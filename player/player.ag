# player: a video file on the gpu decoder: mp4 mov m4v, raw h264 h265;
# a YouTube address streams its H.264 and AAC through yt-dlp
export 0.1.0
export software ['everyday']
export extensions ['.mp4', '.mov', '.m4v', '.h264', '.264', '.h265',
                   '.265', '.hevc', '.wav']
# aura's sign-ins it may use (yt-dlp's cookies): these sites only
export signins ['youtube.com', 'google.com']

import vec
import img
import trinity
import spectra
import <unistd.h>
    +_DEFAULT_SOURCE
import <fcntl.h>
import <string.h>
import <stdio.h>
import <stdlib.h>

# yt-dlp runs on this Node (YouTube's checks need 22 on)
import node/24.18.0 from https://nodejs.org/dist/v24.18.0/node-v24.18.0.tar.xz
    > test -x {install}/node/bin/node || ./configure --prefix={install}/node
    > test -x {install}/node/bin/node || make -j32
    > test -x {install}/node/bin/node || make install

# yt-dlp's release: a python zipapp with its solver
import https://github.com/yt-dlp/yt-dlp/releases/download/2026.10.26/yt-dlp
    > install -m 755 {import_file} {install}/bin/yt-dlp

import Wave
import Tube

func file_bytes [ p: path ] -> vec u8
    fd : i32 [ open[ p.chars, O_RDONLY, 0 ] ]
    if [ fd < 0 ] return null
    n : i64 [ lseek[ fd, 0, SEEK_END ] ]
    lseek[ fd, 0, SEEK_SET ]
    b : vec u8 [ n ]
    got : i64 [ 0 ]
    while [ got < n ]
        k : i64 [ read[ fd, @b[ got ], n - got ] ]
        if [ k <= 0 ] break
        got += k
    close[ fd ]
    return b

# 12 floats: limited-range yuv to rgb, three rows of (y, u, v, add)
func yuv_rows [ bt: bool ] -> @f32
    ky : f32 [ 255.0 / 219.0 ]
    kc : f32 [ 255.0 / 224.0 ]
    rv : f32 [ (bt) ? 1.5748 : 1.402 ]
    gu : f32 [ (bt) ? 0.1873 : 0.3441 ]
    gv : f32 [ (bt) ? 0.4681 : 0.7141 ]
    bu : f32 [ (bt) ? 1.8556 : 1.772 ]
    y0 : f32 [ 16.0 / 255.0 * ky ]
    c0 : f32 [ 128.0 / 255.0 * kc ]
    r : new f32 [ 12 ]
    r[0]  = ky
    r[1]  = 0.0
    r[2]  = rv * kc
    r[3]  = 0.0 - y0 - rv * c0
    r[4]  = ky
    r[5]  = 0.0 - gu * kc
    r[6]  = 0.0 - gv * kc
    r[7]  = 0.0 - y0 + (gu + gv) * c0
    r[8]  = ky
    r[9]  = bu * kc
    r[10] = 0.0
    r[11] = 0.0 - y0 - bu * c0
    return r

# a picture's three planes on the gpu
class Planes
    context vk     : vk_context
    context w      : Display
    public  y      : Texture
    public  u      : Texture
    public  v      : Texture
    public  width  : i32
    public  height : i32
    public  bt709  : bool

    func plane [ pw: i32, ph: i32 ] -> Texture
        return Texture [ vk: vk, w: w, width: pw, height: ph,
                         linear: true, pixel_format: Pixel.u8,
                         surface: Surface.color, tag: 'player' ]

    func put [ f: VideoFrame ]
        cw : i32 [ (f.full) ? f.width : f.width / 2 ]
        ch : i32 [ (f.full) ? f.height : f.height / 2 ]
        if [ !y || width != f.width || height != f.height
             || u.width != cw ]
            y = plane[ f.width, f.height ]
            u = plane[ cw, ch ]
            v = plane[ cw, ch ]
            width  = f.width
            height = f.height
        y.upload[ @f.y[ 0 ], i64[ f.width ] * f.height ]
        u.upload[ @f.u[ 0 ], i64[ cw ] * ch ]
        v.upload[ @f.v[ 0 ], i64[ cw ] * ch ]

    func draw [ cv: Canvas, r: rect ]
        if [ !y ] return
        cv.draw_yuv[ y, u, v, r.x, r.y, r.w, r.h, yuv_rows[ bt709 ] ]

# 'hvc1' / 'hev1' as the sample entry's four bytes
func is_hevc [ codec: i64 ] -> bool
    return codec == 0x68766331 || codec == 0x68657631

# the first video track with a config
func video_of [ dm: Demux ] -> DemuxTrack
    for [ t: DemuxTrack ] in dm.tracks
        if [ t.kind == 1 && t.config.count > 0 ] return t
    return null

# a fragmented file's aac samples gathered, as pcm
func clip_of [ t: DemuxTrack, got: vec DemuxSample ] -> AudioClip
    total : i64 [ 0 ]
    for [ ds: DemuxSample ] in got
        if [ ds.track == t.id ] total += ds.data.count
    if [ total == 0 || t.config.count == 0 ] return null
    data : vec u8 [ total ]
    offs : vec i64 []
    szs  : vec i64 []
    o : i64 [ 0 ]
    for [ ds: DemuxSample ] in got
        if [ ds.track == t.id ]
            n : i64 [ ds.data.count ]
            memcpy[ @data[ o ], @ds.data[ 0 ], n ]
            offs.push[ o ]
            szs.push[ n ]
            o += n
    return aac_clip[ @t.config[ 0 ], i32[ t.config.count ], @data[ 0 ],
                     offs, szs, t.shift ]

# the video's samples in decode order, its config and sound
class Movie
    public samples : vec DemuxSample
    public config  : vec u8
    public hevc    : bool
    public scale   : i64                 # pts units a second
    public length  : f64                 # seconds
    # a raw stream: pictures are timed by display order
    public raw     : bool
    public sound   : AudioClip

    # mp4, mov, m4v: plain or fragmented
    func load_mp4 [ bytes: vec u8 ] -> bool
        dm : Demux []
        plain : bool dm.read_bytes[ @bytes[ 0 ], bytes.count ]
        vt : DemuxTrack video_of[ dm ]
        # a fragmented file (our own takes): samples by its fragments
        if [ !plain || !vt || vt.samples[] == 0 ]
            plain = false
            dm = Demux []
            dm.append[ @bytes[ 0 ], bytes.count ]
            vt = video_of[ dm ]
        if [ !vt ] return false
        at : DemuxTrack [ null ]
        for [ t: DemuxTrack ] in dm.tracks
            if [ t.kind == 2 && !at ] at = t
        hevc   = is_hevc[ vt.codec ]
        config = vt.config
        scale  = vt.timescale
        samples = vec DemuxSample []
        if [ plain ]
            for [ i: i64 0, i < vt.samples[], i += 1 ]
                ds : DemuxSample [ track: vt.id, pts: vt.pts[ i ],
                                   sync: vt.sync[ i ] != 0 ]
                ds.data = vec u8 [ vt.sizes[ i ] ]
                memcpy[ @ds.data[ 0 ], @bytes[ vt.offsets[ i ] ],
                        vt.sizes[ i ] ]
                samples.push[ ds ]
            if [ at && at.samples[] > 0 ]
                sound = aac_clip[ @at.config[ 0 ],
                                  i32[ at.config.count ], @bytes[ 0 ],
                                  at.offsets, at.sizes, at.shift ]
        el
            for [ ds: DemuxSample ] in dm.ready
                if [ ds.track == vt.id ] samples.push[ ds ]
            if [ at ] sound = clip_of[ at, dm.ready ]
        last : i64 [ 0 ]
        for [ ds: DemuxSample ] in samples
            if [ ds.pts > last ] last = ds.pts
        length = f64[ last ] / f64[ scale ]
        return samples.count > 0

    # annex b: start codes, nal units grouped into pictures
    func load_raw [ b: vec u8, fps: f64 ] -> bool
        raw = true
        scale = i64[ fps * 1000.0 ]
        starts : vec i64 []
        n : i64 [ b.count ]
        for [ i: i64 0, i + 2 < n, i += 1 ]
            if [ b[ i ] == 0 && b[ i + 1 ] == 0 && b[ i + 2 ] == 1 ]
                starts.push[ i + 3 ]
                i += 2
        ends : vec i64 []
        for [ k: i64 0, k < starts.count, k += 1 ]
            e : i64 [ (k + 1 < starts.count) ? starts[ k + 1 ] - 3 : n ]
            while [ e > starts[ k ] && b[ e - 1 ] == 0 ] e -= 1
            ends.push[ e ]
        params : vec i64 [] [ -1, -1, -1 ]
        samples = vec DemuxSample []
        first : i64 [ 0 ]
        vcl : bool [ false ]
        for [ k: i64 0, k <= starts.count, k += 1 ]
            begin : bool [ k == starts.count ]
            if [ !begin ]
                s : i64 [ starts[ k ] ]
                t : i32 [ (hevc) ? (b[ s ] >> 1) & 63 : b[ s ] & 31 ]
                pic : bool [ (hevc) ? t < 32 : t == 1 || t == 5 ]
                hb : i64 [ s + ((hevc) ? 2 : 1) ]
                at_top : bool [ pic && (b[ hb ] & 0x80) != 0 ]
                lead : bool [ (hevc) ? (t >= 32 && t <= 35) || t == 39
                                     : t >= 6 && t <= 9 ]
                begin = vcl && (at_top || lead)
                ps : i32 [ (hevc) ? t - 32 : t - 6 ]
                if [ ps >= 0 && ps <= 2 && params[ ps ] < 0 ]
                    params[ ps ] = k
            if [ begin ]
                put_unit[ b, starts, ends, first, k ]
                first = k
                vcl = false
            if [ k < starts.count ]
                s2 : i64 [ starts[ k ] ]
                t2 : i32 [ (hevc) ? (b[ s2 ] >> 1) & 63 : b[ s2 ] & 31 ]
                if [ (hevc) ? t2 < 32 : t2 == 1 || t2 == 5 ] vcl = true
        if [ samples.count == 0 ] return false
        length = f64[ samples.count ] / fps
        config = (hevc) ? hvcc_of[ b, starts, ends, params ]
                        : avcc_of[ b, starts, ends, params ]
        return config != null

    # nal units first .. upto as one length-prefixed sample
    func put_unit [ b: vec u8, starts: vec i64, ends: vec i64,
                    first: i64, upto: i64 ]
        total : i64 [ 0 ]
        for [ k: i64 first, k < upto, k += 1 ]
            total += 4 + ends[ k ] - starts[ k ]
        if [ total == 0 ] return
        ds : DemuxSample [ pts: samples.count * 1000 ]
        ds.data = vec u8 [ total ]
        o : i64 [ 0 ]
        for [ k: i64 first, k < upto, k += 1 ]
            len : i64 [ ends[ k ] - starts[ k ] ]
            ds.data[ o ]     = u8[ (len >> 24) & 255 ]
            ds.data[ o + 1 ] = u8[ (len >> 16) & 255 ]
            ds.data[ o + 2 ] = u8[ (len >> 8) & 255 ]
            ds.data[ o + 3 ] = u8[ len & 255 ]
            memcpy[ @ds.data[ o + 4 ], @b[ starts[ k ] ], len ]
            o += 4 + len
            t : i32 [ (hevc) ? (b[ starts[ k ] ] >> 1) & 63
                             : b[ starts[ k ] ] & 31 ]
            if [ (hevc) ? t >= 16 && t <= 21 : t == 5 ] ds.sync = true
        samples.push[ ds ]

    # one parameter set: two bytes of length, then the bytes
    func put_set [ out: vec u8, b: vec u8, s: i64, e: i64 ]
        len : i64 [ e - s ]
        out.push[ u8[ (len >> 8) & 255 ] ]
        out.push[ u8[ len & 255 ] ]
        for [ i: i64 s, i < e, i += 1 ]
            byte : u8 [ b[ i ] ]
            out.push[ byte ]

    # sps at params[1], pps at params[2]
    func avcc_of [ b: vec u8, starts: vec i64, ends: vec i64,
                   params: vec i64 ] -> vec u8
        sp : i64 [ params[ 1 ] ]
        pp : i64 [ params[ 2 ] ]
        if [ sp < 0 || pp < 0 ] return null
        s : i64 [ starts[ sp ] ]
        out : vec u8 []
        out.push[ 1 ]
        for [ i: i64 1, i <= 3, i += 1 ]
            byte : u8 [ b[ s + i ] ]
            out.push[ byte ]
        out.push[ 0xFF ]
        out.push[ 0xE1 ]
        put_set[ out, b, s, ends[ sp ] ]
        out.push[ 1 ]
        put_set[ out, b, starts[ pp ], ends[ pp ] ]
        return out

    # vps, sps, pps at params[0..2]; the decoder reads the arrays
    func hvcc_of [ b: vec u8, starts: vec i64, ends: vec i64,
                   params: vec i64 ] -> vec u8
        for [ i: i32 0, i < 3, i += 1 ]
            if [ params[ i ] < 0 ] return null
        out : vec u8 []
        out.push[ 1 ]
        for [ i: i32 1, i < 21, i += 1 ]
            out.push[ 0 ]
        out.push[ 3 ]
        out.push[ 3 ]
        for [ i: i32 0, i < 3, i += 1 ]
            out.push[ u8[ 32 + i ] ]
            out.push[ 0 ]
            out.push[ 1 ]
            k : i64 [ params[ i ] ]
            put_set[ out, b, starts[ k ], ends[ k ] ]
        return out

element player : trinity
    width  : i32    [ 1280 ]
    height : i32    [ 720 ]
    public  title  : string [ 'player' ]
    default [ Launch, Live ] file : path
    # a raw stream's pictures a second
    public  [ Launch ] fps : f64 [ 30.0 ]
    mutable clip    : Movie
    mutable dec     : Decoder
    mutable planes  : Planes
    mutable next    : i64                # the next sample to decode
    mutable out_n   : i64                # a raw stream's next picture
    mutable at      : f64                # seconds at from_ms
    mutable from_ms : i64
    mutable paused  : bool
    mutable shown   : bool
    mutable failed  : string
    mutable mixer   : AudioMixer
    mutable voice   : i32
    mutable tried   : string             # the file last opened
    # a sound file: shown from .. to seconds, a span chosen
    mutable wave    : Wave
    # what shows and what is chosen, in seconds (set live)
    public  [ Live ] view_from : f64
    public  [ Live ] view_to   : f64
    public  [ Live ] sel_from  : f64
    public  [ Live ] sel_to    : f64
    # the selection's files: this name beside the open file, then
    # the span's seconds (empty: the open file's name)
    public  [ Live ] out_name  : string
    # the spectrogram and the waveform, made for pic_key's view
    mutable spec_tex : Texture
    mutable wave_tex : Texture
    mutable pic_key : string
    # where the panels sit across the element (pixels)
    mutable panel_x : f32
    mutable panel_w : f32
    mutable drag_x  : f32
    mutable picking : bool
    # a YouTube video streaming in; stalled: the picture caught up
    # with what has come
    mutable tube    : Tube
    mutable stalled : bool
    # waiting on a sign-in in aura: its cookies' time when asked
    mutable signin_at : i64
    mutable signin_look : i64
    # the controls: the pointer (-1 out), its last move, how shown
    mutable mx       : f32
    mutable my       : f32
    mutable moved_ms : i64
    mutable ctl_a    : f32
    # the seek knob held: where it is, when it last sought
    mutable scrub    : bool
    mutable scrub_t  : f64
    mutable scrub_ms : i64
    # the time the drag last sought (-1 none yet)
    mutable sought_t : f64
    mutable vol_drag : bool
    mutable vol      : f32 [ 1.0 ]
    mutable muted    : bool
    mutable icons    : FileIcons

    func init []
        animated  = true
        focusable = true

    # a video in place of the one playing; false when unreadable
    func open_file [ p: path ] -> bool
        txt : string '{p}'
        # an address: a path puts the start folder before it
        hs : i64 [ txt.index_of[ 'https:/' ] ]
        if [ hs < 0 ] hs = txt.index_of[ 'http:/' ]
        if [ hs >= 0 ] return open_tube[ txt.mid[ hs, txt.count - hs ] ]
        if [ !p.exists[] || p.is_dir[] ]
            failed = 'no file: {p}'
            return false
        if [ '{p}'.lcase[].ends_with[ '.wav' ] ] return open_wave[ p ]
        wave = null
        bytes : vec u8 file_bytes[ p ]
        if [ !bytes ]
            failed = 'cannot open {p}'
            return false
        low : string '{p}'.lcase[]
        mv : Movie []
        ok : bool [ false ]
        if [ low.ends_with[ '.h264' ] || low.ends_with[ '.264' ] ]
            ok = mv.load_raw[ bytes, fps ]
        el [ low.ends_with[ '.h265' ] || low.ends_with[ '.265' ]
             || low.ends_with[ '.hevc' ] ]
            mv.hevc = true
            ok = mv.load_raw[ bytes, fps ]
        el
            ok = mv.load_mp4[ bytes ]
        if [ !ok ]
            failed = 'cannot read {p}'
            return false
        if [ mixer && voice > 0 ] mixer.voice_stop[ voice ]
        voice   = 0
        clip    = mv
        file    = p
        dec     = null
        next    = 0
        out_n   = 0
        at      = 0.0
        paused  = false
        shown   = false
        failed  = null
        from_ms = epoch_millis[]
        title   = '{p.filename[]}'
        set_title[ title ]
        sound_at[ 0.0 ]
        return true

    # a YouTube address: its streams fetched, played as they come
    func open_tube [ txt: string ] -> bool
        url : string [ txt ]
        # a path folds // to /
        if [ url.index_of[ '://' ] < 0 ]
            sc : i64 [ url.index_of[ ':/' ] ]
            head : string url.mid[ 0, sc ]
            url = '{head}://{url.mid[ sc + 2, url.count - sc - 2 ]}'
        if [ tube ] tube.stop[]
        if [ mixer && voice > 0 ] mixer.voice_stop[ voice ]
        voice  = 0
        wave   = null
        clip   = null
        dec    = null
        failed = null
        cache : string '{path.path_cache[ 'player' ]}'
        tube = Tube [ url: url, dir: '{cache}/tube-{getpid[]}' ]
        tube.start[]
        title = 'loading {url}'
        set_title[ title ]
        return true

    # its streams read as they grow: it starts once the sound is in
    # and a second of picture; a stall goes on as more comes
    func tube_pump []
        if [ !tube ] return
        # a sign-in done in aura: the same address again, signed in
        if [ signin_at > 0 && epoch_millis[] - signin_look > 1000 ]
            signin_look = epoch_millis[]
            if [ tube.signin_time[] > signin_at ] signin_at = -1
        if [ signin_at < 0 ]
            signin_at = 0
            open_tube[ tube.url ]
            return
        if [ signin_at > 0 ] return
        if [ tube.failed[] ]
            # YouTube asks a sign-in: aura comes up for it, unless
            # signed in already (then why it failed)
            if [ tube.wants_signin[] && !tube.signed ]
                signin_at = max[ tube.signin_time[], 1 ]
                ask : string 'YouTube asks you to sign in'
                failed = '{ask}: in aura, then the video starts'
                tube.stop[]
                if [ ux ] ux.open_address[ signin_url[ tube.url ] ]
                return
            failed = tube.why[]
            tube.stop[]
            tube = null
            return
        tube.pump[]
        vt : DemuxTrack tube.track[]
        if [ !clip ]
            if [ !vt || !tube.has[ 'a.m4a.done' ] ] return
            if [ tube.fresh.count == 0 ] return
            lastp : i64 [ tube.fresh[ tube.fresh.count - 1 ].pts ]
            if [ f64[ lastp ] / f64[ vt.timescale ] < 1.0
                 && !tube.video_done[] ]
                return
            mv : Movie []
            mv.config  = vt.config
            mv.hevc    = is_hevc[ vt.codec ]
            mv.scale   = vt.timescale
            mv.samples = vec DemuxSample []
            mv.sound   = tube.sound[]
            clip    = mv
            next    = 0
            out_n   = 0
            at      = 0.0
            paused  = false
            stalled = false
            shown   = false
            from_ms = epoch_millis[]
            title   = tube.name[]
            set_title[ title ]
        for [ ds: DemuxSample ] in tube.fresh
            clip.samples.push[ ds ]
            if [ secs[ ds.pts ] > clip.length ]
                clip.length = secs[ ds.pts ]
        first : bool [ tube.fresh.count > 0 && voice == 0 && !stalled ]
        tube.fresh.clear[]
        if [ first && !paused ] sound_at[ now[] ]
        # caught up: on again with two seconds ahead, or at the end
        if [ stalled && (clip.length > at + 2.0 || tube.video_done[]) ]
            stalled = false
            toggle[]

    # YouTube's sign-in, back to the video after
    func signin_url [ url: string ] -> string
        digits : string '0123456789ABCDEF'
        back : string ''
        for [ i: i32 0, i < url.count, i += 1 ]
            b : i32 [ (i32 url.chars[ i ]) & 255 ]
            # letters, digits, . - _ as they are; the rest %XX
            ok : bool [ (b >= 97 && b <= 122) || (b >= 65 && b <= 90)
                        || (b >= 48 && b <= 57) || b == 46 || b == 45
                        || b == 95 ]
            if [ ok ] back = '{back}{url.mid[ i, 1 ]}'
            el
                hi : string digits.mid[ b / 16, 1 ]
                lo : string digits.mid[ b % 16, 1 ]
                back = '{back}%{hi}{lo}'
        login : string 'https://accounts.google.com/ServiceLogin'
        return '{login}?service=youtube&continue={back}'

    func growing [] -> bool
        return tube && !tube.video_done[]

    func open_wave [ p: path ] -> bool
        wv : Wave []
        if [ !wv.load[ p ] ]
            failed = 'cannot read {p} (16-bit pcm wav)'
            return false
        if [ mixer && voice > 0 ] mixer.voice_stop[ voice ]
        voice  = 0
        clip   = null
        wave   = wv
        file   = p
        view_from = 0.0
        view_to   = wv.length
        sel_from = 0.0
        sel_to   = 0.0
        at     = 0.0
        paused = true
        failed = null
        pic_key = null
        title  = '{p.filename[]}'
        set_title[ title ]
        return true

    # the sound from t, to its chosen span's end if any
    # with no sound device the play line still runs, silent
    func wave_play [ t: f64 ]
        at = t
        from_ms = epoch_millis[]
        paused = false
        if [ !mixer ]
            mixer = AudioMixer [ sample_rate: 48000 ]
            if [ !mixer.start[] ] return
        if [ voice > 0 ] mixer.voice_stop[ voice ]
        voice = mixer.play_voice[ wave.clip, false, 1.0, 1.0 ]
        if [ voice > 0 ]
            mixer.voice_seek[ voice, t * f64[ wave.rate ] ]

    func wave_halt []
        if [ !paused ] at = now[]
        if [ mixer && voice > 0 ] mixer.voice_stop[ voice ]
        voice = 0
        paused = true

    # a path as given, else beside the open file
    func out_path [ s: string ] -> path
        if [ s.starts_with[ '/' ] ] return path [ s ]
        return path [ '{file.directory[]}/{s}' ]


    # spans by seconds, files by name beside the open file
    action func open_sound [ name: string ]
        open_file[ out_path[ name ] ]
        tried = '{file}'

    action func view_span [ from: f64, to: f64 ]
        if [ !wave || to <= from ] return
        view_from = max[ 0.0, from ]
        view_to = min[ wave.length, to ]

    action func select_span [ from: f64, to: f64 ]
        sel_from = from
        sel_to = to

    action func play_from [ t: f64 ]
        if [ wave ] wave_play[ t ]

    # its ends faded fade_ms
    action func crop [ from: f64, to: f64, fade_ms: f64, name: string ]
        if [ !wave ] return
        op : path out_path[ name ]
        ok : bool wave.write_span[ from, to, op, fade_ms ]
        log 'player: crop {from} .. {to} -> {op}: {ok}'

    # its last xfade_ms laid over its start, to loop
    action func make_loop [ from: f64, to: f64, xfade_ms: f64,
                            name: string ]
        if [ !wave ] return
        op : path out_path[ name ]
        ok : bool wave.write_loop[ from, to, op, xfade_ms ]
        log 'player: loop {from} .. {to} -> {op}: {ok}'

    # a line of numbers every step seconds, as text
    action func measure [ from: f64, to: f64, step: f64, name: string ]
        if [ !wave ] return
        op : path out_path[ name ]
        txt : string wave.stats[ from, to, step ]
        fp : @FILE [ fopen[ '{op}', 'wb' ] ]
        if [ !fp ] return
        fwrite[ txt.chars, 1, txt.count, fp ]
        fclose[ fp ]
        log 'player: measure {from} .. {to} -> {op}'

    # the selection (else all) by db
    action func gain [ db: f64 ]
        if [ !wave ] return
        wave.gain[ sel_from, sel_to, db ]
        edited[]

    action func normalize_to [ db: f64 ]
        if [ !wave ] return
        wave.normalize[ sel_from, sel_to, db ]
        edited[]

    action func high_pass [ hz: f64 ]
        if [ !wave ] return
        wave.filter[ sel_from, sel_to, hz, true ]
        edited[]

    action func low_pass [ hz: f64 ]
        if [ !wave ] return
        wave.filter[ sel_from, sel_to, hz, false ]
        edited[]

    # a file for the chosen span: <name>-<from>-<to>.<ext>
    func span_file [ ext: string ] -> path
        nm : string [ (out_name && out_name.count > 0) ? out_name
                      : file.stem[] ]
        a : i32 [ i32[ sel_from * 1000.0 ] ]
        b : i32 [ i32[ sel_to * 1000.0 ] ]
        return out_path[ '{nm}-{a}-{b}.{ext}' ]

    func chosen [] -> bool
        return wave && sel_to > sel_from

    # the menu's work on the selection (a socket's `call <name>`)
    action func play_selection []
        if [ chosen[] ] wave_play[ sel_from ]

    action func stop_playing []
        if [ wave ] wave_halt[]

    action func zoom_to_selection []
        if [ !chosen[] ] return
        view_from = sel_from
        view_to = sel_to

    action func show_all []
        if [ !wave ] return
        view_from = 0.0
        view_to = wave.length

    action func select_view []
        if [ !wave ] return
        sel_from = view_from
        sel_to = view_to

    action func clear_selection []
        sel_from = 0.0
        sel_to = 0.0

    # its ends faded 10 ms
    action func save_selection []
        if [ !chosen[] ] return
        op : path span_file[ 'wav' ]
        ok : bool wave.write_span[ sel_from, sel_to, op, 10.0 ]
        log 'player: saved {op}: {ok}'

    # made to loop: its last 150 ms laid over its start
    action func save_as_loop []
        if [ !chosen[] ] return
        op : path span_file[ 'loop.wav' ]
        ok : bool wave.write_loop[ sel_from, sel_to, op, 150.0 ]
        log 'player: saved {op}: {ok}'

    # its numbers every tenth of a second, as text
    action func measure_selection []
        if [ !chosen[] ] return
        op : path span_file[ 'txt' ]
        txt : string wave.stats[ sel_from, sel_to, 0.1 ]
        fp : @FILE [ fopen[ '{op}', 'wb' ] ]
        if [ !fp ] return
        fwrite[ txt.chars, 1, txt.count, fp ]
        fclose[ fp ]
        log 'player: saved {op}'

    # after an edit: the old sound stops, the picture is made again
    func edited []
        if [ mixer && voice > 0 ] mixer.voice_stop[ voice ]
        voice = 0
        paused = true
        pic_key = null
        view_to = min[ view_to, wave.length ]
        if [ view_to <= view_from ]
            view_from = 0.0
            view_to = wave.length
        sel_to = min[ sel_to, wave.length ]

    # edits work on the selection, else on the whole sound
    action func normalize []
        if [ !wave ] return
        wave.normalize[ sel_from, sel_to, -1.0 ]
        edited[]

    action func balance_channels []
        if [ !wave ] return
        wave.balance[ sel_from, sel_to ]
        edited[]

    action func make_mono []
        if [ !wave ] return
        wave.make_mono[ sel_from, sel_to ]
        edited[]

    action func swap_channels []
        if [ !wave ] return
        wave.swap_sides[ sel_from, sel_to ]
        edited[]

    action func louder []
        if [ !wave ] return
        wave.gain[ sel_from, sel_to, 3.0 ]
        edited[]

    action func quieter []
        if [ !wave ] return
        wave.gain[ sel_from, sel_to, -3.0 ]
        edited[]

    action func fade_in []
        if [ !wave ] return
        wave.fade[ sel_from, sel_to, true ]
        edited[]

    action func fade_out []
        if [ !wave ] return
        wave.fade[ sel_from, sel_to, false ]
        edited[]

    action func silence []
        if [ !wave ] return
        wave.silence[ sel_from, sel_to ]
        edited[]

    action func reverse []
        if [ !wave ] return
        wave.reverse[ sel_from, sel_to ]
        edited[]

    action func remove_dc []
        if [ !wave ] return
        wave.remove_dc[ sel_from, sel_to ]
        edited[]

    # under 40 Hz
    action func cut_rumble []
        if [ !wave ] return
        wave.filter[ sel_from, sel_to, 40.0, true ]
        edited[]

    # over 8 kHz
    action func cut_hiss []
        if [ !wave ] return
        wave.filter[ sel_from, sel_to, 8000.0, false ]
        edited[]

    action func delete_selection []
        if [ !chosen[] ] return
        wave.cut[ sel_from, sel_to, false ]
        sel_to = sel_from
        edited[]

    action func trim_to_selection []
        if [ !chosen[] ] return
        wave.cut[ sel_from, sel_to, true ]
        sel_from = 0.0
        sel_to = 0.0
        view_from = 0.0
        view_to = wave.length
        edited[]

    action func undo []
        if [ wave && wave.undo[] ] edited[]

    # the whole edited sound: <name>-edit.wav beside the open file
    action func save_file []
        if [ !wave ] return
        nm : string [ (out_name && out_name.count > 0) ? out_name
                      : file.stem[] ]
        op : path out_path[ '{nm}-edit.wav' ]
        ok : bool wave.save[ op ]
        log 'player: saved {op}: {ok}'

    func x_time [ x: f32 ] -> f64
        w : f32 [ max[ panel_w, 1.0 ] ]
        u : f32 [ clamp[ (x - panel_x) / w, 0.0, 1.0 ] ]
        return view_from + (view_to - view_from) * f64[ u ]

    # ctrl+o: the dialog lists the video's folder, else the start one
    public func nav_folder [] -> path
        if [ file && file.exists[] ] return file.directory[]
        return path.path_startup[]

    public func nav_open [ p: path ] -> bool
        if [ p.is_dir[] ] return false
        return open_file[ p ]

    func secs [ pts: i64 ] -> f64
        return f64[ pts ] / f64[ clip.scale ]

    # the play position now
    func now [] -> f64
        if [ paused ] return at
        return at + f64[ epoch_millis[] - from_ms ] / 1000.0

    func sound_at [ t: f64 ]
        if [ !clip.sound ] return
        if [ !mixer ]
            mixer = AudioMixer [ sample_rate: 48000 ]
            if [ !mixer.start[] ]
                clip.sound = null
                return
        if [ voice > 0 ] mixer.voice_stop[ voice ]
        voice = 0
        if [ paused ] return
        voice = mixer.play_voice[ clip.sound, false, 1.0, 1.0 ]
        if [ voice > 0 ]
            mixer.voice_seek[ voice, t * f64[ clip.sound.rate ] ]
        apply_vol[]

    func apply_vol []
        if [ mixer && voice > 0 ]
            mixer.voice_gain[ voice, (muted) ? 0.0 : vol ]

    func set_vol [ v: f32 ]
        vol = clamp[ v, 0.0, 1.0 ]
        muted = vol <= 0.0
        apply_vol[]

    # a new decoder from the key sample at or before t
    func seek [ t: f64 ]
        go : f64 [ max[ 0.0, min[ t, clip.length ] ] ]
        key : i64 [ 0 ]
        for [ i: i64 0, i < clip.samples.count, i += 1 ]
            ds : DemuxSample clip.samples[ i ]
            if [ ds.sync && secs[ ds.pts ] <= go ] key = i
        dec = null
        next  = key
        out_n = key * 1000
        at = go
        from_ms = epoch_millis[]
        sound_at[ go ]

    func decode_one []
        ds : DemuxSample clip.samples[ next ]
        before : i64 [ dec.frames.count ]
        dec.decode[ @ds.data[ 0 ], i32[ ds.data.count ], ds.pts ]
        next += 1
        if [ next == clip.samples.count && !growing[] ] dec.finish[]
        if [ clip.raw ]
            for [ i: i64 before, i < dec.frames.count, i += 1 ]
                f : VideoFrame dec.frames[ i ]
                f.pts = out_n
                out_n += 1000

    # decode until the picture for t is known; it goes up
    func advance [ cv: Canvas, t: f64 ]
        if [ !dec ]
            dec = Decoder [ vk: cv.vk ]
            ok : bool [ (clip.hevc)
                ? dec.config_hevc[ @clip.config[ 0 ],
                                   i32[ clip.config.count ] ]
                : dec.config[ @clip.config[ 0 ],
                              i32[ clip.config.count ] ] ]
            if [ !ok ]
                failed = 'the decoder refused {file}'
                return
        if [ !planes ]
            planes = Planes [ vk: cv.vk, w: cv.w,
                              bt709: dec.height >= 720 ]
        while [ next < clip.samples.count ]
            n : i64 [ dec.frames.count ]
            if [ n > 0 && secs[ dec.frames[ n - 1 ].pts ] > t ] break
            decode_one[]
        pick : i64 [ -1 ]
        for [ i: i64 0, i < dec.frames.count, i += 1 ]
            if [ secs[ dec.frames[ i ].pts ] <= t ] pick = i
        if [ pick < 0 && !shown && dec.frames.count > 0 ] pick = 0
        if [ pick < 0 ] return
        planes.put[ dec.frames[ pick ] ]
        shown = true
        for [ i: i64 0, i <= pick, i += 1 ]
            dec.frames.shift[]

    func toggle []
        at = now[]
        paused = !paused
        from_ms = epoch_millis[]
        sound_at[ at ]

    public func on_press [ ev: Event ]
        set_focus[]
        if [ wave && !failed ]
            drag_x = ev.mouse.pos.x
            picking = true
            return
        if [ !clip || failed ] return
        mx = ev.mouse.pos.x
        my = ev.mouse.pos.y
        moved_ms = epoch_millis[]
        # hidden, a press anywhere plays or pauses
        hit : string [ (ctl_a > 0.3) ? ctl_at[ mx, my ] : '' ]
        if [ hit == 'seek' ]
            scrub = true
            scrub_t = track_time[ mx ]
            scrub_ms = moved_ms
            sought_t = -1.0
        el [ hit == 'play' ]
            toggle[]
        el [ hit == 'back' ]
            seek[ now[] - 10.0 ]
        el [ hit == 'fwd' ]
            seek[ now[] + 10.0 ]
        el [ hit == 'vol' ]
            muted = !muted
            if [ !muted && vol <= 0.0 ] vol = 0.5
            apply_vol[]
        el [ hit == 'slider' ]
            vol_drag = true
            set_vol[ slider_val[ mx ] ]
        el [ hit == '' ]
            toggle[]

    # a drag chooses a span; a click alone plays from there
    public func on_move [ ev: Event ]
        if [ wave ]
            if [ !picking ] return
            x : f32 [ ev.mouse.pos.x ]
            if [ abs[ x - drag_x ] < 3.0 ] return
            sel_from = x_time[ min[ x, drag_x ] ]
            sel_to   = x_time[ max[ x, drag_x ] ]
            return
        mx = ev.mouse.pos.x
        my = ev.mouse.pos.y
        moved_ms = epoch_millis[]
        # the knob follows; the picture waits for the drag to rest
        if [ scrub && clip ]
            scrub_t = track_time[ mx ]
            scrub_ms = moved_ms
        if [ vol_drag ] set_vol[ slider_val[ mx ] ]

    public func on_leave [ ev: Event ]
        if [ scrub || vol_drag ] return
        mx = -1.0
        my = -1.0

    public func on_release [ ev: Event ]
        if [ scrub && clip ]
            scrub = false
            if [ scrub_t != sought_t ] seek[ scrub_t ]
        vol_drag = false
        if [ !wave || !picking ] return
        picking = false
        if [ abs[ ev.mouse.pos.x - drag_x ] < 3.0 ]
            sel_from = 0.0
            sel_to = 0.0
            wave_play[ x_time[ drag_x ] ]

    # the wheel zooms about the pointer
    public func on_wheel [ ev: Event ]
        # a video: the wheel over its controls sets the volume
        if [ !wave && clip && ctl_at[ mx, my ].count > 0 ]
            up : bool [ ev.mouse.wheel_delta.y > 0.0 ]
            set_vol[ vol + ((up) ? 0.05 : -0.05) ]
            moved_ms = epoch_millis[]
            return
        if [ !wave ] return
        k : f64 [ (ev.mouse.wheel_delta.y > 0.0) ? 0.8 : 1.25 ]
        c : f64 x_time[ ev.mouse.pos.x ]
        span : f64 [ min[ wave.length,
                          max[ 0.05, (view_to - view_from) * k ] ] ]
        f : f64 [ f64[ clamp[ (ev.mouse.pos.x - panel_x)
                            / max[ panel_w, 1.0 ], 0.0, 1.0 ] ] ]
        view_from = max[ 0.0, c - span * f ]
        view_to = min[ wave.length, view_from + span ]
        view_from = view_to - span

    # space plays the span (or from the cursor), enter zooms to it,
    # escape shows it all
    func wave_key [ code: i32 ] -> bool
        if [ code == 32 ]
            if [ !paused ] wave_halt[]
            el wave_play[ (sel_to > sel_from) ? sel_from : at ]
        el [ code == 257 && sel_to > sel_from ]
            view_from = sel_from
            view_to = sel_to
        el [ code == 256 ]
            view_from = 0.0
            view_to = wave.length
        el
            return false
        return true

    public func on_key [ ev: Event ]
        if [ ev.key.state != 0 && wave && !failed ]
            if [ wave_key[ ev.key.unicode ] ] ev.stop[]
            return
        if [ ev.key.state == 0 || !clip || failed ] return
        code : i32 [ ev.key.unicode ]
        moved_ms = epoch_millis[]
        # space or k plays; arrows 5 s, j and l 10 s; up, down, m
        if [ code == 32 || code == 75 ]
            toggle[]
        el [ code == 262 ]
            seek[ now[] + 5.0 ]
        el [ code == 263 ]
            seek[ now[] - 5.0 ]
        el [ code == 76 ]
            seek[ now[] + 10.0 ]
        el [ code == 74 ]
            seek[ now[] - 10.0 ]
        el [ code == 265 ]
            set_vol[ vol + 0.05 ]
        el [ code == 264 ]
            set_vol[ vol - 0.05 ]
        el [ code == 77 ]
            muted = !muted
            apply_vol[]
        el
            return
        ev.stop[]

    public func on_canvas [ cv: Canvas ]
        if [ !cv ] return
        cv.reset[ vec4f[ 0.0, 0.0, 0.0, 1.0 ] ]
        # the file, at start or set live (orbiter's pick)
        if [ file && !file.is_dir[] && '{file}' != tried ]
            tried  = '{file}'
            failed = null
            open_file[ file ]
        tube_pump[]
        if [ tube && !clip && !failed ]
            cv.fill_color[ rgba['#ffffff99'] ]
            cv.font_size[ 16 ]
            cv.draw_text[ title, rect [ x: 20.0, y: 20.0,
                                        w: bounds.w - 40.0, h: 24.0 ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                Overflow.visible, null, false ]
            cv.paint[]
            return
        if [ failed ]
            cv.fill_color[ rgba['#ffffff'] ]
            cv.font_size[ 16 ]
            cv.draw_text[ failed, rect [ x: 20.0, y: 20.0,
                                         w: bounds.w - 40.0, h: 24.0 ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                Overflow.visible, null, false ]
            cv.paint[]
            return
        if [ wave ]
            draw_wave[ cv ]
            return
        if [ !clip ]
            own_icon_paint[ cv,
                rect [ x: 0.0, y: 0.0, w: bounds.w, h: bounds.h ] ]
            return
        t : f64 now[]
        if [ !paused && t >= clip.length ]
            at = clip.length
            paused = true
            sound_at[ at ]
            t = at
            # still coming: it waits, then goes on
            if [ growing[] ] stalled = true
        advance[ cv, t ]
        if [ failed || !planes || !planes.y ] return
        bw : f32 [ bounds.w ]
        bh : f32 [ bounds.h ]
        k : f32 [ min[ bw / f32[ planes.width ],
                       bh / f32[ planes.height ] ] ]
        pw : f32 [ f32[ planes.width ] * k ]
        ph : f32 [ f32[ planes.height ] * k ]
        planes.draw[ cv, rect [ x: (bw - pw) / 2.0, y: (bh - ph) / 2.0,
                                w: pw, h: ph ] ]
        draw_controls[ cv, t ]

    # the controls' unit: 1 at the default font size
    func cu [] -> f32
        if [ !ux ] return 1.0
        return ux_unit[ ux ]

    # the seek track's ends and middle row
    func track_x0 [] -> f32
        return 16.0 * cu[]

    func track_x1 [] -> f32
        return bounds.w - 16.0 * cu[]

    func track_y [] -> f32
        return bounds.h - 56.0 * cu[]

    func track_time [ x: f32 ] -> f64
        x0 : f32 track_x0[]
        k : f32 [ clamp[ (x - x0) / max[ track_x1[] - x0, 1.0 ],
                         0.0, 1.0 ] ]
        return f64[ k ] * clip.length

    # the buttons' row: each a round box this wide, left to right
    func btn_x [ i: i32 ] -> f32
        return 16.0 * cu[] + f32[ i ] * 44.0 * cu[]

    func row_y [] -> f32
        return bounds.h - 44.0 * cu[]

    func slider_x [] -> f32
        return btn_x[ 4 ]

    func slider_val [ x: f32 ] -> f32
        return clamp[ (x - slider_x[]) / (80.0 * cu[]), 0.0, 1.0 ]

    # what a point in the controls is over ('' none)
    func ctl_at [ x: f32, y: f32 ] -> string
        if [ !clip || x < 0.0 ] return ''
        u : f32 cu[]
        if [ abs[ y - track_y[] ] <= 10.0 * u
             && x >= track_x0[] - 6.0 * u
             && x <= track_x1[] + 6.0 * u ]
            return 'seek'
        ry : f32 row_y[]
        if [ y < ry - 2.0 * u || y > ry + 38.0 * u ]
            return (y > track_y[]) ? 'bar' : ''
        if [ x >= btn_x[ 0 ] && x < btn_x[ 1 ] ] return 'play'
        if [ x >= btn_x[ 1 ] && x < btn_x[ 2 ] ] return 'back'
        if [ x >= btn_x[ 2 ] && x < btn_x[ 3 ] ] return 'fwd'
        if [ x >= btn_x[ 3 ] && x < btn_x[ 4 ] ] return 'vol'
        if [ x >= slider_x[] - 4.0 * u
             && x <= slider_x[] + 84.0 * u ]
            return 'slider'
        return 'bar'

    func hms [ t: f64 ] -> string
        n : i64 [ i64[ max[ t, 0.0 ] ] ]
        h : i64 [ n / 3600 ]
        m : i64 [ (n / 60) % 60 ]
        sc : i64 [ n % 60 ]
        ss : string '{sc}'
        if [ sc < 10 ] ss = '0{sc}'
        if [ h > 0 ]
            ms : string '{m}'
            if [ m < 10 ] ms = '0{m}'
            return '{h}:{ms}:{ss}'
        return '{m}:{ss}'

    # a round box the pointer's near light brings up
    # reach: of the window's near light
    func ctl_box [ cv: Canvas, x: f32, y: f32, w: f32, h: f32,
                   lit: bool, reach: f32 ]
        r : f32 [ h / 2.0 ]
        cv.save[]
        cv.rounded[ r, r, r, r ]
        # no edge: a window's inner glow, which the pointer grows
        cv.fill_color[ rgba[ (lit) ? '#ffffff1a' : '#ffffff0a' ] ]
        cv.stroke_width[ 0.0 ]
        cv.box_shadow[ rgba['#ffffff22'], 0.0, 0.0, 8.0 * cu[], 0.0,
                       true ]
        if [ ux ]
            ux.near_light_reach[ cv, a, 0.0, 0.0, reach ]
            cv.near_style[ 0.0, 2.0, rgba['#c890ff77'],
                           ux.near_y_fade ]
            cv.near_grow[ 1.0 ]
        cv.rect_to[ x, y, w, h ]
        cv.paint[]
        cv.restore[]

    # a triangle pointing right (or left), its box x, y, w, h
    func tri [ cv: Canvas, x: f32, y: f32, w: f32, h: f32,
               right: bool ]
        if [ right ]
            cv.move_to[ x, y ]
            cv.line_to[ x + w, y + h / 2.0 ]
            cv.line_to[ x, y + h ]
        el
            cv.move_to[ x + w, y ]
            cv.line_to[ x, y + h / 2.0 ]
            cv.line_to[ x + w, y + h ]
        cv.close_path[]
        cv.paint[]

    # the foot: a shade, the seek track, then play, 10 s back and
    # on, the sound and its slider, the time; they fade at rest
    func draw_controls [ cv: Canvas, t: f64 ]
        bw : f32 [ bounds.w ]
        bh : f32 [ bounds.h ]
        u : f32 cu[]
        nw : i64 epoch_millis[]
        # a drag held still 150 ms shows the picture there
        if [ scrub && scrub_t != sought_t && nw - scrub_ms > 150 ]
            sought_t = scrub_t
            seek[ scrub_t ]
        over : bool [ my > track_y[] - 30.0 * u ]
        want : bool [ paused || scrub || vol_drag || over
                      || nw - moved_ms < 2500 ]
        if [ want ] ctl_a = ctl_a + (1.0 - ctl_a) * 0.2
        el ctl_a = ctl_a * 0.85
        if [ ctl_a < 0.01 ] return
        cv.save[]
        cv.set_opacity[ ctl_a ]
        cv.stroke_width[ 0.0 ]
        # the shade the controls sit on, darker at the foot
        sh : f32 [ 120.0 * u ]
        # whole pixel bands that meet: no seams
        for [ i: i32 0, i < 48, i += 1 ]
            k : f32 [ f32[ i ] / 47.0 ]
            y0 : f32 [ round[ bh - sh + f32[ i ] * sh / 48.0 ] ]
            y1 : f32 [ round[ bh - sh + f32[ i + 1 ] * sh / 48.0 ] ]
            if [ y1 <= y0 ] continue
            cv.fill_rgba[ 0.0, 0.0, 0.0, 0.7 * k * k ]
            cv.rect_to[ 0.0, y0, bw, y1 - y0 ]
            cv.paint[]
        # the track: thicker under the pointer, played part lit
        hit : string ctl_at[ mx, my ]
        near_t : bool [ hit == 'seek' || scrub ]
        th : f32 [ ((near_t) ? 7.0 : 4.0) * u ]
        x0 : f32 track_x0[]
        x1 : f32 track_x1[]
        ty : f32 track_y[]
        shown_t : f64 [ (scrub) ? scrub_t : t ]
        done : f32 [ (clip.length > 0.0)
            ? f32[ clamp[ shown_t / clip.length, 0.0, 1.0 ] ] : 0.0 ]
        px : f32 [ x0 + (x1 - x0) * done ]
        ctl_box[ cv, x0, ty - th / 2.0, x1 - x0, th, false, 0.33 ]
        cv.save[]
        cv.rounded[ th / 2.0, th / 2.0, th / 2.0, th / 2.0 ]
        cv.fill_color[ rgba['#ff84ff'] ]
        cv.rect_to[ x0, ty - th / 2.0, max[ px - x0, th ], th ]
        cv.paint[]
        cv.restore[]
        # where the pointer would go, and its time over it
        if [ near_t && !scrub ]
            cv.fill_color[ rgba['#ffffff33'] ]
            hx : f32 [ clamp[ mx, x0, x1 ] ]
            cv.rect_to[ hx - 1.0 * u, ty - th / 2.0, 2.0 * u, th ]
            cv.paint[]
        if [ near_t ]
            tx : f32 [ (scrub) ? px : clamp[ mx, x0, x1 ] ]
            tt : f64 [ (scrub) ? scrub_t : track_time[ tx ] ]
            bwid : f32 [ 64.0 * u ]
            bx : f32 [ clamp[ tx - bwid / 2.0, x0, x1 - bwid ] ]
            ctl_box[ cv, bx, ty - 38.0 * u, bwid, 24.0 * u, true,
                     0.33 ]
            cv.font_size[ i32[ 14.0 * u ] ]
            label[ cv, hms[ tt ], bx, ty - 33.0 * u, bwid, 0.5,
                   '#ffffff' ]
        # the knob
        kr : f32 [ ((near_t) ? 8.0 : 6.0) * u ]
        cv.save[]
        cv.rounded[ kr, kr, kr, kr ]
        cv.fill_color[ rgba['#ffd2ff'] ]
        cv.box_shadow[ rgba['#ff84ffaa'], 0.0, 0.0, 8.0 * u, 0.0,
                       false ]
        cv.rect_to[ px - kr, ty - kr, kr * 2.0, kr * 2.0 ]
        cv.paint[]
        cv.restore[]
        # the buttons
        ry : f32 row_y[]
        bs : f32 [ 36.0 * u ]
        for [ i: i32 0, i < 4, i += 1 ]
            # the sound's button half as far as the rest
            ctl_box[ cv, btn_x[ i ], ry, bs, bs, false,
                     (i == 3) ? 0.165 : 0.33 ]
        cv.fill_color[ rgba['#ffffff'] ]
        g : f32 [ 12.0 * u ]
        cx : f32 [ btn_x[ 0 ] + bs / 2.0 ]
        cy : f32 [ ry + bs / 2.0 ]
        if [ paused ]
            tri[ cv, cx - g * 0.4, cy - g / 2.0, g * 0.9, g, true ]
        el
            cv.rect_to[ cx - g * 0.45, cy - g / 2.0, g * 0.3, g ]
            cv.rect_to[ cx + g * 0.15, cy - g / 2.0, g * 0.3, g ]
            cv.paint[]
        bx1 : f32 [ btn_x[ 1 ] + bs / 2.0 ]
        tri[ cv, bx1 - g * 0.6, cy - g * 0.4, g * 0.6, g * 0.8, false ]
        tri[ cv, bx1, cy - g * 0.4, g * 0.6, g * 0.8, false ]
        bx2 : f32 [ btn_x[ 2 ] + bs / 2.0 ]
        tri[ cv, bx2 - g * 0.6, cy - g * 0.4, g * 0.6, g * 0.8, true ]
        tri[ cv, bx2, cy - g * 0.4, g * 0.6, g * 0.8, true ]
        if [ !icons ] icons = FileIcons []
        vi : SVGModel icons.named[
            (muted || vol <= 0.0) ? 'volume_off' : 'volume_up', 24 ]
        if [ vi ]
            cv.stroke_color[ rgba['#ffffff'] ]
            iz : f32 [ round[ 22.0 * u ] ]
            cv.draw_svg[ vi, round[ btn_x[ 3 ] + (bs - iz) / 2.0 ],
                         round[ ry + (bs - iz) / 2.0 ], iz, iz ]
        # the sound's slider
        sx : f32 slider_x[]
        sw : f32 [ 80.0 * u ]
        sv : f32 [ (muted) ? 0.0 : vol ]
        sth : f32 [ 4.0 * u ]
        ctl_box[ cv, sx, cy - sth / 2.0, sw, sth, false, 0.165 ]
        cv.save[]
        cv.rounded[ sth / 2.0, sth / 2.0, sth / 2.0, sth / 2.0 ]
        cv.fill_color[ rgba['#ffffff'] ]
        cv.rect_to[ sx, cy - sth / 2.0, max[ sw * sv, sth ], sth ]
        cv.paint[]
        # its knob only under the pointer: at rest the track alone
        if [ hit == 'slider' || vol_drag ]
            vr : f32 [ 4.8 * u ]
            cv.rounded[ vr, vr, vr, vr ]
            cv.rect_to[ sx + sw * sv - vr, cy - vr, vr * 2.0,
                        vr * 2.0 ]
            cv.paint[]
        cv.restore[]
        # the time, in the tool font (orbiter's setting swaps it)
        tpx : i32 [ i32[ 17.0 * u ] ]
        cv.set_font[ shared_font[ cv,
            'fonts/BarlowCondensed-Regular.ttf', tpx ] ]
        cv.font_size[ tpx ]
        label[ cv, '{hms[ shown_t ]}  /  {hms[ clip.length ]}',
               sx + sw + 18.0 * u, cy - 7.0 * u, 200.0 * u, 0.0,
               '#ffffffdd' ]
        cv.paint[]
        cv.restore[]

    # a seconds ruler's step for this span: 1, 2 or 5 x 10^n
    func tick_of [ span: f64 ] -> f64
        st : f64 [ 0.001 ]
        while [ span / st > 12.0 ]
            if [ span / (st * 2.0) <= 12.0 ] return st * 2.0
            if [ span / (st * 5.0) <= 12.0 ] return st * 5.0
            st = st * 10.0
        return st

    # a texture of w x h made (or kept) and filled with px
    func tex_of [ cv: Canvas, tx: Texture, w: i32, h: i32, px: vec u8 ]
            -> Texture
        tt : Texture [ tx ]
        if [ !tt || tt.width != w || tt.height != h ]
            tt = Texture [ vk: cv.vk, w: cv.w, width: w, height: h,
                           linear: true, pixel_format: Pixel.rgba8,
                           surface: Surface.color, tag: 'wave' ]
        tt.upload[ @px[ 0 ], w * h * 4 ]
        return tt

    func label [ cv: Canvas, s: string, x: f32, y: f32, w: f32,
                 ax: f32, col: string ]
        cv.fill_color[ rgba[ col ] ]
        cv.draw_text[ s, rect [ x: x, y: y, w: w, h: 14.0 ],
            vec2f [ ax, 0.5 ], vec2f [ 0.0, 0.0 ],
            Overflow.visible, null, false ]

    # a panel: its ground, rounded, a hairline round it
    func panel [ cv: Canvas, x: f32, y: f32, w: f32, h: f32 ]
        cv.stroke_width[ 0.0 ]
        cv.fill_color[ rgba['#101018'] ]
        cv.rounded_rect[ x, y, w, h, 10.0, 10.0, 10.0, 10.0 ]
        cv.paint[]

    func hairline [ cv: Canvas, x: f32, y: f32, w: f32, h: f32 ]
        cv.fill_color[ rgba['#00000000'] ]
        cv.stroke_color[ rgba['#ffffff1a'] ]
        cv.stroke_width[ 1.0 ]
        cv.rounded_rect[ x + 0.5, y + 0.5, w - 1.0, h - 1.0,
                         10.0, 10.0, 10.0, 10.0 ]
        cv.paint[]
        cv.stroke_width[ 0.0 ]

    # a picture in a panel, cut to its rounded corners
    func panel_image [ cv: Canvas, tx: Texture, x: f32, y: f32, w: f32,
                       h: f32 ]
        cv.save[]
        cv.clip_rounded_rect[ x, y, w, h, 10.0, 10.0, 10.0, 10.0 ]
        cv.draw_image[ tx, rect [ x: x, y: y, w: w, h: h ] ]
        cv.restore[]

    # the ruler over the spectrogram (at most 256 px tall) over the
    # waveform; past that height the whole is centred
    func draw_wave [ cv: Canvas ]
        cv.reset[ vec4f[ 0.03, 0.03, 0.05, 1.0 ] ]
        pad : f32 [ 20.0 ]
        rul : f32 [ 26.0 ]
        gap : f32 [ 12.0 ]
        aw  : f32 [ bounds.w - pad * 2.0 ]
        room : f32 [ bounds.h - pad * 2.0 - rul - gap ]
        if [ aw < 32.0 || room < 32.0 ] return
        sh : f32 [ min[ 256.0, room * 0.62 ] ]
        wh : f32 [ min[ 140.0, room - sh ] ]
        tall : f32 [ rul + sh + gap + wh ]
        y0 : f32 [ max[ pad, (bounds.h - tall) * 0.5 ] ]
        px0 : f32 [ pad ]
        panel_x = px0
        panel_w = aw
        sy : f32 [ y0 + rul ]
        wy : f32 [ sy + sh + gap ]
        t : f64 now[]
        if [ !paused ]
            stop_at : f64 [ (sel_to > sel_from) ? sel_to : wave.length ]
            if [ t >= stop_at ]
                wave_halt[]
                at = stop_at
                t = at
        iw : i32 [ i32[ aw ] ]
        ish : i32 [ i32[ sh ] ]
        iwh : i32 [ i32[ wh ] ]
        key : string '{view_from} {view_to} {iw} {ish} {iwh}'
        if [ !spec_tex || key != pic_key ]
            sp : vec u8 wave.spec_picture[ view_from, view_to, iw, ish ]
            spec_tex = tex_of[ cv, spec_tex, iw, ish, sp ]
            wp : vec u8 wave.wave_picture[ view_from, view_to, iw, iwh ]
            wave_tex = tex_of[ cv, wave_tex, iw, iwh, wp ]
            pic_key = key
        span : f64 [ view_to - view_from ]
        panel[ cv, px0, sy, aw, sh ]
        panel_image[ cv, spec_tex, px0, sy, aw, sh ]
        panel[ cv, px0, wy, aw, wh ]
        # the centre line under the waveform
        cv.fill_color[ rgba['#ffffff12'] ]
        cv.rect_to[ px0 + 10.0, wy + wh * 0.5, aw - 20.0, 1.0 ]
        cv.paint[]
        panel_image[ cv, wave_tex, px0, wy, aw, wh ]
        cv.font_size[ 12 ]
        # hertz along the spectrogram's left edge, a faint line each
        top : f64 [ f64[ wave.rate ] * 0.5 ]
        hz : vec f64 [] [ 100.0, 1000.0, 10000.0 ]
        names : vec string [] [ '100 Hz', '1 kHz', '10 kHz' ]
        for [ k: i32 0, k < hz.count, k += 1 ]
            u : f64 [ log[ hz[ k ] / 30.0 ] / log[ top / 30.0 ] ]
            if [ u <= 0.0 || u >= 1.0 ] continue
            ly : f32 [ sy + sh * f32[ 1.0 - u ] ]
            cv.fill_color[ rgba['#ffffff14'] ]
            cv.rect_to[ px0, ly, aw, 1.0 ]
            cv.paint[]
            label[ cv, names[ k ], px0 + 8.0, ly - 15.0, 80.0, 0.0,
                   '#ffffffa0' ]
        # the chosen span over both panels: a wash, a bright edge each
        # side, a tab at the top
        if [ sel_to > sel_from ]
            fa : f64 [ max[ sel_from, view_from ] - view_from ]
            xa : f32 [ px0 + f32[ fa / span ] * aw ]
            xb : f32 [ px0 + f32[ (min[ sel_to, view_to ] - view_from)
                                  / span ] * aw ]
            if [ xb > xa ]
                cv.fill_color[ rgba['#806bff2e'] ]
                cv.rect_to[ xa, sy, xb - xa, wy + wh - sy ]
                cv.paint[]
                cv.fill_color[ rgba['#b3a6ffcc'] ]
                cv.rect_to[ xa, sy, 1.0, wy + wh - sy ]
                cv.rect_to[ xb - 1.0, sy, 1.0, wy + wh - sy ]
                cv.paint[]
                cv.fill_color[ rgba['#806bff'] ]
                cv.rounded_rect[ xa, sy - 6.0, xb - xa, 6.0,
                                 3.0, 3.0, 0.0, 0.0 ]
                cv.paint[]
        hairline[ cv, px0, sy, aw, sh ]
        hairline[ cv, px0, wy, aw, wh ]
        # the ruler: a tick and its seconds every step, a smaller one
        # at each fifth
        st : f64 tick_of[ span ]
        mn : f64 [ st / 5.0 ]
        tk : f64 [ f64[ i64[ view_from / mn ] ] * mn ]
        while [ tk <= view_to ]
            if [ tk >= view_from ]
                x : f32 [ px0 + f32[ (tk - view_from) / span ] * aw ]
                nr : f64 [ f64[ i64[ tk / st + 0.5 ] ] ]
                big : bool [ abs[ tk / st - nr ] < 0.001 ]
                cv.fill_color[ rgba[ (big) ? '#ffffff66'
                                           : '#ffffff26' ] ]
                cv.rect_to[ x, sy - ((big) ? 9.0 : 5.0), 1.0,
                            (big) ? 9.0 : 5.0 ]
                cv.paint[]
                if [ big ]
                    label[ cv, '{f32[ tk ]} s', x + 4.0, y0, 80.0, 0.0,
                           '#ffffffb0' ]
            tk += mn
        # the play line, with a soft glow
        if [ t >= view_from && t <= view_to ]
            cx : f32 [ px0 + f32[ (t - view_from) / span ] * aw ]
            cv.fill_color[ rgba['#ff84ff30'] ]
            cv.rect_to[ cx - 3.0, sy, 7.0, wy + wh - sy ]
            cv.paint[]
            cv.fill_color[ rgba['#ff9cff'] ]
            cv.rect_to[ cx - 0.5, sy, 2.0, wy + wh - sy ]
            cv.paint[]
