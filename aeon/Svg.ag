# an .svg opened in the 2D mode: its shapes listed, drawn flat,
# their points moved and written back into the file
extend aeon

# the transform undoing m
func affine_inverse [ m: affine ] -> affine
    det : f32 [ m.ma * m.md - m.mb * m.mc ]
    if [ abs[ det ] < 1.0e-12 ] det = 1.0e-12
    ia : f32 [ m.md / det ]
    ib : f32 [ 0.0 - m.mb / det ]
    ic : f32 [ 0.0 - m.mc / det ]
    id : f32 [ m.ma / det ]
    return affine [ ma: ia, mb: ib, mc: ic, md: id,
                    tx: 0.0 - (ia * m.tx + ib * m.ty),
                    ty: 0.0 - (ic * m.tx + id * m.ty) ]

# a presentation value of an element: its style's, else its own
func svg_value [ nd: SVGNode, key: string ] -> string
    st : nd.attr[ 'style' ]
    if [ st ]
        for [ part: string ] in st.split[ ';' ]
            at : i32 [ part.index_of[ ':' ] ]
            if [ at <= 0 ] continue
            if [ part.mid[ 0, at ].trim[].compare[ key ] == 0 ]
                return part.mid[ at + 1, part.count - at - 1 ].trim[]
    v : nd.attr[ key ]
    return (v) ? v : ''

# a value set on a shape's element (its style's copy goes: the
# style would win) and on the shape as drawn
func svg_set [ sh: SVGShape, key: string, text: string ]
    nd : sh.node
    if [ !nd ] return
    if [ !nd.attrs ] nd.attrs = map string [ string ] []
    # a <text>'s words are its content, not an attribute
    if [ key.compare[ 'text' ] == 0 ]
        nd.text = '{text}'
        nd.children = vec SVGNode []
        svg_retext[ sh ]
        return
    # a copy: the set below frees the map's own string
    got : svg_value[ nd, key ]
    was : '{got}'
    nd.attrs.set[ key, text ]
    st : nd.attr[ 'style' ]
    if [ st ]
        kept : ''
        for [ part: string ] in st.split[ ';' ]
            at : i32 [ part.index_of[ ':' ] ]
            name : part.mid[ 0, (at > 0) ? at : 0 ].trim[]
            if [ at > 0 && name.compare[ key ] == 0 ] continue
            if [ part.trim[].count == 0 ] continue
            kept = (kept.count == 0) ? part : '{kept};{part}'
        nd.attrs.set[ 'style', kept ]
    # a plain colour (or none) in place of a gradient
    if [ key.compare[ 'fill' ] == 0 ]
        sh.fill_none = text.compare[ 'none' ] == 0
        if [ !sh.fill_none ] sh.fill = svg_color[ text ]
        sh.fill_url = ''
        sh.fill_paint = null
    el [ key.compare[ 'stroke' ] == 0 ]
        sh.stroke_none = text.compare[ 'none' ] == 0
        if [ !sh.stroke_none ] sh.stroke = svg_color[ text ]
        sh.stroke_url = ''
        sh.stroke_paint = null
    el [ key.compare[ 'stroke-width' ] == 0 ]
        sh.sw = f32[ text ]
    el [ key.compare[ 'opacity' ] == 0 ]
        sh.opacity = f32[ text ]
    el [ key.compare[ 'stroke-linecap' ] == 0 ]
        sh.cap = svg_cap_of[ text ]
    el [ key.compare[ 'stroke-linejoin' ] == 0 ]
        sh.join = svg_join_of[ text ]
    el [ key.compare[ 'id' ] == 0 ]
        sh.id = text
    el [ svg_font_keys[].index_of[ key ] >= 0 ]
        svg_retext[ sh ]
    el [ key.compare[ 'transform' ] == 0 ]
        # the points stay where they are in the element's own
        # space: the parent's, then the new transform
        old : svg_parse_transform[ was ]
        if [ was.count == 0 ] old = affine.identity[]
        fresh : svg_parse_transform[ text ]
        if [ text.count == 0 ] fresh = affine.identity[]
        # one that flattens the shape cannot be taken back: kept
        if [ abs[ fresh.ma * fresh.md - fresh.mb * fresh.mc ] < 1e-12 ]
            nd.attrs.set[ key, was ]
            return
        parent : sh.space.multiply[ affine_inverse[ old ] ]
        moved : parent.multiply[ fresh ]
        back : affine_inverse[ sh.space ]
        for [ k: i32 0, k < sh.cmds.count, k += 1 ]
            c : sh.cmds[ k ]
            sh.cmds[ k ] = SVGCmd [ op: c.op,
                x:  remap_x[ back, moved, c.x, c.y ],
                y:  remap_y[ back, moved, c.x, c.y ],
                x1: remap_x[ back, moved, c.x1, c.y1 ],
                y1: remap_y[ back, moved, c.x1, c.y1 ],
                x2: remap_x[ back, moved, c.x2, c.y2 ],
                y2: remap_y[ back, moved, c.x2, c.y2 ] ]
        # what the shape holds on the page goes with it: its
        # gradients' placement, its blur and glow by the scale
        delta : moved.multiply[ back ]
        if [ sh.fill_paint ]
            sh.fill_paint.to_page = delta.multiply[
                sh.fill_paint.to_page ]
        if [ sh.stroke_paint ]
            sh.stroke_paint.to_page = delta.multiply[
                sh.stroke_paint.to_page ]
        k : f32 [ sqrt[ abs[ delta.ma * delta.md
                             - delta.mb * delta.mc ] ] ]
        sh.blur = sh.blur * k
        sh.glow = sh.glow * k
        sh.shadow = sh.shadow * k
        sx : f32 [ sh.shadow_x ]
        sh.shadow_x = delta.ma * sx + delta.mb * sh.shadow_y
        sh.shadow_y = delta.mc * sx + delta.md * sh.shadow_y
        sh.space = moved

# a <text>'s own font values, shown and set as rows
func svg_font_keys [] -> vec string
    return vec string [] [ 'font-family', 'font-size', 'font-weight',
                           'font-style', 'text-anchor' ]

# a <text>'s glyphs made again from its element (its own values
# over svg's defaults)
func svg_retext [ sh: SVGShape ]
    nd : sh.node
    base : SVGState [ fill: vec4f [ 0.0, 0.0, 0.0, 1.0 ],
        stroke: vec4f [ 0.0, 0.0, 0.0, 0.0 ], sw: 1.0,
        fill_none: false, stroke_none: true, fill_opacity: 1.0,
        stroke_opacity: 1.0, opacity: 1.0, cap: 0, join: 0,
        miter: 4.0, font_size: 16.0, weight: 400, slope: 0,
        anchor: 0 ]
    st : SVGState svg_resolve_state[ nd, base ]
    fam : string svg_family_of[ nd, 'sans-serif' ]
    sh.cmds = svg_text_cmds[ svg_text_of[ nd ], fam, st,
        nd.attr_f[ 'x', 0.0 ], nd.attr_f[ 'y', 0.0 ], sh.space ]

# text as xml character data
func svg_escape [ t: string ] -> string
    out : ''
    for [ i: i64 0, i < t.count, i += 1 ]
        ch : t.mid[ i, 1 ]
        if [ ch == '&' ] ch = '&amp;'
        el [ ch == '<' ] ch = '&lt;'
        el [ ch == '>' ] ch = '&gt;'
        out = '{out}{ch}'
    return out

# a point taken back by one transform and out by another
func remap_x [ back: affine, out: affine, x: f32, y: f32 ] -> f32
    return out.apply_x[ back.apply_x[ x, y ], back.apply_y[ x, y ] ]

func remap_y [ back: affine, out: affine, x: f32, y: f32 ] -> f32
    return out.apply_y[ back.apply_x[ x, y ], back.apply_y[ x, y ] ]

# one point of a shape: its command and which of its three
# (0 the end, 1 and 2 a curve's handles)
class SvgPoint
    public cmd  : i32
    public slot : i32

# a shape's commands as they were before a move: its undo
class SvgUndo
    public shape : i32
    public cmds  : vec SVGCmd
    # or a property's value before (shape or document)
    public row   : PropRow
    public was   : string
    # or the whole text before (an element added)
    public text  : string

# a row of the outliner: a shape (kind 5, n its number) or a
# group (kind 6, its span in the text)
class SvgRow
    public text  : string
    public depth : i32
    public kind  : i32
    public n     : i32
    public at    : i64
    public end   : i64

# a shape's filter as aeon writes it: blur, glow and drop
# shadow (element units; colours sRGB r g b a, alpha 0 none)
class SvgFx
    public blur     : f32
    public glow     : f32
    public gain     : f32 [ 1.0 ]
    public glow_rgb : vec f32
    public shadow   : f32
    public shadow_x : f32
    public shadow_y : f32
    public shade_rgb : vec f32

class SvgDoc
    public file   : path
    public model  : SVGModel
    # the chosen shape (-1 none) and the shapes changed since the
    # last save
    public chosen : i32 [ -1 ]
    # more shapes chosen with it (shift): a boolean's other shapes
    public also   : vec i32
    # a new drawing never saved: its file is a working copy, and a
    # save asks where
    public untitled : bool
    public dirty  : vec i32
    # the <svg> element: the document's own values
    public root   : SVGNode
    # its head changed in memory; the text differs from the file
    public root_dirty : bool
    public changed    : bool
    # moves and property edits, last on top
    public undo     : vec SvgUndo
    # a property to set back, for the app (it owns the rows)
    public undo_row : PropRow
    public undo_was : string
    # text put in at places of the text read, at the next compose
    public insert_at   : vec i64
    public insert_text : vec string
    # shapes whose effects are held (not yet in the text), and
    # the id each one's filter is written under
    public fx_on    : vec i32
    public fx_names : vec string

    func init []
        model = SVGModel [ file ]
        dirty = vec i32 []
        fx_on = vec i32 []
        fx_names = vec string []
        also  = vec i32 []
        undo  = vec SvgUndo []
        root  = root_of[]

    # a property about to change: its value before, once for a
    # run of changes to the same field
    func note_prop [ r: PropRow, was: string ]
        if [ undo.count > 0 ]
            top : undo[ undo.count - 1 ]
            if [ top.row && top.row.kind == r.kind
                 && top.row.name.compare[ r.name ] == 0
                 && top.row.pass.compare[ r.pass ] == 0 ] return
        undo.push[ SvgUndo [ shape: -1, row: r, was: was ] ]

    # the <svg> element of the text read
    func root_of [] -> SVGNode
        parser : SVGParser []
        top : parser.parse_doc[ model.source ]
        if [ !top || top.tag == 'svg' ] return top
        for [ c: SVGNode ] in top.children
            if [ c.tag == 'svg' ] return c
        return null

    # a document value: the text remade in memory, read again
    func set_root [ key: string, text: string ]
        if [ !root ] return
        if [ !root.attrs ] root.attrs = map string [ string ] []
        root.attrs.set[ key, text ]
        root_dirty = true
        txt : compose[]
        keep_chosen : i32 [ chosen ]
        model.load[ txt ]
        chosen = keep_chosen
        clear_held[]
        root = root_of[]
        root_dirty = false
        changed = true

    # the <svg> element's open tag from its values
    func root_text [] -> string
        out : '<svg'
        if [ root.attrs ]
            for [ v: string, k: string ] in root.attrs
                out = '{out} {k}="{v}"'
        if [ root.tail_at <= root.head_end ] return '{out}/>'
        return '{out}>'

    func count [] -> i32
        if [ !model || !model.shapes ] return 0
        return model.shapes.count

    # a shape's name: its id, else its tag and number
    func name_of [ i: i32 ] -> string
        sh : model.shapes[ i ]
        if [ sh.id && sh.id.count > 0 ] return sh.id
        tag : string [ (sh.node) ? sh.node.tag : 'shape' ]
        return '{tag} {i + 1}'

    func mark [ i: i32 ]
        if [ dirty.index_of[ i ] < 0 ] dirty.push[ i ]
        follow[ i, 0 ]

    # a <text> element: its shape is its glyphs
    func is_text [ i: i32 ] -> bool
        if [ i < 0 || i >= count[] ] return false
        nd : model.shapes[ i ].node
        return nd && nd.tag.compare[ 'text' ] == 0

    # a linked offset's source (-1 none): its href, by id
    func offset_src [ i: i32 ] -> i32
        nd : model.shapes[ i ].node
        if [ !nd ] return -1
        kind : nd.attr[ 'sodipodi:type' ]
        if [ !kind || kind.compare[ 'inkscape:offset' ] != 0 ]
            return -1
        link : nd.attr[ 'xlink:href' ]
        if [ !link ] link = nd.attr[ 'href' ]
        if [ !link || !link.starts_with[ '#' ] ] return -1
        want : link.mid[ 1, link.count - 1 ]
        for [ k: i32 0, k < count[], k += 1 ]
            sid : model.shapes[ k ].id
            if [ k != i && sid && sid.compare[ want ] == 0 ] return k
        return -1

    # a linked offset's distance (inkscape:radius)
    func radius_of [ i: i32 ] -> f32
        nd : model.shapes[ i ].node
        v : (nd) ? nd.attr[ 'inkscape:radius' ] : null
        if [ !v ] return 0.0
        return f32[ v ]

    # the offsets linked to a shape made again from it
    func follow [ i: i32, depth: i32 ]
        if [ depth > 8 ] return
        for [ j: i32 0, j < count[], j += 1 ]
            if [ j == i || offset_src[ j ] != i ] continue
            remake_offset[ j, i ]
            if [ dirty.index_of[ j ] < 0 ] dirty.push[ j ]
            follow[ j, depth + 1 ]

    func remake_offset [ j: i32, src: i32 ]
        sh : model.shapes[ j ]
        from_cmds : model.shapes[ src ].cmds
        sh.cmds = offset_cmds[ from_cmds, radius_of[ j ] ]
        sh.node.attrs.set[ 'inkscape:original', path_data[ src ] ]

    # a linked offset's distance set; its outline made again
    func set_radius [ i: i32, r: f32 ]
        src : offset_src[ i ]
        if [ src < 0 ] return
        model.shapes[ i ].node.attrs.set[ 'inkscape:radius',
                                          num_text[ r, false ] ]
        remake_offset[ i, src ]
        mark[ i ]

    # a free id from a stem: stem, then stem-2, stem-3 ...
    func free_id [ stem: string ] -> string
        n : i32 [ 1 ]
        while [ true ]
            nm : string [ (n == 1) ? stem : '{stem}-{n}' ]
            taken : bool [ false ]
            for [ sh: SVGShape ] in model.shapes
                if [ sh.id && sh.id.compare[ nm ] == 0 ] taken = true
            if [ !taken ] return nm
            n += 1
        return stem

    # a linked offset of shape i at distance r, put just before
    # it (Inkscape's form: its type, radius, original and href);
    # the new shape's number, -1 when none was made
    func make_offset [ i: i32, r: f32 ] -> i32
        sh : model.shapes[ i ]
        nd : sh.node
        if [ !nd ] return -1
        undo.push[ SvgUndo [ shape: -1, text: compose[] ] ]
        insert_at   = vec i64 []
        insert_text = vec string []
        # the source needs an id to be linked by
        sid : string [ sh.id ]
        if [ !sid || sid.count == 0 ]
            sid = free_id[ nd.tag ]
            insert_at.push[ nd.at + 1 + nd.tag.count ]
            insert_text.push[ ' id="{sid}"' ]
        # the namespaces the link's names are in
        names : vec string [] [ 'xmlns:sodipodi', 'xmlns:inkscape',
                                'xmlns:xlink' ]
        urls : vec string [] [
            'http://sodipodi.sourceforge.net/DTD/sodipodi-0.dtd',
            'http://www.inkscape.org/namespaces/inkscape',
            'http://www.w3.org/1999/xlink' ]
        for [ k: i32 0, k < names.count, k += 1 ]
            if [ root && !root.attr[ names[ k ] ] ]
                if [ !root.attrs ] root.attrs = map string [ string ] []
                root.attrs.set[ names[ k ], urls[ k ] ]
                root_dirty = true
        oid : free_id[ '{sid}-offset' ]
        out : '<path id="{oid}" sodipodi:type="inkscape:offset"'
        rt : num_text[ r, false ]
        orig : path_data[ i ]
        out = '{out} inkscape:radius="{rt}"'
        out = '{out} inkscape:original="{orig}" xlink:href="#{sid}"'
        for [ k: string ] in vec string [] [ 'fill', 'stroke',
                'stroke-width', 'opacity' ]
            v : svg_value[ nd, k ]
            if [ v.count > 0 ] out = '{out} {k}="{v}"'
        tf : nd.attr[ 'transform' ]
        if [ tf ] out = '{out} transform="{tf}"'
        d : cmds_data[ offset_cmds[ sh.cmds, r ], sh.space ]
        out = '{out} d="{d}"/>'
        # on its own line, indented as the source is: behind it
        # when outward, in front of it when inward
        src : model.source
        b : i64 [ nd.at ]
        while [ b > 0 && (src.chars[ b - 1 ] == 32
                          || src.chars[ b - 1 ] == 9) ]
            b -= 1
        indent : src.mid[ b, nd.at - b ]
        front : bool [ r < 0.0 ]
        insert_at.push[ (front) ? nd.end : nd.at ]
        insert_text.push[ (front) ? '\n{indent}{out}'
                                  : '{out}\n{indent}' ]
        txt : compose[]
        insert_at.clear[]
        insert_text.clear[]
        model.load[ txt ]
        clear_held[]
        root = root_of[]
        root_dirty = false
        changed = true
        also.clear[]
        chosen = (front) ? i + 1 : i
        return chosen

    # the parent of the element starting at `at` (null: none)
    func parent_of [ nd: SVGNode, at: i64 ] -> SVGNode
        if [ !nd || !nd.children ] return null
        for [ c: SVGNode ] in nd.children
            if [ c.at == at ] return nd
            found : parent_of[ c, at ]
            if [ found ] return found
        return null

    # an element that draws (not a title, desc, defs ...)
    func draws [ nd: SVGNode ] -> bool
        tags : vec string [] [ 'path', 'rect', 'circle', 'ellipse',
            'line', 'polyline', 'polygon', 'g', 'text', 'use',
            'image' ]
        return tags.index_of[ nd.tag ] >= 0

    # shape i one step up (later: drawn over its neighbour) or
    # down among its parent's elements; the text of the two
    # swapped, the space between kept; false when at the end
    func restack [ i: i32, up: bool ] -> bool
        if [ i < 0 || i >= count[] ] return false
        txt : compose[]
        model.load[ txt ]
        clear_held[]
        root = root_of[]
        root_dirty = false
        nd : model.shapes[ i ].node
        if [ !nd ] return false
        top : SVGParser []
        whole : top.parse_doc[ model.source ]
        par : parent_of[ whole, nd.at ]
        if [ !par ] return false
        at : i32 [ -1 ]
        for [ k: i32 0, k < par.children.count, k += 1 ]
            if [ par.children[ k ].at == nd.at ] at = k
        # the next element that draws, that way
        step : i32 [ (up) ? 1 : -1 ]
        k : i32 [ at + step ]
        while [ k >= 0 && k < par.children.count
                && !draws[ par.children[ k ] ] ]
            k += step
        if [ k < 0 || k >= par.children.count ] return false
        undo.push[ SvgUndo [ shape: -1, text: txt ] ]
        a : SVGNode [ (up) ? par.children[ at ] : par.children[ k ] ]
        b : SVGNode [ (up) ? par.children[ k ] : par.children[ at ] ]
        src : model.source
        head : src.mid[ 0, a.at ]
        first : src.mid[ a.at, a.end - a.at ]
        gap : src.mid[ a.end, b.at - a.end ]
        second : src.mid[ b.at, b.end - b.at ]
        tail : src.mid[ b.end, src.count - b.end ]
        # where the moved element starts now
        lands : i64 [ (up) ? a.at + (b.end - b.at) + (b.at - a.end)
                           : a.at ]
        model.load[ '{head}{second}{gap}{first}{tail}' ]
        root = root_of[]
        changed = true
        also.clear[]
        for [ n: i32 0, n < count[], n += 1 ]
            sn : model.shapes[ n ].node
            if [ sn && sn.at == lands ]
                chosen = n
                return true
        # a group moved: its first shape
        for [ n: i32 0, n < count[], n += 1 ]
            sn : model.shapes[ n ].node
            if [ sn && sn.at >= lands ]
                chosen = n
                return true
        return true

    # one shape chosen alone (-1: none)
    func choose_one [ i: i32 ]
        chosen = i
        also.clear[]

    # shift + a shape: in the choice, or out of it
    func toggle [ i: i32 ]
        if [ i < 0 ] return
        if [ chosen < 0 ]
            chosen = i
            return
        if [ i == chosen ]
            chosen = -1
            if [ also.count > 0 ]
                chosen = also[ also.count - 1 ]
                also.pop[]
            return
        at : i32 [ also.index_of[ i ] ]
        if [ at >= 0 ]
            also.remove[ at ]
        el
            also.push[ i ]

    func is_chosen [ i: i32 ] -> bool
        return i == chosen || also.index_of[ i ] >= 0

    # every chosen shape, in drawing order
    func selected [] -> vec i32
        out : vec i32 []
        for [ i: i32 0, i < count[], i += 1 ]
            if [ is_chosen[ i ] ] out.push[ i ]
        return out

    # shape i written again as a path with its own attributes
    # (not its geometry, nor a link it had) and path data d
    func path_text [ i: i32, d: string ] -> string
        nd : model.shapes[ i ].node
        skip : vec string [] [ 'd', 'x', 'y', 'width', 'height', 'rx',
            'ry', 'cx', 'cy', 'r', 'x1', 'y1', 'x2', 'y2', 'points',
            'sodipodi:type', 'inkscape:radius', 'inkscape:original',
            'xlink:href', 'sodipodi:nodetypes' ]
        out : '<path'
        if [ nd.attrs ]
            for [ v: string, k: string ] in nd.attrs
                if [ skip.index_of[ k ] >= 0 ] continue
                # an emptied value: the attribute left out
                if [ !v || v.count == 0 ] continue
                out = '{out} {k}="{v}"'
        out = '{out} d="{d}"'
        src : model.source
        if [ nd.tail_at <= nd.head_end ] return '{out}/>'
        inner : src.mid[ nd.head_end, nd.tail_at - nd.head_end ]
        return '{out}>{inner}</path>'

    # the chosen shapes made one: 0 union, 1 the bottom one less
    # the rest, 2 their intersection; it takes the bottom one's
    # place and attributes, the others go; curves kept
    func combine [ op: i32 ] -> bool
        ids : selected[]
        if [ ids.count < 2 ] return false
        txt : compose[]
        undo.push[ SvgUndo [ shape: -1, text: txt ] ]
        model.load[ txt ]
        clear_held[]
        root = root_of[]
        root_dirty = false
        base : i32 [ ids[ 0 ] ]
        result : vec SVGCmd [ model.shapes[ base ].cmds ]
        for [ k: i32 1, k < ids.count, k += 1 ]
            other : model.shapes[ ids[ k ] ].cmds
            result = boolean_cmds[ result, other, op ]
        nd : model.shapes[ base ].node
        d : cmds_data[ result, model.shapes[ base ].space ]
        starts : vec i64 []
        stops  : vec i64 []
        texts  : vec string []
        starts.push[ nd.at ]
        stops.push[ nd.end ]
        texts.push[ path_text[ base, d ] ]
        src : model.source
        for [ k: i32 1, k < ids.count, k += 1 ]
            gone : model.shapes[ ids[ k ] ].node
            # its line goes with it
            starts.push[ line_start[ gone ] ]
            stops.push[ gone.end ]
            texts.push[ '' ]
        # last first
        order : vec i32 []
        for [ k: i32 0, k < starts.count, k += 1 ]
            order.push[ k ]
        for [ x: i32 0, x < order.count, x += 1 ]
            for [ y: i32 x + 1, y < order.count, y += 1 ]
                if [ starts[ order[ y ] ] > starts[ order[ x ] ] ]
                    keep : i32 [ order[ x ] ]
                    order[ x ] = order[ y ]
                    order[ y ] = keep
        out : string [ src ]
        for [ k: i32 ] in order
            head : out.mid[ 0, starts[ k ] ]
            tail : out.mid[ stops[ k ], out.count - stops[ k ] ]
            out = '{head}{texts[ k ]}{tail}'
        model.load[ out ]
        root = root_of[]
        changed = true
        also.clear[]
        chosen = -1
        for [ n: i32 0, n < count[], n += 1 ]
            sn : model.shapes[ n ].node
            if [ sn && sn.at == nd.at ] chosen = n
        return true

    # where an element's text starts with its line (the spaces
    # before it and the line break before those)
    func line_start [ nd: SVGNode ] -> i64
        src : model.source
        b : i64 [ nd.at ]
        while [ b > 0 && (src.chars[ b - 1 ] == 32
                          || src.chars[ b - 1 ] == 9) ]
            b -= 1
        if [ b > 0 && src.chars[ b - 1 ] == 10 ] b -= 1
        return b

    # the chosen shapes' elements taken out of the text, one undo
    func delete_chosen [] -> bool
        ids : selected[]
        if [ ids.count == 0 ] return false
        txt : compose[]
        undo.push[ SvgUndo [ shape: -1, text: txt ] ]
        model.load[ txt ]
        clear_held[]
        root = root_of[]
        root_dirty = false
        out : string [ model.source ]
        # last first: the earlier spans stay put
        for [ k: i32 ids.count - 1, k >= 0, k -= 1 ]
            nd : model.shapes[ ids[ k ] ].node
            if [ !nd ] continue
            b : line_start[ nd ]
            head : out.mid[ 0, b ]
            tail : out.mid[ nd.end, out.count - nd.end ]
            out = '{head}{tail}'
        model.load[ out ]
        root = root_of[]
        changed = true
        also.clear[]
        chosen = -1
        return true

    # the shape whose element starts at `at` (-1 none)
    func shape_index_at [ at: i64 ] -> i32
        for [ n: i32 0, n < count[], n += 1 ]
            nd : model.shapes[ n ].node
            if [ nd && nd.at == at ] return n
        return -1

    # the shapes inside a span of the text (a group's)
    func shapes_in [ at: i64, end: i64 ] -> vec i32
        out : vec i32 []
        for [ n: i32 0, n < count[], n += 1 ]
            nd : model.shapes[ n ].node
            if [ nd && nd.at >= at && nd.end <= end ] out.push[ n ]
        return out

    # the outliner's rows: groups and shapes, the last drawn
    # first at each level, a group's own a level in
    func rows [] -> vec SvgRow
        out : vec SvgRow []
        if [ root ] walk_rows[ root, 0, out ]
        return out

    func walk_rows [ nd: SVGNode, depth: i32, out: vec SvgRow ]
        if [ !nd.children ] return
        for [ k: i32 nd.children.count - 1, k >= 0, k -= 1 ]
            c : nd.children[ k ]
            if [ c.tag == 'g' ]
                gid : c.attr[ 'id' ]
                out.push[ SvgRow [ text: (gid) ? gid : 'group',
                    depth: depth, kind: 6, n: -1, at: c.at,
                    end: c.end ] ]
                walk_rows[ c, depth + 1, out ]
                continue
            i : shape_index_at[ c.at ]
            if [ i >= 0 ]
                out.push[ SvgRow [ text: name_of[ i ], depth: depth,
                    kind: 5, n: i, at: c.at, end: c.end ] ]

    # a shape's parent's space: its own transform taken back out
    func parent_space [ i: i32 ] -> affine
        sh : model.shapes[ i ]
        own : sh.node.attr[ 'transform' ]
        if [ !own || own.count == 0 ] return sh.space
        return sh.space.multiply[ affine_inverse[
            svg_parse_transform[ own ] ] ]

    func matrix_text [ m: affine ] -> string
        a : num_text[ m.ma, false ]
        b : num_text[ m.mc, false ]
        c : num_text[ m.mb, false ]
        d : num_text[ m.md, false ]
        e : num_text[ m.tx, false ]
        f : num_text[ m.ty, false ]
        return 'matrix({a},{b},{c},{d},{e},{f})'

    func is_identity [ m: affine ] -> bool
        return abs[ m.ma - 1.0 ] < 1e-6 && abs[ m.mb ] < 1e-6
            && abs[ m.mc ] < 1e-6 && abs[ m.md - 1.0 ] < 1e-6
            && abs[ m.tx ] < 1e-6 && abs[ m.ty ] < 1e-6

    # an id no element of the text has: stem-1, stem-2 ...
    func free_element_id [ stem: string ] -> string
        n : i32 [ 1 ]
        while [ true ]
            nm : '{stem}-{n}'
            if [ model.source.index_of[ 'id="{nm}"' ] < 0 ] return nm
            n += 1
        return stem

    # spans replaced last first; longer first at one start
    func with_spans [ src: string, starts: vec i64, stops: vec i64,
                      texts: vec string ] -> string
        order : vec i32 []
        for [ k: i32 0, k < starts.count, k += 1 ]
            order.push[ k ]
        for [ x: i32 0, x < order.count, x += 1 ]
            for [ y: i32 x + 1, y < order.count, y += 1 ]
                a : i32 [ order[ x ] ]
                b : i32 [ order[ y ] ]
                if [ starts[ b ] > starts[ a ]
                     || (starts[ b ] == starts[ a ]
                         && stops[ b ] > stops[ a ]) ]
                    keep : i32 [ order[ x ] ]
                    order[ x ] = order[ y ]
                    order[ y ] = keep
        out : string [ src ]
        for [ k: i32 ] in order
            head : out.mid[ 0, starts[ k ] ]
            tail : out.mid[ stops[ k ], out.count - stops[ k ] ]
            out = '{head}{texts[ k ]}{tail}'
        return out

    # shape i's blur: its gaussian in the element's units (0 none)
    func blur_of [ i: i32 ] -> f32
        if [ i < 0 || i >= count[] ] return 0.0
        return fx_of[ i ].blur

    # shape i's effects as held on the shape (element units;
    # colours sRGB r g b a, alpha 0 none)
    func fx_of [ i: i32 ] -> SvgFx
        sh : model.shapes[ i ]
        k : f32 [ max[ unit_scale[ i ], 1e-6 ] ]
        back : sh.space.inverse[]
        gc : sh.glow_color
        sc : sh.shadow_color
        return SvgFx [ blur: sh.blur / k, glow: sh.glow / k,
            gain: sh.glow_gain,
            glow_rgb: vec f32 [] [ gc.x, gc.y, gc.z, gc.w ],
            shadow: sh.shadow / k,
            shadow_x: back.ma * sh.shadow_x + back.mb * sh.shadow_y,
            shadow_y: back.mc * sh.shadow_x + back.md * sh.shadow_y,
            shade_rgb: vec f32 [] [ sc.x, sc.y, sc.z, sc.w ] ]

    # Inkscape's blur percent p: its radius (page units) is
    # (p / 100)^2 x the box's width + height / 4, the box the
    # shape's drawn bounds (stroke in)
    func blur_base [ i: i32 ] -> f32
        bx : blur_box[ i ]
        return bx[ 0 ] + bx[ 1 ]

    # shape i's drawn width and height (page units, stroke in)
    func blur_box [ i: i32 ] -> vec f32
        sh : model.shapes[ i ]
        x0 : f32 [ 1e30 ]
        y0 : f32 [ 1e30 ]
        x1 : f32 [ -1e30 ]
        y1 : f32 [ -1e30 ]
        px : f32 [ 0.0 ]
        py : f32 [ 0.0 ]
        for [ c: SVGCmd ] in sh.cmds
            if [ c.op == SVGOp.close ] continue
            # a curve sampled: its handles overreach the box
            n : i32 [ (c.op == SVGOp.cubic || c.op == SVGOp.quad)
                      ? 16 : 1 ]
            for [ k: i32 1, k <= n, k += 1 ]
                t : f32 [ k / f32[ n ] ]
                u : f32 [ 1.0 - t ]
                x : f32 [ c.x ]
                y : f32 [ c.y ]
                if [ c.op == SVGOp.cubic ]
                    x = u * u * u * px + 3.0 * u * u * t * c.x1
                        + 3.0 * u * t * t * c.x2 + t * t * t * c.x
                    y = u * u * u * py + 3.0 * u * u * t * c.y1
                        + 3.0 * u * t * t * c.y2 + t * t * t * c.y
                el [ c.op == SVGOp.quad ]
                    x = u * u * px + 2.0 * u * t * c.x1 + t * t * c.x
                    y = u * u * py + 2.0 * u * t * c.y1 + t * t * c.y
                x0 = min[ x0, x ]
                y0 = min[ y0, y ]
                x1 = max[ x1, x ]
                y1 = max[ y1, y ]
            px = c.x
            py = c.y
        if [ x1 < x0 ] return vec f32 [] [ 0.0, 0.0 ]
        sw : f32 [ (sh.stroke_none) ? 0.0 : sh.sw ]
        return vec f32 [] [ x1 - x0 + sw, y1 - y0 + sw ]

    # the element's units a page unit (its transforms' mean scale)
    func unit_scale [ i: i32 ] -> f32
        m : model.shapes[ i ].space
        return sqrt[ abs[ m.ma * m.md - m.mb * m.mc ] ]

    # shape i's blur as Inkscape's percent (0 none)
    func blur_percent [ i: i32 ] -> f32
        if [ i < 0 || i >= count[] ] return 0.0
        return percent_of[ i, blur_of[ i ] ]

    # shape i's blur set by Inkscape's percent
    func set_blur_percent [ i: i32, p: f32 ]
        if [ i < 0 || i >= count[] ] return
        set_blur[ i, sd_of[ i, p ] ]

    # shape i's glow halo (element units, 0 none)
    func glow_of [ i: i32 ] -> f32
        if [ i < 0 || i >= count[] ] return 0.0
        return fx_of[ i ].glow

    # an element-unit gaussian as Inkscape's percent of shape i
    func percent_of [ i: i32, sd: f32 ] -> f32
        base : f32 [ blur_base[ i ] ]
        if [ sd <= 0.0 || base <= 0.0 ] return 0.0
        r : f32 [ sd * unit_scale[ i ] ]
        return round[ sqrt[ r * 4.0 / base ] * 1000.0 ] / 10.0

    # a percent of shape i as an element-unit gaussian
    func sd_of [ i: i32, p: f32 ] -> f32
        f : f32 [ clamp[ p, 0.0, 100.0 ] / 100.0 ]
        k : f32 [ max[ unit_scale[ i ], 1e-6 ] ]
        return f * f * blur_base[ i ] / 4.0 / k

    func glow_percent [ i: i32 ] -> f32
        if [ i < 0 || i >= count[] ] return 0.0
        return percent_of[ i, glow_of[ i ] ]

    # shape i's glow by percent: its halo by Inkscape's blur rule,
    # brightened 1 + 3 x the percent / 100
    func set_glow_percent [ i: i32, p: f32 ]
        if [ i < 0 || i >= count[] ] return
        fx : fx_of[ i ]
        fx.glow = sd_of[ i, p ]
        fx.gain = 1.0 + 3.0 * clamp[ p, 0.0, 100.0 ] / 100.0
        set_fx[ i, fx ]

    # a colour row's linear text as sRGB r g b a ('' none)
    func srgb_of [ t: string ] -> vec f32
        out : vec f32 [] [ 0.0, 0.0, 0.0, 0.0 ]
        nums : numbers_of[ t ]
        if [ nums.count < 3 ] return out
        for [ k: i32 0, k < 3, k += 1 ]
            out[ k ] = pow[ clamp[ nums[ k ], 0.0, 1.0 ], 1.0 / 2.2 ]
        out[ 3 ] = (nums.count > 3) ? clamp[ nums[ 3 ], 0.0, 1.0 ]
                   : 1.0
        return out

    # sRGB r g b a as a colour row's linear text ('' none)
    func linear_text [ c: vec f32 ] -> string
        if [ c[ 3 ] <= 0.0 ] return ''
        out : ''
        for [ k: i32 0, k < 4, k += 1 ]
            n : f32 [ (k < 3) ? pow[ c[ k ], 2.2 ] : c[ k ] ]
            nt : num_text[ n, false ]
            out = (out.count == 0) ? nt : '{out}, {nt}'
        return out

    # the glow's own colour ('' back to the shape's colours)
    func set_glow_color [ i: i32, t: string ]
        if [ i < 0 || i >= count[] ] return
        fx : fx_of[ i ]
        fx.glow_rgb = srgb_of[ t ]
        set_fx[ i, fx ]

    # the drop shadow's softness by Inkscape's blur percent (0
    # takes it off); turned on, it starts below right, half black
    func set_shadow_percent [ i: i32, p: f32 ]
        if [ i < 0 || i >= count[] ] return
        fx : fx_of[ i ]
        if [ fx.shadow <= 0.0 && p > 0.0 ]
            step : f32 [ 0.04 * blur_base[ i ]
                         / max[ unit_scale[ i ], 1e-6 ] ]
            if [ fx.shadow_x == 0.0 && fx.shadow_y == 0.0 ]
                fx.shadow_x = step
                fx.shadow_y = step
            if [ fx.shade_rgb[ 3 ] <= 0.0 ]
                fx.shade_rgb = vec f32 [] [ 0.0, 0.0, 0.0, 0.5 ]
        fx.shadow = sd_of[ i, p ]
        set_fx[ i, fx ]

    # the drop shadow's offset (element units)
    func set_shadow_offset [ i: i32, x: f32, y: f32 ]
        if [ i < 0 || i >= count[] ] return
        fx : fx_of[ i ]
        fx.shadow_x = x
        fx.shadow_y = y
        set_fx[ i, fx ]

    func set_shadow_color [ i: i32, t: string ]
        if [ i < 0 || i >= count[] ] return
        fx : fx_of[ i ]
        fx.shade_rgb = srgb_of[ t ]
        set_fx[ i, fx ]

    # an element's open tag with key set to val ('' takes it out,
    # and out of its style too)
    func head_with [ nd: SVGNode, key: string, val: string ] -> string
        src : model.source
        return piece_with[ src.mid[ nd.at, nd.head_end - nd.at ], key,
                           val ]

    # the same on an open tag's text
    func piece_with [ open_tag: string, key: string, val: string ]
            -> string
        piece : string [ open_tag ]
        mark : ' {key}="'
        pos : i32 [ piece.index_of[ mark ] ]
        if [ pos >= 0 ]
            vs : i32 [ pos + mark.count ]
            rest : piece.mid[ vs, piece.count - vs ]
            ve : i32 [ vs + rest.index_of[ '"' ] ]
            head : piece.mid[ 0, pos ]
            tail : piece.mid[ ve + 1, piece.count - ve - 1 ]
            piece = (val.count == 0) ? '{head}{tail}'
                    : '{head} {key}="{val}"{tail}'
        el [ val.count > 0 ]
            cut : i32 [ (piece.ends_with[ '/>' ]) ? piece.count - 2
                        : piece.count - 1 ]
            head : piece.mid[ 0, cut ]
            tail : piece.mid[ cut, piece.count - cut ]
            piece = '{head} {key}="{val}"{tail}'
        # the style's own declaration of it out (a style beats an
        # attribute)
        sm : ' style="'
        sp : i32 [ piece.index_of[ sm ] ]
        if [ sp < 0 ] return piece
        vs : i32 [ sp + sm.count ]
        rest : piece.mid[ vs, piece.count - vs ]
        ve : i32 [ vs + rest.index_of[ '"' ] ]
        decls : piece.mid[ vs, ve - vs ]
        kept : ''
        for [ part: string ] in decls.split[ ';' ]
            ci : i32 [ part.index_of[ ':' ] ]
            nm : part.mid[ 0, (ci > 0) ? ci : 0 ].trim[]
            if [ ci > 0 && nm.compare[ key ] == 0 ] continue
            if [ part.trim[].count == 0 ] continue
            kept = (kept.count == 0) ? part : '{kept};{part}'
        head : piece.mid[ 0, vs ]
        tail : piece.mid[ ve, piece.count - ve ]
        return '{head}{kept}{tail}'

    # shape i's blur set (element units; 0 none)
    func set_blur [ i: i32, sd: f32 ]
        if [ i < 0 || i >= count[] ] return
        fx : fx_of[ i ]
        fx.blur = sd
        set_fx[ i, fx ]

    # shape i's effects set on the shape as drawn; its filter is
    # written into the text at the next compose (a save)
    func set_fx [ i: i32, fx: SvgFx ]
        sh : model.shapes[ i ]
        if [ !sh.node ] return
        k : f32 [ unit_scale[ i ] ]
        m : sh.space
        sh.blur = fx.blur * k
        sh.glow = fx.glow * k
        sh.glow_gain = fx.gain
        g : fx.glow_rgb
        sh.glow_color = vec4f [ g[ 0 ], g[ 1 ], g[ 2 ], g[ 3 ] ]
        sh.shadow = fx.shadow * k
        sh.shadow_x = m.ma * fx.shadow_x + m.mb * fx.shadow_y
        sh.shadow_y = m.mc * fx.shadow_x + m.md * fx.shadow_y
        c : fx.shade_rgb
        sh.shadow_color = vec4f [ c[ 0 ], c[ 1 ], c[ 2 ], c[ 3 ] ]
        # its filter: its own when no other shape uses it
        named : svg_filter_ref[ sh.node ]
        at : i32 [ fx_on.index_of[ i ] ]
        fid : string [ (at >= 0) ? fx_names[ at ] : '' ]
        if [ at < 0 ]
            fid = (named.count > 0 && uses_of[ named ] == 1) ? named
                  : fresh_filter_id[ (fx.shadow > 0.0) ? 'shadow'
                      : ((fx.glow > 0.0) ? 'glow' : 'blur') ]
            fx_on.push[ i ]
            fx_names.push[ fid ]
        held : bool [ fx.blur > 0.0 || fx.glow > 0.0
                      || fx.shadow > 0.0 ]
        svg_set[ sh, 'filter', (held) ? 'url(#{fid})' : '' ]
        mark[ i ]
        changed = true

    # how many times the text names url(#id)
    func uses_of [ id: string ] -> i32
        src : model.source
        look : 'url(#{id})'
        uses : i32 [ 0 ]
        from : i32 [ 0 ]
        while [ true ]
            rest : src.mid[ from, src.count - from ]
            hit : i32 [ rest.index_of[ look ] ]
            if [ hit < 0 ] break
            uses += 1
            from += hit + look.count
        return uses

    # an id free in the text and among the held filters
    func fresh_filter_id [ stem: string ] -> string
        n : i32 [ 1 ]
        while [ true ]
            nm : '{stem}-{n}'
            if [ model.source.index_of[ 'id="{nm}"' ] < 0
                 && fx_names.index_of[ nm ] < 0 ] return nm
            n += 1
        return stem

    # a colour as a feFlood's attributes
    func flood_text [ c: vec f32, name: string ] -> string
        code : string [ '#' ]
        for [ k: i32 0, k < 3, k += 1 ]
            two : hex_two[ i32[ round[ c[ k ] * 255.0 ] ] ]
            code = '{code}{two}'
        at : num_text[ c[ 3 ], false ]
        fo : '<feFlood flood-color="{code}" flood-opacity="{at}"'
        return '{fo} result="{name}"/>'

    # shape i's filter as svg: blur, glow (a halo brightened by
    # its gain, in its own colour or the shape's) and drop shadow
    func filter_text [ i: i32, fid: string ] -> string
        fx : fx_of[ i ]
        sd : f32 [ fx.blur ]
        gd : f32 [ fx.glow ]
        ss : f32 [ fx.shadow ]
        shade : bool [ ss > 0.0 ]
        # its region out by three of its widest gaussian, and
        # the shadow's offset
        bx : blur_box[ i ]
        k : f32 [ unit_scale[ i ] ]
        far : f32 [ sqrt[ sd * sd + gd * gd ] * k * 3.0 ]
        fx_far : f32 [ far ]
        fy_far : f32 [ far ]
        if [ shade ]
            fx_far = max[ far, (ss * 3.0 + abs[ fx.shadow_x ]) * k ]
            fy_far = max[ far, (ss * 3.0 + abs[ fx.shadow_y ]) * k ]
        mx : i32 [ max[ 10, i32[ ceil[ 100.0 * fx_far
                                      / max[ bx[ 0 ], 1e-3 ] ] ] ] ]
        my : i32 [ max[ 10, i32[ ceil[ 100.0 * fy_far
                                      / max[ bx[ 1 ], 1e-3 ] ] ] ] ]
        wd : i32 [ 100 + mx * 2 ]
        ht : i32 [ 100 + my * 2 ]
        box : 'x="-{mx}%" y="-{my}%" width="{wd}%" height="{ht}%"'
        body : ''
        from_in : 'SourceGraphic'
        merged : bool [ gd > 0.0 || shade ]
        if [ sd > 0.0 ]
            st : num_text[ sd, false ]
            if [ merged ]
                body = '<feGaussianBlur stdDeviation="{st}"'
                body = '{body} result="soft"/>'
                from_in = 'soft'
            el
                body = '<feGaussianBlur stdDeviation="{st}"/>'
        if [ shade ]
            sdt : num_text[ ss, false ]
            dxt : num_text[ fx.shadow_x, false ]
            dyt : num_text[ fx.shadow_y, false ]
            body = '{body}<feGaussianBlur in="SourceAlpha"'
            body = '{body} stdDeviation="{sdt}" result="shade"/>'
            body = '{body}<feOffset in="shade" dx="{dxt}"'
            body = '{body} dy="{dyt}" result="shift"/>'
            sfl : flood_text[ fx.shade_rgb, 'shadecolor' ]
            body = '{body}{sfl}'
            body = '{body}<feComposite in="shadecolor" in2="shift"'
            body = '{body} operator="in" result="shadow"/>'
        if [ gd > 0.0 ]
            gt : num_text[ gd, false ]
            kt : num_text[ fx.gain, false ]
            body = '{body}<feGaussianBlur in="{from_in}"'
            body = '{body} stdDeviation="{gt}" result="halo"/>'
            lit_in : 'halo'
            if [ fx.glow_rgb[ 3 ] > 0.0 ]
                gfl : flood_text[ fx.glow_rgb, 'glowcolor' ]
                body = '{body}{gfl}'
                body = '{body}<feComposite in="glowcolor"'
                body = '{body} in2="halo" operator="in"'
                body = '{body} result="tinted"/>'
                lit_in = 'tinted'
            fs : ''
            for [ ch: string ] in vec string [] [ 'R', 'G', 'B',
                                                  'A' ]
                fs = '{fs}<feFunc{ch} type="linear" slope="{kt}"/>'
            ct : 'feComponentTransfer'
            body = '{body}<{ct} in="{lit_in}" result="lit">'
            body = '{body}{fs}</{ct}>'
        if [ merged ]
            mn : 'feMergeNode'
            body = '{body}<feMerge>'
            if [ shade ] body = '{body}<{mn} in="shadow"/>'
            if [ gd > 0.0 ] body = '{body}<{mn} in="lit"/>'
            body = '{body}<{mn} in="{from_in}"/></feMerge>'
        cif : 'style="color-interpolation-filters:sRGB"'
        return '<filter id="{fid}" {box} {cif}>{body}</filter>'

    # the held filters as spans of the text: a shape's own one
    # rewritten in place, new ones into <defs> (made when none)
    func fx_spans [ starts: vec i64, stops: vec i64,
                    texts: vec string ]
        fresh : ''
        for [ k: i32 0, k < fx_on.count, k += 1 ]
            i : i32 [ fx_on[ k ] ]
            fx : fx_of[ i ]
            if [ fx.blur <= 0.0 && fx.glow <= 0.0 && fx.shadow <= 0.0 ]
                continue
            ftext : filter_text[ i, fx_names[ k ] ]
            fl : find_id[ root, fx_names[ k ] ]
            if [ fl ]
                starts.push[ fl.at ]
                stops.push[ fl.end ]
                texts.push[ ftext ]
            el
                fresh = '{fresh}  {ftext}\n'
        if [ fresh.count == 0 || !root ] return
        defs : SVGNode [ null ]
        if [ root.children ]
            for [ c: SVGNode ] in root.children
                if [ c.tag == 'defs' && !defs ] defs = c
        if [ defs ]
            starts.push[ defs.tail_at ]
            stops.push[ defs.tail_at ]
            texts.push[ '{fresh}  ' ]
        el
            starts.push[ root.head_end ]
            stops.push[ root.head_end ]
            texts.push[ '\n  <defs>\n{fresh}  </defs>' ]

    # the held changes let go: the text read has them now
    func clear_held []
        dirty.clear[]
        fx_on.clear[]
        fx_names.clear[]

    # a paint's gradient as svg: stops from 'linear | 0: r, g, b,
    # a | ...' (linear colours), each '<stop .../>'
    func stops_text [ t: string ] -> string
        out : ''
        parts : t.split[ '|' ]
        for [ k: i32 1, k < parts.count, k += 1 ]
            p : parts[ k ]
            ci : i32 [ p.index_of[ ':' ] ]
            if [ ci <= 0 ] continue
            head : p.mid[ 0, ci ].trim[]
            nums : numbers_of[ p.mid[ ci + 1, p.count - ci - 1 ] ]
            if [ nums.count < 3 ] continue
            # one letter alone is a character: a string by its type
            code : string [ '#' ]
            for [ j: i32 0, j < 3, j += 1 ]
                srgb : f32 [ pow[ clamp[ nums[ j ], 0.0, 1.0 ],
                                  1.0 / 2.2 ] ]
                two : hex_two[ i32[ round[ srgb * 255.0 ] ] ]
                code = '{code}{two}'
            al : f32 [ (nums.count > 3) ? nums[ 3 ] : 1.0 ]
            stop : '<stop offset="{head}" stop-color="{code}"'
            if [ al < 1.0 ]
                at : num_text[ al, false ]
                stop = '{stop} stop-opacity="{at}"'
            out = '{out}{stop}/>'
        return out

    func hex_two [ n: i32 ] -> string
        digits : '0123456789abcdef'
        hi : digits.mid[ n / 16, 1 ]
        lo : digits.mid[ n % 16, 1 ]
        return '{hi}{lo}'

    # shape i's fill (or stroke) gradient used by it alone
    func grad_own [ i: i32, key: string ] -> bool
        if [ i < 0 || i >= count[] ] return false
        sh : model.shapes[ i ]
        pt : (key.compare[ 'fill' ] == 0) ? sh.fill_paint
             : sh.stroke_paint
        if [ !pt ] return false
        src : model.source
        look : 'url(#{pt.id})'
        uses : i32 [ 0 ]
        from : i32 [ 0 ]
        while [ true ]
            rest : src.mid[ from, src.count - from ]
            hit : i32 [ rest.index_of[ look ] ]
            if [ hit < 0 ] break
            uses += 1
            from += hit + look.count
        return uses == 1

    # its gradient's geometry written from the paint as it is in
    # memory (linear x1 y1 x2 y2; radial cx cy r, its focus on
    # the centre)
    func set_grad_geometry [ i: i32, key: string ]
        if [ i < 0 || i >= count[] || !root ] return
        sh : model.shapes[ i ]
        pt : (key.compare[ 'fill' ] == 0) ? sh.fill_paint
             : sh.stroke_paint
        if [ !pt ] return
        ax : num_text[ pt.ax, false ]
        ay : num_text[ pt.ay, false ]
        bx : num_text[ pt.bx, false ]
        by : num_text[ pt.by, false ]
        rr : num_text[ pt.r, false ]
        # a copy: the reload below frees the paint and its id
        named : '{pt.id}'
        txt : compose[]
        model.load[ txt ]
        clear_held[]
        root = root_of[]
        root_dirty = false
        g : find_id[ root, named ]
        if [ !g ] return
        src : model.source
        piece : src.mid[ g.at, g.head_end - g.at ]
        if [ g.tag == 'radialGradient' ]
            piece = piece_with[ piece, 'cx', ax ]
            piece = piece_with[ piece, 'cy', ay ]
            piece = piece_with[ piece, 'r', rr ]
            piece = piece_with[ piece, 'fx', '' ]
            piece = piece_with[ piece, 'fy', '' ]
        el
            piece = piece_with[ piece, 'x1', ax ]
            piece = piece_with[ piece, 'y1', ay ]
            piece = piece_with[ piece, 'x2', bx ]
            piece = piece_with[ piece, 'y2', by ]
        model.load[ with_spans[ src, vec i64 [] [ g.at ],
            vec i64 [] [ g.head_end ], vec string [] [ piece ] ] ]
        root = root_of[]
        changed = true

    # shape i's fill or stroke made a gradient (the picker's
    # text): its own gradient element rewritten (its geometry
    # kept, its stops replaced), or, shared or none, a new one in
    # <defs> in the shape's box units; the shape names it
    func set_gradient [ i: i32, key: string, t: string ]
        if [ i < 0 || i >= count[] || !root ] return
        txt : compose[]
        model.load[ txt ]
        clear_held[]
        root = root_of[]
        root_dirty = false
        sh : model.shapes[ i ]
        nd : sh.node
        if [ !nd ] return
        src : model.source
        lin : bool [ !t.trim[].starts_with[ 'radial' ] ]
        tag : string [ (lin) ? 'linearGradient' : 'radialGradient' ]
        stops : stops_text[ t ]
        pt : (key.compare[ 'fill' ] == 0) ? sh.fill_paint
             : sh.stroke_paint
        # its gradient, else the one it kept from before a solid
        mark : 'aeon:{key}-gradient'
        kept : string [ (pt) ? pt.id : '' ]
        back : bool [ false ]
        if [ !pt ]
            km : nd.attr[ mark ]
            if [ km && km.count > 0 ]
                kept = km
                back = true
        g : SVGNode [ (kept.count > 0) ? find_id[ root, kept ] : null ]
        # one use only (none, coming back): changed in place
        own : bool [ false ]
        if [ g ]
            uses : i32 [ (back) ? 1 : 0 ]
            look : 'url(#{kept})'
            from : i32 [ 0 ]
            while [ true ]
                rest : src.mid[ from, src.count - from ]
                hit : i32 [ rest.index_of[ look ] ]
                if [ hit < 0 ] break
                uses += 1
                from += hit + look.count
            own = uses == 1
        gid : string [ (g && own) ? kept
                       : free_element_id[ (lin) ? 'linear' : 'radial' ] ]
        # its geometry, as it reads now, when the kind stays
        geo : ''
        same : bool [ g && g.tag == tag ]
        if [ same ]
            names : vec string [] [ 'x1', 'y1', 'x2', 'y2', 'cx', 'cy',
                'r', 'fx', 'fy', 'gradientUnits', 'gradientTransform',
                'spreadMethod' ]
            for [ nm: string ] in names
                v : svg_grad_attr[ root, g, nm ]
                if [ v ] geo = '{geo} {nm}="{v}"'
        el_text : '<{tag} id="{gid}"{geo}>{stops}</{tag}>'
        # coming back: the kept one as it was (the other kind:
        # its stops kept, its geometry svg's default)
        if [ back && g && own ]
            el_text = src.mid[ g.at, g.end - g.at ]
            if [ !same ]
                inner : src.mid[ g.head_end, g.tail_at - g.head_end ]
                el_text = '<{tag} id="{gid}">{inner}</{tag}>'
        starts : vec i64 []
        stops_at : vec i64 []
        texts  : vec string []
        if [ g && own ]
            starts.push[ g.at ]
            stops_at.push[ g.end ]
            texts.push[ el_text ]
        el
            defs : SVGNode [ null ]
            if [ root.children ]
                for [ c: SVGNode ] in root.children
                    if [ c.tag == 'defs' && !defs ] defs = c
            if [ defs ]
                starts.push[ defs.tail_at ]
                stops_at.push[ defs.tail_at ]
                texts.push[ '  {el_text}\n  ' ]
            el
                starts.push[ root.head_end ]
                stops_at.push[ root.head_end ]
                texts.push[ '\n  <defs>{el_text}</defs>' ]
        starts.push[ nd.at ]
        stops_at.push[ nd.head_end ]
        texts.push[ piece_with[ head_with[ nd, key, 'url(#{gid})' ],
                                mark, '' ] ]
        model.load[ with_spans[ src, starts, stops_at, texts ] ]
        root = root_of[]
        changed = true

    # shape i's gradient (fill or stroke) kept by its id while a
    # solid colour stands in, so a gradient again takes it back
    func keep_gradient [ i: i32, key: string ]
        if [ i < 0 || i >= count[] ] return
        sh : model.shapes[ i ]
        nd : sh.node
        pt : (key.compare[ 'fill' ] == 0) ? sh.fill_paint
             : sh.stroke_paint
        if [ !nd || !pt ] return
        if [ !nd.attrs ] nd.attrs = map string [ string ] []
        nd.attrs.set[ 'aeon:{key}-gradient', pt.id ]
        if [ root && !root.attr[ 'xmlns:aeon' ] ]
            if [ !root.attrs ] root.attrs = map string [ string ] []
            root.attrs.set[ 'xmlns:aeon',
                            'https://ar-visions.github.io/aeon' ]
            root_dirty = true

    # the kept gradient let go (a clear starts again)
    func forget_gradient [ i: i32, key: string ]
        if [ i < 0 || i >= count[] ] return
        nd : model.shapes[ i ].node
        if [ nd && nd.attr[ 'aeon:{key}-gradient' ] ]
            nd.attrs.set[ 'aeon:{key}-gradient', '' ]

    # the composed text read again before a change that rewrites
    # the text; undone as a whole
    func fresh_text []
        txt : compose[]
        undo.push[ SvgUndo [ shape: -1, text: txt ] ]
        model.load[ txt ]
        clear_held[]
        root = root_of[]
        root_dirty = false

    # the chosen shapes in a new group, where the topmost of them
    # was, in their drawing order; one from another parent keeps
    # its place on the page (a matrix group round it)
    func group_chosen [] -> bool
        ids : selected[]
        if [ ids.count == 0 ] return false
        fresh_text[]
        top : model.shapes[ ids[ ids.count - 1 ] ].node
        tps : parent_space[ ids[ ids.count - 1 ] ]
        back : affine_inverse[ tps ]
        src : model.source
        b : i64 [ top.at ]
        while [ b > 0 && (src.chars[ b - 1 ] == 32
                          || src.chars[ b - 1 ] == 9) ]
            b -= 1
        indent : src.mid[ b, top.at - b ]
        body : ''
        for [ i: i32 ] in ids
            nd : model.shapes[ i ].node
            piece : src.mid[ nd.at, nd.end - nd.at ]
            rel : back.multiply[ parent_space[ i ] ]
            if [ !is_identity[ rel ] ]
                piece = with_transform[ nd, piece, matrix_text[ rel ] ]
            body = '{body}\n{indent}  {piece}'
        gid : free_element_id[ 'group' ]
        starts : vec i64 []
        stops  : vec i64 []
        texts  : vec string []
        starts.push[ top.at ]
        stops.push[ top.end ]
        texts.push[ '<g id="{gid}">{body}\n{indent}</g>' ]
        for [ k: i32 0, k < ids.count - 1, k += 1 ]
            nd : model.shapes[ ids[ k ] ].node
            starts.push[ line_start[ nd ] ]
            stops.push[ nd.end ]
            texts.push[ '' ]
        model.load[ with_spans[ src, starts, stops, texts ] ]
        root = root_of[]
        changed = true
        # the group's shapes chosen
        g : find_id[ root, gid ]
        choose_one[ -1 ]
        if [ g ]
            for [ i: i32 ] in shapes_in[ g.at, g.end ]
                toggle[ i ]
        return true

    # an element's text with a transform put before its own (or
    # given it, when it has none)
    func with_transform [ nd: SVGNode, piece: string, t: string ]
            -> string
        head : piece.mid[ 0, nd.head_end - nd.at ]
        pos : i32 [ head.index_of[ 'transform="' ] ]
        cut : i32 [ (pos >= 0) ? pos + 11 : 1 + nd.tag.count ]
        before : piece.mid[ 0, cut ]
        after : piece.mid[ cut, piece.count - cut ]
        if [ pos >= 0 ] return '{before}{t} {after}'
        return '{before} transform="{t}"{after}'

    # the element with an id, under nd
    func find_id [ nd: SVGNode, want: string ] -> SVGNode
        if [ !nd || !nd.children ] return null
        for [ c: SVGNode ] in nd.children
            cid : c.attr[ 'id' ]
            if [ cid && cid.compare[ want ] == 0 ] return c
            deeper : find_id[ c, want ]
            if [ deeper ] return deeper
        return null

    # the group holding the chosen shape taken apart: its
    # children where it was, its transform put on each of them
    func ungroup_chosen [] -> bool
        if [ chosen < 0 ] return false
        nd : model.shapes[ chosen ].node
        par : parent_of[ root, nd.at ]
        if [ !par || par.tag != 'g' ] return false
        fresh_text[]
        nd = model.shapes[ chosen ].node
        g : parent_of[ root, nd.at ]
        if [ !g || g.tag != 'g' ] return false
        src : model.source
        inner : src.mid[ g.head_end, g.tail_at - g.head_end ]
        gt : g.attr[ 'transform' ]
        if [ gt && gt.count > 0 && g.children ]
            starts : vec i64 []
            stops  : vec i64 []
            texts  : vec string []
            for [ c: SVGNode ] in g.children
                own : c.attr[ 'transform' ]
                if [ own ]
                    # 'transform="own"' in its head: the group's before
                    head : src.mid[ c.at, c.head_end - c.at ]
                    pos : i32 [ head.index_of[ 'transform=' ] ]
                    if [ pos < 0 ] continue
                    q : i64 [ c.at + pos + 11 ]
                    starts.push[ q ]
                    stops.push[ q ]
                    texts.push[ '{gt} ' ]
                el
                    q : i64 [ c.at + 1 + c.tag.count ]
                    starts.push[ q ]
                    stops.push[ q ]
                    texts.push[ ' transform="{gt}"' ]
            # the spans are of the whole text: cut the group's out
            whole : with_spans[ src, starts, stops, texts ]
            grow : i64 [ whole.count - src.count ]
            span : i64 [ g.tail_at - g.head_end + grow ]
            inner = whole.mid[ g.head_end, span ]
        keep : vec i64 [] [ g.at ]
        out : inner.trim[]
        model.load[ with_spans[ src, keep, vec i64 [] [ g.end ],
                                vec string [] [ out ] ] ]
        root = root_of[]
        changed = true
        # the shapes it held chosen
        choose_one[ -1 ]
        for [ i: i32 ] in shapes_in[ g.at, g.at + out.count ]
            toggle[ i ]
        return true

    # a new path drawn (document units) put last in the drawing,
    # on top; it is chosen
    # the group chosen: the outermost <g> whose shapes are the
    # chosen ones, no more and no fewer (its outliner row lit)
    func chosen_group [] -> SVGNode
        sel : selected[]
        if [ sel.count == 0 ] return null
        found : vec SVGNode []
        nd : parent_of[ root, model.shapes[ sel[ 0 ] ].node.at ]
        while [ nd && nd != root ]
            if [ nd.tag == 'g' ]
                inside : shapes_in[ nd.at, nd.end ]
                if [ inside.count == sel.count ]
                    all : bool [ true ]
                    for [ i: i32 ] in inside
                        if [ !is_chosen[ i ] ] all = false
                    if [ all ] found.push[ nd ]
            nd = parent_of[ root, nd.at ]
        if [ found.count == 0 ] return null
        return found[ found.count - 1 ]

    # the space a group's content is drawn in: the <svg>'s, then
    # each group's transform from the outermost down to it
    func group_space [ g: SVGNode ] -> affine
        chain : vec SVGNode []
        nd : g
        while [ nd && nd != root ]
            chain.push[ nd ]
            nd = parent_of[ root, nd.at ]
        m : model.root_space
        for [ k: i32 chain.count - 1, k >= 0, k -= 1 ]
            t : chain[ k ].attr[ 'transform' ]
            if [ t && t.count > 0 ]
                m = m.multiply[ svg_parse_transform[ t ] ]
        return m

    func add_path [ cmds: vec SVGCmd, width: f32 ] -> bool
        if [ !root || cmds.count < 2 ] return false
        # a group chosen: the path goes last inside it
        into : chosen_group[]
        fresh_text[]
        space : (into) ? group_space[ into ] : model.root_space
        d : cmds_data[ cmds, space ]
        # the stroke as wide in the drawing's units as asked
        unit : f32 [ sqrt[ abs[ space.ma * space.md
                                - space.mb * space.mc ] ] ]
        sw : num_text[ width / maxf[ unit, 1e-9 ], false ]
        pid : free_element_id[ 'path' ]
        out : '<path id="{pid}" fill="none" stroke="#ffffff"'
        out = '{out} stroke-width="{sw}" d="{d}"/>'
        src : model.source
        at : i64 [ (into) ? into.tail_at : root.tail_at ]
        # the closing tag's own indent, put back after the line
        pad : ''
        k : i64 [ at - 1 ]
        while [ k >= 0 ]
            ch : src.mid[ k, 1 ]
            if [ ch != ' ' && ch != '\t' ] break
            pad = '{ch}{pad}'
            k -= 1
        line_text : '  {out}\n{pad}'
        model.load[ with_spans[ src, vec i64 [] [ at ],
            vec i64 [] [ at ], vec string [] [ line_text ] ] ]
        root = root_of[]
        changed = true
        choose_one[ -1 ]
        made : find_id[ root, pid ]
        if [ made ] chosen = shape_index_at[ made.at ]
        return true

    # a new <text> at page point x, y, its letters size page
    # units tall; it goes where a new path would, and is chosen
    func add_text [ x: f32, y: f32, size: f32 ] -> bool
        if [ !root ] return false
        into : chosen_group[]
        fresh_text[]
        space : (into) ? group_space[ into ] : model.root_space
        back : affine_inverse[ space ]
        unit : f32 [ sqrt[ abs[ space.ma * space.md
                                - space.mb * space.mc ] ] ]
        tx : num_text[ back.apply_x[ x, y ], false ]
        ty : num_text[ back.apply_y[ x, y ], false ]
        fs : num_text[ size / maxf[ unit, 1e-9 ], false ]
        tid : free_element_id[ 'text' ]
        out : '<text id="{tid}" x="{tx}" y="{ty}"'
        out = '{out} font-family="sans-serif" font-size="{fs}"'
        out = '{out} fill="#ffffff">Text</text>'
        src : model.source
        at : i64 [ (into) ? into.tail_at : root.tail_at ]
        pad : ''
        k : i64 [ at - 1 ]
        while [ k >= 0 ]
            ch : src.mid[ k, 1 ]
            if [ ch != ' ' && ch != '\t' ] break
            pad = '{ch}{pad}'
            k -= 1
        line_text : '  {out}\n{pad}'
        model.load[ with_spans[ src, vec i64 [] [ at ],
            vec i64 [] [ at ], vec string [] [ line_text ] ] ]
        root = root_of[]
        changed = true
        choose_one[ -1 ]
        made : find_id[ root, tid ]
        if [ made ] chosen = shape_index_at[ made.at ]
        return true

    # what finds shape i again after the text is read anew: its
    # id, else its element's text
    func shape_key [ i: i32 ] -> string
        if [ i < 0 || i >= count[] ] return ''
        nd : model.shapes[ i ].node
        if [ !nd ] return ''
        sid : nd.attr[ 'id' ]
        if [ sid && sid.count > 0 ] return 'id:{sid}'
        span : i64 [ nd.end - nd.at ]
        el_text : model.source.mid[ nd.at, span ]
        return 'el:{el_text}'

    # the shape a key names now (-1 gone); the same number when
    # the key finds none and the count is as it was
    func shape_by_key [ key: string, was: i32, n: i32 ] -> i32
        if [ key.count > 0 ]
            for [ i: i32 0, i < count[], i += 1 ]
                if [ shape_key[ i ].compare[ key ] == 0 ] return i
        if [ was >= 0 && n == count[] ] return was
        return -1

    # the text read again as it was (an undo): the shapes chosen
    # stay chosen where they are still there
    func restore [ txt: string ]
        n : i32 [ count[] ]
        keep : shape_key[ chosen ]
        was : i32 [ chosen ]
        more : vec string []
        more_at : vec i32 []
        for [ i: i32 ] in also
            more.push[ shape_key[ i ] ]
            more_at.push[ i ]
        also.clear[]
        model.load[ txt ]
        clear_held[]
        root = root_of[]
        root_dirty = false
        changed = true
        chosen = shape_by_key[ keep, was, n ]
        for [ k: i32 0, k < more.count, k += 1 ]
            at : i32 [ shape_by_key[ more[ k ], more_at[ k ], n ] ]
            if [ at >= 0 && at != chosen && also.index_of[ at ] < 0 ]
                also.push[ at ]
        if [ chosen < 0 && also.count > 0 ]
            chosen = also[ 0 ]
            also.remove[ 0 ]

    # one point read: x, y of the command's slot
    func point [ i: i32, p: SvgPoint ] -> vec2f
        c : model.shapes[ i ].cmds[ p.cmd ]
        if [ p.slot == 1 ] return vec2f [ c.x1, c.y1 ]
        if [ p.slot == 2 ] return vec2f [ c.x2, c.y2 ]
        return vec2f [ c.x, c.y ]

    # one point set: the command made again with it in its slot
    func set_point [ i: i32, p: SvgPoint, x: f32, y: f32 ]
        sh : model.shapes[ i ]
        c : sh.cmds[ p.cmd ]
        nx : f32 [ (p.slot == 0) ? x : c.x ]
        ny : f32 [ (p.slot == 0) ? y : c.y ]
        ax : f32 [ (p.slot == 1) ? x : c.x1 ]
        ay : f32 [ (p.slot == 1) ? y : c.y1 ]
        bx : f32 [ (p.slot == 2) ? x : c.x2 ]
        by : f32 [ (p.slot == 2) ? y : c.y2 ]
        sh.cmds[ p.cmd ] = SVGCmd [ op: c.op, x: nx, y: ny, x1: ax,
                                    y1: ay, x2: bx, y2: by ]

    # where a segment starts: the end of the command before it
    func seg_start [ i: i32, s: i32 ] -> vec2f
        cmds : model.shapes[ i ].cmds
        for [ k: i32 s - 1, k >= 0, k -= 1 ]
            if [ cmds[ k ].op != SVGOp.close ]
                return vec2f [ cmds[ k ].x, cmds[ k ].y ]
        return vec2f [ 0.0, 0.0 ]

    # a subpath's move, from any command in it
    func run_start [ i: i32, k: i32 ] -> i32
        cmds : model.shapes[ i ].cmds
        for [ j: i32 k, j >= 0, j -= 1 ]
            if [ cmds[ j ].op == SVGOp.move ] return j
        return 0

    # a subpath's close after k (-1 when it stays open)
    func run_close [ i: i32, k: i32 ] -> i32
        cmds : model.shapes[ i ].cmds
        for [ j: i32 k + 1, j < cmds.count, j += 1 ]
            if [ cmds[ j ].op == SVGOp.close ] return j
            if [ cmds[ j ].op == SVGOp.move ] return -1
        return -1

    func same_xy [ ax: f32, ay: f32, bx: f32, by: f32 ] -> bool
        return abs[ ax - bx ] < 0.001 && abs[ ay - by ] < 0.001

    # the segment ending at anchor k (-1 none); a subpath's start
    # takes its closing one, a closing line made a real one
    func seg_in [ i: i32, k: i32 ] -> i32
        cmds : model.shapes[ i ].cmds
        c : cmds[ k ]
        if [ c.op != SVGOp.move ] return k
        j : run_close[ i, k ]
        if [ j < 0 || j - 1 == k ] return -1
        last : cmds[ j - 1 ]
        if [ same_xy[ last.x, last.y, c.x, c.y ] ] return j - 1
        cmds.insert[ SVGCmd [ op: SVGOp.line, x: c.x, y: c.y ], j ]
        types_insert[ i, j ]
        return j

    # the segment leaving anchor k (-1 none); at a closed
    # subpath's end, the closing one
    func seg_out [ i: i32, k: i32 ] -> i32
        cmds : model.shapes[ i ].cmds
        if [ k + 1 >= cmds.count ] return -1
        nx : cmds[ k + 1 ]
        if [ nx.op == SVGOp.line || nx.op == SVGOp.quad
             || nx.op == SVGOp.cubic ] return k + 1
        if [ nx.op != SVGOp.close ] return -1
        m : run_start[ i, k ]
        mv : cmds[ m ]
        here : cmds[ k ]
        if [ same_xy[ here.x, here.y, mv.x, mv.y ] ]
            return (m + 1 < k + 1) ? m + 1 : -1
        back : SVGCmd [ op: SVGOp.line, x: mv.x, y: mv.y ]
        cmds.insert[ back, k + 1 ]
        types_insert[ i, k + 1 ]
        return k + 1

    # a segment made a cubic, the same curve (a line's handles on
    # its ends)
    func as_cubic [ i: i32, s: i32 ]
        sh : model.shapes[ i ]
        c : sh.cmds[ s ]
        if [ c.op == SVGOp.cubic ] return
        a : seg_start[ i, s ]
        if [ c.op == SVGOp.quad ]
            sh.cmds[ s ] = SVGCmd [ op: SVGOp.cubic,
                x1: a.x + (c.x1 - a.x) * 2.0 / 3.0,
                y1: a.y + (c.y1 - a.y) * 2.0 / 3.0,
                x2: c.x + (c.x1 - c.x) * 2.0 / 3.0,
                y2: c.y + (c.y1 - c.y) * 2.0 / 3.0, x: c.x, y: c.y ]
            return
        sh.cmds[ s ] = SVGCmd [ op: SVGOp.cubic, x1: a.x, y1: a.y,
                                x2: c.x, y2: c.y, x: c.x, y: c.y ]

    # an anchor's handle on the side a drag (dx, dy) goes: the
    # one there, else its segment made a cubic for one; null
    # when the anchor has no segment that way
    func handle_toward [ i: i32, k: i32, dx: f32, dy: f32 ]
            -> SvgPoint
        cmds : model.shapes[ i ].cmds
        at : cmds[ k ]
        # each side's way out of the anchor
        before : i32 [ seg_in[ i, k ] ]
        after : i32 [ seg_out[ i, k ] ]
        best_in : f32 [ -2.0 ]
        best_out : f32 [ -2.0 ]
        if [ before >= 0 ]
            c : cmds[ before ]
            w : seg_start[ i, before ]
            if [ c.op == SVGOp.cubic
                 && !same_xy[ c.x2, c.y2, at.x, at.y ] ]
                w = vec2f [ c.x2, c.y2 ]
            best_in = aim[ w.x - at.x, w.y - at.y, dx, dy ]
        if [ after >= 0 ]
            c : cmds[ after ]
            w : vec2f [ c.x, c.y ]
            if [ c.op == SVGOp.cubic
                 && !same_xy[ c.x1, c.y1, at.x, at.y ] ]
                w = vec2f [ c.x1, c.y1 ]
            best_out = aim[ w.x - at.x, w.y - at.y, dx, dy ]
        if [ before < 0 && after < 0 ] return null
        if [ best_out >= best_in ]
            as_cubic[ i, after ]
            return SvgPoint [ cmd: after, slot: 1 ]
        as_cubic[ i, before ]
        return SvgPoint [ cmd: before, slot: 2 ]

    # two segments meeting at a node made one, from p (where a
    # starts) past the node to b's end: lines stay a line, else a
    # cubic keeping the outer handles
    # two segments meeting at a node made one, from p (where came
    # starts) past the node to went's end: two lines a line, else
    # one cubic fitted to the old curve (its ends and their handle
    # directions kept; the handle lengths by least squares,
    # Schneider's fit, the samples' t refined by Newton)
    func joined [ came: SVGCmd, went: SVGCmd, p: vec2f ] -> SVGCmd
        if [ came.op == SVGOp.line && went.op == SVGOp.line ]
            return SVGCmd [ op: SVGOp.line, x: went.x, y: went.y ]
        mid : vec2f [ came.x, came.y ]
        ex : f32 [ went.x ]
        ey : f32 [ went.y ]
        # the old curve sampled, with its length along it
        pts : vec f32 []
        for [ n: i32 0, n <= 24, n += 1 ]
            q : seg_at[ came, p, f32[ n ] / 24.0 ]
            pts.push[ q.x ]
            pts.push[ q.y ]
        for [ n: i32 1, n <= 24, n += 1 ]
            q : seg_at[ went, mid, f32[ n ] / 24.0 ]
            pts.push[ q.x ]
            pts.push[ q.y ]
        np : i32 [ pts.count / 2 ]
        us : vec f32 [ np ]
        for [ n: i32 1, n < np, n += 1 ]
            dx : f32 [ pts[ n * 2 ] - pts[ n * 2 - 2 ] ]
            dy : f32 [ pts[ n * 2 + 1 ] - pts[ n * 2 - 1 ] ]
            us[ n ] = us[ n - 1 ] + sqrt[ dx * dx + dy * dy ]
        total : f32 [ us[ np - 1 ] ]
        if [ total < 1e-9 ]
            return SVGCmd [ op: SVGOp.line, x: ex, y: ey ]
        for [ n: i32 0, n < np, n += 1 ]
            us[ n ] = us[ n ] / total
        # the ends' handle directions, as they were
        t0 : out_way[ came, p ]
        t3 : in_way[ went, mid ]
        a1 : f32 [ total / 3.0 ]
        a2 : f32 [ total / 3.0 ]
        for [ pass: i32 0, pass < 8, pass += 1 ]
            c11 : f32 [ 0.0 ]
            c12 : f32 [ 0.0 ]
            c22 : f32 [ 0.0 ]
            x1 : f32 [ 0.0 ]
            x2 : f32 [ 0.0 ]
            for [ n: i32 0, n < np, n += 1 ]
                u : f32 [ us[ n ] ]
                v : f32 [ 1.0 - u ]
                b0 : f32 [ v * v * v ]
                b1 : f32 [ 3.0 * u * v * v ]
                b2 : f32 [ 3.0 * u * u * v ]
                b3 : f32 [ u * u * u ]
                ax : f32 [ t0.x * b1 ]
                ay : f32 [ t0.y * b1 ]
                bx : f32 [ t3.x * b2 ]
                by : f32 [ t3.y * b2 ]
                rx : f32 [ pts[ n * 2 ] - (b0 + b1) * p.x
                           - (b2 + b3) * ex ]
                ry : f32 [ pts[ n * 2 + 1 ] - (b0 + b1) * p.y
                           - (b2 + b3) * ey ]
                c11 += ax * ax + ay * ay
                c12 += ax * bx + ay * by
                c22 += bx * bx + by * by
                x1 += ax * rx + ay * ry
                x2 += bx * rx + by * ry
            det : f32 [ c11 * c22 - c12 * c12 ]
            a1 = total / 3.0
            a2 = total / 3.0
            if [ abs[ det ] > 1e-12 ]
                f1 : f32 [ (x1 * c22 - x2 * c12) / det ]
                f2 : f32 [ (c11 * x2 - c12 * x1) / det ]
                if [ f1 > total * 0.001 && f2 > total * 0.001 ]
                    a1 = f1
                    a2 = f2
            # each sample's t moved to its nearest on the fit
            k : vec f32 [] [ p.x, p.y, p.x + t0.x * a1,
                p.y + t0.y * a1, ex + t3.x * a2, ey + t3.y * a2,
                ex, ey ]
            for [ n: i32 1, n < np - 1, n += 1 ]
                us[ n ] = nearer_t[ k, us[ n ], pts[ n * 2 ],
                                    pts[ n * 2 + 1 ] ]
        return SVGCmd [ op: SVGOp.cubic, x1: p.x + t0.x * a1,
                        y1: p.y + t0.y * a1, x2: ex + t3.x * a2,
                        y2: ey + t3.y * a2, x: ex, y: ey ]

    # the way a segment leaves its start (its first handle, else
    # toward its end), unit
    func out_way [ c: SVGCmd, p: vec2f ] -> vec2f
        wx : f32 [ c.x - p.x ]
        wy : f32 [ c.y - p.y ]
        if [ c.op == SVGOp.cubic || c.op == SVGOp.quad ]
            if [ !same_xy[ c.x1, c.y1, p.x, p.y ] ]
                wx = c.x1 - p.x
                wy = c.y1 - p.y
            el [ c.op == SVGOp.cubic
                 && !same_xy[ c.x2, c.y2, p.x, p.y ] ]
                wx = c.x2 - p.x
                wy = c.y2 - p.y
        return unit_of[ wx, wy ]

    # the way a segment comes into its end, seen from the end
    # (its last handle, else toward its start), unit
    func in_way [ c: SVGCmd, p: vec2f ] -> vec2f
        wx : f32 [ p.x - c.x ]
        wy : f32 [ p.y - c.y ]
        if [ c.op == SVGOp.cubic
             && !same_xy[ c.x2, c.y2, c.x, c.y ] ]
            wx = c.x2 - c.x
            wy = c.y2 - c.y
        el [ c.op == SVGOp.cubic
             && !same_xy[ c.x1, c.y1, c.x, c.y ] ]
            wx = c.x1 - c.x
            wy = c.y1 - c.y
        el [ c.op == SVGOp.quad ]
            wx = c.x1 - c.x
            wy = c.y1 - c.y
        return unit_of[ wx, wy ]

    func unit_of [ wx: f32, wy: f32 ] -> vec2f
        l : f32 [ sqrt[ wx * wx + wy * wy ] ]
        if [ l < 1e-9 ] return vec2f [ 1.0, 0.0 ]
        return vec2f [ wx / l, wy / l ]

    # a Newton step toward the t on cubic k nearest (x, y)
    func nearer_t [ k: vec f32, t: f32, x: f32, y: f32 ] -> f32
        u : f32 [ 1.0 - t ]
        q : bz_at[ k, 0, t ]
        # first and second derivatives
        d1x : f32 [ 3.0 * (u * u * (k[ 2 ] - k[ 0 ])
                    + 2.0 * u * t * (k[ 4 ] - k[ 2 ])
                    + t * t * (k[ 6 ] - k[ 4 ])) ]
        d1y : f32 [ 3.0 * (u * u * (k[ 3 ] - k[ 1 ])
                    + 2.0 * u * t * (k[ 5 ] - k[ 3 ])
                    + t * t * (k[ 7 ] - k[ 5 ])) ]
        d2x : f32 [ 6.0 * (u * (k[ 4 ] - 2.0 * k[ 2 ] + k[ 0 ])
                    + t * (k[ 6 ] - 2.0 * k[ 4 ] + k[ 2 ])) ]
        d2y : f32 [ 6.0 * (u * (k[ 5 ] - 2.0 * k[ 3 ] + k[ 1 ])
                    + t * (k[ 7 ] - 2.0 * k[ 5 ] + k[ 3 ])) ]
        num : f32 [ (q.x - x) * d1x + (q.y - y) * d1y ]
        den : f32 [ d1x * d1x + d1y * d1y + (q.x - x) * d2x
                    + (q.y - y) * d2y ]
        if [ abs[ den ] < 1e-12 ] return t
        return clamp[ t - num / den, 0.0, 1.0 ]

    func is_seg [ c: SVGCmd ] -> bool
        return c.op == SVGOp.line || c.op == SVGOp.quad
            || c.op == SVGOp.cubic

    # the node at command k taken out, its neighbours joined
    func drop_node [ i: i32, k: i32 ]
        cmds : model.shapes[ i ].cmds
        c : cmds[ k ]
        nx : i32 [ k + 1 ]
        has_out : bool [ nx < cmds.count && is_seg[ cmds[ nx ] ] ]
        if [ c.op != SVGOp.move ]
            if [ has_out ]
                cmds[ nx ] = joined[ c, cmds[ nx ], seg_start[ i, k ] ]
            types_remove[ i, k ]
            cmds.remove[ k ]
            return
        # a subpath's start: the next node starts it
        if [ !has_out ]
            types_remove[ i, k ]
            cmds.remove[ k ]
            return
        out_seg : cmds[ nx ]
        j : run_close[ i, k ]
        if [ j > 0 && is_seg[ cmds[ j - 1 ] ] && j - 1 > nx ]
            last : cmds[ j - 1 ]
            from : seg_start[ i, j - 1 ]
            if [ same_xy[ last.x, last.y, c.x, c.y ] ]
                # the closing segment ran into the start: joined on
                cmds[ j - 1 ] = joined[ last, out_seg, from ]
            el
                # an implied closing line, joined on as a real one
                shut : SVGCmd [ op: SVGOp.line, x: c.x, y: c.y ]
                cmds.insert[ joined[ shut, out_seg, vec2f [ last.x,
                                                            last.y ] ],
                             j ]
                types_insert[ i, j ]
        cmds[ k ] = SVGCmd [ op: SVGOp.move, x: out_seg.x,
                             y: out_seg.y ]
        types_remove[ i, nx ]
        cmds.remove[ nx ]

    # node types, Inkscape's sodipodi:nodetypes: a letter a node
    # (every command but a close): c cusp, s smooth, z symmetric
    func types_of [ i: i32 ] -> string
        nd : model.shapes[ i ].node
        v : (nd) ? nd.attr[ 'sodipodi:nodetypes' ] : null
        return (v) ? v : ''

    func put_types [ i: i32, t: string ]
        nd : model.shapes[ i ].node
        if [ !nd ] return
        if [ !nd.attrs ] nd.attrs = map string [ string ] []
        nd.attrs.set[ 'sodipodi:nodetypes', t ]

    # the node number of the anchor at command k
    func node_no [ i: i32, k: i32 ] -> i32
        cmds : model.shapes[ i ].cmds
        n : i32 [ 0 ]
        for [ j: i32 0, j < k && j < cmds.count, j += 1 ]
            if [ cmds[ j ].op != SVGOp.close ] n += 1
        return n

    # the node an anchor is: a closed subpath's end on its start
    # is that start
    func node_of [ i: i32, k: i32 ] -> i32
        cmds : model.shapes[ i ].cmds
        m : run_start[ i, k ]
        j : run_close[ i, k ]
        if [ k != m && j == k + 1
             && same_xy[ cmds[ k ].x, cmds[ k ].y, cmds[ m ].x,
                         cmds[ m ].y ] ] return m
        return k

    # 0 cusp, 1 smooth, 2 symmetric
    func type_at [ i: i32, k: i32 ] -> i32
        t : types_of[ i ]
        n : node_no[ i, node_of[ i, k ] ]
        if [ n >= t.count ] return 0
        ch : t.mid[ n, 1 ]
        if [ ch.compare[ 's' ] == 0 ] return 1
        if [ ch.compare[ 'z' ] == 0 ] return 2
        return 0

    func set_type [ i: i32, k: i32, kind: i32 ]
        t : types_of[ i ]
        total : node_no[ i, model.shapes[ i ].cmds.count ]
        while [ t.count < total ]
            t = '{t}c'
        n : node_no[ i, node_of[ i, k ] ]
        head : t.mid[ 0, n ]
        tail : t.mid[ n + 1, t.count - n - 1 ]
        if [ kind == 1 ]
            t = '{head}s{tail}'
        el [ kind == 2 ]
            t = '{head}z{tail}'
        el
            t = '{head}c{tail}'
        put_types[ i, t ]

    # a command put in at k: a cusp node for it
    func types_insert [ i: i32, k: i32 ]
        t : types_of[ i ]
        if [ t.count == 0 ] return
        n : node_no[ i, k ]
        if [ n > t.count ] return
        head : t.mid[ 0, n ]
        tail : t.mid[ n, t.count - n ]
        put_types[ i, '{head}c{tail}' ]

    # the command at k about to go: its node's letter goes
    func types_remove [ i: i32, k: i32 ]
        t : types_of[ i ]
        if [ t.count == 0 ] return
        if [ model.shapes[ i ].cmds[ k ].op == SVGOp.close ] return
        n : node_no[ i, k ]
        if [ n >= t.count ] return
        head : t.mid[ 0, n ]
        tail : t.mid[ n + 1, t.count - n - 1 ]
        put_types[ i, '{head}{tail}' ]

    # the segments in and out of anchor k as they are (-1 none;
    # nothing made)
    func seg_in_at [ i: i32, k: i32 ] -> i32
        cmds : model.shapes[ i ].cmds
        c : cmds[ k ]
        if [ c.op != SVGOp.move ] return k
        j : run_close[ i, k ]
        if [ j < 0 || j - 1 == k ] return -1
        last : cmds[ j - 1 ]
        if [ same_xy[ last.x, last.y, c.x, c.y ] ] return j - 1
        return -1

    func seg_out_at [ i: i32, k: i32 ] -> i32
        cmds : model.shapes[ i ].cmds
        if [ k + 1 >= cmds.count ] return -1
        if [ is_seg[ cmds[ k + 1 ] ] ] return k + 1
        if [ cmds[ k + 1 ].op != SVGOp.close ] return -1
        m : run_start[ i, k ]
        if [ same_xy[ cmds[ k ].x, cmds[ k ].y, cmds[ m ].x,
                      cmds[ m ].y ] && m + 1 < k + 1 ] return m + 1
        return -1

    # the node a handle belongs to
    func handle_node [ p: SvgPoint ] -> i32
        return (p.slot == 2) ? p.cmd : p.cmd - 1

    # a handle's partner across its node (null: none, or a side
    # with no handle)
    func partner [ i: i32, p: SvgPoint ] -> SvgPoint
        if [ p.slot == 0 ] return null
        k : handle_node[ p ]
        if [ k < 0 ] return null
        o : i32 [ (p.slot == 2) ? seg_out_at[ i, k ]
                                : seg_in_at[ i, k ] ]
        if [ o < 0 ] return null
        if [ model.shapes[ i ].cmds[ o ].op != SVGOp.cubic ]
            return null
        return SvgPoint [ cmd: o, slot: (p.slot == 2) ? 1 : 2 ]

    # the way out of a node along a straight side: the line's
    # direction past the node (none: 0, 0)
    func line_way [ i: i32, p: SvgPoint ] -> vec2f
        k : handle_node[ p ]
        cmds : model.shapes[ i ].cmds
        o : i32 [ (p.slot == 2) ? seg_out_at[ i, k ]
                                : seg_in_at[ i, k ] ]
        if [ o < 0 || cmds[ o ].op != SVGOp.line ]
            return vec2f [ 0.0, 0.0 ]
        a : vec2f [ cmds[ k ].x, cmds[ k ].y ]
        far : vec2f [ cmds[ o ].x, cmds[ o ].y ]
        if [ p.slot == 1 ] far = seg_start[ i, o ]
        return unit_of[ a.x - far.x, a.y - far.y ]

    # a handle just moved: its node's type holds (smooth: the
    # partner opposite, its own length; symmetric: opposite and
    # the same length; beside a line: on the line's way)
    func hold_node [ i: i32, p: SvgPoint ]
        if [ p.slot == 0 ] return
        k : handle_node[ p ]
        if [ k < 0 ] return
        kind : type_at[ i, k ]
        if [ kind == 0 ] return
        cmds : model.shapes[ i ].cmds
        a : vec2f [ cmds[ k ].x, cmds[ k ].y ]
        h : point[ i, p ]
        way : line_way[ i, p ]
        if [ way.x != 0.0 || way.y != 0.0 ]
            along : f32 [ max[ (h.x - a.x) * way.x
                               + (h.y - a.y) * way.y, 0.0 ] ]
            set_point[ i, p, a.x + way.x * along, a.y + way.y * along ]
            return
        q : partner[ i, p ]
        if [ !q ] return
        dx : f32 [ h.x - a.x ]
        dy : f32 [ h.y - a.y ]
        l : f32 [ sqrt[ dx * dx + dy * dy ] ]
        if [ l < 1e-9 ] return
        o : point[ i, q ]
        ol : f32 [ l ]
        if [ kind == 1 ]
            ol = sqrt[ (o.x - a.x) * (o.x - a.x)
                       + (o.y - a.y) * (o.y - a.y) ]
        set_point[ i, q, a.x - dx / l * ol, a.y - dy / l * ol ]

    # a node made smooth or symmetric: its handles put opposite
    # (the mean of their ways; symmetric: the mean length too)
    func align_node [ i: i32, k: i32 ]
        kind : type_at[ i, k ]
        if [ kind == 0 ] return
        cmds : model.shapes[ i ].cmds
        a : vec2f [ cmds[ k ].x, cmds[ k ].y ]
        si : seg_in_at[ i, k ]
        so : seg_out_at[ i, k ]
        hin : SvgPoint [ null ]
        hout : SvgPoint [ null ]
        if [ si >= 0 && cmds[ si ].op == SVGOp.cubic ]
            hin = SvgPoint [ cmd: si, slot: 2 ]
        if [ so >= 0 && cmds[ so ].op == SVGOp.cubic ]
            hout = SvgPoint [ cmd: so, slot: 1 ]
        if [ hin && hout ]
            pi : point[ i, hin ]
            po : point[ i, hout ]
            ui : unit_of[ pi.x - a.x, pi.y - a.y ]
            uo : unit_of[ po.x - a.x, po.y - a.y ]
            d : unit_of[ uo.x - ui.x, uo.y - ui.y ]
            li : f32 [ sqrt[ (pi.x - a.x) * (pi.x - a.x)
                             + (pi.y - a.y) * (pi.y - a.y) ] ]
            lo : f32 [ sqrt[ (po.x - a.x) * (po.x - a.x)
                             + (po.y - a.y) * (po.y - a.y) ] ]
            if [ kind == 2 ]
                li = (li + lo) * 0.5
                lo = li
            set_point[ i, hout, a.x + d.x * lo, a.y + d.y * lo ]
            set_point[ i, hin, a.x - d.x * li, a.y - d.y * li ]
            return
        if [ hout ] hold_node[ i, hout ]
        if [ hin ] hold_node[ i, hin ]

    # a segment's point at t (a closing line: from its last
    # point back to the start, given as the command x, y)
    func seg_at [ c: SVGCmd, p: vec2f, t: f32 ] -> vec2f
        u : f32 [ 1.0 - t ]
        if [ c.op == SVGOp.cubic ]
            k : vec f32 [] [ p.x, p.y, c.x1, c.y1, c.x2, c.y2, c.x,
                             c.y ]
            return bz_at[ k, 0, t ]
        if [ c.op == SVGOp.quad ]
            return vec2f [ u * u * p.x + 2.0 * u * t * c.x1
                           + t * t * c.x,
                           u * u * p.y + 2.0 * u * t * c.y1
                           + t * t * c.y ]
        return vec2f [ p.x + (c.x - p.x) * t, p.y + (c.y - p.y) * t ]

    # a node put into the segment nearest (x, y), within reach:
    # a line becomes two lines, a curve two curves of the same
    # shape (split at that t); the new node, else null
    func split_at [ i: i32, x: f32, y: f32, reach: f32 ] -> SvgPoint
        cmds : model.shapes[ i ].cmds
        best : f32 [ reach * reach ]
        seg : i32 [ -1 ]
        at_t : f32 [ 0.0 ]
        px : f32 [ 0.0 ]
        py : f32 [ 0.0 ]
        sx : f32 [ 0.0 ]
        sy : f32 [ 0.0 ]
        for [ k: i32 0, k < cmds.count, k += 1 ]
            c : cmds[ k ]
            if [ c.op == SVGOp.move ]
                sx = c.x
                sy = c.y
            el
                # a close is a line back to the start
                tc : SVGCmd [ c ]
                if [ c.op == SVGOp.close ]
                    tc = SVGCmd [ op: SVGOp.line, x: sx, y: sy ]
                for [ n: i32 1, n < 64, n += 1 ]
                    t : f32 [ f32[ n ] / 64.0 ]
                    q : seg_at[ tc, vec2f [ px, py ], t ]
                    d : f32 [ (q.x - x) * (q.x - x)
                              + (q.y - y) * (q.y - y) ]
                    if [ d < best ]
                        best = d
                        seg = k
                        at_t = t
            if [ c.op == SVGOp.close ]
                px = sx
                py = sy
            el
                px = c.x
                py = c.y
        if [ seg < 0 ] return null
        c : cmds[ seg ]
        p : seg_start[ i, seg ]
        t : f32 [ at_t ]
        if [ c.op == SVGOp.close ]
            m : seg_at[ SVGCmd [ op: SVGOp.line, x: sx_of[ i, seg ],
                                 y: sy_of[ i, seg ] ], p, t ]
            cmds.insert[ SVGCmd [ op: SVGOp.line, x: m.x, y: m.y ],
                         seg ]
            types_insert[ i, seg ]
            return SvgPoint [ cmd: seg, slot: 0 ]
        if [ c.op == SVGOp.cubic ]
            k : vec f32 [] [ p.x, p.y, c.x1, c.y1, c.x2, c.y2, c.x,
                             c.y ]
            left : bz_cut[ k, 0, t, true ]
            right : bz_cut[ k, 0, t, false ]
            cmds[ seg ] = SVGCmd [ op: SVGOp.cubic, x1: right[ 2 ],
                y1: right[ 3 ], x2: right[ 4 ], y2: right[ 5 ],
                x: c.x, y: c.y ]
            cmds.insert[ SVGCmd [ op: SVGOp.cubic, x1: left[ 2 ],
                y1: left[ 3 ], x2: left[ 4 ], y2: left[ 5 ],
                x: left[ 6 ], y: left[ 7 ] ], seg ]
            types_insert[ i, seg ]
            return SvgPoint [ cmd: seg, slot: 0 ]
        if [ c.op == SVGOp.quad ]
            ax : f32 [ p.x + (c.x1 - p.x) * t ]
            ay : f32 [ p.y + (c.y1 - p.y) * t ]
            bx : f32 [ c.x1 + (c.x - c.x1) * t ]
            by : f32 [ c.y1 + (c.y - c.y1) * t ]
            mx : f32 [ ax + (bx - ax) * t ]
            my : f32 [ ay + (by - ay) * t ]
            cmds[ seg ] = SVGCmd [ op: SVGOp.quad, x1: bx, y1: by,
                                   x: c.x, y: c.y ]
            cmds.insert[ SVGCmd [ op: SVGOp.quad, x1: ax, y1: ay,
                                  x: mx, y: my ], seg ]
            types_insert[ i, seg ]
            return SvgPoint [ cmd: seg, slot: 0 ]
        m : seg_at[ c, p, t ]
        cmds.insert[ SVGCmd [ op: SVGOp.line, x: m.x, y: m.y ], seg ]
        types_insert[ i, seg ]
        return SvgPoint [ cmd: seg, slot: 0 ]

    # the start of the subpath command k is in
    func sx_of [ i: i32, k: i32 ] -> f32
        return model.shapes[ i ].cmds[ run_start[ i, k ] ].x
    func sy_of [ i: i32, k: i32 ] -> f32
        return model.shapes[ i ].cmds[ run_start[ i, k ] ].y

    # subpaths with no segment left taken out
    func tidy [ i: i32 ]
        cmds : model.shapes[ i ].cmds
        k : i32 [ 0 ]
        while [ k < cmds.count ]
            if [ cmds[ k ].op != SVGOp.move ]
                k += 1
                continue
            e : i32 [ k + 1 ]
            segs : i32 [ 0 ]
            while [ e < cmds.count && cmds[ e ].op != SVGOp.move ]
                if [ is_seg[ cmds[ e ] ] ] segs += 1
                e += 1
            if [ segs == 0 ]
                for [ n: i32 k, n < e, n += 1 ]
                    types_remove[ i, k ]
                    cmds.remove[ k ]
                continue
            k = e

    # the picked nodes taken out; true when any was
    func drop_nodes [ i: i32, picked: vec SvgPoint ] -> bool
        cmds : model.shapes[ i ].cmds
        ks : vec i32 []
        for [ p: SvgPoint ] in picked
            if [ p.slot != 0 ] continue
            k : i32 [ p.cmd ]
            # a closed subpath's end on its start is that start
            m : run_start[ i, k ]
            j : run_close[ i, k ]
            if [ k != m && j == k + 1
                 && same_xy[ cmds[ k ].x, cmds[ k ].y, cmds[ m ].x,
                             cmds[ m ].y ] ]
                k = m
            if [ ks.index_of[ k ] < 0 ] ks.push[ k ]
        if [ ks.count == 0 ] return false
        # last first: the earlier commands stay where they are
        for [ a: i32 0, a < ks.count, a += 1 ]
            for [ b: i32 a + 1, b < ks.count, b += 1 ]
                if [ ks[ b ] > ks[ a ] ]
                    keep : i32 [ ks[ a ] ]
                    ks[ a ] = ks[ b ]
                    ks[ b ] = keep
        for [ k: i32 ] in ks
            drop_node[ i, k ]
        tidy[ i ]
        return true

    # how well a way lines up with a drag: -1 to 1
    func aim [ wx: f32, wy: f32, dx: f32, dy: f32 ] -> f32
        a : f32 [ sqrt[ wx * wx + wy * wy ]
                  * sqrt[ dx * dx + dy * dy ] ]
        if [ a < 1e-9 ] return -1.0
        return (wx * dx + wy * dy) / a

    # every point a shape has: anchors, then a curve's handles
    # the points a press or a box can take: a text's are its
    # glyphs', edited as words, so none
    func points_of [ i: i32 ] -> vec SvgPoint
        if [ is_text[ i ] ] return vec SvgPoint []
        return all_points[ i ]

    # every point, a text's glyphs' too (a whole move's box)
    func all_points [ i: i32 ] -> vec SvgPoint
        out : vec SvgPoint []
        if [ i < 0 || i >= count[] ] return out
        sh : model.shapes[ i ]
        for [ k: i32 0, k < sh.cmds.count, k += 1 ]
            c : sh.cmds[ k ]
            if [ c.op == SVGOp.close ] continue
            out.push[ SvgPoint [ cmd: k, slot: 0 ] ]
            if [ c.op == SVGOp.cubic || c.op == SVGOp.quad ]
                out.push[ SvgPoint [ cmd: k, slot: 1 ] ]
            if [ c.op == SVGOp.cubic ]
                out.push[ SvgPoint [ cmd: k, slot: 2 ] ]
        return out

    # what moves with the picked: an anchor takes its own handles
    # (the curve into it, and the curve out of it)
    func carried [ i: i32, picked: vec SvgPoint ] -> vec SvgPoint
        out : vec SvgPoint []
        sh : model.shapes[ i ]
        for [ p: SvgPoint ] in picked
            add_point[ out, p ]
            if [ p.slot != 0 ] continue
            c : sh.cmds[ p.cmd ]
            if [ c.op == SVGOp.cubic ]
                add_point[ out, SvgPoint [ cmd: p.cmd, slot: 2 ] ]
            if [ p.cmd + 1 < sh.cmds.count ]
                after : sh.cmds[ p.cmd + 1 ]
                if [ after.op == SVGOp.cubic ]
                    add_point[ out, SvgPoint [ cmd: p.cmd + 1,
                                               slot: 1 ] ]
        return out

    func add_point [ list: vec SvgPoint, p: SvgPoint ]
        for [ q: SvgPoint ] in list
            if [ q.cmd == p.cmd && q.slot == p.slot ] return
        list.push[ p ]

    # the anchors on the same spot as this one (a subpath's end
    # back on its start): picked together
    func same_spot [ i: i32, p: SvgPoint ] -> vec SvgPoint
        out : vec SvgPoint []
        out.push[ p ]
        if [ p.slot != 0 ] return out
        at : point[ i, p ]
        for [ q: SvgPoint ] in points_of[ i ]
            if [ q.slot != 0 || q.cmd == p.cmd ] continue
            o : point[ i, q ]
            if [ abs[ o.x - at.x ] < 0.001
                 && abs[ o.y - at.y ] < 0.001 ]
                out.push[ q ]
        return out

    # the shape's outline flattened (document units), a subpath
    # a run: each point x, y; a run starts after a -1e9 mark
    func outline [ i: i32 ] -> vec f32
        out : vec f32 []
        sh : model.shapes[ i ]
        px : f32 [ 0.0 ]
        py : f32 [ 0.0 ]
        for [ c: SVGCmd ] in sh.cmds
            if [ c.op == SVGOp.move ]
                out.push[ -1.0e9 ]
                out.push[ -1.0e9 ]
                out.push[ c.x ]
                out.push[ c.y ]
            el [ c.op == SVGOp.line ]
                out.push[ c.x ]
                out.push[ c.y ]
            el [ c.op == SVGOp.cubic || c.op == SVGOp.quad ]
                for [ k: i32 1, k <= 12, k += 1 ]
                    t : f32 [ f32[ k ] / 12.0 ]
                    u : f32 [ 1.0 - t ]
                    if [ c.op == SVGOp.cubic ]
                        a : f32 [ u * u * u ]
                        b : f32 [ 3.0 * u * u * t ]
                        e : f32 [ 3.0 * u * t * t ]
                        f : f32 [ t * t * t ]
                        out.push[ a * px + b * c.x1 + e * c.x2 + f * c.x ]
                        out.push[ a * py + b * c.y1 + e * c.y2 + f * c.y ]
                    el
                        out.push[ u * u * px + 2.0 * u * t * c.x1
                                  + t * t * c.x ]
                        out.push[ u * u * py + 2.0 * u * t * c.y1
                                  + t * t * c.y ]
            if [ c.op != SVGOp.close ]
                px = c.x
                py = c.y
        return out

    # a point is on the shape: inside its fill (even-odd), or
    # within reach of its outline
    func hits [ i: i32, x: f32, y: f32, reach: f32 ] -> bool
        # a text: anywhere in its letters' box, gaps too
        if [ is_text[ i ] ]
            bx : text_box[ i ]
            return x >= bx[ 0 ] - reach && x <= bx[ 2 ] + reach
                && y >= bx[ 1 ] - reach && y <= bx[ 3 ] + reach
        line : outline[ i ]
        sh : model.shapes[ i ]
        inside : bool [ false ]
        first : i32 [ -1 ]
        for [ k: i32 0, k + 1 < line.count, k += 2 ]
            if [ line[ k ] < -1.0e8 ]
                first = -1
                continue
            if [ first < 0 ] first = k
            # the edge to the next point, or back to the run's first
            nx : i32 [ k + 2 ]
            if [ nx + 1 >= line.count || line[ nx ] < -1.0e8 ]
                nx = first
            ax : f32 [ line[ k ] ]
            ay : f32 [ line[ k + 1 ] ]
            bx : f32 [ line[ nx ] ]
            by : f32 [ line[ nx + 1 ] ]
            if [ (ay > y) != (by > y) ]
                cx : f32 [ ax + (y - ay) * (bx - ax) / (by - ay) ]
                if [ x < cx ] inside = !inside
            # the outline itself (a closing edge only when filled)
            if [ nx == first && sh.fill_none ] continue
            ex : f32 [ bx - ax ]
            ey : f32 [ by - ay ]
            len : f32 [ ex * ex + ey * ey ]
            t : f32 [ 0.0 ]
            if [ len > 0.0 ]
                t = clamp[ ((x - ax) * ex + (y - ay) * ey) / len, 0.0,
                           1.0 ]
            dx : f32 [ ax + ex * t - x ]
            dy : f32 [ ay + ey * t - y ]
            if [ dx * dx + dy * dy <= reach * reach ] return true
        return inside && !sh.fill_none

    # the topmost shape under a point (-1 none)
    # a text's box on the page: x0 y0 x1 y1 of its glyphs'
    # points (a curve's handles stay inside a glyph's box)
    func text_box [ i: i32 ] -> vec f32
        out : vec f32 [] [ 1e30, 1e30, -1e30, -1e30 ]
        for [ c: SVGCmd ] in model.shapes[ i ].cmds
            if [ c.op == SVGOp.close ] continue
            out[ 0 ] = min[ out[ 0 ], c.x ]
            out[ 1 ] = min[ out[ 1 ], c.y ]
            out[ 2 ] = max[ out[ 2 ], c.x ]
            out[ 3 ] = max[ out[ 3 ], c.y ]
        return out

    func shape_at [ x: f32, y: f32, reach: f32 ] -> i32
        for [ i: i32 count[] - 1, i >= 0, i -= 1 ]
            if [ hits[ i, x, y, reach ] ] return i
        return -1

    # ---- saving ----

    # a shape's commands as path data in its element's own space
    func path_data [ i: i32 ] -> string
        sh : model.shapes[ i ]
        return cmds_data[ sh.cmds, sh.space ]

    # commands as path data in a space (the document's to it)
    func cmds_data [ cmds: vec SVGCmd, space: affine ] -> string
        back : affine_inverse[ space ]
        out : ''
        for [ c: SVGCmd ] in cmds
            if [ out.count > 0 ] out = '{out} '
            if [ c.op == SVGOp.close ]
                out = '{out}Z'
                continue
            xy : pair[ back, c.x, c.y ]
            if [ c.op == SVGOp.move ]
                out = '{out}M {xy}'
            el [ c.op == SVGOp.line ]
                out = '{out}L {xy}'
            el [ c.op == SVGOp.quad ]
                q : pair[ back, c.x1, c.y1 ]
                out = '{out}Q {q} {xy}'
            el
                a : pair[ back, c.x1, c.y1 ]
                b : pair[ back, c.x2, c.y2 ]
                out = '{out}C {a} {b} {xy}'
        return out

    func pair [ m: affine, x: f32, y: f32 ] -> string
        px : num_text[ m.apply_x[ x, y ], false ]
        py : num_text[ m.apply_y[ x, y ], false ]
        return '{px},{py}'

    # the element written again as a path: its own attributes but
    # the shape's (x, y, r, points ...), then d; children kept
    func element_text [ i: i32 ] -> string
        sh : model.shapes[ i ]
        nd : sh.node
        if [ is_text[ i ] ] return text_element[ i ]
        geometry : vec string [] [ 'd', 'x', 'y', 'width', 'height',
            'rx', 'ry', 'cx', 'cy', 'r', 'x1', 'y1', 'x2', 'y2',
            'points' ]
        out : '<path'
        if [ nd.attrs ]
            for [ v: string, k: string ] in nd.attrs
                if [ geometry.index_of[ k ] >= 0 ] continue
                if [ !v || v.count == 0 ] continue
                out = '{out} {k}="{v}"'
        d : path_data[ i ]
        out = '{out} d="{d}"'
        src : model.source
        if [ nd.tail_at <= nd.head_end ] return '{out}/>'
        inner : src.mid[ nd.head_end, nd.tail_at - nd.head_end ]
        return '{out}>{inner}</path>'

    # a <text> written as text: its attributes, then its words
    # (its tspans as they were, unless the words were set)
    func text_element [ i: i32 ] -> string
        nd : model.shapes[ i ].node
        out : '<text'
        if [ nd.attrs ]
            for [ v: string, k: string ] in nd.attrs
                if [ !v || v.count == 0 ] continue
                out = '{out} {k}="{v}"'
        src : model.source
        if [ nd.children.count > 0 && nd.tail_at > nd.head_end ]
            inner : src.mid[ nd.head_end, nd.tail_at - nd.head_end ]
            return '{out}>{inner}</text>'
        words : string (nd.text) ? svg_escape[ nd.text ] : ''
        return '{out}>{words}</text>'

    # changes not yet written to the file
    func unsaved [] -> bool
        return dirty.count > 0 || changed || root_dirty

    # text kept from before a quit, unsaved, in place of the file's
    func take_text [ txt: string ]
        model.load[ txt ]
        clear_held[]
        root = root_of[]
        root_dirty = false
        changed = true

    # every change written to another file, which the drawing is
    # from then on
    func save_as [ to: path ] -> bool
        txt : compose[]
        f : handle [ fopen[ to, "w" ] ]
        if [ !f ] return false
        fputs[ txt.chars, f ]
        fclose[ f ]
        file = to
        untitled = false
        keep_chosen : i32 [ chosen ]
        model = SVGModel [ file ]
        chosen = keep_chosen
        clear_held[]
        root = root_of[]
        root_dirty = false
        changed = false
        return true

    # the changed shapes written back, the last in the file first
    # (the earlier spans stay where they are); then read again
    func save [] -> bool
        if [ dirty.count == 0 && !changed ] return true
        txt : compose[]
        f : handle [ fopen[ file, "w" ] ]
        if [ !f ] return false
        fputs[ txt.chars, f ]
        fclose[ f ]
        keep_chosen : i32 [ chosen ]
        model = SVGModel [ file ]
        chosen = keep_chosen
        clear_held[]
        root = root_of[]
        changed = false
        return true

    # the text with every change in it: each change a span of
    # the text read, put in last first (earlier spans stay put)
    func compose [] -> string
        starts : vec i64 []
        stops  : vec i64 []
        texts  : vec string []
        for [ i: i32 ] in dirty
            nd : model.shapes[ i ].node
            if [ !nd ] continue
            starts.push[ nd.at ]
            stops.push[ nd.end ]
            texts.push[ element_text[ i ] ]
        if [ root_dirty && root ]
            starts.push[ root.at ]
            stops.push[ root.head_end ]
            texts.push[ root_text[] ]
        fx_spans[ starts, stops, texts ]
        if [ insert_at ]
            for [ k: i32 0, k < insert_at.count, k += 1 ]
                starts.push[ insert_at[ k ] ]
                stops.push[ insert_at[ k ] ]
                texts.push[ insert_text[ k ] ]
        # last first; at one start the longer span first
        order : vec i32 []
        for [ k: i32 0, k < starts.count, k += 1 ]
            order.push[ k ]
        for [ a: i32 0, a < order.count, a += 1 ]
            for [ b: i32 a + 1, b < order.count, b += 1 ]
                x : i32 [ order[ a ] ]
                y : i32 [ order[ b ] ]
                if [ starts[ y ] > starts[ x ]
                     || (starts[ y ] == starts[ x ]
                         && stops[ y ] > stops[ x ]) ]
                    order[ a ] = y
                    order[ b ] = x
        txt : string [ model.source ]
        for [ k: i32 ] in order
            head : txt.mid[ 0, starts[ k ] ]
            tail : txt.mid[ stops[ k ], txt.count - stops[ k ] ]
            txt = '{head}{texts[ k ]}{tail}'
        return txt

# the 2D view of an .svg: the page and its shapes, pan and zoom;
# a shape chosen shows its points; G moves the picked
element SvgView
    style : CSS {
        area: l0 t0 r0 b0
    }
    public doc    : SvgDoc
    # where the page's corner is on screen, and pixels a unit
    mutable ox    : f32
    mutable oy    : f32
    mutable zoom  : f32
    mutable fitted : bool
    # where the view is going; each frame it moves part of the way
    # there (filter_n), as every movement in 3D does
    mutable ox_goal   : f32
    mutable oy_goal   : f32
    mutable zoom_goal : f32
    public ease       : f32 [ 0.2 ]
    # pan and zoom (edits are heavier still: ease 0.2)
    public view_ease  : f32 [ 0.25 ]
    # g / s, o and a handle drag: the value shown, eased to its goal
    mutable shown_g   : vec2f
    mutable off_shown : f32
    mutable h_goal    : vec2f
    mutable h_shown   : vec2f
    # 1 panning (right, middle or ctrl/cmd + drag)
    mutable mode  : i32
    mutable picked : vec SvgPoint
    # g: what moves and where it was; the pointer's move so far
    mutable moving : bool
    mutable moved  : vec SvgPoint
    mutable from   : vec f32
    mutable shift_x : f32
    mutable shift_y : f32
    # the axes named: 1 x, 2 y, 0 both
    mutable lock   : i32
    # shift + drag from an anchor: its handle on that side drawn
    # out (h_at, where the handle was); h_wait until it moves
    mutable h_wait  : bool
    mutable h_from  : SvgPoint
    mutable h_drag  : SvgPoint
    mutable h_at    : vec2f
    mutable press_x : f32
    mutable press_y : f32
    # a plain press on a point or inside a shape: past 4 px the
    # picked points (or the chosen shapes) follow, as g, until
    # the release; a click alone picks that one (d_point, d_hit)
    mutable d_wait   : bool
    mutable d_moving : bool
    mutable d_point  : SvgPoint
    mutable d_hit    : i32 [ -1 ]
    # b or c: a box (1) or circle (2) select; 0 none
    mutable region   : i32
    mutable region_x : f32
    mutable region_y : f32
    mutable pointer_x : f32
    mutable pointer_y : f32
    # p: a new path drawn; a node is an anchor and its two
    # handles (x y, in x y, out x y), a drag drawing its handles
    mutable pen      : bool
    # t: a click places a text, then typing goes into it (its
    # 'Text' replaced by the first letter) until enter or escape
    mutable texting  : bool
    mutable typing   : i32 [ -1 ]
    mutable placeholder : bool
    mutable pen_nodes : vec f32
    mutable pen_drag : bool
    mutable pen_at   : vec2f
    # o: a linked offset made (or an offset's distance changed)
    # by the pointer or a typed number; off_shape -1 is a new one
    mutable offsetting : bool
    mutable off_shape  : i32
    mutable off_from   : f32
    mutable off_r      : f32
    mutable preview    : vec SVGCmd
    # a linked offset's one knob: dragged, it sets the distance;
    # it sits by the source's point knob_q (of shape knob_of)
    mutable knob_drag  : bool
    # a gradient's handle dragged: 1 its start (a radial's
    # centre), 2 its end (a radial's radius); the paint it is
    mutable g_drag     : i32
    mutable g_key      : string
    # the handle picked last (1 start, 2 end) and its shape
    mutable g_pick     : i32
    mutable g_shape    : i32
    mutable knob_of    : i32 [ -1 ]
    mutable knob_q     : vec2f
    # the way from knob_q to the knob, as last dragged
    mutable knob_d     : vec2f
    # a number being typed, its axes, and values typed
    mutable typing_text : string
    mutable typing_mask : i32
    mutable typed_v     : vec f32
    mutable typed_on    : vec i32
    # s: sized about the points' middle; grow 0 is as was
    mutable sizing  : bool
    mutable grow    : f32
    # r: turned about the pivot; the pointer's angle at the start
    mutable turning : bool
    mutable turn_at : f32
    # the start's angle is taken once the pointer is clear of the
    # pivot (shift + r starts on it)
    mutable turn_ref : bool
    # shift + g: moved only along the way the pointer first
    # goes (taken once it is 8 px from where it started)
    mutable along     : bool
    mutable along_px  : f32
    mutable along_py  : f32
    mutable along_ref : bool
    mutable along_x   : f32
    mutable along_y   : f32
    # the edit lines, drawn solid here, then put down once at
    # line_alpha (crossings do not double)
    mutable line_layer : Canvas
    public  line_alpha : f32 [ 0.3 ]
    # the pointer's light: the layer again through a soft circle
    mutable near_mask  : Canvas
    # the picked points' pass (solid, over the layer)
    mutable solid      : bool
    mutable pivot_x : f32
    mutable pivot_y : f32
    mutable before : vec SVGCmd
    # the shape of each moved point (several chosen move together)
    # and the text before such a move (its undo)
    mutable moved_of : vec i32
    mutable multi_text : string
    # whole shapes moved by their transform: each one's number,
    # its transform at the start and its parent's space (six
    # numbers each: ma mb mc md tx ty)
    mutable whole_ids  : vec i32
    mutable whole_t0   : vec f32
    mutable whole_par  : vec f32

    func fit []
        w : f32 [ doc.model.w ]
        h : f32 [ doc.model.h ]
        zoom_goal = min[ (bounds.w - 80.0) / w, (bounds.h - 80.0) / h ]
        if [ zoom_goal <= 0.0 ] zoom_goal = 1.0
        ox_goal = (bounds.w - w * zoom_goal) * 0.5
        oy_goal = (bounds.h - h * zoom_goal) * 0.5
        # the first fit is at once; home eases there
        if [ !fitted ]
            zoom = zoom_goal
            ox = ox_goal
            oy = oy_goal
        fitted = true

    # every movement part of the way to its goal, this frame
    func ease_frame []
        ff : f32 [ (ux) ? ux.frame_factor : 1.0 ]
        ox   = filter_n[ ox, ox_goal, view_ease, ff ]
        oy   = filter_n[ oy, oy_goal, view_ease, ff ]
        zoom = filter_n[ zoom, zoom_goal, view_ease, ff ]
        if [ moving ]
            g : goal[]
            n : vec2f [ filter_n[ shown_g.x, g.x, ease, ff ],
                        filter_n[ shown_g.y, g.y, ease, ff ] ]
            if [ abs[ n.x - shown_g.x ] + abs[ n.y - shown_g.y ]
                 > 1e-7 ]
                shown_g = n
                place_moved[]
        if [ offsetting ]
            r : f32 [ filter_n[ off_shown, offset_goal[], ease, ff ] ]
            if [ abs[ r - off_shown ] > 1e-7 ]
                off_shown = r
                apply_offset[]
        if [ h_drag ]
            hn : vec2f [ filter_n[ h_shown.x, h_goal.x, ease, ff ],
                         filter_n[ h_shown.y, h_goal.y, ease, ff ] ]
            if [ abs[ hn.x - h_shown.x ] + abs[ hn.y - h_shown.y ]
                 > 1e-7 ]
                h_shown = hn
                doc.set_point[ doc.chosen, h_drag, hn.x, hn.y ]
                doc.hold_node[ doc.chosen, h_drag ]
                doc.follow[ doc.chosen, 0 ]

    # the chosen shape's fill or stroke gradient (null none)
    func paint_of [ key: string ] -> SVGPaint
        if [ !doc || doc.chosen < 0 || doc.chosen >= doc.count[] ]
            return null
        sh : doc.model.shapes[ doc.chosen ]
        if [ key.compare[ 'fill' ] == 0 ] return sh.fill_paint
        return sh.stroke_paint

    # the gradient whose handle is held (g_key names it)
    func grad_paint [] -> SVGPaint
        if [ !g_key ] return null
        return paint_of[ g_key ]

    # a paint's handles on the page: start (centre) then end (a
    # radial's radius point, out along x by the radius as drawn:
    # its units' mean scale)
    func grad_ends [ pt: SVGPaint ] -> vec f32
        m : pt.to_page
        cx : f32 [ m.apply_x[ pt.ax, pt.ay ] ]
        cy : f32 [ m.apply_y[ pt.ax, pt.ay ] ]
        if [ pt.kind == 2 ]
            k : f32 [ sqrt[ abs[ m.ma * m.md - m.mb * m.mc ] ] ]
            return vec f32 [] [ cx, cy, cx + pt.r * k, cy ]
        return vec f32 [] [ cx, cy, m.apply_x[ pt.bx, pt.by ],
                            m.apply_y[ pt.bx, pt.by ] ]

    # the handle under the pointer (10 px), the fill's or the
    # stroke's, nearest (g_key set to it): 1 start, 2 end, 0 none.
    # On one spot the one not held last wins: a press again
    # takes the other
    func grad_hit [ px: f32, py: f32 ] -> i32
        best : f32 [ 100.0 ]
        out : i32 [ 0 ]
        which : string [ '' ]
        held : string [ (g_key) ? g_key : 'stroke' ]
        for [ key: string ] in vec string [] [ 'fill', 'stroke' ]
            pt : paint_of[ key ]
            if [ !pt ] continue
            e : grad_ends[ pt ]
            for [ k: i32 0, k < 2, k += 1 ]
                dx : f32 [ sx[ e[ k * 2 ] ] - px ]
                dy : f32 [ sy[ e[ k * 2 + 1 ] ] - py ]
                d : f32 [ dx * dx + dy * dy ]
                tie : bool [ abs[ d - best ] < 1.0
                             && key.compare[ held ] != 0 ]
                if [ d < best - 1.0 || (out > 0 && tie) ]
                    best = d
                    out = k + 1
                    which = key
        if [ out > 0 ] g_key = which
        return out

    # the dragged handle to the pointer, in the gradient's units
    func grad_to [ px: f32, py: f32 ]
        pt : grad_paint[]
        if [ !pt ] return
        inv : affine_inverse[ pt.to_page ]
        qx : f32 [ (px - ox) / zoom ]
        qy : f32 [ (py - oy) / zoom ]
        gx : f32 [ inv.apply_x[ qx, qy ] ]
        gy : f32 [ inv.apply_y[ qx, qy ] ]
        if [ g_drag == 1 ]
            pt.ax = gx
            pt.ay = gy
        el [ pt.kind == 2 ]
            # the radius on the page, back by the mean scale
            m : pt.to_page
            k : f32 [ sqrt[ abs[ m.ma * m.md - m.mb * m.mc ] ] ]
            cx : f32 [ m.apply_x[ pt.ax, pt.ay ] ]
            cy : f32 [ m.apply_y[ pt.ax, pt.ay ] ]
            pt.r = sqrt[ (qx - cx) * (qx - cx) + (qy - cy) * (qy - cy) ]
                   / max[ k, 1e-6 ]
        el
            pt.bx = gx
            pt.by = gy
        doc.changed = true

    # while s or r runs, its pivot: a clear circle, a 1 px grey
    # outline on half pixels
    func draw_pivot [ cv: Canvas ]
        if [ !moving ] return
        # shift + g: its line, faint, through the start's middle
        if [ along && along_ref ]
            cx : f32 [ sx[ pivot_x ] ]
            cy : f32 [ sy[ pivot_y ] ]
            far : f32 [ 4000.0 ]
            cv.save[]
            cv.fill_color[ '#0000' ]
            cv.stroke_color[ '#9a9aa680' ]
            cv.stroke_width[ 1.0 ]
            cv.move_to[ cx - along_x * far, cy - along_y * far ]
            cv.line_to[ cx + along_x * far, cy + along_y * far ]
            cv.paint[]
            cv.restore[]
        if [ !(sizing || turning) ] return
        px : f32 [ floor[ sx[ pivot_x ] ] + 0.5 ]
        py : f32 [ floor[ sy[ pivot_y ] ] + 0.5 ]
        cv.save[]
        cv.fill_color[ '#0000' ]
        cv.stroke_color[ '#9a9aa6' ]
        cv.stroke_width[ 1.0 ]
        cv.rounded_rect[ px - 3.0, py - 3.0, 6.0, 6.0, 3.0, 3.0, 3.0,
                         3.0 ]
        cv.paint[]
        cv.restore[]

    # the fill's handles yellow, the stroke's pink
    # the edit lines' layer, cleared, the view's size
    func lines_begin [ cv: Canvas ] -> Canvas
        lw : i32 [ max[ 1, i32[ ceil[ bounds.w ] ] ] ]
        lh : i32 [ max[ 1, i32[ ceil[ bounds.h ] ] ] ]
        if [ !line_layer ]
            line_layer = Canvas [ vk: cv.vk, w: cv.w, width: lw,
                                  height: lh, load_existing: true,
                                  quantize: true ]
            line_layer.update[]
        ln : line_layer
        ln.resize[ lw, lh ]
        ln.fresh_state[]
        ln.clear_recorded[ vec4f [ 0.0, 0.0, 0.0, 0.0 ] ]
        return ln

    # the layer put down once at line_alpha, then again through
    # a circle round the pointer (trinity's near light, (1 - d /
    # 160)^2) so near it all reaches full
    func lines_end [ cv: Canvas ]
        ln : line_layer
        fw : f32 [ f32[ ln.content_w ] ]
        fh : f32 [ f32[ ln.content_h ] ]
        if [ !near_mask ]
            near_mask = Canvas [ vk: cv.vk, w: cv.w,
                                 width: ln.content_w,
                                 height: ln.content_h,
                                 load_existing: true, quantize: true ]
            near_mask.update[]
        nm : near_mask
        nm.resize[ ln.content_w, ln.content_h ]
        nm.fresh_state[]
        nm.clear_recorded[ vec4f [ 0.0, 0.0, 0.0, 0.0 ] ]
        rg : radial_gradient[ pointer_x, pointer_y, 0.0, 160.0 ]
        for [ k: i32 0, k <= 8, k += 1 ]
            t : f32 [ k / 8.0 ]
            w : f32 [ (1.0 - t) * (1.0 - t) ]
            av : u32 [ u32[ w * 255.0 ] ]
            rg.add_stop[ t, (av << 24) | 0xffffff ]
        nm.stroke_width[ 0.0 ]
        nm.set_fill_gradient[ rg ]
        nm.rect_to[ 0.0, 0.0, fw, fh ]
        nm.paint[]
        nm.clear_fill_gradient[]
        ln.seal[]
        cv.save[]
        cv.set_opacity[ line_alpha ]
        cv.draw_canvas[ ln, 0.0, 0.0, fw, fh ]
        cv.set_opacity[ 1.0 - line_alpha ]
        cv.draw_canvas_through[ ln, nm, false, 0.0, 0.0, fw, fh ]
        cv.restore[]
        # the layers are cleared next frame: their reads done
        cv.sync_fence[]

    # the gradients' lines (into ln) or their circles (on cv)
    func draw_grad [ cv: Canvas, ln: Canvas, dots: bool ]
        draw_grad_of[ cv, ln, dots, paint_of[ 'stroke' ], '#ff6fd0',
                      'stroke' ]
        draw_grad_of[ cv, ln, dots, paint_of[ 'fill' ], '#ffcf4a',
                      'fill' ]

    # the handles drawn: a line start to end, a circle at each,
    # a white one inside the picked; a radial's circle through
    # its end
    func draw_grad_of [ cv: Canvas, ln: Canvas, dots: bool,
                        pt: SVGPaint, col: string, key: string ]
        if [ !pt ] return
        e : grad_ends[ pt ]
        ax : f32 [ sx[ e[ 0 ] ] ]
        ay : f32 [ sy[ e[ 1 ] ] ]
        bx : f32 [ sx[ e[ 2 ] ] ]
        by : f32 [ sy[ e[ 3 ] ] ]
        if [ !dots ]
            ln.fill_color[ '#0000' ]
            ln.stroke_color[ rgba [ col ] ]
            ln.stroke_width[ 1.5 ]
            if [ pt.kind == 2 ]
                rad : f32 [ sqrt[ (bx - ax) * (bx - ax)
                                  + (by - ay) * (by - ay) ] ]
                ln.rounded_rect[ ax - rad, ay - rad, rad * 2.0,
                                 rad * 2.0, rad, rad, rad, rad ]
                ln.paint[]
            ln.move_to[ ax, ay ]
            ln.line_to[ bx, by ]
            ln.paint[]
            ln.stroke_width[ 0.0 ]
            return
        cv.save[]
        cv.stroke_width[ 0.0 ]
        mine : bool [ g_shape == doc.chosen && g_key
                      && g_key.compare[ key ] == 0 ]
        ends : vec f32 [] [ ax, ay, bx, by ]
        for [ k: i32 0, k < 2, k += 1 ]
            hx : f32 [ ends[ k * 2 ] ]
            hy : f32 [ ends[ k * 2 + 1 ] ]
            # the picked one solid over the layer, the rest in it
            if [ (mine && g_pick == k + 1) != solid ] continue
            # larger near the pointer; under it (10 px) brighter
            r : f32 [ (solid) ? 5.0
                      : 5.0 * (0.5 + 0.5 * near_w[ hx, hy ]) ]
            dx : f32 [ pointer_x - hx ]
            dy : f32 [ pointer_y - hy ]
            if [ dx * dx + dy * dy < 100.0 ]
                cv.fill_color[ brighter[ col ] ]
            el
                cv.fill_color[ rgba [ col ] ]
            cv.rounded_rect[ hx - r, hy - r, r * 2.0, r * 2.0, r, r,
                             r, r ]
            cv.paint[]
            if [ mine && g_pick == k + 1 ]
                ri : f32 [ r * 0.5 ]
                cv.fill_color[ '#ffffff' ]
                cv.rounded_rect[ hx - ri, hy - ri, ri * 2.0, ri * 2.0,
                                 ri, ri, ri, ri ]
                cv.paint[]
        cv.restore[]

    func sx [ x: f32 ] -> f32
        return ox + x * zoom
    func sy [ y: f32 ] -> f32
        return oy + y * zoom

    # the chosen shape's point nearest the pointer, within 10 px
    func nearest [ px: f32, py: f32 ] -> SvgPoint
        best : f32 [ 100.0 ]
        out : SvgPoint null
        # an offset's points are made from its source: not picked
        if [ doc.chosen >= 0 && doc.offset_src[ doc.chosen ] >= 0 ]
            return null
        for [ p: SvgPoint ] in doc.points_of[ doc.chosen ]
            at : doc.point[ doc.chosen, p ]
            dx : f32 [ sx[ at.x ] - px ]
            dy : f32 [ sy[ at.y ] - py ]
            d : f32 [ dx * dx + dy * dy ]
            if [ d < best ]
                best = d
                out = p
        return out

    func moved_has [ p: SvgPoint ] -> bool
        for [ q: SvgPoint ] in moved
            if [ q.cmd == p.cmd && q.slot == p.slot ] return true
        return false

    func is_picked [ p: SvgPoint ] -> bool
        if [ !picked ] return false
        for [ q: SvgPoint ] in picked
            if [ q.cmd == p.cmd && q.slot == p.slot ] return true
        return false

    public func on_press [ ev: Event ]
        if [ !doc ] return
        # a box or circle: a left click picks, any other drops it
        if [ region != 0 ]
            pointer_x = ev.mouse.pos.x
            pointer_y = ev.mouse.pos.y
            if [ ev.mouse.button == 0 ]
                end_region[ ux && (ux.shift || ux.cmd) ]
            el
                region = 0
            return
        if [ pen ]
            pen_press[ ev ]
            return
        if [ typing >= 0 ] typing = -1
        if [ texting ]
            texting = false
            if [ ev.mouse.button != 0 ] return
            # 24 screen pixels tall at this zoom
            x : f32 [ (ev.mouse.pos.x - ox) / zoom ]
            y : f32 [ (ev.mouse.pos.y - oy) / zoom ]
            if [ doc.add_text[ x, y, 24.0 / zoom ] ]
                typing = doc.chosen
                placeholder = true
                picked = vec SvgPoint []
            return
        # a gradient's handle: a drag moves it (one undo; a shared
        # gradient first copied for this shape alone)
        if [ !offsetting && !moving && ev.mouse.button == 0 ]
            hit : i32 [ grad_hit[ ev.mouse.pos.x, ev.mouse.pos.y ] ]
            if [ hit > 0 ]
                at : i32 [ doc.chosen ]
                was : doc.compose[]
                if [ !doc.grad_own[ at, g_key ] ]
                    pt : grad_paint[]
                    doc.set_gradient[ at, g_key, svg_paint_text[ pt ] ]
                doc.undo.push[ SvgUndo [ shape: -1, text: was ] ]
                g_drag = hit
                g_pick = hit
                g_shape = at
                ux.set_capture[ a ]
                return
        # an offset's knob: a drag sets its distance
        if [ !offsetting && !moving && ev.mouse.button == 0
             && doc.chosen >= 0 && doc.offset_src[ doc.chosen ] >= 0 ]
            kb : knob_at[]
            dx : f32 [ sx[ kb.z ] - ev.mouse.pos.x ]
            dy : f32 [ sy[ kb.w ] - ev.mouse.pos.y ]
            if [ dx * dx + dy * dy < 100.0 ]
                start_offset[]
                knob_drag = true
                return
        if [ offsetting ]
            if [ ev.mouse.button == 1 ]
                cancel_offset[]
            el
                end_offset[]
            return
        if [ moving ]
            if [ ev.mouse.button == 1 ]
                cancel_move[]
            el
                end_move[]
            return
        # cmd + click on a node: cusp, smooth, symmetric in turn
        if [ ev.mouse.button == 0 && ux && ux.cmd ]
            np : nearest[ ev.mouse.pos.x, ev.mouse.pos.y ]
            if [ np && np.slot == 0 ]
                doc.undo.push[ SvgUndo [ shape: -1,
                                         text: doc.compose[] ] ]
                was : i32 [ doc.type_at[ doc.chosen, np.cmd ] ]
                kind : i32 [ (was + 1) % 3 ]
                doc.set_type[ doc.chosen, np.cmd, kind ]
                doc.align_node[ doc.chosen, np.cmd ]
                doc.mark[ doc.chosen ]
                return
        if [ ev.mouse.button != 0 || (ux && ux.cmd) ]
            mode = 1
            return
        mode = 0
        if [ !picked ] picked = vec SvgPoint []
        adding : bool [ ux && ux.shift ]
        # a point of the chosen shape first, else a shape
        p : nearest[ ev.mouse.pos.x, ev.mouse.pos.y ]
        # a double click on a segment: a node put in there
        if [ !p && ev.mouse.double_click && doc.chosen >= 0 ]
            sh : doc.model.shapes[ doc.chosen ]
            was : vec SVGCmd [ sh.cmds ]
            bx : f32 [ (ev.mouse.pos.x - ox) / zoom ]
            by : f32 [ (ev.mouse.pos.y - oy) / zoom ]
            np : doc.split_at[ doc.chosen, bx, by, 6.0 / zoom ]
            if [ np ]
                doc.undo.push[ SvgUndo [ shape: doc.chosen,
                                         cmds: was ] ]
                doc.mark[ doc.chosen ]
                picked = vec SvgPoint [] [ np ]
                return
        # shift: a drag from here draws out a handle
        if [ p && adding ]
            h_wait = true
            h_from = p
            h_drag = null
            press_x = ev.mouse.pos.x
            press_y = ev.mouse.pos.y
        d_point = null
        d_hit = -1
        if [ p ]
            # a picked point keeps the others for the drag
            if [ adding || !is_picked[ p ] ]
                if [ !adding ] picked.clear[]
                for [ q: SvgPoint ] in doc.same_spot[ doc.chosen, p ]
                    doc.add_point[ picked, q ]
            el
                d_point = p
            if [ !adding ] drag_wait[ ev ]
            return
        x : f32 [ (ev.mouse.pos.x - ox) / zoom ]
        y : f32 [ (ev.mouse.pos.y - oy) / zoom ]
        hit : doc.shape_at[ x, y, 4.0 / zoom ]
        # shift: the shape in or out of the choice
        if [ adding ]
            doc.toggle[ hit ]
        el [ hit >= 0 && doc.is_chosen[ hit ] ]
            d_hit = hit
        el
            doc.choose_one[ hit ]
        picked.clear[]
        if [ !adding && hit >= 0 ] drag_wait[ ev ]

    func drag_wait [ ev: Event ]
        d_wait = true
        press_x = ev.mouse.pos.x
        press_y = ev.mouse.pos.y

    public func on_release [ ev: Event ]
        mode = 0
        pen_drag = false
        h_wait = false
        if [ d_moving ]
            d_moving = false
            ux.release_capture[ a ]
            if [ moving ] end_move[]
            return
        if [ d_wait ]
            d_wait = false
            if [ d_point ]
                picked.clear[]
                for [ q: SvgPoint ] in doc.same_spot[ doc.chosen,
                                                      d_point ]
                    doc.add_point[ picked, q ]
            if [ d_hit >= 0 ] doc.choose_one[ d_hit ]
        if [ g_drag > 0 ]
            g_drag = 0
            ux.release_capture[ a ]
            doc.set_grad_geometry[ doc.chosen, g_key ]
            return
        if [ knob_drag ]
            knob_drag = false
            end_offset[]
            return
        if [ h_drag ]
            # kept where the pointer left it, not the eased place
            doc.set_point[ doc.chosen, h_drag, h_goal.x, h_goal.y ]
            doc.hold_node[ doc.chosen, h_drag ]
            doc.mark[ doc.chosen ]
            picked = vec SvgPoint [] [ h_drag ]
            h_drag = null

    public func on_move [ ev: Event ]
        pointer_x = ev.mouse.pos.x
        pointer_y = ev.mouse.pos.y
        if [ g_drag > 0 ]
            grad_to[ ev.mouse.pos.x, ev.mouse.pos.y ]
            return
        if [ mode == 1 ]
            ox_goal += ev.mouse.delta.x
            oy_goal += ev.mouse.delta.y
            return
        # shift held: a quarter as fast, for fine placing
        fine : f32 [ (ux && ux.shift) ? 0.25 : 1.0 ]
        if [ pen ]
            pen_at = vec2f [ (ev.mouse.pos.x - ox) / zoom,
                             (ev.mouse.pos.y - oy) / zoom ]
            # a drag from the last node draws its handles out,
            # the one behind it mirrored
            n : i32 [ pen_nodes.count ]
            if [ pen_drag && n >= 6 ]
                ax : f32 [ pen_nodes[ n - 6 ] ]
                ay : f32 [ pen_nodes[ n - 5 ] ]
                pen_nodes[ n - 2 ] = pen_at.x
                pen_nodes[ n - 1 ] = pen_at.y
                pen_nodes[ n - 4 ] = 2.0 * ax - pen_at.x
                pen_nodes[ n - 3 ] = 2.0 * ay - pen_at.y
            return
        # the knob: the distance is the pointer's from the source
        if [ knob_drag ]
            src : doc.offset_src[ doc.chosen ]
            if [ src < 0 ] return
            x : f32 [ (ev.mouse.pos.x - ox) / zoom ]
            y : f32 [ (ev.mouse.pos.y - oy) / zoom ]
            r : signed_reach[ doc.model.shapes[ src ].cmds, x, y,
                              0.25 / zoom ]
            off_r = r.x
            knob_of = doc.chosen
            knob_q = vec2f [ r.z, r.w ]
            dx : f32 [ x - r.z ]
            dy : f32 [ y - r.w ]
            dl : f32 [ sqrt[ dx * dx + dy * dy ] ]
            if [ dl > 1e-6 ] knob_d = vec2f [ dx / dl, dy / dl ]
            return
        if [ offsetting ]
            off_r = off_r + ev.mouse.delta.x * fine / zoom
            return
        if [ h_wait ]
            drag_handle[ ev.mouse.pos.x, ev.mouse.pos.y ]
            return
        if [ d_wait ]
            mx : f32 [ ev.mouse.pos.x - press_x ]
            my : f32 [ ev.mouse.pos.y - press_y ]
            if [ mx * mx + my * my < 16.0 ] return
            d_wait = false
            start_move[ false ]
            if [ !moving ] return
            d_moving = true
            shift_x = mx / zoom
            shift_y = my / zoom
            ux.set_capture[ a ]
            return
        if [ !moving ] return
        if [ turning ] return
        if [ sizing ]
            grow = grow + ev.mouse.delta.x * 0.004 * fine
            return
        shift_x += ev.mouse.delta.x * fine / zoom
        shift_y += ev.mouse.delta.y * fine / zoom

    # the wheel zooms about the pointer
    public func on_wheel [ ev: Event ]
        k : f32 [ pow[ 1.1, ev.mouse.wheel_delta.y ] ]
        px : f32 [ ev.mouse.pos.x ]
        py : f32 [ ev.mouse.pos.y ]
        ox_goal = px - (px - ox_goal) * k
        oy_goal = py - (py - oy_goal) * k
        zoom_goal = zoom_goal * k

    # g: the picked points, or the whole chosen shape, follow
    # the pointer
    func start_move [ size: bool ]
        start_op[ size, false ]

    # g, s or r (turn) started; with shift held, s and r work
    # about the point under the pointer, else the box's middle
    func start_op [ size: bool, turn: bool ]
        if [ doc.chosen < 0 ] return
        sh : doc.model.shapes[ doc.chosen ]
        list : vec SvgPoint []
        moved_of = vec i32 []
        multi_text = null
        if [ picked && picked.count > 0 ]
            list = doc.carried[ doc.chosen, picked ]
            for [ p: SvgPoint ] in list
                moved_of.push[ doc.chosen ]
        el
            # whole shapes: their transforms are set, their points
            # stay (the points give the box and its middle)
            ids : doc.selected[]
            multi_text = doc.compose[]
            whole_ids = vec i32 []
            whole_t0  = vec f32 []
            whole_par = vec f32 []
            for [ i: i32 ] in ids
                whole_ids.push[ i ]
                ws : doc.model.shapes[ i ]
                tt : svg_value[ ws.node, 'transform' ]
                t0 : affine.identity[]
                if [ tt.count > 0 ] t0 = svg_parse_transform[ tt ]
                par : ws.space.multiply[ affine_inverse[ t0 ] ]
                push_six[ whole_t0, t0 ]
                push_six[ whole_par, par ]
                for [ p: SvgPoint ] in doc.all_points[ i ]
                    list.push[ p ]
                    moved_of.push[ i ]
        if [ list.count == 0 ] return
        moved = list
        from = vec f32 []
        for [ k: i32 0, k < moved.count, k += 1 ]
            at : doc.point[ moved_of[ k ], moved[ k ] ]
            from.push[ at.x ]
            from.push[ at.y ]
        before = vec SVGCmd [ sh.cmds ]
        shift_x = 0.0
        shift_y = 0.0
        lock = 0
        typing_text = ''
        typing_mask = 0
        typed_v  = vec f32 [ 2 ]
        typed_on = vec i32 [ 2 ]
        moving = true
        sizing = size && !turn
        turning = turn
        grow = 0.0
        # the middle of the points' box
        lo_x : f32 [ from[ 0 ] ]
        hi_x : f32 [ from[ 0 ] ]
        lo_y : f32 [ from[ 1 ] ]
        hi_y : f32 [ from[ 1 ] ]
        for [ k: i32 0, k < moved.count, k += 1 ]
            lo_x = min[ lo_x, from[ k * 2 ] ]
            hi_x = max[ hi_x, from[ k * 2 ] ]
            lo_y = min[ lo_y, from[ k * 2 + 1 ] ]
            hi_y = max[ hi_y, from[ k * 2 + 1 ] ]
        pivot_x = (lo_x + hi_x) * 0.5
        pivot_y = (lo_y + hi_y) * 0.5
        if [ (sizing || turning) && ux && ux.shift ]
            pivot_x = (pointer_x - ox) / zoom
            pivot_y = (pointer_y - oy) / zoom
        turn_ref = false
        along = !sizing && !turning && ux && ux.shift
        along_ref = false
        along_px = pointer_x
        along_py = pointer_y
        shown_g = goal[]

    # shift + g's way: the pointer's first 8 px (false until)
    func along_way [] -> bool
        if [ along_ref ] return true
        dx : f32 [ pointer_x - along_px ]
        dy : f32 [ pointer_y - along_py ]
        dl : f32 [ sqrt[ dx * dx + dy * dy ] ]
        if [ dl < 8.0 ] return false
        along_x = dx / dl
        along_y = dy / dl
        along_ref = true
        return true

    # the pointer's distance from the pivot, in screen pixels
    func pointer_off [] -> f32
        dx : f32 [ pointer_x - sx[ pivot_x ] ]
        dy : f32 [ pointer_y - sy[ pivot_y ] ]
        return sqrt[ dx * dx + dy * dy ]

    # the pointer's angle about the pivot, in degrees
    func pointer_angle [] -> f32
        dx : f32 [ (pointer_x - ox) / zoom - pivot_x ]
        dy : f32 [ (pointer_y - oy) / zoom - pivot_y ]
        return atan2[ dy, dx ] * 180.0 / 3.14159265

    # x and y: typed values win, else the pointer's
    func goal [] -> vec2f
        rest : f32 [ (sizing) ? 1.0 : 0.0 ]
        typed : bool [ typing_text.count > 0 || typed_on[ 0 ] != 0
                       || typed_on[ 1 ] != 0 ]
        if [ typed ]
            g : vec f32 [] [ rest, rest ]
            for [ a: i32 0, a < 2, a += 1 ]
                if [ typed_on[ a ] != 0 ] g[ a ] = typed_v[ a ]
            if [ typing_text.count > 0 ]
                m : i32 [ (typing_mask != 0) ? typing_mask
                          : default_mask[] ]
                for [ a: i32 0, a < 2, a += 1 ]
                    if [ (m & (1 << a)) != 0 ] g[ a ] = typing_number[]
            # along a line: the number is the distance on it
            if [ along ]
                if [ !along_way[] ] return vec2f [ 0.0, 0.0 ]
                return vec2f [ along_x * g[ 0 ], along_y * g[ 0 ] ]
            return vec2f [ g[ 0 ], g[ 1 ] ]
        if [ along ]
            if [ !along_way[] ] return vec2f [ 0.0, 0.0 ]
            d : f32 [ shift_x * along_x + shift_y * along_y ]
            return vec2f [ along_x * d, along_y * d ]
        # a turn: the pointer's angle since the start, the short
        # way round
        if [ turning ]
            if [ !turn_ref ]
                if [ pointer_off[] < 8.0 ] return vec2f [ 0.0, 0.0 ]
                turn_at = pointer_angle[]
                turn_ref = true
            d : f32 [ pointer_angle[] - turn_at ]
            while [ d > 180.0 ] d -= 360.0
            while [ d < -180.0 ] d += 360.0
            return vec2f [ d, 0.0 ]
        f : f32 [ max[ 1.0 + grow, 0.01 ] ]
        px : f32 [ (sizing) ? f : shift_x ]
        py : f32 [ (sizing) ? f : shift_y ]
        if [ lock == 2 ] px = rest
        if [ lock == 1 ] py = rest
        return vec2f [ px, py ]

    # the number typed so far, or none
    func typing_number [] -> f32
        if [ typing_text.count == 0 || typing_text == '-'
             || typing_text == '.' ] return 0.0
        return f32[ typing_text ]

    # a number with no axis: x for g, both for s
    func default_mask [] -> i32
        if [ lock != 0 ] return lock
        if [ turning ] return 1
        return (sizing) ? 3 : 1

    # the typed number given to every axis of its group
    func commit_typing []
        if [ typing_text.count == 0 ] return
        m : i32 [ (typing_mask != 0) ? typing_mask : default_mask[] ]
        for [ a: i32 0, a < 2, a += 1 ]
            if [ (m & (1 << a)) != 0 ]
                typed_v[ a ] = typing_number[]
                typed_on[ a ] = 1
        typing_text = ''
        typing_mask = 0

    # a shift + drag: past 4 px the handle on the drag's side is
    # taken (or made), then it follows the pointer
    func drag_handle [ px: f32, py: f32 ]
        dx : f32 [ (px - press_x) / zoom ]
        dy : f32 [ (py - press_y) / zoom ]
        if [ !h_drag ]
            mx : f32 [ px - press_x ]
            my : f32 [ py - press_y ]
            if [ mx * mx + my * my < 16.0 ] return
            sh : doc.model.shapes[ doc.chosen ]
            before = vec SVGCmd [ sh.cmds ]
            h_drag = (h_from.slot == 0)
                ? doc.handle_toward[ doc.chosen, h_from.cmd, dx, dy ]
                : h_from
            if [ !h_drag ]
                h_wait = false
                return
            doc.undo.push[ SvgUndo [ shape: doc.chosen,
                                     cmds: before ] ]
            h_at = doc.point[ doc.chosen, h_drag ]
            h_shown = h_at
            picked = vec SvgPoint [] [ h_drag ]
        h_goal = vec2f [ h_at.x + dx, h_at.y + dy ]

    # a point on screen inside the box or circle being drawn
    func in_region [ px: f32, py: f32 ] -> bool
        if [ region == 1 ]
            return px >= minf[ region_x, pointer_x ]
                && px <= maxf[ region_x, pointer_x ]
                && py >= minf[ region_y, pointer_y ]
                && py <= maxf[ region_y, pointer_y ]
        dx : f32 [ pointer_x - region_x ]
        dy : f32 [ pointer_y - region_y ]
        ex : f32 [ px - region_x ]
        ey : f32 [ py - region_y ]
        return ex * ex + ey * ey <= dx * dx + dy * dy

    # the region's pick: the chosen shape's nodes and handles in
    # it, else the shapes wholly in it; shift or cmd adds
    func end_region [ adding: bool ]
        region_kind : i32 [ region ]
        region = 0
        if [ doc.chosen >= 0 ]
            if [ !picked || !adding ] picked = vec SvgPoint []
            # nodes and handles (the bezier weights) alike
            for [ p: SvgPoint ] in doc.points_of[ doc.chosen ]
                at : doc.point[ doc.chosen, p ]
                region = region_kind
                inside : bool [ in_region[ sx[ at.x ], sy[ at.y ] ] ]
                region = 0
                if [ inside ] doc.add_point[ picked, p ]
            return
        if [ !adding ] doc.choose_one[ -1 ]
        for [ i: i32 0, i < doc.count[], i += 1 ]
            edge : doc.outline[ i ]
            whole : bool [ edge.count > 0 ]
            region = region_kind
            for [ k: i32 0, k + 1 < edge.count, k += 2 ]
                if [ edge[ k ] < -1.0e8 ] continue
                ex : f32 [ sx[ edge[ k ] ] ]
                ey : f32 [ sy[ edge[ k + 1 ] ] ]
                if [ !in_region[ ex, ey ] ]
                    whole = false
                    break
            region = 0
            if [ whole && !doc.is_chosen[ i ] ] doc.toggle[ i ]

    # the box or circle from where b or c was pressed
    func draw_region [ cv: Canvas ]
        if [ region == 0 ] return
        cv.fill_color[ '#ffffff14' ]
        cv.stroke_color[ '#ffffffcc' ]
        cv.stroke_width[ 1.0 ]
        if [ region == 1 ]
            cv.rect_to[ minf[ region_x, pointer_x ],
                        minf[ region_y, pointer_y ],
                        abs[ pointer_x - region_x ],
                        abs[ pointer_y - region_y ] ]
        el
            dx : f32 [ pointer_x - region_x ]
            dy : f32 [ pointer_y - region_y ]
            cv.arc[ region_x, region_y, sqrt[ dx * dx + dy * dy ],
                    0.0, 6.2831853 ]
        cv.paint[]

    # a click while drawing: a node there (a drag gives it
    # handles); on the first node, the shape is closed
    func pen_press [ ev: Event ]
        if [ ev.mouse.button != 0 ]
            pen_end[ false ]
            return
        x : f32 [ (ev.mouse.pos.x - ox) / zoom ]
        y : f32 [ (ev.mouse.pos.y - oy) / zoom ]
        n : i32 [ pen_nodes.count ]
        if [ n >= 12 ]
            dx : f32 [ (pen_nodes[ 0 ] - x) * zoom ]
            dy : f32 [ (pen_nodes[ 1 ] - y) * zoom ]
            if [ dx * dx + dy * dy < 64.0 ]
                pen_end[ true ]
                return
        for [ v: f32 ] in vec f32 [] [ x, y, x, y, x, y ]
            pen_nodes.push[ v ]
        pen_drag = true
        pen_at = vec2f [ x, y ]

    # drawing: enter keeps it open, escape drops it, backspace
    # takes the last node back
    func pen_key [ k: i32 ]
        if [ k == 257 || k == 335 ]
            pen_end[ false ]
            return
        if [ k == 256 ]
            pen = false
            pen_nodes = vec f32 []
            return
        if [ k != 259 || pen_nodes.count < 6 ] return
        keep : i32 [ pen_nodes.count - 6 ]
        rest : vec f32 []
        for [ q: i32 0, q < keep, q += 1 ]
            rest.push[ pen_nodes[ q ] ]
        pen_nodes = rest

    # the drawn path made (closed or not); fewer than two nodes
    # make nothing
    func pen_end [ closed: bool ]
        pen = false
        pen_drag = false
        n : i32 [ pen_nodes.count / 6 ]
        if [ n < 2 ] return
        cmds : vec SVGCmd []
        cmds.push[ SVGCmd [ op: SVGOp.move, x: pen_nodes[ 0 ],
                            y: pen_nodes[ 1 ] ] ]
        upto : i32 [ (closed) ? n : n - 1 ]
        for [ i: i32 1, i <= upto, i += 1 ]
            a : i32 [ (i - 1) * 6 ]
            b : i32 [ (i % n) * 6 ]
            # handles on their anchors: a straight line
            flat : bool [ pen_nodes[ a + 4 ] == pen_nodes[ a ]
                && pen_nodes[ a + 5 ] == pen_nodes[ a + 1 ]
                && pen_nodes[ b + 2 ] == pen_nodes[ b ]
                && pen_nodes[ b + 3 ] == pen_nodes[ b + 1 ] ]
            if [ flat ]
                cmds.push[ SVGCmd [ op: SVGOp.line, x: pen_nodes[ b ],
                                    y: pen_nodes[ b + 1 ] ] ]
            el
                cmds.push[ SVGCmd [ op: SVGOp.cubic,
                    x1: pen_nodes[ a + 4 ], y1: pen_nodes[ a + 5 ],
                    x2: pen_nodes[ b + 2 ], y2: pen_nodes[ b + 3 ],
                    x: pen_nodes[ b ], y: pen_nodes[ b + 1 ] ] ]
        if [ closed ] cmds.push[ SVGCmd [ op: SVGOp.close ] ]
        if [ doc.add_path[ cmds, 2.0 / zoom ] ]
            picked = vec SvgPoint []

    # the path being drawn: its segments, the line on to the
    # pointer, its nodes and the dragged handles
    func draw_pen [ cv: Canvas ]
        n : i32 [ pen_nodes.count / 6 ]
        cv.fill_color[ '#0000' ]
        cv.stroke_color[ '#ffcf4a' ]
        cv.stroke_width[ 1.5 ]
        if [ n > 0 ]
            cv.move_to[ sx[ pen_nodes[ 0 ] ], sy[ pen_nodes[ 1 ] ] ]
            for [ i: i32 1, i < n, i += 1 ]
                a : i32 [ (i - 1) * 6 ]
                b : i32 [ i * 6 ]
                cv.cubic_to[ sx[ pen_nodes[ a + 4 ] ],
                    sy[ pen_nodes[ a + 5 ] ], sx[ pen_nodes[ b + 2 ] ],
                    sy[ pen_nodes[ b + 3 ] ], sx[ pen_nodes[ b ] ],
                    sy[ pen_nodes[ b + 1 ] ] ]
            if [ !pen_drag ]
                l : i32 [ (n - 1) * 6 ]
                cv.cubic_to[ sx[ pen_nodes[ l + 4 ] ],
                    sy[ pen_nodes[ l + 5 ] ], sx[ pen_at.x ],
                    sy[ pen_at.y ], sx[ pen_at.x ], sy[ pen_at.y ] ]
            cv.paint[]
        cv.stroke_width[ 0.0 ]
        cv.fill_color[ '#ffcf4a' ]
        for [ i: i32 0, i < n, i += 1 ]
            o : i32 [ i * 6 ]
            cv.rect_to[ sx[ pen_nodes[ o ] ] - 3.5,
                        sy[ pen_nodes[ o + 1 ] ] - 3.5, 7.0, 7.0 ]
            cv.paint[]

    # the pen's handle lines, into the edit lines' layer
    func pen_handles [ ln: Canvas ]
        ln.fill_color[ '#0000' ]
        ln.stroke_color[ '#ffcf4a' ]
        ln.stroke_width[ 1.0 ]
        for [ i: i32 0, i < pen_nodes.count / 6, i += 1 ]
            o : i32 [ i * 6 ]
            ln.move_to[ sx[ pen_nodes[ o + 2 ] ],
                        sy[ pen_nodes[ o + 3 ] ] ]
            ln.line_to[ sx[ pen_nodes[ o + 4 ] ],
                        sy[ pen_nodes[ o + 5 ] ] ]
            ln.paint[]

    # o pressed: an offset of the chosen shape, or the chosen
    # offset's distance
    func start_offset []
        if [ doc.chosen < 0 || moving ] return
        typing_text = ''
        if [ doc.offset_src[ doc.chosen ] >= 0 ]
            off_shape = doc.chosen
            off_from = doc.radius_of[ doc.chosen ]
            doc.undo.push[ SvgUndo [ shape: -1, text: doc.compose[] ] ]
        el
            off_shape = -1
            off_from = 0.0
        off_r = off_from
        off_shown = off_from
        offsetting = true
        apply_offset[]

    # the distance asked for: typed, else the pointer's
    func offset_goal [] -> f32
        if [ typing_text.count > 0 ] return typing_number[]
        return off_r

    func apply_offset []
        r : f32 [ off_shown ]
        if [ off_shape >= 0 ]
            doc.set_radius[ off_shape, r ]
            return
        preview = offset_cmds[ doc.model.shapes[ doc.chosen ].cmds, r ]

    func end_offset []
        r : offset_goal[]
        offsetting = false
        preview = null
        if [ off_shape >= 0 ]
            doc.set_radius[ off_shape, r ]
        el [ r != 0.0 ]
            doc.make_offset[ doc.chosen, r ]
        typing_text = ''
        picked = vec SvgPoint []

    func cancel_offset []
        offsetting = false
        preview = null
        typing_text = ''
        if [ off_shape >= 0 ]
            doc.set_radius[ off_shape, off_from ]
            doc.undo.pop[]

    # what is typed, shown at the view's foot
    # a chosen text's box: a rounded rect set out from its
    # letters, in its own space (it turns with it), dark grey
    # with light grey dashes running round it
    func draw_text_box [ cv: Canvas ]
        sh : doc.model.shapes[ doc.chosen ]
        back : affine_inverse[ sh.space ]
        x0 : f32 [ 1e30 ]
        y0 : f32 [ 1e30 ]
        x1 : f32 [ -1e30 ]
        y1 : f32 [ -1e30 ]
        for [ c: SVGCmd ] in sh.cmds
            if [ c.op == SVGOp.close ] continue
            lx : f32 [ back.apply_x[ c.x, c.y ] ]
            ly : f32 [ back.apply_y[ c.x, c.y ] ]
            x0 = min[ x0, lx ]
            y0 = min[ y0, ly ]
            x1 = max[ x1, lx ]
            y1 = max[ y1, ly ]
        if [ x0 > x1 ] return
        # screen pixels a unit of the text's own space
        k : f32 [ zoom * sqrt[ abs[ sh.space.ma * sh.space.md
                                    - sh.space.mb * sh.space.mc ] ] ]
        if [ k <= 0.0 ] return
        pad : f32 [ 6.0 / k ]
        rad : f32 [ 5.0 / k ]
        x0 -= pad
        y0 -= pad
        x1 += pad
        y1 += pad
        span_w : f32 [ x1 - x0 - 2.0 * rad ]
        span_h : f32 [ y1 - y0 - 2.0 * rad ]
        arc : f32 [ 1.5707963 * rad ]
        total : f32 [ 2.0 * (span_w + span_h) + 4.0 * arc ]
        # 5 px of each colour, running 20 px a second
        step : f32 [ 1.5 / k ]
        dash : f32 [ 5.0 / k ]
        ms : i64 [ Au.epoch_millis[] % 100000 ]
        shift : f32 [ f32[ ms ] * 0.02 / k ]
        cv.save[]
        cv.fill_color[ '#0000' ]
        cv.stroke_width[ 1.0 ]
        for [ pass: i32 0, pass < 2, pass += 1 ]
            cv.stroke_color[ (pass == 0) ? '#3a3a3a' : '#c8c8c8' ]
            d : f32 [ 0.0 ]
            if [ pass == 1 ]
                d = shift - f32[ i64[ shift / (2.0 * dash) ] ]
                    * 2.0 * dash - 2.0 * dash
            while [ d < total ]
                a : f32 [ max[ d, 0.0 ] ]
                b : f32 [ (pass == 0) ? total : min[ d + dash,
                                                      total ] ]
                if [ b > a ]
                    from_at : vec2f rr_at[ a, x0, y0, span_w,
                                           span_h, rad ]
                    cv.move_to[ ox + sh.space.apply_x[ from_at.x,
                        from_at.y ] * zoom, oy + sh.space.apply_y[
                        from_at.x, from_at.y ] * zoom ]
                    t : f32 [ a + step ]
                    while [ t < b + step ]
                        q : vec2f rr_at[ min[ t, b ], x0, y0, span_w,
                                         span_h, rad ]
                        cv.line_to[ ox + sh.space.apply_x[ q.x, q.y ]
                            * zoom, oy + sh.space.apply_y[ q.x, q.y ]
                            * zoom ]
                        t += step
                    cv.paint[]
                d += (pass == 0) ? total : 2.0 * dash
        cv.restore[]

    # the point at length s round a rounded rect (top left corner
    # x0, y0; straight spans w, h; corner radius r), clockwise
    # from the top edge's start
    func rr_at [ s: f32, x0: f32, y0: f32, w: f32, h: f32,
                 r: f32 ] -> vec2f
        arc : f32 [ 1.5707963 * r ]
        left : f32 [ s ]
        # the four sides, each a straight span then its corner
        spans : vec f32 [] [ w, h, w, h ]
        for [ side: i32 0, side < 4, side += 1 ]
            run : f32 [ spans[ side ] ]
            if [ left <= run ]
                if [ side == 0 ] return vec2f [ x0 + r + left, y0 ]
                if [ side == 1 ]
                    return vec2f [ x0 + 2.0 * r + w, y0 + r + left ]
                if [ side == 2 ]
                    return vec2f [ x0 + r + w - left, y0 + 2.0 * r + h ]
                return vec2f [ x0, y0 + r + h - left ]
            left -= run
            if [ left <= arc || side == 3 ]
                ang : f32 [ (f32[ side ] - 1.0) * 1.5707963
                            + min[ left, arc ] / maxf[ r, 1e-9 ] ]
                cxs : vec f32 [] [ x0 + r + w, x0 + r + w, x0 + r,
                                   x0 + r ]
                cys : vec f32 [] [ y0 + r, y0 + r + h, y0 + r + h,
                                   y0 + r ]
                return vec2f [ cxs[ side ] + r * cos[ ang ],
                               cys[ side ] + r * sin[ ang ] ]
            left -= arc
        return vec2f [ x0 + r, y0 ]

    # typed letters go into the text being typed
    public func char_event [ ev: Event ]
        if [ !doc || typing < 0 || typing >= doc.count[] ] return
        if [ !ev.key.text || ev.key.text.count == 0 ] return
        nd : doc.model.shapes[ typing ].node
        was : string (placeholder || !nd.text) ? '' : '{nd.text}'
        placeholder = false
        set_words[ '{was}{ev.key.text}' ]

    # backspace: the last letter (a whole utf-8 code point)
    func erase_letter []
        if [ typing < 0 || typing >= doc.count[] ] return
        nd : doc.model.shapes[ typing ].node
        if [ placeholder || !nd.text || nd.text.count == 0 ]
            placeholder = false
            set_words[ '' ]
            return
        n : i64 [ nd.text.count - 1 ]
        while [ n > 0 && (u8[ nd.text.chars[ n ] ] & 192) == 128 ]
            n -= 1
        set_words[ nd.text.mid[ 0, n ] ]

    func set_words [ words: string ]
        svg_set[ doc.model.shapes[ typing ], 'text', words ]
        doc.mark[ typing ]
        doc.changed = true

    func op_words [] -> string
        if [ texting ] return 'text: click where it goes'
        if [ typing >= 0 ] return 'text: type it; enter or escape ends'
        if [ pen ]
            np : i32 [ pen_nodes.count / 6 ]
            return 'draw  {np} nodes: click, drag a curve, enter'
        if [ offsetting ]
            r : offset_goal[]
            rt : num_text[ r, false ]
            words : 'offset {rt}'
            if [ typing_text.count > 0 ]
                words = '{words}  {typing_text}_'
            return words
        if [ !moving ] return ''
        out : string [ (sizing) ? 'size'
                       : ((turning) ? 'turn' : 'move') ]
        names : vec string [] [ 'x', 'y' ]
        for [ a: i32 0, a < 2, a += 1 ]
            if [ typed_on[ a ] != 0 ]
                out = '{out}  {names[ a ]} {typed_v[ a ]}'
        axes : ''
        for [ a: i32 0, a < 2, a += 1 ]
            if [ (typing_mask & (1 << a)) != 0 ]
                axes = '{axes}{names[ a ]}'
        if [ axes.count > 0 || typing_text.count > 0 ]
            out = '{out}  {axes} {typing_text}_'
        return out

    func place_moved []
        g : shown_g
        fx : f32 [ (sizing) ? max[ g.x, 0.01 ] : 1.0 ]
        fy : f32 [ (sizing) ? max[ g.y, 0.01 ] : 1.0 ]
        mx : f32 [ (sizing || turning) ? 0.0 : g.x ]
        my : f32 [ (sizing || turning) ? 0.0 : g.y ]
        # a turn: by g.x degrees about the pivot
        rc : f32 [ 1.0 ]
        rs : f32 [ 0.0 ]
        if [ turning ]
            rc = cos[ g.x * 3.14159265 / 180.0 ]
            rs = sin[ g.x * 3.14159265 / 180.0 ]
        # whole shapes: the move or size on the page put into each
        # one's transform, from its start (no drift)
        if [ multi_text && whole_ids ]
            # the page op: about the pivot, then the move
            la : f32 [ fx * rc ]
            lb : f32 [ 0.0 - fy * rs ]
            lc : f32 [ fx * rs ]
            ld : f32 [ fy * rc ]
            op : affine [ ma: la, mb: lb, mc: lc, md: ld,
                tx: pivot_x - la * pivot_x - lb * pivot_y + mx,
                ty: pivot_y - lc * pivot_x - ld * pivot_y + my ]
            for [ k: i32 0, k < whole_ids.count, k += 1 ]
                t0 : six_of[ whole_t0, k ]
                par : six_of[ whole_par, k ]
                tn : affine_inverse[ par ].multiply[ op ].multiply[
                    par ].multiply[ t0 ]
                ws : doc.model.shapes[ whole_ids[ k ] ]
                svg_set[ ws, 'transform',
                         svg_parts_text[ svg_parts_m[ tn ] ] ]
                doc.follow[ whole_ids[ k ], 0 ]
            return
        for [ k: i32 0, k < moved.count, k += 1 ]
            ux0 : f32 [ (from[ k * 2 ] - pivot_x) * fx ]
            uy0 : f32 [ (from[ k * 2 + 1 ] - pivot_y) * fy ]
            px : f32 [ pivot_x + ux0 * rc - uy0 * rs ]
            py : f32 [ pivot_y + ux0 * rs + uy0 * rc ]
            doc.set_point[ moved_of[ k ], moved[ k ], px + mx,
                           py + my ]
        # whole shapes moved: their linked offsets follow
        if [ multi_text ]
            for [ i: i32 ] in doc.selected[]
                doc.follow[ i, 0 ]
            return
        # a moved handle's node type holds (its partner follows,
        # unless it moves too)
        for [ q: SvgPoint ] in moved
            if [ q.slot == 0 ] continue
            mate : doc.partner[ doc.chosen, q ]
            if [ mate && moved_has[ mate ] ] continue
            doc.hold_node[ doc.chosen, q ]
        # its linked offsets follow as it goes
        doc.follow[ doc.chosen, 0 ]

    # an affine's six numbers onto v
    func push_six [ v: vec f32, m: affine ]
        v.push[ m.ma ]
        v.push[ m.mb ]
        v.push[ m.mc ]
        v.push[ m.md ]
        v.push[ m.tx ]
        v.push[ m.ty ]

    # the k-th six numbers as an affine
    func six_of [ v: vec f32, k: i32 ] -> affine
        return affine [ ma: v[ k * 6 ], mb: v[ k * 6 + 1 ],
                        mc: v[ k * 6 + 2 ], md: v[ k * 6 + 3 ],
                        tx: v[ k * 6 + 4 ], ty: v[ k * 6 + 5 ] ]

    func end_move []
        commit_typing[]
        # kept: the exact value, not the eased one
        shown_g = goal[]
        place_moved[]
        moving = false
        if [ multi_text ]
            doc.undo.push[ SvgUndo [ shape: -1, text: multi_text ] ]
            for [ i: i32 ] in doc.selected[]
                doc.mark[ i ]
            return
        doc.undo.push[ SvgUndo [ shape: doc.chosen, cmds: before ] ]
        doc.mark[ doc.chosen ]

    func cancel_move []
        moving = false
        shift_x = 0.0
        shift_y = 0.0
        grow = 0.0
        typing_text = ''
        typed_on = vec i32 [ 2 ]
        lock = 0
        # no change at all: a turn's goal reads the pointer, so
        # the rest value is set, not asked for
        rest : f32 [ (sizing) ? 1.0 : 0.0 ]
        shown_g = vec2f [ rest, rest ]
        place_moved[]
        turning = false
        along = false

    # keys, as the app hands them on
    public func key_event [ ev: Event ]
        if [ !doc ] return
        k : i32 [ ev.key.unicode ]
        down : bool [ ev.key.state != 0 ]
        if [ !down ] return
        ctrl : bool [ ev.key.ctrl || ev.key.meta ]
        if [ pen ]
            pen_key[ k ]
            return
        if [ texting ]
            if [ k == 256 ] texting = false
            return
        # typing a text: letters come as characters (char_event)
        if [ typing >= 0 && !ctrl ]
            if [ k == 257 || k == 335 || k == 256 ] typing = -1
            if [ k == 259 ] erase_letter[]
            return
        # a box or circle drawn: enter picks, escape drops it
        if [ region != 0 ]
            if [ k == 257 || k == 335 ]
                end_region[ ev.key.shift || ctrl ]
            if [ k == 256 ] region = 0
            return
        if [ offsetting ]
            if [ k == 257 || k == 335 ]
                end_offset[]
                return
            if [ k == 256 ]
                cancel_offset[]
                return
            if [ k == 259 && typing_text.count > 0 ]
                n : i32 [ typing_text.count - 1 ]
                typing_text = typing_text.mid[ 0, n ]
            ch : ''
            if [ k >= 48 && k <= 57 ] ch = '{k - 48}'
            if [ k >= 320 && k <= 329 ] ch = '{k - 320}'
            if [ k == 46 || k == 330 ] ch = '.'
            if [ (k == 45 || k == 333) && typing_text.count == 0 ]
                ch = '-'
            if [ ch.count > 0 ] typing_text = '{typing_text}{ch}'
            return
        if [ moving ]
            if [ k == 257 || k == 335 ] end_move[]
            if [ k == 256 ] cancel_move[]
            # x or y: a number's axes; after one, a new group
            if [ k == 88 || k == 89 ]
                if [ typing_text.count > 0 ] commit_typing[]
                typing_mask = typing_mask | (1 << (k - 88))
                lock = (typing_mask == 3) ? 0 : typing_mask
            if [ k == 259 && typing_text.count > 0 ]
                n : i32 [ typing_text.count - 1 ]
                typing_text = typing_text.mid[ 0, n ]
            ch : ''
            if [ k >= 48 && k <= 57 ] ch = '{k - 48}'
            if [ k >= 320 && k <= 329 ] ch = '{k - 320}'
            if [ k == 46 || k == 330 ] ch = '.'
            if [ (k == 45 || k == 333) && typing_text.count == 0 ]
                ch = '-'
            if [ ch.count > 0 ] typing_text = '{typing_text}{ch}'
            return
        # ctrl + shift + s: save as (the dialog asks where)
        if [ k == 83 && ctrl && ev.key.shift ]
            nm : string doc.file.filename[]
            if [ ux ] ux.nav_save_as[ nm ]
            return
        # a drawing never saved: the dialog asks where
        if [ k == 83 && ctrl && !ev.key.shift && doc.untitled ]
            if [ ux ] ux.nav_save_as[ 'untitled.svg' ]
            return
        if [ k == 83 && ctrl && !ev.key.shift ]
            if [ doc.save[] ]
                log 'aeon: saved {doc.file}'
                picked = vec SvgPoint []
            return
        if [ k == 90 && ctrl ]
            if [ doc.undo.count == 0 ] return
            back : doc.undo[ doc.undo.count - 1 ]
            doc.undo.pop[]
            if [ back.row ]
                doc.undo_row = back.row
                doc.undo_was = back.was
                return
            if [ back.text ]
                doc.restore[ back.text ]
                picked = vec SvgPoint []
                return
            doc.model.shapes[ back.shape ].cmds = back.cmds
            doc.mark[ back.shape ]
            return
        # delete or backspace with no node picked: the chosen
        # shapes go
        if [ (k == 261 || k == 259) && (!picked || picked.count == 0) ]
            if [ doc.delete_chosen[] ] picked = vec SvgPoint []
            return
        # delete or backspace: the picked nodes taken out
        if [ (k == 261 || k == 259) && picked && picked.count > 0
             && doc.chosen >= 0 ]
            sh : doc.model.shapes[ doc.chosen ]
            was : vec SVGCmd [ sh.cmds ]
            if [ doc.drop_nodes[ doc.chosen, picked ] ]
                doc.undo.push[ SvgUndo [ shape: doc.chosen,
                                         cmds: was ] ]
                doc.mark[ doc.chosen ]
            picked = vec SvgPoint []
            return
        # ctrl + g: the chosen shapes grouped; with shift, the
        # chosen shape's group taken apart
        if [ ctrl && k == 71 ]
            done : bool [ (ev.key.shift) ? doc.ungroup_chosen[]
                                         : doc.group_chosen[] ]
            if [ done ] picked = vec SvgPoint []
            return
        # ctrl + or -: the chosen shapes' union, or the bottom
        # one less the rest
        if [ ctrl && (k == 61 || k == 334 || k == 45 || k == 333) ]
            if [ doc.combine[ (k == 61 || k == 334) ? 0 : 1 ] ]
                picked = vec SvgPoint []
            return
        # page up / down: the chosen shape one step up or down;
        # with ctrl, to the top or bottom (one undo)
        if [ (k == 266 || k == 267) && doc.chosen >= 0 ]
            marks : i32 [ doc.undo.count ]
            while [ doc.restack[ doc.chosen, k == 266 ] ]
                picked = vec SvgPoint []
                if [ !ctrl ] break
            while [ doc.undo.count > marks + 1 ]
                doc.undo.pop[]
            return
        # g moves, s sizes (x or y after: that axis alone)
        if [ k == 71 && !ctrl ] start_move[ false ]
        if [ k == 83 && !ctrl ] start_move[ true ]
        if [ k == 82 && !ctrl ] start_op[ false, true ]
        # b, c: a box or circle select, from the pointer here
        if [ (k == 66 || k == 67) && !ctrl && !moving && !offsetting ]
            region = (k == 66) ? 1 : 2
            region_x = pointer_x
            region_y = pointer_y
            return
        # t: a text, placed by the next click
        if [ k == 84 && !ctrl && !moving && !offsetting ]
            texting = true
            return
        # p: draw a new path
        if [ k == 80 && !ctrl && !moving && !offsetting ]
            pen = true
            pen_nodes = vec f32 []
            pen_drag = false
            return
        # o: a linked offset (on an offset: its distance)
        if [ k == 79 && !ctrl ] start_offset[]
        # home: the page fitted again
        if [ k == 268 ] fit[]
        if [ k == 256 && picked ] picked.clear[]

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !doc ] return
        # ctrl + and - are the booleans here, not the font's size;
        # ctrl + shift + s is save as, not the capture
        w.font_keys = false
        w.capture_keys = false
        cv : Canvas [ w.screen ]
        if [ !fitted && bounds.w > 0.0 ] fit[]
        ease_frame[]
        # nothing past the view's own bounds
        cv.save[]
        cv.clip_rounded_rect[ 0.0, 0.0, bounds.w, bounds.h, 0.0, 0.0,
                              0.0, 0.0 ]
        cv.save[]
        cv.stroke_width[ 0.0 ]
        cv.fill_color[ '#14141a' ]
        cv.rect_to[ 0.0, 0.0, bounds.w, bounds.h ]
        cv.paint[]
        pw : f32 [ doc.model.w * zoom ]
        ph : f32 [ doc.model.h * zoom ]
        draw_grid[ cv ]
        cv.restore[]
        doc.model.render[ cv, ox, oy, pw, ph ]
        cv.save[]
        cv.fill_color[ '#0000' ]
        cv.stroke_color[ '#ffffff40' ]
        cv.stroke_width[ 1.0 ]
        cv.rect_to[ ox, oy, pw, ph ]
        cv.paint[]
        has : bool [ doc.chosen >= 0 && doc.chosen < doc.count[] ]
        if [ has || pen ]
            ln : lines_begin[ cv ]
            if [ has ]
                draw_chosen[ ln, ln ]
                draw_grad[ ln, ln, false ]
                draw_grad[ ln, ln, true ]
            if [ pen ] pen_handles[ ln ]
            lines_end[ cv ]
        if [ has && doc.is_text[ doc.chosen ] ] draw_text_box[ cv ]
        if [ has ]
            # picked points over it, solid
            solid = true
            if [ doc.offset_src[ doc.chosen ] < 0 ] draw_nodes[ cv ]
            draw_grad[ cv, cv, true ]
            solid = false
            draw_pivot[ cv ]
        # the other chosen shapes: their outlines
        for [ i: i32 ] in doc.also
            if [ i >= 0 && i < doc.count[] ]
                outline_shape[ cv, i ]
        if [ pen ] draw_pen[ cv ]
        draw_region[ cv ]
        # an offset being made: its outline
        if [ preview ]
            cv.fill_color[ '#0000' ]
            cv.stroke_color[ '#ffcf4a' ]
            cv.stroke_width[ 1.5 ]
            for [ c: SVGCmd ] in preview
                if [ c.op == SVGOp.move ]
                    cv.move_to[ sx[ c.x ], sy[ c.y ] ]
                el [ c.op == SVGOp.cubic ]
                    cv.cubic_to[ sx[ c.x1 ], sy[ c.y1 ], sx[ c.x2 ],
                                 sy[ c.y2 ], sx[ c.x ], sy[ c.y ] ]
                el [ c.op == SVGOp.close ]
                    cv.close_path[]
            cv.paint[]
        # g or s running: what it does and what is typed
        words : op_words[]
        if [ words.count > 0 ]
            cv.fill_color[ '#ffcf4a' ]
            cv.draw_text[ words,
                rect [ x: 16.0, y: bounds.h - 40.0,
                       w: bounds.w - 32.0, h: 28.0 ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                Overflow.visible, null ]
            cv.paint[]
        cv.restore[]
        cv.restore[]

    # a line a power of ten of units, 8 px or more; major x10
    func draw_grid [ cv: Canvas ]
        step : f32 [ pow[ 10.0,
                         ceil[ log[ 8.0 / zoom ] / log[ 10.0 ] ] ] ]
        px : f32 [ step * zoom ]
        fade : f32 [ clamp[ (px - 8.0) / 24.0, 0.0, 1.0 ] ]
        cv.fill_color[ '#0000' ]
        cv.stroke_width[ 1.0 ]
        for [ major: i32 0, major < 2, major += 1 ]
            a : f32 [ (major == 1) ? 0.14 : 0.06 * fade ]
            cv.stroke_color[ rgba [ r: 1.0, g: 1.0, b: 1.0, a: a ] ]
            lo : i64 [ floor[ (0.0 - ox) / px ] ]
            hi : i64 [ ceil[ (bounds.w - ox) / px ] ]
            for [ i: i64 lo, i <= hi, i += 1 ]
                if [ (i % 10 == 0) != (major == 1) ] continue
                x : f32 [ round[ ox + f32[ i ] * px ] + 0.5 ]
                if [ x < 0.0 || x > bounds.w ] continue
                cv.move_to[ x, 0.0 ]
                cv.line_to[ x, bounds.h ]
            lo = i64[ floor[ (0.0 - oy) / px ] ]
            hi = i64[ ceil[ (bounds.h - oy) / px ] ]
            for [ i: i64 lo, i <= hi, i += 1 ]
                if [ (i % 10 == 0) != (major == 1) ] continue
                y : f32 [ round[ oy + f32[ i ] * px ] + 0.5 ]
                if [ y < 0.0 || y > bounds.h ] continue
                cv.move_to[ 0.0, y ]
                cv.line_to[ bounds.w, y ]
            cv.paint[]

    # a shape's outline, as a chosen one's
    func outline_shape [ cv: Canvas, i: i32 ]
        cv.fill_color[ '#0000' ]
        cv.stroke_color[ '#7fd4ff' ]
        cv.stroke_width[ 1.5 ]
        for [ c: SVGCmd ] in doc.model.shapes[ i ].cmds
            if [ c.op == SVGOp.move ]
                cv.move_to[ sx[ c.x ], sy[ c.y ] ]
            el [ c.op == SVGOp.line ]
                cv.line_to[ sx[ c.x ], sy[ c.y ] ]
            el [ c.op == SVGOp.cubic ]
                cv.cubic_to[ sx[ c.x1 ], sy[ c.y1 ], sx[ c.x2 ],
                             sy[ c.y2 ], sx[ c.x ], sy[ c.y ] ]
            el [ c.op == SVGOp.quad ]
                cv.quad_to[ sx[ c.x1 ], sy[ c.y1 ], sx[ c.x ],
                            sy[ c.y ] ]
            el [ c.op == SVGOp.close ]
                cv.close_path[]
        cv.paint[]

    # the chosen shape: its outline, handles and anchors
    # the offset's knob: x, y the source's point it is measured
    # from, z, w the knob on the offset's outline
    func knob_at [] -> vec4f
        src : doc.offset_src[ doc.chosen ]
        if [ src < 0 ] return vec4f [ 0.0, 0.0, 0.0, 0.0 ]
        # dragged: the way it went, at the distance now
        if [ knob_of == doc.chosen ]
            far : f32 [ abs[ doc.radius_of[ doc.chosen ] ] ]
            return vec4f [ knob_q.x, knob_q.y,
                           knob_q.x + knob_d.x * far,
                           knob_q.y + knob_d.y * far ]
        c : doc.model.shapes[ src ].cmds[ 0 ]
        k : nearest_on[ doc.model.shapes[ doc.chosen ].cmds, c.x, c.y,
                        0.25 / zoom ]
        return vec4f [ c.x, c.y, k.x, k.y ]

    # a linked offset chosen: its outline and its one knob (its
    # points are its source's business)
    func draw_offset [ cv: Canvas ]
        outline_shape[ cv, doc.chosen ]
        kb : knob_at[]
        cv.stroke_color[ '#ffcf4a99' ]
        cv.stroke_width[ 1.0 ]
        cv.move_to[ sx[ kb.x ], sy[ kb.y ] ]
        cv.line_to[ sx[ kb.z ], sy[ kb.w ] ]
        cv.paint[]
        cv.stroke_width[ 0.0 ]
        cv.fill_color[ '#ffcf4a' ]
        # a diamond
        kx : f32 [ sx[ kb.z ] ]
        ky : f32 [ sy[ kb.w ] ]
        cv.move_to[ kx, ky - 6.0 ]
        cv.line_to[ kx + 6.0, ky ]
        cv.line_to[ kx, ky + 6.0 ]
        cv.line_to[ kx - 6.0, ky ]
        cv.close_path[]
        cv.paint[]

    # its lines into ln, its nodes on cv (the view passes the
    # line layer for both)
    func draw_chosen [ cv: Canvas, ln: Canvas ]
        if [ doc.offset_src[ doc.chosen ] >= 0 ]
            draw_offset[ cv ]
            return
        # a text: its box instead (draw_text_box, solid)
        if [ doc.is_text[ doc.chosen ] ] return
        sh : doc.model.shapes[ doc.chosen ]
        ln.fill_color[ '#0000' ]
        ln.stroke_width[ 1.5 ]
        # each segment alone, lit by the pointer's nearness
        px : f32 [ 0.0 ]
        py : f32 [ 0.0 ]
        mx : f32 [ 0.0 ]
        my : f32 [ 0.0 ]
        for [ c: SVGCmd ] in sh.cmds
            if [ c.op == SVGOp.move ]
                mx = c.x
                my = c.y
                px = c.x
                py = c.y
                continue
            ex : f32 [ (c.op == SVGOp.close) ? mx : c.x ]
            ey : f32 [ (c.op == SVGOp.close) ? my : c.y ]
            ln.stroke_color[ '#7fd4ff' ]
            ln.move_to[ sx[ px ], sy[ py ] ]
            if [ c.op == SVGOp.cubic ]
                ln.cubic_to[ sx[ c.x1 ], sy[ c.y1 ], sx[ c.x2 ],
                             sy[ c.y2 ], sx[ ex ], sy[ ey ] ]
            el [ c.op == SVGOp.quad ]
                ln.quad_to[ sx[ c.x1 ], sy[ c.y1 ], sx[ ex ], sy[ ey ] ]
            el
                ln.line_to[ sx[ ex ], sy[ ey ] ]
            ln.paint[]
            px = ex
            py = ey
        # each handle's line to its anchor
        ln.stroke_width[ 1.0 ]
        px = 0.0
        py = 0.0
        for [ c: SVGCmd ] in sh.cmds
            if [ c.op == SVGOp.cubic || c.op == SVGOp.quad ]
                handle_line[ ln, px, py, c.x1, c.y1 ]
            if [ c.op == SVGOp.cubic ]
                handle_line[ ln, c.x, c.y, c.x2, c.y2 ]
            if [ c.op != SVGOp.close ]
                px = c.x
                py = c.y
        cv.stroke_width[ 0.0 ]
        draw_nodes[ cv ]

    # its nodes: the unpicked into the layer, the picked solid
    # (solid set) over it
    func draw_nodes [ cv: Canvas ]
        # the one a press would take: brighter
        hot : nearest[ pointer_x, pointer_y ]
        for [ p: SvgPoint ] in doc.points_of[ doc.chosen ]
            at : doc.point[ doc.chosen, p ]
            on : bool [ is_picked[ p ] || (region != 0
                        && in_region[ sx[ at.x ], sy[ at.y ] ]) ]
            if [ on != solid ] continue
            hx : f32 [ sx[ at.x ] ]
            hy : f32 [ sy[ at.y ] ]
            # half size far off, its own size at the pointer; a
            # picked one its own size always
            z : f32 [ (solid) ? 1.0 : 0.5 + 0.5 * near_w[ hx, hy ] ]
            col : string [ (on) ? '#ffcf4a' : '#7fd4ff' ]
            if [ hot && hot.cmd == p.cmd && hot.slot == p.slot ]
                cv.fill_color[ brighter[ col ] ]
            el
                cv.fill_color[ col ]
            # a node: cusp a square, smooth a circle, symmetric a
            # circle with a dot
            kind : i32 [ (p.slot == 0)
                         ? doc.type_at[ doc.chosen, p.cmd ] : -1 ]
            if [ kind == 0 ]
                cv.rect_to[ hx - 3.5 * z, hy - 3.5 * z, 7.0 * z,
                            7.0 * z ]
            el [ kind > 0 ]
                cv.arc[ hx, hy, 4.5 * z, 0.0, 6.2832 ]
            el
                cv.arc[ hx, hy, 3.0 * z, 0.0, 6.2832 ]
            cv.paint[]
            if [ kind == 2 ]
                cv.fill_color[ '#14141a' ]
                cv.arc[ hx, hy, 1.6 * z, 0.0, 6.2832 ]
                cv.paint[]

    # the pointer's nearness to a screen point, 0..1 (trinity's
    # near light: (1 - d / 160)^2)
    func near_w [ x: f32, y: f32 ] -> f32
        dx : f32 [ pointer_x - x ]
        dy : f32 [ pointer_y - y ]
        w : f32 [ clamp[ 1.0 - sqrt[ dx * dx + dy * dy ] / 160.0,
                         0.0, 1.0 ] ]
        return w * w

    # a colour most of the way to white
    func brighter [ hex: string ] -> rgba
        c : rgba [ hex ]
        c.r = c.r + (1.0 - c.r) * 0.6
        c.g = c.g + (1.0 - c.g) * 0.6
        c.b = c.b + (1.0 - c.b) * 0.6
        return c

    # a handle's line (page points), lit by its nearness
    func handle_line [ cv: Canvas, ax: f32, ay: f32, bx: f32,
                       by: f32 ]
        cv.stroke_color[ '#7fd4ff' ]
        cv.move_to[ sx[ ax ], sy[ ay ] ]
        cv.line_to[ sx[ bx ], sy[ by ] ]
        cv.paint[]

# a gradient as the picker's text: 'linear | 0: r, g, b, a | ...'
# (its stops' colours made linear)
func svg_paint_text [ pt: SVGPaint ] -> string
    out : string [ (pt.kind == 2) ? 'radial' : 'linear' ]
    for [ k: i32 0, k < pt.offs.count, k += 1 ]
        r : num_text[ pow[ pt.cols[ k * 4 ], 2.2 ], false ]
        g : num_text[ pow[ pt.cols[ k * 4 + 1 ], 2.2 ], false ]
        b : num_text[ pow[ pt.cols[ k * 4 + 2 ], 2.2 ], false ]
        al : num_text[ pt.cols[ k * 4 + 3 ], false ]
        ot : num_text[ pt.offs[ k ], false ]
        out = '{out} | {ot}: {r}, {g}, {b}, {al}'
    return out

# a transform's parts: move x y, rotate, scale x y, skew (both
# in degrees), as translate . rotate . skewX . scale
func svg_parts [ t: string ] -> vec f32
    m : affine.identity[]
    if [ t && t.count > 0 ] m = svg_parse_transform[ t ]
    return svg_parts_m[ m ]

# the same parts of a matrix
func svg_parts_m [ m: affine ] -> vec f32
    sx : f32 [ sqrt[ m.ma * m.ma + m.mc * m.mc ] ]
    if [ sx < 1e-9 ]
        return vec f32 [] [ m.tx, m.ty, 0.0, 0.0, 0.0, 0.0 ]
    rot : f32 [ atan2[ m.mc, m.ma ] ]
    sy : f32 [ (m.ma * m.md - m.mb * m.mc) / sx ]
    sk : f32 [ 0.0 ]
    if [ abs[ sy ] > 1e-9 ]
        sk = atan[ (m.ma * m.mb + m.mc * m.md) / (sx * sy) ]
    deg : f32 [ 180.0 / 3.14159265 ]
    return vec f32 [] [ m.tx, m.ty, rot * deg, sx, sy, sk * deg ]

# the parts written back, each left out at its identity
func svg_parts_text [ p: vec f32 ] -> string
    out : ''
    if [ abs[ p[ 0 ] ] > 1e-6 || abs[ p[ 1 ] ] > 1e-6 ]
        out = 'translate({num_text[ p[ 0 ], false ]},'
        out = '{out}{num_text[ p[ 1 ], false ]})'
    if [ abs[ p[ 2 ] ] > 1e-6 ]
        rt : num_text[ p[ 2 ], false ]
        out = (out.count > 0) ? '{out} rotate({rt})' : 'rotate({rt})'
    if [ abs[ p[ 5 ] ] > 1e-6 ]
        kt : num_text[ p[ 5 ], false ]
        out = (out.count > 0) ? '{out} skewX({kt})' : 'skewX({kt})'
    if [ abs[ p[ 3 ] - 1.0 ] > 1e-6 || abs[ p[ 4 ] - 1.0 ] > 1e-6 ]
        st : 'scale({num_text[ p[ 3 ], false ]},'
        st = '{st}{num_text[ p[ 4 ], false ]})'
        out = (out.count > 0) ? '{out} {st}' : st
    return out
