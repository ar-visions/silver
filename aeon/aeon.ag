# aeon: the 3D design app. a project is a folder (a module
# folder): <name>.agi holds the design, nodes wired by name
export 0.1.0

import vec
import img
import gltf
import trinity
import properties
import design

# blender 4.5.14: its python 3.11 (with numpy) runs blend.py
import https://download.blender.org/release/Blender4.5/blender-4.5.14-linux-x64.tar.xz
    > mkdir -p {install}/blender
    > test -x {install}/blender/blender || tar -xJf {import_file} --strip-components 1 -C {install}/blender
    > ln -sf ../blender/4.5/python/bin/python3.11 {install}/bin/blender-python

# bpy 4.5.14: the same blender as a python module; blend.py
# imports it, so no blender program is started
import https://files.pythonhosted.org/packages/5e/e2/89cf67b8dcb0644e3bc97f46981d4e095d808179c4f93a348b57ac00af37/bpy-4.5.14-cp311-cp311-manylinux_2_28_x86_64.whl
    > test -d {install}/pylib-blender/bpy || {install}/bin/blender-python -m zipfile -e {import_file} {install}/pylib-blender

import <stdio.h>
import <stdlib.h>
import <string.h>
import <math.h>

import Panels
import Outline
import Grid
import Offset
import Bool
import Svg
import Graph

# the cell a point falls in, moved by o, as a hash key
func cell_key [ x: f32, y: f32, z: f32, cell: f32, ox: i32,
                oy: i32, oz: i32 ] -> i64
    ix : i64 [ i64[ floor[ x / cell ] ] + ox ]
    iy : i64 [ i64[ floor[ y / cell ] ] + oy ]
    iz : i64 [ i64[ floor[ z / cell ] ] + oz ]
    return (ix * 73856093) ^ (iy * 19349663) ^ (iz * 83492791)

# the gap from each point of a to the nearest of b, at most
func nearest_gap [ a: vec f32, b: vec f32, cell: f32 ] -> f32
    nb : i32 [ b.count / 3 ]
    size : i64 [ 16 ]
    while [ size < i64[ nb ] * 2 ] size = size * 2
    mask : i64 [ size - 1 ]
    heads : vec i32 [ size ]
    next : vec i32 [ nb ]
    for [ i: i32 0, i < nb, i += 1 ]
        h : i64 [ cell_key[ b[ i * 3 ], b[ i * 3 + 1 ], b[ i * 3 + 2 ],
                            cell, 0, 0, 0 ] & mask ]
        next[ i ] = heads[ h ]
        heads[ h ] = i + 1
    worst : f32 [ 0.0 ]
    na : i32 [ a.count / 3 ]
    for [ i: i32 0, i < na, i += 1 ]
        x : f32 [ a[ i * 3 ] ]
        y : f32 [ a[ i * 3 + 1 ] ]
        z : f32 [ a[ i * 3 + 2 ] ]
        best : f32 [ cell * cell ]
        for [ k: i32 0, k < 27, k += 1 ]
            h : i64 [ cell_key[ x, y, z, cell, k % 3 - 1,
                                (k / 3) % 3 - 1, k / 9 - 1 ] & mask ]
            j : i32 [ heads[ h ] ]
            while [ j > 0 ]
                dx : f32 [ b[ (j - 1) * 3 ] - x ]
                dy : f32 [ b[ (j - 1) * 3 + 1 ] - y ]
                dz : f32 [ b[ (j - 1) * 3 + 2 ] - z ]
                d : f32 [ dx * dx + dy * dy + dz * dz ]
                if [ d < best ] best = d
                j = next[ j - 1 ]
        if [ best > worst ] worst = best
    return sqrt[ worst ]

# blender's own result for an object: counts, then points
func read_ref [ p: path, counts: vec i32 ] -> vec f32
    f : handle [ fopen[ p, "rb" ] ]
    if [ !f ] return null
    head : local u32 [ 2 ]
    fread[ head, 4, 2, f ]
    counts.push[ i32[ head[ 0 ] ] ]
    counts.push[ i32[ head[ 1 ] ] ]
    v : vec f32 [ i32[ head[ 0 ] ] * 3 ]
    fread[ @v[ 0 ], 4, head[ 0 ] * 3, f ]
    fclose[ f ]
    return v

# a design's every object against what blender makes of it
func matches_blender [ dir: path, refs: path, objects: i32 ] -> bool
    d : Design [ dir: dir ]
    if [ d.objects.count != objects ]
        log 'aeon: {d.objects.count} objects, not {objects}'
        return false
    good : bool [ true ]
    for [ o: Object ] in d.objects
        m : o.evaluate[ d.base[] ]
        counts : vec i32 []
        rp : path '{refs}/{o.name}.ref'
        made : read_ref[ rp, counts ]
        if [ !m || !made ]
            log 'aeon: {o.name}: nothing to compare'
            good = false
            continue
        gap : f32 [ 0.0 ]
        back : f32 [ 0.0 ]
        if [ m.verts[] == counts[ 0 ] ]
            gap = nearest_gap[ m.pos, made, 0.01 ]
            back = nearest_gap[ made, m.pos, 0.01 ]
        nv : i32 [ m.verts[] ]
        nf : i32 [ m.faces[] ]
        log 'aeon: {o.name}: {nv} of {counts[ 0 ]} points, {nf} of {counts[ 1 ]} faces, gap {gap} back {back}'
        if [ nv != counts[ 0 ] || nf != counts[ 1 ] ] good = false
        # opensubdiv's limit patches differ by up to 0.00033
        if [ gap > 0.0005 || back > 0.0005 ] good = false
    return good

expect func t_flower_matches_blender [] -> bool
    root : path.path_startup[]
    # its own copy: aeon/flower888 is the one edited in aeon
    dir : path '{root}/aeon/tests/flower888'
    refs : path '{root}/aeon/tests/flower888'
    return matches_blender[ dir, refs, 5 ]

# each object's step tables run on its cage give its points, as
# the CPU steps do (what the compute passes will run)
expect func t_stencils_match [] -> bool
    root : path.path_startup[]
    dir : path '{root}/aeon/tests/flower888'
    d : Design [ dir: dir ]
    good : bool [ d.objects.count > 0 ]
    for [ o: Object ] in d.objects
        m : o.evaluate[ d.base[] ]
        c : o.cage[]
        if [ !m || !c ]
            good = false
            continue
        p : c.make[ null, d.base[] ].pos
        tables : o.stencils[ d.base[] ]
        for [ st: Stencil ] in tables
            p = apply_stencil[ st, p ]
        worst : f32 [ 0.0 ]
        if [ p.count != m.pos.count ]
            worst = 1.0
        el
            for [ i: i32 0, i < p.count, i += 1 ]
                gap : f32 [ abs[ p[ i ] - m.pos[ i ] ] ]
                if [ gap > worst ] worst = gap
        log 'stencils: {o.name}: {tables.count} steps, {p.count / 3} of {m.verts[]} points, worst {worst}'
        if [ worst > 0.00001 ] good = false
    return good

# the same tables run on the GPU give the same points
expect func t_gpu_stencils [ vk: vk_context ] -> bool
    w : Display [ vk: vk, format: Pixel.rgba8, backbuffer: true,
                  width: 64, height: 64 ]
    root : path.path_startup[]
    dir : path '{root}/aeon/tests/flower888'
    d : Design [ dir: dir ]
    good : bool [ d.objects.count > 0 ]
    for [ o: Object ] in d.objects
        m : o.evaluate[ d.base[] ]
        c : o.cage[]
        tables : o.stencils[ d.base[] ]
        if [ !m || !c || tables.count == 0 ] continue
        cp : c.make[ null, d.base[] ].pos
        cr : ChainRun [ vk: vk, w: w, tables: tables,
                        n_cage: cp.count / 3, probe: true ]
        cr.run[ cp ]
        # a second run: what a cage move costs
        t0 : i64 [ Au.epoch_micros[] ]
        cr.run[ cp ]
        us : i64 [ Au.epoch_micros[] - t0 ]
        q : cr.result[]
        worst : f32 [ 0.0 ]
        if [ q.count != m.pos.count ]
            worst = 1.0
        el
            for [ i: i32 0, i < q.count, i += 1 ]
                gap : f32 [ abs[ q[ i ] - m.pos[ i ] ] ]
                if [ gap > worst ] worst = gap
        log 'gpu stencils: {o.name}: {q.count / 3} points, worst {worst}, a run {us} us'
        if [ worst > 0.0001 ] good = false
        # the normals: each point's faces summed, as point_normals
        og : ObjectGpu [ vk: vk, w: w, tables: tables, shape: m,
                         n_cage: cp.count / 3, probe: true ]
        og.run[ cp, mat_identity[] ]
        gn : og.normals[]
        cn : point_normals[ m ]
        nw : f32 [ 0.0 ]
        for [ i: i32 0, i < cn.count, i += 1 ]
            gap : f32 [ abs[ gn[ i ] - cn[ i ] ] ]
            if [ gap > nw ] nw = gap
        log 'gpu normals: {o.name}: worst {nw}'
        if [ nw > 0.001 ] good = false
    return good

# a .blend made into a project folder beside it, by blend.py
# with the bpy this module imports; '' when it fails
func import_blend [ file: string ] -> string
    start : path.path_startup[]
    src : path [ file ]
    if [ !file.starts_with[ '/' ] ] src = path '{start}/{file}'
    if [ !src.exists[] ]
        log 'aeon: no file at {src}'
        return ''
    inst : path.path_install[]
    # blend.py sits in the module folder, beside aeon.ag
    listed : path '{inst}/build/silver-aeon.source'
    txt : string [ listed.load[ typeid[ string ], null ] ]
    lines : txt.split[ '\n' ]
    first : path [ lines[ 0 ] ]
    script : path '{first.parent_dir[]}/blend.py'
    # the name up to its first dot: flower888.16.32 -> flower888
    nm : string src.stem[]
    dot : i32 [ nm.index_of[ '.' ] ]
    if [ dot > 0 ] nm = nm.mid[ 0, dot ]
    out : path '{src.parent_dir[]}/{nm}'
    made : path '{out}/{nm}.agi'
    if [ made.exists[] && made.modified_time[] >= src.modified_time[] ]
        return '{out}'
    log 'aeon: importing {src} into {out}'
    # au runs it with install/bin first: our blender-python
    run : command { PYTHONPATH={inst}/pylib-blender blender-python
        {script.shell_escape[]} {src.shell_escape[]}
        {out.shell_escape[]} }
    said : string run.run[ false ]
    for [ ln: string ] in said.split[ '\n' ]
        if [ ln.starts_with[ 'aeon:' ] || ln.starts_with[ 'Error' ] ]
            log '{ln}'
    if [ !made.exists[] || made.modified_time[] < src.modified_time[] ]
        log 'aeon: blender did not write {made}'
        return ''
    return '{out}'

# a point's place on screen: x, y in pixels and its depth
class Spot
    public x : f32
    public y : f32
    public z : f32

# an edit to undo: an object's cage points before it
class CageEdit
    public name : string
    public pos  : vec f32
    # an object's place before it moved (pos then is null)
    public at   : vec f32
    public turn : vec f32
    public size : vec f32
    # a property's value before it changed (name is then '')
    public row  : PropRow
    public was  : string
    # a removed object, or a removed step of the object name, and
    # where it stood; the steps that took its input; its out
    public gone_obj  : Object
    public gone_node : MeshNode
    # an added step of the object name: undone, it goes
    public added     : MeshNode
    public gone_at   : i32
    public fixed     : vec string
    public was_out   : string

# the design's stage: drag a cage point to move it, elsewhere to
# turn the view; x, y or z held keeps a move on that axis
element DesignView
    style : CSS {
        area: l0 t0 r0 b0
    }
    public design  : Design
    # the chosen object: moved whole, or its cage edited (tab)
    public chosen  : string
    # what the panels and the view share as chosen
    public sel     : Selection
    # changes held in memory until ctrl/cmd + s
    public edits   : Edits
    # a node or pass changed in memory: the stages are made again
    public rebuild_due : bool
    # objects whose shape changed: only their models made again
    public remake_due  : vec string

    func remake [ name: string ]
        if [ !remake_due ] remake_due = vec string []
        if [ remake_due.index_of[ name ] < 0 ] remake_due.push[ name ]
    # tab: the chosen object's inner cage, not the object
    mutable inner  : bool
    # each frame's share of what is left: moves, pan and zoom,
    # and the orbit; lower carries more momentum
    public ease      : f32 [ 0.35 ]
    public turn_ease : f32 [ 0.14 ]
    public yaw     : f32 [ 0.6 ]
    public pitch   : f32 [ 0.35 ]
    public dist    : f32 [ 4.0 ]
    mutable stage  : Stage
    # the chosen object alone, over the others greyed (no choice:
    # unused); and whose focus the stages show now
    mutable focus    : Stage
    mutable focus_of : string
    # the floor's grid (the 3D view)
    mutable grid     : Grid
    # the project folder watched: an outside .agi edit redraws
    mutable watcher  : watch
    # and the model module it names
    mutable model_watch : watch
    mutable agi_seen : bool
    # each .agi's time as last read or written here
    mutable known_files : vec string
    mutable known_times : vec i64
    # the design file's text outside its render: block, as read
    mutable known_body  : string
    # where a drag has sent the view; it eases there each frame
    mutable yaw_goal   : f32
    mutable pitch_goal : f32
    mutable goal_set   : bool
    mutable dist_goal  : f32
    mutable center_goal : vec3f
    # g, r, s: 1 move, 2 turn, 3 size, 0 none
    mutable op          : i32
    # the selection as it was when the op began
    mutable from_at     : vec f32
    mutable from_turn   : vec f32
    mutable from_size   : vec f32
    mutable from_pos    : vec f32
    mutable pivot       : vec3f
    # axes named for the pointer, and for the number being typed
    mutable lock_mask   : i32
    mutable typing_mask : i32
    mutable typing_text : string
    # values set by typing, axis by axis
    mutable typed_v     : vec f32
    mutable typed_on    : vec i32
    # the pointer's value, its size step, and the eased one shown
    mutable grow        : f32
    mutable mouse_v     : vec3f
    mutable shown_v     : vec3f
    # the point the view turns around; ctrl/cmd + drag moves it
    mutable center : vec3f
    # the view's matrix (z up): picking and the cage use it
    mutable view_m : mat4f
    # 1 turning the view, 2 moving points, 3 the camera, 4 the
    # object
    mutable mode   : i32
    # g pressed: the selection follows the pointer, no button held
    mutable grabbing : bool
    mutable picked : vec i32
    # b or c: a box (1) or circle (2) select; 0 none
    mutable region : i32
    mutable region_x : f32
    mutable region_y : f32
    mutable pointer_x : f32
    mutable pointer_y : f32
    mutable undo   : vec CageEdit
    mutable dirty  : bool
    # when the held edits were last kept in the shadow
    mutable kept_at : i64
    # a property's undo, for the app to set (it owns the rows)
    public undo_row : PropRow
    public undo_was : string

    # the watch's thread only raises the flag; draw does the rest
    func on_files [ changed: Au :: v: DesignView ] -> none
        v.agi_seen = true

    # the .agi files of the project and their times now
    func agi_files [] -> vec string
        out : vec string []
        nm : string design.dir.filename[]
        out.push[ '{design.dir}/{nm}.agi' ]
        if [ design.model ] out.push[ '{design.objects_file[]}' ]
        mats : path '{design.base[]}/materials'
        if [ mats.exists[] ]
            for [ e: path ] in mats.ls[ null, false ]
                es : string '{e}'
                if [ es.ends_with[ '.agi' ] ] out.push[ es ]
        return out

    func time_of [ f: string ] -> i64
        p : path [ f ]
        if [ !p.exists[] ] return 0
        return p.modified_time[]

    # remember every .agi's time (after a read or our own write)
    func note_files []
        known_files = agi_files[]
        known_times = vec i64 []
        for [ f: string ] in known_files
            known_times.push[ time_of[ f ] ]
        known_body = design.body_text[]

    # what changed since: 0 nothing, 1 the render graph, 2 more
    func changed_files [] -> i32
        now : agi_files[]
        if [ !known_files || now.count != known_files.count ] return 2
        what : i32 [ 0 ]
        nm : string design.dir.filename[]
        design_file : string '{design.dir}/{nm}.agi'
        for [ i: i32 0, i < now.count, i += 1 ]
            if [ now[ i ].compare[ known_files[ i ] ] != 0 ] return 2
            if [ time_of[ now[ i ] ] == known_times[ i ] ] continue
            # the design file: only its render: block, or more
            same : bool [ now[ i ].compare[ design_file ] == 0
                && design.body_text[].compare[ known_body ] == 0 ]
            if [ same && what == 0 ] what = 1
            if [ !same ] what = 2
        return what

    # an outside edit: settings retuned in place, else rebuilt
    func follow_files [ cv: Canvas, w: Window, pw: i32, ph: i32 ]
        what : changed_files[]
        if [ what == 0 ] return
        fresh : StageGraph [ (what == 1) ? design.read_render[] : null ]
        if [ fresh && stage.retune[ fresh ] && focus.retune[ fresh ] ]
            design.render = fresh
            log 'aeon: settings retuned'
        el
            design.load[]
            focus_of = ''
            stage = Stage [ design: design, flip_y: true ]
            stage.build[ cv.vk, w, pw, ph ]
            focus = Stage [ design: design, flip_y: true,
                            transparent: true,
                            objects_only: true, occlude: true ]
            focus.build[ cv.vk, w, pw, ph ]
            if [ picked ] picked.clear[]
            log 'aeon: design reloaded'
        note_files[]

    func editing [] -> Object
        if [ !design || !chosen ] return null
        for [ o: Object ] in design.objects
            if [ o.name.compare[ chosen ] == 0 ] return o
        return null

    # the view's matrices for this frame
    func camera_eye [] -> vec3f
        cp : f32 [ cos[ pitch ] ]
        return vec3f [ center.x + dist * cp * cos[ yaw ],
                       center.y + dist * cp * sin[ yaw ],
                       center.z + dist * sin[ pitch ] ]

    # the pointer's move as a move in the world, in the plane
    # facing the view, at the depth of its centre
    func drag_world [ ev: Event ] -> vec3f
        cp : f32 [ cos[ pitch ] ]
        fx : f32 [ 0.0 - cp * cos[ yaw ] ]
        fy : f32 [ 0.0 - cp * sin[ yaw ] ]
        fz : f32 [ 0.0 - sin[ pitch ] ]
        # the view's right is f x z
        rx : f32 [ fy ]
        ry : f32 [ 0.0 - fx ]
        rl : f32 [ sqrt[ rx * rx + ry * ry ] ]
        if [ rl < 0.0001 ] rl = 0.0001
        rx = rx / rl
        ry = ry / rl
        # the screen's down (y grows down): f x r
        upx : f32 [ 0.0 - ry * fz ]
        upy : f32 [ rx * fz ]
        upz : f32 [ fx * ry - fy * rx ]
        scale : f32 [ 2.0 * dist * tan[ radians[ 20.0 ] ] / bounds.h ]
        dx : f32 [ ev.mouse.delta.x * scale ]
        dy : f32 [ ev.mouse.delta.y * scale ]
        return vec3f [ rx * dx + upx * dy, ry * dx + upy * dy,
                       upz * dy ]

    # a point in the object's space, placed, then on screen
    func spot [ o: Object, x: f32, y: f32, z: f32 ] -> Spot
        where : Placement [ at: o.at, turn: o.turn, size: o.size ]
        m : where.matrix[]
        wx : f32 [ m[ 0 ] * x + m[ 1 ] * y + m[ 2 ] * z + m[ 3 ] ]
        wy : f32 [ m[ 4 ] * x + m[ 5 ] * y + m[ 6 ] * z + m[ 7 ] ]
        wz : f32 [ m[ 8 ] * x + m[ 9 ] * y + m[ 10 ] * z + m[ 11 ] ]
        vm : mat4f [ view_m ]
        pm : mat4f [ stage.proj ]
        ex : f32 [ vm.m[ 0 ] * wx + vm.m[ 4 ] * wy + vm.m[ 8 ] * wz
                   + vm.m[ 12 ] ]
        ey : f32 [ vm.m[ 1 ] * wx + vm.m[ 5 ] * wy + vm.m[ 9 ] * wz
                   + vm.m[ 13 ] ]
        ez : f32 [ vm.m[ 2 ] * wx + vm.m[ 6 ] * wy + vm.m[ 10 ] * wz
                   + vm.m[ 14 ] ]
        ew : f32 [ vm.m[ 3 ] * wx + vm.m[ 7 ] * wy + vm.m[ 11 ] * wz
                   + vm.m[ 15 ] ]
        cx : f32 [ pm.m[ 0 ] * ex + pm.m[ 4 ] * ey + pm.m[ 8 ] * ez
                   + pm.m[ 12 ] * ew ]
        cy : f32 [ pm.m[ 1 ] * ex + pm.m[ 5 ] * ey + pm.m[ 9 ] * ez
                   + pm.m[ 13 ] * ew ]
        cw : f32 [ pm.m[ 3 ] * ex + pm.m[ 7 ] * ey + pm.m[ 11 ] * ez
                   + pm.m[ 15 ] * ew ]
        if [ cw <= 0.0001 ] return Spot [ x: -1.0, y: -1.0, z: -1.0 ]
        return Spot [ x: (cx / cw * 0.5 + 0.5) * bounds.w,
                      y: (cy / cw * 0.5 + 0.5) * bounds.h, z: cw ]

    # the cage point nearest the pointer, within 12 px; -1 none
    func nearest [ px: f32, py: f32 ] -> i32
        o : editing[]
        if [ !o || !stage ] return -1
        c : o.cage[]
        if [ !c || !c.poly ] return -1
        best : f32 [ 144.0 ]
        at : i32 [ -1 ]
        for [ i: i32 0, i < c.poly.verts[], i += 1 ]
            s : spot[ o, c.poly.pos[ i * 3 ], c.poly.pos[ i * 3 + 1 ],
                      c.poly.pos[ i * 3 + 2 ] ]
            dx : f32 [ s.x - px ]
            dy : f32 [ s.y - py ]
            d : f32 [ dx * dx + dy * dy ]
            if [ s.z > 0.0 && d < best ]
                best = d
                at = i
        return at

    # each point of a shape on screen: x, y in pixels, depth
    func screen_points [ o: Object, m: Poly ] -> vec f32
        n : i32 [ m.verts[] ]
        out : vec f32 [ n * 3 ]
        for [ i: i32 0, i < n, i += 1 ]
            s : spot[ o, m.pos[ i * 3 ], m.pos[ i * 3 + 1 ],
                      m.pos[ i * 3 + 2 ] ]
            out[ i * 3 ]     = s.x
            out[ i * 3 + 1 ] = s.y
            out[ i * 3 + 2 ] = s.z
        return out

    # the shown object whose surface is under the pointer, the
    # nearest one: its whole shape, every node applied
    func nearest_object [ px: f32, py: f32 ] -> Object
        if [ !design || !stage ] return null
        closest : f32 [ 1e30 ]
        found : Object [ null ]
        for [ o: Object ] in design.objects
            if [ !o.shown ] continue
            m : o.evaluate_shape[ design.base[] ]
            if [ !m ] continue
            sp : screen_points[ o, m ]
            for [ f: i32 0, f < m.faces[], f += 1 ]
                st : i32 [ m.fstart[ f ] ]
                k : i32 [ m.fsize[ f ] ]
                ia : i32 [ m.corner[ st ] * 3 ]
                # a fan over the face's corners
                for [ j: i32 1, j < k - 1, j += 1 ]
                    ib : i32 [ m.corner[ st + j ] * 3 ]
                    ic : i32 [ m.corner[ st + j + 1 ] * 3 ]
                    z : hit_depth[ sp, ia, ib, ic, px, py ]
                    if [ z > 0.0 && z < closest ]
                        closest = z
                        found = o
        return found

    # the depth where a screen triangle covers a point, else -1
    func hit_depth [ sp: vec f32, ia: i32, ib: i32, ic: i32,
                     px: f32, py: f32 ] -> f32
        ax : f32 [ sp[ ia ] ]
        ay : f32 [ sp[ ia + 1 ] ]
        bx : f32 [ sp[ ib ] ]
        by : f32 [ sp[ ib + 1 ] ]
        cx : f32 [ sp[ ic ] ]
        cy : f32 [ sp[ ic + 1 ] ]
        span : f32 [ (bx - ax) * (cy - ay) - (cx - ax) * (by - ay) ]
        if [ span > -1e-6 && span < 1e-6 ] return -1.0
        wb : f32 [ ((px - ax) * (cy - ay) - (cx - ax) * (py - ay))
                   / span ]
        wc : f32 [ ((bx - ax) * (py - ay) - (px - ax) * (by - ay))
                   / span ]
        if [ wb < 0.0 || wc < 0.0 || wb + wc > 1.0 ] return -1.0
        za : f32 [ sp[ ia + 2 ] ]
        zb : f32 [ sp[ ib + 2 ] ]
        zc : f32 [ sp[ ic + 2 ] ]
        if [ za <= 0.0 || zb <= 0.0 || zc <= 0.0 ] return -1.0
        return za + (zb - za) * wb + (zc - za) * wc

    # object mode: a click chooses an object, a drag moves it
    # object mode: a click chooses an object
    func press_object [ ev: Event ]
        o : nearest_object[ ev.mouse.pos.x, ev.mouse.pos.y ]
        # a click on nothing lets the chosen one go
        if [ !o ]
            chosen = ''
            if [ picked ] picked.clear[]
            if [ sel ]
                sel.object = ''
                sel.pass   = ''
                sel.node   = ''
                sel.solo   = ''
            return
        chosen = o.name
        if [ sel ]
            sel.object = o.name
            sel.pass   = ''
            sel.node   = ''
            # a double-click: it alone, for now; again, all back
            if [ ev.mouse.double_click ]
                sel.solo = (sel.solo && sel.solo.compare[ o.name ] == 0)
                    ? '' : o.name

    # g, r or s: the selection moves, turns or grows from where
    # it was, by the pointer or by typed values, until a click or
    # enter keeps it or a right click or escape puts it back
    func start_op [ kind: i32 ]
        o : editing[]
        if [ !o || op != 0 ] return
        if [ inner && (!picked || picked.count == 0) ] return
        if [ !undo ] undo = vec CageEdit []
        if [ !o.at ] o.at = vec f32 [ 3 ]
        if [ !o.turn ] o.turn = vec f32 [ 3 ]
        if [ !o.size ] o.size = vec f32 [] [ 1.0, 1.0, 1.0 ]
        from_at   = copy_of[ o.at ]
        from_turn = copy_of[ o.turn ]
        from_size = copy_of[ o.size ]
        if [ inner ]
            c : o.cage[]
            from_pos = copy_of[ c.poly.pos ]
            undo.push[ CageEdit [ name: o.name,
                                  pos: copy_of[ c.poly.pos ] ] ]
            # the picked points' middle: turns and sizes go round it
            mx : f32 [ 0.0 ]
            my : f32 [ 0.0 ]
            mz : f32 [ 0.0 ]
            for [ i: i32 ] in picked
                mx += from_pos[ i * 3 ]
                my += from_pos[ i * 3 + 1 ]
                mz += from_pos[ i * 3 + 2 ]
            nn : f32 [ picked.count ]
            pivot = vec3f [ mx / nn, my / nn, mz / nn ]
        el
            undo.push[ CageEdit [ name: o.name, at: copy_of[ o.at ],
                turn: copy_of[ o.turn ], size: copy_of[ o.size ] ] ]
        op = kind
        grabbing = true
        lock_mask = 0
        typing_mask = 0
        typing_text = ''
        typed_v = vec f32 [ 3 ]
        typed_on = vec i32 [ 3 ]
        grow = 0.0
        mouse_v = rest_value[]
        shown_v = rest_value[]

    func copy_of [ v: vec f32 ] -> vec f32
        out : vec f32 []
        for [ x: f32 ] in v
            out.push[ x ]
        return out

    # the value that changes nothing: no move, no turn, size 1
    func rest_value [] -> vec3f
        if [ op == 3 ] return vec3f [ 1.0, 1.0, 1.0 ]
        return vec3f [ 0.0, 0.0, 0.0 ]

    # the number typed so far, or none
    func typing_number [] -> f32
        if [ typing_text.count == 0 || typing_text == '-'
             || typing_text == '.' ] return 0.0
        return f32[ typing_text ]

    # the axes a number with none named goes to
    func default_mask [] -> i32
        if [ lock_mask != 0 ] return lock_mask
        if [ op == 3 ] return 7
        if [ op == 2 ] return 4
        return 1

    # the typed number given to every axis of the group
    func commit_typing []
        if [ typing_text.count == 0 ] return
        m : i32 [ (typing_mask != 0) ? typing_mask : default_mask[] ]
        v : typing_number[]
        for [ a: i32 0, a < 3, a += 1 ]
            if [ (m & (1 << a)) != 0 ]
                typed_v[ a ] = v
                typed_on[ a ] = 1
        typing_text = ''
        typing_mask = 0

    # the value asked for: typed values win; else the pointer's
    func goal_value [] -> vec3f
        typed : bool [ typing_text.count > 0 || typed_on[ 0 ] != 0
                     || typed_on[ 1 ] != 0 || typed_on[ 2 ] != 0 ]
        if [ !typed ] return mouse_v
        r : rest_value[]
        g : vec f32 [] [ r.x, r.y, r.z ]
        for [ a: i32 0, a < 3, a += 1 ]
            if [ typed_on[ a ] != 0 ] g[ a ] = typed_v[ a ]
        if [ typing_text.count > 0 ]
            m : i32 [ (typing_mask != 0) ? typing_mask
                      : default_mask[] ]
            v : typing_number[]
            for [ a: i32 0, a < 3, a += 1 ]
                if [ (m & (1 << a)) != 0 ] g[ a ] = v
        return vec3f [ g[ 0 ], g[ 1 ], g[ 2 ] ]

    # the selection set from where it was, by v
    func apply_op [ v: vec3f ]
        o : editing[]
        if [ !o ] return
        if [ !inner ]
            if [ op == 1 ]
                o.at = vec f32 [] [ from_at[ 0 ] + v.x,
                    from_at[ 1 ] + v.y, from_at[ 2 ] + v.z ]
            el [ op == 2 ]
                o.turn = vec f32 [] [ from_turn[ 0 ] + v.x,
                    from_turn[ 1 ] + v.y, from_turn[ 2 ] + v.z ]
            el
                o.size = vec f32 [] [ from_size[ 0 ] * v.x,
                    from_size[ 1 ] * v.y, from_size[ 2 ] * v.z ]
            dirty = true
            return
        c : o.cage[]
        turn : Placement [ turn: vec f32 [] [ v.x, v.y, v.z ] ]
        m : turn.matrix[]
        for [ i: i32 ] in picked
            x : f32 [ from_pos[ i * 3 ] ]
            y : f32 [ from_pos[ i * 3 + 1 ] ]
            z : f32 [ from_pos[ i * 3 + 2 ] ]
            if [ op == 1 ]
                x = x + v.x
                y = y + v.y
                z = z + v.z
            el
                rx : f32 [ x - pivot.x ]
                ry : f32 [ y - pivot.y ]
                rz : f32 [ z - pivot.z ]
                if [ op == 2 ]
                    tx : f32 [ m[ 0 ] * rx + m[ 1 ] * ry + m[ 2 ] * rz ]
                    ty : f32 [ m[ 4 ] * rx + m[ 5 ] * ry + m[ 6 ] * rz ]
                    tz : f32 [ m[ 8 ] * rx + m[ 9 ] * ry
                               + m[ 10 ] * rz ]
                    rx = tx
                    ry = ty
                    rz = tz
                el
                    rx = rx * v.x
                    ry = ry * v.y
                    rz = rz * v.z
                x = pivot.x + rx
                y = pivot.y + ry
                z = pivot.z + rz
            c.poly.pos[ i * 3 ] = x
            c.poly.pos[ i * 3 + 1 ] = y
            c.poly.pos[ i * 3 + 2 ] = z
        dirty = true

    # kept: the exact value applied, an unsaved edit
    func end_op []
        commit_typing[]
        apply_op[ goal_value[] ]
        o : editing[]
        if [ o && edits ]
            if [ inner ]
                edits.mark[ edits.cages, o.name ]
            el
                edits.mark[ edits.places, o.name ]
        settle_cage[ o ]
        op = 0
        grabbing = false
        mode = 0

    # a cage move ended: the object made once on the CPU, where
    # mirror and array decide their merges from the points (the GPU
    # keeps the merges it was made with while dragging)
    func settle_cage [ o: Object ]
        if [ !o || !inner ] return
        if [ o.joins_hold[ design.base[] ] ] return
        design.forget[ o.name ]
        remake[ o.name ]

    # put back as it was; its undo entry taken
    func cancel_op []
        apply_op[ rest_value[] ]
        settle_cage[ editing[] ]
        if [ undo && undo.count > 0 ] undo.pop[]
        op = 0
        grabbing = false
        mode = 0

    # the pointer drives the value while nothing is typed
    func op_move [ ev: Event ]
        # shift held: a quarter as fast, for fine placing
        fine : f32 [ (ux && ux.shift) ? 0.25 : 1.0 ]
        if [ op == 1 ]
            move : drag_world[ ev ]
            mx : f32 [ move.x * 0.5 * fine ]
            my : f32 [ move.y * 0.5 * fine ]
            mz : f32 [ move.z * 0.5 * fine ]
            # a group of axes keeps the pointer to them
            if [ lock_mask != 0 ]
                if [ (lock_mask & 1) == 0 ] mx = 0.0
                if [ (lock_mask & 2) == 0 ] my = 0.0
                if [ (lock_mask & 4) == 0 ] mz = 0.0
            mouse_v = vec3f [ mouse_v.x + mx, mouse_v.y + my,
                              mouse_v.z + mz ]
        el [ op == 2 ]
            deg : f32 [ ev.mouse.delta.x * 0.5 * fine ]
            m : i32 [ (lock_mask != 0) ? lock_mask : 4 ]
            ax : f32 [ ((m & 1) != 0) ? deg : 0.0 ]
            ay : f32 [ ((m & 2) != 0) ? deg : 0.0 ]
            az : f32 [ ((m & 4) != 0) ? deg : 0.0 ]
            mouse_v = vec3f [ mouse_v.x + ax, mouse_v.y + ay,
                              mouse_v.z + az ]
        el [ op == 3 ]
            grow = grow + ev.mouse.delta.x * 0.004 * fine
            f : f32 [ 1.0 + grow ]
            if [ f < 0.01 ] f = 0.01
            m : i32 [ (lock_mask != 0) ? lock_mask : 7 ]
            mouse_v = vec3f [ ((m & 1) != 0) ? f : 1.0,
                              ((m & 2) != 0) ? f : 1.0,
                              ((m & 4) != 0) ? f : 1.0 ]

    # the shown value eases to the goal, half the way a frame
    func ease_op []
        if [ op == 0 ] return
        g : goal_value[]
        ff : f32 [ ux.frame_factor ]
        n : vec3f [ filter_n[ shown_v.x, g.x, ease, ff ],
                    filter_n[ shown_v.y, g.y, ease, ff ],
                    filter_n[ shown_v.z, g.z, ease, ff ] ]
        moved : f32 [ abs[ n.x - shown_v.x ] + abs[ n.y - shown_v.y ]
                      + abs[ n.z - shown_v.z ] ]
        shown_v = n
        if [ moved > 0.0000001 ] apply_op[ shown_v ]

    # a key while g, r or s runs: enter keeps, escape puts back;
    # axes name a group (x y 2: both 2), digits make its number
    func op_key [ k: i32 ]
        if [ k == 257 || k == 335 ]
            end_op[]
            return
        if [ k == 256 ]
            cancel_op[]
            return
        if [ k >= 88 && k <= 90 ]
            bit : i32 [ 1 << (k - 88) ]
            # an axis after a number starts the next group
            if [ typing_text.count > 0 ] commit_typing[]
            typing_mask = typing_mask | bit
            lock_mask = typing_mask
            return
        if [ k == 259 ]
            if [ typing_text.count > 0 ]
                typing_text = typing_text.mid[ 0, typing_text.count - 1 ]
            return
        ch : ''
        if [ k >= 48 && k <= 57 ] ch = '{k - 48}'
        if [ k >= 320 && k <= 329 ] ch = '{k - 320}'
        if [ k == 46 || k == 330 ] ch = '.'
        if [ (k == 45 || k == 333) && typing_text.count == 0 ] ch = '-'
        if [ ch.count > 0 ] typing_text = '{typing_text}{ch}'

    # what is typed, shown at the view's foot
    func op_words [] -> string
        if [ op == 0 ] return ''
        out : string [ (op == 1) ? 'move' : (op == 2) ? 'turn'
                       : 'size' ]
        names : vec string [] [ 'x', 'y', 'z' ]
        for [ a: i32 0, a < 3, a += 1 ]
            if [ typed_on[ a ] != 0 ]
                out = '{out}  {names[ a ]} {typed_v[ a ]}'
        axes : ''
        for [ a: i32 0, a < 3, a += 1 ]
            if [ (typing_mask & (1 << a)) != 0 ]
                axes = '{axes}{names[ a ]}'
        if [ axes.count > 0 || typing_text.count > 0 ]
            out = '{out}  {axes} {typing_text}_'
        return out

    # inside the box or circle being drawn
    func in_region [ s: Spot ] -> bool
        if [ s.z <= 0.0 ] return false
        if [ region == 1 ]
            return s.x >= min[ region_x, pointer_x ]
                && s.x <= max[ region_x, pointer_x ]
                && s.y >= min[ region_y, pointer_y ]
                && s.y <= max[ region_y, pointer_y ]
        dx : f32 [ pointer_x - region_x ]
        dy : f32 [ pointer_y - region_y ]
        ex : f32 [ s.x - region_x ]
        ey : f32 [ s.y - region_y ]
        return ex * ex + ey * ey <= dx * dx + dy * dy

    # the region's points picked; shift or cmd adds to the pick
    func end_region [ adding: bool ]
        o : editing[]
        c : (o) ? o.cage[] : null
        if [ !picked ] picked = vec i32 []
        if [ !adding ] picked.clear[]
        if [ c && c.poly ]
            for [ i: i32 0, i < c.poly.verts[], i += 1 ]
                s : spot[ o, c.poly.pos[ i * 3 ],
                          c.poly.pos[ i * 3 + 1 ],
                          c.poly.pos[ i * 3 + 2 ] ]
                if [ in_region[ s ] && picked.index_of[ i ] < 0 ]
                    picked.push[ i ]
        region = 0
        mode = 0

    public func on_press [ ev: Event ]
        # a box or circle: a left click picks, any other drops it
        if [ region != 0 ]
            pointer_x = ev.mouse.pos.x
            pointer_y = ev.mouse.pos.y
            if [ ev.mouse.button == 0 ]
                end_region[ ux && (ux.shift || ux.cmd) ]
            el
                region = 0
            return
        # g, r or s ends on a click: right puts it back
        if [ op != 0 ]
            if [ ev.mouse.button == 1 ]
                cancel_op[]
            el
                end_op[]
            return
        # ctrl/cmd held: the drag moves the camera
        if [ ux && ux.cmd ]
            mode = 3
            return
        # shift + middle moves the camera too, as blender's
        if [ ev.mouse.button == 2 && ux && ux.shift ]
            mode = 3
            return
        # the right and middle buttons turn the view
        if [ ev.mouse.button == 1 || ev.mouse.button == 2 ]
            mode = 1
            return
        # the left button chooses, and only chooses
        mode = 0
        if [ !inner ]
            press_object[ ev ]
            return
        # cage mode: a click picks a point (shift adds)
        i : nearest[ ev.mouse.pos.x, ev.mouse.pos.y ]
        if [ i < 0 ] return
        if [ !picked ] picked = vec i32 []
        if [ !ux || !ux.shift ] picked.clear[]
        have : bool [ false ]
        for [ k: i32 ] in picked
            if [ k == i ] have = true
        if [ !have ] picked.push[ i ]

    public func on_release [ ev: Event ]
        if [ !grabbing ] mode = 0

    public func on_move [ ev: Event ]
        pointer_x = ev.mouse.pos.x
        pointer_y = ev.mouse.pos.y
        if [ op != 0 && mode != 1 && mode != 3 ]
            op_move[ ev ]
            return
        if [ mode == 1 ]
            # a drag adds to the goal; the view follows it, eased
            yaw_goal   = yaw_goal - ev.mouse.delta.x * 0.004
            pitch_goal = pitch_goal + ev.mouse.delta.y * 0.004
            if [ pitch_goal > 1.5 ] pitch_goal = 1.5
            if [ pitch_goal < -1.5 ] pitch_goal = -1.5
            return
        if [ mode == 3 ]
            # the model follows the pointer: the camera goes back
            pan : drag_world[ ev ]
            center_goal = vec3f [ center_goal.x - pan.x * 0.5,
                                  center_goal.y - pan.y * 0.5,
                                  center_goal.z - pan.z * 0.5 ]
            return

    # an edit to undo, made outside the view
    func push_undo [ ed: CageEdit ]
        if [ !undo ] undo = vec CageEdit []
        undo.push[ ed ]

    # an addition undone: the step goes, what took it takes its
    # input again
    func take_back [ back: CageEdit ]
        file : design.objects_file[]
        for [ o: Object ] in design.objects
            if [ o.name.compare[ back.name ] != 0 ] continue
            n : back.added
            for [ m: MeshNode ] in o.nodes
                if [ back.fixed.index_of[ m.name ] < 0 ] continue
                m.input = n.input
                if [ edits ]
                    edits.queue[ Write [ file: file, blocks: vec string
                        [] [ o.name, 'nodes', m.name ],
                        key: 'input', value: n.input ] ]
            if [ back.was_out && back.was_out.count > 0 ]
                o.out = back.was_out
                if [ edits ]
                    edits.queue[ Write [ file: file,
                        blocks: vec string [] [ o.name ], key: 'out',
                        value: back.was_out ] ]
            for [ i: i32 0, i < o.nodes.count, i += 1 ]
                if [ o.nodes[ i ] == n ]
                    o.nodes.remove[ i ]
                    break
            if [ edits ] edits.unadd[ '{o.name}/{n.name}' ]
            design.forget[ o.name ]
            remake[ o.name ]

    # a removal undone: the object, or the step, back where it was
    func put_back [ back: CageEdit ]
        file : design.objects_file[]
        if [ back.gone_obj ]
            design.objects.insert[ back.gone_obj, back.gone_at ]
            if [ edits ]
                edits.undrop[ file,
                    vec string [] [ back.gone_obj.name ] ]
            rebuild_due = true
            return
        for [ o: Object ] in design.objects
            if [ o.name.compare[ back.name ] != 0 ] continue
            n : back.gone_node
            o.nodes.insert[ n, back.gone_at ]
            for [ m: MeshNode ] in o.nodes
                if [ back.fixed.index_of[ m.name ] < 0 ] continue
                m.input = n.name
                if [ edits ]
                    edits.queue[ Write [ file: file, blocks: vec string
                        [] [ o.name, 'nodes', m.name ],
                        key: 'input', value: n.name ] ]
            if [ back.was_out && back.was_out.count > 0 ]
                o.out = back.was_out
                if [ edits ]
                    edits.queue[ Write [ file: file,
                        blocks: vec string [] [ o.name ], key: 'out',
                        value: back.was_out ] ]
            if [ edits ]
                edits.undrop[ file,
                    vec string [] [ o.name, 'nodes', n.name ] ]
            design.forget[ o.name ]
            remake[ o.name ]

    # a property about to change: its value before, once for a
    # run of changes to the same field
    func note_prop [ r: PropRow, was: string ]
        if [ !undo ] undo = vec CageEdit []
        if [ undo.count > 0 ]
            top : undo[ undo.count - 1 ]
            if [ top.row && top.row.name.compare[ r.name ] == 0
                 && '{top.row.file}' == '{r.file}'
                 && top.row.blocks.count == r.blocks.count ]
                same : bool [ true ]
                for [ k: i32 0, k < r.blocks.count, k += 1 ]
                    if [ top.row.blocks[ k ].compare[ r.blocks[ k ] ]
                         != 0 ] same = false
                if [ same ] return
        undo.push[ CageEdit [ name: '', row: r, was: was ] ]

    # the files the held edits change
    func edit_files [] -> vec string
        out : vec string []
        for [ w: Write ] in edits.adds
            if [ out.index_of[ '{w.file}' ] < 0 ] out.push[ '{w.file}' ]
        for [ w: Write ] in edits.writes
            if [ out.index_of[ '{w.file}' ] < 0 ] out.push[ '{w.file}' ]
        for [ w: Write ] in edits.drops
            if [ out.index_of[ '{w.file}' ] < 0 ] out.push[ '{w.file}' ]
        if [ edits.places.count > 0 ]
            pf : string '{design.objects_file[]}'
            if [ out.index_of[ pf ] < 0 ] out.push[ pf ]
        for [ o: Object ] in design.objects
            if [ edits.cages.index_of[ o.name ] < 0 ] continue
            c : o.cage[]
            if [ !c ] continue
            mf : string '{design.base[]}/{c.file}'
            if [ out.index_of[ mf ] < 0 ] out.push[ mf ]
        return out

    # the held edits put into the shadow, never the files: each
    # file it touches starts again from its base (the copy kept
    # from before, else the file) and takes every edit, so an
    # undone one is gone from it too
    func flush_shadow []
        if [ !edits || !design ] return
        now : edit_files[]
        all : vec string []
        for [ f: string ] in edits.touched
            all.push[ f ]
        for [ f: string ] in now
            if [ all.index_of[ f ] < 0 ] all.push[ f ]
        for [ f: string ] in all
            sp : path '{shadow_dir[]}{f}'
            base : path '{shadow_base[]}{f}'
            if [ !base.exists[] ] base = path [ f ]
            up : sp.parent_dir[]
            up.make_dir[]
            if [ sp.exists[] ] sp.remove[]
            # no edit left on a file that had none before: no copy
            from : '{base}'
            if [ now.index_of[ f ] < 0 && from.compare[ f ] == 0 ]
                continue
            base.cp[ sp, false, false ]
        root : shadow_dir[]
        for [ ad: Write ] in edits.adds
            if [ !agi_insert_after[ path '{root}{ad.file}', ad.blocks,
                                    ad.value ] ]
                log 'aeon: {ad.key} not added'
        for [ wr: Write ] in edits.writes
            if [ !agi_set[ path '{root}{wr.file}', wr.blocks, wr.key,
                           wr.value ] ]
                log 'aeon: {wr.key} not written'
        for [ dr: Write ] in edits.drops
            if [ !agi_drop[ path '{root}{dr.file}', dr.blocks ] ]
                log 'aeon: {dr.blocks.count} deep block not removed'
        for [ o: Object ] in design.objects
            if [ edits.cages.index_of[ o.name ] >= 0 ]
                c : o.cage[]
                if [ !c || !c.save[ path '{root}{design.base[]}' ] ]
                    log 'aeon: {o.name} cage not kept'
            if [ edits.places.index_of[ o.name ] >= 0 ]
                place_file : path '{root}{design.objects_file[]}'
                if [ !design.save_place_to[ o, place_file ] ]
                    log 'aeon: {o.name} place not kept'
        # a copy the edits left as its base was (all undone) goes
        for [ f: string ] in all
            sp : path '{shadow_dir[]}{f}'
            base : path '{shadow_base[]}{f}'
            if [ !base.exists[] ] base = path [ f ]
            if [ sp.exists[] && same_bytes[ sp, base ] ] sp.remove[]
        edits.touched = now

    # the held edits kept, a second apart at most, so a quit (or a
    # crash) loses none of them
    func keep_design []
        if [ !design || !edits ] return
        if [ !edits.queued[] && edits.touched.count == 0 ] return
        t : i64 [ epoch_micros[] ]
        if [ t - kept_at < 1000000 ] return
        kept_at = t
        flush_shadow[]

    # every change held in memory written: cages, places, values
    func save_all []
        if [ !edits || !design ] return
        # through the shadow: its copies of this design's files go
        # over the files, then the shadow lets them go
        flush_shadow[]
        root : shadow_dir[]
        for [ d: string ] in design_dirs[ design ]
            held : path '{root}{d}'
            for [ f: path ] in held.ls[ null, true ]
                fs : string '{f}'
                n : i32 [ root.count ]
                orig : path [ fs.mid[ n, fs.count - n ] ]
                f.cp[ orig, false, false ]
                f.remove[]
            gone : path '{shadow_base[]}{d}'
            if [ gone.exists[] ] gone.remove_dir[]
        edits.clear[]
        edits.touched = vec string []
        edits.kept = false
        note_files[]
        log 'aeon: saved'

    # blender's numpad: 1 front, 3 right, 7 top (ctrl: the side
    # opposite), 9 the other side, 8 2 4 6 turn 15 degrees, + -
    # zoom; false for any other key
    func numpad [ k: i32, ctrl: bool ] -> bool
        if [ k < 320 || k > 334 ] return false
        half : f32 [ 1.5707963 ]
        # as near straight down as the view's up allows
        top : f32 [ 1.5705 ]
        step : f32 [ radians[ 15.0 ] ]
        aim : f32 [ yaw_goal ]
        if [ k == 321 ]
            aim = (ctrl) ? half : 0.0 - half
            pitch_goal = 0.0
        el [ k == 323 ]
            aim = (ctrl) ? 2.0 * half : 0.0
            pitch_goal = 0.0
        el [ k == 327 ]
            aim = 0.0 - half
            pitch_goal = (ctrl) ? 0.0 - top : top
        el [ k == 329 ]
            aim = yaw_goal + 2.0 * half
            pitch_goal = 0.0 - pitch_goal
        el [ k == 324 ]
            aim = yaw_goal - step
        el [ k == 326 ]
            aim = yaw_goal + step
        el [ k == 328 ]
            pitch_goal = max[ pitch_goal - step, 0.0 - top ]
        el [ k == 322 ]
            pitch_goal = min[ pitch_goal + step, top ]
        el [ k == 334 ]
            dist_goal = max[ dist_goal / 1.2, 0.2 ]
        el [ k == 333 ]
            dist_goal = dist_goal * 1.2
        el
            return false
        # the nearest turn to the goal: never round the long way
        full : f32 [ 4.0 * half ]
        yaw_goal = aim + full * round[ (yaw_goal - aim) / full ]
        return true

    public func on_wheel [ ev: Event ]
        # half a step a notch, eased in as every move is
        step : f32 [ pow[ 1.05, 0.0 - ev.mouse.wheel_delta.y ] ]
        dist_goal = dist_goal * step
        if [ dist_goal < 0.2 ] dist_goal = 0.2

    # keys, as the app hands them on: the view takes no focus
    public func key_event [ ev: Event ]
        k : i32 [ ev.key.unicode ]
        down : bool [ ev.key.state != 0 ]
        # ctrl (cmd) + z: the last edit undone
        if [ k == 90 && down && (ev.key.ctrl || ev.key.meta) ]
            if [ !undo || undo.count == 0 ] return
            back : undo[ undo.count - 1 ]
            undo.pop[]
            if [ back.row ]
                undo_row = back.row
                undo_was = back.was
                return
            if [ !design ] return
            if [ back.added ]
                take_back[ back ]
                return
            if [ back.gone_obj || back.gone_node ]
                put_back[ back ]
                return
            for [ o: Object ] in design.objects
                if [ o.name.compare[ back.name ] != 0 ] continue
                if [ back.at ]
                    o.at = back.at
                    if [ back.turn ] o.turn = back.turn
                    if [ back.size ] o.size = back.size
                    if [ edits ] edits.mark[ edits.places, o.name ]
                el
                    c : o.cage[]
                    for [ i: i32 0, i < back.pos.count, i += 1 ]
                        c.poly.pos[ i ] = back.pos[ i ]
                    if [ edits ] edits.mark[ edits.cages, o.name ]
                    if [ !o.joins_hold[ design.base[] ] ]
                        design.forget[ o.name ]
                        remake[ o.name ]
                if [ stage ] stage.refresh[ o ]
                if [ focus ] focus.refresh[ o ]
            return
        # ctrl (cmd) + s: every held change written (shift: the
        # exchange's capture, not a save)
        if [ k == 83 && down && (ev.key.ctrl || ev.key.meta)
             && !ev.key.shift ]
            save_all[]
            return
        # a box or circle drawn: enter picks, escape drops it
        if [ region != 0 && down ]
            if [ k == 257 || k == 335 ]
                end_region[ ev.key.shift || ev.key.ctrl
                            || ev.key.meta ]
            if [ k == 256 ] region = 0
            return
        # b, c: a box or circle select, from the pointer here
        if [ op == 0 && down && inner && !ev.key.ctrl && !ev.key.meta
             && (k == 66 || k == 67) ]
            region = (k == 66) ? 1 : 2
            region_x = pointer_x
            region_y = pointer_y
            return
        # g, r, s: move, turn, size the selection, as blender's
        if [ op == 0 && down && !ev.key.ctrl && !ev.key.meta ]
            if [ k == 71 ] start_op[ 1 ]
            if [ k == 82 ] start_op[ 2 ]
            if [ k == 83 ] start_op[ 3 ]
            if [ op != 0 ] return
        if [ op != 0 && down ]
            op_key[ k ]
            return
        # the numpad's views, as blender's
        if [ down && numpad[ k, ev.key.ctrl || ev.key.meta ] ] return
        # tab: the chosen object, or its inner cage
        if [ k == 258 && down && !grabbing ]
            if [ chosen && chosen.count > 0 ] inner = !inner
            if [ picked ] picked.clear[]
            region = 0
            return


    # the chosen object's contour: its coverage made white and
    # blurred by rings of offsets, a 1 px ring sharp, wider ones
    # fading; the object drawn over it shows only the outside
    func glow [ cv: Canvas, shown: vec Texture ]
        cv.save[]
        # no colour, brightness past any value: white by coverage
        cv.color_filter[ 0.0, 0.0, 1000.0 ]
        radii : vec f32 [] [ 1.0, 2.0, 3.0, 4.5, 6.5 ]
        strength : vec f32 [] [ 0.9, 0.3, 0.2, 0.12, 0.06 ]
        for [ k: i32 0, k < radii.count, k += 1 ]
            cv.set_opacity[ strength[ k ] ]
            for [ step: i32 0, step < 8, step += 1 ]
                turn : f32 [ f32[ step ] * 0.7853982 ]
                dx : f32 [ cos[ turn ] * radii[ k ] ]
                dy : f32 [ sin[ turn ] * radii[ k ] ]
                for [ tx: Texture ] in shown
                    cv.draw_image[ tx, rect [ x: dx, y: dy,
                        w: bounds.w, h: bounds.h ] ]
        cv.restore[]

    # the chosen cage: its edges, its points, the picked lit
    func draw_cage [ cv: Canvas ]
        if [ !inner ] return
        o : editing[]
        if [ !o ] return
        c : o.cage[]
        if [ !c || !c.poly ] return
        m : c.poly
        nv : i32 [ m.verts[] ]
        spots : vec Spot []
        for [ i: i32 0, i < nv, i += 1 ]
            spots.push[ spot[ o, m.pos[ i * 3 ], m.pos[ i * 3 + 1 ],
                              m.pos[ i * 3 + 2 ] ] ]
        cv.save[]
        cv.fill_color[ '#0000' ]
        cv.stroke_color[ '#7fd4ffaa' ]
        cv.stroke_width[ 1.0 ]
        for [ f: i32 0, f < m.faces[], f += 1 ]
            st : i32 [ m.fstart[ f ] ]
            k : i32 [ m.fsize[ f ] ]
            for [ j: i32 0, j <= k, j += 1 ]
                s : spots[ m.corner[ st + j % k ] ]
                if [ j == 0 ]
                    cv.move_to[ s.x, s.y ]
                el
                    cv.line_to[ s.x, s.y ]
        cv.paint[]
        # creased edges over them: pink, stronger the higher the
        # crease (sharpness is 10 x crease squared)
        cv.stroke_width[ 2.5 ]
        for [ e: i32 0, e < m.sa.count, e += 1 ]
            ea : spots[ m.sa[ e ] ]
            eb : spots[ m.sb[ e ] ]
            if [ ea.z <= 0.0 && eb.z <= 0.0 ] continue
            crease : f32 [ clamp[ sqrt[ m.sharp[ e ] / 10.0 ], 0.0,
                                  1.0 ] ]
            cv.stroke_color[ rgba [ r: 1.0, g: 0.37, b: 0.82,
                                    a: 0.35 + 0.65 * crease ] ]
            cv.move_to[ ea.x, ea.y ]
            cv.line_to[ eb.x, eb.y ]
            cv.paint[]
        cv.stroke_width[ 0.0 ]
        for [ i: i32 0, i < nv, i += 1 ]
            s : spots[ i ]
            if [ s.z <= 0.0 ] continue
            lit : bool [ false ]
            if [ picked ]
                for [ k: i32 ] in picked
                    if [ k == i ] lit = true
            if [ region != 0 && in_region[ s ] ] lit = true
            cv.fill_color[ (lit) ? '#ffcf4a' : '#7fd4ff' ]
            sz : f32 [ (lit) ? 7.0 : 5.0 ]
            cv.rect_to[ s.x - sz * 0.5, s.y - sz * 0.5, sz, sz ]
            cv.paint[]
        draw_region[ cv ]
        cv.restore[]

    # the box or circle from where b or c was pressed
    func draw_region [ cv: Canvas ]
        if [ region == 0 ] return
        cv.fill_color[ '#ffffff14' ]
        cv.stroke_color[ '#ffffffcc' ]
        cv.stroke_width[ 1.0 ]
        if [ region == 1 ]
            cv.rect_to[ min[ region_x, pointer_x ],
                        min[ region_y, pointer_y ],
                        abs[ pointer_x - region_x ],
                        abs[ pointer_y - region_y ] ]
        el
            dx : f32 [ pointer_x - region_x ]
            dy : f32 [ pointer_y - region_y ]
            cv.arc[ region_x, region_y, sqrt[ dx * dx + dy * dy ],
                    0.0, 6.2831853 ]
        cv.paint[]

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        # the svg view takes ctrl + and - and ctrl + shift + s; here
        # they size the font and start the capture
        w.font_keys = true
        w.capture_keys = true
        cv : Canvas [ w.screen ]
        pw : i32 [ bounds.w ]
        ph : i32 [ bounds.h ]
        # the panels choose too: the view follows the selection
        if [ sel ]
            pick : string [ (sel.object) ? sel.object : '' ]
            if [ pick.compare[ (chosen) ? chosen : '' ] != 0 ]
                chosen = pick
                inner  = false
        if [ !stage ]
            stage = Stage [ design: design, flip_y: true ]
            stage.build[ cv.vk, w, pw, ph ]
            focus = Stage [ design: design, flip_y: true,
                            transparent: true,
                            objects_only: true, occlude: true ]
            focus.build[ cv.vk, w, pw, ph ]
            note_files[]
            watcher = watch [ res: design.dir,
                              callback: lambda on_files[ a ] ]
            watcher.start[]
            # the model module beside it is watched too
            if [ design.model ]
                model_watch = watch [ res: design.model,
                                      callback: lambda on_files[ a ] ]
                model_watch.start[]
        if [ agi_seen ]
            agi_seen = false
            follow_files[ cv, w, pw, ph ]
        # a new size: each stage resizes its targets in its frame and
        # hands their readers the new textures (rewire); nothing is
        # made again
        # an object's shape changed: its models, nothing else
        if [ remake_due && remake_due.count > 0 && !rebuild_due ]
            for [ nm: string ] in remake_due
                stage.remake[ nm ]
                focus.remake[ nm ]
            remake_due.clear[]
            focus_of = ''
        if [ remake_due ] remake_due.clear[]
        # a node or pass changed in memory: made again from memory
        if [ rebuild_due ]
            rebuild_due = false
            stage = Stage [ design: design, graph: stage.graph,
                            flip_y: true ]
            stage.build[ cv.vk, w, pw, ph ]
            focus = Stage [ design: design, graph: focus.graph,
                            flip_y: true,
                            transparent: true, objects_only: true,
                            occlude: true ]
            focus.build[ cv.vk, w, pw, ph ]
            focus_of = ''
        if [ !goal_set ]
            yaw_goal    = yaw
            pitch_goal  = pitch
            dist_goal   = dist
            center_goal = center
            goal_set    = true
        # every move eases: half the way to its goal each frame
        ff : f32 [ ux.frame_factor ]
        # the orbit commits a fifth of what is left a frame
        yaw   = filter_n[ yaw, yaw_goal, turn_ease, ff ]
        pitch = filter_n[ pitch, pitch_goal, turn_ease, ff ]
        dist  = filter_n[ dist, dist_goal, ease, ff ]
        center = vec3f [ filter_n[ center.x, center_goal.x, ease, ff ],
                         filter_n[ center.y, center_goal.y, ease, ff ],
                         filter_n[ center.z, center_goal.z, ease, ff ] ]
        ease_op[]
        spot_eye : camera_eye[]
        mid : vec3f [ center ]
        # z up; the projection flips y for vulkan's rows, so the
        # picture is not mirrored (a 180 degree roll mirrors it)
        up : vec3f [ 0.0, 0.0, 1.0 ]
        asp : f32 [ bounds.w / bounds.h ]
        view_m       = mat4f.look_at[ spot_eye, mid, up ]
        stage.eye    = spot_eye
        stage.middle = mid
        stage.up     = up
        lens : mat4f.perspective[ radians[ 40.0 ], asp, 0.05, 100.0 ]
        lens.m[ 5 ]  = 0.0 - lens.m[ 5 ]
        stage.proj   = lens
        if [ dirty ]
            dirty = false
            o : editing[]
            if [ o ]
                stage.refresh[ o ]
                focus.refresh[ o ]
        # a choice: the others greyed and see-through, it over them
        # unseen objects are in neither stage
        want : string [ (chosen) ? chosen : '' ]
        # a solo lasts while its object is the choice
        solo : string [ (sel && sel.solo) ? sel.solo : '' ]
        if [ solo.count > 0 && sel.object.compare[ solo ] != 0 ]
            sel.solo = ''
            solo = ''
        unseen : vec string []
        key : '{want}|solo:{solo}'
        for [ o: Object ] in design.objects
            alone : bool [ solo.count > 0
                           && o.name.compare[ solo ] != 0 ]
            if [ !o.shown || alone ]
                unseen.push[ o.name ]
                key = '{key}|{o.name}'
        quiet : vec string [ (sel && sel.off) ? sel.off : null ]
        if [ quiet ]
            for [ q: string ] in quiet
                key = '{key}|{q}'
        if [ key.compare[ (focus_of) ? focus_of : '' ] != 0 ]
            focus_of = key
            names : vec string [] [ want ]
            for [ nm: string ] in unseen
                names.push[ nm ]
            # alone means alone: a light of its own (the halo) off
            stage.objects_only = solo.count > 0
            stage.show_only[ names, true, quiet ]
            # the chosen one, unless unseen too
            front : vec string []
            if [ want.count > 0 && unseen.index_of[ want ] < 0 ]
                front.push[ want ]
            focus.unseen = unseen
            focus.show_only[ front, false, quiet ]
        focus.eye    = stage.eye
        focus.middle = stage.middle
        focus.proj   = stage.proj
        focus.up     = up
        # the ground, then the stage's outputs, each over the last
        cv.fill_color[ '#14141a' ]
        cv.rect_to[ 0.0, 0.0, bounds.w, bounds.h ]
        cv.paint[]
        whole : rect [ x: 0.0, y: 0.0, w: bounds.w, h: bounds.h ]
        if [ want.count > 0 ]
            cv.save[]
            cv.color_filter[ 0.0, 0.0, 1.0 ]
            cv.set_opacity[ 0.55 ]
            for [ tx: Texture ] in stage.frame[ pw, ph ]
                cv.draw_image[ tx, whole ]
            cv.restore[]
            shown : focus.frame[ pw, ph ]
            glow[ cv, shown ]
            for [ tx: Texture ] in shown
                cv.draw_image[ tx, whole ]
        el
            for [ tx: Texture ] in stage.frame[ pw, ph ]
                cv.draw_image[ tx, whole ]
        # the floor's grid, behind what stands on it
        if [ !grid ] grid = Grid [ vk: cv.vk, w: w ]
        dep : stage.object_depth[]
        if [ want.count > 0 ] dep = focus.object_depth[]
        ground : grid.frame[ dep, view_m, stage.proj, spot_eye, dist,
                            pw, ph ]
        if [ ground ] cv.draw_image[ ground, whole ]
        draw_cage[ cv ]
        # g, r or s running: what it does and what is typed
        words : op_words[]
        if [ words.count > 0 ]
            cv.fill_color[ '#ffcf4a' ]
            cv.draw_text[ words,
                rect [ x: 16.0, y: bounds.h - 40.0,
                       w: bounds.w - 32.0, h: 28.0 ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                Overflow.visible, null ]
            cv.paint[]

# an object's top-level values as its .agi writes them, by key
func agi_values [ obj: Au ] -> map Au [ string ]
    out : map Au [ string ] []
    txt : Au.string_agi[ obj ]
    for [ ln: string ] in txt.split[ '\n' ]
        if [ ln.count == 0 || ln.starts_with[ '\t' ] ] continue
        at : i32 [ ln.index_of[ ':' ] ]
        if [ at <= 0 ] continue
        rest : ln.mid[ at + 1, ln.count - at - 1 ]
        out[ ln.mid[ 0, at ] ] = rest.trim[]
    return out

# the value of key in values, or '' when it has none
func agi_text [ values: map Au [ string ], key: string ] -> string
    v : values[ key ]
    if [ !v ] return ''
    return string [ v ]

# one property row: its name, its value, where it is written
class PropRow
    public name   : string
    public value  : string
    public file   : path
    public blocks : vec string
    # pass settings are written quoted (a word; numbers bare)
    public quoted : bool
    # a list: shown without its brackets
    public list   : bool
    # 0 an object's place, 1 a node, 2 a pass, 3 a draw's
    # setting, 4 a material's value (pass: the material)
    public kind   : i32
    # the object, node or pass it is a member of
    public owner  : Au
    public pass   : string
    public draw   : string
    # the field's name
    public label  : string
    # the whole value as shown (a list's parts bare)
    public full   : string
    # the field's type: f32 and i32 drag, string types
    public type   : string
    # its choices, shown as buttons (stroke-linecap's words)
    public stops  : vec string

# three numbers from '[ a, b, c ]' (or 'a b c')
func numbers_of [ text: string ] -> vec f32
    out : vec f32 []
    clean : ''
    for [ i: i32 0, i < text.count, i += 1 ]
        c : i32 [ text.chars[ i ] ]
        # [ ] and commas read as spaces
        ok : bool [ c != 91 && c != 93 && c != 44 ]
        part : string [ (ok) ? text.mid[ i, 1 ] : ' ' ]
        clean = '{clean}{part}'
    for [ w: string ] in clean.split[ ' ' ]
        if [ w.count > 0 ] out.push[ f32[ w ] ]
    return out

# text that is exactly n numbers (a list's commas and brackets
# aside): never a word that reads as 0
func all_numbers [ text: string, n: i32 ] -> bool
    words : i32 [ 0 ]
    clean : ''
    for [ i: i32 0, i < text.count, i += 1 ]
        c : i32 [ text.chars[ i ] ]
        num : bool [ (c >= 48 && c <= 57) || c == 45 || c == 46
                     || c == 43 || c == 101 || c == 69 ]
        gap : bool [ c == 32 || c == 44 || c == 91 || c == 93 ]
        if [ !num && !gap ] return false
        part : string [ (gap) ? ' ' : text.mid[ i, 1 ] ]
        clean = '{clean}{part}'
    for [ w: string ] in clean.split[ ' ' ]
        if [ w.count > 0 ] words += 1
    return words == n

element aeon : trinity
    public width  : i32    [ 1280 ]
    public height : i32    [ 800 ]
    public title  : string [ 'aeon' ]
    # the project folder; the last one opened when none is given
    default [ Launch ] project : string
    intern [ StatePersist ] last_project : string
    # a drawing's unsaved text kept across a quit (or a crash): on,
    # and where it saves to ('' a drawing never saved)
    intern [ StatePersist ] recover_on : bool
    intern [ StatePersist ] recover_to : string
    # the last text kept, and when
    mutable recover_was : string
    mutable recover_at  : i64
    mutable design : Design
    mutable sel    : Selection
    # each choice in order, and where back and forward stand
    mutable history : vec Selection
    mutable place   : i32 [ -1 ]
    # changes held in memory until ctrl/cmd + s
    mutable edits  : Edits
    # what the outliner and the properties share
    mutable scene  : SceneEdit
    # an .svg opened: the 2D mode, in place of a design
    mutable doc    : SvgDoc
    # the title given to the bar (or the host's) once
    mutable titled : bool
    # how many times one was opened here: the view is made anew
    mutable opened : i32
    # the project as last opened: a new one set from outside (the
    # host's pick, `set project`) opens in place
    mutable opened_as : string

    func init []
        root : path.path_startup[]
        load-persistent[ a ]
        # a drawing left unsaved: opened again where it was
        back : recovered_project[]
        if [ back.count > 0 && (!project || project.count == 0
             || project.compare[ back ] == 0) ]
            project = back
        if [ !project || project.count == 0 ]
            if [ last_project ]
                was : path [ last_project ]
                if [ was.exists[] ] project = last_project
        # nothing opened before: the avatar's design
        if [ !project || project.count == 0 ]
            project = '{root}/aeon/flower888'
        # a folder named from where aeon was started
        if [ !project.starts_with[ '/' ] ]
            project = '{root}/{project}'
        if [ project.ends_with[ '.blend' ] ]
            project = import_blend[ project ]
        # the working copy of a drawing never saved is no project
        # to come back to
        work : string '{aeon_cache[]}/untitled.svg'
        if [ project.count > 0 && project.compare[ work ] != 0 ]
            last_project = project
            save-persistent[ a ]
        opened_as = project
        sel = Selection [ object: '', node: '', pass: '', solo: '' ]
        history = vec Selection []
        edits = Edits []
        if [ project.ends_with[ '.svg' ] ]
            doc = SvgDoc [ file: path [ project ] ]
            recover_into[ doc ]
            scene = SceneEdit [ sel: sel, edits: edits, doc: doc ]
            return
        dir : path [ project ]
        set_shadow_root[ shadow_dir[] ]
        design = Design [ dir: dir ]
        scene = SceneEdit [ design: design, sel: sel, edits: edits ]
        open_shadow[ design, edits ]

    # the views the orbiter bar offers over the editor: the scene
    # as nodes (an svg has none yet)
    public func views [] -> vec string
        if [ doc ] return null
        return vec string [] [ 'nodes' ]

    # the orbiter bar's dialog browses where this was opened from:
    # the svg's folder, or the folder holding the design
    public func nav_folder [] -> path
        if [ !project ] return null
        # a drawing never saved: the last project's folder (its own
        # is aeon's cache)
        if [ doc && doc.untitled ]
            was : path [ (last_project) ? last_project : '' ]
            if [ last_project && was.exists[] ] return was.parent_dir[]
            return path.path_startup[]
        p : path [ project ]
        return p.parent_dir[]

    # a pick in that dialog: an .svg, a .blend, or a folder with its
    # own design (<name>/<name>.agi) opens here; else not ours
    public func nav_open [ p: path ] -> bool
        txt : string '{p}'
        # the dialog asked where to save: the drawing saved there
        if [ ux && ux.nav_saving ]
            if [ !doc ] return false
            to : string [ txt ]
            if [ !to.ends_with[ '.svg' ] ] to = '{to}.svg'
            if [ !doc.save_as[ path [ to ] ] ] return false
            project = to
            last_project = to
            save-persistent[ a ]
            opened_as = to
            titled = false
            log 'aeon: saved as {to}'
            return true
        if [ txt.ends_with[ '.svg' ] || txt.ends_with[ '.blend' ] ]
            open_project[ txt ]
            return true
        if [ p.is_dir[] ]
            nm : string p.filename[]
            own : path '{p}/{nm}.agi'
            if [ own.exists[] ]
                open_project[ txt ]
                return true
        return false

    # the project a kept text belongs to ('' none): its file, or
    # the working copy of a drawing never saved
    func recovered_project [] -> string
        if [ !recover_on ] return ''
        kept : path '{aeon_cache[]}/recover.svg'
        if [ !kept.exists[] ] return ''
        if [ recover_to && recover_to.count > 0 ]
            to : path [ recover_to ]
            if [ to.exists[] ] return recover_to
        return '{aeon_cache[]}/untitled.svg'

    # a drawing just opened takes the text kept for it, unsaved
    func recover_into [ d: SvgDoc ]
        if [ !recover_on ] return
        mine : string [ (recover_to && recover_to.count > 0)
                        ? recover_to : '{aeon_cache[]}/untitled.svg' ]
        have : '{d.file}'
        if [ have.compare[ mine ] != 0 ] return
        kept : path '{aeon_cache[]}/recover.svg'
        if [ !kept.exists[] ] return
        txt : string kept.load[ typeid[ string ], null ]
        d.take_text[ txt ]
        if [ !recover_to || recover_to.count == 0 ] d.untitled = true
        recover_was = txt
        log 'aeon: unsaved changes kept from before'

    # the drawing's unsaved text kept, a second apart at most, so
    # a quit (or a crash) loses none of it; a save lets it go
    func keep_recovery []
        if [ !doc ] return
        if [ !doc.unsaved[] && !doc.untitled ]
            if [ recover_on ]
                recover_on = false
                recover_was = null
                kept : path '{aeon_cache[]}/recover.svg'
                if [ kept.exists[] ] kept.remove[]
                save-persistent[ a ]
            return
        now : i64 [ epoch_micros[] ]
        if [ now - recover_at < 1000000 ] return
        recover_at = now
        txt : doc.compose[]
        if [ recover_was && txt.compare[ recover_was ] == 0 ] return
        keep_file : '{aeon_cache[]}/recover.svg'
        f : handle [ fopen[ keep_file.chars, "w" ] ]
        if [ !f ] return
        fputs[ txt.chars, f ]
        fclose[ f ]
        recover_was = txt
        to : string [ (doc.untitled) ? '' : '{doc.file}' ]
        if [ !recover_on || !recover_to
             || recover_to.compare[ to ] != 0 ]
            recover_on = true
            recover_to = to
            save-persistent[ a ]

    # anything not in the files: a drawing's changes, a design's
    # held or kept edits
    func unsaved [] -> bool
        if [ doc ] return doc.unsaved[] || doc.untitled
        if [ edits ] return edits.pending[]
        return false

    # ctrl/cmd + r: the status line asks; enter reverts
    func ask_revert []
        if [ !unsaved[] ]
            log 'aeon: nothing to revert'
            return
        if [ scene ] scene.reverting = true

    # the kept copies let go and the project read again from its
    # files; a drawing never saved goes back to an empty page
    func revert []
        if [ doc ]
            recover_on  = false
            recover_was = null
            kept : path '{aeon_cache[]}/recover.svg'
            if [ kept.exists[] ] kept.remove[]
            save-persistent[ a ]
            if [ doc.untitled ]
                new_drawing[]
                log 'aeon: reverted to an empty page'
                return
        el [ design ]
            root : shadow_dir[]
            for [ d: string ] in design_dirs[ design ]
                held : path '{root}{d}'
                if [ held.exists[] ] held.remove_dir[]
            sb : path [ shadow_base[] ]
            if [ sb.exists[] ] sb.remove_dir[]
        open_project[ project ]
        log 'aeon: reverted to the files'

    # ctrl/cmd + n: a new drawing, never saved: an empty page as
    # its working copy; a save asks where
    func new_drawing []
        work : string '{aeon_cache[]}/untitled.svg'
        f : handle [ fopen[ work.chars, "w" ] ]
        if [ !f ] return
        head : '<svg xmlns="http://www.w3.org/2000/svg"'
        page : '{head} width="200" height="200" viewBox="0 0 200 200">'
        empty : '{page}\n</svg>\n'
        fputs[ empty.chars, f ]
        fclose[ f ]
        before : string [ last_project ]
        open_project[ work ]
        # the working copy is no project to come back to
        last_project = before
        save-persistent[ a ]
        doc.untitled = true

    # another project opened in place: everything chosen, held and
    # shown starts over; the view is made anew
    func open_project [ p: string ]
        project = p
        if [ project.ends_with[ '.blend' ] ]
            project = import_blend[ project ]
        last_project = project
        save-persistent[ a ]
        sel = Selection [ object: '', node: '', pass: '', solo: '' ]
        history = vec Selection []
        place = -1
        edits = Edits []
        doc = null
        design = null
        if [ project.ends_with[ '.svg' ] ]
            doc = SvgDoc [ file: path [ project ] ]
            scene = SceneEdit [ sel: sel, edits: edits, doc: doc ]
        el
            set_shadow_root[ shadow_dir[] ]
            design = Design [ dir: path [ project ] ]
            scene = SceneEdit [ design: design, sel: sel,
                                edits: edits ]
            open_shadow[ design, edits ]
        opened += 1
        opened_as = project
        titled = false

    # ctrl/cmd + left and right, and orbiter's arrows: the choices
    # made before and after this one
    public func navigate [ dir: i32 ] -> bool
        to : i32 [ place + dir ]
        if [ to < 0 || to >= history.count ] return false
        place = to
        was : history[ to ]
        sel.object = was.object
        sel.node   = was.node
        sel.pass   = was.pass
        nav_state[ place > 0, place < history.count - 1 ]
        return true

    # a new choice is remembered; one after a step back drops
    # the steps ahead of it
    func remember []
        if [ place >= 0 && place < history.count ]
            at : history[ place ]
            if [ at.object.compare[ sel.object ] == 0
                 && at.node.compare[ sel.node ] == 0
                 && at.pass.compare[ sel.pass ] == 0 ] return
        while [ history.count > place + 1 ]
            history.pop[]
        history.push[ Selection [ object: sel.object, node: sel.node,
                                  pass: sel.pass ] ]
        place = history.count - 1
        nav_state[ place > 0, false ]

    # a property's check box toggles here, as orbiter's does
    public func on_press [ ev: Event ]
        if [ ev.target && ev.target inherits LaunchCheck ]
            ck : LaunchCheck ev.target
            ck.selected   = !ck.selected
            ck.pristine   = false
            ev.no_default = true

    public func on_key [ ev: Event ]
        # the revert asked: enter reverts, any other key does not
        if [ scene && scene.reverting && ev.key.state ]
            k : i32 [ ev.key.unicode ]
            if [ k < 340 || k > 347 ]
                scene.reverting = false
                if [ k == 257 || k == 335 ] revert[]
                return
        # ctrl/cmd + n: a new drawing
        if [ ev.key.state && ev.key.unicode == 78
             && (ev.key.ctrl || ev.key.meta) && !ev.key.shift ]
            new_drawing[]
            return
        # ctrl/cmd + r: back to the files, asked first
        if [ ev.key.state && ev.key.unicode == 82
             && (ev.key.ctrl || ev.key.meta) && !ev.key.shift ]
            ask_revert[]
            return
        # escape closes the modifier kinds first
        if [ scene && scene.choosing && ev.key.state
             && ev.key.unicode == 256 ]
            scene.choosing = false
            return
        if [ doc && middle[] ]
            sv : middle[] inherits SvgView
            if [ sv ] sv.key_event[ ev ]
            return
        v : view[]
        if [ v ]
            v.key_event[ ev ]

    # typed characters: the svg view's text being typed
    public func on_char [ ev: Event ]
        if [ doc && middle[] ]
            sv : middle[] inherits SvgView
            if [ sv ] sv.char_event[ ev ]

    func view [] -> DesignView
        mid : middle[]
        if [ !mid ] return null
        return mid inherits DesignView

    # the view between the outliner and the properties
    func middle [] -> element
        if [ !elements || !elements.contains[ 'split' ] ] return null
        sp : elements[ 'split' ]
        key : string 'view{opened}'
        if [ !sp.elements || !sp.elements.contains[ key ] ]
            return null
        return sp.elements[ key ]

    public func render [] -> Elements
        # the host picked another resource for it: opened here
        if [ project && opened_as
             && project.compare[ opened_as ] != 0 ]
            open_project[ project ]
        remember[]
        keep_recovery[]
        # a design's held edits kept in the shadow
        held_in : view[]
        if [ held_in ] held_in.keep_design[]
        # the bar's title (or the host pane's): the folder or file
        if [ !titled && ux ]
            titled = true
            named : path [ project ]
            set_title[ (doc && doc.untitled) ? 'untitled'
                                             : named.filename[] ]
        e : Elements [ ]
        v : view[]
        # the outliner the full left, the scene in the middle, the
        # chosen thing's properties on the right; the seams drag
        scene.view = v
        panes : map element [ string ] []
        panes[ 'outline' ] = Outliner [ scene: scene, animated: true ]
        key : string 'view{opened}'
        if [ doc ]
            panes[ key ] = SvgView [ doc: doc, animated: true ]
        el
            panes[ key ] = DesignView [ design: design, sel: sel,
                edits: edits, animated: true ]
        panes[ 'props' ] = PropsSide [ scene: scene, animated: true ]
        # on its own: the orbiter bar over all of it; in orbiter's
        # pane, the pane's bar is it
        alone : bool [ !ux || !ux.hosted[] ]
        top : string [ (alone) ? 't1.3' : 't0' ]
        if [ alone ]
            e[ 'bar' ] = OrbiterBar [ area: Region { l0 t0 r0 h1.3 } ]
        # the nodes view over it: the editor stays (its stages kept),
        # hidden
        nodes : bool [ ux && !doc && ux.bar_view
                       && ux.bar_view.compare[ 'nodes' ] == 0 ]
        e[ 'split' ] = Splitter [ area: Region [ 'l0 {top} r0 b0' ],
            inner: panes, flex: 1, min_size: 120.0, hide: nodes,
            sizes: vec f32 [] [ 240.0, 0.0, 340.0 ] ]
        if [ nodes ]
            e[ 'nodes' ] = NodeGraph [ scene: scene,
                area: Region [ 'l0 {top} r0 b0' ] ]
        return e

# aeon's cache folder: a new drawing's working copy, the kept
# text and the shadow live there
func aeon_cache [] -> string
    nm : 'aeon'
    dir : string '{path.path_cache[ nm.chars ]}'
    made : path [ dir ]
    if [ !made.exists[] ] made.make_dir[]
    return dir

# where a design's unsaved files are kept (under their own
# paths), and the copies it held when the design was opened
# (what a session's edits start from)
func shadow_dir [] -> string
    return '{aeon_cache[]}/shadow'

func shadow_base [] -> string
    return '{aeon_cache[]}/shadow-base'

# a design's own folders: its project, and its model's
func design_dirs [ d: Design ] -> vec string
    out : vec string [] [ '{d.dir}' ]
    if [ d.model ] out.push[ '{d.model}' ]
    return out

# a design opened: copies kept from before are its unsaved state,
# and what this session's edits start from
func open_shadow [ design: Design, edits: Edits ]
    set_shadow_root[ shadow_dir[] ]
    if [ !design || !edits ] return
    sb : path [ shadow_base[] ]
    if [ sb.exists[] ] sb.remove_dir[]
    edits.touched = vec string []
    edits.kept = false
    root : shadow_dir[]
    for [ d: string ] in design_dirs[ design ]
        held : path '{root}{d}'
        for [ f: path ] in held.ls[ null, true ]
            fs : string '{f}'
            n : i32 [ root.count ]
            orig : fs.mid[ n, fs.count - n ]
            to : path '{shadow_base[]}{orig}'
            up : to.parent_dir[]
            up.make_dir[]
            f.cp[ to, false, false ]
            edits.kept = true
    if [ edits.kept ] log 'aeon: unsaved edits kept from before'

# two files holding the same bytes
func same_bytes [ a: path, b: path ] -> bool
    fa : handle [ fopen[ a, "rb" ] ]
    if [ !fa ] return false
    fb : handle [ fopen[ b, "rb" ] ]
    if [ !fb ]
        fclose[ fa ]
        return false
    fseek[ fa, 0, SEEK_END ]
    fseek[ fb, 0, SEEK_END ]
    na : i64 [ ftell[ fa ] ]
    nb : i64 [ ftell[ fb ] ]
    same : bool [ na == nb ]
    if [ same && na > 0 ]
        fseek[ fa, 0, SEEK_SET ]
        fseek[ fb, 0, SEEK_SET ]
        ba : new u8 [ na ]
        bb : new u8 [ nb ]
        fread[ ba, 1, na, fa ]
        fread[ bb, 1, nb, fb ]
        same = memcmp[ ba, bb, na ] == 0
    fclose[ fa ]
    fclose[ fb ]
    return same
