# the avatar: its model, and the passes that draw it
model: 'fmodel'
# the avatar's chain: the metal body, the core and the plasma
# ring at 4x with depth, the aura's volume over its depth, the
# groove mask, and the heat haze over the reduced body
render: StageGraph
	modules: [ avatar ]
	passes:
		av: Pass
			scale: 4
			depth: true
			reduce: true
			y_up: true
			draws:
				body: Draw
					objects: [ outside, flower, separator ]
					shader: PBR
					settings:
						env_id: 'forest'
						pulse_width: '4.0'
						gamma: '1.88'
						spoke_r0: '0.10'
						spoke_r1: '0.55'
						blend_rings: '0.2'
						blend_haze: '1.0'
						blend_bands: '0.2'
					inputs:
						spokes: 'color:1 1 1 1'
				core: Draw
					objects: [ core ]
					shader: Core
					settings:
						pulse_width: '4.0'
				plasma: Draw
					objects: [ flower ]
					shader: Plasma
					settings:
						pulse_width: '1.0'
		volume: Pass
			scale: 1
			most: 1024
			y_up: true
			draws:
				aura: Draw
					quad: true
					shader: Aura
					settings:
						pulse_width: '0.4'
						pulse_height: '1.2'
						halo_height: '0.4'
						beam_fade: '2.2'
						beam_cone: '0.35'
						beam: '0.0'
						donut_reach: '2.0'
					inputs:
						height: 'av.depth'
						rim: 'color:0.6 0.3 1 1'
		mask: Pass
			scale: 4
			depth: true
			reduce: true
			y_up: true
			objects: [ outside, flower, separator ]
			shader: GrooveMask
		layers: Pass
			scale: 1
			y_up: true
			quad: true
			shader: AeonOver
			inputs:
				color: 'av.reduction'
				emission: 'volume.color'
		heat: Pass
			scale: 1
			y_up: true
			draws:
				heat: Draw
					quad: true
					shader: Heat
					settings:
						heat: '1.0'
						busy: '1.0'
						pulse_height: '1.2'
					inputs:
						color: 'layers.color'
						height: 'av.depth'
						emission: 'mask.reduction'
	out: [ heat ]
