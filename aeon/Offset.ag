extend aeon

# a linked offset: a shape's outline moved out (or in) by a
# distance, fitted as joined cubic beziers. A cubic is eight
# floats in a run: x0 y0 x1 y1 x2 y2 x3 y3.

# one segment's offset: its cubics, or none when it turned back
class Pieces
    public p    : vec f32
    public gone : bool

# a cubic's point at t
func bz_at [ c: vec f32, o: i32, t: f32 ] -> vec2f
    u : f32 [ 1.0 - t ]
    a : f32 [ u * u * u ]
    b : f32 [ 3.0 * u * u * t ]
    e : f32 [ 3.0 * u * t * t ]
    f : f32 [ t * t * t ]
    return vec2f [ a * c[ o ] + b * c[ o + 2 ] + e * c[ o + 4 ]
                   + f * c[ o + 6 ],
                   a * c[ o + 1 ] + b * c[ o + 3 ] + e * c[ o + 5 ]
                   + f * c[ o + 7 ] ]

# a cubic's unit direction at t (a handle on its anchor: the
# chord past it)
func bz_dir [ c: vec f32, o: i32, t: f32 ] -> vec2f
    u : f32 [ 1.0 - t ]
    dx : f32 [ u * u * (c[ o + 2 ] - c[ o ])
               + 2.0 * u * t * (c[ o + 4 ] - c[ o + 2 ])
               + t * t * (c[ o + 6 ] - c[ o + 4 ]) ]
    dy : f32 [ u * u * (c[ o + 3 ] - c[ o + 1 ])
               + 2.0 * u * t * (c[ o + 5 ] - c[ o + 3 ])
               + t * t * (c[ o + 7 ] - c[ o + 5 ]) ]
    if [ dx * dx + dy * dy < 1e-14 ]
        if [ t < 0.5 ]
            dx = c[ o + 4 ] - c[ o ]
            dy = c[ o + 5 ] - c[ o + 1 ]
        el
            dx = c[ o + 6 ] - c[ o + 2 ]
            dy = c[ o + 7 ] - c[ o + 3 ]
    if [ dx * dx + dy * dy < 1e-14 ]
        dx = c[ o + 6 ] - c[ o ]
        dy = c[ o + 7 ] - c[ o + 1 ]
    l : f32 [ sqrt[ dx * dx + dy * dy ] ]
    if [ l < 1e-9 ] return vec2f [ 1.0, 0.0 ]
    return vec2f [ dx / l, dy / l ]

# the point ds to the side of a direction (its right on a
# y-down page; the caller's sign picks the side)
func side_of [ px: f32, py: f32, u: vec2f, ds: f32 ] -> vec2f
    return vec2f [ px + ds * u.y, py - ds * u.x ]

# where two lines meet: z is 0 when they are parallel
func meet [ p: vec2f, u: vec2f, q: vec2f, v: vec2f ] -> vec3f
    cr : f32 [ u.x * v.y - u.y * v.x ]
    if [ abs[ cr ] < 1e-6 ] return vec3f [ 0.0, 0.0, 0.0 ]
    s : f32 [ ((q.x - p.x) * v.y - (q.y - p.y) * v.x) / cr ]
    return vec3f [ p.x + s * u.x, p.y + s * u.y, 1.0 ]

# the part of a cubic from 0 to t, or from t to 1
func bz_cut [ c: vec f32, o: i32, t: f32, keep_left: bool ]
        -> vec f32
    ax : f32 [ c[ o ] + (c[ o + 2 ] - c[ o ]) * t ]
    ay : f32 [ c[ o + 1 ] + (c[ o + 3 ] - c[ o + 1 ]) * t ]
    bx : f32 [ c[ o + 2 ] + (c[ o + 4 ] - c[ o + 2 ]) * t ]
    by : f32 [ c[ o + 3 ] + (c[ o + 5 ] - c[ o + 3 ]) * t ]
    ex : f32 [ c[ o + 4 ] + (c[ o + 6 ] - c[ o + 4 ]) * t ]
    ey : f32 [ c[ o + 5 ] + (c[ o + 7 ] - c[ o + 5 ]) * t ]
    fx : f32 [ ax + (bx - ax) * t ]
    fy : f32 [ ay + (by - ay) * t ]
    gx : f32 [ bx + (ex - bx) * t ]
    gy : f32 [ by + (ey - by) * t ]
    mx : f32 [ fx + (gx - fx) * t ]
    my : f32 [ fy + (gy - fy) * t ]
    if [ keep_left ]
        return vec f32 [] [ c[ o ], c[ o + 1 ], ax, ay, fx, fy, mx,
                            my ]
    return vec f32 [] [ mx, my, gx, gy, ex, ey, c[ o + 6 ],
                        c[ o + 7 ] ]

func push_cubic [ out: vec f32, k: vec f32 ]
    for [ v: f32 ] in k
        out.push[ v ]

# a cubic's offset: its control legs moved aside and met
# (Tiller and Hanson), halved until it lies within tol of the
# true offset
func offset_piece [ c: vec f32, o: i32, ds: f32, tol: f32,
                    out: vec f32, depth: i32 ]
    u0 : bz_dir[ c, o, 0.0 ]
    u2 : bz_dir[ c, o, 1.0 ]
    lx : f32 [ c[ o + 4 ] - c[ o + 2 ] ]
    ly : f32 [ c[ o + 5 ] - c[ o + 3 ] ]
    ll : f32 [ sqrt[ lx * lx + ly * ly ] ]
    u1 : vec2f [ u0 ]
    if [ ll > 1e-9 ] u1 = vec2f [ lx / ll, ly / ll ]
    q0 : side_of[ c[ o ], c[ o + 1 ], u0, ds ]
    q3 : side_of[ c[ o + 6 ], c[ o + 7 ], u2, ds ]
    a1 : side_of[ c[ o + 2 ], c[ o + 3 ], u1, ds ]
    q1 : side_of[ c[ o + 2 ], c[ o + 3 ], u0, ds ]
    q2 : side_of[ c[ o + 4 ], c[ o + 5 ], u2, ds ]
    chx : f32 [ c[ o + 6 ] - c[ o ] ]
    chy : f32 [ c[ o + 7 ] - c[ o + 1 ] ]
    reach : f32 [ 4.0 * (sqrt[ chx * chx + chy * chy ] + abs[ ds ]) ]
    m1 : meet[ q0, u0, a1, u1 ]
    if [ m1.z > 0.5 && abs[ m1.x - c[ o + 2 ] ] < reach
         && abs[ m1.y - c[ o + 3 ] ] < reach ]
        q1 = vec2f [ m1.x, m1.y ]
    m2 : meet[ a1, u1, q3, u2 ]
    if [ m2.z > 0.5 && abs[ m2.x - c[ o + 4 ] ] < reach
         && abs[ m2.y - c[ o + 5 ] ] < reach ]
        q2 = vec2f [ m2.x, m2.y ]
    k : vec f32 [] [ q0.x, q0.y, q1.x, q1.y, q2.x, q2.y, q3.x, q3.y ]
    # how far it lies from the true offset
    err : f32 [ 0.0 ]
    for [ s: i32 1, s < 8, s += 1 ]
        t : f32 [ f32[ s ] / 8.0 ]
        on : bz_at[ c, o, t ]
        want : side_of[ on.x, on.y, bz_dir[ c, o, t ], ds ]
        got : bz_at[ k, 0, t ]
        ex : f32 [ got.x - want.x ]
        ey : f32 [ got.y - want.y ]
        err = max[ err, sqrt[ ex * ex + ey * ey ] ]
    if [ err > tol && depth < 8 ]
        left : bz_cut[ c, o, 0.5, true ]
        right : bz_cut[ c, o, 0.5, false ]
        offset_piece[ left, 0, ds, tol, out, depth + 1 ]
        offset_piece[ right, 0, ds, tol, out, depth + 1 ]
        return
    push_cubic[ out, k ]

# an arc as cubics, a quarter turn at most each
func arc_pieces [ cx: f32, cy: f32, r: f32, a0: f32, sweep: f32,
                  out: vec f32 ]
    n : i32 [ ceil[ abs[ sweep ] / 1.5707964 ] ]
    if [ n < 1 ] n = 1
    step : f32 [ sweep / f32[ n ] ]
    k : f32 [ 4.0 / 3.0 * tan[ step / 4.0 ] ]
    for [ i: i32 0, i < n, i += 1 ]
        a : f32 [ a0 + f32[ i ] * step ]
        b : f32 [ a + step ]
        x0 : f32 [ cx + r * cos[ a ] ]
        y0 : f32 [ cy + r * sin[ a ] ]
        x3 : f32 [ cx + r * cos[ b ] ]
        y3 : f32 [ cy + r * sin[ b ] ]
        push_cubic[ out, vec f32 [] [ x0, y0,
            x0 - k * r * sin[ a ], y0 + k * r * cos[ a ],
            x3 + k * r * sin[ b ], y3 - k * r * cos[ b ], x3, y3 ] ]

# a straight cubic from one point to another
func line_piece [ ax: f32, ay: f32, bx: f32, by: f32, out: vec f32 ]
    push_cubic[ out, vec f32 [] [ ax, ay,
        ax + (bx - ax) / 3.0, ay + (by - ay) / 3.0,
        ax + (bx - ax) * 2.0 / 3.0, ay + (by - ay) * 2.0 / 3.0,
        bx, by ] ]

# a run's samples: x, y, its cubic and t, eight a cubic
func samples [ p: vec f32, from: i32, upto: i32 ] -> vec f32
    out : vec f32 []
    for [ i: i32 from, i < upto, i += 1 ]
        for [ s: i32 0, s <= 8, s += 1 ]
            t : f32 [ f32[ s ] / 8.0 ]
            at : bz_at[ p, i * 8, t ]
            out.push[ at.x ]
            out.push[ at.y ]
            out.push[ f32[ i ] ]
            out.push[ t ]
    return out

# where a's end crosses b's start: a cut back to it, b cut on
# from it; false when they do not cross
func trim_cross [ a: Pieces, b: Pieces ] -> bool
    na : i32 [ a.p.count / 8 ]
    nb : i32 [ b.p.count / 8 ]
    if [ na == 0 || nb == 0 ] return false
    sa : samples[ a.p, max[ na - 4, 0 ], na ]
    sb : samples[ b.p, 0, min[ nb, 4 ] ]
    best : f32 [ -1.0 ]
    ia : i32 [ 0 ]
    ta : f32 [ 0.0 ]
    ib : i32 [ 0 ]
    tb : f32 [ 0.0 ]
    for [ i: i32 0, i + 4 < sa.count, i += 4 ]
        if [ sa[ i + 2 ] != sa[ i + 6 ] ] continue
        for [ j: i32 0, j + 4 < sb.count, j += 4 ]
            if [ sb[ j + 2 ] != sb[ j + 6 ] ] continue
            px : f32 [ sa[ i ] ]
            py : f32 [ sa[ i + 1 ] ]
            rx : f32 [ sa[ i + 4 ] - px ]
            ry : f32 [ sa[ i + 5 ] - py ]
            qx : f32 [ sb[ j ] ]
            qy : f32 [ sb[ j + 1 ] ]
            vx : f32 [ sb[ j + 4 ] - qx ]
            vy : f32 [ sb[ j + 5 ] - qy ]
            cr : f32 [ rx * vy - ry * vx ]
            if [ abs[ cr ] < 1e-12 ] continue
            s : f32 [ ((qx - px) * vy - (qy - py) * vx) / cr ]
            w : f32 [ ((qx - px) * ry - (qy - py) * rx) / cr ]
            if [ s < 0.0 || s > 1.0 || w < 0.0 || w > 1.0 ] continue
            # the crossing latest along a
            along : f32 [ sa[ i + 2 ] + sa[ i + 3 ]
                          + s * (sa[ i + 7 ] - sa[ i + 3 ]) ]
            if [ along > best ]
                best = along
                ia = i32[ sa[ i + 2 ] ]
                ta = sa[ i + 3 ] + s * (sa[ i + 7 ] - sa[ i + 3 ])
                ib = i32[ sb[ j + 2 ] ]
                tb = sb[ j + 3 ] + w * (sb[ j + 7 ] - sb[ j + 3 ])
    if [ best < 0.0 ] return false
    keep : vec f32 []
    for [ i: i32 0, i < ia * 8, i += 1 ]
        keep.push[ a.p[ i ] ]
    push_cubic[ keep, bz_cut[ a.p, ia * 8, ta, true ] ]
    a.p = keep
    rest : vec f32 []
    push_cubic[ rest, bz_cut[ b.p, ib * 8, tb, false ] ]
    for [ i: i32 (ib + 1) * 8, i < b.p.count, i += 1 ]
        rest.push[ b.p[ i ] ]
    b.p = rest
    # one point where they meet
    b.p[ 0 ] = a.p[ a.p.count - 2 ]
    b.p[ 1 ] = a.p[ a.p.count - 1 ]
    return true

# two offsets joined at the corner v: a round join where they
# part, cut where they cross, joined on where they already meet
func join [ a: Pieces, b: Pieces, vx: f32, vy: f32, ds: f32,
            turn: f32, tol: f32 ]
    if [ a.p.count < 8 || b.p.count < 8 ] return
    ex : f32 [ a.p[ a.p.count - 2 ] ]
    ey : f32 [ a.p[ a.p.count - 1 ] ]
    gx : f32 [ b.p[ 0 ] - ex ]
    gy : f32 [ b.p[ 1 ] - ey ]
    if [ gx * gx + gy * gy < tol * tol ]
        b.p[ 0 ] = ex
        b.p[ 1 ] = ey
        return
    if [ turn * ds > 0.0 ]
        a0 : f32 [ atan2[ ey - vy, ex - vx ] ]
        a1 : f32 [ atan2[ b.p[ 1 ] - vy, b.p[ 0 ] - vx ] ]
        sweep : f32 [ a1 - a0 ]
        while [ sweep > 3.1415927 ] sweep -= 6.2831853
        while [ sweep < -3.1415927 ] sweep += 6.2831853
        arc_pieces[ vx, vy, abs[ ds ], a0, sweep, a.p ]
        b.p[ 0 ] = a.p[ a.p.count - 2 ]
        b.p[ 1 ] = a.p[ a.p.count - 1 ]
        return
    if [ trim_cross[ a, b ] ] return
    # nearly parallel, barely overlapping: the ends snapped
    # together (a line back would be a stub against the way)
    if [ gx * gx + gy * gy < ds * ds * 0.01 ]
        b.p[ 0 ] = ex
        b.p[ 1 ] = ey
        return
    line_piece[ ex, ey, b.p[ 0 ], b.p[ 1 ], a.p ]

# a run of cubics offset by ds (its right side), joined
func offset_chain [ segs: vec f32, ds: f32, closed: bool,
                    tol: f32 ] -> vec f32
    n : i32 [ segs.count / 8 ]
    parts : vec Pieces []
    for [ i: i32 0, i < n, i += 1 ]
        p : Pieces [ p: vec f32 [] ]
        offset_piece[ segs, i * 8, ds, tol, p.p, 0 ]
        # turned back on itself: a bend tighter than the offset
        o : i32 [ i * 8 ]
        cx : f32 [ segs[ o + 6 ] - segs[ o ] ]
        cy : f32 [ segs[ o + 7 ] - segs[ o + 1 ] ]
        dx : f32 [ p.p[ p.p.count - 2 ] - p.p[ 0 ] ]
        dy : f32 [ p.p[ p.p.count - 1 ] - p.p[ 1 ] ]
        if [ cx * dx + cy * dy < 0.0 && n > 1 ] p.gone = true
        parts.push[ p ]
    kept : vec Pieces []
    ends : vec i32 []
    for [ i: i32 0, i < n, i += 1 ]
        if [ !parts[ i ].gone ]
            kept.push[ parts[ i ] ]
            ends.push[ i ]
    # every bend tighter than the offset: nothing is left
    if [ kept.count == 0 ] return vec f32 []
    m : i32 [ kept.count ]
    last : i32 [ (closed) ? m : m - 1 ]
    for [ j: i32 0, j < last, j += 1 ]
        a : kept[ j ]
        b : kept[ (j + 1) % m ]
        ia : i32 [ ends[ j ] ]
        ib : i32 [ ends[ (j + 1) % m ] ]
        ta : bz_dir[ segs, ia * 8, 1.0 ]
        tb : bz_dir[ segs, ib * 8, 0.0 ]
        turn : f32 [ ta.x * tb.y - ta.y * tb.x ]
        # a dropped bend between: cut where the two cross
        if [ (ib - ia + n) % n != 1 ] turn = 0.0 - ds
        join[ a, b, segs[ ia * 8 + 6 ], segs[ ia * 8 + 7 ], ds, turn,
              tol ]
    out : vec f32 []
    for [ p: Pieces ] in kept
        push_cubic[ out, p.p ]
    return out

# a run's cubics backwards
func reversed_run [ segs: vec f32 ] -> vec f32
    out : vec f32 []
    n : i32 [ segs.count / 8 ]
    for [ i: i32 n - 1, i >= 0, i -= 1 ]
        o : i32 [ i * 8 ]
        for [ k: i32 3, k >= 0, k -= 1 ]
            out.push[ segs[ o + k * 2 ] ]
            out.push[ segs[ o + k * 2 + 1 ] ]
    return out

# a run's cubics as commands: a move, then cubics
func emit_run [ run: vec f32, closed: bool, out: vec SVGCmd ]
    if [ run.count < 8 ] return
    out.push[ SVGCmd [ op: SVGOp.move, x: run[ 0 ], y: run[ 1 ] ] ]
    for [ o: i32 0, o + 8 <= run.count, o += 8 ]
        out.push[ SVGCmd [ op: SVGOp.cubic, x1: run[ o + 2 ],
            y1: run[ o + 3 ], x2: run[ o + 4 ], y2: run[ o + 5 ],
            x: run[ o + 6 ], y: run[ o + 7 ] ] ]
    if [ closed ] out.push[ SVGCmd [ op: SVGOp.close ] ]

# a subpath's offset: a closed one outward by d (inward when d
# is negative); an open one outlined both sides, ends rounded
func offset_run [ segs: vec f32, closed: bool, d: f32,
                  out: vec SVGCmd ]
    if [ segs.count < 8 ] return
    lo_x : f32 [ segs[ 0 ] ]
    hi_x : f32 [ segs[ 0 ] ]
    lo_y : f32 [ segs[ 1 ] ]
    hi_y : f32 [ segs[ 1 ] ]
    area : f32 [ 0.0 ]
    count : i32 [ segs.count / 2 ]
    for [ i: i32 0, i < count, i += 1 ]
        x : f32 [ segs[ i * 2 ] ]
        y : f32 [ segs[ i * 2 + 1 ] ]
        lo_x = min[ lo_x, x ]
        hi_x = max[ hi_x, x ]
        lo_y = min[ lo_y, y ]
        hi_y = max[ hi_y, y ]
        k : i32 [ (i + 1) % count ]
        area += x * segs[ k * 2 + 1 ] - segs[ k * 2 ] * y
    size : f32 [ sqrt[ (hi_x - lo_x) * (hi_x - lo_x)
                       + (hi_y - lo_y) * (hi_y - lo_y) ] ]
    tol : f32 [ max[ (size + abs[ d ]) * 0.0005, 1e-5 ] ]
    if [ closed ]
        # the right side is outward when the run goes clockwise
        ds : f32 [ (area > 0.0) ? d : 0.0 - d ]
        emit_run[ offset_chain[ segs, ds, true, tol ], true, out ]
        return
    r : f32 [ abs[ d ] ]
    there : offset_chain[ segs, r, false, tol ]
    back : reversed_run[ segs ]
    again : offset_chain[ back, r, false, tol ]
    if [ there.count < 8 || again.count < 8 ] return
    whole : vec f32 []
    push_cubic[ whole, there ]
    # the far end's cap, then back along the other side
    n : i32 [ segs.count ]
    cap_end[ segs[ n - 2 ], segs[ n - 1 ],
             bz_dir[ segs, n - 8, 1.0 ], r, whole,
             again[ 0 ], again[ 1 ] ]
    push_cubic[ whole, again ]
    cap_end[ segs[ 0 ], segs[ 1 ],
             vec2f [ 0.0 - bz_dir[ segs, 0, 0.0 ].x,
                     0.0 - bz_dir[ segs, 0, 0.0 ].y ],
             r, whole, there[ 0 ], there[ 1 ] ]
    emit_run[ whole, true, out ]

# a round end: from the run's last point round the end at
# (cx, cy), facing on, to (tx, ty)
func cap_end [ cx: f32, cy: f32, on: vec2f, r: f32, run: vec f32,
               tx: f32, ty: f32 ]
    ex : f32 [ run[ run.count - 2 ] ]
    ey : f32 [ run[ run.count - 1 ] ]
    a0 : f32 [ atan2[ ey - cy, ex - cx ] ]
    sweep : f32 [ 3.1415927 ]
    mid : f32 [ a0 + sweep * 0.5 ]
    if [ cos[ mid ] * on.x + sin[ mid ] * on.y < 0.0 ]
        sweep = 0.0 - sweep
    arc_pieces[ cx, cy, r, a0, sweep, run ]
    run[ run.count - 2 ] = tx
    run[ run.count - 1 ] = ty

# a cubic added to a run unless it has no length
func add_seg [ segs: vec f32, k: vec f32 ]
    span : f32 [ abs[ k[ 6 ] - k[ 0 ] ] + abs[ k[ 7 ] - k[ 1 ] ]
                 + abs[ k[ 2 ] - k[ 0 ] ] + abs[ k[ 3 ] - k[ 1 ] ]
                 + abs[ k[ 4 ] - k[ 0 ] ] + abs[ k[ 5 ] - k[ 1 ] ] ]
    if [ span < 1e-9 ] return
    push_cubic[ segs, k ]

# a subpath's cubics, and whether it closes
class Run
    public segs   : vec f32
    public closed : bool

# a run's outline as a polygon, eight points a cubic
func run_poly [ segs: vec f32 ] -> vec f32
    out : vec f32 []
    for [ o: i32 0, o + 8 <= segs.count, o += 8 ]
        for [ s: i32 0, s < 8, s += 1 ]
            at : bz_at[ segs, o, f32[ s ] / 8.0 ]
            out.push[ at.x ]
            out.push[ at.y ]
    return out

# a point inside a polygon (even-odd)
func poly_holds [ poly: vec f32, x: f32, y: f32 ] -> bool
    inside : bool [ false ]
    n : i32 [ poly.count / 2 ]
    for [ i: i32 0, i < n, i += 1 ]
        k : i32 [ (i + 1) % n ]
        ax : f32 [ poly[ i * 2 ] ]
        ay : f32 [ poly[ i * 2 + 1 ] ]
        bx : f32 [ poly[ k * 2 ] ]
        by : f32 [ poly[ k * 2 + 1 ] ]
        if [ (ay > y) != (by > y) ]
            cx : f32 [ ax + (y - ay) * (bx - ax) / (by - ay) ]
            if [ x < cx ] inside = !inside
    return inside

# a shape's commands offset by d: each subpath as cubics; a
# subpath inside an odd number of others is a hole, offset the
# other way (into the filled part, as even-odd fills it)
func offset_cmds [ cmds: vec SVGCmd, d: f32 ] -> vec SVGCmd
    runs : runs_of[ cmds ]
    # how deep each closed run sits among the others
    polys : vec Run []
    for [ r: Run ] in runs
        polys.push[ Run [ segs: run_poly[ r.segs ], closed: r.closed ] ]
    out : vec SVGCmd []
    for [ i: i32 0, i < runs.count, i += 1 ]
        r : runs[ i ]
        depth : i32 [ 0 ]
        if [ r.closed ]
            x : f32 [ r.segs[ 0 ] ]
            y : f32 [ r.segs[ 1 ] ]
            for [ k: i32 0, k < runs.count, k += 1 ]
                if [ k == i || !runs[ k ].closed ] continue
                if [ poly_holds[ polys[ k ].segs, x, y ] ] depth += 1
        hole : bool [ depth % 2 == 1 ]
        offset_run[ r.segs, r.closed, (hole) ? 0.0 - d : d, out ]
    return out

# a shape's commands as runs of cubics, a subpath each
func runs_of [ cmds: vec SVGCmd ] -> vec Run
    runs : vec Run []
    segs : vec f32 []
    sx : f32 [ 0.0 ]
    sy : f32 [ 0.0 ]
    px : f32 [ 0.0 ]
    py : f32 [ 0.0 ]
    for [ c: SVGCmd ] in cmds
        if [ c.op == SVGOp.move ]
            if [ segs.count >= 8 ]
                runs.push[ Run [ segs: segs, closed: false ] ]
            segs = vec f32 []
            sx = c.x
            sy = c.y
        el [ c.op == SVGOp.line ]
            add_seg[ segs, vec f32 [] [ px, py,
                px + (c.x - px) / 3.0, py + (c.y - py) / 3.0,
                px + (c.x - px) * 2.0 / 3.0,
                py + (c.y - py) * 2.0 / 3.0, c.x, c.y ] ]
        el [ c.op == SVGOp.quad ]
            add_seg[ segs, vec f32 [] [ px, py,
                px + (c.x1 - px) * 2.0 / 3.0,
                py + (c.y1 - py) * 2.0 / 3.0,
                c.x + (c.x1 - c.x) * 2.0 / 3.0,
                c.y + (c.y1 - c.y) * 2.0 / 3.0, c.x, c.y ] ]
        el [ c.op == SVGOp.cubic ]
            add_seg[ segs, vec f32 [] [ px, py, c.x1, c.y1, c.x2,
                                        c.y2, c.x, c.y ] ]
        el [ c.op == SVGOp.close ]
            add_seg[ segs, vec f32 [] [ px, py,
                px + (sx - px) / 3.0, py + (sy - py) / 3.0,
                px + (sx - px) * 2.0 / 3.0,
                py + (sy - py) * 2.0 / 3.0, sx, sy ] ]
            if [ segs.count >= 8 ]
                runs.push[ Run [ segs: segs, closed: true ] ]
            segs = vec f32 []
            px = sx
            py = sy
            continue
        px = c.x
        py = c.y
    if [ segs.count >= 8 ]
        runs.push[ Run [ segs: segs, closed: false ] ]
    return runs
