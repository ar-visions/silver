# what is chosen, the edits held for a save, and the .agi writer
extend aeon

# what is chosen: an object (and one of its nodes), or a pass
class Selection
    public object : string
    public node   : string
    public pass   : string
    # quad draws switched off, as 'pass/draw'
    public off    : vec string
    # an object shown alone (a double-click) until the choice
    # changes; no eye changes with it
    public solo   : string

    func is_off [ key: string ] -> bool
        if [ !off ] return false
        for [ k: string ] in off
            if [ k.compare[ key ] == 0 ] return true
        return false

    # a quad draw switched on or off
    func flip [ key: string ]
        if [ !off ] off = vec string []
        for [ i: i32 0, i < off.count, i += 1 ]
            if [ off[ i ].compare[ key ] == 0 ]
                off.remove[ i ]
                return
        off.push[ key ]

# one value waiting for a save, for a nested block of an .agi
class Write
    public file   : path
    public blocks : vec string
    public key    : string
    public value  : string

# what is changed in memory and not yet saved (ctrl/cmd + s)
class Edits
    # objects whose cage moved, objects whose place moved
    public cages  : vec string
    public places : vec string
    public writes : vec Write
    # blocks to delete, by file and path (a removed object or step)
    public drops  : vec Write
    # blocks to add, each after its sibling's block (blocks), its
    # key and text (an added step)
    public adds   : vec Write

    func init []
        cages  = vec string []
        places = vec string []
        writes = vec Write []
        drops  = vec Write []
        adds   = vec Write []

    func mark [ list: vec string, name: string ]
        for [ nm: string ] in list
            if [ nm.compare[ name ] == 0 ] return
        list.push[ name ]

    # a value to write: a later one for the same place replaces it
    func queue [ w: Write ]
        for [ i: i32 0, i < writes.count, i += 1 ]
            o : writes[ i ]
            same : bool [ '{o.file}' == '{w.file}'
                && o.key.compare[ w.key ] == 0
                && o.blocks.count == w.blocks.count ]
            if [ same ]
                for [ k: i32 0, k < o.blocks.count, k += 1 ]
                    if [ o.blocks[ k ].compare[ w.blocks[ k ] ] != 0 ]
                        same = false
            if [ same ]
                writes[ i ] = w
                return
        writes.push[ w ]

    func pending [] -> bool
        return cages.count + places.count + writes.count
            + drops.count + adds.count > 0

    func clear []
        cages.clear[]
        places.clear[]
        writes.clear[]
        drops.clear[]
        adds.clear[]

    # an addition undone: its block is no longer added
    func unadd [ key: string ]
        for [ i: i32 0, i < adds.count, i += 1 ]
            if [ adds[ i ].key.compare[ key ] == 0 ]
                adds.remove[ i ]
                return

    # a removal undone: its block is no longer deleted
    func undrop [ file: path, blocks: vec string ]
        for [ i: i32 0, i < drops.count, i += 1 ]
            d : drops[ i ]
            if [ '{d.file}' != '{file}'
                 || d.blocks.count != blocks.count ] continue
            same : bool [ true ]
            for [ k: i32 0, k < blocks.count, k += 1 ]
                if [ d.blocks[ k ].compare[ blocks[ k ] ] != 0 ]
                    same = false
            if [ same ]
                drops.remove[ i ]
                return

# one value written into a nested block of an .agi file: the
# blocks by their keys, then the key's line (added if absent)
func agi_set [ file: path, blocks: vec string, key: string,
               value: string ] -> bool
    if [ !file.exists[] ] return false
    txt : string [ file.load[ typeid[ string ], null ] ]
    lines : txt.split[ '\n' ]
    out : ''
    depth : i32 [ 0 ]
    done : bool [ false ]
    for [ i: i32 0, i < lines.count, i += 1 ]
        ln : lines[ i ]
        if [ i == lines.count - 1 && ln.count == 0 ] continue
        tabs : i32 [ 0 ]
        while [ tabs < ln.count && ln.chars[ tabs ] == 9 ]
            tabs += 1
        word : ln.mid[ tabs, ln.count - tabs ]
        # a line at or above the open block's depth closes it
        if [ !done && depth > 0 && tabs < depth
             && ln.count > 0 && depth == blocks.count ]
            out = '{out}{tabs_of[ depth ]}{key}: {value}\n'
            done = true
        if [ !done && tabs < depth && ln.count > 0 ] depth = tabs
        if [ !done && depth < blocks.count && tabs == depth
             && (word.starts_with[ '{blocks[ depth ]}:' ]) ]
            depth += 1
            out = '{out}{ln}\n'
            continue
        if [ !done && depth == blocks.count && tabs == depth
             && word.starts_with[ '{key}:' ] ]
            out = '{out}{tabs_of[ depth ]}{key}: {value}\n'
            done = true
            continue
        out = '{out}{ln}\n'
    if [ !done && depth == blocks.count ]
        out = '{out}{tabs_of[ depth ]}{key}: {value}\n'
        done = true
    if [ !done ] return false
    f : handle [ fopen[ file, "w" ] ]
    if [ !f ] return false
    fputs[ out.chars, f ]
    fclose[ f ]
    return true

# a nested block of an .agi deleted: its key's line and every
# line indented under it
func agi_drop [ file: path, blocks: vec string ] -> bool
    if [ !file.exists[] || blocks.count == 0 ] return false
    txt : string [ file.load[ typeid[ string ], null ] ]
    lines : txt.split[ '\n' ]
    out : ''
    depth : i32 [ 0 ]
    cut : i32 [ -1 ]
    done : bool [ false ]
    for [ i: i32 0, i < lines.count, i += 1 ]
        ln : lines[ i ]
        if [ i == lines.count - 1 && ln.count == 0 ] continue
        tabs : i32 [ 0 ]
        while [ tabs < ln.count && ln.chars[ tabs ] == 9 ]
            tabs += 1
        # inside the block: deeper lines (and blank ones) go
        if [ cut >= 0 ]
            if [ ln.count == 0 || tabs > cut ] continue
            cut  = -1
            done = true
        word : ln.mid[ tabs, ln.count - tabs ]
        if [ !done && tabs < depth && ln.count > 0 ] depth = tabs
        if [ !done && tabs == depth && depth < blocks.count
             && word.starts_with[ '{blocks[ depth ]}:' ] ]
            if [ depth == blocks.count - 1 ]
                cut = tabs
                continue
            depth += 1
        out = '{out}{ln}\n'
    if [ cut >= 0 ] done = true
    if [ !done ] return false
    f : handle [ fopen[ file, "w" ] ]
    if [ !f ] return false
    fputs[ out.chars, f ]
    fclose[ f ]
    return true

# a block written into an .agi after a sibling's block (blocks:
# the sibling's path); text is the block, already indented
func agi_insert_after [ file: path, blocks: vec string,
                        text: string ] -> bool
    if [ !file.exists[] || blocks.count == 0 ] return false
    txt : string [ file.load[ typeid[ string ], null ] ]
    lines : txt.split[ '\n' ]
    out : ''
    depth : i32 [ 0 ]
    sib : i32 [ -1 ]
    done : bool [ false ]
    for [ i: i32 0, i < lines.count, i += 1 ]
        ln : lines[ i ]
        if [ i == lines.count - 1 && ln.count == 0 ] continue
        tabs : i32 [ 0 ]
        while [ tabs < ln.count && ln.chars[ tabs ] == 9 ]
            tabs += 1
        # the sibling's block ends at a line no deeper than its key
        if [ sib >= 0 && ln.count > 0 && tabs <= sib ]
            out  = '{out}{text}'
            sib  = -1
            done = true
        word : ln.mid[ tabs, ln.count - tabs ]
        if [ !done && sib < 0 && tabs < depth && ln.count > 0 ]
            depth = tabs
        if [ !done && sib < 0 && tabs == depth
             && depth < blocks.count
             && word.starts_with[ '{blocks[ depth ]}:' ] ]
            if [ depth == blocks.count - 1 ]
                sib = tabs
            el
                depth += 1
        out = '{out}{ln}\n'
    if [ sib >= 0 ]
        out  = '{out}{text}'
        done = true
    if [ !done ] return false
    f : handle [ fopen[ file, "w" ] ]
    if [ !f ] return false
    fputs[ out.chars, f ]
    fclose[ f ]
    return true

func tabs_of [ n: i32 ] -> string
    out : ''
    for [ i: i32 0, i < n, i += 1 ]
        out = '{out}\t'
    return out
