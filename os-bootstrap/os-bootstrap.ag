#
# the drive's nvidia files come from nvidia's installer alone
expect func t_nvidia_files [] -> bool
    b : Bootstrap []
    b.initialize[]
    return b.nvidia_check[ '7.2.11-nvidia610.57.04-noamd-nointel' ]

# the whole drive tree: nothing from the computer's own system
expect func t_tree_sources [] -> bool
    b : Bootstrap []
    b.initialize[]
    return b.tree_check[]
