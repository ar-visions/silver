# os-bootstrap — assembles orbiter-os (linux + orbiter as init) for the drive
export 1.0.0

# these four are build-only ARTIFACTS: mcopy/mformat are run as
# programs and mesa/libdrm/spirv are files bundled into the image.
# nothing here links them, so gating them leaves every function
# this module exports -- which is what the installer calls
ifndef [ windows ]
    # the x86 drive's; a phone build takes its own (arm64)
    ifdef [ x86_64 ]
        # FAT without root: the installer stick's EFI partition image
        import mtools/4.0.48 from https://ftp.gnu.org/gnu/mtools/mtools-4.0.48.tar.gz
            --disable-floppyd

        # radv and anv need a newer libdrm than the system's
        import libdrm/2.4.134 from https://dri.freedesktop.org/libdrm/libdrm-2.4.134.tar.xz
            PKG_CONFIG_PATH={install}/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig
            PYTHONPATH={install}/pylib
            PATH={install}/pylib/bin:{install}/bin:/usr/bin:/bin
            -Damdgpu=enabled
            -Dintel=enabled
            -Dradeon=disabled
            -Dnouveau=disabled
            -Dvmwgfx=disabled
            -Dcairo-tests=disabled
            -Dvalgrind=disabled
            -Dman-pages=disabled
            -Dtests=false

        # anv's built-in GPU programs: SPIR-V from OpenCL C (the
        # translator, then libclc from our LLVM's own source)
        import KhronosGroup:SPIRV-LLVM-Translator/8e829705b660a4c3a1fcd97885c35b8d78941276
            -DLLVM_DIR={install}/lib/cmake/llvm
            -DLLVM_SPIRV_INCLUDE_TESTS=OFF
            -DCMAKE_INSTALL_RPATH={install}/lib
            -DCMAKE_BUILD_TYPE=Release
            >> test -f {install}/share/pkgconfig/libclc.pc || cmake -S {root_path}/checkout/LLVM/llvm-project/libclc -B {install}/build/libclc -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX={install} -DLLVM_DIR={install}/lib/cmake/llvm -DLIBCLC_CUSTOM_LLVM_TOOLS_BINARY_DIR={install}/bin -DLIBCLC_TARGETS_TO_BUILD=spirv64-mesa3d-
            >> test -f {install}/share/pkgconfig/libclc.pc || cmake --build {install}/build/libclc
            >> test -f {install}/share/pkgconfig/libclc.pc || cmake --install {install}/build/libclc

        # Vulkan drivers: venus (qemu guests), radv (amd), anv (intel)
        import mesa/mesa-26.2.2 from https://gitlab.freedesktop.org/mesa/mesa
            PKG_CONFIG_PATH={install}/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig
            PYTHONPATH={install}/pylib
            PATH={install}/pylib/bin:{install}/bin:/usr/bin:/bin
            LDFLAGS=-Wl,-rpath,{install}/lib
            > {install}/bin/python3 -m pip install --quiet --target {install}/pylib mako pyyaml meson
            -Dvulkan-drivers=virtio,amd,intel
            -Dintel-rt=disabled
            -Damd-use-llvm=false
            -Dgallium-drivers=
            -Dplatforms=
            -Dglx=disabled
            -Degl=disabled
            -Dgbm=disabled
            -Dllvm=enabled
            -Dshared-llvm=enabled
            -Dvideo-codecs=

# the phone's own compiler: silver on orbiter-os builds for its arch,
# so the board gets LLVM, clang, lld and lldb at our commit (aether's)
ifdef [ linux ]
    ifdef [ arm64 ]
        import LLVM:llvm-project/bd7db754895ed3b51388ec549cd656c770c17587
            -S {root_path}/checkout/LLVM/llvm-project/llvm
            "-DLLVM_ENABLE_PROJECTS=clang;lld;lldb"
            -DLLVM_TARGETS_TO_BUILD=AArch64
            -DLLVM_HOST_TRIPLE=aarch64-linux-gnu
            -DLLVM_NATIVE_TOOL_DIR={root_path}/platform/native/bin
            "-DCROSS_TOOLCHAIN_FLAGS_NATIVE=-DCMAKE_C_COMPILER={root_path}/platform/native/bin/clang;-DCMAKE_CXX_COMPILER={root_path}/platform/native/bin/clang++"
            -DLLVM_BUILD_LLVM_DYLIB=ON
            -DLLVM_LINK_LLVM_DYLIB=ON
            -DLLVM_ENABLE_RTTI=ON
            -DLLVM_ENABLE_FFI=OFF
            -DLLVM_ENABLE_ZSTD=OFF
            -DLLVM_ENABLE_LIBXML2=OFF
            -DLLVM_INCLUDE_TESTS=OFF
            -DLLVM_INCLUDE_EXAMPLES=OFF
            -DLLVM_INCLUDE_BENCHMARKS=OFF
            -DLLDB_ENABLE_PYTHON=OFF
            -DLLDB_ENABLE_LIBEDIT=OFF
            -DLLDB_ENABLE_CURSES=OFF
            -DLLDB_ENABLE_LZMA=OFF
            -DLLDB_INCLUDE_TESTS=OFF
            -DCLANG_DEFAULT_CXX_STDLIB=libstdc++
            -DCLANG_DEFAULT_PIE_ON_LINUX=ON
            -DCMAKE_BUILD_TYPE=Release

# the phone's Vulkan: turnip, Mesa's driver for the Adreno (810 in the
# Fairphone 6, known from Mesa 26) over the kernel's msm driver
ifdef [ linux ]
    ifdef [ arm64 ]
        import mesa/mesa-26.2.2 from https://gitlab.freedesktop.org/mesa/mesa
            PYTHONPATH={root_path}/platform/native/pylib
            PATH={root_path}/platform/native/pylib/bin:{root_path}/platform/native/bin:/usr/bin:/bin
            -Dvulkan-drivers=freedreno
            -Dfreedreno-kmds=msm
            -Dgallium-drivers=
            -Dplatforms=
            -Dglx=disabled
            -Degl=disabled
            -Dgbm=disabled
            -Dllvm=disabled
            -Dvideo-codecs=

# EfiFs's UEFI NTFS driver: our boot program reads the kernel from an
# orbiter-os folder on a Windows partition through it
import https://github.com/pbatard/EfiFs/releases/download/v1.13/ntfs_x64.efi
    > mkdir -p {install}/share/silver-os-bootstrap/efifs
    > cp {import_file} {install}/share/silver-os-bootstrap/efifs/ntfs_x64.efi

# a kernel built on a Mac: GNU make, coreutils, sed and find in
# their own folder (first on the kernel's PATH alone), OpenSSL for
# its certificate tool, musl's elf.h for its host programs
ifdef [ apple ]
    import make/4.4.1 from https://ftp.gnu.org/gnu/make/make-4.4.1.tar.gz
        --prefix={install}/kernel-host
        --disable-nls
    import coreutils/9.5 from https://ftp.gnu.org/gnu/coreutils/coreutils-9.5.tar.xz
        --prefix={install}/kernel-host
        --disable-nls
    import sed/4.9 from https://ftp.gnu.org/gnu/sed/sed-4.9.tar.xz
        --prefix={install}/kernel-host
        --disable-nls
    import findutils/4.10.0 from https://ftp.gnu.org/gnu/findutils/findutils-4.10.0.tar.xz
        --prefix={install}/kernel-host
        --disable-nls
    import openssl/3.5.4 from https://github.com/openssl/openssl/releases/download/openssl-3.5.4/openssl-3.5.4.tar.gz
        > ./Configure --prefix={install}/kernel-host no-tests no-docs
        > make -j8
        > make install_sw
    import https://raw.githubusercontent.com/kraj/musl/v1.2.5/include/elf.h
        > mkdir -p {install}/kernel-host/include
        > cp {import_file} {install}/kernel-host/include/elf.h
    # the installer stick: its FAT (the x86 line) and its ext4
    import mtools/4.0.48 from https://ftp.gnu.org/gnu/mtools/mtools-4.0.48.tar.gz
        --disable-floppyd
    import e2fsprogs/1.47.1 from https://mirrors.edge.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v1.47.1/e2fsprogs-1.47.1.tar.xz
        --prefix={install}/kernel-host
        --disable-nls
        --disable-fuse2fs
        --disable-e2initrd-helper

# the same lines as img's and wine's: one key for the shared build
import madler:zlib/51b7f2abdade71cd9bb0e7a373ef2610ec6f9daf <zlib.h>
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
    -lz
import vec
import img
import trinity
# fastboot is the phone flasher over libusb. phone_look and
# phone_install are its only callers, and both are gated below:
# the usb stick and disk paths never touch it
ifndef [ windows ]
    import fastboot
import <stdio.h>
import <stdlib.h>
import <string.h>
# posix.h carries unistd, pthread, utime and statvfs here
ifdef [ windows ]
    import <posix.h>
ifndef [ windows ]
    import <unistd.h>
    import <sys/statvfs.h>
    import <utime.h>
    import <pthread.h>
import <time.h>
import <sys/stat.h>
import <fcntl.h>
import <signal.h>
import <disk_gpt.h>
import Base

# one entry of the guest file system
class OsFile
    public src  : string       # host file to copy; empty for dir, link, device
    public dst  : string       # guest path, no leading slash
    public link : string       # symlink target
    public dir  : bool
    public dev  : bool         # the console character device

# silver's folder: the first above the install holding our own
# source (platform/native or install), else where we started
func silver_root [] -> path
    up : path.path_install[]
    for [ i: i32 0, i < 4, i += 1 ]
        up = path '{up}/..'
        src : path '{up}/os-bootstrap/os-bootstrap.ag'
        if [ src.exists[] ] return up.absolute[]
    return path.path_startup[]

# building is for a linux system with silver's source; booted
# into orbiter-os there is nothing to bootstrap from
func bootstrap_here [] -> bool
    fh : handle fopen[ '/proc/cmdline', 'r' ]
    b : local i8 [ 4096 ]
    cmd : string ''
    if [ fh && fgets[ @b[0], 4096, fh ] ] cmd = string [ @b[0] ]
    if [ fh ] fclose[ fh ]
    if [ cmd.index_of[ 'orbiter.init=' ] >= 0 ] return false
    root : silver_root[]
    src : path '{root}/os-bootstrap/os-bootstrap.ag'
    return src.exists[]

# where os-bootstrap writes orbiter-os: the drive tree's folder
func tree_home [] -> string
    return '{silver_root[]}/orbiter-os'

# an answers file's 'key: value' (its brackets and quotes kept)
func answer_word [ f: string, key: string ] -> string
    fp : path [ f ]
    tx : string fp.load[ typeid[ string ], null ]
    if [ !tx ] return ''
    for [ ln: string ] in tx.split[ '\n' ]
        t : string ln.trim[]
        if [ t.starts_with[ '{key}:' ] ]
            return t.mid[ key.count + 1, t.count - key.count - 1 ].trim[]
    return ''

# its 'key: [ a, b ]' as names
func answer_list [ f: string, key: string ] -> vec string
    out : vec string []
    w : string answer_word[ f, key ]
    for [ p: string ] in w.split[ ',' ]
        n : string p.trim[]
        while [ n.starts_with[ '[' ] ] n = n.mid[ 1, n.count - 1 ].trim[]
        while [ n.ends_with[ ']' ] ] n = n.mid[ 0, n.count - 1 ].trim[]
        if [ n.count > 0 ] out.push[ n ]
    return out

func drive_tree [] -> string
    return '{tree_home[]}/root'

# orbiter-os's own boot words, after its uuid and root: its
# init, the drivers it loads, its home and libraries
# the user's ssh folder: keys, known hosts, config
# the user's home on this computer
func home_dir [] -> string
    hc : cstr [ getenv[ "HOME" ] ]
    if [ hc == null ] return ''
    return string[ hc ]

func ssh_dir [] -> string
    h : home_dir[]
    if [ h.count == 0 ] return ''
    return '{h}/.ssh'

# the keys there: each private file beside its .pub
func ssh_keys [] -> i32
    d : path [ ssh_dir[] ]
    if [ !d.is_dir[] ] return 0
    n : i32 [ 0 ]
    for [ f: path ] in d.ls[ null, false ]
        nm : f.filename[]
        if [ nm.ends_with[ '.pub' ] ]
            pk : path '{d}/{nm.mid[ 0, nm.count - 4 ]}'
            if [ pk.exists[] ] n += 1
    return n

# sh: an ssh folder copied to another, kept private (quoted paths)
func ssh_copy_sh [ from: string, to: string ] -> string
    c : 'mkdir -p {to} && cp -a {from}/. {to}/'
    return '{c} && chmod 700 {to} && chmod -R go-rwx {to}'

# the file types the games apps open (each module's export says its
# section and extensions: knes '.nes', psx '.cue' ...)
func game_exts [] -> vec string
    out : vec string []
    d : path '{silver_root[]}/install/export'
    entries : d.ls[ null, false ]
    if [ !entries ] return out
    for [ e: path ] in entries
        ax : e.ext[]
        if [ !ax || !(ax == 'agi') ] continue
        t : string e.load[ typeid[string], null ]
        if [ !t ] continue
        sx : i32 [ t.index_of[ 'software:' ] ]
        ix : i32 [ t.index_of[ 'extensions:' ] ]
        if [ sx < 0 || ix < 0 ] continue
        sl : t.mid[ sx, t.count - sx ]
        sl = sl.mid[ 0, sl.index_of[ "]" ] ]
        if [ sl.index_of[ 'games' ] < 0 ] continue
        xl : t.mid[ ix, t.count - ix ]
        xl = xl.mid[ 0, xl.index_of[ "]" ] ]
        # the quoted words: every other piece between quotes
        parts : xl.split[ "'" ]
        for [ i: i32 1, i < parts.count, i += 2 ]
            if [ parts[ i ].starts_with[ "." ] ] out.push[ parts[ i ] ]
    return out

# the user's games: in their home folder, two folders down (not the
# hidden ones), each file a games app opens, with what goes with it:
# the files named as it is (its saves, a disc's tracks) and those a
# cue sheet lists; as paths under the home
func game_files [] -> vec string
    out : vec string []
    hc : cstr [ getenv[ "HOME" ] ]
    exts : vec string game_exts[]
    if [ hc == null || exts.count == 0 ] return out
    home : string [ hc ]
    found : map bool [ string ] []
    game_walk[ path [ home ], home, exts, out, found, 2 ]
    return out

func game_walk [ d: path, home: string, exts: vec string,
                 out: vec string, found: map bool [ string ],
                 depth: i32 ]
    entries : d.ls[ null, false ]
    if [ !entries ] return
    for [ e: path ] in entries
        nm : string e.filename[]
        if [ nm.starts_with[ "." ] || e.is_symlink[] ] continue
        if [ e.is_dir[] ]
            if [ depth > 0 ]
                game_walk[ e, home, exts, out, found, depth - 1 ]
            continue
        for [ x: string ] in exts
            if [ nm.ends_with[ x ] ]
                game_with[ d, nm, home, entries, out, found ]
                break

# a game file and what goes with it, once each
func game_with [ d: path, nm: string, home: string,
                 entries: vec path, out: vec string,
                 found: map bool [ string ] ]
    dot : i32 [ nm.rindex_of[ "." ] ]
    stem : string [ (dot > 0) ? nm.mid[ 0, dot ] : nm ]
    for [ e: path ] in entries
        if [ e.is_dir[] ] continue
        if [ e.filename[].starts_with[ stem ] ]
            game_keep[ '{e}', home, out, found ]
    if [ !nm.ends_with[ '.cue' ] ] return
    cue : path '{d}/{nm}'
    t : string cue.load[ typeid[string], null ]
    if [ !t ] return
    # FILE "Track 1.bin" BINARY
    for [ ln: string ] in t.split[ '\n' ]
        q : i32 [ ln.index_of[ "\"" ] ]
        if [ !ln.trim[].starts_with[ 'FILE' ] || q < 0 ] continue
        rest : ln.mid[ q + 1, ln.count - q - 1 ]
        e2 : i32 [ rest.index_of[ "\"" ] ]
        if [ e2 <= 0 ] continue
        tk : rest.mid[ 0, e2 ]
        game_keep[ '{d}/{tk}', home, out, found ]

func game_keep [ f: string, home: string, out: vec string,
                 found: map bool [ string ] ]
    if [ !f.starts_with[ '{home}/' ] || found.contains[ f ] ] return
    p : path [ f ]
    if [ !p.exists[] ] return
    found[ f ] = true
    out.push[ f.mid[ home.count + 1, f.count - home.count - 1 ] ]

func os_words [ arm: bool, nvidia: bool ] -> string
    root : silver_root[]
    line : 'orbiter.init={root}/install/build/orbiter'
    if [ nvidia ] line = '{line} orbiter.modules=nvidia-drm:modeset=1'
    # nothing printed on the screen at boot, no cursor
    line = '{line} quiet loglevel=0 vt.global_cursor_default=0'
    lib : '{root}/install/lib:{root}/install/build'
    # claude and others open links only with BROWSER set
    line = '{line} HOME=/root BROWSER=/usr/bin/xdg-open'
    # the kernel gives init no PATH; claude is in /usr/local/bin
    line = '{line} PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin'
    # claude and the console start the user's shell from it
    line = '{line} SHELL=/bin/bash'
    line = '{line} LD_LIBRARY_PATH={lib}'
    gnu : string [ (arm) ? 'aarch64' : 'x86_64' ]
    return '{line}:/usr/lib/{gnu}-linux-gnu'

# one line of the summary: what, its state, and a word on it
class Built
    public what : string [ '' ]
    public ok   : bool
    public note : string [ '' ]

element BootText
    public face : Layer [ label_color: rgba [ '#e4e4ea' ], label_size: 17,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
        label_align: vec2f [ x: 0.0, y: 0.5 ] ]

element BootGood
    public face : Layer [ label_color: rgba [ '#8fe0a8' ], label_size: 15,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
        label_align: vec2f [ x: 0.0, y: 0.5 ] ]

element BootBad
    public face : Layer [ label_color: rgba [ '#ff9a8a' ], label_size: 15,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
        label_align: vec2f [ x: 0.0, y: 0.5 ] ]

element BootLog
    no_cache : true
    public face : Layer [ label_color: rgba [ '#c8c8d0' ], label_size: 14,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
        label_align: vec2f [ x: 0.0, y: 0.5 ] ]

# the system menu's look (RoundTab): a pill lit by the near light
Button BootButton
    style : CSS {
        layers.body:
            fill_color: #ffffff0a
            radius: 999
            stroke_width: 1
            # 1/255: unseen at rest, yet the near light lights it
            stroke_color: #ffffff01
            box_shadow: inset 0 0 13px #8af2
            near_border: true
            near_reach: 0.5
            near_inset: 4.0
            near_inset_color: #c890ffff
        layers.face:
            label_color: #f2f2f6
            label_size: 15
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.5 0.5
        :hovered
            layers.body:
                fill_color: #ffffff18
                near_inset: 6.0
    }

# a list in a framed box: the header, then rows that scroll
element ListBox
    # the panel's own look: the high blur under, an inner glow
    public frame : Layer [ fill_color: rgba [ '#140a2a66' ], stroke_width: 0.0,
        radius: Radius [ '8' ], background_lens: BlurStage.frost,
        box_shadow: BoxShadow [ 'inset 0 0 6px #0000005f curve 2' ] ]

# the column names, above the rows; never scrolls
element ListHead
    public rule : Layer [ fill_color: rgba [ '#ffffff1f' ],
                   area: Region { l0 b0 r0 h0.04 } ]

# the rows, scrolled within the box
element ListRows
    focusable : true
    scrollbar : ScrollLayer [ overlay: true,
        area: Region { l0 t0 r0 b0 }, thumb_color: '#fff3',
        thumb_w: 6.0, thumb_min_h: 32.0, thumb_radius: 4.0 ]

# a column's text; the row underneath takes the click
element ListCell
    ghost : true
    public face  : Layer [ label_color: rgba [ '#e4e4ea' ], label_size: 16,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
        label_align: vec2f [ x: 0.0, y: 0.5 ] ]

# a cell of a row that cannot be picked
ListCell ListDimCell
    face  : Layer [ label_color: rgba [ '#ffffff48' ], label_size: 16,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
        label_align: vec2f [ x: 0.0, y: 0.5 ] ]

ListCell ListHeadCell
    face  : Layer [ label_color: rgba [ '#ffffff80' ], label_size: 14,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
        label_align: vec2f [ x: 0.0, y: 0.5 ] ]

# one row: the whole row picks it
Button ListRow
    public rule : Layer [ fill_color: rgba [ '#ffffff10' ],
                   area: Region { l0 b0 r0 h0.04 } ]
    style : CSS {
        layers.body:
            fill_color: #0000
            radius: 0
            stroke_width: 0
        :hovered
            layers.body:
                fill_color: #ffffff12
        :selected
            layers.body:
                fill_color: #4d3dbcaa
    }

# a list's cells: names at their left edges (units), as given
func list_cells [ names: vec string, lefts: vec string, head: bool,
                  dim: bool ] -> Elements
    out : Elements []
    for [ i: i32 0, i < names.count, i += 1 ]
        ar : Region [ lefts[ i ] ]
        nm : names[ i ]
        if [ head ] out[ 'c{i}' ] = ListHeadCell [ label: nm, area: ar ]
        el [ dim ] out[ 'c{i}' ] = ListDimCell [ label: nm, area: ar ]
        el out[ 'c{i}' ] = ListCell [ label: nm, area: ar ]
    return out

# one of a few choices: lit when picked
Button Choice
    style : CSS {
        layers.body:
            fill_color: #ffffff0a
            radius: 999
            stroke_width: 1
            # 1/255: unseen at rest, yet the near light lights it
            stroke_color: #ffffff01
            box_shadow: inset 0 0 13px #8af2
            near_border: true
            near_reach: 0.5
            near_inset: 4.0
            near_inset_color: #c890ffff
        layers.face:
            label_color: #e4e4ea
            label_size: 16
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.5 0.5
        :hovered
            layers.body:
                fill_color: #ffffff18
                near_inset: 6.0
        :selected
            layers.body:
                fill_color: #4d3dbcaa
                stroke_color: #806bff
            layers.face:
                label_color: #ffffff
    }

# a drive an installer can go on: a usb stick or a removable one
class UsbDrive
    public name  : string [ '' ]
    public model : string [ '' ]
    public bytes : i64
    public ok    : bool

# one kernel built for the drive: what it is, where it is
class KernelBuild
    public name    : string [ '' ]
    public dir     : string [ '' ]
    public version : string [ '' ]
    public nvidia  : string [ '' ]
    # x64, ARM64, Apple or Surface: the hardware it is built for
    public hardware : string [ 'x64' ]
    # AMD's and Intel's kernel drivers, or none
    public amd     : string [ 'amdgpu' ]
    public intel   : string [ 'i915, xe' ]
    public release : string [ '' ]
    public drivers : i32
    public built   : string [ '' ]

# the drive's builder: the kernels built, the one the drive
# takes, a new one from the choices, and the drive tree
element Bootstrap
    public  app        : string [ 'orbiter' ]          # the guest's init
    public  share_max  : i64    [ 32 * 1024 * 1024 ]   # skip share dirs larger than this
    mutable install    : path
    mutable root       : path
    mutable out_dir    : path
    # the selected kernel: its folder and its bzImage
    mutable kdir       : string
    mutable kernel     : path
    mutable files      : vec OsFile
    mutable seen       : map bool [ string ]
    # folders kept out of the tree (a driver the kernel lacks)
    mutable left       : map bool [ string ]
    # the drive's own system files: the pinned base, never /
    mutable sys        : UbuntuBase
    mutable sysr       : string
    mutable deps_done  : map bool [ string ]
    mutable mapped     : map string [ string ]
    mutable kernels    : vec KernelBuild
    mutable chosen     : string
    # the installer stick's kernel: the chosen one, or an ARM one
    mutable stick      : string
    # the choices for a new kernel
    mutable want_hardware : string
    mutable want_version : string
    # linux-surface's patch series (6.18 ...), read once
    mutable surface_series : vec string
    # the kernel.org release each series' patches fit, read once
    mutable surface_versions : vec string
    # the asahi branch's version (its Makefile), read once
    mutable asahi_version  : string
    mutable fp_version     : string
    # the phone page: what is on USB, said; a check-only install
    mutable phone_word     : string
    mutable phone_ok       : bool
    mutable phone_at       : i64
    # orbiter-os runs on the phone: its shell port is there
    mutable phone_live     : bool
    public phone_dry       : bool
    # the versions offered: kernel.org's list, read once
    mutable releases     : vec string
    mutable want_nvidia  : string
    mutable want_amd     : string
    mutable want_intel   : string
    # the build's thread and what it says, under lock
    mutable lock       : mutex
    mutable lines      : vec string
    mutable building   : bool
    mutable failed     : bool
    # writing an installer: 0..1 through the image, then the copy
    mutable progress   : f32
    mutable image_bytes : i64
    # the image's part of that bar; the copy takes the rest
    intern image_share : f32 [ 0.2 ]
    mutable parts      : vec Built
    # the installer's drive picker, shown by Write installer
    # Cancel Build: the running command's group is stopped
    mutable cancelled  : bool
    mutable usb_view   : bool
    mutable drives     : vec UsbDrive
    mutable want_drive : string
    # the stick carries the user's ssh keys (for its install)
    mutable stick_keys : bool
    # an unattended install's answers (an InstallAnswers .agi) put
    # on the stick: it boots, installs itself, with no screen
    mutable stick_answers : string [ '' ]
    # a server's tree carries these apps alone (null: every app)
    mutable only_apps : vec string
    mutable drives_at  : i64
    intern  tid        : pthread_t
    # the page: '' the kernels, 'build' a new one's choices
    mutable kview      : string [ '' ]
    # the building view shows its log only when asked
    mutable show_log   : bool
    # what the build is doing, in words
    mutable step       : string [ '' ]

    func init []
        setup[]

    # this machine's own line: a Mac on Apple silicon is Apple
    func own_hardware [] -> string
        hw : string [ 'x64' ]
        ifdef [ apple ]
            ifdef [ arm64 ]
                hw = 'Apple'
        return hw

    public func setup []
        install = path.path_install[].normalize[]
        root    = silver_root[]
        out_dir = path [ tree_home[] ]
        if [ !lock ] lock = mutex []
        if [ !lines ] lines = vec string []
        if [ !want_hardware ] want_hardware = own_hardware[]
        if [ !want_version ] want_version = offered[][ 0 ]
        if [ !want_nvidia ] want_nvidia = nvidias[][ 0 ]
        if [ !want_amd ] want_amd = amds[][ 0 ]
        if [ !want_intel ] want_intel = intels[][ 0 ]
        scan[]

    public func can_build [] -> bool
        return bootstrap_here[]

    func share [] -> string
        return '{install}/share/silver-os-bootstrap'

    # the hardware a kernel is built for
    public func hardwares [] -> vec string
        return vec string [] [ 'x64', 'ARM64', 'Apple', 'Surface',
                               'Fairphone 6' ]

    # the kernels the chosen hardware takes: kernel.org's for x64
    # and ARM64, the series linux-surface patches, Asahi's branch
    public func offered [] -> vec string
        if [ want_hardware == 'Fairphone 6' ]
            if [ !fp_version ] fp_version = fairphone_release[]
            return vec string [] [ fp_version ]
        if [ want_hardware == 'Apple' ]
            if [ !asahi_version ] asahi_version = asahi_release[]
            return vec string [] [ asahi_version ]
        if [ want_hardware != 'Surface' ] return versions[]
        if [ !surface_versions ] surface_versions = surface_releases[]
        return surface_versions

    # Surface: for each series kernel.org offers that linux-surface
    # patches, the release its patches are made for (the version
    # in linux-surface's v<series>-surface tree): newer stables
    # moved code the patches touch (btusb's BIT(29) taken twice)
    func surface_releases [] -> vec string
        if [ !surface_series ] surface_series = patch_series[]
        tree : 'https://raw.githubusercontent.com/linux-surface/kernel'
        out : vec string []
        for [ v: string ] in versions[]
            for [ ser: string ] in surface_series
                if [ !v.starts_with[ '{ser}.' ] && v != ser ] continue
                mk : '{tree}/v{ser}-surface/Makefile'
                sv : makefile_version[ mk ]
                if [ sv.count > 0 && out.index_of[ sv ] < 0 ]
                    out.push[ sv ]
        return out

    # Asahi's release line is its asahi branch: its version from
    # the Makefile there; 'asahi' when it cannot be read
    func asahi_release [] -> string
        raw : 'https://raw.githubusercontent.com/AsahiLinux/linux'
        v : makefile_version[ '{raw}/asahi/Makefile' ]
        return (v.count > 0) ? v : 'asahi'

    # a kernel Makefile's version, x.y.z, read from a url; ''
    func makefile_version [ url: string ] -> string
        cmd : 'curl -s --max-time 4 {url}'
        fh_cmd : command [ cmd ]
        fh : handle fh_cmd.stream[]
        b : local i8 [ 256 ]
        parts3 : vec string [] [ '', '', '' ]
        keys : vec string [] [ 'VERSION = ', 'PATCHLEVEL = ',
                               'SUBLEVEL = ' ]
        n : i32 [ 0 ]
        while [ fh && fgets[ @b[0], 256, fh ] && n < 12 ]
            ln0 : string [ @b[0] ]
            ln : ln0.trim[]
            for [ k: i32 0, k < 3, k += 1 ]
                if [ ln.starts_with[ keys[ k ] ] ]
                    kc : i32 [ keys[ k ].count ]
                    parts3[ k ] = ln.mid[ kc, ln.count - kc ]
            n += 1
        if [ fh ] pclose[ fh ]
        if [ parts3[ 0 ].count == 0 || parts3[ 1 ].count == 0 ]
            return ''
        v : '{parts3[ 0 ]}.{parts3[ 1 ]}'
        return (parts3[ 2 ].count > 0) ? '{v}.{parts3[ 2 ]}' : v

    # linux-surface's patches/<series> folders
    func patch_series [] -> vec string
        out : vec string []
        api : 'https://api.github.com/repos/linux-surface/linux-surface'
        cmd : 'curl -s --max-time 4 {api}/contents/patches'
        fh_cmd : command [ cmd ]
        fh : handle fh_cmd.stream[]
        b : local i8 [ 1024 ]
        while [ fh && fgets[ @b[0], 1024, fh ] ]
            ln0 : string [ @b[0] ]
            ln : ln0.trim[]
            if [ !ln.starts_with[ '"name": "' ] ] continue
            nm : ln.mid[ 9, ln.count - 9 ]
            q : i32 [ nm.index_of[ '"' ] ]
            if [ q > 0 ] nm = nm.mid[ 0, q ]
            if [ nm.index_of[ '.' ] > 0 && !nm.ends_with[ '.md' ] ]
                out.push[ nm ]
        if [ fh ] pclose[ fh ]
        return out

    # nvidia's modules go with x64 and Surface only
    func nvidia_offered [] -> bool
        return want_hardware == 'x64' || want_hardware == 'Surface'

    # amd's cards go in PCs and arm64 boards; Intel's in PCs
    func amd_offered [] -> bool
        return want_hardware != 'Apple'
            && want_hardware != 'Fairphone 6'

    func intel_offered [] -> bool
        return want_hardware == 'x64' || want_hardware == 'Surface'

    # AMD's and Intel's drivers are part of Linux: in, or none
    public func amds [] -> vec string
        return vec string [] [ 'amdgpu', 'none' ]

    public func intels [] -> vec string
        return vec string [] [ 'i915, xe', 'none' ]

    # an x64 or Surface kernel: what the drive tree runs today
    func on_pc [ kb: KernelBuild ] -> bool
        return kb.hardware == 'x64' || kb.hardware == 'Surface'

    # the hardware lines this build page builds so far
    func builds_hardware [] -> bool
        return true

    # the choices: kernel.org's 6.x series, nvidia's
    public func versions [] -> vec string
        if [ !releases ] releases = kernel_releases[]
        return releases

    # kernel.org's current list: its stable release, then the two
    # newest longterm; without the network, the series we know
    func kernel_releases [] -> vec string
        out : vec string []
        url : 'https://www.kernel.org/releases.json'
        cmd : 'curl -s --max-time 4 {url}'
        fh_cmd : command [ cmd ]
        fh : handle fh_cmd.stream[]
        text : string ''
        b : local i8 [ 4096 ]
        while [ fh && fgets[ @b[0], 4096, fh ] ]
            ln : string [ @b[0] ]
            text = '{text}{ln}'
        if [ fh ] pclose[ fh ]
        longterm : i32 [ 0 ]
        for [ want: string ] in vec string [] [ 'stable', 'longterm' ]
            at : i32 [ 0 ]
            while [ true ]
                rest : text.mid[ at, text.count - at ]
                m : i32 [ rest.index_of[ '"moniker": "{want}"' ] ]
                if [ m < 0 ] break
                # each entry: its moniker, then its version
                after : rest.mid[ m, rest.count - m ]
                v : i32 [ after.index_of[ '"version": "' ] ]
                at = at + m + 1
                if [ v < 0 ] continue
                vs : after.mid[ v + 12, after.count - v - 12 ]
                q : i32 [ vs.index_of[ '"' ] ]
                if [ q <= 0 ] continue
                out.push[ vs.mid[ 0, q ] ]
                if [ want == 'stable' ] break
                longterm += 1
                if [ longterm == 2 ] break
        if [ out.count == 0 ]
            return vec string [] [ '7.2', '6.18', '6.12' ]
        return out

    # nvidia's releases: the modules and libraries share one
    public func nvidias [] -> vec string
        return vec string [] [ '610.57.04', '615.71.09', 'none' ]

    # nvidia's own installer for a release, unpacked once
    func nvidia_user [ v: string ] -> string
        dir : '{share[]}/nvidia-user/{v}'
        dp : path [ dir ]
        if [ dp.exists[] ] return dir
        run : 'NVIDIA-Linux-x86_64-{v}.run'
        site : 'https://download.nvidia.com/XFree86/Linux-x86_64'
        got : fetch[ run, '{site}/{v}/{run}' ]
        if [ got.count == 0 ] return ''
        ex : 'sh {got} --extract-only --target {dir}.all'
        if [ !sh[ 'rm -rf {dir}.all {dir}.part && {ex}' ] ] return ''
        # only what the drive takes: the 1.7 GB rest stays out
        keep : vec string [] [ 'libGLX_nvidia', 'libEGL_nvidia',
            'libnvidia-glcore', 'libnvidia-glvkspirv',
            'libnvidia-gpucomp', 'libnvidia-tls', 'libnvidia-glsi',
            'libnvidia-rtcore', 'libnvidia-eglcore',
            'libnvidia-allocator', 'libnvidia-egl-gbm',
            'libEGL.so.1.1.0', 'libGLdispatch.so.0' ]
        cp : 'mkdir -p {dir}.part/32 {dir}.part/firmware'
        for [ k: string ] in keep
            cp = '{cp} && cp -P {dir}.all/{k}* {dir}.part/'
            small : 'cp -P {dir}.all/32/{k}* {dir}.part/32/'
            cp = '{cp} && ({small} || true)'
        cp = '{cp} && cp {dir}.all/*.json {dir}.part/'
        cp = '{cp} && cp {dir}.all/firmware/gsp_* {dir}.part/firmware/'
        cp = '{cp} && rm -rf {dir}.all && mv {dir}.part {dir}'
        if [ !sh[ cp ] ] return ''
        return dir

    # the kernels in kernels/, and the one the drive takes
    public func scan []
        kernels = vec KernelBuild []
        kd : path '{share[]}/kernels'
        entries : kd.ls[ null, false ]
        if [ entries ]
            for [ e: path ] in entries
                # bzImage on x86, Image on arm64
                bz : path '{e}/bzImage'
                if [ !bz.exists[] ] bz = path '{e}/Image'
                if [ !bz.exists[] ] bz = path '{e}/Image.gz'
                if [ !e.is_dir[] || !bz.exists[] ] continue
                # a build under way: not a kernel yet
                if [ e.filename[].ends_with[ '.part' ] ] continue
                kb : KernelBuild [ name: e.filename[], dir: '{e}' ]
                info : read_lines[ '{e}/build.agi' ]
                for [ ln: string ] in info
                    sp : i32 [ ln.index_of[ ' ' ] ]
                    if [ sp <= 0 ] continue
                    k : ln.mid[ 0, sp ]
                    v : ln.mid[ sp + 1, ln.count - sp - 1 ]
                    if [ k == 'version' ] kb.version = v
                    el [ k == 'hardware' ] kb.hardware = v
                    el [ k == 'nvidia' ] kb.nvidia = v
                    el [ k == 'amd' ] kb.amd = v
                    el [ k == 'intel' ] kb.intel = v
                kb.release = module_release[ '{e}/kmods' ]
                md : '{e}/kmods/lib/modules/{kb.release}/kernel'
                kb.drivers = count_files[ md, '.ko' ]
                kb.built   = when[ bz ]
                kernels.push[ kb ]
        pick : first_line[ '{share[]}/kernels/selected' ].trim[]
        found : bool [ false ]
        for [ kb: KernelBuild ] in kernels
            if [ kb.name == pick ] found = true
        if [ !found && kernels.count > 0 ]
            pick = kernels[ kernels.count - 1 ].name
        select[ pick ]

    # the kernel the drive tree takes
    public func select [ nm: string ]
        chosen = nm
        stick  = nm
        kdir   = '{share[]}/kernels/{nm}'
        kernel = path '{kdir}/bzImage'
        if [ !kernel.exists[] ] kernel = path '{kdir}/Image'
        if [ nm.count > 0 ]
            sf : '{share[]}/kernels/selected'
            fh : handle fopen[ sf.chars, 'w' ]
            if [ fh ]
                fputs[ nm.chars, fh ]
                fclose[ fh ]
        parts = summary[]

    func selected [] -> KernelBuild
        for [ kb: KernelBuild ] in kernels
            if [ kb.name == chosen ] return kb
        return null

    func stick_kernel [] -> KernelBuild
        for [ kb: KernelBuild ] in kernels
            if [ kb.name == stick ] return kb
        return null

    # the drive tree and its boot files, against the chosen kernel
    public func summary [] -> vec Built
        out : vec Built []
        kb : selected[]
        rel : string [ (kb) ? kb.release : '' ]
        tb : Built [ what: 'Drive tree' ]
        tree : '{out_dir}/root'
        bytes : first_line[ '{tree}/boot/tree-bytes' ].trim[]
        tr : module_release[ tree ]
        # the chosen kernel's modules, whatever else is beside them
        have : path '{tree}/lib/modules/{rel}/modules.alias'
        if [ rel.count > 0 && have.exists[] ] tr = rel
        tb.ok = bytes.count > 0 && tr.count > 0 && tr == rel
        sz : i64 [ bytes.integer_value[] / (1024 * 1024) ]
        tbp : path '{tree}/boot/tree-bytes'
        tw : when[ tbp ]
        tb.note = (bytes.count == 0) ? 'not written'
            : ((tr.count == 0) ? 'written without a module tree'
            : ((tr != rel) ? 'has kernel {tr}, not the chosen one'
            : '{sz} MB, written {tw}'))
        out.push[ tb ]
        bt : Built [ what: 'Boot files' ]
        vm : path '{tree}/boot/vmlinuz'
        rd : path '{tree}/boot/initramfs'
        same : bool [ vm.exists[] && kernel.exists[]
            && file_size[ '{vm}' ] == file_size[ '{kernel}' ] ]
        bt.ok = same && rd.exists[]
        bt.note = (bt.ok) ? 'vmlinuz is the chosen kernel, initramfs'
            : ((vm.exists[]) ? 'vmlinuz is not the chosen kernel'
            : 'not written')
        out.push[ bt ]
        return out

    # a chosen kernel, written into the drive tree
    public func ready [] -> bool
        if [ !selected[] ] return false
        for [ b: Built ] in parts
            if [ !b.ok ] return false
        return true

    # the build's word: logged, and the last lines shown
    func say [ s: string ]
        log 'os-bootstrap: {s}'
        lock.lock[]
        lines.push[ s ]
        lock.unlock[]
        sw : string step_word[ s ]
        if [ sw.count > 0 ] step = sw
        # a kernel build's whole output, kept for reading
        if [ job == 'kernel' ]
            fh : handle fopen[ log_file[].chars, 'a' ]
            if [ fh ]
                fputs[ '{s}\n'.chars, fh ]
                fclose[ fh ]

    # the kernel build's log
    func log_file [] -> string
        return '{install}/tmp/kernel-build.log'

    # a build's command as the step it is, in words ('' for output)
    func step_word [ s: string ] -> string
        if [ s.starts_with[ 'Downloading' ] ] return 'Downloading'
        if [ !s.starts_with[ '$ ' ] ] return ''
        if [ s.index_of[ 'modules_install' ] >= 0 ]
            return 'Installing the modules'
        if [ s.index_of[ 'headers_install' ] >= 0 ]
            return 'Kernel headers'
        if [ s.index_of[ ' dtbs' ] >= 0 ] return 'Device trees'
        if [ s.index_of[ 'Image modules' ] >= 0 ]
            return 'Compiling the kernel and its modules'
        if [ s.index_of[ 'NV_KERNEL_MODULES' ] >= 0 ]
            return 'NVIDIA\'s modules'
        if [ s.index_of[ 'depmod' ] >= 0 ] return 'Module index'
        if [ s.index_of[ 'defconfig' ] >= 0
             || s.index_of[ 'merge_config' ] >= 0
             || s.index_of[ 'scripts/config' ] >= 0
             || s.index_of[ '.config' ] >= 0 ]
            return 'Configuring'
        if [ s.index_of[ 'patch -p1' ] >= 0 ] return 'Patching'
        if [ s.index_of[ 'tar x' ] >= 0 ] return 'Unpacking the source'
        if [ s.index_of[ 'clang' ] >= 0 ] return 'Building init'
        if [ s.index_of[ 'rustup' ] >= 0
             || s.index_of[ 'bindgen' ] >= 0 ]
            return 'Rust tools'
        return ''

    # a shell line, its output said; true when it worked
    # a shell's quoting of a line: inside '', each ' as '\''
    func quoted [ cmd: string ] -> string
        out : string ''
        for [ i: i32 0, i < cmd.count, i += 1 ]
            ch : cmd.mid[ i, 1 ]
            out = (ch == '\'') ? '{out}\'\\\'\'' : '{out}{ch}'
        return '\'{out}\''

    # where the running command's process id is kept
    func pid_file [] -> string
        return '{install}/tmp/os-bootstrap-build.pid'

    # a shell in a process group of its own: macOS has no setsid
    func grouped [ q: string ] -> string
        ifdef [ apple ]
            ps : '\'POSIX::setsid(); exec @ARGV\''
            return 'perl -MPOSIX -e {ps} sh -c {q}'
        ifndef [ apple ]
            return 'setsid sh -c {q}'

    func sh [ cmd: string ] -> bool
        if [ cancelled ] return false
        # its own group, its id kept: Cancel Build stops all of it
        pf : pid_file[]
        q : quoted[ 'echo $$ > {pf}; {cmd}' ]
        full : '{grouped[ q ]} 2>&1'
        fh_cmd : command [ full ]
        fh : handle fh_cmd.stream[]
        if [ !fh ] return false
        b : local i8 [ 1024 ]
        while [ fgets[ @b[0], 1024, fh ] ]
            ln : string [ @b[0] ]
            say[ ln.trim[] ]
        return pclose[ fh ] == 0

    # sh for dd: its byte counts move progress, past the image's
    # share; its other lines are said. dd ends a count with \r
    func sh_copy [ cmd: string ] -> bool
        if [ cancelled ] return false
        pf : pid_file[]
        run : '({cmd}; echo "status $?") 2>&1'
        q : quoted[ 'echo $$ > {pf}; {run}' ]
        full : grouped[ q ]
        fh_cmd : command [ full ]
        fh : handle fh_cmd.stream[]
        if [ !fh ] return false
        code : i32 [ 1 ]
        b : local i8 [ 1024 ]
        n : i32 [ 0 ]
        ch : i32 [ fgetc[ fh ] ]
        while [ ch >= 0 ]
            if [ ch == 10 || ch == 13 || n == 1023 ]
                b[ n ] = 0
                n = 0
                raw : string [ @b[0] ]
                code = copy_line[ raw.trim[], code ]
            el
                b[ n ] = i8[ ch ]
                n += 1
            ch = fgetc[ fh ]
        pclose[ fh ]
        return code == 0

    # one line of sh_copy's: the exit status, a count, or words
    func copy_line [ ln: string, code: i32 ] -> i32
        sp : i32 [ i32[ ln.index_of[ ' ' ] ] ]
        if [ ln.starts_with[ 'status ' ] ]
            return ln.mid[ 7, ln.count - 7 ].integer_value[]
        if [ sp > 0 && ln.index_of[ ' bytes' ] == sp ]
            if [ image_bytes > 0 ]
                f : f32 [ f32[ ln.mid[ 0, sp ].integer_value[] ]
                          / f32[ image_bytes ] ]
                progress = image_share + (1.0 - image_share)
                    * minf[ f, 1.0 ]
        el [ ln.count > 0 ] say[ ln ]
        return code

    # a repo's branch at its newest commit, as a tarball kept in
    # install/imports by that commit; offline, one kept before
    func github_tarball [ repo: string, branch: string,
                          pre: string ] -> string
        api : 'https://api.github.com/repos/{repo}/commits/{branch}'
        sha : string ''
        cmd : 'curl -s --max-time 6 {api}'
        fh_cmd : command [ cmd ]
        fh : handle fh_cmd.stream[]
        b : local i8 [ 1024 ]
        while [ fh && fgets[ @b[0], 1024, fh ] && sha.count == 0 ]
            raw : string [ @b[0] ]
            ln : raw.trim[]
            if [ ln.starts_with[ '"sha": "' ] ] sha = ln.mid[ 8, 40 ]
        if [ fh ] pclose[ fh ]
        if [ sha.count == 0 ]
            d : path [ '{install}/imports' ]
            have : d.ls[ null, false ]
            if [ have ]
                for [ f: path ] in have
                    if [ f.filename[].starts_with[ pre ] ] return '{f}'
            say[ '{repo} could not be reached' ]
            return ''
        cl : 'https://codeload.github.com/{repo}/tar.gz/{sha}'
        return fetch[ '{pre}{sha}.tar.gz', cl ]

    # a kept tarball's folder in install/build, unpacked once
    func unpacked [ tar: string, pre: string, into: string ] -> string
        if [ tar.count == 0 ] return ''
        t : path [ tar ]
        nm : t.filename[]
        sha : nm.mid[ pre.count, nm.count - pre.count - 7 ]
        dir : '{into}/{pre}{sha}'
        un : 'tar xzf {tar} -C {dir} --strip-components=1'
        un = 'mkdir -p {dir} && {un}'
        mark : '{dir}/.unpacked'
        if [ !sh[ 'test -f {mark} || ({un} && touch {mark})' ] ]
            return ''
        return dir

    # linux-surface's patches and configs
    func surface_source [] -> string
        pre : 'linux-surface-'
        repo : 'linux-surface/linux-surface'
        tar : github_tarball[ repo, 'master', pre ]
        return unpacked[ tar, pre, '{install}/build' ]

    # a download kept in install/imports, fetched when missing
    func fetch [ stem: string, url: string ] -> string
        imp : '{install}/imports'
        d : path [ imp ]
        d.make_dir[]
        have : d.ls[ null, false ]
        if [ have ]
            for [ f: path ] in have
                if [ f.filename[].ends_with[ stem ] ] return '{f}'
        dest : '{imp}/{stem}'
        say[ 'Downloading {url}' ]
        get : 'curl -fL -o {dest}.part {url}'
        if [ !sh[ '{get} && mv {dest}.part {dest}' ] ] return ''
        return dest

    # the config: the base, then what the drive needs built in
    func config_words [ amd: string, intel: string,
                        surface: bool, apple: bool ] -> string
        on : vec string [] [ 'VIRTIO_PCI', 'VIRTIO_BLK',
            'VIRTIO_INPUT', 'VIRTIO_CONSOLE', 'HW_RANDOM_VIRTIO', 'DRM',
            'DRM_VIRTIO_GPU',
            'DRM_FBDEV_EMULATION', 'INPUT_EVDEV', 'DEVTMPFS',
            'DEVTMPFS_MOUNT', 'BLK_DEV_INITRD', 'BLK_DEV_NVME',
            'SYSFB_SIMPLEFB', 'DRM_SIMPLEDRM', 'TMPFS', 'EFIVAR_FS',
            'KVM_GUEST', 'PARAVIRT', 'VIRTIO_NET', 'NET_9P',
            'NET_9P_VIRTIO', '9P_FS', 'USB_STORAGE', 'USB_UAS',
            'NLS_ISO8859_1', 'FW_LOADER_COMPRESS',
            'FW_LOADER_COMPRESS_ZSTD', 'FW_LOADER_COMPRESS_XZ',
            'DEBUG_INFO_NONE' ]
        # OBJTOOL_WERROR: 7.x fails nvidia's naked returns, 6.x warned
        off : vec string [] [ 'DRM_NOUVEAU', 'OBJTOOL_WERROR',
            'MODULE_SIG',
            'MODULE_SIG_ALL', 'DEBUG_INFO_BTF',
            'DEBUG_INFO_BTF_MODULES',
            'DEBUG_INFO_DWARF5', 'DEBUG_INFO' ]
        if [ amd == 'none' ]
            off.push[ 'DRM_AMDGPU' ]
            off.push[ 'DRM_RADEON' ]
        if [ intel == 'none' ]
            off.push[ 'DRM_I915' ]
            off.push[ 'DRM_XE' ]
        # Rust (Asahi's GPU driver) needs MODVERSIONS off, or
        # GENDWARFKSYMS, which needs the debug info we leave out
        if [ apple ] off.push[ 'MODVERSIONS' ]
        # linux-surface builds these in: soc-button-array and the
        # like race them as modules
        if [ surface ]
            for [ w: string ] in vec string [] [ 'PINCTRL_INTEL',
                    'PINCTRL_ALDERLAKE', 'PINCTRL_CANNONLAKE',
                    'PINCTRL_ICELAKE', 'PINCTRL_METEORLAKE',
                    'PINCTRL_SUNRISEPOINT', 'PINCTRL_TIGERLAKE' ]
                on.push[ w ]
        keys : vec string [] [ 'MODULE_SIG_KEY', 'SYSTEM_TRUSTED_KEYS',
            'SYSTEM_REVOCATION_KEYS' ]
        out : string ''
        for [ w: string ] in on
            out = '{out} -e {w}'
        for [ w: string ] in off
            out = '{out} -d {w}'
        for [ w: string ] in keys
            out = '{out} --set-str {w} \'\''
        return out

    # a file of postmarketOS's packages (pmaports), by url
    func pmaports_url [ pkg: string, file: string ] -> string
        api : 'https://gitlab.postmarketos.org/api/v4/projects'
        pm : '{api}/postmarketOS%2Fpmaports/repository/files'
        return '{pm}/device%2Ftesting%2F{pkg}%2F{file}/raw?ref=main'

    # a line of a pmaports file: the value after 'key='
    func pmaports_value [ pkg: string, file: string, key: string ]
            -> string
        url : pmaports_url[ pkg, file ]
        cmd : 'curl -s --max-time 8 \'{url}\''
        fh_cmd : command [ cmd ]
        fh : handle fh_cmd.stream[]
        out : string ''
        b : local i8 [ 1024 ]
        while [ fh && fgets[ @b[0], 1024, fh ] ]
            ln0 : string [ @b[0] ]
            ln : ln0.trim[]
            if [ !ln.starts_with[ '{key}=' ] ] continue
            v : ln.mid[ key.count + 1, ln.count - key.count - 1 ]
            if [ v.starts_with[ '"' ] ] v = v.mid[ 1, v.count - 2 ]
            if [ out.count == 0 ] out = v
        if [ fh ] pclose[ fh ]
        return out

    # the Fairphone 6's kernel: the release postmarketOS builds
    # from milos-mainline (Fairphone's mainline work for its chip)
    func fairphone_release [] -> string
        v : pmaports_value[ 'linux-postmarketos-qcom-milos',
                            'APKBUILD', 'pkgver' ]
        return (v.count > 0) ? v : '7.2.0'

    # the Fairphone 6's kernel as postmarketOS builds it: milos-
    # mainline's tag, postmarketOS's config (modules plain, the
    # USB serial gadget built in), Image.gz, modules, the phone's
    # device tree; then its firmware, from Fairphone's blobs
    public func build_fairphone [ ver: string ] -> bool
        nm : '{ver}-fp6'
        out : '{share[]}/kernels/{nm}'
        part : '{out}.part'
        bd : '{install}/build/linux-{ver}-milos'
        tag : 'v{ver}-milos'
        gh : 'https://github.com'
        steps : vec string []
        tu : '{gh}/milos-mainline/linux/archive/refs/tags/{tag}.tar.gz'
        tb : fetch[ 'milos-linux-{tag}.tar.gz', tu ]
        if [ tb.count == 0 ] return false
        un : 'mkdir -p {bd} && tar xf {tb} -C {bd} --strip-components=1'
        steps.push[ 'test -f {bd}/Makefile || ({un})' ]
        kp : 'linux-postmarketos-qcom-milos'
        cn : 'config-postmarketos-qcom-milos.aarch64'
        cf : fetch[ 'pmaports-{ver}-{cn}', pmaports_url[ kp, cn ] ]
        if [ cf.count == 0 ] return false
        steps.push[ 'cp {cf} {bd}/.config' ]
        # modules plain (the boot loads them itself), the USB
        # serial gadget in, no BTF (pahole), no git version
        sw : '-d MODULE_COMPRESS -d MODULE_COMPRESS_ALL'
        sw = '{sw} -d MODULE_COMPRESS_ZSTD -e MODULE_COMPRESS_NONE'
        sw = '{sw} -e USB_CONFIGFS -e USB_CONFIGFS_ACM'
        sw = '{sw} -d DEBUG_INFO_BTF -d LOCALVERSION_AUTO'
        steps.push[ '{bd}/scripts/config --file {bd}/.config {sw}' ]
        mk : 'make -C {bd} ARCH=arm64 LLVM={install}/bin/ -j16'
        steps.push[ '{mk} olddefconfig' ]
        dtb : 'qcom/milos-fairphone-fp6.dtb'
        steps.push[ '{mk} Image.gz modules {dtb}' ]
        steps.push[ 'rm -rf {part} && mkdir -p {part}' ]
        mi : 'INSTALL_MOD_PATH={part}/kmods INSTALL_MOD_STRIP=1'
        steps.push[ '{mk} modules_install {mi}' ]
        steps.push[ 'cp {bd}/arch/arm64/boot/Image.gz {part}/Image.gz' ]
        steps.push[ 'cp {bd}/arch/arm64/boot/dts/{dtb} {part}/fp6.dtb' ]
        if [ !run_steps[ steps ] ] return false
        if [ !phone_init[ bd, '{part}/init' ] ] return false
        # the modules postmarketOS loads first (panel, SPI)
        dp : 'device-fairphone-fp6'
        ef : fetch[ 'pmaports-{ver}-fp6-modules-initfs',
                    pmaports_url[ dp, 'modules-initfs' ] ]
        if [ ef.count == 0 ] return false
        steps.push[ 'cp {ef} {part}/early.list' ]
        # how the phone boots (offsets, page size, command line),
        # as postmarketOS's device files say: for the installer
        di : fetch[ 'pmaports-{ver}-fp6-deviceinfo',
                    pmaports_url[ dp, 'deviceinfo' ] ]
        kc : fetch[ 'pmaports-{ver}-fp6-kernel-cmdline.conf',
                    pmaports_url[ dp, 'kernel-cmdline.conf' ] ]
        if [ di.count == 0 || kc.count == 0 ] return false
        steps.push[ 'cp {di} {part}/deviceinfo' ]
        steps.push[ 'cp {kc} {part}/kernel-cmdline.conf' ]
        if [ !run_steps[ steps ] ] return false
        if [ !phone_shell[] ] return false
        if [ !fairphone_firmware[ ver, '{part}/firmware' ] ]
            return false
        info : 'hardware Fairphone 6\nversion {ver}\nnvidia none\n'
        info = '{info}amd n/a\nintel n/a\n'
        write_file[ '{part}/build.agi', info ]
        if [ !sh[ 'rm -rf {out} && mv {part} {out}' ] ] return false
        say[ 'Built {nm}' ]
        scan[]
        return true

    # its firmware, placed as postmarketOS places it: Fairphone's
    # blobs (FairBlobs, at postmarketOS's commit) joined into .mbn
    # by pil-squasher; Wi-Fi's board file from linux-firmware
    func fairphone_firmware [ ver: string, fw: string ] -> bool
        gh : 'https://github.com'
        fp : 'firmware-fairphone-fp6'
        sha : pmaports_value[ fp, 'APKBUILD', '_commit' ]
        if [ sha.count == 0 ]
            say[ 'postmarketOS\'s firmware commit was not found' ]
            return false
        bu : '{gh}/FairBlobs/FP6-firmware/archive/{sha}.tar.gz'
        bt : fetch[ 'FP6-firmware-{sha}.tar.gz', bu ]
        ps : '3c9f8b8756ba6e4dbf9958570fd4c9aea7a70cf4'
        pu : '{gh}/linux-msm/pil-squasher/archive/{ps}.tar.gz'
        pt : fetch[ 'pil-squasher-{ps}.tar.gz', pu ]
        lf : 'https://git.kernel.org/pub/scm/linux/kernel/git/firmware'
        wb : '{lf}/linux-firmware.git/plain/ath11k/WCN6750/hw1.0'
        bb : fetch[ 'linux-firmware-WCN6750-board-2.bin',
                    '{wb}/board-2.bin' ]
        if [ bt.count == 0 || pt.count == 0 || bb.count == 0 ]
            return false
        steps : vec string []
        sq : '{install}/build/pil-squasher-{ps}'
        su : 'mkdir -p {sq} && tar xf {pt} -C {sq} --strip-components=1'
        steps.push[ 'test -f {sq}/Makefile || ({su})' ]
        steps.push[ 'make -C {sq} CC={install}/bin/clang' ]
        bl : '{install}/build/FP6-firmware-{sha}'
        bx : 'tar xf {bt} -C {bl} --strip-components=1'
        bu2 : 'mkdir -p {bl} && {bx}'
        steps.push[ 'test -f {bl}/adsp.mdt || ({bu2})' ]
        one : '{sq}/pil-squasher "${{m%.mdt}}.mbn" "$m"'
        each : 'for m in *.mdt; do {one} || exit 1; done'
        steps.push[ 'cd {bl} && {each}' ]
        q : '{fw}/qcom/milos/fairphone/fp6'
        dirs : '{q} {fw}/qca {fw}/postmarketos'
        steps.push[ 'rm -rf {fw} && mkdir -p {dirs}' ]
        mine : 'gen80300_zap.mbn adsp*.mbn adsp*.jsn battmgr.jsn'
        mine = '{mine} cdsp*.mbn cdsp*.jsn ipa_fws.mbn modem.mbn'
        mine = '{mine} modem*.jsn vpu20_2v.mbn wpss.mbn'
        steps.push[ 'cd {bl} && cp {mine} {q}/ && cp -r modem_pr {q}/' ]
        gpu : 'gen80300_gmu.bin gen80300_sqe.fw'
        steps.push[ 'cd {bl} && cp {gpu} {fw}/postmarketos/' ]
        steps.push[ 'cd {bl} && cp msbtfw12.mbn msnv12.bin {fw}/qca/' ]
        ah : '{fw}/ath11k/WCN6750/hw1.0'
        steps.push[ 'mkdir -p {ah} && cp {bb} {ah}/board-2.bin' ]
        # Awinic config tested with Catcrafts audio
        ac : 'e58a5be8fa0fb6bc5a5f2e29cc01c036ccf75710'
        af : fetch[ 'aw882xx_acf-e58a5be8.bin',
            '{gh}/FairBlobs/FP6-firmware/raw/{ac}/aw882xx_acf.bin' ]
        if [ af.count > 0 ] steps.push[ 'cp {af} {q}/aw88261_acf.bin' ]
        return run_steps[ steps ]

    # steps in order, each said; false at the first that fails
    # orbiter-os for arm64 from the current source: orbiter and
    # every module it reaches, LLVM and turnip (arm64 imports);
    # the device is os-bootstrap's own fp6.agi, for everyone
    func phone_shell [] -> bool
        sb : '{install}/bin/silver -d fp6 --build'
        steps : vec string []
        # bootcube: the phone's boot picture, until orbiter's
        shell : 'cd {root} && {sb} os-bootstrap && {sb} orbiter'
        steps.push[ '{shell} && {sb} bootcube' ]
        if [ !run_steps[ steps ] ] return false
        # every app and scene that runs on the phone (its source
        # names no platforms, or arm64): one that fails is said, the
        # rest go on
        rp : path [ root ]
        for [ d: path ] in rp.ls[ null, false ]
            n : string d.filename[]
            m : path '{d}/{n}.ag'
            if [ !d.is_dir[] || !m.exists[] ] continue
            src : string m.load[ typeid[ string ], null ]
            if [ !src || (src.index_of[ '\nexport software ' ] < 0
                 && src.index_of[ '\nexport scenes ' ] < 0) ]
                continue
            pa : i32 [ src.index_of[ 'export platforms ' ] ]
            if [ pa >= 0 ]
                pr : src.mid[ pa, src.count - pa ]
                pe : i32 [ pr.index_of[ '\n' ] ]
                pl : string (pe >= 0) ? pr.mid[ 0, pe ] : pr
                if [ pl.index_of[ "'arm64'" ] < 0 ] continue
            st : 'cd {root} && {sb} {n}'
            say[ '$ {st}' ]
            if [ !sh[ st ] ] say[ 'phone: {n} did not build; left out' ]
        return true

    # the phone's /init from init.c as it is, on the kernel's own
    # nolibc and headers (its source tree, build/linux-<ver>-milos)
    func phone_init [ bd: string, out: string ] -> bool
        hi : '{bd}/usr-arm64'
        nl : '{bd}/tools/include/nolibc'
        src : path '{nl}/nolibc.h'
        if [ !src.exists[] ]
            say[ 'The phone kernel\'s source is gone: build it again' ]
            return false
        steps : vec string []
        mk : 'make -C {bd} ARCH=arm64 LLVM={install}/bin/'
        hd : path '{hi}/include/linux'
        if [ !hd.exists[] ]
            steps.push[ '{mk} headers_install INSTALL_HDR_PATH={hi}' ]
        ic : '{install}/bin/clang -target aarch64-linux-gnu -static'
        ic = '{ic} -nostdlib -nostdinc -ffreestanding -Os'
        ic = '{ic} -fno-stack-protector -fuse-ld=lld -I{nl}'
        ic = '{ic} -I{hi}/include -include {nl}/nolibc.h'
        steps.push[ '{ic} -o {out} {root}/os-bootstrap/init.c' ]
        return run_steps[ steps ]

    func run_steps [ steps: vec string ] -> bool
        for [ st: string ] in steps
            say[ '$ {st}' ]
            if [ !sh[ st ] ] return false
        steps.clear[]
        return true

    # a Fairphone 6, by the product its bootloader names
    func is_fp6 [ product: string ] -> bool
        return product.index_of[ 'FP6' ] >= 0
            || product.index_of[ 'fp6' ] >= 0

    # the lit kernel goes on a phone, not a USB stick
    public func on_phone [] -> bool
        sk : stick_kernel[]
        return sk && sk.hardware == 'Fairphone 6'

    # the phone on USB as its bootloader answers, in words
    # fastboot/libusb; the usb stick and disk paths do not use it
    ifndef [ windows ]
        func phone_look []
            # running orbiter-os: its shell port answers, not fastboot
            phone_live = phone_shell_port[].count > 0
            if [ phone_live ]
                phone_ok = false
                phone_word = 'orbiter-os is running: Update sends the shell'
                return
            fb : Fastboot []
            if [ !fb.open[] ]
                phone_ok = false
                plug : 'Connect the phone in fastboot mode (from off: '
                plug = '{plug}Power and Volume Down).'
                refused : bool [ fb.problem == 'access refused' ]
                phone_word = (refused)
                    ? 'A phone is there; Install asks once for USB access.'
                    : plug
                phone_ok = refused
                return
            pr : fb.getvar[ 'product' ]
            un : fb.getvar[ 'unlocked' ]
            fb.close[]
            lock : string [ (un == 'yes') ? 'unlocked' : 'locked' ]
            phone_word = '{pr}, {lock}'
            if [ !is_fp6[ pr ] ]
                phone_word = '{phone_word}: not a Fairphone 6'
            phone_ok = is_fp6[ pr ]

    # USB access to fastboot phones (any maker: by the fastboot
    # interface) and to orbiter-os's serial port; asked once
    func phone_udev [] -> bool
        rules : '/etc/udev/rules.d/51-orbiter-phone.rules'
        # the PC's ModemManager probes the shell port, typing
        if [ sh[ 'grep -qs ID_MM_DEVICE_IGNORE {rules}' ] ] return true
        tmp : '{install}/tmp/51-orbiter-phone.rules'
        t : 'SUBSYSTEM=="usb", ENV{{ID_USB_INTERFACES}}=="*:ff4203:*", '
        t = '{t}TAG+="uaccess"\n'
        t = '{t}SUBSYSTEM=="tty", ATTRS{{idVendor}}=="1d6b", '
        t = '{t}ATTRS{{idProduct}}=="0104", TAG+="uaccess", '
        t = '{t}ENV{{ID_MM_DEVICE_IGNORE}}="1"\n'
        write_file[ tmp, t ]
        say[ 'USB access for the phone: the system asks for a password' ]
        up : 'udevadm control --reload-rules && udevadm trigger'
        q : quoted[ 'cp {tmp} {rules} && {up}' ]
        return sh[ 'pkexec sh -c {q}' ]

    # the lit Fairphone kernel's boot image written to the phone's
    # boot partition (its current slot), then its log over USB
    # fastboot/libusb; the usb stick and disk paths do not use it
    ifndef [ windows ]
        public func phone_install [] -> bool
            kb : stick_kernel[]
            if [ !kb || kb.hardware != 'Fairphone 6' ]
                say[ 'Light a Fairphone 6 kernel in the list first' ]
                return false
            # USB access to fastboot and to the phone's log port,
            # asked once (the log port is never refused that way)
            if [ !phone_udev[] ] return false
            fb : Fastboot []
            if [ !fb.open[] && fb.problem == 'access refused' ]
                sleep[ 1 ]
            if [ !fb.open[] ]
                say[ 'No phone: {fb.problem}' ]
                return false
            product : fb.getvar[ 'product' ]
            unlocked : fb.getvar[ 'unlocked' ]
            room : var_bytes[ fb.getvar[ 'partition-size:boot' ] ]
            data : var_bytes[ fb.getvar[ 'partition-size:userdata' ] ]
            most : var_bytes[ fb.getvar[ 'max-download-size' ] ]
            fb.close[]
            if [ !is_fp6[ product ] ]
                say[ '{product} is not a Fairphone 6' ]
                return false
            if [ unlocked != 'yes' ]
                say[ 'The bootloader is locked. Unlocking wipes the phone:' ]
                say[ 'turn on OEM unlocking in Android\'s Developer options,' ]
                say[ 'then unlock it (fastboot flashing unlock) and come back.' ]
                return false
            say[ 'Phone {product}, kernel {kb.name}' ]
            # the shell it carries is built from the source as it is
            if [ !phone_shell[] ]
                say[ 'orbiter did not build for the phone' ]
                return false
            # the root's uuid: the boot line finds userdata by it
            uuid : new_uuid[]
            img : phone_image[ kb, uuid ]
            if [ img.count == 0 ] return false
            fs : phone_rootfs[ kb, uuid ]
            if [ fs.count == 0 ] return false
            # each against its partition, when the phone says
            if [ room > 0 && file_bytes[ img ] > room ]
                say[ 'boot.img is {file_bytes[ img ]} bytes; boot holds {room}' ]
                return false
            if [ data > 0 && file_bytes[ fs ] > data ]
                say[ 'rootfs.img is {file_bytes[ fs ]} bytes; userdata holds {data}' ]
                return false
            # in sparse pieces the phone takes in one download each
            if [ most <= 0 ] most = 256 * 1024 * 1024
            work : '{install}/tmp/phone-fp6'
            pieces : sparse_pieces[ fs, '{work}/rootfs', most ]
            if [ pieces.count == 0 ]
                say[ 'rootfs.img could not be split into sparse pieces' ]
                return false
            say[ 'rootfs in {pieces.count} sparse pieces of at most {most} bytes' ]
            ram : '{work}/boot-ram.img'
            if [ phone_dry ]
                say[ 'would erase dtbo_a and dtbo_b' ]
                say[ 'would flash userdata with {pieces.count} pieces' ]
                say[ 'would RAM-boot {ram}, which writes boot itself' ]
                say[ 'Check only: nothing written to the phone' ]
                return true
            if [ !fb.open[] ]
                say[ 'The phone went away: {fb.problem}' ]
                return false
            # Android overlays do not fit our device tree
            say[ 'Erasing Android\'s device tree overlays (dtbo)' ]
            if [ !fb.erase[ 'dtbo_a' ] || !fb.erase[ 'dtbo_b' ] ]
                say[ 'Erasing dtbo stopped: {fb.problem}' ]
                fb.close[]
                return false
            say[ 'Flashing userdata (Android\'s data is erased)' ]
            if [ !fb.flash_pieces[ 'userdata', pieces ] ]
                say[ 'Flashing userdata stopped: {fb.problem}' ]
                fb.close[]
                return false
            for [ n: string ] in fb.notes
                say[ '  {n}' ]
            # fastboot flash boot erases the modem's NV
            say[ 'RAM-booting orbiter-os once to write its boot slots' ]
            if [ !fb.download[ ram ] ]
                say[ 'Sending the boot image stopped: {fb.problem}' ]
                fb.close[]
                return false
            if [ !fb.okay[ fb.command[ 'boot' ] ] ]
                say[ 'The RAM boot was refused: {fb.problem}' ]
                fb.close[]
                return false
            fb.close[]
            sh[ 'mv {phone_stamp[]}.next {phone_stamp[]}' ]
            sh[ 'touch -r {phone_stamp[]} {phone_stamp[]}.inc' ]
            sh[ 'mv {phone_stamp[]}.debs.next {phone_stamp[]}.debs' ]
            return phone_serial[ product ]

    # postmarketOS's deviceinfo value for a key ('' when none)
    func device_value [ di: string, key: string ] -> string
        k : 'deviceinfo_{key}='
        for [ ln: string ] in read_lines[ di ]
            if [ !ln.starts_with[ k ] ] continue
            v : ln.mid[ k.count, ln.count - k.count ]
            if [ v.starts_with[ '"' ] ] v = v.mid[ 1, v.count - 2 ]
            return v
        return ''

    # the order modules load in: postmarketOS's early ones (with
    # what they need) first, then every other unless early_only,
    # each after its dependencies (modules.dep)
    func module_order [ md: string, early: string, early_only: bool ]
            -> vec string
        all : vec string []
        deps : vec string []
        for [ ln: string ] in read_lines[ '{md}/modules.dep' ]
            c : i32 [ ln.index_of[ ':' ] ]
            if [ c <= 0 ] continue
            all.push[ ln.mid[ 0, c ] ]
            deps.push[ ln.mid[ c + 1, ln.count - c - 1 ].trim[] ]
        out : vec string []
        for [ nm: string ] in read_lines[ early ]
            for [ k: string ] in all
                if [ k.ends_with[ '/{nm}.ko' ] ]
                    module_visit[ k, all, deps, out ]
        if [ early_only ] return out
        for [ k: string ] in all
            module_visit[ k, all, deps, out ]
        return out

    func module_visit [ k: string, all: vec string, deps: vec string,
                        out: vec string ]
        if [ out.index_of[ k ] >= 0 ] return
        at : i64 [ all.index_of[ k ] ]
        if [ at >= 0 ]
            d : string deps[ at ]
            for [ p: string ] in d.split[ ' ' ]
                if [ p.count > 0 ] module_visit[ p, all, deps, out ]
        if [ out.index_of[ k ] < 0 ] out.push[ k ]

    # the Fairphone's boot.img: the kernel, its device tree, and a
    # ramdisk of our /init and the early modules (in load order);
    # the firmware and other modules load from userdata; as
    # postmarketOS's deviceinfo says to pack it
    public func phone_image [ kb: KernelBuild, uuid: string ]
            -> string
        kd : kb.dir
        rel : kb.release
        work : '{install}/tmp/phone-fp6'
        di : '{kd}/deviceinfo'
        md : '{kd}/kmods/lib/modules/{rel}'
        steps : vec string []
        steps.push[ 'rm -rf {work} && mkdir -p {work}' ]
        # Google's boot image packer (Apache-2.0)
        gs : 'https://android.googlesource.com'
        mu : '{gs}/platform/system/tools/mkbootimg/+archive/refs/heads'
        mz : fetch[ 'platform-system-tools-mkbootimg-main.tar.gz',
                    '{mu}/main.tar.gz' ]
        if [ mz.count == 0 ] return ''
        tl : '{install}/build/mkbootimg'
        steps.push[ 'mkdir -p {tl} && tar xzf {mz} -C {tl}' ]
        # the ramdisk: /init, its mount points, the early modules
        rd : '{work}/rd'
        mp : '{rd}/dev {rd}/proc {rd}/sys {rd}/mnt {rd}/newroot'
        steps.push[ 'mkdir -p {mp} {rd}/lib/early' ]
        if [ !run_steps[ steps ] ] return ''
        # init as its source is now, never the kernel build's copy
        bd : '{install}/build/linux-{kb.version}-milos'
        if [ !phone_init[ bd, '{rd}/init' ] ] return ''
        # the bootloader loads the ramdisk under the device tree's
        # place (15 MB): only the early ones, the rest from userdata
        order : module_order[ md, '{kd}/early.list', true ]
        names : string ''
        for [ k: string ] in order
            parts : k.split[ '/' ]
            base : string parts[ parts.count - 1 ]
            nm : base.mid[ 0, base.count - 3 ]
            names = '{names}{nm}\n'
            steps.push[ 'cp {md}/{k} {rd}/lib/early/{base}' ]
        if [ !run_steps[ steps ] ] return ''
        write_file[ '{rd}/lib/early/modules.load', names ]
        say[ '{order.count} modules in the boot ramdisk' ]
        newc : 'find . | cpio -o -H newc --quiet'
        rz : '{work}/ramdisk.gz'
        steps.push[ '(cd {rd} && {newc}) | gzip -9 > {rz}' ]
        if [ !run_steps[ steps ] ] return ''
        # past the device tree's place the bootloader refuses it all
        ro : device_value[ di, 'flash_offset_ramdisk' ]
        dto : device_value[ di, 'flash_offset_dtb' ]
        room : i64 [ hex_value[ dto.mid[ 2, dto.count - 2 ] ]
                   - hex_value[ ro.mid[ 2, ro.count - 2 ] ] ]
        if [ room > 0 && file_bytes[ rz ] > room ]
            say[ 'The boot ramdisk is {file_bytes[ rz ]} bytes; ' +
                 'the bootloader takes {room}' ]
            return ''
        # the command line: no text on the screen at any point (no
        # console there, no framebuffer for one: the cube, then
        # orbiter, draw by KMS), the root on userdata by its uuid,
        # orbiter as pid 1 on turnip
        line : 'quiet loglevel=0 drm_kms_helper.fbdev_emulation=0'
        line = '{line} vt.global_cursor_default=0'
        line = '{line} orbiter.phone=fp6 orbiter.uuid={uuid}'
        line = '{line} orbiter.root=/ {os_words[ true, false ]}'
        icd : '{root}/install/share/vulkan/icd.d/freedreno_icd.aarch64.json'
        line = '{line} VK_DRIVER_FILES={icd}'
        hv : device_value[ di, 'header_version' ]
        ps : device_value[ di, 'flash_pagesize' ]
        mk : '{install}/bin/python3 {tl}/mkbootimg.py'
        a : '--header_version {hv} --pagesize {ps}'
        places : vec string [] [ 'base', 'kernel', 'ramdisk', 'second',
                                 'tags', 'dtb' ]
        for [ pl: string ] in places
            fl : string [ (pl == 'base') ? '--base' : '--{pl}_offset' ]
            ov : device_value[ di, 'flash_offset_{pl}' ]
            a = '{a} {fl} {ov}'
        ca : device_value[ di, 'bootimg_custom_args' ]
        a = '{a} {ca} --kernel {kd}/Image.gz --ramdisk {rz}'
        a = '{a} --dtb {kd}/fp6.dtb'
        img : '{work}/boot.img'
        steps.push[ '{mk} {a} --cmdline \'{line}\' --output {img}' ]
        # RAM boot writes both slots without fastboot
        ram : '{line} orbiter.writeboot=/boot/orbiter-boot.img'
        rb : '{work}/boot-ram.img'
        steps.push[ '{mk} {a} --cmdline \'{ram}\' --output {rb}' ]
        if [ !run_steps[ steps ] ] return ''
        say[ 'boot.img: {file_bytes[ img ]} bytes' ]
        return img

    # the phone's root for userdata: orbiter-os for arm64. The
    # fp6 build's sysroot (ubuntu's arm64 userspace) is its base;
    # silver's files at /src/silver, the arm64 build at
    # /src/silver/install, the shares orbiter's modules use, every
    # kernel module and all the firmware; ext4 with the given uuid
    public func phone_rootfs [ kb: KernelBuild, uuid: string ]
            -> string
        kd : kb.dir
        work : '{install}/tmp/phone-fp6'
        st : '{work}/root'
        img : '{work}/rootfs.img'
        fp : '{root}/platform/fp6'
        si : '{st}{root}'
        ti : '{si}/install'
        ob_bin : path '{fp}/build/orbiter'
        if [ !ob_bin.exists[] ]
            say[ 'orbiter is not built for the phone (fp6)' ]
            return ''
        steps : vec string []
        # what is newer than this goes in the next update
        steps.push[ 'touch {phone_stamp[]}.next' ]
        steps.push[ 'cp {fp}/debs.txt {phone_stamp[]}.debs.next' ]
        steps.push[ 'rm -rf {st} {img} && mkdir -p {st}' ]
        steps.push[ 'cp -a {fp}/sysroot/. {st}/' ]
        # the build named its sysroot in the .pc files; the phone's
        # own paths again
        pc : '{st}/usr/lib/aarch64-linux-gnu/pkgconfig'
        sx : 'sed -i -E "s|={fp}/sysroot/usr|=/usr|"'
        steps.push[ '{sx} {pc}/*.pc {st}/usr/share/pkgconfig/*.pc' ]
        steps.push[ 'mkdir -p {ti}/build {ti}/lib {ti}/share {ti}/tmp' ]
        # silver's own files as they are: the shares link into them
        cpg : 'xargs -0 cp -a --parents -t {si}'
        sf : source_files[ '' ]
        steps.push[ 'cd {root} && {sf} | {cpg}' ]
        # the libraries, less what only links them here
        steps.push[ 'cp -a {fp}/lib/. {ti}/lib/' ]
        steps.push[ 'rm -rf {ti}/lib/*.a {ti}/lib/*.la {ti}/lib/cmake' ]
        # our libraries' pkg-config files name this PC's fp6 folder
        rp : 'sed -i "s|{fp}|{root}/install|g"'
        steps.push[ '{rp} {ti}/lib/pkgconfig/*.pc' ]
        # silver, clang and lld for arm64: the phone builds itself
        steps.push[ 'mkdir -p {ti}/bin && cp -a {fp}/bin/. {ti}/bin/' ]
        # an IDE as the PC is: the whole build (imports' stamps),
        # every header (the phone's own over ours), silver's .git
        steps.push[ 'cp -a {fp}/build/. {ti}/build/' ]
        inc : 'mkdir -p {ti}/include && (cp -rL {install}/include/.'
        inc = '{inc} {ti}/include/ || true) && cp -af {fp}/include/.'
        steps.push[ '{inc} {ti}/include/' ]
        steps.push[ 'cp -a {root}/.git {si}/' ]
        # git's https: the PC's certificate authorities
        ca : '/etc/ssl/certs/ca-certificates.crt'
        steps.push[ 'mkdir -p {st}/etc/ssl/certs && cp {ca} {st}{ca}' ]
        # the tree's files are the PC user's; root uses its git
        gc : '[safe]\n\tdirectory = *\n'
        steps.push[ 'printf "{gc}" > {st}/etc/gitconfig' ]
        # each product link names the phone's build folder
        lk : 'for p in silver-*.product; do'
        lk = '{lk} ln -sfn {root}/install/build/'
        lk = '{lk}$(basename $(readlink $p))'
        lk = '{lk} {ti}/build/$p; done'
        steps.push[ 'cd {fp}/build && {lk}' ]
        steps.push[ 'cp -a {fp}/share/. {ti}/share/' ]
        steps.push[ '{rp} {ti}/share/pkgconfig/*.pc' ]
        # the shares of the modules built for it; os-bootstrap's
        # kernels stay on the PC
        shares : 'for p in silver-*.product; do'
        shares = '{shares} m=$(basename $p .product);'
        shares = '{shares} test -d {install}/share/$m || continue;'
        shares = '{shares} test $m = silver-os-bootstrap && continue;'
        shares = '{shares} cp -a {install}/share/$m {ti}/share/;'
        # a module's data by its plain name too (share/keyboard)
        shares = '{shares} s=${{m#silver-}};'
        shares = '{shares} if test -d {install}/share/$s; then'
        shares = '{shares} cp -a {install}/share/$s {ti}/share/;'
        shares = '{shares} fi; done'
        steps.push[ 'cd {fp}/build && {shares}' ]
        ob : '{install}/share/silver-os-bootstrap'
        steps.push[ 'mkdir -p {ti}/share/silver-os-bootstrap' ]
        steps.push[ 'cp -a {ob}/images {ti}/share/silver-os-bootstrap' ]
        icd : '{ti}/share/vulkan/icd.d/freedreno_icd.aarch64.json'
        steps.push[ 'sed -i "s|{fp}/lib|{root}/install/lib|" {icd}' ]
        km : '{kd}/kmods/lib/modules'
        ul : '{st}/usr/lib'
        steps.push[ 'mkdir -p {ul}/modules {ul}/firmware' ]
        steps.push[ 'cp -a {km}/. {ul}/modules/' ]
        steps.push[ 'cp -r {kd}/firmware/. {ul}/firmware/' ]
        # postmarketOS's own folder (the GPU's sqe and gmu): this
        # kernel looks for them under qcom/
        pf : '{ul}/firmware/postmarketos'
        steps.push[ 'test ! -d {pf} || cp -rn {pf}/. {ul}/firmware/qcom/' ]
        steps.push[ 'mkdir -p {st}/root' ]
        # the user's games, at their place in the phone's home: the
        # list 0 ended, copied with their folders
        hc : cstr [ getenv[ "HOME" ] ]
        gl : '{work}/games.list'
        if [ hc != null && games_list[ work, gl ] ]
            cg : 'xargs -0 -r -a {gl} cp -a --parents -t {st}/root'
            steps.push[ 'cd "{string[ hc ]}" && {cg}' ]
        steps.push[ 'echo orbiter > {st}/etc/hostname' ]
        # system bus policy for Wi-Fi and the modem
        bus : '{root}/wifi/root/etc/dbus-1/orbiter.conf'
        bd : '{st}/etc/dbus-1'
        steps.push[ 'mkdir -p {bd} && cp {bus} {bd}/' ]
        # the session bus: MMS (mmsd-tng) and the tray on it
        sess : '{root}/tray/root/etc/dbus-1/orbiter-session.conf'
        steps.push[ 'cp {sess} {bd}/' ]
        prep : '{root}/os-bootstrap/modem-prepare.sh'
        ps : '{st}/usr/sbin/orbiter-modem-prepare'
        steps.push[ 'cp {prep} {ps} && chmod 755 {ps}' ]
        steps.push[ 'mkdir -p {st}/var/log' ]
        # RAM boot copies this image to both slots
        bi : '{install}/tmp/phone-fp6/boot.img'
        kept : '{st}/boot/orbiter-boot.img'
        steps.push[ 'mkdir -p {st}/boot && cp {bi} {kept}' ]
        # copy the kernel's audio profiles
        uc : '{kd}/ucm2'
        su : '{st}/usr/share/alsa/ucm2'
        uk : '(mkdir -p {su} && cp -a {uc}/. {su}/)'
        steps.push[ 'test ! -d {uc} || {uk}' ]
        # Catcrafts imsd carries its own libraries
        ex : '{install}/share/silver-os-bootstrap/phone-extra'
        steps.push[ 'test ! -d {ex} || cp -a {ex}/. {st}/' ]
        if [ !run_steps[ steps ] ] return ''
        # the tree and a fifth more, a quarter GB to grow in
        mb : 's=$(du -sm {st} | cut -f1)'
        steps.push[ '{mb}; truncate -s $((s * 6 / 5 + 256))M {img}' ]
        mk : 'mke2fs -q -t ext4 -b 4096 -U {uuid} -L orbiter-phone'
        steps.push[ '{mk} -E root_owner=0:0 -d {st} {img}' ]
        steps.push[ 'rm -rf {st}' ]
        if [ !run_steps[ steps ] ] return ''
        say[ 'rootfs.img: {file_bytes[ img ]} bytes' ]
        return img

    # the user's games, as paths under their home, 0 ended in a list
    # file; false when there is no home or no list was written
    func games_list [ work: string, gl: string ] -> bool
        wd : path [ work ]
        wd.make_dir[]
        games : vec string game_files[]
        gf : handle fopen[ gl.chars, 'w' ]
        if [ !gf ] return false
        for [ g: string ] in games
            fputs[ g.chars, gf ]
            fputc[ 0, gf ]
        fclose[ gf ]
        say[ 'games from your home: {games.count} files' ]
        return true

    # a size as the bootloader says it: hex with 0x, else decimal
    func var_bytes [ v: string ] -> i64
        if [ v.starts_with[ '0x' ] ]
            return hex_value[ v.mid[ 2, v.count - 2 ] ]
        return v.integer_value[]

    func file_bytes [ f: string ] -> i64
        st : struct stat
        if [ stat[ f.chars, @st ] != 0 ] return 0
        return st.st_size

    func hex_value [ h: string ] -> i64
        digits : '0123456789abcdef'
        v : i64 [ 0 ]
        for [ i: i32 0, i < h.count, i += 1 ]
            ch : h.mid[ i, 1 ]
            d : i32 [ digits.index_of[ ch ] ]
            if [ d < 0 ] d = '0123456789ABCDEF'.index_of[ ch ]
            if [ d < 0 ] return 0
            v = v * 16 + d
        return v

    # silver's files as they are on disk, 0 ended: committed and
    # new ones (.gitignore's left out), none deleted; with a stamp,
    # only those newer than it
    func source_files [ newer: string ] -> string
        ls : 'git ls-files -z -co --exclude-standard'
        keep : '[ -e "$f" ]'
        if [ newer.count > 0 ] keep = '{keep} && [ "$f" -nt {newer} ]'
        pick : 'while IFS= read -r -d "" f; do'
        pick = '{pick} {keep} && printf "%s\\0" "$f"; done'
        return '{ls} | bash -c \'{pick}\''

    # when the phone last took the shell (its install or update)
    func phone_stamp [] -> string
        return '{install}/tmp/phone-fp6.synced'

    # orbiter-os's shell port on the phone (its second USB serial
    # port, interface 2); '' when none
    func phone_shell_port [] -> string
        q : 'for t in /sys/class/tty/ttyACM*; do d=$t/device; '
        q = '{q}id=$(cat $d/../idVendor 2>/dev/null):'
        q = '{q}$(cat $d/../idProduct 2>/dev/null):'
        q = '{q}$(cat $d/bInterfaceNumber 2>/dev/null); '
        q = '{q}[ "$id" = "1d6b:0104:02" ] && '
        q = '{q}echo /dev/${{t##*/}}; done'
        run : command [ q ]
        fh : handle run.stream[]
        if [ !fh ] return ''
        b : local i8 [ 256 ]
        out : string ''
        if [ fgets[ @b[0], 256, fh ] ] out = string [ @b[0] ]
        pclose[ fh ]
        return out.trim[]

    # the shell as it is now onto a phone running orbiter-os, over
    # its shell port: only what changed since it last took one
    # fastboot/libusb are not needed: the phone stays running
    func phone_update [] -> bool
        port : phone_shell_port[]
        if [ port.count == 0 ]
            say[ 'orbiter-os is not running on a connected phone' ]
            return false
        if [ !phone_udev[] ] return false
        if [ !phone_shell[] ]
            say[ 'orbiter did not build for the phone' ]
            return false
        stamp : phone_stamp[]
        sp : path stamp
        if [ !sp.exists[] ]
            say[ 'No install recorded for this phone: Install it first' ]
            return false
        work : '{install}/tmp/phone-fp6'
        tb : '{work}/update.tar'
        fp : '{root}/platform/fp6'
        rt : root.mid[ 1, root.count - 1 ]
        since : '-newer {stamp}'
        # each group in its place on the phone, as phone_rootfs lays it
        tr : 'tar -rf {tb} --null -T -'
        sf : source_files[ stamp ]
        pk : '{fp}/debs.txt'
        nd : '{work}/debs'
        nl : '{work}/debs-new.txt'
        ar : '{root}/platform/native/bin/llvm-ar'
        ub : 'http://ports.ubuntu.com/ubuntu-ports'
        mf : 'os-bootstrap/modem-prepare.sh'
        steps : vec string []
        steps.push[ command {
            mkdir -p {work} && rm -f {tb} } ]
        steps.push[ command { touch {stamp}.next } ]
        steps.push[ command { cd {root} && {sf}
            | {tr} --transform "s,^,{rt}/," } ]
        steps.push[ command { cd {fp}/build
            && find . -maxdepth 1 {since} \( -name orbiter
                -o -name "libsilver-*.so" -o -name "silver-*.source" \)
                -print0
            | {tr} --transform "s,^\.,{rt}/install/build," } ]
        # every app's launcher (a name with no dot), whatever its age:
        # the phone runs an app through it
        steps.push[ command { cd {fp}/build
            && find . -maxdepth 1 -type f -perm -u+x ! -name "*.*"
                -print0
            | {tr} --transform "s,^\.,{rt}/install/build," } ]
        # every built module's share (fonts, images: mostly links into
        # silver's files), as Install lays them; os-bootstrap's stays;
        # all once, then only what changed (.shares marks it); S: a
        # link keeps its target
        steps.push[ command { cd {fp}/build
            && for p in silver-*.product; do m=$(basename $p .product);
                test $m = silver-os-bootstrap && continue;
                test -d {install}/share/$m && echo $m;
                s=${{m#silver-}}; if test -d {install}/share/$s;
                then echo $s; fi; done > {work}/shares } ]
        steps.push[ command { cd {install}/share
            && find $(cat {work}/shares)
                $(test -f {stamp}.shares && echo {since}) ! -type d
                -print0
            | {tr} --transform "s,^,{rt}/install/share/,S" } ]
        # what those links point to in silver's folder that git does
        # not track (a module's downloaded maps; not its reference
        # sources): all once, then only what changed (.links marks it)
        steps.push[ command { cd {install}/share
            && find $(cat {work}/shares) -type l -print0
            | xargs -0 -r readlink -f | grep "^{root}/"
            | grep -v "/reference/"
            | sed "s,^{root}/,," | sort -u > {work}/targets
            && cd {root} && git ls-files > {work}/tracked
            && grep -vxFf {work}/tracked {work}/targets
            | while read f; do test -f "$f" || continue;
                test -f {stamp}.links && test ! "$f" -nt {stamp}.links
                && continue; printf "%s\0" "$f"; done
            | {tr} --transform "s,^,{rt}/," } ]
        # the user's games, in the phone's home as Install puts them:
        # all once, then those changed since (.games marks it)
        hc : cstr [ getenv[ "HOME" ] ]
        gl : '{work}/games.list'
        if [ hc != null && games_list[ work, gl ] ]
            gn : '$(test -f {stamp}.games && echo -N {stamp}.games)'
            steps.push[ command { cd "{string[ hc ]}"
                && tar -rf {tb} --null -T {gl} {gn}
                    --transform "s,^,root/," } ]
        # every built app's export record: its props (orbiter hosts
        # it) and what its view needs (system_bus, mms)
        steps.push[ command { cd {fp}/build
            && for p in silver-*.product; do m=$(basename $p .product);
                test -f {install}/export/$m.agi && echo $m.agi;
                test -f {install}/export/$m.props.agi
                && echo $m.props.agi; done
            | (cd {install}/export && tar -rf {tb} -T -
                --transform "s,^,{rt}/install/export/,") } ]
        # every app's build stamp, else the phone builds it again
        steps.push[ command { cd {fp}/build
            && find . -maxdepth 1 -name "silver-*.product" -print0
            | {tr} --transform "s,^\.,{rt}/install/build,"
                --transform "s,^{fp}/build,/{rt}/install/build," } ]
        # the headers (ours, then the phone's own) and git's CAs; all
        # of them the first time (the phone had none)
        hs : '$(test -f {stamp}.inc && echo -newer {stamp}.inc)'
        steps.push[ command { cd {install}/include
            && find -L . {hs} -type f -print0
            | {tr} -h --transform "s,^\.,{rt}/install/include," } ]
        steps.push[ command { cd {fp}/include
            && find -L . {hs} -type f -print0
            | {tr} -h --transform "s,^\.,{rt}/install/include," } ]
        ca : '/etc/ssl/certs/ca-certificates.crt'
        steps.push[ command {
            tar -rf {tb} -h -P --transform "s,^/,," {ca} } ]
        steps.push[ command { cd {root}
            && find .git {hs} ! -type d -print0
            | {tr} --transform "s,^,{rt}/," } ]
        # the imports' build stamps, then libraries and programs
        steps.push[ command { cd {fp}/build
            && find . -name silver-token -print0
            | {tr} --transform "s,^\.,{rt}/install/build," } ]
        steps.push[ command { cd {fp}/lib
            && find . {since} ! -type d ! -name "*.a" ! -name "*.la"
                -print0
            | {tr} --transform "s,^\.,{rt}/install/lib," } ]
        steps.push[ command { cd {fp}/bin
            && find . {since} ! -type d -print0
            | {tr} --transform "s,^\.,{rt}/install/bin," } ]
        # packages fp6.agi gained since the phone was written; /lib,
        # /bin, /sbin are links into /usr there, as here
        steps.push[ command { test -f {stamp}.debs
            && sort {stamp}.debs > {nl}.was
            && sort {pk} | comm -13 {nl}.was - > {nl} || : > {nl} } ]
        steps.push[ command {
            rm -rf {nd} && mkdir -p {nd}/root && cd {nd}
            && for d in lib bin sbin; do mkdir -p root/usr/$d
                && ln -s usr/$d root/$d; done
            && for f in $(cat {nl}); do
                curl -sfL {ub}/$f -o p.deb
                && {ar} x p.deb $({ar} t p.deb | grep data.tar)
                && tar --keep-directory-symlink -xf data.tar.* -C root
                && rm -f data.tar.* p.deb || exit 1; done;
            rm -f root/lib root/bin root/sbin } ]
        steps.push[ command { cd {nd}/root
            && find . ! -type d -print0 | {tr} } ]
        # the boot's modem script (it sets the clock from the network)
        mp : 's,^{mf},usr/sbin/orbiter-modem-prepare,'
        steps.push[ command {
            cd {root} && tar -rf {tb} --mode=0755
                --transform "{mp}" {mf} } ]
        steps.push[ command {
            test -f {tb} || tar -cf {tb} -T /dev/null } ]
        if [ !run_steps[ steps ] ] return false
        say[ 'Sending {file_bytes[ tb ]} bytes of changes to the phone' ]
        # 4 MB pieces, each taken whole into a file on the phone and
        # said so before the next (a stall stops at one piece); each
        # said on the phone's bar (orbiter-note.sh). The port becomes
        # this shell's terminal: grep reads it from the foreground.
        # written, orbiter-apply.sh (in the same tar) unpacks it: live
        # when no library under orbiter changed, else the phone
        # restarts (orbiter is pid 1); reboot(2) by perl, arm64's 142
        pd : '{work}/pieces'
        uf : '/root/.update.tar'
        nt : 'sh /{rt}/os-bootstrap/orbiter-note.sh'
        ap : '{rt}/os-bootstrap/orbiter-apply.sh'
        rb : 'perl -e \\"syscall(142,0xfee1dead,672274793,0x1234567)\\"'
        # what the phone's shell runs: one line each (a quoted string
        # in a block keeps its line breaks, so these have none)
        pc : command { {nt} $((i+1)) $k 2>/dev/null;
            stty raw -echo; head -c $m | base64 -d $op {uf}
            && echo OK-\$((40+2)) || echo FAIL-\$((40+2)); stty sane }
        fin : command { tar -x -C / -f {uf} {ap};
            sh /{ap} {uf}; a=\$?; rm -f {uf}; sync;
            ({nt} done 2>/dev/null; true);
            [ \$a = 0 ] && echo LIVE-\$((40+2));
            [ \$a = 1 ] && echo DONE-\$((40+2)) && sleep 1 && {rb};
            [ \$a -gt 1 ] && echo FAIL-\$((40+2)) }
        go : command {
            rm -rf {pd} && mkdir -p {pd}
            && split -b 4M -d -a 4 {tb} {pd}/p
            && k=$(ls {pd} | wc -l); i=0;
            stty -F {port} raw -echo; exec 3<>{port};
            printf "\025\r" >&3; sleep 1;
            for f in {pd}/p*; do m=$(base64 -w0 $f | wc -c);
                op=">>"; [ $i = 0 ] && op=">";
                printf "{pc}\r" >&3;
                sleep 0.3; base64 -w0 $f >&3;
                r=$(timeout --foreground 60 grep -a -m1 -o
                    "OK-42\|FAIL-42" <&3); i=$((i+1));
                echo "phone: piece $i of $k: $r";
                [ "$r" = OK-42 ] || exit 1; done;
            printf "{fin}\r" >&3;
            r=$(timeout --foreground 900 grep -a -m1 -o
                "LIVE-42\|DONE-42\|FAIL-42" <&3);
            echo "phone: $r"; [ "$r" != FAIL-42 ] && [ -n "$r" ] }
        if [ !sh[ go ] ]
            say[ 'The phone did not take the update' ]
            return false
        if [ !sh[ 'mv {stamp}.next {stamp}' ] ] return false
        sh[ 'touch -r {stamp} {stamp}.inc' ]
        sh[ 'cp {pk} {stamp}.debs' ]
        sh[ 'touch {stamp}.shares' ]
        sh[ 'touch {stamp}.links' ]
        sh[ 'touch {stamp}.games' ]
        say[ 'Updated: orbiter takes it live, or the phone restarts' ]
        return true

    # orbiter-os's USB serial port, once the phone has booted: its
    # log said here and kept in install/tmp/phone-<product>.log
    func phone_serial [ product: string ] -> bool
        say[ 'Waiting for the phone\'s log on USB' ]
        up : '$t/device/..'
        find : 'for t in /sys/class/tty/ttyACM*; do '
        find = '{find}v=$(cat {up}/idVendor 2>/dev/null); '
        find = '{find}p=$(cat {up}/idProduct 2>/dev/null); '
        find = '{find}test "$v:$p" = "1d6b:0104" '
        find = '{find}&& echo /dev/$(basename $t); done'
        lg : '{install}/tmp/phone-{product}.log'
        wait : 'for i in $(seq 120); do d=$({find} | head -1); '
        wait = '{wait}test -n "$d" && break; sleep 1; done'
        cat : 'test -n "$d" && stty -F $d raw -echo'
        cat = '{cat} && timeout 120 cat $d | tee {lg}'
        ok : sh[ '{wait}; {cat}; test -n "$d"' ]
        if [ !ok ] say[ 'No log port came up in two minutes' ]
        return ok

    # one kernel: download, configure, make, its modules, then
    # nvidia's beside them; kernels/<name> when it worked
    public func build_kernel [ hw: string, ver: string, nv: string,
                               amd: string, intel: string ] -> bool
        if [ ver.count == 0 ] return false
        if [ hw == 'Fairphone 6' ] return build_fairphone[ ver ]
        surface : bool [ hw == 'Surface' ]
        apple : bool [ hw == 'Apple' ]
        arm : bool [ hw == 'ARM64' || apple ]
        # nvidia's modules and Intel's graphics: PCs only; AMD's
        # cards: not in a Mac
        pc : bool [ hw == 'x64' || surface ]
        gpu : string [ (pc) ? nv : 'none' ]
        # a one-letter literal is a character: 'n/a', not '-'
        igpu : string [ (pc) ? intel : 'n/a' ]
        dgpu : string [ (apple) ? 'n/a' : amd ]
        tag : string [ (surface) ? '-surface' : (apple) ? '-asahi'
                       : (arm) ? '-arm64' : '' ]
        base : '{ver}{tag}'
        nm : string [ (gpu == 'none') ? base : '{base}-nvidia{gpu}' ]
        if [ dgpu == 'none' ] nm = '{nm}-noamd'
        if [ igpu == 'none' ] nm = '{nm}-nointel'
        # arm64 is built by our own LLVM; x86 by the system's gcc.
        # Asahi's GPU driver is Rust: rustc from the user's rustup,
        # bindgen on our libclang
        mk : string [ (arm) ? 'ARCH=arm64 LLVM={install}/bin/' : '' ]
        cargo : 'PATH=$HOME/.cargo/bin:$PATH'
        pre : string [ (apple)
            ? 'env {cargo} LIBCLANG_PATH={install}/lib ' : '' ]
        cfg : string [ (arm) ? 'linux-arm64.config' : 'linux.config' ]
        kimg : string [ (arm) ? 'Image' : 'bzImage' ]
        kpath : string [ (arm) ? 'arch/arm64/boot/Image'
                               : 'arch/x86/boot/bzImage' ]
        out : '{share[]}/kernels/{nm}'
        kroot : '{install}/build'
        steps : vec string []
        # each step's shell first runs this (a Mac's tools)
        kenv : string ''
        ifdef [ apple ]
            if [ !arm ]
                say[ 'An x64 kernel is built on Linux for now' ]
                return false
            # the tree needs case: a case-sensitive volume, made once
            kroot = '{install}/build/kernels'
            img : '{kroot}.sparseimage'
            fs : '-fs "Case-sensitive APFS" -volname orbiter-kernels'
            made : 'hdiutil create -size 200g -type SPARSE {fs} {kroot}'
            att : 'hdiutil attach -nobrowse -mountpoint {kroot} {img}'
            on : 'mount | grep -q " on {kroot} "'
            # now: the Asahi tree is unpacked onto it before the steps
            if [ !sh[ '{on} || ((test -f {img} || {made}) && {att})' ] ]
                return false
            # GNU's tools first, OpenSSL, the SDK for our clang
            kh : '{install}/kernel-host'
            kenv = 'export PATH={kh}/bin:$HOME/.cargo/bin:$PATH'
            kenv = '{kenv} PKG_CONFIG_PATH={kh}/lib/pkgconfig'
            kenv = '{kenv} SDKROOT=$(xcrun --show-sdk-path); '
        bd : '{kroot}/linux-{base}'
        if [ apple ]
            # Asahi's tree, its asahi branch at its newest commit
            bd = unpacked[ github_tarball[ 'AsahiLinux/linux', 'asahi',
                'asahi-linux-' ], 'asahi-linux-', kroot ]
            if [ bd.count == 0 ] return false
            steps.push[ '{cargo} rustup component add rust-src' ]
            bg : 'cargo install --locked --root {install} bindgen-cli'
            bgx : '{install}/bin/bindgen'
            steps.push[ 'test -x {bgx} || ({cargo} {bg})' ]
        el
            major : ver.mid[ 0, ver.index_of[ '.' ] ]
            kurl : 'https://cdn.kernel.org/pub/linux/kernel/v{major}.x'
            stem : 'linux-{ver}.tar.xz'
            tarball : fetch[ stem, '{kurl}/{stem}' ]
            if [ tarball.count == 0 ] return false
            unpack : 'tar xf {tarball} -C {bd} --strip-components=1'
            made : 'mkdir -p {bd} && {unpack}'
            steps.push[ 'test -f {bd}/Makefile || ({made})' ]
        ifdef [ apple ]
            # Linux headers the host programs take: ours, musl's,
            # and last the tree's own (a Linux host's /usr/include)
            mh : '{root}/os-bootstrap/mac-host'
            hc : '-I{kh}/include -I{mh} -D_UUID_T -D__GETHOSTUUID_H'
            hc = '{hc} -include {mh}/linux-host.h'
            hc = '{hc} -idirafter {bd}/include/uapi'
            kl : 'HOSTLDFLAGS=-Wl,-rpath,{kh}/lib'
            mk = '{mk} "HOSTCFLAGS={hc}" {kl}'
        # its series, x.y
        d1 : i32 [ i32[ ver.index_of[ '.' ] ] ]
        tail : ver.mid[ d1 + 1, ver.count - d1 - 1 ]
        d2 : i32 [ i32[ tail.index_of[ '.' ] ] ]
        ser : string [ (d2 < 0) ? ver : ver.mid[ 0, d1 + 1 + d2 ] ]
        ls : string [ (surface) ? surface_source[] : '' ]
        if [ surface && ls.count == 0 ] return false
        if [ surface ]
            # linux-surface's patches in order, as they ship them; one
            # already in this release is passed by, any other must
            # fit exactly (no fuzz)
            pd : '{ls}/patches/{ser}'
            have : 'patch -p1 -R -s -f --dry-run -F0 < $p > /dev/null'
            put : 'patch -p1 -N -s -F0 < $p || exit 1'
            one : 'if {have} 2>&1; then echo "already in: $p"; '
            one = '{one}else {put}; fi'
            loop : 'cd {bd} && for p in {pd}/*.patch; do {one}; done'
            done : '{loop} && touch .surface-patched'
            steps.push[ 'test -f {bd}/.surface-patched || ({done})' ]
        # orbiter-os's config: drivers for the hardware out there
        steps.push[ 'cp {root}/os-bootstrap/{cfg} {bd}/.config' ]
        # a hardware line's own fragment over it
        frag : string [ (surface) ? '{ls}/configs/surface-{ser}.config'
            : (apple) ? 'arch/arm64/configs/asahi.config' : '' ]
        if [ frag.count > 0 ]
            mc : 'scripts/kconfig/merge_config.sh -m .config {frag}'
            steps.push[ 'cd {bd} && {mc}' ]
        words : config_words[ dgpu, igpu, surface, apple ]
        steps.push[ '{bd}/scripts/config --file {bd}/.config{words}' ]
        steps.push[ '{pre}make -C {bd} {mk} -j16 olddefconfig' ]
        if [ apple ]
            # without Rust there is no GPU driver: stop, saying why
            rv : 'grep -q "^CONFIG_RUST=y" {bd}/.config'
            ra : '{pre}make -C {bd} {mk} rustavailable'
            steps.push[ '{rv} || ({ra}; exit 1)' ]
        tg : '{kimg} modules'
        if [ apple ] tg = '{tg} dtbs'
        steps.push[ '{pre}make -C {bd} {mk} -j16 {tg}' ]
        # into .part: the kernel it replaces stays until the end
        part : '{out}.part'
        steps.push[ 'rm -rf {part} && mkdir -p {part}' ]
        mi : 'INSTALL_MOD_PATH={part}/kmods INSTALL_MOD_STRIP=1'
        steps.push[ '{pre}make -C {bd} {mk} modules_install {mi}' ]
        steps.push[ 'cp {bd}/{kpath} {part}/{kimg}' ]
        # the stick's /init for arm64, on the kernel's own nolibc
        if [ arm ]
            hi : '{bd}/usr-arm64'
            hm : '{pre}make -C {bd} {mk} headers_install'
            steps.push[ '{hm} INSTALL_HDR_PATH={hi}' ]
            nl : '{bd}/tools/include/nolibc'
            ic : '{install}/bin/clang -target aarch64-linux-gnu -static'
            ic = '{ic} -nostdlib -nostdinc -ffreestanding -Os'
            ic = '{ic} -fno-stack-protector -fuse-ld=lld -I{nl}'
            ic = '{ic} -I{hi}/include -include {nl}/nolibc.h'
            ini : '{root}/os-bootstrap/init.c'
            steps.push[ '{ic} -o {part}/init {ini}' ]
        # m1n1 hands the kernel its Mac's device tree
        if [ apple ]
            dt : '{bd}/arch/arm64/boot/dts/apple'
            dc : 'cp {dt}/*.dtb {part}/dtbs/'
            steps.push[ 'mkdir -p {part}/dtbs && {dc}' ]
        for [ st: string ] in steps
            say[ '$ {st}' ]
            if [ !sh[ '{kenv}{st}' ] ] return false
        if [ gpu != 'none' ]
            gh : 'https://github.com/NVIDIA/open-gpu-kernel-modules'
            rels : '{gh}/archive/refs/tags'
            ntar : fetch[ '{nv}.tar.gz', '{rels}/{nv}.tar.gz' ]
            if [ ntar.count == 0 ] return false
            nb : '{install}/build/nvidia-{nm}'
            mods : 'nvidia nvidia-modeset nvidia-drm'
            nsteps : vec string []
            nu : 'tar xf {ntar} -C {nb} --strip-components=1'
            nmade : 'mkdir -p {nb} && {nu}'
            nsteps.push[ 'test -d {nb}/kernel-open || ({nmade})' ]
            nm2 : 'NV_KERNEL_MODULES=\'{mods}\''
            src2 : 'SYSSRC={bd} SYSOUT={bd}'
            nsteps.push[ 'make -C {nb} -j16 modules {src2} {nm2}' ]
            rel : 'K=$(make -s -C {bd} kernelrelease)'
            ex : 'E={part}/kmods/lib/modules/$K/extra'
            ko : '{nb}/kernel-open'
            kos : '{ko}/nvidia.ko {ko}/nvidia-modeset.ko'
            kos = '{kos} {ko}/nvidia-drm.ko'
            cp : 'mkdir -p $E && cp {kos} $E/'
            dm : 'depmod -b {part}/kmods $K'
            nsteps.push[ '{rel} && {ex} && {cp} && {dm}' ]
            for [ st: string ] in nsteps
                say[ '$ {st}' ]
                if [ !sh[ st ] ] return false
        info : 'hardware {hw}\nversion {ver}\nnvidia {gpu}\n'
        info = '{info}amd {dgpu}\nintel {igpu}\n'
        ip : '{part}/build.agi'
        fh : handle fopen[ ip.chars, 'w' ]
        if [ fh ]
            fputs[ info.chars, fh ]
            fclose[ fh ]
        if [ !sh[ 'rm -rf {out} && mv {part} {out}' ] ] return false
        say[ 'Built {nm}' ]
        scan[]
        # the drive tree is x86 until orbiter-os is built for arm64
        if [ pc ] select[ nm ]
        return true

    # the installer stick as an image, built as the user: the
    # stub, the chosen kernel and its boot line on FAT, the tree on
    # ext4 (made with its uuid, for the line); '' when it failed
    public func make_image [] -> string
        kb : stick_kernel[]
        if [ !kb ] return ''
        # an ARM stick: its own stub, Image and /init
        arm : bool [ !on_pc[ kb ] ]
        kimg : string [ (arm) ? 'Image' : 'bzImage' ]
        efi : string [ (arm) ? 'BOOTAA64.EFI' : 'BOOTX64.EFI' ]
        ai : '{kb.dir}/init'
        ap : path [ ai ]
        if [ arm && !ap.exists[] ]
            say[ '{kb.name} has no arm64 /init: build it again' ]
            return ''
        work : image_work[]
        tree : '{out_dir}/root'
        bin  : '{install}/bin'
        img  : '{work}/disk.img'
        uuid : new_uuid[]
        # 512 MB of EFI at 1 MB; the tree after it, room to spare
        tb : i64 [ first_line[ '{tree}/boot/tree-bytes' ].trim[]
            .integer_value[] ]
        mb : i64 [ tb / 1048576 * 115 / 100 + 256 ]
        total : i64 [ 1 + 512 + mb + 1 ]
        off : i64 [ 1050624 * 512 ]
        # the work folders of runs that are gone (3 GB or more each)
        old : 'for d in {install}/tmp/installer-*; do '
        old = '{old}p=$(echo "$d" | sed "s/.*-//"); '
        old = '{old}kill -0 $p 2>/dev/null || rm -rf "$d"; done'
        old_cmd : command [ old ]
        old_cmd.exec[ false ]
        if [ !sh[ 'rm -rf {work} && mkdir -p {work}/stage' ] ] return ''
        image_bytes = total * 1048576
        free : i64 [ disk_free[ work ] / 1048576 ]
        if [ free < total ]
            say[ 'Not enough room on this computer\'s disk: the ' +
                 'image needs {total} MB, {free} MB is free' ]
            wipe[ work ]
            return ''
        # the boot line: this stick's tree, in install mode; with
        # answers, unattended and with no screen
        line : 'initrd=\\EFI\\orbiter\\initramfs console=tty0'
        line = '{line} orbiter.uuid={uuid} orbiter.root=/'
        line = '{line} orbiter.args=--install,true'
        ans : bool [ stick_answers && stick_answers.count > 0 ]
        if [ ans ]
            line = '{line},--answers,/boot/install-answers.agi'
            line = '{line},--trinity.text_mode,true'
            # no screen: what it says goes to the serial line
            line = '{line} console=ttyS0,115200'
        nv : bool [ kb.nvidia != 'none' ]
        line = '{line} {os_words[ arm, nv ]}'
        if [ !write_file[ '{work}/cmdline.txt', '{line}\n' ] ]
            return ''
        # the stick's initramfs: the drive's /init, or arm64's
        init : string [ (arm) ? ai : '{out_dir}/init' ]
        rd : path '{work}/initramfs'
        write_cpio[ boot_files[ init ], rd ]
        tgt : string [ (arm) ? 'aarch64' : 'x86_64' ]
        cc : '{bin}/clang -target {tgt}-unknown-windows -ffreestanding'
        cc = '{cc} -fno-stack-protector -O2'
        if [ !arm ] cc = '{cc} -mno-red-zone'
        ld : '{bin}/lld-link -subsystem:efi_application -entry:efi_main'
        mt : 'MTOOLS_SKIP_CHECK=1'
        at : '-i {img}@@1M'
        fat : '-F -v ORBITER -T 1048576 -h 64 -s 32'
        to : '::EFI/orbiter/'
        # the drive tree, linked, its kernel parts left out: the
        # chosen kernel's go in their place (the tree is not touched)
        skip : '-path ./root/.cache -o -path ./lib/modules'
        skip = '{skip} -o -path ./boot/vmlinuz'
        stage : 'find . \\( {skip} -o -path ./boot/initramfs \\) -prune'
        # names apart by a nul: a name may hold any byte
        stage = '{stage} -o -print0'
        km : '{kb.dir}/kmods/lib/modules/{kb.release}'
        # the user's ssh keys, when asked: the install offers them
        carry : 'true'
        if [ stick_keys && ssh_keys[] > 0 ]
            carry = ssh_copy_sh[ quoted[ ssh_dir[] ],
                                 quoted[ '{work}/stage/root/.ssh' ] ]
        # the disk, then its table (disk_gpt), then what is on it
        steps : vec string [] [
            '{cc} -c {root}/os-bootstrap/efistub.c -o {work}/stub.o',
            '{ld} -nodefaultlib -out:{work}/{efi} {work}/stub.o',
            '(cd {tree} && {stage} | cpio -0pdlm --quiet {work}/stage)',
            'mkdir -p {work}/stage/lib/modules',
            'cp -al {km} {work}/stage/lib/modules/',
            'ln {kb.dir}/{kimg} {work}/stage/boot/vmlinuz',
            'ln {work}/initramfs {work}/stage/boot/initramfs',
            carry,
            (ans) ? 'cp {quoted[ stick_answers ]} ' +
                '{work}/stage/boot/install-answers.agi' : 'true',
            # this machine's public keys (never the private ones): the
            # installed user trusts them, so we reach it by ssh
            (ans) ? '(cat {quoted[ ssh_dir[] ]}/*.pub ' +
                '> {work}/stage/boot/install-authorized_keys ' +
                '2>/dev/null; true)' : 'true',
            'truncate -s {total}M {img}' ]
        fill : vec string [] [
            '{mt} {bin}/mformat {at} {fat} ::',
            '{mt} {bin}/mmd {at} ::EFI ::EFI/BOOT ::EFI/orbiter',
            '{mt} {bin}/mcopy {at} {work}/{efi} ::EFI/BOOT/',
            '{mt} {bin}/mcopy {at} {kb.dir}/{kimg} {to}vmlinuz.efi',
            '{mt} {bin}/mcopy {at} {work}/initramfs {to}',
            '{mt} {bin}/mcopy {at} {work}/cmdline.txt {to}',
            'mke2fs -q -t ext4 -F -U {uuid} -L orbiter-usb ' +
                '-E offset={off} -d {work}/stage {img} {mb}M',
            'rm -rf {work}/stage' ]
        # a Mac: GNU's cp and truncate, e2fsprogs' mke2fs
        tools : string ''
        ifdef [ apple ]
            kh : '{install}/kernel-host'
            tools = 'export PATH={kh}/bin:{kh}/sbin:$PATH; '
        n : i32 [ steps.count + fill.count ]
        for [ i: i32 0, i < n, i += 1 ]
            st : string [ (i < steps.count) ? steps[ i ]
                : fill[ i - steps.count ] ]
            say[ '$ {st}' ]
            if [ !sh[ '{tools}{st}' ] ]
                wipe[ work ]
                return ''
            if [ i == steps.count - 1 ]
                if [ disk_gpt[ img.chars, total * 2048, 1048576 ] == 0 ]
                    say[ 'The partition table could not be written' ]
                    wipe[ work ]
                    return ''
            progress = image_share * f32[ i + 1 ] / f32[ n ]
        say[ 'Image ready: {total} MB, boot line in EFI/orbiter' ]
        return img

    # a fresh uuid, lower case: the kernel's, else uuidgen's
    func new_uuid [] -> string
        u : first_line[ '/proc/sys/kernel/random/uuid' ].trim[]
        if [ u.count > 0 ] return u
        q : command { uuidgen | tr A-Z a-z }
        fh : handle q.stream[]
        b : local i8 [ 64 ]
        if [ fh && fgets[ @b[0], 64, fh ] ] u = string [ @b[0] ]
        if [ fh ] pclose[ fh ]
        return u.trim[]

    # this process's own image folder: two writes never share one
    public func image_work [] -> string
        return '{install}/tmp/installer-{getpid[]}'

    # gone, cancelled or not (sh stops once cancelled)
    func wipe [ f: string ]
        rm_cmd : command { rm -rf {quoted[ f ]} }
        rm_cmd.exec[ false ]

    # made by Cancel: the root shell writing a stick watches it
    func cancel_file [] -> string
        return '{install}/tmp/installer-cancel-{getpid[]}'

    # bytes free on the file system holding dir
    func disk_free [ dir: string ] -> i64
        st : struct statvfs
        if [ statvfs[ dir.chars, @st ] != 0 ] return -1
        return i64[ st.f_bavail ] * i64[ st.f_frsize ]

    func write_file [ f: string, text: string ] -> bool
        fh : handle fopen[ f.chars, 'w' ]
        if [ !fh ] return false
        fputs[ text.chars, fh ]
        return fclose[ fh ] == 0

    # the image onto the chosen stick: root through pkexec, once
    public func write_installer [] -> bool
        dv : string [ want_drive ]
        if [ !dv || dv.count == 0 ] return false
        # one writer a stick: a second one crawls both
        busy : 'pgrep -f "dd if=.* of=/dev/{dv}[ ]" >/dev/null'
        busy_cmd : command [ busy ]
        if [ busy_cmd.exec[ false ] == 0 ]
            say[ 'A write to /dev/{dv} is still running' ]
            return false
        progress = 0.0
        # a cancel file left behind would stop this write at once
        wipe[ cancel_file[] ]
        img : make_image[]
        if [ img.count == 0 ] return false
        say[ 'Writing to /dev/{dv}: the system asks for your password' ]
        un : 'for p in /dev/{dv}?*; do umount $p 2>/dev/null; done'
        # straight to the stick, so the count is what it holds
        dd : 'dd if={img} of=/dev/{dv} bs=4M oflag=direct'
        dd = '{dd} conv=fsync status=progress'
        ifdef [ apple ]
            # the raw device skips the buffer cache (oflag's work)
            un = 'diskutil unmountDisk /dev/{dv}'
            dd = 'dd if={img} of=/dev/r{dv} bs=4m status=progress'
        # dd runs as root, out of Cancel's reach: the root shell
        # stops it when the cancel file appears, or this app is gone
        cf : cancel_file[]
        wt : 'while kill -0 $p 2>/dev/null; do '
        wt = '{wt}( [ -e {cf} ] || ! kill -0 {getpid[]} ) && '
        wt = '{wt}kill $p; sleep 0.5; done; wait $p'
        as_root : '{un}; {dd} & p=$!; {wt} && sync'
        ok : bool [ false ]
        ifdef [ apple ]
            ok = sh_copy[ mac_root[ as_root ] ]
        ifndef [ apple ]
            ok = sh_copy[ 'pkexec sh -c {quoted[ as_root ]}' ]
        if [ ok ] progress = 1.0
        wipe[ image_work[] ]
        wipe[ cf ]
        if [ ok ] say[ 'The installer is on /dev/{dv}.' ]
        if [ cancelled ] say[ 'The stick is only partly written.' ]
        return ok

    # a Mac's root: macOS's password prompt runs the script, its
    # dd counts (written to a file there) read back once a second
    func mac_root [ as_root: string ] -> string
        work : image_work[]
        lg : '{work}/dd.log'
        ap : 'do shell script "sh {work}/root.sh 2> {lg}"'
        ap = '{ap} with administrator privileges'
        rd : string {
            osascript {work}/root.scpt & o=$!
            while kill -0 $o 2>/dev/null; do
              tail -c 300 {lg} 2>/dev/null | tr '\r' '\n' | tail -1
              sleep 1
            done
            wait $o
        }
        if [ !write_file[ '{work}/root.sh', '{as_root}\n' ]
             || !write_file[ '{work}/root.scpt', '{ap}\n' ]
             || !write_file[ '{work}/root-run.sh', '{rd.trim[]}\n' ] ]
            return 'false'
        return 'sh {work}/root-run.sh'

    # the build, on its own thread: a new kernel, or the tree
    mutable job : string
    # Cancel Build: the command running now, and every one after
    public func cancel []
        if [ !building ] return
        cancelled = true
        say[ 'Cancelling' ]
        if [ job == 'usb' ] write_file[ cancel_file[], '' ]
        pid : i32 [ first_line[ pid_file[] ].trim[].integer_value[] ]
        if [ pid > 1 ] kill[ -pid, SIGTERM ]

    func build_work [] -> none
        if [ job == 'kernel' ]
            failed = !build_kernel[ want_hardware, want_version,
                want_nvidia, want_amd, want_intel ]
        el [ job == 'usb' ]
            failed = !write_installer[]
        el [ job == 'phone' ]
            # phone flashing is fastboot/libusb: not on windows
            ifndef [ windows ]
                failed = !phone_install[]
        el [ job == 'phone_update' ]
            failed = !phone_update[]
        el
            say[ 'Writing the drive tree with {chosen}' ]
            out_dir.make_dir[]
            assemble[]
        parts    = summary[]
        building = false
        if [ cancelled ] failed = true
        say[ (cancelled) ? 'Cancelled.'
            : ((failed) ? 'The build stopped.' : 'Done.') ]
        # a kernel built: back to the list, the new one in it
        if [ job == 'kernel' && !failed && !cancelled ]
            kview    = ''
            show_log = false
        cancelled = false
        Au.auto_free[]

    # a build: 'kernel' from the choices, or 'tree'
    public func start [ what: string ]
        if [ building || !can_build[] ] return
        job       = what
        step      = ''
        if [ what == 'kernel' ]
            sh[ 'mkdir -p {install}/tmp && : > {log_file[]}' ]
        building  = true
        failed    = false
        cancelled = false
        pthread_create[ @tid, null, @build_work, a ]

    public func on_click [ ev: Event ]
        e : cast element [ ev.origin ]
        while [ e && e inherits ListCell ] e = e.parent
        # the one click a write takes: its Cancel
        if [ e && e.id == 'usb_cancel' ]
            cancel[]
            return
        # while a kernel builds: its log, shown or not
        if [ e && e.id == 'log_toggle' ]
            show_log = !show_log
            pristine = false
            return
        if [ !e || !e.id || building ] return
        key : e.id
        if [ key == 'boot_build' ]
            if [ builds_hardware[] ] start[ 'kernel' ]
        el [ key == 'boot_new' ]
            kview = 'build'
        el [ key == 'build_back' ]
            kview    = ''
            show_log = false
        el [ key == 'log_toggle' ]
            show_log = !show_log
        el [ key == 'boot_usb' ]
            usb_view  = true
            drives_at = 0
            phone_at  = 0
        el [ key == 'usb_back' ]
            usb_view = false
            progress = 0.0
        el [ key == 'usb_write' ] start[ 'usb' ]
        el [ key == 'phone_go' ] start[ 'phone' ]
        el [ key == 'phone_update' ] start[ 'phone_update' ]
        el [ key == 'keys_on' ] stick_keys = true
        el [ key == 'keys_off' ] stick_keys = false
        el [ key.starts_with[ 'drv_' ] ]
            nm : key.mid[ 4, key.count - 4 ]
            for [ d: UsbDrive ] in drives
                if [ d.name == nm && d.ok ] want_drive = nm
        el [ key.starts_with[ 'del_' ] ]
            at : i32 [ key.mid[ 4, key.count - 4 ].integer_value[] ]
            if [ at >= 0 && at < kernels.count ]
                remove[ kernels[ at ].name ]
        el [ key.starts_with[ 'kern_' ] ]
            at : i32 [ key.mid[ 5, key.count - 5 ].integer_value[] ]
            if [ at >= 0 && at < kernels.count ]
                pk : KernelBuild kernels[ at ]
                # an ARM kernel lights for the stick only: the
                # drive tree stays x86
                if [ on_pc[ pk ] ] select[ pk.name ]
                el
                    stick = pk.name
                    goes : string [ (pk.hardware == 'Fairphone 6')
                        ? 'goes on the phone' : 'makes an ARM stick' ]
                    say[ 'The drive keeps {chosen}; Write installer ' +
                         '{goes} with {stick}' ]
        el [ key.starts_with[ 'hw_' ] ]
            want_hardware = key.mid[ 3, key.count - 3 ]
            vs : offered[]
            want_version  = (vs.count > 0) ? vs[ 0 ] : ''
        el [ key.starts_with[ 'ver_' ] ]
            want_version = key.mid[ 4, key.count - 4 ]
        el [ key.starts_with[ 'nv_' ] ]
            want_nvidia = key.mid[ 3, key.count - 3 ]
        el [ key.starts_with[ 'amd_' ] ]
            want_amd = key.mid[ 4, key.count - 4 ]
        el [ key.starts_with[ 'in_' ] ]
            want_intel = key.mid[ 3, key.count - 3 ]
        el
            return
        ev.stop[]
        pristine = false
        if [ ux ] ux.restyle = true

    # a built kernel's folder, gone; the tree keeps its own copy
    func remove [ nm: string ]
        if [ nm.count == 0 ] return
        sh[ 'rm -rf {quoted[ '{share[]}/kernels/{nm}' ]}' ]
        say[ 'Removed {nm}' ]
        scan[]

    # the kernel row under the pointer: shift's Remove goes there
    mutable hover_row : i32 [ -1 ]

    public func on_hover [ ev: Event ]
        hover_at[]

    public func on_leave [ ev: Event ]
        hover_at[]

    func hover_at []
        at : i32 [ -1 ]
        for [ h: element* ux.hovered, h, h = h.parent ]
            if [ h.id && h.id.starts_with[ 'kern_' ] ]
                at = h.id.mid[ 5, h.id.count - 5 ].integer_value[]
                break
        if [ at == hover_row ] return
        hover_row = at
        if [ ux.shift ] ux.dirty_tree[ a ]

    # the kernels list: one row a build, the chosen one lit. Remove:
    # on every row with ctrl/cmd held, on the hovered row with shift
    func kernel_els [] -> Elements
        lefts : vec string [] [ 'l0.7 t0 w3.6 b0', 'l4.4 t0 w3.6 b0',
            'l8.1 t0 w4.4 b0', 'l12.6 t0 w4.2 b0', 'l16.9 t0 w3.4 b0',
            'l20.4 t0 w3.4 b0', 'l23.9 t0 r0.7 b0' ]
        rows : Elements []
        for [ i: i32 0, i < kernels.count, i += 1 ]
            kb : KernelBuild kernels[ i ]
            # Remove in the Built column's place
            del : bool [ ux && !building
                && (ux.cmd || (ux.shift && i == hover_row)) ]
            row : vec string [] [ kb.hardware, kb.release,
                '{kb.drivers} drivers', kb.nvidia, kb.amd, kb.intel,
                (del) ? '' : kb.built ]
            cells : list_cells[ row, lefts, false, false ]
            if [ del ]
                cells[ 'del_{i}' ] = BootButton [ label: 'Remove',
                    area: Region { l23.4 t0.15 r0.5 h0.9 } ]
            rows[ 'kern_{i}' ] = ListRow [ selected: kb.name == stick,
                area: Region { l0 t0+ r0 h1.2 }, elements: cells ]
        head : vec string [] [ 'Hardware', 'Kernel', 'Modules',
                               'NVIDIA', 'AMD', 'Intel', 'Built' ]
        unit : f32 [ (fc > 0.0) ? fc : 22.0 ]
        out : Elements []
        out[ 'head' ] = ListHead [ area: Region { l0 t0 r0 h1.1 },
            elements: list_cells[ head, lefts, true, false ] ]
        out[ 'rows' ] = ListRows [ area: Region { l0 t1.1 r0 b0 },
            content_h: f32[ kernels.count ] * 1.2 * unit,
            elements: rows ]
        return out

    # usb and removable drives: the running one and any too small
    # for the tree and its EFI partition are shown, not picked
    func scan_drives []
        drives = vec UsbDrive []
        here : root_disk[]
        tree : first_line[ '{out_dir}/root/boot/tree-bytes' ].trim[]
        efi : i64 [ 512 * 1024 * 1024 ]
        need : i64 [ tree.integer_value[] + efi ]
        ifdef [ apple ]
            mac_drives[ need ]
        ifndef [ apple ]
            sys_drives[ here, need ]
        if [ want_drive ]
            kept : bool [ false ]
            for [ dv: UsbDrive ] in drives
                if [ dv.name == want_drive && dv.ok ] kept = true
            if [ !kept ] want_drive = ''

    # a Mac's: every external physical disk, from diskutil
    func mac_drives [ need: i64 ]
        q : string {
            for d in $(diskutil list external physical |
              awk '$1 ~ "^/dev/disk" {{ sub("/dev/", "", $1); print $1 }}');
            do diskutil info $d | awk -v d=$d -F': *' '/Disk Size/ {{ b = $2; sub(/.*[(]/, "", b); sub(/ Bytes.*/, "", b) }} /Media Name/ {{ m = $2 }} END {{ print d "|" b "|" m }}';
            done
        }
        run : command [ q ]
        fh : handle run.stream[]
        b : local i8 [ 512 ]
        while [ fh && fgets[ @b[0], 512, fh ] ]
            ln : string [ @b[0] ]
            f : ln.trim[].split[ "|" ]
            if [ f.count < 3 ] continue
            n : i64 [ f[ 1 ].integer_value[] ]
            if [ n == 0 ] continue
            dv : UsbDrive [ name: f[ 0 ], bytes: n, model: f[ 2 ] ]
            dv.ok = dv.bytes >= need
            drives.push[ dv ]
        if [ fh ] pclose[ fh ]

    # Linux's: usb and removable block devices
    func sys_drives [ here: string, need: i64 ]
        d : path '/sys/block'
        entries : d.ls[ null, false ]
        if [ !entries ] return
        for [ e: path ] in entries
            nm : e.filename[]
            lk : link_of[ '/sys/block/{nm}' ]
            usb : bool [ lk.index_of[ '/usb' ] >= 0 ]
            rem : bool [ first_line[ '{e}/removable' ].trim[] == '1' ]
            if [ !usb && !rem ] continue
            n : i64 [ first_line[ '{e}/size' ].trim[].integer_value[] ]
            # an empty card reader reports no size
            if [ n == 0 ] continue
            dv : UsbDrive [ name: nm, bytes: n * 512,
                model: first_line[ '{e}/device/model' ].trim[] ]
            dv.ok = nm != here && dv.bytes >= need
            drives.push[ dv ]

    func link_of [ f: string ] -> string
        b : local i8 [ 4096 ]
        n : i64 [ readlink[ f.chars, @b[0], 4095 ] ]
        if [ n <= 0 ] return ''
        b[ n ] = 0
        return string [ @b[0] ]

    # the disk / is on, by the mount table
    func root_disk [] -> string
        fh : handle fopen[ '/proc/self/mountinfo', 'r' ]
        if [ !fh ] return ''
        b : local i8 [ 4096 ]
        num : string ''
        while [ fgets[ @b[0], 4096, fh ] ]
            ln : string [ @b[0] ]
            words : ln.split[ ' ' ]
            if [ words.count > 4 && '{words[4]}' == '/' ]
                num = '{words[2]}'
        fclose[ fh ]
        if [ num.count == 0 ] return ''
        lk : link_of[ '/sys/dev/block/{num}' ]
        pt : path '/sys/dev/block/{num}/partition'
        if [ pt.exists[] ] lk = lk.mid[ 0, lk.rindex_of[ '/' ] ]
        at : i32 [ lk.rindex_of[ '/' ] ]
        return (at >= 0) ? lk.mid[ at + 1, lk.count - at - 1 ] : lk

    func gb [ n: i64 ] -> string
        g : f64 [ f64[ n ] / 1073741824.0 ]
        return '{g.1f} GB'

    # a row of choices: its name, then one button each
    func choices [ t: Elements, y: f32, name: string, pre: string,
                   vals: vec string, cur: string ]
        t[ '{pre}name' ] = BootText [ label: name,
            area: Region [ 'l0 t{y} w4 h0.825' ] ]
        x : f32 [ 4.4 ]
        for [ v: string ] in vals
            t[ '{pre}{v}' ] = Choice [ label: v, selected: v == cur,
                area: Region [ 'l{x} t{y} w3.7 h0.825' ] ]
            x += 3.95

    public func render [] -> Elements
        if [ building ] pristine = false
        t : Elements []
        # a kernel building: what it does now; its log when asked
        if [ building && job == 'kernel' ]
            building_view[ t ]
            return t
        # a new kernel: its choices, then Build or Back
        if [ kview == 'build' && !usb_view ]
            build_view[ t ]
            return t
        # the kernels: the page's most, the two ways on under it
        if [ usb_view && on_phone[] ]
            phone_view[ t ]
            return t
        lh : f32 [ (usb_view) ? 3.8 : 11.0 ]
        t[ 'kernels' ] = ListBox [ elements: kernel_els[],
            area: Region [ 'l0 t0 r0 h{lh}' ] ]
        y : f32 [ lh + 0.5 ]
        if [ usb_view ]
            # sticks come and go: look again every two seconds
            now : i64 [ epoch_millis[] ]
            if [ now - drives_at > 2000 ]
                scan_drives[]
                drives_at = now
            pristine = false
            t[ 'drv_name' ] = BootText [ label: 'Drive',
                area: Region [ 'l0 t{y} w4 h0.825' ] ]
            x : f32 [ 4.4 ]
            for [ dv: UsbDrive ] in drives
                md : string [ (dv.model.count > 0)
                    ? '  {dv.model}' : '' ]
                word : '{dv.name}{md}  {gb[ dv.bytes ]}'
                t[ 'drv_{dv.name}' ] = Choice [ label: word,
                    selected: dv.name == want_drive, disable: !dv.ok,
                    opacity: (dv.ok) ? 1.0 : 0.4,
                    area: Region [ 'l{x} t{y} w8.6 h0.825' ] ]
                x += 8.9
            if [ drives.count == 0 ]
                plug : 'Plug in a USB drive.'
                t[ 'drv_none' ] = BootLog [ label: plug,
                    area: Region [ 'l4.4 t{y} r0 h0.825' ] ]
            y += 1.25
            # the user's keys on the stick, only when asked
            nk : i32 ssh_keys[]
            if [ nk > 0 ]
                t[ 'keys_name' ] = BootText [ label: 'SSH keys',
                    area: Region [ 'l0 t{y} w4 h0.825' ] ]
                kw : string [ (nk == 1) ? 'Carry my key'
                    : 'Carry my {nk} keys' ]
                t[ 'keys_on' ] = Choice [ label: kw,
                    selected: stick_keys,
                    area: Region [ 'l4.4 t{y} w8.6 h0.825' ] ]
                t[ 'keys_off' ] = Choice [ label: 'Leave them out',
                    selected: !stick_keys,
                    area: Region [ 'l13.3 t{y} w8.6 h0.825' ] ]
                y += 1.25
            # while it writes: Back is its Cancel, Write waits
            br : Region [ 'l0 t{y} w4.5 h0.825' ]
            if [ building && job == 'usb' ]
                t[ 'usb_cancel' ] = BootButton [ label: 'Cancel',
                    disable: cancelled,
                    opacity: (cancelled) ? 0.4 : 1.0, area: br ]
            el
                t[ 'usb_back' ] = BootButton [ label: 'Back',
                    area: br ]
            # a drive picked: the installer goes on it
            go : bool [ want_drive && want_drive.count > 0
                && !building ]
            t[ 'usb_write' ] = BootButton [ label: 'Write installer',
                disable: !go, opacity: (go) ? 1.0 : 0.4,
                area: Region [ 'r4.5 t{y} r0 h0.825' ] ]
            y += 1.25
            log_view[ t, y ]
            return t
        if [ can_build[] && !building ]
            t[ 'boot_new' ] = BootButton [ label: 'Build kernel…',
                area: Region [ 'r4.5 t{y} r0 h0.825' ] ]
            # an installer stick for the lit kernel
            if [ stick_kernel[] ]
                t[ 'boot_usb' ] = BootButton [
                    label: 'Write installer…',
                    area: Region [ 'r4.75 t{y} w4.5 h0.825' ] ]
        return t

    # the phone page: the phone on USB, Back, and Install
    func phone_view [ t: Elements ]
        lh : f32 [ 3.8 ]
        t[ 'kernels' ] = ListBox [ elements: kernel_els[],
            area: Region [ 'l0 t0 r0 h{lh}' ] ]
        y : f32 [ lh + 0.5 ]
        # phones come and go: look again every two seconds
        now : i64 [ epoch_millis[] ]
        if [ !building && now - phone_at > 2000 ]
            # phone flashing is fastboot/libusb: not on windows
            ifndef [ windows ]
                phone_look[]
            phone_at = now
        pristine = false
        t[ 'phone_name' ] = BootText [ label: 'Phone',
            area: Region [ 'l0 t{y} w4 h0.825' ] ]
        t[ 'phone_word' ] = BootLog [ label: phone_word,
            area: Region [ 'l4.4 t{y} r0 h0.825' ] ]
        y += 1.25
        t[ 'usb_back' ] = BootButton [ label: 'Back',
            disable: building, opacity: (building) ? 0.4 : 1.0,
            area: Region [ 'l0 t{y} w4.5 h0.825' ] ]
        live : bool [ phone_live && !building ]
        t[ 'phone_update' ] = BootButton [ label: 'Update',
            disable: !live, opacity: (live) ? 1.0 : 0.4,
            area: Region [ 'r9.4 t{y} r4.9 h0.825' ] ]
        go : bool [ phone_ok && !building ]
        t[ 'phone_go' ] = BootButton [ label: 'Install',
            disable: !go, opacity: (go) ? 1.0 : 0.4,
            area: Region [ 'r4.5 t{y} r0 h0.825' ] ]
        y += 1.25
        log_view[ t, y ]

    # a new kernel's page: its choices, Back and Build
    func build_view [ t: Elements ]
        y : f32 [ 0.0 ]
        choices[ t, y, 'Hardware', 'hw_', hardwares[], want_hardware ]
        y += 1.05
        choices[ t, y, 'Kernel', 'ver_', offered[], want_version ]
        # where a line's kernel comes from
        nt : string ''
        if [ want_hardware == 'Apple' ]
            nt = 'from the Asahi Linux project'
        if [ want_hardware == 'Fairphone 6' ]
            nt = 'milos-mainline, as postmarketOS builds it'
        if [ nt.count > 0 ]
            t[ 'kern_note' ] = BootLog [ label: nt,
                area: Region [ 'l8.6 t{y} w9 h0.825' ] ]
        if [ nvidia_offered[] ]
            y += 1.05
            choices[ t, y, 'NVIDIA', 'nv_', nvidias[], want_nvidia ]
        if [ amd_offered[] ]
            y += 1.05
            choices[ t, y, 'AMD', 'amd_', amds[], want_amd ]
        if [ intel_offered[] ]
            y += 1.05
            choices[ t, y, 'Intel', 'in_', intels[], want_intel ]
        y += 1.6
        # the last one stopped: its word, and its log
        if [ failed && lines.count > 0 ]
            t[ 'build_word' ] = BootLog [ label: lines.last[],
                area: Region [ 'l0 t{y} r9.25 h0.825' ] ]
            t[ 'log_toggle' ] = BootButton [
                label: (show_log) ? 'Hide log' : 'Show log',
                area: Region [ 'r9.25 t{y} w4.5 h0.825' ] ]
        t[ 'build_back' ] = BootButton [ label: 'Back',
            area: Region [ 'l0 t13.3 w4.5 h0.825' ] ]
        ok : bool [ builds_hardware[] ]
        t[ 'boot_build' ] = BootButton [ label: 'Build',
            disable: !ok, opacity: (ok) ? 1.0 : 0.4,
            area: Region [ 'r4.5 t13.3 r0 h0.825' ] ]
        if [ failed && show_log ] log_view_to[ t, y + 1.25, 12.9 ]

    # a kernel building: the step it is on, its log if asked
    func building_view [ t: Elements ]
        sw : string [ (step.count > 0) ? '{step}…' : 'Starting…' ]
        if [ cancelled ] sw = 'Cancelling…'
        t[ 'build_step' ] = BootText [ label: sw,
            area: Region [ 'l0 t0 r5 h0.825' ] ]
        t[ 'log_toggle' ] = BootButton [
            label: (show_log) ? 'Hide log' : 'Show log',
            area: Region [ 'r4.5 t0 r0 h0.825' ] ]
        lf : 'The whole log: {log_file[]}'
        t[ 'log_where' ] = BootLog [ label: lf,
            area: Region [ 'l0 t0.95 r0 h0.825' ] ]
        if [ show_log ] log_view[ t, 2.2 ]

    # the build's output from y down, as much as fits
    func log_view [ t: Elements, y: f32 ]
        log_view_to[ t, y, 14.15 ]

    # the same, ending at foot (clear of the buttons under it)
    func log_view_to [ t: Elements, y: f32, foot: f32 ]
        room : i32 [ i32[ (foot - y) / 0.72 ] ]
        shown : vec string []
        lock.lock[]
        oldest : i32 [ lines.count - room ]
        if [ oldest < 0 ] oldest = 0
        for [ i: i32 oldest, i < lines.count, i += 1 ]
            shown.push[ '{lines[ i ]}' ]
        lock.unlock[]
        log_els : Elements []
        ly : f32 [ 0.0 ]
        for [ i: i32 0, i < shown.count, i += 1 ]
            log_els[ 'l_{i}' ] = BootLog [ label: shown[ i ],
                area: Region [ 'l0 t{ly} r0 h0.7' ] ]
            ly += 0.72
        # the oldest line fades out over the top 32 px
        t[ 'console' ] = element [ elements: log_els,
            mask_glow: vec4f [ 32.0, 0.0, 0.0, 0.0 ],
            area: Region [ 'l0 t{y} r0 h{ly}' ] ]

    # helpers for the summary

    # a file's first line ('' when none): never the whole file
    func first_line [ f: string ] -> string
        fh : handle fopen[ f.chars, 'r' ]
        if [ !fh ] return ''
        b : local i8 [ 4096 ]
        out : string ''
        if [ fgets[ @b[0], 4096, fh ] ] out = string [ @b[0] ]
        fclose[ fh ]
        return out

    func read_lines [ f: string ] -> vec string
        out : vec string []
        fh : handle fopen[ f.chars, 'r' ]
        if [ !fh ] return out
        b : local i8 [ 1024 ]
        while [ fgets[ @b[0], 1024, fh ] ]
            ln : string [ @b[0] ]
            out.push[ ln.trim[] ]
        fclose[ fh ]
        return out

    # the release a tree has modules for (lib/modules/<release>)
    func module_release [ tree: string ] -> string
        md : path '{tree}/lib/modules'
        rels : md.ls[ null, false ]
        out : string ''
        if [ !rels ] return out
        for [ r: path ] in rels
            ma : path '{r}/modules.alias'
            if [ ma.exists[] ] out = r.filename[]
        return out

    func count_files [ dir: string, ext: string ] -> i32
        cmd : 'find {dir} -name \'*{ext}*\' 2>/dev/null | wc -l'
        fh_cmd : command [ cmd ]
        fh : handle fh_cmd.stream[]
        if [ !fh ] return 0
        b : local i8 [ 64 ]
        n : i32 [ 0 ]
        if [ fgets[ @b[0], 64, fh ] ]
            s0 : string [ @b[0] ]
            n = s0.trim[].integer_value[]
        pclose[ fh ]
        return n

    func when [ p: path ] -> string
        t : i64 [ p.modified_time[] / 1000 ]
        b : local i8 [ 64 ]
        strftime[ @b[0], 64, '%b %d %H:%M', localtime[ @t ] ]
        return string [ @b[0] ]

    # guest path of a path: the same absolute path, no leading slash
    func guest [ p: string ] -> string
        if [ p.starts_with[ '/' ] ] return p.mid[ 1, i32[ p.count ] - 1 ]
        return p

    func add_dir [ dst: string ]
        if [ dst.count == 0 || seen.contains[ dst ] ] return
        seen[ dst ] = true
        n : i64 [ dst.rindex_of[ '/' ] ]
        if [ n > 0 ] add_dir[ dst.mid[ 0, i32[ n ] ] ]
        files.push[ OsFile [ dst: dst, dir: true ] ]

    func file_size [ src: string ] -> i64
        f : handle fopen[ src.chars, 'rb' ]
        if [ !f ] return 0
        fseek[ f, 0, SEEK_END ]
        n : i64 [ ftell[ f ] ]
        fclose[ f ]
        return n

    # silver's own files: the repository, the install, the tree
    func is_ours [ p: string ] -> bool
        o : '{out_dir}'
        return p.starts_with[ '{root}/' ] || p == '{root}'
            || p.starts_with[ '{install}' ] || p.starts_with[ o ]

    # a path with its . and .. parts taken out
    func norm [ p: string ] -> string
        out : vec string []
        for [ part: string ] in p.split[ '/' ]
            if [ part.count == 0 || part == '.' ] continue
            if [ part == '..' ]
                if [ out.count > 0 ] out.pop[]
                continue
            out.push[ part ]
        r : string ''
        for [ part: string ] in out
            r = '{r}/{part}'
        return (r.count > 0) ? r : '/'

    # a path as the drive sees it: a base file loses the base
    func logical [ p: string ] -> string
        if [ sysr.count > 0 && p.starts_with[ '{sysr}/' ] ]
            return p.mid[ sysr.count, p.count - sysr.count ]
        return p

    # a system path under merged /usr: /bin/x is /usr/bin/x
    func canon [ p: string ] -> string
        for [ top: string ] in vec string [] [ 'bin', 'sbin', 'lib',
                'lib32', 'lib64' ]
            if [ !mapped.contains[ top ] ] continue
            if [ p == '/{top}' || p.starts_with[ '/{top}/' ] ]
                to : mapped[ top ]
                rest : p.mid[ top.count + 1, p.count - top.count - 1 ]
                return '/{to}{rest}'
        return p

    # the file a path is read from: ours as it is, a system one
    # from the base
    func src_of [ p: string ] -> string
        lp : logical[ p ]
        if [ is_ours[ lp ] ] return lp
        return '{sysr}{canon[ lp ]}'

    # the pinned x64 base, made the first time a tree needs it
    func use_base [] -> bool
        if [ !sys ]
            bd : '{share[]}/x64-base'
            sys = UbuntuBase [ dir: bd, tools: '{install}/bin' ]
        if [ !sys.make[] ]
            say[ 'The x64 base could not be made' ]
            return false
        sysr = sys.root[]
        return true

    # the base's top links (bin to usr/bin ...), as the tree's own
    func add_tops []
        mapped = map string [ string ] []
        for [ top: string ] in vec string [] [ 'bin', 'sbin', 'lib',
                'lib32', 'lib64' ]
            tp : path '{sysr}/{top}'
            if [ !tp.is_symlink[] ] continue
            buf : local i8 [ 4096 ]
            tn : '{sysr}/{top}'
            len : i64 [ readlink[ tn.chars, @buf[0], 4095 ] ]
            if [ len <= 0 ] continue
            buf[len] = 0
            to : string [ @buf[0] ]
            mapped[ top ] = to
            seen[ top ] = true
            files.push[ OsFile [ dst: top, link: to ] ]

    func add_file [ given: string ]
        lp : logical[ given ]
        ours : bool [ is_ours[ lp ] ]
        if [ !ours ] lp = canon[ lp ]
        src : string [ (ours) ? lp : '{sysr}{lp}' ]
        dst : guest[ lp ]
        if [ left.contains[ dst ] ] return
        p : path [ src ]
        if [ !p.exists[] && !p.is_symlink[] ] return
        # a folder seen as a parent is still walked for its files
        if [ !p.is_symlink[] && p.is_dir[] ]
            add_dir[ dst ]           # the directory entry itself, then its files
            add_tree[ src ]
            return
        if [ seen.contains[ dst ] ] return
        seen[ dst ] = true
        n : i64 [ dst.rindex_of[ '/' ] ]
        if [ n > 0 ] add_dir[ dst.mid[ 0, i32[ n ] ] ]
        if [ p.is_symlink[] ]
            buf : local i8 [ 4096 ]
            len : i64 [ readlink[ src.chars, @buf[0], 4095 ] ]
            if [ len <= 0 ] return
            buf[len] = 0
            target : string [ @buf[0] ]
            files.push[ OsFile [ dst: dst, link: target ] ]
            # a linked file must be in the tree too; a linked
            # directory (install) is walked by what is asked for
            sl : i32 [ lp.rindex_of[ '/' ] ]
            sp : lp.mid[ 0, sl ]
            full : string [ (target.starts_with[ '/' ]) ? target
                            : '{sp}/{target}' ]
            full = norm[ full ]
            tp : path [ src_of[ full ] ]
            if [ !tp.is_dir[] ] add_file[ full ]
        el
            files.push[ OsFile [ src: src, dst: dst ] ]

    # a host folder into the tree at another place; its links to
    # the build tree (build, source) stay behind
    func add_tree_at [ src: string, dst: string ]
        add_dir[ dst ]
        d : path [ src ]
        entries : d.ls[ null, false ]
        if [ !entries ] return
        for [ e: path ] in entries
            t : '{dst}/{e.filename[]}'
            if [ e.is_symlink[] ] continue
            if [ e.is_dir[] ] add_tree_at[ '{e}', t ]
            el files.push[ OsFile [ src: '{e}', dst: t ] ]

    func add_tree [ src: string ]
        d : path [ src ]
        entries : d.ls[ null, false ]
        if [ !entries ] return
        for [ e: path ] in entries
            add_file[ '{e}' ]

    # every shared library the loader will pull for this binary
    # the libraries the loader pulls, read from the file itself:
    # its interpreter, its needed names by its run paths, silver's
    # install, then the base; never the computer's own loader
    func add_deps [ bin: string ]
        lp : logical[ bin ]
        if [ !deps_done || deps_done.contains[ lp ] ] return
        deps_done[ lp ] = true
        file : src_of[ lp ]
        fpath : path [ file ]
        real : '{fpath.absolute[]}'
        if [ real.count == 0 ] return
        rl : logical[ real ]
        sl : i32 [ rl.rindex_of[ '/' ] ]
        origin : rl.mid[ 0, sl ]
        rd : '{install}/bin/llvm-readelf'
        cmd : command [ '{rd} -h -d -l --wide "{real}" 2>/dev/null' ]
        fp : handle cmd.stream[]
        if [ !fp ] return
        elf32 : bool [ false ]
        needs : vec string []
        dirs : vec string []
        interp : string ''
        line : local i8 [ 4096 ]
        while [ fgets[ @line[0], 4096, fp ] ]
            ln : string [ @line[0] ]
            if [ ln.index_of[ 'Class:' ] >= 0
                    && ln.index_of[ 'ELF32' ] >= 0 ]
                elf32 = true
            v : bracket[ ln, 'Shared library: [' ]
            if [ v.count > 0 ] needs.push[ v ]
            rp : bracket[ ln, 'runpath: [' ]
            if [ rp.count == 0 ] rp = bracket[ ln, 'rpath: [' ]
            if [ rp.count > 0 ]
                for [ d: string ] in rp.split[ ':' ]
                    dd : string [ d ]
                    o : i32 [ d.index_of[ '$ORIGIN' ] ]
                    if [ o >= 0 ]
                        tail : d.mid[ o + 7, d.count - o - 7 ]
                        dd = '{origin}{tail}'
                    dirs.push[ norm[ dd ] ]
            ip : i32 [ ln.index_of[ 'program interpreter: ' ] ]
            if [ ip >= 0 ]
                rest : ln.mid[ ip + 21, ln.count - ip - 21 ]
                e : i32 [ rest.index_of[ ']' ] ]
                if [ e > 0 ] interp = rest.mid[ 0, e ]
        pclose[ fp ]
        # a base program never takes our install's libraries
        if [ !elf32 && is_ours[ lp ] ]
            dirs.push[ '{install}/lib' ]
            dirs.push[ '{install}/build' ]
        multi : 'x86_64-linux-gnu'
        if [ elf32 ] multi = 'i386-linux-gnu'
        dirs.push[ '/usr/lib/{multi}' ]
        dirs.push[ (elf32) ? '/usr/lib32' : '/usr/lib64' ]
        dirs.push[ '/usr/lib' ]
        if [ interp.count > 0 ] add_file[ interp ]
        for [ n: string ] in needs
            got : string ''
            have : bool [ false ]
            for [ d: string ] in dirs
                cand : '{d}/{n}'
                # one the tree already holds (nvidia's own)
                if [ seen.contains[ guest[ canon[ cand ] ] ] ]
                    have = true
                    break
                cp : path [ src_of[ cand ] ]
                if [ cp.exists[] ]
                    got = cand
                    break
            if [ have ] continue
            if [ got.count == 0 ]
                log 'os-bootstrap: {n} (for {lp}) is in no library folder'
                continue
            add_file[ got ]
            add_deps[ got ]

    # the text between a word and its closing ]
    func bracket [ ln: string, word: string ] -> string
        at : i32 [ ln.index_of[ word ] ]
        if [ at < 0 ] return ''
        rest : ln.mid[ at + word.count, ln.count - at - word.count ]
        e : i32 [ rest.index_of[ ']' ] ]
        if [ e < 0 ] return ''
        return rest.mid[ 0, e ]

    func tree_size [ src: string ] -> i64
        d : path [ src ]
        entries : d.ls[ null, false ]
        total : i64 [ 0 ]
        if [ !entries ] return 0
        # as tar counts it: a 512 byte header an entry, data padded
        for [ e: path ] in entries
            total += 512
            if [ e.is_symlink[] ] continue
            if [ e.is_dir[] ] total += tree_size[ '{e}' ]
            el total += (file_size[ '{e}' ] + 511) / 512 * 512
        return total

    func assemble [] -> bool
        if [ !build_apps[] ] return false
        if [ !gather[] ] return false
        write_tree[]
        write_boot[]
        return true

    # every module the drive carries is built here first: a stale
    # product on the drive is a build at its launch, and the drive
    # cannot fetch what a build needs
    func build_apps [] -> bool
        ex : path '{install}/export'
        regs : ex.ls[ null, false ]
        names : vec string [] [ app ]
        if [ regs ]
            for [ r: path ] in regs
                nm : r.filename[]
                if [ !nm.ends_with[ '.agi' ] || nm.ends_with[ '.props.agi' ] ]
                    continue
                stem : nm.mid[ 0, nm.count - 4 ]
                if [ !stem.starts_with[ 'silver-' ] ] continue
                mod : stem.mid[ 7, stem.count - 7 ]
                srcf : first_line[ '{install}/build/{stem}.source' ].trim[]
                if [ srcf.count == 0 ] continue
                sp : path [ srcf ]
                if [ !sp.exists[] ] continue
                t : string r.load[ typeid[ string ], null ]
                if [ !t ] continue
                t = '\n{t}'
                if [ t.index_of[ '\nsoftware:' ] < 0
                        && t.index_of[ '\nscenes:' ] < 0 ] continue
                names.push[ mod ]
        for [ mod: string ] in names
            # the launcher's rule: a listed source newer than the
            # product builds at launch; the installer builds it clean
            clean : (host_stale[ mod ]) ? ' --clean' : ''
            say[ 'Building {mod}{clean}' ]
            sv : '{install}/bin/silver'
            b : command [ 'cd {root} && {sv} --build{clean} {mod}' ]
            if [ b.exec[ false ] != 0 ]
                say[ '{mod} did not build: the tree is not written' ]
                return false
        return true

    # silver-host's staleness: a source in the record newer than the
    # product (an import's .ag counts there, not in silver's own rule)
    func host_stale [ mod: string ] -> bool
        prod : path '{install}/build/libsilver-{mod}.so'
        if [ !prod.exists[] ] return true
        pt : prod.modified_time[]
        src : path '{install}/build/silver-{mod}.source'
        t : string src.load[ typeid[ string ], null ]
        if [ !t ] return false
        for [ line: string ] in t.split[ '\n' ]
            f : line.trim[]
            if [ f.count == 0 ] continue
            sp : path [ f ]
            if [ sp.exists[] && sp.modified_time[] > pt ] return true
        return false

    # every file the drive tree takes, and where each comes from
    func gather [] -> bool
        # no app: its path would be the build folder, all of it
        if [ !app || app.count == 0 ]
            log 'os-bootstrap: no app to assemble'
            return false
        files = vec OsFile []
        seen  = map bool [ string ] []
        left  = map bool [ string ] []
        deps_done = map bool [ string ] []
        if [ !use_base[] ] return false
        add_tops[]
        add_dir[ 'dev' ]
        add_dir[ 'proc' ]
        add_dir[ 'sys' ]
        add_dir[ 'tmp' ]
        add_dir[ 'root' ]
        add_dir[ 'run' ]
        # mnt: the holder's view root (silver-host VIEW_ROOT)
        add_dir[ 'mnt' ]
        add_dir[ 'home' ]
        add_dir[ 'media' ]
        # the base's var/run and var/lock are links to /run (iwd's
        # bus library dials /var/run); the services log in var/log
        add_file[ '/var/run' ]
        add_file[ '/var/lock' ]
        add_dir[ 'run/lock' ]
        add_dir[ 'var/log' ]
        # the export stamps: a build on the drive reruns no export
        add_file[ '{install}/tmp/exports' ]
        files.push[ OsFile [ dst: 'dev/console', dev: true ] ]
        # the install symlink, orbiter's launcher and every module product
        add_file[ '{root}/install' ]
        add_file[ '{install}/build/{app}' ]
        add_deps[ '{install}/build/{app}' ]
        add_file[ '{install}/build/{app}.cmd' ]
        add_file[ '{install}/build/libsilver-{app}.so' ]
        add_deps[ '{install}/build/libsilver-{app}.so' ]
        # the launcher loads the product this link names
        add_file[ '{install}/build/silver-{app}.product' ]
        log 'os-bootstrap: launcher done, {files.count} entries'
        # the share dir of every module in that closure rides along when small
        mods : vec string []
        for [ e: OsFile ] in files
            nm : e.dst
            at : i64 [ nm.rindex_of[ '/' ] ]
            if [ at >= 0 ] nm = nm.mid[ i32[ at ] + 1, i32[ nm.count ] - i32[ at ] - 1 ]
            if [ nm.starts_with[ 'libsilver-' ] && nm.ends_with[ '.so' ] ]
                mods.push[ nm.mid[ 10, i32[ nm.count ] - 13 ] ]
        for [ mod: string ] in mods
            # its product link and records: built, never compiled again
            for [ ext: string ] in vec string [] [ '', '.abi', '.deps' ]
                add_file[ '{install}/build/silver-{mod}.product{ext}' ]
            add_file[ '{install}/build/silver-{mod}.source' ]
            sh : '{install}/share/silver-{mod}'
            shp : path [ sh ]
            if [ !shp.exists[] ] continue
            # the app's own share always: its images are its startup
            if [ mod != app && tree_size[ sh ] > share_max ]
                log 'os-bootstrap: share silver-{mod} left out: too big'
                continue
            log 'os-bootstrap: share silver-{mod}'
            add_file[ sh ]
        add_import_stamps[]
        add_file[ '{install}/share/orbiter' ]
        # libxkbcommon's keyboard maps and compose files
        add_file[ '{install}/share/X11' ]
        log 'os-bootstrap: products done, {files.count} entries'
        # our mesa's vulkan drivers: venus, radv (amd), anv (intel)
        # radv and anv only with the kernel's own drivers
        kb : selected[]
        drvs : vec string [] [ 'virtio' ]
        if [ !kb || kb.amd != 'none' ] drvs.push[ 'radeon' ]
        if [ !kb || kb.intel != 'none' ] drvs.push[ 'intel' ]
        icds : path '{install}/share/vulkan/icd.d'
        for [ drv: string ] in drvs
            so : '{install}/lib/libvulkan_{drv}.so'
            add_file[ so ]
            add_deps[ so ]
            for [ j: path ] in icds.ls[ null, false ]
                if [ j.filename[].starts_with[ '{drv}_icd' ] ]
                    add_file[ '{j}' ]
        add_file[ '{install}/lib/libvulkan.so.1' ]
        add_deps[ '{install}/lib/libvulkan.so.1' ]
        add_nvidia[]
        add_steam[]
        add_tools[]
        add_shell[]
        # programs run in the console module, hosted at run time
        add_module[ 'console' ]
        # the boot picture init runs as the gpu driver loads
        add_module[ 'bootcube' ]
        add_open[]
        add_claude[]
        add_wifi[]
        add_network[]
        add_tray[]
        add_toolchain[]
        add_games[]
        add_apps[]
        add_lib_links[]
        add_link_archives[]
        add_records[]
        return true

    # a test: the whole tree gathered, each file from silver's
    # folder, the base or nvidia's installer, never the system
    public func tree_check [] -> bool
        if [ !gather[] ] return false
        home : string [ getenv[ 'HOME' ] ]
        bad : i32 [ 0 ]
        for [ f: OsFile ] in files
            src : f.src
            if [ !src || src.count == 0 ] continue
            if [ is_ours[ src ] || src.starts_with[ '{sysr}/' ] ]
                continue
            # the user's own games from their home: taken on purpose
            if [ src.starts_with[ '{home}/' ] ] continue
            if [ bad < 20 ] log 'from the system: {src} -> {f.dst}'
            bad += 1
        total : i64 [ 0 ]
        for [ f: OsFile ] in files
            if [ f.src && f.src.count > 0 ] total += file_bytes[ f.src ]
        mb : i64 [ total / 1048576 ]
        # a link whose target the tree lacks dangles on the drive
        have : map bool [ string ] []
        links : map string [ string ] []
        for [ f: OsFile ] in files
            have[ f.dst ] = true
            if [ f.link && f.link.count > 0 ] links[ f.dst ] = f.link
        dangle : i32 [ 0 ]
        for [ f: OsFile ] in files
            if [ !f.link || f.link.count == 0 ] continue
            t : tree_target[ f.dst, f.link, links ]
            if [ t.count == 0 || have.contains[ t ] ] continue
            if [ dangle < 20 ] log 'dangling link: {f.dst} -> {f.link}'
            dangle += 1
        log 'tree check: {files.count} entries, {mb} MB, {bad} from the system, {dangle} dangling links'
        return bad == 0 && dangle == 0

    # a link line names a library unversioned (-ltiff): every
    # install/lib link whose target is in the tree rides along
    func add_lib_links []
        have : map bool [ string ] []
        for [ f: OsFile ] in files
            have[ f.dst ] = true
        n : i32 [ 0 ]
        # ours, then the base's (-lcrypt, -lasound, -lxcb ...)
        for [ dir: string ] in vec string [] [ '{install}/lib',
                '{sysr}/usr/lib/x86_64-linux-gnu' ]
            d : path [ dir ]
            entries : d.ls[ null, false ]
            if [ !entries ] continue
            for [ e: path ] in entries
                if [ !e.is_symlink[] ] continue
                ep : '{e}'
                if [ !ep.ends_with[ '.so' ] ] continue
                dst : guest[ logical[ ep ] ]
                if [ have.contains[ dst ] ] continue
                # the link's final file, resolved inside its tree
                t : guest[ logical[ link_end[ ep ] ] ]
                if [ !have.contains[ t ] ] continue
                add_file[ ep ]
                n += 1
        log 'os-bootstrap: library links: {n}'

    # the archives a carried module's link lines name (-lmbedtls):
    # a link on the drive finds them
    func add_link_archives []
        mods : vec string []
        for [ e: OsFile ] in files
            nm : e.dst
            at : i64 [ nm.rindex_of[ '/' ] ]
            if [ at >= 0 ]
                nm = nm.mid[ i32[ at ] + 1, i32[ nm.count ] - i32[ at ] - 1 ]
            if [ nm.starts_with[ 'libsilver-' ]
                    && nm.ends_with[ '.so' ] ]
                mods.push[ nm.mid[ 10, i32[ nm.count ] - 13 ] ]
        names : map bool [ string ] []
        for [ mod: string ] in mods
            sf : path [ '{install}/build/silver-{mod}.source' ]
            if [ !sf.exists[] ] continue
            list : string sf.load[ typeid[ string ], null ]
            if [ !list ] continue
            for [ src: string ] in list.split[ '\n' ]
                if [ !src.ends_with[ '.ag' ] ] continue
                ap : path [ src ]
                if [ !ap.exists[] ] continue
                text : string ap.load[ typeid[ string ], null ]
                if [ !text ] continue
                for [ line: string ] in text.split[ '\n' ]
                    for [ word: string ] in line.trim[].split[ ' ' ]
                        if [ !word.starts_with[ '-l' ] || word.count < 3 ]
                            continue
                        lib : word.mid[ 2, word.count - 2 ]
                        names[ lib ] = true
        n : i32 [ 0 ]
        for [ on: bool, name: string ] in names
            so : path [ '{install}/lib/lib{name}.so' ]
            bso : path [ '{install}/build/lib{name}.so' ]
            if [ so.exists[] || so.is_symlink[] || bso.exists[] ]
                continue
            ar : '{install}/lib/lib{name}.a'
            arp : path [ ar ]
            if [ !arp.exists[] ] continue
            add_file[ ar ]
            n += 1
        log 'os-bootstrap: link archives: {n}'

    # where a chain of links ends, each step inside its own tree
    func link_end [ p: string ] -> string
        cur : p
        for [ i: i32 0, i < 16, i += 1 ]
            cp : path [ cur ]
            if [ !cp.is_symlink[] ] return cur
            target : link_of[ cur ]
            if [ target.count == 0 ] return cur
            if [ target.starts_with[ '/' ] ]
                base : bool [ cur.starts_with[ '{sysr}/' ] ]
                cur = target
                if [ base ] cur = '{sysr}{target}'
            el
                sl : i32 [ cur.rindex_of[ '/' ] ]
                cur = norm[ '{cur.mid[ 0, sl ]}/{target}' ]
        return cur

    # a link's target as a tree path (no leading slash)
    func link_path [ dst: string, target: string ] -> string
        if [ target.starts_with[ '/' ] ] return guest[ norm[ target ] ]
        n : i64 [ dst.rindex_of[ '/' ] ]
        d : string ''
        if [ n > 0 ] d = dst.mid[ 0, i32[ n ] ]
        return guest[ norm[ '/{d}/{target}' ] ]

    # the target resolved through the tree's own links
    func tree_target [ dst: string, target: string,
            links: map string [ string ] ] -> string
        t : link_path[ dst, target ]
        for [ pass: i32 0, pass < 16, pass += 1 ]
            parts : t.split[ '/' ]
            pre : string ''
            found : bool [ false ]
            for [ k: i32 0, k < parts.count && !found, k += 1 ]
                pk : parts[ k ]
                if [ k == 0 ] pre = pk
                el pre = '{pre}/{pk}'
                if [ !links.contains[ pre ] ] continue
                rest : string ''
                for [ j: i32 k + 1, j < parts.count, j += 1 ]
                    pj : parts[ j ]
                    rest = '{rest}/{pj}'
                lt : links[ pre ]
                lp : link_path[ pre, lt ]
                t = '{lp}{rest}'
                found = true
            if [ !found ] return t
        return t

    # orbiter-os builds itself: silver, its clang and lld, every
    # header they read, the C library's link files and gcc's start
    # files (clang links with them), silver's sources and its git
    # history (a module builds only inside its repository)
    # the user's games, at the same place in the new system's home
    func add_games []
        hc : cstr [ getenv[ "HOME" ] ]
        if [ hc == null ] return
        home : string [ hc ]
        games : vec string game_files[]
        for [ g: string ] in games
            dst : 'root/{g}'
            if [ seen.contains[ dst ] ] continue
            seen[ dst ] = true
            n : i64 [ dst.rindex_of[ '/' ] ]
            if [ n > 0 ] add_dir[ dst.mid[ 0, i32[ n ] ] ]
            files.push[ OsFile [ src: '{home}/{g}', dst: dst ] ]
        say[ 'games from your home: {games.count} files' ]

    func add_toolchain []
        for [ t: string ] in vec string [] [ '{install}/bin/silver',
                '{install}/build/silver', '{install}/bin/clang',
                '{install}/bin/clang++', '{install}/bin/lld',
                '{install}/bin/ld.lld', '/usr/bin/git',
                '/usr/bin/ssh', '/usr/bin/ssh-keygen', '/usr/bin/ssh-add',
                '/usr/bin/ssh-agent' ]
            add_file[ t ]
            add_deps[ t ]
        add_deps[ '{install}/bin/clang-22' ]
        add_file[ '{install}/include' ]
        # include/Au, aether, silver, net are links into build/src
        add_file[ '{install}/build/src' ]
        add_file[ '{install}/lib/clang/22/include' ]
        add_file[ '/usr/include' ]
        add_file[ '/usr/lib/gcc/x86_64-linux-gnu' ]
        add_file[ '/usr/lib/git-core' ]
        # git over https: the helper's own libraries, the templates
        add_deps[ '/usr/lib/git-core/git-remote-https' ]
        add_file[ '/usr/share/git-core/templates' ]
        # git over ssh: the client's settings
        add_file[ '/etc/ssh/ssh_config' ]
        add_file[ '/etc/ssh/ssh_config.d' ]
        # link files where the linker and glibc's scripts look;
        # the libraries the scripts name, with the others in /lib
        dev : '/usr/lib/x86_64-linux-gnu'
        for [ f: string ] in vec string [] [ 'crt1.o', 'Scrt1.o',
                'crti.o', 'crtn.o', 'libc.so', 'libc_nonshared.a',
                'libm.so', 'libmvec.so', 'libpthread.a', 'libdl.a' ]
            add_file[ '{dev}/{f}' ]
        for [ f: string ] in vec string [] [ 'libc.so.6', 'libm.so.6',
                'libmvec.so.1' ]
            add_file[ '/lib/x86_64-linux-gnu/{f}' ]
        # tracked and new files alike (a build record names them)
        cmd : command [ 'git -C {root} ls-files -co --exclude-standard' ]
        fh : handle cmd.stream[]
        if [ fh ]
            b : local i8 [ 4096 ]
            while [ fgets[ @b[0], 4096, fh ] ]
                ln : string [ @b[0] ]
                add_file[ '{root}/{ln.trim[]}' ]
            pclose[ fh ]
        add_file[ '{root}/.git' ]
        log 'os-bootstrap: toolchain done, {files.count} entries'

    # a file of nvidia's installer into the tree at dst
    func add_as [ src: string, dst: string ]
        if [ seen.contains[ dst ] ] return
        p : path [ src ]
        if [ !p.exists[] ] return
        seen[ dst ] = true
        n : i64 [ dst.rindex_of[ '/' ] ]
        if [ n > 0 ] add_dir[ dst.mid[ 0, i32[ n ] ] ]
        files.push[ OsFile [ src: src, dst: dst ] ]

    func add_link [ dst: string, target: string ]
        if [ seen.contains[ dst ] ] return
        seen[ dst ] = true
        files.push[ OsFile [ dst: dst, link: target ] ]

    # the file in d whose name starts so (egl-gbm's own version)
    func named_in [ d: string, start: string ] -> string
        dp : path [ d ]
        entries : dp.ls[ null, false ]
        if [ entries ]
            for [ e: path ] in entries
                nm : e.filename[]
                if [ nm.starts_with[ start ] ] return nm
        return ''

    # nvidia's libraries from d into lib: each file, its soname
    func add_nvlibs [ d: string, lib: string, libs: vec string ]
        for [ i: i32 0, i + 1 < libs.count, i += 2 ]
            f : libs[ i ]
            so : libs[ i + 1 ]
            if [ f.count == 0 ] continue
            add_as[ '{d}/{f}', '{lib}/{f}' ]
            if [ so != f ] add_link[ '{lib}/{so}', f ]
        for [ i: i32 0, i < libs.count, i += 2 ]
            f : libs[ i ]
            if [ f.count > 0 ] add_deps[ '{d}/{f}' ]

    # a test: one kernel's nvidia files, none from the system
    public func nvidia_check [ kname: string ] -> bool
        chosen = kname
        files = vec OsFile []
        seen  = map bool [ string ] []
        left  = map bool [ string ] []
        deps_done = map bool [ string ] []
        if [ !use_base[] ] return false
        add_tops[]
        add_nvidia[]
        lib : 'usr/lib/x86_64-linux-gnu'
        want : vec string [] [ '{lib}/libGLX_nvidia.so.0',
            '{lib}/libnvidia-glcore.so.610.57.04',
            '{lib}/libnvidia-egl-gbm.so.1',
            '{lib}/gbm/nvidia-drm_gbm.so',
            'usr/lib/i386-linux-gnu/libGLX_nvidia.so.0',
            'usr/share/vulkan/icd.d/nvidia_icd.json',
            'usr/lib/firmware/nvidia/610.57.04/gsp_ga10x.bin' ]
        for [ w: string ] in want
            if [ !seen.contains[ w ] ]
                log 'missing {w}'
                return false
        for [ f: OsFile ] in files
            src : f.src
            if [ src && src.starts_with[ '/usr/lib' ]
                     && src.index_of[ 'nvidia' ] >= 0 ]
                log 'from the system: {src}'
                return false
        log 'nvidia files: {files.count} entries'
        return true

    # the drive's gpu: the release the kernel was built with,
    # from nvidia's own installer, never the running system's
    func add_nvidia []
        kb : selected[]
        if [ !kb ] return
        v : kb.nvidia
        if [ v.count == 0 || v == 'none' ] return
        d : nvidia_user[ v ]
        if [ d.count == 0 ]
            say[ 'NVIDIA {v}: its installer did not download' ]
            return
        lib : 'usr/lib/x86_64-linux-gnu'
        gbm : named_in[ d, 'libnvidia-egl-gbm.so.1.' ]
        # the icd and the libraries it opens at run time
        libs : vec string [] [
            'libGLX_nvidia.so.{v}', 'libGLX_nvidia.so.0',
            'libEGL_nvidia.so.{v}', 'libEGL_nvidia.so.0',
            'libnvidia-allocator.so.{v}', 'libnvidia-allocator.so.1',
            gbm, 'libnvidia-egl-gbm.so.1',
            'libEGL.so.1.1.0', 'libEGL.so.1',
            'libGLdispatch.so.0', 'libGLdispatch.so.0' ]
        for [ nm: string ] in vec string [] [ 'glcore', 'glvkspirv',
                'gpucomp', 'tls', 'glsi', 'rtcore', 'eglcore' ]
            libs.push[ 'libnvidia-{nm}.so.{v}' ]
            libs.push[ 'libnvidia-{nm}.so.{v}' ]
        add_nvlibs[ d, lib, libs ]
        add_dir[ '{lib}/gbm' ]
        alloc : '../libnvidia-allocator.so.1'
        add_link[ '{lib}/gbm/nvidia-drm_gbm.so', alloc ]
        # vkCreateInstance opens glvnd's EGL and nvidia's vendor
        add_as[ '{d}/nvidia_icd.json',
                'usr/share/vulkan/icd.d/nvidia_icd.json' ]
        add_as[ '{d}/10_nvidia.json',
                'usr/share/glvnd/egl_vendor.d/10_nvidia.json' ]
        add_as[ '{d}/15_nvidia_gbm.json',
                'usr/share/egl/egl_external_platform.d/15_nvidia_gbm.json' ]
        # the gpu's own 32-bit half, for Steam
        l32 : vec string [] [
            'libGLX_nvidia.so.{v}', 'libGLX_nvidia.so.0',
            'libEGL_nvidia.so.{v}', 'libEGL_nvidia.so.0',
            'libGLdispatch.so.0', 'libGLdispatch.so.0' ]
        for [ nm: string ] in vec string [] [ 'glcore', 'tls', 'glsi',
                'glvkspirv', 'gpucomp', 'eglcore' ]
            l32.push[ 'libnvidia-{nm}.so.{v}' ]
            l32.push[ 'libnvidia-{nm}.so.{v}' ]
        add_nvlibs[ '{d}/32', 'usr/lib/i386-linux-gnu', l32 ]
        # the gsp firmware of this release; the system's others stay
        fw : 'usr/lib/firmware/nvidia'
        for [ nm: string ] in vec string [] [ 'gsp_ga10x.bin',
                'gsp_tu10x.bin' ]
            add_as[ '{d}/firmware/{nm}', '{fw}/{v}/{nm}' ]
        digits : '0123456789'
        hp : path '{sysr}/{fw}'
        had : hp.ls[ null, false ]
        if [ had ]
            for [ e: path ] in had
                nm : e.filename[]
                if [ digits.index_of[ nm.mid[ 0, 1 ] ] >= 0 ]
                    left[ '{fw}/{nm}' ] = true

    # Steam: its launcher, and what its own runtime leaves to the
    # system (Valve's steam-libs-i386 and -amd64), 32-bit and 64
    func add_steam []
        add_file[ '{install}/bin/steam' ]
        add_file[ '{install}/lib/steam' ]
        l32 : '/usr/lib/i386-linux-gnu'
        l64 : '/usr/lib/x86_64-linux-gnu'
        add_file[ '/lib/ld-linux.so.2' ]
        base : vec string [] [ 'libc.so.6', 'libcrypt.so.1',
            'libgcc_s.so.1', 'libstdc++.so.6', 'libGL.so.1', 'libGLX.so.0',
            'libEGL.so.1', 'libgbm.so.1', 'libX11.so.6', 'libxcb.so.1',
            'libxcb-dri3.so.0', 'libXinerama.so.1', 'libudev.so.1',
            'libgpg-error.so.0', 'libdbus-1.so.3' ]
        for [ l: string ] in base
            for [ d: string ] in vec string [] [ l32, l64 ]
                add_file[ '{d}/{l}' ]
                add_deps[ '{d}/{l}' ]
        add_file[ '{l64}/libnss3.so' ]
        add_deps[ '{l64}/libnss3.so' ]
        log 'os-bootstrap: steam done, {files.count} entries'

    # a module orbiter hosts at run time (not in its link closure)
    # the imports' build stamps: silver reads them as built and
    # installed, so no checkout is cloned on the drive
    func add_import_stamps []
        bd : path '{install}/build'
        tops : bd.ls[ null, false ]
        if [ !tops ] return
        for [ d: path ] in tops
            nm : d.filename[]
            # a build-none module's proof that its imports are built
            if [ nm.ends_with[ '.silver-token' ]
                    || nm.ends_with[ '.imported' ] ]
                add_file[ '{d}' ]
                continue
            if [ !d.is_dir[] ] continue
            # a token at the top and one a level down (freetype's
            # own folder holds another freetype): both ride
            tok : path '{d}/silver-token'
            if [ tok.exists[] ] add_file[ '{tok}' ]
            subs : d.ls[ null, false ]
            if [ !subs ] continue
            for [ e: path ] in subs
                st : path '{e}/silver-token'
                if [ st.exists[] ] add_file[ '{st}' ]

    # every program in a folder, each with its libraries
    func add_programs [ dir: string ]
        d : path [ dir ]
        entries : d.ls[ null, false ]
        if [ !entries ] return
        for [ e: path ] in entries
            if [ e.is_symlink[] ] continue
            if [ e.is_dir[] ]
                add_programs[ '{e}' ]
                continue
            add_file[ '{e}' ]
            add_deps[ '{e}' ]

    # the word of an export line: run: ['blender'] gives blender
    func export_word [ t: string, key: string ] -> string
        at : i32 [ t.index_of[ '\n{key}: [' ] ]
        if [ at < 0 ] return ''
        tail : t.mid[ at, t.count - at ]
        q : i32 [ tail.index_of[ "'" ] ]
        if [ q < 0 ] return ''
        word : tail.mid[ q + 1, tail.count - q - 1 ]
        e : i32 [ word.index_of[ "'" ] ]
        if [ e <= 0 ] return ''
        return word.mid[ 0, e ]

    # every built app and scene module (the export registry's
    # software: and scenes: lines) with all it needs to run
    func add_apps []
        ex : path '{install}/export'
        regs : ex.ls[ null, false ]
        if [ !regs ] return
        n : i32 [ 0 ]
        for [ r: path ] in regs
            nm : r.filename[]
            if [ !nm.ends_with[ '.agi' ] ] continue
            t : string r.load[ typeid[ string ], null ]
            if [ !t ] continue
            t = '\n{t}'
            app : bool [ t.index_of[ '\nsoftware:' ] >= 0 ]
            scene : bool [ t.index_of[ '\nscenes:' ] >= 0 ]
            if [ !app && !scene ] continue
            stem : nm.mid[ 0, nm.count - 4 ]
            # a server's tree: only the apps it was asked for
            if [ only_apps ]
                om : string [ (stem.starts_with[ 'silver-' ])
                    ? stem.mid[ 7, stem.count - 7 ] : stem ]
                if [ !only_apps.contains[ om ] ] continue
            # a module whose source is gone left a stale record
            srcf : first_line[ '{install}/build/{stem}.source' ].trim[]
            if [ srcf.count > 0 ]
                sp : path [ srcf ]
                if [ !sp.exists[] ]
                    log 'os-bootstrap: {stem}: its source is gone, left out'
                    continue
            # a program module (build none) has no product
            prod : '{install}/build/{stem}.product'
            lib : link_of[ prod ]
            if [ lib.count > 0 ]
                add_file[ lib ]
                add_deps[ lib ]
                for [ e: string ] in vec string [] [ '', '.abi', '.deps' ]
                    add_file[ '{prod}{e}' ]
                add_file[ '{install}/build/{stem}.source' ]
            mod : stem
            if [ stem.starts_with[ 'silver-' ] ]
                mod = stem.mid[ 7, stem.count - 7 ]
            for [ f: string ] in vec string [] [ '{install}/build/{mod}',
                    '{install}/bin/{mod}' ]
                fp : path [ f ]
                if [ fp.exists[] ]
                    add_file[ f ]
                    add_deps[ f ]
            # its link record: without it the drive relinks it
            add_file[ '{install}/build/{mod}.cmd' ]
            add_file[ '{install}/share/{stem}' ]
            add_file[ '{install}/share/{mod}' ]
            # the module folder's data git does not track (maps, models)
            src : first_line[ '{install}/build/{stem}.source' ].trim[]
            sl : i32 [ src.rindex_of[ '/' ] ]
            if [ lib.count > 0 && sl > 0 ]
                dir : src.mid[ 0, sl ]
                for [ d: string ] in vec string [] [ 'textures', 'models' ]
                    add_file[ '{dir}/{d}' ]
            add_run_program[ export_word[ t, 'run' ] ]
            # a daemon's program (its line's first word)
            dl : export_word[ t, 'daemon' ]
            sp : i32 [ i32[ dl.index_of[ ' ' ] ] ]
            add_run_program[ (sp > 0) ? dl.mid[ 0, sp ] : dl ]
            n += 1
        # what the apps spawn: WebKit's helpers and the like
        add_programs[ '{install}/libexec' ]
        # glib's TLS and proxy modules: dlopen, never a NEEDED
        add_programs[ '{install}/lib/gio' ]
        # a module's -I folders under install/lib (dbus-1.0/include)
        lib : path '{install}/lib'
        libs : lib.ls[ null, false ]
        if [ libs ]
            for [ d: path ] in libs
                inc : path '{d}/include'
                if [ d.is_dir[] && inc.is_dir[] ] add_file[ '{inc}' ]
        # the page process loads WebKit's bundle by its own path
        add_file[ '{install}/lib/wpe-webkit-2.0' ]
        add_programs[ '{install}/lib/wpe-webkit-2.0/injected-bundle' ]
        # fontconfig: its rules and the base's fonts (WebKit's text)
        add_file[ '/etc/fonts' ]
        add_file[ '/usr/share/fontconfig' ]
        add_file[ '/usr/share/fonts' ]
        log 'os-bootstrap: apps done, {n} modules, {files.count} entries'

    # orbiter reads install/export: the record and props of every
    # module whose product, launcher or program is in the tree
    func add_records []
        ex : path '{install}/export'
        # a library that came in as another's dependency (webgfx under
        # aura) after add_apps scanned: its records ride too, else the
        # drive takes it for never built and compiles it
        late : vec string []
        for [ e: OsFile ] in files
            nm : e.dst
            at : i64 [ nm.rindex_of[ '/' ] ]
            if [ at >= 0 ] nm = nm.mid[ i32[ at ] + 1, i32[ nm.count ] - i32[ at ] - 1 ]
            if [ nm.starts_with[ 'libsilver-' ] && nm.ends_with[ '.so' ] ]
                late.push[ nm.mid[ 10, i32[ nm.count ] - 13 ] ]
        for [ mod: string ] in late
            for [ ext: string ] in vec string [] [ '', '.abi', '.deps' ]
                add_file[ '{install}/build/silver-{mod}.product{ext}' ]
            add_file[ '{install}/build/silver-{mod}.source' ]
            add_file[ '{install}/build/silver-{mod}.artifacts' ]
            # the editor's colouring: a build's byproduct, so the
            # installer carries it (a launch never builds one)
            add_file[ '{install}/syntax/{mod}.f' ]
        regs : ex.ls[ null, false ]
        if [ !regs ] return
        n : i32 [ 0 ]
        for [ r: path ] in regs
            nm : r.filename[]
            if [ !nm.ends_with[ '.agi' ] || nm.ends_with[ '.props.agi' ] ]
                continue
            stem : nm.mid[ 0, nm.count - 4 ]
            mod : stem
            if [ stem.starts_with[ 'silver-' ] ]
                mod = stem.mid[ 7, stem.count - 7 ]
            t : string r.load[ typeid[ string ], null ]
            if [ !t ] continue
            srcf : first_line[ '{install}/build/{stem}.source' ].trim[]
            if [ srcf.count > 0 ]
                sp : path [ srcf ]
                if [ !sp.exists[] ] continue
            t = '\n{t}'
            run : bool [ t.index_of[ '\nrun:' ] >= 0
                || t.index_of[ '\nlaunch:' ] >= 0 ]
            here : bool [ run ]
            for [ f: string ] in vec string [] [
                    '{install}/build/{stem}.product',
                    '{install}/build/{mod}', '{install}/bin/{mod}' ]
                if [ seen.contains[ guest[ f ] ] ] here = true
            if [ !here ] continue
            add_file[ '{r}' ]
            add_file[ '{install}/export/{stem}.props.agi' ]
            add_file[ '{install}/build/{stem}.artifacts' ]
            n += 1
        log 'os-bootstrap: export records: {n}'

    # a program module's program (export run) and the tree it
    # links into: install/blender whole, install/lib/<name> whole
    func add_run_program [ prog: string ]
        if [ prog.count == 0 ] return
        bin : '{install}/bin/{prog}'
        bp : path [ bin ]
        if [ !bp.exists[] && !bp.is_symlink[] ] return
        add_file[ bin ]
        add_deps[ bin ]
        to : link_of[ bin ]
        if [ to.count == 0 ] return
        full : to
        if [ !to.starts_with[ '/' ] ] full = '{install}/bin/{to}'
        full = norm[ full ]
        pre : '{install}/'
        if [ !full.starts_with[ pre ] ] return
        rest : full.mid[ pre.count, full.count - pre.count ]
        parts : rest.split[ '/' ]
        if [ parts.count < 2 ] return
        top : parts[ 0 ]
        if [ top == 'bin' || top == 'build' ] return
        tree : '{pre}{top}'
        if [ top == 'lib' || top == 'share' ]
            second : parts[ 1 ]
            tree = '{pre}{top}/{second}'
        add_file[ tree ]
        add_programs[ tree ]

    func add_module [ mod: string ]
        for [ f: string ] in vec string [] [ '{install}/build/{mod}',
                '{install}/build/libsilver-{mod}.so' ]
            add_file[ f ]
            add_deps[ f ]
        add_file[ '{install}/build/silver-{mod}.product' ]
        add_file[ '{install}/share/silver-{mod}' ]
        add_file[ '{root}/{mod}/{mod}.ag' ]

    # bash and the everyday commands: the console, claude, git
    func add_shell []
        add_file[ '/bin/bash' ]
        add_deps[ '/bin/bash' ]
        names : vec string [] [ 'ls', 'cat', 'cp', 'mv', 'rm', 'mkdir',
            'rmdir', 'ln', 'chmod', 'chown', 'touch', 'head', 'tail',
            'wc', 'sort', 'uniq', 'cut', 'tr', 'tee', 'date', 'env',
            'echo', 'printf', 'pwd', 'basename', 'dirname', 'readlink',
            'realpath', 'stat', 'df', 'du', 'sleep', 'true', 'false',
            'test', '[', 'yes', 'seq', 'md5sum', 'sha256sum', 'mktemp',
            'nproc', 'id', 'whoami', 'uname', 'install', 'expr',
            'base64', 'comm', 'paste', 'od', 'split', 'tac', 'truncate',
            'sync', 'timeout', 'dd', 'grep', 'egrep', 'fgrep', 'sed',
            'find', 'xargs', 'diff', 'cmp', 'tar', 'gzip', 'gunzip',
            'zcat', 'xz', 'less', 'ps', 'kill', 'pgrep', 'pkill',
            'which', 'awk', 'curl', 'clear', 'tput', 'nano', 'vi',
            'top', 'free', 'uptime', 'watch', 'vmstat', 'pidof', 'pmap',
            'w' ]
        for [ nm: string ] in names
            t : '/usr/bin/{nm}'
            add_file[ t ]
            add_deps[ t ]
        # and every other program the base's packages hold
        for [ dir: string ] in vec string [] [ 'bin', 'sbin' ]
            d : path [ '{sysr}/usr/{dir}' ]
            for [ f: path ] in d.ls[ null, false ]
                t : '/usr/{dir}/{f.filename[]}'
                add_file[ t ]
                add_deps[ t ]
        # terminal descriptions: less, clear, nano, bash's line edits
        add_file[ '/usr/share/terminfo' ]
        # alsa's own configuration: every sound device open reads it
        add_file[ '/usr/share/alsa' ]
        # python: build scripts and tools on the drive
        add_file[ '/usr/bin/python3' ]
        add_file[ '/usr/bin/python3.12' ]
        add_deps[ '/usr/bin/python3.12' ]
        add_file[ '/usr/lib/python3.12' ]
        add_file[ '/usr/lib/python3' ]
        # X11 programs in orbiter's compositor run on Xwayland
        add_file[ '/usr/bin/Xwayland' ]
        add_deps[ '/usr/bin/Xwayland' ]
        add_file[ '/usr/lib/xorg' ]
        add_file[ '/usr/share/X11' ]

    # xdg-open: an address goes to orbiter, which hosts aura on it
    func add_open []
        bin : '{out_dir}/xdg-open'
        cmd : '{install}/bin/clang -static -Os -o "{bin}" "{root}/orbiter/xdg-open.c"'
        open_build : command [ cmd ]
        if [ open_build.exec[ false ] != 0 ]
            log 'os-bootstrap: xdg-open.c did not build'
            return
        dst : 'usr/bin/xdg-open'
        if [ seen.contains[ dst ] ] return
        seen[ dst ] = true
        add_dir[ 'usr/bin' ]
        files.push[ OsFile [ src: bin, dst: dst ] ]
        # the console names install/bin/xdg-open as BROWSER
        own : guest[ '{install}/bin/xdg-open' ]
        if [ seen.contains[ own ] ] return
        seen[ own ] = true
        add_dir[ own.mid[ 0, i32[ own.rindex_of[ '/' ] ] ] ]
        files.push[ OsFile [ src: bin, dst: own ] ]

    # claude by Anthropic's own installer, run here with a staging
    # home; its binary goes to /usr/local on orbiter-os
    func add_claude []
        home : '{install}/tmp/claude-home'
        vers : path '{home}/.local/share/claude/versions'
        if [ !vers.exists[] ]
            hp : path [ home ]
            hp.make_dir[]
            get : command { curl -fsSL https://claude.ai/install.sh
                -o {home}/install.sh && HOME={home} bash
                {home}/install.sh }
            if [ get.exec[ false ] != 0 ]
                log 'os-bootstrap: the claude installer failed'
                return
        newest : path
        for [ v: path ] in vers.ls[ null, false ]
            if [ !newest || v.modified_time[] > newest.modified_time[] ]
                newest = v
        if [ !newest ]
            log 'os-bootstrap: no claude in {vers}'
            return
        name : newest.filename[]
        # /root is orbiter-os's own (root-owned once booted)
        dst : 'usr/local/share/claude/versions/{name}'
        if [ seen.contains[ dst ] ] return
        seen[ dst ] = true
        add_dir[ 'usr/local/share/claude/versions' ]
        files.push[ OsFile [ src: '{newest}', dst: dst ] ]
        add_dir[ 'usr/local/bin' ]
        seen[ 'usr/local/bin/claude' ] = true
        files.push[ OsFile [ dst: 'usr/local/bin/claude',
            link: '/{dst}' ] ]
        add_deps[ '{newest}' ]
        # https roots for claude's sign in and its requests
        add_file[ '/etc/ssl/certs/ca-certificates.crt' ]
        log 'os-bootstrap: claude {name}'

    # the session bus init starts: apps' tray icons reach orbiter
    func add_tray []
        add_file[ '/usr/bin/dbus-daemon' ]
        add_deps[ '/usr/bin/dbus-daemon' ]
        add_tree_at[ '{root}/tray/root/etc', 'etc' ]

    # Wi-Fi: iwd (the wifi module's import), the system bus it is
    # driven over, and their config from wifi/root
    func add_wifi []
        iwd : '{install}/libexec/iwd'
        ip : path [ iwd ]
        if [ !ip.exists[] ]
            log 'os-bootstrap: no iwd (build the wifi module)'
            return
        for [ t: string ] in vec string [] [ iwd, '/usr/bin/dbus-daemon' ]
            add_file[ t ]
            add_deps[ t ]
        add_file[ '{install}/share/dbus-1/system.d' ]
        add_tree_at[ '{root}/wifi/root/etc', 'etc' ]
        add_tree_at[ '{root}/wifi/root/usr/sbin', 'usr/sbin' ]

    # names resolve (glibc loads nss by dlopen: never a NEEDED), and
    # a wired address by dhcpcd (iwd does Wi-Fi's own)
    func add_network []
        lib : '/usr/lib/x86_64-linux-gnu'
        for [ f: string ] in vec string [] [ '/etc/nsswitch.conf',
                '/etc/hosts', '/etc/host.conf', '/etc/services',
                '/etc/protocols', '{lib}/libnss_files.so.2',
                '{lib}/libnss_dns.so.2', '/usr/sbin/dhcpcd',
                '/usr/lib/dhcpcd' ]
            add_file[ f ]
            add_deps[ f ]

    # the install wizard's programs, and the shell popen runs
    func add_tools []
        tools : vec string [] [ '/bin/sh', '/usr/sbin/sfdisk',
            '/usr/sbin/mkfs.vfat', '/usr/sbin/mkfs.ext4',
            '/usr/bin/efibootmgr', '/usr/sbin/e2fsck',
            '/usr/sbin/resize2fs', '/usr/sbin/ntfsresize',
            '/usr/bin/partx', '/usr/sbin/mkswap',
            '/usr/bin/fallocate', '/usr/bin/lsblk' ]
        for [ t: string ] in tools
            add_file[ t ]
            add_deps[ t ]
        # mke2fs reads its defaults from here
        add_file[ '/etc/mke2fs.conf' ]
        # the wizard names the hardware from here
        add_file[ '/usr/share/misc/pci.ids' ]
        # init loads drivers by the hardware: modprobe, modinfo
        for [ t: string ] in vec string [] [ '/usr/sbin/modprobe',
                                             '/usr/sbin/modinfo' ]
            add_file[ t ]
            add_deps[ t ]
        # the kernel's modules (nvidia's in extra/) and firmware
        add_tree_at[ '{kdir}/kmods/lib/modules', 'usr/lib/modules' ]
        # firmware of drivers the kernel left out stays behind
        kb : selected[]
        if [ kb && kb.amd == 'none' ]
            left[ 'usr/lib/firmware/amdgpu' ] = true
            left[ 'usr/lib/firmware/radeon' ] = true
        if [ kb && kb.intel == 'none' ]
            left[ 'usr/lib/firmware/i915' ] = true
            left[ 'usr/lib/firmware/xe' ] = true
        add_file[ '/lib/firmware' ]
        # modprobe's blocklist and options: nvidiafb never loads
        add_tree_at[ '{root}/os-bootstrap/modprobe.d',
            'etc/modprobe.d' ]

    # the drive's initramfs: only /init, which enters /orbiter-os
    func write_boot []
        bin : '{out_dir}/init'
        cmd : '{install}/bin/clang -static -Os -o "{bin}" "{root}/os-bootstrap/init.c"'
        init_build : command [ cmd ]
        if [ init_build.exec[ false ] != 0 ]
            log 'os-bootstrap: init.c did not build'
            return
        rd : path '{out_dir}/root/boot/initramfs'
        write_cpio[ boot_files[ bin ], rd ]
        # for an install into a Windows partition: the boot program
        # and the NTFS driver it reads the kernel through
        bd : '{out_dir}/root/boot'
        cc : '{install}/bin/clang -target x86_64-unknown-windows'
        cc = '{cc} -ffreestanding -fno-stack-protector -O2'
        cc = '{cc} -mno-red-zone'
        ld : '{install}/bin/lld-link -subsystem:efi_application'
        ld = '{ld} -entry:efi_main -nodefaultlib'
        efs : '{install}/share/silver-os-bootstrap/efifs/ntfs_x64.efi'
        stub : command {
            {cc} -c {root}/os-bootstrap/efistub.c -o {out_dir}/stub.o &&
            {ld} -out:{bd}/orbiter.efi {out_dir}/stub.o &&
            cp {efs} {bd}/ntfs_x64.efi }
        if [ stub.exec[ false ] != 0 ]
            log 'os-bootstrap: the boot program did not build'

    # an initramfs's few entries: the device folders and /init
    func boot_files [ bin: string ] -> vec OsFile
        boot : vec OsFile []
        boot.push[ OsFile [ dst: 'dev', dir: true ] ]
        boot.push[ OsFile [ dst: 'dev/console', dev: true ] ]
        boot.push[ OsFile [ dst: 'proc', dir: true ] ]
        boot.push[ OsFile [ dst: 'sys', dir: true ] ]
        boot.push[ OsFile [ src: bin, dst: 'init' ] ]
        # NTFS before the root: a system in a Windows partition's image
        kb : selected[]
        if [ kb ]
            nt : path '{kb.dir}/kmods/lib/modules/{kb.release}/kernel/fs/ntfs3/ntfs3.ko'
            if [ nt.exists[] ]
                boot.push[ OsFile [ dst: 'lib', dir: true ] ]
                boot.push[ OsFile [ src: '{nt}', dst: 'lib/ntfs3.ko' ] ]
        return boot

    # a host file into the tree: its own mode and time kept
    func copy_file [ src: string, dst: string ]
        st : struct stat
        if [ stat[ src.chars, @st ] != 0 ] return
        mode : u32 [ st.st_mode & 0xFFF ]
        # the same file by its exact time: a source and its product
        # a second apart must keep their order (silver's rebuild test)
        dt : struct stat
        # macOS names the time st_mtimespec, Linux st_mtim
        if [ stat[ dst.chars, @dt ] == 0 ]
            ifdef [ apple ]
                if [ dt.st_mtimespec.tv_sec == st.st_mtimespec.tv_sec
                     && dt.st_mtimespec.tv_nsec
                        == st.st_mtimespec.tv_nsec ]
                    # an older write made it 0755: its own mode back
                    if [ (dt.st_mode & 0xFFF) != mode ]
                        chmod[ dst.chars, mode ]
                    return
            ifndef [ apple ]
                if [ dt.st_mtim.tv_sec == st.st_mtim.tv_sec
                     && dt.st_mtim.tv_nsec == st.st_mtim.tv_nsec ]
                    if [ (dt.st_mode & 0xFFF) != mode ]
                        chmod[ dst.chars, mode ]
                    return
        fi : handle fopen[ src.chars, 'rb' ]
        if [ !fi ] return
        # an older copy may be read only: a fresh file each time
        unlink[ dst.chars ]
        fo : handle fopen[ dst.chars, 'wb' ]
        if [ !fo ]
            log 'os-bootstrap: cannot write {dst}'
            fclose[ fi ]
            return
        buf : @u8 [ malloc[ 1 << 20 ] ]
        while [ true ]
            n : i64 [ fread[ buf, 1, 1 << 20, fi ] ]
            if [ n <= 0 ] break
            fwrite[ buf, 1, n, fo ]
        free[ buf ]
        fclose[ fi ]
        fclose[ fo ]
        chmod[ dst.chars, mode ]
        # the launcher compares product and source times
        ts : local timespec [ 2 ]
        ifdef [ apple ]
            ts[ 0 ] = st.st_atimespec
            ts[ 1 ] = st.st_mtimespec
        ifndef [ apple ]
            ts[ 0 ] = st.st_atim
            ts[ 1 ] = st.st_mtim
        utimensat[ AT_FDCWD, dst.chars, @ts[ 0 ], 0 ]

    # the guest as a folder, copied to /orbiter-os to boot
    func write_tree []
        base : '{out_dir}/root'
        say[ 'Writing the tree' ]
        # the top links come first: their folder must be there
        bp : path [ base ]
        bp.make_dir[]
        for [ e: OsFile ] in files
            if [ cancelled ] return
            # devtmpfs makes /dev/console on the drive
            if [ e.dev ] continue
            t : '{base}/{e.dst}'
            if [ e.dir ]
                tp : path [ t ]
                tp.make_dir[]
            el [ e.link ]
                # an older tree's real folder where a link now goes
                lt : path [ t ]
                if [ lt.is_dir[] && !lt.is_symlink[] ]
                    sh[ 'rm -rf "{t}"' ]
                unlink[ t.chars ]
                symlink[ e.link.chars, t.chars ]
            el
                copy_file[ e.src, t ]
        prune_tree[ base ]
        bd : path '{base}/boot'
        bd.make_dir[]
        copy_file[ '{kernel}', '{base}/boot/vmlinuz' ]
        # the install wizard's measure of the copy: all of the tree
        bytes : i64 [ tree_size[ base ] ]
        tb : '{base}/boot/tree-bytes'
        f : handle fopen[ tb.chars, 'w' ]
        if [ f ]
            fprintf[ f, "%lld\n", bytes ]
            fclose[ f ]
        say[ 'Wrote the tree: {files.count} entries, {bytes} bytes' ]

    # what an earlier write put in the install's build, export and
    # share folders and this list no longer names: gone (a deleted
    # module's product and record stayed on the drive)
    func prune_tree [ base: string ]
        tops : vec string [] [ 'build', 'export', 'share' ]
        for [ top: string ] in tops
            keep : map bool [ string ] []
            marks : vec string [] [ '/platform/native/{top}/',
                '/install/{top}/' ]
            for [ e: OsFile ] in files
                for [ mark: string ] in marks
                    at : i32 [ e.dst.index_of[ mark ] ]
                    if [ at < 0 ] continue
                    rest : e.dst.mid[ at + mark.count,
                        e.dst.count - at - mark.count ]
                    sl : i32 [ rest.index_of[ '/' ] ]
                    if [ sl > 0 ] rest = rest.mid[ 0, sl ]
                    keep[ rest ] = true
            if [ keep.count == 0 ] continue
            d : path '{base}/src/silver/platform/native/{top}'
            entries : d.ls[ null, false ]
            if [ !entries ] continue
            n : i32 [ 0 ]
            for [ e: path ] in entries
                nm : e.filename[]
                if [ keep.contains[ nm ] ] continue
                sh[ 'rm -rf "{e}"' ]
                n += 1
            if [ n > 0 ] log 'os-bootstrap: {top}: {n} stale entries removed'

    func cpio_pad [ f: @FILE, n: i64 ]
        k : i64 [ n ]
        while [ (k % 4) != 0 ]
            fputc[ 0, f ]
            k += 1

    # newc header: 6-char magic then 13 8-digit hex fields, then the name
    func cpio_header [ f: @FILE, name: string, mode: u32, size: i64, ino: i32, mtime: i64, rmajor: i32, rminor: i32 ]
        nlen : i32 [ i32[ name.count ] + 1 ]
        fprintf[ f, "070701%08x%08x%08x%08x%08x%08x%08x%08x%08x%08x%08x%08x%08x",
            ino, mode, 0, 0, 1, i32[ mtime ], i32[ size ], 0, 0, rmajor, rminor, nlen, 0 ]
        fwrite[ name.chars, 1, nlen, f ]
        cpio_pad[ f, 110 + nlen ]

    func write_cpio [ items: vec OsFile, out: path ]
        f : @FILE [ fopen[ out.chars, 'wb' ] ]
        if [ !f ]
            log 'os-bootstrap: cannot write {out}'
            return
        ino : i32 [ 1 ]
        # cpio mode words: file type then permissions (octal 040755 …)
        mode_dir  : u32 [ 0x41ED ]
        mode_file : u32 [ 0x81ED ]
        mode_link : u32 [ 0xA1FF ]
        mode_con  : u32 [ 0x2180 ]
        buf : @u8 [ malloc[ 1 << 20 ] ]
        now : i64 [ time[ null ] ]
        for [ e: OsFile ] in items
            ino += 1
            if [ e.dir ]
                cpio_header[ f, e.dst, mode_dir, 0, ino, now, 0, 0 ]
            el [ e.dev ]
                # major 5 minor 1 is the kernel console
                cpio_header[ f, e.dst, mode_con, 0, ino, now, 5, 1 ]
            el [ e.link ]
                cpio_header[ f, e.dst, mode_link, e.link.count, ino, now, 0, 0 ]
                fwrite[ e.link.chars, 1, e.link.count, f ]
                cpio_pad[ f, e.link.count ]
            el
                size : i64 [ file_size[ e.src ] ]
                sp : path [ e.src ]
                # the launcher compares product and source times: keep them
                cpio_header[ f, e.dst, mode_file, size, ino, sp.modified_time[] / 1000, 0, 0 ]
                src : handle fopen[ e.src.chars, 'rb' ]
                left : i64 [ size ]
                while [ src && left > 0 ]
                    n : i64 [ fread[ buf, 1, (left < (1 << 20)) ? left : (1 << 20), src ] ]
                    if [ n <= 0 ] break
                    fwrite[ buf, 1, n, f ]
                    left -= n
                if [ src ] fclose[ src ]
                cpio_pad[ f, size ]
        free[ buf ]
        cpio_header[ f, 'TRAILER!!!', 0, 0, 0, 0, 0, 0 ]
        fclose[ f ]
        log 'os-bootstrap: {items.count} entries -> {out}'

# the app: write the drive tree, then quit
element main : trinity
    width      : i32    [ 1280 ]
    height     : i32    [ 800 ]
    public  title      : string [ 'orbiter-os' ]
    public  background : string [ 'Background' ]
    # the connected phone updated, as the phone page's Update
    public  update     : bool
    # the phone's boot.img alone, from this kernel build (its name),
    # for the root whose uuid is boot_uuid
    public  boot_image : string
    public  boot_uuid  : string
    # the tree's folder, in place of orbiter-os (a scratch write)
    public  out        : string
    # the installer as an image file here (no stick written), for
    # the chosen kernel; answers: an unattended install's choices
    public  image      : string
    public  answers    : string

    func init []
        # outside a window: initialize gives it its defaults
        b : Bootstrap []
        b.initialize[]
        if [ out && out.count > 0 ] b.out_dir = path [ out ]
        if [ update ]
            if [ !b.phone_update[] ] log 'os-bootstrap: no update'
            Au.quit_request[]
            return
        if [ boot_image && boot_image.count > 0 ]
            img : ''
            for [ kb: KernelBuild ] in b.kernels
                if [ kb.name == boot_image ]
                    img = b.phone_image[ kb, boot_uuid ]
            log 'os-bootstrap: boot image {img}'
            Au.quit_request[]
            return
        if [ image && image.count > 0 ]
            if [ answers ] b.stick_answers = answers
            # a server (headless): its own tree, orbiter and the
            # answers' services alone
            hl : string [ (answers) ? answer_word[ answers, 'headless' ]
                : '' ]
            if [ hl == 'true' ]
                b.only_apps = answer_list[ answers, 'services' ]
                b.only_apps.push[ 'orbiter' ]
                b.out_dir = path '{tree_home[]}/headless'
                log 'os-bootstrap: a server: {b.only_apps.count} apps'
            # the tree brought up to this build first: the apps as
            # they are now (only newer files are copied)
            b.out_dir.make_dir[]
            if [ !b.assemble[] ]
                log 'os-bootstrap: the tree was not written'
                Au.quit_request[]
                return
            made : string b.make_image[]
            dest : string b.quoted[ image ]
            ok : bool [ made.count > 0 && b.sh[ 'mv {made} {dest}' ] ]
            if [ ok ] log 'os-bootstrap: installer image {image}'
            el log 'os-bootstrap: the image was not made'
            b.wipe[ b.image_work[] ]
            Au.quit_request[]
            return
        if [ b.kernels.count == 0 ]
            if [ !b.build_kernel[ b.want_hardware, b.want_version,
                    b.want_nvidia, b.want_amd, b.want_intel ] ]
                log 'os-bootstrap: the kernel did not build'
                Au.quit_request[]
                return
        b.out_dir.make_dir[]
        b.assemble[]
        Au.quit_request[]

