
class cursor
    intern  debug   : dbg
    public  source  : path
    public  line    : u32
    public  column  : u32

class variable
    intern  debug    : dbg
    public  name     : string
    public  type     : string
    public  value    : string
    public  children : vec Au
    public  expanded : bool

class frame
    intern  debug     : dbg
    public  func_name : string
    public  source    : path
    public  line      : u32

# delivered to on_exit when the inferior terminates.
class exited
    intern  debug : dbg
    public  code  : i32

class iobuffer
    intern  debug : dbg
    public  bytes : cstr
    public  count : i32

class breakpoint
    intern  debug   : dbg
    intern  removed : bool
    intern  lldb_bp : handle
    func dealloc [ ]

class dbg
    public   location    : path
    public   position    : cursor
    public   target      : Au
    public   on_stdout   : callback
    public   on_stderr   : callback
    public   on_break    : callback
    public   on_exit     : callback
    public   on_crash    : callback
    public   auto_start  : bool
    public   exceptions  : bool
    public   running     : bool
    public   poll        : async
    public   io          : async
    public   stdout_fifo : path
    public   stderr_fifo : path
    public   fifo_fd_out : i32
    public   fifo_fd_err : i32
    public   active      : bool
    # set_breakpoint results live here: unheld, the pool drain deallocs
    # them and breakpoint_dealloc deletes them out of lldb
    public   bps         : vec breakpoint

    intern   impl        : handle

    func step_into          [ ]
    func step_over          [ ]
    func step_out           [ ]
    func pause              [ ]
    func cont               [ ]
    func start              [ ]
    func attach             [ pid: i32 ]
    func stop               [ ]
    func read_arguments     [ ] -> vec Au
    func read_locals        [ ] -> vec Au
    func read_frames        [ ] -> vec Au
    func read_statics       [ ] -> vec Au
    func read_globals       [ ] -> vec Au
    func read_registers     [ ] -> vec Au
    func set_breakpoint     [ source: path, ln: u32, column: u32 ] -> breakpoint
    func remove_breakpoint  [ bp: breakpoint ]
    func enable_breakpoint  [ bp: breakpoint, enable: bool ]
    func init               [ ]
    func dealloc            [ ]
