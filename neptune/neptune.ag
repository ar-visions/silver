# neptune: a planet module over the scenes utilities
export 0.1.0
export scenes ['Neptune']
export dependencies ['orbiter']
import vec
import img
import gltf
import trinity
import tls
import scenes

import <stdio.h>
import <stdlib.h>
import <unistd.h>
    +_DEFAULT_SOURCE
    +_XOPEN_SOURCE=500

func neptune_bake [] -> bool
    si : Image [ uri: path '{scenes_share[]}/textures/saturn-color.png' ]
    if [ si.width == 0 ]
        log 'neptune: saturn plate missing'
        return false
    ji : Image [ uri: path '{scenes_share[]}/textures/jupiter-color.png' ]
    if [ ji.width == 0 ]
        log 'neptune: jupiter plate missing'
        return false
    w9 : i32 [ si.width ]
    h9 : i32 [ si.height ]
    jw : i32 [ ji.width ]
    jh : i32 [ ji.height ]
    log 'neptune: composing {w9}x{h9} saturn with {jw}x{jh} jupiter patches'
    sp : i32 [ si.pixel_size ]
    sdat : @u8 [ si.vdata[] ]
    jp : i32 [ ji.pixel_size ]
    jdat : @u8 [ ji.vdata[] ]
    im : Image [ width: w9, height: h9, format: Pixel.rgba8,
                 linear: true, wrap_u: true ]
    od : @u8 [ im.vdata[] ]
    # THE GREAT DARK SPOT, ours rather than jupiter's borrowed one: an
    # ellipse laid down with a brush whose edge is broken by perlin, so
    # it reads as a storm the bands are wrapping around instead of a
    # painted oval. wide and shallow, the way a banded planet holds one
    du : f32 [ 0.34 ]
    dv : f32 [ 0.385 ]
    for [ y: i32 0, y < h9, y += 1 ]
        v : f32 [ (f32[ y ] + 0.5) / f32[ h9 ] ]
        for [ x: i32 0, x < w9, x += 1 ]
            u : f32 [ (f32[ x ] + 0.5) / f32[ w9 ] ]
            sb : i32 [ (y * w9 + x) * sp ]
            r9 : f32 [ f32[ sdat[ sb ] ] / 255.0 ]
            g9 : f32 [ f32[ sdat[ sb + 1 ] ] / 255.0 ]
            b9 : f32 [ f32[ sdat[ sb + 2 ] ] / 255.0 ]
            l9 : f32 [ r9 * 0.299 + g9 * 0.587 + b9 * 0.114 ]
            cv : f32 [ (r9 - b9) * 0.5 ]

            # the spot: distance in an ellipse three times wider than
            # tall, with the boundary pushed in and out by two octaves
            dxx : f32 [ u - du ]
            if [ dxx > 0.5 ] dxx = dxx - 1.0
            if [ dxx < 0.0 - 0.5 ] dxx = dxx + 1.0
            dyy : f32 [ v - dv ]
            # 36 degrees of longitude across is not a storm, it is a
            # continent. 7x tighter puts it near jupiter's spot, and the
            # perlin wobble has to shrink with it or it swamps the shape
            rr : f32 [ sqrt[ dxx * dxx * 440.0 + dyy * dyy * 3100.0 ] ]
            nb1 : f32 [ eu_gnoise[ u * 34.0, v * 34.0, 3.0 ] ]
            nb2 : f32 [
                eu_gnoise[ u * 88.0 + 5.0, v * 88.0 + 11.0, 17.0 ] ]
            rr = rr + (nb1 - 0.5) * 0.30 + (nb2 - 0.5) * 0.12
            spot : f32 [ 1.0 - eu_sstep[ 0.30, 0.72, rr ] ]
            # a bright collar on its trailing edge, the way a dark storm
            # drags methane cloud around itself
            coll : f32 [
                eu_sstep[ 0.62, 0.86, rr ]
                * (1.0 - eu_sstep[ 0.86, 1.10, rr ]) ]
            l9 = l9 * (1.0 - spot * 0.62) + coll * 0.16

            # JUPITER PATCHES. saturn's deck is smooth to the point of
            # being featureless; jupiter's is the turbulence we want.
            # the mask is perlin sampled around a CIRCLE in longitude,
            # so it closes at the seam instead of cutting a hard line
            # ELONGATED along the wind. the circle radius sets how many
            # noise cells fit around the equator, so 1.6 is 10 cells of
            # 410 texels; 16 in latitude is 128 texels. that is a patch
            # three times wider than tall, lying WITH the bands
            ang : f32 [ u * 6.28318530718 ]
            mx : f32 [ cos[ ang ] * 1.6 + 6.0 ]
            my : f32 [ sin[ ang ] * 1.6 + 6.0 ]
            pm1 : f32 [ eu_gnoise[ mx, my, v * 16.0 ] ]
            # a finer turn breaks the blob edge, kept flat as well so it
            # frays the patch into ribbons instead of vertical fingers
            pm2 : f32 [
                eu_gnoise[ mx * 2.6 + 19.0, my * 2.6 + 7.0, v * 34.0 ] ]
            pm9 : f32 [ pm1 + (pm2 - 0.5) * 0.18 ]
            patch : f32 [ eu_sstep[ 0.44, 0.64, pm9 ] ]
            # FLIPPED in latitude and MIRRORED in longitude, so the
            # borrowed bands do not line up with anything jupiter reads
            # as. both plates are 4096x2048, so this is a direct index
            jx : i32 [ (1.0 - u) * f32[ jw ] ]
            jy : i32 [ (1.0 - v) * f32[ jh ] ]
            if [ jx < 0 ] jx = 0
            if [ jx >= jw ] jx = jw - 1
            if [ jy < 0 ] jy = 0
            if [ jy >= jh ] jy = jh - 1
            jb : i32 [ (jy * jw + jx) * jp ]
            jl : f32 [ (f32[ jdat[ jb ] ] * 0.299
                       + f32[ jdat[ jb + 1 ] ] * 0.587
                       + f32[ jdat[ jb + 2 ] ] * 0.114) / 255.0 ]
            # stretched about its own mid grey: jupiter's belts flatten
            # out once the ochre is gone, and flat is what we came here
            # to fix
            jl = (jl - 0.5) * 1.35 + 0.5
            if [ jl < 0.0 ] jl = 0.0
            if [ jl > 1.0 ] jl = 1.0
            l9 = l9 + (jl - l9) * patch * 0.80

            # DEEP BLUE: structure as luminance, hue carried in code --
            # tinting saturn's ochre would leave it fighting through
            nr : f32 [ l9 * 0.20 + cv * 0.10 ]
            ng : f32 [ l9 * 0.46 + cv * 0.06 ]
            nb : f32 [ l9 * 0.92 + 0.06 ]
            if [ nr < 0.0 ] nr = 0.0
            if [ ng < 0.0 ] ng = 0.0
            if [ nb > 1.0 ] nb = 1.0
            ob : i32 [ (y * w9 + x) * 4 ]
            od[ ob ]     = u8[ nr * 255.0 ]
            od[ ob + 1 ] = u8[ ng * 255.0 ]
            od[ ob + 2 ] = u8[ nb * 255.0 ]
            od[ ob + 3 ] = 255
    bd : path '../{share_name}/baked'
    bd.make_dir[]
    im.png[ path '../{share_name}/baked/neptune-color.png' ]
    log 'neptune: colour map written'
    return true

# separable running box, wrapping in x and clamping in y. eu_blur is
# a 3x3 kernel run N times -- four passes is a sigma of 1.6 texels,
# which is nothing at all on a plate 4096 across. result lands in S
func nep_box [ S: @f32, T: @f32, w: i32, h: i32, rx: i32, ry: i32 ]
    ivx : f32 [ 1.0 / f32[ rx * 2 + 1 ] ]
    ivy : f32 [ 1.0 / f32[ ry * 2 + 1 ] ]
    for [ y: i32 0, y < h, y += 1 ]
        row : i32 [ y * w ]
        acc : f32 [ 0.0 ]
        for [ k: i32 0 - rx, k <= rx, k += 1 ]
            xx : i32 [ k ]
            if [ xx < 0 ] xx = xx + w
            acc += S[ row + xx ]
        for [ x: i32 0, x < w, x += 1 ]
            T[ row + x ] = acc * ivx
            xo : i32 [ x - rx ]
            if [ xo < 0 ] xo = xo + w
            xn : i32 [ x + rx + 1 ]
            if [ xn >= w ] xn = xn - w
            acc = acc - S[ row + xo ] + S[ row + xn ]
    for [ x: i32 0, x < w, x += 1 ]
        acc : f32 [ 0.0 ]
        for [ k: i32 0 - ry, k <= ry, k += 1 ]
            yy : i32 [ k ]
            if [ yy < 0 ] yy = 0
            if [ yy >= h ] yy = h - 1
            acc += T[ yy * w + x ]
        for [ y: i32 0, y < h, y += 1 ]
            S[ y * w + x ] = acc * ivy
            yo : i32 [ y - ry ]
            if [ yo < 0 ] yo = 0
            yn : i32 [ y + ry + 1 ]
            if [ yn >= h ] yn = h - 1
            acc = acc - T[ yo * w + x ] + T[ yn * w + x ]

# the storm mask for neptune: jupiter's tone term, but taken off a
# BLURRED plate. jupiter reads darkness where neptune reads brightness
# -- its bright methane cloud IS the weather.
#
# the blur is the whole point. thresholding the plate directly gave
# features a median FOUR texels tall running the full circumference,
# which is what the hairlines were; widening the ramp only made them
# more numerous, never thicker. blurred at radius 16 first, the same
# threshold gives a median of 86 texels and a p90 of 349
func neptune_storm [] -> bool
    ci : Image [ uri: path '../{share_name}/baked/neptune-color.png' ]
    if [ ci.width == 0 ] return false
    w9 : i32 [ ci.width ]
    h9 : i32 [ ci.height ]
    n9 : i32 [ w9 * h9 ]
    L : new f32 [ n9 ]
    eu_lum[ ci, L ]
    # JUPITER'S BAKE, line for line: an isotropic sobel MAX'd with a
    # tone term, then one light gaussian. the structure has to come
    # off the plate itself -- perlin alone gives smears, not cloud.
    # 14, not jupiter's 4: the blue mapping packs this plate into
    # luminance 0.16-0.44, so its gradients are a third of jupiter's
    S : new f32 [ n9 ]
    for [ y: i32 0, y < h9, y += 1 ]
        ym : i32 [ (y > 0) ? y - 1 : 0 ]
        yp : i32 [ (y < h9 - 1) ? y + 1 : h9 - 1 ]
        for [ x: i32 0, x < w9, x += 1 ]
            xm : i32 [ (x > 0) ? x - 1 : w9 - 1 ]
            xp : i32 [ (x < w9 - 1) ? x + 1 : 0 ]
            gx : f32 [ L[ y * w9 + xp ] - L[ y * w9 + xm ] ]
            gy : f32 [ L[ yp * w9 + x ] - L[ ym * w9 + x ] ]
            # 30, not 14. MEASURED: sobel alone peaked at 0.69 of a
            # map the shader reads through smoothstep[0.10, 0.72], so
            # only 0.3% of it ever cleared half. 30 saturates the
            # strongest shear lines and puts ~7% over that gate
            mg : f32 [ sqrt[ gx * gx + gy * gy ] * 30.0 ]
            if [ mg > 1.0 ] mg = 1.0
            # SOBEL ONLY. max'ing this with a brightness term filled
            # broad areas, and a broad mask lets the perlin paint open
            # blobs while the edges stand alone as closed loops --
            # fingerprints. edges alone confine every flash to a shear
            # line, so what draws is a streak running with the band
            S[ y * w9 + x ] = mg
    T : new f32 [ n9 ]
    eu_blur[ S, T, w9, h9, 4 ]
    im : Image [ width: w9, height: h9, format: Pixel.rgba8,
                 linear: true, wrap_u: true ]
    od : @u8 [ im.vdata[] ]
    for [ i: i32 0, i < n9, i += 1 ]
        v9 : f32 [ T[ i ] ]
        if [ v9 < 0.0 ] v9 = 0.0
        if [ v9 > 1.0 ] v9 = 1.0
        b4 : i32 [ i * 4 ]
        od[ b4 ]     = u8[ v9 * 255.0 ]
        od[ b4 + 1 ] = 0
        od[ b4 + 2 ] = 0
        od[ b4 + 3 ] = 255
    im.png[ path '../{share_name}/baked/neptune-storm.png' ]
    log 'neptune: storm map written'
    return true

# the ring strip, computed rather than sourced -- neptune has no
# photograph to cut one from. it is read radially only, so one row is
# the whole ring system: x is radius, alpha is how much it blocks.
#
# REAL RADII, in km, against neptune's 24764 equatorial radius. the
# strip spans 40900 to 64500 so Adams lands inside the shader's outer
# edge fade instead of being clipped by it:
#   Galle      41900, ~2000 wide, dust, the faintest of them
#   Le Verrier 53200, ~113 wide
#   Lassell    53200-57200, a broad faint sheet bridging two narrows
#   Arago      57200, narrow
#   Galatea    61953, an unnamed thread at the shepherd's orbit
#   Adams      62933, ~35 wide, the brightest
func nep_ring_r0 [] -> f32
    return 40900.0
func nep_ring_r1 [] -> f32
    return 64500.0

func neptune_rings [] -> bool
    w9 : i32 [ 2048 ]
    h9 : i32 [ 4 ]
    r0 : f32 [ nep_ring_r0[] ]
    r1 : f32 [ nep_ring_r1[] ]
    im : Image [ width: w9, height: h9, format: Pixel.rgba8,
                 linear: true ]
    od : @u8 [ im.vdata[] ]
    for [ x: i32 0, x < w9, x += 1 ]
        t  : f32 [ (f32[ x ] + 0.5) / f32[ w9 ] ]
        km : f32 [ r0 + t * (r1 - r0) ]
        # each ring's optical depth, scaled so the faint ones survive
        # the 8-bit strip. voyager measured Adams and Le Verrier as
        # the only two that read at all; the rest are dust
        a9 : f32 [ 0.0 ]
        # the named rings, every shoulder ~3x softer than a hard edge
        a9 += nep_band[ km, 41900.0, 1000.0, 1800.0 ] * 0.10
        a9 += nep_band[ km, 53200.0,   60.0,  420.0 ] * 0.55
        a9 += nep_band[ km, 55200.0, 2000.0,  900.0 ] * 0.06
        a9 += nep_band[ km, 57200.0,   50.0,  380.0 ] * 0.18
        a9 += nep_band[ km, 61953.0,   40.0,  350.0 ] * 0.05
        a9 += nep_band[ km, 62933.0,   25.0,  340.0 ] * 0.85
        # minor threads flanking the two bright ones, softer again --
        # no hard width at all, just a wide gaussian either side
        a9 += nep_band[ km, 52150.0,    0.0,  620.0 ] * 0.11
        a9 += nep_band[ km, 54300.0,    0.0,  680.0 ] * 0.09
        a9 += nep_band[ km, 61750.0,    0.0,  700.0 ] * 0.12
        a9 += nep_band[ km, 63950.0,    0.0,  640.0 ] * 0.10
        if [ a9 > 1.0 ] a9 = 1.0
        # dark and near neutral, a touch warm -- voyager saw grey dust,
        # not saturn's bright ice
        cr : f32 [ 0.66 ]
        cg : f32 [ 0.63 ]
        cb : f32 [ 0.61 ]
        for [ y: i32 0, y < h9, y += 1 ]
            b4 : i32 [ (y * w9 + x) * 4 ]
            od[ b4 ]     = u8[ cr * 255.0 ]
            od[ b4 + 1 ] = u8[ cg * 255.0 ]
            od[ b4 + 2 ] = u8[ cb * 255.0 ]
            od[ b4 + 3 ] = u8[ a9 * 255.0 ]
    bd : path '../{share_name}/baked'
    bd.make_dir[]
    im.png[ path '../{share_name}/baked/neptune-ring.png' ]
    log 'neptune: ring strip written'
    return true

func neptune_maps []
    h1 : u64 [ @neptune_bake ]
    h2 : u64 [ @neptune_storm ]
    h3 : u64 [ @neptune_rings ]
    stamp : string '{h1}-{h2}-{h3}'
    sp : path '../{share_name}/baked/neptune.hash'
    cp : path '../{share_name}/baked/neptune-color.png'
    stp : path '../{share_name}/baked/neptune-storm.png'
    rgp : path '../{share_name}/baked/neptune-ring.png'
    if [ sp.exists[] && cp.exists[] && stp.exists[] && rgp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            log 'neptune: colour map current ({stamp})'
            return
    if [ neptune_bake[] && neptune_storm[] && neptune_rings[] ]
        sp.save[ stamp, null ]
export func neptune_export []
    neptune_maps[]

# NEPTUNE. the ball is composed, not sourced: saturn's poles, jupiter's
# middle flipped and mirrored with its great spot swirled into another
# shape, driven deep blue. the discharges here are WHITE cloud forming
# along the wind, off an elongated streak basis rather than a sobel
Backdrop Neptune
    frost : true
    public func bg_color [ ] -> rgba
        return color
    frost_sharp : true
    intern e_cur  : f32
    intern p_cur  : f32
    intern p_set  : bool
    intern nept   : JupiterShader
    intern rings  : RingShader
    intern sky    : GaiaShader
    intern models : vec Model
    intern target : Render
    intern built  : bool
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    public color  : rgba [ r:0.001, g:0.002, b:0.006, a:1.0 ]

    func build_models[]
        built     = true
        gltf      : build_globe[]
        cp : path '../{share_name}/baked/neptune-color.png'
        st : path '../{share_name}/baked/neptune-storm.png'
        rg : path '../{share_name}/baked/neptune-ring.png'
        if [ !cp.exists[] || !st.exists[] || !rg.exists[] ]
            log 'neptune: no baked maps — composing live'
            neptune_bake[]
            neptune_storm[]
            neptune_rings[]
        nept = JupiterShader [ vk: vk ]
        n_samplers : map Image [string] [
            'color':  Image [ uri: cp, surface: TitanSurface.color,
                              linear: true, wrap_u: true ],
            'height': Image [ uri: st, surface: TitanSurface.height,
                              linear: true, wrap_u: true ]
        ]
        nept_model : Model [ vk: vk, w: ux, id: gltf, s: nept,
                             samplers: n_samplers,
            straight_alpha: true ]
        rings = RingShader [ vk: vk ]
        r_samplers : map Image [string] [
            'color': Image [ uri: rg, surface: TitanSurface.color,
                             linear: true ]
        ]
        ring_model : Model [ vk: vk, w: ux, id: gltf, s: rings,
                             samplers: r_samplers,
            straight_alpha: true ]
        sky = GaiaShader [ vk: vk ]
        sky_samplers : map Image [string] [
            'color': Image [ uri: path '{scenes_share[]}/textures/gaia.png', surface: GaiaSurface.color ]
        ]
        sky_model : Model [ vk: vk, w: ux, id: gltf, s: sky,
                            samplers: sky_samplers,
            straight_alpha: true, cull_none: true ]
        models = vec Model [] [sky_model, nept_model, ring_model ]

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        # the backdrop sits under frost or blur: one pixel per point
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      (ux.scale > 1.0) ? 1.0 / ux.scale : 1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.owner  = a
        ux.element_targets[ id ] = target

    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    func load_bg [ arg: object :: t: Neptune ]
        t.build_models[]
        t.ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : vec Au []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: lambda load_bg[ a ],
                                work: w9 ]
        if [ !ready ] return
        # the done job held this element: let it go
        if [ load_task ] load_task = null
        create_target[]
        orbit[]

    func orbit[]
        aspect : f32 [
            (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ]
            : 1.7778 ]
        e_t    : f32 [ (vantage == OrbitView.low)  ? 1.95 :
                       (vantage == OrbitView.high) ? 2.55 :
                       (vantage == OrbitView.far)  ? 3.60 : 5.20 ]
        if [ e_cur == 0.0 ] e_cur = e_t
        e_cur = filter_n[ e_cur, e_t, 0.08, ux.frame_factor ]
        p_t    : f32 [ (angle == ViewAngle.flat)   ? 0.0 :
            (angle == ViewAngle.angled) ? 0.156 : 0.480 ]
        if [ p_cur == 0.0 && p_t != 0.0 && !p_set ] p_cur = p_t
        p_set  = true
        p_cur  = filter_n[ p_cur, p_t, 0.08, ux.frame_factor ]
        ux.orbit_moving = abs[ e_cur - e_t ] > 0.002 || abs[
            p_cur - p_t ] > 0.001

        e_d    : f32 [ e_cur ]
        _eye   : vec3f [ 0.0,  e_d * p_cur, e_d ]
        _tgt   : vec3f [ 0.0,  0.0,  0.0  ]
        _up    : vec3f [ 0.0, -1.0,  0.0  ]
        _proj  : mat4f.perspective[ radians[ 55.0 ], aspect, 0.01,
                                    90.0 ]
        _view  : mat4f.look_at    [ _eye, _tgt, _up ]

        # neptune turns in 16 hours: the fastest deck in the system
        # SATURN'S rate exactly
        spin_d : f32 [ ux.time * 9000.0 ]
        q_spin : quatf [ vec4f [ 0.0, 1.0, 0.0, radians[ spin_d ] ] ]
        # a heavy tilt runs the bands diagonally across the disk, and
        # counter-moving bands are only readable when they lie flat
        q_tilt : quatf [ vec4f [ 0.0, 0.0, 1.0, radians[ 8.0 ] ] ]
        mm : mat4f.identity[]
        mm = mm.rotate[ q_tilt ]
        mm = mm.rotate[ q_spin ]
        nept.model   = mm
        nept.view    = _view
        nept.proj    = _proj
        nept.gain    = 1.05
        nept.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        # JUPITER'S EFFECT, only white. the mix-to-white path ignores
        # these two entirely, so they are here to say what colour it is
        # w 0.0 keeps neptune exactly as it was -- events, not standing
        nept.pc_a = vec4f [ 1.00, 1.00, 1.00, 0.0 ]
        # w 0.00015, the same gentle carry jupiter gets
        nept.pc_b = vec4f [ 1.00, 1.00, 1.00, 0.00015 ]
        # UNSTRETCHED, jupiter's own 1.0/1.0. the 0.35/1.40 bias drew
        # every perlin cell into an 8:1 smear, which is what read as
        # fake -- shape has to come off the sobel, not the noise.
        # z 0 adds no colour; w 0.50 lifts the blue halfway to white
        nept.pstr = vec4f [ 1.0, 1.0, 0.0, 0.50 ]
        # jupiter's threshold, rate and duty verbatim. w 0.0 lights the
        # whole disk instead of only the dark side
        # y is the pulse rate. nept.time advances 240 a second at
        # ludicrous, so the old 0.9 ran the fade at 34 HERTZ -- a
        # strobe above the frame rate, aliasing rather than fading.
        # 0.0065 is a four second cycle. z 1.0 leaves pow[] a plain
        # sine, the gentlest ramp there is in and out
        nept.pctl = vec4f [ 0.69, 0.00325, 1.0, 0.0 ]
        # SATURN'S WIND, verbatim. these are the exact constants out of
        # SaturnShader: 0.60 jet at 0.012 width, 0.22 lobes at 43.98
        # with a 1.8 decay, 0.16 shear, and its 0.05 ping-pong rate
        # saturn's profile, with the lobes carrying further out and
        # the shear doubled -- saturn reads its counter-motion against
        # a ring plane and a hard band structure; neptune's deck is
        # smooth, so the same numbers show nothing at all on it
        # z 0.0125 is jupiter's ping-pong rate, not saturn's 0.05 --
        # 0.05 shears the deck back and forth three times a SECOND,
        # which is jitter rather than wind. w 18.0 keeps the pulse
        # broader than the 25 cells now down the latitude; any finer
        # than the cell and it prints the cell as stripes
        nept.wctl  = vec4f [ 0.34, 0.012, 43.98, 0.46 ]
        nept.wctl2 = vec4f [ 0.60, 1.1, 0.0125, 18.0 ]
        # w 0.0: neptune is already blue; nothing to push it toward
        nept.tint  = vec4f [ 1.0, 1.0, 1.0, 0.0 ]
        nept.pfire = vec4f [ 1.0, 0.6, 0.2, 0.0 ]
        nept.pfire2 = vec4f [ 1.0, 0.9, 0.7, 0.0 ]
        # WITHOUT THIS the shader sees time 0 -- no wind shift, no spin,
        # no noise evolution. the pattern freezes onto the surface and
        # simply rotates with the ball, which is exactly what it did
        nept.time = ux.time * 60000.0

        # the rings share the ball's tilt but NOT its spin -- a ring
        # system does not turn with the planet under it. true scale is
        # 64500 km over neptune's 24764, or 2.604 ball radii; drawn a
        # bit closer in than that so they sit against the disk
        r_sc : vec3f [ 2.25, 0.002, 2.25 ]
        rm : mat4f.identity[]
        rm = rm.rotate[ q_tilt ]
        rm = rm.scale [ r_sc ]
        rings.model   = rm
        rings.view    = _view
        rings.proj    = _proj
        # faint. voyager needed long exposures to see these at all
        rings.gain    = 0.75
        rings.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        # x is inner 40900 over outer 64500, unchanged by the scale.
        # y is the ball over the ring outer, which the pull-in DID
        # change: 1.0 / 2.25, not 1.0 / 2.604
        rings.rgeo    = vec4f [ 0.6341, 0.4444, 0.0, 0.0 ]

        skq : quatf [ vec4f [ 1.0, 0.0, 0.0, radians[ 45.0 ] ] ]
        skm : mat4f.identity[]
        skm = skm.rotate[ skq ]
        skm = skm.scale [ vec3f [ 30.0, 30.0, 30.0 ] ]
        sky.model = skm
        sky.view  = _view
        sky.proj  = _proj
        sky.gain  = 0.45
        sky.time  = ux.time * 60000.0

# the pictures for orbiter's scene picker; last, after the bakes
export func neptune_thumbs []
    names : vec string [] [ 'Neptune' ]
    dir   : path '../{share_name}/thumbs'
    scene_thumbs_for[ names, dir ]
