extend scenes

# jupiter: Björn Jónsson's Cassini + Juno cylindrical map (The Planetary
# Society),
# 14400x7200, resampled to 4096x2048 at export
export func bake_jupiter []
    root : path.path_startup[]
    out  : path '{root}/scenes/textures/jupiter-color.png'
    force : getenv[ 'SILVER_EXPORT_FORCE' ]
    if [ !force && out.exists[] ]
        log 'scenes: jupiter map current'
        return
    dir : path.path_storage[ 'scenes' ]
    src : path '{dir}/jupiter-css-juno.jpg'
    if [ !src.exists[] ]
        n : i64 [
            Http.download[
                'https://planetary.s3.amazonaws.com/web/assets/pictures/20180511_jupiter_map_css_plus_juno_bj.jpg', src ] ]
        log 'scenes: fetched the jupiter map ({n} bytes)'
    im : Image [ uri: src ]
    if [ !im || im.width == 0 ]
        log 'scenes: cannot read {src}'
        return
    jup : im.resize[ 4096, 2048 ]
    jup.png[ out ]
    log 'scenes: jupiter map baked -> {out}'

# 8-dir horizon walk on the equirect height, wrap x clamp y
func eu_bake_ao [ H: @f32, AO: @f32, w: i32, h: i32, hscale: f32 ]
    dxs : new f32 [ 8 ]
    dys : new f32 [ 8 ]
    for [ d: i32 0, d < 8, d += 1 ]
        aa : f32 [ f32[ d ] * 0.7853982 ]
        dxs[ d ] = cos[ aa ]
        dys[ d ] = sin[ aa ]
    for [ y: i32 0, y < h, y += 1 ]
        fy : f32 [ y ]
        for [ x: i32 0, x < w, x += 1 ]
            h0 : f32 [ H[ y * w + x ] ]
            fx : f32 [ x ]
            occ : f32 [ 0.0 ]
            for [ d: i32 0, d < 8, d += 1 ]
                m : f32 [ 0.0 ]
                jt : f32 [ eu_hash2[ fx, fy, f32[ d ] ] * 4.0 ]
                for [ s: i32 1, s <= 12, s += 1 ]
                    dist : f32 [ f32[ s * 4 ] + jt ]
                    px : i32 [ x + i32[ dxs[ d ] * dist ] ]
                    py : i32 [ y + i32[ dys[ d ] * dist ] ]
                    px = px % w
                    if [ px < 0 ] px += w
                    if [ py < 0 ] py = 0
                    if [ py >= h ] py = h - 1
                    sl : f32 [ (H[ py * w + px ] - h0) * hscale / dist ]
                    if [ sl > m ] m = sl
                occ += m / (1.0 + m)
            v2 : f32 [ 1.0 - occ * 0.17 ]
            if [ v2 < 0.0 ] v2 = 0.0
            AO[ y * w + x ] = v2

# jupiter overhead: saturn's ball minus the rings, winds kept
ModelViewProject JupiterShader
    mutable gain    : f32
    mutable cam_pos : vec4f
    # the two discharge colours, picked between per region. jupiter
    # runs sodium orange against hydrogen blue; neptune wants white
    mutable pc_a    : vec4f
    mutable pc_b    : vec4f
    # xy scales the discharge noise. equal is blobs; x well under y
    # draws every cell out along the wind into a streak
    mutable pstr    : vec4f
    # x = noise threshold, y = pulse rate, z = duty exponent. neptune
    # wants rarer cells that fire briefly; jupiter wants the opposite
    mutable pctl    : vec4f
    # the crosswind: x = shear amplitude, y = equatorial jet width,
    # z = lobe frequency, w = lobe amplitude. jupiter's profile dies
    # outside 18 degrees of the equator, which leaves most of a disk
    # standing still
    mutable wctl    : vec4f
    # x = jet amplitude, y = lobe decay, z = ping-pong rate. with wctl
    # this is the whole wind model, so one planet can be handed
    # another's verbatim
    mutable wctl2   : vec4f
    # a LIVE albedo tint, MULTIPLIED onto the texture colour. rgb is
    # the per-channel factor, w how far the blend is ever allowed to
    # go. driven by its own drifting perlin, so unlike a baked patch
    # it comes and goes with the weather
    mutable tint    : vec4f
    # FIRE ON THE PLATE at the poles: rgb the DEEP colour, w its
    # strength. a ring burnt into the surface itself -- this is what
    # the marched aurora above it is standing on
    mutable pfire   : vec4f
    # the pale end of that fire. the ring runs between the two along
    # its length, so it is never one flat colour
    mutable pfire2  : vec4f

    attrib color : LayoutBinding [ type:typeid[ TitanSurface ],
                                   id:TitanSurface.color, count:1,
                                   format: typeid[ rgba8 ] ]
    # baked sobel contrast of the color map: where storms live
    attrib height : LayoutBinding [ type:typeid[ TitanSurface ],
                                    id:TitanSurface.height, count:1,
                                    format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_normal    : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_uv        : VertexOutput [ type:typeid[ vec2f ] ]
    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]

    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]

    func jp_perm4 [ x: vec4f ] -> GLSL vec4f {
        return mod((x * 34.0 + 1.0) * x, vec4(289.0));
    }

    func jp_isqrt4 [ r: vec4f ] -> GLSL vec4f {
        return 1.79284291400159 - 0.85373472095314 * r;
    }

    func jp_gnoise [ P: vec3f ] -> GLSL float {
        vec3 Pi0 = mod(floor(P), vec3(289.0));
        vec3 Pi1 = mod(Pi0 + vec3(1.0), vec3(289.0));
        vec3 Pf0 = fract(P);
        vec3 Pf1 = Pf0 - vec3(1.0);
        vec4 ix  = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
        vec4 iy  = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
        vec4 iz0 = vec4(Pi0.z);
        vec4 iz1 = vec4(Pi1.z);
        vec4 ixy  = jp_perm4(jp_perm4(ix) + iy);
        vec4 ixy0 = jp_perm4(ixy + iz0);
        vec4 ixy1 = jp_perm4(ixy + iz1);
        vec4 gx0 = fract(ixy0 / 7.0) * 2.0 - 1.0;
        vec4 gy0 = fract(floor(ixy0 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz0 = 1.0 - abs(gx0) - abs(gy0);
        vec4 gx1 = fract(ixy1 / 7.0) * 2.0 - 1.0;
        vec4 gy1 = fract(floor(ixy1 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz1 = 1.0 - abs(gx1) - abs(gy1);
        vec4 sz0 = step(gz0, vec4(0.0));
        gx0 -= sz0 * (step(0.0, gx0) - 0.5);
        gy0 -= sz0 * (step(0.0, gy0) - 0.5);
        vec4 sz1 = step(gz1, vec4(0.0));
        gx1 -= sz1 * (step(0.0, gx1) - 0.5);
        gy1 -= sz1 * (step(0.0, gy1) - 0.5);
        vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
        vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
        vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
        vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
        vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
        vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
        vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
        vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);
        vec4 nm0 = jp_isqrt4(vec4(dot(g000,g000), dot(g010,g010), dot(g100,g100), dot(g110,g110)));
        g000 *= nm0.x; g010 *= nm0.y; g100 *= nm0.z; g110 *= nm0.w;
        vec4 nm1 = jp_isqrt4(vec4(dot(g001,g001), dot(g011,g011), dot(g101,g101), dot(g111,g111)));
        g001 *= nm1.x; g011 *= nm1.y; g101 *= nm1.z; g111 *= nm1.w;
        float n000 = dot(g000, Pf0);
        float n100 = dot(g100, vec3(Pf1.x, Pf0.y, Pf0.z));
        float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
        float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
        float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
        float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
        float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
        float n111 = dot(g111, Pf1);
        vec3  fxyz = Pf0 * Pf0 * Pf0 * (Pf0 * (Pf0 * 6.0 - 15.0) + 10.0);
        vec4  n_z  = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fxyz.z);
        vec2  n_yz = mix(n_z.xy, n_z.zw, fxyz.y);
        return mix(n_yz.x, n_yz.y, fxyz.x) * 0.5 + 0.5;
    }

    func init[]
        eye    : vec3f [0.0f, 0.0f, 2.5f]
        target : vec3f [0.0f, 0.0f, 0.0f]
        up     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye, target, up]

    func vertex[] -> GLSL none {
        v_uv        = vec2(1.0 - a_uv.x, a_uv.y);
        mat3 nm     = transpose(inverse(mat3(ubo.model)));
        v_normal    = normalize(nm * a_normal);
        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        vec3  n        = normalize(v_normal);
        vec3  sun      = normalize(vec3(0.85, -0.10, 0.15));
        vec3  view_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        // zonal winds: a hot equatorial jet plus thin alternating
        // lobes — jupiter runs more bands than saturn
        float la = v_uv.y - 0.5;
        float w  = ubo.wctl2.x * exp(-la * la / ubo.wctl.y)
                 + ubo.wctl.w * cos(la * ubo.wctl.z) * exp(-abs(la) * ubo.wctl2.y);
        // flow ping-pong: two half-cycle phases crossfaded, so shear
        // stays bounded and the bands slide forever without smearing
        float t9 = ubo.time * ubo.wctl2.z;
        float p0 = fract(t9);
        float p1 = fract(t9 + 0.5);
        float s0 = w * (p0 - 0.5) * ubo.wctl.x;
        float s1 = w * (p1 - 0.5) * ubo.wctl.x;
        float bl = abs(2.0 * p0 - 1.0);
        // NO uniform spin here. any shift added at every latitude is
        // common motion, and the eye reads the largest common motion
        // as the whole planet turning -- it buries the shear
        vec2  bu0 = vec2(v_uv.x + s0, v_uv.y);
        vec2  bu1 = vec2(v_uv.x + s1, v_uv.y);
        vec3  alb = mix(texture(color, bu0).rgb,
                        texture(color, bu1).rgb, bl);
        // THE LIVE TINT, multiplied onto that colour. this was baked
        // into the plate, which meant it could never move -- here it
        // drifts. three things decide it, the same three the bake
        // used, but now on a clock:
        //   a slow perlin says WHERE, sampled on a circle so it
        //   closes at the seam and drifting on its own third axis
        //   band darkness says HOW MUCH -- it collects in the belts
        //   two latitude waves thicken it along y
        float tl9 = dot(alb, vec3(0.299, 0.587, 0.114));
        float tdk = 1.0 - smoothstep(0.60, 0.75, tl9);
        float tbn = 0.5 + 0.35 * sin(bu0.y * 38.0 + 0.7)
                        + 0.15 * sin(bu0.y * 91.0 + 2.1);
        // EAST-WEST STRETCHED, hard. the circle radius sets how many
        // cells fit around the equator and the third axis how many
        // fit down the latitude -- 0.55 is only 3.5 around, 16 is
        // sixteen down. that is 104 degrees of longitude against 11
        // of latitude, a 9:1 draw along the wind. it was 0.8:1 before,
        // very slightly TALLER than wide
        // the clock goes on LONGITUDE, never on the third axis. that
        // axis carries latitude, so a time term there walks the whole
        // field from pole to pole -- which is the north-to-south
        // sweep, and nothing in an atmosphere migrates that way.
        // rotating the sample circle drifts it east instead, and a
        // rotated circle is still a circle, so the seam stays closed
        float tag = (bu0.x + ubo.time * 0.00007) * 6.28318530718;
        float tpn = jp_gnoise(vec3(cos(tag) * 0.55, sin(tag) * 0.55,
                                   bu0.y * 16.0));
        // the latitude bands GATE it. adding them instead let the
        // perlin's own floor tint the whole ball, which is the glob:
        // outside a band there is now no tint at all, and the perlin
        // only decides how much of one shows WITHIN it
        float tgb = smoothstep(0.42, 0.78, tbn);
        float tw9 = smoothstep(0.455, 0.545, tpn)
                  * (0.15 + 0.85 * tdk) * tgb;
        alb = mix(alb, alb * ubo.tint.rgb, clamp(tw9, 0.0, 1.0) * ubo.tint.w);
        // LAMBERT, the same law earth and the moon use here. a sphere
        // under a distant sun falls off as the cosine of the incidence
        // angle: flat near the sub-solar point, steepest at 90. the
        // old 0.5 wrap spread that fade over the WHOLE globe, so
        // nothing was ever fully lit; 8.0 collapsed it to a cut.
        // the 0.06 is jupiter's own departure -- an atmosphere deep
        // enough to carry light about four degrees past the geometric
        // terminator. no square: that is gamma, not illumination
        float lam9     = dot(n, sun);
        float ndl      = clamp((lam9 + 0.06) / 1.06, 0.0, 1.0);
        float mu       = clamp(dot(n, view_dir), 0.0, 1.0);
        // cam_pos.w scales the ambient floor -- how much albedo shows
        // where no sun reaches. at 1.0 this is the 0.08 it has always
        // been; higher keeps the unlit pole from going to black
        float amb9     = 0.08 * ubo.cam_pos.w;
        vec3  col      = alb * (amb9 + (1.0 - amb9) * ndl) * ubo.gain;
        // NIGHT-SIDE PLASMA. the storm map is baked: sobel edge max'd
        // with band darkness, already gaussian'd. one read here
        // the SAME uv the albedo used -- spin and shear both
        vec2  ju0 = bu0;
        vec2  ju1 = bu1;
        float sob = smoothstep(0.10, 0.72,
                        mix(texture(height, ju0).r, texture(height, ju1).r, bl));

        // the noise rides ju0/ju1, which already carry the wind as a
        // BOUNDED shear. an offset that grows with time and varies by
        // latitude does not move the field, it shears it: after ten
        // minutes neighbouring latitudes are hundreds of noise cells
        // apart and every feature is one pixel tall
        // GRADIENT noise clusters hard around 0.5, so a raw 0.8 cut
        // fires on almost nothing -- stretch first, then threshold
        vec2  ps9 = ubo.pstr.xy;
        // THE UV SEAM. gradient noise on raw u is discontinuous at the
        // wrap: x runs 0 to 18 across the map and those are different
        // lattice cells, so the field does not meet itself. sampled
        // around a CIRCLE in longitude it closes. radius is the old
        // cell count over two pi, so the features are the same size
        // pc_b.w DRIFTS THE FIELD IN LONGITUDE. rotating the sample
        // circle is still a circle, so this travels without ever
        // breaking the seam -- and it is the axis weather actually
        // moves along. the time term used to sit on the third axis
        // instead, which carries LATITUDE, so the whole field crept
        // down the map
        float dx9 = ubo.time * ubo.pc_b.w;
        float a90 = (ju0.x + dx9) * 6.28318530718;
        float a91 = (ju1.x + dx9) * 6.28318530718;
        float r90 = 2.8648 * ps9.x;
        float r91 = 6.5254 * ps9.x;
        float sy9 = 18.0 * ps9.y;
        float sy8 = 41.0 * ps9.y;
        // the third axis keeps only a slow BOIL -- a fifth of what it
        // carried. it is the latitude axis, so anything fast on it
        // reads as the field sinking rather than evolving
        float st9 = mix(jp_gnoise(vec3(cos(a90) * r90, sin(a90) * r90, ju0.y * sy9 + ubo.time * 0.006)),
                        jp_gnoise(vec3(cos(a91) * r90, sin(a91) * r90, ju1.y * sy9 + ubo.time * 0.006)), bl);
        float st2 = mix(jp_gnoise(vec3(cos(a90) * r91 + 7.0, sin(a90) * r91 + 7.0, ju0.y * sy8 + ubo.time * 0.010)),
                        jp_gnoise(vec3(cos(a91) * r91 + 7.0, sin(a91) * r91 + 7.0, ju1.y * sy8 + ubo.time * 0.010)), bl);
        st9 = clamp((st9 - 0.5) * 3.4 + 0.5, 0.0, 1.0);
        st2 = clamp((st2 - 0.5) * 3.0 + 0.5, 0.0, 1.0);
        float flash = smoothstep(ubo.pctl.x, ubo.pctl.x + 0.32, st9)
                    * (0.45 + 0.55 * st2);

        // cells pulse on their own clocks, and a wave runs the bands so
        // fronts sweep rather than the planet blinking as one
        // wctl2.w is how many pulse phases fit down the latitude. it
        // has to sit near the CELL count -- 60 against 10 cells is 6
        // phases inside one cell, which prints the cell as stripes
        float pls = 0.5 + 0.5 * sin(ubo.time * ubo.pctl.y + st2 * 21.0
                                  + ju0.y * ubo.wctl2.w);
        // 31.4159 is FIVE whole cycles. 34.0 was 5.41, so the wave
        // jumped 0.41 of a cycle across the seam
        float wv  = 0.5 + 0.5 * sin(ju0.x * 31.4159265 - ubo.time * 0.24 + st2 * 4.0);
        // pc_a.w is PERMANENCE: 0 is an event that fires and dies, 1 is
        // a standing feature that only breathes. lightning is the
        // first; a cloud deck is the second, and it was being switched
        // on and off like a strike
        float prm = ubo.pc_a.w;
        float flr = mix(0.10, 1.00, prm);
        float wvg = mix(smoothstep(0.15, 0.85, wv), 1.0, prm);
        flash *= (flr + (1.0 - flr) * pow(pls, ubo.pctl.z)) * wvg;

        // ORANGE or BLUE by region, sodium and hydrogen at depth
        float hue = jp_gnoise(vec3(cos(a90) * 0.7958 + 31.0, sin(a90) * 0.7958 + 31.0,
                                   ju0.y * 5.0 + ubo.time * 0.012));
        vec3  pc  = mix(ubo.pc_a.rgb, ubo.pc_b.rgb, smoothstep(0.42, 0.58, hue));
        // pctl.w = how much of this is night-only. 1 is a discharge
        // seen against the dark side; 0 is weather, lit right across
        float night = 1.0 - smoothstep(0.015, 0.28, ndl);
        // WEATHER DOES NOT GLOW. cloud is lit by the same sun as the
        // deck under it, so it takes the same light term -- at HALF
        // strength, so it still reads through the terminator instead
        // of vanishing with the surface. a flat 1.0 here was what lit
        // the night side as brightly as the day
        float lit9  = 0.08 + 0.92 * ndl;
        // 0.85, not 0.5. half the darkening still left cloud at 0.54
        // of full on the night side, which is a glow -- this puts it
        // at 0.22, dim but not gone
        float gate  = mix(mix(1.0, lit9, 0.85), night, ubo.pctl.w);
        float amt   = flash * sob * gate;
        // TWO ways to land it, and a planet picks one. pstr.z adds a
        // discharge colour on top; pstr.w instead lifts the albedo
        // already there toward white, and never past pstr.w itself
        col += pc * amt * ubo.pstr.z;
        col  = mix(col, vec3(1.0), min(amt, 1.0) * ubo.pstr.w);

        // FIRE AT THE POLES, on the plate itself. the texture is
        // equirect and the model spins about y, so the pole is just
        // v near 0 or 1 -- no axis maths, and it lands ON the surface
        // rather than in a shell above it. a RING at 17 degrees off
        // the pole, matching the oval the marched aurora rides, so
        // the glow above is standing on the burn below
        float pv9 = min(bu0.y, 1.0 - bu0.y);
        // THIN. 0.030 was 5.4 degrees of latitude, a zone broad
        // enough for the noise to mottle across -- 0.013 is 2.3, a
        // line, but a soft-shouldered one rather than a wire
        float pd9 = (pv9 - 0.094) / 0.013;
        // and a HOLE: nothing at all inside 10.8 degrees, so the pole
        // carries none of this and it can only ever read as a ring
        float prg = exp(-pd9 * pd9) * smoothstep(0.060, 0.080, pv9);
        if (prg > 0.002 && ubo.pfire.w > 0.0) {{
            // the clock rides LONGITUDE. the third axis here is
            // colatitude, and a time term on it would drag the fire
            // toward the pole
            float pag = (bu0.x + ubo.time * 0.00012) * 6.28318530718;
            // EAST-WEST STRETCHED like the tint's. radius 1.4 is 8.8
            // cells around, 41 degrees of longitude each, against 46
            // down the latitude at 2 degrees -- a 21:1 draw, so these
            // are clouds lying ALONG the ring, not spokes across it
            float pn1 = jp_gnoise(vec3(cos(pag) * 1.4,       sin(pag) * 1.4,       pv9 * 46.0));
            float pn2 = jp_gnoise(vec3(cos(pag) * 3.6 + 5.0, sin(pag) * 3.6 + 5.0, pv9 * 100.0));
            // CONTINUOUS, swelling and thinning. a 0.04 window on
            // the noise snapped between full and nothing and left cut
            // crescents -- 0.40 to 0.58 ramps over four times the
            // range, and the 0.28 floor keeps the ring joined all the
            // way round so it never actually breaks
            float pseg = 0.28 + 0.72 * smoothstep(0.40, 0.58, pn1);
            // TWO COLOURS along its length. the fine octave picks
            // between the deep orange and the pale, so the ring runs
            // hot and cool along itself instead of reading as one
            // painted band
            float pmx  = smoothstep(0.40, 0.62, pn2);
            vec3  pcol = mix(ubo.pfire.rgb, ubo.pfire2.rgb, pmx);
            // a light brightness texture on top, never to nothing
            float ptx  = 0.78 + 0.22 * pmx;
            col += pcol * prg * pseg * ptx * ubo.pfire.w;
        }}

        float a        = smoothstep(0.0, 0.18, mu);
        fragColor      = vec4(col, a);
    }

ModelViewProject EuropaShader
    mutable gain     : f32
    mutable cam_pos  : vec4f
    # real geometry displacement, in sphere radii
    mutable displace : f32

    # baked at scene build: R height hi, A height lo, G AO, B cavity
    attrib height : LayoutBinding [ type:typeid[ TitanSurface ],
                                    id:TitanSurface.height, count:1,
                                    format: typeid[ rgba8 ] ]
    # baked normals: RG = normal xy, B = cavity
    attrib nrmA   : LayoutBinding [ type:typeid[ TitanSurface ],
                                    id:TitanSurface.nrm_a,  count:1,
                                    format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_normal    : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_uv        : VertexOutput [ type:typeid[ vec2f ] ]
    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]
    attrib v_sp        : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_h         : VertexOutput [ type:typeid[ f32 ] ]

    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]

    func eg_perm4 [ x: vec4f ] -> GLSL vec4f {
        return mod((x * 34.0 + 1.0) * x, vec4(289.0));
    }

    func eg_isqrt4 [ r: vec4f ] -> GLSL vec4f {
        return 1.79284291400159 - 0.85373472095314 * r;
    }

    func eg_gnoise [ P: vec3f ] -> GLSL float {
        vec3 Pi0 = mod(floor(P), vec3(289.0));
        vec3 Pi1 = mod(Pi0 + vec3(1.0), vec3(289.0));
        vec3 Pf0 = fract(P);
        vec3 Pf1 = Pf0 - vec3(1.0);
        vec4 ix  = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
        vec4 iy  = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
        vec4 iz0 = vec4(Pi0.z);
        vec4 iz1 = vec4(Pi1.z);
        vec4 ixy  = eg_perm4(eg_perm4(ix) + iy);
        vec4 ixy0 = eg_perm4(ixy + iz0);
        vec4 ixy1 = eg_perm4(ixy + iz1);
        vec4 gx0 = fract(ixy0 / 7.0) * 2.0 - 1.0;
        vec4 gy0 = fract(floor(ixy0 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz0 = 1.0 - abs(gx0) - abs(gy0);
        vec4 gx1 = fract(ixy1 / 7.0) * 2.0 - 1.0;
        vec4 gy1 = fract(floor(ixy1 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz1 = 1.0 - abs(gx1) - abs(gy1);
        vec4 sz0 = step(gz0, vec4(0.0));
        gx0 -= sz0 * (step(0.0, gx0) - 0.5);
        gy0 -= sz0 * (step(0.0, gy0) - 0.5);
        vec4 sz1 = step(gz1, vec4(0.0));
        gx1 -= sz1 * (step(0.0, gx1) - 0.5);
        gy1 -= sz1 * (step(0.0, gy1) - 0.5);
        vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
        vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
        vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
        vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
        vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
        vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
        vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
        vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);
        vec4 nm0 = eg_isqrt4(vec4(dot(g000,g000), dot(g010,g010), dot(g100,g100), dot(g110,g110)));
        g000 *= nm0.x; g010 *= nm0.y; g100 *= nm0.z; g110 *= nm0.w;
        vec4 nm1 = eg_isqrt4(vec4(dot(g001,g001), dot(g011,g011), dot(g101,g101), dot(g111,g111)));
        g001 *= nm1.x; g011 *= nm1.y; g101 *= nm1.z; g111 *= nm1.w;
        float n000 = dot(g000, Pf0);
        float n100 = dot(g100, vec3(Pf1.x, Pf0.y, Pf0.z));
        float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
        float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
        float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
        float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
        float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
        float n111 = dot(g111, Pf1);
        vec3  fxyz = Pf0 * Pf0 * Pf0 * (Pf0 * (Pf0 * 6.0 - 15.0) + 10.0);
        vec4  n_z  = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fxyz.z);
        vec2  n_yz = mix(n_z.xy, n_z.zw, fxyz.y);
        return mix(n_yz.x, n_yz.y, fxyz.x) * 0.5 + 0.5;
    }

    func init[]
        eye    : vec3f [0.0f, 0.0f, 2.5f]
        target : vec3f [0.0f, 0.0f, 0.0f]
        up     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye, target, up]

    func vertex[] -> GLSL none {
        v_uv        = vec2(1.0 - a_uv.x, a_uv.y);
        v_sp        = normalize(a_pos);
        mat3 nm     = transpose(inverse(mat3(ubo.model)));
        v_normal    = normalize(nm * a_normal);
        // two-byte height: one byte terraces at the terminator
        vec4  hp    = textureLod(height, v_uv, 0.0);
        float hv    = (hp.r * 65280.0 + hp.a * 255.0) / 65535.0;
        v_h         = hv;
        vec3  disp  = a_pos + a_normal * (hv - 0.5) * ubo.displace;
        vec4  wpos  = ubo.model * vec4(disp, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        vec3  n        = normalize(v_normal);
        vec3  sun      = normalize(vec3(0.85, -0.10, 0.15));
        vec3  view_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        float dist9    = length(ubo.cam_pos.xyz - v_world_pos.xyz);
        vec4  hp  = texture(height, v_uv);
        vec4  np  = texture(nrmA, v_uv);
        float ao9 = hp.g;
        vec2  nxy = np.rg * 2.0 - 1.0;
        float cav = hp.b;
        float met = np.b;
        // the smooth-sphere daylight gates the detail tilt: the dark
        // side must not catch extreme grazing light off micro normals
        float wrs = clamp(dot(n, sun) * 0.5 + 0.5, 0.0, 1.0);
        float dfade = 1.0 - smoothstep(0.9, 2.6, dist9);
        float ntilt = dfade * (0.25 + 0.75 * wrs);
        if (ntilt > 0.0) {{
            vec3 t_e = normalize(cross(vec3(0.0, 1.0, 0.0), n));
            vec3 t_n = cross(n, t_e);
            n = normalize(n + (t_e * nxy.x + t_n * nxy.y) * 1.2 * ntilt);
        }}
        // cav carries the deep-carve mask: snow at surface level,
        // europa's light tan orange on the lineae floors, darker
        // bits in the deepest cores; ao stays a whisper
        float deep = cav;
        float ao = mix(0.96, 1.0, ao9) * (1.0 - deep * 0.10 * dfade);
        // depressions sit slightly darker; plains rest at 0.62
        float low = clamp((0.62 - v_h) / 0.35, 0.0, 1.0);
        ao *= 1.0 - low * 0.10;
        float dm  = smoothstep(0.12, 0.70, deep);
        float dm2 = smoothstep(0.55, 0.95, deep);
        // perlin variance breathes over the tan floors, two octaves
        float tn1 = eg_gnoise(v_sp * 14.0 + vec3(5.0, 2.0, 9.0));
        float tn2 = eg_gnoise(v_sp * 41.0 + vec3(1.0, 8.0, 3.0));
        vec3  tan9 = vec3(0.80, 0.64, 0.44) * (0.74 + 0.36 * tn1 + 0.16 * (tn2 - 0.5));
        vec3  alb = mix(vec3(0.94, 0.96, 0.99), tan9, dm);
        alb = mix(alb, vec3(0.48, 0.36, 0.25), dm2 * 0.6);
        // ~15% of the snow fields carry a darkening overlay that
        // settles into their minor depressions
        float sgate = smoothstep(0.58, 0.66, eg_gnoise(v_sp * 5.5 + vec3(9.0, 4.0, 21.0)));
        float lm    = smoothstep(0.02, 0.22, low) * (1.0 - dm);
        alb *= 1.0 - sgate * lm * 0.22;
        // and everywhere outside the orange, minor dips gray a bit
        alb = mix(alb, vec3(0.72, 0.74, 0.77), lm * 0.30);
        // metal4 dresses the highlands: cool steel grain, reflective
        alb = mix(alb, vec3(0.68, 0.72, 0.78) * (0.50 + 0.70 * met),
                  clamp(met * 1.6, 0.0, 0.75));
        // wrapped light, same response curve as saturn and enceladus
        float wr    = clamp(dot(n, sun) * 0.5 + 0.5, 0.0, 1.0);
        float lit   = wr * wr;
        float mu    = clamp(dot(normalize(v_normal), view_dir), 0.0, 1.0);
        float night = 1.0 - smoothstep(0.10, 0.50, wrs);
        // floor: the dark side dims, it never goes void
        float amb   = mix(0.26, 0.08, night);
        vec3  col   = alb * ao * (amb + 0.74 * lit) * ubo.gain;
        // fresnel ice light: the terrain limb keeps a soft lift
        float fr = pow(1.0 - mu, 4.0);
        col += vec3(0.70, 0.82, 1.00) * fr * (0.12 + 0.35 * lit) * ubo.gain;
        // outermost fragments darken away toward the silhouette
        col *= 0.30 + 0.70 * smoothstep(0.0, 0.12, mu);
        // the atmospheric haze continues into the crack interiors at
        // quarter strength — its EXACT overlay color, unrelit; the
        // mask is the fine etch and the blur bowl mixed
        float inner = clamp((deep + low) * 0.5, 0.0, 1.0);
        col = mix(col, vec3(0.36, 0.16, 0.70), inner * 0.25);
        // the metal highlands catch the sun: broad specular sheen
        float mspec = pow(clamp(dot(reflect(-sun, n), view_dir), 0.0, 1.0), 24.0);
        col += vec3(0.85, 0.90, 1.00) * mspec * met * 0.45 * (0.25 + 0.75 * lit);
        // glowing water in the crack centers: emissive teal, and a
        // sun glint off the flat pool read from the smooth normal
        float wmask = smoothstep(0.78, 0.96, deep);
        if (wmask > 0.0) {{
            // pink pools running blue where the carve is deepest
            vec3  water = mix(vec3(0.70, 0.38, 0.66), vec3(0.25, 0.45, 0.95),
                              smoothstep(0.88, 0.99, deep));
            vec3  nsm   = normalize(v_normal);
            float spec  = pow(clamp(dot(reflect(-sun, nsm), view_dir), 0.0, 1.0), 48.0);
            col = mix(col, water * (0.35 + 0.65 * lit), wmask * 0.85);
            col += water * wmask * 0.25;
            col += vec3(0.90, 0.97, 1.00) * spec * wmask * (0.35 + 0.65 * lit);
        }}
        // the finest fracture filaments emit light of their own,
        // night side included — the baked detail2 mask
        float em = np.a;
        col += vec3(0.30, 0.62, 0.90) * em * 0.35;
        // soft shoulder: bright ice rolls off, it never clips white
        col = 1.0 - exp(-col * 1.25);
        // fuzzy limb: the land blends away at the horizon instead
        // of cutting an aliased hard edge against space
        float ha = smoothstep(0.0, 0.10, mu);
        fragColor = vec4(col, ha);
    }

# the marched horizon lens from enceladus — plus geysers risen from
# the LAKES: the shell ray samples the baked deep mask under each
# march point, so the columns stand exactly on the water
ModelViewProject EuropaGlowShader
    mutable gain    : f32
    mutable cam_pos : vec4f
    # jet emitters: xyz = unit surface position of a lake, w = strength
    mutable j0  : vec4f
    mutable j1  : vec4f
    mutable j2  : vec4f
    mutable j3  : vec4f
    mutable j4  : vec4f
    mutable j5  : vec4f
    mutable j6  : vec4f
    mutable j7  : vec4f
    mutable j8  : vec4f
    mutable j9  : vec4f
    mutable j10 : vec4f
    mutable j11 : vec4f
    mutable j12 : vec4f
    mutable j13 : vec4f
    mutable j14 : vec4f
    mutable j15 : vec4f
    mutable j16 : vec4f
    mutable j17 : vec4f
    mutable j18 : vec4f
    mutable j19 : vec4f
    mutable j20 : vec4f
    mutable j21 : vec4f
    mutable j22 : vec4f
    mutable j23 : vec4f
    mutable j24 : vec4f
    mutable j25 : vec4f
    mutable j26 : vec4f
    mutable j27 : vec4f
    mutable j28 : vec4f
    mutable j29 : vec4f
    mutable j30 : vec4f
    mutable j31 : vec4f

    # the packed surface bake: B is the deep-carve (lake) mask
    attrib height : LayoutBinding [ type:typeid[ TitanSurface ],
                                    id:TitanSurface.height, count:1,
                                    format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]
    attrib fragColor   : FragmentOutput[ type:typeid[ vec4f ] ]


    func gp_perm4 [ x: vec4f ] -> GLSL vec4f {
        return mod((x * 34.0 + 1.0) * x, vec4(289.0));
    }

    func gp_isqrt4 [ r: vec4f ] -> GLSL vec4f {
        return 1.79284291400159 - 0.85373472095314 * r;
    }

    func gp_gnoise [ P: vec3f ] -> GLSL float {
        vec3 Pi0 = mod(floor(P), vec3(289.0));
        vec3 Pi1 = mod(Pi0 + vec3(1.0), vec3(289.0));
        vec3 Pf0 = fract(P);
        vec3 Pf1 = Pf0 - vec3(1.0);
        vec4 ix  = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
        vec4 iy  = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
        vec4 iz0 = vec4(Pi0.z);
        vec4 iz1 = vec4(Pi1.z);
        vec4 ixy  = gp_perm4(gp_perm4(ix) + iy);
        vec4 ixy0 = gp_perm4(ixy + iz0);
        vec4 ixy1 = gp_perm4(ixy + iz1);
        vec4 gx0 = fract(ixy0 / 7.0) * 2.0 - 1.0;
        vec4 gy0 = fract(floor(ixy0 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz0 = 1.0 - abs(gx0) - abs(gy0);
        vec4 gx1 = fract(ixy1 / 7.0) * 2.0 - 1.0;
        vec4 gy1 = fract(floor(ixy1 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz1 = 1.0 - abs(gx1) - abs(gy1);
        vec4 sz0 = step(gz0, vec4(0.0));
        gx0 -= sz0 * (step(0.0, gx0) - 0.5);
        gy0 -= sz0 * (step(0.0, gy0) - 0.5);
        vec4 sz1 = step(gz1, vec4(0.0));
        gx1 -= sz1 * (step(0.0, gx1) - 0.5);
        gy1 -= sz1 * (step(0.0, gy1) - 0.5);
        vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
        vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
        vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
        vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
        vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
        vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
        vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
        vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);
        vec4 nm0 = gp_isqrt4(vec4(dot(g000,g000), dot(g010,g010), dot(g100,g100), dot(g110,g110)));
        g000 *= nm0.x; g010 *= nm0.y; g100 *= nm0.z; g110 *= nm0.w;
        vec4 nm1 = gp_isqrt4(vec4(dot(g001,g001), dot(g011,g011), dot(g101,g101), dot(g111,g111)));
        g001 *= nm1.x; g011 *= nm1.y; g101 *= nm1.z; g111 *= nm1.w;
        float n000 = dot(g000, Pf0);
        float n100 = dot(g100, vec3(Pf1.x, Pf0.y, Pf0.z));
        float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
        float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
        float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
        float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
        float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
        float n111 = dot(g111, Pf1);
        vec3  fxyz = Pf0 * Pf0 * Pf0 * (Pf0 * (Pf0 * 6.0 - 15.0) + 10.0);
        vec4  n_z  = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fxyz.z);
        vec2  n_yz = mix(n_z.xy, n_z.zw, fxyz.y);
        return mix(n_yz.x, n_yz.y, fxyz.x) * 0.5 + 0.5;
    }

    # one analytic tube: returns rgb*w in xyz and w in w — no noise
    func g_tube [ p0: vec3f, jw: f32, ro: vec3f, rd: vec3f, s_hit: f32 ] -> GLSL vec4f {
        vec3  w0 = ro - p0;
        float aa = dot(rd, p0);
        float d0 = dot(rd, w0);
        float d1 = dot(p0, w0);
        float dn = max(1.0 - aa * aa, 1e-4);
        float s9 = (aa * d1 - d0) / dn;
        float t9 = (d1 - aa * d0) / dn;
        if (s9 < 0.02) return vec4(0.0);
        float occ = 1.0 - smoothstep(s_hit - 0.10, s_hit + 0.10, s9);
        if (occ <= 0.0) return vec4(0.0);
        float tt  = max(t9, 0.0);
        float env = smoothstep(-0.015, 0.025, t9) * exp(-8.0 * tt);
        vec3  qp = w0 + s9 * rd - t9 * p0;
        float d2 = dot(qp, qp);
        float sg = 0.008 + 0.05 * tt;
        float gc = exp(-d2 / (sg * sg));
        float gh = 0.15 * exp(-d2 / (9.0 * sg * sg));
        float boost = 1.0 / sqrt(max(dn, 0.20));
        float w9 = env * boost * occ * jw * (gc + gh);
        float cm = clamp(tt / 0.45, 0.0, 1.0);
        // blue at the vent, rising into hot pink
        vec3  cc = mix(vec3(0.25, 0.45, 0.95), vec3(1.00, 0.24, 0.72), cm);
        return vec4(cc * w9, w9);
    }

    # each site is a FAN of three tubes, like the enceladus vents —
    # lone tubes were too sparse to ever hold the visible limb
    func g_jet [ J: vec4f, ro: vec3f, rd: vec3f, s_hit: f32 ] -> GLSL vec4f {
        if (J.w <= 0.0) return vec4(0.0);
        vec3 p0 = J.xyz;
        // perlin breathing: each vent emits between 20% and 70%
        float pm = gp_gnoise(vec3(p0.x * 5.0 + ubo.time * 0.008,
                                  p0.y * 5.0, p0.z * 5.0 + ubo.time * 0.005));
        float jw = J.w * (0.20 + 0.50 * pm);
        vec3 te = normalize(cross(vec3(0.0, 1.0, 0.0), p0));
        vec4 acc = g_tube(p0, jw, ro, rd, s_hit);
        acc += g_tube(normalize(p0 + te * 0.014), jw * 0.7, ro, rd, s_hit);
        acc += g_tube(normalize(p0 - te * 0.012), jw * 0.7, ro, rd, s_hit);
        return acc;
    }

    func init[]
        eye    : vec3f [0.0f, 0.0f, 2.5f]
        target : vec3f [0.0f, 0.0f, 0.0f]
        up     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye, target, up]

    func vertex[] -> GLSL none {
        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        vec3  ro  = ubo.cam_pos.xyz;
        vec3  rd  = normalize(v_world_pos.xyz - ro);
        // one shell layer only: inside we see its far side, outside
        // its near side — the guard stops the outside double-count
        if (dot(ro, ro) >= 1.69 && !gl_FrontFacing) { fragColor = vec4(0.0); return; }
        // geysers: pure analytic tubes standing on the lakes — the
        // emitter list arrives from the bake as uniforms
        float b9  = dot(ro, rd);
        float c9  = dot(ro, ro) - 1.0;
        float dsc = b9 * b9 - c9;
        float s_hit = (dsc > 0.0) ? (0.0 - b9 - sqrt(dsc)) : 1e9;
        if (s_hit < 0.0) s_hit = 1e9;
        vec3  gcol = vec3(0.0);
        float gsum = 0.0;
        vec4  a9;
        a9 = g_jet(ubo.j0,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j1,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j2,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j3,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j4,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j5,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j6,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j7,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j8,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j9,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j10, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j11, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j12, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j13, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j14, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j15, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j16, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j17, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j18, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j19, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j20, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j21, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j22, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j23, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j24, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j25, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j26, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j27, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j28, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j29, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j30, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j31, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        float sum = 0.0;
        float tca = 0.0 - dot(ro, rd);
        if (tca > 0.0) {{
            vec3  pca  = ro + rd * tca;
            float rc   = length(pca);
            // the condensed rim band at HALF thickness, the glow
            // dragged farther inside the face at lower intensity;
            // the outward edge into space stays as it was
            float din  = max(1.0 - rc, 0.0);
            float inw  = 0.40 * exp(-din / 0.018) + 0.34 * exp(-din / 0.75);
            float od   = exp(-max(rc - 1.0, 0.0) / 0.014) * inw;
            float dip  = clamp(din / 0.75, 0.0, 1.0);
            float hocc = mix(1.0, 0.85, dip);
            vec3  sunh = normalize(vec3(0.85, -0.10, 0.15));
            float hw   = clamp(dot(pca / max(rc, 1e-4), sunh) * 0.5 + 0.5, 0.0, 1.0);
            float nearg = exp(-abs(rc - 1.0) / 0.006);
            sum = od * hocc * (0.06 + 0.26 * hw) * (1.0 + 4.0 * nearg);
        }}
        vec3  icy = vec3(0.36, 0.16, 0.70);
        float tot = sum + gsum;
        vec3  fc  = (icy * sum + gcol) / max(tot, 1e-5);
        fragColor = vec4(fc, clamp(tot * ubo.gain, 0.0, 0.9));
    }

# patch the active source set over the 4k equirect: a large
# perlin owns regions per source, a small one works the blend
func europa_build_maps [ H: @f32, AO: @f32, CV: @f32, EM: @f32, MM: @f32,
                         w: i32, h: i32 ]
    names : vec string [] [ 'europa-greybase', 'europa-fracture',
                            'europa-crevasses',
        'europa-metal2', 'europa-fracture-blur',
        'europa-fracture-detail2',
        'europa-scratch', 'europa-metal4' ]
    ns : i32 [ names.count ]
    sw : new i32 [ ns ]
    sh : new i32 [ ns ]
    so : new i32 [ ns ]
    imgs : vec Image []
    total : i32 [ 0 ]
    for [ i: i32 0, i < ns, i += 1 ]
        p9 : path '../{share_name}/textures/{names[i]}.png'
        im : Image [ uri: p9 ]
        imgs.push[ im ]
        sw[i] = im.width
        sh[i] = im.height
        so[i] = total
        total += im.width * im.height
    SB : new f32 [ total ]
    for [ i: i32 0, i < ns, i += 1 ]
        si : Image imgs[i]
        eu_lum[ si, @SB[ so[i] ] ]
    g0 : @f32 [ @SB[ so[0] ] ]
    g1 : @f32 [ @SB[ so[1] ] ]
    g2 : @f32 [ @SB[ so[2] ] ]
    g3 : @f32 [ @SB[ so[3] ] ]
    g4 : @f32 [ @SB[ so[4] ] ]
    g5 : @f32 [ @SB[ so[5] ] ]
    g6 : @f32 [ @SB[ so[6] ] ]
    g7 : @f32 [ @SB[ so[7] ] ]
    log 'europa: patching {ns} sources over {w}x{h}'
    for [ y: i32 0, y < h, y += 1 ]
        v : f32 [ (f32[ y ] + 0.5) / f32[ h ] ]
        lat : f32 [ (0.5 - v) * 3.14159265 ]
        cl : f32 [ cos[ lat ] ]
        sl : f32 [ sin[ lat ] ]
        for [ x: i32 0, x < w, x += 1 ]
            u : f32 [ (f32[ x ] + 0.5) / f32[ w ] ]
            lon : f32 [ u * 6.2831853 ]
            spx : f32 [ cl * sin[ lon ] ]
            spy : f32 [ sl ]
            spz : f32 [ cl * cos[ lon ] ]
            # meridian mirror-blend factor for the u seam
            sd : f32 [ u ]
            if [ 1.0 - u < sd ] sd = 1.0 - u
            sk : f32 [ sd / 0.06 ]
            if [ sk > 1.0 ] sk = 1.0
            sk = sk * sk * (3.0 - 2.0 * sk)
            ub : f32 [ u + 0.5 ]
            ub = ub - floor[ ub ]
            # smooth rolling plains from the grey base, two octaves
            b1 : f32 [
                eu_pat[ g0, sw[0], sh[0], u, v, ub, sk, 0.70, 0.9, 0.9,
                        0.13, 0.41 ] ]
            b2 : f32 [
                eu_pat[ g0, sw[0], sh[0], u, v, ub, sk, 2.30, 2.1, 2.1,
                        0.61, 0.07 ] ]
            # ONE fracture domain, three registered levels: the
            # blur presses, the sharp etches, detail2 finest —
            # a second independent domain crossed the first and
            # read as misaligned paint; it is gone
            s1 : f32 [
                eu_pat[ g1, sw[1], sh[1], u, v, ub, sk, 1.10, 1.2, 1.8,
                        0.29, 0.53 ] ]
            d1 : f32 [
                eu_pat[ g4, sw[4], sh[4], u, v, ub, sk, 1.10, 1.2, 1.8,
                        0.29, 0.53 ] ]
            e1 : f32 [
                eu_pat[ g5, sw[5], sh[5], u, v, ub, sk, 1.10, 1.2, 1.8,
                        0.29, 0.53 ] ]
            f1 : f32 [
                eu_pat[ g2, sw[2], sh[2], u, v, ub, sk, 0.35, 5.0, 11.0,
                        0.47, 0.83 ] ]
            m1 : f32 [
                eu_pat[ g3, sw[3], sh[3], u, v, ub, sk, 1.85, 1.7, 3.4,
                        0.09, 0.67 ] ]
            cb : f32 [ 1.0 - eu_sstep[ 0.45, 0.72, d1 ] ]
            cs : f32 [ 1.0 - eu_sstep[ 0.30, 0.55, s1 ] ]
            em : f32 [ 1.0 - eu_sstep[ 0.90, 0.995, e1 ] ]
            c3  : f32 [ 1.0 - eu_sstep[ 0.15, 0.40, f1 ] ]
            # metal2 runs the opposite way: its BRIGHT streaks etch
            c4  : f32 [ eu_sstep[ 0.62, 0.85, m1 ] ]
            # region perlins move the carving families around
            r1 : f32 [ 0.35 + 0.65 * eu_sstep[ 0.35, 0.65,
                eu_gnoise[ spx * 1.3, spy * 1.3, spz * 1.3 ] ] ]
            r3 : f32 [ eu_sstep[ 0.40, 0.70,
                eu_gnoise[ spx * 2.6, spy * 2.6 + 7.0, spz * 2.6 ] ] ]
            r4 : f32 [ eu_sstep[ 0.42, 0.72,
                eu_gnoise[ spx * 1.5 + 23.0, spy * 1.5, spz * 1.5 ] ] ]
            # reduction perlin on the sharp etch: only ever removes
            rp : f32 [ eu_sstep[ 0.25, 0.80,
                eu_gnoise[ spx * 4.7 + 41.0, spy * 4.7, spz * 4.7 ] ] ]
            # deep is ALSO the basis for the bottom texture
            deep : f32 [ cb * r1 ]
            if [ deep > 1.0 ] deep = 1.0
            # thin rivers: independent shallow families
            t1 : f32 [
                eu_pat[ g6, sw[6], sh[6], u, v, ub, sk, 0.85, 2.2, 7.7,
                        0.21, 0.39 ] ]
            t2 : f32 [
                eu_pat[ g6, sw[6], sh[6], u, v, ub, sk, 2.15, 4.0, 13.0,
                        0.57, 0.93 ] ]
            ct1 : f32 [ 1.0 - eu_sstep[ 0.30, 0.55, t1 ] ]
            ct2 : f32 [ 1.0 - eu_sstep[ 0.28, 0.52, t2 ] ]
            det : f32 [ cs * (0.05 + 0.28 * cb) * r1 * rp
                      + em * (0.06 + 0.16 * cb)
                      + ct1 * 0.030 * (0.40 + 0.60 * r1)
                      + ct2 * 0.020
                      + c3 * 0.05 * r3 + c4 * 0.06 * r4 ]
            h9 : f32 [ 0.62 + (b1 - 0.5) * 0.30 + (b2 - 0.5) * 0.12 ]
            h9 -= deep * 0.55 + det
            if [ h9 < 0.0 ] h9 = 0.0
            if [ h9 > 1.0 ] h9 = 1.0
            H[ y * w + x ] = h9
            # the fine detail IS water: filaments sit at lake
            # level immediately, wherever they mark
            lk : f32 [ deep ]
            if [ em * 0.96 > lk ] lk = em * 0.96
            CV[ y * w + x ] = lk
            ev : f32 [ em * (0.40 + 0.60 * cb) * r1 ]
            if [ ev > 1.0 ] ev = 1.0
            EM[ y * w + x ] = ev
            # metal4 dresses the higher elevations, about a
            # quarter of the moon under its own region perlin
            hm : f32 [ eu_sstep[ 0.64, 0.70, h9 ]
                * (0.45 + 0.55 * eu_sstep[ 0.40, 0.60,
                eu_gnoise[ spx * 1.4 + 51.0, spy * 1.4, spz * 1.4 ] ]) ]
            m4 : f32 [
                eu_pat[ g7, sw[7], sh[7], u, v, ub, sk, 1.35, 2.2, 2.9,
                        0.51, 0.13 ] ]
            m4 = (m4 - 0.21) / 0.61
            if [ m4 < 0.0 ] m4 = 0.0
            if [ m4 > 1.0 ] m4 = 1.0
            MM[ y * w + x ] = hm * m4
    n9 : i32 [ w * h ]
    log 'europa: baking AO'
    eu_bake_ao[ H, AO, w, h, 60.0 ]
    AB : new f32 [ n9 ]
    eu_blur[ AO, AB, w, h, 2 ]
# the full europa surface bake: maps packed and written to the
# bundle; runs under SILVER_EXPORT, or once live if never baked
func europa_bake []
    w9 : i32 [ 8192 ]
    h9 : i32 [ 4096 ]
    n9 : i32 [ w9 * h9 ]
    H  : new f32 [ n9 ]
    AO : new f32 [ n9 ]
    CV : new f32 [ n9 ]
    EM : new f32 [ n9 ]
    MM : new f32 [ n9 ]
    europa_build_maps[ H, AO, CV, EM, MM, w9, h9 ]
    # pack: R height hi, A height lo, G AO, B cavity
    pk : Image [ width: w9, height: h9, format: Pixel.rgba8,
                 linear: true, wrap_u: true ]
    pd : @u8 [ pk.vdata[] ]
    for [ i: i32 0, i < n9, i += 1 ]
        b2 : i32 [ i * 4 ]
        hq : i32 [ H[ i ] * 65535.0 ]
        pd[ b2 ]     = u8[ hq / 256 ]
        pd[ b2 + 1 ] = u8[ AO[ i ] * 255.0 ]
        pd[ b2 + 2 ] = u8[ CV[ i ] * 255.0 ]
        pd[ b2 + 3 ] = u8[ hq % 256 ]
    # normals from central differences, wrap x clamp y
    nk : Image [ width: w9, height: h9, format: Pixel.rgba8,
                 linear: true, wrap_u: true ]
    nd : @u8 [ nk.vdata[] ]
    for [ y: i32 0, y < h9, y += 1 ]
        ym : i32 [ (y > 0) ? y - 1 : 0 ]
        yp : i32 [ (y < h9 - 1) ? y + 1 : h9 - 1 ]
        for [ x: i32 0, x < w9, x += 1 ]
            xm : i32 [ (x > 0) ? x - 1 : w9 - 1 ]
            xp : i32 [ (x < w9 - 1) ? x + 1 : 0 ]
            dx : f32 [ (H[ y * w9 + xp ] - H[ y * w9 + xm ]) * 4.0 ]
            dy : f32 [ (H[ yp * w9 + x ] - H[ ym * w9 + x ]) * 4.0 ]
            if [ dx < -1.0 ] dx = -1.0
            if [ dx >  1.0 ] dx = 1.0
            if [ dy < -1.0 ] dy = -1.0
            if [ dy >  1.0 ] dy = 1.0
            b3 : i32 [ (y * w9 + x) * 4 ]
            nd[ b3 ]     = u8[ (0.0 - dx) * 127.0 + 128.0 ]
            nd[ b3 + 1 ] = u8[ (0.0 - dy) * 127.0 + 128.0 ]
            nd[ b3 + 2 ] = u8[ MM[ y * w9 + x ] * 255.0 ]
            nd[ b3 + 3 ] = u8[ EM[ y * w9 + x ] * 255.0 ]
    bd : path '../{share_name}/baked'
    bd.make_dir[]
    pk.png[ path '../{share_name}/baked/europa-pk.png' ]
    nk.png[ path '../{share_name}/baked/europa-nk.png' ]
    log 'europa: baked maps written'

export func europa_maps []
    # token hash of the bake code: recompute only when it changes
    hv : u64 [ @europa_build_maps ]
    hb : u64 [ @europa_bake ]
    stamp : string '{hv}-{hb}'
    sp  : path '../{share_name}/baked/europa.hash'
    pkp : path '../{share_name}/baked/europa-pk.png'
    nkp : path '../{share_name}/baked/europa-nk.png'
    if [ sp.exists[] && pkp.exists[] && nkp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            log 'europa: baked maps current ({stamp})'
            return
    europa_bake[]
    sp.save[ stamp, null ]

element Europa
    frost : true
    public func bg_color [ ] -> rgba
        return color
    frost_sharp : true
    intern e_cur  : f32
    intern p_cur  : f32
    intern p_set  : bool
    intern eur    : EuropaShader
    intern glow   : EuropaGlowShader
    intern sky    : GaiaShader
    intern jup    : JupiterShader
    intern models : vec Model
    intern target : Render
    intern built  : bool
    # async load: worker decodes, draw waits on ready for vk work
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    # geyser plots from the bake; pushed to the shader every frame
    intern jetv   : new f32 [ 128 ]
    public color  : rgba [ r:0.002, g:0.003, b:0.006, a:1.0 ]

    # dense uv sphere built in memory: the displacement needs verts
    func build_sphere [] -> GltfModel
        nlon : i32 [ 768 ]
        nlat : i32 [ 384 ]
        n1 : i32 [ nlon + 1 ]
        m1 : i32 [ nlat + 1 ]
        nv : i32 [ n1 * m1 ]
        nv3 : i32 [ nv * 3 ]
        nv2 : i32 [ nv * 2 ]
        ni : i32 [ nlon * nlat * 6 ]
        vb : i32 [ nv3 * 4 ]
        tb : i32 [ nv2 * 4 ]
        ib : i32 [ ni * 4 ]
        tsz : i32 [ vb + vb + tb + ib ]
        data : new u8 [ tsz ]
        pf : @f32 [ data ]
        ip : @data[ vb + vb + tb ]
        iu : @u32 [ ip ]
        for [ iy: i32 0, iy <= nlat, iy += 1 ]
            lat : f32 [
                -1.5707963 + f32[ iy ] * 3.14159265 / f32[ nlat ] ]
            cl : f32 [ cos[ lat ] ]
            sl : f32 [ sin[ lat ] ]
            for [ ix: i32 0, ix <= nlon, ix += 1 ]
                lon : f32 [ f32[ ix ] * 6.2831853 / f32[ nlon ] ]
                dx : f32 [ cl * cos[ lon ] ]
                dy : f32 [ sl ]
                dz : f32 [ cl * sin[ lon ] ]
                vi : i32 [ iy * n1 + ix ]
                i3 : i32 [ vi * 3 ]
                pf[ i3 ]     = dx
                pf[ i3 + 1 ] = dy
                pf[ i3 + 2 ] = dz
                pf[ nv3 + i3 ]     = dx
                pf[ nv3 + i3 + 1 ] = dy
                pf[ nv3 + i3 + 2 ] = dz
                i2 : i32 [ nv3 * 2 + vi * 2 ]
                pf[ i2 ]     = f32[ ix ] / f32[ nlon ]
                pf[ i2 + 1 ] = 1.0 - f32[ iy ] / f32[ nlat ]
        k : i32 [ 0 ]
        for [ iy: i32 0, iy < nlat, iy += 1 ]
            for [ ix: i32 0, ix < nlon, ix += 1 ]
                i0 : i32 [ iy * n1 + ix ]
                iu[ k ]     = u32[ i0 ]
                iu[ k + 1 ] = u32[ i0 + n1 ]
                iu[ k + 2 ] = u32[ i0 + 1 ]
                iu[ k + 3 ] = u32[ i0 + 1 ]
                iu[ k + 4 ] = u32[ i0 + n1 ]
                iu[ k + 5 ] = u32[ i0 + n1 + 1 ]
                k += 6
        bufs : vec GltfBuffer []
        bufs += GltfBuffer [ byteLength: u64[ tsz ], data: data ]
        views : vec BufferView []
        views += BufferView [ buffer: 0, byteOffset: 0,
                              byteLength: vb ]
        views += BufferView [ buffer: 0, byteOffset: vb,
                              byteLength: vb ]
        views += BufferView [ buffer: 0, byteOffset: vb + vb,
                              byteLength: tb ]
        views += BufferView [ buffer: 0, byteOffset: vb + vb + tb,
                              byteLength: ib ]
        accs : vec Accessor []
        accs += Accessor [ bufferView: 0,
                           componentType: ComponentType.FLOAT,
                           type: CompoundType.VEC3, count: nv ]
        accs += Accessor [ bufferView: 1,
                           componentType: ComponentType.FLOAT,
                           type: CompoundType.VEC3, count: nv ]
        accs += Accessor [ bufferView: 2,
                           componentType: ComponentType.FLOAT,
                           type: CompoundType.VEC2, count: nv ]
        accs += Accessor [ bufferView: 3,
                           componentType: ComponentType.UNSIGNED_INT,
                           type: CompoundType.SCALAR, count: ni ]
        am : map i64 [ string ] [ ]
        am[ 'POSITION' ]   = i64[ 0 ]
        am[ 'NORMAL' ]     = i64[ 1 ]
        am[ 'TEXCOORD_0' ] = i64[ 2 ]
        prs : vec Primitive []
        prs += Primitive [ name: 'europa', attributes: am,
                           indices: u64[ 3 ], material: 0,
                           mode: Mode.TRIANGLES ]
        mshs : vec Mesh []
        mshs += Mesh [ name: 'europa', primitives: prs ]
        nds : vec Node []
        nds += Node [ name: 'europa', mesh: 0 ]
        sn : vec i64 []
        sn += 0
        scns : vec Scene []
        scns += Scene [ name: 'scene', nodes: sn ]
        gm : GltfModel [ nodes: nds, meshes: mshs, scenes: scns,
                         scene: 0,
            buffers: bufs, bufferViews: views, accessors: accs ]
        return gm

    func build_models[]
        built = true
        gltf_path : path '../{share_name}/models/earth.gltf'
        gltf      : GltfModel.open[ gltf_path ]
        pkp : path '../{share_name}/baked/europa-pk.png'
        nkp : path '../{share_name}/baked/europa-nk.png'
        if [ !pkp.exists[] || !nkp.exists[] ]
            log 'europa: no baked maps — baking live (SILVER_EXPORT=1 bakes at build)'
            europa_bake[]
        pk : Image [ uri: pkp, linear: true, wrap_u: true ]
        nk : Image [ uri: nkp, linear: true, wrap_u: true ]
        w9 : i32 [ pk.width ]
        h9 : i32 [ pk.height ]
        pd : @u8 [ pk.vdata[] ]
        e_gltf : build_sphere[]
        e_gltf.hold[]
        e_gltf.compute_worlds[]
        eur = EuropaShader [ vk: vk ]
        e_samplers : map Image [string] [
            'height': pk,
            'nrm_a':  nk
        ]
        eur_model : Model [ vk: vk, w: ux, id: e_gltf, s: eur,
                            samplers: e_samplers, straight_alpha: true ]
        # jet emitters: the strongest lake cells, one per neighborhood
        cw : i32 [ 96 ]
        ch : i32 [ 48 ]
        cavg : new f32 [ cw * ch ]
        for [ cy: i32 0, cy < ch, cy += 1 ]
            for [ cx: i32 0, cx < cw, cx += 1 ]
                y0 : i32 [ cy * h9 / ch ]
                y1 : i32 [ (cy + 1) * h9 / ch ]
                x0 : i32 [ cx * w9 / cw ]
                x1 : i32 [ (cx + 1) * w9 / cw ]
                mx : f32 [ 0.0 ]
                for [ yy: i32 y0, yy < y1, yy += 4 ]
                    for [ xx: i32 x0, xx < x1, xx += 4 ]
                        cv : f32 [
                            f32[ pd[ (yy * w9 + xx) * 4 + 2 ] ]
                            / 255.0 ]
                        if [ cv > mx ] mx = cv
                # the MAX finds a lake in the cell; averages drowned
                # thin water webs below any threshold
                cavg[ cy * cw + cx ] = mx
        for [ i: i32 0, i < 128, i += 1 ] jetv[i] = 0.0
        used : new i32 [ cw * ch ]
        for [ i: i32 0, i < cw * ch, i += 1 ] used[i] = 0
        # random lake plots, enceladus-style: seeded picks over every
        # qualifying cell, spaced by the suppression grid — the scan
        # order must never decide, or they all pool at one pole
        nj : i32 [ 0 ]
        seed : i64 [ 48271 ]
        for [ t: i32 0, t < 800, t += 1 ]
            if [ nj >= 32 ] break
            seed = (seed * 1103515245 + 12345) % 2147483647
            ci : i32 [ seed % i64[ cw * ch ] ]
            if [ used[ ci ] != 0 ] continue
            if [ cavg[ ci ] < 0.60 ] continue
            cy9 : i32 [ ci / cw ]
            cx9 : i32 [ ci % cw ]
            # anywhere but the polar caps
            if [ cy9 < 8 || cy9 >= 40 ] continue
            for [ dyi: i32 0, dyi < 3, dyi += 1 ]
                for [ dxi: i32 0, dxi < 3, dxi += 1 ]
                    ny : i32 [ cy9 + dyi - 1 ]
                    nx : i32 [ (cx9 + dxi - 1 + cw) % cw ]
                    if [ ny >= 0 && ny < ch ] used[ ny * cw + nx ] = 1
            U : f32 [ (f32[ cx9 ] + 0.5) / f32[ cw ] ]
            V : f32 [ (f32[ cy9 ] + 0.5) / f32[ ch ] ]
            latj : f32 [ (0.5 - V) * 3.14159265 ]
            lonj : f32 [ (1.0 - U) * 6.2831853 ]
            clj : f32 [ cos[ latj ] ]
            st : f32 [ 0.7 + cavg[ ci ] * 0.4 ]
            if [ st > 1.1 ] st = 1.1
            jetv[ nj * 4 ]     = clj * cos[ lonj ]
            jetv[ nj * 4 + 1 ] = sin[ latj ]
            jetv[ nj * 4 + 2 ] = clj * sin[ lonj ]
            jetv[ nj * 4 + 3 ] = st
            nj += 1
        log 'europa: {nj} geyser sites'
        log 'europa: j0 {jetv[0]} {jetv[1]} {jetv[2]} w{jetv[3]}'
        log 'europa: j1 {jetv[4]} {jetv[5]} {jetv[6]} w{jetv[7]}'
        log 'europa: j2 {jetv[8]} {jetv[9]} {jetv[10]} w{jetv[11]}'
        glow = EuropaGlowShader [ vk: vk ]
        gl_samplers : map Image [string] [
            'height': pk
        ]
        glow_model : Model [ vk: vk, w: ux, id: gltf, s: glow,
                             samplers: gl_samplers,
            straight_alpha: true, cull_none: true, depth_no_test: true ]
        # storm map: sobel contrast of the jupiter texture, baked at
        # startup — discharges live where the bands shear hardest
        ji : Image [ uri: path '../{share_name}/textures/jupiter-color.png' ]
        jw : i32 [ ji.width ]
        jh : i32 [ ji.height ]
        jl : new f32 [ jw * jh ]
        eu_lum[ ji, jl ]
        # the sobel edge, then MAX'd with how dark the band is: the
        # edges give skinny beams along the shear lines and nothing
        # between them, and the deep belts fill that out. baked here,
        # so the shader stays one texture read
        jg : new f32 [ jw * jh ]
        for [ y: i32 0, y < jh, y += 1 ]
            ym : i32 [ (y > 0) ? y - 1 : 0 ]
            yp : i32 [ (y < jh - 1) ? y + 1 : jh - 1 ]
            for [ x: i32 0, x < jw, x += 1 ]
                xm : i32 [ (x > 0) ? x - 1 : jw - 1 ]
                xp : i32 [ (x < jw - 1) ? x + 1 : 0 ]
                gx : f32 [ jl[ y * jw + xp ] - jl[ y * jw + xm ] ]
                gy : f32 [ jl[ yp * jw + x ] - jl[ ym * jw + x ] ]
                mg : f32 [ sqrt[ gx * gx + gy * gy ] * 4.0 ]
                if [ mg > 1.0 ] mg = 1.0
                # distance BELOW 0.2 luminance, negatives clamped off
                dk : f32 [ (0.2 - jl[ y * jw + x ]) / 0.2 ]
                if [ dk < 0.0 ] dk = 0.0
                if [ dk > 1.0 ] dk = 1.0
                jg[ y * jw + x ] = (mg > dk) ? mg : dk
        # gaussian it here too -- the shader was paying five taps a
        # pixel for a blur that never changes
        jt : new f32 [ jw * jh ]
        eu_blur[ jg, jt, jw, jh, 4 ]
        sbi : Image [ width: jw, height: jh, format: Pixel.rgba8,
                      linear: true, wrap_u: true ]
        sd : @u8 [ sbi.vdata[] ]
        for [ i: i32 0, i < jw * jh, i += 1 ]
            v9 : f32 [ jt[ i ] ]
            if [ v9 < 0.0 ] v9 = 0.0
            if [ v9 > 1.0 ] v9 = 1.0
            b4 : i32 [ i * 4 ]
            sd[ b4 ]     = u8[ v9 * 255.0 ]
            sd[ b4 + 1 ] = 0
            sd[ b4 + 2 ] = 0
            sd[ b4 + 3 ] = 255
        jup = JupiterShader [ vk: vk ]
        j_samplers : map Image [string] [
            'color': Image [ uri: path '../{share_name}/textures/jupiter-color.png', surface: TitanSurface.color,
                wrap_u: true ],
            'height': sbi
        ]
        jup_model : Model [ vk: vk, w: ux, id: gltf, s: jup,
                            samplers: j_samplers, straight_alpha: true ]
        sky       = GaiaShader [ vk: vk ]
        sky_samplers : map Image [string] [
            'color': Image [ uri: path '../{share_name}/textures/gaia.png', surface: GaiaSurface.color ]
        ]
        sky_model : Model [ vk: vk, w: ux, id: gltf, s: sky,
                            samplers: sky_samplers,
            straight_alpha: true, cull_none: true ]
        models = vec Model [] [sky_model, jup_model, eur_model,
                                glow_model ]

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        # the backdrop sits under frost or blur: one pixel per point
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      (ux.scale > 1.0) ? 1.0 / ux.scale : 1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.owner  = a
        ux.element_targets[ id ] = target

    # unregister only; we keep our ref so the GPU graph outlives the
    # frame
    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    # ice light: pale cold panes, glacier blue accents
    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#000a',       # editor pane background
            '#140a2a80':  '#0e141a80',   # console pane background
            '#14121c80':  '#0e141a80',   # instance panel background
            '#ff6a2e55':  '#7ac8e855',   # search highlight fill
            '#220022aa':  '#0c1216aa',   # run console base fill
            '#22002280':  '#0c121680',   # commit tab fill, half alpha
            '#614':       '#28343e',     # TButtons / nav rest fill
            '#413':       '#1e2830',     # TButtons hover fill
            '#826':       '#3e5060',     # TButtons lit / nav selected
            '#625a':      '#22668866',   # bottom status bar fill, 40%
            '#8af2':      '#8cf2',       # status bar inner glow
            '#425':       '#16a8',       # editor selection color
            '#ede3':      '#ade3',       # editor selection border
            '#44225588':  '#16a4',       # editor line highlight
            '#ff3a6a22':  '#7ac8e822',   # commit tab fill
            '#ff3a6a44':  '#7ac8e844',   # commit tab hover fill
            '#3a1c8a40':  '#49778a40',   # selected title tint
            '#1d0f3f':    '#152026',       # title bar, dock ground (flat)
            '#ff5a8a80':  '#7ac8e880',   # commit tab border
            '#ff7aa480':  '#a8e0f480'    # commit tab hover border
        ]

    func load_bg [ arg: object :: t: Europa ]
        t0 : i64 [ Au.epoch_millis[] ]
        log 'scene load_bg start at {t0}'
        t.build_models[]
        t1 : i64 [ Au.epoch_millis[] ]
        log 'scene load_bg done in {t1 - t0}ms at {t1}'
        t.ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : vec Au []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: lambda load_bg[ a ],
                                work: w9 ]
        if [ !ready ] return
        # the done job held this element: let it go
        if [ load_task ] load_task = null
        create_target[]
        orbit[]

    func orbit[]
        # surface flyover like enceladus: ice fills the frame at low
        # orbit and jupiter hangs above the limb ahead
        time : 0.0 - ux.time * 730.0
        if [ time == 0.0 ] time = -54.0
        a_t      : f32 [ (ux.orbit_mode == OrbitView.low)  ? 0.25 :
            (ux.orbit_mode == OrbitView.high) ? 0.70 : 2.60 ]
        if [ e_cur == 0.0 ] e_cur = a_t
        e_cur = filter_n[ e_cur, a_t, 0.08, ux.frame_factor ]
        altitude : f32 [ e_cur ]
        eye_dist : f32 [ 1.0 + altitude ]
        t_deg    : f32 [ (ux.angle_mode == ViewAngle.flat)   ? 0.0 :
            (ux.angle_mode == ViewAngle.angled) ? 60.0 : 76.0 ]
        if [ p_cur == 0.0 && !p_set ] p_cur = t_deg
        p_set    = true
        p_cur    = filter_n[ p_cur, t_deg, 0.08, ux.frame_factor ]
        ux.orbit_moving = abs[ e_cur - a_t ] > 0.0004 || abs[
            p_cur - t_deg ] > 0.05
        tilt     : f32 [ radians[ p_cur ] ]
        aspect   : f32 [
            (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ]
            : 1.7778 ]
        orbit_a : radians[ time ]
        co      : cos[ orbit_a ]
        so      : sin[ orbit_a ]
        ex_l  : f32 [ 0.0 ]
        ey_l  : f32 [ 0.0 ]
        ez_l  : f32 [ eye_dist ]
        fx_l  : f32 [ -sin[ tilt ] ]
        fy_l  : f32 [ 0.0 ]
        fz_l  : f32 [ -cos[ tilt ] ]
        tx_l  : f32 [ ex_l + fx_l * 2.0 ]
        ty_l  : f32 [ ey_l + fy_l * 2.0 ]
        tz_l  : f32 [ ez_l + fz_l * 2.0 ]
        _eye   : vec3f [  co * ex_l + so * ez_l, ey_l,
                         -so * ex_l + co * ez_l ]
        _tgt   : vec3f [  co * tx_l + so * tz_l, ty_l,
                         -so * tx_l + co * tz_l ]
        _up    : vec3f [  co, 0.0, 0.0 - so ]

        _proj  : mat4f.perspective[ radians[ 60.0 ], aspect, 0.001,
                                    60.0 ]
        _view  : mat4f.look_at    [ _eye, _tgt, _up ]

        eur.model    = mat4f.identity[]
        eur.view     = _view
        eur.proj     = _proj
        eur.gain     = 1.5
        eur.displace = 0.016
        eur.cam_pos  = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]

        # the glow shell just past the terrain, whole sky from inside
        gm : mat4f.identity[]
        gm = gm.scale [ vec3f [ 1.30, 1.30, 1.30 ] ]
        glow.model   = gm
        glow.view    = _view
        glow.proj    = _proj
        glow.gain    = 1.0
        glow.time    = ux.time * 60000.0
        glow.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        # the emitter list re-arms every frame like cam_pos: set once
        # at build, the values died with the frame pool
        glow.j0  = vec4f [ jetv[0] + 0.0,   jetv[1] + 0.0,
                           jetv[2] + 0.0,   jetv[3] + 0.0]
        glow.j1  = vec4f [ jetv[4] + 0.0,   jetv[5] + 0.0,
                           jetv[6] + 0.0,   jetv[7] + 0.0]
        glow.j2  = vec4f [ jetv[8] + 0.0,   jetv[9] + 0.0,
                           jetv[10] + 0.0,  jetv[11] + 0.0]
        glow.j3  = vec4f [ jetv[12] + 0.0,  jetv[13] + 0.0,
                           jetv[14] + 0.0,  jetv[15] + 0.0]
        glow.j4  = vec4f [ jetv[16] + 0.0,  jetv[17] + 0.0,
                           jetv[18] + 0.0,  jetv[19] + 0.0]
        glow.j5  = vec4f [ jetv[20] + 0.0,  jetv[21] + 0.0,
                           jetv[22] + 0.0,  jetv[23] + 0.0]
        glow.j6  = vec4f [ jetv[24] + 0.0,  jetv[25] + 0.0,
                           jetv[26] + 0.0,  jetv[27] + 0.0]
        glow.j7  = vec4f [ jetv[28] + 0.0,  jetv[29] + 0.0,
                           jetv[30] + 0.0,  jetv[31] + 0.0]
        glow.j8  = vec4f [ jetv[32] + 0.0,  jetv[33] + 0.0,
                           jetv[34] + 0.0,  jetv[35] + 0.0]
        glow.j9  = vec4f [ jetv[36] + 0.0,  jetv[37] + 0.0,
                           jetv[38] + 0.0,  jetv[39] + 0.0]
        glow.j10 = vec4f [ jetv[40] + 0.0,  jetv[41] + 0.0,
                           jetv[42] + 0.0,  jetv[43] + 0.0]
        glow.j11 = vec4f [ jetv[44] + 0.0,  jetv[45] + 0.0,
                           jetv[46] + 0.0,  jetv[47] + 0.0]
        glow.j12 = vec4f [ jetv[48] + 0.0,  jetv[49] + 0.0,
                           jetv[50] + 0.0,  jetv[51] + 0.0]
        glow.j13 = vec4f [ jetv[52] + 0.0,  jetv[53] + 0.0,
                           jetv[54] + 0.0,  jetv[55] + 0.0]
        glow.j14 = vec4f [ jetv[56] + 0.0,  jetv[57] + 0.0,
                           jetv[58] + 0.0,  jetv[59] + 0.0]
        glow.j15 = vec4f [ jetv[60] + 0.0,  jetv[61] + 0.0,
                           jetv[62] + 0.0,  jetv[63] + 0.0]
        glow.j16 = vec4f [ jetv[64] + 0.0,  jetv[65] + 0.0,
                           jetv[66] + 0.0,  jetv[67] + 0.0]
        glow.j17 = vec4f [ jetv[68] + 0.0,  jetv[69] + 0.0,
                           jetv[70] + 0.0,  jetv[71] + 0.0]
        glow.j18 = vec4f [ jetv[72] + 0.0,  jetv[73] + 0.0,
                           jetv[74] + 0.0,  jetv[75] + 0.0]
        glow.j19 = vec4f [ jetv[76] + 0.0,  jetv[77] + 0.0,
                           jetv[78] + 0.0,  jetv[79] + 0.0]
        glow.j20 = vec4f [ jetv[80] + 0.0,  jetv[81] + 0.0,
                           jetv[82] + 0.0,  jetv[83] + 0.0]
        glow.j21 = vec4f [ jetv[84] + 0.0,  jetv[85] + 0.0,
                           jetv[86] + 0.0,  jetv[87] + 0.0]
        glow.j22 = vec4f [ jetv[88] + 0.0,  jetv[89] + 0.0,
                           jetv[90] + 0.0,  jetv[91] + 0.0]
        glow.j23 = vec4f [ jetv[92] + 0.0,  jetv[93] + 0.0,
                           jetv[94] + 0.0,  jetv[95] + 0.0]
        glow.j24 = vec4f [ jetv[96] + 0.0,  jetv[97] + 0.0,
                           jetv[98] + 0.0,  jetv[99] + 0.0]
        glow.j25 = vec4f [ jetv[100] + 0.0, jetv[101] + 0.0,
                           jetv[102] + 0.0, jetv[103] + 0.0]
        glow.j26 = vec4f [ jetv[104] + 0.0, jetv[105] + 0.0,
                           jetv[106] + 0.0, jetv[107] + 0.0]
        glow.j27 = vec4f [ jetv[108] + 0.0, jetv[109] + 0.0,
                           jetv[110] + 0.0, jetv[111] + 0.0]
        glow.j28 = vec4f [ jetv[112] + 0.0, jetv[113] + 0.0,
                           jetv[114] + 0.0, jetv[115] + 0.0]
        glow.j29 = vec4f [ jetv[116] + 0.0, jetv[117] + 0.0,
                           jetv[118] + 0.0, jetv[119] + 0.0]
        glow.j30 = vec4f [ jetv[120] + 0.0, jetv[121] + 0.0,
                           jetv[122] + 0.0, jetv[123] + 0.0]
        glow.j31 = vec4f [ jetv[124] + 0.0, jetv[125] + 0.0,
                           jetv[126] + 0.0, jetv[127] + 0.0]

        # the galaxy wraps the whole scene from a big inner sphere
        skq9 : vec4f [ 1.0, 0.0, 0.0, radians[ 45.0 ] ]
        skq  : quatf [ skq9 ]
        skm : mat4f.identity[]
        skm = skm.rotate[ skq ]
        skm = skm.scale [ vec3f [ 30.0, 30.0, 30.0 ] ]
        sky.model = skm
        sky.view  = _view
        sky.proj  = _proj
        sky.gain  = 0.45
        sky.time  = ux.time * 60000.0

        # jupiter fixed in the sky above the limb, huge and near
        # upright — the offset rides the SAME orbit rotation as the
        # eye or the camera walks away from it
        rise   : f32 [ radians[ 14.0 ] ]
        aim    : f32 [ tilt + rise ]
        s_dist : f32 [ 24.0 ]
        sx    : f32 [ 0.0 - s_dist * sin[ aim ] ]
        sz    : f32 [ eye_dist - s_dist * cos[ aim ] ]
        s_off  : vec3f [ co * sx + so * sz, 0.0,
                         (0.0 - so) * sx + co * sz ]
        s_sc   : vec3f [ 11.0, 11.0, 11.0 ]
        s_axis : vec4f [ 0.0, 0.0, 1.0, radians[ -3.0 ] ]
        sq     : quatf [ s_axis ]
        s_tip  : vec4f [ 1.0, 0.0, 0.0, radians[ 8.0 ] ]
        sq3    : quatf [ s_tip ]
        # ONE EIGHTH the old 6000: a gas giant that turned once every
        # fifteen seconds at ludacrous, while its lit face took minutes
        # to move, read as a spinning ball under a fixed lamp
        s_spin : vec4f [ 0.0, 1.0, 0.0, radians[ ux.time * 375.0 ] ]
        sq2    : quatf [ s_spin ]
        sm : mat4f.identity[]
        sm = sm.translate[ s_off ]
        sm = sm.rotate   [ sq3 ]
        sm = sm.rotate   [ sq ]
        sm = sm.rotate   [ sq2 ]
        sm = sm.scale    [ s_sc ]
        jup.model    = sm
        jup.view     = _view
        jup.proj     = _proj
        jup.gain     = 0.75
        jup.cam_pos  = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        # sodium orange against hydrogen blue -- the uniforms default to
        # black, so an unset palette means no discharges at all
        # w 0.0 = an EVENT. lightning fires and dies; this is the
        # behaviour that lane was hardcoded to before it existed
        jup.pc_a     = vec4f [ 1.00, 0.46, 0.13, 0.0 ]
        # w is longitude drift. 0.00015 is a lap every 28 seconds at
        # ludacrous -- storms carried by the wind, not racing it
        jup.pc_b     = vec4f [ 0.30, 0.60, 1.00, 0.00015 ]
        # z = additive discharge gain, w = lift toward white (unused).
        # pctl.w 1.0 keeps this a NIGHT-side effect; wctl2.w 60.0 is
        # the pulse frequency down the latitude, as it has always been
        jup.pstr     = vec4f [ 1.0, 1.0, 4.2, 0.0 ]
        # x is the discharge threshold. MEASURED against the actual
        # noise, not guessed: 0.69 fires on 0.062 of the disk and
        # 0.871 on 0.0078, which is an eighth of the storms. the
        # relation is nowhere near linear -- 0.80 is only a third off
        jup.pctl     = vec4f [ 0.871, 0.9, 2.0, 1.0 ]
        jup.wctl     = vec4f [ 0.16, 0.010, 56.55, 0.25 ]
        # z is the band ping-pong rate, a QUARTER of the old 0.0125.
        # at ludacrous that was shearing back and forth about three
        # times a second, which reads as the deck spinning, not wind
        jup.wctl2    = vec4f [ 0.55, 1.6, 0.0015625, 60.0 ]
        # w 0.0: jupiter takes no live tint at all
        jup.tint     = vec4f [ 1.0, 1.0, 1.0, 0.0 ]
        jup.pfire    = vec4f [ 1.0, 0.6, 0.2, 0.0 ]
        jup.pfire2   = vec4f [ 1.0, 0.9, 0.7, 0.0 ]
        jup.time     = ux.time * 60000.0
