# backdrop scenes: exported for any app to read in at runtime
export 0.1.0
export scenes ['Earth', 'Moon', 'Mars', 'Terra', 'MilkyWay', 'Titan', 'Europa', 'Enceladus', 'Uranus', 'Neptune', 'Pluto', 'Synthwave', 'Clouds']

import vec
import img
import gltf
import trinity

import <stdio.h>
import <stdlib.h>

enum PurpleSurface
    color        : 0
    cloud        : 1

enum EarthSurface
    color        : 0
    normal       : 1
    elevation    : 2
    water        : 3
    water_blur   : 4
    cloud        : 5
    bathymetry   : 6
    lights       : 7

ModelViewProject EarthShader
    mutable _pad0   : f32
    mutable _pad1   : f32
    mutable _pad2   : f32
    mutable cam_pos : vec4f

    attrib color        : LayoutBinding [ type:typeid[ EarthSurface ], id:EarthSurface.color,      count:1, format: typeid[ rgba8 ] ]
    attrib normal       : LayoutBinding [ type:typeid[ EarthSurface ], id:EarthSurface.normal,     count:1, format: typeid[ rgba8 ] ]
    attrib elevation    : LayoutBinding [ type:typeid[ EarthSurface ], id:EarthSurface.elevation,  count:1, format: typeid[ rgba8 ] ]
    attrib water        : LayoutBinding [ type:typeid[ EarthSurface ], id:EarthSurface.water,      count:1, format: typeid[ rgba8 ] ]
    attrib water_blur   : LayoutBinding [ type:typeid[ EarthSurface ], id:EarthSurface.water_blur, count:1, format: typeid[ rgba8 ] ]
    attrib cloud        : LayoutBinding [ type:typeid[ EarthSurface ], id:EarthSurface.cloud,      count:1, format: typeid[ rgba8 ] ]
    attrib bathymetry   : LayoutBinding [ type:typeid[ EarthSurface ], id:EarthSurface.bathymetry, count:1, format: typeid[ rgba8 ] ]
    attrib lights       : LayoutBinding [ type:typeid[ EarthSurface ], id:EarthSurface.lights,     count:1, format: typeid[ rgba8 ] ]

    attrib a_pos        : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal     : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv         : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_normal     : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_uv         : VertexOutput  [ type:typeid[ vec2f ] ]
    attrib v_tangent    : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_bitangent  : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_world_pos  : VertexOutput  [ type:typeid[ vec4f ] ]

    attrib fragColor    : FragmentOutput[ type:typeid[ vec4f ] ]

    func init[]
        fov_deg : 60.0f
        aspect  : 1920.0f / 1080.0f
        near    : 0.1f
        far     : 100.0f
        eye2    : vec3f [0.0f,  0.0f,  1.5f]
        target2 : vec3f [0.0f,  0.0f,  0.0f]
        up2     : vec3f [0.0f, -1.0f,  0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[70.0f], 1.0f, 0.1f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func rotateY [ angle: f32 ] -> GLSL mat3f {
        float c = cos(angle);
        float s = sin(angle);
        return mat3(
            vec3(c, 0.0, -s),
            vec3(0.0, 1.0, 0.0),
            vec3(s, 0.0, c)
        );
    }

    func sdf_sphere [ p: vec3f, radius: f32, squash: f32 ] -> GLSL float {
        // squash factor < 1.0 flattens vertically
        vec3 q = vec3(p.x, p.y / squash, p.z);
        return length(q) - radius;
    }

    func sdf_cylinder [ p: vec3f, h: f32, r: f32 ] -> GLSL float {
        vec2 d = abs(vec2(length(p.xz), p.y)) - vec2(r, h);
        return min(max(d.x, d.y), 0.0) + length(max(d, vec2(0.0)));
    }

    # permutation function
    func permute4 [ x: vec4f ] -> GLSL vec4f {
        return mod((x * 34.0 + 1.0) * x, vec4(289.0));
    }

    # fast inverse sqrt
    func taylorInvSqrt4 [ r: vec4f ] -> GLSL vec4f {
        return 1.79284291400159 - 0.85373472095314 * r;
    }

    # smootherstep fade curve
    func fade [ t: vec3f ] -> GLSL vec3f {
        return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
    }

    # basic perlin 3D noise
    func perlin3D [ P: vec3f ] -> GLSL float {
        vec3 Pi0 = mod(floor(P), vec3(289.0));
        vec3 Pi1 = mod(Pi0 + vec3(1.0), vec3(289.0));
        vec3 Pf0 = fract(P);
        vec3 Pf1 = Pf0 - vec3(1.0);

        vec4 ix = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
        vec4 iy = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
        vec4 iz0 = vec4(Pi0.z);
        vec4 iz1 = vec4(Pi1.z);

        vec4 ixy = permute4(permute4(ix) + iy);
        vec4 ixy0 = permute4(ixy + iz0);
        vec4 ixy1 = permute4(ixy + iz1);

        vec4 gx0 = fract(ixy0 / 7.0) * 2.0 - 1.0;
        vec4 gy0 = fract(floor(ixy0 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz0 = 1.0 - abs(gx0) - abs(gy0);

        vec4 gx1 = fract(ixy1 / 7.0) * 2.0 - 1.0;
        vec4 gy1 = fract(floor(ixy1 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz1 = 1.0 - abs(gx1) - abs(gy1);

        vec4 sz0 = step(gz0, vec4(0.0));
        gx0 -= sz0 * (step(0.0, gx0) - 0.5);
        gy0 -= sz0 * (step(0.0, gy0) - 0.5);

        vec4 sz1 = step(gz1, vec4(0.0));
        gx1 -= sz1 * (step(0.0, gx1) - 0.5);
        gy1 -= sz1 * (step(0.0, gy1) - 0.5);

        vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
        vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
        vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
        vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
        vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
        vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
        vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
        vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);

        vec4 norm0 = taylorInvSqrt4(vec4(dot(g000, g000), dot(g010, g010), dot(g100, g100), dot(g110, g110)));
        g000 *= norm0.x;
        g010 *= norm0.y;
        g100 *= norm0.z;
        g110 *= norm0.w;
        vec4 norm1 = taylorInvSqrt4(vec4(dot(g001, g001), dot(g011, g011), dot(g101, g101), dot(g111, g111)));
        g001 *= norm1.x;
        g011 *= norm1.y;
        g101 *= norm1.z;
        g111 *= norm1.w;

        float n000 = dot(g000, Pf0);
        float n100 = dot(g100, vec3(Pf1.x, Pf0.y, Pf0.z));
        float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
        float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
        float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
        float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
        float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
        float n111 = dot(g111, Pf1);

        vec3 fade_xyz = fade(Pf0);
        vec4 n_z = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fade_xyz.z);
        vec2 n_yz = mix(n_z.xy, n_z.zw, fade_xyz.y);
        float n_xyz = mix(n_yz.x, n_yz.y, fade_xyz.x);

        return n_xyz * 0.5 + 0.5;
    }

    # fractal brownian motion (fbm) using perlin noise
    func fbm [ pos: vec3f, y_translate: f32 ] -> GLSL float {
        float value = 0.0;
        float amplitude = 0.5;
        float frequency = 0.1;
        for (int i = 0; i < 6; ++i) {
            value += amplitude * perlin3D(pos * frequency + vec3(0.0, y_translate * 11.0, 0.0));
            amplitude *= 0.5;
            frequency *= 2.0;
        }
        return value;
    }

    func atmos_tint [ surf: vec3f, n: vec3f, vdir: vec3f, sdir: vec3f ] -> GLSL vec3f {
        float ndv      = max(dot(n, vdir), 0.0);
        float raw_sl   = dot(n, sdir);
        float cosZ     = max(raw_sl, -0.10);
        float air_mass = 1.0 / (cosZ + 0.22);

        vec3  sigma         = vec3(0.06, 0.15, 0.38);
        vec3  transmittance = exp(-sigma * air_mass);
        float sun_intensity = smoothstep(-0.10, 0.18, raw_sl);
        vec3  sun_c         = transmittance * (0.4 + 1.8 * sun_intensity);

        // atmospheric extinction — wide GENTLE fade from surface through blue
        // atmosphere into space clear-color, no hard silhouette during day.
        float limb_rim  = pow(1.0 - ndv, 5.0);
        float limb_soft = pow(1.0 - ndv, 2.2);
        float limb_wide = pow(1.0 - ndv, 0.9);    // very wide soft ramp
        float day_f     = smoothstep(0.00, 0.35, raw_sl);
        float grazing   = smoothstep(-0.20, 0.08, raw_sl) * smoothstep(0.55, 0.08, raw_sl);

        vec3  rayleigh = vec3(0.14, 0.40, 0.92);
        vec3  tint     = rayleigh * day_f * 0.70 + sun_c * grazing * 1.6;

        // fade to scene clear color at silhouette, matches background exactly.
        vec3  space_c    = vec3(0.088, 0.088, 0.188);
        vec3  surf_faded = mix(surf, space_c, clamp(limb_wide, 0.0, 1.0));

        // in-scatter tint peaks INSIDE the disk (gated by ndv), NOT at the
        // silhouette — so silhouette pixel = space_c = background, no edge.
        float in_scatter = ndv * limb_soft;
        float mix_amt    = in_scatter * (0.15 + 0.40 * day_f);
        return mix(surf_faded, tint, clamp(mix_amt, 0.0, 0.50));
    }

    func fragment[] -> GLSL none {
        vec2 uv = v_uv;

        // === Lighting setup ===
        // locals are prefixed (n_/w_/b_/e_/l_/c_) so they don't shadow the
        // sampler2Ds named `normal`/`water`/`bathymetry`/`elevation`/`lights`/`color`.
        vec3 n_view   = normalize(v_normal);
        vec3 sun_dir  = normalize(vec3(0.2, 0.0, 0.8)); // fixed light source
        vec3 view_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);

        vec3  normal_map        = texture(normal, v_uv).rgb * 2.0 - 1.0;
        mat3  TBN               = mat3(normalize(v_tangent), normalize(v_bitangent), n_view);
        vec3  perturbed_normal2 = normalize(TBN * normal_map);

        float NdotL    = max(dot(perturbed_normal2, sun_dir), 0.0);
        vec3  half_dir = normalize(sun_dir + view_dir);
        float spec     = pow(max(dot(perturbed_normal2, half_dir), 0.0), 28.0);

        // === Textures ===
        vec3  albedo = texture(color, uv).rgb;

        float w_amt  = texture(water, uv).r;
        float clouds = texture(cloud,      uv).r;
        float e_amt  = texture(elevation,  uv).r;
        float b_amt  = texture(bathymetry, uv).r;
        float l_amt  = texture(lights,     uv).r;

        // === Water coloring ===
        vec3 water_color = mix(vec3(0.0, 0.1, 0.1), vec3(0.2, 0.6, 1.0), b_amt);
        albedo = mix(albedo, water_color, w_amt);

        // === Elevation / bathymetry tint ===
        float elevation_effect = smoothstep(0.5, 1.0, e_amt);
        float bathy_effect     = w_amt * smoothstep(0.0, 0.5, b_amt);
        vec3  terrain_tint     = mix(vec3(0.8, 0.6, 0.3), vec3(0.2, 0.4, 0.7), bathy_effect);
        albedo = mix(albedo, terrain_tint, 0.3 * bathy_effect + 0.2 * elevation_effect);

        // === Specular reflection on water ===
        float edge_fade = pow(1.0 - dot(perturbed_normal2, view_dir), 2.0);
        vec3  specular  = vec3(1.0) * spec * 0.4 * w_amt;
        specular       += vec3(1.0) * w_amt * edge_fade;

        // === Ambient + Diffuse ===
        float ambient = 0.01;
        vec3  final   = albedo * (ambient + NdotL) + specular;

        // === Optional Gamma Correction (sRGB)
        vec3 f1 = pow(final, vec3(1.0 / 1.8));
        vec3 f2 = pow(final, vec3(1.0 / 6.4));

        float NdotV = max(0.0, pow(1.0 - dot(perturbed_normal2, view_dir), 1.0)) * 2.0;

        // animated FBM-based distortion
        float t = ubo.time * 0.2;
        vec3  offset  = vec3(uv * 50.0, t * 0.3) * 10.0;
        float noise_x = fbm(offset + vec3(100.0, 0.0, 0.0), 0.0);
        float noise_y = fbm(offset + vec3(0.0, 500.0, 0.0), 0.0);
        float noise_z = fbm(offset + vec3(0.0, 0.0,  15.0), 0.0);

        vec3 distortion       = normalize(vec3(noise_x, noise_y, noise_z) * 2.0 - 1.0) * 0.06;
        vec3 perturbed_normal = normalize(perturbed_normal2 + distortion);

        float spec2 = 0.0;

        // === Add tight central specular glint ===
        spec2 += max(0.0, pow(dot(n_view, view_dir), 244.0) * 0.88);

        float e = texture(elevation, v_uv).x;

        vec3 earth_rgb = mix(f1, f2, spec2) + vec3(e * 2.2 * spec2) * vec3(0.8, 1.0, 0.8);
        earth_rgb      = atmos_tint(earth_rgb, n_view, view_dir, sun_dir);
        fragColor = vec4(earth_rgb, 1.0);
    }

    func vertex[] -> GLSL none {
        const float M_PI = 3.1415926535897932384;

        v_uv        = vec2(1.0 - a_uv.x, a_uv.y);
        float theta = v_uv.x * 2.0 * M_PI; // longitude
        float phi   = v_uv.y * M_PI;       // latitude

        // Tangent: derivative of position w.r.t. u (around equator)
        v_tangent = normalize(vec3(-sin(theta), 0.0, cos(theta)));

        // Bitangent: derivative w.r.t. v (from pole to pole)
        v_bitangent = normalize(cross(v_tangent, a_pos)); // orthogonalized

        // Correctly rotate normal into world space
        mat3 normal_matrix = transpose(inverse(mat3(ubo.model)));
        v_normal    = normalize(normal_matrix * a_normal);
        v_tangent   = normalize(normal_matrix * v_tangent);
        v_bitangent = normalize(normal_matrix * v_bitangent);

        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }


EarthShader OceanShader
    func fragment[] -> GLSL none {
        vec2 uv = v_uv;

        // === Lighting setup ===
        // locals are prefixed (n_/w_/c_/b_) so they don't shadow the
        // sampler2Ds named `normal`/`water`/`cloud`/`bathymetry`/etc.
        vec3 n_view = normalize(v_normal);

        // animated FBM-based distortion
        float t = ubo.time * 0.2;
        vec3 offset = vec3(uv * 100.0, t * 0.3) * 5.0;
        float noise_x = fbm(offset + vec3(100.0, 0.0, 0.0), 0.0);
        float noise_y = fbm(offset + vec3(0.0, 500.0, 0.0), 0.0);
        float noise_z = fbm(offset + vec3(0.0, 0.0, 15.0), 0.0);

        // fade the ripple once its cycle drops under a pixel: it dashes.
        // gate on the TOP octave, not the base coordinate: fbm runs 6
        // octaves from 0.1 doubling to 3.2, so the finest detail is at
        // uv*1600, and 500 leaves it half-on while it is already aliasing
        float d_px = fwidth(uv.x) * 1600.0;
        float d_aa = clamp(1.0 - d_px, 0.0, 1.0);
        vec3 distortion = normalize(vec3(noise_x, noise_y, noise_z) * 2.0 - 1.0) * 0.084 * d_aa;
        vec3 perturbed_normal = normalize(n_view + distortion);

        vec3 sun_dir  = normalize(vec3(0.2, 0.0, 0.8));
        vec3 view_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);

        float NdotL   = max(dot(perturbed_normal, sun_dir), 0.0);
        vec3 half_dir = normalize(sun_dir + view_dir);

        // sharp Blinn-Phong highlight — tight sun glint on water.
        // fresnel boost makes grazing-angle water mirror-like.
        float spec    = pow(max(dot(perturbed_normal, half_dir), 0.0), 96.0);
        float fresnel = pow(1.0 - max(dot(perturbed_normal, view_dir), 0.0), 5.0);
        // gate on the true normal: a perturbed one sparkles past the terminator
        float day_s   = smoothstep(-0.02, 0.12, dot(n_view, sun_dir));
        spec          = (spec + fresnel * 0.3) * 3.0 * day_s;

        // === Textures ===
        const float kernel[7] = float[](
            0.006, 0.061, 0.242, 0.383, 0.242, 0.061, 0.006
        );

        vec2 texel = 1.0 / vec2(textureSize(cloud, 0));
        float c_amt = 0.0;

        for (int i = -3; i <= 3; ++i) {
            for (int j = -3; j <= 3; ++j) {
                vec2 offset = vec2(i, j) * texel * 2.0;
                float weight = kernel[i + 3] * kernel[j + 3];
                c_amt += texture(cloud, uv + offset).r * weight;
            }
        }

        float w_amt = (texture(water, uv).r + texture(water_blur, uv).r) / 2.0;

        // === Water coloring ===
        vec3 water_color = vec3(0.022, 0.11, 0.22);

        // === Specular reflection on water ===
        float edge_fade = pow(1.0 - dot(n_view, view_dir), 2.0);
        // sun glint scaled by NdotL so we don't see highlights on night side
        vec3 s1 = vec3(1.0, 0.98, 0.92) * spec * w_amt * NdotL;
        s1 += vec3(0.1, 0.2, 0.3) * w_amt * edge_fade;

        float ambient = 0.005;

        water_color -= c_amt * (0.22 * (1.0 - (2.0 * spec)));
        vec3 final = water_color * (ambient + NdotL) + s1;

        float facing = max(0.0, pow(dot(n_view, view_dir), 144.0) * 0.44);
        vec3 glint   = vec3(1.0) * facing;

        float b_amt = texture(bathymetry, uv).r;
        vec3 water_color2 = vec3(0.4, 0.4, 0.4) * b_amt;

        vec4 ocean_out = mix(vec4(water_color2 + glint, w_amt), vec4(final, w_amt), 1.0 - (glint.x * 1.44));
        ocean_out.rgb  = atmos_tint(ocean_out.rgb, n_view, view_dir, sun_dir);
        fragColor      = ocean_out;
    }

    func vertex[] -> GLSL none {
        v_uv           = vec2(1.0 - a_uv.x, a_uv.y);

        // Correctly rotate normal into world space
        mat3 normal_matrix = transpose(inverse(mat3(ubo.model)));
        v_normal = normalize(normal_matrix * a_normal);

        float scale     = 0.00044;
        vec3  surface   = a_pos + (a_normal * 1.0 * scale);
        vec4  wpos      = ubo.model * vec4(surface, 1.0);
        v_world_pos     = wpos;
        gl_Position     = ubo.proj * ubo.view * wpos;
    }

EarthShader CloudShader
    attrib v_cloud_avg  : VertexOutput [ type:typeid[ f32 ] ]

    func vertex[] -> GLSL none {
        v_uv = vec2(1.0 - a_uv.x, a_uv.y);

        // Correctly rotate normal into world space
        mat3 normal_matrix = transpose(inverse(mat3(ubo.model)));
        v_normal = normalize(normal_matrix * a_normal);

        // === Pre-blur the cloud sample with a 7-tap separable kernel,
        //     so the fragment can do `cloud / (2.0 - v_cloud_avg)` for
        //     a smoother contrast normalization than the raw sample.
        const float kernel[7] = float[](
            0.006, 0.061, 0.242, 0.383, 0.242, 0.061, 0.006
        );

        vec2  texel = 1.0 / vec2(textureSize(cloud, 0));
        float c_avg = 0.0;

        for (int i = -3; i <= 3; ++i) {
            for (int j = -3; j <= 3; ++j) {
                vec2  offset = vec2(i, j) * texel * 2.0;
                float weight = kernel[i + 3] * kernel[j + 3];
                c_avg += texture(cloud, v_uv + offset).r * weight;
            }
        }

        v_cloud_avg = c_avg;

        float scale   = 0.008; //0.0044 + clouds * 0.0044;
        vec3  surface = a_pos + (a_normal * 1.0 * scale);
        vec4  wpos    = ubo.model * vec4(surface, 1.0);
        v_world_pos   = wpos;
        gl_Position   = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        vec2 uv = v_uv;

        vec3 n_view   = normalize(v_normal);
        vec3 sun_dir  = normalize(vec3(0.2, 0.0, 0.8)); // fixed light source
        vec3 view_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);

        float NdotL    = max(dot(n_view, sun_dir), 0.0);
        vec3  half_dir = normalize(sun_dir + view_dir);
        float spec     = pow(max(dot(n_view, half_dir), 0.0), 128.0);

        float c_amt = texture(cloud, uv).x / (2.0 - v_cloud_avg);

        float ndv = max(dot(n_view, view_dir), 0.0);
        // silhouette fade: ramps back to 0 at the geometric limb so we don't
        // slam a bright rim into jagged mesh-edge pixels. widened further for
        // a very gentle transition into the background.
        float silh_fade = smoothstep(0.0, 0.24, ndv);
        float edge      = pow(1.0 - ndv, 4.0) * silh_fade;
        float rim       = pow(1.0 - ndv, 2.0) * silh_fade;
        float limb_wide = pow(1.0 - ndv, 0.9);
        c_amt *= clamp(1.0 - limb_wide, 0.0, 1.0);

        // === physical sun color through atmosphere — Beer/Rayleigh.
        // air_mass ≈ 1/cos(zenith) = 1/NdotL; clamped so terminator still glows.
        // per-channel optical depth: blue scatters ~5x red, giving the real
        // white→yellow→orange→red progression as the sun descends toward horizon.
        float raw_sl = dot(n_view, sun_dir);
        // Kasten-Young-ish soft secant: flattens air_mass near the horizon
        // so reds/yellows don't blow out saturation at the terminator.
        float cosZ     = max(raw_sl, -0.10);
        float air_mass = 1.0 / (cosZ + 0.22);

        vec3  sigma         = vec3(0.06, 0.15, 0.38);
        vec3  transmittance = exp(-sigma * air_mass);

        float sun_intensity = smoothstep(-0.10, 0.18, raw_sl);
        vec3  sun_color     = transmittance * (0.4 + 1.8 * sun_intensity);

        float day     = smoothstep(0.00, 0.35, raw_sl);
        // grazing = terminator aura strength (peaks where sun just grazes horizon)
        float grazing = smoothstep(-0.20, 0.08, raw_sl) * smoothstep(0.55, 0.08, raw_sl);

        vec3 base_color = vec3(1.0) * (0.12 + 0.88 * day);
        vec3 haze_color = mix(base_color, sun_color, edge);

        // === Day atmosphere = ULTRA soft extended glow, not a glass dome.
        // wide gaussian so the color bleeds far into the disk AND out toward
        // space; low alpha overall means the cloud shell lets earth show
        // through while gaining an atmospheric glow on top.
        vec3  col_deep   = vec3(0.25, 0.55, 0.98);
        vec3  col_light  = vec3(0.55, 0.75, 1.00);
        float band       = exp(-pow((ndv - 0.18) / 0.22, 2.0));   // much wider, peak deeper in
        float inward     = smoothstep(0.02, 0.25, ndv);
        vec3  limb_c     = mix(col_light, col_deep, inward);
        float alpha_fade = smoothstep(0.0, 0.10, ndv);
        vec3  day_limb   = limb_c * band * alpha_fade * 0.55 * day;
        float day_haze   = band * alpha_fade * 0.55 * day;

        // === aura: warm crescent at terminator limb — smooth everywhere,
        // silh_fade guarantees no sharp edge at silhouette.
        float aura_gain = grazing * edge * 2.0;
        vec3  aura      = sun_color * aura_gain;

        // === aurora: uses the same fbm as Earth/Ocean distortion, integrated
        // across the atmosphere depth. the cloud shell sits from earth surface
        // up to atmosphere top; sample several depths along world-space and sum
        // for a volumetric look. night-side only, polar-concentrated.
        float night_f = smoothstep(0.05, -0.25, raw_sl);
        float polar   = pow(1.0 - abs(n_view.y), 1.5);
        float t_a     = ubo.time * 0.25;
        // ray-march 4 altitude slices along the view direction. stepping
        // inward toward earth gives parallax + color stratification — lower
        // altitudes emit green (atomic oxygen ~557nm), higher emit magenta/
        // red (~630nm + nitrogen pinks). summed + weighted by altitude.
        // === TRUE volumetric ray-march through a VIRTUAL aurora shell.
        // aurora in reality spans ~100-400km altitude (0.016-0.063 units).
        // we march through that entire thick volume, NOT the thin cloud shell.
        // ray/sphere intersections give real slice; 12 samples along it.
        // shells are earth-local; the sky earth is not at the origin
        mat4  m_inv   = inverse(ubo.model);
        vec3  ro      = (m_inv * vec4(ubo.cam_pos.xyz, 1.0)).xyz;
        vec3  rd      = normalize((m_inv * v_world_pos).xyz - ro);
        float R_top   = 1.044;                         // aurora top (~400km)
        float R_bot   = 1.022;                         // aurora bottom (~90km)
        float R_earth = 1.000;
        float b       = dot(ro, rd);
        float c_top   = dot(ro, ro) - R_top   * R_top;
        float c_bot   = dot(ro, ro) - R_bot   * R_bot;
        float c_earth = dot(ro, ro) - R_earth * R_earth;

        float disc_top   = b * b - c_top;
        float disc_bot   = b * b - c_bot;
        float disc_earth = b * b - c_earth;

        // ray must enter the top shell for aurora to exist along it
        float t_enter = -b - sqrt(max(disc_top, 0.0));
        float t_exit  = -b + sqrt(max(disc_top, 0.0));

        // clip to the near side of the bottom shell (first earth-ward boundary)
        if (disc_bot > 0.0) {
            float t_bot_near = -b - sqrt(disc_bot);
            if (t_bot_near > t_enter) t_exit = min(t_exit, t_bot_near);
        }
        // clip against earth occlusion (ray hits earth before aurora exit)
        if (disc_earth > 0.0) {
            float t_earth = -b - sqrt(disc_earth);
            if (t_earth > t_enter) t_exit = min(t_exit, t_earth);
        }

        float slice_len = max(t_exit - t_enter, 0.0);
        vec3  aur_low   = vec3(0.15, 1.00, 0.55);
        vec3  aur_high  = vec3(0.85, 0.30, 0.90);
        vec3  aur_sum   = vec3(0.0);
        float dens      = 0.0;

        // 12-sample ray-march — real 3D positions, altitude colors, front-to-back.
        for (int i = 0; i < 12; i++) {
            float ki  = (float(i) + 0.5) / 12.0;
            vec3  wp  = ro + rd * (t_enter + slice_len * ki);
            float alt = length(wp) - R_earth;
            float alt_n = clamp((alt - (R_bot - R_earth)) / (R_top - R_bot), 0.0, 1.0);

            if (disc_top <= 0.0 || slice_len <= 0.0) break;

            // lower frequency + softer threshold = larger, hazier shapes,
            // still gated so aurora has form rather than a smooth fog.
            vec3  sp   = wp * 28.0 + vec3(0.0, t_a + ki * 2.0, 0.0);
            float ss   = fbm(sp, ki * 0.4);
            float sc   = smoothstep(0.44, 0.72, ss);
            // front-to-back attenuation keeps parallax readable
            float atten = 1.0 - ki * 0.35;
            aur_sum += mix(aur_high, aur_low, alt_n) * sc * atten;
            dens    += sc * atten;
        }

        float curtain = smoothstep(0.4, 3.0, dens);
        vec3  aur_col = aur_sum / max(dens, 0.01);
        // depth proxy through haze — limb looks through more atmosphere.
        // silh_fade keeps aurora from clipping hard at the mesh silhouette.
        float depth_f  = pow(1.0 - ndv, 2.0) * silh_fade;
        float aurora_g = night_f * polar * curtain * depth_f * 2.2;
        vec3  aurora   = aur_col * aurora_g;

        vec3  color_out   = haze_color + aura + day_limb + aurora;
        float cloud_alpha = c_amt + edge * 0.4 + aura_gain * 0.5 + day_haze * 0.7 + aurora_g * 0.8;

        fragColor = vec4(color_out, cloud_alpha);
    }


element EarthPrev
    frost : true
    # eased camera distance / angle; p_set marks the first frame
    intern e_cur  : f32
    intern p_cur  : f32
    intern p_set  : bool
    intern earth  : EarthShader
    intern ocean  : OceanShader
    intern cloud  : CloudShader
    intern models : vec Model
    intern target : Render
    intern built  : bool
    # async load: worker decodes, draw waits on ready for vk work
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    public color  : rgba [ r:0.022, g:0.088, b:0.122, a:1.0 ]

    func build_models[]
        built     = true
        gltf_path : path '../scenes/models/earth.gltf'
        gltf      : GltfModel.open[ gltf_path ]
        earth     = EarthShader [ vk: vk ]
        ocean     = OceanShader [ vk: vk ]
        cloud     = CloudShader [ vk: vk ]
        #purple = Purple [ vk: vk ]

        u : path '../scenes/textures/earth-color-8192x4096.png'
        earth_color : Image [ uri: u, surface: EarthSurface.color ]
        earth_samplers : map Image [string] [
            'color':      earth_color,
            'normal':     Image [ uri: path '../scenes/textures/earth-normal-8192x4096.png',     surface: EarthSurface.normal ],
            'elevation':  Image [ uri: path '../scenes/textures/earth-elevation-8192x4096.png',  surface: EarthSurface.elevation ],
            'water':      Image [ uri: path '../scenes/textures/earth-water-8192x4096.png',      surface: EarthSurface.water ],
            'water_blur': Image [ uri: path '../scenes/textures/earth-water-blur-8192x4096.png', surface: EarthSurface.water_blur ],
            'cloud':      Image [ uri: path '../scenes/textures/earth-cloud-8192x4096.png',      surface: EarthSurface.cloud ],
            'bathymetry': Image [ uri: path '../scenes/textures/earth-bathymetry-8192x4096.png', surface: EarthSurface.bathymetry ],
            'lights':     Image [ uri: path '../scenes/textures/earth-lights-8192x4096.png',     surface: EarthSurface.lights ]
        ]
        earth_model : Model [ vk: vk, w: ux, id: gltf, s: earth, samplers: earth_samplers, straight_alpha: true ]
        ocean_model : Model [ vk: vk, w: ux, id: gltf, s: ocean, samplers: earth_samplers, straight_alpha: true ]
        cloud_model : Model [ vk: vk, w: ux, id: gltf, s: cloud, samplers: earth_samplers, straight_alpha: true ]
        models      = vec Model [] [ earth_model, ocean_model, cloud_model ]

    # own render pass; the window composites its color as the backdrop
    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        ux.element_targets[ id ] = target

    # unregister only; we keep our ref so the GPU graph outlives the frame
    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    func load_bg [ arg: object :: t: EarthPrev ]
        t0 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg start at {t0}'
        t.build_models[]
        t1 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg done in {t1 - t0}ms at {t1}'
        t.ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : vec Au []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: lambda load_bg[ a ], work: w9 ]
        if [ !ready ] return
        create_target[]
        orbit[]

    func orbit[]
        # ux.time is KILOseconds: x64 advanced 0.016 deg a second, which
        # is slower than the per-frame jitter that used to sit under it
        time : ux.time * 1460.0
        if [time == 0.0]
            time = -54.0
        # a surface flyover: altitude above the ground, not eye distance.
        # low is the original 0.063 -- the ladder only goes outward
        a_t      : f32 [ (ux.orbit_mode == OrbitView.low)  ? 0.063 :
                         (ux.orbit_mode == OrbitView.high) ? 0.200 : 0.600 ]
        if [ e_cur == 0.0 ] e_cur = a_t
        e_cur = filter_n[ e_cur, a_t, 0.08, ux.frame_factor ]
        altitude : f32 [ e_cur ]
        eye_dist : f32 [ 1.0 + altitude ]
        # aim, in degrees off NADIR. flat must be 0 or it points away
        # from the planet centre and the body sits off-frame at far orbit
        t_deg    : f32 [ (ux.angle_mode == ViewAngle.flat)   ? 0.0 :
                         (ux.angle_mode == ViewAngle.angled) ? 50.0 : 68.0 ]
        if [ p_cur == 0.0 && !p_set ] p_cur = t_deg
        p_set    = true
        p_cur    = filter_n[ p_cur, t_deg, 0.08, ux.frame_factor ]
        # set AFTER both eases, and OR them: whichever is still moving
        # has to hold the frame skip off
        ux.orbit_moving = abs[ e_cur - a_t ] > 0.0004 || abs[ p_cur - t_deg ] > 0.05
        tilt     : f32 [ radians[ p_cur ] ]
        # follow the window, never a fixed 16:9 -- a hardcoded aspect
        # stretches the disc the moment the window is not that shape
        aspect   : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]

        # NO per-frame nudge here: `time` is a local recomputed from
        # ux.time every frame, so a -= cannot accumulate. all it did
        # was add frame_factor's millisecond jitter on top
        orbit_a : radians[ time ]
        co      : cos[ orbit_a ]
        so      : sin[ orbit_a ]

        ex_l  : f32 [ 0.0 ]
        ey_l  : f32 [ 0.0 ]
        ez_l  : f32 [ eye_dist ]
        fx_l  : f32 [ -sin[ tilt ] ]
        fy_l  : f32 [ 0.0 ]
        fz_l  : f32 [ -cos[ tilt ] ]
        tx_l  : f32 [ ex_l + fx_l * 2.0 ]
        ty_l  : f32 [ ey_l + fy_l * 2.0 ]
        tz_l  : f32 [ ez_l + fz_l * 2.0 ]
        ux_l  : f32 [ 1.0 ]
        uy_l  : f32 [ 0.0 ]
        uz_l  : f32 [ 0.0 ]

        # rotate each vector around Y by orbit_a
        _eye2    : vec3f [  co * ex_l + so * ez_l, ey_l, -so * ex_l + co * ez_l ]
        _target2 : vec3f [  co * tx_l + so * tz_l, ty_l, -so * tx_l + co * tz_l ]
        _up2     : vec3f [  co * ux_l + so * uz_l, uy_l, -so * ux_l + co * uz_l ]

        _model   : mat4f.identity   []
        _proj    : mat4f.perspective[ radians[ 60.0 ], aspect, 0.001, 10.0 ]
        _view    : mat4f.look_at    [ _eye2, _target2, _up2 ]

        # earth no longer spins — only the optional axial tilt stays
        tilt_axis : vec4f [ 1.0, 0.0, 0.0, radians[ 0 ] ]
        q_tilt    : quatf [ tilt_axis ]
        m : mat4f.identity[]
        m = m.rotate[ q_tilt ]

        earth.model = m
        earth.view  = _view
        earth.proj  = _proj

        ocean.model = m
        ocean.view  = _view
        ocean.proj  = _proj

        cloud.model = m
        cloud.view  = _view
        cloud.proj  = _proj

        _cam : vec4f [ _eye2.x, _eye2.y, _eye2.z, 1.0 ]

        earth.time    = time
        ocean.time    = time
        cloud.time    = time
        earth.cam_pos = _cam
        ocean.cam_pos = _cam
        cloud.cam_pos = _cam


# vantage the scenes share; each maps it to its own distance, since
# a globe view and a surface flyover need very different numbers
enum OrbitView
    low  : 0
    high : 1
    far  : 2
    wide : 3

# how far off flat-on the camera sits. a globe scene reads it as pitch
# above the equator; a surface flyover reads it as how far its aim
# swings up toward the horizon
enum ViewAngle
    flat   : 0
    angled : 1
    steep  : 2

enum MoonSurface
    color  : 0
    height : 1
    cloud  : 2
    jungle : 3

ModelViewProject MoonShader
    mutable gain     : f32
    mutable regolith : f32
    # relief from the height map; 0 leaves the normal alone
    mutable relief   : f32
    mutable cam_pos : vec4f

    attrib color  : LayoutBinding [ type:typeid[ MoonSurface ], id:MoonSurface.color,  count:1, format: typeid[ rgba8 ] ]
    attrib height : LayoutBinding [ type:typeid[ MoonSurface ], id:MoonSurface.height, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos        : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal     : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv         : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_normal     : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_uv         : VertexOutput  [ type:typeid[ vec2f ] ]
    attrib v_world_pos  : VertexOutput  [ type:typeid[ vec4f ] ]

    attrib fragColor    : FragmentOutput[ type:typeid[ vec4f ] ]

    func init[]
        eye2    : vec3f [0.0f,  0.0f,  1.5f]
        target2 : vec3f [0.0f,  0.0f,  0.0f]
        up2     : vec3f [0.0f, -1.0f,  0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[70.0f], 1.0f, 0.1f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_uv        = vec2(1.0 - a_uv.x, a_uv.y);
        mat3 nm     = transpose(inverse(mat3(ubo.model)));
        v_normal    = normalize(nm * a_normal);
        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func hash31 [ p: vec3f ] -> GLSL float {
        return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);
    }

    # value noise; one octave, continent scale is set by the caller
    func vnoise [ p: vec3f ] -> GLSL float {
        vec3 i = floor(p);
        vec3 f = fract(p);
        vec3 u = f * f * (3.0 - 2.0 * f);
        float n000 = hash31(i + vec3(0.0, 0.0, 0.0));
        float n100 = hash31(i + vec3(1.0, 0.0, 0.0));
        float n010 = hash31(i + vec3(0.0, 1.0, 0.0));
        float n110 = hash31(i + vec3(1.0, 1.0, 0.0));
        float n001 = hash31(i + vec3(0.0, 0.0, 1.0));
        float n101 = hash31(i + vec3(1.0, 0.0, 1.0));
        float n011 = hash31(i + vec3(0.0, 1.0, 1.0));
        float n111 = hash31(i + vec3(1.0, 1.0, 1.0));
        return mix(mix(mix(n000, n100, u.x), mix(n010, n110, u.x), u.y),
                   mix(mix(n001, n101, u.x), mix(n011, n111, u.x), u.y), u.z);
    }

    func p_permute4 [ x: vec4f ] -> GLSL vec4f {
        return mod((x * 34.0 + 1.0) * x, vec4(289.0));
    }

    func p_invsqrt4 [ r: vec4f ] -> GLSL vec4f {
        return 1.79284291400159 - 0.85373472095314 * r;
    }

    # gradient noise. value noise interpolates CORNER VALUES, so its
    # isocontours run along the lattice and any mask built on it cuts
    # square edges. gradient noise interpolates corner GRADIENTS and
    # is zero at every lattice point, so nothing aligns to the grid
    func gnoise [ P: vec3f ] -> GLSL float {
        vec3 Pi0 = mod(floor(P), vec3(289.0));
        vec3 Pi1 = mod(Pi0 + vec3(1.0), vec3(289.0));
        vec3 Pf0 = fract(P);
        vec3 Pf1 = Pf0 - vec3(1.0);
        vec4 ix  = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
        vec4 iy  = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
        vec4 iz0 = vec4(Pi0.z);
        vec4 iz1 = vec4(Pi1.z);
        vec4 ixy  = p_permute4(p_permute4(ix) + iy);
        vec4 ixy0 = p_permute4(ixy + iz0);
        vec4 ixy1 = p_permute4(ixy + iz1);
        vec4 gx0 = fract(ixy0 / 7.0) * 2.0 - 1.0;
        vec4 gy0 = fract(floor(ixy0 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz0 = 1.0 - abs(gx0) - abs(gy0);
        vec4 gx1 = fract(ixy1 / 7.0) * 2.0 - 1.0;
        vec4 gy1 = fract(floor(ixy1 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz1 = 1.0 - abs(gx1) - abs(gy1);
        vec4 sz0 = step(gz0, vec4(0.0));
        gx0 -= sz0 * (step(0.0, gx0) - 0.5);
        gy0 -= sz0 * (step(0.0, gy0) - 0.5);
        vec4 sz1 = step(gz1, vec4(0.0));
        gx1 -= sz1 * (step(0.0, gx1) - 0.5);
        gy1 -= sz1 * (step(0.0, gy1) - 0.5);
        vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
        vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
        vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
        vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
        vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
        vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
        vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
        vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);
        vec4 nm0 = p_invsqrt4(vec4(dot(g000,g000), dot(g010,g010), dot(g100,g100), dot(g110,g110)));
        g000 *= nm0.x; g010 *= nm0.y; g100 *= nm0.z; g110 *= nm0.w;
        vec4 nm1 = p_invsqrt4(vec4(dot(g001,g001), dot(g011,g011), dot(g101,g101), dot(g111,g111)));
        g001 *= nm1.x; g011 *= nm1.y; g101 *= nm1.z; g111 *= nm1.w;
        float n000 = dot(g000, Pf0);
        float n100 = dot(g100, vec3(Pf1.x, Pf0.y, Pf0.z));
        float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
        float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
        float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
        float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
        float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
        float n111 = dot(g111, Pf1);
        vec3  fxyz = Pf0 * Pf0 * Pf0 * (Pf0 * (Pf0 * 6.0 - 15.0) + 10.0);
        vec4  n_z  = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fxyz.z);
        vec2  n_yz = mix(n_z.xy, n_z.zw, fxyz.y);
        return mix(n_yz.x, n_yz.y, fxyz.x) * 0.5 + 0.5;
    }

    # three octaves on offset domains, over gradient noise
    func fnoise [ p: vec3f ] -> GLSL float {
        float a = gnoise(p);
        float b = gnoise(p * 2.17 + vec3( 37.2, 11.7, 91.3));
        float c = gnoise(p * 4.41 + vec3(-19.4, 63.1, 27.8));
        return a * 0.56 + b * 0.30 + c * 0.14;
    }

    func fragment[] -> GLSL none {
        vec3  n      = normalize(v_normal);
        vec3  sun    = normalize(vec3(0.2, 0.0, 0.8));
        // relief: tilt the normal by the height gradient, east/north basis
        float e_uv   = 1.0 / 4096.0;
        float h_l    = texture(height, v_uv + vec2(-e_uv, 0.0)).r;
        float h_r    = texture(height, v_uv + vec2( e_uv, 0.0)).r;
        float h_d    = texture(height, v_uv + vec2(0.0, -e_uv)).r;
        float h_u    = texture(height, v_uv + vec2(0.0,  e_uv)).r;
        vec3  t_e    = normalize(cross(vec3(0.0, 1.0, 0.0), n));
        vec3  t_n    = cross(n, t_e);
        vec3  bump   = t_e * (h_l - h_r) + t_n * (h_d - h_u);
        float r_aa   = clamp(1.0 - fwidth(v_uv.x) * 4096.0, 0.0, 1.0);
        n            = normalize(n + bump * ubo.relief * 24.0 * r_aa);
        float ndl    = max(dot(n, sun), 0.0);
        vec3  albedo = texture(color, v_uv).rgb;
        // one blob spans most of the visible ground from low orbit
        float g      = ubo.regolith;
        float nz     = vnoise(normalize(v_world_pos.xyz) * 1.15);
        float ctr    = 1.0 + g * (nz - 0.5) * 0.8;
        vec3  alb    = clamp((albedo - 0.5) * ctr + 0.5, 0.0, 1.0);
        alb          = mix(alb, alb * vec3(1.06, 0.99, 0.90), g * nz);
        alb         *= (1.0 - 0.08 * g);
        // regolith: no specular, a little ambient so the limb reads
        vec3  lit    = alb * (0.05 + 0.95 * ndl) * ubo.gain;
        fragColor    = vec4(lit / (1.0 + lit), 1.0);
    }


element Moon
    frost : true
    frost_sharp : true
    # eased camera distance / angle; p_set marks the first frame
    intern e_cur  : f32
    intern p_cur  : f32
    intern p_set  : bool
    intern moon   : MoonShader
    # the earth in the sky gets the Earth scene's full stack
    intern earth  : EarthShader
    intern ocean  : OceanShader
    intern cloud  : CloudShader
    intern models : vec Model
    intern target : Render
    intern built  : bool
    # async load: worker decodes, draw waits on ready for vk work
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    public color  : rgba [ r:0.004, g:0.006, b:0.014, a:1.0 ]

    func build_models[]
        built     = true
        gltf_path : path '../scenes/models/earth.gltf'
        gltf      : GltfModel.open[ gltf_path ]
        moon      = MoonShader  [ vk: vk ]
        earth     = EarthShader [ vk: vk ]
        ocean     = OceanShader [ vk: vk ]
        cloud     = CloudShader [ vk: vk ]

        # the ground: one map, lit flat with the regolith noise
        moon_samplers : map Image [string] [
            'color':  Image [ uri: path '../scenes/textures/moon-color-8192x4096.jpg',    surface: MoonSurface.color ],
            'height': Image [ uri: path '../scenes/textures/moon-displace-2048x1024.png', surface: MoonSurface.height ]
        ]
        earth_samplers : map Image [string] [
            'color':      Image [ uri: path '../scenes/textures/earth-color-8192x4096.png',      surface: EarthSurface.color ],
            'normal':     Image [ uri: path '../scenes/textures/earth-normal-8192x4096.png',     surface: EarthSurface.normal ],
            'elevation':  Image [ uri: path '../scenes/textures/earth-elevation-8192x4096.png',  surface: EarthSurface.elevation ],
            'water':      Image [ uri: path '../scenes/textures/earth-water-8192x4096.png',      surface: EarthSurface.water ],
            'water_blur': Image [ uri: path '../scenes/textures/earth-water-blur-8192x4096.png', surface: EarthSurface.water_blur ],
            'cloud':      Image [ uri: path '../scenes/textures/earth-cloud-8192x4096.png',      surface: EarthSurface.cloud ],
            'bathymetry': Image [ uri: path '../scenes/textures/earth-bathymetry-8192x4096.png', surface: EarthSurface.bathymetry ],
            'lights':     Image [ uri: path '../scenes/textures/earth-lights-8192x4096.png',     surface: EarthSurface.lights ]
        ]
        moon_model  : Model [ vk: vk, w: ux, id: gltf, s: moon,  samplers: moon_samplers,  straight_alpha: true ]
        earth_model : Model [ vk: vk, w: ux, id: gltf, s: earth, samplers: earth_samplers, straight_alpha: true ]
        ocean_model : Model [ vk: vk, w: ux, id: gltf, s: ocean, samplers: earth_samplers, straight_alpha: true ]
        cloud_model : Model [ vk: vk, w: ux, id: gltf, s: cloud, samplers: earth_samplers, straight_alpha: true ]
        models      = vec Model [] [ moon_model, earth_model, ocean_model, cloud_model ]

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        ux.element_targets[ id ] = target

    # unregister only; we keep our ref so the GPU graph outlives the frame
    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    # regolith: the editor's purples go gray under a lunar sky
    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#1c1c20cc',
            '#140a2a80':  '#1c1c2080',
            '#4258':      '#8a8a8a22',
            '#ff6a2e55':  '#9a9a9a55',
            '#220022aa':  '#20202aaa',
            '#614':       '#3c3c42',
            '#413':       '#2e2e34',
            '#826':       '#565660',
            '#625a':      '#333a',
            '#8af2':      '#8882',
            '#425':       '#3a3a42',
            '#ede3':      '#bbb3',       # editor selection border
            '#44225588':  '#8a8a8a66',
            '#ff3a6a22':  '#8a8a8a22',   # commit tab fill
            '#ff3a6a44':  '#8a8a8a44',   # commit tab hover fill
            '#ff5a8a99':  '#9a9a9a99',   # commit tab border
            '#ff7aa4cc':  '#b4b4b4cc'    # commit tab hover border
        ]

    func load_bg [ arg: object :: t: Moon ]
        t0 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg start at {t0}'
        t.build_models[]
        t1 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg done in {t1 - t0}ms at {t1}'
        t.ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : vec Au []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: lambda load_bg[ a ], work: w9 ]
        if [ !ready ] return
        create_target[]
        orbit[]

    func orbit[]
        # ux.time is KILOseconds: x64 advanced 0.016 deg a second, which
        # is slower than the per-frame jitter that used to sit under it
        time : ux.time * 1460.0
        if [time == 0.0]
            time = -54.0
        # a surface flyover: altitude above the ground, not eye distance.
        # low is the original 0.063 -- the ladder only goes outward
        a_t      : f32 [ (ux.orbit_mode == OrbitView.low)  ? 0.063 :
                         (ux.orbit_mode == OrbitView.high) ? 0.200 : 0.600 ]
        if [ e_cur == 0.0 ] e_cur = a_t
        e_cur = filter_n[ e_cur, a_t, 0.08, ux.frame_factor ]
        altitude : f32 [ e_cur ]
        eye_dist : f32 [ 1.0 + altitude ]
        # limb sits at 70.2; aim above it or there is no sky to fill
        # off NADIR: flat is 0 so the body centres at any altitude. the
        # limb sits at 70.2 at low orbit, so steep must clear it for sky
        t_deg    : f32 [ (ux.angle_mode == ViewAngle.flat)   ? 0.0 :
                         (ux.angle_mode == ViewAngle.angled) ? 74.0 : 82.0 ]
        if [ p_cur == 0.0 && !p_set ] p_cur = t_deg
        p_set    = true
        p_cur    = filter_n[ p_cur, t_deg, 0.08, ux.frame_factor ]
        # set AFTER both eases, and OR them: whichever is still moving
        # has to hold the frame skip off
        ux.orbit_moving = abs[ e_cur - a_t ] > 0.0004 || abs[ p_cur - t_deg ] > 0.05
        tilt     : f32 [ radians[ p_cur ] ]
        # follow the window, never a fixed 16:9 -- a hardcoded aspect
        # stretches the disc the moment the window is not that shape
        aspect   : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]

        # NO per-frame nudge here: `time` is a local recomputed from
        # ux.time every frame, so a -= cannot accumulate. all it did
        # was add frame_factor's millisecond jitter on top
        orbit_a : radians[ time ]
        co      : cos[ orbit_a ]
        so      : sin[ orbit_a ]

        ex_l  : f32 [ 0.0 ]
        ey_l  : f32 [ 0.0 ]
        ez_l  : f32 [ eye_dist ]
        fx_l  : f32 [ -sin[ tilt ] ]
        fy_l  : f32 [ 0.0 ]
        fz_l  : f32 [ -cos[ tilt ] ]
        tx_l  : f32 [ ex_l + fx_l * 2.0 ]
        ty_l  : f32 [ ey_l + fy_l * 2.0 ]
        tz_l  : f32 [ ez_l + fz_l * 2.0 ]
        ux_l  : f32 [ 1.0 ]
        uy_l  : f32 [ 0.0 ]
        uz_l  : f32 [ 0.0 ]

        _eye2    : vec3f [  co * ex_l + so * ez_l, ey_l, -so * ex_l + co * ez_l ]
        _target2 : vec3f [  co * tx_l + so * tz_l, ty_l, -so * tx_l + co * tz_l ]
        _up2     : vec3f [  co * ux_l + so * uz_l, uy_l, -so * ux_l + co * uz_l ]

        _proj    : mat4f.perspective[ radians[ 60.0 ], aspect, 0.001, 10.0 ]
        _view    : mat4f.look_at    [ _eye2, _target2, _up2 ]

        # the moon holds the middle
        mm : mat4f.identity[]
        moon.model = mm
        moon.view  = _view
        moon.proj  = _proj
        moon.gain  = 1.0
        moon.regolith = 1.0
        moon.relief   = 0.0

        # fixed in the sky; the limb sits at 70.2 from straight down
        rise   : f32 [ radians[ 14.0 ] ]
        aim    : f32 [ tilt + rise ]
        e_dist : f32 [ 6.0 ]
        e_off  : vec3f [ -e_dist * sin[ aim ], 0.0, eye_dist - e_dist * cos[ aim ] ]
        # world +y is the screen's x axis here; north must follow screen up
        nx_l : f32 [ -cos[ tilt ] ]
        nz_l : f32 [  sin[ tilt ] ]
        n_x  : f32 [  co * nx_l + so * nz_l ]
        n_z  : f32 [ -so * nx_l + co * nz_l ]
        # 90 degrees about this carries the model's +y onto north
        e_axis : vec4f [ n_z, 0.0, -n_x, radians[ 90.0 ] ]
        q_axis : quatf [ e_axis ]
        # ux.time counts kiloseconds: 6000 = one turn per minute
        spin_d : f32 [ ux.time * 6000.0 ]
        e_spin : vec4f [ 0.0, 1.0, 0.0, radians[ spin_d ] ]
        q_spin : quatf [ e_spin ]
        e_sc   : vec3f [ 1.5, 1.5, 1.5 ]
        em : mat4f.identity[]
        em = em.translate[ e_off ]
        em = em.rotate   [ q_axis ]
        em = em.rotate   [ q_spin ]
        em = em.scale    [ e_sc ]
        earth.model = em
        earth.view  = _view
        earth.proj  = _proj
        ocean.model = em
        ocean.view  = _view
        ocean.proj  = _proj
        cloud.model = em
        cloud.view  = _view
        cloud.proj  = _proj

        _cam2 : vec4f [ _eye2.x, _eye2.y, _eye2.z, 1.0 ]
        moon.cam_pos  = _cam2
        earth.cam_pos = _cam2
        ocean.cam_pos = _cam2
        cloud.cam_pos = _cam2
        earth.time    = time
        ocean.time    = time
        cloud.time    = time


# gltf material colors arrive as 1x1 textures on Surface.color, so the
# steel, glass and tire parts each keep their own tone with no map.
# lit by the same sun vector the terra surface uses, or the monument
# would hold noon while the ground under it turns into night
enum GaiaSurface
    color : 0

# sky sphere: viewed from INSIDE — no lighting, just the star map
ModelViewProject GaiaShader
    mutable gain : f32

    attrib color : LayoutBinding [ type:typeid[ GaiaSurface ], id:GaiaSurface.color, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_uv      : VertexOutput  [ type:typeid[ vec2f ] ]
    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]

    func init[]
        eye2    : vec3f [0.0f, 0.0f, 0.0f]
        target2 : vec3f [0.0f, 0.0f, 1.0f]
        up2     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[70.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_uv        = a_uv;
        gl_Position = ubo.proj * ubo.view * ubo.model * vec4(a_pos, 1.0);
    }

    func g_hash31 [ p: vec3f ] -> GLSL float {
        return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);
    }

    func g_vnoise [ p: vec3f ] -> GLSL float {
        vec3 i = floor(p);
        vec3 f = fract(p);
        vec3 u = f * f * (3.0 - 2.0 * f);
        float n000 = g_hash31(i + vec3(0.0, 0.0, 0.0));
        float n100 = g_hash31(i + vec3(1.0, 0.0, 0.0));
        float n010 = g_hash31(i + vec3(0.0, 1.0, 0.0));
        float n110 = g_hash31(i + vec3(1.0, 1.0, 0.0));
        float n001 = g_hash31(i + vec3(0.0, 0.0, 1.0));
        float n101 = g_hash31(i + vec3(1.0, 0.0, 1.0));
        float n011 = g_hash31(i + vec3(0.0, 1.0, 1.0));
        float n111 = g_hash31(i + vec3(1.0, 1.0, 1.0));
        return mix(mix(mix(n000, n100, u.x), mix(n010, n110, u.x), u.y),
                   mix(mix(n001, n101, u.x), mix(n011, n111, u.x), u.y), u.z);
    }

    func fragment[] -> GLSL none {
        vec3 sky  = texture(color, v_uv).rgb;
        // galactic band: full boost at the equator, falling to the poles
        float band = 1.0 - abs(v_uv.y - 0.5) * 2.0;
        float g    = ubo.gain * mix(0.5, 2.3, smoothstep(0.0, 1.0, band));
        // violet cast: red and blue lifted over green
        vec3 tint  = vec3(1.12, 0.90, 1.32);
        // dust: a 2D slice of drifting 3D noise darkens the field.
        // value noise cells ran 1/5 of the map wide and smoothstep drew
        // their isoline as a hard diamond -- finer scales, four octaves
        // on offset domains, and a soft stretch instead of a threshold
        // six octaves, each on its own offset domain and drifting at
        // its own rate, so no two share a cell boundary. the top one
        // stops near 450 -- past that a cell is a pixel and it shimmers
        float t9 = ubo.time * 0.03;
        float d1 = g_vnoise(vec3(v_uv *  29.0, t9));
        float d2 = g_vnoise(vec3(v_uv *  61.0 + vec2( 7.0,  3.0), t9 * 1.7));
        float d3 = g_vnoise(vec3(v_uv * 127.0 + vec2(23.0, 11.0), t9 * 2.3));
        float d4 = g_vnoise(vec3(v_uv * 251.0 + vec2( 5.0, 29.0), t9 * 3.1));
        float d5 = g_vnoise(vec3(v_uv * 449.0 + vec2(31.0, 17.0), t9 * 4.3));
        float dn = 0.30 * d1 + 0.24 * d2 + 0.19 * d3
                 + 0.15 * d4 + 0.12 * d5;
        // a third of the previous bite: 0.62 took 38% out of the field,
        // this takes about 13%
        float dust = mix(1.0, 0.873, clamp((dn - 0.5) * 1.9 + 0.5, 0.0, 1.0));
        fragColor  = vec4(sky * tint * g * dust, 1.0);
    }

element MilkyWay
    frost : true
    frost_sharp : true
    # eased field of view; orbit steps zoom the gaze, not a distance
    intern e_cur  : f32
    intern p_cur  : f32
    intern gaia   : GaiaShader
    intern models : vec Model
    intern target : Render
    intern built  : bool
    # async load: worker decodes, draw waits on ready for vk work
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    # decoded by the worker; the vk objects are built on the main thread.
    # the worker fills plain members only — a collection built on the worker
    # does not survive its pool drain intact
    intern geom      : GltfModel
    intern img_color : Image
    # flat clear-color pass; the backdrop from frame one
    intern plain     : Render
    public color  : rgba [ r:0.0, g:0.0, b:0.004, a:1.0 ]

    # worker thread: file reads and pixel decodes only, never a vk call
    func load_files[]
        gltf_path : path '../scenes/models/earth.gltf'
        geom      = GltfModel.open[ gltf_path ]
        img_color = Image [ uri: path '../scenes/textures/gaia.png', surface: GaiaSurface.color ]

    # main thread: every vk object this scene owns
    func build_models[]
        built     = true
        gaia      = GaiaShader [ vk: vk ]
        gaia_samplers : map Image [string] [ 'color': img_color ]
        gaia_model : Model [ vk: vk, w: ux, id: geom, s: gaia, samplers: gaia_samplers,
            straight_alpha: true, cull_none: true ]
        models     = vec Model [] [ gaia_model ]

    # a modelless pass that just clears to the scene color, so the ux has a
    # backdrop to composite while the real one is still decoding
    func create_plain[]
        if [ plain || target ] return
        plain = Render [
            vk:          vk,
            w:           ux,
            wscale:      1.0,
            use_depth:   false,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      [] ]
        plain.owner = a
        ux.element_targets[ id ] = plain

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        # swapping the map entry is what the window reads as a new backdrop;
        # it restarts reveal at 0 and fades the loaded scene in over the flat
        ux.element_targets[ id ] = target

    # unregister only; we keep our ref so the GPU graph outlives the frame
    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    # deep space: near-black panes, starlight blues
    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#0a0a1288',   # editor pane background
            '#140a2a80':  '#418a',       # console pane background
            '#ff6a2e55':  '#8a8aa455',   # search highlight fill
            '#220022aa':  '#1e0e28aa',   # run console base fill
            '#614':       '#524a',       # TButtons / nav rest fill
            '#413':       '#524e',       # TButtons hover fill
            '#826':       '#635e',       # TButtons lit / nav selected
            '#625a':      '#5248',       # bottom status bar fill
            '#8af2':      '#99a2',       # status bar inner glow 
            '#425':       '#8164',       # editor selection color
            '#ede3':      '#a388',       # editor selection border
            '#44225588':  '#8a8aaa11',   # editor line highlight
            '#ff3a6a22':  '#8a8ad422',   # commit tab fill
            '#ff3a6a44':  '#8a8ad444',   # commit tab hover fill
            '#ff5a8a99':  '#8a9ade99',   # commit tab border
            '#ff7aa4cc':  '#a8b6ffcc'    # commit tab hover border
        ]


    func load_bg [ arg: object :: t: MilkyWay ]
        t0 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg start at {t0}'
        t.load_files[]
        t1 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg done in {t1 - t0}ms at {t1}'
        t.ready = true

    func draw [ w: Window ]
        animated = true
        create_plain[]
        if [ !loading ]
            loading = true
            w9 : vec Au []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: lambda load_bg[ a ], work: w9 ]
        if [ !ready ] return
        if [ !built ] build_models[]
        create_target[]
        orbit[]

    func orbit[]
        aspect : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]
        # orbit steps become zoom: field of view narrows from far to low
        e_t    : f32 [ (ux.orbit_mode == OrbitView.low)  ? 45.0 :
                       (ux.orbit_mode == OrbitView.high) ? 65.0 : 85.0 ]
        if [ e_cur == 0.0 ] e_cur = e_t
        e_cur = filter_n[ e_cur, e_t, 0.08, ux.frame_factor ]

        # angle steps pitch the gaze off the galactic plane
        p_t    : f32 [ (ux.angle_mode == ViewAngle.flat)   ? 0.0 :
                       (ux.angle_mode == ViewAngle.angled) ? 0.35 : 0.80 ]
        p_cur  = filter_n[ p_cur, p_t, 0.08, ux.frame_factor ]
        ux.orbit_moving = abs[ e_cur - e_t ] > 0.02 || abs[ p_cur - p_t ] > 0.001

        _eye   : vec3f [ 0.0, 0.0, 0.0 ]
        _tgt   : vec3f [ 0.0, p_cur, 1.0 ]
        _up    : vec3f [ 0.0, -1.0, 0.0 ]
        _proj  : mat4f.perspective[ radians[ e_cur ], aspect, 0.01, 20.0 ]
        _view  : mat4f.look_at    [ _eye, _tgt, _up ]

        # ux.time counts kiloseconds: a slow drift across the sky
        spin_d : f32 [ ux.time * 900.0 ]
        m_spin : vec4f [ 0.0, 1.0, 0.0, radians[ spin_d ] ]
        q_spin : quatf [ m_spin ]
        mm : mat4f.identity[]
        mm = mm.rotate[ q_spin ]

        gaia.model = mm
        gaia.view  = _view
        gaia.proj  = _proj
        gaia.gain  = 0.88
        gaia.time  = ux.time * 60000.0


enum TitanSurface
    color  : 0
    height : 1
    height2 : 2
    nrm_a  : 3
    nrm_b  : 4

# Titan to spec: 1.45 bar N2, tholin haze — orange thickening at the
# limb, detached bluish upper layer, seasonal north polar hood
ModelViewProject TitanShader
    mutable gain    : f32
    mutable cam_pos : vec4f

    attrib color : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.color, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_normal    : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_uv        : VertexOutput [ type:typeid[ vec2f ] ]
    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]

    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]

    func init[]
        eye2    : vec3f [0.0f, 0.0f, 2.5f]
        target2 : vec3f [0.0f, 0.0f, 0.0f]
        up2     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_uv        = vec2(1.0 - a_uv.x, a_uv.y);
        mat3 nm     = transpose(inverse(mat3(ubo.model)));
        v_normal    = normalize(nm * a_normal);
        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        vec3  n        = normalize(v_normal);
        // half phase: the sun sits off to the side for both bodies
        vec3  sun      = normalize(vec3(0.85, -0.10, 0.15));
        vec3  view_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        float mu       = clamp(dot(n, view_dir), 0.0, 1.0);
        float h        = 1.0 - mu;
        // surface reads at disc center, dissolving into haze mid-disc
        float alb      = texture(color, v_uv).r;
        vec3  surf     = mix(vec3(0.30, 0.17, 0.07), vec3(1.0, 0.70, 0.34), alb);
        float sread    = (1.0 - smoothstep(0.0, 0.55, h)) * 0.45;
        // haze body with the lensing bands near the limb — the
        // classic cassini butterscotch, pale and creamy; the blue
        // layer is a DARK thin rim, not a glow
        vec3  warm     = vec3(0.95, 0.78, 0.54);
        vec3  cream    = vec3(0.99, 0.90, 0.72);
        vec3  blue     = vec3(0.20, 0.28, 0.58);
        vec3  hazec    = mix(warm, cream, smoothstep(0.62, 0.84, h));
        hazec          = mix(hazec, blue, smoothstep(0.86, 0.96, h));
        // seasonal hood: haze thickens over the north pole
        float hood     = smoothstep(0.78, 0.92, 1.0 - v_uv.y) * 0.35;
        vec3  col      = mix(hazec, surf, clamp(sread - hood, 0.0, 1.0));
        // terminator crosses the disc; the haze wraps it slightly
        float wrap     = clamp(dot(n, sun) * 0.5 + 0.5, 0.0, 1.0);
        float ndl      = max(dot(n, sun), 0.0);
        // wrapped haze light plus real diffuse so the ball reads round
        float lit      = 0.55 * wrap * wrap + 0.45 * ndl;
        col           *= (0.02 + 1.10 * lit) * ubo.gain;
        // tangent path absorption dims the disc toward its edges
        col           *= (0.78 + 0.22 * mu);
        // sun side gets a faint cool cast in the upper haze
        float sunside  = clamp(dot(n, sun), 0.0, 1.0);
        col           += vec3(0.10, 0.15, 0.32) * (sunside * sunside)
                       * smoothstep(0.60, 0.94, h) * 0.35 * ubo.gain;
        // soft outer edge: exponential falloff like a real scale
        // height — opaque core, then a long asymptotic feather
        float t        = clamp((h - 0.74) / 0.23, 0.0, 1.0);
        float a        = exp(-6.0 * t * t);
        fragColor      = vec4(col, a);
    }

# the rings: a squashed sphere shaded radially from the strip
# texture — model-space xz radius IS the ring coordinate
ModelViewProject RingShader
    mutable gain    : f32
    mutable cam_pos : vec4f
    # x = the strip's inner radius over its outer, so t maps radius.
    # y = the planet's radius over that same outer, which is the
    # cylinder its shadow casts. both were saturn's numbers inline
    mutable rgeo    : vec4f

    attrib color : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.color, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_mpos      : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]

    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]

    func init[]
        eye2    : vec3f [0.0f, 0.0f, 2.5f]
        target2 : vec3f [0.0f, 0.0f, 0.0f]
        up2     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_mpos      = a_pos;
        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        // saturn: D-ring inner at 74500/140220 of the F-ring outer
        float rad = length(v_mpos.xz);
        float r0  = ubo.rgeo.x;
        float t   = (rad - r0) / (1.0 - r0);
        if (t < 0.0 || t > 1.0) { fragColor = vec4(0.0); return; }
        vec4  band = texture(color, vec2(t, 0.5));
        vec3  sun  = normalize(vec3(0.85, -0.10, 0.15));
        // the ring plane normal in world; both faces take light
        vec3  pn   = normalize((ubo.model * vec4(0.0, 1.0, 0.0, 0.0)).xyz);
        float ndl  = abs(dot(pn, sun));
        // saturn's shadow: anti-sun side, within the ball's cylinder
        vec3  ctr  = (ubo.model * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
        float rout = length((ubo.model * vec4(1.0, 0.0, 0.0, 0.0)).xyz);
        vec3  p    = v_world_pos.xyz - ctr;
        vec3  q    = p - sun * dot(p, sun);
        float rp   = ubo.rgeo.y * rout;
        float sh   = (dot(p, sun) < 0.0)
                   ? mix(0.12, 1.0, smoothstep(rp * 0.96, rp * 1.04, length(q)))
                   : 1.0;
        vec3  col  = band.rgb * (0.03 + 0.97 * ndl) * sh * ubo.gain;
        float a    = band.a * smoothstep(0.0, 0.012, t) * (1.0 - smoothstep(0.985, 1.0, t));
        fragColor  = vec4(col, a);
    }

# saturn seen from titan: side-lit to the same half phase
ModelViewProject SaturnShader
    mutable gain    : f32
    mutable cam_pos : vec4f

    attrib color  : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.color,  count:1, format: typeid[ rgba8 ] ]
    # the ring strip: its alpha at the sun-crossing radius IS the shadow
    attrib height : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.height, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_normal    : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_uv        : VertexOutput [ type:typeid[ vec2f ] ]
    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]
    attrib v_mpos      : VertexOutput [ type:typeid[ vec3f ] ]

    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]

    func init[]
        eye2    : vec3f [0.0f, 0.0f, 2.5f]
        target2 : vec3f [0.0f, 0.0f, 0.0f]
        up2     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_uv        = vec2(1.0 - a_uv.x, a_uv.y);
        v_mpos      = a_pos;
        mat3 nm     = transpose(inverse(mat3(ubo.model)));
        v_normal    = normalize(nm * a_normal);
        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        vec3  n        = normalize(v_normal);
        vec3  sun      = normalize(vec3(0.85, -0.10, 0.15));
        vec3  view_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        // ring shadow: trace this point toward the sun in MODEL space;
        // where the ray crosses the equator inside the annulus, the
        // ring strip's alpha at that radius blocks the light
        vec3  sm  = normalize(transpose(mat3(ubo.model)) * sun);
        float shad = 1.0;
        if (abs(sm.y) > 1e-4) {{
            float tr = -v_mpos.y / sm.y;
            if (tr > 0.0) {{
                vec3  q  = v_mpos + sm * tr;
                float rr = length(q.xz) / 2.325;
                float ur = (rr - 0.531) / 0.469;
                if (ur > 0.0 && ur < 1.0) {{
                    float ra = texture(height, vec2(ur, 0.5)).a;
                    shad = 1.0 - ra * 0.85;
                }}
            }}
        }}
        // zonal winds: the equatorial jet plus alternating lobes —
        // neighboring bands shear past each other like the real thing
        float la = v_uv.y - 0.5;
        float w  = 0.60 * exp(-la * la / 0.012)
                 + 0.22 * cos(la * 43.98) * exp(-abs(la) * 1.8);
        // flow ping-pong: two half-cycle phases crossfaded, so shear
        // stays bounded and the bands slide forever without smearing
        float t9 = ubo.time * 0.05;
        float p0 = fract(t9);
        float p1 = fract(t9 + 0.5);
        float s0 = w * (p0 - 0.5) * 0.16;
        float s1 = w * (p1 - 0.5) * 0.16;
        float bl = abs(2.0 * p0 - 1.0);
        // NO uniform spin here. any shift added at every latitude is
        // common motion, and the eye reads the largest common motion
        // as the whole planet turning -- it buries the shear
        vec2  bu0 = vec2(v_uv.x + s0, v_uv.y);
        vec2  bu1 = vec2(v_uv.x + s1, v_uv.y);
        vec3  alb = mix(texture(color, bu0).rgb,
                        texture(color, bu1).rgb, bl);
        // wrapped like the moon, or opposite phases read as broken
        float wr9      = clamp(dot(n, sun) * 0.5 + 0.5, 0.0, 1.0);
        float ndl      = wr9 * wr9 * shad;
        float mu       = clamp(dot(n, view_dir), 0.0, 1.0);
        vec3  col      = alb * (0.08 + 0.92 * ndl) * ubo.gain;
        // slight edge softening at this distance
        float a        = smoothstep(0.0, 0.18, mu);
        fragColor      = vec4(col, a);
    }

element Titan
    frost : true
    frost_sharp : true
    # eased camera distance / angle; p_set marks the first frame
    intern e_cur  : f32
    intern p_cur  : f32
    intern p_set  : bool
    intern titan  : TitanShader
    intern saturn : SaturnShader
    intern rings  : RingShader
    intern models : vec Model
    intern target : Render
    intern built  : bool
    # async load: worker decodes, draw waits on ready for vk work
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    public color  : rgba [ r:0.004, g:0.003, b:0.006, a:1.0 ]

    func build_models[]
        built     = true
        gltf_path : path '../scenes/models/earth.gltf'
        gltf      : GltfModel.open[ gltf_path ]
        titan     = TitanShader [ vk: vk ]
        t_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/titan-color.png', surface: TitanSurface.color ]
        ]
        titan_model : Model [ vk: vk, w: ux, id: gltf, s: titan, samplers: t_samplers, straight_alpha: true ]
        saturn    = SaturnShader [ vk: vk ]
        s_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/saturn-color.png', surface: TitanSurface.color,
                wrap_u: true ],
            'height': Image [ uri: path '../scenes/textures/saturn-ring-alpha.png', surface: TitanSurface.height ]
        ]
        saturn_model : Model [ vk: vk, w: ux, id: gltf, s: saturn, samplers: s_samplers, straight_alpha: true ]
        rings     = RingShader [ vk: vk ]
        r_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/saturn-ring-alpha.png', surface: TitanSurface.color ]
        ]
        ring_model : Model [ vk: vk, w: ux, id: gltf, s: rings, samplers: r_samplers,
            straight_alpha: true ]
        models = vec Model [] [saturn_model, ring_model, titan_model ]

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        ux.element_targets[ id ] = target

    # unregister only; we keep our ref so the GPU graph outlives the frame
    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    # tholin sky: the ui goes deep amber-brown under the haze
    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#432a',       # editor pane background
            '#140a2a80':  '#148a',       # console pane background
            '#ff6a2e55':  '#ffb04a55',   # search highlight fill
            '#220022aa':  '#1e1206aa',   # run console base fill
            '#614':       '#4c3210',     # TButtons / nav rest fill
            '#413':       '#38240c',     # TButtons hover fill
            '#826':       '#6e4a18',     # TButtons lit / nav selected
            '#625a':      '#5428',       # bottom status bar fill
            '#8af2':      '#fc82',       # status bar inner glow
            '#425':       '#18a8',     # editor selection color
            '#ede3':      '#fc93',       # editor selection border
            '#44225588':  '#18a4',    # editor line highlight
            '#ff3a6a22':  '#ffb04a22',   # commit tab fill
            '#ff3a6a44':  '#ffb04a44',   # commit tab hover fill
            '#ff5a8a99':  '#ffb85a99',   # commit tab border
            '#ff7aa4cc':  '#ffd08acc'    # commit tab hover border
        ]

    func load_bg [ arg: object :: t: Titan ]
        t0 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg start at {t0}'
        t.build_models[]
        t1 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg done in {t1 - t0}ms at {t1}'
        t.ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : vec Au []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: lambda load_bg[ a ], work: w9 ]
        if [ !ready ] return
        create_target[]
        orbit[]

    func orbit[]
        aspect : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]
        # pulled back: titan reads small with saturn owning the sky
        e_t    : f32 [ (ux.orbit_mode == OrbitView.low)  ? 2.60 :
                       (ux.orbit_mode == OrbitView.high) ? 3.40 : 4.60 ]
        if [ e_cur == 0.0 ] e_cur = e_t
        e_cur = filter_n[ e_cur, e_t, 0.08, ux.frame_factor ]

        p_t    : f32 [ (ux.angle_mode == ViewAngle.flat)   ? 0.0 :
                       (ux.angle_mode == ViewAngle.angled) ? 0.156 : 0.480 ]
        if [ p_cur == 0.0 && p_t != 0.0 && !p_set ] p_cur = p_t
        p_set  = true
        p_cur  = filter_n[ p_cur, p_t, 0.08, ux.frame_factor ]

        ux.orbit_moving = abs[ e_cur - e_t ] > 0.002 || abs[ p_cur - p_t ] > 0.001
        e_d    : f32 [ e_cur ]
        _eye   : vec3f [ 0.0,  e_d * p_cur, e_d ]
        _tgt   : vec3f [ 0.0,  0.0,  0.0  ]
        _up    : vec3f [ 0.0, -1.0,  0.0  ]

        _proj  : mat4f.perspective[ radians[ 60.0 ], aspect, 0.01, 60.0 ]
        _view  : mat4f.look_at    [ _eye, _tgt, _up ]

        # Titan turns once per 15.9 days — a gentle drift here
        spin_d : f32 [ ux.time * 2400.0 ]
        m_spin : vec4f [ 0.0, 1.0, 0.0, radians[ spin_d ] ]
        q_spin : quatf [ m_spin ]
        mm : mat4f.identity[]
        mm = mm.rotate[ q_spin ]

        titan.model   = mm
        titan.view    = _view
        titan.proj    = _proj
        titan.gain    = 1.15
        titan.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]

        # Saturn hangs huge in the sky, up and left, tidally fixed
        s_off  : vec3f [ -8.0, -4.5, -20.0 ]
        s_sc   : vec3f [ 10.5, 10.5, 10.5 ]
        s_axis : vec4f [ 0.0, 0.0, 1.0, radians[ 26.7 ] ]
        sq     : quatf [ s_axis ]
        # tip the whole assembly toward the viewer: the ring plane
        # opens into an ellipse instead of slicing the scene edge-on
        s_tip  : vec4f [ 1.0, 0.0, 0.0, radians[ 20.0 ] ]
        sq3    : quatf [ s_tip ]
        s_spin : vec4f [ 0.0, 1.0, 0.0, radians[ ux.time * 9000.0 ] ]
        sq2    : quatf [ s_spin ]
        sm : mat4f.identity[]
        sm = sm.translate[ s_off ]
        sm = sm.rotate   [ sq3 ]
        sm = sm.rotate   [ sq ]
        sm = sm.rotate   [ sq2 ]
        sm = sm.scale    [ s_sc ]
        saturn.model    = sm
        saturn.view     = _view
        saturn.proj     = _proj
        saturn.gain     = 1.9
        saturn.cam_pos  = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        saturn.time     = ux.time * 60000.0

        # rings share saturn's frame: F-ring outer = 2.325x the ball
        r_sc : vec3f [ 24.4, 0.02, 24.4 ]
        rm : mat4f.identity[]
        rm = rm.translate[ s_off ]
        rm = rm.rotate   [ sq3 ]
        rm = rm.rotate   [ sq ]
        rm = rm.scale    [ r_sc ]
        rings.model   = rm
        rings.view    = _view
        rings.proj    = _proj
        rings.gain    = 1.9
        rings.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        # SATURN'S OWN, the two numbers that were inline in the
        # shader: D-ring inner 74500 over F-ring outer 140220, and
        # the ball's 60268 over that same outer
        rings.rgeo    = vec4f [ 0.531, 0.430, 0.0, 0.0 ]


# enceladus geysers: procedural jets fanning off the south cone
# into a soft veil — a shell around the moon, nothing textured
ModelViewProject PlumeShader
    mutable gain    : f32
    mutable cam_pos : vec4f

    attrib color : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.color, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_mpos      : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]

    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]

    func init[]
        eye2    : vec3f [0.0f, 0.0f, 2.5f]
        target2 : vec3f [0.0f, 0.0f, 0.0f]
        up2     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_mpos      = a_pos;
        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func p_perm4 [ x: vec4f ] -> GLSL vec4f {
        return mod((x * 34.0 + 1.0) * x, vec4(289.0));
    }

    func p_isqrt4 [ r: vec4f ] -> GLSL vec4f {
        return 1.79284291400159 - 0.85373472095314 * r;
    }

    func p_gnoise [ P: vec3f ] -> GLSL float {
        vec3 Pi0 = mod(floor(P), vec3(289.0));
        vec3 Pi1 = mod(Pi0 + vec3(1.0), vec3(289.0));
        vec3 Pf0 = fract(P);
        vec3 Pf1 = Pf0 - vec3(1.0);
        vec4 ix  = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
        vec4 iy  = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
        vec4 iz0 = vec4(Pi0.z);
        vec4 iz1 = vec4(Pi1.z);
        vec4 ixy  = p_perm4(p_perm4(ix) + iy);
        vec4 ixy0 = p_perm4(ixy + iz0);
        vec4 ixy1 = p_perm4(ixy + iz1);
        vec4 gx0 = fract(ixy0 / 7.0) * 2.0 - 1.0;
        vec4 gy0 = fract(floor(ixy0 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz0 = 1.0 - abs(gx0) - abs(gy0);
        vec4 gx1 = fract(ixy1 / 7.0) * 2.0 - 1.0;
        vec4 gy1 = fract(floor(ixy1 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz1 = 1.0 - abs(gx1) - abs(gy1);
        vec4 sz0 = step(gz0, vec4(0.0));
        gx0 -= sz0 * (step(0.0, gx0) - 0.5);
        gy0 -= sz0 * (step(0.0, gy0) - 0.5);
        vec4 sz1 = step(gz1, vec4(0.0));
        gx1 -= sz1 * (step(0.0, gx1) - 0.5);
        gy1 -= sz1 * (step(0.0, gy1) - 0.5);
        vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
        vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
        vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
        vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
        vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
        vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
        vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
        vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);
        vec4 nm0 = p_isqrt4(vec4(dot(g000,g000), dot(g010,g010), dot(g100,g100), dot(g110,g110)));
        g000 *= nm0.x; g010 *= nm0.y; g100 *= nm0.z; g110 *= nm0.w;
        vec4 nm1 = p_isqrt4(vec4(dot(g001,g001), dot(g011,g011), dot(g101,g101), dot(g111,g111)));
        g001 *= nm1.x; g011 *= nm1.y; g101 *= nm1.z; g111 *= nm1.w;
        float n000 = dot(g000, Pf0);
        float n100 = dot(g100, vec3(Pf1.x, Pf0.y, Pf0.z));
        float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
        float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
        float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
        float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
        float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
        float n111 = dot(g111, Pf1);
        vec3  fxyz = Pf0 * Pf0 * Pf0 * (Pf0 * (Pf0 * 6.0 - 15.0) + 10.0);
        vec4  n_z  = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fxyz.z);
        vec2  n_yz = mix(n_z.xy, n_z.zw, fxyz.y);
        return mix(n_yz.x, n_yz.y, fxyz.x) * 0.5 + 0.5;
    }

    # the surface's province field, verbatim — a vent only ignites in
    # the darkest terrain, so placement is seeded by the image
    func vent_weight [ pm: vec3f ] -> GLSL float {
        float pv = p_gnoise(pm * 2.2 + vec3(5.0, 11.0, 3.0));
        return 1.0 - smoothstep(0.30, 0.70, pv);
    }

    func fragment[] -> GLSL none {
        // ray march through a field of vent cones: the quad is only
        // screen coverage — the columns are computed in 3d along the
        // view ray, so they stand in space and occlude correctly
        // 4 vent clusters spread over the whole ball, 3 sources each;
        // every jet fires along its surface normal — nearby cluster
        // members diverge like a fan by geometry alone: the streaks
        // a forest: 8 skewed fissure clusters over the whole ball —
        // a ray through the planet's vicinity threads several jets
        const float AZ[48]   = float[](0.38, 0.52, 0.63,  1.24, 1.31, 1.35,  2.16, 2.21, 2.24,  2.94, 3.05, 3.13,
                                       3.78, 3.91, 4.02,  4.62, 4.68, 4.77,  5.40, 5.52, 5.60,  6.02, 6.10, 6.14,
                                       0.90, 1.70, 2.60, 3.40, 4.30, 5.00, 5.90, 0.10,
                                       1.68, 1.76, 1.83,  3.29, 3.36, 3.41,  4.08, 4.16, 4.24,  5.79, 5.86, 5.92,
                                       0.65, 2.50, 3.60, 5.15);
        const float LAT[48]  = float[](0.545, 0.585, 0.610,  -0.88, -0.82, -0.76,  -0.30, -0.19, -0.09,  0.86, 0.91, 0.98,
                                       0.10, 0.17, 0.26,  -1.18, -1.12, -1.08,  -0.64, -0.72, -0.76,  0.30, 0.37, 0.41,
                                       -0.45, 0.72, 0.45, -1.00, 0.62, -0.05, 0.95, -0.52,
                                       0.34, 0.42, 0.47,  -0.58, -0.50, -0.45,  0.60, 0.68, 0.72,  -0.34, -0.26, -0.21,
                                       -0.15, 0.78, 1.05, -0.95);
        vec3 e_p0[48];
        for (int i = 0; i < 48; i++) {{
            float cl = cos(LAT[i]);
            e_p0[i] = vec3(cl * sin(AZ[i]), sin(LAT[i]), cl * cos(AZ[i]));
        }}
        vec3  ro  = ubo.cam_pos.xyz;
        vec3  rd  = normalize(v_world_pos.xyz - ro);
        // one shell layer only: inside we see its far side, outside
        // its near side — the guard stops the outside double-count
        if (dot(ro, ro) >= 1.69 && !gl_FrontFacing) { fragColor = vec4(0.0); return; }
        // the moon blocks the march past its surface
        float b     = dot(ro, rd);
        float c     = dot(ro, ro) - 1.0;
        float dsc   = b * b - c;
        float s_hit = (dsc > 0.0) ? (-b - sqrt(dsc)) : 1e9;
        if (s_hit < 0.0) s_hit = 1e9;
        // march the segment crossing the plume bounding sphere
        // small jets (~1/8 former scale): stepping under-samples them,
        // so each contributes its ANALYTIC ray integral at closest
        // approach — the ray walks the 3d emitter list exactly
        float sumc = 0.0;
        float sumh = 0.0;
        for (int i = 0; i < 48; i++) {{
            vec3  p0 = e_p0[i];
            vec3  w0 = ro - p0;
            float aa = dot(rd, p0);
            float d0 = dot(rd, w0);
            float d1 = dot(p0, w0);
            float dn = max(1.0 - aa * aa, 1e-4);
            float s9 = (aa * d1 - d0) / dn;
            float t9 = (d1 - aa * d0) / dn;
            if (s9 < 0.02) continue;
            // soft occlusion at the limb — nothing pops binary
            float occ = 1.0 - smoothstep(s_hit - 0.10, s_hit + 0.10, s9);
            if (occ <= 0.0) continue;
            float tt  = max(t9, 0.0);
            // soft emergence at the vent, pure attenuation outward —
            // no end cut: the exp IS the ending
            float env = smoothstep(-0.015, 0.025, t9) * exp(-9.0 * tt);
            vec3  qp = w0 + s9 * rd - t9 * p0;
            float d2 = dot(qp, qp);
            // a real cone: the plume flares open as it rises
            float sg = 0.008 + 0.10 * tt;
            float gc = exp(-d2 / (sg * sg));
            float gh = 0.15 * exp(-d2 / (9.0 * sg * sg));
            float boost = 1.0 / sqrt(max(dn, 0.20));
            // emission rides a 3d perlin field: each frame renders a
            // moving cross-section — advected along the axis it ROLLS
            // continuous modulation: |qp| never flips across the axis
            // (the vector form did — hard wedge edges), the seed rides
            // the source position, and time evolves the slice
            float rq = length(qp);
            float sd = dot(p0, vec3(37.7, 17.3, 29.1));
            vec3  sp = vec3(rq * 30.0, sd, ubo.time * 0.15);
            float n1 = p_gnoise(sp);
            // azimuthal desync, faded to zero at the axis where the
            // qp direction flips — continuous everywhere, async around
            vec3  sq = qp * 24.0 + vec3(sd, ubo.time * 0.13, 0.0);
            float n2 = p_gnoise(sq);
            float aw = smoothstep(0.0, sg * 1.2, rq);
            float nn = mix(n1, 0.45 * n1 + 0.55 * n2, aw);
            float m  = 0.45 + 1.10 * (nn * nn * (3.0 - 2.0 * nn));
            // fingers: the azimuthal perlin sharpened hard at the
            // source, dissolving to a smooth column by half height
            float fing = pow(clamp(n2, 0.0, 1.0), 3.0);
            float fw   = exp(-4.6 * tt) * aw;
            m *= mix(1.0, 0.20 + 2.4 * fing, fw);
            // seeded by the surface: dark provinces erupt, bright ice
            // stays quiet — placement emerges from the image field
            float vw = vent_weight(p0);
            float w9 = env * boost * occ * m * 0.30 * (0.22 + 0.78 * vw * vw);
            sumc += gc * w9;
            sumh += gh * w9;
        }}
        // soft horizon: a whisper-thin exponential atmosphere at the
        // ray's closest approach — the lens hugs the limb tight
        float tca = 0.0 - dot(ro, rd);
        if (tca > 0.0) {{
            vec3  pca  = ro + rd * tca;
            float rc   = length(pca);
            // outward: a long slow fade into space — the rim breathes
            float od   = exp(-max(rc - 1.0, 0.0) / 0.014) * smoothstep(0.930, 0.995, rc);
            // smooth occlusion: the binary cut stamped the analytic
            // sphere's silhouette as a dark circle over the terrain
            float dip  = clamp((1.0 - rc) / 0.018, 0.0, 1.0);
            float hocc = mix(1.0, 0.35, dip);
            vec3  sunh = normalize(vec3(0.85, -0.10, 0.15));
            float hw   = clamp(dot(pca / max(rc, 1e-4), sunh) * 0.5 + 0.5, 0.0, 1.0);
            // blaze where the graze kisses the surface: the light
            // itself dissolves the terrain edge
            // asymmetric on purpose: wide going out into space, tight
            // going in, or the rim glow lies over the terrain as fog
            float nearg = exp(-(max(rc - 1.0, 0.0) / 0.020
                              + max(1.0 - rc, 0.0) / 0.0035));
            sumc += od * hocc * (0.10 + 0.40 * hw) * (1.0 + 2.5 * nearg);
        }}
        // pale ice spine wrapped in rich blue breadth
        float tot = sumc + sumh;
        vec3  icy = (vec3(0.85, 0.92, 1.0) * sumc + vec3(0.30, 0.50, 1.0) * sumh)
                  / max(tot, 1e-5);
        fragColor = vec4(icy, clamp(tot * ubo.gain, 0.0, 0.9));
    }

# the icy surface with the vent field casting light onto it —
# emitter positions mirror PlumeShader's list exactly
ModelViewProject EnceladusShader
    mutable gain    : f32
    mutable cam_pos : vec4f
    # real geometry displacement, in sphere radii
    mutable displace : f32

    attrib height  : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.height,  count:1, format: typeid[ rgba8 ] ]
    attrib detail2 : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.height2, count:1, format: typeid[ rgba8 ] ]
    # baked offline from the two height maps: RG = normal xy, B = cavity
    attrib nrmA    : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.nrm_a,   count:1, format: typeid[ rgba8 ] ]
    attrib nrmB    : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.nrm_b,   count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_normal    : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_uv        : VertexOutput [ type:typeid[ vec2f ] ]
    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]

    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]
    # object-space point, so the noise stays pinned as the moon turns
    attrib v_sp        : VertexOutput [ type:typeid[ vec3f ] ]
    # the displacement height, carried down so the fragment never has
    # to sample the map itself -- that is what shattered into speckle
    attrib v_h         : VertexOutput [ type:typeid[ f32 ] ]

    func e_perm4 [ x: vec4f ] -> GLSL vec4f {
        return mod((x * 34.0 + 1.0) * x, vec4(289.0));
    }

    func e_isqrt4 [ r: vec4f ] -> GLSL vec4f {
        return 1.79284291400159 - 0.85373472095314 * r;
    }

    # gradient noise: zero at every lattice point, so nothing it drives
    # lines up with the grid the way value noise does
    func e_gnoise [ P: vec3f ] -> GLSL float {
        vec3 Pi0 = mod(floor(P), vec3(289.0));
        vec3 Pi1 = mod(Pi0 + vec3(1.0), vec3(289.0));
        vec3 Pf0 = fract(P);
        vec3 Pf1 = Pf0 - vec3(1.0);
        vec4 ix  = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
        vec4 iy  = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
        vec4 iz0 = vec4(Pi0.z);
        vec4 iz1 = vec4(Pi1.z);
        vec4 ixy  = e_perm4(e_perm4(ix) + iy);
        vec4 ixy0 = e_perm4(ixy + iz0);
        vec4 ixy1 = e_perm4(ixy + iz1);
        vec4 gx0 = fract(ixy0 / 7.0) * 2.0 - 1.0;
        vec4 gy0 = fract(floor(ixy0 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz0 = 1.0 - abs(gx0) - abs(gy0);
        vec4 gx1 = fract(ixy1 / 7.0) * 2.0 - 1.0;
        vec4 gy1 = fract(floor(ixy1 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz1 = 1.0 - abs(gx1) - abs(gy1);
        vec4 sz0 = step(gz0, vec4(0.0));
        gx0 -= sz0 * (step(0.0, gx0) - 0.5);
        gy0 -= sz0 * (step(0.0, gy0) - 0.5);
        vec4 sz1 = step(gz1, vec4(0.0));
        gx1 -= sz1 * (step(0.0, gx1) - 0.5);
        gy1 -= sz1 * (step(0.0, gy1) - 0.5);
        vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
        vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
        vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
        vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
        vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
        vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
        vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
        vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);
        vec4 nm0 = e_isqrt4(vec4(dot(g000,g000), dot(g010,g010), dot(g100,g100), dot(g110,g110)));
        g000 *= nm0.x; g010 *= nm0.y; g100 *= nm0.z; g110 *= nm0.w;
        vec4 nm1 = e_isqrt4(vec4(dot(g001,g001), dot(g011,g011), dot(g101,g101), dot(g111,g111)));
        g001 *= nm1.x; g011 *= nm1.y; g101 *= nm1.z; g111 *= nm1.w;
        float n000 = dot(g000, Pf0);
        float n100 = dot(g100, vec3(Pf1.x, Pf0.y, Pf0.z));
        float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
        float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
        float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
        float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
        float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
        float n111 = dot(g111, Pf1);
        vec3  fxyz = Pf0 * Pf0 * Pf0 * (Pf0 * (Pf0 * 6.0 - 15.0) + 10.0);
        vec4  n_z  = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fxyz.z);
        vec2  n_yz = mix(n_z.xy, n_z.zw, fxyz.y);
        return mix(n_yz.x, n_yz.y, fxyz.x) * 0.5 + 0.5;
    }

    # the map patched in at three scales on offset domains, mixed by a
    # large perlin. ONE straight equirect lookup pinches at the pole and
    # reads as hair; this stops any single scale carrying the surface
    func h_patch [ uv: vec2f, sp: vec3f ] -> GLSL float {
        float w1 = e_gnoise(sp * 1.30);
        float w2 = e_gnoise(sp * 2.70 + vec3(19.0, 7.0, 41.0));
        // TWO different maps, each turned to its own angle and scale,
        // so neither one's grain lines up with the other or with the
        // equirect grid. the perlin picks which one owns each region
        float c1 = cos(0.70);  float s1 = sin(0.70);
        float c2 = cos(2.30);  float s2 = sin(2.30);
        // meridian mirror-blend: the u-wrap lands mid-tile under
        // these rotations — evaluate a half-turn clone and
        // interpolate across the seam band
        float sd  = min(uv.x, 1.0 - uv.x);
        float sk  = smoothstep(0.0, 0.06, sd);
        vec2  uvb = vec2(fract(uv.x + 0.5), uv.y);
        vec2  ua  = mat2(c1, s1, -s1, c1) * uv  * 1.60 + vec2(0.13, 0.41);
        vec2  ub  = mat2(c2, s2, -s2, c2) * uv  * 3.10 + vec2(0.61, 0.07);
        vec2  ua2 = mat2(c1, s1, -s1, c1) * uvb * 1.60 + vec2(0.13, 0.41);
        vec2  ub2 = mat2(c2, s2, -s2, c2) * uvb * 3.10 + vec2(0.61, 0.07);
        float a  = mix(textureLod(height,  ua2, 0.0).r, textureLod(height,  ua, 0.0).r, sk);
        float b  = mix(textureLod(detail2, ub2, 0.0).r, textureLod(detail2, ub, 0.0).r, sk);
        return mix(a, b, smoothstep(0.30, 0.70, w1)) * (0.85 + 0.30 * w2);
    }

    func init[]
        eye2    : vec3f [0.0f, 0.0f, 2.5f]
        target2 : vec3f [0.0f, 0.0f, 0.0f]
        up2     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_uv        = vec2(1.0 - a_uv.x, a_uv.y);
        v_sp        = normalize(a_pos);
        mat3 nm     = transpose(inverse(mat3(ubo.model)));
        v_normal    = normalize(nm * a_normal);
        // displace the SPHERE. the surface was a perfect ball before,
        // with all its relief faked by a normal tilt -- which is what
        // painted the hairline black and white over it
        float hv    = h_patch(v_uv, v_sp);
        v_h         = hv;
        vec3  disp  = a_pos + a_normal * (hv - 0.5) * ubo.displace;
        vec4 wpos   = ubo.model * vec4(disp, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        const float AZ[48]   = float[](0.38, 0.52, 0.63,  1.24, 1.31, 1.35,  2.16, 2.21, 2.24,  2.94, 3.05, 3.13,
                                       3.78, 3.91, 4.02,  4.62, 4.68, 4.77,  5.40, 5.52, 5.60,  6.02, 6.10, 6.14,
                                       0.90, 1.70, 2.60, 3.40, 4.30, 5.00, 5.90, 0.10,
                                       1.68, 1.76, 1.83,  3.29, 3.36, 3.41,  4.08, 4.16, 4.24,  5.79, 5.86, 5.92,
                                       0.65, 2.50, 3.60, 5.15);
        const float LAT[48]  = float[](0.545, 0.585, 0.610,  -0.88, -0.82, -0.76,  -0.30, -0.19, -0.09,  0.86, 0.91, 0.98,
                                       0.10, 0.17, 0.26,  -1.18, -1.12, -1.08,  -0.64, -0.72, -0.76,  0.30, 0.37, 0.41,
                                       -0.45, 0.72, 0.45, -1.00, 0.62, -0.05, 0.95, -0.52,
                                       0.34, 0.42, 0.47,  -0.58, -0.50, -0.45,  0.60, 0.68, 0.72,  -0.34, -0.26, -0.21,
                                       -0.15, 0.78, 1.05, -0.95);
        vec3  n        = normalize(v_normal);
        vec3  sun      = normalize(vec3(0.85, -0.10, 0.15));
        vec3  view_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        float dist9 = length(ubo.cam_pos.xyz - v_world_pos.xyz);

        // baked normal + cavity sampled with REAL mips (lod-0 is what
        // speckled), through the same patch transforms as the mesh so
        // shading always agrees with the displacement
        float w1 = e_gnoise(v_sp * 1.30);
        float c1 = cos(0.70);  float s1 = sin(0.70);
        float c2 = cos(2.30);  float s2 = sin(2.30);
        // same meridian mirror-blend as the mesh displacement
        float sd  = min(v_uv.x, 1.0 - v_uv.x);
        float sk  = smoothstep(0.0, 0.06, sd);
        vec2  uvb = vec2(fract(v_uv.x + 0.5), v_uv.y);
        vec2  ua  = mat2(c1, s1, -s1, c1) * v_uv * 1.60 + vec2(0.13, 0.41);
        vec2  ub  = mat2(c2, s2, -s2, c2) * v_uv * 3.10 + vec2(0.61, 0.07);
        vec2  ua2 = mat2(c1, s1, -s1, c1) * uvb  * 1.60 + vec2(0.13, 0.41);
        vec2  ub2 = mat2(c2, s2, -s2, c2) * uvb  * 3.10 + vec2(0.61, 0.07);
        vec4  pa = mix(texture(nrmA, ua2), texture(nrmA, ua), sk);
        vec4  pb = mix(texture(nrmB, ub2), texture(nrmB, ub), sk);
        float wA = smoothstep(0.30, 0.70, w1);
        vec2  nxy = mix(pa.rg, pb.rg, wA) * 2.0 - 1.0;
        float cav = mix(pa.b, pb.b, wA);
        float dfade = 1.0 - smoothstep(0.9, 2.6, dist9);
        if (dfade > 0.0) {{
            vec3 t_e = normalize(cross(vec3(0.0, 1.0, 0.0), n));
            vec3 t_n = cross(n, t_e);
            n = normalize(n + (t_e * nxy.x + t_n * nxy.y) * 2.0 * dfade);
        }}

        // AO: the broad height term plus the baked cavity darkening
        // scar field: proximity to ACTIVE vents (same seeding as the
        // plume), driving the local deep-crack brushing
        float scar9 = 0.0;
        for (int i = 0; i < 48; i++) {{
            float cl = cos(LAT[i]);
            vec3  p0 = vec3(cl * sin(AZ[i]), sin(LAT[i]), cl * cos(AZ[i]));
            float pv0 = e_gnoise(p0 * 2.2 + vec3(5.0, 11.0, 3.0));
            float vw0 = 1.0 - smoothstep(0.30, 0.70, pv0);
            vec3  dv0 = v_world_pos.xyz - p0;
            scar9 += exp(-dot(dv0, dv0) / 0.045) * (0.10 + 0.90 * vw0 * vw0);
        }}
        scar9 = clamp(scar9, 0.0, 1.0);
        // perlin-brushed deep cracks: the cavity source re-sampled
        // tighter and rotated, patched in organically by the brush —
        // floored so every emitting site visibly scars
        float br  = e_gnoise(v_sp * 9.0 + vec3(2.0, 17.0, 8.0));
        float brm = (0.35 + 0.65 * smoothstep(0.35, 0.75, br)) * scar9;
        float cav2 = mix(texture(nrmA, ua2 * 3.7 + vec2(0.37, 0.71)).b,
                         texture(nrmA, ua  * 3.7 + vec2(0.37, 0.71)).b, sk);
        float ao = (0.88 + 0.12 * clamp(v_h, 0.0, 1.0)) * (1.0 - cav * 0.50 * dfade);
        // base scar darkening plus crack accents: the cavity channel
        // is sparse (mean 0.15), so gating everything on it hid it all
        ao *= 1.0 - (0.28 + cav2 * 0.55) * brm;
        // darker body: ridges pop against it and the cuts run deep
        vec3  alb = mix(vec3(0.62, 0.66, 0.75), vec3(0.88, 0.90, 0.96),
                        clamp(v_h, 0.0, 1.0));
        alb = mix(alb, vec3(0.38, 0.48, 0.72), cav * 0.70 * dfade);
        // large perlin provinces: broad dark terrain regions, not one
        // uniform reflecting white — plus general contrast stretch
        float pv = e_gnoise(v_sp * 2.2 + vec3(5.0, 11.0, 3.0));
        alb *= 0.60 + 0.50 * smoothstep(0.25, 0.75, pv);
        // the scarred ice around live vents runs deep glacial blue
        alb = mix(alb, vec3(0.30, 0.42, 0.64), (0.30 + cav2 * 0.55) * brm);
        // wrapped light: the night side dims, never goes void.
        // squaring wr crushed the mids, and a 0.06 floor sent anything
        // angled to black -- on the most reflective body in the system
        // SAME response curve as saturn: equal geometry must show
        // equal phase, or a full moon sits under a new saturn
        float wr       = clamp(dot(n, sun) * 0.5 + 0.5, 0.0, 1.0);
        float lit      = wr * wr;
        // silhouette alpha rides the SMOOTH geometric normal — the
        // detail tilt drove it negative in patches and punched holes
        float mu       = clamp(dot(normalize(v_normal), view_dir), 0.0, 1.0);
        // night sweep: the dark side goes truly dark, and the deep
        // ice answers — the ao/texture field becomes the light source
        float night = 1.0 - smoothstep(0.10, 0.50, wr);
        float amb   = mix(0.26, 0.02, night);
        vec3  col   = alb * ao * (amb + 0.74 * lit) * ubo.gain;
        // coverage tiers: ~5% of the surface glows at full strength,
        // ~25% at an eighth, the rest stays dark ice
        float gm    = e_gnoise(v_sp * 3.4 + vec3(7.0, 3.0, 23.0));
        float gmask = 0.125 * smoothstep(0.50, 0.56, gm)
                    + 0.875 * smoothstep(0.70, 0.78, gm);
        // FAINT: thin ice glowing from beneath — only the deepest
        // hollows, and only a glimmer, against a truly dark night
        float sink = smoothstep(0.55, 0.95, clamp((0.5 - v_h) * 2.0, 0.0, 1.0));
        vec3  iceglow = vec3(0.20, 0.45, 0.85) * sink * night * gmask;
        col += iceglow * 0.18 * ubo.gain;
        // fresnel ice light: the terrain limb keeps a soft lift
        float fr = pow(1.0 - mu, 4.0);
        col += vec3(0.70, 0.82, 1.00) * fr * (0.12 + 0.35 * lit) * ubo.gain;
        // the outermost fragments — normals turned toward space —
        // darken away, handing the silhouette to the horizon light
        col *= 0.30 + 0.70 * smoothstep(0.0, 0.12, mu);
        // the vents glow onto the ice around them, night side included
        float gl9 = 0.0;
        for (int i = 0; i < 48; i++) {{
            float cl = cos(LAT[i]);
            vec3  p0 = vec3(cl * sin(AZ[i]), sin(LAT[i]), cl * cos(AZ[i]));
            // same seeding as the plume: quiet vents cast no glow
            float pv = e_gnoise(p0 * 2.2 + vec3(5.0, 11.0, 3.0));
            float vw = 1.0 - smoothstep(0.30, 0.70, pv);
            vec3  dv = v_world_pos.xyz - p0;
            gl9 += exp(-dot(dv, dv) / 0.0064) * (0.15 + 0.85 * vw * vw);
        }}
        col += vec3(0.55, 0.70, 0.95) * gl9 * 0.55;
        // opaque to the edge: the marched horizon owns the softness —
        // an alpha fade here reads as a dark ring against space
        fragColor = vec4(col, 1.0);
    }

element Enceladus
    frost : true
    frost_sharp : true
    intern e_cur  : f32
    intern p_cur  : f32
    intern p_set  : bool
    intern enc    : EnceladusShader
    intern sky    : GaiaShader
    intern plume  : PlumeShader
    intern saturn : SaturnShader
    intern rings  : RingShader
    intern models : vec Model
    intern target : Render
    intern built  : bool
    # async load: worker decodes, draw waits on ready for vk work
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    public color  : rgba [ r:0.002, g:0.003, b:0.006, a:1.0 ]

    func build_models[]
        built     = true
        gltf_path : path '../scenes/models/earth.gltf'
        gltf      : GltfModel.open[ gltf_path ]
        enc       = EnceladusShader [ vk: vk ]
        e_samplers : map Image [string] [
            'height': Image [ uri: path '../scenes/textures/enceladus-detail.png', surface: TitanSurface.height,
                wrap_u: true, wrap_v: true ],
            # a second, unrelated map so the surface is not one grain
            'height2': Image [ uri: path '../scenes/textures/moon-displace-2048x1024.png', surface: TitanSurface.height2,
                wrap_u: true, wrap_v: true ],
            'nrm_a': Image [ uri: path '../scenes/textures/enceladus-na.png', surface: TitanSurface.nrm_a,
                wrap_u: true, wrap_v: true ],
            'nrm_b': Image [ uri: path '../scenes/textures/enceladus-nb.png', surface: TitanSurface.nrm_b,
                wrap_u: true, wrap_v: true ]
        ]
        enc_model : Model [ vk: vk, w: ux, id: gltf, s: enc, samplers: e_samplers, straight_alpha: true ]
        plume     = PlumeShader [ vk: vk ]
        p_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/enceladus-color.png', surface: TitanSurface.color ]
        ]
        plume_model : Model [ vk: vk, w: ux, id: gltf, s: plume, samplers: p_samplers,
            straight_alpha: true, cull_none: true, depth_no_test: true ]
        saturn    = SaturnShader [ vk: vk ]
        s_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/saturn-color.png', surface: TitanSurface.color,
                wrap_u: true ],
            'height': Image [ uri: path '../scenes/textures/saturn-ring-alpha.png', surface: TitanSurface.height ]
        ]
        saturn_model : Model [ vk: vk, w: ux, id: gltf, s: saturn, samplers: s_samplers, straight_alpha: true ]
        rings     = RingShader [ vk: vk ]
        r_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/saturn-ring-alpha.png', surface: TitanSurface.color ]
        ]
        ring_model : Model [ vk: vk, w: ux, id: gltf, s: rings, samplers: r_samplers,
            straight_alpha: true ]
        sky       = GaiaShader [ vk: vk ]
        sky_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/gaia.png', surface: GaiaSurface.color ]
        ]
        sky_model : Model [ vk: vk, w: ux, id: gltf, s: sky, samplers: sky_samplers,
            straight_alpha: true, cull_none: true ]
        models = vec Model [] [sky_model, saturn_model, ring_model, enc_model, plume_model ]

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        ux.element_targets[ id ] = target

    # unregister only; we keep our ref so the GPU graph outlives the frame
    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    # ice light: pale cold panes, glacier blue accents
    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#000a',   # editor pane background
            '#140a2a80':  '#0e141a80',   # console pane background
            '#ff6a2e55':  '#7ac8e855',   # search highlight fill
            '#220022aa':  '#0c1216aa',   # run console base fill
            '#614':       '#28343e',     # TButtons / nav rest fill
            '#413':       '#1e2830',     # TButtons hover fill
            '#826':       '#3e5060',     # TButtons lit / nav selected
            '#625a':      '#268a',       # bottom status bar fill
            '#8af2':      '#8cf2',       # status bar inner glow
            '#425':       '#16a8',     # editor selection color
            '#ede3':      '#ade3',       # editor selection border
            '#44225588':  '#16a4',    # editor line highlight
            '#ff3a6a22':  '#7ac8e822',   # commit tab fill
            '#ff3a6a44':  '#7ac8e844',   # commit tab hover fill
            '#ff5a8a99':  '#7ac8e899',   # commit tab border
            '#ff7aa4cc':  '#a8e0f4cc'    # commit tab hover border
        ]

    func load_bg [ arg: object :: t: Enceladus ]
        t0 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg start at {t0}'
        t.build_models[]
        t1 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg done in {t1 - t0}ms at {t1}'
        t.ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : vec Au []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: lambda load_bg[ a ], work: w9 ]
        if [ !ready ] return
        create_target[]
        orbit[]

    func orbit[]
        # surface flyover like Earth's close shot: the ice fills the
        # frame at low orbit and saturn hangs above the limb.
        # negative rate: the gaze leads the motion — flying FORWARD
        time : 0.0 - ux.time * 1460.0
        if [ time == 0.0 ] time = -54.0
        a_t      : f32 [ (ux.orbit_mode == OrbitView.low)  ? 0.25 :
                         (ux.orbit_mode == OrbitView.high) ? 0.70 : 2.60 ]
        if [ e_cur == 0.0 ] e_cur = a_t
        e_cur = filter_n[ e_cur, a_t, 0.08, ux.frame_factor ]
        altitude : f32 [ e_cur ]
        eye_dist : f32 [ 1.0 + altitude ]
        t_deg    : f32 [ (ux.angle_mode == ViewAngle.flat)   ? 0.0 :
                         (ux.angle_mode == ViewAngle.angled) ? 60.0 : 76.0 ]
        if [ p_cur == 0.0 && !p_set ] p_cur = t_deg
        p_set    = true
        p_cur    = filter_n[ p_cur, t_deg, 0.08, ux.frame_factor ]
        ux.orbit_moving = abs[ e_cur - a_t ] > 0.0004 || abs[ p_cur - t_deg ] > 0.05
        tilt     : f32 [ radians[ p_cur ] ]
        aspect   : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]
        orbit_a : radians[ time ]
        co      : cos[ orbit_a ]
        so      : sin[ orbit_a ]
        ex_l  : f32 [ 0.0 ]
        ey_l  : f32 [ 0.0 ]
        ez_l  : f32 [ eye_dist ]
        fx_l  : f32 [ -sin[ tilt ] ]
        fy_l  : f32 [ 0.0 ]
        fz_l  : f32 [ -cos[ tilt ] ]
        tx_l  : f32 [ ex_l + fx_l * 2.0 ]
        ty_l  : f32 [ ey_l + fy_l * 2.0 ]
        tz_l  : f32 [ ez_l + fz_l * 2.0 ]
        _eye   : vec3f [  co * ex_l + so * ez_l, ey_l, -so * ex_l + co * ez_l ]
        _tgt   : vec3f [  co * tx_l + so * tz_l, ty_l, -so * tx_l + co * tz_l ]
        _up    : vec3f [  co, 0.0, 0.0 - so ]

        _proj  : mat4f.perspective[ radians[ 60.0 ], aspect, 0.001, 60.0 ]
        _view  : mat4f.look_at    [ _eye, _tgt, _up ]

        enc.model   = mat4f.identity[]
        enc.view    = _view
        enc.proj    = _proj
        enc.gain    = 1.5
        enc.displace = 0.010
        enc.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]

        # the galaxy wraps the whole scene from a big inner sphere; the
        # camera looks at its equator, rolled so the band runs diagonally
        skq9 : vec4f [ 1.0, 0.0, 0.0, radians[ 45.0 ] ]
        skq  : quatf [ skq9 ]
        skm : mat4f.identity[]
        skm = skm.rotate[ skq ]
        skm = skm.scale [ vec3f [ 30.0, 30.0, 30.0 ] ]
        sky.model = skm
        sky.view  = _view
        sky.proj  = _proj
        sky.gain  = 0.45
        sky.time  = ux.time * 60000.0

        # the proxy: a shell just past jet reach — from inside its far
        # side covers the WHOLE sky (no rim to cut a beam at any gaze),
        # from outside its near side covers the planet region
        hm : mat4f.identity[]
        hm = hm.scale [ vec3f [ 1.30, 1.30, 1.30 ] ]
        plume.model   = hm
        plume.view    = _view
        plume.proj    = _proj
        plume.gain    = 1.0
        plume.time    = ux.time * 60000.0
        plume.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]

        # saturn fixed in the sky above the limb, darker, near edge-on.
        # the offset must ride the SAME orbit rotation as the eye or
        # the camera walks away from it and it slides off-frame
        rise   : f32 [ radians[ 14.0 ] ]
        aim    : f32 [ tilt + rise ]
        s_dist : f32 [ 24.0 ]
        sx9    : f32 [ 0.0 - s_dist * sin[ aim ] ]
        sz9    : f32 [ eye_dist - s_dist * cos[ aim ] ]
        s_off  : vec3f [ co * sx9 + so * sz9, 0.0, (0.0 - so) * sx9 + co * sz9 ]
        s_sc   : vec3f [ 8.5, 8.5, 8.5 ]
        s_axis : vec4f [ 0.0, 0.0, 1.0, radians[ -22.0 ] ]
        sq     : quatf [ s_axis ]
        s_tip  : vec4f [ 1.0, 0.0, 0.0, radians[ 8.0 ] ]
        sq3    : quatf [ s_tip ]
        s_spin : vec4f [ 0.0, 1.0, 0.0, radians[ ux.time * 9000.0 ] ]
        sq2    : quatf [ s_spin ]
        sm : mat4f.identity[]
        sm = sm.translate[ s_off ]
        sm = sm.rotate   [ sq3 ]
        sm = sm.rotate   [ sq ]
        sm = sm.rotate   [ sq2 ]
        sm = sm.scale    [ s_sc ]
        saturn.model    = sm
        saturn.view     = _view
        saturn.proj     = _proj
        saturn.gain     = 0.75
        saturn.cam_pos  = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        saturn.time     = ux.time * 60000.0

        r_sc : vec3f [ 19.8, 0.02, 19.8 ]
        rm : mat4f.identity[]
        rm = rm.translate[ s_off ]
        rm = rm.rotate   [ sq3 ]
        rm = rm.rotate   [ sq ]
        rm = rm.scale    [ r_sc ]
        rings.model   = rm
        rings.view    = _view
        rings.proj    = _proj
        rings.gain    = 0.8
        rings.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        # SATURN'S OWN, the two numbers that were inline in the
        # shader: D-ring inner 74500 over F-ring outer 140220, and
        # the ball's 60268 over that same outer
        rings.rgeo    = vec4f [ 0.531, 0.430, 0.0, 0.0 ]

# europa bake: cpu gradient perlin, quintic fade, mod-289 lattice
func eu_perm [ x: f32 ] -> f32
    p : f32 [ (x * 34.0 + 1.0) * x ]
    return p - floor[ p / 289.0 ] * 289.0

# gradient dot for one lattice corner, glsl e_gnoise rules
func eu_grad [ h9: f32, x: f32, y: f32, z: f32 ] -> f32
    h7 : f32 [ floor[ h9 / 7.0 ] ]
    gx : f32 [ (h9 / 7.0 - h7) * 2.0 - 1.0 ]
    gy : f32 [ (h7 / 7.0 - floor[ h7 / 7.0 ]) * 2.0 - 1.0 ]
    gz : f32 [ 1.0 - abs[ gx ] - abs[ gy ] ]
    if [ gz < 0.0 ]
        if [ gx >= 0.0 ]
            gx = gx - 0.5
        el
            gx = gx + 0.5
        if [ gy >= 0.0 ]
            gy = gy - 0.5
        el
            gy = gy + 0.5
    r9 : f32 [ gx * gx + gy * gy + gz * gz ]
    nm : f32 [ 1.79284291400159 - 0.85373472095314 * r9 ]
    return (gx * x + gy * y + gz * z) * nm

func eu_fade [ t: f32 ] -> f32
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0)

func eu_gnoise [ px: f32, py: f32, pz: f32 ] -> f32
    ix : f32 [ floor[ px ] ]
    iy : f32 [ floor[ py ] ]
    iz : f32 [ floor[ pz ] ]
    fx : f32 [ px - ix ]
    fy : f32 [ py - iy ]
    fz : f32 [ pz - iz ]
    ix = ix - floor[ ix / 289.0 ] * 289.0
    iy = iy - floor[ iy / 289.0 ] * 289.0
    iz = iz - floor[ iz / 289.0 ] * 289.0
    hx0  : f32 [ eu_perm[ ix ] ]
    hx1  : f32 [ eu_perm[ ix + 1.0 ] ]
    h00  : f32 [ eu_perm[ hx0 + iy ] ]
    h10  : f32 [ eu_perm[ hx1 + iy ] ]
    h01  : f32 [ eu_perm[ hx0 + iy + 1.0 ] ]
    h11  : f32 [ eu_perm[ hx1 + iy + 1.0 ] ]
    n000 : f32 [ eu_grad[ eu_perm[ h00 + iz ],       fx,       fy,       fz ] ]
    n100 : f32 [ eu_grad[ eu_perm[ h10 + iz ],       fx - 1.0, fy,       fz ] ]
    n010 : f32 [ eu_grad[ eu_perm[ h01 + iz ],       fx,       fy - 1.0, fz ] ]
    n110 : f32 [ eu_grad[ eu_perm[ h11 + iz ],       fx - 1.0, fy - 1.0, fz ] ]
    n001 : f32 [ eu_grad[ eu_perm[ h00 + iz + 1.0 ], fx,       fy,       fz - 1.0 ] ]
    n101 : f32 [ eu_grad[ eu_perm[ h10 + iz + 1.0 ], fx - 1.0, fy,       fz - 1.0 ] ]
    n011 : f32 [ eu_grad[ eu_perm[ h01 + iz + 1.0 ], fx,       fy - 1.0, fz - 1.0 ] ]
    n111 : f32 [ eu_grad[ eu_perm[ h11 + iz + 1.0 ], fx - 1.0, fy - 1.0, fz - 1.0 ] ]
    ux9 : f32 [ eu_fade[ fx ] ]
    uy9 : f32 [ eu_fade[ fy ] ]
    uz9 : f32 [ eu_fade[ fz ] ]
    nx00 : f32 [ n000 + (n100 - n000) * ux9 ]
    nx10 : f32 [ n010 + (n110 - n010) * ux9 ]
    nx01 : f32 [ n001 + (n101 - n001) * ux9 ]
    nx11 : f32 [ n011 + (n111 - n011) * ux9 ]
    ny0  : f32 [ nx00 + (nx10 - nx00) * uy9 ]
    ny1  : f32 [ nx01 + (nx11 - nx01) * uy9 ]
    return (ny0 + (ny1 - ny0) * uz9) * 0.5 + 0.5

func eu_hash2 [ x: f32, y: f32, s9: f32 ] -> f32
    v : f32 [ sin[ x * 12.9898 + y * 78.233 + s9 * 37.719 ] * 43758.5453 ]
    return v - floor[ v ]

# fold a tile coordinate into mirrored repeat: edges continue
# into their own reflection, so no source seam can print
func eu_mirr [ t: f32 ] -> f32
    m : f32 [ t * 0.5 - floor[ t * 0.5 ] ]
    m = m * 2.0
    if [ m > 1.0 ] m = 2.0 - m
    return m

# bilinear over a luminance field, mirrored on both axes
func eu_bilin [ S: @f32, w: i32, h: i32, u: f32, v: f32 ] -> f32
    x : f32 [ eu_mirr[ u ] * f32[ w - 1 ] ]
    y : f32 [ eu_mirr[ v ] * f32[ h - 1 ] ]
    x0 : i32 [ i32[ x ] ]
    y0 : i32 [ i32[ y ] ]
    tx : f32 [ x - f32[ x0 ] ]
    ty : f32 [ y - f32[ y0 ] ]
    if [ x0 >= w - 1 ] x0 = w - 2
    if [ y0 >= h - 1 ] y0 = h - 2
    x1 : i32 [ x0 + 1 ]
    y1 : i32 [ y0 + 1 ]
    a9 : f32 [ S[ y0 * w + x0 ] ]
    b9 : f32 [ S[ y0 * w + x1 ] ]
    c9 : f32 [ S[ y1 * w + x0 ] ]
    d9 : f32 [ S[ y1 * w + x1 ] ]
    return (a9 * (1.0 - tx) + b9 * tx) * (1.0 - ty) + (c9 * (1.0 - tx) + d9 * tx) * ty

# mirror-blended rotated sample of one source across the u seam;
# sx != sy stretches the pattern into elongated grain
func eu_pat [ S: @f32, sw: i32, sh: i32, u: f32, v: f32, ub9: f32,
              sk9: f32, ang: f32, sx: f32, sy: f32, ox: f32, oy: f32 ] -> f32
    rc : f32 [ cos[ ang ] ]
    rs : f32 [ sin[ ang ] ]
    ax : f32 [ (u   * rc - v * rs) * sx + ox ]
    ay : f32 [ (u   * rs + v * rc) * sy + oy ]
    bx : f32 [ (ub9 * rc - v * rs) * sx + ox ]
    by : f32 [ (ub9 * rs + v * rc) * sy + oy ]
    sa : f32 [ eu_bilin[ S, sw, sh, ax, ay ] ]
    sb : f32 [ eu_bilin[ S, sw, sh, bx, by ] ]
    return sb + (sa - sb) * sk9

func eu_sstep [ e0: f32, e1: f32, x: f32 ] -> f32
    t : f32 [ (x - e0) / (e1 - e0) ]
    if [ t < 0.0 ] t = 0.0
    if [ t > 1.0 ] t = 1.0
    return t * t * (3.0 - 2.0 * t)

# luminance field from an Image, any channel count
func eu_lum [ im: Image, L: @f32 ]
    d : @u8 [ im.vdata[] ]
    ps : i32 [ im.pixel_size ]
    n : i32 [ im.width * im.height ]
    if [ ps >= 3 ]
        for [ i: i32 0, i < n, i += 1 ]
            b2 : i32 [ i * ps ]
            L[ i ] = (f32[ d[ b2 ] ] * 0.299 + f32[ d[ b2 + 1 ] ] * 0.587 + f32[ d[ b2 + 2 ] ] * 0.114) / 255.0
    el
        for [ i: i32 0, i < n, i += 1 ]
            L[ i ] = f32[ d[ i * ps ] ] / 255.0

# 3x3 box blur passes, wrap x clamp y
func eu_blur [ H: @f32, T: @f32, w: i32, h: i32, passes: i32 ]
    for [ p9: i32 0, p9 < passes, p9 += 1 ]
        for [ y: i32 0, y < h, y += 1 ]
            ym : i32 [ (y > 0) ? y - 1 : 0 ]
            yp : i32 [ (y < h - 1) ? y + 1 : h - 1 ]
            for [ x: i32 0, x < w, x += 1 ]
                xm : i32 [ (x > 0) ? x - 1 : w - 1 ]
                xp : i32 [ (x < w - 1) ? x + 1 : 0 ]
                T[ y * w + x ] = (H[ ym * w + xm ] + H[ ym * w + x ] + H[ ym * w + xp ]
                                + H[ y  * w + xm ] + H[ y  * w + x ] + H[ y  * w + xp ]
                                + H[ yp * w + xm ] + H[ yp * w + x ] + H[ yp * w + xp ]) / 9.0
        for [ i: i32 0, i < w * h, i += 1 ]
            H[ i ] = T[ i ]

# 8-dir horizon walk on the equirect height, wrap x clamp y
func eu_bake_ao [ H: @f32, AO: @f32, w: i32, h: i32, hscale: f32 ]
    dxs : new f32 [ 8 ]
    dys : new f32 [ 8 ]
    for [ d: i32 0, d < 8, d += 1 ]
        aa : f32 [ f32[ d ] * 0.7853982 ]
        dxs[ d ] = cos[ aa ]
        dys[ d ] = sin[ aa ]
    for [ y: i32 0, y < h, y += 1 ]
        fy3 : f32 [ f32[ y ] ]
        for [ x: i32 0, x < w, x += 1 ]
            h0 : f32 [ H[ y * w + x ] ]
            fx3 : f32 [ f32[ x ] ]
            occ : f32 [ 0.0 ]
            for [ d: i32 0, d < 8, d += 1 ]
                m : f32 [ 0.0 ]
                jt : f32 [ eu_hash2[ fx3, fy3, f32[ d ] ] * 4.0 ]
                for [ s: i32 1, s <= 12, s += 1 ]
                    dist : f32 [ f32[ s * 4 ] + jt ]
                    px : i32 [ x + i32[ dxs[ d ] * dist ] ]
                    py : i32 [ y + i32[ dys[ d ] * dist ] ]
                    px = px % w
                    if [ px < 0 ] px += w
                    if [ py < 0 ] py = 0
                    if [ py >= h ] py = h - 1
                    sl : f32 [ (H[ py * w + px ] - h0) * hscale / dist ]
                    if [ sl > m ] m = sl
                occ += m / (1.0 + m)
            v2 : f32 [ 1.0 - occ * 0.17 ]
            if [ v2 < 0.0 ] v2 = 0.0
            AO[ y * w + x ] = v2

# jupiter overhead: saturn's ball minus the rings, winds kept
ModelViewProject JupiterShader
    mutable gain    : f32
    mutable cam_pos : vec4f
    # the two discharge colours, picked between per region. jupiter
    # runs sodium orange against hydrogen blue; neptune wants white
    mutable pc_a    : vec4f
    mutable pc_b    : vec4f
    # xy scales the discharge noise. equal is blobs; x well under y
    # draws every cell out along the wind into a streak
    mutable pstr    : vec4f
    # x = noise threshold, y = pulse rate, z = duty exponent. neptune
    # wants rarer cells that fire briefly; jupiter wants the opposite
    mutable pctl    : vec4f
    # the crosswind: x = shear amplitude, y = equatorial jet width,
    # z = lobe frequency, w = lobe amplitude. jupiter's profile dies
    # outside 18 degrees of the equator, which leaves most of a disk
    # standing still
    mutable wctl    : vec4f
    # x = jet amplitude, y = lobe decay, z = ping-pong rate. with wctl
    # this is the whole wind model, so one planet can be handed
    # another's verbatim
    mutable wctl2   : vec4f
    # a LIVE albedo tint, MULTIPLIED onto the texture colour. rgb is
    # the per-channel factor, w how far the blend is ever allowed to
    # go. driven by its own drifting perlin, so unlike a baked patch
    # it comes and goes with the weather
    mutable tint    : vec4f
    # FIRE ON THE PLATE at the poles: rgb the DEEP colour, w its
    # strength. a ring burnt into the surface itself -- this is what
    # the marched aurora above it is standing on
    mutable pfire   : vec4f
    # the pale end of that fire. the ring runs between the two along
    # its length, so it is never one flat colour
    mutable pfire2  : vec4f

    attrib color : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.color, count:1, format: typeid[ rgba8 ] ]
    # baked sobel contrast of the color map: where storms live
    attrib height : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.height, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_normal    : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_uv        : VertexOutput [ type:typeid[ vec2f ] ]
    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]

    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]

    func jp_perm4 [ x: vec4f ] -> GLSL vec4f {
        return mod((x * 34.0 + 1.0) * x, vec4(289.0));
    }

    func jp_isqrt4 [ r: vec4f ] -> GLSL vec4f {
        return 1.79284291400159 - 0.85373472095314 * r;
    }

    func jp_gnoise [ P: vec3f ] -> GLSL float {
        vec3 Pi0 = mod(floor(P), vec3(289.0));
        vec3 Pi1 = mod(Pi0 + vec3(1.0), vec3(289.0));
        vec3 Pf0 = fract(P);
        vec3 Pf1 = Pf0 - vec3(1.0);
        vec4 ix  = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
        vec4 iy  = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
        vec4 iz0 = vec4(Pi0.z);
        vec4 iz1 = vec4(Pi1.z);
        vec4 ixy  = jp_perm4(jp_perm4(ix) + iy);
        vec4 ixy0 = jp_perm4(ixy + iz0);
        vec4 ixy1 = jp_perm4(ixy + iz1);
        vec4 gx0 = fract(ixy0 / 7.0) * 2.0 - 1.0;
        vec4 gy0 = fract(floor(ixy0 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz0 = 1.0 - abs(gx0) - abs(gy0);
        vec4 gx1 = fract(ixy1 / 7.0) * 2.0 - 1.0;
        vec4 gy1 = fract(floor(ixy1 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz1 = 1.0 - abs(gx1) - abs(gy1);
        vec4 sz0 = step(gz0, vec4(0.0));
        gx0 -= sz0 * (step(0.0, gx0) - 0.5);
        gy0 -= sz0 * (step(0.0, gy0) - 0.5);
        vec4 sz1 = step(gz1, vec4(0.0));
        gx1 -= sz1 * (step(0.0, gx1) - 0.5);
        gy1 -= sz1 * (step(0.0, gy1) - 0.5);
        vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
        vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
        vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
        vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
        vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
        vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
        vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
        vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);
        vec4 nm0 = jp_isqrt4(vec4(dot(g000,g000), dot(g010,g010), dot(g100,g100), dot(g110,g110)));
        g000 *= nm0.x; g010 *= nm0.y; g100 *= nm0.z; g110 *= nm0.w;
        vec4 nm1 = jp_isqrt4(vec4(dot(g001,g001), dot(g011,g011), dot(g101,g101), dot(g111,g111)));
        g001 *= nm1.x; g011 *= nm1.y; g101 *= nm1.z; g111 *= nm1.w;
        float n000 = dot(g000, Pf0);
        float n100 = dot(g100, vec3(Pf1.x, Pf0.y, Pf0.z));
        float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
        float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
        float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
        float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
        float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
        float n111 = dot(g111, Pf1);
        vec3  fxyz = Pf0 * Pf0 * Pf0 * (Pf0 * (Pf0 * 6.0 - 15.0) + 10.0);
        vec4  n_z  = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fxyz.z);
        vec2  n_yz = mix(n_z.xy, n_z.zw, fxyz.y);
        return mix(n_yz.x, n_yz.y, fxyz.x) * 0.5 + 0.5;
    }

    func init[]
        eye2    : vec3f [0.0f, 0.0f, 2.5f]
        target2 : vec3f [0.0f, 0.0f, 0.0f]
        up2     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_uv        = vec2(1.0 - a_uv.x, a_uv.y);
        mat3 nm     = transpose(inverse(mat3(ubo.model)));
        v_normal    = normalize(nm * a_normal);
        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        vec3  n        = normalize(v_normal);
        vec3  sun      = normalize(vec3(0.85, -0.10, 0.15));
        vec3  view_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        // zonal winds: a hot equatorial jet plus thin alternating
        // lobes — jupiter runs more bands than saturn
        float la = v_uv.y - 0.5;
        float w  = ubo.wctl2.x * exp(-la * la / ubo.wctl.y)
                 + ubo.wctl.w * cos(la * ubo.wctl.z) * exp(-abs(la) * ubo.wctl2.y);
        // flow ping-pong: two half-cycle phases crossfaded, so shear
        // stays bounded and the bands slide forever without smearing
        float t9 = ubo.time * ubo.wctl2.z;
        float p0 = fract(t9);
        float p1 = fract(t9 + 0.5);
        float s0 = w * (p0 - 0.5) * ubo.wctl.x;
        float s1 = w * (p1 - 0.5) * ubo.wctl.x;
        float bl = abs(2.0 * p0 - 1.0);
        // NO uniform spin here. any shift added at every latitude is
        // common motion, and the eye reads the largest common motion
        // as the whole planet turning -- it buries the shear
        vec2  bu0 = vec2(v_uv.x + s0, v_uv.y);
        vec2  bu1 = vec2(v_uv.x + s1, v_uv.y);
        vec3  alb = mix(texture(color, bu0).rgb,
                        texture(color, bu1).rgb, bl);
        // THE LIVE TINT, multiplied onto that colour. this was baked
        // into the plate, which meant it could never move -- here it
        // drifts. three things decide it, the same three the bake
        // used, but now on a clock:
        //   a slow perlin says WHERE, sampled on a circle so it
        //   closes at the seam and drifting on its own third axis
        //   band darkness says HOW MUCH -- it collects in the belts
        //   two latitude waves thicken it along y
        float tl9 = dot(alb, vec3(0.299, 0.587, 0.114));
        float tdk = 1.0 - smoothstep(0.60, 0.75, tl9);
        float tbn = 0.5 + 0.35 * sin(bu0.y * 38.0 + 0.7)
                        + 0.15 * sin(bu0.y * 91.0 + 2.1);
        // EAST-WEST STRETCHED, hard. the circle radius sets how many
        // cells fit around the equator and the third axis how many
        // fit down the latitude -- 0.55 is only 3.5 around, 16 is
        // sixteen down. that is 104 degrees of longitude against 11
        // of latitude, a 9:1 draw along the wind. it was 0.8:1 before,
        // very slightly TALLER than wide
        // the clock goes on LONGITUDE, never on the third axis. that
        // axis carries latitude, so a time term there walks the whole
        // field from pole to pole -- which is the north-to-south
        // sweep, and nothing in an atmosphere migrates that way.
        // rotating the sample circle drifts it east instead, and a
        // rotated circle is still a circle, so the seam stays closed
        float tag = (bu0.x + ubo.time * 0.00007) * 6.28318530718;
        float tpn = jp_gnoise(vec3(cos(tag) * 0.55, sin(tag) * 0.55,
                                   bu0.y * 16.0));
        // the latitude bands GATE it. adding them instead let the
        // perlin's own floor tint the whole ball, which is the glob:
        // outside a band there is now no tint at all, and the perlin
        // only decides how much of one shows WITHIN it
        float tgb = smoothstep(0.42, 0.78, tbn);
        float tw9 = smoothstep(0.455, 0.545, tpn)
                  * (0.15 + 0.85 * tdk) * tgb;
        alb = mix(alb, alb * ubo.tint.rgb, clamp(tw9, 0.0, 1.0) * ubo.tint.w);
        // LAMBERT, the same law earth and the moon use here. a sphere
        // under a distant sun falls off as the cosine of the incidence
        // angle: flat near the sub-solar point, steepest at 90. the
        // old 0.5 wrap spread that fade over the WHOLE globe, so
        // nothing was ever fully lit; 8.0 collapsed it to a cut.
        // the 0.06 is jupiter's own departure -- an atmosphere deep
        // enough to carry light about four degrees past the geometric
        // terminator. no square: that is gamma, not illumination
        float lam9     = dot(n, sun);
        float ndl      = clamp((lam9 + 0.06) / 1.06, 0.0, 1.0);
        float mu       = clamp(dot(n, view_dir), 0.0, 1.0);
        // cam_pos.w scales the ambient floor -- how much albedo shows
        // where no sun reaches. at 1.0 this is the 0.08 it has always
        // been; higher keeps the unlit pole from going to black
        float amb9     = 0.08 * ubo.cam_pos.w;
        vec3  col      = alb * (amb9 + (1.0 - amb9) * ndl) * ubo.gain;
        // NIGHT-SIDE PLASMA. the storm map is baked: sobel edge max'd
        // with band darkness, already gaussian'd. one read here
        // the SAME uv the albedo used -- spin and shear both
        vec2  ju0 = bu0;
        vec2  ju1 = bu1;
        float sob = smoothstep(0.10, 0.72,
                        mix(texture(height, ju0).r, texture(height, ju1).r, bl));

        // the noise rides ju0/ju1, which already carry the wind as a
        // BOUNDED shear. an offset that grows with time and varies by
        // latitude does not move the field, it shears it: after ten
        // minutes neighbouring latitudes are hundreds of noise cells
        // apart and every feature is one pixel tall
        // GRADIENT noise clusters hard around 0.5, so a raw 0.8 cut
        // fires on almost nothing -- stretch first, then threshold
        vec2  ps9 = ubo.pstr.xy;
        // THE UV SEAM. gradient noise on raw u is discontinuous at the
        // wrap: x runs 0 to 18 across the map and those are different
        // lattice cells, so the field does not meet itself. sampled
        // around a CIRCLE in longitude it closes. radius is the old
        // cell count over two pi, so the features are the same size
        // pc_b.w DRIFTS THE FIELD IN LONGITUDE. rotating the sample
        // circle is still a circle, so this travels without ever
        // breaking the seam -- and it is the axis weather actually
        // moves along. the time term used to sit on the third axis
        // instead, which carries LATITUDE, so the whole field crept
        // down the map
        float dx9 = ubo.time * ubo.pc_b.w;
        float a90 = (ju0.x + dx9) * 6.28318530718;
        float a91 = (ju1.x + dx9) * 6.28318530718;
        float r90 = 2.8648 * ps9.x;
        float r91 = 6.5254 * ps9.x;
        float sy9 = 18.0 * ps9.y;
        float sy8 = 41.0 * ps9.y;
        // the third axis keeps only a slow BOIL -- a fifth of what it
        // carried. it is the latitude axis, so anything fast on it
        // reads as the field sinking rather than evolving
        float st9 = mix(jp_gnoise(vec3(cos(a90) * r90, sin(a90) * r90, ju0.y * sy9 + ubo.time * 0.006)),
                        jp_gnoise(vec3(cos(a91) * r90, sin(a91) * r90, ju1.y * sy9 + ubo.time * 0.006)), bl);
        float st2 = mix(jp_gnoise(vec3(cos(a90) * r91 + 7.0, sin(a90) * r91 + 7.0, ju0.y * sy8 + ubo.time * 0.010)),
                        jp_gnoise(vec3(cos(a91) * r91 + 7.0, sin(a91) * r91 + 7.0, ju1.y * sy8 + ubo.time * 0.010)), bl);
        st9 = clamp((st9 - 0.5) * 3.4 + 0.5, 0.0, 1.0);
        st2 = clamp((st2 - 0.5) * 3.0 + 0.5, 0.0, 1.0);
        float flash = smoothstep(ubo.pctl.x, ubo.pctl.x + 0.32, st9)
                    * (0.45 + 0.55 * st2);

        // cells pulse on their own clocks, and a wave runs the bands so
        // fronts sweep rather than the planet blinking as one
        // wctl2.w is how many pulse phases fit down the latitude. it
        // has to sit near the CELL count -- 60 against 10 cells is 6
        // phases inside one cell, which prints the cell as stripes
        float pls = 0.5 + 0.5 * sin(ubo.time * ubo.pctl.y + st2 * 21.0
                                  + ju0.y * ubo.wctl2.w);
        // 31.4159 is FIVE whole cycles. 34.0 was 5.41, so the wave
        // jumped 0.41 of a cycle across the seam
        float wv  = 0.5 + 0.5 * sin(ju0.x * 31.4159265 - ubo.time * 0.24 + st2 * 4.0);
        // pc_a.w is PERMANENCE: 0 is an event that fires and dies, 1 is
        // a standing feature that only breathes. lightning is the
        // first; a cloud deck is the second, and it was being switched
        // on and off like a strike
        float prm = ubo.pc_a.w;
        float flr = mix(0.10, 1.00, prm);
        float wvg = mix(smoothstep(0.15, 0.85, wv), 1.0, prm);
        flash *= (flr + (1.0 - flr) * pow(pls, ubo.pctl.z)) * wvg;

        // ORANGE or BLUE by region, sodium and hydrogen at depth
        float hue = jp_gnoise(vec3(cos(a90) * 0.7958 + 31.0, sin(a90) * 0.7958 + 31.0,
                                   ju0.y * 5.0 + ubo.time * 0.012));
        vec3  pc  = mix(ubo.pc_a.rgb, ubo.pc_b.rgb, smoothstep(0.42, 0.58, hue));
        // pctl.w = how much of this is night-only. 1 is a discharge
        // seen against the dark side; 0 is weather, lit right across
        float night = 1.0 - smoothstep(0.015, 0.28, ndl);
        // WEATHER DOES NOT GLOW. cloud is lit by the same sun as the
        // deck under it, so it takes the same light term -- at HALF
        // strength, so it still reads through the terminator instead
        // of vanishing with the surface. a flat 1.0 here was what lit
        // the night side as brightly as the day
        float lit9  = 0.08 + 0.92 * ndl;
        // 0.85, not 0.5. half the darkening still left cloud at 0.54
        // of full on the night side, which is a glow -- this puts it
        // at 0.22, dim but not gone
        float gate  = mix(mix(1.0, lit9, 0.85), night, ubo.pctl.w);
        float amt   = flash * sob * gate;
        // TWO ways to land it, and a planet picks one. pstr.z adds a
        // discharge colour on top; pstr.w instead lifts the albedo
        // already there toward white, and never past pstr.w itself
        col += pc * amt * ubo.pstr.z;
        col  = mix(col, vec3(1.0), min(amt, 1.0) * ubo.pstr.w);

        // FIRE AT THE POLES, on the plate itself. the texture is
        // equirect and the model spins about y, so the pole is just
        // v near 0 or 1 -- no axis maths, and it lands ON the surface
        // rather than in a shell above it. a RING at 17 degrees off
        // the pole, matching the oval the marched aurora rides, so
        // the glow above is standing on the burn below
        float pv9 = min(bu0.y, 1.0 - bu0.y);
        // THIN. 0.030 was 5.4 degrees of latitude, a zone broad
        // enough for the noise to mottle across -- 0.013 is 2.3, a
        // line, but a soft-shouldered one rather than a wire
        float pd9 = (pv9 - 0.094) / 0.013;
        // and a HOLE: nothing at all inside 10.8 degrees, so the pole
        // carries none of this and it can only ever read as a ring
        float prg = exp(-pd9 * pd9) * smoothstep(0.060, 0.080, pv9);
        if (prg > 0.002 && ubo.pfire.w > 0.0) {{
            // the clock rides LONGITUDE. the third axis here is
            // colatitude, and a time term on it would drag the fire
            // toward the pole
            float pag = (bu0.x + ubo.time * 0.00012) * 6.28318530718;
            // EAST-WEST STRETCHED like the tint's. radius 1.4 is 8.8
            // cells around, 41 degrees of longitude each, against 46
            // down the latitude at 2 degrees -- a 21:1 draw, so these
            // are clouds lying ALONG the ring, not spokes across it
            float pn1 = jp_gnoise(vec3(cos(pag) * 1.4,       sin(pag) * 1.4,       pv9 * 46.0));
            float pn2 = jp_gnoise(vec3(cos(pag) * 3.6 + 5.0, sin(pag) * 3.6 + 5.0, pv9 * 100.0));
            // CONTINUOUS, swelling and thinning. a 0.04 window on
            // the noise snapped between full and nothing and left cut
            // crescents -- 0.40 to 0.58 ramps over four times the
            // range, and the 0.28 floor keeps the ring joined all the
            // way round so it never actually breaks
            float pseg = 0.28 + 0.72 * smoothstep(0.40, 0.58, pn1);
            // TWO COLOURS along its length. the fine octave picks
            // between the deep orange and the pale, so the ring runs
            // hot and cool along itself instead of reading as one
            // painted band
            float pmx  = smoothstep(0.40, 0.62, pn2);
            vec3  pcol = mix(ubo.pfire.rgb, ubo.pfire2.rgb, pmx);
            // a light brightness texture on top, never to nothing
            float ptx  = 0.78 + 0.22 * pmx;
            col += pcol * prg * pseg * ptx * ubo.pfire.w;
        }}

        float a        = smoothstep(0.0, 0.18, mu);
        fragColor      = vec4(col, a);
    }

ModelViewProject EuropaShader
    mutable gain     : f32
    mutable cam_pos  : vec4f
    # real geometry displacement, in sphere radii
    mutable displace : f32

    # baked at scene build: R height hi, A height lo, G AO, B cavity
    attrib height : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.height, count:1, format: typeid[ rgba8 ] ]
    # baked normals: RG = normal xy, B = cavity
    attrib nrmA   : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.nrm_a,  count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_normal    : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_uv        : VertexOutput [ type:typeid[ vec2f ] ]
    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]
    attrib v_sp        : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_h         : VertexOutput [ type:typeid[ f32 ] ]

    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]

    func eg_perm4 [ x: vec4f ] -> GLSL vec4f {
        return mod((x * 34.0 + 1.0) * x, vec4(289.0));
    }

    func eg_isqrt4 [ r: vec4f ] -> GLSL vec4f {
        return 1.79284291400159 - 0.85373472095314 * r;
    }

    func eg_gnoise [ P: vec3f ] -> GLSL float {
        vec3 Pi0 = mod(floor(P), vec3(289.0));
        vec3 Pi1 = mod(Pi0 + vec3(1.0), vec3(289.0));
        vec3 Pf0 = fract(P);
        vec3 Pf1 = Pf0 - vec3(1.0);
        vec4 ix  = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
        vec4 iy  = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
        vec4 iz0 = vec4(Pi0.z);
        vec4 iz1 = vec4(Pi1.z);
        vec4 ixy  = eg_perm4(eg_perm4(ix) + iy);
        vec4 ixy0 = eg_perm4(ixy + iz0);
        vec4 ixy1 = eg_perm4(ixy + iz1);
        vec4 gx0 = fract(ixy0 / 7.0) * 2.0 - 1.0;
        vec4 gy0 = fract(floor(ixy0 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz0 = 1.0 - abs(gx0) - abs(gy0);
        vec4 gx1 = fract(ixy1 / 7.0) * 2.0 - 1.0;
        vec4 gy1 = fract(floor(ixy1 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz1 = 1.0 - abs(gx1) - abs(gy1);
        vec4 sz0 = step(gz0, vec4(0.0));
        gx0 -= sz0 * (step(0.0, gx0) - 0.5);
        gy0 -= sz0 * (step(0.0, gy0) - 0.5);
        vec4 sz1 = step(gz1, vec4(0.0));
        gx1 -= sz1 * (step(0.0, gx1) - 0.5);
        gy1 -= sz1 * (step(0.0, gy1) - 0.5);
        vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
        vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
        vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
        vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
        vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
        vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
        vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
        vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);
        vec4 nm0 = eg_isqrt4(vec4(dot(g000,g000), dot(g010,g010), dot(g100,g100), dot(g110,g110)));
        g000 *= nm0.x; g010 *= nm0.y; g100 *= nm0.z; g110 *= nm0.w;
        vec4 nm1 = eg_isqrt4(vec4(dot(g001,g001), dot(g011,g011), dot(g101,g101), dot(g111,g111)));
        g001 *= nm1.x; g011 *= nm1.y; g101 *= nm1.z; g111 *= nm1.w;
        float n000 = dot(g000, Pf0);
        float n100 = dot(g100, vec3(Pf1.x, Pf0.y, Pf0.z));
        float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
        float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
        float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
        float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
        float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
        float n111 = dot(g111, Pf1);
        vec3  fxyz = Pf0 * Pf0 * Pf0 * (Pf0 * (Pf0 * 6.0 - 15.0) + 10.0);
        vec4  n_z  = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fxyz.z);
        vec2  n_yz = mix(n_z.xy, n_z.zw, fxyz.y);
        return mix(n_yz.x, n_yz.y, fxyz.x) * 0.5 + 0.5;
    }

    func init[]
        eye2    : vec3f [0.0f, 0.0f, 2.5f]
        target2 : vec3f [0.0f, 0.0f, 0.0f]
        up2     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_uv        = vec2(1.0 - a_uv.x, a_uv.y);
        v_sp        = normalize(a_pos);
        mat3 nm     = transpose(inverse(mat3(ubo.model)));
        v_normal    = normalize(nm * a_normal);
        // two-byte height: one byte terraces at the terminator
        vec4  hp    = textureLod(height, v_uv, 0.0);
        float hv    = (hp.r * 65280.0 + hp.a * 255.0) / 65535.0;
        v_h         = hv;
        vec3  disp  = a_pos + a_normal * (hv - 0.5) * ubo.displace;
        vec4  wpos  = ubo.model * vec4(disp, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        vec3  n        = normalize(v_normal);
        vec3  sun      = normalize(vec3(0.85, -0.10, 0.15));
        vec3  view_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        float dist9    = length(ubo.cam_pos.xyz - v_world_pos.xyz);
        vec4  hp  = texture(height, v_uv);
        vec4  np  = texture(nrmA, v_uv);
        float ao9 = hp.g;
        vec2  nxy = np.rg * 2.0 - 1.0;
        float cav = hp.b;
        float met = np.b;
        // the smooth-sphere daylight gates the detail tilt: the dark
        // side must not catch extreme grazing light off micro normals
        float wrs = clamp(dot(n, sun) * 0.5 + 0.5, 0.0, 1.0);
        float dfade = 1.0 - smoothstep(0.9, 2.6, dist9);
        float ntilt = dfade * (0.25 + 0.75 * wrs);
        if (ntilt > 0.0) {{
            vec3 t_e = normalize(cross(vec3(0.0, 1.0, 0.0), n));
            vec3 t_n = cross(n, t_e);
            n = normalize(n + (t_e * nxy.x + t_n * nxy.y) * 1.2 * ntilt);
        }}
        // cav carries the deep-carve mask: snow at surface level,
        // europa's light tan orange on the lineae floors, darker
        // bits in the deepest cores; ao stays a whisper
        float deep = cav;
        float ao = mix(0.96, 1.0, ao9) * (1.0 - deep * 0.10 * dfade);
        // depressions sit slightly darker; plains rest at 0.62
        float low = clamp((0.62 - v_h) / 0.35, 0.0, 1.0);
        ao *= 1.0 - low * 0.10;
        float dm  = smoothstep(0.12, 0.70, deep);
        float dm2 = smoothstep(0.55, 0.95, deep);
        // perlin variance breathes over the tan floors, two octaves
        float tn1 = eg_gnoise(v_sp * 14.0 + vec3(5.0, 2.0, 9.0));
        float tn2 = eg_gnoise(v_sp * 41.0 + vec3(1.0, 8.0, 3.0));
        vec3  tan9 = vec3(0.80, 0.64, 0.44) * (0.74 + 0.36 * tn1 + 0.16 * (tn2 - 0.5));
        vec3  alb = mix(vec3(0.94, 0.96, 0.99), tan9, dm);
        alb = mix(alb, vec3(0.48, 0.36, 0.25), dm2 * 0.6);
        // ~15% of the snow fields carry a darkening overlay that
        // settles into their minor depressions
        float sgate = smoothstep(0.58, 0.66, eg_gnoise(v_sp * 5.5 + vec3(9.0, 4.0, 21.0)));
        float lm    = smoothstep(0.02, 0.22, low) * (1.0 - dm);
        alb *= 1.0 - sgate * lm * 0.22;
        // and everywhere outside the orange, minor dips gray a bit
        alb = mix(alb, vec3(0.72, 0.74, 0.77), lm * 0.30);
        // metal4 dresses the highlands: cool steel grain, reflective
        alb = mix(alb, vec3(0.68, 0.72, 0.78) * (0.50 + 0.70 * met),
                  clamp(met * 1.6, 0.0, 0.75));
        // wrapped light, same response curve as saturn and enceladus
        float wr    = clamp(dot(n, sun) * 0.5 + 0.5, 0.0, 1.0);
        float lit   = wr * wr;
        float mu    = clamp(dot(normalize(v_normal), view_dir), 0.0, 1.0);
        float night = 1.0 - smoothstep(0.10, 0.50, wrs);
        // floor: the dark side dims, it never goes void
        float amb   = mix(0.26, 0.08, night);
        vec3  col   = alb * ao * (amb + 0.74 * lit) * ubo.gain;
        // fresnel ice light: the terrain limb keeps a soft lift
        float fr = pow(1.0 - mu, 4.0);
        col += vec3(0.70, 0.82, 1.00) * fr * (0.12 + 0.35 * lit) * ubo.gain;
        // outermost fragments darken away toward the silhouette
        col *= 0.30 + 0.70 * smoothstep(0.0, 0.12, mu);
        // the atmospheric haze continues into the crack interiors at
        // quarter strength — its EXACT overlay color, unrelit; the
        // mask is the fine etch and the blur bowl mixed
        float inner = clamp((deep + low) * 0.5, 0.0, 1.0);
        col = mix(col, vec3(0.36, 0.16, 0.70), inner * 0.25);
        // the metal highlands catch the sun: broad specular sheen
        float mspec = pow(clamp(dot(reflect(-sun, n), view_dir), 0.0, 1.0), 24.0);
        col += vec3(0.85, 0.90, 1.00) * mspec * met * 0.45 * (0.25 + 0.75 * lit);
        // glowing water in the crack centers: emissive teal, and a
        // sun glint off the flat pool read from the smooth normal
        float wmask = smoothstep(0.78, 0.96, deep);
        if (wmask > 0.0) {{
            // pink pools running blue where the carve is deepest
            vec3  water = mix(vec3(0.70, 0.38, 0.66), vec3(0.25, 0.45, 0.95),
                              smoothstep(0.88, 0.99, deep));
            vec3  nsm   = normalize(v_normal);
            float spec  = pow(clamp(dot(reflect(-sun, nsm), view_dir), 0.0, 1.0), 48.0);
            col = mix(col, water * (0.35 + 0.65 * lit), wmask * 0.85);
            col += water * wmask * 0.25;
            col += vec3(0.90, 0.97, 1.00) * spec * wmask * (0.35 + 0.65 * lit);
        }}
        // the finest fracture filaments emit light of their own,
        // night side included — the baked detail2 mask
        float em = np.a;
        col += vec3(0.30, 0.62, 0.90) * em * 0.35;
        // soft shoulder: bright ice rolls off, it never clips white
        col = 1.0 - exp(-col * 1.25);
        // fuzzy limb: the land blends away at the horizon instead
        // of cutting an aliased hard edge against space
        float ha = smoothstep(0.0, 0.10, mu);
        fragColor = vec4(col, ha);
    }

# the marched horizon lens from enceladus — plus geysers risen from
# the LAKES: the shell ray samples the baked deep mask under each
# march point, so the columns stand exactly on the water
ModelViewProject EuropaGlowShader
    mutable gain    : f32
    mutable cam_pos : vec4f
    # jet emitters: xyz = unit surface position of a lake, w = strength
    mutable j0  : vec4f
    mutable j1  : vec4f
    mutable j2  : vec4f
    mutable j3  : vec4f
    mutable j4  : vec4f
    mutable j5  : vec4f
    mutable j6  : vec4f
    mutable j7  : vec4f
    mutable j8  : vec4f
    mutable j9  : vec4f
    mutable j10 : vec4f
    mutable j11 : vec4f
    mutable j12 : vec4f
    mutable j13 : vec4f
    mutable j14 : vec4f
    mutable j15 : vec4f
    mutable j16 : vec4f
    mutable j17 : vec4f
    mutable j18 : vec4f
    mutable j19 : vec4f
    mutable j20 : vec4f
    mutable j21 : vec4f
    mutable j22 : vec4f
    mutable j23 : vec4f
    mutable j24 : vec4f
    mutable j25 : vec4f
    mutable j26 : vec4f
    mutable j27 : vec4f
    mutable j28 : vec4f
    mutable j29 : vec4f
    mutable j30 : vec4f
    mutable j31 : vec4f

    # the packed surface bake: B is the deep-carve (lake) mask
    attrib height : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.height, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]
    attrib fragColor   : FragmentOutput[ type:typeid[ vec4f ] ]


    func gp_perm4 [ x: vec4f ] -> GLSL vec4f {
        return mod((x * 34.0 + 1.0) * x, vec4(289.0));
    }

    func gp_isqrt4 [ r: vec4f ] -> GLSL vec4f {
        return 1.79284291400159 - 0.85373472095314 * r;
    }

    func gp_gnoise [ P: vec3f ] -> GLSL float {
        vec3 Pi0 = mod(floor(P), vec3(289.0));
        vec3 Pi1 = mod(Pi0 + vec3(1.0), vec3(289.0));
        vec3 Pf0 = fract(P);
        vec3 Pf1 = Pf0 - vec3(1.0);
        vec4 ix  = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
        vec4 iy  = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
        vec4 iz0 = vec4(Pi0.z);
        vec4 iz1 = vec4(Pi1.z);
        vec4 ixy  = gp_perm4(gp_perm4(ix) + iy);
        vec4 ixy0 = gp_perm4(ixy + iz0);
        vec4 ixy1 = gp_perm4(ixy + iz1);
        vec4 gx0 = fract(ixy0 / 7.0) * 2.0 - 1.0;
        vec4 gy0 = fract(floor(ixy0 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz0 = 1.0 - abs(gx0) - abs(gy0);
        vec4 gx1 = fract(ixy1 / 7.0) * 2.0 - 1.0;
        vec4 gy1 = fract(floor(ixy1 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz1 = 1.0 - abs(gx1) - abs(gy1);
        vec4 sz0 = step(gz0, vec4(0.0));
        gx0 -= sz0 * (step(0.0, gx0) - 0.5);
        gy0 -= sz0 * (step(0.0, gy0) - 0.5);
        vec4 sz1 = step(gz1, vec4(0.0));
        gx1 -= sz1 * (step(0.0, gx1) - 0.5);
        gy1 -= sz1 * (step(0.0, gy1) - 0.5);
        vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
        vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
        vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
        vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
        vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
        vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
        vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
        vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);
        vec4 nm0 = gp_isqrt4(vec4(dot(g000,g000), dot(g010,g010), dot(g100,g100), dot(g110,g110)));
        g000 *= nm0.x; g010 *= nm0.y; g100 *= nm0.z; g110 *= nm0.w;
        vec4 nm1 = gp_isqrt4(vec4(dot(g001,g001), dot(g011,g011), dot(g101,g101), dot(g111,g111)));
        g001 *= nm1.x; g011 *= nm1.y; g101 *= nm1.z; g111 *= nm1.w;
        float n000 = dot(g000, Pf0);
        float n100 = dot(g100, vec3(Pf1.x, Pf0.y, Pf0.z));
        float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
        float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
        float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
        float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
        float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
        float n111 = dot(g111, Pf1);
        vec3  fxyz = Pf0 * Pf0 * Pf0 * (Pf0 * (Pf0 * 6.0 - 15.0) + 10.0);
        vec4  n_z  = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fxyz.z);
        vec2  n_yz = mix(n_z.xy, n_z.zw, fxyz.y);
        return mix(n_yz.x, n_yz.y, fxyz.x) * 0.5 + 0.5;
    }

    # one analytic tube: returns rgb*w in xyz and w in w — no noise
    func g_tube [ p0: vec3f, jw: f32, ro: vec3f, rd: vec3f, s_hit: f32 ] -> GLSL vec4f {
        vec3  w0 = ro - p0;
        float aa = dot(rd, p0);
        float d0 = dot(rd, w0);
        float d1 = dot(p0, w0);
        float dn = max(1.0 - aa * aa, 1e-4);
        float s9 = (aa * d1 - d0) / dn;
        float t9 = (d1 - aa * d0) / dn;
        if (s9 < 0.02) return vec4(0.0);
        float occ = 1.0 - smoothstep(s_hit - 0.10, s_hit + 0.10, s9);
        if (occ <= 0.0) return vec4(0.0);
        float tt  = max(t9, 0.0);
        float env = smoothstep(-0.015, 0.025, t9) * exp(-8.0 * tt);
        vec3  qp = w0 + s9 * rd - t9 * p0;
        float d2 = dot(qp, qp);
        float sg = 0.008 + 0.05 * tt;
        float gc = exp(-d2 / (sg * sg));
        float gh = 0.15 * exp(-d2 / (9.0 * sg * sg));
        float boost = 1.0 / sqrt(max(dn, 0.20));
        float w9 = env * boost * occ * jw * (gc + gh);
        float cm = clamp(tt / 0.45, 0.0, 1.0);
        // blue at the vent, rising into hot pink
        vec3  cc = mix(vec3(0.25, 0.45, 0.95), vec3(1.00, 0.24, 0.72), cm);
        return vec4(cc * w9, w9);
    }

    # each site is a FAN of three tubes, like the enceladus vents —
    # lone tubes were too sparse to ever hold the visible limb
    func g_jet [ J: vec4f, ro: vec3f, rd: vec3f, s_hit: f32 ] -> GLSL vec4f {
        if (J.w <= 0.0) return vec4(0.0);
        vec3 p0 = J.xyz;
        // perlin breathing: each vent emits between 20% and 70%
        float pm = gp_gnoise(vec3(p0.x * 5.0 + ubo.time * 0.008,
                                  p0.y * 5.0, p0.z * 5.0 + ubo.time * 0.005));
        float jw = J.w * (0.20 + 0.50 * pm);
        vec3 te = normalize(cross(vec3(0.0, 1.0, 0.0), p0));
        vec4 acc = g_tube(p0, jw, ro, rd, s_hit);
        acc += g_tube(normalize(p0 + te * 0.014), jw * 0.7, ro, rd, s_hit);
        acc += g_tube(normalize(p0 - te * 0.012), jw * 0.7, ro, rd, s_hit);
        return acc;
    }

    func init[]
        eye2    : vec3f [0.0f, 0.0f, 2.5f]
        target2 : vec3f [0.0f, 0.0f, 0.0f]
        up2     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        vec3  ro  = ubo.cam_pos.xyz;
        vec3  rd  = normalize(v_world_pos.xyz - ro);
        // one shell layer only: inside we see its far side, outside
        // its near side — the guard stops the outside double-count
        if (dot(ro, ro) >= 1.69 && !gl_FrontFacing) { fragColor = vec4(0.0); return; }
        // geysers: pure analytic tubes standing on the lakes — the
        // emitter list arrives from the bake as uniforms
        float b9  = dot(ro, rd);
        float c9  = dot(ro, ro) - 1.0;
        float dsc = b9 * b9 - c9;
        float s_hit = (dsc > 0.0) ? (0.0 - b9 - sqrt(dsc)) : 1e9;
        if (s_hit < 0.0) s_hit = 1e9;
        vec3  gcol = vec3(0.0);
        float gsum = 0.0;
        vec4  a9;
        a9 = g_jet(ubo.j0,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j1,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j2,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j3,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j4,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j5,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j6,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j7,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j8,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j9,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j10, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j11, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j12, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j13, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j14, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j15, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j16, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j17, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j18, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j19, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j20, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j21, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j22, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j23, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j24, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j25, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j26, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j27, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j28, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j29, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j30, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j31, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        float sum = 0.0;
        float tca = 0.0 - dot(ro, rd);
        if (tca > 0.0) {{
            vec3  pca  = ro + rd * tca;
            float rc   = length(pca);
            // the condensed rim band at HALF thickness, the glow
            // dragged farther inside the face at lower intensity;
            // the outward edge into space stays as it was
            float din  = max(1.0 - rc, 0.0);
            float inw  = 0.40 * exp(-din / 0.018) + 0.34 * exp(-din / 0.75);
            float od   = exp(-max(rc - 1.0, 0.0) / 0.014) * inw;
            float dip  = clamp(din / 0.75, 0.0, 1.0);
            float hocc = mix(1.0, 0.85, dip);
            vec3  sunh = normalize(vec3(0.85, -0.10, 0.15));
            float hw   = clamp(dot(pca / max(rc, 1e-4), sunh) * 0.5 + 0.5, 0.0, 1.0);
            float nearg = exp(-abs(rc - 1.0) / 0.006);
            sum = od * hocc * (0.06 + 0.26 * hw) * (1.0 + 4.0 * nearg);
        }}
        vec3  icy = vec3(0.36, 0.16, 0.70);
        float tot = sum + gsum;
        vec3  fc  = (icy * sum + gcol) / max(tot, 1e-5);
        fragColor = vec4(fc, clamp(tot * ubo.gain, 0.0, 0.9));
    }

# patch the active source set over the 4k equirect: a large
# perlin owns regions per source, a small one works the blend
func europa_build_maps [ H: @f32, AO: @f32, CV: @f32, EM: @f32, MM: @f32, w: i32, h: i32 ]
    names : vec string [] [ 'europa-greybase', 'europa-fracture', 'europa-crevasses',
        'europa-metal2', 'europa-fracture-blur', 'europa-fracture-detail2',
        'europa-scratch', 'europa-metal4' ]
    ns : i32 [ names.count ]
    sw : new i32 [ ns ]
    sh : new i32 [ ns ]
    so : new i32 [ ns ]
    imgs : vec Image []
    total : i32 [ 0 ]
    for [ i: i32 0, i < ns, i += 1 ]
        p9 : path '../scenes/textures/{names[i]}.png'
        im : Image [ uri: p9 ]
        imgs.push[ im ]
        sw[i] = im.width
        sh[i] = im.height
        so[i] = total
        total += im.width * im.height
    SB : new f32 [ total ]
    for [ i: i32 0, i < ns, i += 1 ]
        si : Image imgs[i]
        eu_lum[ si, @SB[ so[i] ] ]
    g0 : @f32 [ @SB[ so[0] ] ]
    g1 : @f32 [ @SB[ so[1] ] ]
    g2 : @f32 [ @SB[ so[2] ] ]
    g3 : @f32 [ @SB[ so[3] ] ]
    g4 : @f32 [ @SB[ so[4] ] ]
    g5 : @f32 [ @SB[ so[5] ] ]
    g6 : @f32 [ @SB[ so[6] ] ]
    g7 : @f32 [ @SB[ so[7] ] ]
    puts 'europa: patching {ns} sources over {w}x{h}'
    for [ y: i32 0, y < h, y += 1 ]
        v : f32 [ (f32[ y ] + 0.5) / f32[ h ] ]
        lat : f32 [ (0.5 - v) * 3.14159265 ]
        cl : f32 [ cos[ lat ] ]
        sl : f32 [ sin[ lat ] ]
        for [ x: i32 0, x < w, x += 1 ]
            u : f32 [ (f32[ x ] + 0.5) / f32[ w ] ]
            lon : f32 [ u * 6.2831853 ]
            spx : f32 [ cl * sin[ lon ] ]
            spy : f32 [ sl ]
            spz : f32 [ cl * cos[ lon ] ]
            # meridian mirror-blend factor for the u seam
            sd9 : f32 [ u ]
            if [ 1.0 - u < sd9 ] sd9 = 1.0 - u
            sk9 : f32 [ sd9 / 0.06 ]
            if [ sk9 > 1.0 ] sk9 = 1.0
            sk9 = sk9 * sk9 * (3.0 - 2.0 * sk9)
            ub9 : f32 [ u + 0.5 ]
            ub9 = ub9 - floor[ ub9 ]
            # smooth rolling plains from the grey base, two octaves
            b1 : f32 [ eu_pat[ g0, sw[0], sh[0], u, v, ub9, sk9, 0.70, 0.9, 0.9, 0.13, 0.41 ] ]
            b2 : f32 [ eu_pat[ g0, sw[0], sh[0], u, v, ub9, sk9, 2.30, 2.1, 2.1, 0.61, 0.07 ] ]
            # ONE fracture domain, three registered levels: the
            # blur presses, the sharp etches, detail2 finest —
            # a second independent domain crossed the first and
            # read as misaligned paint; it is gone
            s1 : f32 [ eu_pat[ g1, sw[1], sh[1], u, v, ub9, sk9, 1.10, 1.2, 1.8, 0.29, 0.53 ] ]
            d1 : f32 [ eu_pat[ g4, sw[4], sh[4], u, v, ub9, sk9, 1.10, 1.2, 1.8, 0.29, 0.53 ] ]
            e1 : f32 [ eu_pat[ g5, sw[5], sh[5], u, v, ub9, sk9, 1.10, 1.2, 1.8, 0.29, 0.53 ] ]
            f1 : f32 [ eu_pat[ g2, sw[2], sh[2], u, v, ub9, sk9, 0.35, 5.0, 11.0, 0.47, 0.83 ] ]
            m1 : f32 [ eu_pat[ g3, sw[3], sh[3], u, v, ub9, sk9, 1.85, 1.7, 3.4, 0.09, 0.67 ] ]
            cb1 : f32 [ 1.0 - eu_sstep[ 0.45, 0.72, d1 ] ]
            cs1 : f32 [ 1.0 - eu_sstep[ 0.30, 0.55, s1 ] ]
            em1 : f32 [ 1.0 - eu_sstep[ 0.90, 0.995, e1 ] ]
            c3  : f32 [ 1.0 - eu_sstep[ 0.15, 0.40, f1 ] ]
            # metal2 runs the opposite way: its BRIGHT streaks etch
            c4  : f32 [ eu_sstep[ 0.62, 0.85, m1 ] ]
            # region perlins move the carving families around
            r1 : f32 [ 0.35 + 0.65 * eu_sstep[ 0.35, 0.65,
                eu_gnoise[ spx * 1.3, spy * 1.3, spz * 1.3 ] ] ]
            r3 : f32 [ eu_sstep[ 0.40, 0.70,
                eu_gnoise[ spx * 2.6, spy * 2.6 + 7.0, spz * 2.6 ] ] ]
            r4 : f32 [ eu_sstep[ 0.42, 0.72,
                eu_gnoise[ spx * 1.5 + 23.0, spy * 1.5, spz * 1.5 ] ] ]
            # reduction perlin on the sharp etch: only ever removes
            rp1 : f32 [ eu_sstep[ 0.25, 0.80,
                eu_gnoise[ spx * 4.7 + 41.0, spy * 4.7, spz * 4.7 ] ] ]
            # deep is ALSO the basis for the bottom texture
            deep : f32 [ cb1 * r1 ]
            if [ deep > 1.0 ] deep = 1.0
            # thin rivers: independent shallow families
            t1 : f32 [ eu_pat[ g6, sw[6], sh[6], u, v, ub9, sk9, 0.85, 2.2, 7.7, 0.21, 0.39 ] ]
            t2 : f32 [ eu_pat[ g6, sw[6], sh[6], u, v, ub9, sk9, 2.15, 4.0, 13.0, 0.57, 0.93 ] ]
            ct1 : f32 [ 1.0 - eu_sstep[ 0.30, 0.55, t1 ] ]
            ct2 : f32 [ 1.0 - eu_sstep[ 0.28, 0.52, t2 ] ]
            det : f32 [ cs1 * (0.05 + 0.28 * cb1) * r1 * rp1
                      + em1 * (0.06 + 0.16 * cb1)
                      + ct1 * 0.030 * (0.40 + 0.60 * r1)
                      + ct2 * 0.020
                      + c3 * 0.05 * r3 + c4 * 0.06 * r4 ]
            h9 : f32 [ 0.62 + (b1 - 0.5) * 0.30 + (b2 - 0.5) * 0.12 ]
            h9 -= deep * 0.55 + det
            if [ h9 < 0.0 ] h9 = 0.0
            if [ h9 > 1.0 ] h9 = 1.0
            H[ y * w + x ] = h9
            # the fine detail IS water: filaments sit at lake
            # level immediately, wherever they mark
            lk9 : f32 [ deep ]
            if [ em1 * 0.96 > lk9 ] lk9 = em1 * 0.96
            CV[ y * w + x ] = lk9
            ev9 : f32 [ em1 * (0.40 + 0.60 * cb1) * r1 ]
            if [ ev9 > 1.0 ] ev9 = 1.0
            EM[ y * w + x ] = ev9
            # metal4 dresses the higher elevations, about a
            # quarter of the moon under its own region perlin
            hm : f32 [ eu_sstep[ 0.64, 0.70, h9 ]
                * (0.45 + 0.55 * eu_sstep[ 0.40, 0.60,
                    eu_gnoise[ spx * 1.4 + 51.0, spy * 1.4, spz * 1.4 ] ]) ]
            m4 : f32 [ eu_pat[ g7, sw[7], sh[7], u, v, ub9, sk9, 1.35, 2.2, 2.9, 0.51, 0.13 ] ]
            m4 = (m4 - 0.21) / 0.61
            if [ m4 < 0.0 ] m4 = 0.0
            if [ m4 > 1.0 ] m4 = 1.0
            MM[ y * w + x ] = hm * m4
    n9 : i32 [ w * h ]
    puts 'europa: baking AO'
    eu_bake_ao[ H, AO, w, h, 60.0 ]
    AB : new f32 [ n9 ]
    eu_blur[ AO, AB, w, h, 2 ]
# the full europa surface bake: maps packed and written to the
# bundle; runs under SILVER_EXPORT, or once live if never baked
func europa_bake []
    w9 : i32 [ 8192 ]
    h9 : i32 [ 4096 ]
    n9 : i32 [ w9 * h9 ]
    H  : new f32 [ n9 ]
    AO : new f32 [ n9 ]
    CV : new f32 [ n9 ]
    EM : new f32 [ n9 ]
    MM : new f32 [ n9 ]
    europa_build_maps[ H, AO, CV, EM, MM, w9, h9 ]
    # pack: R height hi, A height lo, G AO, B cavity
    pk : Image [ width: w9, height: h9, format: Pixel.rgba8, linear: true, wrap_u: true ]
    pd : @u8 [ pk.vdata[] ]
    for [ i: i32 0, i < n9, i += 1 ]
        b2 : i32 [ i * 4 ]
        hq : i32 [ i32[ H[ i ] * 65535.0 ] ]
        pd[ b2 ]     = u8[ hq / 256 ]
        pd[ b2 + 1 ] = u8[ AO[ i ] * 255.0 ]
        pd[ b2 + 2 ] = u8[ CV[ i ] * 255.0 ]
        pd[ b2 + 3 ] = u8[ hq % 256 ]
    # normals from central differences, wrap x clamp y
    nk : Image [ width: w9, height: h9, format: Pixel.rgba8, linear: true, wrap_u: true ]
    nd : @u8 [ nk.vdata[] ]
    for [ y: i32 0, y < h9, y += 1 ]
        ym : i32 [ (y > 0) ? y - 1 : 0 ]
        yp : i32 [ (y < h9 - 1) ? y + 1 : h9 - 1 ]
        for [ x: i32 0, x < w9, x += 1 ]
            xm : i32 [ (x > 0) ? x - 1 : w9 - 1 ]
            xp : i32 [ (x < w9 - 1) ? x + 1 : 0 ]
            dx : f32 [ (H[ y * w9 + xp ] - H[ y * w9 + xm ]) * 4.0 ]
            dy : f32 [ (H[ yp * w9 + x ] - H[ ym * w9 + x ]) * 4.0 ]
            if [ dx < -1.0 ] dx = -1.0
            if [ dx >  1.0 ] dx = 1.0
            if [ dy < -1.0 ] dy = -1.0
            if [ dy >  1.0 ] dy = 1.0
            b3 : i32 [ (y * w9 + x) * 4 ]
            nd[ b3 ]     = u8[ (0.0 - dx) * 127.0 + 128.0 ]
            nd[ b3 + 1 ] = u8[ (0.0 - dy) * 127.0 + 128.0 ]
            nd[ b3 + 2 ] = u8[ MM[ y * w9 + x ] * 255.0 ]
            nd[ b3 + 3 ] = u8[ EM[ y * w9 + x ] * 255.0 ]
    bd : path '../scenes/baked'
    bd.make_dir[]
    pk.png[ path '../scenes/baked/europa-pk.png' ]
    nk.png[ path '../scenes/baked/europa-nk.png' ]
    puts 'europa: baked maps written'

export func europa_maps []
    # token hash of the bake code: recompute only when it changes
    hv : u64 [ @europa_build_maps ]
    hb : u64 [ @europa_bake ]
    stamp : string '{hv}-{hb}'
    sp  : path '../scenes/baked/europa.hash'
    pkp : path '../scenes/baked/europa-pk.png'
    nkp : path '../scenes/baked/europa-nk.png'
    if [ sp.exists[] && pkp.exists[] && nkp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            puts 'europa: baked maps current ({stamp})'
            return
    europa_bake[]
    sp.save[ stamp, null ]

element Europa
    frost : true
    frost_sharp : true
    intern e_cur  : f32
    intern p_cur  : f32
    intern p_set  : bool
    intern eur    : EuropaShader
    intern glow   : EuropaGlowShader
    intern sky    : GaiaShader
    intern jup    : JupiterShader
    intern models : vec Model
    intern target : Render
    intern built  : bool
    # async load: worker decodes, draw waits on ready for vk work
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    # geyser plots from the bake; pushed to the shader every frame
    intern jetv   : new f32 [ 128 ]
    public color  : rgba [ r:0.002, g:0.003, b:0.006, a:1.0 ]

    # dense uv sphere built in memory: the displacement needs verts
    func build_sphere [] -> GltfModel
        nlon : i32 [ 768 ]
        nlat : i32 [ 384 ]
        n1 : i32 [ nlon + 1 ]
        m1 : i32 [ nlat + 1 ]
        nv : i32 [ n1 * m1 ]
        nv3 : i32 [ nv * 3 ]
        nv2 : i32 [ nv * 2 ]
        ni : i32 [ nlon * nlat * 6 ]
        vb : i32 [ nv3 * 4 ]
        tb : i32 [ nv2 * 4 ]
        ib : i32 [ ni * 4 ]
        tsz : i32 [ vb + vb + tb + ib ]
        data : new u8 [ tsz ]
        pf : @f32 [ data ]
        ip : @data[ vb + vb + tb ]
        iu : @u32 [ ip ]
        for [ iy: i32 0, iy <= nlat, iy += 1 ]
            lat : f32 [ -1.5707963 + f32[ iy ] * 3.14159265 / f32[ nlat ] ]
            cl : f32 [ cos[ lat ] ]
            sl : f32 [ sin[ lat ] ]
            for [ ix: i32 0, ix <= nlon, ix += 1 ]
                lon : f32 [ f32[ ix ] * 6.2831853 / f32[ nlon ] ]
                dx : f32 [ cl * cos[ lon ] ]
                dy : f32 [ sl ]
                dz : f32 [ cl * sin[ lon ] ]
                vi : i32 [ iy * n1 + ix ]
                i3 : i32 [ vi * 3 ]
                pf[ i3 ]     = dx
                pf[ i3 + 1 ] = dy
                pf[ i3 + 2 ] = dz
                pf[ nv3 + i3 ]     = dx
                pf[ nv3 + i3 + 1 ] = dy
                pf[ nv3 + i3 + 2 ] = dz
                i2 : i32 [ nv3 * 2 + vi * 2 ]
                pf[ i2 ]     = f32[ ix ] / f32[ nlon ]
                pf[ i2 + 1 ] = 1.0 - f32[ iy ] / f32[ nlat ]
        k : i32 [ 0 ]
        for [ iy: i32 0, iy < nlat, iy += 1 ]
            for [ ix: i32 0, ix < nlon, ix += 1 ]
                i0 : i32 [ iy * n1 + ix ]
                iu[ k ]     = u32[ i0 ]
                iu[ k + 1 ] = u32[ i0 + n1 ]
                iu[ k + 2 ] = u32[ i0 + 1 ]
                iu[ k + 3 ] = u32[ i0 + 1 ]
                iu[ k + 4 ] = u32[ i0 + n1 ]
                iu[ k + 5 ] = u32[ i0 + n1 + 1 ]
                k += 6
        bufs : vec GltfBuffer []
        bufs += GltfBuffer [ byteLength: u64[ tsz ], data: data ]
        views : vec BufferView []
        views += BufferView [ buffer: 0, byteOffset: 0,            byteLength: vb ]
        views += BufferView [ buffer: 0, byteOffset: vb,           byteLength: vb ]
        views += BufferView [ buffer: 0, byteOffset: vb + vb,      byteLength: tb ]
        views += BufferView [ buffer: 0, byteOffset: vb + vb + tb, byteLength: ib ]
        accs : vec Accessor []
        accs += Accessor [ bufferView: 0, componentType: ComponentType.FLOAT, type: CompoundType.VEC3, count: nv ]
        accs += Accessor [ bufferView: 1, componentType: ComponentType.FLOAT, type: CompoundType.VEC3, count: nv ]
        accs += Accessor [ bufferView: 2, componentType: ComponentType.FLOAT, type: CompoundType.VEC2, count: nv ]
        accs += Accessor [ bufferView: 3, componentType: ComponentType.UNSIGNED_INT, type: CompoundType.SCALAR, count: ni ]
        am : map i64 [ string ] [ ]
        am[ 'POSITION' ]   = i64[ 0 ]
        am[ 'NORMAL' ]     = i64[ 1 ]
        am[ 'TEXCOORD_0' ] = i64[ 2 ]
        prs : vec Primitive []
        prs += Primitive [ name: 'europa', attributes: am, indices: u64[ 3 ], material: 0, mode: Mode.TRIANGLES ]
        mshs : vec Mesh []
        mshs += Mesh [ name: 'europa', primitives: prs ]
        nds : vec Node []
        nds += Node [ name: 'europa', mesh: 0 ]
        sn : vec i64 []
        sn += 0
        scns : vec Scene []
        scns += Scene [ name: 'scene', nodes: sn ]
        gm : GltfModel [ nodes: nds, meshes: mshs, scenes: scns, scene: 0,
            buffers: bufs, bufferViews: views, accessors: accs ]
        return gm

    func build_models[]
        built = true
        gltf_path : path '../scenes/models/earth.gltf'
        gltf      : GltfModel.open[ gltf_path ]
        pkp : path '../scenes/baked/europa-pk.png'
        nkp : path '../scenes/baked/europa-nk.png'
        if [ !pkp.exists[] || !nkp.exists[] ]
            puts 'europa: no baked maps — baking live (SILVER_EXPORT=1 bakes at build)'
            europa_bake[]
        pk : Image [ uri: pkp, linear: true, wrap_u: true ]
        nk : Image [ uri: nkp, linear: true, wrap_u: true ]
        w9 : i32 [ pk.width ]
        h9 : i32 [ pk.height ]
        pd9 : @u8 [ pk.vdata[] ]
        e_gltf : build_sphere[]
        e_gltf.hold[]
        e_gltf.compute_worlds[]
        eur = EuropaShader [ vk: vk ]
        e_samplers : map Image [string] [
            'height': pk,
            'nrm_a':  nk
        ]
        eur_model : Model [ vk: vk, w: ux, id: e_gltf, s: eur, samplers: e_samplers, straight_alpha: true ]
        # jet emitters: the strongest lake cells, one per neighborhood
        cw : i32 [ 96 ]
        ch : i32 [ 48 ]
        cavg : new f32 [ cw * ch ]
        for [ cy: i32 0, cy < ch, cy += 1 ]
            for [ cx: i32 0, cx < cw, cx += 1 ]
                y0 : i32 [ cy * h9 / ch ]
                y1 : i32 [ (cy + 1) * h9 / ch ]
                x0 : i32 [ cx * w9 / cw ]
                x1 : i32 [ (cx + 1) * w9 / cw ]
                mx9 : f32 [ 0.0 ]
                for [ yy: i32 y0, yy < y1, yy += 4 ]
                    for [ xx: i32 x0, xx < x1, xx += 4 ]
                        cv9 : f32 [ f32[ pd9[ (yy * w9 + xx) * 4 + 2 ] ] / 255.0 ]
                        if [ cv9 > mx9 ] mx9 = cv9
                # the MAX finds a lake in the cell; averages drowned
                # thin water webs below any threshold
                cavg[ cy * cw + cx ] = mx9
        for [ i: i32 0, i < 128, i += 1 ] jetv[i] = 0.0
        used : new i32 [ cw * ch ]
        for [ i: i32 0, i < cw * ch, i += 1 ] used[i] = 0
        # random lake plots, enceladus-style: seeded picks over every
        # qualifying cell, spaced by the suppression grid — the scan
        # order must never decide, or they all pool at one pole
        nj : i32 [ 0 ]
        seed : i64 [ 48271 ]
        for [ t: i32 0, t < 800, t += 1 ]
            if [ nj >= 32 ] break
            seed = (seed * 1103515245 + 12345) % 2147483647
            ci : i32 [ i32[ seed % i64[ cw * ch ] ] ]
            if [ used[ ci ] != 0 ] continue
            if [ cavg[ ci ] < 0.60 ] continue
            cy9 : i32 [ ci / cw ]
            cx9 : i32 [ ci % cw ]
            # anywhere but the polar caps
            if [ cy9 < 8 || cy9 >= 40 ] continue
            for [ dyi: i32 0, dyi < 3, dyi += 1 ]
                for [ dxi: i32 0, dxi < 3, dxi += 1 ]
                    ny9 : i32 [ cy9 + dyi - 1 ]
                    nx9 : i32 [ (cx9 + dxi - 1 + cw) % cw ]
                    if [ ny9 >= 0 && ny9 < ch ] used[ ny9 * cw + nx9 ] = 1
            U : f32 [ (f32[ cx9 ] + 0.5) / f32[ cw ] ]
            V : f32 [ (f32[ cy9 ] + 0.5) / f32[ ch ] ]
            latj : f32 [ (0.5 - V) * 3.14159265 ]
            lonj : f32 [ (1.0 - U) * 6.2831853 ]
            clj : f32 [ cos[ latj ] ]
            st : f32 [ 0.7 + cavg[ ci ] * 0.4 ]
            if [ st > 1.1 ] st = 1.1
            jetv[ nj * 4 ]     = clj * cos[ lonj ]
            jetv[ nj * 4 + 1 ] = sin[ latj ]
            jetv[ nj * 4 + 2 ] = clj * sin[ lonj ]
            jetv[ nj * 4 + 3 ] = st
            nj += 1
        puts 'europa: {nj} geyser sites'
        puts 'europa: j0 {jetv[0]} {jetv[1]} {jetv[2]} w{jetv[3]}'
        puts 'europa: j1 {jetv[4]} {jetv[5]} {jetv[6]} w{jetv[7]}'
        puts 'europa: j2 {jetv[8]} {jetv[9]} {jetv[10]} w{jetv[11]}'
        glow = EuropaGlowShader [ vk: vk ]
        gl_samplers : map Image [string] [
            'height': pk
        ]
        glow_model : Model [ vk: vk, w: ux, id: gltf, s: glow, samplers: gl_samplers,
            straight_alpha: true, cull_none: true, depth_no_test: true ]
        # storm map: sobel contrast of the jupiter texture, baked at
        # startup — discharges live where the bands shear hardest
        ji : Image [ uri: path '../scenes/textures/jupiter-color.png' ]
        jw : i32 [ ji.width ]
        jh : i32 [ ji.height ]
        jl : new f32 [ jw * jh ]
        eu_lum[ ji, jl ]
        # the sobel edge, then MAX'd with how dark the band is: the
        # edges give skinny beams along the shear lines and nothing
        # between them, and the deep belts fill that out. baked here,
        # so the shader stays one texture read
        jg : new f32 [ jw * jh ]
        for [ y: i32 0, y < jh, y += 1 ]
            ym : i32 [ (y > 0) ? y - 1 : 0 ]
            yp : i32 [ (y < jh - 1) ? y + 1 : jh - 1 ]
            for [ x: i32 0, x < jw, x += 1 ]
                xm : i32 [ (x > 0) ? x - 1 : jw - 1 ]
                xp : i32 [ (x < jw - 1) ? x + 1 : 0 ]
                gx : f32 [ jl[ y * jw + xp ] - jl[ y * jw + xm ] ]
                gy : f32 [ jl[ yp * jw + x ] - jl[ ym * jw + x ] ]
                mg : f32 [ sqrt[ gx * gx + gy * gy ] * 4.0 ]
                if [ mg > 1.0 ] mg = 1.0
                # distance BELOW 0.2 luminance, negatives clamped off
                dk : f32 [ (0.2 - jl[ y * jw + x ]) / 0.2 ]
                if [ dk < 0.0 ] dk = 0.0
                if [ dk > 1.0 ] dk = 1.0
                jg[ y * jw + x ] = (mg > dk) ? mg : dk
        # gaussian it here too -- the shader was paying five taps a
        # pixel for a blur that never changes
        jt : new f32 [ jw * jh ]
        eu_blur[ jg, jt, jw, jh, 4 ]
        sbi : Image [ width: jw, height: jh, format: Pixel.rgba8, linear: true, wrap_u: true ]
        sd : @u8 [ sbi.vdata[] ]
        for [ i: i32 0, i < jw * jh, i += 1 ]
            v9 : f32 [ jt[ i ] ]
            if [ v9 < 0.0 ] v9 = 0.0
            if [ v9 > 1.0 ] v9 = 1.0
            b4 : i32 [ i * 4 ]
            sd[ b4 ]     = u8[ v9 * 255.0 ]
            sd[ b4 + 1 ] = 0
            sd[ b4 + 2 ] = 0
            sd[ b4 + 3 ] = 255
        jup = JupiterShader [ vk: vk ]
        j_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/jupiter-color.png', surface: TitanSurface.color,
                wrap_u: true ],
            'height': sbi
        ]
        jup_model : Model [ vk: vk, w: ux, id: gltf, s: jup, samplers: j_samplers, straight_alpha: true ]
        sky       = GaiaShader [ vk: vk ]
        sky_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/gaia.png', surface: GaiaSurface.color ]
        ]
        sky_model : Model [ vk: vk, w: ux, id: gltf, s: sky, samplers: sky_samplers,
            straight_alpha: true, cull_none: true ]
        models = vec Model [] [sky_model, jup_model, eur_model, glow_model ]

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        ux.element_targets[ id ] = target

    # unregister only; we keep our ref so the GPU graph outlives the frame
    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    # ice light: pale cold panes, glacier blue accents
    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#000a',       # editor pane background
            '#140a2a80':  '#0e141a80',   # console pane background
            '#ff6a2e55':  '#7ac8e855',   # search highlight fill
            '#220022aa':  '#0c1216aa',   # run console base fill
            '#614':       '#28343e',     # TButtons / nav rest fill
            '#413':       '#1e2830',     # TButtons hover fill
            '#826':       '#3e5060',     # TButtons lit / nav selected
            '#625a':      '#268a',       # bottom status bar fill
            '#8af2':      '#8cf2',       # status bar inner glow
            '#425':       '#16a8',       # editor selection color
            '#ede3':      '#ade3',       # editor selection border
            '#44225588':  '#16a4',       # editor line highlight
            '#ff3a6a22':  '#7ac8e822',   # commit tab fill
            '#ff3a6a44':  '#7ac8e844',   # commit tab hover fill
            '#ff5a8a99':  '#7ac8e899',   # commit tab border
            '#ff7aa4cc':  '#a8e0f4cc'    # commit tab hover border
        ]

    func load_bg [ arg: object :: t: Europa ]
        t0 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg start at {t0}'
        t.build_models[]
        t1 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg done in {t1 - t0}ms at {t1}'
        t.ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : vec Au []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: lambda load_bg[ a ], work: w9 ]
        if [ !ready ] return
        create_target[]
        orbit[]

    func orbit[]
        # surface flyover like enceladus: ice fills the frame at low
        # orbit and jupiter hangs above the limb ahead
        time : 0.0 - ux.time * 730.0
        if [ time == 0.0 ] time = -54.0
        a_t      : f32 [ (ux.orbit_mode == OrbitView.low)  ? 0.25 :
                         (ux.orbit_mode == OrbitView.high) ? 0.70 : 2.60 ]
        if [ e_cur == 0.0 ] e_cur = a_t
        e_cur = filter_n[ e_cur, a_t, 0.08, ux.frame_factor ]
        altitude : f32 [ e_cur ]
        eye_dist : f32 [ 1.0 + altitude ]
        t_deg    : f32 [ (ux.angle_mode == ViewAngle.flat)   ? 0.0 :
                         (ux.angle_mode == ViewAngle.angled) ? 60.0 : 76.0 ]
        if [ p_cur == 0.0 && !p_set ] p_cur = t_deg
        p_set    = true
        p_cur    = filter_n[ p_cur, t_deg, 0.08, ux.frame_factor ]
        ux.orbit_moving = abs[ e_cur - a_t ] > 0.0004 || abs[ p_cur - t_deg ] > 0.05
        tilt     : f32 [ radians[ p_cur ] ]
        aspect   : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]
        orbit_a : radians[ time ]
        co      : cos[ orbit_a ]
        so      : sin[ orbit_a ]
        ex_l  : f32 [ 0.0 ]
        ey_l  : f32 [ 0.0 ]
        ez_l  : f32 [ eye_dist ]
        fx_l  : f32 [ -sin[ tilt ] ]
        fy_l  : f32 [ 0.0 ]
        fz_l  : f32 [ -cos[ tilt ] ]
        tx_l  : f32 [ ex_l + fx_l * 2.0 ]
        ty_l  : f32 [ ey_l + fy_l * 2.0 ]
        tz_l  : f32 [ ez_l + fz_l * 2.0 ]
        _eye   : vec3f [  co * ex_l + so * ez_l, ey_l, -so * ex_l + co * ez_l ]
        _tgt   : vec3f [  co * tx_l + so * tz_l, ty_l, -so * tx_l + co * tz_l ]
        _up    : vec3f [  co, 0.0, 0.0 - so ]

        _proj  : mat4f.perspective[ radians[ 60.0 ], aspect, 0.001, 60.0 ]
        _view  : mat4f.look_at    [ _eye, _tgt, _up ]

        eur.model    = mat4f.identity[]
        eur.view     = _view
        eur.proj     = _proj
        eur.gain     = 1.5
        eur.displace = 0.016
        eur.cam_pos  = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]

        # the glow shell just past the terrain, whole sky from inside
        gm9 : mat4f.identity[]
        gm9 = gm9.scale [ vec3f [ 1.30, 1.30, 1.30 ] ]
        glow.model   = gm9
        glow.view    = _view
        glow.proj    = _proj
        glow.gain    = 1.0
        glow.time    = ux.time * 60000.0
        glow.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        # the emitter list re-arms every frame like cam_pos: set once
        # at build, the values died with the frame pool
        glow.j0  = vec4f [ jetv[0] + 0.0,   jetv[1] + 0.0,   jetv[2] + 0.0,   jetv[3] + 0.0]
        glow.j1  = vec4f [ jetv[4] + 0.0,   jetv[5] + 0.0,   jetv[6] + 0.0,   jetv[7] + 0.0]
        glow.j2  = vec4f [ jetv[8] + 0.0,   jetv[9] + 0.0,   jetv[10] + 0.0,  jetv[11] + 0.0]
        glow.j3  = vec4f [ jetv[12] + 0.0,  jetv[13] + 0.0,  jetv[14] + 0.0,  jetv[15] + 0.0]
        glow.j4  = vec4f [ jetv[16] + 0.0,  jetv[17] + 0.0,  jetv[18] + 0.0,  jetv[19] + 0.0]
        glow.j5  = vec4f [ jetv[20] + 0.0,  jetv[21] + 0.0,  jetv[22] + 0.0,  jetv[23] + 0.0]
        glow.j6  = vec4f [ jetv[24] + 0.0,  jetv[25] + 0.0,  jetv[26] + 0.0,  jetv[27] + 0.0]
        glow.j7  = vec4f [ jetv[28] + 0.0,  jetv[29] + 0.0,  jetv[30] + 0.0,  jetv[31] + 0.0]
        glow.j8  = vec4f [ jetv[32] + 0.0,  jetv[33] + 0.0,  jetv[34] + 0.0,  jetv[35] + 0.0]
        glow.j9  = vec4f [ jetv[36] + 0.0,  jetv[37] + 0.0,  jetv[38] + 0.0,  jetv[39] + 0.0]
        glow.j10 = vec4f [ jetv[40] + 0.0,  jetv[41] + 0.0,  jetv[42] + 0.0,  jetv[43] + 0.0]
        glow.j11 = vec4f [ jetv[44] + 0.0,  jetv[45] + 0.0,  jetv[46] + 0.0,  jetv[47] + 0.0]
        glow.j12 = vec4f [ jetv[48] + 0.0,  jetv[49] + 0.0,  jetv[50] + 0.0,  jetv[51] + 0.0]
        glow.j13 = vec4f [ jetv[52] + 0.0,  jetv[53] + 0.0,  jetv[54] + 0.0,  jetv[55] + 0.0]
        glow.j14 = vec4f [ jetv[56] + 0.0,  jetv[57] + 0.0,  jetv[58] + 0.0,  jetv[59] + 0.0]
        glow.j15 = vec4f [ jetv[60] + 0.0,  jetv[61] + 0.0,  jetv[62] + 0.0,  jetv[63] + 0.0]
        glow.j16 = vec4f [ jetv[64] + 0.0,  jetv[65] + 0.0,  jetv[66] + 0.0,  jetv[67] + 0.0]
        glow.j17 = vec4f [ jetv[68] + 0.0,  jetv[69] + 0.0,  jetv[70] + 0.0,  jetv[71] + 0.0]
        glow.j18 = vec4f [ jetv[72] + 0.0,  jetv[73] + 0.0,  jetv[74] + 0.0,  jetv[75] + 0.0]
        glow.j19 = vec4f [ jetv[76] + 0.0,  jetv[77] + 0.0,  jetv[78] + 0.0,  jetv[79] + 0.0]
        glow.j20 = vec4f [ jetv[80] + 0.0,  jetv[81] + 0.0,  jetv[82] + 0.0,  jetv[83] + 0.0]
        glow.j21 = vec4f [ jetv[84] + 0.0,  jetv[85] + 0.0,  jetv[86] + 0.0,  jetv[87] + 0.0]
        glow.j22 = vec4f [ jetv[88] + 0.0,  jetv[89] + 0.0,  jetv[90] + 0.0,  jetv[91] + 0.0]
        glow.j23 = vec4f [ jetv[92] + 0.0,  jetv[93] + 0.0,  jetv[94] + 0.0,  jetv[95] + 0.0]
        glow.j24 = vec4f [ jetv[96] + 0.0,  jetv[97] + 0.0,  jetv[98] + 0.0,  jetv[99] + 0.0]
        glow.j25 = vec4f [ jetv[100] + 0.0, jetv[101] + 0.0, jetv[102] + 0.0, jetv[103] + 0.0]
        glow.j26 = vec4f [ jetv[104] + 0.0, jetv[105] + 0.0, jetv[106] + 0.0, jetv[107] + 0.0]
        glow.j27 = vec4f [ jetv[108] + 0.0, jetv[109] + 0.0, jetv[110] + 0.0, jetv[111] + 0.0]
        glow.j28 = vec4f [ jetv[112] + 0.0, jetv[113] + 0.0, jetv[114] + 0.0, jetv[115] + 0.0]
        glow.j29 = vec4f [ jetv[116] + 0.0, jetv[117] + 0.0, jetv[118] + 0.0, jetv[119] + 0.0]
        glow.j30 = vec4f [ jetv[120] + 0.0, jetv[121] + 0.0, jetv[122] + 0.0, jetv[123] + 0.0]
        glow.j31 = vec4f [ jetv[124] + 0.0, jetv[125] + 0.0, jetv[126] + 0.0, jetv[127] + 0.0]

        # the galaxy wraps the whole scene from a big inner sphere
        skq9 : vec4f [ 1.0, 0.0, 0.0, radians[ 45.0 ] ]
        skq  : quatf [ skq9 ]
        skm : mat4f.identity[]
        skm = skm.rotate[ skq ]
        skm = skm.scale [ vec3f [ 30.0, 30.0, 30.0 ] ]
        sky.model = skm
        sky.view  = _view
        sky.proj  = _proj
        sky.gain  = 0.45
        sky.time  = ux.time * 60000.0

        # jupiter fixed in the sky above the limb, huge and near
        # upright — the offset rides the SAME orbit rotation as the
        # eye or the camera walks away from it
        rise   : f32 [ radians[ 14.0 ] ]
        aim    : f32 [ tilt + rise ]
        s_dist : f32 [ 24.0 ]
        sx9    : f32 [ 0.0 - s_dist * sin[ aim ] ]
        sz9    : f32 [ eye_dist - s_dist * cos[ aim ] ]
        s_off  : vec3f [ co * sx9 + so * sz9, 0.0, (0.0 - so) * sx9 + co * sz9 ]
        s_sc   : vec3f [ 11.0, 11.0, 11.0 ]
        s_axis : vec4f [ 0.0, 0.0, 1.0, radians[ -3.0 ] ]
        sq     : quatf [ s_axis ]
        s_tip  : vec4f [ 1.0, 0.0, 0.0, radians[ 8.0 ] ]
        sq3    : quatf [ s_tip ]
        # ONE EIGHTH the old 6000: a gas giant that turned once every
        # fifteen seconds at ludacrous, while its lit face took minutes
        # to move, read as a spinning ball under a fixed lamp
        s_spin : vec4f [ 0.0, 1.0, 0.0, radians[ ux.time * 375.0 ] ]
        sq2    : quatf [ s_spin ]
        sm : mat4f.identity[]
        sm = sm.translate[ s_off ]
        sm = sm.rotate   [ sq3 ]
        sm = sm.rotate   [ sq ]
        sm = sm.rotate   [ sq2 ]
        sm = sm.scale    [ s_sc ]
        jup.model    = sm
        jup.view     = _view
        jup.proj     = _proj
        jup.gain     = 0.75
        jup.cam_pos  = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        # sodium orange against hydrogen blue -- the uniforms default to
        # black, so an unset palette means no discharges at all
        # w 0.0 = an EVENT. lightning fires and dies; this is the
        # behaviour that lane was hardcoded to before it existed
        jup.pc_a     = vec4f [ 1.00, 0.46, 0.13, 0.0 ]
        # w is longitude drift. 0.00015 is a lap every 28 seconds at
        # ludacrous -- storms carried by the wind, not racing it
        jup.pc_b     = vec4f [ 0.30, 0.60, 1.00, 0.00015 ]
        # z = additive discharge gain, w = lift toward white (unused).
        # pctl.w 1.0 keeps this a NIGHT-side effect; wctl2.w 60.0 is
        # the pulse frequency down the latitude, as it has always been
        jup.pstr     = vec4f [ 1.0, 1.0, 4.2, 0.0 ]
        # x is the discharge threshold. MEASURED against the actual
        # noise, not guessed: 0.69 fires on 0.062 of the disk and
        # 0.871 on 0.0078, which is an eighth of the storms. the
        # relation is nowhere near linear -- 0.80 is only a third off
        jup.pctl     = vec4f [ 0.871, 0.9, 2.0, 1.0 ]
        jup.wctl     = vec4f [ 0.16, 0.010, 56.55, 0.25 ]
        # z is the band ping-pong rate, a QUARTER of the old 0.0125.
        # at ludacrous that was shearing back and forth about three
        # times a second, which reads as the deck spinning, not wind
        jup.wctl2    = vec4f [ 0.55, 1.6, 0.0015625, 60.0 ]
        # w 0.0: jupiter takes no live tint at all
        jup.tint     = vec4f [ 1.0, 1.0, 1.0, 0.0 ]
        jup.pfire    = vec4f [ 1.0, 0.6, 0.2, 0.0 ]
        jup.pfire2   = vec4f [ 1.0, 0.9, 0.7, 0.0 ]
        jup.time     = ux.time * 60000.0


# ======================================================================
# Terra: a GROUND STAGE on Mars, not a globe. mars-height carries the
# real geography and the clone patches add the resolution it does not
# have -- 8192 across the planet is 400m a texel, which is a smooth
# ramp at walking distance. its own enum: a binding added to an
# inherited shader lands on the parent's slot
# MOLA elevations are metres against the areoid; this turns them into
# sphere radii. everything downstream is in radii
func mars_radius [] -> f32
    return 3390000.0

# the Valles Marineris box, in our uv space. the valley runs roughly
# 255E to 335E just south of the equator; this is 240E..340E by
# 15N..25S, which holds it end to end with room to orbit along it.
# u = 0 is longitude 180, so 240E lands at 0.1667
func mars_vu0 [] -> f32
    return 0.166667
func mars_vu1 [] -> f32
    return 0.444444
func mars_vv0 [] -> f32
    return 0.416667
func mars_vv1 [] -> f32
    return 0.638889

# packing range for the baked height, in sphere radii. MOLA runs
# -8208m (Hellas floor) to +21229m (Olympus summit); this spans that
# with a little headroom either side
func mars_hmin [] -> f32
    return -0.0028
func mars_hmax [] -> f32
    return 0.0068

# the slope either baked component carries before it clamps. real
# martian slopes averaged over 463m stay well under 1.0, so 1.5 keeps
# far more precision than the 4.0 a synthetic field needed
func mars_smax [] -> f32
    return 1.5

# relief exaggeration. applied to height AND slope TOGETHER, in the
# bake, so the shading can never disagree with the silhouette. 1.0 is
# true scale -- and true scale is subtle: all of Mars is 0.87% of its
# own radius, so from orbit a real planet looks nearly smooth
func mars_exag [] -> f32
    return 1.0

# MOLA MEGDR, 128 pixels per degree: 16 tiles of 11520 x 5632, 16-bit
# signed big-endian metres. four latitude bands running down from +88,
# four longitudes running east from 0. assembled here into one
# 46080 x 22528 grid, north row first, longitude 0 at column 0
func mola_load [ M: @i16 ] -> bool
    # the export runs with cwd at the bundle, so a relative path finds
    # nothing. SILVER is the source root and is set for every build
    root : path.path_startup[]
    ev : symbol [ getenv[ 'SILVER' ] ]
    if [ ev ] root = path [ string [ ev ] ]
    if [ !root ]
        puts 'mola: no SILVER root — cannot locate the tiles'
        return false
    puts 'mola: reading tiles from {root}/checkout/mola'
    bands : vec string [] [ '88n', '44n', '00n', '44s' ]
    lons  : vec string [] [ '000', '090', '180', '270' ]
    tw : i32 [ 11520 ]
    th : i32 [ 5632 ]
    gw : i32 [ 46080 ]
    row : new u8 [ tw * 2 ]
    for [ b: i32 0, b < 4, b += 1 ]
        for [ l: i32 0, l < 4, l += 1 ]
            fn : string '{root}/checkout/mola/megt{bands[b]}{lons[l]}hb.img'
            fp : handle [ fopen[ fn.chars, 'rb' ] ]
            if [ !fp ]
                puts 'mola: cannot open {fn}'
                return false
            for [ y: i32 0, y < th, y += 1 ]
                nr : i32 [ i32[ fread[ @row[0], 1, tw * 2, fp ] ] ]
                if [ nr < tw * 2 ]
                    puts 'mola: short read in {fn} row {y}'
                    fclose[ fp ]
                    return false
                base : i32 [ (b * th + y) * gw + l * tw ]
                for [ x: i32 0, x < tw, x += 1 ]
                    # big-endian, and the sign has to be put back by
                    # hand: the high byte carries it
                    v : i32 [ i32[ row[ x * 2 ] ] * 256 + i32[ row[ x * 2 + 1 ] ] ]
                    if [ v > 32767 ] v = v - 65536
                    M[ base + x ] = i16[ v ]
            fclose[ fp ]
    puts 'mola: loaded 16 tiles into 46080x22528'
    return true

# our uv space is not MOLA's: u = 0 sits at longitude 180, and v spans
# the full pole-to-pole 180 while MOLA stops at +/-88. so a column is
# a pure rotation by half the grid, and a row is an offset of 256 with
# the two-degree polar caps clamped to the nearest real data
func mola_at [ M: @i16, ux: i32, uy: i32 ] -> f32
    gw : i32 [ 46080 ]
    gh : i32 [ 22528 ]
    mx : i32 [ ux - 23040 ]
    if [ mx < 0 ] mx = mx + gw
    if [ mx >= gw ] mx = mx - gw
    my : i32 [ uy - 256 ]
    if [ my < 0 ] my = 0
    if [ my >= gh ] my = gh - 1
    return f32[ M[ my * gw + mx ] ]

# CPU twin of the shader's old height field. the guide steers the patch
# exactly as it did per-fragment, but now it runs ONCE at 8192x4096
# instead of three times per pixel per frame
func mars_build_height [ H: @f32, w: i32, h: i32 ]
    bim : Image [ uri: path '../scenes/textures/mars-height-8192x4096.png' ]
    bw : i32 [ bim.width ]
    bh : i32 [ bim.height ]
    B : new f32 [ bw * bh ]
    eu_lum[ bim, B ]

    names : vec string [] [ 'europa-caldera', 'europa-stardunes', 'europa-grain-granite' ]
    ns : i32 [ names.count ]
    sw : new i32 [ ns ]
    sh : new i32 [ ns ]
    so : new i32 [ ns ]
    imgs : vec Image []
    total : i32 [ 0 ]
    for [ i: i32 0, i < ns, i += 1 ]
        p9 : path '../scenes/textures/{names[i]}.png'
        im : Image [ uri: p9 ]
        imgs.push[ im ]
        sw[i] = im.width
        sh[i] = im.height
        so[i] = total
        total += im.width * im.height
    SB : new f32 [ total ]
    for [ i: i32 0, i < ns, i += 1 ]
        si : Image imgs[i]
        eu_lum[ si, @SB[ so[i] ] ]
    g0 : @f32 [ @SB[ so[0] ] ]
    g1 : @f32 [ @SB[ so[1] ] ]
    g2 : @f32 [ @SB[ so[2] ] ]

    disp : f32 [ 0.0088 ]
    detl : f32 [ 0.00030 ]
    ee : f32 [ 1.0 / 8192.0 ]
    puts 'mars: patching {ns} sources over {w}x{h}'
    for [ y: i32 0, y < h, y += 1 ]
        v : f32 [ (f32[ y ] + 0.5) / f32[ h ] ]
        for [ x: i32 0, x < w, x += 1 ]
            u : f32 [ (f32[ x ] + 0.5) / f32[ w ] ]
            # the guide, read with the same offset the shader uses to
            # line the height map up with the color map
            bu : f32 [ u - 0.0635 ]
            b : f32 [ eu_bilin[ B, bw, bh, bu, v ] ]
            gx : f32 [ eu_bilin[ B, bw, bh, bu + ee, v ] - eu_bilin[ B, bw, bh, bu - ee, v ] ]
            gy : f32 [ eu_bilin[ B, bw, bh, bu, v + ee ] - eu_bilin[ B, bw, bh, bu, v - ee ] ]
            rug : f32 [ sqrt[ gx * gx + gy * gy ] * 55.0 ]
            if [ rug > 1.0 ] rug = 1.0
            # detail follows the guide's own slope: torn ground gets the
            # roughness, the plains stay smooth. never zero, or the
            # flats turn to glass
            amp : f32 [ 0.22 + 0.78 * rug ]
            # meridian mirror-blend: the wrap lands mid-tile under these
            # rotations, so a half-turn clone covers the seam band
            sd : f32 [ (u < 1.0 - u) ? u : 1.0 - u ]
            sk : f32 [ eu_sstep[ 0.0, 0.06, sd ] ]
            ub : f32 [ u + 0.5 ]
            if [ ub > 1.0 ] ub = ub - 1.0
            sp3 : f32 [ 0.0 ]
            # four octaves, each source on its own angle and scale so no
            # two grains line up with each other or with the equirect
            for [ oi: i32 0, oi < 4, oi += 1 ]
                oc : f32 [ (oi == 0) ? 1.0 : ((oi == 1) ? 3.7 : ((oi == 2) ? 13.0 : 47.0)) ]
                wt : f32 [ (oi == 0) ? 1.0 : ((oi == 1) ? 0.46 : ((oi == 2) ? 0.21 : 0.09)) ]
                pa : f32 [ eu_pat[ g0, sw[0], sh[0], u, v, ub, sk, 0.70,  61.0 * oc,  61.0 * oc, 0.13, 0.41 ] ]
                pb : f32 [ eu_pat[ g1, sw[1], sh[1], u, v, ub, sk, 2.30,  97.0 * oc,  97.0 * oc, 0.61, 0.07 ] ]
                pc : f32 [ eu_pat[ g2, sw[2], sh[2], u, v, ub, sk, 4.10, 149.0 * oc, 149.0 * oc, 0.29, 0.83 ] ]
                # the noise decides which source owns each region; a
                # single lerp would leave the third as a constant wash
                w1 : f32 [ eu_gnoise[ u * 1.7 * oc, v * 1.7 * oc, 0.0 ] ]
                w3 : f32 [ eu_gnoise[ u * 0.9 * oc + 5.0, v * 0.9 * oc + 61.0, 13.0 ] ]
                w2 : f32 [ eu_gnoise[ u * 3.9 * oc + 19.0, v * 3.9 * oc + 7.0, 41.0 ] ]
                ab : f32 [ pa + (pb - pa) * eu_sstep[ 0.30, 0.70, w1 ] ]
                cc : f32 [ ab + (pc - ab) * eu_sstep[ 0.35, 0.75, w3 ] ]
                sp3 += (cc * (0.80 + 0.40 * w2) - 0.5) * wt
            H[ y * w + x ] = b * disp + sp3 * detl * amp

func mars_bake []
    w9 : i32 [ 8192 ]
    h9 : i32 [ 4096 ]
    n9 : i32 [ w9 * h9 ]
    H : new f32 [ n9 ]
    mars_build_height[ H, w9, h9 ]
    hmx : f32 [ mars_hmax[] ]
    # height packed 16-bit across R and A: 8 bits of 0.0104 radii is a
    # 40m stair, and the terminator finds every one of them
    pk : Image [ width: w9, height: h9, format: Pixel.rgba8, linear: true, wrap_u: true ]
    pd : @u8 [ pk.vdata[] ]
    for [ i: i32 0, i < n9, i += 1 ]
        t : f32 [ H[ i ] / hmx ]
        if [ t < 0.0 ] t = 0.0
        if [ t > 1.0 ] t = 1.0
        hq : i32 [ i32[ t * 65535.0 ] ]
        b2 : i32 [ i * 4 ]
        pd[ b2 ]     = u8[ hq / 256 ]
        pd[ b2 + 1 ] = 0
        pd[ b2 + 2 ] = 0
        pd[ b2 + 3 ] = u8[ hq % 256 ]
    # normals as real surface SLOPE, not a fudge: dH over the world
    # distance between texels, so the shading matches the displacement
    smx : f32 [ mars_smax[] ]
    du : f32 [ 6.2831853 / f32[ w9 ] ]
    dv : f32 [ 3.1415927 / f32[ h9 ] ]
    nk : Image [ width: w9, height: h9, format: Pixel.rgba8, linear: true, wrap_u: true ]
    nd : @u8 [ nk.vdata[] ]
    for [ y: i32 0, y < h9, y += 1 ]
        ym : i32 [ (y > 0) ? y - 1 : 0 ]
        yp : i32 [ (y < h9 - 1) ? y + 1 : h9 - 1 ]
        # meridians converge: a degree of longitude is cos(lat) as wide
        lat9 : f32 [ (0.5 - (f32[ y ] + 0.5) / f32[ h9 ]) * 3.1415927 ]
        cl9 : f32 [ cos[ lat9 ] ]
        if [ cl9 < 0.02 ] cl9 = 0.02
        for [ x: i32 0, x < w9, x += 1 ]
            xm : i32 [ (x > 0) ? x - 1 : w9 - 1 ]
            xp : i32 [ (x < w9 - 1) ? x + 1 : 0 ]
            su : f32 [ (H[ y * w9 + xp ] - H[ y * w9 + xm ]) / (2.0 * du * cl9) ]
            sv : f32 [ (H[ yp * w9 + x ] - H[ ym * w9 + x ]) / (2.0 * dv) ]
            su = su / smx
            sv = sv / smx
            if [ su < -1.0 ] su = -1.0
            if [ su >  1.0 ] su = 1.0
            if [ sv < -1.0 ] sv = -1.0
            if [ sv >  1.0 ] sv = 1.0
            b3 : i32 [ (y * w9 + x) * 4 ]
            nd[ b3 ]     = u8[ su * 127.0 + 128.0 ]
            nd[ b3 + 1 ] = u8[ sv * 127.0 + 128.0 ]
            nd[ b3 + 2 ] = 0
            nd[ b3 + 3 ] = 255
    bd : path '../scenes/baked'
    bd.make_dir[]
    pk.png[ path '../scenes/baked/mars-pk.png' ]
    nk.png[ path '../scenes/baked/mars-nk.png' ]
    puts 'mars: baked maps written'

# the real thing: MOLA straight through, no invented detail. the
# displacement map stays at 8192 (the mesh is 3072 wide, so that is
# already generous) while the SLOPE goes out at MOLA's full 46080,
# split into four longitude tiles -- 46080 is past what any GPU will
# take as one image, and slope is where 463m actually shows
func mars_bake_mola [] -> bool
    gw : i32 [ 46080 ]
    gh : i32 [ 22528 ]
    ow : i32 [ 46080 ]
    oh : i32 [ 23040 ]
    M : new i16 [ gw * gh ]
    if [ !mola_load[ M ] ]
        puts 'mars: MOLA tiles missing — run the download first'
        return false
    R : f32 [ mars_radius[] ]
    ex : f32 [ mars_exag[] ]
    hlo : f32 [ mars_hmin[] ]
    hhi : f32 [ mars_hmax[] ]
    hsp : f32 [ hhi - hlo ]

    # displacement map: box-averaged down from 46080, because point
    # sampling a 5.6x reduction aliases every ridge into sparkle
    dw : i32 [ 8192 ]
    dh : i32 [ 4096 ]
    # 46080/8192 is 5.625, NOT 5. integer division here walks the whole
    # map out of register -- the elevation range still looks right
    # because it still sweeps the planet, just to the wrong places
    fsx : f32 [ f32[ ow ] / f32[ dw ] ]
    fsy : f32 [ f32[ oh ] / f32[ dh ] ]
    pk : Image [ width: dw, height: dh, format: Pixel.rgba8, linear: true, wrap_u: true ]
    pd : @u8 [ pk.vdata[] ]
    for [ y: i32 0, y < dh, y += 1 ]
        by0 : i32 [ i32[ f32[ y ] * fsy ] ]
        by1 : i32 [ i32[ f32[ y + 1 ] * fsy ] ]
        if [ by1 <= by0 ] by1 = by0 + 1
        for [ x: i32 0, x < dw, x += 1 ]
            bx0 : i32 [ i32[ f32[ x ] * fsx ] ]
            bx1 : i32 [ i32[ f32[ x + 1 ] * fsx ] ]
            if [ bx1 <= bx0 ] bx1 = bx0 + 1
            acc : f32 [ 0.0 ]
            nsm : i32 [ 0 ]
            for [ by: i32 by0, by < by1, by += 1 ]
                for [ bx: i32 bx0, bx < bx1, bx += 1 ]
                    acc += mola_at[ M, bx, by ]
                    nsm += 1
            mv : f32 [ acc / f32[ nsm ] ]
            hr : f32 [ mv / R * ex ]
            t : f32 [ (hr - hlo) / hsp ]
            if [ t < 0.0 ] t = 0.0
            if [ t > 1.0 ] t = 1.0
            hq : i32 [ i32[ t * 65535.0 ] ]
            b2 : i32 [ (y * dw + x) * 4 ]
            pd[ b2 ]     = u8[ hq / 256 ]
            pd[ b2 + 1 ] = 0
            pd[ b2 + 2 ] = 0
            pd[ b2 + 3 ] = u8[ hq % 256 ]
    bd : path '../scenes/baked'
    bd.make_dir[]
    pk.png[ path '../scenes/baked/mars-pk.png' ]
    puts 'mars: displacement map written ({dw}x{dh})'

    # slope. one degree of latitude is a fixed distance; one of
    # longitude shrinks as cos(lat), so the east-west run has to carry
    # that or every pole turns into a spike
    smx : f32 [ mars_smax[] ]
    dstep : f32 [ 3.1415927 / 180.0 / 128.0 ]

    # global slope, at the displacement map's resolution: this is what
    # the rest of the planet is shaded with
    nk : Image [ width: dw, height: dh, format: Pixel.rgba8, linear: true, wrap_u: true ]
    nd : @u8 [ nk.vdata[] ]
    gstep : f32 [ dstep * fsx ]
    isx : i32 [ i32[ fsx ] ]
    isy : i32 [ i32[ fsy ] ]
    for [ y: i32 0, y < dh, y += 1 ]
        lat9 : f32 [ (0.5 - (f32[ y ] + 0.5) / f32[ dh ]) * 3.1415927 ]
        cl9 : f32 [ cos[ lat9 ] ]
        if [ cl9 < 0.004 ] cl9 = 0.004
        for [ x: i32 0, x < dw, x += 1 ]
            cx9 : i32 [ i32[ (f32[ x ] + 0.5) * fsx ] ]
            cy9 : i32 [ i32[ (f32[ y ] + 0.5) * fsy ] ]
            hu : f32 [ (mola_at[ M, cx9 + isx, cy9 ] - mola_at[ M, cx9 - isx, cy9 ]) / R * ex ]
            hv2 : f32 [ (mola_at[ M, cx9, cy9 + isy ] - mola_at[ M, cx9, cy9 - isy ]) / R * ex ]
            pu : f32 [ hu / (2.0 * gstep * cl9) / smx ]
            pv : f32 [ hv2 / (2.0 * gstep) / smx ]
            if [ pu < -1.0 ] pu = -1.0
            if [ pu >  1.0 ] pu = 1.0
            if [ pv < -1.0 ] pv = -1.0
            if [ pv >  1.0 ] pv = 1.0
            b3 : i32 [ (y * dw + x) * 4 ]
            nd[ b3 ]     = u8[ pu * 127.0 + 128.0 ]
            nd[ b3 + 1 ] = u8[ pv * 127.0 + 128.0 ]
            nd[ b3 + 2 ] = 0
            nd[ b3 + 3 ] = 255
    nk.png[ path '../scenes/baked/mars-nk.png' ]
    puts 'mars: global slope written ({dw}x{dh})'

    # the valley, at MOLA's own 463m. only this box gets it: the whole
    # planet at full resolution is a gigapixel of slope nobody orbits
    # over. 240E..340E by 15N..25S covers Valles Marineris end to end
    vx0 : i32 [ i32[ mars_vu0[] * f32[ ow ] ] ]
    vy0 : i32 [ i32[ mars_vv0[] * f32[ oh ] ] ]
    vw : i32 [ i32[ (mars_vu1[] - mars_vu0[]) * f32[ ow ] ] ]
    vh : i32 [ i32[ (mars_vv1[] - mars_vv0[]) * f32[ oh ] ] ]
    vsu : Image [ width: vw, height: vh, format: Pixel.u8, linear: true ]
    vsv : Image [ width: vw, height: vh, format: Pixel.u8, linear: true ]
    vud : @u8 [ vsu.vdata[] ]
    vvd : @u8 [ vsv.vdata[] ]
    for [ y: i32 0, y < vh, y += 1 ]
        gy : i32 [ vy0 + y ]
        lat9 : f32 [ (0.5 - (f32[ gy ] + 0.5) / f32[ oh ]) * 3.1415927 ]
        cl9 : f32 [ cos[ lat9 ] ]
        if [ cl9 < 0.004 ] cl9 = 0.004
        for [ x: i32 0, x < vw, x += 1 ]
            gx : i32 [ vx0 + x ]
            hu : f32 [ (mola_at[ M, gx + 1, gy ] - mola_at[ M, gx - 1, gy ]) / R * ex ]
            hv2 : f32 [ (mola_at[ M, gx, gy + 1 ] - mola_at[ M, gx, gy - 1 ]) / R * ex ]
            pu : f32 [ hu / (2.0 * dstep * cl9) / smx ]
            pv : f32 [ hv2 / (2.0 * dstep) / smx ]
            if [ pu < -1.0 ] pu = -1.0
            if [ pu >  1.0 ] pu = 1.0
            if [ pv < -1.0 ] pv = -1.0
            if [ pv >  1.0 ] pv = 1.0
            o : i32 [ y * vw + x ]
            vud[ o ] = u8[ pu * 127.0 + 128.0 ]
            vvd[ o ] = u8[ pv * 127.0 + 128.0 ]
    vsu.png[ path '../scenes/baked/mars-vsu.png' ]
    vsv.png[ path '../scenes/baked/mars-vsv.png' ]
    puts 'mars: valles slope written ({vw}x{vh})'
    puts 'mars: MOLA bake complete'
    return true

# how many times the rock material repeats across the equator, and how
# far it tilts the normal. 2048 tiles over 21300km of equator is a
# 10.4km tile, so its own 2048 texels land at 5m each -- against MOLA's
# 2600m, which is what makes the surface mush from 13km up
# how thick the air is. 0.04 was invisible: at ground distances of
# 0.05-0.3 sphere radii it gave about one percent opacity
# how high the dust shell stands, and the scale height it thins over.
# 0.020 radii is 68km of atmosphere; it fades to nothing over 7km
# the shell must stand far enough out that rays grazing ITS surface
# already carry no alpha -- roughly five scale heights. at the low
# rungs the eye sits inside it, which is fine: it is a closed sky
func mars_atm_h [] -> f32
    return 0.300
# the colour ramp is measured in THIS, not in a fixed radius, so the
# band keeps its proportions and simply reaches further as it grows.
# 0.0075 was gone within ~40km; 0.018 carries the air to ~100km
func mars_atm_fall [] -> f32
    return 0.018
func mars_atm_gain [] -> f32
    return 0.62

# the cloud deck, in sphere radii. the low rung flies at 0.050, so a
# deck topping out at 0.030 puts the craft just above it -- which is
# the vantage that shows a cloudscape rather than a ceiling
func mars_cld_lo [] -> f32
    return 0.0060
func mars_cld_hi [] -> f32
    return 0.0250
# how much sky is covered. 0.52 leaves real gaps to fly between
# MEASURED against the baked field, not assumed. coverage is the
# threshold 1-cov on a worley distribution whose mean is 0.478, so it
# is nothing like linear in area: 0.50 covers 42% of the volume, 0.40
# covers 16%, and 0.155 covers 0.02% -- which is why the sky emptied.
# 0.369 is a true quarter of what 0.50 gave
func mars_cld_cov [] -> f32
    return 0.460
# 3.4 draws a lobe out to roughly three times its width along the
# equator. 1.0 would be round, unsheared cloud
func mars_cld_wind [] -> f32
    return 3.4

func mars_haze [] -> f32
    return 0.85

# the BARE planet's air, which is nothing like the terraformed one:
# 0.85 was tuned for a wet Terra and buried the real mars in fog
func mars_bare_haze [] -> f32
    return 0.34

func mars_dtile [] -> f32
    return 2048.0
# the gate spans 0.10 to 2.00 on its own, so this stays at unity and
# the numbers in the shader mean what they say
func mars_damp [] -> f32
    return 1.0
# how far the rock material lifts the MESH, in sphere radii, before
# the edge map scales it. 0.00004 is 136m of relief where MOLA has none
func mars_dh [] -> f32
    return 0.00004

# relief multiplier applied at DRAW time, not in the bake -- the bake
# reads 2GB of MOLA tiles and this is a look control. it must scale
# hmax and smax TOGETHER: hmax sets how far the mesh lifts, smax how
# hard the slope map shades, and moving one without the other makes
# the shading disagree with the silhouette
func mars_relief [] -> f32
    return 3.0

# SEA LEVEL, in packed height units (the same 0..1 the height map
# stores). Valles floor reads 0.154, the plateau above it 0.384 and
# Olympus 0.942, so 0.22 at the poles rising to 0.32 at the equator
# floods the canyon system and the northern lowlands while leaving
# every plateau dry
func mars_sea_l0 [] -> f32
    return 0.22
# the equatorial bias: warm ground fills easier, so the sea stands
# higher there. this is the whole reason the valley is a sea and the
# polar basins are not
func mars_sea_bias [] -> f32
    return 0.10

# ONE tileable rock material for the whole planet: normal in RG,
# cavity in B, roughness in A. this is the slot a real terrain PBR
# normal map drops into -- point mars-dn at it and delete nothing else.
#
# EVERY source read uses an EVEN integer scale. eu_bilin addresses
# mirrored, whose period is 2, so an even scale is exactly periodic
# over one output tile and no seam can print at any tiling frequency.
# free rotation would break that, which is why there is none here
func mars_bake_detail [] -> bool
    # the three grey europa plates were chosen by MEASURED structure-
    # tensor coherence, because Mars has no grain direction and a source
    # that does prints its own across the whole planet. stardunes ran
    # 0.482 at -42 degrees -- that was the diagonal streaking -- and
    # granite 0.335 at 0, which banded it horizontally. these three are
    # the flattest we own: scratch 0.012, metal4 0.042, fracture 0.056.
    #
    # they are FINE GRAIN and nothing else, which is why a whole planet
    # of them read as one material. sand and the two stone plates carry
    # the structure they lack -- rubble, fracture and vein -- and they
    # own the provinces below. every plate is normalised to a common
    # mean and spread first, or the height steps where one hands over
    # 3 is the SELECTOR, never blended in
    names : vec string [] [ 'europa-scratch.png', 'europa-metal4.png', 'europa-fracture.png',
        'europa-caldera.png', 'mars-veg-sand.png', 'mars-stone.png', 'mars-stone2.png' ]
    ns : i32 [ names.count ]
    sw : new i32 [ ns ]
    sh : new i32 [ ns ]
    so : new i32 [ ns ]
    imgs : vec Image []
    total : i32 [ 0 ]
    for [ i: i32 0, i < ns, i += 1 ]
        p9 : path '../scenes/textures/{names[i]}'
        im : Image [ uri: p9 ]
        if [ im.width == 0 ]
            puts 'mars: detail source {names[i]} missing'
            return false
        imgs.push[ im ]
        sw[i] = im.width
        sh[i] = im.height
        so[i] = total
        total += im.width * im.height
    SB : new f32 [ total ]
    for [ i: i32 0, i < ns, i += 1 ]
        si : Image imgs[i]
        eu_lum[ si, @SB[ so[i] ] ]
    # COMMON mean and spread. a plate that sits brighter or flatter than
    # its neighbour would otherwise step the height at every province
    # boundary, which reads as a patchwork of shelves rather than rock
    for [ i: i32 0, i < ns, i += 1 ]
        pn : i32 [ sw[i] * sh[i] ]
        pp : @f32 [ @SB[ so[i] ] ]
        psum : f32 [ 0.0 ]
        for [ k: i32 0, k < pn, k += 1 ] psum += pp[ k ]
        pmu : f32 [ psum / f32[ pn ] ]
        pvar : f32 [ 0.0 ]
        for [ k: i32 0, k < pn, k += 1 ]
            pd9 : f32 [ pp[ k ] - pmu ]
            pvar += pd9 * pd9
        psig : f32 [ sqrt[ pvar / f32[ pn ] ] ]
        if [ psig < 0.000001 ] psig = 0.000001
        for [ k: i32 0, k < pn, k += 1 ] pp[ k ] = (pp[ k ] - pmu) / psig * 0.18 + 0.5
        puts 'mars: plate {names[i]} mean {pmu} sigma {psig}'
    g0 : @f32 [ @SB[ so[0] ] ]
    g1 : @f32 [ @SB[ so[1] ] ]
    g2 : @f32 [ @SB[ so[2] ] ]
    g3 : @f32 [ @SB[ so[3] ] ]
    g4 : @f32 [ @SB[ so[4] ] ]
    g5 : @f32 [ @SB[ so[5] ] ]
    g6 : @f32 [ @SB[ so[6] ] ]

    w9 : i32 [ 2048 ]
    h9 : i32 [ 2048 ]
    n9 : i32 [ w9 * h9 ]
    D : new f32 [ n9 ]
    puts 'mars: patching rock detail over {w9}x{h9}'
    for [ y: i32 0, y < h9, y += 1 ]
        v : f32 [ f32[ y ] / f32[ h9 ] ]
        for [ x: i32 0, x < w9, x += 1 ]
            u : f32 [ f32[ x ] / f32[ w9 ] ]
            # THREE selector fields, each an even scale on its own axis
            # order, so the provinces they cut never line up with each
            # other or with the tile grid
            s1 : f32 [ eu_bilin[ g3, sw[3], sh[3], u * 2.0 + 0.13, v * 2.0 + 0.41 ] ]
            s2 : f32 [ eu_bilin[ g3, sw[3], sh[3], v * 6.0 + 0.61, u * 6.0 + 0.07 ] ]
            s3 : f32 [ eu_bilin[ g3, sw[3], sh[3], u * 10.0 + 0.29, v * 10.0 + 0.83 ] ]
            # SAND takes the largest share, the two stone plates the
            # next, the grey grain what is left. the plates are all
            # normalised to one spread, so a province change swaps the
            # STRUCTURE without moving the height
            f_st : f32 [ eu_sstep[ 0.44, 0.60, s1 ] ]
            f_rk : f32 [ eu_sstep[ 0.68, 0.84, s1 ] ]
            acc : f32 [ 0.0 ]
            for [ oi: i32 0, oi < 4, oi += 1 ]
                oc : f32 [ (oi == 0) ? 1.0 : ((oi == 1) ? 3.0 : ((oi == 2) ? 9.0 : 27.0)) ]
                wt : f32 [ (oi == 0) ? 1.0 : ((oi == 1) ? 0.52 : ((oi == 2) ? 0.27 : 0.13)) ]
                # regolith, blown into ripple
                p_sa : f32 [ eu_bilin[ g4, sw[4], sh[4], u * 4.0 * oc + 0.13, v * 4.0 * oc + 0.41 ] ]
                # rough rubble, and veined rock that breaks in sheets
                p_s1 : f32 [ eu_bilin[ g5, sw[5], sh[5], v * 2.0 * oc + 0.61, u * 2.0 * oc + 0.07 ] ]
                p_s2 : f32 [ eu_bilin[ g6, sw[6], sh[6], u * 6.0 * oc + 0.29, v * 6.0 * oc + 0.83 ] ]
                # the grey plates: fine grain the stone has none of
                p_a  : f32 [ eu_bilin[ g0, sw[0], sh[0], v * 8.0 * oc + 0.37, u * 8.0 * oc + 0.19 ] ]
                p_b  : f32 [ eu_bilin[ g1, sw[1], sh[1], u * 10.0 * oc + 0.71, v * 10.0 * oc + 0.53 ] ]
                p_c  : f32 [ eu_bilin[ g2, sw[2], sh[2], v * 12.0 * oc + 0.11, u * 12.0 * oc + 0.67 ] ]
                st : f32 [ p_s1 + (p_s2 - p_s1) * eu_sstep[ 0.34, 0.74, s2 ] ]
                rk : f32 [ p_a + (p_b - p_a) * eu_sstep[ 0.30, 0.70, s2 ] ]
                rk = rk + (p_c - rk) * eu_sstep[ 0.36, 0.78, s3 ]
                cc : f32 [ p_sa + (st - p_sa) * f_st ]
                cc = cc + (rk - cc) * f_rk
                acc += (cc - 0.5) * wt
            D[ y * w9 + x ] = acc

    # the blurred twin is the local datum: where the surface sits under
    # it the ground is a crevice, and how far it strays is the grain
    T : new f32 [ n9 ]
    tmp : new f32 [ n9 ]
    for [ i: i32 0, i < n9, i += 1 ] T[ i ] = D[ i ]
    eu_blur[ T, tmp, w9, h9, 3 ]

    # the field's own spread, so B spends its 8 bits on the range the
    # material occupies rather than on outliers
    dsum : f32 [ 0.0 ]
    for [ i: i32 0, i < n9, i += 1 ] dsum += D[ i ]
    dmean : f32 [ dsum / f32[ n9 ] ]
    dvar : f32 [ 0.0 ]
    for [ i: i32 0, i < n9, i += 1 ]
        dd9 : f32 [ D[ i ] - dmean ]
        dvar += dd9 * dd9
    dsig : f32 [ sqrt[ dvar / f32[ n9 ] ] ]
    if [ dsig < 0.000001 ] dsig = 0.000001
    puts 'mars: detail height mean {dmean} sigma {dsig}'

    # scale the packed slope by the field's own gradient RMS, so the
    # 8 bits are spent on the range the material actually occupies
    acc2 : f32 [ 0.0 ]
    for [ y: i32 0, y < h9, y += 1 ]
        ym : i32 [ (y > 0) ? y - 1 : h9 - 1 ]
        yp : i32 [ (y < h9 - 1) ? y + 1 : 0 ]
        for [ x: i32 0, x < w9, x += 1 ]
            xm : i32 [ (x > 0) ? x - 1 : w9 - 1 ]
            xp : i32 [ (x < w9 - 1) ? x + 1 : 0 ]
            gx : f32 [ D[ y * w9 + xp ] - D[ y * w9 + xm ] ]
            gy : f32 [ D[ yp * w9 + x ] - D[ ym * w9 + x ] ]
            acc2 += gx * gx + gy * gy
    rms : f32 [ sqrt[ acc2 / f32[ n9 ] ] ]
    if [ rms < 0.000001 ] rms = 0.000001
    gsc : f32 [ 1.0 / (rms * 3.0) ]
    puts 'mars: detail gradient rms {rms}'

    dn : Image [ width: w9, height: h9, format: Pixel.rgba8, linear: true, wrap_u: true, wrap_v: true ]
    dd : @u8 [ dn.vdata[] ]
    for [ y: i32 0, y < h9, y += 1 ]
        ym : i32 [ (y > 0) ? y - 1 : h9 - 1 ]
        yp : i32 [ (y < h9 - 1) ? y + 1 : 0 ]
        for [ x: i32 0, x < w9, x += 1 ]
            xm : i32 [ (x > 0) ? x - 1 : w9 - 1 ]
            xp : i32 [ (x < w9 - 1) ? x + 1 : 0 ]
            gx : f32 [ (D[ y * w9 + xp ] - D[ y * w9 + xm ]) * gsc ]
            gy : f32 [ (D[ yp * w9 + x ] - D[ ym * w9 + x ]) * gsc ]
            if [ gx < -1.0 ] gx = -1.0
            if [ gx >  1.0 ] gx =  1.0
            if [ gy < -1.0 ] gy = -1.0
            if [ gy >  1.0 ] gy =  1.0
            o : i32 [ y * w9 + x ]
            # B is the detail HEIGHT, centred on 128 -- the mesh
            # displaces by it, and RG is exactly its own gradient, so
            # the shading can never disagree with the geometry
            hn : f32 [ (D[ o ] - dmean) / (dsig * 3.0) ]
            if [ hn < -1.0 ] hn = -1.0
            if [ hn >  1.0 ] hn =  1.0
            dv : f32 [ T[ o ] - D[ o ] ]
            rg : f32 [ ((dv < 0.0) ? 0.0 - dv : dv) * 9.0 ]
            if [ rg > 1.0 ] rg = 1.0
            b4 : i32 [ o * 4 ]
            dd[ b4 ]     = u8[ gx * 127.0 + 128.0 ]
            dd[ b4 + 1 ] = u8[ gy * 127.0 + 128.0 ]
            dd[ b4 + 2 ] = u8[ hn * 127.0 + 128.0 ]
            dd[ b4 + 3 ] = u8[ rg * 255.0 ]
    bd : path '../scenes/baked'
    bd.make_dir[]
    dn.png[ path '../scenes/baked/mars-dn.png' ]
    puts 'mars: rock detail written ({w9}x{h9})'
    return true

# WHERE to augment. the colour map is useless as albedo -- it has
# shadows baked in -- but it is the finest EDGE source we own: crater
# rims, scarps and canyon walls at 8192 across, structure the height
# map lost. sobel it for edge magnitude, then build an INTEGRAL IMAGE
# so the mean edge energy over any box costs four lookups instead of
# a blur per scale. three scales come out of one pass.
#
# R = edge over 4 texels (10km), G = 16 (42km), B = 64 (166km),
# A = the raw sobel. the shader scales BOTH the geometry patch and the
# normal amplitude by these: busy ground gets high frequency, dead
# flat plains stay flat
func mars_bake_edge [] -> bool
    cim : Image [ uri: path '../scenes/textures/mars-color-8192x4096.png' ]
    if [ cim.width == 0 ]
        puts 'mars: colour map missing — cannot build the edge map'
        return false
    w9 : i32 [ cim.width ]
    h9 : i32 [ cim.height ]
    n9 : i32 [ w9 * h9 ]
    puts 'mars: sobel over {w9}x{h9}'
    L : new f32 [ n9 ]
    eu_lum[ cim, L ]

    S : new f32 [ n9 ]
    for [ y: i32 0, y < h9, y += 1 ]
        ym : i32 [ (y > 0) ? y - 1 : 0 ]
        yp : i32 [ (y < h9 - 1) ? y + 1 : h9 - 1 ]
        for [ x: i32 0, x < w9, x += 1 ]
            # longitude wraps; latitude clamps at the caps
            xm : i32 [ (x > 0) ? x - 1 : w9 - 1 ]
            xp : i32 [ (x < w9 - 1) ? x + 1 : 0 ]
            a1 : f32 [ L[ ym * w9 + xm ] ]
            a2 : f32 [ L[ ym * w9 + x  ] ]
            a3 : f32 [ L[ ym * w9 + xp ] ]
            b1 : f32 [ L[ y  * w9 + xm ] ]
            b3 : f32 [ L[ y  * w9 + xp ] ]
            c1 : f32 [ L[ yp * w9 + xm ] ]
            c2 : f32 [ L[ yp * w9 + x  ] ]
            c3 : f32 [ L[ yp * w9 + xp ] ]
            gx : f32 [ (a3 + 2.0 * b3 + c3) - (a1 + 2.0 * b1 + c1) ]
            gy : f32 [ (c1 + 2.0 * c2 + c3) - (a1 + 2.0 * a2 + a3) ]
            S[ y * w9 + x ] = sqrt[ gx * gx + gy * gy ]

    # the integral image, one row of padding on each leading edge so a
    # box query never has to special-case the border. f64: an f32
    # accumulator runs out of mantissa a third of the way down 33M texels
    iw : i32 [ w9 + 1 ]
    I : new f64 [ iw * (h9 + 1) ]
    puts 'mars: integral image {iw}x{h9 + 1}'
    for [ y: i32 0, y < h9, y += 1 ]
        rs : f64 [ 0.0 ]
        for [ x: i32 0, x < w9, x += 1 ]
            rs += f64[ S[ y * w9 + x ] ]
            I[ (y + 1) * iw + (x + 1) ] = I[ y * iw + (x + 1) ] + rs

    ek : Image [ width: w9, height: h9, format: Pixel.rgba8, linear: true, wrap_u: true ]
    ed : @u8 [ ek.vdata[] ]
    r1 : i32 [ 4 ]
    r2 : i32 [ 16 ]
    r3 : i32 [ 64 ]
    # each scale normalised by its own spread, or the wide box -- which
    # averages far more texels -- comes out black next to the narrow one
    m1 : f64 [ 0.0 ]
    m2 : f64 [ 0.0 ]
    m3 : f64 [ 0.0 ]
    for [ y: i32 0, y < h9, y += 1 ]
        for [ x: i32 0, x < w9, x += 1 ]
            m1 += f64[ mars_box[ I, iw, w9, h9, x, y, r1 ] ]
            m2 += f64[ mars_box[ I, iw, w9, h9, x, y, r2 ] ]
            m3 += f64[ mars_box[ I, iw, w9, h9, x, y, r3 ] ]
    fn9 : f64 [ f64[ n9 ] ]
    a1m : f32 [ f32[ m1 / fn9 ] ]
    a2m : f32 [ f32[ m2 / fn9 ] ]
    a3m : f32 [ f32[ m3 / fn9 ] ]
    if [ a1m < 0.000001 ] a1m = 0.000001
    if [ a2m < 0.000001 ] a2m = 0.000001
    if [ a3m < 0.000001 ] a3m = 0.000001
    puts 'mars: edge means {a1m} {a2m} {a3m}'
    smx9 : f32 [ 0.0 ]
    for [ i: i32 0, i < n9, i += 1 ]
        if [ S[i] > smx9 ] smx9 = S[i]
    if [ smx9 < 0.000001 ] smx9 = 0.000001
    for [ y: i32 0, y < h9, y += 1 ]
        for [ x: i32 0, x < w9, x += 1 ]
            e1 : f32 [ mars_box[ I, iw, w9, h9, x, y, r1 ] / (a1m * 2.5) ]
            e2 : f32 [ mars_box[ I, iw, w9, h9, x, y, r2 ] / (a2m * 2.5) ]
            e3 : f32 [ mars_box[ I, iw, w9, h9, x, y, r3 ] / (a3m * 2.5) ]
            if [ e1 > 1.0 ] e1 = 1.0
            if [ e2 > 1.0 ] e2 = 1.0
            if [ e3 > 1.0 ] e3 = 1.0
            e4 : f32 [ S[ y * w9 + x ] / smx9 ]
            if [ e4 > 1.0 ] e4 = 1.0
            b4 : i32 [ (y * w9 + x) * 4 ]
            ed[ b4 ]     = u8[ e1 * 255.0 ]
            ed[ b4 + 1 ] = u8[ e2 * 255.0 ]
            ed[ b4 + 2 ] = u8[ e3 * 255.0 ]
            ed[ b4 + 3 ] = u8[ e4 * 255.0 ]
    bd : path '../scenes/baked'
    bd.make_dir[]
    ek.png[ path '../scenes/baked/mars-ek.png' ]
    puts 'mars: edge map written ({w9}x{h9})'
    return true

# mean of the sobel field over a box, from the integral image: four
# lookups, whatever the radius
func mars_box [ I: @f64, iw: i32, w9: i32, h9: i32, x: i32, y: i32, r: i32 ] -> f32
    x0 : i32 [ x - r ]
    y0 : i32 [ y - r ]
    x1 : i32 [ x + r ]
    y1 : i32 [ y + r ]
    if [ x0 < 0 ] x0 = 0
    if [ y0 < 0 ] y0 = 0
    if [ x1 > w9 - 1 ] x1 = w9 - 1
    if [ y1 > h9 - 1 ] y1 = h9 - 1
    s9 : f64 [ I[ (y1 + 1) * iw + (x1 + 1) ]
             - I[ y0 * iw + (x1 + 1) ]
             - I[ (y1 + 1) * iw + x0 ]
             + I[ y0 * iw + x0 ] ]
    cnt : f32 [ f32[ (x1 - x0 + 1) * (y1 - y0 + 1) ] ]
    return f32[ s9 ] / cnt

func mars_edge_map []
    h1 : u64 [ @mars_bake_edge ]
    h2 : u64 [ @mars_box ]
    h3 : u64 [ @eu_lum ]
    stamp : string '{h1}-{h2}-{h3}'
    sp : path '../scenes/baked/mars-ek.hash'
    ekp : path '../scenes/baked/mars-ek.png'
    if [ sp.exists[] && ekp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            puts 'mars: edge map current ({stamp})'
            return
    if [ mars_bake_edge[] ] sp.save[ stamp, null ]

# RIVERS. not painted noise -- real drainage. every texel in the
# Valles box sends its water to its lowest neighbour, and the cells are
# walked from the highest down so each one hands its whole upstream
# area on before its turn to give. that is what makes a river network
# dendritic instead of wormy: tributaries MERGE and get wider.
#
# R = water, G = sand bank, and only inside the canyon -- the plateau
# above the rim drains off the box and carries nothing
func mars_bake_river [] -> bool
    pk : Image [ uri: path '../scenes/baked/mars-pk.png' ]
    if [ pk.width == 0 ]
        puts 'mars: no height map — cannot cut rivers'
        return false
    W9 : i32 [ pk.width ]
    H9 : i32 [ pk.height ]
    pd : @u8 [ pk.vdata[] ]
    ps : i32 [ pk.pixel_size ]
    x0 : i32 [ i32[ mars_vu0[] * f32[ W9 ] ] ]
    x1 : i32 [ i32[ mars_vu1[] * f32[ W9 ] ] ]
    y0 : i32 [ i32[ mars_vv0[] * f32[ H9 ] ] ]
    y1 : i32 [ i32[ mars_vv1[] * f32[ H9 ] ] ]
    bw : i32 [ x1 - x0 ]
    bh : i32 [ y1 - y0 ]
    nb : i32 [ bw * bh ]
    puts 'mars: cutting rivers over {bw}x{bh}'
    T : new i32 [ nb ]
    for [ y: i32 0, y < bh, y += 1 ]
        for [ x: i32 0, x < bw, x += 1 ]
            b2 : i32 [ ((y + y0) * W9 + (x + x0)) * ps ]
            T[ y * bw + x ] = i32[ pd[ b2 ] ] * 256 + i32[ pd[ b2 + 3 ] ]

    # counting sort by packed height, HIGHEST first. 65536 buckets is
    # one pass -- a comparison sort over two million cells is not
    cnt : new i32 [ 65536 ]
    for [ i: i32 0, i < nb, i += 1 ] cnt[ T[i] ] += 1
    fill : new i32 [ 65536 ]
    run : i32 [ 0 ]
    for [ v: i32 65535, v >= 0, v -= 1 ]
        fill[ v ] = run
        run += cnt[ v ]
    ord : new i32 [ nb ]
    for [ i: i32 0, i < nb, i += 1 ]
        ord[ fill[ T[i] ] ] = i
        fill[ T[i] ] += 1

    # every cell starts owning its own rainfall, then gives the lot to
    # its lowest neighbour on the way down
    acc : new f32 [ nb ]
    for [ i: i32 0, i < nb, i += 1 ] acc[ i ] = 1.0
    for [ k: i32 0, k < nb, k += 1 ]
        i : i32 [ ord[ k ] ]
        x : i32 [ i % bw ]
        y : i32 [ i / bw ]
        lo : i32 [ T[ i ] ]
        bi : i32 [ 0 - 1 ]
        for [ dy: i32 0 - 1, dy <= 1, dy += 1 ]
            ny : i32 [ y + dy ]
            if [ ny >= 0 && ny < bh ]
                for [ dx: i32 0 - 1, dx <= 1, dx += 1 ]
                    nx : i32 [ x + dx ]
                    if [ (dx != 0 || dy != 0) && nx >= 0 && nx < bw ]
                        j : i32 [ ny * bw + nx ]
                        if [ T[ j ] < lo ]
                            lo = T[ j ]
                            bi = j
        if [ bi >= 0 ] acc[ bi ] += acc[ i ]

    # a river's WIDTH goes as the log of its catchment, which is why a
    # linear threshold gives either a hairline or a flood
    # MEASURED, not assumed: the largest catchment in the box came out
    # at ~2500 cells, not the tens of thousands a drainage this size
    # would carry, because a real DEM is full of closed hollows and
    # flow dies in every one. so the scale is set from what the terrain
    # actually produced -- a 300 threshold left 487 water texels in the
    # whole canyon
    hi9 : i32 [ i32[ 0.30 * 65535.0 ] ]
    amx : f32 [ 1.0 ]
    for [ i: i32 0, i < nb, i += 1 ]
        if [ acc[ i ] > amx ] amx = acc[ i ]
    puts 'mars: largest catchment {amx} cells'
    riv : new f32 [ nb ]
    thr : f32 [ 24.0 ]
    lt : f32 [ log[ thr ] ]
    ls : f32 [ log[ amx ] - lt ]
    if [ ls < 0.5 ] ls = 0.5
    for [ i: i32 0, i < nb, i += 1 ]
        r9 : f32 [ 0.0 ]
        # only inside the canyon: above the rim the water leaves the box
        if [ acc[ i ] > thr && T[ i ] < hi9 ]
            r9 = (log[ acc[ i ] ] - lt) / ls
            if [ r9 < 0.0 ] r9 = 0.0
            if [ r9 > 1.0 ] r9 = 1.0
        riv[ i ] = r9

    # banks: how close the sand reaches. spread the water outward a few
    # times, keeping the largest -- a cheap distance field
    bank : new f32 [ nb ]
    tmp2 : new f32 [ nb ]
    for [ i: i32 0, i < nb, i += 1 ] bank[ i ] = riv[ i ]
    for [ p9: i32 0, p9 < 7, p9 += 1 ]
        for [ y: i32 0, y < bh, y += 1 ]
            for [ x: i32 0, x < bw, x += 1 ]
                i : i32 [ y * bw + x ]
                m9 : f32 [ bank[ i ] ]
                xm : i32 [ (x > 0) ? x - 1 : 0 ]
                xp : i32 [ (x < bw - 1) ? x + 1 : bw - 1 ]
                ym : i32 [ (y > 0) ? y - 1 : 0 ]
                yp : i32 [ (y < bh - 1) ? y + 1 : bh - 1 ]
                if [ bank[ y * bw + xm ] > m9 ] m9 = bank[ y * bw + xm ]
                if [ bank[ y * bw + xp ] > m9 ] m9 = bank[ y * bw + xp ]
                if [ bank[ ym * bw + x ] > m9 ] m9 = bank[ ym * bw + x ]
                if [ bank[ yp * bw + x ] > m9 ] m9 = bank[ yp * bw + x ]
                tmp2[ i ] = m9 * 0.86
        for [ i: i32 0, i < nb, i += 1 ]
            bank[ i ] = (riv[i] > tmp2[i]) ? riv[i] : tmp2[i]

    rv : Image [ width: W9, height: H9, format: Pixel.rgba8, linear: true, wrap_u: true ]
    rd : @u8 [ rv.vdata[] ]
    n9 : i32 [ W9 * H9 ]
    for [ i: i32 0, i < n9, i += 1 ]
        b4 : i32 [ i * 4 ]
        rd[ b4 ] = 0
        rd[ b4 + 1 ] = 0
        rd[ b4 + 2 ] = 0
        rd[ b4 + 3 ] = 255
    nriv : i32 [ 0 ]
    for [ y: i32 0, y < bh, y += 1 ]
        for [ x: i32 0, x < bw, x += 1 ]
            i : i32 [ y * bw + x ]
            b4 : i32 [ ((y + y0) * W9 + (x + x0)) * 4 ]
            rd[ b4 ]     = u8[ riv[ i ] * 255.0 ]
            rd[ b4 + 1 ] = u8[ bank[ i ] * 255.0 ]
            if [ riv[ i ] > 0.05 ] nriv += 1
    bd : path '../scenes/baked'
    bd.make_dir[]
    rv.png[ path '../scenes/baked/mars-rv.png' ]
    puts 'mars: rivers written, {nriv} water texels'
    return true

func mars_river_map []
    h1 : u64 [ @mars_bake_river ]
    h2 : u64 [ @mars_vu0 ]
    h3 : u64 [ @mars_vu1 ]
    h4 : u64 [ @mars_vv0 ]
    h5 : u64 [ @mars_vv1 ]
    stamp : string '{h1}-{h2}-{h3}-{h4}-{h5}'
    sp : path '../scenes/baked/mars-rv.hash'
    rvp : path '../scenes/baked/mars-rv.png'
    if [ sp.exists[] && rvp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            puts 'mars: rivers current ({stamp})'
            return
    if [ mars_bake_river[] ] sp.save[ stamp, null ]

# CLOUD VOLUME. the shape of a real cloud comes from WORLEY noise
# inverted -- cellular distance fields give the billowing cauliflower
# lobes that value noise simply cannot make, however it is octaved.
# this bakes a 64^3 volume as an 8x8 slice atlas:
#   R = billow base (worley fbm, 4/8/16 cells)
#   G,B,A = single-octave worley at 8/16/32, for edge erosion
# every octave wraps its cell indices, so the volume tiles in all
# three axes and can be sampled endlessly across the sky
func cl_hash [ ix: i32, iy: i32, iz: i32, sd: i32 ] -> f32
    h : i32 [ ix * 374761393 + iy * 668265263 + iz * 2147483647 + sd * 1274126177 ]
    h = (h ^ (h >> 13)) * 1274126177
    h = h ^ (h >> 16)
    hu : i32 [ h & 8388607 ]
    return f32[ hu ] / 8388608.0

# nearest feature-point distance, cells wrapped so the field tiles
func cl_worley [ px: f32, py: f32, pz: f32, nc: i32, sd: i32 ] -> f32
    fx : f32 [ px * f32[ nc ] ]
    fy : f32 [ py * f32[ nc ] ]
    fz : f32 [ pz * f32[ nc ] ]
    ix : i32 [ i32[ floor[ fx ] ] ]
    iy : i32 [ i32[ floor[ fy ] ] ]
    iz : i32 [ i32[ floor[ fz ] ] ]
    best : f32 [ 9.0 ]
    for [ dz: i32 0 - 1, dz <= 1, dz += 1 ]
        for [ dy: i32 0 - 1, dy <= 1, dy += 1 ]
            for [ dx: i32 0 - 1, dx <= 1, dx += 1 ]
                cx : i32 [ (ix + dx) % nc ]
                cy : i32 [ (iy + dy) % nc ]
                cz : i32 [ (iz + dz) % nc ]
                if [ cx < 0 ] cx = cx + nc
                if [ cy < 0 ] cy = cy + nc
                if [ cz < 0 ] cz = cz + nc
                ox : f32 [ f32[ ix + dx ] + cl_hash[ cx, cy, cz, sd ] ]
                oy : f32 [ f32[ iy + dy ] + cl_hash[ cx, cy, cz, sd + 7 ] ]
                oz : f32 [ f32[ iz + dz ] + cl_hash[ cx, cy, cz, sd + 19 ] ]
                ddx : f32 [ ox - fx ]
                ddy : f32 [ oy - fy ]
                ddz : f32 [ oz - fz ]
                d2 : f32 [ ddx * ddx + ddy * ddy + ddz * ddz ]
                if [ d2 < best ] best = d2
    d : f32 [ sqrt[ best ] ]
    if [ d > 1.0 ] d = 1.0
    # INVERTED: near a feature point is dense, which is the lobe
    return 1.0 - d

func mars_bake_cloud [] -> bool
    n : i32 [ 64 ]
    gw : i32 [ n * 8 ]
    gh : i32 [ n * 8 ]
    puts 'mars: baking {n}^3 cloud volume as {gw}x{gh} atlas'
    im : Image [ width: gw, height: gh, format: Pixel.rgba8, linear: true, wrap_u: true, wrap_v: true ]
    dd : @u8 [ im.vdata[] ]
    inv : f32 [ 1.0 / f32[ n ] ]
    for [ z: i32 0, z < n, z += 1 ]
        sx : i32 [ (z % 8) * n ]
        sy : i32 [ (z / 8) * n ]
        pz : f32 [ (f32[ z ] + 0.5) * inv ]
        for [ y: i32 0, y < n, y += 1 ]
            py : f32 [ (f32[ y ] + 0.5) * inv ]
            for [ x: i32 0, x < n, x += 1 ]
                px : f32 [ (f32[ x ] + 0.5) * inv ]
                w4 : f32 [ cl_worley[ px, py, pz, 4,  11 ] ]
                w8 : f32 [ cl_worley[ px, py, pz, 8,  23 ] ]
                w16 : f32 [ cl_worley[ px, py, pz, 16, 37 ] ]
                w32 : f32 [ cl_worley[ px, py, pz, 32, 53 ] ]
                base : f32 [ w4 * 0.625 + w8 * 0.250 + w16 * 0.125 ]
                if [ base < 0.0 ] base = 0.0
                if [ base > 1.0 ] base = 1.0
                o : i32 [ ((sy + y) * gw + (sx + x)) * 4 ]
                dd[ o ]     = u8[ base * 255.0 ]
                dd[ o + 1 ] = u8[ w8  * 255.0 ]
                dd[ o + 2 ] = u8[ w16 * 255.0 ]
                dd[ o + 3 ] = u8[ w32 * 255.0 ]
    bd : path '../scenes/baked'
    bd.make_dir[]
    im.png[ path '../scenes/baked/mars-cld.png' ]
    puts 'mars: cloud volume written'
    return true

func mars_cloud_map []
    h1 : u64 [ @mars_bake_cloud ]
    h2 : u64 [ @cl_worley ]
    h3 : u64 [ @cl_hash ]
    stamp : string '{h1}-{h2}-{h3}'
    sp : path '../scenes/baked/mars-cld.hash'
    cp : path '../scenes/baked/mars-cld.png'
    if [ sp.exists[] && cp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            puts 'mars: cloud volume current ({stamp})'
            return
    if [ mars_bake_cloud[] ] sp.save[ stamp, null ]

# NEPTUNE, composed rather than sourced: saturn's smooth banded poles
# with jupiter's turbulent middle set between them, then driven deep
# blue. jupiter's band is FLIPPED in latitude and MIRRORED in longitude
# so it does not read as jupiter, and the great red spot is warped by a
# swirl about its own centre into a different storm entirely
func nep_lerp [ a: f32, b: f32, t: f32 ] -> f32
    return a + (b - a) * t

func neptune_bake [] -> bool
    si : Image [ uri: path '../scenes/textures/saturn-color.png' ]
    if [ si.width == 0 ]
        puts 'neptune: saturn plate missing'
        return false
    ji : Image [ uri: path '../scenes/textures/jupiter-color.png' ]
    if [ ji.width == 0 ]
        puts 'neptune: jupiter plate missing'
        return false
    w9 : i32 [ si.width ]
    h9 : i32 [ si.height ]
    jw : i32 [ ji.width ]
    jh : i32 [ ji.height ]
    puts 'neptune: composing {w9}x{h9} saturn with {jw}x{jh} jupiter patches'
    sp9 : i32 [ si.pixel_size ]
    sdat : @u8 [ si.vdata[] ]
    jp9 : i32 [ ji.pixel_size ]
    jdat : @u8 [ ji.vdata[] ]
    im : Image [ width: w9, height: h9, format: Pixel.rgba8, linear: true, wrap_u: true ]
    od : @u8 [ im.vdata[] ]
    # THE GREAT DARK SPOT, ours rather than jupiter's borrowed one: an
    # ellipse laid down with a brush whose edge is broken by perlin, so
    # it reads as a storm the bands are wrapping around instead of a
    # painted oval. wide and shallow, the way a banded planet holds one
    du0 : f32 [ 0.34 ]
    dv0 : f32 [ 0.385 ]
    for [ y: i32 0, y < h9, y += 1 ]
        v : f32 [ (f32[ y ] + 0.5) / f32[ h9 ] ]
        for [ x: i32 0, x < w9, x += 1 ]
            u : f32 [ (f32[ x ] + 0.5) / f32[ w9 ] ]
            sb : i32 [ (y * w9 + x) * sp9 ]
            r9 : f32 [ f32[ sdat[ sb ] ] / 255.0 ]
            g9 : f32 [ f32[ sdat[ sb + 1 ] ] / 255.0 ]
            b9 : f32 [ f32[ sdat[ sb + 2 ] ] / 255.0 ]
            l9 : f32 [ r9 * 0.299 + g9 * 0.587 + b9 * 0.114 ]
            cv9 : f32 [ (r9 - b9) * 0.5 ]

            # the spot: distance in an ellipse three times wider than
            # tall, with the boundary pushed in and out by two octaves
            dxx : f32 [ u - du0 ]
            if [ dxx > 0.5 ] dxx = dxx - 1.0
            if [ dxx < 0.0 - 0.5 ] dxx = dxx + 1.0
            dyy : f32 [ v - dv0 ]
            # 36 degrees of longitude across is not a storm, it is a
            # continent. 7x tighter puts it near jupiter's spot, and the
            # perlin wobble has to shrink with it or it swamps the shape
            rr : f32 [ sqrt[ dxx * dxx * 440.0 + dyy * dyy * 3100.0 ] ]
            nb1 : f32 [ eu_gnoise[ u * 34.0, v * 34.0, 3.0 ] ]
            nb2 : f32 [ eu_gnoise[ u * 88.0 + 5.0, v * 88.0 + 11.0, 17.0 ] ]
            rr = rr + (nb1 - 0.5) * 0.30 + (nb2 - 0.5) * 0.12
            spot : f32 [ 1.0 - eu_sstep[ 0.30, 0.72, rr ] ]
            # a bright collar on its trailing edge, the way a dark storm
            # drags methane cloud around itself
            coll : f32 [ eu_sstep[ 0.62, 0.86, rr ] * (1.0 - eu_sstep[ 0.86, 1.10, rr ]) ]
            l9 = l9 * (1.0 - spot * 0.62) + coll * 0.16

            # JUPITER PATCHES. saturn's deck is smooth to the point of
            # being featureless; jupiter's is the turbulence we want.
            # the mask is perlin sampled around a CIRCLE in longitude,
            # so it closes at the seam instead of cutting a hard line
            # ELONGATED along the wind. the circle radius sets how many
            # noise cells fit around the equator, so 1.6 is 10 cells of
            # 410 texels; 16 in latitude is 128 texels. that is a patch
            # three times wider than tall, lying WITH the bands
            ang : f32 [ u * 6.28318530718 ]
            mx9 : f32 [ cos[ ang ] * 1.6 + 6.0 ]
            my9 : f32 [ sin[ ang ] * 1.6 + 6.0 ]
            pm1 : f32 [ eu_gnoise[ mx9, my9, v * 16.0 ] ]
            # a finer turn breaks the blob edge, kept flat as well so it
            # frays the patch into ribbons instead of vertical fingers
            pm2 : f32 [ eu_gnoise[ mx9 * 2.6 + 19.0, my9 * 2.6 + 7.0, v * 34.0 ] ]
            pm9 : f32 [ pm1 + (pm2 - 0.5) * 0.18 ]
            patch : f32 [ eu_sstep[ 0.44, 0.64, pm9 ] ]
            # FLIPPED in latitude and MIRRORED in longitude, so the
            # borrowed bands do not line up with anything jupiter reads
            # as. both plates are 4096x2048, so this is a direct index
            jx : i32 [ i32[ (1.0 - u) * f32[ jw ] ] ]
            jy : i32 [ i32[ (1.0 - v) * f32[ jh ] ] ]
            if [ jx < 0 ] jx = 0
            if [ jx >= jw ] jx = jw - 1
            if [ jy < 0 ] jy = 0
            if [ jy >= jh ] jy = jh - 1
            jb : i32 [ (jy * jw + jx) * jp9 ]
            jl9 : f32 [ (f32[ jdat[ jb ] ] * 0.299
                       + f32[ jdat[ jb + 1 ] ] * 0.587
                       + f32[ jdat[ jb + 2 ] ] * 0.114) / 255.0 ]
            # stretched about its own mid grey: jupiter's belts flatten
            # out once the ochre is gone, and flat is what we came here
            # to fix
            jl9 = (jl9 - 0.5) * 1.35 + 0.5
            if [ jl9 < 0.0 ] jl9 = 0.0
            if [ jl9 > 1.0 ] jl9 = 1.0
            l9 = l9 + (jl9 - l9) * patch * 0.80

            # DEEP BLUE: structure as luminance, hue carried in code --
            # tinting saturn's ochre would leave it fighting through
            nr : f32 [ l9 * 0.20 + cv9 * 0.10 ]
            ng : f32 [ l9 * 0.46 + cv9 * 0.06 ]
            nb : f32 [ l9 * 0.92 + 0.06 ]
            if [ nr < 0.0 ] nr = 0.0
            if [ ng < 0.0 ] ng = 0.0
            if [ nb > 1.0 ] nb = 1.0
            ob : i32 [ (y * w9 + x) * 4 ]
            od[ ob ]     = u8[ nr * 255.0 ]
            od[ ob + 1 ] = u8[ ng * 255.0 ]
            od[ ob + 2 ] = u8[ nb * 255.0 ]
            od[ ob + 3 ] = 255
    bd : path '../scenes/baked'
    bd.make_dir[]
    im.png[ path '../scenes/baked/neptune-color.png' ]
    puts 'neptune: colour map written'
    return true

# separable running box, wrapping in x and clamping in y. eu_blur is
# a 3x3 kernel run N times -- four passes is a sigma of 1.6 texels,
# which is nothing at all on a plate 4096 across. result lands in S
func nep_box [ S: @f32, T: @f32, w: i32, h: i32, rx: i32, ry: i32 ]
    ivx : f32 [ 1.0 / f32[ rx * 2 + 1 ] ]
    ivy : f32 [ 1.0 / f32[ ry * 2 + 1 ] ]
    for [ y: i32 0, y < h, y += 1 ]
        row : i32 [ y * w ]
        acc : f32 [ 0.0 ]
        for [ k: i32 0 - rx, k <= rx, k += 1 ]
            xx : i32 [ k ]
            if [ xx < 0 ] xx = xx + w
            acc += S[ row + xx ]
        for [ x: i32 0, x < w, x += 1 ]
            T[ row + x ] = acc * ivx
            xo : i32 [ x - rx ]
            if [ xo < 0 ] xo = xo + w
            xn : i32 [ x + rx + 1 ]
            if [ xn >= w ] xn = xn - w
            acc = acc - S[ row + xo ] + S[ row + xn ]
    for [ x: i32 0, x < w, x += 1 ]
        acc : f32 [ 0.0 ]
        for [ k: i32 0 - ry, k <= ry, k += 1 ]
            yy : i32 [ k ]
            if [ yy < 0 ] yy = 0
            if [ yy >= h ] yy = h - 1
            acc += T[ yy * w + x ]
        for [ y: i32 0, y < h, y += 1 ]
            S[ y * w + x ] = acc * ivy
            yo : i32 [ y - ry ]
            if [ yo < 0 ] yo = 0
            yn : i32 [ y + ry + 1 ]
            if [ yn >= h ] yn = h - 1
            acc = acc - T[ yo * w + x ] + T[ yn * w + x ]

# the storm mask for neptune: jupiter's tone term, but taken off a
# BLURRED plate. jupiter reads darkness where neptune reads brightness
# -- its bright methane cloud IS the weather.
#
# the blur is the whole point. thresholding the plate directly gave
# features a median FOUR texels tall running the full circumference,
# which is what the hairlines were; widening the ramp only made them
# more numerous, never thicker. blurred at radius 16 first, the same
# threshold gives a median of 86 texels and a p90 of 349
func neptune_storm [] -> bool
    ci : Image [ uri: path '../scenes/baked/neptune-color.png' ]
    if [ ci.width == 0 ] return false
    w9 : i32 [ ci.width ]
    h9 : i32 [ ci.height ]
    n9 : i32 [ w9 * h9 ]
    L : new f32 [ n9 ]
    eu_lum[ ci, L ]
    # JUPITER'S BAKE, line for line: an isotropic sobel MAX'd with a
    # tone term, then one light gaussian. the structure has to come
    # off the plate itself -- perlin alone gives smears, not cloud.
    # 14, not jupiter's 4: the blue mapping packs this plate into
    # luminance 0.16-0.44, so its gradients are a third of jupiter's
    S : new f32 [ n9 ]
    for [ y: i32 0, y < h9, y += 1 ]
        ym : i32 [ (y > 0) ? y - 1 : 0 ]
        yp : i32 [ (y < h9 - 1) ? y + 1 : h9 - 1 ]
        for [ x: i32 0, x < w9, x += 1 ]
            xm : i32 [ (x > 0) ? x - 1 : w9 - 1 ]
            xp : i32 [ (x < w9 - 1) ? x + 1 : 0 ]
            gx : f32 [ L[ y * w9 + xp ] - L[ y * w9 + xm ] ]
            gy : f32 [ L[ yp * w9 + x ] - L[ ym * w9 + x ] ]
            # 30, not 14. MEASURED: sobel alone peaked at 0.69 of a
            # map the shader reads through smoothstep[0.10, 0.72], so
            # only 0.3% of it ever cleared half. 30 saturates the
            # strongest shear lines and puts ~7% over that gate
            mg : f32 [ sqrt[ gx * gx + gy * gy ] * 30.0 ]
            if [ mg > 1.0 ] mg = 1.0
            # SOBEL ONLY. max'ing this with a brightness term filled
            # broad areas, and a broad mask lets the perlin paint open
            # blobs while the edges stand alone as closed loops --
            # fingerprints. edges alone confine every flash to a shear
            # line, so what draws is a streak running with the band
            S[ y * w9 + x ] = mg
    T : new f32 [ n9 ]
    eu_blur[ S, T, w9, h9, 4 ]
    im : Image [ width: w9, height: h9, format: Pixel.rgba8, linear: true, wrap_u: true ]
    od : @u8 [ im.vdata[] ]
    for [ i: i32 0, i < n9, i += 1 ]
        v9 : f32 [ T[ i ] ]
        if [ v9 < 0.0 ] v9 = 0.0
        if [ v9 > 1.0 ] v9 = 1.0
        b4 : i32 [ i * 4 ]
        od[ b4 ]     = u8[ v9 * 255.0 ]
        od[ b4 + 1 ] = 0
        od[ b4 + 2 ] = 0
        od[ b4 + 3 ] = 255
    im.png[ path '../scenes/baked/neptune-storm.png' ]
    puts 'neptune: storm map written'
    return true

# the ring strip, computed rather than sourced -- neptune has no
# photograph to cut one from. it is read radially only, so one row is
# the whole ring system: x is radius, alpha is how much it blocks.
#
# REAL RADII, in km, against neptune's 24764 equatorial radius. the
# strip spans 40900 to 64500 so Adams lands inside the shader's outer
# edge fade instead of being clipped by it:
#   Galle      41900, ~2000 wide, dust, the faintest of them
#   Le Verrier 53200, ~113 wide
#   Lassell    53200-57200, a broad faint sheet bridging two narrows
#   Arago      57200, narrow
#   Galatea    61953, an unnamed thread at the shepherd's orbit
#   Adams      62933, ~35 wide, the brightest
func nep_ring_r0 [] -> f32
    return 40900.0
func nep_ring_r1 [] -> f32
    return 64500.0

# a soft-shouldered band: flat across its width, gaussian off the ends
func nep_band [ km: f32, c: f32, hw: f32, soft: f32 ] -> f32
    d : f32 [ km - c ]
    if [ d < 0.0 ] d = 0.0 - d
    if [ d <= hw ] return 1.0
    e : f32 [ (d - hw) / soft ]
    return exp[ 0.0 - e * e ]

func neptune_rings [] -> bool
    w9 : i32 [ 2048 ]
    h9 : i32 [ 4 ]
    r0 : f32 [ nep_ring_r0[] ]
    r1 : f32 [ nep_ring_r1[] ]
    im : Image [ width: w9, height: h9, format: Pixel.rgba8, linear: true ]
    od : @u8 [ im.vdata[] ]
    for [ x: i32 0, x < w9, x += 1 ]
        t  : f32 [ (f32[ x ] + 0.5) / f32[ w9 ] ]
        km : f32 [ r0 + t * (r1 - r0) ]
        # each ring's optical depth, scaled so the faint ones survive
        # the 8-bit strip. voyager measured Adams and Le Verrier as
        # the only two that read at all; the rest are dust
        a9 : f32 [ 0.0 ]
        # the named rings, every shoulder ~3x softer than a hard edge
        a9 += nep_band[ km, 41900.0, 1000.0, 1800.0 ] * 0.10
        a9 += nep_band[ km, 53200.0,   60.0,  420.0 ] * 0.55
        a9 += nep_band[ km, 55200.0, 2000.0,  900.0 ] * 0.06
        a9 += nep_band[ km, 57200.0,   50.0,  380.0 ] * 0.18
        a9 += nep_band[ km, 61953.0,   40.0,  350.0 ] * 0.05
        a9 += nep_band[ km, 62933.0,   25.0,  340.0 ] * 0.85
        # minor threads flanking the two bright ones, softer again --
        # no hard width at all, just a wide gaussian either side
        a9 += nep_band[ km, 52150.0,    0.0,  620.0 ] * 0.11
        a9 += nep_band[ km, 54300.0,    0.0,  680.0 ] * 0.09
        a9 += nep_band[ km, 61750.0,    0.0,  700.0 ] * 0.12
        a9 += nep_band[ km, 63950.0,    0.0,  640.0 ] * 0.10
        if [ a9 > 1.0 ] a9 = 1.0
        # dark and near neutral, a touch warm -- voyager saw grey dust,
        # not saturn's bright ice
        cr : f32 [ 0.66 ]
        cg : f32 [ 0.63 ]
        cb : f32 [ 0.61 ]
        for [ y: i32 0, y < h9, y += 1 ]
            b4 : i32 [ (y * w9 + x) * 4 ]
            od[ b4 ]     = u8[ cr * 255.0 ]
            od[ b4 + 1 ] = u8[ cg * 255.0 ]
            od[ b4 + 2 ] = u8[ cb * 255.0 ]
            od[ b4 + 3 ] = u8[ a9 * 255.0 ]
    bd : path '../scenes/baked'
    bd.make_dir[]
    im.png[ path '../scenes/baked/neptune-ring.png' ]
    puts 'neptune: ring strip written'
    return true

func neptune_maps []
    h1 : u64 [ @neptune_bake ]
    h2 : u64 [ @neptune_storm ]
    h3 : u64 [ @neptune_rings ]
    stamp : string '{h1}-{h2}-{h3}'
    sp : path '../scenes/baked/neptune.hash'
    cp : path '../scenes/baked/neptune-color.png'
    stp : path '../scenes/baked/neptune-storm.png'
    rgp : path '../scenes/baked/neptune-ring.png'
    if [ sp.exists[] && cp.exists[] && stp.exists[] && rgp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            puts 'neptune: colour map current ({stamp})'
            return
    if [ neptune_bake[] && neptune_storm[] && neptune_rings[] ] sp.save[ stamp, null ]

# ======================================================================
# URANUS. the plate is saturn's band structure INTERPOLATED into more
# bands than it has: latitude is folded back and forth several times
# over the source, so one pass of saturn's belts becomes several, and
# two folds at different phases are lerped together so the repeat does
# not read. then driven pale cyan -- methane eats the red end, which is
# the whole reason the planet is that colour
func ur_fold [ t: f32 ] -> f32
    x : f32 [ t - floor[ t ] ]
    if [ x > 0.5 ] x = 1.0 - x
    return x * 2.0

func uranus_bake [] -> bool
    si : Image [ uri: path '../scenes/textures/saturn-color.png' ]
    if [ si.width == 0 ]
        puts 'uranus: saturn plate missing'
        return false
    w9 : i32 [ si.width ]
    h9 : i32 [ si.height ]
    sp9 : i32 [ si.pixel_size ]
    sdat : @u8 [ si.vdata[] ]
    puts 'uranus: folding {w9}x{h9} of saturn into more bands'
    im : Image [ width: w9, height: h9, format: Pixel.rgba8, linear: true, wrap_u: true ]
    od : @u8 [ im.vdata[] ]
    for [ y: i32 0, y < h9, y += 1 ]
        v : f32 [ (f32[ y ] + 0.5) / f32[ h9 ] ]
        # 3.5 folds of the source across the disk. the fold mirrors, so
        # the seam at each turn is continuous rather than a cut
        fa : f32 [ ur_fold[ v * 3.5 ] ]
        fb : f32 [ ur_fold[ v * 2.5 + 0.37 ] ]
        # keep both folds off the polar rows, where equirect smears
        ya : i32 [ i32[ (0.06 + fa * 0.88) * f32[ h9 ] ] ]
        yb : i32 [ i32[ (0.06 + fb * 0.88) * f32[ h9 ] ] ]
        if [ ya < 0 ] ya = 0
        if [ ya >= h9 ] ya = h9 - 1
        if [ yb < 0 ] yb = 0
        if [ yb >= h9 ] yb = h9 - 1
        for [ x: i32 0, x < w9, x += 1 ]
            u : f32 [ (f32[ x ] + 0.5) / f32[ w9 ] ]
            # the second fold is read half a turn away in longitude so
            # the two never carry the same storm
            xb : i32 [ (x + w9 / 2) % w9 ]
            ba : i32 [ (ya * w9 + x)  * sp9 ]
            bb : i32 [ (yb * w9 + xb) * sp9 ]
            la : f32 [ (f32[ sdat[ ba ] ] * 0.299 + f32[ sdat[ ba + 1 ] ] * 0.587
                      + f32[ sdat[ ba + 2 ] ] * 0.114) / 255.0 ]
            lb : f32 [ (f32[ sdat[ bb ] ] * 0.299 + f32[ sdat[ bb + 1 ] ] * 0.587
                      + f32[ sdat[ bb + 2 ] ] * 0.114) / 255.0 ]
            # a slow wander decides which fold leads, so the mix itself
            # is not a constant blend of two repeating things
            ang : f32 [ u * 6.28318530718 ]
            mx9 : f32 [ cos[ ang ] * 1.3 + 5.0 ]
            my9 : f32 [ sin[ ang ] * 1.3 + 5.0 ]
            wq : f32 [ eu_gnoise[ mx9, my9, v * 5.0 ] ]
            l9 : f32 [ nep_lerp[ la, lb, eu_sstep[ 0.35, 0.65, wq ] ] ]
            # NO contrast pull. saturn's belts are the whole point of
            # sourcing from it, and flattening them to 0.30 -- then
            # 0.62 -- threw away the thing we came for. the pale look
            # comes from the high colour floors below, not from
            # destroying the luminance that carries the bands
            # PALE CYAN, and nothing else. methane absorbs red, so
            # red carries least and blue-green carry most.
            # the blue variance USED to be baked in here as a second
            # base. it moved into the shader: a plate cannot drift,
            # and the whole point is that it moves with the weather
            nr : f32 [ 0.30 + l9 * 0.42 ]
            ng : f32 [ 0.50 + l9 * 0.42 ]
            nb : f32 [ 0.52 + l9 * 0.40 ]
            if [ nr > 1.0 ] nr = 1.0
            if [ ng > 1.0 ] ng = 1.0
            if [ nb > 1.0 ] nb = 1.0
            ob : i32 [ (y * w9 + x) * 4 ]
            od[ ob ]     = u8[ nr * 255.0 ]
            od[ ob + 1 ] = u8[ ng * 255.0 ]
            od[ ob + 2 ] = u8[ nb * 255.0 ]
            od[ ob + 3 ] = 255
    bd : path '../scenes/baked'
    bd.make_dir[]
    im.png[ path '../scenes/baked/uranus-color.png' ]
    puts 'uranus: colour map written'
    return true

# the same sobel neptune uses, on uranus' own plate
func uranus_storm [] -> bool
    ci : Image [ uri: path '../scenes/baked/uranus-color.png' ]
    if [ ci.width == 0 ] return false
    w9 : i32 [ ci.width ]
    h9 : i32 [ ci.height ]
    n9 : i32 [ w9 * h9 ]
    L : new f32 [ n9 ]
    eu_lum[ ci, L ]
    S : new f32 [ n9 ]
    for [ y: i32 0, y < h9, y += 1 ]
        ym : i32 [ (y > 0) ? y - 1 : 0 ]
        yp : i32 [ (y < h9 - 1) ? y + 1 : h9 - 1 ]
        for [ x: i32 0, x < w9, x += 1 ]
            xm : i32 [ (x > 0) ? x - 1 : w9 - 1 ]
            xp : i32 [ (x < w9 - 1) ? x + 1 : 0 ]
            gx : f32 [ L[ y * w9 + xp ] - L[ y * w9 + xm ] ]
            gy : f32 [ L[ yp * w9 + x ] - L[ ym * w9 + x ] ]
            # 60, not neptune's 30: the contrast pull-out above leaves
            # gradients half what that plate carries
            mg : f32 [ sqrt[ gx * gx + gy * gy ] * 60.0 ]
            if [ mg > 1.0 ] mg = 1.0
            S[ y * w9 + x ] = mg
    T : new f32 [ n9 ]
    eu_blur[ S, T, w9, h9, 4 ]
    im : Image [ width: w9, height: h9, format: Pixel.rgba8, linear: true, wrap_u: true ]
    od : @u8 [ im.vdata[] ]
    for [ i: i32 0, i < n9, i += 1 ]
        v9 : f32 [ T[ i ] ]
        if [ v9 < 0.0 ] v9 = 0.0
        if [ v9 > 1.0 ] v9 = 1.0
        b4 : i32 [ i * 4 ]
        od[ b4 ]     = u8[ v9 * 255.0 ]
        od[ b4 + 1 ] = 0
        od[ b4 + 2 ] = 0
        od[ b4 + 3 ] = 255
    im.png[ path '../scenes/baked/uranus-storm.png' ]
    puts 'uranus: storm map written'
    return true

# URANUS' RINGS: thirteen of them, narrow and dark, epsilon brightest.
# radii in km against the 25559 equatorial radius. every band is FOUR
# TIMES the width neptune's got -- these are drawn to be seen
func ur_ring_r0 [] -> f32
    return 37000.0
func ur_ring_r1 [] -> f32
    return 53000.0

func uranus_rings [] -> bool
    w9 : i32 [ 2048 ]
    h9 : i32 [ 4 ]
    r0 : f32 [ ur_ring_r0[] ]
    r1 : f32 [ ur_ring_r1[] ]
    im : Image [ width: w9, height: h9, format: Pixel.rgba8, linear: true ]
    od : @u8 [ im.vdata[] ]
    for [ x: i32 0, x < w9, x += 1 ]
        t  : f32 [ (f32[ x ] + 0.5) / f32[ w9 ] ]
        km : f32 [ r0 + t * (r1 - r0) ]
        a9 : f32 [ 0.0 ]
        # the soft shoulders have to stay UNDER the gaps between rings.
        # rings 6, 5 and 4 sit only ~370 km apart and do merge -- that
        # is real -- but 1400 km shoulders merged the whole system into
        # one annulus at full alpha, which is not
        # zeta, the inner dust sheet
        a9 += nep_band[ km, 39600.0, 1600.0,  700.0 ] * 0.06
        # the narrow inner three: 6, 5, 4
        a9 += nep_band[ km, 41837.0,  180.0,  190.0 ] * 0.13
        a9 += nep_band[ km, 42234.0,  180.0,  190.0 ] * 0.14
        a9 += nep_band[ km, 42571.0,  180.0,  190.0 ] * 0.15
        # alpha and beta
        a9 += nep_band[ km, 44718.0,  240.0,  250.0 ] * 0.26
        a9 += nep_band[ km, 45661.0,  240.0,  250.0 ] * 0.28
        # eta, gamma, delta
        a9 += nep_band[ km, 47176.0,  200.0,  210.0 ] * 0.20
        a9 += nep_band[ km, 47627.0,  200.0,  210.0 ] * 0.24
        a9 += nep_band[ km, 48300.0,  200.0,  210.0 ] * 0.26
        # lambda, then EPSILON -- the widest and brightest by far
        a9 += nep_band[ km, 50024.0,  140.0,  180.0 ] * 0.10
        a9 += nep_band[ km, 51149.0,  520.0,  620.0 ] * 0.90
        if [ a9 > 1.0 ] a9 = 1.0
        # darker than neptune's. uranus' rings are among the least
        # reflective surfaces in the solar system -- charcoal, not ice
        cr : f32 [ 0.55 ]
        cg : f32 [ 0.56 ]
        cb : f32 [ 0.58 ]
        for [ y: i32 0, y < h9, y += 1 ]
            b4 : i32 [ (y * w9 + x) * 4 ]
            od[ b4 ]     = u8[ cr * 255.0 ]
            od[ b4 + 1 ] = u8[ cg * 255.0 ]
            od[ b4 + 2 ] = u8[ cb * 255.0 ]
            od[ b4 + 3 ] = u8[ a9 * 255.0 ]
    bd : path '../scenes/baked'
    bd.make_dir[]
    im.png[ path '../scenes/baked/uranus-ring.png' ]
    puts 'uranus: ring strip written'
    return true

func uranus_maps []
    h1 : u64 [ @uranus_bake ]
    h2 : u64 [ @uranus_storm ]
    h3 : u64 [ @uranus_rings ]
    stamp : string '{h1}-{h2}-{h3}'
    sp : path '../scenes/baked/uranus.hash'
    cp : path '../scenes/baked/uranus-color.png'
    stp : path '../scenes/baked/uranus-storm.png'
    rgp : path '../scenes/baked/uranus-ring.png'
    if [ sp.exists[] && cp.exists[] && stp.exists[] && rgp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            puts 'uranus: maps current ({stamp})'
            return
    if [ uranus_bake[] && uranus_storm[] && uranus_rings[] ] sp.save[ stamp, null ]

export func uranus_export []
    uranus_maps[]

export func neptune_export []
    neptune_maps[]

export func mars_maps []
    # EVERY function the output depends on, not just the two big ones.
    # a stamp over the bake alone stayed identical when a constant
    # moved, so the build reported the maps current and shipped stale
    # ones -- which is how a misaligned map survived three rebuilds
    h1 : u64 [ @mola_load ]
    h2 : u64 [ @mola_at ]
    h3 : u64 [ @mars_bake_mola ]
    h4 : u64 [ @mars_radius ]
    h5 : u64 [ @mars_hmin ]
    h6 : u64 [ @mars_hmax ]
    h7 : u64 [ @mars_smax ]
    h8 : u64 [ @mars_exag ]
    h9 : u64 [ @mars_vu0 ]
    ha : u64 [ @mars_vu1 ]
    hb : u64 [ @mars_vv0 ]
    hc : u64 [ @mars_vv1 ]
    stamp : string '{h1}-{h2}-{h3}-{h4}-{h5}-{h6}-{h7}-{h8}-{h9}-{ha}-{hb}-{hc}'
    sp : path '../scenes/baked/mars.hash'
    pkp : path '../scenes/baked/mars-pk.png'
    nkp : path '../scenes/baked/mars-nk.png'
    if [ sp.exists[] && pkp.exists[] && nkp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            puts 'mars: baked maps current ({stamp})'
            mars_detail_map[]
            mars_edge_map[]
            mars_river_map[]
            mars_cloud_map[]
            return
    # stamp ONLY on success: saving it after a failed bake caches the
    # failure forever, and the next build reports everything current
    if [ mars_bake_mola[] ] sp.save[ stamp, null ]
    mars_detail_map[]
    mars_edge_map[]
    mars_river_map[]
    mars_cloud_map[]

# the rock material shares NO input with the MOLA bake, so it carries
# its own stamp: touching one must not re-read 2GB of tiles for the other
func mars_detail_map []
    h1 : u64 [ @mars_bake_detail ]
    h2 : u64 [ @eu_bilin ]
    h3 : u64 [ @eu_blur ]
    h4 : u64 [ @eu_sstep ]
    h5 : u64 [ @eu_lum ]
    stamp : string '{h1}-{h2}-{h3}-{h4}-{h5}'
    sp : path '../scenes/baked/mars-dn.hash'
    dnp : path '../scenes/baked/mars-dn.png'
    if [ sp.exists[] && dnp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            puts 'mars: rock detail current ({stamp})'
            return
    if [ mars_bake_detail[] ] sp.save[ stamp, null ]

# no colour map: it has shadows baked into it and fights every light
enum TerraSurface
    height  : 0
    nrm     : 1
    detail  : 2
    edge    : 3
    color   : 4
    veg_a   : 5
    veg_b   : 6
    veg_c   : 7
    river   : 8

ModelViewProject TerraShader
    # unpack scale for the baked height, and the slope range the baked
    # normal encodes. both must match what mars_bake wrote
    mutable hmax     : f32
    mutable smax     : f32
    mutable sun_dir  : vec4f
    mutable cam_pos  : vec4f
    mutable haze     : f32
    # how many times the rock material repeats across the equator, and
    # how far it tilts the normal
    mutable dtile    : f32
    mutable damp     : f32
    # the craft in MODEL space, and the horizon arc in radians: the
    # carpet mesh is laid out relative to both
    mutable eye_m    : vec4f
    mutable hdist    : f32
    # how far the rock material displaces the mesh, in sphere radii
    mutable dh       : f32
    # sea level at the poles, and how much higher it stands at the
    # equator. both in packed height units
    mutable sea_l0   : f32
    mutable sea_bias : f32

    attrib height  : LayoutBinding [ type:typeid[ TerraSurface ], id:TerraSurface.height, count:1, format: typeid[ rgba8 ] ]
    attrib nrm     : LayoutBinding [ type:typeid[ TerraSurface ], id:TerraSurface.nrm,    count:1, format: typeid[ rgba8 ] ]
    attrib detail  : LayoutBinding [ type:typeid[ TerraSurface ], id:TerraSurface.detail, count:1, format: typeid[ rgba8 ] ]
    attrib edge    : LayoutBinding [ type:typeid[ TerraSurface ], id:TerraSurface.edge,   count:1, format: typeid[ rgba8 ] ]
    attrib color   : LayoutBinding [ type:typeid[ TerraSurface ], id:TerraSurface.color,  count:1, format: typeid[ rgba8 ] ]
    attrib veg_a   : LayoutBinding [ type:typeid[ TerraSurface ], id:TerraSurface.veg_a,  count:1, format: typeid[ rgba8 ] ]
    attrib veg_b   : LayoutBinding [ type:typeid[ TerraSurface ], id:TerraSurface.veg_b,  count:1, format: typeid[ rgba8 ] ]
    attrib veg_c   : LayoutBinding [ type:typeid[ TerraSurface ], id:TerraSurface.veg_c,  count:1, format: typeid[ rgba8 ] ]
    attrib river   : LayoutBinding [ type:typeid[ TerraSurface ], id:TerraSurface.river,  count:1, format: typeid[ rgba8 ] ]

    attrib a_pos        : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal     : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv         : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_normal     : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_uv         : VertexOutput  [ type:typeid[ vec2f ] ]
    attrib v_sp         : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_world_pos  : VertexOutput  [ type:typeid[ vec4f ] ]
    attrib v_h          : VertexOutput  [ type:typeid[ f32   ] ]

    attrib fragColor    : FragmentOutput[ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    # the bake, unpacked. 16 bits across R and A, scaled by hmax.
    # the hardware interpolates those two bytes INDEPENDENTLY, so
    # everywhere the low byte wraps 255->0 it ramps backwards across a
    # whole texel and the ground ripples like water. decode four
    # texels FIRST, then interpolate. the coarse mesh averaged this
    # away; a metre-scale mesh resolves every one of them
    func o_ground [ uv: vec2f ] -> GLSL float {
        vec2  ts = vec2(8192.0, 4096.0);
        vec2  pp = uv * ts - 0.5;
        vec2  fr = fract(pp);
        vec2  b0 = (floor(pp) + 0.5) / ts;
        vec2  e1 = 1.0 / ts;
        vec4  q00 = textureLod(height, b0, 0.0);
        vec4  q10 = textureLod(height, b0 + vec2(e1.x, 0.0), 0.0);
        vec4  q01 = textureLod(height, b0 + vec2(0.0, e1.y), 0.0);
        vec4  q11 = textureLod(height, b0 + e1, 0.0);
        float h00 = q00.r * 65280.0 + q00.a * 255.0;
        float h10 = q10.r * 65280.0 + q10.a * 255.0;
        float h01 = q01.r * 65280.0 + q01.a * 255.0;
        float h11 = q11.r * 65280.0 + q11.a * 255.0;
        float hh  = mix(mix(h00, h10, fr.x), mix(h01, h11, fr.x), fr.y);
        return hh / 65535.0 * ubo.hmax;
    }

    # PERLIN BRUSH. fed by the sphere position, never uv -- that is
    # continuous over the whole planet, with no meridian seam and no
    # pole where the cells collapse. e_gnoise belongs to the enceladus
    # shader and is not in scope here
    func o_hash [ p: vec3f ] -> GLSL float {
        return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453123);
    }

    func o_noise [ p: vec3f ] -> GLSL float {
        vec3 i = floor(p);
        vec3 f = fract(p);
        vec3 u = f * f * (3.0 - 2.0 * f);
        return mix(mix(mix(o_hash(i + vec3(0.0, 0.0, 0.0)), o_hash(i + vec3(1.0, 0.0, 0.0)), u.x),
                       mix(o_hash(i + vec3(0.0, 1.0, 0.0)), o_hash(i + vec3(1.0, 1.0, 0.0)), u.x), u.y),
                   mix(mix(o_hash(i + vec3(0.0, 0.0, 1.0)), o_hash(i + vec3(1.0, 0.0, 1.0)), u.x),
                       mix(o_hash(i + vec3(0.0, 1.0, 1.0)), o_hash(i + vec3(1.0, 1.0, 1.0)), u.x), u.y), u.z);
    }

    # four octaves, each shifted so the lattice never prints
    func o_fbm [ p: vec3f ] -> GLSL float {
        float s = 0.0;
        float a = 0.5;
        vec3  q = p;
        for (int i = 0; i < 4; i++) {{
            s += a * o_noise(q);
            q  = q * 2.03 + vec3(11.3, 7.7, 3.1);
            a  = a * 0.5;
        }}
        return s;
    }



    func vertex [] -> GLSL none {
        // the mesh arrives as a FLAT polar grid centred on the craft,
        // its radius a fraction of the horizon arc. wrap it onto the
        // sphere here, so altitude rescales it and nothing rebuilds
        float rn = length(a_pos.xz);
        vec2  pd = rn > 0.0 ? a_pos.xz / rn : vec2(1.0, 0.0);
        vec3  up_m = normalize(ubo.eye_m.xyz);
        vec3  ax9  = abs(up_m.y) > 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3  t_e  = normalize(cross(ax9, up_m));
        vec3  t_n  = cross(up_m, t_e);
        float s9   = rn * ubo.hdist;
        vec3  dir  = normalize(up_m * cos(s9) + (t_e * pd.x + t_n * pd.y) * sin(s9));

        // longitude measured FROM the craft, never absolute: that is
        // what keeps the +/-pi meridian from splitting a triangle.
        // u runs 0.5-based to match the height map's 0.0635 offset
        float lon0 = atan(ubo.eye_m.z, ubo.eye_m.x);
        float dl   = atan(dir.z, dir.x) - lon0;
        if (dl >  3.14159265) dl -= 6.28318531;
        if (dl < -3.14159265) dl += 6.28318531;
        vec2 uv = vec2(0.5 + (lon0 + dl) / 6.28318531,
                       0.5 - asin(clamp(dir.y, -1.0, 1.0)) / 3.14159265);

        v_uv     = uv;
        v_sp     = dir;
        mat3 nm  = transpose(inverse(mat3(ubo.model)));
        v_normal = normalize(nm * dir);
        float g  = o_ground(uv);
        v_h      = g;

        // patch geometry WHERE THE EDGES ARE. the integral image says
        // how much structure the colour map holds around this point;
        // busy ground earns high frequency, dead flat plains stay flat
        vec4  ee = textureLod(edge, uv, 0.0);
        float aug = clamp(ee.r * 0.55 + ee.g * 0.30 + ee.b * 0.15, 0.0, 1.0);
        // the same height-difference gate the shading uses, so the
        // geometry gets patched exactly where the ground moves and a
        // flat plain stays a flat plain
        vec2  vsl  = (textureLod(nrm, uv, 0.0).rg * 2.0 - 1.0) * ubo.smax;
        float vrug = clamp(length(vsl) / 0.12, 0.0, 1.0);
        float vclat = sqrt(max(1.0 - dir.y * dir.y, 0.0025));
        vec2  duv   = vec2(uv.x * vclat * 2.0, uv.y);
        float dsum = 0.0;
        float dw   = 0.0;
        float dfq  = ubo.dtile / 256.0;
        float dwt  = 1.0;
        for (int i = 0; i < 3; i++) {{
            float an = 0.61 * float(i);
            float ca = cos(an);
            float sa = sin(an);
            vec2  ru = mat2(ca, sa, -sa, ca) * duv * dfq + vec2(0.37, 0.71) * float(i);
            dsum += (textureLod(detail, ru, 0.0).b * 2.0 - 1.0) * dwt;
            dw   += dwt;
            dfq  *= 3.0;
            dwt  *= 0.78;
        }}
        vec3 disp = dir * (1.0 + g + dsum / dw * ubo.dh
                                   * (0.10 + 1.90 * vrug) * (0.55 + 0.45 * aug));
        vec4 wpos = ubo.model * vec4(disp, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment [] -> GLSL none {
        vec3 sp = normalize(v_sp);
        // the mesh normal is the ball's and would light this flat. the
        // bake carries the real surface slope at 8192 across, far finer
        // than any mesh we can afford to displace
        vec3 ax = abs(sp.y) > 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3 ea = normalize(cross(ax, sp));
        vec3 no = normalize(cross(sp, ea));
        vec2 sl = (texture(nrm, v_uv).rg * 2.0 - 1.0) * ubo.smax;
        // slope is rise over run along each axis: tilt the sphere normal
        // by it rather than treating the map as a tangent-space normal
        vec3 n = normalize(sp - ea * sl.x - no * sl.y);

        // MOLA is 2600m a texel, so from 13km up the ground is pure
        // bilinear mush. the rock material fills the whole span below
        // that -- SIX octaves from 1300m a texel down to 5m -- so
        // relief exists at every scale between the map and the eye.
        // SHADING ONLY: the silhouette stays MOLA's
        float dist = length(v_world_pos.xyz - ubo.cam_pos.xyz);
        // same aspect correction the vertex used, or the shading grain
        // walks off the geometry it is meant to describe
        float clat = sqrt(max(1.0 - sp.y * sp.y, 0.0025));
        vec2  duv  = vec2(v_uv.x * clat * 2.0, v_uv.y);
        vec2  dxy  = vec2(0.0);
        float cav  = 0.0;
        float rgh  = 0.0;
        float wsum = 0.0;
        // start at 1/256 of the tiling rate, which is where MOLA stops
        float fq = ubo.dtile / 256.0;
        float wt = 1.0;
        // NO per-pixel downslope rotation here. sl comes from an 8-BIT
        // map, so its direction quantises, and duv is already scaled by
        // ~2000 -- one 8-bit step of angle throws the sample eight
        // whole tiles sideways between neighbouring pixels. that is
        // what came out as hard rectangular blocks
        for (int i = 0; i < 6; i++) {{
            // each octave on its own angle and origin, or the ladder
            // stacks into one self-similar pattern instead of terrain
            float an = 0.61 * float(i);
            float ca = cos(an);
            float sa = sin(an);
            vec2  ru = mat2(ca, sa, -sa, ca) * duv * fq + vec2(0.37, 0.71) * float(i);
            vec4  dv = texture(detail, ru);
            dxy  += (dv.rg * 2.0 - 1.0) * wt;
            // B is the material's height: below its own mean is a
            // crevice, above it is a crest catching the light
            cav  += (dv.b * 2.0 - 1.0) * wt;
            rgh  += dv.a * wt;
            wsum += wt;
            // three per step spans 1300m to 5m in six reads. no
            // distance crossfade: the mip chain already retires an
            // octave the moment its texel drops under the pixel, and
            // fading them in bands is what left ONE octave live at a
            // time -- which is why it read as bare grain
            fq *= 3.0;
            wt *= 0.78;
        }}
        dxy /= wsum;
        cav /= wsum;
        rgh /= wsum;
        // amplitude rides REAL HEIGHT DIFFERENCE. sl is the surface's
        // own rise over run, so it IS the height change per metre --
        // where the ground actually moves, the material goes hard, and
        // a dead flat plain keeps almost nothing. 0.12 instead of 0.35
        // brings ordinary martian slopes into range: at 0.35 nearly
        // everything read as flat and the detail sat at its floor
        vec4  ee9 = texture(edge, v_uv);
        float aug = clamp(ee9.r * 0.55 + ee9.g * 0.30 + ee9.b * 0.15, 0.0, 1.0);
        // NORMALISED slope. sl is already multiplied by smax, and
        // smax carries the 3x relief look-control -- so every fixed
        // threshold below was silently 3x too sensitive the moment
        // relief moved. dividing it back out gives the raw map value
        // in 0..1, and these gates mean the same thing at any relief.
        // this is what emptied the valley: flat0 hit zero on the canyon
        // floor, which zeroed basin, which killed sand and water
        float slope0 = length(sl) / max(ubo.smax, 1e-6);
        float rug = clamp(slope0 / 0.08, 0.0, 1.0);
        // the planting needs its own texture BEFORE the normal is set.
        // a canyon floor is dead flat, so the slope gate drops the rock
        // material to its 0.10 floor exactly where the forest sits --
        // which is why the wooded ground came out smooth and lifeless
        float flat0 = 1.0 - clamp(slope0 / 0.20, 0.0, 1.0);
        // EVERYTHING keys off the sea now. raw elevation was the right
        // datum when there was no water; with an ocean, what governs
        // planting, treeline and snow is height ABOVE SEA LEVEL -- and
        // the sea itself tilts with latitude, so a fixed elevation band
        // no longer means the same climate at two different latitudes
        float tg9  = v_h / max(ubo.hmax, 1e-6);
        float sea9 = ubo.sea_l0 + ubo.sea_bias * cos(asin(clamp(sp.y, -1.0, 1.0)));
        float asl  = tg9 - sea9;
        float lowl  = 1.0 - smoothstep(0.0, 0.30, asl);
        float brush  = o_fbm(sp * 6.0);
        float b_fine = o_fbm(sp * 19.0 + vec3(19.0, 5.0, 31.0));
        float cover = clamp((0.45 + 0.55 * lowl) * flat0 * flat0
                            * (0.40 + 1.20 * brush) - 0.15, 0.0, 1.0);
        cover *= 1.0 - aug * 0.45;
        // WET LOWLANDS, as a CONTINUOUS field. the drainage network on
        // its own was a hairline -- 1% of the box, pixels of it at
        // this altitude. this is one big perlin over the whole basin
        // floor, about half of it wet, with the flow map only LEANING
        // it so the real channels sit wettest inside each patch.
        // sp * 1.5 is a very large patch: whole reaches of valley, not
        // a stipple
        vec4  rv9   = texture(river, v_uv);
        // VERY soft: sp * 0.62 makes one patch span a large part of
        // the whole canyon system, so the wet ground arrives as broad
        // washes instead of a stipple you have to look for
        float wperl = o_fbm(sp * 0.62 + vec3(41.0, 13.0, 7.0));
        // the whole canyon FLOOR is basin, not just its deepest reaches
        // -- and gated by FLATNESS, because sand does not lie on a
        // cliff and water certainly does not stand on one
        // reaches much further UP the valley -- 0.28 kept it pinned to
        // the deepest floor, so most of the canyon never qualified
        float basin = smoothstep(0.08, 0.44, lowl) * flat0 * flat0;
        // -0.75, not -0.30. the field used to average 0.85, which is
        // past the sand threshold everywhere -- so the floor was sand
        // wall to wall and there was no green left beside it for the
        // eye to read a transition against. this centres it so all
        // three bands get real ground
        float wetf  = clamp(basin * (wperl * 2.30 - 0.62), 0.0, 1.0);
        // the CHANNEL is water in its own right, not a nudge on the
        // perlin. the bake's accumulation tops out at 94/255, so as a
        // lean it could never cross the water threshold -- rescaled to
        // its real range it carves the drainage straight through the
        // sand, which is the reflective thread the flats were missing
        // the drainage BIASES the field, it does not punch water in on
        // its own. maxing it straight into wet drew 2600m-wide threads
        // with a hard smoothstep edge -- that was the aliasing, and it
        // left water with no sand around it. folded into wetf instead,
        // every pool is automatically rimmed by sand, because sand and
        // water are two thresholds on the SAME field
        float chan  = smoothstep(0.05, 0.30, rv9.r) * basin;
        wetf = clamp(wetf + chan * 0.40, 0.0, 1.0);
        // THREE bands on one field, in order, with real width each:
        // green below 0.28, sand from 0.28 to 0.56, water above 0.60.
        // sand used to start at 0.02 and finish by 0.30 -- saturated
        // before the water band even began, so it read as the floor's
        // base colour rather than as a shore
        // wide, soft ramps: a shore is a gradient, not a contour
        float sand  = smoothstep(0.16, 0.54, wetf);
        float wet   = smoothstep(0.56, 0.94, wetf);
        cover *= (1.0 - wet) * (1.0 - sand * 0.95);

        // SDF TO THE SHORE. (ground - sea) is a height difference, and
        // dividing it by the local slope turns it into a HORIZONTAL
        // distance -- so the beach keeps its width whether the shore
        // shelves gently or drops off a cliff. that is the whole point
        // of a distance field over a height threshold: a plain height
        // band would be kilometres wide on a flat and vanish on a wall
        float dsh  = asl * ubo.hmax / max(length(sl), 0.0020);
        // reaches about 2km inland and the same distance out
        float beach = 1.0 - smoothstep(0.0, 0.00060, abs(dsh));
        // 80% of the shoreline is beach; the other fifth runs to rock
        float bmask = smoothstep(0.34, 0.46, o_fbm(sp * 5.5 + vec3(61.0, 17.0, 5.0)));
        beach *= bmask;
        // THE SEABED IS SAND, all of it. `wet` is the terrain's own
        // perlin field, not the real sea -- the sea is the shell, so
        // the ground under it was never told it was submerged and kept
        // its rock. the water is transparent in the shallows, so that
        // rock was showing straight through
        float seabed = 1.0 - smoothstep(-0.00060, 0.00060, dsh);
        sand   = max(sand, max(beach, seabed));
        cover *= (1.0 - beach) * (1.0 - seabed);

        // GREEN ONLY NEAR WATER. growth needs the water it grows beside,
        // so cover falls away with distance from the shoreline -- and
        // dsh is already a horizontal distance in metres, so this is a
        // real reach inland rather than an elevation guess. a perlin
        // section then decides WHICH stretches of coast are green at
        // all; the rest of the planet is left as bare mars
        float reach = 1.0 - smoothstep(0.0, 0.0080, max(dsh, 0.0));
        float vsec  = smoothstep(0.28, 0.64, o_fbm(sp * 2.1 + vec3(13.0, 47.0, 29.0)));
        cover *= reach * vsec;
        // and NOTHING grows high up, whatever the shoreline says. a
        // steep coast keeps dsh small a long way up a cliff, so reach
        // alone would run grass right up the wall. asl is height above
        // sea: full growth under 1.4km, gone by 5.2km, bare mars above
        cover *= 1.0 - smoothstep(0.020, 0.075, asl);

        // SNOW -- the reverse of the lowlands. cold high ground holds
        // ice, and it caps the planting rather than replacing it. steep
        // faces shed it, same as sand cannot lie on a cliff
        float high9 = 1.0 - lowl;
        float snowf = clamp(smoothstep(0.42, 0.80, high9)
                          * (0.45 + 1.05 * o_fbm(sp * 2.6 + vec3(7.0, 29.0, 17.0)))
                          - 0.18, 0.0, 1.0) * flat0;
        // a TWENTYFOLD span: a tenth on dead flat ground, double where
        // the surface actually moves. the edge map only trims it, and
        // canopy carries relief of its own however flat the ground is
        // SMOOTH the wet ground. sand flat and standing water have no
        // scree and no rock grain -- leaving the material on them is
        // what made the canyon floor read as blown-out white rubble.
        // water goes fully flat so it can behave like glass
        float smooth9 = (1.0 - sand * 0.88) * (1.0 - wet) * (1.0 - snowf * 0.70);
        n = normalize(n + (ea * dxy.x + no * dxy.y)
                        * ubo.damp * (0.10 + 1.90 * rug + 1.30 * cover)
                        * (0.55 + 0.45 * aug) * smooth9);

        // NO carve here. the bank field is a dilated 8-bit map that
        // steps about 14% per texel, so any real gain turns every step
        // into a cliff -- at 26 it shattered the whole floor into
        // facets. a groove would have to come from a smooth distance
        // field, not from this one

        mat3 nmm = transpose(inverse(mat3(ubo.model)));
        vec3 nw = normalize(nmm * n);

        vec3 sun = normalize(ubo.sun_dir.xyz);
        float ndl = max(dot(nw, sun), 0.0);
        // TERRAFORMED. the mars map is the ground underneath -- its
        // baked shadows matter far less once vegetation covers it --
        // and the planting mixes on top
        vec3  c_rock = vec3(0.26, 0.16, 0.11);
        vec3  c_dust = vec3(0.64, 0.43, 0.28);
        float crest = clamp(cav * 0.5 + 0.5, 0.0, 1.0);
        float flat9 = 1.0 - clamp(slope0 / 0.20, 0.0, 1.0);
        vec3  marsc = texture(color, v_uv).rgb;
        float marsl = dot(marsc, vec3(0.333));
        vec3  bare  = marsc;
        bare = mix(bare, mix(c_rock, c_dust, flat9 * (0.35 + 0.65 * crest)), 0.45);
        bare *= 0.78 + 0.44 * crest;
        bare = mix(bare, vec3(dot(bare, vec3(0.35, 0.48, 0.17))), rgh * 0.25);

        // WHERE it grows -- lowl, brush, b_fine and cover were all
        // worked out above, because the normal needed cover before the
        // lighting ran. deep ground holds water and air, slope sheds
        // both, and the perlin brush wanders the boundary so it never
        // reads as a contour line

        // ELEVATION picks the planting, not distance. the canyon floor
        // is the deepest, warmest, densest air on the planet and it
        // takes the forest; the plateau above the rim gets grass. lowl
        // reads about 0.97 on the Valles floor against 0.43 up top,
        // so the band between them is where the treeline sits
        vec2  vuv = duv * ubo.dtile;
        float treeline = smoothstep(0.62, 0.90, lowl);

        // STOCHASTIC PATCHING. one tap at one rate repeats on a grid,
        // which is what you were looking at. three taps at scales that
        // share no common multiple, with the brush choosing which one
        // OWNS each patch, pushes the repeat period out past the
        // horizon. the brush drives the WEIGHTS, never the coordinate:
        // a scale that varies per pixel multiplies its own gradient by
        // uv -- about 3000 here -- and aliases, the same way the
        // downslope rotation did
        // FAR larger patches: 0.180 put 737 plates around the equator,
        // a 29km stamp that reads as uniform mush. these run 65 to 320,
        // so a plate covers 100-330km and its features are legible.
        // each tap also gets its OWN fixed rotation -- scale alone left
        // every copy square to the grid, which is the column look.
        // fixed, never per-pixel: a turning coordinate aliases
        mat2 r0 = mat2( 1.0000,  0.0000,  0.0000, 1.0000);
        mat2 r1 = mat2( 0.4258,  0.9048, -0.9048, 0.4258);
        mat2 r2 = mat2(-0.7859,  0.6184, -0.6184,-0.7859);
        float k1 = smoothstep(0.28, 0.72, brush);
        float k2 = smoothstep(0.34, 0.78, b_fine);
        vec3  gA = texture(veg_b, r0 * vuv * 0.0160 + vec2(0.13, 0.41)).rgb;
        vec3  gB = texture(veg_b, r1 * vuv * 0.0290 + vec2(0.61, 0.07)).rgb;
        vec3  gC = texture(veg_b, r2 * vuv * 0.0521 + vec2(0.29, 0.83)).rgb;
        vec3  v_gras = mix(mix(gA, gB, k1), gC, k2 * 0.65);
        vec3  cA = texture(veg_c, r1 * vuv * 0.0240 + vec2(0.37, 0.71)).rgb;
        vec3  cB = texture(veg_c, r2 * vuv * 0.0434 + vec2(0.07, 0.53)).rgb;
        vec3  cC = texture(veg_c, r0 * vuv * 0.0781 + vec2(0.83, 0.19)).rgb;
        vec3  v_tree = mix(mix(cA, cB, k2), cC, k1 * 0.60);
        // SAND gets the same three-tap treatment as the planting, and
        // three rotations on top. it measures 0.849 coherent at -57
        // degrees -- by far the most directional plate we own -- so
        // only its LEVEL is taken and the hue is carried in code. no
        // single tap can print its dune direction across the planet
        float sA = dot(texture(veg_a, r1 * vuv * 0.0090 + vec2(0.11, 0.37)).rgb, vec3(0.333));
        float sB = dot(texture(veg_a, r2 * vuv * 0.0163 + vec2(0.53, 0.19)).rgb, vec3(0.333));
        float sC = dot(texture(veg_a, r0 * vuv * 0.0294 + vec2(0.29, 0.71)).rgb, vec3(0.333));
        float slv = mix(mix(sA, sB, k2), sC, k1 * 0.60);
        // sand, not chalk. 0.82 x (0.60 + 0.70) reached 1.1 before the
        // 1.25 diffuse gain even touched it, which is why the floor
        // burned out to white
        // ONE perlin mask for all three, so the bare ground that breaks
        // through the snow is the same ground that breaks through the
        // planting and the sand. how much each KEEPS of the mars map
        // differs: sand 10, planting 50, snow 70
        float mmix = smoothstep(0.30, 0.74, o_fbm(sp * 3.3 + vec3(53.0, 11.0, 23.0)));
        vec3  c_sand = vec3(0.60, 0.53, 0.40) * (0.72 + 0.42 * slv);
        c_sand = mix(c_sand, marsc, mmix * 0.10);
        // the base under the planting: barely tinted, and carrying the
        // map's own colour. it was 0.42/0.50/0.30 -- green in its own
        // right, so even bare ground read as grass
        vec3  c_base = marsc * (0.85 + 0.55 * slv) * vec3(0.92, 1.00, 0.86);
        // sand base underneath, grass wherever cover takes hold, and
        // the forest only down in the valley. the brush wobbles the
        // treeline so it wanders instead of ringing the canyon at one
        // exact contour
        vec3  veg = c_base;
        veg = mix(veg, v_gras, smoothstep(0.12, 0.52, cover));
        veg = mix(veg, v_tree, treeline * smoothstep(0.20, 0.60, cover)
                             * (0.55 + 0.45 * b_fine));
        // the planting does not erase the planet. the mars map's own
        // light and dark provinces show THROUGH it -- multiplied in, so
        // bright terrain carries bright growth, plus a little of its
        // colour straight so the ground keeps its identity under green
        // MOSTLY the mars map. multiplying against its full COLOUR
        // carries every crater, streak and dark province through the
        // planting -- taking only its luminance flattened all that to
        // one featureless wash. the 2.05 lifts it back out of the
        // darkening a straight multiply costs
        veg *= marsc * 2.05 + 0.06;
        // MOSTLY mars, everywhere -- not only inside the perlin
        // patches. a floor of 55% bare ground with the patches taking
        // it to 90%, so the planting reads as a tint over martian
        // terrain rather than as a green surface of its own
        veg = mix(veg, marsc * (0.95 + 0.30 * slv), 0.55 + 0.35 * mmix);
        vec3  base = mix(bare, veg, cover);
        // grass gives way to sand, and the channel bed is sand as well
        // so the water reads as riverbed underneath and not as rock
        base = mix(base, c_sand * (0.86 + 0.28 * crest), max(sand, wet));
        // the SHORE is pale, washed sand -- brighter and less red than
        // the dry inland sand, or a beach is the same tan as the ground
        // behind it and reads as nothing at all. wet sand darkens right
        // at the waterline the way a tide line does
        vec3 c_shore = vec3(0.80, 0.74, 0.62) * (0.78 + 0.34 * slv);
        c_shore = mix(c_shore, marsc, mmix * 0.10);
        c_shore *= 1.0 - 0.34 * (1.0 - smoothstep(0.0, 0.00022, abs(dsh)));
        base = mix(base, c_shore, beach);
        // ice over the top. the sand plate's own grain stands in for
        // snow texture -- it is the only fine granular thing we own,
        // and taken as level only it carries no direction
        vec3 c_snow = vec3(0.84, 0.89, 0.97) * (0.80 + 0.32 * slv);
        // same rule as the planting: snow lying thin lets the ground's
        // own colour through, so the provinces stay legible under it
        c_snow *= 0.72 + 0.62 * marsl;
        // same perlin, so the rock that breaks through the snow is the
        // rock that breaks through the planting further down
        c_snow = mix(c_snow, marsc * 0.92, mmix * 0.70);
        base = mix(base, c_snow, snowf);

        // a grazing sun throws long shadow: the terminator on a slope is
        // hard, so keep the ambient low or the shadows turn to grey mud
        // gain under 1: the map is already a bright albedo, and pushing
        // it past full white flattens every ridge into paper
        vec3 lit = base * (0.16 + ndl * 1.25);

        // GRASS SHINE. living leaf is waxy and throws a broad sheen,
        // and its own texture says where -- flat lawn glares, deep
        // canopy swallows it
        vec3  gvd = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        vec3  ghv = normalize(sun + gvd);
        float gsp = pow(max(dot(nw, ghv), 0.0), 26.0);
        lit += vec3(0.62, 0.72, 0.44) * gsp * cover * (1.0 - sand) * 0.55
             * (0.35 + 0.65 * dot(veg, vec3(0.333)));

        // ICE SHEEN. glazed snow is a half-mirror: a tight highlight
        // plus a fresnel rim, so it flares as the ground turns away
        float isp  = pow(max(dot(nw, ghv), 0.0), 140.0);
        float ifr  = 0.04 + 0.96 * pow(1.0 - max(dot(nw, gvd), 0.0), 5.0);
        lit += (vec3(1.00, 1.00, 1.06) * isp * 0.85
             +  vec3(0.62, 0.72, 0.92) * ifr * 0.16) * snowf;

        // WATER. the channel is a surface of its own: the rock material
        // gets flattened out of the normal so it can reflect, the bed
        // shows through the shallows, and the sun leaves a hard
        // highlight because still water is very nearly a mirror
        if (wet > 0.001) {{
            // GLASS. the surface is the sphere's own normal, with only
            // a trace of the terrain left in it -- still water is flat
            // however rough its bed, and any grain here kills the
            // mirror. so the look is carried by reflection and fresnel,
            // not by a diffuse term
            vec3  wn   = normalize(mix(n, sp, 0.985));
            vec3  wnw  = normalize(nmm * wn);
            vec3  wvd  = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
            vec3  hv   = normalize(sun + wvd);
            float spec = pow(max(dot(wnw, hv), 0.0), 900.0);
            float wndl = max(dot(wnw, sun), 0.0);
            // schlick: looked at flat, water is nearly all reflection,
            // and a canyon floor seen from orbit is a very flat look
            float fres = 0.02 + 0.98 * pow(1.0 - max(dot(wnw, wvd), 0.0), 5.0);
            // purplish blue, deepening where the catchment is largest
            // shallows stay purplish blue; the deep runs RED. this is
            // iron-laden water over red rock, not an earth ocean
            vec3  shal = vec3(0.31, 0.30, 0.58);
            vec3  mid9 = vec3(0.30, 0.17, 0.36);
            vec3  deep = vec3(0.42, 0.11, 0.12);
            float dpt9 = smoothstep(0.15, 0.95, wetf);
            vec3  wcol = mix(shal, mid9, smoothstep(0.0, 0.55, dpt9));
            wcol = mix(wcol, deep, smoothstep(0.45, 1.0, dpt9));
            // the sky it mirrors, warmed toward the sun like the haze
            vec3  sky  = mix(vec3(0.30, 0.31, 0.52), vec3(1.05, 0.80, 0.58),
                             pow(max(dot(-wvd, sun), 0.0), 3.0));
            vec3  wlit = wcol * (0.14 + wndl * 0.55) * (1.0 - fres)
                       + sky * fres * 1.15
                       + vec3(1.00, 0.97, 1.05) * spec * 5.0;
            lit = mix(lit, wlit, wet);
        }}

        // ATMOSPHERE. mars air is loaded with suspended dust, and it
        // forward-scatters hard: looking away from the sun it is deep
        // iron red, across it a dusty orange, and straight into it a
        // yellow gold. one three-stop ramp on the scattering angle
        vec3 vd = normalize(v_world_pos.xyz - ubo.cam_pos.xyz);
        float fw = max(dot(vd, sun), 0.0);
        float fs = pow(fw, 6.0);
        // FOG BY DISTANCE, not by sun angle. yellow gold only close in,
        // through brown red across the middle, into purple at range --
        // one continuous ramp, so the ground and the shell above it
        // never paint two separate arcs
        float fd = clamp(dist / 0.55, 0.0, 1.0);
        // the far haze is the same warm white-gold as the sunlit cloud,
        // NOT purple. purple belongs above the horizon, in space --
        // down here it read as a bruise across the distance
        vec3 dust = mix(vec3(1.30, 0.98, 0.56), vec3(1.02, 0.72, 0.44),
                        smoothstep(0.0, 0.40, fd));
        dust = mix(dust, vec3(0.92, 0.74, 0.58), smoothstep(0.35, 1.0, fd));
        // looking into the sun still lifts it, but only in brightness
        dust *= 1.0 + 0.85 * fs;
        // FOG pools in the basins: the column of air above a canyon
        // floor is far deeper than over a plateau, and dust settles
        // into it. asl is height above sea, so this thickens downward
        float fogl = 1.0 - smoothstep(-0.02, 0.14, asl);
        float hz = 1.0 - exp(-dist * ubo.haze * (1.0 + fs * 4.0)
                                  * (0.55 + 1.60 * fogl));
        vec3 outc = mix(lit, dust, clamp(hz, 0.0, 1.0));

        // LIMB GLOW. at the horizon the line of sight grazes the entire
        // depth of the dust column, so the air lights up exactly where
        // the ground runs out. the crossfade IS the softness: geometry
        // fades DOWN by mu while the dust flares UP through the same
        // band. mu collapses to zero in the last fraction of a percent
        // of the projected radius, so the fade has to start at mid-band
        // or it spans no pixels at all
        vec3  vdir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        vec3  nsp  = normalize(nmm * sp);
        float mu   = clamp(dot(nsp, vdir), 0.0, 1.0);
        // MIX, never add. adding leaves the terrain underneath still
        // showing, so craters and ridges print their shapes through the
        // glow. mixing to full replaces them -- at the rim there is
        // nothing but air, which is what a deep atmosphere looks like
        float limb = smoothstep(0.30, 0.03, mu);
        // the near band is the same dust as the haze; the outermost
        // fade goes purple, the way a thick sky does at its top
        // terrain stays OPAQUE to its edge and simply DARKENS by mu.
        // the shell above flares up through the same band -- that
        // crossfade is the softness, and it is why the ground must not
        // try to paint its own rim colour here
        outc *= 0.30 + 0.70 * smoothstep(0.0, 0.12, mu);

        fragColor = vec4(outc, 1.0);
    }


# THE SKY SHELL. the rim glow on the ground can only light fragments
# that HAVE ground, so it stops dead at the silhouette. this is the
# same carpet mesh a third time, lifted to a shell above the surface,
# so there is geometry ABOVE the limb to carry the fade into space.
#
# its opacity comes from the ray's CLOSEST APPROACH to the planet --
# the classic optical-depth trick. a ray grazing the surface travels
# through the whole dust column and is opaque; one passing high above
# barely clips it. that is what fades the fuzz out to black, and it
# costs a dot product and an exp
enum TerraCloudSurface
    volume  : 0

ModelViewProject TerraSkyShader
    mutable sun_dir  : vec4f
    mutable cam_pos  : vec4f
    mutable eye_m    : vec4f
    mutable hdist    : f32
    mutable atm_h    : f32
    mutable atm_fall : f32
    mutable atm_gain : f32
    # the cloud deck: base and top radius, coverage, and wind phase
    mutable cld_lo   : f32
    mutable cld_hi   : f32
    mutable cld_cov  : f32
    mutable cld_time : f32
    # how hard the wind shears the deck along the equator
    mutable cld_wind : f32

    attrib volume  : LayoutBinding [ type:typeid[ TerraCloudSurface ], id:TerraCloudSurface.volume, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos        : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal     : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv         : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_normal     : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_uv         : VertexOutput  [ type:typeid[ vec2f ] ]
    attrib v_sp         : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_world_pos  : VertexOutput  [ type:typeid[ vec4f ] ]
    attrib v_h          : VertexOutput  [ type:typeid[ f32   ] ]

    attrib fragColor    : FragmentOutput[ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    func vertex [] -> GLSL none {
        float rn = length(a_pos.xz);
        vec2  pd = rn > 0.0 ? a_pos.xz / rn : vec2(1.0, 0.0);
        vec3  up_m = normalize(ubo.eye_m.xyz);
        vec3  ax9  = abs(up_m.y) > 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3  t_e  = normalize(cross(ax9, up_m));
        vec3  t_n  = cross(up_m, t_e);
        // THE WHOLE SPHERE, not a cap. the carpet is a polar grid, so
        // mapping its radius across a half-turn wraps it into a closed
        // shell with NO mesh boundary anywhere. a cap ends somewhere,
        // and wherever it ended the alpha was still 0.06 -- that was
        // the hard line straight across the sky
        float s9   = (rn / 1.35) * 3.14159265;
        vec3  dir  = normalize(up_m * cos(s9) + (t_e * pd.x + t_n * pd.y) * sin(s9));
        v_uv     = a_uv;
        v_sp     = dir;
        v_normal = dir;
        v_h      = 0.0;
        vec4 wpos = ubo.model * vec4(dir * (1.0 + ubo.atm_h), 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func c_hash [ p: vec3f ] -> GLSL float {
        return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453123);
    }

    func c_remap [ x: f32, a: f32, b: f32, c: f32, d: f32 ] -> GLSL float {
        return c + (clamp(x, a, b) - a) / max(b - a, 1e-5) * (d - c);
    }

    # henyey-greenstein: real droplets scatter FORWARD, which is the
    # silver lining you get looking toward the sun through a cloud edge
    func c_hg [ ct: f32, g: f32 ] -> GLSL float {
        float g2 = g * g;
        return (1.0 - g2) / (12.566371 * pow(1.0 + g2 - 2.0 * g * ct, 1.5));
    }

    # one z-slice of the baked 64^3 volume out of its 8x8 atlas. the
    # 63/64 inset stops bilinear bleeding a neighbouring slice in
    func c_slice [ uv: vec2f, z: f32 ] -> GLSL vec4f {
        float zi = mod(z, 64.0);
        vec2  t  = (uv * 63.0 + 0.5) / 512.0;
        return texture(volume, vec2(mod(zi, 8.0) * 0.125 + t.x,
                                    floor(zi / 8.0) * 0.125 + t.y));
    }

    # trilinear: bilinear is free inside a slice, the z lerp by hand
    func c_vol [ p: vec3f ] -> GLSL vec4f {
        vec3  q  = fract(p);
        float zf = q.z * 64.0 - 0.5;
        float z0 = floor(zf);
        return mix(c_slice(q.xy, z0), c_slice(q.xy, z0 + 1.0), zf - z0);
    }

    # DENSITY, built the way the volumetric-cloud papers do it: a
    # billow base cut by coverage, then ERODED at its edges by the
    # high-frequency octaves. the erosion makes wisps and torn
    # shoulders; without it every cloud is a smooth blob
    func c_dens [ p: vec3f ] -> GLSL float {
        float r = length(p);
        float h = (r - (1.0 + ubo.cld_lo)) / max(ubo.cld_hi - ubo.cld_lo, 1e-5);
        if (h < 0.0 || h > 1.0) return 0.0;
        // anvil profile: flat base, widest low, feathering at the top
        // FLAT base: cut on hard at the deck floor so the underside is
        // a plane, the way a real cloud base condenses at one altitude
        float prof = smoothstep(0.0, 0.035, h) * (1.0 - smoothstep(0.62, 1.0, h));
        // and FOUR TIMES the material at the base. a deck of even
        // density top to bottom is a slab -- real cloud carries its
        // mass low and thins upward, which is what gives a cloudscape
        // its weight and lets the crowns read as crowns
        // TEN to one, base to top. the base has to be the body of the
        // thing and the crown a remnant of it
        prof *= mix(1.0, 0.10, h);
        // WIND SHEAR. scaling the POLAR component makes the field vary
        // fast in latitude and slow in longitude, so every lobe is
        // drawn out east-west and the deck bands parallel to the
        // equator -- which is what a prevailing wind does to cloud.
        // it stretches the shapes rather than resizing them
        vec3  ps = vec3(p.x, p.y * ubo.cld_wind, p.z);
        // 1.2, not 3.0. the threshold only ever keeps the PEAK of each
        // worley lobe, so a 282km lobe was surviving as a core a
        // fraction that size -- spikes with no footprint. a 706km lobe
        // leaves a base worth the name even after the cut
        vec3  q = ps * 1.2 + vec3(ubo.cld_time, ubo.cld_time * 0.05, ubo.cld_time * 0.6);
        vec4  v = c_vol(q);
        // coverage cuts the RAW field; the profile attenuates AFTER.
        // cutting `v.r * prof` instead made the height profile push
        // samples across the threshold, so the deck's own taper became
        // a hard in/out surface in 3D -- that is what tore
        float base = c_remap(v.r, 1.0 - ubo.cld_cov, 1.0, 0.0, 1.0);
        if (base <= 0.001) return 0.0;
        float d = base * prof;
        if (d <= 0.001) return 0.0;
        // erosion strengthens with height, so bases stay solid and the
        // crowns tear into cauliflower
        vec4  hf = c_vol(q * 2.9 + vec3(19.3, 7.1, 11.7));
        // (q already carries the shear, so the erosion runs WITH the
        // bands rather than cutting across them)
        float ero = hf.g * 0.625 + hf.b * 0.250 + hf.a * 0.125;
        // barely eroded at the base, heavily at the crown: that is what
        // keeps bottoms flat and breaks the tops into scattered heads
        // nothing at all at the base -- erosion there is what was
        // trimming the footprint away as fast as coverage made it
        d = c_remap(d, ero * (0.02 + 0.80 * h), 1.0, 0.0, 1.0);
        return clamp(d, 0.0, 1.0);
    }

    func fragment [] -> GLSL none {
        // THE ENCELADUS METHOD. the model transform is a pure rotation,
        // so the planet centre is the world origin and the ray's
        // closest approach is one dot product. everything comes from
        // that radius: a ray grazing the surface crosses the whole dust
        // column, one passing high above barely clips it
        vec3  ro = ubo.cam_pos.xyz;
        vec3  rd = normalize(v_world_pos.xyz - ro);
        float tca = 0.0 - dot(ro, rd);
        float glow = 0.0;
        float hw = 0.0;
        float rch = 0.0;
        vec3  sunw = normalize(ubo.sun_dir.xyz);
        if (tca > 0.0) {{
            vec3  pca = ro + rd * tca;
            float rc  = length(pca);
            // in SCALE HEIGHTS, not a fixed radius: the colour ramp has
            // to travel with the alpha or extending the air just parks
            // a solid purple band out where it used to fade
            rch = clamp((rc - 1.0) / (ubo.atm_fall * 2.13), 0.0, 1.0);
            // outward, a long slow fade into space. the smoothstep is a
            // SMOOTH occlusion ramp -- a binary cut stamps the analytic
            // sphere's silhouette as a hard circle offset from the real
            // displaced terrain edge
            float od = exp(-max(rc - 1.0, 0.0) / ubo.atm_fall)
                     * smoothstep(0.976, 0.997, rc);
            // and smoothed again by penetration depth going inward
            float dip  = clamp((1.0 - rc) / 0.018, 0.0, 1.0);
            float hocc = mix(1.0, 0.35, dip);
            hw = clamp(dot(pca / max(rc, 1e-4), sunw) * 0.5 + 0.5, 0.0, 1.0);
            // the blaze where the graze kisses the surface: this is
            // what DISSOLVES the terrain edge, so no ridge or crater
            // prints its shape through the rim
            // asymmetric on purpose: wide going out into space, tight
            // going in, or the rim glow lies over the terrain as fog
            float nearg = exp(-(max(rc - 1.0, 0.0) / 0.012
                              + max(1.0 - rc, 0.0) / 0.0035));
            glow = od * hocc * (0.16 + 0.52 * hw) * (1.0 + 5.0 * nearg);
            // THIN THE FLOOR. holding full opacity right down onto the
            // limb is what gives it a thick base -- easing it off there
            // lifts the whole visible band up off the horizon
            glow *= 0.30 + 0.70 * smoothstep(0.0, 0.34, rch);
        }}
        float fw = max(dot(rd, sunw), 0.0);
        // the same air as the ground haze: gold into the sun, iron red
        // away from it -- and purple where it thins out to nothing
        // ONE colour, and the ALPHA does the fading. tinting toward
        // purple as it thinned just painted a solid purple band up
        // there -- the air has to thin to NOTHING, and that is a fade
        // to transparent, not a fade to another colour
        // THREE stops now. a transparent yellow sits on the horizon
        // itself, the warm white-gold you liked is lifted above it, and
        // purple takes over only as the whole thing dies into space
        vec3 col = mix(vec3(1.36, 1.06, 0.42), vec3(1.18, 0.86, 0.56),
                       smoothstep(0.0, 0.40, rch));
        col = mix(col, vec3(0.40, 0.20, 0.58), smoothstep(0.44, 1.0, rch));
        col *= 1.0 + 0.80 * pow(fw, 4.0);
        float atma = clamp(glow * ubo.atm_gain, 0.0, 0.58);

        // ---- VOLUMETRIC CLOUDS ----
        // the deck is a spherical shell. clip the ray to it, march, and
        // light each sample by marching a few steps toward the sun --
        // that self-shadowing is what gives a cloud its shape. flat
        // billboards cannot do it at any resolution
        float r0 = 1.0 + ubo.cld_lo;
        float r1 = 1.0 + ubo.cld_hi;
        float bq = dot(ro, rd);
        float c1 = dot(ro, ro) - r1 * r1;
        float c0 = dot(ro, ro) - r0 * r0;
        float cg = dot(ro, ro) - 1.0;
        float d1 = bq * bq - c1;
        vec3  cL = vec3(0.0);
        float Tr = 1.0;
        if (d1 > 0.0) {{
            float s1 = sqrt(d1);
            float tn = -bq - s1;
            float tf = -bq + s1;
            // inside the outer shell already: start at the eye
            if (tn < 0.0) tn = 0.0;
            // the inner sphere and the planet both cut the march short
            float d0 = bq * bq - c0;
            if (d0 > 0.0) {{
                float t0 = -bq - sqrt(d0);
                if (t0 > tn) tf = min(tf, t0);
            }}
            float dg = bq * bq - cg;
            if (dg > 0.0) {{
                float tg = -bq - sqrt(dg);
                if (tg > 0.0) tf = min(tf, tg);
            }}
            // a grazing ray crosses the deck for an enormous distance;
            // spreading a fixed step count over it makes dt huge and
            // the march prints as stair-stepped bands. cap the segment
            tf = min(tf, tn + 0.42);
            if (tf > tn) {{
                // FIXED STEP SIZE, not a fixed count. a count spread
                // over a grazing crossing gave 30km steps against 3km
                // features -- that is the speckle. a constant step
                // samples every ray at the same rate and simply runs
                // out of budget on the long ones, by which point they
                // are opaque anyway
                // EIGHT TIMES the tests. the step is three times finer
                // and the budget eight times longer -- affordable only
                // because empty air is skipped at triple stride below,
                // and most of the deck is empty
                // UNIFORM stride. the adaptive skip made neighbouring
                // pixels land on different sample positions and take
                // different step counts, so two pixels looking at one
                // cloud disagreed -- that is noise by construction
                float dt = (ubo.cld_hi - ubo.cld_lo) / 40.0;
                const int STEPS = 640;
                float jit = c_hash(vec3(gl_FragCoord.xy, 7.3));
                // MODEL space: the craft holds station while the planet
                // turns, so a field sampled in WORLD space sits still
                // relative to the camera -- the clouds were painted on
                // the lens. the planet's frame is what we fly through
                mat3 wm = transpose(mat3(ubo.model));
                vec3 sunm = wm * sunw;
                // forward scattering: strong lobe plus a wide one, the
                // usual two-term fit to real droplet phase
                float ct = dot(normalize(rd), sunw);
                float ph = max(c_hg(ct, 0.76), c_hg(ct, -0.22) * 0.55);
                // YELLOW where the sun strikes, through GREY in the
                // body, to PURPLE in shadow and along the base. the
                // ramp runs on how much light reached the sample, so
                // it is lighting doing it, not a height gradient
                vec3 c_lit = vec3(1.35, 1.12, 0.58);
                vec3 c_mid = vec3(0.62, 0.60, 0.63);
                vec3 c_shd = vec3(0.34, 0.22, 0.48);
                vec3 sunc = mix(c_lit, vec3(1.18, 0.72, 0.36),
                                smoothstep(0.35, 0.0, abs(sunw.y)));
                // ambient: purple sky above, dusty violet bounce below
                vec3 amb_t = vec3(0.40, 0.33, 0.55);
                vec3 amb_b = vec3(0.30, 0.20, 0.40);
                float tc = tn + jit * dt;
                for (int i = 0; i < STEPS; i++) {{
                    if (tc > tf) break;
                    vec3  p = wm * (ro + rd * tc);
                    tc += dt;
                    float d = c_dens(p);
                    // clear air costs one sample and three steps of
                    // ground: the fine rate is spent only inside cloud
                    if (d > 0.0004) {{
                        // light march toward the sun: this self-shadow
                        // is what gives a cloud an inside
                        float lstep = (ubo.cld_hi - ubo.cld_lo) * 0.22;
                        float ls = c_dens(p + sunm * lstep)
                                 + c_dens(p + sunm * lstep * 2.2)
                                 + c_dens(p + sunm * lstep * 4.0)
                                 + c_dens(p + sunm * lstep * 7.0) * 0.5;
                        float dep = ls * lstep;
                        // beer-powder: a cloud edge is BRIGHTER than
                        // its face, which single beer cannot express
                        float beer = exp(-dep * 52.0);
                        float powd = 1.0 - exp(-d * 9.0);
                        float hh = clamp((length(p) - (1.0 + ubo.cld_lo))
                                       / max(ubo.cld_hi - ubo.cld_lo, 1e-5), 0.0, 1.0);
                        vec3  amb = mix(amb_b, amb_t, hh);
                        // beer is how much sun survived to here: 1 at a
                        // sunlit face, 0 deep inside. that is the axis
                        // the yellow-grey-purple ramp belongs on
                        // crowns go WHITE, not yellow -- the yellow is
                        // the low sun on their flanks
                        vec3  crown = mix(sunc, vec3(1.42, 1.36, 1.22), hh * hh);
                        vec3  body = mix(c_shd, c_mid, smoothstep(0.02, 0.35, beer));
                        body = mix(body, crown, smoothstep(0.30, 0.85, beer));
                        // and the base sits in its own shadow: purple,
                        // deepening the lower in the deck it lies
                        body = mix(body, c_shd, (1.0 - hh) * (1.0 - hh) * 0.72);
                        vec3  sc  = body * (0.55 + powd * ph * 2.2) + amb * (0.30 + 0.55 * hh);
                        // DENSER: they were see-through at any depth
                        float aa  = 1.0 - exp(-d * dt * 210.0);
                        cL += Tr * aa * sc;
                        Tr *= 1.0 - aa;
                        if (Tr < 0.015) break;
                    }}
                }}
            }}
        }}
        float cloud_a = 1.0 - Tr;
        // clouds sit UNDER the limb glow: the air is above the deck
        // PREMULTIPLIED, and the model is set straight_alpha:false so
        // the pipeline blends with SRC=ONE. the march already produces
        // premultiplied values -- cL accumulates as Tr*a*colour -- so
        // dividing it back out only to have the blender multiply it in
        // again blows the colour up wherever alpha is near zero, which
        // is precisely a cloud's edge. that was the tearing
        vec3  outc = cL + col * atma * Tr;
        float outa = clamp(cloud_a + atma * Tr, 0.0, 1.0);
        fragColor = vec4(outc, outa);
    }


enum TerraWaterSurface
    height  : 0

# A REAL WATER SURFACE. the terraformed sea is a shell of its own at
# sea-level radius, riding the same carpet mesh as the ground, and the
# waterline is where that shell passes through the terrain -- not a
# threshold painted on rock. that is what gives a true shore, real
# depth, and an ocean that fills basins instead of following noise
ModelViewProject TerraWaterShader
    mutable hmax     : f32
    mutable sun_dir  : vec4f
    mutable cam_pos  : vec4f
    mutable haze     : f32
    mutable eye_m    : vec4f
    mutable hdist    : f32
    mutable sea_l0   : f32
    mutable sea_bias : f32

    attrib height  : LayoutBinding [ type:typeid[ TerraWaterSurface ], id:TerraWaterSurface.height, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos        : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal     : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv         : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_normal     : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_uv         : VertexOutput  [ type:typeid[ vec2f ] ]
    attrib v_sp         : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_world_pos  : VertexOutput  [ type:typeid[ vec4f ] ]
    attrib v_h          : VertexOutput  [ type:typeid[ f32   ] ]

    attrib fragColor    : FragmentOutput[ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    # same four-tap decode the ground uses: the 16 bits live across R
    # and A, and bilinear on the low byte ramps backwards at every wrap
    func w_ground [ uv: vec2f ] -> GLSL float {
        vec2  ts = vec2(8192.0, 4096.0);
        vec2  pp = uv * ts - 0.5;
        vec2  fr = fract(pp);
        vec2  b0 = (floor(pp) + 0.5) / ts;
        vec2  e1 = 1.0 / ts;
        vec4  q00 = textureLod(height, b0, 0.0);
        vec4  q10 = textureLod(height, b0 + vec2(e1.x, 0.0), 0.0);
        vec4  q01 = textureLod(height, b0 + vec2(0.0, e1.y), 0.0);
        vec4  q11 = textureLod(height, b0 + e1, 0.0);
        float h00 = q00.r * 65280.0 + q00.a * 255.0;
        float h10 = q10.r * 65280.0 + q10.a * 255.0;
        float h01 = q01.r * 65280.0 + q01.a * 255.0;
        float h11 = q11.r * 65280.0 + q11.a * 255.0;
        return mix(mix(h00, h10, fr.x), mix(h01, h11, fr.x), fr.y) / 65535.0;
    }

    # sea level stands HIGHER at the equator: warm ground fills easier,
    # and that bias is the whole reason the valley is a sea while the
    # polar basins stay dry
    func w_sea [ dy: f32 ] -> GLSL float {
        return ubo.sea_l0 + ubo.sea_bias * cos(asin(clamp(dy, -1.0, 1.0)));
    }

    func vertex [] -> GLSL none {
        float rn = length(a_pos.xz);
        vec2  pd = rn > 0.0 ? a_pos.xz / rn : vec2(1.0, 0.0);
        vec3  up_m = normalize(ubo.eye_m.xyz);
        vec3  ax9  = abs(up_m.y) > 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3  t_e  = normalize(cross(ax9, up_m));
        vec3  t_n  = cross(up_m, t_e);
        float s9   = rn * ubo.hdist;
        vec3  dir  = normalize(up_m * cos(s9) + (t_e * pd.x + t_n * pd.y) * sin(s9));

        float lon0 = atan(ubo.eye_m.z, ubo.eye_m.x);
        float dl   = atan(dir.z, dir.x) - lon0;
        if (dl >  3.14159265) dl -= 6.28318531;
        if (dl < -3.14159265) dl += 6.28318531;
        vec2 uv = vec2(0.5 + (lon0 + dl) / 6.28318531,
                       0.5 - asin(clamp(dir.y, -1.0, 1.0)) / 3.14159265);

        v_uv     = uv;
        v_sp     = dir;
        mat3 nm  = transpose(inverse(mat3(ubo.model)));
        v_normal = normalize(nm * dir);
        // the shell sits at SEA level, flat as water is
        float sg = w_sea(dir.y) * ubo.hmax;
        v_h      = sg;
        vec4 wpos = ubo.model * vec4(dir * (1.0 + sg), 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment [] -> GLSL none {
        vec3  sp = normalize(v_sp);
        float tg = w_ground(v_uv);
        float sea = w_sea(sp.y);
        // ABOVE the waterline there is no sea here. cutting the shell
        // per pixel is what makes the shore follow the real contour
        // instead of a painted threshold
        float depth = sea - tg;
        // a MARGIN, not zero. at exactly the waterline the sea shell and
        // the ground are coplanar, and the depth test alternates between
        // them pixel by pixel -- that is the dashed contour. 0.0012 of
        // packed height is ~80m of water, thin enough to see nothing
        if (depth <= 0.0012) discard;

        mat3 nmm = transpose(inverse(mat3(ubo.model)));
        vec3 nw  = normalize(nmm * sp);
        vec3 sun = normalize(ubo.sun_dir.xyz);
        vec3 vdw = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        vec3 hv  = normalize(sun + vdw);

        // shallows purplish blue, the deep running RED -- iron water
        // over red rock, not an earth ocean
        float dn   = clamp(depth / 0.16, 0.0, 1.0);
        // cyan through the body, greener where it shallows out, and a
        // deep teal at the bottom rather than an ocean navy
        vec3  shal = vec3(0.34, 0.74, 0.60);
        vec3  mid9 = vec3(0.13, 0.56, 0.66);
        vec3  deep = vec3(0.03, 0.17, 0.30);
        vec3  wcol = mix(shal, mid9, smoothstep(0.00, 0.45, dn));
        wcol = mix(wcol, deep, smoothstep(0.40, 1.00, dn));
        // the bed used to be FAKED by brightening the water colour in
        // the shallows. it is real now: the shell blends, so the actual
        // terrain underneath shows through wherever the water is thin

        // FOAM where the sea runs out onto the shore -- the same
        // contour the terrain puts its beach on, read from the other side
        float foam = 1.0 - smoothstep(0.0, 0.0055, depth);
        wcol = mix(wcol, vec3(0.78, 0.74, 0.80), foam * foam * 0.70);

        float ndl  = max(dot(nw, sun), 0.0);
        float spec = pow(max(dot(nw, hv), 0.0), 700.0);
        float fres = 0.02 + 0.98 * pow(1.0 - max(dot(nw, vdw), 0.0), 5.0);
        vec3  sky  = mix(vec3(0.32, 0.31, 0.55), vec3(1.05, 0.80, 0.58),
                         pow(max(dot(-vdw, sun), 0.0), 3.0));
        vec3  lit  = wcol * (0.16 + ndl * 0.72) * (1.0 - fres * 0.75)
                   + sky * fres * 0.38
                   + vec3(1.00, 0.97, 1.05) * spec * 4.5;

        // the same air as the ground, and the sea lies at the very
        // bottom of it -- so it always carries the thick-layer factor
        float dist = length(v_world_pos.xyz - ubo.cam_pos.xyz);
        vec3  vdd = normalize(v_world_pos.xyz - ubo.cam_pos.xyz);
        float fw = max(dot(vdd, sun), 0.0);
        float fs = pow(fw, 6.0);
        float fd = clamp(dist / 0.55, 0.0, 1.0);
        // the far haze is the same warm white-gold as the sunlit cloud,
        // NOT purple. purple belongs above the horizon, in space --
        // down here it read as a bruise across the distance
        vec3 dust = mix(vec3(1.30, 0.98, 0.56), vec3(1.02, 0.72, 0.44),
                        smoothstep(0.0, 0.40, fd));
        dust = mix(dust, vec3(0.92, 0.74, 0.58), smoothstep(0.35, 1.0, fd));
        dust *= 1.0 + 0.85 * fs;
        float hz = 1.0 - exp(-dist * ubo.haze * (1.0 + fs * 4.0) * 2.05);
        vec3  outc = mix(lit, dust, clamp(hz, 0.0, 1.0));
        // the sea takes the same limb treatment, or the water edge
        // stays hard while the land beside it goes soft
        float mu = clamp(dot(nw, vdw), 0.0, 1.0);
        outc *= 0.30 + 0.70 * smoothstep(0.0, 0.12, mu);

        // TRANSPARENT AT THE EDGES. thin water hides nothing, so the
        // shore fades out over the bed instead of ending on a hard
        // colour boundary -- and it means the beach reads continuously
        // from dry sand, through wet sand, into water
        // FOUR TIMES the reach. this band is the shallows, and it has
        // to span real ground -- at 0.014 the bed only showed for the
        // last kilometre of depth, which is a rim, not a shallow
        float wa = smoothstep(0.0, 0.056, depth);
        fragColor = vec4(outc, clamp(wa, 0.0, 1.0));
    }


# a UNIFORM globe spends its triangles where nobody is looking. at
# 3072x1536 that was 9.4M triangles, 252MB, and STILL only 6.93km a
# quad -- fifteen times coarser than the MOLA data underneath it,
# so nothing under 7km could ever reach the silhouette.
#
# from altitude h the entire visible planet is the spherical cap out
# to the horizon arc, and nothing past it shows except peaks tall
# enough to clear the bulge. so a polar grid CENTRED ON THE CRAFT
# covers everything the globe did, with the rings packed under the
# camera: 573k triangles, 16MB, and about a metre a quad up close.
#
# ring radius is stored as a FRACTION of the horizon arc, so the
# vertex shader scales it by altitude and the mesh never rebuilds
func carpet_steps [] -> i32
    return 1024
# rings grow by this fraction near the craft...
func carpet_grow [] -> f32
    return 0.0296
# ...but a step NEVER exceeds this, which is a quarter of the
# height map's 2600m texel. past a texel the mesh undersamples the
# map, and a map sliding under an undersampled mesh is the ripple
func carpet_cap [] -> f32
    return 0.00215
# the innermost ring, and how far past the horizon the outer one
# reaches -- 1.35 catches peaks standing above it
func carpet_rmin [] -> f32
    return 0.0004
func carpet_rmax [] -> f32
    return 1.35

func build_carpet [] -> GltfModel
    na : i32 [ carpet_steps[] ]
    n1 : i32 [ na + 1 ]
    # ring radii first: geometric while the steps are small, then
    # CAPPED so no step ever outruns a height-map texel
    rmn9 : f32 [ carpet_rmin[] ]
    rmx9 : f32 [ carpet_rmax[] ]
    cap9 : f32 [ carpet_cap[] ]
    gro9 : f32 [ carpet_grow[] ]
    RR : new f32 [ 4096 ]
    RR[ 0 ] = 0.0
    kk : i32 [ 1 ]
    rc : f32 [ rmn9 ]
    while [ rc < rmx9 && kk < 4095 ]
        RR[ kk ] = rc
        kk += 1
        st9 : f32 [ rc * gro9 ]
        if [ st9 > cap9 ] st9 = cap9
        rc = rc + st9
    RR[ kk ] = rmx9
    kk += 1
    m1 : i32 [ kk ]
    nr : i32 [ kk - 1 ]
    puts 'CARPET rings={nr} steps={na} tris={nr * na * 2}'
    nv : i32 [ n1 * m1 ]
    nv3 : i32 [ nv * 3 ]
    nv2 : i32 [ nv * 2 ]
    ni : i32 [ na * nr * 6 ]
    vb : i32 [ nv3 * 4 ]
    tb : i32 [ nv2 * 4 ]
    ib : i32 [ ni * 4 ]
    tsz : i32 [ vb + vb + tb + ib ]
    data : new u8 [ tsz ]
    pf : @f32 [ data ]
    ip : @data[ vb + vb + tb ]
    iu : @u32 [ ip ]
    for [ ir: i32 0, ir <= nr, ir += 1 ]
        # ring 0 collapses to the point under the craft; its quads
        # are degenerate and cost nothing
        rn : f32 [ RR[ ir ] ]
        for [ ia: i32 0, ia <= na, ia += 1 ]
            th : f32 [ f32[ ia ] * 6.2831853 / f32[ na ] ]
            vi : i32 [ ir * n1 + ia ]
            i3 : i32 [ vi * 3 ]
            # the plane offset from the craft, in horizon fractions.
            # the shader wraps it onto the sphere
            pf[ i3 ]     = rn * cos[ th ]
            pf[ i3 + 1 ] = 0.0
            pf[ i3 + 2 ] = rn * sin[ th ]
            pf[ nv3 + i3 ]     = 0.0
            pf[ nv3 + i3 + 1 ] = 1.0
            pf[ nv3 + i3 + 2 ] = 0.0
            # uv comes from the wrapped direction, per vertex, in
            # the shader -- there is none to store here
            i2 : i32 [ nv3 * 2 + vi * 2 ]
            pf[ i2 ]     = 0.0
            pf[ i2 + 1 ] = 0.0
    k : i32 [ 0 ]
    # SAME order as the globe's. the opposite order renders only a
    # strip just past the tangent point -- the back of the bulge,
    # seen because everything nearer was facing away and culled
    for [ ir: i32 0, ir < nr, ir += 1 ]
        for [ ia: i32 0, ia < na, ia += 1 ]
            i0 : i32 [ ir * n1 + ia ]
            iu[ k ]     = u32[ i0 ]
            iu[ k + 1 ] = u32[ i0 + n1 ]
            iu[ k + 2 ] = u32[ i0 + 1 ]
            iu[ k + 3 ] = u32[ i0 + 1 ]
            iu[ k + 4 ] = u32[ i0 + n1 ]
            iu[ k + 5 ] = u32[ i0 + n1 + 1 ]
            k += 6
    bufs : vec GltfBuffer []
    bufs += GltfBuffer [ byteLength: u64[ tsz ], data: data ]
    views : vec BufferView []
    views += BufferView [ buffer: 0, byteOffset: 0,            byteLength: vb ]
    views += BufferView [ buffer: 0, byteOffset: vb,           byteLength: vb ]
    views += BufferView [ buffer: 0, byteOffset: vb + vb,      byteLength: tb ]
    views += BufferView [ buffer: 0, byteOffset: vb + vb + tb, byteLength: ib ]
    accs : vec Accessor []
    accs += Accessor [ bufferView: 0, componentType: ComponentType.FLOAT, type: CompoundType.VEC3, count: nv ]
    accs += Accessor [ bufferView: 1, componentType: ComponentType.FLOAT, type: CompoundType.VEC3, count: nv ]
    accs += Accessor [ bufferView: 2, componentType: ComponentType.FLOAT, type: CompoundType.VEC2, count: nv ]
    accs += Accessor [ bufferView: 3, componentType: ComponentType.UNSIGNED_INT, type: CompoundType.SCALAR, count: ni ]
    am : map i64 [ string ] [ ]
    am[ 'POSITION' ]   = i64[ 0 ]
    am[ 'NORMAL' ]     = i64[ 1 ]
    am[ 'TEXCOORD_0' ] = i64[ 2 ]
    prs : vec Primitive []
    prs += Primitive [ name: 'olympus', attributes: am, indices: u64[ 3 ], material: 0, mode: Mode.TRIANGLES ]
    mshs : vec Mesh []
    mshs += Mesh [ name: 'olympus', primitives: prs ]
    nds : vec Node []
    nds += Node [ name: 'olympus', mesh: 0 ]
    sn : vec i64 []
    sn += 0
    scns : vec Scene []
    scns += Scene [ name: 'scene', nodes: sn ]
    gm : GltfModel [ nodes: nds, meshes: mshs, scenes: scns, scene: 0,
        buffers: bufs, bufferViews: views, accessors: accs ]
    return gm

element Terra
    frost : true
    frost_sharp : true
    intern olymp  : TerraShader
    intern owater : TerraWaterShader
    intern osky   : TerraSkyShader
    intern gsky   : GaiaShader
    intern models : vec Model
    intern target : Render
    intern built  : bool
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    intern e_cur  : f32
    intern dbg_n  : i32
    public color  : rgba [ r:0.004, g:0.003, b:0.004, a:1.0 ]

    func build_models[]
        built = true
        puts 'TERRA build_models: start'
        o_gltf : build_carpet[]
        o_gltf.hold[]
        o_gltf.compute_worlds[]
        puts 'TERRA build_models: sphere built'
        olymp = TerraShader [ vk: vk ]
        pkp : path '../scenes/baked/mars-pk.png'
        nkp : path '../scenes/baked/mars-nk.png'
        dnp : path '../scenes/baked/mars-dn.png'
        ekp : path '../scenes/baked/mars-ek.png'
        rvp : path '../scenes/baked/mars-rv.png'
        if [ !pkp.exists[] || !nkp.exists[] ]
            puts 'mars: no baked maps — baking live (SILVER_EXPORT=1 bakes at build)'
            mars_bake_mola[]
        if [ !dnp.exists[] ]
            puts 'mars: no rock detail — baking live'
            mars_bake_detail[]
        if [ !ekp.exists[] ]
            puts 'mars: no edge map — baking live'
            mars_bake_edge[]
        if [ !rvp.exists[] ]
            puts 'mars: no river map — baking live'
            mars_bake_river[]
        # data maps MUST be linear or the sampler re-linearizes them and
        # the whole surface drops below its real height
        o_samplers : map Image [string] [
            'height': Image [ uri: pkp, surface: TerraSurface.height, linear: true, wrap_u: true ],
            'nrm':    Image [ uri: nkp, surface: TerraSurface.nrm,    linear: true, wrap_u: true ],
            'detail': Image [ uri: dnp, surface: TerraSurface.detail, linear: true, wrap_u: true, wrap_v: true ],
            'edge':   Image [ uri: ekp, surface: TerraSurface.edge,   linear: true, wrap_u: true ],
            'color':  Image [ uri: path '../scenes/textures/mars-color-8192x4096.jpg', surface: TerraSurface.color, linear: true, wrap_u: true ],
            'veg_a':  Image [ uri: path '../scenes/textures/mars-veg-sand.png',   surface: TerraSurface.veg_a, linear: true, wrap_u: true, wrap_v: true ],
            'veg_b':  Image [ uri: path '../scenes/textures/mars-veg-grass.png',  surface: TerraSurface.veg_b, linear: true, wrap_u: true, wrap_v: true ],
            'veg_c':  Image [ uri: path '../scenes/textures/mars-veg-forest.png', surface: TerraSurface.veg_c, linear: true, wrap_u: true, wrap_v: true ],
            'river':  Image [ uri: rvp, surface: TerraSurface.river, linear: true, wrap_u: true ]
        ]
        puts 'TERRA build_models: maps loaded'
        # the projection y-flip reverses triangle winding, so back-face
        # culling would cull the whole carpet
        o_model : Model [ vk: vk, w: ux, id: o_gltf, s: olymp, samplers: o_samplers,
            straight_alpha: true, cull_none: true ]
        # the sea rides the SAME carpet, one shell higher. it needs only
        # the height map: everything else it works out per pixel
        owater = TerraWaterShader [ vk: vk ]
        w_samplers : map Image [string] [
            'height': Image [ uri: pkp, surface: TerraWaterSurface.height, linear: true, wrap_u: true ]
        ]
        w_model : Model [ vk: vk, w: ux, id: o_gltf, s: owater, samplers: w_samplers,
            straight_alpha: true, cull_none: true ]
        # the sky shell needs no maps at all -- it works entirely from
        # the ray's geometry. drawn LAST so it lays over both surfaces
        osky = TerraSkyShader [ vk: vk ]
        cldp : path '../scenes/baked/mars-cld.png'
        if [ !cldp.exists[] ]
            puts 'mars: no cloud volume — baking live'
            mars_bake_cloud[]
        # the volume tiles on all three axes, so both axes wrap
        s_samplers : map Image [string] [
            'volume': Image [ uri: cldp, surface: TerraCloudSurface.volume,
                linear: true, wrap_u: true, wrap_v: true ]
        ]
        # PREMULTIPLIED: a volumetric march accumulates premultiplied
        # colour by construction, so the blender must not scale it again
        s_model : Model [ vk: vk, w: ux, id: o_gltf, s: osky, samplers: s_samplers,
            straight_alpha: false, cull_none: true, depth_no_test: true ]
        # the galaxy behind everything, same plate the saturn scenes use
        gsky = GaiaShader [ vk: vk ]
        g_gltf : GltfModel.open[ path '../scenes/models/earth.gltf' ]
        g_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/gaia.png', surface: GaiaSurface.color ]
        ]
        g_model : Model [ vk: vk, w: ux, id: g_gltf, s: gsky, samplers: g_samplers,
            straight_alpha: true, cull_none: true ]
        # backdrop FIRST, then ground, sea, and the air over both
        models  = vec Model [] [ g_model, o_model, w_model, s_model ]
        puts 'TERRA build_models: done, {models.count} model(s)'

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      (ux.frost_eff[] == 2) ? 2.0 : 1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        ux.element_targets[ id ] = target

    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    func load_bg [ arg: object :: t: Terra ]
        t.build_models[]
        t.ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : vec Au []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: lambda load_bg[ a ], work: w9 ]
        if [ !ready ] return
        create_target[]
        orbit[]

    func orbit[]
        aspect : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]
        # ORBIT DISTANCE from the centre, not eye height. this was left
        # over from the ground-stage version and put the camera 0.0035
        # from the origin -- inside the planet, looking at its core,
        # with the whole surface backface-culled around it
        # ALTITUDE above the datum, not orbit distance: this is a craft
        # over the deck. 0.004 is 13km, 0.05 is 170km
        # the two lowest rungs are gone. 13km and 51km sat so far under
        # the deck that Valles ran off both edges; this starts where the
        # old ladder ENDED and climbs. 0.130 is the rung that holds the
        # whole 3280km trunk inside the horizon at once
        e_t : f32 [ (ux.orbit_mode == OrbitView.low)  ? 0.050 :
                    (ux.orbit_mode == OrbitView.high) ? 0.130 :
                    (ux.orbit_mode == OrbitView.far)  ? 0.340 : 0.800 ]
        if [ e_cur == 0.0 ] e_cur = e_t
        e_cur = filter_n[ e_cur, e_t, 0.06, ux.frame_factor ]

        # the spin has to come FIRST now: the craft's latitude is a
        # function of how far along the canyon it has flown
        # 184.39 sat at u=0.275 -- already 400km INSIDE the trunk, which
        # measures 0.2557..0.4099. 173 starts at u=0.245, just short of
        # the western end, so the canyon opens ahead instead of being
        # half behind us. the drift below stays anchored to 184.39, so
        # starting earlier simply begins it further north, on the axis
        spin_d : f32 [ 173.0 + ux.time * 900.0 ]

        # the craft rides over Valles Marineris' own latitude while the
        # planet turns under it -- that IS the flight, no path needed
        # MEASURED off mars-pk by weighted fit of the trunk's own axis:
        #   lat = -0.03489 * lon - 12.388
        # so Ius-Melas-Coprates runs 2.03 degrees SOUTH OF DUE EAST. a
        # constant latitude is a parallel, and a parallel cannot stay
        # in a canyon that trends -- it enters at one rim and leaves by
        # the other, which is the angle you were looking at. drifting
        # the craft south as it runs east puts the track ON the axis.
        # the 25.2 tilt means model latitude is not world latitude, so
        # the drift is stated in world terms: -0.0387 per degree of spin
        vlat : f32 [ radians[ -10.718 - 0.0387 * (spin_d - 184.39) ] ]
        cx : f32 [ 0.0 ]
        cy : f32 [ sin[ vlat ] ]
        cz : f32 [ cos[ vlat ] ]
        e_r : f32 [ 1.0 + e_cur ]
        _eye : vec3f [ cx * e_r, cy * e_r, cz * e_r ]

        # the ground flows past in the direction Y cross up, because the
        # model spins about Y. look that way, not at the planet centre --
        # aiming at the centre is nadir by definition, which is the
        # straight-down view you were getting
        # Y x c is the direction the GROUND flows. the craft travels the
        # other way, so forward is the negative of it -- aiming along
        # the flow puts you on the stern watching the wake
        # the planet's spin axis in WORLD space is TILTED: mm applies
        # the 25.2 about Z and then spins about Y, so the axis the
        # ground actually turns on is Rz(25.2) * Y, not Y. taking Y
        # aimed the camera 25.6 degrees off the true travel direction,
        # which is what every "look further right" was chasing
        axr : f32 [ radians[ 25.2 ] ]
        wx : f32 [ 0.0 - sin[ axr ] ]
        wy : f32 [ cos[ axr ] ]
        wz : f32 [ 0.0 ]
        # ground flow is w x c; the craft travels the other way
        gx : f32 [ 0.0 - (wy * cz - wz * cy) ]
        gy : f32 [ 0.0 - (wz * cx - wx * cz) ]
        gz : f32 [ 0.0 - (wx * cy - wy * cx) ]
        gl : f32 [ sqrt[ gx * gx + gy * gy + gz * gz ] ]
        if [ gl > 0.0 ]
            gx = gx / gl
            gy = gy / gl
            gz = gz / gl

        # yaw 15 degrees to starboard, about the SCREEN up (-c, the same
        # inversion look_at gets), so right here means right on screen.
        # g is horizontal and c is radial, so their cross is already unit
        # ZERO. g is the true travel direction now, so any yaw at all is
        # aim pointed away from where the craft is going
        yaw : f32 [ radians[ 0.0 ] ]
        yc : f32 [ cos[ yaw ] ]
        ys : f32 [ sin[ yaw ] ]
        # sign flipped: look_at is given -c as its up, which inverts the
        # screen, so cross(g, -c) came out as screen LEFT. every degree
        # of "right" yaw was pushing the canyon further right instead
        rx : f32 [ gy * cz - gz * cy ]
        ry : f32 [ gz * cx - gx * cz ]
        rz : f32 [ gx * cy - gy * cx ]
        gx2 : f32 [ gx * yc + rx * ys ]
        gy2 : f32 [ gy * yc + ry * ys ]
        gz2 : f32 [ gz * yc + rz * ys ]
        gx = gx2
        gy = gy2
        gz = gz2

        # the horizon sits BELOW local horizontal by the dip angle, and
        # from this low that is only a few degrees. six degrees past it
        # drops the limb into the upper third, like the reference
        dip : f32 [ acos[ 1.0 / e_r ] ]
        pit : f32 [ dip + radians[ 6.0 ] ]
        pc : f32 [ cos[ pit ] ]
        ps : f32 [ sin[ pit ] ]
        dx : f32 [ gx * pc - cx * ps ]
        dy : f32 [ gy * pc - cy * ps ]
        dz : f32 [ gz * pc - cz * ps ]
        _tgt : vec3f [ _eye.x + dx, _eye.y + dy, _eye.z + dz ]
        # THE up, not its negative. mat4f.perspective is GL handed
        # (m[1][1] is +ifov) and the viewport height is positive, so
        # vulkan renders it upside down; negating up rolled the camera
        # 180 to cancel that, which negates RIGHT as well and leaves the
        # whole image horizontally MIRRORED. that is why every yaw
        # correction went the wrong way. flip the projection's y
        # instead and keep the true up
        _up : vec3f [ cx, cy, cz ]
        # near must be tight: at 13km altitude a 0.002 near plane clips
        # the ground out from under the craft
        _proj : mat4f.perspective[ radians[ 55.0 ], aspect, 0.00005, 24.0 ]
        _proj.m[5] = 0.0 - _proj.m[5]
        _view : mat4f.look_at[ _eye, _tgt, _up ]

        # 160 degrees puts Valles Marineris (290E) square in front at
        # t=0; the tilt is about Z, which leaves that facing alone.
        # ux.time counts kiloseconds, so 900 drifts east slowly enough
        # to read the canyon rather than smear past it
        q_spin : quatf [ vec4f [ 0.0, 1.0, 0.0, radians[ spin_d ] ] ]
        q_axis : quatf [ vec4f [ 0.0, 0.0, 1.0, radians[ 25.2 ] ] ]
        mm : mat4f.identity[]
        mm = mm.rotate[ q_axis ]
        mm = mm.rotate[ q_spin ]

        olymp.model = mm
        olymp.view  = _view
        olymp.proj  = _proj
        # must match what mars_bake packed, or the terrain reads at the
        # wrong height and the shading disagrees with the silhouette
        olymp.hmax     = mars_hmax[] * mars_relief[]
        olymp.smax     = mars_smax[] * mars_relief[]
        olymp.haze     = mars_haze[]
        olymp.dtile    = mars_dtile[]
        olymp.damp     = mars_damp[]
        olymp.dh       = mars_dh[]
        olymp.sea_l0   = mars_sea_l0[]
        olymp.sea_bias = mars_sea_bias[]
        # the carpet is laid out around the craft, so the shader needs
        # the eye in MODEL space -- the planet turns, the craft does not
        mi : mat4f [ mm.inverse[] ]
        # by hand, NOT mi.mul_v4: a C function returning a 16-byte
        # all-float struct comes back in two registers, and the call
        # reads one float from each -- x and z arrive, y and w never
        # get written. see the note in orbit's header
        emx : f32 [ mi.m[0] * _eye.x + mi.m[4] * _eye.y + mi.m[8]  * _eye.z + mi.m[12] ]
        emy : f32 [ mi.m[1] * _eye.x + mi.m[5] * _eye.y + mi.m[9]  * _eye.z + mi.m[13] ]
        emz : f32 [ mi.m[2] * _eye.x + mi.m[6] * _eye.y + mi.m[10] * _eye.z + mi.m[14] ]
        em : vec4f [ emx, emy, emz, 1.0 ]
        olymp.eye_m = em
        # the arc from under the craft to the horizon: everything
        # visible lies inside it, which is why the cap is enough
        olymp.hdist = acos[ 1.0 / e_r ]
        olymp.cam_pos  = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        # the sun sits low, dead ahead, and stays there as the craft
        # flies: that is what backlights the dust and rakes every wall
        # 4 degrees put almost every facet in its own shadow -- the
        # relief was there and unreadable. 15 still rakes hard enough
        # to throw the canyon walls but actually lights the ground
        sel : f32 [ radians[ 15.0 ] ]
        sc : f32 [ cos[ sel ] ]
        ss : f32 [ sin[ sel ] ]
        olymp.sun_dir = vec4f [ gx * sc + cx * ss, gy * sc + cy * ss, gz * sc + cz * ss, 0.0 ]

        # the sea shell shares the craft frame exactly, or its waterline
        # would sit on different ground than the terrain it cuts. set
        # LAST: it copies eye_m, hdist and sun_dir, all worked out above
        owater.model    = mm
        owater.view     = _view
        owater.proj     = _proj
        owater.hmax     = olymp.hmax
        owater.haze     = olymp.haze
        owater.cam_pos  = olymp.cam_pos
        owater.sun_dir  = olymp.sun_dir
        owater.eye_m    = olymp.eye_m
        owater.hdist    = olymp.hdist
        owater.sea_l0   = mars_sea_l0[]
        owater.sea_bias = mars_sea_bias[]

        osky.model    = mm
        osky.view     = _view
        osky.proj     = _proj
        osky.cam_pos  = olymp.cam_pos
        osky.sun_dir  = olymp.sun_dir
        osky.eye_m    = olymp.eye_m
        osky.hdist    = olymp.hdist
        osky.atm_h    = mars_atm_h[]
        osky.atm_fall = mars_atm_fall[]
        osky.atm_gain = mars_atm_gain[]
        osky.cld_lo   = mars_cld_lo[]
        osky.cld_hi   = mars_cld_hi[]
        osky.cld_cov  = mars_cld_cov[]
        osky.cld_wind = mars_cld_wind[]
        # ux.time counts kiloseconds, so this drifts the deck slowly
        osky.cld_time = ux.time * 3.0

        # the galaxy wraps the scene from a big inner sphere, tilted so
        # the band cuts the sky diagonally. scale 12, NOT the 30 the
        # saturn scenes use: this camera's far plane is 24, and a shell
        # past it is clipped away entirely
        gskq : quatf [ vec4f [ 1.0, 0.0, 0.0, radians[ 45.0 ] ] ]
        gskm : mat4f.identity[]
        gskm = gskm.rotate[ gskq ]
        gskm = gskm.scale[ vec3f [ 12.0, 12.0, 12.0 ] ]
        gsky.model = gskm
        gsky.view  = _view
        gsky.proj  = _proj
        gsky.gain  = 0.45
        gsky.time  = ux.time * 60000.0
        dbg_n += 1
        if [ dbg_n < 3 ]
            puts 'TERRA mode={i32[ ux.orbit_mode ]} e_cur={e_cur} hmax={olymp.hmax} smax={olymp.smax}'
            puts 'TERRA eye={_eye.x},{_eye.y},{_eye.z} eye_m={em.x},{em.y},{em.z},{em.w} hdist={olymp.hdist} e_r={e_r}'
# MARS, THE PLANET AS IT IS. same carpet mesh and same MOLA maps as
# Terra, but nothing is terraformed: no sea, no planting, no rivers,
# no snow and no cloud deck. only the map's own iron colour, the rock
# material over it, and the dust atmosphere above
enum MarsSurface
    height  : 0
    nrm     : 1
    detail  : 2
    edge    : 3
    color   : 4

ModelViewProject MarsShader
    # unpack scale for the baked height, and the slope range the baked
    # normal encodes. both must match what mars_bake wrote
    mutable hmax     : f32
    mutable smax     : f32
    mutable sun_dir  : vec4f
    mutable cam_pos  : vec4f
    mutable haze     : f32
    # how many times the rock material repeats across the equator, and
    # how far it tilts the normal
    mutable dtile    : f32
    mutable damp     : f32
    # the craft in MODEL space, and the horizon arc in radians: the
    # carpet mesh is laid out relative to both
    mutable eye_m    : vec4f
    mutable hdist    : f32
    # how far the rock material displaces the mesh, in sphere radii
    mutable dh       : f32

    attrib height  : LayoutBinding [ type:typeid[ MarsSurface ], id:MarsSurface.height, count:1, format: typeid[ rgba8 ] ]
    attrib nrm     : LayoutBinding [ type:typeid[ MarsSurface ], id:MarsSurface.nrm,    count:1, format: typeid[ rgba8 ] ]
    attrib detail  : LayoutBinding [ type:typeid[ MarsSurface ], id:MarsSurface.detail, count:1, format: typeid[ rgba8 ] ]
    attrib edge    : LayoutBinding [ type:typeid[ MarsSurface ], id:MarsSurface.edge,   count:1, format: typeid[ rgba8 ] ]
    attrib color   : LayoutBinding [ type:typeid[ MarsSurface ], id:MarsSurface.color,  count:1, format: typeid[ rgba8 ] ]

    attrib a_pos        : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal     : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv         : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_normal     : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_uv         : VertexOutput  [ type:typeid[ vec2f ] ]
    attrib v_sp         : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_world_pos  : VertexOutput  [ type:typeid[ vec4f ] ]
    attrib v_h          : VertexOutput  [ type:typeid[ f32   ] ]

    attrib fragColor    : FragmentOutput[ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    # the bake, unpacked. 16 bits across R and A, scaled by hmax.
    # the hardware interpolates those two bytes INDEPENDENTLY, so
    # everywhere the low byte wraps 255->0 it ramps backwards across a
    # whole texel and the ground ripples like water. decode four
    # texels FIRST, then interpolate
    func m_ground [ uv: vec2f ] -> GLSL float {
        vec2  ts = vec2(8192.0, 4096.0);
        vec2  pp = uv * ts - 0.5;
        vec2  fr = fract(pp);
        vec2  b0 = (floor(pp) + 0.5) / ts;
        vec2  e1 = 1.0 / ts;
        vec4  q00 = textureLod(height, b0, 0.0);
        vec4  q10 = textureLod(height, b0 + vec2(e1.x, 0.0), 0.0);
        vec4  q01 = textureLod(height, b0 + vec2(0.0, e1.y), 0.0);
        vec4  q11 = textureLod(height, b0 + e1, 0.0);
        float h00 = q00.r * 65280.0 + q00.a * 255.0;
        float h10 = q10.r * 65280.0 + q10.a * 255.0;
        float h01 = q01.r * 65280.0 + q01.a * 255.0;
        float h11 = q11.r * 65280.0 + q11.a * 255.0;
        float hh  = mix(mix(h00, h10, fr.x), mix(h01, h11, fr.x), fr.y);
        return hh / 65535.0 * ubo.hmax;
    }

    func vertex [] -> GLSL none {
        // the mesh arrives as a FLAT polar grid centred on the craft,
        // its radius a fraction of the horizon arc. wrap it onto the
        // sphere here, so altitude rescales it and nothing rebuilds
        float rn = length(a_pos.xz);
        vec2  pd = rn > 0.0 ? a_pos.xz / rn : vec2(1.0, 0.0);
        vec3  up_m = normalize(ubo.eye_m.xyz);
        vec3  ax9  = abs(up_m.y) > 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3  t_e  = normalize(cross(ax9, up_m));
        vec3  t_n  = cross(up_m, t_e);
        float s9   = rn * ubo.hdist;
        vec3  dir  = normalize(up_m * cos(s9) + (t_e * pd.x + t_n * pd.y) * sin(s9));

        // longitude measured FROM the craft, never absolute: that is
        // what keeps the +/-pi meridian from splitting a triangle
        float lon0 = atan(ubo.eye_m.z, ubo.eye_m.x);
        float dl   = atan(dir.z, dir.x) - lon0;
        if (dl >  3.14159265) dl -= 6.28318531;
        if (dl < -3.14159265) dl += 6.28318531;
        vec2 uv = vec2(0.5 + (lon0 + dl) / 6.28318531,
                       0.5 - asin(clamp(dir.y, -1.0, 1.0)) / 3.14159265);

        v_uv     = uv;
        v_sp     = dir;
        mat3 nm  = transpose(inverse(mat3(ubo.model)));
        v_normal = normalize(nm * dir);
        float g  = m_ground(uv);
        v_h      = g;

        // patch geometry WHERE THE EDGES ARE. the integral image says
        // how much structure the colour map holds around this point;
        // busy ground earns high frequency, dead flat plains stay flat
        vec4  ee = textureLod(edge, uv, 0.0);
        float aug = clamp(ee.r * 0.55 + ee.g * 0.30 + ee.b * 0.15, 0.0, 1.0);
        vec2  vsl  = (textureLod(nrm, uv, 0.0).rg * 2.0 - 1.0) * ubo.smax;
        float vrug = clamp(length(vsl) / 0.12, 0.0, 1.0);
        float vclat = sqrt(max(1.0 - dir.y * dir.y, 0.0025));
        vec2  duv   = vec2(uv.x * vclat * 2.0, uv.y);
        float dsum = 0.0;
        float dw   = 0.0;
        float dfq  = ubo.dtile / 256.0;
        float dwt  = 1.0;
        for (int i = 0; i < 3; i++) {{
            float an = 0.61 * float(i);
            float ca = cos(an);
            float sa = sin(an);
            vec2  ru = mat2(ca, sa, -sa, ca) * duv * dfq + vec2(0.37, 0.71) * float(i);
            dsum += (textureLod(detail, ru, 0.0).b * 2.0 - 1.0) * dwt;
            dw   += dwt;
            dfq  *= 3.0;
            dwt  *= 0.78;
        }}
        vec3 disp = dir * (1.0 + g + dsum / dw * ubo.dh
                                   * (0.10 + 1.90 * vrug) * (0.55 + 0.45 * aug));
        vec4 wpos = ubo.model * vec4(disp, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment [] -> GLSL none {
        vec3 sp = normalize(v_sp);
        // the mesh normal is the ball's and would light this flat. the
        // bake carries the real surface slope at 8192 across, far finer
        // than any mesh we can afford to displace
        vec3 ax = abs(sp.y) > 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3 ea = normalize(cross(ax, sp));
        vec3 no = normalize(cross(sp, ea));
        vec2 sl = (texture(nrm, v_uv).rg * 2.0 - 1.0) * ubo.smax;
        vec3 n = normalize(sp - ea * sl.x - no * sl.y);

        // MOLA is 2600m a texel, so from 13km up the ground is pure
        // bilinear mush. the rock material fills the whole span below
        // that -- SIX octaves from 1300m a texel down to 5m.
        // SHADING ONLY: the silhouette stays MOLA's
        float dist = length(v_world_pos.xyz - ubo.cam_pos.xyz);
        float clat = sqrt(max(1.0 - sp.y * sp.y, 0.0025));
        vec2  duv  = vec2(v_uv.x * clat * 2.0, v_uv.y);
        vec2  dxy  = vec2(0.0);
        float cav  = 0.0;
        float rgh  = 0.0;
        float wsum = 0.0;
        float fq = ubo.dtile / 256.0;
        float wt = 1.0;
        for (int i = 0; i < 6; i++) {{
            // each octave on its own angle and origin, or the ladder
            // stacks into one self-similar pattern instead of terrain
            float an = 0.61 * float(i);
            float ca = cos(an);
            float sa = sin(an);
            vec2  ru = mat2(ca, sa, -sa, ca) * duv * fq + vec2(0.37, 0.71) * float(i);
            vec4  dv = texture(detail, ru);
            dxy  += (dv.rg * 2.0 - 1.0) * wt;
            // B is the material's height: below its own mean is a
            // crevice, above it is a crest catching the light
            cav  += (dv.b * 2.0 - 1.0) * wt;
            rgh  += dv.a * wt;
            wsum += wt;
            fq *= 3.0;
            wt *= 0.78;
        }}
        dxy /= wsum;
        cav /= wsum;
        rgh /= wsum;
        vec4  ee9 = texture(edge, v_uv);
        float aug = clamp(ee9.r * 0.55 + ee9.g * 0.30 + ee9.b * 0.15, 0.0, 1.0);
        // NORMALISED slope: sl already carries smax, and smax carries
        // the relief look-control, so divide it back out
        float slope0 = length(sl) / max(ubo.smax, 1e-6);
        float rug = clamp(slope0 / 0.08, 0.0, 1.0);
        n = normalize(n + (ea * dxy.x + no * dxy.y)
                        * ubo.damp * (0.10 + 1.90 * rug)
                        * (0.55 + 0.45 * aug));

        mat3 nmm = transpose(inverse(mat3(ubo.model)));
        vec3 nw = normalize(nmm * n);

        vec3 sun = normalize(ubo.sun_dir.xyz);
        float ndl = max(dot(nw, sun), 0.0);
        // BARE MARS. the colour map is the albedo; the rock material
        // only shades it -- crests catch the light, crevices hold dark.
        // RUST, not soil: 0.64/0.43/0.28 was a tan with as much green
        // in it as an earth desert, and that is what read as brown
        vec3  c_rock = vec3(0.30, 0.13, 0.085);
        vec3  c_dust = vec3(0.74, 0.34, 0.21);
        float crest = clamp(cav * 0.5 + 0.5, 0.0, 1.0);
        float flat9 = 1.0 - clamp(slope0 / 0.20, 0.0, 1.0);
        vec3  marsc = texture(color, v_uv).rgb;
        vec3  base  = marsc;
        base = mix(base, mix(c_rock, c_dust, flat9 * (0.35 + 0.65 * crest)), 0.45);
        base *= 0.78 + 0.44 * crest;
        // the map itself is a brown plate, and it carries over half the
        // result -- so tilt the whole thing to iron rather than leaving
        // the map to drag the new rock colours back toward soil
        base *= vec3(1.10, 0.87, 0.79);
        // and hold the colour: bleeding to grey by roughness was taking
        // the red back out exactly where the material is strongest
        base = mix(base, vec3(dot(base, vec3(0.35, 0.48, 0.17))), rgh * 0.12);

        // a grazing sun throws long shadow: the terminator on a slope is
        // hard, so keep the ambient low or the shadows turn to grey mud
        vec3 lit = base * (0.16 + ndl * 1.25);

        // ATMOSPHERE. mars air is loaded with suspended iron dust and
        // it forward-scatters hard, but it reddens rather than gilds:
        // salmon close in, dusty rose across the middle, and a cooler
        // red at range. one three-stop ramp on distance
        vec3 vd = normalize(v_world_pos.xyz - ubo.cam_pos.xyz);
        float fw = max(dot(vd, sun), 0.0);
        float fs = pow(fw, 6.0);
        float fd = clamp(dist / 0.55, 0.0, 1.0);
        vec3 dust = mix(vec3(1.26, 0.74, 0.60), vec3(1.02, 0.56, 0.48),
                        smoothstep(0.0, 0.40, fd));
        dust = mix(dust, vec3(0.88, 0.58, 0.56), smoothstep(0.35, 1.0, fd));
        dust *= 1.0 + 0.85 * fs;
        // HAZE POOLS IN THE BASINS: the column of air over a canyon
        // floor is far deeper than over a plateau, and dust settles
        // into it. elevation is the datum here, there being no sea
        float tg9  = v_h / max(ubo.hmax, 1e-6);
        float fogl = 1.0 - smoothstep(0.02, 0.40, tg9);
        float hz = 1.0 - exp(-dist * ubo.haze * (1.0 + fs * 4.0)
                                  * (0.55 + 1.60 * fogl));
        vec3 outc = mix(lit, dust, clamp(hz, 0.0, 1.0));

        // THE DUST POOL. suspended dust settles into the deepest ground
        // and sits there, so a canyon floor is full of it whatever the
        // range. the haze above is a DISTANCE term and clears to
        // nothing up close, which left the valley bare from overhead --
        // this is elevation only. the packed height reads 0.154 on the
        // Valles floor against 0.384 on the plateau, so a band of
        // 0.10..0.26 fills the trunk and the northern basins and stops
        // at the rim. same dust colour as the air, because it IS the air
        float pool = 1.0 - smoothstep(0.10, 0.26, tg9);
        outc = mix(outc, dust, pool * (0.30 + 0.45 * fd));

        // LIMB. terrain stays OPAQUE to its edge and simply DARKENS by
        // mu; the sky shell above flares up through the same band, and
        // that crossfade is the softness
        vec3  vdir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        vec3  nsp  = normalize(nmm * sp);
        float mu   = clamp(dot(nsp, vdir), 0.0, 1.0);
        outc *= 0.30 + 0.70 * smoothstep(0.0, 0.12, mu);

        fragColor = vec4(outc, 1.0);
    }


# THE SKY SHELL, dust only. the rim glow on the ground can only light
# fragments that HAVE ground, so it stops dead at the silhouette. this
# is the same carpet mesh a second time, lifted to a shell above the
# surface, so there is geometry ABOVE the limb to carry the fade into
# space. no cloud march here -- mars keeps its air and nothing else
ModelViewProject MarsSkyShader
    mutable sun_dir  : vec4f
    mutable cam_pos  : vec4f
    mutable eye_m    : vec4f
    mutable hdist    : f32
    mutable atm_h    : f32
    mutable atm_fall : f32
    mutable atm_gain : f32

    attrib a_pos        : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal     : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv         : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_normal     : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_uv         : VertexOutput  [ type:typeid[ vec2f ] ]
    attrib v_sp         : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_world_pos  : VertexOutput  [ type:typeid[ vec4f ] ]

    attrib fragColor    : FragmentOutput[ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    func vertex [] -> GLSL none {
        float rn = length(a_pos.xz);
        vec2  pd = rn > 0.0 ? a_pos.xz / rn : vec2(1.0, 0.0);
        vec3  up_m = normalize(ubo.eye_m.xyz);
        vec3  ax9  = abs(up_m.y) > 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3  t_e  = normalize(cross(ax9, up_m));
        vec3  t_n  = cross(up_m, t_e);
        // THE WHOLE SPHERE, not a cap. the carpet is a polar grid, so
        // mapping its radius across a half-turn wraps it into a closed
        // shell with NO mesh boundary anywhere
        float s9   = (rn / 1.35) * 3.14159265;
        vec3  dir  = normalize(up_m * cos(s9) + (t_e * pd.x + t_n * pd.y) * sin(s9));
        v_uv     = a_uv;
        v_sp     = dir;
        v_normal = dir;
        vec4 wpos = ubo.model * vec4(dir * (1.0 + ubo.atm_h), 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment [] -> GLSL none {
        // THE ENCELADUS METHOD. the model transform is a pure rotation,
        // so the planet centre is the world origin and the ray's
        // closest approach is one dot product. everything comes from
        // that radius: a ray grazing the surface crosses the whole dust
        // column, one passing high above barely clips it
        vec3  ro = ubo.cam_pos.xyz;
        vec3  rd = normalize(v_world_pos.xyz - ro);
        float tca = 0.0 - dot(ro, rd);
        float glow = 0.0;
        float hw = 0.0;
        float rch = 0.0;
        vec3  sunw = normalize(ubo.sun_dir.xyz);
        if (tca > 0.0) {{
            vec3  pca = ro + rd * tca;
            float rc  = length(pca);
            // in SCALE HEIGHTS, not a fixed radius: the colour ramp has
            // to travel with the alpha or extending the air just parks
            // a solid purple band out where it used to fade
            rch = clamp((rc - 1.0) / (ubo.atm_fall * 2.13), 0.0, 1.0);
            // outward, a long slow fade into space. the smoothstep is a
            // SMOOTH occlusion ramp -- a binary cut stamps the analytic
            // sphere's silhouette as a hard circle offset from the real
            // displaced terrain edge
            float od = exp(-max(rc - 1.0, 0.0) / ubo.atm_fall)
                     * smoothstep(0.976, 0.997, rc);
            float dip  = clamp((1.0 - rc) / 0.018, 0.0, 1.0);
            float hocc = mix(1.0, 0.35, dip);
            hw = clamp(dot(pca / max(rc, 1e-4), sunw) * 0.5 + 0.5, 0.0, 1.0);
            // the blaze where the graze kisses the surface: this is
            // what DISSOLVES the terrain edge, so no ridge or crater
            // prints its shape through the rim
            float nearg = exp(-(max(rc - 1.0, 0.0) / 0.012
                              + max(1.0 - rc, 0.0) / 0.0035));
            glow = od * hocc * (0.16 + 0.52 * hw) * (1.0 + 5.0 * nearg);
            // THIN THE FLOOR, or the band sits thick on the horizon
            glow *= 0.30 + 0.70 * smoothstep(0.0, 0.34, rch);
        }}
        float fw = max(dot(rd, sunw), 0.0);
        // PINK-RED, not Terra's gold. suspended iron dust reddens the
        // whole column: salmon on the horizon itself, dusty rose above
        // it, and a red-violet as the last of it dies into space
        vec3 col = mix(vec3(1.34, 0.66, 0.52), vec3(1.10, 0.54, 0.50),
                       smoothstep(0.0, 0.40, rch));
        col = mix(col, vec3(0.52, 0.20, 0.34), smoothstep(0.44, 1.0, rch));
        col *= 1.0 + 0.80 * pow(fw, 4.0);
        float atma = clamp(glow * ubo.atm_gain, 0.0, 0.58);
        // PREMULTIPLIED: the model is set straight_alpha:false, so the
        // pipeline blends with SRC=ONE
        fragColor = vec4(col * atma, atma);
    }


element Mars
    frost : true
    frost_sharp : true
    intern surf   : MarsShader
    intern msky   : MarsSkyShader
    intern gsky   : GaiaShader
    intern models : vec Model
    intern target : Render
    intern built  : bool
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    intern e_cur  : f32
    public color  : rgba [ r:0.010, g:0.005, b:0.006, a:1.0 ]

    func build_models[]
        built = true
        o_gltf : build_carpet[]
        o_gltf.hold[]
        o_gltf.compute_worlds[]
        surf = MarsShader [ vk: vk ]
        pkp : path '../scenes/baked/mars-pk.png'
        nkp : path '../scenes/baked/mars-nk.png'
        dnp : path '../scenes/baked/mars-dn.png'
        ekp : path '../scenes/baked/mars-ek.png'
        if [ !pkp.exists[] || !nkp.exists[] ]
            puts 'mars: no baked maps — baking live (SILVER_EXPORT=1 bakes at build)'
            mars_bake_mola[]
        if [ !dnp.exists[] ]
            puts 'mars: no rock detail — baking live'
            mars_bake_detail[]
        if [ !ekp.exists[] ]
            puts 'mars: no edge map — baking live'
            mars_bake_edge[]
        # data maps MUST be linear or the sampler re-linearizes them and
        # the whole surface drops below its real height
        o_samplers : map Image [string] [
            'height': Image [ uri: pkp, surface: MarsSurface.height, linear: true, wrap_u: true ],
            'nrm':    Image [ uri: nkp, surface: MarsSurface.nrm,    linear: true, wrap_u: true ],
            'detail': Image [ uri: dnp, surface: MarsSurface.detail, linear: true, wrap_u: true, wrap_v: true ],
            'edge':   Image [ uri: ekp, surface: MarsSurface.edge,   linear: true, wrap_u: true ],
            'color':  Image [ uri: path '../scenes/textures/mars-color-8192x4096.jpg', surface: MarsSurface.color, linear: true, wrap_u: true ]
        ]
        # the projection y-flip reverses triangle winding, so back-face
        # culling would cull the whole carpet
        o_model : Model [ vk: vk, w: ux, id: o_gltf, s: surf, samplers: o_samplers,
            straight_alpha: true, cull_none: true ]
        # the air shell needs no maps at all -- it works entirely from
        # the ray's geometry. drawn LAST so it lays over the surface
        msky = MarsSkyShader [ vk: vk ]
        s_model : Model [ vk: vk, w: ux, id: o_gltf, s: msky,
            straight_alpha: false, cull_none: true, depth_no_test: true ]
        # the galaxy behind everything, same plate the saturn scenes use
        gsky = GaiaShader [ vk: vk ]
        g_gltf : GltfModel.open[ path '../scenes/models/earth.gltf' ]
        g_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/gaia.png', surface: GaiaSurface.color ]
        ]
        g_model : Model [ vk: vk, w: ux, id: g_gltf, s: gsky, samplers: g_samplers,
            straight_alpha: true, cull_none: true ]
        # backdrop FIRST, then ground, and the air over it
        models  = vec Model [] [ g_model, o_model, s_model ]

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      (ux.frost_eff[] == 2) ? 2.0 : 1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        ux.element_targets[ id ] = target

    # unregister only; we keep our ref so the GPU graph outlives the frame
    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    # iron oxide: the editor's purples go rust under a martian sky
    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#4108',   # editor pane background
            '#140a2a80':  '#429a',   # console pane background
            '#4258':      '#8a5a4a58',   # unused (line_color moved to #44225588)
            '#ff6a2e55':  '#ff8a4a55',   # search highlight fill
            '#220022aa':  '#2a1a16aa',   # run console base fill
            '#614':       '#54281a',     # TButtons / nav rest fill
            '#413':       '#3c1c10',     # TButtons hover fill
            '#826':       '#7c3c22',     # TButtons lit / nav selected
            '#625a':      '#408a',       # bottom status bar fill
            '#8af2':      '#fa62',       # status bar inner glow
            '#425':       '#52281e',     # editor selection color
            '#ede3':      '#fa83',       # editor selection border
            '#44225588':  '#5a3a2e33',   # editor line highlight
            '#ff3a6a22':  '#ff8a4a22',   # commit tab fill
            '#ff3a6a44':  '#ff8a4a44',   # commit tab hover fill
            '#ff5a8a99':  '#e0784299',   # commit tab border
            '#ff7aa4cc':  '#ffa068cc'    # commit tab hover border
        ]

    func load_bg [ arg: object :: t: Mars ]
        t.build_models[]
        t.ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : vec Au []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: lambda load_bg[ a ], work: w9 ]
        if [ !ready ] return
        create_target[]
        orbit[]

    func orbit[]
        aspect : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]
        # ALTITUDE above the datum, not orbit distance: this is a craft
        # over the deck. 0.050 is 170km, 0.130 holds the whole Valles
        # trunk inside the horizon at once
        e_t : f32 [ (ux.orbit_mode == OrbitView.low)  ? 0.050 :
                    (ux.orbit_mode == OrbitView.high) ? 0.130 :
                    (ux.orbit_mode == OrbitView.far)  ? 0.340 : 0.800 ]
        if [ e_cur == 0.0 ] e_cur = e_t
        e_cur = filter_n[ e_cur, e_t, 0.06, ux.frame_factor ]

        # the spin comes FIRST: the craft's latitude is a function of
        # how far along the canyon it has flown
        spin_d : f32 [ 173.0 + ux.time * 900.0 ]

        # the craft rides over Valles Marineris' own latitude while the
        # planet turns under it -- that IS the flight, no path needed.
        # MEASURED off mars-pk: lat = -0.03489 * lon - 12.388, and the
        # 25.2 tilt means model latitude is not world latitude, so the
        # drift is stated in world terms: -0.0387 per degree of spin
        vlat : f32 [ radians[ -10.718 - 0.0387 * (spin_d - 184.39) ] ]
        cx : f32 [ 0.0 ]
        cy : f32 [ sin[ vlat ] ]
        cz : f32 [ cos[ vlat ] ]
        e_r : f32 [ 1.0 + e_cur ]
        _eye : vec3f [ cx * e_r, cy * e_r, cz * e_r ]

        # the planet's spin axis in WORLD space is TILTED: mm applies
        # the 25.2 about Z and then spins about Y, so the axis the
        # ground actually turns on is Rz(25.2) * Y, not Y
        axr : f32 [ radians[ 25.2 ] ]
        wx : f32 [ 0.0 - sin[ axr ] ]
        wy : f32 [ cos[ axr ] ]
        wz : f32 [ 0.0 ]
        # ground flow is w x c; the craft travels the other way
        gx : f32 [ 0.0 - (wy * cz - wz * cy) ]
        gy : f32 [ 0.0 - (wz * cx - wx * cz) ]
        gz : f32 [ 0.0 - (wx * cy - wy * cx) ]
        gl : f32 [ sqrt[ gx * gx + gy * gy + gz * gz ] ]
        if [ gl > 0.0 ]
            gx = gx / gl
            gy = gy / gl
            gz = gz / gl

        # the horizon sits BELOW local horizontal by the dip angle, and
        # from this low that is only a few degrees. six degrees past it
        # drops the limb into the upper third
        dip : f32 [ acos[ 1.0 / e_r ] ]
        pit : f32 [ dip + radians[ 6.0 ] ]
        pc : f32 [ cos[ pit ] ]
        ps : f32 [ sin[ pit ] ]
        dx : f32 [ gx * pc - cx * ps ]
        dy : f32 [ gy * pc - cy * ps ]
        dz : f32 [ gz * pc - cz * ps ]
        _tgt : vec3f [ _eye.x + dx, _eye.y + dy, _eye.z + dz ]
        # THE up, not its negative: negating it mirrors the image
        # horizontally. flip the projection's y instead
        _up : vec3f [ cx, cy, cz ]
        # near must be tight: at 13km altitude a 0.002 near plane clips
        # the ground out from under the craft
        _proj : mat4f.perspective[ radians[ 55.0 ], aspect, 0.00005, 24.0 ]
        _proj.m[5] = 0.0 - _proj.m[5]
        _view : mat4f.look_at[ _eye, _tgt, _up ]

        q_spin : quatf [ vec4f [ 0.0, 1.0, 0.0, radians[ spin_d ] ] ]
        q_axis : quatf [ vec4f [ 0.0, 0.0, 1.0, radians[ 25.2 ] ] ]
        mm : mat4f.identity[]
        mm = mm.rotate[ q_axis ]
        mm = mm.rotate[ q_spin ]

        surf.model = mm
        surf.view  = _view
        surf.proj  = _proj
        # must match what mars_bake packed, or the terrain reads at the
        # wrong height and the shading disagrees with the silhouette
        surf.hmax     = mars_hmax[] * mars_relief[]
        surf.smax     = mars_smax[] * mars_relief[]
        surf.haze     = mars_bare_haze[]
        surf.dtile    = mars_dtile[]
        surf.damp     = mars_damp[]
        surf.dh       = mars_dh[]
        # the carpet is laid out around the craft, so the shader needs
        # the eye in MODEL space -- the planet turns, the craft does not
        mi : mat4f [ mm.inverse[] ]
        # by hand, NOT mi.mul_v4: a C function returning a 16-byte
        # all-float struct comes back in two registers, and the call
        # reads one float from each -- x and z arrive, y and w never
        # get written
        emx : f32 [ mi.m[0] * _eye.x + mi.m[4] * _eye.y + mi.m[8]  * _eye.z + mi.m[12] ]
        emy : f32 [ mi.m[1] * _eye.x + mi.m[5] * _eye.y + mi.m[9]  * _eye.z + mi.m[13] ]
        emz : f32 [ mi.m[2] * _eye.x + mi.m[6] * _eye.y + mi.m[10] * _eye.z + mi.m[14] ]
        em : vec4f [ emx, emy, emz, 1.0 ]
        surf.eye_m = em
        # the arc from under the craft to the horizon: everything
        # visible lies inside it, which is why the cap is enough
        surf.hdist = acos[ 1.0 / e_r ]
        surf.cam_pos  = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        # the sun sits low, dead ahead, and stays there as the craft
        # flies: that is what backlights the dust and rakes every wall
        sel : f32 [ radians[ 15.0 ] ]
        sc : f32 [ cos[ sel ] ]
        ss : f32 [ sin[ sel ] ]
        surf.sun_dir = vec4f [ gx * sc + cx * ss, gy * sc + cy * ss, gz * sc + cz * ss, 0.0 ]

        msky.model    = mm
        msky.view     = _view
        msky.proj     = _proj
        msky.cam_pos  = surf.cam_pos
        msky.sun_dir  = surf.sun_dir
        msky.eye_m    = surf.eye_m
        msky.hdist    = surf.hdist
        msky.atm_h    = mars_atm_h[]
        msky.atm_fall = mars_atm_fall[]
        msky.atm_gain = mars_atm_gain[]

        # the galaxy wraps the scene from a big inner sphere, tilted so
        # the band cuts the sky diagonally. scale 12, NOT the 30 the
        # saturn scenes use: this camera's far plane is 24, and a shell
        # past it is clipped away entirely
        gskq : quatf [ vec4f [ 1.0, 0.0, 0.0, radians[ 45.0 ] ] ]
        gskm : mat4f.identity[]
        gskm = gskm.rotate[ gskq ]
        gskm = gskm.scale[ vec3f [ 12.0, 12.0, 12.0 ] ]
        gsky.model = gskm
        gsky.view  = _view
        gsky.proj  = _proj
        gsky.gain  = 0.45
        gsky.time  = ux.time * 60000.0


# NEPTUNE. the ball is composed, not sourced: saturn's poles, jupiter's
# middle flipped and mirrored with its great spot swirled into another
# shape, driven deep blue. the discharges here are WHITE cloud forming
# along the wind, off an elongated streak basis rather than a sobel
# THE AURORA: enceladus' march, aimed at a magnetic axis instead of a
# vent list. a shell above the cloud top, emitting only in a RING at a
# fixed colatitude -- so it is a glowing edge from the side, and when
# the pole comes round it opens into a circle with a dark centre. the
# inner edge is the whole point; a cap would just be a bright pole
ModelViewProject AuroraShader
    mutable gain    : f32
    mutable cam_pos : vec4f
    # xyz = the magnetic axis in WORLD space, w = the oval's
    # colatitude off that axis, in radians
    mutable maxis   : vec4f
    # x = shell inner radius, y = outer, z = oval half width in
    # radians, w = how hard the curtains bite
    mutable ashell  : vec4f
    # the two ends of the emission: inner edge and outer skirt
    mutable c_in    : vec4f
    mutable c_out   : vec4f

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_mpos      : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]

    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]

    func init[]
        eye2    : vec3f [0.0f, 0.0f, 2.5f]
        target2 : vec3f [0.0f, 0.0f, 0.0f]
        up2     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_mpos      = a_pos;
        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func a_hash31 [ p: vec3f ] -> GLSL float {
        return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);
    }

    func a_vnoise [ p: vec3f ] -> GLSL float {
        vec3 i = floor(p);
        vec3 f = fract(p);
        vec3 u = f * f * (3.0 - 2.0 * f);
        float n000 = a_hash31(i + vec3(0.0, 0.0, 0.0));
        float n100 = a_hash31(i + vec3(1.0, 0.0, 0.0));
        float n010 = a_hash31(i + vec3(0.0, 1.0, 0.0));
        float n110 = a_hash31(i + vec3(1.0, 1.0, 0.0));
        float n001 = a_hash31(i + vec3(0.0, 0.0, 1.0));
        float n101 = a_hash31(i + vec3(1.0, 0.0, 1.0));
        float n011 = a_hash31(i + vec3(0.0, 1.0, 1.0));
        float n111 = a_hash31(i + vec3(1.0, 1.0, 1.0));
        return mix(mix(mix(n000, n100, u.x), mix(n010, n110, u.x), u.y),
                   mix(mix(n001, n101, u.x), mix(n011, n111, u.x), u.y), u.z);
    }

    func fragment[] -> GLSL none {
        vec3  ro = ubo.cam_pos.xyz;
        vec3  rd = normalize(v_world_pos.xyz - ro);
        // one shell layer only: from outside we want the near face,
        // from inside the far one, or every ray counts twice
        if (dot(ro, ro) >= 1.69 && !gl_FrontFacing) { fragColor = vec4(0.0); return; }
        // the ball stops the march at its own surface
        float b     = dot(ro, rd);
        float c     = dot(ro, ro) - 1.0;
        float dsc   = b * b - c;
        float s_hit = (dsc > 0.0) ? (-b - sqrt(dsc)) : 1e9;
        if (s_hit < 0.0) s_hit = 1e9;
        // the segment of the ray inside the shell
        float ri  = ubo.ashell.x;
        float rou = ubo.ashell.y;
        float cc  = dot(ro, ro) - rou * rou;
        float dd  = b * b - cc;
        if (dd <= 0.0) { fragColor = vec4(0.0); return; }
        float sq = sqrt(dd);
        float t0 = max(-b - sq, 0.0);
        float t1 = min(-b + sq, s_hit);
        if (t1 <= t0) { fragColor = vec4(0.0); return; }

        vec3  ax  = normalize(ubo.maxis.xyz);
        float ovc = ubo.maxis.w;
        float ovw = ubo.ashell.z;
        // any two vectors square to the axis, to measure azimuth by
        vec3  up9 = (abs(ax.y) < 0.9) ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        vec3  ex9 = normalize(cross(up9, ax));
        vec3  ey9 = cross(ax, ex9);

        float sin9 = 0.0;
        float sou9 = 0.0;
        float dt   = (t1 - t0) / 32.0;
        for (int i = 0; i < 32; i++) {{
            vec3  p = ro + rd * (t0 + (float(i) + 0.5) * dt);
            float r = length(p);
            // fades in off the cloud top, out at the shell's ceiling
            float sh = smoothstep(ri - 0.015, ri + 0.020, r)
                     * (1.0 - smoothstep(rou - 0.14, rou, r));
            if (sh <= 0.0) continue;
            vec3  pn = p / max(r, 1e-4);
            // BOTH poles: the abs folds the southern oval onto the
            // northern one, and they are symmetric anyway
            float ca  = abs(dot(pn, ax));
            float col = acos(clamp(ca, 0.0, 1.0));
            // the ring. gaussian about a colatitude, so it has an
            // INNER edge as much as an outer -- the pole is dark
            float dv   = (col - ovc) / ovw;
            float ring = exp(-dv * dv);
            // a HINT of purple around the oval, and nowhere else --
            // it is keyed to the same colatitude, so it exists at the
            // poles only. 0.10, not the 0.34 that washed the pole out
            float dh   = (col - ovc) / (ovw * 2.6);
            float halo = exp(-dh * dh) * 0.10;
            if (ring + halo < 0.002) continue;
            // curtains: azimuth about the axis, several rates so the
            // structure never repeats around the oval
            float az = atan(dot(pn, ey9), dot(pn, ex9));
            float cu = 0.55
                     + 0.28 * sin(az *  7.0 + ubo.time * 0.11)
                     + 0.20 * sin(az * 13.0 - ubo.time * 0.17 + 1.7)
                     + 0.14 * sin(az * 23.0 + ubo.time * 0.23 + 4.1);
            cu = clamp(cu, 0.0, 1.6);
            // TEXTURE, not curtains. sampled on a circle in azimuth so
            // it closes, and across colatitude too, so the oval breaks
            // into blobs instead of running as one smooth band. this
            // is what makes it read as an aurora rather than a ring
            vec2  ac9 = vec2(cos(az), sin(az));
            float pt1 = a_vnoise(vec3(ac9 * 3.0,        col * 34.0 + ubo.time * 0.04));
            float pt2 = a_vnoise(vec3(ac9 * 7.5 + 11.0, col * 72.0 + ubo.time * 0.07));
            float tex = smoothstep(0.22, 0.74, 0.62 * pt1 + 0.38 * pt2);
            // fine radial striations across the band. an INTEGER count
            // of cycles, or the seam at +/- pi cuts them
            float str = 0.62 + 0.38 * sin(az * 40.0 + pt1 * 11.0);
            // MIXED with the smooth curtains, not replacing them. all
            // texture and the volume turns to grit; none and it is a
            // featureless band
            cu = cu * mix(1.0, (0.22 + 1.60 * tex) * str, 0.62);
            cu = mix(1.0, cu, ubo.ashell.w);
            // rays stand UP the field line: brighter low, thinning out
            float hh = clamp((r - ri) / max(rou - ri, 1e-4), 0.0, 1.0);
            float ray = exp(-2.1 * hh);
            float w9  = ring * sh * cu * ray * dt;
            // the inner edge burns hardest; the skirt carries outward
            sin9 += w9 * (1.0 - smoothstep(0.0, 1.0, hh));
            sou9 += w9 * smoothstep(0.0, 1.0, hh);
            // the halo is ALL skirt -- it is the purple, and it does
            // not take the curtains or it would just be a wider oval
            sou9 += halo * sh * ray * dt;
        }}
        // the limb itself: a thin glow at the ray's closest approach,
        // so the planet keeps an edge even where no oval is turned
        // toward us. this is the 'glowing edge' the oval sits inside
        float rc  = length(ro - rd * b);
        float lg  = exp(-max(rc - 1.0, 0.0) / 0.030)
                  * smoothstep(0.945, 0.998, rc);

        float tot = sin9 + sou9;
        vec3  col = ubo.c_in.rgb * sin9 + ubo.c_out.rgb * sou9
                  + ubo.c_in.rgb * lg * 0.35;
        float a   = clamp((tot * 2.4 + lg * 0.30) * ubo.gain, 0.0, 1.0);
        if (a <= 0.001) { fragColor = vec4(0.0); return; }
        fragColor = vec4(col * ubo.gain, a);
    }

# URANUS, ON ITS SIDE. 97.77 degrees of axial tilt is the whole
# identity of this planet: the pole faces the sun, and the rings stand
# up as a hoop rather than lying flat across the disk
element Uranus
    frost : true
    frost_sharp : true
    intern e_cur  : f32
    intern p_cur  : f32
    intern p_set  : bool
    intern uran   : JupiterShader
    intern aur    : AuroraShader
    intern rings  : RingShader
    intern sky    : GaiaShader
    intern models : vec Model
    intern target : Render
    intern built  : bool
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    public color  : rgba [ r:0.002, g:0.004, b:0.005, a:1.0 ]

    func build_models[]
        built     = true
        gltf_path : path '../scenes/models/earth.gltf'
        gltf      : GltfModel.open[ gltf_path ]
        cp : path '../scenes/baked/uranus-color.png'
        st : path '../scenes/baked/uranus-storm.png'
        rg : path '../scenes/baked/uranus-ring.png'
        if [ !cp.exists[] || !st.exists[] || !rg.exists[] ]
            puts 'uranus: no baked maps — composing live'
            uranus_bake[]
            uranus_storm[]
            uranus_rings[]
        uran = JupiterShader [ vk: vk ]
        u_samplers : map Image [string] [
            'color':  Image [ uri: cp, surface: TitanSurface.color,  linear: true, wrap_u: true ],
            'height': Image [ uri: st, surface: TitanSurface.height, linear: true, wrap_u: true ]
        ]
        uran_model : Model [ vk: vk, w: ux, id: gltf, s: uran, samplers: u_samplers,
            straight_alpha: true ]
        rings = RingShader [ vk: vk ]
        r_samplers : map Image [string] [
            'color': Image [ uri: rg, surface: TitanSurface.color, linear: true ]
        ]
        ring_model : Model [ vk: vk, w: ux, id: gltf, s: rings, samplers: r_samplers,
            straight_alpha: true ]
        aur = AuroraShader [ vk: vk ]
        # marched shell, so it must not depth-test against the ball it
        # wraps, and both faces are needed
        aur_model : Model [ vk: vk, w: ux, id: gltf, s: aur,
            straight_alpha: true, cull_none: true, depth_no_test: true ]
        sky = GaiaShader [ vk: vk ]
        sky_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/gaia.png', surface: GaiaSurface.color ]
        ]
        sky_model : Model [ vk: vk, w: ux, id: gltf, s: sky, samplers: sky_samplers,
            straight_alpha: true, cull_none: true ]
        models = vec Model [] [sky_model, uran_model, ring_model, aur_model ]

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        ux.element_targets[ id ] = target

    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    func load_bg [ arg: object :: t: Uranus ]
        t.build_models[]
        t.ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : vec Au []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: lambda load_bg[ a ], work: w9 ]
        if [ !ready ] return
        create_target[]
        orbit[]

    func orbit[]
        aspect : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]
        e_t    : f32 [ (ux.orbit_mode == OrbitView.low)  ? 2.20 :
                       (ux.orbit_mode == OrbitView.high) ? 2.90 :
                       (ux.orbit_mode == OrbitView.far)  ? 4.10 : 5.80 ]
        if [ e_cur == 0.0 ] e_cur = e_t
        e_cur = filter_n[ e_cur, e_t, 0.08, ux.frame_factor ]
        p_t    : f32 [ (ux.angle_mode == ViewAngle.flat)   ? 0.0 :
                       (ux.angle_mode == ViewAngle.angled) ? 0.156 : 0.480 ]
        if [ p_cur == 0.0 && p_t != 0.0 && !p_set ] p_cur = p_t
        p_set  = true
        p_cur  = filter_n[ p_cur, p_t, 0.08, ux.frame_factor ]
        ux.orbit_moving = abs[ e_cur - e_t ] > 0.002 || abs[ p_cur - p_t ] > 0.001

        e_d    : f32 [ e_cur ]
        # TOWARD THE SUNLIT POLE. the 97.77 tilt about z carries the
        # spin axis to about (-0.99, -0.14, 0), so the ring plane holds
        # y and z -- a camera at (0, y, z) sits INSIDE that plane and
        # sees the hoop edge-on as a line. 35 degrees off it opens the
        # ellipse to 0.57 of its width.
        # the sign is POSITIVE x: the sun sits at (0.85, -0.10, 0.15),
        # so leaning to -x put the camera over the night pole and the
        # planet came up dark
        pl9    : f32 [ radians[ 35.0 ] ]
        _eye   : vec3f [ e_d * sin[ pl9 ], e_d * p_cur, e_d * cos[ pl9 ] ]
        _tgt   : vec3f [ 0.0,  0.0,  0.0  ]
        _up    : vec3f [ 0.0, -1.0,  0.0  ]
        _proj  : mat4f.perspective[ radians[ 55.0 ], aspect, 0.01, 90.0 ]
        _view  : mat4f.look_at    [ _eye, _tgt, _up ]

        # uranus turns in 17 hours, and RETROGRADE -- negative rate
        spin_d : f32 [ 0.0 - ux.time * 8400.0 ]
        q_spin : quatf [ vec4f [ 0.0, 1.0, 0.0, radians[ spin_d ] ] ]
        # 97.77 DEGREES. this is the planet's whole character: the axis
        # lies in its orbital plane, so it rolls rather than spins
        q_tilt : quatf [ vec4f [ 0.0, 0.0, 1.0, radians[ 97.77 ] ] ]
        mm : mat4f.identity[]
        mm = mm.rotate[ q_tilt ]
        mm = mm.rotate[ q_spin ]
        uran.model   = mm
        uran.view    = _view
        uran.proj    = _proj
        uran.gain    = 1.15
        # w 3.0 lifts the ambient floor from 0.08 to 0.24, so the pole
        # that faces away still carries a quarter of its albedo
        uran.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 3.0 ]
        # white cloud, as neptune. uranus shows even less of it
        # w 0.85 = STANDING. uranus' streaks are a permanent deck that
        # only breathes, not a field of strikes switching on and off
        uran.pc_a = vec4f [ 1.00, 1.00, 1.00, 0.85 ]
        # w 0.0006 is a lap every 7 seconds at ludacrous: the streaks
        # ZOOM around the x axis rather than creeping down the y
        uran.pc_b = vec4f [ 1.00, 1.00, 1.00, 0.0006 ]
        # TWENTY TIMES the streaks. count goes as the square of the
        # scale, so 4.47 each way is 80 cells around against 18 --
        # 6400 of them where there were 324
        uran.pstr = vec4f [ 4.47, 4.47, 0.0, 0.38 ]
        uran.pctl = vec4f [ 0.74, 0.00325, 1.0, 0.0 ]
        # the deck barely moves -- uranus has the least visible weather
        # of the four giants, so the shear is a third of neptune's
        uran.wctl  = vec4f [ 0.12, 0.014, 38.00, 0.30 ]
        uran.wctl2 = vec4f [ 0.42, 1.3, 0.0015625, 14.0 ]
        # a MULTIPLY on the texture colour: red and green cut, blue
        # left alone, so pale cyan goes deep blue by subtraction and
        # never clips. w 0.85 is the ceiling -- the perlin swings it
        # from no colour at all up to this
        uran.tint  = vec4f [ 0.66, 0.84, 1.00, 0.85 ]
        # SODIUM GOLD burnt into the plate at the poles. this is the
        # source the blue-violet shell above it is powered by, so it
        # sits at the same 17 degrees off the pole the oval does
        # DEEP fiery orange, and a warm pale to run against it. the
        # old 0.62 green was closer to gold than fire; 0.42 is the
        # orange itself. w 0.72 burns it harder
        uran.pfire  = vec4f [ 1.00, 0.42, 0.07, 0.72 ]
        uran.pfire2 = vec4f [ 1.00, 0.88, 0.66, 1.0 ]
        uran.time  = ux.time * 60000.0

        # THE AURORA. the shell is a plain sphere at the world origin
        # like the ball, so the march needs no inverse -- the magnetic
        # axis is handed in as a world vector instead.
        # rotating y by the 97.77 tilt about z lands the pole here.
        # uranus' real magnetic axis is a further 59 degrees off its
        # rotation axis and offset a third of a radius from centre, so
        # its true aurorae are lopsided patches; this is the tidy
        # version, on the rotational pole
        ta9 : f32 [ radians[ 97.77 ] ]
        am : mat4f.identity[]
        am = am.scale[ vec3f [ 1.34, 1.34, 1.34 ] ]
        aur.model   = am
        aur.view    = _view
        aur.proj    = _proj
        aur.gain    = 1.0
        aur.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        # w is the oval's colatitude: 17 degrees off the pole, so the
        # centre stays dark and the ring reads as a ring
        aur.maxis   = vec4f [ 0.0 - sin[ ta9 ], cos[ ta9 ], 0.0, radians[ 17.0 ] ]
        # shell from just above the cloud top to 1.34; the oval is 5.5
        # degrees wide; curtains at 0.85 of full bite
        aur.ashell  = vec4f [ 1.005, 1.34, radians[ 5.5 ], 0.85 ]
        # hydrogen, not oxygen: uranus glows blue-violet, never green.
        # the inner edge is back to blue; only the outer skirt and the
        # halo carry purple, so the colour shows at the poles alone
        aur.c_in    = vec4f [ 0.42, 0.86, 1.00, 1.0 ]
        aur.c_out   = vec4f [ 0.62, 0.30, 1.00, 1.0 ]
        aur.time    = ux.time * 60000.0

        # the rings take the tilt and NOT the spin, so they stand as a
        # hoop. outer 53000 km over uranus' 25559 is 2.074 ball radii,
        # drawn a little tighter as neptune's are
        r_sc : vec3f [ 1.92, 0.002, 1.92 ]
        rm : mat4f.identity[]
        rm = rm.rotate[ q_tilt ]
        rm = rm.scale [ r_sc ]
        rings.model   = rm
        rings.view    = _view
        rings.proj    = _proj
        rings.gain    = 0.70
        rings.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        # inner 37000 over outer 53000, and the ball over the drawn outer
        rings.rgeo    = vec4f [ 0.6981, 0.5208, 0.0, 0.0 ]

        # THE GALAXY, aimed into frame. the band lies on the sphere's
        # equator, so what matters is where its plane normal points
        # against the view. at 45 about x that normal is (0, .71, .71)
        # and this camera looks along about (-.57, 0, -.82) -- 35
        # degrees apart, outside a 55 degree lens, so the band sat off
        # screen entirely. 20 about x then 15 about z brings the
        # normal to about (-.24, .91, .34), which is 8 degrees off
        # centre: the band crosses the shot, diagonally, behind uranus
        skq : quatf [ vec4f [ 1.0, 0.0, 0.0, radians[ 20.0 ] ] ]
        skr : quatf [ vec4f [ 0.0, 0.0, 1.0, radians[ 15.0 ] ] ]
        skm : mat4f.identity[]
        skm = skm.rotate[ skq ]
        skm = skm.rotate[ skr ]
        skm = skm.scale [ vec3f [ 30.0, 30.0, 30.0 ] ]
        sky.model = skm
        sky.view  = _view
        sky.proj  = _proj
        sky.gain  = 0.45
        sky.time  = ux.time * 60000.0

    # pale cyan light: the editor's purples go to methane blue-green
    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#08161acc',   # editor pane background
            '#140a2a80':  '#0a1a1e88',   # console pane background
            '#ff6a2e55':  '#7fd6cc55',   # search highlight fill
            '#220022aa':  '#0a1a1caa',   # run console base fill
            '#614':       '#2a4a4a',     # TButtons / nav rest fill
            '#413':       '#22403f',     # TButtons hover fill
            '#826':       '#3f6f6a',     # TButtons lit / nav selected
            '#625a':      '#28484a',     # bottom status bar fill
            '#8af2':      '#8ad0d2',     # status bar inner glow
            '#425':       '#5c7250',     # editor selection color
            '#ede3':      '#000f',       # editor selection border
            '#44225588':  '#8ad0cc11',   # editor line highlight
            '#ff3a6a22':  '#7fd6cc22',   # commit tab fill
            '#ff3a6a44':  '#7fd6cc44',   # commit tab hover fill
            '#ff5a8a99':  '#7fd6cc99',   # commit tab border
            '#ff7aa4cc':  '#a8ece4cc'    # commit tab hover border
        ]

element Neptune
    frost : true
    frost_sharp : true
    intern e_cur  : f32
    intern p_cur  : f32
    intern p_set  : bool
    intern nept   : JupiterShader
    intern rings  : RingShader
    intern sky    : GaiaShader
    intern models : vec Model
    intern target : Render
    intern built  : bool
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    public color  : rgba [ r:0.001, g:0.002, b:0.006, a:1.0 ]

    func build_models[]
        built     = true
        gltf_path : path '../scenes/models/earth.gltf'
        gltf      : GltfModel.open[ gltf_path ]
        cp : path '../scenes/baked/neptune-color.png'
        st : path '../scenes/baked/neptune-storm.png'
        rg : path '../scenes/baked/neptune-ring.png'
        if [ !cp.exists[] || !st.exists[] || !rg.exists[] ]
            puts 'neptune: no baked maps — composing live'
            neptune_bake[]
            neptune_storm[]
            neptune_rings[]
        nept = JupiterShader [ vk: vk ]
        n_samplers : map Image [string] [
            'color':  Image [ uri: cp, surface: TitanSurface.color,  linear: true, wrap_u: true ],
            'height': Image [ uri: st, surface: TitanSurface.height, linear: true, wrap_u: true ]
        ]
        nept_model : Model [ vk: vk, w: ux, id: gltf, s: nept, samplers: n_samplers,
            straight_alpha: true ]
        rings = RingShader [ vk: vk ]
        r_samplers : map Image [string] [
            'color': Image [ uri: rg, surface: TitanSurface.color, linear: true ]
        ]
        ring_model : Model [ vk: vk, w: ux, id: gltf, s: rings, samplers: r_samplers,
            straight_alpha: true ]
        sky = GaiaShader [ vk: vk ]
        sky_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/gaia.png', surface: GaiaSurface.color ]
        ]
        sky_model : Model [ vk: vk, w: ux, id: gltf, s: sky, samplers: sky_samplers,
            straight_alpha: true, cull_none: true ]
        models = vec Model [] [sky_model, nept_model, ring_model ]

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        ux.element_targets[ id ] = target

    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    func load_bg [ arg: object :: t: Neptune ]
        t.build_models[]
        t.ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : vec Au []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: lambda load_bg[ a ], work: w9 ]
        if [ !ready ] return
        create_target[]
        orbit[]

    func orbit[]
        aspect : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]
        e_t    : f32 [ (ux.orbit_mode == OrbitView.low)  ? 1.95 :
                       (ux.orbit_mode == OrbitView.high) ? 2.55 :
                       (ux.orbit_mode == OrbitView.far)  ? 3.60 : 5.20 ]
        if [ e_cur == 0.0 ] e_cur = e_t
        e_cur = filter_n[ e_cur, e_t, 0.08, ux.frame_factor ]
        p_t    : f32 [ (ux.angle_mode == ViewAngle.flat)   ? 0.0 :
                       (ux.angle_mode == ViewAngle.angled) ? 0.156 : 0.480 ]
        if [ p_cur == 0.0 && p_t != 0.0 && !p_set ] p_cur = p_t
        p_set  = true
        p_cur  = filter_n[ p_cur, p_t, 0.08, ux.frame_factor ]
        ux.orbit_moving = abs[ e_cur - e_t ] > 0.002 || abs[ p_cur - p_t ] > 0.001

        e_d    : f32 [ e_cur ]
        _eye   : vec3f [ 0.0,  e_d * p_cur, e_d ]
        _tgt   : vec3f [ 0.0,  0.0,  0.0  ]
        _up    : vec3f [ 0.0, -1.0,  0.0  ]
        _proj  : mat4f.perspective[ radians[ 55.0 ], aspect, 0.01, 90.0 ]
        _view  : mat4f.look_at    [ _eye, _tgt, _up ]

        # neptune turns in 16 hours: the fastest deck in the system
        # SATURN'S rate exactly
        spin_d : f32 [ ux.time * 9000.0 ]
        q_spin : quatf [ vec4f [ 0.0, 1.0, 0.0, radians[ spin_d ] ] ]
        # a heavy tilt runs the bands diagonally across the disk, and
        # counter-moving bands are only readable when they lie flat
        q_tilt : quatf [ vec4f [ 0.0, 0.0, 1.0, radians[ 8.0 ] ] ]
        mm : mat4f.identity[]
        mm = mm.rotate[ q_tilt ]
        mm = mm.rotate[ q_spin ]
        nept.model   = mm
        nept.view    = _view
        nept.proj    = _proj
        nept.gain    = 1.05
        nept.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        # JUPITER'S EFFECT, only white. the mix-to-white path ignores
        # these two entirely, so they are here to say what colour it is
        # w 0.0 keeps neptune exactly as it was -- events, not standing
        nept.pc_a = vec4f [ 1.00, 1.00, 1.00, 0.0 ]
        # w 0.00015, the same gentle carry jupiter gets
        nept.pc_b = vec4f [ 1.00, 1.00, 1.00, 0.00015 ]
        # UNSTRETCHED, jupiter's own 1.0/1.0. the 0.35/1.40 bias drew
        # every perlin cell into an 8:1 smear, which is what read as
        # fake -- shape has to come off the sobel, not the noise.
        # z 0 adds no colour; w 0.50 lifts the blue halfway to white
        nept.pstr = vec4f [ 1.0, 1.0, 0.0, 0.50 ]
        # jupiter's threshold, rate and duty verbatim. w 0.0 lights the
        # whole disk instead of only the dark side
        # y is the pulse rate. nept.time advances 240 a second at
        # ludacrous, so the old 0.9 ran the fade at 34 HERTZ -- a
        # strobe above the frame rate, aliasing rather than fading.
        # 0.0065 is a four second cycle. z 1.0 leaves pow[] a plain
        # sine, the gentlest ramp there is in and out
        nept.pctl = vec4f [ 0.69, 0.00325, 1.0, 0.0 ]
        # SATURN'S WIND, verbatim. these are the exact constants out of
        # SaturnShader: 0.60 jet at 0.012 width, 0.22 lobes at 43.98
        # with a 1.8 decay, 0.16 shear, and its 0.05 ping-pong rate
        # saturn's profile, with the lobes carrying further out and
        # the shear doubled -- saturn reads its counter-motion against
        # a ring plane and a hard band structure; neptune's deck is
        # smooth, so the same numbers show nothing at all on it
        # z 0.0125 is jupiter's ping-pong rate, not saturn's 0.05 --
        # 0.05 shears the deck back and forth three times a SECOND,
        # which is jitter rather than wind. w 18.0 keeps the pulse
        # broader than the 25 cells now down the latitude; any finer
        # than the cell and it prints the cell as stripes
        nept.wctl  = vec4f [ 0.34, 0.012, 43.98, 0.46 ]
        nept.wctl2 = vec4f [ 0.60, 1.1, 0.0125, 18.0 ]
        # w 0.0: neptune is already blue; nothing to push it toward
        nept.tint  = vec4f [ 1.0, 1.0, 1.0, 0.0 ]
        nept.pfire = vec4f [ 1.0, 0.6, 0.2, 0.0 ]
        nept.pfire2 = vec4f [ 1.0, 0.9, 0.7, 0.0 ]
        # WITHOUT THIS the shader sees time 0 -- no wind shift, no spin,
        # no noise evolution. the pattern freezes onto the surface and
        # simply rotates with the ball, which is exactly what it did
        nept.time = ux.time * 60000.0

        # the rings share the ball's tilt but NOT its spin -- a ring
        # system does not turn with the planet under it. true scale is
        # 64500 km over neptune's 24764, or 2.604 ball radii; drawn a
        # bit closer in than that so they sit against the disk
        r_sc : vec3f [ 2.25, 0.002, 2.25 ]
        rm : mat4f.identity[]
        rm = rm.rotate[ q_tilt ]
        rm = rm.scale [ r_sc ]
        rings.model   = rm
        rings.view    = _view
        rings.proj    = _proj
        # faint. voyager needed long exposures to see these at all
        rings.gain    = 0.75
        rings.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        # x is inner 40900 over outer 64500, unchanged by the scale.
        # y is the ball over the ring outer, which the pull-in DID
        # change: 1.0 / 2.25, not 1.0 / 2.604
        rings.rgeo    = vec4f [ 0.6341, 0.4444, 0.0, 0.0 ]

        skq : quatf [ vec4f [ 1.0, 0.0, 0.0, radians[ 45.0 ] ] ]
        skm : mat4f.identity[]
        skm = skm.rotate[ skq ]
        skm = skm.scale [ vec3f [ 30.0, 30.0, 30.0 ] ]
        sky.model = skm
        sky.view  = _view
        sky.proj  = _proj
        sky.gain  = 0.45
        sky.time  = ux.time * 60000.0


# THE LIVING EARTH. the planet is one perlin field: continents rise
# out of it, elevation picks the vegetation, worley lobes shrink-wrap
# the canopy over the ground, and a volume march filters sunlight
# down through the tree layers. a real aerial rainforest plate feeds
# the spatial reflectance, so the organic detail is actual forest
enum JungleSurface
    forest : 0

ModelViewProject JungleShader
    mutable sun_dir : vec4f
    mutable cam_pos : vec4f

    attrib forest : LayoutBinding [ type:typeid[ JungleSurface ], id:JungleSurface.forest, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_world_pos : VertexOutput  [ type:typeid[ vec4f ] ]
    attrib fragColor   : FragmentOutput[ type:typeid[ vec4f ] ]

    func init []
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    # the shell rides far outside with the camera always INSIDE it,
    # so no mesh silhouette can ever cross the view and clip
    func vertex [] -> GLSL none {
        vec4 wpos = ubo.model * vec4(a_pos * 4.0, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func j_shash [ p: @vec3f ] -> GLSL float {
        return fract(sin(dot(p, vec3(12.9898, 78.233, 37.719))) * 43758.5453);
    }

    func j_perm [ x: @vec4f ] -> GLSL vec4f {
        return mod((x * 34.0 + 1.0) * x, vec4(289.0));
    }

    func j_tinv [ r: @vec4f ] -> GLSL vec4f {
        return 1.79284291400159 - 0.85373472095314 * r;
    }

    func j_fade [ t: @vec3f ] -> GLSL vec3f {
        return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
    }

    # textbook 3D perlin, the same construction EarthShader has run
    # for years: permutation-polynomial gradients, quintic fade
    func j_perlin [ P: @vec3f ] -> GLSL float {
        vec3 Pi0 = mod(floor(P), vec3(289.0));
        vec3 Pi1 = mod(Pi0 + vec3(1.0), vec3(289.0));
        vec3 Pf0 = fract(P);
        vec3 Pf1 = Pf0 - vec3(1.0);

        vec4 ix = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
        vec4 iy = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
        vec4 iz0 = vec4(Pi0.z);
        vec4 iz1 = vec4(Pi1.z);

        vec4 ixy = j_perm(j_perm(ix) + iy);
        vec4 ixy0 = j_perm(ixy + iz0);
        vec4 ixy1 = j_perm(ixy + iz1);

        vec4 gx0 = fract(ixy0 / 7.0) * 2.0 - 1.0;
        vec4 gy0 = fract(floor(ixy0 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz0 = 1.0 - abs(gx0) - abs(gy0);

        vec4 gx1 = fract(ixy1 / 7.0) * 2.0 - 1.0;
        vec4 gy1 = fract(floor(ixy1 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz1 = 1.0 - abs(gx1) - abs(gy1);

        vec4 sz0 = step(gz0, vec4(0.0));
        gx0 -= sz0 * (step(0.0, gx0) - 0.5);
        gy0 -= sz0 * (step(0.0, gy0) - 0.5);

        vec4 sz1 = step(gz1, vec4(0.0));
        gx1 -= sz1 * (step(0.0, gx1) - 0.5);
        gy1 -= sz1 * (step(0.0, gy1) - 0.5);

        vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
        vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
        vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
        vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
        vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
        vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
        vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
        vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);

        vec4 norm0 = j_tinv(vec4(dot(g000, g000), dot(g010, g010), dot(g100, g100), dot(g110, g110)));
        g000 *= norm0.x;
        g010 *= norm0.y;
        g100 *= norm0.z;
        g110 *= norm0.w;
        vec4 norm1 = j_tinv(vec4(dot(g001, g001), dot(g011, g011), dot(g101, g101), dot(g111, g111)));
        g001 *= norm1.x;
        g011 *= norm1.y;
        g101 *= norm1.z;
        g111 *= norm1.w;

        float n000 = dot(g000, Pf0);
        float n100 = dot(g100, vec3(Pf1.x, Pf0.y, Pf0.z));
        float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
        float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
        float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
        float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
        float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
        float n111 = dot(g111, Pf1);

        vec3 fade_xyz = j_fade(Pf0);
        vec4 n_z = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fade_xyz.z);
        vec2 n_yz = mix(n_z.xy, n_z.zw, fade_xyz.y);
        float n_xyz = mix(n_yz.x, n_yz.y, fade_xyz.x);

        return n_xyz * 0.5 + 0.5;
    }

    func j_fbm [ p: @vec3f, oct: @i32 ] -> GLSL float {
        float v = 0.0;
        float a = 0.5;
        vec3 q = p;
        for (int i = 0; i < oct; ++i) {
            v += a * j_perlin(q);
            q = q * 2.17 + vec3(13.7, 7.3, 5.1);
            a *= 0.5;
        }
        return v;
    }

    # ONE simple perlin fbm makes the whole landscape: above sea is
    # land lift, below is ocean depth. nothing else shapes the coast
    func j_elev [ d: @vec3f ] -> GLSL float {
        return (j_fbm(d * 2.6, 5) - 0.50) * 2.2;
    }

    # elevation picks the vegetation: tall jungle on the lowlands,
    # thinning as the ground climbs, bare on the peaks
    func j_veg [ d: @vec3f, e: @f32 ] -> GLSL float {
        if (e <= 0.001) return 0.0;
        float moist = j_fbm(d * 11.0 + vec3(3.0, 29.0, 13.0), 2);
        float band = 1.0 - smoothstep(0.30, 0.75, e);
        // vegetation WALKS in from the beach, patchy with moisture,
        // so the greenline wanders -- nothing is immediate
        float shore = smoothstep(0.002, 0.055, e * (0.6 + 0.8 * moist));
        return clamp(band * shore * (0.30 + 0.85 * moist), 0.0, 1.0);
    }

    # 3D worley: distance to the nearest hashed feature point.
    # INVERTED, every cell is one round lobe -- and a field of round
    # lobes IS cauliflower. perlin cannot make this shape; this is
    # the same trick the mars cloud bake stands on
    func j_worley [ p: @vec3f ] -> GLSL float {
        vec3 ip = floor(p);
        vec3 fp = fract(p);
        float best = 9.0;
        for (int z = -1; z <= 1; ++z) {
            for (int y = -1; y <= 1; ++y) {
                for (int x = -1; x <= 1; ++x) {
                    vec3 c = vec3(float(x), float(y), float(z));
                    vec3 q = c - fp
                           + vec3(j_shash(ip + c),
                                  j_shash(ip + c + vec3(7.7, 3.3, 1.1)),
                                  j_shash(ip + c + vec3(2.2, 9.9, 5.5)));
                    best = min(best, dot(q, q));
                }
            }
        }
        return 1.0 - min(sqrt(best), 1.0);
    }

    # the cauliflower lift: worley lobes at three scales -- broad
    # masses, crowns, fine lumps -- summed into one bumpy skin
    func j_lobes [ d: @vec3f ] -> GLSL float {
        float w1 = j_worley(d * 28.0);
        float w2 = j_worley(d * 88.0 + vec3(31.0, 17.0, 7.0));
        float w3 = j_worley(d * 260.0 + vec3(5.0, 47.0, 23.0));
        return w1 * 0.50 + w2 * 0.35 + w3 * 0.15;
    }

    # the forest inside the forest: two higher worley octaves whose
    # frequencies land on single-tree crowns
    func j_detail [ d: @vec3f ] -> GLSL float {
        float w4 = j_worley(d * 760.0 + vec3(3.0, 13.0, 37.0));
        float w5 = j_worley(d * 2100.0 + vec3(41.0, 7.0, 19.0));
        return w4 * 0.65 + w5 * 0.35;
    }


    func fragment [] -> GLSL none {
        // MODEL space: the field is painted on the planet, so the ray
        // must fly through the planet's frame, not the camera's
        mat3 wm = transpose(mat3(ubo.model));
        vec3 ro = wm * ubo.cam_pos.xyz;
        vec3 rd = normalize(wm * (v_world_pos.xyz - ubo.cam_pos.xyz));
        vec3 sun = normalize(wm * ubo.sun_dir.xyz);

        // THE UNIT: one offset above the height map. the volume is
        // exactly this thick over every point of the landscape, and
        // the march steps through it uniformly, everywhere
        float VOFF = 0.011;
        float VSTEP = VOFF / 10.0;
        float RTOP = 1.0 + 0.012 + VOFF;
        float bq = dot(ro, rd);
        float dc = bq * bq - dot(ro, ro) + RTOP * RTOP;

        float Trv = 1.0;
        vec3  acc = vec3(0.0);
        float hit = 0.0;
        vec3  hp  = vec3(0.0);
        float e_h = 0.0;
        if (dc > 0.0) {
            float t = max(-bq - sqrt(dc), 0.0);
            t += j_shash(vec3(gl_FragCoord.xy, 3.7)) * VSTEP;
            float tp = t;
            for (int i = 0; i < 240; ++i) {
                vec3  p = ro + rd * t;
                float r = length(p);
                if (r > RTOP + 0.0004 && dot(p, rd) > 0.0) break;
                vec3  dir = p / r;
                float e   = j_elev(dir);
                float rg  = 1.0 + max(e, 0.0) * 0.012;
                if (r < rg) {
                    // bisect pins the exact ground
                    float t0 = tp;
                    float t1 = t;
                    for (int k = 0; k < 6; ++k) {
                        float tm = (t0 + t1) * 0.5;
                        vec3  pm = ro + rd * tm;
                        vec3  dm = pm / length(pm);
                        if (length(pm) < 1.0 + max(j_elev(dm), 0.0) * 0.012) t1 = tm; else t0 = tm;
                    }
                    hp  = ro + rd * t1;
                    e_h = j_elev(normalize(hp));
                    hit = 1.0;
                    break;
                }
                tp = t;
                if (e > 0.002 && r < rg + VOFF) {
                    float hv = clamp((r - rg) / VOFF, 0.0, 1.0);
                    // the REAL canopy top sits a perlin percentage
                    // DOWN from the offset skin -- and the coasts
                    // carry no top at all, so most of a march is
                    // clear air until the trees actually begin
                    float vg = j_veg(dir, e);
                    float top = vg * (0.35 + 0.65 * j_fbm(dir * 40.0, 3));
                    if (hv < top) {
                        float day = smoothstep(-0.05, 0.18, dot(dir, sun));
                        // scatter starts AT this local top and light
                        // dies with depth below it
                        float tsun = exp(-3.0 * (top - hv) / max(top, 0.05));
                        float al = 1.0 - exp(-55.0 * VSTEP);
                        vec3 cv = vec3(0.055, 0.185, 0.050) * (0.06 + 1.60 * tsun * day);
                        acc += Trv * al * cv;
                        Trv *= 1.0 - al;
                        if (Trv < 0.02) {
                            hit = 2.0;
                            break;
                        }
                    }
                    t += VSTEP;
                } else {
                    t += max((r - (rg + VOFF)) * 0.5, VSTEP);
                }
            }
        }

        vec3 col = acc;
        float alpha = 1.0;
        if (hit == 1.0) {
            vec3  dir = normalize(hp);
            float day = smoothstep(-0.05, 0.18, dot(dir, sun));
            float dl  = clamp(dot(dir, sun), 0.0, 1.0);
            // the height map's own normal on the tangent plane
            vec3 ax = abs(dir.y) > 0.9 ? vec3(1.0, 0.0, 0.0) : vec3(0.0, 1.0, 0.0);
            vec3 t1 = normalize(cross(ax, dir));
            vec3 t2 = cross(dir, t1);
            float ee = 0.0008;
            vec3 d1 = normalize(dir + t1 * ee);
            vec3 d2 = normalize(dir + t2 * ee);
            float h0 = 1.0 + max(e_h, 0.0) * 0.012;
            float h1 = 1.0 + max(j_elev(d1), 0.0) * 0.012;
            float h2 = 1.0 + max(j_elev(d2), 0.0) * 0.012;
            vec3 n = normalize(dir - (t1 * (h1 - h0) + t2 * (h2 - h0)) / ee);
            float ndl = clamp(dot(n, sun), 0.0, 1.0);
            float veg = j_veg(dir, e_h);
            vec3  sc;
            if (e_h > 0.0) {
                // the floor under the fog: sand climbing into soil
                float cover = clamp(veg * 1.1, 0.0, 1.0) * smoothstep(0.003, 0.045, e_h);
                vec3 sandc = mix(vec3(0.52, 0.44, 0.30), vec3(0.75, 0.66, 0.45),
                                 smoothstep(0.0, 0.010, e_h));
                vec3 grnd = mix(sandc, vec3(0.10, 0.16, 0.07), smoothstep(0.05, 0.55, cover));
                sc = grnd * (0.15 + 1.60 * ndl * day);
            } else {
                // depth is the SAME perlin field continued below sea
                // level, so every coast shelves exactly as the land
                // above it falls -- continuous by construction
                float depth = clamp(-e_h * 1.2, 0.0, 1.0);
                vec3 wc = mix(vec3(0.10, 0.62, 0.62), vec3(0.03, 0.28, 0.42), smoothstep(0.01, 0.14, depth));
                wc = mix(wc, vec3(0.008, 0.055, 0.150), smoothstep(0.12, 0.55, depth));
                // the sea floor shows through the shallows: at zero
                // depth the water is only a wet sheen over the sand,
                // so the waterline arrives instead of switching on
                float clear9 = 1.0 - smoothstep(0.0, 0.055, depth);
                wc = mix(wc, vec3(0.62, 0.58, 0.42) * vec3(0.75, 0.95, 0.90), clear9 * 0.85);
                // surf breaks white just off the shoreline
                float foam = smoothstep(0.006, 0.0, -e_h)
                           * smoothstep(0.30, 0.75, j_fbm(dir * 900.0, 2));
                wc = mix(wc, vec3(0.85, 0.90, 0.90), foam * 0.7);
                float spec = pow(max(dot(normalize(sun - rd), dir), 0.0), 180.0);
                sc = wc * (0.16 + 1.45 * dl) + vec3(1.2, 1.1, 0.9) * spec * dl;
            }
            // limb: the air blues and washes the ground at the rim
            float mu = clamp(dot(dir, -rd), 0.0, 1.0);
            sc = mix(sc, vec3(0.45, 0.65, 1.00) * (0.15 + 0.85 * day), pow(1.0 - mu, 3.0) * 0.7);
            col += Trv * sc;
        } else if (hit == 0.0) {
            // missed everything: a thin blue limb, then space
            float tca = max(-bq, 0.0);
            float rc  = length(ro + rd * tca);
            float g   = exp(-max(rc - 1.0, 0.0) / 0.004);
            col  += Trv * vec3(0.45, 0.65, 1.00) * g;
            alpha = 1.0 - Trv * (1.0 - g);
        }
        fragColor = vec4(pow(col, vec3(1.0 / 2.2)), alpha);
    }


element Earth
    frost : true
    frost_sharp : true
    intern e_cur  : f32
    intern p_cur  : f32
    intern jungle : JungleShader
    intern models : vec Model
    intern target : Render
    intern built  : bool
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    intern geom      : GltfModel
    intern img_forest : Image
    public color  : rgba [ r:0.004, g:0.006, b:0.014, a:1.0 ]

    func load_files[]
        geom = GltfModel.open[ path '../scenes/models/earth.gltf' ]
        img_forest = Image [ uri: path '../scenes/textures/mars-veg-jungle.png',
            surface: JungleSurface.forest, linear: true, wrap_u: true, wrap_v: true ]

    func build_models[]
        built  = true
        jungle = JungleShader [ vk: vk ]
        j_samplers : map Image [string] [ 'forest': img_forest ]
        j_model : Model [ vk: vk, w: ux, id: geom, s: jungle, samplers: j_samplers,
            straight_alpha: true, cull_none: true ]
        models = vec Model [] [j_model ]

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        ux.element_targets[ id ] = target

    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    # jungle world: the editor dresses in canopy greens and reef teals
    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#0a180ecc',   # editor pane background
            '#140a2a80':  '#0e221280',   # console pane background
            '#4258':      '#2a4a3258',   # unused (line_color moved)
            '#ff6a2e55':  '#5ab24a55',   # search highlight fill
            '#220022aa':  '#0a1c12aa',   # run console base fill
            '#614':       '#1a3822',     # TButtons / nav rest fill
            '#413':       '#12281a',     # TButtons hover fill
            '#826':       '#2a5434',     # TButtons lit / nav selected
            '#625a':      '#1c30208a',   # bottom status bar fill
            '#8af2':      '#8fa872',     # status bar inner glow
            '#425':       '#20422a',     # editor selection color
            '#ede3':      '#9d83',       # editor selection border
            '#44225588':  '#3a5a3a33',   # editor line highlight
            '#ff3a6a22':  '#5ab24a22',   # commit tab fill
            '#ff3a6a44':  '#5ab24a44',   # commit tab hover fill
            '#ff5a8a99':  '#6ac25a99',   # commit tab border
            '#ff7aa4cc':  '#8ade7acc'    # commit tab hover border
        ]

    # worker decodes files only; every vk object is built on main
    func load_bg [ arg: object :: t: Earth ]
        t.load_files[]
        t.ready = true

    func draw [ w: Window ]
        animated = true
        if [ !loading ]
            loading = true
            w9 : vec Au []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: lambda load_bg[ a ], work: w9 ]
        if [ !ready ] return
        if [ !built ] build_models[]
        create_target[]
        orbit[]

    func orbit[]
        aspect : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]
        # altitude above the canopy in planet radii
        e_t : f32 [ (ux.orbit_mode == OrbitView.low)  ? 0.040 :
                    (ux.orbit_mode == OrbitView.high) ? 0.095 :
                    (ux.orbit_mode == OrbitView.far)  ? 0.260 : 0.850 ]
        if [ e_cur == 0.0 ] e_cur = e_t
        e_cur = filter_n[ e_cur, e_t, 0.06, ux.frame_factor ]
        # gaze tips from straight down toward the horizon
        p_t : f32 [ (ux.angle_mode == ViewAngle.flat)   ? 0.0 :
                    (ux.angle_mode == ViewAngle.angled) ? 0.35 : 0.75 ]
        p_cur = filter_n[ p_cur, p_t, 0.06, ux.frame_factor ]
        ux.orbit_moving = abs[ e_cur - e_t ] > 0.002 || abs[ p_cur - p_t ] > 0.005

        R : f32 [ 1.0 + e_cur ]
        _eye : vec3f [ 0.0, 0.0, R ]
        _tgt : vec3f [ 0.0, p_cur, R - 1.0 ]
        _up  : vec3f [ 0.0, -1.0, 0.0 ]
        _proj : mat4f.perspective[ radians[ 55.0 ], aspect, 0.002, 10.0 ]
        _view : mat4f.look_at    [ _eye, _tgt, _up ]

        # the ground drifts under the craft as the planet turns
        spin_d : f32 [ ux.time * 400.0 ]
        q_spin : quatf [ vec4f [ 0.0, 1.0, 0.0, radians[ spin_d ] ] ]
        q_tilt : quatf [ vec4f [ 0.0, 0.0, 1.0, radians[ 12.0 ] ] ]
        mm : mat4f.identity[]
        mm = mm.rotate[ q_tilt ]
        mm = mm.rotate[ q_spin ]
        jungle.model   = mm
        jungle.view    = _view
        jungle.proj    = _proj
        jungle.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        jungle.sun_dir = vec4f [ 0.45, 0.35, 0.82, 0.0 ]
        jungle.time    = ux.time * 1000.0

# ---- Synthwave: purple sky, comic two-tone mountains, a neon grid
# with real world-width lines, bloomed and comb-filtered in post ----

# ---- synthwave range: a baked 16-bit heightmap on a flat 512 grid the
# vertex shader lifts; snow by slope and altitude in the fragment ----

# ridged perlin over a domain warp, on a broad mass that rises and
# sags along the flanks of the lake valley; the centre stays open.
# the lake floor sits at -4
func synth_height [ x: f32, z: f32 ] -> f32
    # the warp bends every ridge so nothing runs in straight rows
    wx : f32 [ x + (eu_gnoise[ x * 0.008 + 11.0, z * 0.008 + 4.0, 0.2 ] - 0.5) * 70.0 ]
    wz : f32 [ z + (eu_gnoise[ x * 0.008 + 2.0,  z * 0.008 + 9.0, 0.8 ] - 0.5) * 70.0 ]
    qx : f32 [ wx * 0.026 + 5.2 ]
    qz : f32 [ wz * 0.026 + 1.7 ]
    a  : f32 [ 1.0 ]
    h  : f32 [ 0.0 ]
    w  : f32 [ 1.0 ]
    for [ i: i32 0, i < 8, i += 1 ]
        n : f32 [ 1.0 - abs[ eu_gnoise[ qx, qz, 0.37 ] * 2.0 - 1.0 ] ]
        n = n * n * (3.0 - 2.0 * n)
        h += n * a * w
        w = n * 1.1
        if [ w > 1.0 ] w = 1.0
        a *= 0.5
        rx : f32 [ (qx * 0.8 + qz * 0.6) * 2.05 ]
        rz : f32 [ (qz * 0.8 - qx * 0.6) * 2.05 ]
        qx = rx
        qz = rz
    # the mass: where the range stands tall and where it sags to a pass
    mass : f32 [ (eu_gnoise[ wx * 0.005 + 7.0, wz * 0.005 + 3.0, 0.6 ] - 0.3) / 0.45 ]
    if [ mass < 0.0 ] mass = 0.0
    if [ mass > 1.0 ] mass = 1.0
    mass = mass * mass * (3.0 - 2.0 * mass)
    ax : f32 [ abs[ x ] ]
    e1 : f32 [ (ax - 60.0) / 100.0 ]
    if [ e1 < 0.0 ] e1 = 0.0
    if [ e1 > 1.0 ] e1 = 1.0
    flank : f32 [ e1 * e1 * (3.0 - 2.0 * e1) ]
    return flank * (h * (14.0 + 34.0 * mass) + 10.0 * mass) - 4.0

# a map row, wrapped: the map loops in z
func synth_row [ y: i32, h: i32 ] -> i32
    r : i32 [ y % h ]
    if [ r < 0 ] r += h
    return r

# hydraulic erosion: water droplets roll downhill carrying sediment,
# cutting gullies where they speed up and fanning it out where they
# slow. heights are in world units; one cell is ~0.6 units. rows wrap
func synth_erode [ H: @f32, w: i32, h: i32, drops: i32 ]
    inertia : f32 [ 0.05 ]
    capf    : f32 [ 4.0 ]
    minsl   : f32 [ 0.01 ]
    erode   : f32 [ 0.30 ]
    depo    : f32 [ 0.30 ]
    evap    : f32 [ 0.02 ]
    grav    : f32 [ 4.0 ]
    scale   : f32 [ 1.0 / 80.0 ]
    for [ d: i32 0, d < drops, d += 1 ]
        fd : f32 [ f32[ d ] ]
        px : f32 [ 2.0 + eu_hash2[ fd, 0.37, 1.0 ] * f32[ w - 5 ] ]
        py : f32 [ eu_hash2[ fd, 0.71, 2.0 ] * f32[ h ] ]
        dx : f32 [ 0.0 ]
        dy : f32 [ 0.0 ]
        spd : f32 [ 1.0 ]
        wat : f32 [ 1.0 ]
        sed : f32 [ 0.0 ]
        for [ life: i32 0, life < 40, life += 1 ]
            xi : i32 [ i32[ floor[ px ] ] ]
            yi : i32 [ i32[ floor[ py ] ] ]
            if [ xi < 2 || xi >= w - 3 ] break
            fx : f32 [ px - f32[ xi ] ]
            fy : f32 [ py - f32[ yi ] ]
            r0 : i32 [ synth_row[ yi, h ] * w ]
            r1 : i32 [ synth_row[ yi + 1, h ] * w ]
            h00 : f32 [ H[ r0 + xi ] * scale ]
            h10 : f32 [ H[ r0 + xi + 1 ] * scale ]
            h01 : f32 [ H[ r1 + xi ] * scale ]
            h11 : f32 [ H[ r1 + xi + 1 ] * scale ]
            gx : f32 [ (h10 - h00) * (1.0 - fy) + (h11 - h01) * fy ]
            gy : f32 [ (h01 - h00) * (1.0 - fx) + (h11 - h10) * fx ]
            hc : f32 [ h00 * (1.0 - fx) * (1.0 - fy) + h10 * fx * (1.0 - fy) + h01 * (1.0 - fx) * fy + h11 * fx * fy ]
            dx = dx * inertia - gx * (1.0 - inertia)
            dy = dy * inertia - gy * (1.0 - inertia)
            ln : f32 [ sqrt[ dx * dx + dy * dy ] ]
            if [ ln < 1e-6 ]
                dx = eu_hash2[ fd, f32[ life ], 3.0 ] - 0.5
                dy = eu_hash2[ fd, f32[ life ], 4.0 ] - 0.5
                ln = sqrt[ dx * dx + dy * dy ]
            dx /= ln
            dy /= ln
            nx : f32 [ px + dx ]
            ny : f32 [ py + dy ]
            xj : i32 [ i32[ floor[ nx ] ] ]
            yj : i32 [ i32[ floor[ ny ] ] ]
            if [ xj < 2 || xj >= w - 3 ] break
            gx2 : f32 [ nx - f32[ xj ] ]
            gy2 : f32 [ ny - f32[ yj ] ]
            s0 : i32 [ synth_row[ yj, h ] * w ]
            s1 : i32 [ synth_row[ yj + 1, h ] * w ]
            hn : f32 [ (H[ s0 + xj ] * (1.0 - gx2) * (1.0 - gy2) + H[ s0 + xj + 1 ] * gx2 * (1.0 - gy2) +
                        H[ s1 + xj ] * (1.0 - gx2) * gy2 + H[ s1 + xj + 1 ] * gx2 * gy2) * scale ]
            dh : f32 [ hn - hc ]
            cap : f32 [ 0.0 - dh ]
            if [ cap < minsl ] cap = minsl
            cap = cap * spd * wat * capf
            if [ sed > cap || dh > 0.0 ]
                amt : f32 [ (sed - cap) * depo ]
                if [ dh > 0.0 ]
                    amt = dh
                    if [ amt > sed ] amt = sed
                sed -= amt
                amt /= scale
                H[ r0 + xi ]     += amt * (1.0 - fx) * (1.0 - fy)
                H[ r0 + xi + 1 ] += amt * fx * (1.0 - fy)
                H[ r1 + xi ]     += amt * (1.0 - fx) * fy
                H[ r1 + xi + 1 ] += amt * fx * fy
            el
                amt : f32 [ (cap - sed) * erode ]
                if [ amt > 0.0 - dh ] amt = 0.0 - dh
                sed += amt
                amt /= scale
                # take it from a 5x5 footprint, weighted by distance
                for [ oy: i32 -2, oy <= 2, oy += 1 ]
                    ro : i32 [ synth_row[ yi + oy, h ] * w ]
                    for [ ox: i32 -2, ox <= 2, ox += 1 ]
                        cx : f32 [ f32[ xi + ox ] - px ]
                        cy : f32 [ f32[ yi + oy ] - py ]
                        wt : f32 [ 2.5 - sqrt[ cx * cx + cy * cy ] ]
                        if [ wt > 0.0 ]
                            H[ ro + xi + ox ] -= amt * wt * 0.0765
            s2 : f32 [ spd * spd + dh * grav ]
            if [ s2 < 0.0 ] s2 = 0.0
            spd = sqrt[ s2 ]
            wat *= 1.0 - evap
            px = nx
            py = ny
            # keep the row coordinate inside the map as it wraps
            if [ py < 0.0 ] py += f32[ h ]
            if [ py >= f32[ h ] ] py -= f32[ h ]

# thermal weathering: any slope steeper than the talus angle sheds
# material to its lower neighbour until it rests. rows wrap
func synth_talus [ H: @f32, w: i32, h: i32, passes: i32 ]
    # one cell is ~0.6 units across; 0.55 units of drop per cell is ~42 degrees
    limit : f32 [ 0.55 ]
    for [ pss: i32 0, pss < passes, pss += 1 ]
        for [ y: i32 0, y < h, y += 1 ]
            r0 : i32 [ y * w ]
            r1 : i32 [ synth_row[ y + 1, h ] * w ]
            for [ x: i32 1, x < w - 1, x += 1 ]
                hc : f32 [ H[ r0 + x ] ]
                d1 : f32 [ hc - H[ r0 + x + 1 ] ]
                if [ d1 > limit ]
                    m : f32 [ (d1 - limit) * 0.25 ]
                    H[ r0 + x ]     -= m
                    H[ r0 + x + 1 ] += m
                if [ d1 < 0.0 - limit ]
                    m : f32 [ (0.0 - d1 - limit) * 0.25 ]
                    H[ r0 + x ]     += m
                    H[ r0 + x + 1 ] -= m
                hc = H[ r0 + x ]
                d2 : f32 [ hc - H[ r1 + x ] ]
                if [ d2 > limit ]
                    m : f32 [ (d2 - limit) * 0.25 ]
                    H[ r0 + x ] -= m
                    H[ r1 + x ] += m
                if [ d2 < 0.0 - limit ]
                    m : f32 [ (0.0 - d2 - limit) * 0.25 ]
                    H[ r0 + x ] += m
                    H[ r1 + x ] -= m

# world x spans -300..300 across the map, z 30..400 down it. height is
# packed R hi / A lo over -8..504 so the shader reads hv * 512 - 8
func synth_bake [] -> bool
    w9 : i32 [ 1024 ]
    h9 : i32 [ 1024 ]
    pk : Image [ width: w9, height: h9, format: Pixel.rgba8, linear: true, wrap_u: true, wrap_v: true ]
    pd : @u8 [ pk.vdata[] ]
    n9 : i32 [ w9 * h9 ]
    HF : new f32 [ n9 ]
    # the map loops in z: the first 60 units ease from the field one
    # period ahead into the field itself, so row 0 continues row 1023
    zp : f32 [ 370.0 ]
    for [ y: i32 0, y < h9, y += 1 ]
        zz : f32 [ (f32[ y ] + 0.5) / f32[ h9 ] * zp ]
        bw : f32 [ zz / 60.0 ]
        if [ bw > 1.0 ] bw = 1.0
        bw = bw * bw * (3.0 - 2.0 * bw)
        for [ x: i32 0, x < w9, x += 1 ]
            wx : f32 [ ((f32[ x ] + 0.5) / f32[ w9 ] - 0.5) * 600.0 ]
            hv : f32 [ synth_height[ wx, zz + 30.0 ] ]
            if [ bw < 1.0 ] hv = hv * bw + synth_height[ wx, zz + 30.0 + zp ] * (1.0 - bw)
            HF[ y * w9 + x ] = hv
    synth_erode[ HF, w9, h9, 900000 ]
    synth_talus[ HF, w9, h9, 12 ]
    for [ y: i32 0, y < h9, y += 1 ]
        for [ x: i32 0, x < w9, x += 1 ]
            hv : f32 [ (HF[ y * w9 + x ] + 8.0) / 512.0 ]
            if [ hv < 0.0 ] hv = 0.0
            if [ hv > 1.0 ] hv = 1.0
            hq : i32 [ i32[ hv * 65535.0 ] ]
            b2 : i32 [ (y * w9 + x) * 4 ]
            pd[ b2 ]     = u8[ hq / 256 ]
            pd[ b2 + 1 ] = u8[ 0 ]
            pd[ b2 + 2 ] = u8[ 0 ]
            pd[ b2 + 3 ] = u8[ hq % 256 ]
    bd : path '../scenes/baked'
    bd.make_dir[]
    pk.png[ path '../scenes/baked/synth-height.png' ]
    # the flat grid: positions on the lake plane, uv over the map.
    # 1024 rows run two loops deep so the far end fogs out, not clips
    gn : i32 [ 512 ]
    gz : i32 [ 1024 ]
    nv : i32 [ gn * gz ]
    ni : i32 [ (gn - 1) * (gz - 1) * 6 ]
    n3 : i32 [ nv * 3 ]
    n2 : i32 [ nv * 2 ]
    P  : new f32 [ n3 ]
    N  : new f32 [ n3 ]
    T  : new f32 [ n2 ]
    I  : new u32 [ ni ]
    for [ y: i32 0, y < gz, y += 1 ]
        v : f32 [ f32[ y ] / f32[ gz - 1 ] ]
        for [ x: i32 0, x < gn, x += 1 ]
            u : f32 [ f32[ x ] / f32[ gn - 1 ] ]
            k : i32 [ y * gn + x ]
            P[ k * 3 ]     = (u - 0.5) * 600.0
            P[ k * 3 + 1 ] = 0.0
            P[ k * 3 + 2 ] = 30.0 + v * 740.0
            N[ k * 3 ]     = 0.0
            N[ k * 3 + 1 ] = 1.0
            N[ k * 3 + 2 ] = 0.0
            T[ k * 2 ]     = u
            T[ k * 2 + 1 ] = v
    q : i32 [ 0 ]
    for [ y: i32 0, y < gz - 1, y += 1 ]
        for [ x: i32 0, x < gn - 1, x += 1 ]
            k : i32 [ y * gn + x ]
            I[ q ]     = u32[ k ]
            I[ q + 1 ] = u32[ k + gn ]
            I[ q + 2 ] = u32[ k + 1 ]
            I[ q + 3 ] = u32[ k + 1 ]
            I[ q + 4 ] = u32[ k + gn ]
            I[ q + 5 ] = u32[ k + gn + 1 ]
            q += 6
    fb : fopen[ path '../scenes/baked/synth-grid.bin', "wb" ]
    if [ !fb ] return false
    fwrite[ @P[ 0 ], 4, n3, fb ]
    fwrite[ @N[ 0 ], 4, n3, fb ]
    fwrite[ @T[ 0 ], 4, n2, fb ]
    fwrite[ @I[ 0 ], 4, ni, fb ]
    fclose[ fb ]
    b3 : i32 [ n3 * 4 ]
    b2 : i32 [ n2 * 4 ]
    bi : i32 [ ni * 4 ]
    fg : fopen[ path '../scenes/baked/synth-grid.gltf', "wb" ]
    if [ !fg ] return false
    fputs[ '{{"asset":{{"version":"2.0"}},"scene":0,"scenes":[{{"nodes":[0]}}],"nodes":[{{"mesh":0}}],', fg ]
    fputs[ '"meshes":[{{"primitives":[{{"attributes":{{"POSITION":0,"NORMAL":1,"TEXCOORD_0":2}},"indices":3}}]}}],', fg ]
    fputs[ '"accessors":[{{"bufferView":0,"componentType":5126,"count":{nv},"type":"VEC3","min":[-300,0,30],"max":[300,0,770]}},', fg ]
    fputs[ '{{"bufferView":1,"componentType":5126,"count":{nv},"type":"VEC3"}},', fg ]
    fputs[ '{{"bufferView":2,"componentType":5126,"count":{nv},"type":"VEC2"}},', fg ]
    fputs[ '{{"bufferView":3,"componentType":5125,"count":{ni},"type":"SCALAR"}}],', fg ]
    fputs[ '"bufferViews":[{{"buffer":0,"byteLength":{b3},"byteOffset":0,"target":34962}},', fg ]
    fputs[ '{{"buffer":0,"byteLength":{b3},"byteOffset":{b3},"target":34962}},', fg ]
    fputs[ '{{"buffer":0,"byteLength":{b2},"byteOffset":{b3 * 2},"target":34962}},', fg ]
    fputs[ '{{"buffer":0,"byteLength":{bi},"byteOffset":{b3 * 2 + b2},"target":34963}}],', fg ]
    fputs[ '"buffers":[{{"byteLength":{b3 * 2 + b2 + bi},"uri":"synth-grid.bin"}}]}}', fg ]
    fclose[ fg ]
    puts 'synthwave: range baked'
    return true

export func synth_export []
    h1 : u64 [ @synth_height ]
    h2 : u64 [ @synth_bake ]
    h3 : u64 [ @synth_erode ]
    h4 : u64 [ @synth_row ]
    h5 : u64 [ @synth_talus ]
    stamp : string '{h1}-{h2}-{h3}-{h4}-{h5}'
    sp : path '../scenes/baked/synth.hash'
    hp : path '../scenes/baked/synth-height.png'
    gp : path '../scenes/baked/synth-grid.gltf'
    if [ sp.exists[] && hp.exists[] && gp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            puts 'synthwave: range current ({stamp})'
            return
    if [ synth_bake[] ] sp.save[ stamp, null ]

enum SynthSurface
    color  : 0
    refl   : 1
    height : 2

# the range: the grid lifted by the baked map, shaded from the map's
# slopes. key light over the camera's left shoulder, the low sun
# behind the peaks as rim, purple sky light, distance haze
ModelViewProject SynthTerrain
    mutable params : vec4f          # x aspect  y scroll  z sin pitch  w cos pitch
    mutable cam    : vec4f          # x tan half fov  y eye height

    attrib height : LayoutBinding [ type:typeid[ SynthSurface ], id:SynthSurface.height, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_uv      : VertexOutput   [ type:typeid[ vec2f ] ]
    attrib v_wpos    : VertexOutput   [ type:typeid[ vec3f ] ]
    attrib fragColor : FragmentOutput [ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    # one exact texel: the two height bytes must never be filtered
    # apart, or the low byte's wraps pop the surface by half a unit
    func t_texel [ tx: @i32, ty: @i32 ] -> GLSL f32 {
        ivec2 ts = textureSize(height, 0);
        ivec2 c  = ivec2(clamp(tx, 0, ts.x - 1), ((ty % ts.y) + ts.y) % ts.y);
        vec4  hp = texelFetch(height, c, 0);
        return (hp.r * 65280.0 + hp.a * 255.0) / 65535.0 * 512.0 - 8.0;
    }

    # bilinear over exact texels, wrapping down the map
    func t_height [ q: @vec2f ] -> GLSL f32 {
        vec2  ts = vec2(textureSize(height, 0));
        vec2  p  = q * ts - 0.5;
        vec2  f  = fract(p);
        ivec2 i  = ivec2(floor(p));
        float a  = t_texel(i.x,     i.y);
        float b  = t_texel(i.x + 1, i.y);
        float c  = t_texel(i.x,     i.y + 1);
        float d  = t_texel(i.x + 1, i.y + 1);
        return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
    }

    # the scene camera: cam.y units up, looking along +z, pitched by
    # params.zw, cam.x = tan of half the vertical field
    func t_clip [ q: @vec3f, ar: @f32 ] -> GLSL vec4f {
        vec3  v  = vec3(q.x, q.y - ubo.cam.y, q.z);
        float cs = ubo.params.w;
        float sn = ubo.params.z;
        float ta = ubo.cam.x;
        float vy = v.y * cs - v.z * sn;
        float vz = v.y * sn + v.z * cs;
        float n  = 1.0;
        float f  = 1200.0;
        return vec4(v.x / (ta * ar), -vy / ta, (vz - n) * f / (f - n), vz);
    }

    func t_hash [ p: @vec2f ] -> GLSL f32 {
        vec2 q = fract(p * vec2(123.34, 456.21));
        q += dot(q, q + 45.32);
        return fract(q.x * q.y);
    }

    func t_noise [ p: @vec2f ] -> GLSL f32 {
        vec2 i = floor(p);
        vec2 f = fract(p);
        vec2 u = f * f * (3.0 - 2.0 * f);
        float a = t_hash(i);
        float b = t_hash(i + vec2(1.0, 0.0));
        float c = t_hash(i + vec2(0.0, 1.0));
        float d = t_hash(i + vec2(1.0, 1.0));
        return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
    }

    # the haze everything fades into: violet fog lit pink toward the sun
    func t_grad [ rd: @vec3f ] -> GLSL vec3f {
        vec3  sun = normalize(vec3(0.0, 0.04, 1.0));
        float sd  = clamp(dot(rd, sun), 0.0, 1.0);
        return vec3(0.30, 0.18, 0.40) + vec3(0.95, 0.45, 0.65) * pow(sd, 6.0) * 0.55;
    }

    func vertex [] -> GLSL none {
        // the range scrolls toward the camera with the floor and loops.
        // each grid vertex sits on an exact texel (one row = two texels)
        // and the whole mesh slides by the sub-cell remainder, so the
        // geometry translates rigidly instead of resampling the map
        ivec2 ts    = textureSize(height, 0);
        float cellz = 370.0 / float(ts.y / 2);
        float off   = ubo.params.y * 370.0;
        float cells = floor(off / cellz);
        float rem   = off - cells * cellz;
        float col   = floor(a_uv.x * 511.0 + 0.5) * 2.0;
        float row   = floor(a_uv.y * 1023.0 + 0.5) * 2.0 + cells * 2.0;
        int   tx    = int(col);
        int   ty    = int(row);
        float h     = t_texel(tx, ty);
        v_uv        = vec2((col + 0.5) / float(ts.x), (mod(row, float(ts.y)) + 0.5) / float(ts.y));
        vec3  wp    = vec3(a_pos.x, h, a_pos.z - rem);
        v_wpos      = wp;
        gl_Position = t_clip(wp, ubo.params.x);
    }

    func fragment [] -> GLSL none {
        vec2  ts  = vec2(textureSize(height, 0));
        vec2  e   = 1.0 / ts;
        float hx0 = t_height(v_uv - vec2(e.x, 0.0));
        float hx1 = t_height(v_uv + vec2(e.x, 0.0));
        float hz0 = t_height(v_uv - vec2(0.0, e.y));
        float hz1 = t_height(v_uv + vec2(0.0, e.y));
        // one texel is 600/ts.x units across and 370/ts.y units deep
        vec3  n   = normalize(vec3(-(hx1 - hx0) * ts.x / 1200.0, 1.0, -(hz1 - hz0) * ts.y / 740.0));
        vec3  eye = vec3(0.0, ubo.cam.y, 0.0);
        vec3  rd  = normalize(v_wpos - eye);
        float h   = v_wpos.y;
        vec3  key = normalize(vec3(-0.60, 0.45, -0.55));
        vec3  sun = normalize(vec3(0.30, 0.08, 1.00));
        // soft shadow: walk toward the key light over the map
        float sh = 1.0;
        float st = 2.0;
        vec3  sp = v_wpos + key * st;
        for (int i = 0; i < 8; i++) {
            vec2  su = vec2(sp.x / 600.0 + 0.5, v_uv.y + (sp.z - v_wpos.z) / 370.0);
            float th = t_height(su);
            sh = min(sh, 6.0 * (sp.y - th) / st);
            st += 3.0 + st * 0.30;
            sp  = v_wpos + key * st;
        }
        sh = clamp(sh, 0.0, 1.0);
        float dif = max(dot(n, key), 0.0) * sh;
        float amb = 0.35 + 0.65 * n.y;
        float rim = pow(1.0 - max(dot(n, -rd), 0.0), 4.0) * max(dot(rd, sun), 0.0);
        // snow takes the gentle slopes up high; rock keeps the steep faces
        float alt  = clamp((h + 2.0) / 40.0, 0.0, 1.0);
        float brk  = t_noise(vec2(v_uv.x * 600.0, v_uv.y * 370.0) * 0.35) - 0.5;
        float snow = smoothstep(0.45, 0.75, n.y + 0.10 * brk) * smoothstep(0.20, 0.50, alt);
        vec3  alb  = mix(vec3(0.16, 0.15, 0.30), vec3(0.82, 0.86, 0.98), snow);
        vec3  skyl = vec3(0.50, 0.38, 0.80) * amb;
        vec3  hb   = vec3(0.9, 0.45, 0.65) * max(dot(n, normalize(vec3(sun.x, 0.0, sun.z))), 0.0) * 0.45;
        vec3  sunl = vec3(1.0, 0.82, 0.90) * 1.8 * dif;
        vec3  col  = alb * (skyl + hb + sunl) + vec3(1.0, 0.5, 0.7) * rim * 1.0;
        float dist = length(v_wpos - eye);
        // distance haze, total before the mesh ends so new rows fade in
        float fog  = max(1.0 - exp(-dist * 0.0018), smoothstep(600.0, 740.0, dist));
        col = mix(col, t_grad(rd), fog);
        // ground fog pools on the lake and climbs the bases
        float gf = exp(-(h + 4.0) * 0.06) * smoothstep(20.0, 80.0, dist);
        col = mix(col, t_grad(rd), gf * 0.7);
        fragColor = vec4(col, 1.0);
    }


ModelViewProject SynthGrid
    mutable params : vec4f          # x aspect  y -  z sin pitch  w cos pitch
    mutable cam    : vec4f          # x tan half fov  y eye height

    # the sky render (galaxy, clouds, the range) and its blurred copy
    attrib color : LayoutBinding [ type:typeid[ SynthSurface ], id:SynthSurface.color, count:1, format: typeid[ rgba8 ] ]
    attrib refl  : LayoutBinding [ type:typeid[ SynthSurface ], id:SynthSurface.refl,  count:1, format: typeid[ rgba8 ] ]

    attrib pos       : VertexInput    [ type:typeid[ vec3f ] ]
    attrib uv        : VertexInput    [ type:typeid[ vec2f ] ]
    attrib v_uv      : VertexOutput   [ type:typeid[ vec2f ] ]
    attrib fragColor : FragmentOutput [ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        eye:    vec3f [ 0.0, 0.0, 2.0 ]
        center: vec3f [ 0.0, 0.0, 0.0 ]
        up:     vec3f [ 0.0, 1.0, 0.0 ]
        view  = mat4f.look_at[ eye, center, up ]
        proj  = mat4f.ortho[ -1, 1, -1, 1, 0.1, 10.0 ]

    func vertex [] -> GLSL none {
        v_uv        = uv;
        gl_Position = vec4(pos.x, pos.y, 0.0, 1.0);
    }

    # the haze at the horizon: violet fog lit pink toward the sun
    func haze [ rd: @vec3f ] -> GLSL vec3f {
        vec3  sun = normalize(vec3(0.0, 0.04, 1.0));
        float sd  = clamp(dot(rd, sun), 0.0, 1.0);
        return vec3(0.30, 0.18, 0.40) + vec3(0.95, 0.45, 0.65) * pow(sd, 6.0) * 0.55;
    }

    # fog and glow settle on the horizon line from both sides
    func fogged [ c: @vec3f, rd: @vec3f ] -> GLSL vec3f {
        float f = smoothstep(0.07, 0.0, abs(rd.y));
        return mix(c, haze(rd), f * 0.8);
    }

    # a glowing line on the floor, sg wide, seen through a pixel that
    # covers aa floor units: a line thinner than the pixel widens to
    # the pixel and dims by the same ratio, so far lines stay steady
    func ribbon [ d: @f32, aa: @f32, sg: @f32 ] -> GLSL f32 {
        float s2 = sg * sg + aa * aa / 8.0;
        return sg / sqrt(s2) * exp(-d * d / s2);
    }

    func fragment [] -> GLSL none {
        vec2  uv = v_uv;
        float t  = ubo.time;
        float ar = (ubo.params.x > 0.0) ? ubo.params.x : 1.778;
        vec3  col;
        // the scene camera: cam.y up, pitched by params.zw, cam.x = tan
        // of half the vertical field; x scales by the window aspect
        float sn = ubo.params.z;
        float cs = ubo.params.w;
        float ta = ubo.cam.x * 2.0;
        vec3  ro = vec3(0.0, ubo.cam.y, 0.0);
        vec3  r0 = normalize(vec3((uv.x - 0.5) * ta * ar, (0.5 - uv.y) * ta, 1.0));
        vec3  rd = vec3(r0.x, r0.y * cs + r0.z * sn, r0.z * cs - r0.y * sn);
        if (rd.y >= 0.0) {
            col = fogged(texture(color, uv).rgb, rd);
        } else {
            float ny = max(-rd.y, 1e-4);
            float th = ro.y / ny;
            vec3  p  = ro + rd * th;
            float sc = t * 1.4;                           // floor scroll
            vec2  gp = vec2(p.x, p.z + sc);
            // the floor is a mirror: bounce the ray, find where that
            // direction lands on screen, read the blurred sky there
            float rip  = 0.0015 * sin(gp.y * 2.5 - t * 1.5) * exp(-th * 0.05);
            vec3  rr   = vec3(rd.x, -rd.y + rip, rd.z);
            vec3  rc   = vec3(rr.x, rr.y * cs - rr.z * sn, rr.y * sn + rr.z * cs);
            vec2  ruv  = vec2(0.5 + rc.x / rc.z / (ta * ar), 0.5 - rc.y / rc.z / ta);
            vec3  rf   = fogged(texture(refl, ruv).rgb, rr);
            float fres = mix(0.30, 0.85, exp(-th * 0.05));
            col = mix(vec3(0.030, 0.020, 0.070), rf * 0.8, fres);
            // minor grid: a thin line every unit, fading with distance
            vec2  aa  = fwidth(gp);
            vec2  dl  = abs(fract(gp + 0.5) - 0.5);
            float fog = exp(-th * 0.045);
            float mn  = ribbon(dl.x, aa.x, 0.008) + ribbon(dl.y, aa.y, 0.008);
            col += vec3(0.15, 0.55, 0.85) * mn * 0.5 * fog * exp(-th * 0.012);
            // major lasers every 4 units: a tight core in a soft halo
            vec2  dm   = abs(fract(gp * 0.25 + 0.5) - 0.5) * 4.0;
            float core = ribbon(dm.x, aa.x, 0.03) + ribbon(dm.y, aa.y, 0.03);
            float halo = ribbon(dm.x, aa.x, 0.30) + ribbon(dm.y, aa.y, 0.30);
            // the far floor folds its lines into a faint cyan haze
            // line light fades with distance: far lines thinner than a
            // pixel dim out instead of aliasing
            float att  = exp(-th * 0.012);
            float far  = smoothstep(10.0, 60.0, th);
            float glow = 1.0 - exp(-((core + halo * 0.12) * att + far * 0.08) * 2.2);
            col += vec3(0.15, 0.75, 1.00) * glow * 1.4 + vec3(0.7, 0.95, 1.0) * glow * glow * 0.6;
            // the far floor sinks into the same fog the sky meets
            col = mix(col, haze(rr), smoothstep(0.10, 0.0, ny) * 0.85);
        }
        fragColor = vec4(col, 1.0);
    }

ModelViewProject SynthPost
    mutable params : vec4f          # x blur px  y height px  z chroma px  w glow

    attrib color : LayoutBinding [ type:typeid[ SynthSurface ], id:SynthSurface.color, count:1, format: typeid[ rgba8 ] ]

    attrib pos       : VertexInput    [ type:typeid[ vec3f ] ]
    attrib uv        : VertexInput    [ type:typeid[ vec2f ] ]
    attrib v_uv      : VertexOutput   [ type:typeid[ vec2f ] ]
    attrib fragColor : FragmentOutput [ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        eye:    vec3f [ 0.0, 0.0, 2.0 ]
        center: vec3f [ 0.0, 0.0, 0.0 ]
        up:     vec3f [ 0.0, 1.0, 0.0 ]
        view  = mat4f.look_at[ eye, center, up ]
        proj  = mat4f.ortho[ -1, 1, -1, 1, 0.1, 10.0 ]

    func vertex [] -> GLSL none {
        v_uv        = uv;
        gl_Position = vec4(pos.x, pos.y, 0.0, 1.0);
    }

    func fragment [] -> GLSL none {
        vec2 uv  = v_uv;
        vec2 px  = vec2(1.0) / vec2(textureSize(color, 0));
        vec3 base = texture(color, uv).rgb;
        // a real gaussian blur at ubo.params.x pixels of radius
        vec3  bl = vec3(0.0);
        float ws = 0.0;
        for (int i = -3; i <= 3; i++)
        for (int j = -3; j <= 3; j++) {
            float w = exp(-float(i * i + j * j) / 6.0);
            bl += texture(color, uv + vec2(float(i), float(j)) * px * ubo.params.x).rgb * w;
            ws += w;
        }
        bl /= ws;
        // bloom rides the blur: squaring favors the bright neon
        vec3 col = base + bl * bl * ubo.params.w;
        // the comb: chroma taps split a few pixels left and right
        float ch = ubo.params.z;
        col.r = mix(col.r, texture(color, uv + vec2(ch * px.x, 0.0)).r, 0.5) + bl.r * bl.r * ubo.params.w * 0.5;
        col.b = mix(col.b, texture(color, uv - vec2(ch * px.x, 0.0)).b, 0.5) + bl.b * bl.b * ubo.params.w * 0.5;
        float vg = 1.0 - 0.35 * pow(length(uv - vec2(0.5)) * 1.3, 2.0);
        fragColor = vec4(col * vg, 1.0);
    }

element Synthwave
    frost : true
    frost_sharp : true
    # sky + range drawn once per size, then reduced and blurred for the mirror
    mutable gaia_img    : Image
    mutable gaia_geom   : GltfModel
    mutable gaia_shader : GaiaShader
    mutable gaia_model  : Model
    mutable hmap_img    : Image
    mutable terr_geom   : GltfModel
    mutable terr_shader : SynthTerrain
    mutable terr_model  : Model
    mutable sky_render  : Render
    mutable red_model   : Model
    mutable red_render  : Render
    mutable bv_shader   : BlurV
    mutable bv_model    : Model
    mutable bv_render   : Render
    mutable bl_shader   : Blur
    mutable bl_model    : Model
    mutable bl_render   : Render
    mutable grid_shader : SynthGrid
    mutable grid_model  : Model
    mutable grid_render : Render
    mutable post_shader : SynthPost
    mutable post_model  : Model
    mutable target      : Render
    mutable last_rw     : i32
    mutable last_rh     : i32
    # eased camera: height, pitch (degrees, up is positive), vertical fov
    intern  c_h         : f32
    intern  c_p         : f32
    intern  c_f         : f32

    func create_target[]
        if [ target ] return
        # the galaxy: the same gaia sphere the other scenes wrap in
        gaia_img    = Image [ uri: path '../scenes/textures/gaia.png', surface: GaiaSurface.color ]
        gaia_geom   = GltfModel.open[ path '../scenes/models/earth.gltf' ]
        gaia_shader = GaiaShader [ vk: vk ]
        gaia_model  = Model  [ vk: vk, w: ux, id: gaia_geom, s: gaia_shader,
            straight_alpha: true, cull_none: true, samplers: map Au[string] [ 'color': gaia_img ] ]
        puts 'synthwave: before terrain ux {ux.width}x{ux.height} scale {ux.scale}'
        hmap_img    = Image [ uri: path '../scenes/baked/synth-height.png', surface: SynthSurface.height ]
        puts 'synthwave: hmap {hmap_img.width}x{hmap_img.height} ux {ux.width}x{ux.height}'
        terr_geom   = GltfModel.open[ path '../scenes/baked/synth-grid.gltf' ]
        puts 'synthwave: gltf open ux {ux.width}x{ux.height}'
        terr_shader = SynthTerrain [ vk: vk, name: 'synthterrain' ]
        terr_model  = Model  [ vk: vk, w: ux, id: terr_geom, s: terr_shader, cull_none: true,
            samplers: map Au[string] [ 'height': hmap_img ] ]
        puts 'synthwave: terrain model ux {ux.width}x{ux.height} scale {ux.scale}'
        sky_render  = Render [ vk: vk, w: ux, wscale: 1.0, use_depth: true,
            clear_color: vec4f [ 0.03, 0.01, 0.07, 1.0 ], models: [ gaia_model, terr_model ] ]
        red_model   = Model  [ w: ux, samplers: map Au[string] [ 'color': sky_render.color ] ]
        red_render  = Render [ vk: vk, w: ux, wscale: 0.5, models: [ red_model ] ]
        bv_shader   = BlurV  [ vk: vk, name: 'blur-v', reduction_scale: 2.0 ]
        bv_model    = Model  [ w: ux, s: bv_shader, samplers: map Au[string] [ 'color': red_render.color ] ]
        bv_render   = Render [ vk: vk, w: ux, wscale: 1.0, models: [ bv_model ] ]
        bl_shader   = Blur   [ vk: vk, name: 'blur', reduction_scale: 2.0 ]
        bl_model    = Model  [ w: ux, s: bl_shader, samplers: map Au[string] [ 'color': bv_render.color ] ]
        bl_render   = Render [ vk: vk, w: ux, wscale: 1.0, models: [ bl_model ] ]
        grid_shader = SynthGrid [ vk: vk, name: 'synthgrid' ]
        grid_model  = Model  [ w: ux, s: grid_shader,
            samplers: map Au[string] [ 'color': sky_render.color, 'refl': bl_render.color ] ]
        grid_render = Render [ vk: vk, w: ux, wscale: 1.0, models: [ grid_model ] ]
        post_shader = SynthPost [ vk: vk, name: 'synthpost' ]
        post_model  = Model  [ w: ux, s: post_shader,
            samplers: map Texture[string] [ 'color': grid_render.color ] ]
        target = Render [ vk: vk, w: ux, wscale: 1.0,
            clear_color: vec4f [ 0.02, 0.0, 0.04, 1.0 ], models: [ post_model ] ]
        target.hold[]
        target.owner = a
        ux.element_targets[ id ] = target

    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    func draw [ w: Window ]
        animated = true
        create_target[]
        # a resize recreates grid_render's color attachment: the post
        # model's descriptor still holds the DESTROYED view — rebind it
        rw9 : i32 [ i32[ ux.width ] ]
        rh9 : i32 [ i32[ ux.height ] ]
        if [ rw9 != last_rw || rh9 != last_rh ]
            last_rw = rw9
            last_rh = rh9
            if [ post_model && grid_render ]
                red_model.samplers[ 'color' ] = sky_render.color
                red_model.rebind_model[]
                bv_model.samplers[ 'color' ] = red_render.color
                bv_model.rebind_model[]
                bl_model.samplers[ 'color' ] = bv_render.color
                bl_model.rebind_model[]
                grid_model.samplers[ 'color' ] = sky_render.color
                grid_model.samplers[ 'refl' ]  = bl_render.color
                grid_model.rebind_model[]
                post_model.samplers[ 'color' ] = grid_render.color
                post_model.rebind_model[]
        t9  : f32 [ ux.time * 1000.0 ]
        ar9 : f32 [ (rh9 > 0) ? f32[ rw9 ] / f32[ rh9 ] : 1.778 ]
        # angle steps pitch the gaze: flat keeps the horizon at 60%,
        # steep looks down the lake. orbit steps lift and widen the view
        p_t : f32 [ (ux.angle_mode == ViewAngle.flat)   ? 9.5 :
                    (ux.angle_mode == ViewAngle.angled) ? 0.0 : -14.0 ]
        h_t : f32 [ (ux.orbit_mode == OrbitView.low)  ? 1.0 :
                    (ux.orbit_mode == OrbitView.high) ? 7.0 :
                    (ux.orbit_mode == OrbitView.far)  ? 14.0 : 2.5 ]
        f_t : f32 [ (ux.orbit_mode == OrbitView.far)  ? 50.0 :
                    (ux.orbit_mode == OrbitView.wide) ? 80.0 : 62.0 ]
        if [ c_f == 0.0 ]
            c_p = p_t
            c_h = h_t
            c_f = f_t
        c_p = filter_n[ c_p, p_t, 0.08, ux.frame_factor ]
        c_h = filter_n[ c_h, h_t, 0.08, ux.frame_factor ]
        c_f = filter_n[ c_f, f_t, 0.08, ux.frame_factor ]
        ux.orbit_moving = abs[ c_p - p_t ] > 0.02 || abs[ c_h - h_t ] > 0.01 || abs[ c_f - f_t ] > 0.05
        sn9 : f32 [ sin[ radians[ c_p ] ] ]
        cs9 : f32 [ cos[ radians[ c_p ] ] ]
        ta9 : f32 [ tan[ radians[ c_f * 0.5 ] ] ]
        # the galaxy through the same camera; a slow drift
        _eye  : vec3f [ 0.0, 0.0, 0.0 ]
        _tgt  : vec3f [ 0.0, sn9 / cs9, 1.0 ]
        _up   : vec3f [ 0.0, -1.0, 0.0 ]
        _proj : mat4f.perspective[ radians[ c_f ], ar9, 0.5, 1000.0 ]
        _view : mat4f.look_at    [ _eye, _tgt, _up ]
        # the galaxy wraps the whole scene from a big inner sphere; the
        # camera looks at its equator, rolled so the band runs diagonally
        skq9  : vec4f [ 0.0, 0.0, 1.0, radians[ 15.0 ] ]
        skq   : quatf [ skq9 ]
        spq9  : vec4f [ 0.0, 1.0, 0.0, radians[ ux.time * 900.0 ] ]
        spq   : quatf [ spq9 ]
        skm   : mat4f.identity[]
        skm   = skm.rotate[ skq ]
        skm   = skm.rotate[ spq ]
        skm   = skm.scale [ vec3f [ 800.0, 800.0, 800.0 ] ]
        gaia_shader.model = skm
        gaia_shader.view  = _view
        gaia_shader.proj  = _proj
        gaia_shader.gain  = 0.275
        gaia_shader.time  = ux.time * 60000.0
        # the range scrolls toward the camera with the floor and loops
        sc9 : f32 [ t9 * 1.4 / 370.0 ]
        terr_shader.params = vec4f [ ar9, sc9 - floor[ sc9 ], sn9, cs9 ]
        terr_shader.cam    = vec4f [ ta9, c_h, 0.0, 0.0 ]
        sky_render.update[]
        sky_render.draw[]
        sky_render.sync_fence[]
        red_render.update[]
        red_render.draw[]
        red_render.sync_fence[]
        bv_render.update[]
        bv_render.draw[]
        bv_render.sync_fence[]
        bl_render.update[]
        bl_render.draw[]
        bl_render.sync_fence[]
        grid_shader.time   = t9
        grid_shader.params = vec4f [ ar9, 0.0, sn9, cs9 ]
        grid_shader.cam    = vec4f [ ta9, c_h, 0.0, 0.0 ]
        post_shader.params = vec4f [ 2.2, (ux) ? f32[ ux.height ] : 1080.0, 0.0, 1.1 ]
        grid_render.update[]
        grid_render.draw[]
        grid_render.sync_fence[]

    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#12061ecc',   # editor pane background
            '#140a2a80':  '#160a2280',   # console pane background
            '#ff6a2e55':  '#e04ae855',   # search highlight fill
            '#220022aa':  '#180826aa',   # run console base fill
            '#614':       '#3a2050',     # TButtons / nav rest fill
            '#413':       '#2a1638',     # TButtons hover fill
            '#826':       '#5c3078',     # TButtons lit / nav selected
            '#625a':      '#4a2a8a',     # bottom status bar fill
            '#8af2':      '#c8aff2',     # status bar inner glow
            '#425':       '#2a1444',     # editor selection color
            '#ede3':      '#e8cff3',     # editor selection border
            '#44225588':  '#301a4888',   # editor line highlight
            '#ff3a6a22':  '#e04ae822',   # commit tab fill
            '#ff3a6a44':  '#e04ae844',   # commit tab hover fill
            '#ff5a8a99':  '#e06af299',   # commit tab border
            '#ff7aa4cc':  '#f09affcc'    # commit tab hover border
        ]

# ===============================================================
# Clouds: Nubis volumetric cloudscapes (see clouds/clouds.ag)
# ===============================================================
enum CloudSurface
    shape   : 0
    detail  : 1
    curl    : 2
    weather : 3
    island  : 4
    waves   : 5
    stars   : 6
    tvar    : 5

class CloudBake
    intern seed : u32 [ 1234567 ]
    intern perm : vec i32

    func rnd [] -> f32
        seed = seed * 1664525 + 1013904223
        return f32[ seed >> 8 ] / 16777216.0

    func init []
        perm = vec i32 [ 512 ]
        for [ i: i32 0, i < 256, i += 1 ] perm[ i ] = i
        for [ i: i32 255, i > 0, i = i - 1 ]
            j : i32 [ i32[ rnd[] * f32[ i + 1 ] ] ]
            if [ j > i ] j = i
            t : i32 [ perm[ i ] ]
            perm[ i ] = perm[ j ]
            perm[ j ] = t
        for [ i: i32 0, i < 256, i += 1 ] perm[ 256 + i ] = perm[ i ]

    func fade [ t: f32 ] -> f32
        return t * t * t * (t * (t * 6.0 - 15.0) + 10.0)

    func grad3 [ h: i32, x: f32, y: f32, z: f32 ] -> f32
        g : i32 [ h & 15 ]
        u : f32 [ (g < 8) ? x : y ]
        v : f32 [ (g < 4) ? y : ((g == 12 || g == 14) ? x : z) ]
        return (((g & 1) == 0) ? u : 0.0 - u) + (((g & 2) == 0) ? v : 0.0 - v)

    func hash3 [ x: i32, y: i32, z: i32 ] -> i32
        return perm[ (perm[ (perm[ x & 255 ] + y) & 255 ] + z) & 255 ]

    # tileable perlin, period P (power of two) in lattice units
    func perlin3 [ x: f32, y: f32, z: f32, P: i32 ] -> f32
        fx : f32 [ floor[ x ] ]
        fy : f32 [ floor[ y ] ]
        fz : f32 [ floor[ z ] ]
        xi : i32 [ i32[ fx ] ]
        yi : i32 [ i32[ fy ] ]
        zi : i32 [ i32[ fz ] ]
        xf : f32 [ x - fx ]
        yf : f32 [ y - fy ]
        zf : f32 [ z - fz ]
        m : i32 [ P - 1 ]
        x0 : i32 [ xi & m ]
        y0 : i32 [ yi & m ]
        z0 : i32 [ zi & m ]
        x1 : i32 [ (xi + 1) & m ]
        y1 : i32 [ (yi + 1) & m ]
        z1 : i32 [ (zi + 1) & m ]
        u : f32 [ fade[ xf ] ]
        v : f32 [ fade[ yf ] ]
        w : f32 [ fade[ zf ] ]
        n000 : f32 [ grad3[ hash3[ x0, y0, z0 ], xf,       yf,       zf ] ]
        n100 : f32 [ grad3[ hash3[ x1, y0, z0 ], xf - 1.0, yf,       zf ] ]
        n010 : f32 [ grad3[ hash3[ x0, y1, z0 ], xf,       yf - 1.0, zf ] ]
        n110 : f32 [ grad3[ hash3[ x1, y1, z0 ], xf - 1.0, yf - 1.0, zf ] ]
        n001 : f32 [ grad3[ hash3[ x0, y0, z1 ], xf,       yf,       zf - 1.0 ] ]
        n101 : f32 [ grad3[ hash3[ x1, y0, z1 ], xf - 1.0, yf,       zf - 1.0 ] ]
        n011 : f32 [ grad3[ hash3[ x0, y1, z1 ], xf,       yf - 1.0, zf - 1.0 ] ]
        n111 : f32 [ grad3[ hash3[ x1, y1, z1 ], xf - 1.0, yf - 1.0, zf - 1.0 ] ]
        a0 : f32 [ n000 + (n100 - n000) * u ]
        a1 : f32 [ n010 + (n110 - n010) * u ]
        b0 : f32 [ n001 + (n101 - n001) * u ]
        b1 : f32 [ n011 + (n111 - n011) * u ]
        c0 : f32 [ a0 + (a1 - a0) * v ]
        c1 : f32 [ b0 + (b1 - b0) * v ]
        return c0 + (c1 - c0) * w

    # tileable perlin fbm in 0..1; x,y,z in 0..1; base period P
    func perlin_fbm3 [ x: f32, y: f32, z: f32, P: i32, octaves: i32 ] -> f32
        sum : f32 [ 0.0 ]
        amp : f32 [ 1.0 ]
        norm : f32 [ 0.0 ]
        p : i32 [ P ]
        for [ o: i32 0, o < octaves, o += 1 ]
            f : f32 [ f32[ p ] ]
            sum += perlin3[ x * f, y * f, z * f, p ] * amp
            norm += amp
            amp *= 0.5
            p *= 2
            if [ p > 128 ] break
        v : f32 [ sum / norm ]
        # perlin lives in about -0.7..0.7: stretch to 0..1
        return sat[ v * 0.75 + 0.5 ]

    # feature points for a worley frequency F: F^3 cells, 3 floats each
    func worley_points [ F: i32 ] -> vec f32
        n : i32 [ F * F * F * 3 ]
        pts : vec f32 [ n ]
        for [ i: i32 0, i < n, i += 1 ] pts[ i ] = rnd[]
        return pts

    # inverted tileable worley; x,y,z in 0..1
    func worley3 [ x: f32, y: f32, z: f32, F: i32, pts: vec f32 ] -> f32
        px : f32 [ x * f32[ F ] ]
        py : f32 [ y * f32[ F ] ]
        pz : f32 [ z * f32[ F ] ]
        cx : i32 [ i32[ floor[ px ] ] ]
        cy : i32 [ i32[ floor[ py ] ] ]
        cz : i32 [ i32[ floor[ pz ] ] ]
        md : f32 [ 1e9 ]
        for [ dz: i32 -1, dz <= 1, dz += 1 ]
            zz : i32 [ cz + dz ]
            wz : i32 [ (zz + F) % F ]
            for [ dy: i32 -1, dy <= 1, dy += 1 ]
                yy : i32 [ cy + dy ]
                wy : i32 [ (yy + F) % F ]
                for [ dx: i32 -1, dx <= 1, dx += 1 ]
                    xx : i32 [ cx + dx ]
                    wx : i32 [ (xx + F) % F ]
                    i : i32 [ ((wz * F + wy) * F + wx) * 3 ]
                    fx : f32 [ f32[ xx ] + pts[ i ] - px ]
                    fy : f32 [ f32[ yy ] + pts[ i + 1 ] - py ]
                    fz : f32 [ f32[ zz ] + pts[ i + 2 ] - pz ]
                    d2 : f32 [ fx * fx + fy * fy + fz * fz ]
                    if [ d2 < md ] md = d2
        d : f32 [ sqrt[ md ] ]
        if [ d > 1.0 ] d = 1.0
        return 1.0 - d

    func worley2 [ x: f32, y: f32, F: i32, pts: vec f32 ] -> f32
        px : f32 [ x * f32[ F ] ]
        py : f32 [ y * f32[ F ] ]
        cx : i32 [ i32[ floor[ px ] ] ]
        cy : i32 [ i32[ floor[ py ] ] ]
        md : f32 [ 1e9 ]
        for [ dy: i32 -1, dy <= 1, dy += 1 ]
            yy : i32 [ cy + dy ]
            wy : i32 [ (yy + F) % F ]
            for [ dx: i32 -1, dx <= 1, dx += 1 ]
                xx : i32 [ cx + dx ]
                wx : i32 [ (xx + F) % F ]
                i : i32 [ (wy * F + wx) * 3 ]
                fx : f32 [ f32[ xx ] + pts[ i ] - px ]
                fy : f32 [ f32[ yy ] + pts[ i + 1 ] - py ]
                d2 : f32 [ fx * fx + fy * fy ]
                if [ d2 < md ] md = d2
        d : f32 [ sqrt[ md ] ]
        if [ d > 1.0 ] d = 1.0
        return 1.0 - d

    func remap [ v: f32, lo: f32, hi: f32, nlo: f32, nhi: f32 ] -> f32
        return nlo + ((v - lo) / (hi - lo)) * (nhi - nlo)

    func sat [ v: f32 ] -> f32
        return (v < 0.0) ? 0.0 : ((v > 1.0) ? 1.0 : v)

    func to_byte [ v: f32 ] -> u8
        s : f32 [ sat[ v ] * 255.0 + 0.5 ]
        return u8[ i32[ s ] ]

    func run []
        t0 : i64 [ epoch_micros[] ]
        bd : path '../scenes/baked'
        bd.make_dir[]
        bake_shape[ path '../scenes/baked/nubis-shape.png' ]
        bake_detail[ path '../scenes/baked/nubis-detail.png' ]
        bake_curl[ path '../scenes/baked/nubis-curl.png' ]
        bake_weather[ path '../scenes/baked/nubis-weather.png' ]
        bake_tops[ path '../scenes/baked/nubis-tops.png' ]
        bake_ms : i64 [ (epoch_micros[] - t0) / 1000 ]
        puts 'clouds: nubis noise set baked in {bake_ms} ms'

    # shape 128^3: R perlin-worley, G/B/A worley fbm at rising freq
    func bake_shape [ out: path ]
        N : i32 [ 128 ]
        img : Image [ width: N, height: N * N, format: Pixel.rgba8, linear: true, wrap_u: true, wrap_v: true ]
        d : @u8 [ img.vdata[] ]
        w4  : worley_points[ 4 ]
        w8  : worley_points[ 8 ]
        w16 : worley_points[ 16 ]
        w32 : worley_points[ 32 ]
        w64 : worley_points[ 64 ]
        inv : f32 [ 1.0 / f32[ N ] ]
        for [ z: i32 0, z < N, z += 1 ]
            fz : f32 [ (f32[ z ] + 0.5) * inv ]
            for [ y: i32 0, y < N, y += 1 ]
                fy : f32 [ (f32[ y ] + 0.5) * inv ]
                for [ x: i32 0, x < N, x += 1 ]
                    fx : f32 [ (f32[ x ] + 0.5) * inv ]
                    p  : f32 [ perlin_fbm3[ fx, fy, fz, 4, 6 ] ]
                    a4  : f32 [ worley3[ fx, fy, fz, 4,  w4 ] ]
                    a8  : f32 [ worley3[ fx, fy, fz, 8,  w8 ] ]
                    a16 : f32 [ worley3[ fx, fy, fz, 16, w16 ] ]
                    a32 : f32 [ worley3[ fx, fy, fz, 32, w32 ] ]
                    a64 : f32 [ worley3[ fx, fy, fz, 64, w64 ] ]
                    wlow : f32 [ a4 * 0.625 + a8 * 0.25 + a16 * 0.125 ]
                    # perlin dilated by worley: billows in the low perlin
                    pw : f32 [ sat[ remap[ p, 0.0, 1.0, wlow, 1.0 ] ] ]
                    i : i32 [ ((z * N + y) * N + x) * 4 ]
                    d[ i ]     = to_byte[ pw ]
                    d[ i + 1 ] = to_byte[ a8 * 0.625 + a16 * 0.25 + a32 * 0.125 ]
                    d[ i + 2 ] = to_byte[ a16 * 0.625 + a32 * 0.25 + a64 * 0.125 ]
                    d[ i + 3 ] = to_byte[ a32 * 0.75 + a64 * 0.25 ]
        img.png[ out ]

    # detail 32^3: worley fbm, three rising frequencies
    func bake_detail [ out: path ]
        N : i32 [ 32 ]
        img : Image [ width: N, height: N * N, format: Pixel.rgba8, linear: true, wrap_u: true, wrap_v: true ]
        d : @u8 [ img.vdata[] ]
        w2  : worley_points[ 2 ]
        w4  : worley_points[ 4 ]
        w8  : worley_points[ 8 ]
        w16 : worley_points[ 16 ]
        inv : f32 [ 1.0 / f32[ N ] ]
        for [ z: i32 0, z < N, z += 1 ]
            fz : f32 [ (f32[ z ] + 0.5) * inv ]
            for [ y: i32 0, y < N, y += 1 ]
                fy : f32 [ (f32[ y ] + 0.5) * inv ]
                for [ x: i32 0, x < N, x += 1 ]
                    fx : f32 [ (f32[ x ] + 0.5) * inv ]
                    a2  : f32 [ worley3[ fx, fy, fz, 2,  w2 ] ]
                    a4  : f32 [ worley3[ fx, fy, fz, 4,  w4 ] ]
                    a8  : f32 [ worley3[ fx, fy, fz, 8,  w8 ] ]
                    a16 : f32 [ worley3[ fx, fy, fz, 16, w16 ] ]
                    i : i32 [ ((z * N + y) * N + x) * 4 ]
                    d[ i ]     = to_byte[ a2 * 0.625 + a4 * 0.25 + a8 * 0.125 ]
                    d[ i + 1 ] = to_byte[ a4 * 0.625 + a8 * 0.25 + a16 * 0.125 ]
                    d[ i + 2 ] = to_byte[ a8 * 0.75 + a16 * 0.25 ]
                    d[ i + 3 ] = to_byte[ 1.0 ]
        img.png[ out ]

    # curl 128^2: rotated gradient of a perlin field (divergence free)
    func bake_curl [ out: path ]
        N : i32 [ 128 ]
        img : Image [ width: N, height: N, format: Pixel.rgba8, linear: true, wrap_u: true, wrap_v: true ]
        d : @u8 [ img.vdata[] ]
        inv : f32 [ 1.0 / f32[ N ] ]
        e : f32 [ inv ]
        for [ y: i32 0, y < N, y += 1 ]
            fy : f32 [ (f32[ y ] + 0.5) * inv ]
            for [ x: i32 0, x < N, x += 1 ]
                fx : f32 [ (f32[ x ] + 0.5) * inv ]
                px1 : f32 [ perlin_fbm3[ fx + e, fy, 0.37, 4, 3 ] ]
                px0 : f32 [ perlin_fbm3[ fx - e, fy, 0.37, 4, 3 ] ]
                py1 : f32 [ perlin_fbm3[ fx, fy + e, 0.37, 4, 3 ] ]
                py0 : f32 [ perlin_fbm3[ fx, fy - e, 0.37, 4, 3 ] ]
                qx1 : f32 [ perlin_fbm3[ fx + e, fy, 0.71, 4, 3 ] ]
                qx0 : f32 [ perlin_fbm3[ fx - e, fy, 0.71, 4, 3 ] ]
                gx : f32 [ (px1 - px0) / (2.0 * e) ]
                gy : f32 [ (py1 - py0) / (2.0 * e) ]
                gz : f32 [ (qx1 - qx0) / (2.0 * e) ]
                i : i32 [ (y * N + x) * 4 ]
                d[ i ]     = to_byte[ gy * 0.08 + 0.5 ]
                d[ i + 1 ] = to_byte[ 0.5 - gx * 0.08 ]
                d[ i + 2 ] = to_byte[ gz * 0.08 + 0.5 ]
                d[ i + 3 ] = to_byte[ 1.0 ]
        img.png[ out ]

    # tops 256^2: the height field. its own perlin section, coarser than
    # coverage, so a cloud's top is half to one and a half times nominal
    func bake_tops [ out: path ]
        N : i32 [ 256 ]
        img : Image [ width: N, height: N, format: Pixel.rgba8, linear: true, wrap_u: true, wrap_v: true ]
        d : @u8 [ img.vdata[] ]
        inv : f32 [ 1.0 / f32[ N ] ]
        for [ y: i32 0, y < N, y += 1 ]
            fy : f32 [ (f32[ y ] + 0.5) * inv ]
            for [ x: i32 0, x < N, x += 1 ]
                fx : f32 [ (f32[ x ] + 0.5) * inv ]
                hv : f32 [ perlin_fbm3[ fx + 0.17, fy + 0.83, 0.41, 3, 3 ] ]
                bv : f32 [ perlin_fbm3[ fx + 0.71, fy + 0.29, 0.62, 5, 2 ] ]
                i : i32 [ (y * N + x) * 4 ]
                d[ i ]     = to_byte[ sat[ remap[ hv, 0.3, 0.7, 0.0, 1.0 ] ] ]
                d[ i + 1 ] = to_byte[ sat[ remap[ bv, 0.35, 0.65, 0.0, 1.0 ] ] ]
                d[ i + 2 ] = to_byte[ 0.5 ]
                d[ i + 3 ] = to_byte[ 1.0 ]
        img.png[ out ]

    # weather 512^2: R perlin coverage field, G perlin-worley islands,
    # B cloud type field, A unused
    func bake_weather [ out: path ]
        N : i32 [ 512 ]
        img : Image [ width: N, height: N, format: Pixel.rgba8, linear: true, wrap_u: true, wrap_v: true ]
        d : @u8 [ img.vdata[] ]
        w3 : worley_points[ 3 ]
        inv : f32 [ 1.0 / f32[ N ] ]
        for [ y: i32 0, y < N, y += 1 ]
            fy : f32 [ (f32[ y ] + 0.5) * inv ]
            for [ x: i32 0, x < N, x += 1 ]
                fx : f32 [ (f32[ x ] + 0.5) * inv ]
                # large air masses times the cloud footprints inside them
                big : f32 [ perlin_fbm3[ fx, fy, 0.11, 2, 2 ] ]
                pf  : f32 [ perlin_fbm3[ fx, fy, 0.53, 4, 5 ] ]
                wf  : f32 [ worley2[ fx, fy, 3, w3 ] ]
                cov : f32 [ sat[ remap[ pf, 0.0, 1.0, big * 0.5 - 0.25, 1.0 ] ] ]
                isl : f32 [ sat[ remap[ pf, 1.0 - wf * 0.9, 1.0, 0.0, 1.0 ] ] ]
                typ : f32 [ perlin_fbm3[ fx + 0.3, fy + 0.7, 0.29, 2, 3 ] ]
                stm : f32 [ perlin_fbm3[ fx + 0.6, fy + 0.2, 0.83, 6, 3 ] ]
                i : i32 [ (y * N + x) * 4 ]
                d[ i ]     = to_byte[ cov ]
                d[ i + 1 ] = to_byte[ isl ]
                d[ i + 2 ] = to_byte[ typ ]
                d[ i + 3 ] = to_byte[ sat[ remap[ stm, 0.40, 0.88, 0.0, 1.0 ] ] ]
        img.png[ out ]

# ---------------------------------------------------------------
# the sky shader: atmosphere + cloud layer, one fullscreen pass
# ---------------------------------------------------------------
ModelViewProject NubisSky
    mutable cam_pos   : vec4f     # xyz metres above ground, w unused
    mutable cam_right : vec4f     # w: tan(half fov) * aspect
    mutable cam_up    : vec4f     # w: tan(half fov)
    mutable cam_fwd   : vec4f     # w: exposure
    mutable sun_dir   : vec4f     # w: sun intensity
    mutable wind      : vec4f     # xyz m/s, w: seconds
    mutable layer     : vec4f     # x cloud bottom, y cloud top, z planet radius, w atmosphere radius
    mutable weather_a : vec4f     # x coverage, y type, z unused, w island mix
    mutable weather_b : vec4f     # x anvil, y skew m, z density, w detail strength
    mutable light_a   : vec4f     # x g forward, y silver intensity, z silver spread, w ambient
    mutable light_b   : vec4f     # x ms scatter, y ms extinction, z ms phase, w extinction / m
    mutable scales    : vec4f     # x shape tile m, y detail tile m, z curl tile m, w weather tile m
    mutable march     : vec4f     # x quality, y curl strength, z max distance, w fog
    mutable tops      : vec4f     # type tops above the base, m: stratus, stratocumulus, cumulus
    mutable world     : vec4f     # xy: how far we have flown, in metres
    mutable key_tint  : vec4f     # rgb: the key light's colour, w: night
    mutable sea       : vec4f     # x wave count, y choppiness, z foam start, w detail fade m
    mutable sea_b     : vec4f     # x wind m/s, y reflect quality, z swell, w unused
    mutable jitter    : vec4f     # xy: sub-pixel uv offset of this frame's samples
    mutable view_mode : i32
    mutable frame     : i32

    attrib shape   : LayoutBinding [ type:typeid[ CloudSurface ], id: CloudSurface.shape,   count:1, format: typeid[ rgba8 ], volume: true ]
    attrib detail  : LayoutBinding [ type:typeid[ CloudSurface ], id: CloudSurface.detail,  count:1, format: typeid[ rgba8 ], volume: true ]
    attrib curl    : LayoutBinding [ type:typeid[ CloudSurface ], id: CloudSurface.curl,    count:1, format: typeid[ rgba8 ] ]
    attrib weather : LayoutBinding [ type:typeid[ CloudSurface ], id: CloudSurface.weather, count:1, format: typeid[ rgba8 ] ]
    # distance (in cells of the weather tile / 256) to the nearest cloud island
    attrib island  : LayoutBinding [ type:typeid[ CloudSurface ], id: CloudSurface.island,  count:1, format: typeid[ rgba8 ] ]
    # one Gerstner component per record: xy wave vector, z amplitude, w phase
    attrib stars   : LayoutBinding [ type:typeid[ CloudSurface ], id: CloudSurface.stars,   count:1, format: typeid[ rgba8 ] ]
    attrib waves   : StorageBuffer [ type:typeid[ CloudSurface ], id: CloudSurface.waves,   count:1, format: typeid[ vec4f ] ]
    # R: cloud top height scale, G: base height offset
    attrib tvar    : LayoutBinding [ type:typeid[ CloudSurface ], id: CloudSurface.tvar,    count:1, format: typeid[ rgba8 ] ]

    attrib pos       : VertexInput    [ type:typeid[ vec3f ] ]
    attrib uv        : VertexInput    [ type:typeid[ vec2f ] ]
    attrib v_uv      : VertexOutput   [ type:typeid[ vec2f ] ]
    attrib fragColor : FragmentOutput [ type:typeid[ vec4f ] ]

    func init []
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    func vertex [] -> GLSL none {
        v_uv        = uv;
        gl_Position = vec4(pos.x, pos.y, 0.0, 1.0);
    }

    func remap [ v: @f32, lo: @f32, hi: @f32, nlo: @f32, nhi: @f32 ] -> GLSL f32 {
        return nlo + ((v - lo) / (hi - lo)) * (nhi - nlo);
    }

    func hg [ c: @f32, g: @f32 ] -> GLSL f32 {
        float g2 = g * g;
        return (1.0 - g2) / (4.0 * 3.14159265 * pow(1.0 + g2 - 2.0 * g * c, 1.5));
    }

    # near / far hits of a sphere at the origin; (-1,-1) on a miss
    func ray_sphere [ o: @vec3f, d: @vec3f, r: @f32 ] -> GLSL vec2f {
        float b = dot(o, d);
        float c = dot(o, o) - r * r;
        float h = b * b - c;
        if (h < 0.0) return vec2(-1.0);
        float s = sqrt(h);
        return vec2(-b - s, -b + s);
    }

    # single-scatter atmosphere (Rayleigh + Mie) from o along d up to
    # tmax: rgb in-scattered light, a = transmittance
    func atmosphere [ o: @vec3f, d: @vec3f, tmax: @f32 ] -> GLSL vec4f {
        vec3  C  = vec3(0.0, -ubo.layer.z, 0.0);
        float R  = ubo.layer.z;
        float Ra = ubo.layer.w;
        vec3  oc = o - C;
        vec2  ta = ray_sphere(oc, d, Ra);
        if (ta.y < 0.0) return vec4(0.0, 0.0, 0.0, 1.0);
        float t0 = max(ta.x, 0.0);
        float t1 = min(ta.y, tmax);
        if (t1 <= t0) return vec4(0.0, 0.0, 0.0, 1.0);
        vec3  betaR = vec3(9.5e-6, 21.5e-6, 54.0e-6);
        float betaM = 7.0e-6;
        float Hr = 8000.0;
        float Hm = 1200.0;
        vec3  sun = ubo.sun_dir.xyz;
        float mu  = dot(d, sun);
        float phR = 3.0 / (16.0 * 3.14159265) * (1.0 + mu * mu);
        float phM = hg(mu, 0.70);
        // samples cluster toward the camera: along a horizon ray nearly
        // all the air is in the first tens of km, and even spacing there
        // reads as a dark saturated band
        float span = t1 - t0;
        vec3  sumR = vec3(0.0);
        vec3  sumM = vec3(0.0);
        float odR = 0.0;
        float odM = 0.0;
        for (int i = 0; i < 12; i++) {{
            float a0 = float(i) / 12.0;
            float a1 = float(i + 1) / 12.0;
            float s0 = a0 * a0;
            float s1 = a1 * a1;
            float ds = span * (s1 - s0);
            vec3  p  = oc + d * (t0 + span * (s0 + s1) * 0.5);
            float h  = max(length(p) - R, 0.0);
            float hr = exp(-h / Hr) * ds;
            float hm = exp(-h / Hm) * ds;
            odR += hr;
            odM += hm;
            vec2  tl  = ray_sphere(p, sun, Ra);
            float dsl = tl.y / 4.0;
            float olR = 0.0;
            float olM = 0.0;
            for (int j = 0; j < 4; j++) {{
                vec3  q  = p + sun * dsl * (float(j) + 0.5);
                float hq = max(length(q) - R, 0.0);
                olR += exp(-hq / Hr) * dsl;
                olM += exp(-hq / Hm) * dsl;
            }}
            vec3 tau = betaR * (odR + olR) + betaM * 1.1 * (odM + olM);
            vec3 att = exp(-tau);
            sumR += att * hr;
            sumM += att * hm;
        }}
        vec3 L = ubo.sun_dir.w * (sumR * betaR * phR + sumM * betaM * phM);
        vec3 T = exp(-(betaR * odR + betaM * 1.1 * odM));
        float Ta = (T.r + T.g + T.b) / 3.0;
        // multiple scattering stand-in: thick air glows sky-blue, not orange
        float ms_air = clamp(odR * 5.0e-5, 0.0, 1.0);
        L += vec3(0.30, 0.42, 0.92) * ubo.sun_dir.w * 0.034 * ms_air * clamp(sun.y * 3.0 + 0.62, 0.0, 1.0);
        // by night the long horizon path still reddens, but under a moon
        // there is no warm band to see: the sky goes cool and desaturated,
        // over a floor of starlight
        float ng = ubo.key_tint.w;
        if (ng > 0.0) {{
            float lum = dot(L, vec3(0.2126, 0.7152, 0.0722));
            L = mix(L, vec3(lum) * vec3(0.66, 0.82, 1.16), ng);
            L += vec3(0.0016, 0.0022, 0.0044) * ng;
        }}
        return vec4(L, Ta);
    }

    # sunlight reaching p: the sun's transmittance through the air
    func sun_light [ p: @vec3f ] -> GLSL vec3f {
        vec3  C  = vec3(0.0, -ubo.layer.z, 0.0);
        float R  = ubo.layer.z;
        vec3  pc = p - C;
        vec3  sun = ubo.sun_dir.xyz;
        vec2  tl = ray_sphere(pc, sun, ubo.layer.w);
        float dsl = max(tl.y, 0.0) / 6.0;
        float oR = 0.0;
        float oM = 0.0;
        for (int j = 0; j < 6; j++) {{
            vec3  q  = pc + sun * dsl * (float(j) + 0.5);
            float hq = max(length(q) - R, 0.0);
            oR += exp(-hq / 8000.0) * dsl;
            oM += exp(-hq / 1200.0) * dsl;
        }}
        vec3 tau = vec3(9.5e-6, 21.5e-6, 54.0e-6) * oR + 7.0e-6 * 1.1 * oM;
        return exp(-tau) * ubo.sun_dir.w * ubo.key_tint.rgb;
    }

    func height_frac [ p: @vec3f ] -> GLSL f32 {
        float r = length(p - vec3(0.0, -ubo.layer.z, 0.0)) - ubo.layer.z;
        return clamp((r - ubo.layer.x) / (ubo.layer.y - ubo.layer.x), 0.0, 1.0);
    }

    # weather at p: x coverage, y type, z height scale
    func weather_at [ p: @vec3f ] -> GLSL vec3f {
        vec2 uv = (p.xz + ubo.world.xy) / ubo.scales.w + 0.5;
        vec4 w  = texture(weather, uv);
        // fields stretched to 0..1 from the bake's 10th..90th percentiles
        float fr = clamp(remap(w.r, 0.30, 0.72, 0.0, 1.0), 0.0, 1.0);
        float fg = clamp(remap(w.g, 0.0, 0.5, 0.0, 1.0), 0.0, 1.0);
        float field = mix(fr, fg, ubo.weather_a.w);
        float c   = ubo.weather_a.x;
        float cov = clamp(remap(field, 1.0 - c, 1.0 - c + 0.35, 0.0, 1.0), 0.0, 1.0) * 0.95;
        float typ = clamp(remap(w.b, 0.35, 0.72, 0.0, 1.0) * 0.5 + ubo.weather_a.y - 0.25, 0.0, 1.0);
        // a separate perlin field scales each cloud's own height
        float hsc = texture(tvar, p.xz / ubo.scales.w * 3.0 + 0.5).r;
        return vec3(cov, typ, hsc);
    }

    # top of the cloud type at this weather, metres above the base:
    # stratus, stratocumulus, cumulus
    func type_top [ p: @vec3f, w: @vec3f ] -> GLSL f32 {
        float t  = w.y;
        float a  = mix(ubo.tops.x, ubo.tops.y, clamp(t * 2.0, 0.0, 1.0));
        float cu = mix(a, ubo.tops.z, clamp(t * 2.0 - 1.0, 0.0, 1.0));
        // a separate perlin field: this cloud is half to 1.5x as tall
        return cu * mix(0.5, 1.5, w.z);
    }

    # height fraction within this type's own top
    func type_frac [ p: @vec3f, w: @vec3f ] -> GLSL f32 {
        float r = length(p - vec3(0.0, -ubo.layer.z, 0.0)) - ubo.layer.z;
        return clamp((r - ubo.layer.x) / type_top(p, w), 0.0, 1.0);
    }

    # density over height: a sharp condensation level at the base,
    # stratus -> stratocumulus -> cumulus tops
    func height_gradient [ h: @f32, w: @vec3f ] -> GLSL f32 {
        float t  = w.y;
        // cumulus bases are flat at the condensation level, stratus fades in
        float base = clamp(remap(h, 0.0, mix(0.18, 0.05, clamp(t * 1.5, 0.0, 1.0)), 0.0, 1.0), 0.0, 1.0);
        float st = clamp(remap(h, 0.35, 0.75, 1.0, 0.0), 0.0, 1.0);
        float sc = clamp(remap(h, 0.55, 0.9, 1.0, 0.0), 0.0, 1.0);
        float cu = clamp(remap(h, 0.7, 1.0, 1.0, 0.0), 0.0, 1.0);
        float a  = mix(st, sc, clamp(t * 2.0, 0.0, 1.0));
        return base * mix(a, cu, clamp(t * 2.0 - 1.0, 0.0, 1.0));
    }

    # the Nubis density sampler. lod 0 = full detail, 1 = shape only
    func cloud_density [ p: @vec3f, hl: @f32, w: @vec3f, lod: @f32 ] -> GLSL f32 {
        float h = type_frac(p, w);
        // deformation runs on METRES above the base, never on the type
        // fraction: a tall tower would stretch the same shear over its
        // whole column and smear it into wavy fibres
        float hm = length(p - vec3(0.0, -ubo.layer.z, 0.0)) - ubo.layer.z - ubo.layer.x;
        float hd = clamp(hm / 2500.0, 0.0, 1.0);
        vec3 q = p + vec3(ubo.world.x, 0.0, ubo.world.y) + ubo.wind.xyz * ubo.wind.w;
        q += ubo.wind.xyz * (hd * ubo.weather_b.y / max(length(ubo.wind.xyz), 0.01));
        vec4 low = texture(shape, q / ubo.scales.x);
        float lfbm = low.g * 0.625 + low.b * 0.25 + low.a * 0.125;
        // the composite spans 0.71..0.93 in the bake: stretch to 0..1
        float comp = remap(low.r, -(1.0 - lfbm), 1.0, 0.0, 1.0);
        comp = clamp(remap(comp, 0.70, 0.94, 0.0, 1.0), 0.0, 1.0);
        float cov = w.x;
        float profile = height_gradient(h, w) * cov;
        float base = clamp(comp - (1.0 - profile), 0.0, 1.0) * clamp(cov * 1.5, 0.0, 1.0);
        if (base <= 0.0) return 0.0;
        if (lod < 0.5) {{
            vec3 cn = texture(curl, q.xz / ubo.scales.z).rgb * 2.0 - 1.0;
            // curl is a low-level turbulence: it fades out with height
            q += cn * ubo.march.y * (1.0 - hd) * ubo.scales.y * 0.15;
            vec3  hi   = texture(detail, q / ubo.scales.y).rgb;
            float hfbm = hi.r * 0.625 + hi.g * 0.25 + hi.b * 0.125;
            // wispy bottoms, billowy tops; the flat base keeps its edge
            float m = mix(hfbm, 1.0 - hfbm, clamp(hm / 250.0, 0.0, 1.0));
            m *= mix(0.35, 1.0, clamp(h * 6.0, 0.0, 1.0));
            base = remap(base, m * ubo.weather_b.w, 1.0, 0.0, 1.0);
        }}
        // a thin cloud is translucent; a deep one is dense
        return clamp(base, 0.0, 1.0) * ubo.weather_b.z * mix(0.45, 1.2, w.z);
    }

    # optical depth toward the sun: five cone samples and one far
    func light_march [ p: @vec3f ] -> GLSL f32 {
        vec3  sun = ubo.sun_dir.xyz;
        float ls = 225.0;
        vec3 k0 = vec3( 0.38, -0.14,  0.24);
        vec3 k1 = vec3(-0.24,  0.36, -0.12);
        vec3 k2 = vec3( 0.07,  0.32,  0.41);
        vec3 k3 = vec3(-0.44, -0.08,  0.26);
        vec3 k4 = vec3( 0.29, -0.38, -0.30);
        float od = 0.0;
        for (int i = 1; i <= 5; i++) {{
            vec3 k = (i == 1) ? k0 : (i == 2) ? k1 : (i == 3) ? k2 : (i == 4) ? k3 : k4;
            float s = ls * float(i);
            vec3  q = p + sun * s + k * s * 0.45;
            float h = height_frac(q);
            if (h <= 0.0 || h >= 1.0) continue;
            vec3  w = weather_at(q);
            od += cloud_density(q, h, w, (i > 2) ? 1.0 : 0.0) * ls;
        }}
        vec3  qf = p + sun * ls * 9.0;
        float hf = height_frac(qf);
        if (hf > 0.0 && hf < 1.0) od += cloud_density(qf, hf, weather_at(qf), 1.0) * ls * 3.0;
        return od;
    }

    # sunlight transmittance from a ground point up through the layer
    func ground_shadow [ p: @vec3f ] -> GLSL f32 {
        vec3  C  = vec3(0.0, -ubo.layer.z, 0.0);
        vec3  sun = ubo.sun_dir.xyz;
        if (sun.y <= 0.02) return 1.0;
        vec2 t0 = ray_sphere(p - C, sun, ubo.layer.z + ubo.layer.x);
        vec2 t1 = ray_sphere(p - C, sun, ubo.layer.z + ubo.layer.y);
        float ds = (t1.y - t0.y) / 6.0;
        float od = 0.0;
        for (int i = 0; i < 6; i++) {{
            vec3 q = p + sun * (t0.y + ds * (float(i) + 0.5));
            od += cloud_density(q, height_frac(q), weather_at(q), 1.0) * ds;
        }}
        return exp(-od * ubo.light_b.w * 0.6);
    }

    # the galaxy, and only where the sky has gone dark enough to show
    # it. the band is tilted off the horizon and turns with the hours
    func night_stars [ d: @vec3f ] -> GLSL vec3f {
        float ng = ubo.key_tint.w;
        if (ng <= 0.001) return vec3(0.0);
        float ca = 0.6216;
        float sa = 0.7833;
        vec3  r  = vec3(d.x, d.y * ca - d.z * sa, d.y * sa + d.z * ca);
        float u  = atan(r.z, r.x) * 0.15915494 + 0.5 + ubo.sea_b.w;
        float v  = acos(clamp(r.y, -1.0, 1.0)) * 0.31830989;
        vec3  c  = texture(stars, vec2(u, v)).rgb;
        // squaring holds the band and drops the wash between the stars.
        // low in the sky there is too much air to see any of it
        float up = smoothstep(0.03, 0.70, d.y);
        return c * c * ng * 0.05 * up;
    }

    func aces [ x: @vec3f ] -> GLSL vec3f {
        return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
    }

    # a cheap pass over the cloud layer for what the water reflects:
    # coarse noise, long steps, and it stops at the first solid cloud
    func cloud_reflect [ o: @vec3f, d: @vec3f ] -> GLSL vec4f {
        vec3  C  = vec3(0.0, -ubo.layer.z, 0.0);
        float R  = ubo.layer.z;
        vec2  ti = ray_sphere(o - C, d, R + ubo.layer.x);
        vec2  to = ray_sphere(o - C, d, R + ubo.layer.y);
        float t0 = (ti.y > 0.0) ? ti.y : -1.0;
        float t1 = (to.y > 0.0) ? to.y : -1.0;
        if (t0 < 0.0 || t1 <= t0) return vec4(0.0, 0.0, 0.0, 1.0);
        t1 = min(t1, t0 + 60000.0);
        float steps = 24.0 * ubo.sea_b.y;
        float dt = (t1 - t0) / steps;
        vec3  col = vec3(0.0);
        float T   = 1.0;
        vec3  sun_c = sun_light(o + d * t0);
        vec3  amb   = atmosphere(o + d * t0, vec3(0.0, 1.0, 0.0), 1e12).rgb;
        float mu    = dot(d, ubo.sun_dir.xyz);
        float ph    = max(mix(hg(mu, ubo.light_a.x), hg(mu, -0.25), 0.3),
                          ubo.light_a.y * hg(mu, 0.99 - ubo.light_a.z));
        for (int i = 0; i < 48; i++) {{
            if (float(i) >= steps || T < 0.02) break;
            vec3  p = o + d * (t0 + dt * (float(i) + 0.5));
            vec3  w = weather_at(p);
            float dens = cloud_density(p, 0.0, w, 1.0);
            if (dens <= 0.0) continue;
            float ext = ubo.light_b.w;
            float od  = light_march(p) * ext;
            vec3  S   = (exp(-od) * ph * sun_c + amb * 0.5) * dens * ext;
            float e   = max(dens * ext, 1e-6);
            float Ts  = exp(-e * dt);
            col += T * (S - S * Ts) / e;
            T   *= Ts;
        }}
        return vec4(col, T);
    }

    # the sea surface: a sum of spectral components (JONSWAP frequency
    # spectrum, Donelan-Banner spreading) as Gerstner waves. returns the
    # displacement: xz sideways, y up
    func ocean_disp [ q: @vec2f, n: @f32, kmax: @f32 ] -> GLSL vec3f {
        vec3  D = vec3(0.0);
        float t = ubo.wind.w;
        float Q = ubo.sea.y;
        for (int i = 0; i < 128; i++) {{
            if (float(i) >= n) break;
            vec4  wv = waves[i];
            float k  = length(wv.xy);
            if (k > kmax) break;
            float om = sqrt(9.81 * k);
            float a  = dot(wv.xy, q + ubo.world.xy) - om * t + wv.w;
            D.y  += wv.z * cos(a);
            D.xz -= (wv.xy / k) * (wv.z * Q * sin(a));
        }}
        return D;
    }

    # normal and folding of the same surface. w carries the Jacobian:
    # below 1 the surface is compressing, and that is where foam is
    func ocean_ndj [ q: @vec2f, n: @f32, kmax: @f32 ] -> GLSL vec4f {
        float t = ubo.wind.w;
        float Q = ubo.sea.y;
        float hx = 0.0;
        float hz = 0.0;
        float jxx = 0.0;
        float jzz = 0.0;
        float jxz = 0.0;
        for (int i = 0; i < 128; i++) {{
            if (float(i) >= n) break;
            vec4  wv = waves[i];
            float k  = length(wv.xy);
            if (k > kmax) break;
            float om = sqrt(9.81 * k);
            float a  = dot(wv.xy, q + ubo.world.xy) - om * t + wv.w;
            float sa = sin(a);
            float ca = cos(a);
            hx  -= wv.z * wv.x * sa;
            hz  -= wv.z * wv.y * sa;
            float qa = Q * wv.z * ca / k;
            jxx -= qa * wv.x * wv.x;
            jzz -= qa * wv.y * wv.y;
            jxz -= qa * wv.x * wv.y;
        }}
        vec3 nrm = normalize(vec3(-hx, 1.0, -hz));
        float J  = (1.0 + jxx) * (1.0 + jzz) - jxz * jxz;
        return vec4(nrm, J);
    }

    func fragment [] -> GLSL none {
        vec2  uvj = v_uv + ubo.jitter.xy;
        vec2  ndc = vec2(uvj.x * 2.0 - 1.0, 1.0 - uvj.y * 2.0);
        vec3  o   = ubo.cam_pos.xyz;
        vec3  d   = normalize(ubo.cam_fwd.xyz + ubo.cam_right.xyz * (ndc.x * ubo.cam_right.w) + ubo.cam_up.xyz * (ndc.y * ubo.cam_up.w));
        vec3  C   = vec3(0.0, -ubo.layer.z, 0.0);
        float R   = ubo.layer.z;
        vec3  sun = ubo.sun_dir.xyz;
        float mu  = dot(d, sun);
        // per-pixel, per-frame jitter for the march start
        float jit = fract(52.9829189 * fract(dot(gl_FragCoord.xy + float(ubo.frame % 8) * 5.588238, vec2(0.06711056, 0.00583715))));

        // ground
        vec2  tg = ray_sphere(o - C, d, R);
        bool  ground = tg.y > 0.0 && tg.x > 0.0;
        float t_ground = ground ? tg.x : 1e12;

        // sky behind everything
        vec4 sky = atmosphere(o, d, t_ground);
        vec3 bg  = sky.rgb;
        if (!ground) {{
            float sd = smoothstep(0.99985, 0.99995, mu);
            bg += vec3(1.0, 0.96, 0.9) * sd * sky.a * ubo.sun_dir.w * 0.5;
            // stars sit behind the air, so the haze thins them out
            bg += night_stars(d) * sky.a;
        }} else {{
            vec3  gp  = o + d * tg.x;
            vec3  up  = normalize(gp - C);
            vec3  up0 = normalize(o - C);
            float ch0 = length(o - C) - R;
            vec3  sc  = sun_light(gp);
            float sh  = ground_shadow(gp);
            // a wave shorter than a few pixels can only alias: cut the
            // spectrum at the pixel footprint and carry what is left as
            // surface roughness instead
            float fp   = max(tg.x * ubo.sea_b.z, 0.02);
            float kmax = 6.2831853 / (fp * 8.0);
            float fade = clamp(1.0 - tg.x / ubo.sea.w, 0.0, 1.0);
            vec3  disp = ocean_disp(gp.xz, ubo.sea.x, kmax);
            vec4  ndj  = ocean_ndj(gp.xz, ubo.sea.x, kmax);
            vec3  n    = normalize(mix(up, ndj.xyz, 0.35 + 0.65 * fade));
            vec3  V    = -d;
            // foam where the surface folds over itself, plus the wind
            // whipping the crests white
            // whitecaps break where the surface folds over itself, and
            // only once the wind is strong enough to tear the crests
            float wind_f = smoothstep(6.0, 16.0, ubo.sea_b.x);
            float foam = clamp((ubo.sea.z - ndj.w) * 1.6, 0.0, 1.0);
            float crest = smoothstep(0.95, 1.5, disp.y / max(ubo.sea_b.x * 0.16, 0.25));
            foam = clamp(foam + crest * 0.5, 0.0, 1.0) * wind_f;
            // break the sheet up so it never reads as paint
            vec3  fuv = vec3((gp.xz + ubo.world.xy) * 0.0037, ubo.wind.w * 0.006);
            float fn  = texture(detail, fuv).r * 0.5 + texture(detail, fuv * 5.3 + 0.37).g * 0.5;
            foam = clamp(foam * (0.15 + 1.5 * fn) - 0.12, 0.0, 1.0) * (0.3 + 0.7 * fade);
            float ndl = max(dot(n, sun), 0.0);
            float ndv = max(dot(n, V), 0.0);
            // Fresnel: at grazing angles the sea is a mirror
            float F = 0.02 + 0.98 * pow(1.0 - ndv, 5.0);
            // the true mirror direction: bending it toward the sky puts
            // the reflection out of line with the clouds it comes from
            vec3  Rd = reflect(d, n);
            if (dot(Rd, up) < 0.0004) Rd = normalize(Rd + up * (0.0004 - dot(Rd, up)));
            vec4  rc = cloud_reflect(gp, Rd);
            vec3  rf = rc.rgb + rc.a * (atmosphere(gp, Rd, 1e12).rgb + night_stars(Rd));
            // the sun's own reflection: a rough mirror lobe on the slopes
            vec3  H  = normalize(Rd + sun);
            // the waves we dropped still scatter: they widen the lobe
            float rough = mix(0.06, 0.22, clamp(ubo.sea_b.x / 20.0, 0.0, 1.0)) + clamp(fp * 0.01, 0.0, 0.22);
            float a2 = rough * rough * rough * rough;
            float dh = max(dot(n, normalize(V + sun)), 0.0);
            float dd = dh * dh * (a2 - 1.0) + 1.0;
            float spec = a2 / (3.14159265 * dd * dd);
            rf += sc * sh * spec * 0.6;
            // what comes back up out of the water: sky light scattered in
            // the top metres, greener where a crest is thin and lit
            vec3  deep = vec3(0.004, 0.016, 0.031);
            vec3  sss  = vec3(0.02, 0.10, 0.09) * (0.4 + 0.6 * clamp(disp.y * 0.35 + 0.5, 0.0, 1.0));
            vec3  skyl = atmosphere(gp, up, 1e12).rgb + vec3(0.016, 0.020, 0.034) * ubo.key_tint.w;
            vec3  wat  = deep * skyl * 6.0 + sss * (sc * sh * max(sun.y, 0.0) * 0.35 + skyl * 0.6);
            vec3  gc   = mix(wat, rf, F);
            // the sea has to sink into the sky just above the horizon,
            // or it ends at a hard line there. how far out the horizon
            // sits depends on how high we are, so the fade follows that
            // marine haze sits in a layer near the surface, so how much
            // of it a ray crosses depends on how steeply it looks down,
            // not just how far it goes: from up high the near sea stays
            // clear while the horizon still dissolves
            float up0d = max(-dot(d, up0), 1e-4);
            float hz_H = 1000.0;
            float tau  = (hz_H / up0d) * (1.0 - exp(-ch0 / hz_H)) * 1.0e-4;
            float wf   = 1.0 - exp(-tau);
            // the sky the sea has to match is the sky AT the horizon,
            // which sits BELOW horizontal by the dip angle — mirroring
            // the ray about the horizontal aimed too high and left a
            // one-pixel crease along the horizon line
            float dip  = sqrt(max(2.0 * ch0 / R, 1e-12));
            float ev   = dot(d, up0);
            vec3  hzd  = normalize(d + up0 * (max(ev, 0.0002 - dip) - ev));
            vec3  fogc = atmosphere(o, hzd, 1e12).rgb;
            // foam sits on top: lit by sun and sky, not a mirror
            vec3  fc   = (sc * sh * ndl * 0.30 + skyl * 0.85) * 0.55;
            gc = mix(gc, fc, foam);
            // the haze goes on AFTER the aerial perspective, or the far
            // sea ends up brighter than the sky it is dissolving into
            bg = mix(gc * sky.a + sky.rgb, fogc, wf);
        }}

        // the cloud layer shells
        float r1 = R + ubo.layer.x;
        float r2 = R + ubo.layer.y;
        vec2  ti = ray_sphere(o - C, d, r1);
        vec2  to = ray_sphere(o - C, d, r2);
        float rc = length(o - C);
        float t_start = -1.0;
        float t_end   = -1.0;
        if (rc < r1) {{
            if (!ground) {{ t_start = ti.y; t_end = to.y; }}
        }} else if (rc < r2) {{
            t_start = 0.0;
            t_end   = (ti.x > 0.0) ? ti.x : to.y;
        }} else {{
            if (to.x > 0.0) {{ t_start = to.x; t_end = (ti.x > 0.0) ? ti.x : to.y; }}
        }}
        if (ground) t_end = min(t_end, t_ground);
        t_end = min(t_end, t_start + ubo.march.z);

        vec3  col = vec3(0.0);
        float T   = 1.0;
        float depth = -1.0;
        float steps_taken = 0.0;
        if (t_start >= 0.0 && t_end > t_start) {{
            float fine   = (6.0 + t_start * 0.01) / ubo.march.x;
            float coarse = fine * 3.0;
            float t = t_start + jit * fine;
            bool  in_cloud = false;
            int   zeros = 0;
            vec3  sun_c = vec3(-1.0);
            vec3  amb_top = vec3(0.0);
            vec3  amb_bot = vec3(0.0);
            float sigma = ubo.light_b.w;
            float ga = ubo.light_a.x;
            for (int i = 0; i < 512; i++) {{
                if (t > t_end || T < 0.004) break;
                fine   = (6.0 + t * 0.01) / ubo.march.x;
                coarse = fine * 3.0;
                vec3  p = o + d * t;
                float h = height_frac(p);
                vec3  w = weather_at(p);
                steps_taken += 1.0;
                if (!in_cloud) {{
                    // outside an island: leap by the island distance field
                    float isd = texture(island, (p.xz + ubo.world.xy) / ubo.scales.w + 0.5).r * 255.0 - 1.5;
                    if (isd > 0.0) {{
                        float leap = isd * (ubo.scales.w / 256.0) / max(length(d.xz), 0.02);
                        t += max(leap, coarse);
                        continue;
                    }}
                    float dl = cloud_density(p, h, w, 1.0);
                    if (dl > 0.0) {{
                        in_cloud = true;
                        t = max(t - coarse, t_start);
                        continue;
                    }}
                    t += coarse;
                    continue;
                }}
                float dens = cloud_density(p, h, w, 0.0);
                // fade out toward the march cap so no cut face shows
                dens *= clamp((t_start + ubo.march.z - t) / 8000.0, 0.0, 1.0);
                if (dens <= 0.0) {{
                    zeros += 1;
                    if (zeros > 8) {{ in_cloud = false; zeros = 0; }}
                    t += fine;
                    continue;
                }}
                zeros = 0;
                if (sun_c.x < 0.0) {{
                    // lit once per pixel at the first cloud sample
                    sun_c   = sun_light(p);
                    vec3 upv = normalize(p - C);
                    amb_top = atmosphere(p, upv, 1e12).rgb + vec3(0.016, 0.020, 0.034) * ubo.key_tint.w;
                    amb_bot = sun_c * max(sun.y, 0.0) * 0.05 * vec3(0.30, 0.31, 0.33) + amb_top * 0.35;
                }}
                float ext = sigma;
                float od  = light_march(p) * ext;
                // Nubis in-scatter probability: dark edges, dark bottoms
                float ht = type_frac(p, w);
                float lod_d = cloud_density(p, h, w, 1.0);
                float depth_p = 0.05 + pow(clamp(lod_d, 0.0, 1.0), clamp(remap(ht, 0.3, 0.85, 0.5, 2.0), 0.5, 2.0));
                float vert_p  = pow(clamp(remap(ht, 0.07, 0.14, 0.1, 1.0), 0.1, 1.0), 0.8);
                // how much light reaches this point at all: it occludes
                // the sky ambient wherever we are deep in the cloud
                float occ     = depth_p * vert_p;
                // the dark-edge (powder) look only shows with the sun
                // behind us. backlit, a thin edge passes the sun straight
                // through while the thick middle stays dark: silver lining
                float inscat  = mix(1.0, occ, clamp(0.5 - mu * 0.5, 0.0, 1.0));
                // three octaves of multiple scattering (Wrenninge / Frostbite)
                vec3  direct = vec3(0.0);
                float oa = 1.0;
                float ob = 1.0;
                float oc = 1.0;
                for (int k = 0; k < 3; k++) {{
                    float ph = mix(hg(mu, ga * oc), hg(mu, -0.25 * oc), 0.3);
                    ph = max(ph, ubo.light_a.y * hg(mu, (0.99 - ubo.light_a.z) * oc));
                    direct += exp(-od * ob) * ph * oa;
                    oa *= ubo.light_b.x;
                    ob *= ubo.light_b.y;
                    oc *= ubo.light_b.z;
                }}
                direct *= sun_c * inscat;
                // ambient: the sky from above, the ground from below,
                // attenuated by the cloud still overhead — that is what
                // keeps a thick middle dark while its edges pass light
                float above = (1.0 - ht) * type_top(p, w) * lod_d;
                float amb_t = exp(-above * ext * 0.15);
                vec3  amb   = mix(amb_bot, amb_top, ht) * amb_t * ubo.light_a.w;
                vec3  S    = (direct + amb) * dens * ext;
                float e    = max(dens * ext, 1e-6);
                float Ts   = exp(-e * fine);
                col += T * (S - S * Ts) / e;
                T   *= Ts;
                if (depth < 0.0 && T < 0.5) depth = t;
                t += fine;
            }}
        }}
        if (depth < 0.0) depth = t_start;
        // aerial perspective: the air between us and the cloud
        if (T < 0.995 && depth > 0.0) {{
            vec4 ap = atmosphere(o, d, depth);
            col = col * ap.a + ap.rgb * (1.0 - T);
            // Nubis: the far band dissolves into the horizon haze
            float far = clamp((depth - 25000.0) / 40000.0, 0.0, 1.0);
            col = mix(col, bg * (1.0 - T), far);
        }}
        vec3 final = col + T * bg;

        if (ubo.view_mode == 1) final = vec3(1.0 - T);
        if (ubo.view_mode == 2) final = mix(vec3(0.0, 0.05, 0.3), vec3(1.0, 0.3, 0.0), steps_taken / 200.0);
        vec3 tm = (ubo.view_mode == 0) ? aces(final * ubo.cam_fwd.w) : clamp(final, 0.0, 1.0);
        // alpha carries the cloud depth for the temporal reprojection
        float dn = (depth > 0.0) ? clamp(depth / 60000.0, 0.0, 1.0) : 1.0;
        fragColor = vec4(pow(tm, vec3(1.0 / 2.2)), (ubo.jitter.z > 0.5) ? 1.0 : dn);
    }

# ---------------------------------------------------------------
# temporal upsampling: the half-res jittered pass accumulates into a
# full-res history reprojected by the camera rotation (Nubis 2015:
# a fraction of the pixels per frame, the rest reprojected)
# ---------------------------------------------------------------
enum TemporalSurface
    fresh   : 0
    history : 1

ModelViewProject TemporalCompose
    mutable cam_right  : vec4f    # w: tan(half fov) * aspect
    mutable cam_up     : vec4f    # w: tan(half fov)
    mutable cam_fwd    : vec4f
    mutable prev_right : vec4f
    mutable prev_up    : vec4f
    mutable prev_fwd   : vec4f
    mutable jitter     : vec4f    # xy: uv offset the fresh pass used, zw: fresh texel size
    mutable blend      : vec4f    # x: history weight, y: history valid
    mutable cam_pos    : vec4f
    mutable prev_pos   : vec4f

    attrib fresh   : LayoutBinding [ type:typeid[ TemporalSurface ], id: TemporalSurface.fresh,   count:1, format: typeid[ rgba8 ] ]
    attrib history : LayoutBinding [ type:typeid[ TemporalSurface ], id: TemporalSurface.history, count:1, format: typeid[ rgba8 ] ]

    attrib pos       : VertexInput    [ type:typeid[ vec3f ] ]
    attrib uv        : VertexInput    [ type:typeid[ vec2f ] ]
    attrib v_uv      : VertexOutput   [ type:typeid[ vec2f ] ]
    attrib fragColor : FragmentOutput [ type:typeid[ vec4f ] ]

    func init []
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    func vertex [] -> GLSL none {
        v_uv        = uv;
        gl_Position = vec4(pos.x, pos.y, 0.0, 1.0);
    }

    func fragment [] -> GLSL none {
        vec2  ndc = vec2(v_uv.x * 2.0 - 1.0, 1.0 - v_uv.y * 2.0);
        vec3  d   = normalize(ubo.cam_fwd.xyz + ubo.cam_right.xyz * (ndc.x * ubo.cam_right.w) + ubo.cam_up.xyz * (ndc.y * ubo.cam_up.w));
        // the fresh texel at uv holds the ray at uv + jitter: read back by it
        vec2  fuv = v_uv - ubo.jitter.xy;
        vec2  ts  = ubo.jitter.zw;
        vec4  f4  = texture(fresh, fuv);
        vec3  f   = f4.rgb;
        vec3  mn  = f;
        vec3  mx  = f;
        for (int j = -1; j <= 1; j++)
            for (int i = -1; i <= 1; i++) {{
                vec3 n = texture(fresh, fuv + vec2(float(i), float(j)) * ts).rgb;
                mn = min(mn, n);
                mx = max(mx, n);
            }}
        // where did this cloud point fall last frame (depth from the fresh alpha)
        vec3  wp = ubo.cam_pos.xyz + d * (f4.a * 60000.0);
        vec3  pd = normalize(wp - ubo.prev_pos.xyz);
        float pz = dot(pd, ubo.prev_fwd.xyz);
        vec3  out_c = f;
        if (pz > 0.0 && ubo.blend.y > 0.5) {{
            vec2 pn = vec2(dot(pd, ubo.prev_right.xyz) / (pz * ubo.prev_right.w), dot(pd, ubo.prev_up.xyz) / (pz * ubo.prev_up.w));
            vec2 puv = vec2(pn.x * 0.5 + 0.5, 0.5 - pn.y * 0.5);
            if (puv.x > 0.0 && puv.x < 1.0 && puv.y > 0.0 && puv.y < 1.0) {{
                vec3 h = texture(history, puv).rgb;
                vec3 e = (mx - mn) * 0.25 + 0.01;
                h = clamp(h, mn - e, mx + e);
                out_c = mix(h, f, ubo.blend.x);
            }}
        }}
        fragColor = vec4(out_c, 1.0);
    }

class WeatherState
    public name      : string
    public coverage  : f32
    public ctype     : f32
    public island    : f32
    public anvil     : f32
    public skew      : f32
    public density   : f32
    public detail    : f32
    public wind      : f32


# the cloudscape as an orbiter backdrop: the Nubis sky above a plain,
# orbiter's orbit steps pick the altitude (ground, under the base,
# above the tops), the angle steps the gaze; weather wanders on its
# own schedule
func nubis_bake []
    b : CloudBake [ ]
    b.hold[]
    b.run[]

func nubis_bake_version [] -> i32
    return 7

export func nubis_export []
    h1 : u64 [ @nubis_bake ]
    bv : i32 [ nubis_bake_version[] ]
    stamp : string '{h1}-{bv}'
    sp : path '../scenes/baked/nubis.hash'
    p1 : path '../scenes/baked/nubis-shape.png'
    p2 : path '../scenes/baked/nubis-detail.png'
    p3 : path '../scenes/baked/nubis-curl.png'
    p4 : path '../scenes/baked/nubis-weather.png'
    force : getenv[ 'SILVER_EXPORT_FORCE' ]
    if [ !force && sp.exists[] && p1.exists[] && p2.exists[] && p3.exists[] && p4.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            puts 'clouds: nubis noise set current'
            return
    nubis_bake[]
    sp.save[ stamp, null ]

element Clouds
    frost : true
    frost_sharp : true
    mutable sky        : NubisSky
    mutable vmodel     : Model
    mutable lowres     : Render
    mutable comp       : TemporalCompose
    mutable comp_model : Model
    mutable target     : Render
    mutable copy_model : Model
    mutable hist       : Render
    mutable tx_shape   : Texture
    mutable tx_detail  : Texture
    mutable tx_curl    : Texture
    mutable tx_weather : Texture
    mutable tx_tvar    : Texture
    mutable tx_island  : Texture
    mutable tx_stars   : Texture
    mutable wave_buf   : Buffer
    mutable wave_n     : i32
    mutable wave_wind  : f32 [ -1.0 ]
    mutable old_islands : vec Texture
    mutable wimg       : Image
    mutable states     : vec WeatherState
    mutable cur        : WeatherState
    mutable goal       : WeatherState
    mutable prev       : WeatherState
    mutable blend_t    : f32 [ 1.0 ]
    mutable next_change : f32 [ 45.0 ]
    mutable wseed      : u32 [ 7919 ]
    mutable preset     : i32 [ 2 ]
    mutable frame      : i32
    mutable last_us    : i64
    mutable seconds    : f32
    mutable yaw        : f32 [ -1.36 ]
    mutable cam_x      : f32
    mutable cam_z      : f32
    # ONE continuous clock: the sun and moon come from it and nothing
    # else ever moves them
    mutable tod        : f32 [ 18.15 ]
    mutable wtime      : f32
    mutable last_rw    : i32
    mutable last_rh    : i32
    mutable prev_right : vec4f
    mutable prev_up    : vec4f
    mutable prev_fwd   : vec4f
    mutable prev_pos   : vec4f
    mutable hist_valid : bool
    mutable isl_cov    : f32 [ -1.0 ]
    mutable isl_mix    : f32
    mutable isl_secs   : f32 [ -10.0 ]
    mutable edt_v      : vec i32
    mutable edt_z      : vec f32
    mutable edt_f      : vec f32
    mutable edt_d      : vec f32
    # eased camera: height m, pitch deg, vertical fov deg
    intern  c_h        : f32
    intern  c_p        : f32
    intern  c_f        : f32

    func sat [ v: f32 ] -> f32
        return (v < 0.0) ? 0.0 : ((v > 1.0) ? 1.0 : v)

    func remap [ v: f32, lo: f32, hi: f32, nlo: f32, nhi: f32 ] -> f32
        return nlo + ((v - lo) / (hi - lo)) * (nhi - nlo)

    func lerp_f [ x: f32, y: f32, t: f32 ] -> f32
        return x + (y - x) * t

    func rnd [] -> f32
        wseed = wseed * 1664525 + 1013904223
        return f32[ wseed >> 8 ] / 16777216.0

    func make_states []
        states = vec WeatherState []
        states += WeatherState [ name: 'clear, a few cumulus', coverage: 0.4, ctype: 0.85, island: 0.8, anvil: 0.0, skew: 300.0, density: 1.0, detail: 0.3, wind: 6.0 ]
        states += WeatherState [ name: 'fair weather cumulus',  coverage: 0.62, ctype: 0.8, island: 0.5, anvil: 0.1, skew: 500.0, density: 1.0, detail: 0.32, wind: 8.0 ]
        states += WeatherState [ name: 'stratocumulus sheet',   coverage: 0.85, ctype: 0.45, island: 0.2, anvil: 0.0, skew: 400.0, density: 1.1, detail: 0.28, wind: 10.0 ]
        states += WeatherState [ name: 'overcast stratus',      coverage: 0.97, ctype: 0.08, island: 0.0, anvil: 0.0, skew: 200.0, density: 1.4, detail: 0.22, wind: 5.0 ]
        states += WeatherState [ name: 'heavy cumulus',         coverage: 0.62, ctype: 0.9, island: 0.4, anvil: 1.0, skew: 900.0, density: 1.3, detail: 0.3, wind: 18.0 ]
        states += WeatherState [ name: 'sunset towers',         coverage: 0.45, ctype: 0.95, island: 0.7, anvil: 0.4, skew: 600.0, density: 1.0, detail: 0.3, wind: 7.0 ]

    func copy_state [ s: WeatherState ] -> WeatherState
        return WeatherState [ name: s.name, coverage: s.coverage, ctype: s.ctype, island: s.island,
            anvil: s.anvil, skew: s.skew, density: s.density, detail: s.detail, wind: s.wind ]

    # the weather scheduler: a new state by chance, blended over seconds
    func schedule []
        nx : i32 [ i32[ rnd[] * f32[ states.count ] ] ]
        if [ nx >= states.count ] nx = states.count - 1
        if [ nx == preset ] nx = (nx + 1) % states.count
        preset = nx
        prev = copy_state[ cur ]
        prev.hold[]
        goal = copy_state[ states[ nx ] ]
        goal.hold[]
        blend_t = 0.0
        next_change = seconds + 40.0 + rnd[] * 40.0

    # JONSWAP: the deep-water frequency spectrum for a wind of U over a
    # fetch of F metres (Hasselmann 1973, as used by Arc Blanc 2025)
    func omega_p [ wind: f32 ] -> f32
        U : f32 [ (wind < 0.5) ? 0.5 : wind ]
        return 22.0 * pow[ 9.81 * 9.81 / (U * 100000.0), 0.33333 ]

    func jonswap [ om: f32, wind: f32 ] -> f32
        U : f32 [ (wind < 0.5) ? 0.5 : wind ]
        al : f32 [ 0.076 * pow[ U * U / (100000.0 * 9.81), 0.22 ] ]
        omp : f32 [ omega_p[ wind ] ]
        sg : f32 [ (om <= omp) ? 0.07 : 0.09 ]
        dd : f32 [ om - omp ]
        r : f32 [ exp[ 0.0 - dd * dd / (2.0 * sg * sg * omp * omp) ] ]
        return al * 9.81 * 9.81 / pow[ om, 5.0 ] * exp[ 0.0 - 1.25 * pow[ omp / om, 4.0 ] ] * pow[ 3.3, r ]

    # Donelan-Banner directional spreading: how tightly the waves of a
    # given frequency hold the wind's direction
    func db_beta [ rw: f32 ] -> f32
        if [ rw < 0.95 ] return 2.61 * pow[ rw, 1.3 ]
        if [ rw < 1.6 ]  return 2.28 * pow[ rw, 0.0 - 1.3 ]
        eps : f32 [ 0.8393 * exp[ 0.0 - 0.567 * log[ rw * rw ] ] - 0.4 ]
        return pow[ 10.0, eps ]

    func sech2 [ x: f32 ] -> f32
        ax : f32 [ (x < 0.0) ? 0.0 - x : x ]
        if [ ax > 12.0 ] return 0.0
        e : f32 [ exp[ ax ] ]
        c : f32 [ (e + 1.0 / e) * 0.5 ]
        return 1.0 / (c * c)

    func tanh_f [ x: f32 ] -> f32
        if [ x > 12.0 ] return 1.0
        e : f32 [ exp[ 2.0 * x ] ]
        return (e - 1.0) / (e + 1.0)

    # sample the spectrum into Gerstner components, longest wave first
    # so a distant pixel can use a prefix of the list
    func build_waves [ wind: f32 ]
        NK : i32 [ 40 ]
        ND : i32 [ 3 ]
        n : i32 [ NK * ND ]
        if [ !wave_buf ]
            wave_buf = Buffer [ vk: vk, size: i64[ n ] * 16,
                u_storage: true, m_host_visible: true, m_host_coherent: true ]
            wave_buf.hold[]
        wd : @f32 [ wave_buf.data ]
        th0 : f32 [ atan2[ 0.6, 0.8 ] ]
        lmin : f32 [ 1.6 ]
        lmax : f32 [ 780.0 ]
        omp : f32 [ omega_p[ wind ] ]
        idx : i32 [ 0 ]
        for [ i: i32 0, i < NK, i += 1 ]
            f0 : f32 [ f32[ i ] / f32[ NK ] ]
            f1 : f32 [ f32[ i + 1 ] / f32[ NK ] ]
            l0 : f32 [ lmax * pow[ lmin / lmax, f0 ] ]
            l1 : f32 [ lmax * pow[ lmin / lmax, f1 ] ]
            lm : f32 [ sqrt[ l0 * l1 ] ]
            k : f32 [ 6.2831853 / lm ]
            om : f32 [ sqrt[ 9.81 * k ] ]
            om0 : f32 [ sqrt[ 9.81 * 6.2831853 / l0 ] ]
            om1 : f32 [ sqrt[ 9.81 * 6.2831853 / l1 ] ]
            dom : f32 [ om1 - om0 ]
            S : f32 [ jonswap[ om, wind ] ]
            bs : f32 [ db_beta[ om / omp ] ]
            qn : f32 [ 1.0 / tanh_f[ bs * 3.14159265 ] ]
            sp : f32 [ 3.2 / bs ]
            if [ sp > 3.14159265 ] sp = 3.14159265
            dth : f32 [ sp / f32[ ND ] ]
            for [ j: i32 0, j < ND, j += 1 ]
                u : f32 [ (f32[ j ] + rnd[]) / f32[ ND ] ]
                th : f32 [ (u - 0.5) * sp ]
                D : f32 [ 0.5 * bs * sech2[ bs * th ] * qn ]
                A : f32 [ sqrt[ 2.0 * S * D * dom * dth ] ]
                wd[ idx * 4 ]     = k * cos[ th0 + th ]
                wd[ idx * 4 + 1 ] = k * sin[ th0 + th ]
                wd[ idx * 4 + 2 ] = A
                wd[ idx * 4 + 3 ] = rnd[] * 6.2831853
                idx += 1
        wave_n = idx
        wave_wind = wind

    func load_texture [ p: path, depth: i32 ] -> Texture
        expect p.exists[], 'baked noise missing: {p}'
        im : Image [ uri: p, linear: true, wrap_u: true, wrap_v: true ]
        im.hold[]
        tx : Texture [ vk: vk, w: ux, sampler: im, depth: depth, mip_levels: 1, linear: true, wrap_u: true, wrap_v: true ]
        tx.hold[]
        return tx

    # 1D squared distance transform (Felzenszwalb-Huttenlocher)
    func edt1d [ n: i32 ]
        k : i32 [ 0 ]
        edt_v[ 0 ] = 0
        edt_z[ 0 ] = -1e20
        edt_z[ 1 ] = 1e20
        for [ q: i32 1, q < n, q += 1 ]
            fq : f32 [ f32[ q ] ]
            s : f32 [ 0.0 ]
            while [ true ]
                vi : i32 [ edt_v[ k ] ]
                fv : f32 [ f32[ vi ] ]
                s = ((edt_f[ q ] + fq * fq) - (edt_f[ vi ] + fv * fv)) / (2.0 * fq - 2.0 * fv)
                if [ s <= edt_z[ k ] && k > 0 ]
                    k = k - 1
                el
                    break
            k += 1
            edt_v[ k ] = q
            edt_z[ k ] = s
            edt_z[ k + 1 ] = 1e20
        k = 0
        for [ q: i32 0, q < n, q += 1 ]
            fq : f32 [ f32[ q ] ]
            while [ edt_z[ k + 1 ] < fq ] k += 1
            vi : i32 [ edt_v[ k ] ]
            fv : f32 [ f32[ vi ] ]
            edt_d[ q ] = (fq - fv) * (fq - fv) + edt_f[ vi ]

    # the island map: where the weather field, thresholded by the
    # current coverage, has cloud. distance in cells, wrapped
    func build_island []
        N : i32 [ 256 ]
        if [ !edt_v ]
            edt_v = vec i32 [ N * 3 + 2 ]
            edt_z = vec f32 [ N * 3 + 2 ]
            edt_f = vec f32 [ N * 3 ]
            edt_d = vec f32 [ N * 3 ]
        wd : @u8 [ wimg.vdata[] ]
        ww : i32 [ wimg.width ]
        c  : f32 [ cur.coverage ]
        mask : vec f32 [ N * N ]
        for [ y: i32 0, y < N, y += 1 ]
            for [ x: i32 0, x < N, x += 1 ]
                inside : bool [ false ]
                # max over the 2x2 source pixels: conservative
                for [ sy: i32 0, sy < 2, sy += 1 ]
                    for [ sx: i32 0, sx < 2, sx += 1 ]
                        px : i32 [ (x * 2 + sx) % ww ]
                        py : i32 [ (y * 2 + sy) % ww ]
                        i : i32 [ (py * ww + px) * 4 ]
                        r : f32 [ f32[ wd[ i ] ] / 255.0 ]
                        g : f32 [ f32[ wd[ i + 1 ] ] / 255.0 ]
                        fr : f32 [ sat[ remap[ r, 0.30, 0.72, 0.0, 1.0 ] ] ]
                        fg : f32 [ sat[ remap[ g, 0.0, 0.5, 0.0, 1.0 ] ] ]
                        field : f32 [ fr + (fg - fr) * cur.island ]
                        cov : f32 [ sat[ remap[ field, 1.0 - c, 1.0 - c + 0.35, 0.0, 1.0 ] ] ]
                        if [ cov > 0.002 ] inside = true
                mask[ y * N + x ] = (inside) ? 0.0 : 1e10
        # rows, tripled for the wrap
        for [ y: i32 0, y < N, y += 1 ]
            for [ x: i32 0, x < N * 3, x += 1 ] edt_f[ x ] = mask[ y * N + (x % N) ]
            edt1d[ N * 3 ]
            for [ x: i32 0, x < N, x += 1 ] mask[ y * N + x ] = edt_d[ N + x ]
        # columns
        for [ x: i32 0, x < N, x += 1 ]
            for [ y: i32 0, y < N * 3, y += 1 ] edt_f[ y ] = mask[ (y % N) * N + x ]
            edt1d[ N * 3 ]
            for [ y: i32 0, y < N, y += 1 ] mask[ y * N + x ] = edt_d[ N + y ]
        im : Image [ width: N, height: N, format: Pixel.rgba8, linear: true, wrap_u: true, wrap_v: true ]
        im.hold[]
        d : @u8 [ im.vdata[] ]
        for [ i: i32 0, i < N * N, i += 1 ]
            dist : f32 [ sqrt[ mask[ i ] ] ]
            if [ dist > 255.0 ] dist = 255.0
            d[ i * 4 ]     = u8[ i32[ dist ] ]
            d[ i * 4 + 1 ] = u8[ i32[ dist ] ]
            d[ i * 4 + 2 ] = u8[ i32[ dist ] ]
            d[ i * 4 + 3 ] = u8[ 255 ]
        if [ tx_island ]
            if [ !old_islands ] old_islands = vec Texture []
            old_islands += tx_island
        tx_island = Texture [ vk: vk, w: ux, sampler: im, mip_levels: 1, linear: true, wrap_u: true, wrap_v: true ]
        tx_island.hold[]
        isl_cov   = c
        isl_mix   = cur.island
        isl_secs  = seconds

    func create_target []
        if [ target ] return
        make_states[]
        cur = copy_state[ states[ preset ] ]
        cur.hold[]
        goal = states[ preset ]
        prev = copy_state[ cur ]
        prev.hold[]
        p1 : path '../scenes/baked/nubis-shape.png'
        if [ !p1.exists[] ]
            puts 'clouds: no baked noise — baking live (SILVER_EXPORT=1 bakes at build)'
            nubis_bake[]
        tx_shape   = load_texture[ path '../scenes/baked/nubis-shape.png', 128 ]
        tx_detail  = load_texture[ path '../scenes/baked/nubis-detail.png', 32 ]
        tx_curl    = load_texture[ path '../scenes/baked/nubis-curl.png', 1 ]
        tx_weather = load_texture[ path '../scenes/baked/nubis-weather.png', 1 ]
        tx_tvar    = load_texture[ path '../scenes/baked/nubis-tops.png', 1 ]
        tx_stars   = load_texture[ path '../scenes/textures/gaia.png', 1 ]
        wimg = Image [ uri: path '../scenes/baked/nubis-weather.png', linear: true ]
        wimg.hold[]
        build_island[]
        build_waves[ cur.wind ]
        sky = NubisSky [ vk: vk, name: 'nubis-sky' ]
        sky.hold[]
        smp : map Au[string] [ 'shape': tx_shape, 'detail': tx_detail, 'curl': tx_curl, 'weather': tx_weather, 'island': tx_island, 'tvar': tx_tvar, 'waves': wave_buf, 'stars': tx_stars ]
        vmodel = Model [ vk: vk, w: ux, s: sky, samplers: smp ]
        vmodel.hold[]
        lowres = Render [ vk: vk, w: ux, wscale: 0.5, tag: 'nubis-low',
            clear_color: vec4f [ 0.0, 0.0, 0.0, 1.0 ], models: [ vmodel ] ]
        lowres.hold[]
        # history = a copy of last frame's target, taken before the compose
        hist = Render [ vk: vk, w: ux, wscale: 1.0, tag: 'nubis-hist', clear_color: vec4f [ 0.0, 0.0, 0.0, 1.0 ] ]
        hist.hold[]
        comp = TemporalCompose [ vk: vk, name: 'nubis-temporal' ]
        comp.hold[]
        comp_model = Model [ vk: vk, w: ux, s: comp, samplers: map Au[string] [ 'fresh': lowres.color, 'history': hist.color ] ]
        comp_model.hold[]
        target = Render [ vk: vk, w: ux, wscale: 1.0, tag: 'nubis',
            clear_color: vec4f [ 0.0, 0.0, 0.0, 1.0 ], models: [ comp_model ] ]
        target.hold[]
        copy_model = Model [ w: ux, samplers: map Au[string] [ 'color': target.color ] ]
        copy_model.hold[]
        hist.models = vec Model [] [ copy_model ]
        copy_model.finish[ hist, 0 ]
        target.owner = a
        ux.element_targets[ id ] = target

    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    func draw [ w: Window ]
        animated = true
        create_target[]
        now : i64 [ epoch_micros[] ]
        dt : f32 [ 0.0 ]
        if [ last_us > 0 ] dt = f32[ now - last_us ] / 1000000.0
        if [ dt > 1.0 ] dt = 1.0
        last_us = now
        seconds += dt
        frame += 1
        yaw += dt * 0.012
        # the speed steps fly us forward through the clouds; the same
        # factor runs the wind. time_scale is 1/64 subtle .. 4 ludicrous
        ts4 : f32 [ ux.time_scale * 4.0 ]
        wtime += dt * ts4
        spd : f32 [ 140.0 * ts4 ]
        cam_x += sin[ yaw ] * spd * dt
        cam_z += cos[ yaw ] * spd * dt
        # the day runs once, slowly, in wall-clock time: the speed steps
        # move us through the world, never through the day
        tod += dt * (24.0 / 2400.0)
        if [ tod >= 24.0 ] tod -= 24.0
        if [ seconds > next_change ] schedule[]
        if [ blend_t < 1.0 ]
            blend_t += dt / 12.0
            if [ blend_t > 1.0 ] blend_t = 1.0
            t : f32 [ blend_t * blend_t * (3.0 - 2.0 * blend_t) ]
            cur.coverage = lerp_f[ prev.coverage, goal.coverage, t ]
            cur.ctype    = lerp_f[ prev.ctype,    goal.ctype,    t ]
            cur.island   = lerp_f[ prev.island,   goal.island,   t ]
            cur.anvil    = lerp_f[ prev.anvil,    goal.anvil,    t ]
            cur.skew     = lerp_f[ prev.skew,     goal.skew,     t ]
            cur.density  = lerp_f[ prev.density,  goal.density,  t ]
            cur.detail   = lerp_f[ prev.detail,   goal.detail,   t ]
            cur.wind     = lerp_f[ prev.wind,     goal.wind,     t ]
        # the island map follows the weather blend, a few times a second
        dc : f32 [ cur.coverage - isl_cov ]
        dm : f32 [ cur.island - isl_mix ]
        if [ dc < 0.0 ] dc = 0.0 - dc
        if [ dm < 0.0 ] dm = 0.0 - dm
        if [ (dc > 0.01 || dm > 0.02) && seconds - isl_secs > 0.25 ]
            build_island[]
            vmodel.samplers[ 'island' ] = tx_island
            vmodel.rebind_model[]
        # a resize rebuilt the attachments: rebind the chain
        rw9 : i32 [ i32[ ux.width ] ]
        rh9 : i32 [ i32[ ux.height ] ]
        lowres.update[]
        hist.update[]
        if [ rw9 != last_rw || rh9 != last_rh ]
            last_rw = rw9
            last_rh = rh9
            comp_model.samplers[ 'fresh' ]   = lowres.color
            comp_model.samplers[ 'history' ] = hist.color
            comp_model.rebind_model[]
            copy_model.samplers[ 'color' ] = target.color
            copy_model.rebind_model[]
            hist_valid = false
        # orbit steps: on the ground, under the cloud base, above the tops,
        # wide on the ground. angle steps swing the gaze up (or down from above)
        above : bool [ ux.orbit_mode == OrbitView.far ]
        h_t : f32 [ (ux.orbit_mode == OrbitView.low)  ? 400.0 :
                    (ux.orbit_mode == OrbitView.high) ? 1150.0 :
                    (above) ? 5200.0 : 400.0 ]
        p_t : f32 [ (above) ? ((ux.angle_mode == ViewAngle.flat) ? -4.0 : (ux.angle_mode == ViewAngle.angled) ? -22.0 : -55.0)
                            : ((ux.angle_mode == ViewAngle.flat) ? 8.0 : (ux.angle_mode == ViewAngle.angled) ? 32.0 : 65.0) ]
        f_t : f32 [ (ux.orbit_mode == OrbitView.wide) ? 95.0 : 60.0 ]
        if [ c_f == 0.0 ]
            c_p = p_t
            c_h = h_t
            c_f = f_t
        c_p = filter_n[ c_p, p_t, 0.06, ux.frame_factor ]
        c_h = filter_n[ c_h, h_t, 0.06, ux.frame_factor ]
        c_f = filter_n[ c_f, f_t, 0.06, ux.frame_factor ]
        ux.orbit_moving = abs[ c_p - p_t ] > 0.02 || abs[ c_h - h_t ] > 0.5 || abs[ c_f - f_t ] > 0.05
        pitch : f32 [ radians[ c_p ] ]
        cp : f32 [ cos[ pitch ] ]
        fx : f32 [ cp * sin[ yaw ] ]
        fy : f32 [ sin[ pitch ] ]
        fz : f32 [ cp * cos[ yaw ] ]
        rx : f32 [ 0.0 - fz ]
        rz : f32 [ fx ]
        rl : f32 [ sqrt[ rx * rx + rz * rz ] ]
        if [ rl < 0.0001 ] rl = 0.0001
        rx = rx / rl
        rz = rz / rl
        ux2 : f32 [ 0.0 - rz * fy ]
        uy2 : f32 [ rz * fx - rx * fz ]
        uz2 : f32 [ rx * fy ]
        th : f32 [ tan[ radians[ c_f * 0.5 ] ] ]
        aspect : f32 [ (rh9 > 0) ? f32[ rw9 ] / f32[ rh9 ] : 1.778 ]
        sky.cam_pos   = vec4f [ 0.0, c_h, 0.0, 0.0 ]
        sky.cam_right = vec4f [ rx, 0.0, rz, th * aspect ]
        sky.cam_up    = vec4f [ ux2, uy2, uz2, th ]
        sky.cam_fwd   = vec4f [ fx, fy, fz, 0.9 ]
        # sun and moon from the one clock: hour angle, a fixed latitude
        # and declination. the moon rides half a day behind the sun
        H : f32 [ (tod - 12.0) * 0.2617994 ]
        lat : f32 [ 0.35 ]
        dec : f32 [ 0.20 ]
        sel : f32 [ asin[ sin[ lat ] * sin[ dec ] + cos[ lat ] * cos[ dec ] * cos[ H ] ] ]
        saz : f32 [ atan2[ 0.0 - sin[ H ] * cos[ dec ], cos[ lat ] * sin[ dec ] - sin[ lat ] * cos[ dec ] * cos[ H ] ] ]
        Hm : f32 [ H + 3.14159265 ]
        mdec : f32 [ 0.0 - dec ]
        mel : f32 [ asin[ sin[ lat ] * sin[ mdec ] + cos[ lat ] * cos[ mdec ] * cos[ Hm ] ] ]
        maz : f32 [ atan2[ 0.0 - sin[ Hm ] * cos[ mdec ], cos[ lat ] * sin[ mdec ] - sin[ lat ] * cos[ mdec ] * cos[ Hm ] ] ]
        # ONE key light, handed over cleanly: the sun fades to nothing as
        # it sets, and only then does the moon fade in. swapping the
        # direction while the light still had strength lit the whole
        # scene from the moon's angle at half sun power
        sfade : f32 [ sat[ (0.0 - sel - 0.005) / 0.09 ] ]
        mfade : f32 [ sat[ (0.0 - sel - 0.10) / 0.09 ] ]
        kel : f32 [ sel ]
        kaz : f32 [ saz ]
        pw : f32 [ 22.0 * (1.0 - sfade) ]
        if [ mfade > 0.0 ]
            kel = mel
            kaz = maz
            pw  = 1.30 * mfade
        se : f32 [ cos[ kel ] ]
        sky.sun_dir   = vec4f [ se * sin[ kaz ], sin[ kel ], se * cos[ kaz ], pw ]
        # moonlight is silver: cool, and it keeps the clouds readable
        sky.key_tint  = vec4f [ 1.0 - 0.30 * mfade, 1.0 - 0.16 * mfade, 1.0, sfade ]
        sky.world     = vec4f [ cam_x, cam_z, 0.0, 0.0 ]
        sky.wind      = vec4f [ cur.wind * 0.8, 0.0, cur.wind * 0.6, wtime ]
        sky.layer     = vec4f [ 1500.0, 6000.0, 6371000.0, 6471000.0 ]
        sky.tops      = vec4f [ 1100.0, 1800.0, 3000.0, 0.0 ]
        sky.weather_a = vec4f [ cur.coverage, cur.ctype, 1.0, cur.island ]
        sky.weather_b = vec4f [ 0.6, cur.skew, cur.density, cur.detail ]
        sky.light_a   = vec4f [ 0.6, 1.4, 0.18, 1.0 ]
        sky.light_b   = vec4f [ 0.4, 0.75, 0.5, 0.016 ]
        sky.scales    = vec4f [ 6000.0, 650.0, 3000.0, 60000.0 ]
        sky.march     = vec4f [ 2.0, 1.0, 60000.0, 1.0 / 45000.0 ]
        # the sea state follows the wind: rebuild when it has moved
        dw : f32 [ cur.wind - wave_wind ]
        if [ dw < 0.0 ] dw = 0.0 - dw
        if [ dw > 0.5 ] build_waves[ cur.wind ]
        sky.sea       = vec4f [ f32[ wave_n ], 1.15, 0.55, 12000.0 ]
        sky.view_mode = 0
        sky.frame     = frame
        sky.time      = wtime
        ph : i32 [ frame % 4 ]
        ox : f32 [ ((ph & 1) == 0) ? -0.25 : 0.25 ]
        oy : f32 [ ((ph & 2) == 0) ? -0.25 : 0.25 ]
        lw : f32 [ f32[ lowres.width ] ]
        lh : f32 [ f32[ lowres.height ] ]
        jx : f32 [ ox / lw ]
        jy : f32 [ oy / lh ]
        sky.jitter = vec4f [ jx, jy, 0.0, 0.0 ]
        # sea_b.z = the angle one pixel covers: the wave LOD works off it
        sky.sea_b  = vec4f [ cur.wind, 1.0, 2.0 * th / lh, tod / 24.0 ]
        # last frame's target becomes the history, then the fresh pass
        if [ hist_valid ]
            hist.draw[]
            hist.sync_fence[]
        lowres.draw[]
        lowres.sync_fence[]
        comp.cam_right  = sky.cam_right
        comp.cam_up     = sky.cam_up
        comp.cam_fwd    = sky.cam_fwd
        comp.prev_right = prev_right
        comp.prev_up    = prev_up
        comp.prev_fwd   = prev_fwd
        comp.jitter     = vec4f [ jx, jy, 1.0 / lw, 1.0 / lh ]
        comp.blend      = vec4f [ 0.2, (hist_valid) ? 1.0 : 0.0, 0.0, 0.0 ]
        comp.cam_pos    = sky.cam_pos
        comp.prev_pos   = prev_pos
        prev_right = sky.cam_right
        prev_up    = sky.cam_up
        prev_fwd   = sky.cam_fwd
        prev_pos   = sky.cam_pos
        hist_valid = true
        target.update[]

    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#080a1acc',   # editor pane background
            '#140a2a80':  '#0e1c2e80',   # console pane background
            '#ff6a2e55':  '#4aa0e855',   # search highlight fill
            '#220022aa':  '#0a1826aa',   # run console base fill
            '#614':       '#1f3a52',     # TButtons / nav rest fill
            '#413':       '#16283a',     # TButtons hover fill
            '#826':       '#2f5a80',     # TButtons lit / nav selected
            '#625a':      '#2a4a6a',     # bottom status bar fill
            '#8af2':      '#aed6f2',     # status bar inner glow
            '#425':       '#18304a',     # editor selection color
            '#ede3':      '#d8ecf6',     # editor selection border
            '#44225588':  '#1c3a5288',   # editor line highlight
            '#ff3a6a22':  '#4aa0e822',   # commit tab fill
            '#ff3a6a44':  '#4aa0e844',   # commit tab hover fill
            '#ff5a8a99':  '#6ab4f299',   # commit tab border
            '#ff7aa4cc':  '#9ad0ffcc'    # commit tab hover border
        ]
