extend ai

import <sys/stat.h>

# gpu tensors; kernels read addresses from push constants

# push constants: 6 addresses, 12 ints, 4 floats
func grad_header [] -> string
    return '#version 460\n#extension GL_EXT_buffer_reference : require\n#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require\nlayout(buffer_reference, std430, buffer_reference_align = 4) buffer F {{ float v[]; }};\nlayout(push_constant) uniform P {{ uint64_t a0; uint64_t a1; uint64_t a2; uint64_t a3; uint64_t a4; uint64_t a5; int n0; int n1; int n2; int n3; int n4; int n5; int n6; int n7; int n8; int n9; int n10; int n11; float f0; float f1; float f2; float f3; }} p;\n'

# decl goes before main, compute is main's body
class GKern
    public lx : i32 [ 256 ]
    public ly : i32 [ 1 ]
    func decl [] -> GLSL none {}
    func compute [] -> GLSL none {}

GKern KAxpby
    func compute [] -> GLSL none {
         uint i = gl_GlobalInvocationID.x; if (i >= uint(p.n0)) return; F x = F(p.a0); F y = F(p.a1); y.v[i] = p.f0 * x.v[i] + p.f1 * y.v[i];
    }

GKern KRegroup
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x; uint B = uint(p.n0); uint Cc = uint(p.n1); uint T = uint(p.n2);
        if (i >= B * Cc * T) return;
        uint b = i / (Cc * T); uint r = i - b * Cc * T; uint c = r / T; uint t = r - c * T;
        F s = F(p.a0); F d = F(p.a1);
        uint cbt = c * B * T + b * T + t;
        if (p.n3 == 0) {{ d.v[cbt] = s.v[i]; return; }}
        float v = s.v[cbt];
        if (p.a2 != 0ul) v += F(p.a2).v[c];
        d.v[i] = ((p.f0 != 0.0) ? p.f0 * d.v[i] : 0.0) + v;
    }

GKern KRowSums
    func decl [] -> GLSL none {
        shared float part[256];
    }
    func compute [] -> GLSL none {
        uint r = gl_WorkGroupID.x; uint l = gl_LocalInvocationID.x; uint N = uint(p.n1);
        F m = F(p.a0); F d = F(p.a1);
        float s = 0.0;
        for (uint j = l; j < N; j += 256u) s += m.v[r * N + j];
        part[l] = s; barrier();
        for (uint w = 128u; w > 0u; w >>= 1) {{ if (l < w) part[l] += part[l + w]; barrier(); }}
        if (l == 0u) d.v[r] += part[0];
    }

GKern KIm2col
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x;
        uint B = uint(p.n0); uint Ci = uint(p.n1); uint T = uint(p.n2); uint K = uint(p.n3); int S = p.n4; int P = p.n5; int D = p.n6; uint To = uint(p.n8);
        uint BT = B * To;
        if (i >= Ci * K * BT) return;
        uint row = i / BT; uint col = i - row * BT;
        uint c = row / K; uint kk = row - c * K;
        uint b = col / To; uint to = col - b * To;
        int t = int(to) * S - P + int(kk) * D;
        F x = F(p.a0); F o = F(p.a1);
        o.v[i] = (t >= 0 && t < int(T)) ? x.v[(b * Ci + c) * T + uint(t)] : 0.0;
    }

GKern KCol2im
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x;
        uint B = uint(p.n0); uint Ci = uint(p.n1); uint T = uint(p.n2); uint K = uint(p.n3); int S = p.n4; int P = p.n5; int D = p.n6; uint To = uint(p.n8);
        if (i >= B * Ci * T) return;
        uint b = i / (Ci * T); uint r = i - b * Ci * T; uint c = r / T; int t = int(r - c * T);
        F dc = F(p.a0); F dx = F(p.a1);
        uint BT = B * To; float s = 0.0;
        for (uint kk = 0u; kk < K; kk++) {{
          int q = t + P - int(kk) * D;
          if (q < 0 || q % S != 0) continue;
          int to = q / S;
          if (to >= int(To)) continue;
          s += dc.v[(c * K + kk) * BT + b * To + uint(to)];
        }}
        dx.v[i] += s;
    }

GKern KConvtGather
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x;
        uint B = uint(p.n0); uint Co = uint(p.n1); uint T = uint(p.n2); uint K = uint(p.n3); int S = p.n4; int P = p.n5; uint To = uint(p.n8);
        if (i >= B * Co * To) return;
        uint b = i / (Co * To); uint r = i - b * Co * To; uint c = r / To; int to = int(r - c * To);
        F cl = F(p.a0); F y = F(p.a1);
        float s = (p.a2 != 0ul) ? F(p.a2).v[c] : 0.0;
        uint BT = B * T;
        for (uint kk = 0u; kk < K; kk++) {{
          int q = to + P - int(kk);
          if (q < 0 || q % S != 0) continue;
          int t = q / S;
          if (t >= int(T)) continue;
          s += cl.v[(c * K + kk) * BT + b * T + uint(t)];
        }}
        y.v[i] = s;
    }

GKern KIm2colT
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x;
        uint B = uint(p.n0); uint Co = uint(p.n1); uint To = uint(p.n2); uint K = uint(p.n3); int S = p.n4; int P = p.n5; uint T = uint(p.n8);
        uint BT = B * T;
        if (i >= Co * K * BT) return;
        uint row = i / BT; uint col = i - row * BT;
        uint c = row / K; uint kk = row - c * K;
        uint b = col / T; uint t = col - b * T;
        int to = int(t) * S - P + int(kk);
        F dy = F(p.a0); F o = F(p.a1);
        o.v[i] = (to >= 0 && to < int(To)) ? dy.v[(b * Co + c) * To + uint(to)] : 0.0;
    }

GKern KUnary
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x; if (i >= uint(p.n0)) return;
        F x = F(p.a0); F y = F(p.a1); float v = x.v[i]; float r = v;
        if (p.n1 == 1) r = (v >= 0.0) ? v : p.f0 * v;
        else if (p.n1 == 2) r = tanh(v);
        else if (p.n1 == 3) r = 1.0 / (1.0 + exp(-v));
        else if (p.n1 == 4) r = exp(v);
        else if (p.n1 == 5) r = p.f0 * v;
        else if (p.n1 == 6) {{
            float z = v * 0.70710678; float sg = (z < 0.0) ? -1.0 : 1.0; float az = abs(z);
            float t = 1.0 / (1.0 + 0.3275911 * az);
            float e = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp(-az * az);
            r = 0.5 * v * (1.0 + sg * e);
        }}
        y.v[i] = r;
    }

GKern KUnaryBack
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x; if (i >= uint(p.n0)) return;
        F x = F(p.a0); F y = F(p.a1); F dy = F(p.a2); F dx = F(p.a3);
        float v = x.v[i]; float o = y.v[i]; float d = 1.0;
        if (p.n1 == 1) d = (v >= 0.0) ? 1.0 : p.f0;
        else if (p.n1 == 2) d = 1.0 - o * o;
        else if (p.n1 == 3) d = o * (1.0 - o);
        else if (p.n1 == 4) d = o;
        else if (p.n1 == 5) d = p.f0;
        else if (p.n1 == 6) {{
            float z = v * 0.70710678; float sg = (z < 0.0) ? -1.0 : 1.0; float az = abs(z);
            float t = 1.0 / (1.0 + 0.3275911 * az);
            float e = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * exp(-az * az);
            d = 0.5 * (1.0 + sg * e) + v * 0.3989422804 * exp(-0.5 * v * v);
        }}
        dx.v[i] += dy.v[i] * d;
    }

GKern KBin
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x; uint C = uint(p.n1); uint T = uint(p.n2);
        if (i >= uint(p.n0) * C * T) return;
        uint b = i / (C * T); uint r = i - b * C * T; uint c = r / T; uint t = r - c * T;
        F x = F(p.a0); F z = F(p.a1); F y = F(p.a2);
        float zv = z.v[b * uint(p.n3) + c * uint(p.n4) + t * uint(p.n5)];
        y.v[i] = (p.n6 == 1) ? x.v[i] * zv : x.v[i] + zv;
    }

GKern KBinDx
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x; uint C = uint(p.n1); uint T = uint(p.n2);
        if (i >= uint(p.n0) * C * T) return;
        uint b = i / (C * T); uint r = i - b * C * T; uint c = r / T; uint t = r - c * T;
        F dy = F(p.a0); F z = F(p.a1); F dx = F(p.a2);
        float f = (p.n6 == 1) ? z.v[b * uint(p.n3) + c * uint(p.n4) + t * uint(p.n5)] : 1.0;
        dx.v[i] += dy.v[i] * f;
    }

GKern KBinDz
    func decl [] -> GLSL none {
        shared float part[256];
    }
    func compute [] -> GLSL none {
        uint j = gl_WorkGroupID.x; uint l = gl_LocalInvocationID.x;
        uint B = uint(p.n0); uint C = uint(p.n1); uint T = uint(p.n2);
        uint sb = uint(p.n3); uint sc = uint(p.n4); uint st = uint(p.n5);
        uint zb = (sb == 0u) ? 1u : B; uint zc = (sc == 0u) ? 1u : C; uint zt = (st == 0u) ? 1u : T;
        uint b0 = j / (zc * zt); uint rr = j - b0 * zc * zt; uint c0 = rr / zt; uint t0 = rr - c0 * zt;
        uint nb = (sb == 0u) ? B : 1u; uint nc = (sc == 0u) ? C : 1u; uint nt = (st == 0u) ? T : 1u;
        uint total = nb * nc * nt;
        F dy = F(p.a0); F x = F(p.a1); F dz = F(p.a2);
        float s = 0.0;
        for (uint e = l; e < total; e += 256u) {{
          uint eb = e / (nc * nt); uint er = e - eb * nc * nt; uint ec = er / nt; uint et = er - ec * nt;
          uint b = (sb == 0u) ? eb : b0; uint c = (sc == 0u) ? ec : c0; uint t = (st == 0u) ? et : t0;
          uint i = (b * C + c) * T + t;
          s += dy.v[i] * ((p.n6 == 1) ? x.v[i] : 1.0);
        }}
        part[l] = s; barrier();
        for (uint w = 128u; w > 0u; w >>= 1) {{ if (l < w) part[l] += part[l + w]; barrier(); }}
        if (l == 0u) dz.v[j] += part[0];
    }

GKern KGate
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x; uint H = uint(p.n1); uint T = uint(p.n2);
        if (i >= uint(p.n0) * H * T) return;
        uint b = i / (H * T); uint r = i - b * H * T; uint c = r / T; uint t = r - c * T;
        F x = F(p.a0); F y = F(p.a2);
        float u = x.v[(b * 2u * H + c) * T + t]; float w = x.v[(b * 2u * H + H + c) * T + t];
        if (p.a1 != 0ul) {{ F g = F(p.a1); u += g.v[b * 2u * H + c]; w += g.v[b * 2u * H + H + c]; }}
        y.v[i] = tanh(u) / (1.0 + exp(-w));
    }

GKern KGateBack
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x; uint H = uint(p.n1); uint T = uint(p.n2);
        if (i >= uint(p.n0) * H * T) return;
        uint b = i / (H * T); uint r = i - b * H * T; uint c = r / T; uint t = r - c * T;
        F x = F(p.a0); F dy = F(p.a2); F d = F(p.a3);
        uint iu = (b * 2u * H + c) * T + t; uint iw = (b * 2u * H + H + c) * T + t;
        float u = x.v[iu]; float w = x.v[iw];
        if (p.a1 != 0ul) {{ F g = F(p.a1); u += g.v[b * 2u * H + c]; w += g.v[b * 2u * H + H + c]; }}
        float th = tanh(u); float sg = 1.0 / (1.0 + exp(-w)); float o = dy.v[i];
        d.v[iu] = o * sg * (1.0 - th * th);
        d.v[iw] = o * th * sg * (1.0 - sg);
    }

GKern KChanCopy
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x; uint N = uint(p.n1); uint T = uint(p.n2);
        if (i >= uint(p.n0) * N * T) return;
        uint b = i / (N * T); uint r = i - b * N * T; uint c = r / T; uint t = r - c * T;
        F s = F(p.a0); F d = F(p.a1);
        uint si = (b * uint(p.n3) + uint(p.n5) + c) * T + t;
        uint di = (b * uint(p.n4) + uint(p.n6) + c) * T + t;
        d.v[di] = ((p.f0 != 0.0) ? p.f0 * d.v[di] : 0.0) + s.v[si];
    }

GKern KLnorm
    func compute [] -> GLSL none {
        uint j = gl_GlobalInvocationID.x; uint C = uint(p.n1); uint T = uint(p.n2);
        if (j >= uint(p.n0) * T) return;
        uint b = j / T; uint t = j - b * T;
        F x = F(p.a0); F ga = F(p.a1); F be = F(p.a2); F y = F(p.a3); F mu = F(p.a4); F rs = F(p.a5);
        float m = 0.0; for (uint c = 0u; c < C; c++) m += x.v[(b * C + c) * T + t]; m /= float(C);
        float v = 0.0; for (uint c = 0u; c < C; c++) {{ float d = x.v[(b * C + c) * T + t] - m; v += d * d; }}
        float r = inversesqrt(v / float(C) + 1e-5);
        mu.v[j] = m; rs.v[j] = r;
        for (uint c = 0u; c < C; c++) {{ uint i = (b * C + c) * T + t; y.v[i] = (x.v[i] - m) * r * ga.v[c] + be.v[c]; }}
    }

GKern KLnormDx
    func compute [] -> GLSL none {
        uint j = gl_GlobalInvocationID.x; uint C = uint(p.n1); uint T = uint(p.n2);
        if (j >= uint(p.n0) * T) return;
        uint b = j / T; uint t = j - b * T;
        F x = F(p.a0); F ga = F(p.a1); F dy = F(p.a2); F dx = F(p.a3); F mu = F(p.a4); F rs = F(p.a5);
        float m = mu.v[j]; float r = rs.v[j];
        float s1 = 0.0; float s2 = 0.0;
        for (uint c = 0u; c < C; c++) {{ uint i = (b * C + c) * T + t; float gy = dy.v[i] * ga.v[c]; float xh = (x.v[i] - m) * r; s1 += gy; s2 += gy * xh; }}
        s1 /= float(C); s2 /= float(C);
        for (uint c = 0u; c < C; c++) {{ uint i = (b * C + c) * T + t; float gy = dy.v[i] * ga.v[c]; float xh = (x.v[i] - m) * r; dx.v[i] += r * (gy - s1 - xh * s2); }}
    }

# layer norm with one time step: a workgroup a row
GKern KLnormRow
    func decl [] -> GLSL none {
        shared float red[256];
    }
    func compute [] -> GLSL none {
        uint j = gl_WorkGroupID.x; uint l = gl_LocalInvocationID.x; uint C = uint(p.n1);
        F x = F(p.a0); F ga = F(p.a1); F be = F(p.a2); F y = F(p.a3); F mu = F(p.a4); F rs = F(p.a5);
        uint base = j * C;
        float s = 0.0; for (uint c = l; c < C; c += 256u) s += x.v[base + c];
        red[l] = s; barrier();
        for (uint w = 128u; w > 0u; w >>= 1) {{ if (l < w) red[l] += red[l + w]; barrier(); }}
        float m = red[0] / float(C); barrier();
        float v = 0.0; for (uint c = l; c < C; c += 256u) {{ float d = x.v[base + c] - m; v += d * d; }}
        red[l] = v; barrier();
        for (uint w = 128u; w > 0u; w >>= 1) {{ if (l < w) red[l] += red[l + w]; barrier(); }}
        float r = inversesqrt(red[0] / float(C) + 1e-5);
        if (l == 0u) {{ mu.v[j] = m; rs.v[j] = r; }}
        for (uint c = l; c < C; c += 256u) y.v[base + c] = (x.v[base + c] - m) * r * ga.v[c] + be.v[c];
    }

GKern KLnormRowDx
    func decl [] -> GLSL none {
        shared float ra[256];
        shared float rb[256];
    }
    func compute [] -> GLSL none {
        uint j = gl_WorkGroupID.x; uint l = gl_LocalInvocationID.x; uint C = uint(p.n1);
        F x = F(p.a0); F ga = F(p.a1); F dy = F(p.a2); F dx = F(p.a3); F mu = F(p.a4); F rs = F(p.a5);
        uint base = j * C;
        float m = mu.v[j]; float r = rs.v[j];
        float s1 = 0.0; float s2 = 0.0;
        for (uint c = l; c < C; c += 256u) {{ float gy = dy.v[base + c] * ga.v[c]; s1 += gy; s2 += gy * (x.v[base + c] - m) * r; }}
        ra[l] = s1; rb[l] = s2; barrier();
        for (uint w = 128u; w > 0u; w >>= 1) {{ if (l < w) {{ ra[l] += ra[l + w]; rb[l] += rb[l + w]; }} barrier(); }}
        s1 = ra[0] / float(C); s2 = rb[0] / float(C);
        for (uint c = l; c < C; c += 256u) {{ float gy = dy.v[base + c] * ga.v[c]; float xh = (x.v[base + c] - m) * r; dx.v[base + c] += r * (gy - s1 - xh * s2); }}
    }

GKern KLnormDg
    func decl [] -> GLSL none {
        shared float pa[256];
        shared float pb[256];
    }
    func compute [] -> GLSL none {
        uint c = gl_WorkGroupID.x; uint l = gl_LocalInvocationID.x; uint B = uint(p.n0); uint C = uint(p.n1); uint T = uint(p.n2);
        F x = F(p.a0); F dy = F(p.a2); F mu = F(p.a4); F rs = F(p.a5);
        float s1 = 0.0; float s2 = 0.0;
        for (uint e = l; e < B * T; e += 256u) {{ uint b = e / T; uint t = e - b * T; uint i = (b * C + c) * T + t; float xh = (x.v[i] - mu.v[e]) * rs.v[e]; s1 += dy.v[i] * xh; s2 += dy.v[i]; }}
        pa[l] = s1; pb[l] = s2; barrier();
        for (uint w = 128u; w > 0u; w >>= 1) {{ if (l < w) {{ pa[l] += pa[l + w]; pb[l] += pb[l + w]; }} barrier(); }}
        if (l == 0u) {{ if (p.a1 != 0ul) F(p.a1).v[c] += pa[0]; if (p.a3 != 0ul) F(p.a3).v[c] += pb[0]; }}
    }

GKern KAttnRelSoft
    func decl [] -> GLSL none {
        shared float red[256];
    }
    func compute [] -> GLSL none {
        uint row = gl_WorkGroupID.x; uint l = gl_LocalInvocationID.x;
        int H = p.n1; int DK = p.n2; int T = p.n3; int W = p.n4;
        int zi = int(row) / T; int i = int(row) - zi * T; int b = zi / H; int h = zi - b * H;
        F q = F(p.a0); F ek = F(p.a1); F P = F(p.a2);
        uint base = uint(zi) * uint(T) * uint(T) + uint(i) * uint(T);
        float mi = (p.a3 != 0ul) ? F(p.a3).v[uint(b * T + i)] : 1.0;
        float mx = -1e30;
        for (int j = int(l); j < T; j += 256) {{
          float s = P.v[base + uint(j)];
          int r = j - i + W;
          if (p.a1 != 0ul && r >= 0 && r <= 2 * W) {{ float a = 0.0; for (int d = 0; d < DK; d++) a += q.v[uint((b * H * DK + h * DK + d) * T + i)] * ek.v[uint(r * DK + d)]; s += a * p.f0; }}
          float mj = (p.a3 != 0ul) ? F(p.a3).v[uint(b * T + j)] : 1.0;
          if (mi * mj == 0.0) s = -1e4;
          if (p.n5 != 0 && j > i) s = -1e30;
          P.v[base + uint(j)] = s; mx = max(mx, s);
        }}
        red[l] = mx; barrier();
        for (uint w = 128u; w > 0u; w >>= 1) {{ if (l < w) red[l] = max(red[l], red[l + w]); barrier(); }}
        mx = red[0]; barrier();
        float sum = 0.0;
        for (int j = int(l); j < T; j += 256) {{ float e = exp(P.v[base + uint(j)] - mx); P.v[base + uint(j)] = e; sum += e; }}
        red[l] = sum; barrier();
        for (uint w = 128u; w > 0u; w >>= 1) {{ if (l < w) red[l] += red[l + w]; barrier(); }}
        float inv = 1.0 / red[0];
        for (int j = int(l); j < T; j += 256) P.v[base + uint(j)] *= inv;
    }

GKern KAttnRelV
    func compute [] -> GLSL none {
        uint e = gl_GlobalInvocationID.x; int H = p.n1; int DK = p.n2; int T = p.n3; int W = p.n4;
        if (e >= uint(p.n0 * H * DK * T)) return;
        int i = int(e) % T; int cd = int(e) / T; int d = cd % DK; int zi = cd / DK;
        F P = F(p.a0); F ev = F(p.a1); F o = F(p.a2);
        float s = 0.0;
        for (int r = 0; r <= 2 * W; r++) {{ int j = i + r - W; if (j < 0 || j >= T) continue; s += P.v[uint((zi * T + i) * T + j)] * ev.v[uint(r * DK + d)]; }}
        o.v[e] += s;
    }

GKern KAttnSoftBack
    func decl [] -> GLSL none {
        shared float red[256];
    }
    func compute [] -> GLSL none {
        uint row = gl_WorkGroupID.x; uint l = gl_LocalInvocationID.x;
        int H = p.n1; int DK = p.n2; int T = p.n3; int W = p.n4;
