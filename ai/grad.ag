        F s = F(p.a0); F d = F(p.a1); F ids = F(p.a2);
        uint src = (b * C + c) * T + uint(ids.v[b]) * uint(p.n4) + t;
        if (p.n5 == 0) d.v[i] = s.v[src];
        else d.v[src] += s.v[i];
    }

GKern KPadReflect
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x; uint T = uint(p.n1); int L = p.n2; int Tn = p.n3;
        if (i >= uint(p.n0) * uint(Tn)) return;
        uint row = i / uint(Tn); int t = int(i - row * uint(Tn)) - L;
        if (t < 0) t = -t;
        if (t >= int(T)) t = 2 * int(T) - 2 - t;
        F s = F(p.a0); F d = F(p.a1);
        d.v[i] = s.v[row * T + uint(t)];
    }

GKern KPadReflectBack
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x; int T = p.n1; int L = p.n2; int Tn = p.n3;
        if (i >= uint(p.n0) * uint(T)) return;
        uint row = i / uint(T); int t = int(i - row * uint(T));
        F dy = F(p.a0); F dx = F(p.a1);
        float s = dy.v[row * uint(Tn) + uint(t + L)];
        int ql = L - t;
        if (t > 0 && ql >= 0) s += dy.v[row * uint(Tn) + uint(ql)];
        int qr = L + 2 * T - 2 - t;
        if (t < T - 1 && qr < Tn) s += dy.v[row * uint(Tn) + uint(qr)];
        dx.v[i] += s;
    }

GKern KMagBack
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x; uint Fq = uint(p.n1); uint T = uint(p.n2);
        if (i >= uint(p.n0) * Fq * T) return;
        uint b = i / (Fq * T); uint r = i - b * Fq * T; uint f = r / T; uint t = r - f * T;
        F x = F(p.a0); F y = F(p.a1); F dy = F(p.a2); F dx = F(p.a3);
        uint ir = (b * 2u * Fq + f) * T + t; uint ii = (b * 2u * Fq + Fq + f) * T + t;
        float g = dy.v[i] / y.v[i];
        dx.v[ir] += g * x.v[ir];
        dx.v[ii] += g * x.v[ii];
    }

GKern KLogClampBack
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x; if (i >= uint(p.n0)) return;
        F x = F(p.a0); F dy = F(p.a1); F dx = F(p.a2);
        float v = x.v[i];
        if (v > p.f0) dx.v[i] += dy.v[i] / v;
    }

GKern KPeriodFold
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x; uint C = uint(p.n1); uint T = uint(p.n2); uint P = uint(p.n3);
        uint H = T / P;
        if (i >= uint(p.n0) * C * T) return;
        uint b = i / (C * T); uint r = i - b * C * T; uint c = r / T; uint t = r - c * T;
        uint h = t / P; uint j = t - h * P;
        uint o = ((b * P + j) * C + c) * H + h;
        F s = F(p.a0); F d = F(p.a1);
        if (p.n4 == 0) d.v[o] = s.v[i];
        else d.v[i] += s.v[o];
    }

GKern KLoss
    func decl [] -> GLSL none {
        shared float part[256];
    }
    func compute [] -> GLSL none {
        uint l = gl_LocalInvocationID.x; uint N = uint(p.n0); int mode = p.n1;
        F x = F(p.a0); F o = F(p.a2);
        float s = 0.0;
        uint G = gl_NumWorkGroups.x; uint gi = gl_WorkGroupID.x;
        for (uint i = gi * 256u + l; i < N; i += 256u * G) {{
            float v = x.v[i];
            if (mode == 0) {{ float d = p.f0 - v; s += d * d; }}
            else if (mode == 1) s += abs(v - F(p.a1).v[i]);
            else if (mode == 3) s += max(v, 0.0) - v * F(p.a1).v[i] + log(1.0 + exp(-abs(v)));
            else {{
                F lq = F(p.a1); F mp = F(p.a3); F lp = F(p.a4);
                uint T9 = uint(p.n2); uint C9 = uint(p.n3);
                float mk = (p.a5 != 0ul) ? F(p.a5).v[(i / (C9 * T9)) * T9 + i % T9] : 1.0;
                float d = v - mp.v[i];
                s += (lp.v[i] - lq.v[i] - 0.5 + 0.5 * d * d * exp(-2.0 * lp.v[i])) * mk;
            }}
        }}
        part[l] = s; barrier();
        for (uint w = 128u; w > 0u; w >>= 1) {{ if (l < w) part[l] += part[l + w]; barrier(); }}
        if (l == 0u) o.v[gi] = part[0];
    }

# the loss groups' partial sums, in order, scaled
GKern KLossSum
    func compute [] -> GLSL none {
        if (gl_GlobalInvocationID.x != 0u) return;
        F pt = F(p.a0); F o = F(p.a1);
        float s = 0.0;
        for (int i = 0; i < p.n0; i++) s += pt.v[i];
        o.v[0] = s * p.f0;
    }

GKern KLossBack
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x; uint N = uint(p.n0); int mode = p.n1;
        if (i >= N) return;
        F x = F(p.a0); F dl = F(p.a2); F dx = F(p.a3);
        float g = dl.v[0] * p.f1;
        float v = x.v[i];
        if (mode == 0) dx.v[i] += g * -2.0 * (p.f0 - v);
        else if (mode == 1) {{
            float d = v - F(p.a1).v[i]; float sg = (d > 0.0) ? 1.0 : ((d < 0.0) ? -1.0 : 0.0);
            dx.v[i] += g * sg;
            if (p.a4 != 0ul) F(p.a4).v[i] -= g * sg;
        }}
        else if (mode == 3) dx.v[i] += g * (1.0 / (1.0 + exp(-v)) - F(p.a1).v[i]);
    }

# a row's softmax cross entropy; a target under 0 is left out
GKern KXent
    func decl [] -> GLSL none {
        shared float red[256];
    }
    func compute [] -> GLSL none {
        uint row = gl_WorkGroupID.x; uint l = gl_LocalInvocationID.x;
        uint N = uint(p.n1);
        F x = F(p.a0); F ids = F(p.a1); F lse = F(p.a2); F rl = F(p.a3); F vl = F(p.a4);
        int tgt = int(ids.v[row]);
        if (tgt < 0) {{ if (l == 0u) {{ lse.v[row] = 0.0; rl.v[row] = 0.0; vl.v[row] = 0.0; }} return; }}
        uint base = row * N;
        float mx = -1e30;
        for (uint j = l; j < N; j += 256u) mx = max(mx, x.v[base + j]);
        red[l] = mx; barrier();
        for (uint w = 128u; w > 0u; w >>= 1) {{ if (l < w) red[l] = max(red[l], red[l + w]); barrier(); }}
        mx = red[0]; barrier();
        float sum = 0.0;
        for (uint j = l; j < N; j += 256u) sum += exp(x.v[base + j] - mx);
        red[l] = sum; barrier();
        for (uint w = 128u; w > 0u; w >>= 1) {{ if (l < w) red[l] += red[l + w]; barrier(); }}
        if (l == 0u) {{
            float ls = mx + log(red[0]);
            lse.v[row] = ls; rl.v[row] = ls - x.v[base + uint(tgt)]; vl.v[row] = 1.0;
        }}
    }

# the rows' losses summed in a fixed order, over the rows kept
GKern KXentSum
    func decl [] -> GLSL none {
        shared float ps[256];
        shared float pc[256];
    }
    func compute [] -> GLSL none {
        uint l = gl_LocalInvocationID.x; uint R = uint(p.n0);
        F rl = F(p.a0); F vl = F(p.a1);
        float s = 0.0; float c = 0.0;
        for (uint r = l; r < R; r += 256u) {{ s += rl.v[r]; c += vl.v[r]; }}
        ps[l] = s; pc[l] = c; barrier();
        for (uint w = 128u; w > 0u; w >>= 1) {{ if (l < w) {{ ps[l] += ps[l + w]; pc[l] += pc[l + w]; }} barrier(); }}
        if (l == 0u) {{ F(p.a3).v[0] = pc[0]; F(p.a2).v[0] = ps[0] / max(pc[0], 1.0); }}
    }

GKern KXentBack
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x; uint R = uint(p.n0); uint N = uint(p.n1);
        if (i >= R * N) return;
        uint row = i / N; uint c = i - row * N;
        F x = F(p.a0); F ids = F(p.a1); F lse = F(p.a2); F dl = F(p.a3); F cnt = F(p.a4); F dx = F(p.a5);
        int tgt = int(ids.v[row]);
        if (tgt < 0) return;
        float g = dl.v[0] / max(cnt.v[0], 1.0);
        float pr = exp(x.v[i] - lse.v[row]);
        dx.v[i] += g * (pr - ((int(c) == tgt) ? 1.0 : 0.0));
    }

GKern KKlBack
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x; uint N = uint(p.n0);
        if (i >= N) return;
        F zp = F(p.a0); F lq = F(p.a1); F mp = F(p.a2); F lp = F(p.a3); F grads = F(p.a4);
        uint T9 = uint(p.n2); uint C9 = uint(p.n5);
        float mk = (p.a5 != 0ul) ? F(p.a5).v[(i / (C9 * T9)) * T9 + i % T9] : 1.0;
        float g = grads.v[0] * p.f1 * mk;
        float e = exp(-2.0 * lp.v[i]); float d = zp.v[i] - mp.v[i];
        uint64_t base = uint64_t(uint(p.n3)) | (uint64_t(uint(p.n4)) << 32);
        F dz = F(base); F dq = F(base + uint64_t(N) * 4ul); F dm = F(base + uint64_t(N) * 8ul); F dlp = F(base + uint64_t(N) * 12ul);
        dz.v[i] = g * d * e;
        dq.v[i] = -g;
        dm.v[i] = -g * d * e;
        dlp.v[i] = g * (1.0 - d * d * e);
    }

GKern KAdamW
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x; if (i >= uint(p.n0)) return;
        F w = F(p.a0); F g = F(p.a1); F m = F(p.a2); F v = F(p.a3);
        float lr = p.f0; float b1 = p.f1; float b2 = p.f2;
        float c1 = uintBitsToFloat(uint(p.n1)); float c2 = uintBitsToFloat(uint(p.n2));
        float wd = uintBitsToFloat(uint(p.n3)); float eps = uintBitsToFloat(uint(p.n4));
        float gv = g.v[i];
        float pw = w.v[i] * (1.0 - lr * wd);
        float mm = b1 * m.v[i] + (1.0 - b1) * gv;
        float vv = b2 * v.v[i] + (1.0 - b2) * gv * gv;
        m.v[i] = mm; v.v[i] = vv;
        w.v[i] = pw - lr * (mm / c1) / (sqrt(vv / c2) + eps);
    }

GKern KTop8
    func decl [] -> GLSL none {
        shared float bd[2048];
        shared int bi[2048];
    }
    func compute [] -> GLSL none {
        uint row = gl_WorkGroupID.x; uint l = gl_LocalInvocationID.x; uint N = uint(p.n1);
        F d = F(p.a0); F od = F(p.a1); F oi = F(p.a2);
        float kd[8]; int ki[8];
        for (int j = 0; j < 8; j++) {{ kd[j] = 3.0e38; ki[j] = -1; }}
        for (uint c = l; c < N; c += 256u) {{
            float v = d.v[row * N + c];
            if (v < kd[7]) {{
                int j = 7;
                while (j > 0 && kd[j - 1] > v) {{ kd[j] = kd[j - 1]; ki[j] = ki[j - 1]; j--; }}
                kd[j] = v; ki[j] = int(c);
            }}
        }}
        for (int j = 0; j < 8; j++) {{ bd[l * 8u + uint(j)] = kd[j]; bi[l * 8u + uint(j)] = ki[j]; }}
        barrier();
        if (l == 0u) {{
            for (uint e = 8u; e < 2048u; e++) {{
                float v = bd[e]; int ix = bi[e];
                if (ix < 0 || v >= kd[7]) continue;
                int j = 7;
                while (j > 0 && kd[j - 1] > v) {{ kd[j] = kd[j - 1]; ki[j] = ki[j - 1]; j--; }}
                kd[j] = v; ki[j] = ix;
            }}
            for (int j = 0; j < 8; j++) {{ od.v[row * 8u + uint(j)] = kd[j]; oi.v[row * 8u + uint(j)] = float(ki[j]); }}
        }}
    }

GKern KSplitSum
    func compute [] -> GLSL none {
        uint i = gl_GlobalInvocationID.x; uint M = uint(p.n0); uint N = uint(p.n1);
        if (i >= M * N) return;
        uint r = i / N; uint c = i - r * N;
        F P = F(p.a0); F C = F(p.a1);
        float s = 0.0;
        for (int q = 0; q < p.n2; q++) s += P.v[uint(q) * M * N + i];
        uint at = r * uint(p.n3) + c * uint(p.n4);
        float old = (p.f1 != 0.0) ? p.f1 * C.v[at] : 0.0;
        C.v[at] = p.f0 * s + old;
    }

# one dispatch's arguments
class GArgs
    public ad : new u64 [ 6 ]
    public nn : new i32 [ 12 ]
    public ff : new f32 [ 4 ]

# a compute pipeline from a GKern; push constants GArgs
class GKernel
    context vk     : vk_context
    public  name   : string
    public  kern   : GKern
    public  ready  : bool
    intern  pipe   : VkPipeline
    intern  layout : VkPipelineLayout

    func init []
        dir : string '{path.path_install[]}/tmp/grad'
        mkdir[ dir.chars, 0x1ED ]
        src : string '{dir}/{name}.comp'
        spv : string '{dir}/{name}.spv'
        dc : GLSL kern.decl*[]
        mn : GLSL kern.compute*[]
        dtext : string [
            (dc && dc.body) ? string [ dc.body ] : string [ '' ] ]
        text : string '{grad_header[]}layout(local_size_x = {kern.lx}, local_size_y = {kern.ly}) in;\n{dtext}\nvoid main() {{\n{string [ mn.body ]}\n}}\n'
        fo : @FILE [ fopen[ src.chars, 'wb' ] ]
        if [ !fo ] return
        fwrite[ text.chars, 1, text.count, fo ]
        fclose[ fo ]
        if [ trinity_glsl_to_spv[ src.chars, spv.chars ] != 0 ]
            log 'grad: {name} did not compile'
            return
        fi : @FILE [ fopen[ spv.chars, 'rb' ] ]
        if [ !fi ] return
        fseek[ fi, 0, SEEK_END ]
        n : i64 [ ftell[ fi ] ]
        rewind[ fi ]
        code : new u8 [ n ]
        fread[ code, 1, n, fi ]
        fclose[ fi ]
        dv : cast VkDevice [ vk.dev_handle[] ]
        mi : VkShaderModuleCreateInfo [
            sType:    VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO,
            codeSize: n,
            pCode:    code ]
        md : VkShaderModule
        if [ vkCreateShaderModule[ dv, mi, null, @md ] != VK_SUCCESS ]
            return
        rng : VkPushConstantRange [
            stageFlags: VK_SHADER_STAGE_COMPUTE_BIT,
            offset:     0,
            size:       112 ]
        li : VkPipelineLayoutCreateInfo [
            sType:                  VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO,
            setLayoutCount:         0,
            pushConstantRangeCount: 1,
            pPushConstantRanges:    @rng ]
        if [ vkCreatePipelineLayout[ dv, li, null, @layout ] != VK_SUCCESS ]
            return
        ci : VkComputePipelineCreateInfo [
            sType:  VK_STRUCTURE_TYPE_COMPUTE_PIPELINE_CREATE_INFO,
            layout: layout,
            stage:  VkPipelineShaderStageCreateInfo [
            sType:  VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO,
                stage:  VK_SHADER_STAGE_COMPUTE_BIT,
                module: md,
                pName:  'main' ] ]
        ready = vkCreateComputePipelines[ dv, null, 1, ci, null,
                                          @pipe ] == VK_SUCCESS
        vkDestroyShaderModule[ dv, md, null ]

    func pipeline_handle [] -> handle
        return cast handle [ pipe ]

    func layout_handle [] -> handle
        return cast handle [ layout ]

# a device buffer tensors are carved from, 256-aligned
class GArena
    context vk    : vk_context
    public  bytes : i64
    public  base  : u64
    public  top   : i64
    public  buf   : Buffer

    func init []
        buf = Buffer [ vk: vk, size: bytes, u_storage: true,
                       u_shader: true,
                       u_src: true, u_dst: true, m_device_local: true ]
        base = buf.address[]

    # the offset of n fresh bytes, or -1 when the arena is full
    func take [ n: i64 ] -> i64
        at : i64 [ (top + 255) & (0 - 256) ]
        if [ at + n > bytes ] return -1
        top = at + n
        return at

# a tensor of f32 values living in an arena
class GTensor
    public ar    : GArena
    public off   : i64
    public count : i64
    public dims  : vec i64
    # it takes a gradient; gr holds it during a step
    public need  : bool
    public gr    : GTensor

    func addr [] -> u64
        return ar.base + u64[ off ]

# dispatches and copies; finish submits once and waits
class GRun
    context vk   : vk_context
    intern  cmd  : VkCommandBuffer
    intern  open : bool
    # gpu time per kernel, when profiling
    public  prof  : bool
    intern  qpool : VkQueryPool
    intern  qn    : i32
    intern  qname : vec string
    public  ptime : map f64 [ string ]
    public  pcount : map i64 [ string ]
    # independent dispatches: the caller fences once after
    public  nofence : bool

    func start []
        if [ open ] return
        dv : cast VkDevice [ vk.dev_handle[] ]
        cp : cast VkCommandPool [ vk.compute_pool_handle[] ]
        if [ !cp ] cp = cast VkCommandPool [ vk.pool_handle[] ]
        vkAllocateCommandBuffers[ dv, VkCommandBufferAllocateInfo [
            sType:              VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO,
            commandPool:        cp,
            level:              VK_COMMAND_BUFFER_LEVEL_PRIMARY,
            commandBufferCount: 1 ], @cmd ]
        vkBeginCommandBuffer[ cmd, VkCommandBufferBeginInfo [
            sType: VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO,
            flags: VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT ] ]
        open = true
        if [ prof ]
            if [ !qpool ]
                vkCreateQueryPool[ dv, VkQueryPoolCreateInfo [
                    sType:      VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO,
                    queryType:  VK_QUERY_TYPE_TIMESTAMP,
                    queryCount: 32768 ], null, @qpool ]
                ptime = map f64 [ string ] []
                pcount = map i64 [ string ] []
            vkCmdResetQueryPool[ cmd, qpool, 0, 32768 ]
            qname = vec string []
            qn = 0
            stamp[ 'start' ]

    func stamp [ name: string ]
        # prof turned on with a buffer open: no pool until the next
        if [ !prof || !qpool || qn >= 32768 ] return
        vkCmdWriteTimestamp[ cmd, VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
                             qpool, u32[ qn ] ]
        qname.push[ name ]
        qn += 1

    # every write so far lands before anything after it reads
    func fence_mem []
        mb : VkMemoryBarrier [
            sType:         VK_STRUCTURE_TYPE_MEMORY_BARRIER,
            srcAccessMask: VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_WRITE_BIT,
            dstAccessMask: VK_ACCESS_SHADER_READ_BIT | VK_ACCESS_SHADER_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT ]
        st : VkPipelineStageFlags [
            VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_TRANSFER_BIT ]
        vkCmdPipelineBarrier[ cmd, st, st, 0, 1, @mb, 0, null, 0, null ]

    func dispatch [ k: GKernel, g: GArgs, gx: i32, gy: i32, gz: i32 ]
        if [ !k.ready ] return
        start[]
        pk : local u8 [ 112 ]
        memcpy[ @pk[ 0 ], g.ad, 48 ]
        memcpy[ @pk[ 48 ], g.nn, 48 ]
        memcpy[ @pk[ 96 ], g.ff, 16 ]
        vkCmdBindPipeline[ cmd, VK_PIPELINE_BIND_POINT_COMPUTE,
                           cast VkPipeline [ k.pipeline_handle[] ] ]
        vkCmdPushConstants[ cmd,
                            cast VkPipelineLayout [ k.layout_handle[] ],
                            VK_SHADER_STAGE_COMPUTE_BIT, 0, 112,
                            @pk[ 0 ] ]
        vkCmdDispatch[ cmd, u32[ gx ], u32[ gy ], u32[ gz ] ]
        if [ !nofence ] fence_mem[]
        stamp[ k.name ]

    # n bytes from one buffer to another
    func move [ src: Buffer, so: i64, dst: Buffer, doff: i64, n: i64 ]
        if [ n <= 0 ] return
        start[]
        rg : VkBufferCopy [ srcOffset: u64[ so ], dstOffset: u64[ doff ],
                            size: u64[ n ] ]
        vkCmdCopyBuffer[ cmd, cast VkBuffer [ src.buffer_handle[] ],
                         cast VkBuffer [ dst.buffer_handle[] ], 1, @rg ]
        fence_mem[]
        stamp[ 'copy' ]

    func finish []
        if [ !open ] return
        open = false
        dv : cast VkDevice [ vk.dev_handle[] ]
        qq : cast VkQueue [ vk.compute_queue_handle[] ]
        cp : cast VkCommandPool [ vk.compute_pool_handle[] ]
        if [ !qq ]
            qq = cast VkQueue [ vk.queue_handle[] ]
            cp = cast VkCommandPool [ vk.pool_handle[] ]
        cb : VkCommandBuffer [ cmd ]
        vkEndCommandBuffer[ cb ]
        vkQueueSubmit[ qq, 1, VkSubmitInfo [
            sType:              VK_STRUCTURE_TYPE_SUBMIT_INFO,
            commandBufferCount: 1,
            pCommandBuffers:    @cb ], null ]
        vkQueueWaitIdle[ qq ]
        vkFreeCommandBuffers[ dv, cp, 1, @cb ]
        if [ prof && qpool && qn > 1 ]
            ts : vec u64 [ qn ]
            vkGetQueryPoolResults[ dv, qpool, 0, u32[ qn ], qn * 8,
                                   @ts[ 0 ], 8,
                                   VK_QUERY_RESULT_64_BIT | VK_QUERY_RESULT_WAIT_BIT ]
            ns : f64 [ vk.timestamp_ns[] ]
            for [ i: i32 1, i < qn, i += 1 ]
                nm : string qname[ i ]
                us : f64 [ f64[ ts[ i ] - ts[ i - 1 ] ] * ns / 1000.0 ]
                have : f64 [
                    (ptime.contains[ nm ]) ? ptime[ nm ] : 0.0 ]
                ptime[ nm ] = have + us
                hc : i64 [ (pcount.contains[ nm ]) ? pcount[ nm ] : 0 ]
                pcount[ nm ] = hc + 1

# a recorded op; Grad.back_op runs its backward by kind
class GOp
    public out  : GTensor
    public kind : i32

# y = conv1d(x, w) + b; cols kept for the weight gradient
GOp GConvOp
    public x    : GTensor
    public w    : GTensor
    public b    : GTensor
    public st   : i32
    public pd   : i32
    public dl   : i32
    public gp   : i32

# y = conv_transpose1d(x, w) + b
GOp GConvTOp
    public xin  : GTensor
    public wt   : GTensor
    public bias : GTensor
    public t_st : i32
    public t_pd : i32

# y = f(x): 1 leaky, 2 tanh, 3 sigmoid, 4 exp, 5 scale
GOp GUnaryOp
    public ux   : GTensor
    public code : i32
    public f0   : f32

# y = x + z or x * z, z broadcast over [b, c, t]
GOp GBinOp
    public bx   : GTensor
    public bz   : GTensor
    public mul  : bool
    public sb   : i64
    public sc   : i64
    public stt  : i64

# wavenet gate: tanh(x[:h] + g) * sigmoid(x[h:] + g)
GOp GGateOp
    public gx   : GTensor
    public gc   : GTensor

# channels c0..c0+n of x
GOp GSliceOp
    public sx   : GTensor
    public c0   : i64

# x and z joined along channels
GOp GJoinOp
    public jx   : GTensor
    public jz   : GTensor

# layer norm over channels at every (b, t)
GOp GNormOp
    public nx    : GTensor
    public gamma : GTensor
    public beta  : GTensor
    public mean  : GTensor
    public rstd  : GTensor

# vits self attention with relative positions, masked
GOp GAttnOp
    public q    : GTensor
    public kk   : GTensor
    public v    : GTensor
    public ek   : GTensor
    public ev   : GTensor
    public am   : GTensor
    public pr   : GTensor
    public nh   : i64
    public win  : i64
    # a position sees only itself and those before it
    public causal : bool

# [b, a, c] turned to [b, c, a]
GOp GSwapOp
    public wx : GTensor

# y = x w^t + b on rows: x [n, in], w [out, in]
GOp GLinOp
    public lx : GTensor
    public lw : GTensor
    public lb : GTensor

# table rows picked by ids (whole numbers as floats)
GOp GLookOp
    public ids : GTensor
    public tab : GTensor

# w = g v / |v| per slice along dim 0
GOp GWnormOp
    public wv  : GTensor
    public wg  : GTensor
    public nrm : GTensor

# channels in reverse order
GOp GFlipOp
    public fx : GTensor

# the same values under new dims
GOp GShapeOp
    public rx : GTensor

# frames t0 .. t0+n of [b, c, t]
GOp GTsliceOp
    public tx : GTensor
    public t0 : i64

# frames ids[b]*mult .. +n of each batch item b
GOp GTsIdsOp
    public sx   : GTensor
    public ids  : GTensor
    public mult : i64

# reflect padding along time
GOp GPadOp
    public px : GTensor
    public pl : i64

# |complex| of stacked halves, and its log clamp
GOp GMagOp
    public mx : GTensor
GOp GLogOp
    public lgx : GTensor
    public lo  : f32

# [b, c, t] to [b*p, c, t/p]: each period an item
GOp GFoldOp
    public fx9 : GTensor
    public per : i64

# a mean loss: 0 least squares, 1 l1, 3 sigmoid cross entropy
GOp GLossOp
    public lx   : GTensor
    public ly   : GTensor
    public mode : i32
    public tgt  : f32
    public nrm  : f32

# vits' kl between the flow's z_p (posterior) and the prior
GOp GKlOp
    public zp   : GTensor
    public lq   : GTensor
    public mp   : GTensor
    public lp   : GTensor
    public km   : GTensor
    public nrm  : f32

# mean softmax cross entropy of rows against target ids
GOp GXentOp
    public xx  : GTensor
    public ids : GTensor
    public lse : GTensor
    public cnt : GTensor

# kernels, arenas and staging for one device
class Grad
    context vk     : vk_context
    public  valid  : bool
    # weights and their optimizer state, kept for good
    public  keep   : GArena
    # one step's activations and gradients, reset each step
    public  work   : GArena
    public  stage  : Buffer
    public  stage_bytes : i64
    public  rn     : GRun
    intern  kernels : map GKernel [ string ]
    public  keep_mb : i64 [ 1024 ]
    public  work_mb : i64 [ 2048 ]
    # one op's columns and staging, reused by the next op
    public  scratch : GArena
    public  scratch_mb : i64 [ 512 ]
    # the step's operations in order, while recording
    public  tape    : vec GOp
    public  record  : bool

    func init []
        if [ !vk ] return
        keep = GArena [ vk: vk, bytes: keep_mb * 1048576 ]
        work = GArena [ vk: vk, bytes: work_mb * 1048576 ]
        scratch = GArena [ vk: vk, bytes: scratch_mb * 1048576 ]
        stage_bytes = 64 * 1048576
        stage = Buffer [ vk: vk, size: stage_bytes, u_src: true,
                         u_dst: true,
                         m_host_visible: true, m_host_coherent: true,
                         m_host_cached: true ]
        rn = GRun [ vk: vk ]
        kernels = map GKernel [ string ] []
        tape = vec GOp []
        valid = keep.base != 0 && work.base != 0 && stage.data != null

    # a kernel by name, compiled from src the first time
    func kernel [ name: string, kn: GKern ] -> GKernel
        have : GKernel kernels[ name ]
        if [ have ] return have
        k : GKernel [ vk: vk, name: name, kern: kn ]
        kernels[ name ] = k
        return k

    func tensor_in [ ar: GArena, dims: vec i64 ] -> GTensor
        n : i64 [ 1 ]
        for [ d: i64 ] in dims
            n = n * d
        at : i64 [ ar.take[ n * 4 ] ]
        if [ at < 0 ]
            throw 'grad: arena full ({ar.bytes / 1048576} MB, {ar.top / 1048576} MB used) for {n} values'
        return GTensor [ ar: ar, off: at, count: n, dims: dims ]

    # a step's tensor, gone at the next reset
    func temp [ dims: vec i64 ] -> GTensor
        return tensor_in[ work, dims ]

    # keep only ts above mark: they move down, all else above goes
    func compact [ mark: i64, ts: vec GTensor ] -> vec GTensor
        scratch.top = 0
        held : vec GTensor []
        for [ t: GTensor ] in ts
            h : GTensor stemp[ t.dims ]
            rn.move[ t.ar.buf, t.off, h.ar.buf, h.off, t.count * 4 ]
            held.push[ h ]
        work.top = mark
        out : vec GTensor []
        for [ h: GTensor ] in held
            t : GTensor temp[ h.dims ]
            rn.move[ h.ar.buf, h.off, t.ar.buf, t.off, h.count * 4 ]
            out.push[ t ]
        return out

    # every arena back to the device; the grad is unusable after
    func release []
        rn.finish[]
        if [ keep ] keep.buf.destroy_now[]
        if [ work ] work.buf.destroy_now[]
        if [ scratch ] scratch.buf.destroy_now[]
        if [ stage ] stage.destroy_now[]
        valid = false

    # an op's own working tensor, gone when the next op starts
    func stemp [ dims: vec i64 ] -> GTensor
        return tensor_in[ scratch, dims ]

    func param [ dims: vec i64 ] -> GTensor
        return tensor_in[ keep, dims ]

    # values onto the gpu, through the staging buffer in pieces
    func upload [ t: GTensor, v: vec f32 ]
        if [ !t ] return
        n : i64 [ (v.count < t.count) ? v.count : t.count ]
        done : i64 [ 0 ]
        while [ done < n ]
            part : i64 [
                ((n - done) * 4 < stage_bytes) ? (n - done)
                : stage_bytes / 4 ]
            memcpy[ stage.data, @v[ done ], part * 4 ]
            rn.move[ stage, 0, t.ar.buf, t.off + done * 4, part * 4 ]
            rn.finish[]
            done += part

    func download [ t: GTensor ] -> vec f32
        out : vec f32 [ t.count ]
        done : i64 [ 0 ]
        while [ done < t.count ]
            part : i64 [
                ((t.count - done) * 4 < stage_bytes) ? (t.count - done)
                : stage_bytes / 4 ]
            rn.move[ t.ar.buf, t.off + done * 4, stage, 0, part * 4 ]
            rn.finish[]
            memcpy[ @out[ done ], stage.data, part * 4 ]
            done += part
        return out

    # the step's tensors all go; the arena starts over
    func reset_work []
        work.top = 0

    func groups [ n: i64 ] -> i32
        return i32[ (n + 255) / 256 ]

    # y = a*x + b*y over n values
    func axpby [ x: GTensor, y: GTensor, fa: f32, fb: f32 ]
        k : GKernel kernel[ 'axpby', KAxpby [] ]
        g : GArgs []
        g.ad[ 0 ] = x.addr[]
        g.ad[ 1 ] = y.addr[]
        g.nn[ 0 ] = i32[ y.count ]
        g.ff[ 0 ] = fa
        g.ff[ 1 ] = fb
        rn.dispatch[ k, g, groups[ y.count ], 1, 1 ]

    # c = alpha a.b + beta c per batch z; see KGemm
    func gemm [ va: GView, vb: GView, vc: GView, m: i64, n: i64, k: i64,
                batch: i64, alpha: f32, beta: f32 ]
        # few output tiles over a long sum: split the sum
        tiles : i64 [ ((n + 63) / 64) * ((m + 63) / 64) * batch ]
        sk : i64 [ 224 / tiles ]
        if [ sk > k / 512 ] sk = k / 512
        if [ batch == 1 && sk >= 2 ]
            gemm_split[ va, vb, vc, m, n, k, sk, alpha, beta ]
            return
        gemm_run[ va, vb, vc, m, n, k, batch, alpha, beta ]

    # sk pieces of the sum into scratch, then one ordered sum
    func gemm_split [ va: GView, vb: GView, vc: GView, m: i64, n: i64,
                      k: i64, sk: i64, alpha: f32, beta: f32 ]
        kc : i64 [ k / sk ]
        rest : i64 [ k - kc * sk ]
        np : i64 [ (rest > 0) ? sk + 1 : sk ]
        save : i64 [ scratch.top ]
        pt : GTensor stemp[ dims3[ np, m, n ] ]
        gemm_run[
            GView [ t: va.t, rs: va.rs, cs: va.cs, bs: kc * va.cs ],
            GView [ t: vb.t, rs: vb.rs, cs: vb.cs, bs: kc * vb.rs ],
            GView [ t: pt, rs: n, cs: 1, bs: m * n ], m, n, kc, sk, 1.0,
            0.0 ]
        if [ rest > 0 ]
            ta : GTensor [ ar: va.t.ar,
                           off: va.t.off + kc * sk * va.cs * 4,
                           count: va.t.count, dims: va.t.dims ]
            tb : GTensor [ ar: vb.t.ar,
                           off: vb.t.off + kc * sk * vb.rs * 4,
                           count: vb.t.count, dims: vb.t.dims ]
            tp : GTensor [ ar: pt.ar, off: pt.off + sk * m * n * 4,
                           count: m * n, dims: pt.dims ]
            gemm_run[ GView [ t: ta, rs: va.rs, cs: va.cs, bs: 0 ],
                      GView [ t: tb, rs: vb.rs, cs: vb.cs, bs: 0 ],
                      GView [ t: tp, rs: n, cs: 1, bs: 0 ], m, n, rest,
                      1, 1.0, 0.0 ]
        split_sum[ pt, vc, m, n, np, alpha, beta ]
        scratch.top = save

    # the np partials of a split gemm into c, in order
    func split_sum [ pt: GTensor, vc: GView, m: i64, n: i64, np: i64,
                     alpha: f32, beta: f32 ]
        k2 : GKernel kernel[ 'split_sum', KSplitSum [] ]
        g : GArgs []
        g.ad[ 0 ] = pt.addr[]
        g.ad[ 1 ] = vc.t.addr[]
        g.nn[ 0 ] = i32[ m ]
        g.nn[ 1 ] = i32[ n ]
        g.nn[ 2 ] = i32[ np ]
        g.nn[ 3 ] = i32[ vc.rs ]
        g.nn[ 4 ] = i32[ vc.cs ]
        g.ff[ 0 ] = alpha
        g.ff[ 1 ] = beta
        rn.dispatch[ k2, g, groups[ m * n ], 1, 1 ]

    func gemm_run [ va: GView, vb: GView, vc: GView, m: i64, n: i64,
                    k: i64, batch: i64, alpha: f32, beta: f32 ]
        kk : GKernel kernel[ 'gemm', KGemm [] ]
        g : GArgs []
        g.ad[ 0 ] = va.t.addr[]
        g.ad[ 1 ] = vb.t.addr[]
        g.ad[ 2 ] = vc.t.addr[]
        g.nn[ 0 ] = i32[ m ]
        g.nn[ 1 ] = i32[ n ]
        g.nn[ 2 ] = i32[ k ]
        g.nn[ 3 ] = i32[ va.rs ]
        g.nn[ 4 ] = i32[ va.cs ]
        g.nn[ 5 ] = i32[ vb.rs ]
        g.nn[ 6 ] = i32[ vb.cs ]
        g.nn[ 7 ] = i32[ vc.rs ]
        g.nn[ 8 ] = i32[ vc.cs ]
        g.nn[ 9 ] = i32[ va.bs ]
        g.nn[ 10 ] = i32[ vb.bs ]
        g.nn[ 11 ] = i32[ vc.bs ]
        g.ff[ 0 ] = alpha
        g.ff[ 1 ] = beta
        # tall or narrow shapes waste most of a 128-row tile
        if [ m >= 512 && n >= 512 ]
            k2 : GKernel kernel[ 'gemm2', KGemm2 [] ]
            rn.dispatch[ k2, g, i32[ (n + 63) / 64 ],
                         i32[ (m + 127) / 128 ], i32[ batch ] ]
            return
        rn.dispatch[ kk, g, i32[ (n + 63) / 64 ], i32[ (m + 63) / 64 ],
                     i32[ batch ] ]

    # the gradient of t, made zero the first time a step asks
    func grad_of [ t: GTensor ] -> GTensor
        if [ !t.gr ]
            t.gr = temp[ t.dims ]
            fill[ t.gr, 0.0 ]
        return t.gr

    # the loss's gradient is 1; every recorded op in reverse
    func backward [ loss: GTensor ]
        fill[ grad_of[ loss ], 1.0 ]
        i : i64 [ tape.count - 1 ]
        while [ i >= 0 ]
            back_op[ tape[ i ] ]
            i -= 1
        rn.finish[]

    func back_op [ rec: GOp ]
        switch [ rec.kind ]
            case 1
                conv1d_back[ cast GConvOp [ rec ] ]
            case 2
                convt1d_back[ cast GConvTOp [ rec ] ]
            case 3
                unary_back[ cast GUnaryOp [ rec ] ]
            case 4
                bin_back[ cast GBinOp [ rec ] ]
            case 5
                gate_back[ cast GGateOp [ rec ] ]
            case 6
                slice_back[ cast GSliceOp [ rec ] ]
            case 7
                join_back[ cast GJoinOp [ rec ] ]
            case 8
                norm_back[ cast GNormOp [ rec ] ]
            case 9
                attn_back[ cast GAttnOp [ rec ] ]
            case 10
                swap_back[ cast GSwapOp [ rec ] ]
            case 11
                linear_back[ cast GLinOp [ rec ] ]
            case 12
                lookup_back[ cast GLookOp [ rec ] ]
            case 13
                wnorm_back[ cast GWnormOp [ rec ] ]
            case 14
                flip_back[ cast GFlipOp [ rec ] ]
            case 15
                reshape_back[ cast GShapeOp [ rec ] ]
            case 16
                tslice_back[ cast GTsliceOp [ rec ] ]
            case 17
                tsids_back[ cast GTsIdsOp [ rec ] ]
            case 18
                pad_back[ cast GPadOp [ rec ] ]
            case 19
                mag_back[ cast GMagOp [ rec ] ]
            case 20
                log_back[ cast GLogOp [ rec ] ]
            case 21
                fold_back[ cast GFoldOp [ rec ] ]
            case 22
                loss_back[ cast GLossOp [ rec ] ]
            case 23
                kl_back[ cast GKlOp [ rec ] ]
            case 24
                xent_back[ cast GXentOp [ rec ] ]

    func keeps [ t: GTensor ] -> bool
        return record && t && t.need

    # [b, c, t] <-> [c][b*t]; back 1 adds beta*y and bias
    func regroup [ src: GTensor, dst: GTensor, bias: GTensor, nb: i64,
                   ch: i64, nt: i64, back: i32, beta: f32 ]
        k : GKernel kernel[ 'regroup', KRegroup [] ]
        g : GArgs []
        g.ad[ 0 ] = src.addr[]
        g.ad[ 1 ] = dst.addr[]
        g.ad[ 2 ] = (bias) ? bias.addr[] : u64[ 0 ]
        g.nn[ 0 ] = i32[ nb ]
        g.nn[ 1 ] = i32[ ch ]
        g.nn[ 2 ] = i32[ nt ]
        g.nn[ 3 ] = back
        g.ff[ 0 ] = beta
        rn.dispatch[ k, g, groups[ nb * ch * nt ], 1, 1 ]

    # db[c] += the sum of row c of m [c][n]
    func row_sums [ m: GTensor, db: GTensor, rows: i64, n: i64 ]
        k : GKernel kernel[ 'row_sums', KRowSums [] ]
        g : GArgs []
        g.ad[ 0 ] = m.addr[]
        g.ad[ 1 ] = db.addr[]
        g.nn[ 0 ] = i32[ rows ]
        g.nn[ 1 ] = i32[ n ]
        rn.dispatch[ k, g, i32[ rows ], 1, 1 ]

    # unroll x for a conv: cols[(ci, k)][b*to + to]
    func im2col [ x: GTensor, cols: GTensor, nb: i64, cin: i64, nt: i64,
                  kw: i64, st: i32, pd: i32, dl: i32, gp: i32,
                  tout: i64 ]
        k : GKernel kernel[ 'im2col', KIm2col [] ]
        g : GArgs []
        g.ad[ 0 ] = x.addr[]
        g.ad[ 1 ] = cols.addr[]
        g.nn[ 0 ] = i32[ nb ]
        g.nn[ 1 ] = i32[ cin ]
        g.nn[ 2 ] = i32[ nt ]
        g.nn[ 3 ] = i32[ kw ]
        g.nn[ 4 ] = st
        g.nn[ 5 ] = pd
        g.nn[ 6 ] = dl
        g.nn[ 8 ] = i32[ tout ]
        rn.dispatch[ k, g, groups[ cin * kw * nb * tout ], 1, 1 ]

    # dx[b, c, t] += every column tap that read x[b, c, t]
    func col2im [ dcols: GTensor, dx: GTensor, nb: i64, cin: i64,
                  nt: i64, kw: i64, st: i32, pd: i32, dl: i32,
                  tout: i64 ]
        k : GKernel kernel[ 'col2im', KCol2im [] ]
        g : GArgs []
        g.ad[ 0 ] = dcols.addr[]
        g.ad[ 1 ] = dx.addr[]
        g.nn[ 0 ] = i32[ nb ]
        g.nn[ 1 ] = i32[ cin ]
        g.nn[ 2 ] = i32[ nt ]
        g.nn[ 3 ] = i32[ kw ]
        g.nn[ 4 ] = st
        g.nn[ 5 ] = pd
        g.nn[ 6 ] = dl
        g.nn[ 8 ] = i32[ tout ]
        rn.dispatch[ k, g, groups[ nb * cin * nt ], 1, 1 ]

    # pytorch's conv1d: x [b, cin, t], w [cout, cin/gp, k]
    func conv1d [ x: GTensor, w: GTensor, b: GTensor, st: i32, pd: i32,
                  dl: i32, gp: i32 ] -> GTensor
        nb : i64 [ x.dims[ 0 ] ]
        cin : i64 [ x.dims[ 1 ] ]
        nt : i64 [ x.dims[ 2 ] ]
        cout : i64 [ w.dims[ 0 ] ]
        kw : i64 [ w.dims[ 2 ] ]
        tout : i64 [
            (nt + 2 * i64[ pd ] - i64[ dl ] * (kw - 1) - 1) / i64[ st ]
            + 1 ]
        cg : i64 [ cin / i64[ gp ] ]
        og : i64 [ cout / i64[ gp ] ]
        bt : i64 [ nb * tout ]
        scratch.top = 0
        cols : GTensor stemp[ vec i64 [] [ cin * kw, bt ] ]
        im2col[ x, cols, nb, cin, nt, kw, st, pd, dl, gp, tout ]
        ym : GTensor stemp[ vec i64 [] [ cout, bt ] ]
        gemm[ GView [ t: w, rs: cg * kw, cs: 1, bs: og * cg * kw ],
              GView [ t: cols, rs: bt, cs: 1, bs: cg * kw * bt ],
              GView [ t: ym, rs: bt, cs: 1, bs: og * bt ], og, bt,
              cg * kw, i64[ gp ], 1.0, 0.0 ]
        y : GTensor temp[ vec i64 [] [ nb, cout, tout ] ]
        regroup[ ym, y, b, nb, cout, tout, 1, 0.0 ]
        if [ keeps[ x ] || keeps[ w ] || keeps[ b ] ]
            y.need = true
            tape.push[
                GConvOp [ kind: 1, out: y, x: x, w: w, b: b, st: st,
                          pd: pd, dl: dl, gp: gp ] ]
        return y

    func conv1d_back [ rec: GConvOp ]
        x : GTensor rec.x
        w : GTensor rec.w
        dy : GTensor rec.out.gr
        if [ !dy ] return
        nb : i64 [ x.dims[ 0 ] ]
        cin : i64 [ x.dims[ 1 ] ]
        nt : i64 [ x.dims[ 2 ] ]
        cout : i64 [ w.dims[ 0 ] ]
        kw : i64 [ w.dims[ 2 ] ]
        tout : i64 [ rec.out.dims[ 2 ] ]
        gp : i64 [ rec.gp ]
        cg : i64 [ cin / gp ]
        og : i64 [ cout / gp ]
        bt : i64 [ nb * tout ]
        scratch.top = 0
        dm : GTensor stemp[ vec i64 [] [ cout, bt ] ]
        regroup[ dy, dm, null, nb, cout, tout, 0, 0.0 ]
        if [ rec.b && rec.b.need ]
            row_sums[ dm, grad_of[ rec.b ], cout, bt ]
        if [ w.need ]
            # the columns again: cheaper than keeping them
            cols : GTensor stemp[ vec i64 [] [ cin * kw, bt ] ]
            im2col[ x, cols, nb, cin, nt, kw, rec.st, rec.pd, rec.dl,
                    rec.gp, tout ]
            gemm[ GView [ t: dm, rs: bt, cs: 1, bs: og * bt ],
                  GView [ t: cols, rs: 1, cs: bt, bs: cg * kw * bt ],
                  GView [ t: grad_of[ w ], rs: cg * kw, cs: 1,
                          bs: og * cg * kw ], og, cg * kw, bt, gp, 1.0,
                          1.0 ]
        if [ x.need ]
            dc : GTensor stemp[ vec i64 [] [ cin * kw, bt ] ]
            gemm[ GView [ t: w, rs: 1, cs: cg * kw, bs: og * cg * kw ],
                  GView [ t: dm, rs: bt, cs: 1, bs: og * bt ],
                  GView [ t: dc, rs: bt, cs: 1, bs: cg * kw * bt ],
                  cg * kw, bt, og, gp, 1.0, 0.0 ]
            col2im[ dc, grad_of[ x ], nb, cin, nt, kw, rec.st, rec.pd,
                    rec.dl, tout ]

    # pytorch's conv_transpose1d: w [cin, cout, k]
    func convt1d [ x: GTensor, w: GTensor, b: GTensor, st: i32,
                   pd: i32 ] -> GTensor
        nb : i64 [ x.dims[ 0 ] ]
        cin : i64 [ x.dims[ 1 ] ]
        nt : i64 [ x.dims[ 2 ] ]
        cout : i64 [ w.dims[ 1 ] ]
        kw : i64 [ w.dims[ 2 ] ]
        tout : i64 [ (nt - 1) * i64[ st ] - 2 * i64[ pd ] + kw ]
        bt : i64 [ nb * nt ]
        scratch.top = 0
        xp : GTensor stemp[ vec i64 [] [ cin, bt ] ]
        regroup[ x, xp, null, nb, cin, nt, 0, 0.0 ]
        # cols[(co, k)][b*t] = sum over ci of w x
        cols : GTensor stemp[ vec i64 [] [ cout * kw, bt ] ]
        gemm[ GView [ t: w, rs: 1, cs: cout * kw, bs: 0 ],
              GView [ t: xp, rs: bt, cs: 1, bs: 0 ],
              GView [ t: cols, rs: bt, cs: 1, bs: 0 ], cout * kw, bt,
              cin, 1, 1.0, 0.0 ]
        y : GTensor temp[ vec i64 [] [ nb, cout, tout ] ]
        convt_gather[ cols, y, b, nb, cout, nt, kw, st, pd, tout ]
        if [ keeps[ x ] || keeps[ w ] || keeps[ b ] ]
            y.need = true
            tape.push[
                GConvTOp [ kind: 2, out: y, xin: x, wt: w, bias: b,
                           t_st: st, t_pd: pd ] ]
        return y

    # y[b, co, to] = bias + every tap landing on to
    func convt_gather [ cols: GTensor, y: GTensor, b: GTensor, nb: i64,
                        cout: i64, nt: i64, kw: i64, st: i32, pd: i32,
                        tout: i64 ]
        k : GKernel kernel[ 'convt_gather', KConvtGather [] ]
        g : GArgs []
        g.ad[ 0 ] = cols.addr[]
        g.ad[ 1 ] = y.addr[]
        g.ad[ 2 ] = (b) ? b.addr[] : u64[ 0 ]
        g.nn[ 0 ] = i32[ nb ]
        g.nn[ 1 ] = i32[ cout ]
        g.nn[ 2 ] = i32[ nt ]
        g.nn[ 3 ] = i32[ kw ]
        g.nn[ 4 ] = st
        g.nn[ 5 ] = pd
        g.nn[ 8 ] = i32[ tout ]
        rn.dispatch[ k, g, groups[ nb * cout * tout ], 1, 1 ]

    func convt1d_back [ rec: GConvTOp ]
        x : GTensor rec.xin
        w : GTensor rec.wt
        dy : GTensor rec.out.gr
        if [ !dy ] return
        nb : i64 [ x.dims[ 0 ] ]
        cin : i64 [ x.dims[ 1 ] ]
        nt : i64 [ x.dims[ 2 ] ]
        cout : i64 [ w.dims[ 1 ] ]
        kw : i64 [ w.dims[ 2 ] ]
        tout : i64 [ rec.out.dims[ 2 ] ]
        bt : i64 [ nb * nt ]
        scratch.top = 0
        if [ rec.bias && rec.bias.need ]
            dm : GTensor stemp[ vec i64 [] [ cout, nb * tout ] ]
            regroup[ dy, dm, null, nb, cout, tout, 0, 0.0 ]
            row_sums[ dm, grad_of[ rec.bias ], cout, nb * tout ]
        # dcols is dy unrolled like im2col
        dc : GTensor stemp[ vec i64 [] [ cout * kw, bt ] ]
        im2col_t[ dy, dc, nb, cout, tout, kw, rec.t_st, rec.t_pd, nt ]
        if [ w.need ]
            xp : GTensor stemp[ vec i64 [] [ cin, bt ] ]
            regroup[ x, xp, null, nb, cin, nt, 0, 0.0 ]
            gemm[ GView [ t: xp, rs: bt, cs: 1, bs: 0 ],
                  GView [ t: dc, rs: 1, cs: bt, bs: 0 ],
                  GView [ t: grad_of[ w ], rs: cout * kw, cs: 1, bs: 0 ],
                  cin, cout * kw, bt, 1, 1.0, 1.0 ]
        if [ x.need ]
            dxp : GTensor stemp[ vec i64 [] [ cin, bt ] ]
            gemm[ GView [ t: w, rs: cout * kw, cs: 1, bs: 0 ],
                  GView [ t: dc, rs: bt, cs: 1, bs: 0 ],
                  GView [ t: dxp, rs: bt, cs: 1, bs: 0 ], cin, bt,
                  cout * kw, 1, 1.0, 0.0 ]
            regroup[ dxp, grad_of[ x ], null, nb, cin, nt, 1, 1.0 ]

    # dy unrolled as a transposed conv's columns
    func im2col_t [ dy: GTensor, dc: GTensor, nb: i64, cout: i64,
                    tout: i64, kw: i64, st: i32, pd: i32, nt: i64 ]
        k : GKernel kernel[ 'im2col_t', KIm2colT [] ]
        g : GArgs []
        g.ad[ 0 ] = dy.addr[]
        g.ad[ 1 ] = dc.addr[]
        g.nn[ 0 ] = i32[ nb ]
        g.nn[ 1 ] = i32[ cout ]
        g.nn[ 2 ] = i32[ tout ]
        g.nn[ 3 ] = i32[ kw ]
        g.nn[ 4 ] = st
        g.nn[ 5 ] = pd
        g.nn[ 8 ] = i32[ nt ]
        rn.dispatch[ k, g, groups[ cout * kw * nb * nt ], 1, 1 ]

    # the first n dims of src, then last
    func dims_with [ src: vec i64, n: i64, last: i64 ] -> vec i64
        od : vec i64 [ n + 1 ]
        for [ i: i64 0, i < n, i += 1 ]
            od[ i ] = src[ i ]
        od[ n ] = last
        return od

    func dims3 [ nb: i64, c: i64, nt: i64 ] -> vec i64
        return vec i64 [] [ nb, c, nt ]

    func unary [ x: GTensor, code: i32, f0: f32 ] -> GTensor
        k : GKernel kernel[ 'unary', KUnary [] ]
        y : GTensor temp[ x.dims ]
        g : GArgs []
        g.ad[ 0 ] = x.addr[]
        g.ad[ 1 ] = y.addr[]
        g.nn[ 0 ] = i32[ x.count ]
        g.nn[ 1 ] = code
        g.ff[ 0 ] = f0
        rn.dispatch[ k, g, groups[ x.count ], 1, 1 ]
        if [ keeps[ x ] ]
            y.need = true
            tape.push[
                GUnaryOp [ kind: 3, out: y, ux: x, code: code,
                           f0: f0 ] ]
        return y

    func unary_back [ rec: GUnaryOp ]
        k : GKernel kernel[ 'unary_back', KUnaryBack [] ]
        if [ !rec.out.gr || !rec.ux.need ] return
        g : GArgs []
        g.ad[ 0 ] = rec.ux.addr[]
        g.ad[ 1 ] = rec.out.addr[]
        g.ad[ 2 ] = rec.out.gr.addr[]
        g.ad[ 3 ] = grad_of[ rec.ux ].addr[]
        g.nn[ 0 ] = i32[ rec.ux.count ]
        g.nn[ 1 ] = rec.code
        g.ff[ 0 ] = rec.f0
        rn.dispatch[ k, g, groups[ rec.ux.count ], 1, 1 ]

    func leaky [ x: GTensor, slope: f32 ] -> GTensor
        return unary[ x, 1, slope ]
    func tanh_of [ x: GTensor ] -> GTensor
        return unary[ x, 2, 0.0 ]
    func sigmoid [ x: GTensor ] -> GTensor
        return unary[ x, 3, 0.0 ]
    func exp_of [ x: GTensor ] -> GTensor
        return unary[ x, 4, 0.0 ]
    func scale [ x: GTensor, v: f32 ] -> GTensor
        return unary[ x, 5, v ]

    # z's steps over x's [b, c, t]; 0 where z has length 1
    func steps_of [ x: GTensor, z: GTensor ] -> vec i64
        zb : i64 [ (z.dims.count == 3) ? z.dims[ 0 ] : 1 ]
        zc : i64 [ (z.dims.count == 3) ? z.dims[ 1 ] : z.dims[ 0 ] ]
        zt : i64 [ (z.dims.count == 3) ? z.dims[ 2 ] : 1 ]
        return vec i64 [] [ (zb == 1) ? 0 : zc * zt, (zc == 1) ? 0 : zt,
                            (zt == 1) ? 0 : 1 ]

    # x + z or x * z; z [b, c, t], [c], [b, c, 1] or [b, 1, t]
    func bin [ x: GTensor, z: GTensor, mul: bool ] -> GTensor
        k : GKernel kernel[ 'bin', KBin [] ]
        st : vec i64 steps_of[ x, z ]
        y : GTensor temp[ x.dims ]
        g : GArgs []
        g.ad[ 0 ] = x.addr[]
        g.ad[ 1 ] = z.addr[]
        g.ad[ 2 ] = y.addr[]
        g.nn[ 0 ] = i32[ x.dims[ 0 ] ]
        g.nn[ 1 ] = i32[ x.dims[ 1 ] ]
        g.nn[ 2 ] = i32[ x.dims[ 2 ] ]
        g.nn[ 3 ] = i32[ st[ 0 ] ]
        g.nn[ 4 ] = i32[ st[ 1 ] ]
        g.nn[ 5 ] = i32[ st[ 2 ] ]
        g.nn[ 6 ] = (mul) ? 1 : 0
        rn.dispatch[ k, g, groups[ x.count ], 1, 1 ]
        if [ keeps[ x ] || keeps[ z ] ]
            y.need = true
            tape.push[
                GBinOp [ kind: 4, out: y, bx: x, bz: z, mul: mul,
                         sb: st[ 0 ], sc: st[ 1 ], stt: st[ 2 ] ] ]
        return y

    func add [ x: GTensor, z: GTensor ] -> GTensor
        return bin[ x, z, false ]
    func mul [ x: GTensor, z: GTensor ] -> GTensor
        return bin[ x, z, true ]

    func bin_back [ rec: GBinOp ]
        dy : GTensor rec.out.gr
        if [ !dy ] return
        x : GTensor rec.bx
        z : GTensor rec.bz
        nb : i64 [ x.dims[ 0 ] ]
        nc : i64 [ x.dims[ 1 ] ]
        nt : i64 [ x.dims[ 2 ] ]
        if [ x.need ]
            k : GKernel kernel[ 'bin_dx', KBinDx [] ]
            g : GArgs []
            g.ad[ 0 ] = dy.addr[]
            g.ad[ 1 ] = z.addr[]
            g.ad[ 2 ] = grad_of[ x ].addr[]
            g.nn[ 0 ] = i32[ nb ]
            g.nn[ 1 ] = i32[ nc ]
            g.nn[ 2 ] = i32[ nt ]
            g.nn[ 3 ] = i32[ rec.sb ]
            g.nn[ 4 ] = i32[ rec.sc ]
            g.nn[ 5 ] = i32[ rec.stt ]
            g.nn[ 6 ] = (rec.mul) ? 1 : 0
            rn.dispatch[ k, g, groups[ x.count ], 1, 1 ]
        if [ z.need && z.count == x.count ]
            # no broadcast: dz is elementwise, as dx is
            k3 : GKernel kernel[ 'bin_dx', KBinDx [] ]
            g3 : GArgs []
            g3.ad[ 0 ] = dy.addr[]
            g3.ad[ 1 ] = x.addr[]
            g3.ad[ 2 ] = grad_of[ z ].addr[]
            g3.nn[ 0 ] = i32[ nb ]
            g3.nn[ 1 ] = i32[ nc ]
            g3.nn[ 2 ] = i32[ nt ]
            g3.nn[ 3 ] = i32[ nc * nt ]
            g3.nn[ 4 ] = i32[ nt ]
            g3.nn[ 5 ] = 1
            g3.nn[ 6 ] = (rec.mul) ? 1 : 0
            rn.dispatch[ k3, g3, groups[ x.count ], 1, 1 ]
        el [ z.need ]
            # one workgroup per z value sums every x position it met
            k2 : GKernel kernel[ 'bin_dz', KBinDz [] ]
            g2 : GArgs []
            g2.ad[ 0 ] = dy.addr[]
            g2.ad[ 1 ] = x.addr[]
            g2.ad[ 2 ] = grad_of[ z ].addr[]
            g2.nn[ 0 ] = i32[ nb ]
            g2.nn[ 1 ] = i32[ nc ]
            g2.nn[ 2 ] = i32[ nt ]
            g2.nn[ 3 ] = i32[ rec.sb ]
            g2.nn[ 4 ] = i32[ rec.sc ]
            g2.nn[ 5 ] = i32[ rec.stt ]
            g2.nn[ 6 ] = (rec.mul) ? 1 : 0
            rn.dispatch[ k2, g2, i32[ z.count ], 1, 1 ]

    # tanh(x[:, :h] + g[:, :h]) * sigmoid(x[:, h:] + g[:, h:])
    func gate [ x: GTensor, gc: GTensor ] -> GTensor
        k : GKernel kernel[ 'gate', KGate [] ]
        nb : i64 [ x.dims[ 0 ] ]
        h : i64 [ x.dims[ 1 ] / 2 ]
        nt : i64 [ x.dims[ 2 ] ]
        y : GTensor temp[ dims3[ nb, h, nt ] ]
        g : GArgs []
        g.ad[ 0 ] = x.addr[]
        g.ad[ 1 ] = (gc) ? gc.addr[] : u64[ 0 ]
        g.ad[ 2 ] = y.addr[]
        g.nn[ 0 ] = i32[ nb ]
        g.nn[ 1 ] = i32[ h ]
        g.nn[ 2 ] = i32[ nt ]
        rn.dispatch[ k, g, groups[ y.count ], 1, 1 ]
        if [ keeps[ x ] || keeps[ gc ] ]
            y.need = true
            tape.push[ GGateOp [ kind: 5, out: y, gx: x, gc: gc ] ]
        return y

    func gate_back [ rec: GGateOp ]
        dy : GTensor rec.out.gr
        if [ !dy ] return
        x : GTensor rec.gx
        nb : i64 [ x.dims[ 0 ] ]
        h : i64 [ x.dims[ 1 ] / 2 ]
        nt : i64 [ x.dims[ 2 ] ]
        # both halves' gradients, then x's and g's from them
        dxx : GTensor temp[ x.dims ]
        k : GKernel kernel[ 'gate_back', KGateBack [] ]
        g : GArgs []
        g.ad[ 0 ] = x.addr[]
        g.ad[ 1 ] = (rec.gc) ? rec.gc.addr[] : u64[ 0 ]
        g.ad[ 2 ] = dy.addr[]
        g.ad[ 3 ] = dxx.addr[]
        g.nn[ 0 ] = i32[ nb ]
        g.nn[ 1 ] = i32[ h ]
        g.nn[ 2 ] = i32[ nt ]
        rn.dispatch[ k, g, groups[ nb * h * nt ], 1, 1 ]
        if [ x.need ] axpby[ dxx, grad_of[ x ], 1.0, 1.0 ]
        if [ rec.gc && rec.gc.need ]
            # g is [b, 2h, 1]: its gradient sums dxx over t
            row_sums[ dxx, grad_of[ rec.gc ], nb * 2 * h, nt ]

    # channels c0 .. c0 + n of x [b, c, t]
    func slice [ x: GTensor, c0: i64, n: i64 ] -> GTensor
        nb : i64 [ x.dims[ 0 ] ]
        nt : i64 [ x.dims[ 2 ] ]
        y : GTensor temp[ dims3[ nb, n, nt ] ]
        chan_copy[ x, y, nb, x.dims[ 1 ], n, nt, c0, 0, 0.0 ]
        if [ keeps[ x ] ]
            y.need = true
            tape.push[ GSliceOp [ kind: 6, out: y, sx: x, c0: c0 ] ]
        return y

    # n channels from s0 into d0: dst = beta dst + src
    func chan_copy [ src: GTensor, dst: GTensor, nb: i64, cs: i64,
                     n: i64, nt: i64, s0: i64, d0: i64, beta: f32 ]
        k : GKernel kernel[ 'chan_copy', KChanCopy [] ]
        g : GArgs []
        g.ad[ 0 ] = src.addr[]
        g.ad[ 1 ] = dst.addr[]
        g.nn[ 0 ] = i32[ nb ]
        g.nn[ 1 ] = i32[ n ]
        g.nn[ 2 ] = i32[ nt ]
        g.nn[ 3 ] = i32[ cs ]
        g.nn[ 4 ] = i32[ dst.dims[ 1 ] ]
        g.nn[ 5 ] = i32[ s0 ]
        g.nn[ 6 ] = i32[ d0 ]
        g.ff[ 0 ] = beta
        rn.dispatch[ k, g, groups[ nb * n * nt ], 1, 1 ]

    func slice_back [ rec: GSliceOp ]
        dy : GTensor rec.out.gr
        if [ !dy || !rec.sx.need ] return
        chan_copy[ dy, grad_of[ rec.sx ], dy.dims[ 0 ], dy.dims[ 1 ],
                   dy.dims[ 1 ], dy.dims[ 2 ], 0, rec.c0, 1.0 ]

    func join [ x: GTensor, z: GTensor ] -> GTensor
        nb : i64 [ x.dims[ 0 ] ]
        nt : i64 [ x.dims[ 2 ] ]
        cx : i64 [ x.dims[ 1 ] ]
        cz : i64 [ z.dims[ 1 ] ]
        y : GTensor temp[ dims3[ nb, cx + cz, nt ] ]
        chan_copy[ x, y, nb, cx, cx, nt, 0, 0, 0.0 ]
        chan_copy[ z, y, nb, cz, cz, nt, 0, cx, 0.0 ]
        if [ keeps[ x ] || keeps[ z ] ]
            y.need = true
            tape.push[ GJoinOp [ kind: 7, out: y, jx: x, jz: z ] ]
        return y

    func join_back [ rec: GJoinOp ]
        dy : GTensor rec.out.gr
        if [ !dy ] return
        nb : i64 [ dy.dims[ 0 ] ]
        nt : i64 [ dy.dims[ 2 ] ]
        cx : i64 [ rec.jx.dims[ 1 ] ]
        cz : i64 [ rec.jz.dims[ 1 ] ]
        if [ rec.jx.need ]
            chan_copy[ dy, grad_of[ rec.jx ], nb, cx + cz, cx, nt, 0, 0,
                       1.0 ]
        if [ rec.jz.need ]
            chan_copy[ dy, grad_of[ rec.jz ], nb, cx + cz, cz, nt, cx, 0,
                       1.0 ]

    # layer norm over the channels of [b, c, t], eps 1e-5
    func layer_norm [ x: GTensor, gamma: GTensor,
                      beta: GTensor ] -> GTensor
        k : GKernel kernel[ 'lnorm', KLnorm [] ]
        nb : i64 [ x.dims[ 0 ] ]
        nc : i64 [ x.dims[ 1 ] ]
        nt : i64 [ x.dims[ 2 ] ]
        y : GTensor temp[ x.dims ]
        mean : GTensor temp[ vec i64 [] [ nb * nt ] ]
        rstd : GTensor temp[ vec i64 [] [ nb * nt ] ]
        g : GArgs []
        g.ad[ 0 ] = x.addr[]
        g.ad[ 1 ] = gamma.addr[]
        g.ad[ 2 ] = beta.addr[]
        g.ad[ 3 ] = y.addr[]
        g.ad[ 4 ] = mean.addr[]
        g.ad[ 5 ] = rstd.addr[]
        g.nn[ 0 ] = i32[ nb ]
        g.nn[ 1 ] = i32[ nc ]
        g.nn[ 2 ] = i32[ nt ]
        if [ nt == 1 ]
            kr : GKernel kernel[ 'lnorm_row', KLnormRow [] ]
            rn.dispatch[ kr, g, i32[ nb ], 1, 1 ]
        el
            rn.dispatch[ k, g, groups[ nb * nt ], 1, 1 ]
        if [ keeps[ x ] || keeps[ gamma ] || keeps[ beta ] ]
            y.need = true
            tape.push[
                GNormOp [ kind: 8, out: y, nx: x, gamma: gamma,
                          beta: beta, mean: mean, rstd: rstd ] ]
        return y

    func norm_back [ rec: GNormOp ]
        dy : GTensor rec.out.gr
        if [ !dy ] return
        x : GTensor rec.nx
        nb : i64 [ x.dims[ 0 ] ]
        nc : i64 [ x.dims[ 1 ] ]
        nt : i64 [ x.dims[ 2 ] ]
        if [ x.need ]
            k : GKernel kernel[ 'lnorm_dx', KLnormDx [] ]
            g : GArgs []
            g.ad[ 0 ] = x.addr[]
            g.ad[ 1 ] = rec.gamma.addr[]
            g.ad[ 2 ] = dy.addr[]
            g.ad[ 3 ] = grad_of[ x ].addr[]
            g.ad[ 4 ] = rec.mean.addr[]
            g.ad[ 5 ] = rec.rstd.addr[]
            g.nn[ 0 ] = i32[ nb ]
            g.nn[ 1 ] = i32[ nc ]
            g.nn[ 2 ] = i32[ nt ]
            if [ nt == 1 ]
                kr : GKernel kernel[ 'lnorm_row_dx', KLnormRowDx [] ]
                rn.dispatch[ kr, g, i32[ nb ], 1, 1 ]
            el
                rn.dispatch[ k, g, groups[ nb * nt ], 1, 1 ]
        if [ rec.gamma.need || rec.beta.need ]
            # per channel: sum over (b, t) of dy * xhat, and of dy
            k2 : GKernel kernel[ 'lnorm_dg', KLnormDg [] ]
            g2 : GArgs []
            g2.ad[ 0 ] = x.addr[]
            g2.ad[ 1 ] = (rec.gamma.need) ? grad_of[
                rec.gamma ].addr[] : u64[ 0 ]
            g2.ad[ 2 ] = dy.addr[]
            g2.ad[ 3 ] = (rec.beta.need) ? grad_of[
                rec.beta ].addr[] : u64[ 0 ]
            g2.ad[ 4 ] = rec.mean.addr[]
            g2.ad[ 5 ] = rec.rstd.addr[]
            g2.nn[ 0 ] = i32[ nb ]
            g2.nn[ 1 ] = i32[ nc ]
            g2.nn[ 2 ] = i32[ nt ]
            rn.dispatch[ k2, g2, i32[ nc ], 1, 1 ]

    func attn_args [ q: GTensor, nh: i64, win: i64,
                     causal: bool ] -> GArgs
        g : GArgs []
        g.nn[ 0 ] = i32[ q.dims[ 0 ] ]
        g.nn[ 1 ] = i32[ nh ]
        g.nn[ 2 ] = i32[ q.dims[ 1 ] / nh ]
        g.nn[ 3 ] = i32[ q.dims[ 2 ] ]
        g.nn[ 4 ] = i32[ win ]
        g.nn[ 5 ] = (causal) ? 1 : 0
        g.ff[ 0 ] = f32[ 1.0 / sqrt[ f64[ q.dims[ 1 ] / nh ] ] ]
        return g

    func attention [ q: GTensor, kk: GTensor, v: GTensor, ek: GTensor,
                     ev: GTensor, am: GTensor, nh: i64,
                     win: i64 ] -> GTensor
        return attention_run[ q, kk, v, ek, ev, am, nh, win, false ]

    # a language model's attention: no relative tables, no mask
    func causal_attention [ q: GTensor, kk: GTensor, v: GTensor,
                            nh: i64 ] -> GTensor
        return attention_run[ q, kk, v, null, null, null, nh, 0, true ]

    func attention_run [ q: GTensor, kk: GTensor, v: GTensor,
                         ek: GTensor, ev: GTensor, am: GTensor,
                         nh: i64, win: i64, causal: bool ] -> GTensor
        nb : i64 [ q.dims[ 0 ] ]
        nc : i64 [ q.dims[ 1 ] ]
        nt : i64 [ q.dims[ 2 ] ]
        dk : i64 [ nc / nh ]
        z : i64 [ nb * nh ]
        sc : f32 [ 1.0 / sqrt[ f64[ dk ] ] ]
        pr : GTensor temp[ vec i64 [] [ z, nt, nt ] ]
        gemm[ GView [ t: q, rs: 1, cs: nt, bs: dk * nt ],
              GView [ t: kk, rs: nt, cs: 1, bs: dk * nt ],
              GView [ t: pr, rs: nt, cs: 1, bs: nt * nt ], nt, nt, dk, z,
              sc, 0.0 ]
        # relative keys, the mask, then softmax per row
        k1 : GKernel kernel[ 'attn_rel_soft', KAttnRelSoft [] ]
        g : GArgs attn_args[ q, nh, win, causal ]
        g.ad[ 0 ] = q.addr[]
        g.ad[ 1 ] = (ek) ? ek.addr[] : u64[ 0 ]
        g.ad[ 2 ] = pr.addr[]
        g.ad[ 3 ] = (am) ? am.addr[] : u64[ 0 ]
        rn.dispatch[ k1, g, i32[ z * nt ], 1, 1 ]
        o : GTensor temp[ q.dims ]
        gemm[ GView [ t: pr, rs: nt, cs: 1, bs: nt * nt ],
              GView [ t: v, rs: 1, cs: nt, bs: dk * nt ],
              GView [ t: o, rs: 1, cs: nt, bs: dk * nt ], nt, dk, nt, z,
              1.0, 0.0 ]
        if [ ev ]
            k2 : GKernel kernel[ 'attn_rel_v', KAttnRelV [] ]
            g2 : GArgs attn_args[ q, nh, win, causal ]
            g2.ad[ 0 ] = pr.addr[]
            g2.ad[ 1 ] = ev.addr[]
            g2.ad[ 2 ] = o.addr[]
            rn.dispatch[ k2, g2, groups[ o.count ], 1, 1 ]
        if [
            keeps[ q ] || keeps[ kk ] || keeps[ v ] || keeps[ ek ]
            || keeps[ ev ] ]
            o.need = true
            tape.push[
                GAttnOp [ kind: 9, out: o, q: q, kk: kk, v: v, ek: ek,
                          ev: ev, am: am, pr: pr, nh: nh, win: win,
                          causal: causal ] ]
        return o

    func attn_back [ rec: GAttnOp ]
        dout : GTensor rec.out.gr
        if [ !dout ] return
        q : GTensor rec.q
        nb : i64 [ q.dims[ 0 ] ]
        nc : i64 [ q.dims[ 1 ] ]
        nt : i64 [ q.dims[ 2 ] ]
        nh : i64 [ rec.nh ]
        dk : i64 [ nc / nh ]
        z : i64 [ nb * nh ]
        sc : f32 [ 1.0 / sqrt[ f64[ dk ] ] ]
        pr : GTensor rec.pr
        # dP = dO^T v + relative values, then softmax back
        dp : GTensor temp[ vec i64 [] [ z, nt, nt ] ]
        gemm[ GView [ t: dout, rs: 1, cs: nt, bs: dk * nt ],
              GView [ t: rec.v, rs: nt, cs: 1, bs: dk * nt ],
              GView [ t: dp, rs: nt, cs: 1, bs: nt * nt ], nt, nt, dk, z,
              1.0, 0.0 ]
        k1 : GKernel kernel[ 'attn_soft_back', KAttnSoftBack [] ]
        g1 : GArgs attn_args[ q, nh, rec.win, rec.causal ]
        g1.ad[ 0 ] = pr.addr[]
        g1.ad[ 1 ] = dp.addr[]
        g1.ad[ 2 ] = (rec.ev) ? rec.ev.addr[] : u64[ 0 ]
        g1.ad[ 3 ] = dout.addr[]
        # a masked score passes no gradient
        g1.ad[ 4 ] = (rec.am) ? rec.am.addr[] : u64[ 0 ]
        rn.dispatch[ k1, g1, i32[ z * nt ], 1, 1 ]
        # dp now holds dS
        if [ q.need ]
            dq : GTensor grad_of[ q ]
            gemm[ GView [ t: dp, rs: nt, cs: 1, bs: nt * nt ],
                  GView [ t: rec.kk, rs: 1, cs: nt, bs: dk * nt ],
                  GView [ t: dq, rs: 1, cs: nt, bs: dk * nt ], nt, dk,
                  nt, z, sc, 1.0 ]
            if [ rec.ek ]
                k2 : GKernel kernel[ 'attn_dq_rel', KAttnDqRel [] ]
                g2 : GArgs attn_args[ q, nh, rec.win, rec.causal ]
                g2.ad[ 0 ] = dp.addr[]
                g2.ad[ 1 ] = rec.ek.addr[]
                g2.ad[ 2 ] = dq.addr[]
                rn.dispatch[ k2, g2, groups[ q.count ], 1, 1 ]
        if [ rec.kk.need ]
            gemm[ GView [ t: q, rs: nt, cs: 1, bs: dk * nt ],
                  GView [ t: dp, rs: nt, cs: 1, bs: nt * nt ],
                  GView [ t: grad_of[ rec.kk ], rs: nt, cs: 1,
                          bs: dk * nt ], dk, nt, nt, z, sc, 1.0 ]
        # dv(d, j) = sum over i of dO(d, i) P(i, j)
        if [ rec.v.need ]
            gemm[ GView [ t: dout, rs: nt, cs: 1, bs: dk * nt ],
                  GView [ t: pr, rs: nt, cs: 1, bs: nt * nt ],
                  GView [ t: grad_of[ rec.v ], rs: nt, cs: 1,
                          bs: dk * nt ], dk, nt, nt, z, 1.0, 1.0 ]
        # a workgroup per table entry sums every (z, i)
        k3 : GKernel kernel[ 'attn_dtab', KAttnDtab [] ]
        nr : i64 [ 2 * rec.win + 1 ]
        if [ rec.ek && rec.ek.need ]
            g3 : GArgs attn_args[ q, nh, rec.win, rec.causal ]
            g3.ad[ 0 ] = dp.addr[]
            g3.ad[ 1 ] = q.addr[]
            g3.ad[ 2 ] = grad_of[ rec.ek ].addr[]
            g3.ff[ 1 ] = sc
            rn.dispatch[ k3, g3, i32[ nr * dk ], 1, 1 ]
        if [ rec.ev && rec.ev.need ]
            g4 : GArgs attn_args[ q, nh, rec.win, rec.causal ]
            g4.ad[ 0 ] = pr.addr[]
            g4.ad[ 1 ] = dout.addr[]
            g4.ad[ 2 ] = grad_of[ rec.ev ].addr[]
            g4.ff[ 1 ] = 1.0
            rn.dispatch[ k3, g4, i32[ nr * dk ], 1, 1 ]

    # [b, a, c] into [b, c, a] as dst = beta * dst + src
    func swap_into [ src: GTensor, dst: GTensor, nb: i64, na: i64,
                     nc: i64, beta: f32 ]
        k : GKernel kernel[ 'swap12', KSwap12 [] ]
        g : GArgs []
        g.ad[ 0 ] = src.addr[]
        g.ad[ 1 ] = dst.addr[]
        g.nn[ 0 ] = i32[ nb ]
        g.nn[ 1 ] = i32[ na ]
        g.nn[ 2 ] = i32[ nc ]
        g.ff[ 0 ] = beta
        rn.dispatch[ k, g, groups[ nb * na * nc ], 1, 1 ]

    func swap12 [ x: GTensor ] -> GTensor
        nb : i64 [ x.dims[ 0 ] ]
        na : i64 [ x.dims[ 1 ] ]
        nc : i64 [ x.dims[ 2 ] ]
        y : GTensor temp[ dims3[ nb, nc, na ] ]
        swap_into[ x, y, nb, na, nc, 0.0 ]
        if [ keeps[ x ] ]
            y.need = true
            tape.push[ GSwapOp [ kind: 10, out: y, wx: x ] ]
        return y

    func swap_back [ rec: GSwapOp ]
        dy : GTensor rec.out.gr
        if [ !dy || !rec.wx.need ] return
        swap_into[ dy, grad_of[ rec.wx ], dy.dims[ 0 ], dy.dims[ 1 ],
                   dy.dims[ 2 ], 1.0 ]

    # db[c] += the sum of column c of m [rows][c]
    func col_sums [ m: GTensor, db: GTensor, rows: i64, nc: i64 ]
        k : GKernel kernel[ 'col_sums', KColSums [] ]
        g : GArgs []
        g.ad[ 0 ] = m.addr[]
        g.ad[ 1 ] = db.addr[]
        g.nn[ 0 ] = i32[ rows ]
        g.nn[ 1 ] = i32[ nc ]
        rn.dispatch[ k, g, i32[ nc ], 1, 1 ]

    # x's rows through w [out, in] and b
    func linear [ x: GTensor, w: GTensor, b: GTensor ] -> GTensor
        nin : i64 [ w.dims[ 1 ] ]
        nout : i64 [ w.dims[ 0 ] ]
        rows : i64 [ x.count / nin ]
        od : vec i64 dims_with[ x.dims, x.dims.count - 1, nout ]
        y : GTensor temp[ od ]
        gemm[ GView [ t: x, rs: nin, cs: 1, bs: 0 ],
              GView [ t: w, rs: 1, cs: nin, bs: 0 ],
              GView [ t: y, rs: nout, cs: 1, bs: 0 ], rows, nout, nin, 1,
              1.0, 0.0 ]
        if [ b ] bin_rows[ y, b, rows, nout ]
        if [ keeps[ x ] || keeps[ w ] || keeps[ b ] ]
            y.need = true
            tape.push[
                GLinOp [ kind: 11, out: y, lx: x, lw: w, lb: b ] ]
        return y

    # every row of y [rows, n] plus b [n]
    func bin_rows [ y: GTensor, b: GTensor, rows: i64, n: i64 ]
        k : GKernel kernel[ 'bin', KBin [] ]
        g : GArgs []
        g.ad[ 0 ] = y.addr[]
        g.ad[ 1 ] = b.addr[]
        g.ad[ 2 ] = y.addr[]
        g.nn[ 0 ] = i32[ rows ]
        g.nn[ 1 ] = 1
        g.nn[ 2 ] = i32[ n ]
        g.nn[ 3 ] = 0
        g.nn[ 4 ] = 0
        g.nn[ 5 ] = 1
        g.nn[ 6 ] = 0
        rn.dispatch[ k, g, groups[ rows * n ], 1, 1 ]

    func linear_back [ rec: GLinOp ]
        dy : GTensor rec.out.gr
        if [ !dy ] return
        nin : i64 [ rec.lw.dims[ 1 ] ]
        nout : i64 [ rec.lw.dims[ 0 ] ]
        rows : i64 [ rec.lx.count / nin ]
        if [ rec.lx.need ]
            gemm[ GView [ t: dy, rs: nout, cs: 1, bs: 0 ],
                  GView [ t: rec.lw, rs: nin, cs: 1, bs: 0 ],
                  GView [ t: grad_of[ rec.lx ], rs: nin, cs: 1, bs: 0 ],
                  rows, nin, nout, 1, 1.0, 1.0 ]
        if [ rec.lw.need ]
            gemm[ GView [ t: dy, rs: 1, cs: nout, bs: 0 ],
                  GView [ t: rec.lx, rs: nin, cs: 1, bs: 0 ],
                  GView [ t: grad_of[ rec.lw ], rs: nin, cs: 1, bs: 0 ],
                  nout, nin, rows, 1, 1.0, 1.0 ]
        if [ rec.lb && rec.lb.need ]
            col_sums[ dy, grad_of[ rec.lb ], rows, nout ]

    # rows of tab [v, d] by ids into [ids' dims, d]
    func lookup [ ids: GTensor, tab: GTensor ] -> GTensor
        d : i64 [ tab.dims[ 1 ] ]
        od : vec i64 dims_with[ ids.dims, ids.dims.count, d ]
        y : GTensor temp[ od ]
        k : GKernel kernel[ 'lookup', KLookup [] ]
        g : GArgs []
        g.ad[ 0 ] = ids.addr[]
        g.ad[ 1 ] = tab.addr[]
        g.ad[ 2 ] = y.addr[]
        g.nn[ 0 ] = i32[ ids.count ]
        g.nn[ 1 ] = i32[ d ]
        rn.dispatch[ k, g, groups[ y.count ], 1, 1 ]
        if [ keeps[ tab ] ]
            y.need = true
            tape.push[
                GLookOp [ kind: 12, out: y, ids: ids, tab: tab ] ]
        return y

    func lookup_back [ rec: GLookOp ]
        dy : GTensor rec.out.gr
        if [ !dy || !rec.tab.need ] return
        k : GKernel kernel[ 'lookup_back', KLookupBack [] ]
        g : GArgs []
        g.ad[ 0 ] = rec.ids.addr[]
        g.ad[ 1 ] = dy.addr[]
        g.ad[ 2 ] = grad_of[ rec.tab ].addr[]
        g.nn[ 0 ] = i32[ rec.ids.count ]
        g.nn[ 1 ] = i32[ rec.tab.dims[ 1 ] ]
        g.nn[ 2 ] = i32[ rec.tab.dims[ 0 ] ]
        rn.dispatch[ k, g, groups[ rec.tab.count ], 1, 1 ]

    # weight norm: w = g v / |v| over each slice along dim 0
    func wnorm [ v: GTensor, wg: GTensor ] -> GTensor
        w : GTensor temp[ v.dims ]
        # a vec literal of x.dims[0] stores its address
        no : i64 [ v.dims[ 0 ] ]
        nrm : GTensor temp[ vec i64 [] [ no ] ]
        k : GKernel kernel[ 'wnorm', KWnorm [] ]
        g : GArgs []
        g.ad[ 0 ] = v.addr[]
        g.ad[ 1 ] = wg.addr[]
        g.ad[ 2 ] = w.addr[]
        g.ad[ 3 ] = nrm.addr[]
        g.nn[ 0 ] = i32[ v.dims[ 0 ] ]
        g.nn[ 1 ] = i32[ v.count / v.dims[ 0 ] ]
        rn.dispatch[ k, g, i32[ v.dims[ 0 ] ], 1, 1 ]
        if [ keeps[ v ] || keeps[ wg ] ]
            w.need = true
            tape.push[
                GWnormOp [ kind: 13, out: w, wv: v, wg: wg, nrm: nrm ] ]
        return w

    func wnorm_back [ rec: GWnormOp ]
        dw : GTensor rec.out.gr
        if [ !dw ] return
        k : GKernel kernel[ 'wnorm_back', KWnormBack [] ]
        g : GArgs []
        g.ad[ 0 ] = rec.wv.addr[]
        g.ad[ 1 ] = rec.wg.addr[]
        g.ad[ 2 ] = dw.addr[]
        g.ad[ 3 ] = rec.nrm.addr[]
        g.ad[ 4 ] = (rec.wv.need) ? grad_of[ rec.wv ].addr[] : u64[ 0 ]
        g.ad[ 5 ] = (rec.wg.need) ? grad_of[ rec.wg ].addr[] : u64[ 0 ]
        g.nn[ 0 ] = i32[ rec.wv.dims[ 0 ] ]
        g.nn[ 1 ] = i32[ rec.wv.count / rec.wv.dims[ 0 ] ]
        rn.dispatch[ k, g, i32[ rec.wv.dims[ 0 ] ], 1, 1 ]

    func flip_into [ src: GTensor, dst: GTensor, beta: f32 ]
        k : GKernel kernel[ 'flip', KFlip [] ]
        g : GArgs []
        g.ad[ 0 ] = src.addr[]
        g.ad[ 1 ] = dst.addr[]
        g.nn[ 0 ] = i32[ src.dims[ 0 ] ]
        g.nn[ 1 ] = i32[ src.dims[ 1 ] ]
        g.nn[ 2 ] = i32[ src.dims[ 2 ] ]
        g.ff[ 0 ] = beta
        rn.dispatch[ k, g, groups[ src.count ], 1, 1 ]

    func flip [ x: GTensor ] -> GTensor
        y : GTensor temp[ x.dims ]
        flip_into[ x, y, 0.0 ]
        if [ keeps[ x ] ]
            y.need = true
            tape.push[ GFlipOp [ kind: 14, out: y, fx: x ] ]
        return y

    func flip_back [ rec: GFlipOp ]
        dy : GTensor rec.out.gr
        if [ !dy || !rec.fx.need ] return
        flip_into[ dy, grad_of[ rec.fx ], 1.0 ]

    # x's values copied under new dims (the same count)
    func reshape [ x: GTensor, dims: vec i64 ] -> GTensor
        y : GTensor temp[ dims ]
        rn.move[ x.ar.buf, x.off, y.ar.buf, y.off, x.count * 4 ]
        if [ keeps[ x ] ]
            y.need = true
            tape.push[ GShapeOp [ kind: 15, out: y, rx: x ] ]
        return y

    func reshape_back [ rec: GShapeOp ]
        dy : GTensor rec.out.gr
        if [ !dy || !rec.rx.need ] return
        axpby[ dy, grad_of[ rec.rx ], 1.0, 1.0 ]

    # a checkpoint tensor into the weight arena
    func param_of [ t: tensor ] -> GTensor
        if [ !t ] return null
        nd : i64 [ t.tensor_shape.count ]
        dims : vec i64 [ nd ]
        for [ i: i64 0, i < nd, i += 1 ]
            dims[ i ] = i64[ t.tensor_shape[ i ] ]
        g : GTensor param[ dims ]
        if [ !g ] return null
        upload_raw[ g, t.floats, g.count ]
        return g

    # n values from host memory onto the gpu
    func upload_raw [ t: GTensor, src: @f32, n: i64 ]
        if [ !t ] return
        done : i64 [ 0 ]
        while [ done < n ]
            part : i64 [
                ((n - done) * 4 < stage_bytes) ? (n - done)
                : stage_bytes / 4 ]
            memcpy[ stage.data, @src[ done ], part * 4 ]
            rn.move[ stage, 0, t.ar.buf, t.off + done * 4, part * 4 ]
            rn.finish[]
            done += part

    func gelu [ x: GTensor ] -> GTensor
        return unary[ x, 6, 0.0 ]

    func tslice_run [ src: GTensor, dst: GTensor, nb: i64, nc: i64,
                      n: i64, nt: i64, t0: i64, back: i32 ]
        k : GKernel kernel[ 'tslice', KTslice [] ]
        g : GArgs []
        g.ad[ 0 ] = src.addr[]
        g.ad[ 1 ] = dst.addr[]
        g.nn[ 0 ] = i32[ nb ]
        g.nn[ 1 ] = i32[ nc ]
        g.nn[ 2 ] = i32[ n ]
        g.nn[ 3 ] = i32[ nt ]
        g.nn[ 4 ] = i32[ t0 ]
        g.nn[ 5 ] = back
        rn.dispatch[ k, g, groups[ nb * nc * n ], 1, 1 ]

    # frames t0 .. t0+n of x [b, c, t]
    func tslice [ x: GTensor, t0: i64, n: i64 ] -> GTensor
        y : GTensor temp[ dims3[ x.dims[ 0 ], x.dims[ 1 ], n ] ]
        tslice_run[ x, y, x.dims[ 0 ], x.dims[ 1 ], n, x.dims[ 2 ], t0,
                    0 ]
        if [ keeps[ x ] ]
            y.need = true
            tape.push[ GTsliceOp [ kind: 16, out: y, tx: x, t0: t0 ] ]
        return y

    func tslice_back [ rec: GTsliceOp ]
        dy : GTensor rec.out.gr
        if [ !dy || !rec.tx.need ] return
        tslice_run[ dy, grad_of[ rec.tx ], dy.dims[ 0 ], dy.dims[ 1 ],
                    dy.dims[ 2 ], rec.tx.dims[ 2 ], rec.t0, 1 ]

    # per (b, c) norm over time, affine per channel; no grad
    func time_norm [ x: GTensor, gamma: GTensor,
                     beta: GTensor ] -> GTensor
        y : GTensor temp[ x.dims ]
        k : GKernel kernel[ 'tnorm', KTnorm [] ]
        g : GArgs []
        g.ad[ 0 ] = x.addr[]
        g.ad[ 1 ] = gamma.addr[]
        g.ad[ 2 ] = beta.addr[]
        g.ad[ 3 ] = y.addr[]
        g.nn[ 1 ] = i32[ x.dims[ 1 ] ]
        g.nn[ 2 ] = i32[ x.dims[ 2 ] ]
        rn.dispatch[ k, g, i32[ x.dims[ 0 ] * x.dims[ 1 ] ], 1, 1 ]
        return y

    # pytorch's conv2d, forward only
    func conv2d [ x: GTensor, w: GTensor, b: GTensor, ph: i32,
                  pw: i32 ] -> GTensor
        nb : i64 [ x.dims[ 0 ] ]
        ci : i64 [ x.dims[ 1 ] ]
        nh : i64 [ x.dims[ 2 ] ]
        nw : i64 [ x.dims[ 3 ] ]
        co : i64 [ w.dims[ 0 ] ]
        kh : i64 [ w.dims[ 2 ] ]
        kw : i64 [ w.dims[ 3 ] ]
        oh : i64 [ nh + 2 * i64[ ph ] - kh + 1 ]
        ow : i64 [ nw + 2 * i64[ pw ] - kw + 1 ]
        n : i64 [ nb * oh * ow ]
        scratch.top = 0
        cols : GTensor stemp[ vec i64 [] [ ci * kh * kw, n ] ]
        k : GKernel kernel[ 'im2col2d', KIm2col2d [] ]
        g : GArgs []
        g.ad[ 0 ] = x.addr[]
        g.ad[ 1 ] = cols.addr[]
        g.nn[ 0 ] = i32[ nb ]
        g.nn[ 1 ] = i32[ ci ]
        g.nn[ 2 ] = i32[ nh ]
        g.nn[ 3 ] = i32[ nw ]
        g.nn[ 4 ] = i32[ kh ]
        g.nn[ 5 ] = i32[ kw ]
        g.nn[ 6 ] = ph
        g.nn[ 7 ] = pw
        g.nn[ 8 ] = i32[ oh ]
        g.nn[ 9 ] = i32[ ow ]
        rn.dispatch[ k, g, groups[ cols.count ], 1, 1 ]
        ym : GTensor stemp[ vec i64 [] [ co, n ] ]
        gemm[ GView [ t: w, rs: ci * kh * kw, cs: 1, bs: 0 ],
              GView [ t: cols, rs: n, cs: 1, bs: 0 ],
              GView [ t: ym, rs: n, cs: 1, bs: 0 ], co, n, ci * kh * kw,
              1, 1.0, 0.0 ]
        y : GTensor temp[ vec i64 [] [ nb, co, oh, ow ] ]
        regroup[ ym, y, b, nb, co, oh * ow, 1, 0.0 ]
        return y

    # conv_transpose2d k3 stride st doubles h, w; forward
    func convt2d [ x: GTensor, w: GTensor, st: i32, pd: i32 ] -> GTensor
        nb : i64 [ x.dims[ 0 ] ]
        ci : i64 [ x.dims[ 1 ] ]
        nh : i64 [ x.dims[ 2 ] ]
        nw : i64 [ x.dims[ 3 ] ]
        co : i64 [ w.dims[ 1 ] ]
        n : i64 [ nb * nh * nw ]
        scratch.top = 0
        xp : GTensor stemp[ vec i64 [] [ ci, n ] ]
        regroup[ x, xp, null, nb, ci, nh * nw, 0, 0.0 ]
        cols : GTensor stemp[ vec i64 [] [ co * 9, n ] ]
        gemm[ GView [ t: w, rs: 1, cs: co * 9, bs: 0 ],
              GView [ t: xp, rs: n, cs: 1, bs: 0 ],
              GView [ t: cols, rs: n, cs: 1, bs: 0 ], co * 9, n, ci, 1,
              1.0, 0.0 ]
        oh : i64 [ nh * i64[ st ] ]
        ow : i64 [ nw * i64[ st ] ]
        y : GTensor temp[ vec i64 [] [ nb, co, oh, ow ] ]
        k : GKernel kernel[ 'convt2d_gather', KConvt2dGather [] ]
        g : GArgs []
        g.ad[ 0 ] = cols.addr[]
        g.ad[ 1 ] = y.addr[]
        g.nn[ 0 ] = i32[ nb ]
        g.nn[ 1 ] = i32[ co ]
        g.nn[ 2 ] = i32[ nh ]
        g.nn[ 3 ] = i32[ nw ]
        g.nn[ 4 ] = st
        g.nn[ 5 ] = pd
        g.nn[ 6 ] = i32[ oh ]
        g.nn[ 7 ] = i32[ ow ]
        rn.dispatch[ k, g, groups[ y.count ], 1, 1 ]
        return y

    # 2x2 average pooling over [b, c, h, w]; forward only
    func avg_pool2 [ x: GTensor ] -> GTensor
        nh : i64 [ x.dims[ 2 ] ]
        nw : i64 [ x.dims[ 3 ] ]
        n0 : i64 [ x.dims[ 0 ] ]
        n1 : i64 [ x.dims[ 1 ] ]
        y : GTensor temp[ vec i64 [] [ n0, n1, nh / 2, nw / 2 ] ]
        k : GKernel kernel[ 'avgpool2', KAvgPool2 [] ]
        g : GArgs []
        g.ad[ 0 ] = x.addr[]
        g.ad[ 1 ] = y.addr[]
        g.nn[ 0 ] = i32[ x.dims[ 0 ] * x.dims[ 1 ] ]
        g.nn[ 1 ] = i32[ nh ]
        g.nn[ 2 ] = i32[ nw ]
        rn.dispatch[ k, g, groups[ y.count ], 1, 1 ]
        return y

    # bidirectional gru 256; [t, 512] forward then reverse
    func gru256 [ xf: GTensor, xr: GTensor, whf: GTensor, whr: GTensor,
                  bhf: GTensor, bhr: GTensor, nt: i64 ] -> GTensor
        y : GTensor temp[ vec i64 [] [ nt, 512 ] ]
        k : GKernel kernel[ 'gru256', KGru [] ]
        g : GArgs []
        g.ad[ 0 ] = xf.addr[]
        g.ad[ 1 ] = xr.addr[]
        g.ad[ 2 ] = whf.addr[]
        g.ad[ 3 ] = whr.addr[]
        g.ad[ 4 ] = bhf.addr[]
        g.ad[ 5 ] = bhr.addr[]
        ya : u64 [ y.addr[] ]
        g.nn[ 0 ] = i32[ nt ]
        g.nn[ 2 ] = i32[ ya & 0xFFFFFFFF ]
        g.nn[ 3 ] = i32[ ya >> 32 ]
        rn.dispatch[ k, g, 2, 1, 1 ]
        return y

    # the same memory under other dims (no copy, no gradient)
    func view [ t: GTensor, dims: vec i64 ] -> GTensor
        return GTensor [ ar: t.ar, off: t.off, count: t.count,
                         dims: dims ]

    # x under new dims, no copy; its gradient is x's under them
    func reshape_view [ x: GTensor, dims: vec i64 ] -> GTensor
        y : GTensor view[ x, dims ]
        if [ keeps[ x ] ]
            y.need = true
            y.gr = view[ grad_of[ x ], dims ]
        return y

    # |x| of stacked re/im halves [b, 2f, t], eps in root
    func magnitude [ x: GTensor, eps: f32 ] -> GTensor
        nf : i64 [ x.dims[ 1 ] / 2 ]
        y : GTensor temp[ dims3[ x.dims[ 0 ], nf, x.dims[ 2 ] ] ]
        k : GKernel kernel[ 'mag', KMag [] ]
        g : GArgs []
        g.ad[ 0 ] = x.addr[]
        g.ad[ 1 ] = y.addr[]
        g.nn[ 0 ] = i32[ x.dims[ 0 ] ]
        g.nn[ 1 ] = i32[ nf ]
        g.nn[ 2 ] = i32[ x.dims[ 2 ] ]
        g.ff[ 0 ] = eps
        rn.dispatch[ k, g, groups[ y.count ], 1, 1 ]
        if [ keeps[ x ] ]
            y.need = true
            tape.push[ GMagOp [ kind: 19, out: y, mx: x ] ]
        return y

    func mag_back [ rec: GMagOp ]
        dy : GTensor rec.out.gr
        if [ !dy || !rec.mx.need ] return
        k : GKernel kernel[ 'mag_back', KMagBack [] ]
        g : GArgs []
        g.ad[ 0 ] = rec.mx.addr[]
        g.ad[ 1 ] = rec.out.addr[]
        g.ad[ 2 ] = dy.addr[]
        g.ad[ 3 ] = grad_of[ rec.mx ].addr[]
        g.nn[ 0 ] = i32[ dy.dims[ 0 ] ]
        g.nn[ 1 ] = i32[ dy.dims[ 1 ] ]
        g.nn[ 2 ] = i32[ dy.dims[ 2 ] ]
        rn.dispatch[ k, g, groups[ dy.count ], 1, 1 ]

    func log_clamp [ x: GTensor, lo: f32 ] -> GTensor
        y : GTensor temp[ x.dims ]
        k : GKernel kernel[ 'log_clamp', KLogClamp [] ]
        g : GArgs []
        g.ad[ 0 ] = x.addr[]
        g.ad[ 1 ] = y.addr[]
        g.nn[ 0 ] = i32[ x.count ]
        g.ff[ 0 ] = lo
        rn.dispatch[ k, g, groups[ x.count ], 1, 1 ]
        if [ keeps[ x ] ]
            y.need = true
            tape.push[ GLogOp [ kind: 20, out: y, lgx: x, lo: lo ] ]
        return y

    func log_back [ rec: GLogOp ]
        dy : GTensor rec.out.gr
        if [ !dy || !rec.lgx.need ] return
        k : GKernel kernel[ 'log_clamp_back', KLogClampBack [] ]
        g : GArgs []
        g.ad[ 0 ] = rec.lgx.addr[]
        g.ad[ 1 ] = dy.addr[]
        g.ad[ 2 ] = grad_of[ rec.lgx ].addr[]
        g.nn[ 0 ] = i32[ dy.count ]
        g.ff[ 0 ] = rec.lo
        rn.dispatch[ k, g, groups[ dy.count ], 1, 1 ]

    func tsids_run [ src: GTensor, dst: GTensor, ids: GTensor, nb: i64,
                     nc: i64, n: i64, nt: i64, mult: i64, back: i32 ]
        k : GKernel kernel[ 'tslice_ids', KTsliceIds [] ]
        g : GArgs []
        g.ad[ 0 ] = src.addr[]
        g.ad[ 1 ] = dst.addr[]
        g.ad[ 2 ] = ids.addr[]
        g.nn[ 0 ] = i32[ nb ]
        g.nn[ 1 ] = i32[ nc ]
        g.nn[ 2 ] = i32[ n ]
        g.nn[ 3 ] = i32[ nt ]
        g.nn[ 4 ] = i32[ mult ]
        g.nn[ 5 ] = back
        rn.dispatch[ k, g, groups[ nb * nc * n ], 1, 1 ]

    # each batch item's frames ids[b]*mult .. +n
    func tslice_ids [ x: GTensor, ids: GTensor, n: i64,
                      mult: i64 ] -> GTensor
        y : GTensor temp[ dims3[ x.dims[ 0 ], x.dims[ 1 ], n ] ]
        tsids_run[ x, y, ids, x.dims[ 0 ], x.dims[ 1 ], n, x.dims[ 2 ],
                   mult, 0 ]
        if [ keeps[ x ] ]
            y.need = true
            tape.push[
                GTsIdsOp [ kind: 17, out: y, sx: x, ids: ids,
                           mult: mult ] ]
        return y

    func tsids_back [ rec: GTsIdsOp ]
        dy : GTensor rec.out.gr
        if [ !dy || !rec.sx.need ] return
        tsids_run[ dy, grad_of[ rec.sx ], rec.ids, dy.dims[ 0 ],
                   dy.dims[ 1 ], dy.dims[ 2 ], rec.sx.dims[ 2 ],
                   rec.mult, 1 ]

    func pad_run [ src: GTensor, dst: GTensor, rows: i64, nt: i64,
                   pl: i64, tn: i64, back: i32 ]
        k : GKernel [
            (back == 1)
            ? kernel[ 'pad_reflect_back', KPadReflectBack [] ]
            : kernel[ 'pad_reflect', KPadReflect [] ] ]
        g : GArgs []
        g.ad[ 0 ] = src.addr[]
        g.ad[ 1 ] = dst.addr[]
        g.nn[ 0 ] = i32[ rows ]
        g.nn[ 1 ] = i32[ nt ]
        g.nn[ 2 ] = i32[ pl ]
        g.nn[ 3 ] = i32[ tn ]
        g.nn[ 4 ] = back
        rn.dispatch[ k, g, groups[ rows * ((back == 1) ? nt : tn) ], 1,
                     1 ]

    # reflect padding: pl frames before, pr after, along time
    func pad_reflect [ x: GTensor, pl: i64, pr: i64 ] -> GTensor
        nt : i64 [ x.dims[ 2 ] ]
        y : GTensor temp[
            dims3[ x.dims[ 0 ], x.dims[ 1 ], nt + pl + pr ] ]
        pad_run[ x, y, x.dims[ 0 ] * x.dims[ 1 ], nt, pl, nt + pl + pr,
                 0 ]
        if [ keeps[ x ] ]
            y.need = true
            tape.push[ GPadOp [ kind: 18, out: y, px: x, pl: pl ] ]
        return y

    func pad_back [ rec: GPadOp ]
        dy : GTensor rec.out.gr
        if [ !dy || !rec.px.need ] return
        # one source gathers every tap mirrored onto it
        x : GTensor rec.px
        pad_run[ dy, grad_of[ x ], x.dims[ 0 ] * x.dims[ 1 ],
                 x.dims[ 2 ], rec.pl, dy.dims[ 2 ], 1 ]

    func fold_run [ src: GTensor, dst: GTensor, nb: i64, nc: i64,
                    nt: i64, per: i64, back: i32 ]
        k : GKernel kernel[ 'period_fold', KPeriodFold [] ]
        g : GArgs []
        g.ad[ 0 ] = src.addr[]
        g.ad[ 1 ] = dst.addr[]
        g.nn[ 0 ] = i32[ nb ]
        g.nn[ 1 ] = i32[ nc ]
        g.nn[ 2 ] = i32[ nt ]
        g.nn[ 3 ] = i32[ per ]
        g.nn[ 4 ] = back
        rn.dispatch[ k, g, groups[ nb * nc * nt ], 1, 1 ]

    # [b, c, t] (t a multiple of per) to [b*per, c, t/per]
    func period_fold [ x: GTensor, per: i64 ] -> GTensor
        nb : i64 [ x.dims[ 0 ] ]
        nc : i64 [ x.dims[ 1 ] ]
        nt : i64 [ x.dims[ 2 ] ]
        y : GTensor temp[ dims3[ nb * per, nc, nt / per ] ]
        fold_run[ x, y, nb, nc, nt, per, 0 ]
        if [ keeps[ x ] ]
            y.need = true
            tape.push[ GFoldOp [ kind: 21, out: y, fx9: x, per: per ] ]
        return y

    func fold_back [ rec: GFoldOp ]
        dy : GTensor rec.out.gr
        if [ !dy || !rec.fx9.need ] return
        x : GTensor rec.fx9
        fold_run[ dy, grad_of[ x ], x.dims[ 0 ], x.dims[ 1 ],
                  x.dims[ 2 ], rec.per, 1 ]

    func one [] -> vec i64
        return vec i64 [] [ 1 ]

    func loss_run [ x: GTensor, y: GTensor, mode: i32, tgt: f32,
                    nrm: f32 ] -> GTensor
        o : GTensor temp[ one[] ]
        # a group per 4096 values, at most 256: partials in order
        ng : i64 [ (x.count + 4095) / 4096 ]
        if [ ng > 256 ] ng = 256
        if [ ng < 1 ] ng = 1
        save : i64 [ scratch.top ]
        pt : GTensor stemp[ dims3[ 1, 1, ng ] ]
        k : GKernel kernel[ 'loss', KLoss [] ]
        g : GArgs []
        g.ad[ 0 ] = x.addr[]
        g.ad[ 1 ] = (y) ? y.addr[] : u64[ 0 ]
        g.ad[ 2 ] = pt.addr[]
        g.nn[ 0 ] = i32[ x.count ]
        g.nn[ 1 ] = mode
        g.ff[ 0 ] = tgt
        rn.dispatch[ k, g, i32[ ng ], 1, 1 ]
        k2 : GKernel kernel[ 'loss_sum', KLossSum [] ]
        g2 : GArgs []
        g2.ad[ 0 ] = pt.addr[]
        g2.ad[ 1 ] = o.addr[]
        g2.nn[ 0 ] = i32[ ng ]
        g2.ff[ 0 ] = nrm
        rn.dispatch[ k2, g2, 1, 1, 1 ]
        scratch.top = save
        if [ keeps[ x ] || keeps[ y ] ]
            o.need = true
            tape.push[
                GLossOp [ kind: 22, out: o, lx: x, ly: y, mode: mode,
                          tgt: tgt, nrm: nrm ] ]
        return o

    # mean((tgt - x)^2)
    func lsq [ x: GTensor, tgt: f32 ] -> GTensor
        return loss_run[ x, null, 0, tgt, f32[ 1.0 / f64[ x.count ] ] ]

    # mean sigmoid cross entropy of logits x against bits y
    func bce [ x: GTensor, y: GTensor ] -> GTensor
        return loss_run[ x, y, 3, 0.0, f32[ 1.0 / f64[ x.count ] ] ]

    # mean(|x - y|)
    func l1 [ x: GTensor, y: GTensor ] -> GTensor
        return loss_run[ x, y, 1, 0.0, f32[ 1.0 / f64[ x.count ] ] ]

    func loss_back [ rec: GLossOp ]
        dl : GTensor rec.out.gr
        if [ !dl ] return
        k : GKernel kernel[ 'loss_back', KLossBack [] ]
        x : GTensor rec.lx
        g : GArgs []
        g.ad[ 0 ] = x.addr[]
        g.ad[ 1 ] = (rec.ly) ? rec.ly.addr[] : u64[ 0 ]
        g.ad[ 2 ] = dl.addr[]
        if [ x.need ]
            g.ad[ 3 ] = grad_of[ x ].addr[]
        el
            # the kernel always writes dx: a scratch that nothing reads
            g.ad[ 3 ] = temp[ x.dims ].addr[]
        g.ad[ 4 ] = (rec.ly && rec.ly.need) ? grad_of[
            rec.ly ].addr[] : u64[ 0 ]
        g.nn[ 0 ] = i32[ x.count ]
        g.nn[ 1 ] = rec.mode
        g.ff[ 0 ] = rec.tgt
        g.ff[ 1 ] = rec.nrm
        rn.dispatch[ k, g, groups[ x.count ], 1, 1 ]

    # vits kl over the mask [b, 1, t], divided by msum
    func kl [ zp: GTensor, lq: GTensor, mp: GTensor, lp: GTensor,
              km: GTensor, msum: f64 ] -> GTensor
        o : GTensor temp[ one[] ]
        # a group per 4096 values, at most 256: partials in order
        ng : i64 [ (zp.count + 4095) / 4096 ]
        if [ ng > 256 ] ng = 256
        if [ ng < 1 ] ng = 1
        save : i64 [ scratch.top ]
        pt : GTensor stemp[ dims3[ 1, 1, ng ] ]
        k : GKernel kernel[ 'loss', KLoss [] ]
        g : GArgs []
        g.ad[ 0 ] = zp.addr[]
        g.ad[ 1 ] = lq.addr[]
        g.ad[ 2 ] = pt.addr[]
        g.ad[ 3 ] = mp.addr[]
        g.ad[ 4 ] = lp.addr[]
        g.ad[ 5 ] = (km) ? km.addr[] : u64[ 0 ]
        g.nn[ 0 ] = i32[ zp.count ]
        g.nn[ 1 ] = 2
        g.nn[ 2 ] = i32[ zp.dims[ 2 ] ]
        g.nn[ 3 ] = i32[ zp.dims[ 1 ] ]
        rn.dispatch[ k, g, i32[ ng ], 1, 1 ]
        k2 : GKernel kernel[ 'loss_sum', KLossSum [] ]
        g2 : GArgs []
        g2.ad[ 0 ] = pt.addr[]
        g2.ad[ 1 ] = o.addr[]
        g2.nn[ 0 ] = i32[ ng ]
        g2.ff[ 0 ] = f32[ 1.0 / msum ]
        rn.dispatch[ k2, g2, 1, 1, 1 ]
        scratch.top = save
        if [ keeps[ zp ] || keeps[ lq ] || keeps[ mp ] || keeps[ lp ] ]
            o.need = true
            tape.push[
                GKlOp [ kind: 23, out: o, zp: zp, lq: lq, mp: mp, lp: lp,
                        km: km, nrm: f32[ 1.0 / msum ] ] ]
        return o

    func kl_back [ rec: GKlOp ]
        dl : GTensor rec.out.gr
        if [ !dl ] return
        n : i64 [ rec.zp.count ]
        # the four gradients side by side, then each onto its input
        four : GTensor temp[ vec i64 [] [ 4 * n ] ]
        k : GKernel kernel[ 'kl_back', KKlBack [] ]
        g : GArgs []
        g.ad[ 0 ] = rec.zp.addr[]
        g.ad[ 1 ] = rec.lq.addr[]
        g.ad[ 2 ] = rec.mp.addr[]
        g.ad[ 3 ] = rec.lp.addr[]
        g.ad[ 4 ] = dl.addr[]
        g.ad[ 5 ] = (rec.km) ? rec.km.addr[] : u64[ 0 ]
        fa : u64 [ four.addr[] ]
        g.nn[ 0 ] = i32[ n ]
        g.nn[ 2 ] = i32[ rec.zp.dims[ 2 ] ]
        g.nn[ 3 ] = i32[ fa & 0xFFFFFFFF ]
        g.nn[ 4 ] = i32[ fa >> 32 ]
        g.nn[ 5 ] = i32[ rec.zp.dims[ 1 ] ]
        g.ff[ 1 ] = rec.nrm
        rn.dispatch[ k, g, groups[ n ], 1, 1 ]
        ins : vec GTensor [] [ rec.zp, rec.lq, rec.mp, rec.lp ]
        for [ q: i64 0, q < 4, q += 1 ]
            t9 : GTensor ins[ q ]
            if [ !t9.need ] continue
            part : GTensor GTensor [ ar: four.ar,
                                     off: four.off + q * n * 4, count: n,
                                     dims: t9.dims ]
            axpby[ part, grad_of[ t9 ], 1.0, 1.0 ]

    # every loss seeded with its weight, then the tape
    func backward_all [ losses: vec GTensor, weights: vec f32 ]
        backward_from[ losses, weights, 0 ]

    # as backward_all, over the ops recorded since mark
    func backward_from [ losses: vec GTensor, weights: vec f32,
                         mark: i64 ]
        for [ i: i64 0, i < losses.count, i += 1 ]
            lt : GTensor losses[ i ]
            fill[ grad_of[ lt ], weights[ i ] ]
        j : i64 [ tape.count - 1 ]
        while [ j >= mark ]
            back_op[ tape[ j ] ]
            j -= 1

    # the ops recorded after mark are forgotten
    func tape_cut [ mark: i64 ]
        while [ tape.count > mark ]
            tape.pop[]

    # x [rows, n] against ids [rows]; an id under 0 is left out
    func xent [ x: GTensor, ids: GTensor ] -> GTensor
        nr : i64 [ ids.count ]
        nn : i64 [ x.count / nr ]
        o : GTensor temp[ one[] ]
        cnt : GTensor temp[ one[] ]
        lse : GTensor temp[ vec i64 [] [ nr ] ]
        save : i64 [ scratch.top ]
        rl : GTensor stemp[ vec i64 [] [ nr ] ]
        vl : GTensor stemp[ vec i64 [] [ nr ] ]
        k : GKernel kernel[ 'xent', KXent [] ]
        g : GArgs []
        g.ad[ 0 ] = x.addr[]
        g.ad[ 1 ] = ids.addr[]
        g.ad[ 2 ] = lse.addr[]
        g.ad[ 3 ] = rl.addr[]
        g.ad[ 4 ] = vl.addr[]
        g.nn[ 0 ] = i32[ nr ]
        g.nn[ 1 ] = i32[ nn ]
        rn.dispatch[ k, g, i32[ nr ], 1, 1 ]
        k2 : GKernel kernel[ 'xent_sum', KXentSum [] ]
        g2 : GArgs []
        g2.ad[ 0 ] = rl.addr[]
        g2.ad[ 1 ] = vl.addr[]
        g2.ad[ 2 ] = o.addr[]
        g2.ad[ 3 ] = cnt.addr[]
        g2.nn[ 0 ] = i32[ nr ]
        rn.dispatch[ k2, g2, 1, 1, 1 ]
        scratch.top = save
        if [ keeps[ x ] ]
            o.need = true
            tape.push[
                GXentOp [ kind: 24, out: o, xx: x, ids: ids, lse: lse,
                          cnt: cnt ] ]
        return o

    func xent_back [ rec: GXentOp ]
        dl : GTensor rec.out.gr
        if [ !dl || !rec.xx.need ] return
        nr : i64 [ rec.ids.count ]
        k : GKernel kernel[ 'xent_back', KXentBack [] ]
        g : GArgs []
        g.ad[ 0 ] = rec.xx.addr[]
        g.ad[ 1 ] = rec.ids.addr[]
        g.ad[ 2 ] = rec.lse.addr[]
        g.ad[ 3 ] = dl.addr[]
        g.ad[ 4 ] = rec.cnt.addr[]
        g.ad[ 5 ] = grad_of[ rec.xx ].addr[]
        g.nn[ 0 ] = i32[ nr ]
        g.nn[ 1 ] = i32[ rec.xx.count / nr ]
        rn.dispatch[ k, g, groups[ rec.xx.count ], 1, 1 ]

    # pytorch's adamw on one parameter; step is 1-based
    func adamw [ w: GTensor, m: GTensor, v: GTensor, lr: f32, b1: f32,
                 b2: f32, eps: f32, decay: f32, step: i64 ]
        if [ !w.gr ] return
        k : GKernel kernel[ 'adamw', KAdamW [] ]
        c1 : f32 [ 1.0 - pow[ f64[ b1 ], f64[ step ] ] ]
        c2 : f32 [ 1.0 - pow[ f64[ b2 ], f64[ step ] ] ]
        g : GArgs []
        g.ad[ 0 ] = w.addr[]
        g.ad[ 1 ] = w.gr.addr[]
        g.ad[ 2 ] = m.addr[]
        g.ad[ 3 ] = v.addr[]
        g.nn[ 0 ] = i32[ w.count ]
        g.nn[ 1 ] = f32_bits[ c1 ]
        g.nn[ 2 ] = f32_bits[ c2 ]
        g.nn[ 3 ] = f32_bits[ decay ]
        g.nn[ 4 ] = f32_bits[ eps ]
        g.ff[ 0 ] = lr
        g.ff[ 1 ] = b1
        g.ff[ 2 ] = b2
        rn.dispatch[ k, g, groups[ w.count ], 1, 1 ]

    func f32_bits [ v: f32 ] -> i32
        b : local f32 [ 1 ] [ v ]
        o : local i32 [ 1 ]
        memcpy[ @o[ 0 ], @b[ 0 ], 4 ]
        return o[ 0 ]

    # x's values in a new tensor that takes no gradient
    func detached [ x: GTensor ] -> GTensor
        y : GTensor temp[ x.dims ]
        rn.move[ x.ar.buf, x.off, y.ar.buf, y.off, x.count * 4 ]
        return y

    # the 8 least of every row of d [rows, n]: values and columns
    func top8 [ d: GTensor, rows: i64, n: i64, od: GTensor,
                oi: GTensor ]
        k : GKernel kernel[ 'top8', KTop8 [] ]
        g : GArgs []
        g.ad[ 0 ] = d.addr[]
        g.ad[ 1 ] = od.addr[]
        g.ad[ 2 ] = oi.addr[]
        g.nn[ 0 ] = i32[ rows ]
        g.nn[ 1 ] = i32[ n ]
        rn.dispatch[ k, g, i32[ rows ], 1, 1 ]

    # gpu time by kernel since profiling began, most first
    func prof_report []
        if [ !rn.ptime ] return
        names : vec string []
        for [ v: f64, k: string ] in rn.ptime
            names.push[ k ]
        total : f64 [ 0.0 ]
        for [ k: string ] in names
            tv : f64 [ rn.ptime[ k ] ]
            total += tv
        for [ r: i32 0, r < 15 && names.count > 0, r += 1 ]
            bi : i64 [ 0 ]
            for [ i: i64 1, i < names.count, i += 1 ]
                if [ rn.ptime[ names[ i ] ] > rn.ptime[ names[ bi ] ] ]
                    bi = i
            nm : string names[ bi ]
            tv : f64 [ rn.ptime[ nm ] ]
            cv : i64 [ rn.pcount[ nm ] ]
            log 'grad prof: {nm} {tv / 1000.0} ms in {cv} dispatches ({100.0 * tv / total}%)'
            names.remove[ bi ]
        log 'grad prof: total {total / 1000.0} ms'

    func fill [ t: GTensor, v: f32 ]
        k : GKernel kernel[ 'fill', KFill [] ]
        g : GArgs []
        g.ad[ 0 ] = t.addr[]
        g.nn[ 0 ] = i32[ t.count ]
        g.ff[ 0 ] = v
        rn.dispatch[ k, g, groups[ t.count ], 1, 1 ]

# c = alpha a.b + beta c, strided, batch z

# the strides of one gemm operand, and its batch step
class GView
    public t    : GTensor
    public rs   : i64
    public cs   : i64
    public bs   : i64

# values up, arithmetic on the gpu, values back
expect func t_grad_roundtrip [] -> bool
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, backbuffer: true, width: 64, height: 64 ]
    Au.hold[ disp ]
    gd : Grad [ vk: vk, keep_mb: 16, work_mb: 16 ]
    if [ !gd.valid ] return false
    n : i64 [ 100000 ]
    x : GTensor gd.temp[ vec i64 [] [ n ] ]
    y : GTensor gd.temp[ vec i64 [] [ n ] ]
    xv : vec f32 [ n ]
    for [ i: i64 0, i < n, i += 1 ]
        xv[ i ] = f32[ i ] * 0.5
    gd.upload[ x, xv ]
    gd.fill[ y, 3.0 ]
    gd.axpby[ x, y, 2.0, 10.0 ]
    gd.rn.finish[]
    back : vec f32 gd.download[ y ]
    bad : i64 [ 0 ]
    for [ i: i64 0, i < n, i += 1 ]
        if [ back[ i ] != f32[ i ] + 30.0 ] bad += 1
    log 'grad roundtrip: {n} values, {bad} wrong; y[7] = {back[ 7 ]}'
    return bad == 0

# gemm against a cpu product: a transposed, batch 3
expect func t_grad_gemm [] -> bool
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, backbuffer: true, width: 64, height: 64 ]
    Au.hold[ disp ]
    gd : Grad [ vk: vk, keep_mb: 16, work_mb: 64 ]
    m : i64 [ 70 ]
    n : i64 [ 130 ]
    k : i64 [ 45 ]
    nb : i64 [ 3 ]

    # a is stored [k, m] (so a(m, k) = a[k*m_ + m]), b is [k, n]
    av : vec f32 [ nb * k * m ]
    bv : vec f32 [ nb * k * n ]
    cv : vec f32 [ nb * m * n ]
    for [ i: i64 0, i < av.count, i += 1 ]
        av[ i ] = f32[ (i * 7) % 13 ] * 0.1 - 0.6
    for [ i: i64 0, i < bv.count, i += 1 ]
        bv[ i ] = f32[ (i * 5) % 11 ] * 0.2 - 1.0
    for [ i: i64 0, i < cv.count, i += 1 ]
        cv[ i ] = f32[ i % 3 ]
    ta : GTensor gd.temp[ vec i64 [] [ av.count ] ]
    tb : GTensor gd.temp[ vec i64 [] [ bv.count ] ]
    tc : GTensor gd.temp[ vec i64 [] [ cv.count ] ]
    gd.upload[ ta, av ]
    gd.upload[ tb, bv ]
    gd.upload[ tc, cv ]
    gd.gemm[ GView [ t: ta, rs: 1, cs: m, bs: k * m ],
             GView [ t: tb, rs: n, cs: 1, bs: k * n ],
             GView [ t: tc, rs: n, cs: 1, bs: m * n ], m, n, k, nb, 1.5,
             0.5 ]
    gd.rn.finish[]
    got : vec f32 gd.download[ tc ]
    worst : f64 [ 0.0 ]
    for [ z: i64 0, z < nb, z += 1 ]
        for [ r: i64 0, r < m, r += 1 ]
            for [ c: i64 0, c < n, c += 1 ]
                s9 : f64 [ 0.0 ]
                for [ q: i64 0, q < k, q += 1 ]
                    ia : i64 [ z * k * m + q * m + r ]
                    ib : i64 [ z * k * n + q * n + c ]
                    s9 += f64[ av[ ia ] ] * f64[ bv[ ib ] ]
                ic : i64 [ z * m * n + r * n + c ]
                want : f64 [ 1.5 * s9 + 0.5 * f64[ cv[ ic ] ] ]
                d : f64 [ fabs[ want - f64[ got[ ic ] ] ] ]
                if [ d > worst ] worst = d
    log 'grad gemm: {nb} x {m}x{k} . {k}x{n}, worst error {worst}'
    return worst < 0.0001

# a golden file of f32 values
func grad_gold [ dir: string, name: string ] -> vec f32
    fp : @FILE [ fopen[ '{dir}/{name}.f32', 'rb' ] ]
    if [ !fp ] return vec f32 []
    fseek[ fp, 0, SEEK_END ]
    n : i64 [ i64[ ftell[ fp ] ] / 4 ]
    rewind[ fp ]
    v : vec f32 [ n ]
    fread[ @v[ 0 ], 4, n, fp ]
    fclose[ fp ]
    return v

func grad_worst [ got: vec f32, want: vec f32 ] -> f64
    if [ got.count != want.count ] return 1.0e30
    w : f64 [ 0.0 ]
    for [ i: i64 0, i < got.count, i += 1 ]
        d : f64 [ fabs[ f64[ got[ i ] ] - f64[ want[ i ] ] ] ]
        if [ d > w ] w = d
    return w

# a tensor of the given shape holding a golden file
func grad_load [ gd: Grad, dir: string, name: string, dims: vec i64,
                 need: bool ] -> GTensor
    t : GTensor gd.temp[ dims ]
    gd.upload[ t, grad_gold[ dir, name ] ]
    t.need = need
    return t

# conv1d and conv_transpose1d vs pytorch (GRAD_GOLD)
expect func t_grad_conv [] -> bool
    ge : cstr [ getenv[ 'GRAD_GOLD' ] ]
    if [ !ge ] return true
    dir : string [ ge ]
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, backbuffer: true, width: 64, height: 64 ]
    Au.hold[ disp ]
    gd : Grad [ vk: vk, keep_mb: 16, work_mb: 64 ]
    gd.record = true
    x : GTensor grad_load[ gd, dir, 'c_x', vec i64 [] [ 2, 8, 37 ],
                           true ]
    w : GTensor grad_load[ gd, dir, 'c_w', vec i64 [] [ 12, 2, 5 ],
                           true ]
    b : GTensor grad_load[ gd, dir, 'c_b', vec i64 [] [ 12 ], true ]
    y : GTensor gd.conv1d[ x, w, b, 3, 2, 2, 4 ]
    gd.upload[ gd.grad_of[ y ], grad_gold[ dir, 'c_dy' ] ]
    tx : GTensor grad_load[ gd, dir, 't_x', vec i64 [] [ 2, 6, 9 ],
                            true ]
    tw : GTensor grad_load[ gd, dir, 't_w', vec i64 [] [ 6, 4, 10 ],
                            true ]
    tb : GTensor grad_load[ gd, dir, 't_b', vec i64 [] [ 4 ], true ]
    ty : GTensor gd.convt1d[ tx, tw, tb, 5, 2 ]
    gd.upload[ gd.grad_of[ ty ], grad_gold[ dir, 't_dy' ] ]
    # both outputs have gradients: run from the last op
    i : i64 [ gd.tape.count - 1 ]
    while [ i >= 0 ]
        gd.back_op[ gd.tape[ i ] ]
        i -= 1
    gd.rn.finish[]
    e : vec f64 [] [
        grad_worst[ gd.download[ y ], grad_gold[ dir, 'c_y' ] ],
        grad_worst[ gd.download[ x.gr ], grad_gold[ dir, 'c_dx' ] ],
        grad_worst[ gd.download[ w.gr ], grad_gold[ dir, 'c_dw' ] ],
        grad_worst[ gd.download[ b.gr ], grad_gold[ dir, 'c_db' ] ],
        grad_worst[ gd.download[ ty ], grad_gold[ dir, 't_y' ] ],
        grad_worst[ gd.download[ tx.gr ], grad_gold[ dir, 't_dx' ] ],
        grad_worst[ gd.download[ tw.gr ], grad_gold[ dir, 't_dw' ] ],
        grad_worst[ gd.download[ tb.gr ], grad_gold[ dir, 't_db' ] ] ]
    log 'grad conv: y {e[ 0 ]} dx {e[ 1 ]} dw {e[ 2 ]} db {e[ 3 ]}; convt: y {e[ 4 ]} dx {e[ 5 ]} dw {e[ 6 ]} db {e[ 7 ]}'
    ok : bool [ true ]
    for [ v: f64 ] in e
        if [ v > 0.0001 ] ok = false
    return ok

# every element-wise op in one graph vs pytorch
expect func t_grad_elementwise [] -> bool
    ge : cstr [ getenv[ 'GRAD_GOLD' ] ]
    if [ !ge ] return true
    dir : string [ ge ]
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, backbuffer: true, width: 64, height: 64 ]
    Au.hold[ disp ]
    gd : Grad [ vk: vk, keep_mb: 16, work_mb: 64 ]
    gd.record = true
    x  : GTensor grad_load[ gd, dir, 'e_x', vec i64 [] [ 2, 6, 9 ],
                            true ]
    zc : GTensor grad_load[ gd, dir, 'e_zc', vec i64 [] [ 6 ], true ]
    m  : GTensor grad_load[ gd, dir, 'e_m', vec i64 [] [ 2, 1, 9 ],
                            true ]
    gc : GTensor grad_load[ gd, dir, 'e_gc', vec i64 [] [ 2, 12, 1 ],
                            true ]
    ga : GTensor grad_load[ gd, dir, 'e_ga', vec i64 [] [ 6 ], true ]
    be : GTensor grad_load[ gd, dir, 'e_be', vec i64 [] [ 6 ], true ]
    c : GTensor gd.add[ gd.mul[ gd.leaky[ x, 0.1 ], m ], zc ]
    g : GTensor gd.join[ gd.tanh_of[ c ], gd.sigmoid[ c ] ]
    j : GTensor gd.add[ gd.gate[ g, gc ], gd.slice[ g, 3, 6 ] ]
    k : GTensor gd.mul[ j, gd.exp_of[ gd.scale[ c, 0.3 ] ] ]
    l : GTensor gd.layer_norm[ k, ga, be ]
    gd.upload[ gd.grad_of[ l ], grad_gold[ dir, 'e_dl' ] ]
    i : i64 [ gd.tape.count - 1 ]
    while [ i >= 0 ]
        gd.back_op[ gd.tape[ i ] ]
        i -= 1
    gd.rn.finish[]
    e : vec f64 [] [
        grad_worst[ gd.download[ l ], grad_gold[ dir, 'e_l' ] ],
        grad_worst[ gd.download[ x.gr ], grad_gold[ dir, 'e_dx' ] ],
        grad_worst[ gd.download[ zc.gr ], grad_gold[ dir, 'e_dzc' ] ],
        grad_worst[ gd.download[ m.gr ], grad_gold[ dir, 'e_dm' ] ],
        grad_worst[ gd.download[ gc.gr ], grad_gold[ dir, 'e_dgc' ] ],
        grad_worst[ gd.download[ ga.gr ], grad_gold[ dir, 'e_dga' ] ],
        grad_worst[ gd.download[ be.gr ], grad_gold[ dir, 'e_dbe' ] ] ]
    log 'grad elementwise: out {e[ 0 ]} dx {e[ 1 ]} dz {e[ 2 ]} dmask {e[ 3 ]} dcond {e[ 4 ]} dgamma {e[ 5 ]} dbeta {e[ 6 ]}'
    ok : bool [ true ]
    for [ v: f64 ] in e
        if [ v > 0.0001 ] ok = false
    return ok

# rvc's relative attention with a mask vs pytorch
expect func t_grad_attention [] -> bool
    ge : cstr [ getenv[ 'GRAD_GOLD' ] ]
    if [ !ge ] return true
    dir : string [ ge ]
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, backbuffer: true, width: 64, height: 64 ]
    Au.hold[ disp ]
    gd : Grad [ vk: vk, keep_mb: 16, work_mb: 64 ]
    gd.record = true
    q  : GTensor grad_load[ gd, dir, 'a_q', vec i64 [] [ 2, 12, 30 ],
                            true ]
    kk : GTensor grad_load[ gd, dir, 'a_k', vec i64 [] [ 2, 12, 30 ],
                            true ]
    v  : GTensor grad_load[ gd, dir, 'a_v', vec i64 [] [ 2, 12, 30 ],
                            true ]
    ek : GTensor grad_load[ gd, dir, 'a_ek', vec i64 [] [ 21, 6 ],
                            true ]
    ev : GTensor grad_load[ gd, dir, 'a_ev', vec i64 [] [ 21, 6 ],
                            true ]
    m  : GTensor grad_load[ gd, dir, 'a_m', vec i64 [] [ 2, 1, 30 ],
                            false ]
    o  : GTensor gd.attention[ q, kk, v, ek, ev, m, 2, 10 ]
    gd.upload[ gd.grad_of[ o ], grad_gold[ dir, 'a_do' ] ]
    gd.back_op[ gd.tape[ gd.tape.count - 1 ] ]
    gd.rn.finish[]
    e : vec f64 [] [
        grad_worst[ gd.download[ o ], grad_gold[ dir, 'a_o' ] ],
        grad_worst[ gd.download[ q.gr ], grad_gold[ dir, 'a_dq' ] ],
        grad_worst[ gd.download[ kk.gr ], grad_gold[ dir, 'a_dk' ] ],
        grad_worst[ gd.download[ v.gr ], grad_gold[ dir, 'a_dv' ] ],
        grad_worst[ gd.download[ ek.gr ], grad_gold[ dir, 'a_dek' ] ],
        grad_worst[ gd.download[ ev.gr ], grad_gold[ dir, 'a_dev' ] ] ]
    log 'grad attention: out {e[ 0 ]} dq {e[ 1 ]} dk {e[ 2 ]} dv {e[ 3 ]} dek {e[ 4 ]} dev {e[ 5 ]}'
    ok : bool [ true ]
    for [ w: f64 ] in e
        if [ w > 0.0001 ] ok = false
    return ok

# causal attention and cross entropy vs pytorch
expect func t_grad_lm [] -> bool
    ge : cstr [ getenv[ 'GRAD_GOLD' ] ]
    if [ !ge ] return true
    dir : string [ ge ]
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, backbuffer: true, width: 64, height: 64 ]
    Au.hold[ disp ]
    gd : Grad [ vk: vk, keep_mb: 16, work_mb: 64 ]
    gd.record = true
    dims : vec i64 [] [ 2, 12, 30 ]
    q  : GTensor grad_load[ gd, dir, 'c_q', dims, true ]
    kk : GTensor grad_load[ gd, dir, 'c_k', dims, true ]
    v  : GTensor grad_load[ gd, dir, 'c_v', dims, true ]
    o  : GTensor gd.causal_attention[ q, kk, v, 2 ]
    gd.upload[ gd.grad_of[ o ], grad_gold[ dir, 'c_do' ] ]
    gd.back_op[ gd.tape[ gd.tape.count - 1 ] ]
    gd.tape_cut[ 0 ]
    x : GTensor grad_load[ gd, dir, 'x_x', vec i64 [] [ 20, 37 ],
                           true ]
    ids : GTensor grad_load[ gd, dir, 'x_ids', vec i64 [] [ 20 ],
                             false ]
    loss : GTensor gd.xent[ x, ids ]
    gd.backward[ loss ]
    gd.tape_cut[ 0 ]
    z : GTensor grad_load[ gd, dir, 'b_z', vec i64 [] [ 6, 64 ], true ]
    bits : GTensor grad_load[ gd, dir, 'b_bits', vec i64 [] [ 6, 64 ],
                              false ]
    lb : GTensor gd.bce[ z, bits ]
    gd.backward[ lb ]
    e : vec f64 [] [
        grad_worst[ gd.download[ o ], grad_gold[ dir, 'c_o' ] ],
        grad_worst[ gd.download[ q.gr ], grad_gold[ dir, 'c_dq' ] ],
        grad_worst[ gd.download[ kk.gr ], grad_gold[ dir, 'c_dk' ] ],
        grad_worst[ gd.download[ v.gr ], grad_gold[ dir, 'c_dv' ] ],
        grad_worst[ gd.download[ loss ], grad_gold[ dir, 'x_loss' ] ],
        grad_worst[ gd.download[ x.gr ], grad_gold[ dir, 'x_dx' ] ],
        grad_worst[ gd.download[ lb ], grad_gold[ dir, 'b_loss' ] ],
        grad_worst[ gd.download[ z.gr ], grad_gold[ dir, 'b_dz' ] ] ]
    log 'grad lm: out {e[ 0 ]} dq {e[ 1 ]} dk {e[ 2 ]} dv {e[ 3 ]} loss {e[ 4 ]} dx {e[ 5 ]} bits loss {e[ 6 ]} dz {e[ 7 ]}'
    ok : bool [ true ]
    for [ w: f64 ] in e
        if [ w > 0.0001 ] ok = false
    return ok

# linear, lookup, swap, flip, wnorm conv vs pytorch
expect func t_grad_misc [] -> bool
    ge : cstr [ getenv[ 'GRAD_GOLD' ] ]
    if [ !ge ] return true
    dir : string [ ge ]
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, backbuffer: true, width: 64, height: 64 ]
    Au.hold[ disp ]
    gd : Grad [ vk: vk, keep_mb: 16, work_mb: 64 ]
    gd.record = true
    x   : GTensor grad_load[ gd, dir, 'm_x', vec i64 [] [ 2, 7, 5 ],
                             true ]
    lw  : GTensor grad_load[ gd, dir, 'm_lw', vec i64 [] [ 4, 5 ],
                             true ]
    lb  : GTensor grad_load[ gd, dir, 'm_lb', vec i64 [] [ 4 ], true ]
    ids : GTensor grad_load[ gd, dir, 'm_ids', vec i64 [] [ 2, 7 ],
                             false ]
    tab : GTensor grad_load[ gd, dir, 'm_tab', vec i64 [] [ 6, 4 ],
                             true ]
    v   : GTensor grad_load[ gd, dir, 'm_v', vec i64 [] [ 3, 4, 3 ],
                             true ]
    wg  : GTensor grad_load[ gd, dir, 'm_g', vec i64 [] [ 3 ], true ]
    h : GTensor gd.add[ gd.linear[ x, lw, lb ], gd.lookup[ ids, tab ] ]
    y : GTensor gd.conv1d[ gd.flip[ gd.swap12[ h ] ], gd.wnorm[ v, wg ],
                           null, 1, 1, 1, 1 ]
    gd.upload[ gd.grad_of[ y ], grad_gold[ dir, 'm_dy' ] ]
    i : i64 [ gd.tape.count - 1 ]
    while [ i >= 0 ]
        gd.back_op[ gd.tape[ i ] ]
        i -= 1
    gd.rn.finish[]
    e : vec f64 [] [
        grad_worst[ gd.download[ y ], grad_gold[ dir, 'm_y' ] ],
        grad_worst[ gd.download[ x.gr ], grad_gold[ dir, 'm_dx' ] ],
        grad_worst[ gd.download[ lw.gr ], grad_gold[ dir, 'm_dlw' ] ],
        grad_worst[ gd.download[ lb.gr ], grad_gold[ dir, 'm_dlb' ] ],
        grad_worst[ gd.download[ tab.gr ], grad_gold[ dir, 'm_dtab' ] ],
        grad_worst[ gd.download[ v.gr ], grad_gold[ dir, 'm_dv' ] ],
        grad_worst[ gd.download[ wg.gr ], grad_gold[ dir, 'm_dg' ] ] ]
    log 'grad misc: out {e[ 0 ]} dx {e[ 1 ]} dlw {e[ 2 ]} dlb {e[ 3 ]} dtab {e[ 4 ]} dv {e[ 5 ]} dg {e[ 6 ]}'
    ok : bool [ true ]
    for [ w: f64 ] in e
        if [ w > 0.0001 ] ok = false
    return ok

# training ops in one weighted loss, and adamw, vs pytorch
expect func t_grad_training [] -> bool
    ge : cstr [ getenv[ 'GRAD_GOLD' ] ]
    if [ !ge ] return true
    dir : string [ ge ]
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, backbuffer: true, width: 64, height: 64 ]
    Au.hold[ disp ]
    gd : Grad [ vk: vk, keep_mb: 16, work_mb: 64 ]
    gd.record = true
    x   : GTensor grad_load[ gd, dir, 'tr_x', vec i64 [] [ 2, 1, 40 ],
                             true ]
    bs  : GTensor grad_load[ gd, dir, 'tr_basis',
                             vec i64 [] [ 18, 1, 16 ], false ]
    mw  : GTensor grad_load[ gd, dir, 'tr_melw', vec i64 [] [ 5, 9, 1 ],
                             false ]
    tg  : GTensor grad_load[ gd, dir, 'tr_tgt', vec i64 [] [ 2, 5, 10 ],
                             false ]
    x2  : GTensor grad_load[ gd, dir, 'tr_x2', vec i64 [] [ 2, 3, 20 ],
                             true ]
    x3  : GTensor grad_load[ gd, dir, 'tr_x3', vec i64 [] [ 2, 2, 12 ],
                             true ]
    w3  : GTensor grad_load[ gd, dir, 'tr_w3', vec i64 [] [ 4, 2, 3 ],
                             true ]
    zp  : GTensor grad_load[ gd, dir, 'tr_zp', vec i64 [] [ 2, 3, 6 ],
                             true ]
    lq  : GTensor grad_load[ gd, dir, 'tr_lq', vec i64 [] [ 2, 3, 6 ],
                             true ]
    mp  : GTensor grad_load[ gd, dir, 'tr_mp', vec i64 [] [ 2, 3, 6 ],
                             true ]
    lp  : GTensor grad_load[ gd, dir, 'tr_lp', vec i64 [] [ 2, 3, 6 ],
                             true ]
    mk  : GTensor grad_load[ gd, dir, 'tr_mk', vec i64 [] [ 2, 1, 6 ],
                             false ]
    ids : GTensor gd.temp[ vec i64 [] [ 2 ] ]
    iv : vec f32 [ 2 ]
    iv[ 0 ] = 3.0
    iv[ 1 ] = 7.0
    gd.upload[ ids, iv ]
    sp : GTensor gd.conv1d[ gd.pad_reflect[ x, 7, 7 ], bs, null, 4, 0, 1,
                            1 ]
    ml : GTensor gd.log_clamp[
        gd.conv1d[ gd.magnitude[ sp, 0.0000002 ], mw, null, 1, 0, 1, 1 ],
        0.000002 ]
    l1 : GTensor gd.l1[ ml, tg ]
    l2 : GTensor gd.lsq[ gd.tslice_ids[ x2, ids, 5, 1 ], 1.0 ]
    l3 : GTensor gd.lsq[
        gd.conv1d[ gd.period_fold[ x3, 3 ], w3, null, 1, 1, 1, 1 ],
        0.0 ]
    l4 : GTensor gd.kl[ zp, lq, mp, lp, mk, 10.0 ]
    wts : vec f32 [ 4 ]
    wts[ 0 ] = 45.0
    wts[ 1 ] = 1.0
    wts[ 2 ] = 1.0
    wts[ 3 ] = 1.0
    gd.backward_all[ vec GTensor [] [ l1, l2, l3, l4 ], wts ]
    gd.rn.finish[]
    ls : vec f32 [ 4 ]
    lt : vec GTensor [] [ l1, l2, l3, l4 ]
    for [ i: i64 0, i < 4, i += 1 ]
        one : vec f32 gd.download[ lt[ i ] ]
        ls[ i ] = one[ 0 ]
    e : vec f64 [] [ grad_worst[ ls, grad_gold[ dir, 'tr_losses' ] ],
        grad_worst[ gd.download[ x.gr ], grad_gold[ dir, 'tr_dx' ] ],
        grad_worst[ gd.download[ x2.gr ], grad_gold[ dir, 'tr_dx2' ] ],
        grad_worst[ gd.download[ x3.gr ], grad_gold[ dir, 'tr_dx3' ] ],
        grad_worst[ gd.download[ w3.gr ], grad_gold[ dir, 'tr_dw3' ] ],
        grad_worst[ gd.download[ zp.gr ], grad_gold[ dir, 'tr_dzp' ] ],
        grad_worst[ gd.download[ lq.gr ], grad_gold[ dir, 'tr_dlq' ] ],
        grad_worst[ gd.download[ mp.gr ], grad_gold[ dir, 'tr_dmp' ] ],
        grad_worst[ gd.download[ lp.gr ], grad_gold[ dir, 'tr_dlp' ] ] ]
    # adamw: two steps against torch's
    gd.record = false
    aw : GTensor grad_load[ gd, dir, 'ad_w0', vec i64 [] [ 50 ], false ]
    am : GTensor gd.temp[ vec i64 [] [ 50 ] ]
    av : GTensor gd.temp[ vec i64 [] [ 50 ] ]
    gd.fill[ am, 0.0 ]
    gd.fill[ av, 0.0 ]
    aw.gr = grad_load[ gd, dir, 'ad_g1', vec i64 [] [ 50 ], false ]
    gd.adamw[ aw, am, av, 0.0001, 0.8, 0.99, 0.000000001, 0.01, 1 ]
    aw.gr = grad_load[ gd, dir, 'ad_g2', vec i64 [] [ 50 ], false ]
    gd.adamw[ aw, am, av, 0.0001, 0.8, 0.99, 0.000000001, 0.01, 2 ]
    gd.rn.finish[]
    ae : f64 grad_worst[ gd.download[ aw ], grad_gold[ dir, 'ad_w2' ] ]
    log 'grad training: losses {e[ 0 ]} dx {e[ 1 ]} dslice {e[ 2 ]} dfold {e[ 3 ]} dw {e[ 4 ]} kl {e[ 5 ]} {e[ 6 ]} {e[ 7 ]} {e[ 8 ]}; adamw {ae}'
    ok : bool [ ae < 0.000001 ]
    for [ w: f64 ] in e
        if [ w > 0.0005 ] ok = false
    return ok

# the split-sum gemm (few tiles, a long sum) vs doubles on the cpu
expect func t_grad_gemm_split [] -> bool
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, backbuffer: true, width: 64, height: 64 ]
    Au.hold[ disp ]
    gd : Grad [ vk: vk, keep_mb: 16, work_mb: 128 ]
    m : i64 [ 32 ]
    n : i64 [ 96 ]
    k : i64 [ 25601 ]
    av : vec f32 [ m * k ]
    bv : vec f32 [ n * k ]
    for [ i: i64 0, i < m * k, i += 1 ]
        av[ i ] = f32[ sin[ f64[ i ] * 0.37 ] ]
    for [ i: i64 0, i < n * k, i += 1 ]
        bv[ i ] = f32[ cos[ f64[ i ] * 0.11 ] ]
    ta : GTensor gd.temp[ gd.dims3[ 1, m, k ] ]
    tb : GTensor gd.temp[ gd.dims3[ 1, n, k ] ]
    tc : GTensor gd.temp[ gd.dims3[ 1, m, n ] ]
    gd.upload[ ta, av ]
    gd.upload[ tb, bv ]
    gd.fill[ tc, 0.5 ]
    worst : f64 [ 0.0 ]
    for [ pass: i32 0, pass < 2, pass += 1 ]
        bt : f32 [ pass ]
        gd.gemm[ GView [ t: ta, rs: k, cs: 1, bs: 0 ],
                 GView [ t: tb, rs: 1, cs: k, bs: 0 ],
                 GView [ t: tc, rs: n, cs: 1, bs: 0 ], m, n, k, 1, 2.0,
                 bt ]
        gd.rn.finish[]
        cv : vec f32 gd.download[ tc ]
        for [ r: i64 0, r < m, r += 1 ]
            for [ c: i64 0, c < n, c += 1 ]
                acc : f64 [ 0.0 ]
                for [ q: i64 0, q < k, q += 1 ]
                    acc += f64[ av[ r * k + q ] ] * f64[
                        bv[ c * k + q ] ]
                want : f64 [ 2.0 * acc ]
                # pass 1 adds pass 0's result once more
                if [ pass == 1 ] want = 4.0 * acc
                e : f64 [ fabs[ f64[ cv[ r * n + c ] ] - want ] ]
                if [ e > worst ] worst = e
    log 'grad gemm split: 32x96 over 25601, worst {worst}'
    gd.release[]
    return worst < 0.01

# a full arena throws; the grad still releases after it
expect func t_grad_arena_full [] -> bool
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, backbuffer: true, width: 64, height: 64 ]
    Au.hold[ disp ]
    gd : Grad [ vk: vk, keep_mb: 1, work_mb: 1 ]
    a : GTensor gd.temp[ gd.dims3[ 1, 1, 1000 ] ]
    gd.fill[ a, 2.0 ]
    caught : string [ null ]
    try
        b : GTensor gd.temp[ gd.dims3[ 1, 1024, 1024 ] ]
        gd.fill[ b, 1.0 ]
    catch [ message: string ]
        caught = message
    gd.rn.finish[]
    v : vec f32 gd.download[ a ]
    gd.release[]
    log 'grad arena full: {caught}; earlier tensor {v[ 999 ]}'
    return caught && caught.starts_with[ 'grad: arena full' ] && v[
        999 ] == 2.0

intern pool_probe_freed : i64

class PoolProbe
    public n : i64
    func dealloc []
        pool_probe_freed += 1

func pool_probe_make [] -> i64
    p : PoolProbe [ n: 3 ]
    return p.n

# a drain to a mark frees only what came after it
expect func t_grad_pool_mark [] -> bool
    keep : PoolProbe [ n: 7 ]
    base : i64 [ pool_probe_freed ]
    mk : i32 [ Au.auto_mark[] ]
    q : i64 pool_probe_make[]
    Au.auto_free_to[ mk ]
    freed : i64 [ pool_probe_freed - base ]
    log 'grad pool mark: freed {freed} after the mark, kept {keep.n}'
    return q == 3 && freed == 1 && keep.n == 7

# both gemm kernels, every stride layout, vs doubles on the cpu
expect func t_grad_gemm_layouts [] -> bool
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, backbuffer: true, width: 64, height: 64 ]
    Au.hold[ disp ]
    gd : Grad [ vk: vk, keep_mb: 16, work_mb: 64 ]
    worst : f64 [ 0.0 ]
    shapes : vec i64 [ 4 ]
    shapes[ 0 ] = 200
    shapes[ 1 ] = 150
    shapes[ 2 ] = 50
    shapes[ 3 ] = 150
    for [ sh: i64 0, sh < 2, sh += 1 ]
        m : i64 [ shapes[ sh * 2 ] ]
        n : i64 [ shapes[ sh * 2 + 1 ] ]
        k : i64 [ 77 ]
        nb : i64 [ 2 ]
        av : vec f32 [ nb * m * k ]
        bv : vec f32 [ nb * k * n ]
        for [ i: i64 0, i < av.count, i += 1 ]
            av[ i ] = f32[ sin[ f64[ i ] * 0.37 ] ]
        for [ i: i64 0, i < bv.count, i += 1 ]
            bv[ i ] = f32[ cos[ f64[ i ] * 0.11 ] ]
        ta : GTensor gd.temp[ gd.dims3[ nb, m, k ] ]
        tb : GTensor gd.temp[ gd.dims3[ nb, k, n ] ]
        tc : GTensor gd.temp[ gd.dims3[ nb, m, n ] ]
        gd.upload[ ta, av ]
        gd.upload[ tb, bv ]
        for [ lay: i32 0, lay < 4, lay += 1 ]
            # bit 1: a is m-contiguous; bit 2: b is k-contiguous
            a_rs : i64 [ ((lay & 1) != 0) ? 1 : k ]
            a_cs : i64 [ ((lay & 1) != 0) ? m : 1 ]
            b_rs : i64 [ ((lay & 2) != 0) ? 1 : n ]
            b_cs : i64 [ ((lay & 2) != 0) ? k : 1 ]
            for [ pass: i32 0, pass < 2, pass += 1 ]
                if [ pass == 0 ] gd.fill[ tc, 0.5 ]
                bt : f32 [ pass ]
                gd.gemm_run[
                    GView [ t: ta, rs: a_rs, cs: a_cs, bs: m * k ],
                    GView [ t: tb, rs: b_rs, cs: b_cs, bs: k * n ],
                    GView [ t: tc, rs: n, cs: 1, bs: m * n ], m, n, k,
                    nb, 2.0, bt ]
                gd.rn.finish[]
                cv : vec f32 gd.download[ tc ]
                for [ b: i64 0, b < nb, b += 1 ]
                    for [ r: i64 0, r < m, r += 1 ]
                        for [ c: i64 0, c < n, c += 1 ]
                            acc : f64 [ 0.0 ]
                            for [ q: i64 0, q < k, q += 1 ]
                                ai : i64 [
                                    b * m * k + r * a_rs + q * a_cs ]
                                bi : i64 [
                                    b * k * n + q * b_rs + c * b_cs ]
                                acc += f64[ av[ ai ] ] * f64[ bv[ bi ] ]
                            # pass 1 adds pass 0's result once more
                            want : f64 [
                                (pass == 0) ? 2.0 * acc : 4.0 * acc ]
                            e : f64 [
                                fabs[
                                    f64[ cv[ b * m * n + r * n + c ] ]
                                    - want ] ]
                            if [ e > worst ] worst = e
    log 'grad gemm layouts: 200x150 and 50x150 over 77, 4 layouts, worst {worst}'
    gd.release[]
    return worst < 0.0001

# gemm throughput on a 2048 cube (GRAD_BENCH)
expect func t_grad_gemm_speed [] -> bool
    if [ !getenv[ 'GRAD_BENCH' ] ] return true
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, backbuffer: true, width: 64, height: 64 ]
    Au.hold[ disp ]
    gd : Grad [ vk: vk, keep_mb: 16, work_mb: 256 ]
    n : i64 [ 2048 ]
    a : GTensor gd.temp[ vec i64 [] [ n, n ] ]
    b : GTensor gd.temp[ vec i64 [] [ n, n ] ]
    c : GTensor gd.temp[ vec i64 [] [ n, n ] ]
    gd.fill[ a, 0.5 ]
    gd.fill[ b, 0.25 ]
    gd.rn.finish[]
    t0 : i64 [ Au.epoch_micros[] ]
    for [ r: i32 0, r < 10, r += 1 ]
        gd.gemm[ GView [ t: a, rs: n, cs: 1, bs: 0 ],
                 GView [ t: b, rs: n, cs: 1, bs: 0 ],
                 GView [ t: c, rs: n, cs: 1, bs: 0 ], n, n, n, 1, 1.0,
                 0.0 ]
    gd.rn.finish[]
    us : f64 [ Au.epoch_micros[] - t0 ]
    tf : f64 [
        10.0 * 2.0 * f64[ n ] * f64[ n ] * f64[ n ] / us / 1000000.0 ]
    log 'grad gemm speed: 10 x 2048^3 in {us / 1000.0} ms, {tf} TFLOPS'
    gd.release[]
    return true
