class Mesh
    public name:            string
    public primitives:      vec Primitive
    public weights:         vec f32
    public extras:          MeshExtras
    func get_primitive [n: cstr] -> Primitive
        for [p: Primitive] in primitives
            if [strcmp [p.name, n] == 0]
                return p
        return null

class Scene
    public name:            string
    public nodes:           vec i64

class AssetDesc
    public generator:       string
    public copyright:       string
    public version:         string

class GltfBuffer
    public byteLength:      u64
    public uri:             path
    public data:            vec u8
    intern static base :    path

    static func set_base [ p: path ]
        base = p

    static func get_base [] -> path
        return base

    func init []
        if [ !uri ]
            return
        str  : string[ uri ]
        name : (base) ? '{base}/{str}' : str
        rp : Res.res_path[ name ]
        fp : @FILE [ fopen[ rp.chars, "rb" ] ]
        if [ !fp ]
            alt : (str.starts_with[ 'models/' ]) ? str : 'models/{str}'
            rp2 : Res.res_path[ alt ]
            fp = fopen[ rp2.chars, "rb" ]
        if [ !fp ]
            log 'GltfBuffer: failed to open {name}'
            return
        fseek[ fp, 0, SEEK_END ]
        length: i64 [ ftell[ fp ] ]
        rewind[ fp ]
        if [ byteLength > 0 && u64[ length ] < byteLength ]
            log 'GltfBuffer: {uri.chars} is {length} bytes but the gltf declares {byteLength} — unfetched git-lfs pointer? (git lfs pull)'
        buf: new u8 [ length ]
        fread[ buf, 1, length, fp ]
        fclose[ fp ]
        data       = buf
        byteLength = length

class ResKey
    intern h    : u64
    intern seq  : vec u8
    intern bidx : i32
    intern pass : i32

    func init []
        seq = new u8 [ 256 ]

    func rehash []
        for [ w: i32 0, w < 32, w += 1 ]
            h = h ^ (h << 13)
            h = h ^ (h >> 7)
            h = h ^ (h << 17)
            for [ b: i32 0, b < 8, b += 1 ]
                sh : u64 [ u64[ b ] * 8 ]
                seq[ w * 8 + b ] = u8[ (h >> sh) & 255 ]

    func seed [ pw: string ]
        s : string [ ]
        for [ r: i32 0, r < 16, r += 1 ]
            s = '{s}{pw}'
        h = 0xcbf29ce484222325
        for [ i: i32 0, i < s.count, i += 1 ]
            h = (h ^ u64[ u8[ s.chars[ i ] ] ]) * 0x100000001b3
        rehash[]
        bidx = 0
        pass = 0

    func seek [ pos: u64 ]
        s : u64 [ pos / 5632 ]
        for [ k: u64 0, k < s, k += 1 ]
            rehash[]
        rem : u64 [ pos - s * 5632 ]
        pass = i32[ rem / 256 ]
        bidx = i32[ rem % 256 ]

    func apply [ buf: @u8, n: i64 ]
        for [ j: i64 0, j < n, j += 1 ]
            buf[ j ] = buf[ j ] ^ seq[ bidx ]
            bidx = bidx + 1
            if [ bidx >= 256 ]
                bidx = 0
                pass = pass + 1
                if [ pass >= 22 ]
                    pass = 0
                    rehash[]

# fnv-1a 64-bit over a name string
func res_hname [ name: string ] -> u64
    h : u64 [ 0xcbf29ce484222325 ]
    for [ i: i32 0, i < name.count, i += 1 ]
        h = (h ^ u64[ u8[ name.chars[ i ] ] ]) * 0x100000001b3
    return h

func res_hkey [ name: string, size: u64 ] -> u64
    return (res_hname[ name ] ^ size) * 0x100000001b3

class Res
    intern static magic : u32 [ 0x32534552 ]

    intern isrc    : path
    intern ibase   : path
    intern icache  : path
    intern ipw     : string
    intern iobsc   : bool
    intern iblob   : u64
    intern icount  : i32
    intern inhash  : vec u64
    intern ichash  : vec u64
    intern ioffs   : vec u64
    intern isizes  : vec u64

    # 16-hex-char cache filename from a 64-bit content hash
    static func hex16 [ v: u64 ] -> string
        buf : new i8 [ 17 ]
        snprintf[ buf, 17, "%016lx", v ]
        return string[ buf ]

    # pack files (relative names under base) into dest .res
    static func pack [ base: path, names: vec string, dest: path,
                       pw: string, obscure: bool ] -> bool
        n     : i32 [ names.count ]
        sizes : new u64 [ n ]
        nhash : new u64 [ n ]
        chash : new u64 [ n ]
        chunk : new u8 [ 65536 ]
        for [ i: i32 0, i < n, i += 1 ]
            nm : names[ i ]
            fp : @FILE [ fopen[ '{base}/{nm}', 'rb' ] ]
            if [ !fp ]
                log 'res: cannot open {base}/{nm}'
                return false
            fseek[ fp, 0, SEEK_END ]
            sz : u64 [ ftell[ fp ] ]
            fclose[ fp ]
            sizes[ i ] = sz
            nhash[ i ] = res_hname[ nm ]
            chash[ i ] = res_hkey[ nm, sz ]
        out : @FILE [ fopen[ dest.chars, 'wb' ] ]
        if [ !out ]
            log 'res: cannot write {dest.chars}'
            return false
        m  : u32 [ magic ]
        v  : u32 [ 2 ]
        ob : u32 [ (obscure) ? 1 : 0 ]
        c  : u32 [ n ]
        fwrite[ @m,  4, 1, out ]
        fwrite[ @v,  4, 1, out ]
        fwrite[ @ob, 4, 1, out ]
        fwrite[ @c,  4, 1, out ]
        off : u64 [ 0 ]
        for [ i: i32 0, i < n, i += 1 ]
            nh : u64 [ nhash[ i ] ]
            ch : u64 [ chash[ i ] ]
            sz : u64 [ sizes[ i ] ]
            fwrite[ @nh,  8, 1, out ]
            fwrite[ @ch,  8, 1, out ]
            fwrite[ @off, 8, 1, out ]
            fwrite[ @sz,  8, 1, out ]
            off = off + sz
        key : ResKey [ ]
        key.seed[ pw ]
        total : u64 [ 0 ]
        for [ i: i32 0, i < n, i += 1 ]
            fp : @FILE [ fopen[ '{base}/{names[ i ]}', 'rb' ] ]
            if [ !fp ] return false
            remain : u64 [ sizes[ i ] ]
            while [ remain > 0 ]
                want : i64 [ (remain > 65536) ? 65536 : i64[ remain ] ]
                got  : i64 [ fread[ chunk, 1, want, fp ] ]
                if [ got <= 0 ] break
                if [ obscure ] key.apply[ chunk, got ]
                fwrite[ chunk, 1, got, out ]
                total  = total + u64[ got ]
                remain = remain - u64[ got ]
            fclose[ fp ]
        fclose[ out ]
        log 'res: packed {n} files -> {dest.chars} ({total} bytes, obscured={ob})'
        return true

    func load [ res_path: path, base_dir: path, cache_dir: path,
                password: string ] -> bool
        isrc   = res_path
        ibase  = base_dir
        icache = cache_dir
        ipw    = password
        fp : @FILE [ fopen[ res_path.chars, 'rb' ] ]
        if [ !fp ]
            log 'res: cannot open {res_path.chars}'
            return false
        m  : u32 [ 0 ]
        v  : u32 [ 0 ]
        ob : u32 [ 0 ]
        c  : u32 [ 0 ]
        fread[ @m,  4, 1, fp ]
        fread[ @v,  4, 1, fp ]
        fread[ @ob, 4, 1, fp ]
        fread[ @c,  4, 1, fp ]
        if [ m != magic ]
            log 'res: bad magic in {res_path.chars}'
            fclose[ fp ]
            return false
        iobsc  = ob != 0
        icount = i32[ c ]
        inhash = new u64 [ icount ]
        ichash = new u64 [ icount ]
        ioffs  = new u64 [ icount ]
        isizes = new u64 [ icount ]
        for [ i: i32 0, i < icount, i += 1 ]
            nh : u64 [ 0 ]
            ch : u64 [ 0 ]
            o  : u64 [ 0 ]
            s  : u64 [ 0 ]
            fread[ @nh, 8, 1, fp ]
            fread[ @ch, 8, 1, fp ]
            fread[ @o,  8, 1, fp ]
            fread[ @s,  8, 1, fp ]
            inhash[ i ] = nh
            ichash[ i ] = ch
            ioffs[ i ]  = o
            isizes[ i ] = s
        cbytes : u64 [ u64[ icount ] * 32 ]
        iblob  = 16 + cbytes
        fclose[ fp ]
        icache.make_dir[]
        return true

    static func dotext [ name: string ] -> string
        np : path [ name ]
        e  : np.ext[]
        if [ e && e.count > 0 ] return '.{e}'
        return ''

    func cache_path [ i: i32, ext: string ] -> path
        hx : Res.hex16[ ichash[ i ] ]
        return path '{icache}/{hx}{ext}'

    # extract entry i into the cache if not already present
    func ensure [ i: i32, ext: string ] -> path
        cp : cache_path[ i, ext ]
        if [ cp.exists[] ] return cp
        fp : @FILE [ fopen[ isrc.chars, 'rb' ] ]
        if [ !fp ] return cp
        fseek[ fp, i64[ iblob + ioffs[ i ] ], SEEK_SET ]
        key : ResKey [ ]
        if [ iobsc ]
            key.seed[ ipw ]
            key.seek[ ioffs[ i ] ]
        out : @FILE [ fopen[ cp.chars, 'wb' ] ]
        if [ !out ]
            fclose[ fp ]
            return cp
        chunk : new u8 [ 65536 ]
        remain : u64 [ isizes[ i ] ]
        while [ remain > 0 ]
            want : i64 [ (remain > 65536) ? 65536 : i64[ remain ] ]
            got  : i64 [ fread[ chunk, 1, want, fp ] ]
            if [ got <= 0 ] break
            if [ iobsc ] key.apply[ chunk, got ]
            fwrite[ chunk, 1, got, out ]
            remain = remain - u64[ got ]
        fclose[ out ]
        fclose[ fp ]
        return cp

    func extract_all []
        for [ i: i32 0, i < icount, i += 1 ]
            ensure[ i, '' ]
        log 'res: extract_all {icount} entries -> {icache.chars}'

    func find [ name: string ] -> path
        p : path name
        if [ p.exists[] ] return p
        nm : p.normalize[]
        ext : Res.dotext[ name ]
        nh : u64 [ res_hname[ nm ] ]
        for [ i: i32 0, i < icount, i += 1 ]
            if [ inhash[ i ] == nh ] return ensure[ i, ext ]
        return p

    func lookup [ name: string ] -> path
        nm : path [ name ]
        nm = nm.normalize[]
        ext : Res.dotext[ name ]
        nh : u64 [ res_hname[ nm ] ]
        for [ i: i32 0, i < icount, i += 1 ]
            if [ inhash[ i ] == nh ] return ensure[ i, ext ]
        return null

    intern static mounts : vec Res

    static func mount [ res_path: path, base_dir: path, cache_dir: path,
                        password: string ] -> Res
        arc : Res [ ]
        if [ !arc.load[ res_path, base_dir, cache_dir, password ] ]
            return null
        if [ !mounts ] mounts = vec Res []
        mounts += arc
        return arc

    static func res_path [ name: string ] -> path
        sh : path.path_share_path[]
        if [ sh ]
            sp : path '{sh}/{name}'
            if [ sp.exists[] ] return sp
        p : path name
        if [ p.exists[] ] return p
        if [ mounts ]
            for [ arc: Res ] in mounts
                loose : path '{arc.ibase}/{name}'
                if [ loose.exists[] ] return loose
                cp : arc.lookup[ name ]
                if [ cp ] return cp
        return p

