    public ior:                          f32
    # glTF's defaults when a file leaves a factor out
    public baseColorFactor:              vec4f [ 1.0, 1.0, 1.0, 1.0 ]
    public baseColorTexture:             TextureInfo
    public metallicFactor:               f32 [ 1.0 ]
    public roughnessFactor:              f32 [ 1.0 ]
    public metallicRoughnessTexture:     TextureInfo
