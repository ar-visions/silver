class GltfModel
    public nodes:            vec Node
    public skins:            vec Skin
    public accessors:        vec Accessor
    public bufferViews:      vec BufferView
    public meshes:           vec Mesh
    public buffers:          vec GltfBuffer
    public animations:       vec Animation
    public scenes:           vec Scene
    public materials:        vec Material
    public images:           vec GltfImage
    public textures:         vec GltfTexture
    public samplers:         vec GltfSampler
    public scene:            u64
    public asset:            AssetDesc
    # the gltf's own folder: its texture uris resolve from it later
    intern src_dir:          path

    # gltf uris resolve relative to the gltf file itself
    static func open [ p: path ] -> GltfModel
        if [ p.is_ext[ 'glb' ] ] return open_glb[ p ]
        GltfBuffer.set_base[ p.parent_dir[] ]
        m : p.load[ typeid[ GltfModel ], null ]
        GltfBuffer.set_base[ null ]
        g : cast GltfModel [ m ]
        if [ g ] g.src_dir = p.parent_dir[]
        return g

    # binary glTF: a JSON chunk, then one BIN chunk as buffer 0
    static func open_glb [ p: path ] -> GltfModel
        fp : @FILE [ fopen[ p.chars, "rb" ] ]
        if [ !fp ]
            log 'gltf: cannot open {p}'
            return null
        fseek[ fp, 0, SEEK_END ]
        length : i64 [ ftell[ fp ] ]
        rewind[ fp ]
        bytes : new u8 [ length ]
        fread[ bytes, 1, length, fp ]
        fclose[ fp ]
        b8   : @u8 [ bytes ]
        head : cast @u32 [ b8 ]
        if [ length < 28 || head[ 0 ] != 0x46546C67 || head[ 1 ] != 2 ]
            log 'gltf: {p} is not a version 2 glb'
            return null
        jlen  : i64 [ i64[ head[ 3 ] ] ]
        jtext : new i8 [ jlen + 1 ]
        jc    : @i8 [ jtext ]
        memcpy[ jc, @b8[ 20 ], jlen ]
        jc[ jlen ] = 0
        g : cast GltfModel [ Au.parse[ typeid[ GltfModel ], jc, null ] ]
        if [ !g ]
            log 'gltf: {p} has no readable JSON chunk'
            return null
        g.src_dir = p.parent_dir[]
        at : i64 [ 20 + jlen ]
        if [ at + 8 <= length && g.buffers && g.buffers.count > 0 ]
            bh   : cast @u32 [ @b8[ at ] ]
            blen : i64 [ i64[ bh[ 0 ] ] ]
            bin  : new u8 [ blen ]
            memcpy[ bin, @b8[ at + 8 ], blen ]
            buf0 : g.buffers[ 0 ]
            buf0.data       = bin
            buf0.byteLength = u64[ blen ]
        g.unpack_images[ p ]
        return g

    # a .glb's pictures go to the cache as files, named by the
    # glb and its time, so texture_uri finds them as any other
    func unpack_images [ p: path ]
        if [ !images || !buffers || buffers.count == 0 ] return
        cache : path.path_cache[ 'gltf' ]
        dir   : path '{cache}/{p.stem[]}-{p.modified_time[]}'
        dir.make_dir[]
        bin : buffers[ 0 ].data
        for [ i: i32 0, i < images.count, i += 1 ]
            im : images[ i ]
            if [ !im || im.uri || !im.mimeType ] continue
            png : bool [ im.mimeType == 'image/png' ]
            ext : string [ (png) ? 'png' : 'jpg' ]
            bv  : bufferViews[ im.bufferView ]
            to  : path '{dir}/image{i}.{ext}'
            if [ !to.exists[] ]
                out : @FILE [ fopen[ to.chars, "wb" ] ]
                if [ !out ]
                    log 'gltf: cannot write {to}'
                    continue
                src : @u8 [ bin ]
                fwrite[ @src[ bv.byteOffset ], 1, bv.byteLength, out ]
                fclose[ out ]
            im.uri = to

    func texture_uri [ ti: TextureInfo ] -> path
        if [ !ti || !textures ] return null
        if [ ti.index < 0 || ti.index >= textures.count ] return null
        tx : textures[ ti.index ]
        if [ !tx || !images ] return null
        if [ tx.source < 0 || tx.source >= images.count ] return null
        im : images[ tx.source ]
        if [ !im || !im.uri ] return null
        # beside the gltf when it is there; an archive finds the uri
        if [ src_dir ]
            own : path '{src_dir}/{im.uri}'
            if [ own.exists[] ] return own
        base : GltfBuffer.get_base[]
        if [ base ] return path '{base}/{im.uri}'
        return im.uri

    # glTF's default and 10497 repeat; 33071 is clamp to the edge
    func texture_repeats [ ti: TextureInfo, along_v: bool ] -> bool
        if [ !ti || !textures ] return true
        if [ ti.index < 0 || ti.index >= textures.count ] return true
        tx : textures[ ti.index ]
        if [ !tx || !samplers ] return true
        if [ tx.sampler < 0 || tx.sampler >= samplers.count ]
            return true
        sm : samplers[ tx.sampler ]
        mode : i64 [ (along_v) ? sm.wrapT : sm.wrapS ]
        return mode != 33071

    func find [n: cstr] -> Node
        for [node: Node] in nodes
            if [strcmp [node.name, n] == 0]
                return node
        return null

    func node_local [ n: Node ] -> mat4f
        if [ n.matrix.m[15] != 0.0 ] return n.matrix
        m : mat4f.identity[]
        m = m.translate[ n.translation ]
        if [
            n.rotation.x != 0 || n.rotation.y != 0 || n.rotation.z != 0
            || n.rotation.w != 0 ]
            m = m.rotate[ n.rotation ]
        if [ n.scale.x != 0 || n.scale.y != 0 || n.scale.z != 0 ]
            m = m.scale[ n.scale ]
        return m

    func compose_world [ ni: i64, parent: mat4f ]
        n : nodes[ ni ]
        if [ !n ] return
        w : mat4f [ parent.mul[ node_local[ n ] ] ]
        n.world = w
        if [ n.children ]
            for [ ci: i32 0, ci < n.children.count, ci += 1 ]
                compose_world[ n.children[ ci ], w ]

    func compute_worlds []
        if [ scenes && scenes.count > 0 ]
            sc : scenes[ scene ]
            if [ sc && sc.nodes ]
                for [ ri: i32 0, ri < sc.nodes.count, ri += 1 ]
                    compose_world[ sc.nodes[ ri ], mat4f.identity[] ]
        for [ n: Node ] in nodes
            if [ n.world.m[15] == 0.0 ]
                n.world = node_local[ n ]

    func index_of [n: cstr] -> i32
        i: i32 [0]
        for [node: Node] in nodes
            if [strcmp [node.name, n] == 0]
                return i
            i += 1
        return -1

    func index [n: string] -> Node
        return find [n]

    func node_transform [joints: JData, parent_mat: mat4f,
                          node_index: i32,
                          parent: GltfTransform] -> GltfTransform
        node: nodes[node_index]
        node.processed = true
        transform: GltfTransform

        if [ node.joint_index >= 0 ]
            transform.jdata = joints
            rotation_m: mat4f [node.rotation]
            transform.local_mat = mat4f []
            transform.local_mat = transform.local_mat.translate [node.translation]
            transform.local_mat = transform.local_mat.mul[ rotation_m ]
            transform.local_mat = transform.local_mat.scale[
                node.scale ]
            transform.local_default = transform.local_mat
            transform.iparent = parent.istate
            transform.istate  = node.joint_index
            state_mat: parent_mat.mul[ transform.local_default ]
            joints.states[transform.istate] = state_mat

            for [ child_idx: i64 ] in node.children
                ch: node_transform[ joints, state_mat, child_idx,
                                    transform]
                if [ch]
                    transform.ichildren += ch.istate
            
            joints.transforms += transform
        
        return transform

    func joints [node: Node] -> JData
        if [node.mx_joints]
            return node.mx_joints
        j: JData[]
        ident: mat4f.identity[]
        if [node.skin != -1]
            skin: skins[node.skin]
            all_children: map bool[i64]
            for [node_idx: i64] in skin.joints
                n: nodes[node_idx]
                for [i: i64] in n.children
                    all_children.set [i, true]
            j_index: i32 [0]
            for [node_idx: i64] in skin.joints
                n: nodes[node_idx]
                n.joint_index = j_index
                j_index += 1
            n: i32 [skin.joints.count]
            j.transforms = vec GltfTransform []
            j.states     = vec mat4f []
            
            for [ i: i32 0, i < n, i += 1 ]
                j.states.push ident

            
            for [node_idx: i64] in skin.joints
                if [all_children.contains [node_idx]]
                    continue
                node_transform [j, ident, node_idx, null]
        el
            n: i32 [j.states.count]
            for [i: i32 0, i < n, i += 1]
                j.states.push [ident]
        node.mx_joints = j
        return j

struct HumanVertex
    pos:       vec3f
    normal:    vec3f
    uv0:       vec2f
    uv1:       vec2f
    tangent:   vec3f
    joints0:   vec3f
    joints1:   vec3f
    weights0:  vec3f
    weights1:  vec3f


func pbr_defaults [] -> PbrMetallicRoughness
    static pbr: PbrMetallicRoughness
    if [ !pbr ]
        pbr = PbrMetallicRoughness[]
        pbr.baseColorFactor            = vec4f [ 0, 0, 1, 1 ]
        pbr.metallicFactor             = 1.0
        pbr.roughnessFactor            = 1.0
        pbr.emissiveFactor             = vec3f [ 0, 0, 0 ]
        pbr.diffuseFactor              = vec4f [ 1, 1, 1, 1 ]
        pbr.specularFactor             = vec3f [ 1, 1, 1 ]
        pbr.glossinessFactor           = 1.0
        pbr.sheenColorFactor           = vec3f [ 0, 0, 0 ]
        pbr.sheenRoughnessFactor       = 0.0
        pbr.clearcoatFactor            = 0.0
        pbr.clearcoatRoughnessFactor   = 0.0
        pbr.transmissionFactor         = 0.0
        pbr.thicknessFactor            = 0.0
        pbr.attenuationColor           = vec3f [ 1, 1, 1 ]
        pbr.attenuationDistance        = 1e20
        pbr.ior                        = 1.5
        pbr.specularColorFactor        = vec3f [ 1, 1, 1 ]
        pbr.emissiveStrength           = 1.0
        pbr.iridescenceFactor          = 0.0
        pbr.iridescenceIor             = 1.3
        pbr.iridescenceThicknessMinimum = 100.0
        pbr.iridescenceThicknessMaximum = 400.0
    return pbr

# a factor the file leaves out reads as glTF's default, 1
expect func t_pbr_defaults [] -> bool
    text : string '{{ "pbrMetallicRoughness": {{ "baseColorTexture": {{ "index": 0 }} }} }}'
    m : cast Material [ Au.parse[ typeid[ Material ], text.chars, null ] ]
    pbr : m.pbrMetallicRoughness
    given : string '{{ "pbrMetallicRoughness": {{ "metallicFactor": 0.05, "roughnessFactor": 0.6 }} }}'
    g : cast Material [ Au.parse[ typeid[ Material ], given.chars, null ] ]
    gp : g.pbrMetallicRoughness
    log 'pbr defaults: metal {pbr.metallicFactor} rough {pbr.roughnessFactor} base {pbr.baseColorFactor.x}; given {gp.metallicFactor} {gp.roughnessFactor}'
    return pbr.metallicFactor == 1.0 && pbr.roughnessFactor == 1.0
        && pbr.baseColorFactor.w == 1.0 && gp.metallicFactor < 0.1
        && gp.roughnessFactor < 0.7
