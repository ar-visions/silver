+            const VkMemoryBarrier mb = { .sType = VK_STRUCTURE_TYPE_MEMORY_BARRIER,
+                                         .srcAccessMask = VK_ACCESS_MEMORY_WRITE_BIT,
+                                         .dstAccessMask = VK_ACCESS_MEMORY_READ_BIT };
+            vk->BeginCommandBuffer(queue->sync_cmd, &bi);
+            vk->CmdPipelineBarrier(queue->sync_cmd, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+                                   VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, 0, 1, &mb, 0, NULL, 0, NULL);
+            vk->EndCommandBuffer(queue->sync_cmd);
+         }
+      }
+   }
+   const VkSubmitInfo si = {
+      .sType = VK_STRUCTURE_TYPE_SUBMIT_INFO,
+      .commandBufferCount = 1,
+      .pCommandBuffers = &queue->sync_cmd,
+   };
+   VkResult result = vk->QueueSubmit(queue->base.handle.queue, queue->sync_cmd ? 1 : 0,
+                                     queue->sync_cmd ? &si : NULL, sync->fence);
    mtx_unlock(&queue->vk_mutex);
 
