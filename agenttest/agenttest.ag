import trinity
import <stdlib.h>

expect func optional_description [] -> bool
    entry : ShotEntry [ text: 'Title' ]
    if [ entry.description || entry.open ] return false
    entry.add_description[ 'First line' ]
    entry.add_description[ 'Second line' ]
    if [ entry.text != 'Title' || entry.open ] return false
    return entry.description.count == 2 && entry.description[1] == 'Second line'
