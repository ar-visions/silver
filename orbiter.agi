# comments allowed
browse_single: 	true
max_search: 	4000000
code_font_size: 20
# each agent's models, first is the default
agents:
	claude:
		models: [ fable, opus ]
	codex:
		models: [ gpt-5-codex, gpt-5 ]

projects:
	orbiter: Project
		name: 	orbiter
		root: 	'orbiter'
		build:	silver orbiter
		cwd:	'.'
		run:	orbiter
		files:	orbiter.ag Editor.ag

consoles:
	shell: ConsoleInstance
		name:	shell
		kind:	shell

	claude: ConsoleInstance
		name:	claude
		kind:	claude
		run:	claude --dangerously-skip-permissions --model sonnet