{
    "version": "0.2.0",
    "configurations": [
        {
            "name":       "silver / hypercube",
            "type":       "lldb",
            "request":    "launch",
            "program":    "${workspaceFolder}/install/bin/silver",
            "args":     [ "hypercube" ],
            "cwd":        "/src/silver",
            "env":      {
                "SILVER_ISOLATE":   "0",
                "IMPORT":           "${workspaceFolder}/install"
            }
        },
        {
            "name":       "silver / orbiter",
            "type":       "lldb",
            "request":    "launch",
            "program":    "${workspaceFolder}/install/bin/silver",
            "args":     [ "orbiter" ],
            "cwd":        "/src/silver",
            "env":      {
                "SILVER_ISOLATE":   "0",
            }
        },
        {
            "name":       "silver / orion",
            "type":       "lldb",
            "request":    "launch",
            "stopOnEntry": false,
            "program":    "${workspaceFolder}/platform/native/debug/orion",
            "args":     [ ],
            "cwd":        "/src/silver"
        },
        {
            "name":       "silver / hyperspace",
            "type":       "lldb",
            "request":    "launch",
            "stopOnEntry": false,
            "program":    "${workspaceFolder}/platform/native/debug/hyperspace",
            "args":     [ "hyperspace" ],
            "cwd":        "/src/silver"
        },
        {
            "name":       "silver / asnes",
            "type":       "lldb",
            "request":    "launch",
            "stopOnEntry": false,
            "program":    "${workspaceFolder}/platform/native/debug/silver",
            "args":     [ "asnes", "--run", "--rom", "/src/silver/zelda.smc" ],
            "cwd":        "/src/silver"
        },
    ]
}