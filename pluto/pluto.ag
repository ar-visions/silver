# pluto: the target camera, black sky and haze
export 0.1.0
export scenes ['Pluto']
export dependencies ['orbiter']
import vec
import img
import gltf
import trinity
import tls
import scenes

import <stdio.h>
import <stdlib.h>
import <string.h>
# posix.h carries unistd where the header does not exist
ifdef [ windows ]
    import <posix.h>
ifndef [ windows ]
import <unistd.h>
        +_DEFAULT_SOURCE
        +_XOPEN_SOURCE=500

enum PlutoSurface
    albedo : 0
    height : 1
    normal : 2

ModelViewProject PlutoGround
    mutable hmax    : f32
    mutable sun_dir : vec4f
    mutable cam_pos : vec4f

    attrib albedo : LayoutBinding [ type:typeid[ PlutoSurface ],
                                    id:PlutoSurface.albedo, count:1,
                                    format:typeid[ rgba8 ] ]
    attrib height : LayoutBinding [ type:typeid[ PlutoSurface ],
                                    id:PlutoSurface.height, count:1,
                                    format:typeid[ rgba8 ] ]
    attrib normal : LayoutBinding [ type:typeid[ PlutoSurface ],
                                    id:PlutoSurface.normal, count:1,
                                    format:typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_uv        : VertexOutput [ type:typeid[ vec2f ] ]
    attrib v_world_pos : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_east      : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_north     : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_up        : VertexOutput [ type:typeid[ vec3f ] ]
    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    func vertex [] -> GLSL none {
        v_uv = a_uv;
        float h = textureLod(height, a_uv, 0.0).r * ubo.hmax;
        vec3 dir = normalize(a_pos);
        vec3 pos = dir * (1.0 + h);
        vec3 east = normalize(vec3(-dir.z, 0.0, dir.x));
        vec3 north = normalize(cross(dir, east));
        mat3 basis = mat3(ubo.model);
        vec4 wpos = ubo.model * vec4(pos, 1.0);
        v_world_pos = wpos.xyz;
        v_east = normalize(basis * east);
        v_north = normalize(basis * north);
        v_up = normalize(basis * dir);
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func p_shadow [ uv: vec2f, sun: vec3f, east: vec3f,
                    north: vec3f, up: vec3f ] -> GLSL f32 {
        float se = dot(sun, east);
        float sn = dot(sun, north);
        float su = dot(sun, up);
        float across = length(vec2(se, sn));
        if (across < 0.001 || su <= 0.0)
            return 1.0;
        vec2 direction = normalize(vec2(se, -sn));
        float base = textureLod(height, uv, 0.0).r * 3.2;
        float slope = su / across;
        float shade = 1.0;
        for (int i = 1; i <= 24; i++) {
            float km = float(i) * 0.65;
            vec2 at = uv + direction * km / vec2(175.0, 180.0);
            if (at.x < 0.0 || at.x > 1.0 ||
                at.y < 0.0 || at.y > 1.0)
                continue;
            float land = textureLod(height, at, 0.0).r * 3.2;
            float ray = base + km * slope;
            shade = min(shade,
                smoothstep(land - 0.08, land + 0.08, ray));
        }
        return mix(0.22, 1.0, shade);
    }

    func fragment [] -> GLSL none {
        vec3 alb = texture(albedo, v_uv).rgb;
        vec3 tn = texture(normal, v_uv).rgb * 2.0 - 1.0;
        vec3 n = normalize(v_east * tn.x + v_north * tn.y +
                           v_up * tn.z);
        vec3 sun = normalize(ubo.sun_dir.xyz);
        vec3 eye = normalize(ubo.cam_pos.xyz - v_world_pos);
        float nl = max(dot(n, sun), 0.0);
        float shadow = p_shadow(v_uv, sun, v_east,
                                v_north, v_up);
        float gloss = pow(max(dot(reflect(-sun, n), eye), 0.0),
                          48.0);
        float ice = smoothstep(0.25, 0.65,
            min(alb.r, min(alb.g, alb.b)));
        vec3 light = vec3(1.0, 0.94, 0.84) * nl * shadow * 1.10;
        vec3 ambient = mix(vec3(0.42, 0.43, 0.46),
                           vec3(0.55, 0.57, 0.61), ice);
        vec3 color = alb * (ambient + light);
        color += vec3(0.55, 0.72, 0.92) * gloss * ice * 0.08;
        fragColor = vec4(color, 1.0);
    }

func build_pluto_ground [] -> GltfModel
    steps : i32 [ 768 ]
    cols  : i32 [ steps + 1 ]
    verts : i32 [ cols * cols ]
    pos_count : i32 [ verts * 3 ]
    uv_count  : i32 [ verts * 2 ]
    inds  : i32 [ steps * steps * 6 ]
    pos_bytes : i32 [ pos_count * 4 ]
    uv_bytes  : i32 [ uv_count * 4 ]
    ind_bytes : i32 [ inds * 4 ]
    total : i32 [ pos_bytes * 2 + uv_bytes + ind_bytes ]
    data : new u8 [ total ]
    values : @f32 [ data ]
    ind_data : @data[ pos_bytes * 2 + uv_bytes ]
    indices : @u32 [ ind_data ]
    for [ row: i32 0, row <= steps, row += 1 ]
        v : f32 [ f32[ row ] / f32[ steps ] ]
        map_v : f32 [ 0.3195 + v * 0.0480 ]
        lat : f32 [ (0.5 - map_v) * 3.14159265 ]
        clat : f32 [ cos[ lat ] ]
        slat : f32 [ sin[ lat ] ]
        for [ col: i32 0, col <= steps, col += 1 ]
            u : f32 [ f32[ col ] / f32[ steps ] ]
            map_u : f32 [ 0.4265 + u * 0.0235 ]
            lon : f32 [ (map_u - 0.5) * 6.2831853 ]
            vertex : i32 [ row * cols + col ]
            pos_at : i32 [ vertex * 3 ]
            x : f32 [ clat * cos[ lon ] ]
            z : f32 [ clat * sin[ lon ] ]
            values[ pos_at ] = x
            values[ pos_at + 1 ] = slat
            values[ pos_at + 2 ] = z
            values[ pos_count + pos_at ] = x
            values[ pos_count + pos_at + 1 ] = slat
            values[ pos_count + pos_at + 2 ] = z
            uv_at : i32 [ pos_count * 2 + vertex * 2 ]
            values[ uv_at ] = u
            values[ uv_at + 1 ] = v
    at : i32 [ 0 ]
    for [ row: i32 0, row < steps, row += 1 ]
        for [ col: i32 0, col < steps, col += 1 ]
            corner : i32 [ row * cols + col ]
            indices[ at ] = u32[ corner ]
            indices[ at + 1 ] = u32[ corner + 1 ]
            indices[ at + 2 ] = u32[ corner + cols ]
            indices[ at + 3 ] = u32[ corner + 1 ]
            indices[ at + 4 ] = u32[ corner + cols + 1 ]
            indices[ at + 5 ] = u32[ corner + cols ]
            at += 6
    bufs : vec GltfBuffer []
    bufs += GltfBuffer [ byteLength: u64[ total ], data: data ]
    views : vec BufferView []
    views += BufferView [ buffer: 0, byteOffset: 0,
                          byteLength: pos_bytes ]
    views += BufferView [ buffer: 0, byteOffset: pos_bytes,
                          byteLength: pos_bytes ]
    views += BufferView [ buffer: 0,
                          byteOffset: pos_bytes * 2,
                          byteLength: uv_bytes ]
    views += BufferView [ buffer: 0,
                          byteOffset: pos_bytes * 2 + uv_bytes,
                          byteLength: ind_bytes ]
    accs : vec Accessor []
    accs += Accessor [ bufferView: 0,
                       componentType: ComponentType.FLOAT,
                       type: CompoundType.VEC3, count: verts ]
    accs += Accessor [ bufferView: 1,
                       componentType: ComponentType.FLOAT,
                       type: CompoundType.VEC3, count: verts ]
    accs += Accessor [ bufferView: 2,
                       componentType: ComponentType.FLOAT,
                       type: CompoundType.VEC2, count: verts ]
    accs += Accessor [ bufferView: 3,
                       componentType: ComponentType.UNSIGNED_INT,
                       type: CompoundType.SCALAR, count: inds ]
    attrs : map i64 [ string ] [ ]
    attrs[ 'POSITION' ] = i64[ 0 ]
    attrs[ 'NORMAL' ] = i64[ 1 ]
    attrs[ 'TEXCOORD_0' ] = i64[ 2 ]
    prims : vec Primitive []
    prims += Primitive [ name: 'pluto-ground', attributes: attrs,
                         indices: u64[ 3 ], material: 0,
                         mode: Mode.TRIANGLES ]
    meshes : vec Mesh []
    meshes += Mesh [ name: 'pluto-ground', primitives: prims ]
    nodes : vec Node []
    nodes += Node [ name: 'pluto-ground', mesh: 0 ]
    scene_nodes : vec i64 []
    scene_nodes += 0
    scene_list : vec Scene []
    scene_list += Scene [ name: 'scene', nodes: scene_nodes ]
    return GltfModel [ nodes: nodes, meshes: meshes,
        scenes: scene_list, scene: 0, buffers: bufs,
        bufferViews: views, accessors: accs ]

# THE SKY: black, the Sun and the edge-on haze.
# It renders behind the local terrain.
ModelViewProject PlutoSky
    mutable sun_dir  : vec4f
    mutable sun_see  : vec4f
    mutable cam_pos  : vec4f
    mutable haze_k   : f32
    mutable haze_h   : f32
    mutable haze_tall: f32
    mutable haze_fwd : f32
    mutable sun_px   : f32

    attrib a_pos        : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal     : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv         : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_world_pos  : VertexOutput  [ type:typeid[ vec4f ] ]

    attrib fragColor    : FragmentOutput[ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    func vertex [] -> GLSL none {
        // the globe mesh as a shell round the planet
        vec3  dir  = normalize(a_pos);
        vec4 wpos  = ubo.model * vec4(dir * 1.5, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func s_dens [ r: float ] -> GLSL float {
        float a = max(r - 1.0, 0.0);
        float low = exp(-a / ubo.haze_h);
        float high = exp(-a / (ubo.haze_h * 3.0));
        return low + ubo.haze_tall * high;
    }

    # march haze inside its eight-scale-height shell
    # scale heights, as the ground's is
    func s_haze_ray [ ro: vec3f, rd: vec3f, L: float,
                      sunw: vec3f ] -> GLSL vec3f {
        float ra = 1.0 + ubo.haze_h * 8.0;
        float b  = dot(ro, rd);
        float h1 = b * b - (dot(ro, ro) - ra * ra);
        if (h1 <= 0.0) return vec3(0.0);
        float sq = sqrt(h1);
        float s0 = max(-b - sq, 0.0);
        float s1 = min(-b + sq, L);
        if (s1 <= s0) return vec3(0.0);
        float fw = max(dot(rd, sunw), 0.0);
        // the lobes are round the sun's disk as the frame shows it
        float fd = max(dot(rd, normalize(ubo.sun_see.xyz)), 0.0);
        vec3  hc = vec3(0.12, 0.28, 0.55) * (1.0 + 4.0 * pow(fd, 8.0))
                 + vec3(0.9, 0.86, 0.8) * ubo.haze_fwd * pow(fd, 80.0);
        const int N = 16;
        float ds = (s1 - s0) / float(N);
        float od = 0.0;
        vec3  ins = vec3(0.0);
        for (int i = 0; i < N; i++) {{
            vec3  p  = ro + rd * (s0 + (float(i) + 0.5) * ds);
            float dn = s_dens(length(p)) * ubo.haze_k * ds;
            float lit = clamp(dot(normalize(p), sunw) * 6.0 + 0.5,
                              0.15, 1.0);
            ins += hc * dn * exp(-od) * lit;
            od  += dn;
        }}
        return ins;
    }

    func fragment [] -> GLSL none {
        vec3  ro = ubo.cam_pos.xyz;
        vec3  rd = normalize(v_world_pos.xyz - ro);
        vec3  sunw = normalize(ubo.sun_dir.xyz);
        // the ray runs to the ground, else on past the shell
        float b  = dot(ro, rd);
        float h0 = b * b - (dot(ro, ro) - 1.0);
        float L  = 4.0;
        if (h0 > 0.0 && (-b - sqrt(h0)) > 0.0) L = -b - sqrt(h0);
        vec3  ins = s_haze_ray(ro, rd, L, sunw);
        // the sun is a hot disk and a small glow
        float sa = acos(clamp(
            dot(rd, normalize(ubo.sun_see.xyz)), -1.0, 1.0));
        float r0  = ubo.sun_px;
        vec3 sun = vec3(1.0, 0.97, 0.92) *
            smoothstep(r0 * 1.3, r0 * 0.7, sa);
        sun += vec3(1.0, 0.85, 0.65) *
            exp(-sa / (r0 * 2.0)) * 0.12;
        fragColor = vec4(pow(ins + sun, vec3(1.0 / 2.2)), 1.0);
    }

Backdrop Pluto
    frost : true
    public func bg_color [ ] -> rgba
        return color
    frost_sharp : true
    intern pground   : PlutoGround
    intern psky      : PlutoSky
    intern models    : vec Model
    intern target    : Render
    intern g_gltf    : GltfModel
    intern g_ground  : GltfModel
    intern img_albedo : Image
    intern img_height : Image
    intern img_normal : Image
    intern built     : bool
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    public color  : rgba [ r:0.0, g:0.0, b:0.004, a:1.0 ]

    func build_models[]
        built = true
        g_gltf = build_globe[]
        g_gltf.hold[]
        g_gltf.compute_worlds[]
        g_ground = build_pluto_ground[]
        g_ground.hold[]
        g_ground.compute_worlds[]
        pground = PlutoGround [ vk: vk ]
        psky = PlutoSky [ vk: vk ]
        ap : path '../{share_name}/textures/pluto-local-albedo.png'
        hp : path '../{share_name}/textures/pluto-local-height.png'
        np : path '../{share_name}/textures/pluto-local-normal.png'
        img_albedo = Image [ uri: ap, surface: PlutoSurface.albedo,
                             linear: true ]
        img_height = Image [ uri: hp, surface: PlutoSurface.height,
                             linear: true ]
        img_normal = Image [ uri: np, surface: PlutoSurface.normal,
                             linear: true ]

    func create_target[]
        if [ target ] return
        smp : map Au[string] [
            'albedo': img_albedo,
            'height': img_height,
            'normal': img_normal ]
        s_model : Model [ vk: vk, w: ux, id: g_gltf, s: psky,
                          cull_none: true, depth_no_test: true ]
        g_model : Model [ vk: vk, w: ux, id: g_ground, s: pground,
                          samplers: smp, cull_none: true ]
        models = vec Model [] [ s_model, g_model ]
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      (ux.frost_eff[] == 2) ? 2.0 : 1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.owner  = a
        ux.element_targets[ id ] = target

    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    # map editor purple to cold nitrogen ice
    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#0e1420cc',
            '#140a2a80':  '#0e142080',
            '#14121c80':  '#0e142080',
            '#220022aa':  '#101a26aa',
            '#22002280':  '#101a2680',
            '#614':       '#2c3a4c',
            '#413':       '#22303e',
            '#826':       '#4a6280',
            '#625a':      '#2c3a4ca0',
            '#8af2':      '#9ac0ff22',
            '#425':       '#2e3e52',
            '#ede3':      '#bcd4ff33',
            '#44225588':  '#3a4c6433',
            '#ff3a6a22':  '#7ab0ff22',
            '#ff3a6a44':  '#7ab0ff44',
            '#3a1c8a40':  '#4b648a40',
            '#1d0f3f':    '#1e2739',
            '#ff5a8a80':  '#8ab8ff80',
            '#ff7aa480':  '#a8ccff80'
        ]

    func load_bg [ arg: object :: t: Pluto ]
        t.build_models[]
        t.ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w_ : vec Au []
            w_.push[ a ]
            load_task = async [ target: a, work_fn: lambda load_bg[ a ],
                                work: w_ ]
        if [ !ready ] return
        # the done job held this element: let it go
        if [ load_task ] load_task = null
        create_target[]
        orbit[]

    # Target: the craft is at the tholin's east edge.
    # Map point: x 1740, y 702; 27.1 W, 28.3 N.
    # The rolled limb crosses y 197 to y 373 of 941.
    # The sun disk is at x 1122, y 145.
    func orbit[]
        aspect : f32 [
            (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ]
            : 1.7778 ]
        fov : f32 [ 40.0 ]
        # altitude over the mean ground in radii: 11 km
        alt : f32 [ 0.0095 ]
        lon_d : f32 [ 0.0 - 27.07 ]
        lat_d : f32 [ 28.3 ]
        # heading turns the +x look about the eye vertical
        # vertical: -90 faces north, 180 east
        head_d : f32 [ 180.0 ]
        # hold the craft at the target still
        # the craft is on the planet frame's x axis once
        # the planet is turned under it: eye at +z
        cx : f32 [ 0.0 ]
        cy : f32 [ 0.0 ]
        cz : f32 [ 1.0 ]
        e_r : f32 [ 1.0 + alt ]
        _eye : vec3f [ 0.0, 0.0, e_r ]
        # ahead is +x; with the x mirror the right is +y
        gx : f32 [ 1.0 ]
        gy : f32 [ 0.0 ]
        gz : f32 [ 0.0 ]
        dip : f32 [ acos[ 1.0 / e_r ] ]
        # the limb 6.45 degrees above the frame's centre
        pit : f32 [ dip + radians[ 6.45 ] ]
        pc : f32 [ cos[ pit ] ]
        ps : f32 [ sin[ pit ] ]
        dx : f32 [ gx * pc - cx * ps ]
        dy : f32 [ gy * pc - cy * ps ]
        dz : f32 [ gz * pc - cz * ps ]
        _tgt : vec3f [ _eye.x + dx, _eye.y + dy, _eye.z + dz ]
        # rolled: the horizon falls to the right
        roll : f32 [ radians[ 0.0 - 6.1 ] ]
        _up : vec3f [ cx, cy + sin[ roll ], cz * cos[ roll ] ]
        _proj : mat4f.perspective[ radians[ fov ], aspect, 0.001, 24.0 ]
        _proj.m[5] = 0.0 - _proj.m[5]
        # mirror x so screen right faces east
        _proj.m[0] = 0.0 - _proj.m[0]
        _view : mat4f.look_at[ _eye, _tgt, _up ]

        q_spin : quatf [
            vec4f [ 0.0, 1.0, 0.0, radians[ lon_d - 90.0 ] ] ]
        q_lat : quatf [ vec4f [ 1.0, 0.0, 0.0, radians[ lat_d ] ] ]
        q_head : quatf [ vec4f [ 0.0, 0.0, 1.0, radians[ head_d ] ] ]
        mm : mat4f.identity[]
        mm = mm.rotate[ q_head ]
        mm = mm.rotate[ q_lat ]
        mm = mm.rotate[ q_spin ]

        haze_k : f32 [ 12.0 ]
        haze_h : f32 [ 0.0008 ]
        # the light is 12 degrees above the sun side
        # its disk sits lower, where the reference shows it
        sel : f32 [ radians[ 12.0 ] ]
        saz : f32 [ radians[ 12.5 ] ]
        sc : f32 [ cos[ sel ] ]
        ss : f32 [ sin[ sel ] ]
        psky.model    = mm
        psky.view     = _view
        psky.proj     = _proj
        pground.model = mm
        pground.view  = _view
        pground.proj  = _proj
        pground.hmax  = 3.2 / 1188.0
        pground.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        pground.sun_dir = vec4f [ sc * cos[ saz ], sc * sin[ saz ],
                                  ss, 0.0 ]
        psky.cam_pos  = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        psky.sun_dir  = vec4f [ sc * cos[ saz ], sc * sin[ saz ],
                                ss, 0.0 ]
        psky.haze_k   = haze_k
        psky.haze_h   = haze_h
        psky.haze_tall = 0.0
        psky.haze_fwd  = 1.0
        # place the disk 2.2 degrees over the
        # craft's horizontal, 10.1 to the right
        vel : f32 [ radians[ 1.0 ] ]
        vaz : f32 [ radians[ 10.5 ] ]
        psky.sun_see  = vec4f [ cos[ vel ] * cos[ vaz ],
                                cos[ vel ] * sin[ vaz ],
                                sin[ vel ], 0.0 ]
        psky.sun_px   = radians[ 0.25 ]

# the pictures for orbiter's scene picker
export func pluto_thumbs []
    names : vec string [] [ 'Pluto' ]
    dir   : path '../{share_name}/thumbs'
    scene_thumbs_for[ names, dir ]

# PLUTO_SHOTS writes the target frame at its target size
expect func t_pluto_frames [] -> bool
    dir : getenv[ 'PLUTO_SHOTS' ]
    if [ !dir ] return true
    vk : vk_context []
    vk.hold[]
    w : Window [ vk: vk, format: Pixel.rgba8,
                 backbuffer: true, width: 1672, height: 941 ]
    w.hold[]
    if [ !w.element_targets ]
        w.element_targets = map Render [string] []
    st : Au.find_type[ 'Pluto', null ]
    e : element [ Au.new_object[ st, null, null, true,
        __FILE__, __LINE__, __SEQUENCE__ ] ]
    e.hold[]
    e.id = 'Pluto'
    e.ux = w
    e.vk = w.vk
    r : Render [ null ]
    for [ i: i32 0, i < 6000, i += 1 ]
        e.draw*[ w ]
        if [ w.element_targets.contains[ 'Pluto' ] ]
            r = w.element_targets[ 'Pluto' ]
            if [ r && r.models && r.models.count > 0 ] break
            r = null
        usleep[ 10000 ]
    if [ !r ] return false
    for [ f: i32 0, f < 4, f += 1 ]
        e.draw*[ w ]
        r.draw[]
        r.sync_fence[]
    im : Image [ r.color ]
    im.png[ path '{string[ dir ]}/pluto.png' ]
    e.drop[]
    return true
