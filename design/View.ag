# the view: a design's objects as one gltf model, drawn lit
extend design

# a Principled surface, as blend.py writes it
class Principled
    public base_color        : vec f32
    public metallic          : f32
    public roughness         : f32 [ 0.5 ]
    public alpha             : f32 [ 1.0 ]
    public emission_color    : vec f32
    public emission_strength : f32

# a material file: its surface and how it blends
class Finish
    public surface : Principled
    public blend   : string

# materials/<name>.agi, as read
func read_finish [ dir: path, name: string ] -> Finish
    p : path '{dir}/materials/{name}.agi'
    if [ !p.exists[] ]
        log 'aeon: no material at {p}'
        return null
    from : shadowed[ p ]
    txt : string [ from.load[ typeid[ string ], null ] ]
    f : Finish [ surface: Principled [] ]
    Au.parse_agi[ null, txt.chars, f ]
    return f

# a finish as gltf's material
func finish_material [ f: Finish, name: string ] -> Material
    pbr : pbr_defaults[]
    if [ f && f.surface ]
        s : f.surface
        if [ s.base_color && s.base_color.count >= 3 ]
            pbr.baseColorFactor = vec4f [ s.base_color[ 0 ],
                s.base_color[ 1 ], s.base_color[ 2 ], s.alpha ]
        pbr.metallicFactor  = s.metallic
        pbr.roughnessFactor = s.roughness
        if [ s.emission_color && s.emission_color.count >= 3 ]
            pbr.emissiveFactor = vec3f [ s.emission_color[ 0 ],
                s.emission_color[ 1 ], s.emission_color[ 2 ] ]
            pbr.emissiveStrength = s.emission_strength
    return Material [ name: name, pbrMetallicRoughness: pbr ]

# the parts of a model being filled: values and index runs
class Filling
    public pos     : vec f32
    public normal  : vec f32
    public uv      : vec f32
    public color   : vec f32
    public index   : vec u32
    public firsts  : vec i32
    public counts  : vec i32
    public ifirsts : vec i32
    public icounts : vec i32
    public mats    : vec i32
    public meshes  : vec i32
    # the mesh point each written vertex came from
    public verts   : vec i32

# every point's normal: the faces around it, by their size
func point_normals [ m: Poly ] -> vec f32
    nv : i32 [ m.verts[] ]
    n : vec f32 [ nv * 3 ]
    p : m.pos
    for [ f: i32 0, f < m.faces[], f += 1 ]
        st : i32 [ m.fstart[ f ] ]
        k : i32 [ m.fsize[ f ] ]
        # newell's sum: the face's normal, as long as its area
        sx : f32 [ 0.0 ]
        sy : f32 [ 0.0 ]
        sz : f32 [ 0.0 ]
        for [ j: i32 0, j < k, j += 1 ]
            u : i32 [ m.corner[ st + j ] * 3 ]
            w : i32 [ m.corner[ st + (j + 1) % k ] * 3 ]
            sx += (p[ u + 1 ] - p[ w + 1 ]) * (p[ u + 2 ] + p[ w + 2 ])
            sy += (p[ u + 2 ] - p[ w + 2 ]) * (p[ u ] + p[ w ])
            sz += (p[ u ] - p[ w ]) * (p[ u + 1 ] + p[ w + 1 ])
        for [ j: i32 0, j < k, j += 1 ]
            u : i32 [ m.corner[ st + j ] * 3 ]
            n[ u ] = n[ u ] + sx
            n[ u + 1 ] = n[ u + 1 ] + sy
            n[ u + 2 ] = n[ u + 2 ] + sz
    for [ v: i32 0, v < nv, v += 1 ]
        x : f32 [ n[ v * 3 ] ]
        y : f32 [ n[ v * 3 + 1 ] ]
        z : f32 [ n[ v * 3 + 2 ] ]
        l : f32 [ sqrt[ x * x + y * y + z * z ] ]
        if [ l > 0.0 ]
            n[ v * 3 ] = x / l
            n[ v * 3 + 1 ] = y / l
            n[ v * 3 + 2 ] = z / l
    return n

# one object's faces of material slot, into the filling
func fill_part [ fl: Filling, m: Poly, normals: vec f32,
                 place: vec f32, slot: i32, y_up: bool ]
    mat : m.attr[ 'material_index' ]
    uvs : m.attr[ 'UVMap' ]
    col : m.attr[ 'Color' ]
    # else the first colour of four, per point or per corner
    if [ !col ]
        for [ at: Attr ] in m.attrs
            if [ !col && at.width == 4
                 && (at.domain == 0 || at.domain == 3) ]
                col = at
    first : i32 [ fl.pos.count / 3 ]
    ifirst : i32 [ fl.index.count ]
    for [ f: i32 0, f < m.faces[], f += 1 ]
        own : i32 [ (mat) ? i32[ mat.data[ f ] ] : 0 ]
        if [ own != slot ] continue
        st : i32 [ m.fstart[ f ] ]
        k : i32 [ m.fsize[ f ] ]
        base : u32 [ fl.pos.count / 3 - first ]
        for [ j: i32 0, j < k, j += 1 ]
            c : i32 [ st + j ]
            v : i32 [ m.corner[ c ] ]
            x : f32 [ m.pos[ v * 3 ] ]
            y : f32 [ m.pos[ v * 3 + 1 ] ]
            z : f32 [ m.pos[ v * 3 + 2 ] ]
            nx : f32 [ normals[ v * 3 ] ]
            ny : f32 [ normals[ v * 3 + 1 ] ]
            nz : f32 [ normals[ v * 3 + 2 ] ]
            px : f32 [ place[ 0 ] * x + place[ 1 ] * y + place[ 2 ] * z
                       + place[ 3 ] ]
            py : f32 [ place[ 4 ] * x + place[ 5 ] * y + place[ 6 ] * z
                       + place[ 7 ] ]
            pz : f32 [ place[ 8 ] * x + place[ 9 ] * y
                       + place[ 10 ] * z + place[ 11 ] ]
            qx : f32 [ place[ 0 ] * nx + place[ 1 ] * ny
                       + place[ 2 ] * nz ]
            qy : f32 [ place[ 4 ] * nx + place[ 5 ] * ny
                       + place[ 6 ] * nz ]
            qz : f32 [ place[ 8 ] * nx + place[ 9 ] * ny
                       + place[ 10 ] * nz ]
            # glTF's axes: x, z, -y
            if [ y_up ]
                up : f32 [ pz ]
                pz = 0.0 - py
                py = up
                nup : f32 [ qz ]
                qz = 0.0 - qy
                qy = nup
            fl.pos.push[ px ]
            fl.pos.push[ py ]
            fl.pos.push[ pz ]
            fl.normal.push[ qx ]
            fl.normal.push[ qy ]
            fl.normal.push[ qz ]
            fl.verts.push[ v ]
            ux : f32 [ (uvs) ? uvs.data[ c * 2 ] : 0.0 ]
            uy : f32 [ (uvs) ? uvs.data[ c * 2 + 1 ] : 0.0 ]
            fl.uv.push[ ux ]
            fl.uv.push[ uy ]
            ci : i32 [ (col && col.domain == 3) ? c : v ]
            for [ r: i32 0, r < 4, r += 1 ]
                cv : f32 [ (col) ? col.data[ ci * 4 + r ] : 1.0 ]
                fl.color.push[ cv ]
        # a fan over the face's corners
        for [ j: i32 1, j < k - 1, j += 1 ]
            left : u32 [ base + u32[ j ] ]
            right : u32 [ base + u32[ j + 1 ] ]
            fl.index.push[ base ]
            fl.index.push[ left ]
            fl.index.push[ right ]
    many : i32 [ fl.pos.count / 3 - first ]
    if [ many == 0 ] return
    fl.firsts.push[ first ]
    fl.counts.push[ many ]
    fl.ifirsts.push[ ifirst ]
    icount : i32 [ fl.index.count - ifirst ]
    fl.icounts.push[ icount ]
    fl.mats.push[ slot ]

# which objects a model holds, in order, and their part counts
class ModelParts
    public names  : vec string
    public counts : vec i32
    # each part's first vertex and its count, and every vertex's
    # mesh point: an edit writes from these alone
    public firsts : vec i32
    public sizes  : vec i32
    public verts  : vec i32
    # glTF's axes: x, z, -y of the design's
    public y_up   : bool

# one object evaluated and filled once: its own buffer
# (positions, normals, uvs, colours, indices) and its parts
class Made
    public buffer  : GltfBuffer
    public points  : i32
    public faces   : i32
    public firsts  : vec i32
    public counts  : vec i32
    public ifirsts : vec i32
    public icounts : vec i32
    public mats    : vec i32
    public verts   : vec i32

# an object's nodes run and its parts filled, kept on the design
# until it changes; every draw and stage shares the bytes
func made_of [ d: Design, o: Object, y_up: bool ] -> Made
    key : '{o.name}|{y_up}'
    if [ !d.made ] d.made = map Made [ string ] []
    have : d.made[ key ]
    if [ have ] return have
    m : o.evaluate[ d.base[] ]
    if [ !m ] return null
    fl : Filling [ pos: vec f32 [], normal: vec f32 [],
                   uv: vec f32 [], color: vec f32 [],
                   index: vec u32 [], firsts: vec i32 [],
                   counts: vec i32 [], ifirsts: vec i32 [],
                   icounts: vec i32 [], mats: vec i32 [],
                   meshes: vec i32 [], verts: vec i32 [] ]
    normals : point_normals[ m ]
    where : Placement [ at: o.at, turn: o.turn, size: o.size ]
    place : where.matrix[]
    names : o.materials
    nslot : i32 [ (names && names.count > 0) ? names.count : 1 ]
    for [ s: i32 0, s < nslot, s += 1 ]
        fill_part[ fl, m, normals, place, s, y_up ]
    nv : i32 [ fl.pos.count / 3 ]
    pb : i64 [ i64[ nv ] * 12 ]
    ub : i64 [ i64[ nv ] * 8 ]
    cb : i64 [ i64[ nv ] * 16 ]
    ib : i64 [ i64[ fl.index.count ] * 4 ]
    total : i64 [ pb * 2 + ub + cb + ib ]
    data : new u8 [ total ]
    if [ nv > 0 ]
        memcpy[ @data[ 0 ], @fl.pos[ 0 ], pb ]
        memcpy[ @data[ pb ], @fl.normal[ 0 ], pb ]
        memcpy[ @data[ pb * 2 ], @fl.uv[ 0 ], ub ]
        memcpy[ @data[ pb * 2 + ub ], @fl.color[ 0 ], cb ]
        memcpy[ @data[ pb * 2 + ub + cb ], @fl.index[ 0 ], ib ]
    made : Made [ buffer: GltfBuffer [ byteLength: u64[ total ],
                                       data: data ],
        points: m.verts[], faces: m.faces[],
        firsts: fl.firsts, counts: fl.counts, ifirsts: fl.ifirsts,
        icounts: fl.icounts, mats: fl.mats, verts: fl.verts ]
    d.made[ key ] = made
    log 'aeon: {o.name}: {m.verts[]} points, {m.faces[]} faces, {fl.firsts.count} parts'
    return made

# the design as one gltf model: a mesh an object, a part a
# material it uses; only the objects named, when names are given
func design_model [ d: Design, only: vec string,
                    record: ModelParts ] -> GltfModel
    mats : vec Material []
    matnames : vec string []
    # an svg panel's picture: a texture named by the svg's path
    texs : vec GltfTexture []
    imgs : vec GltfImage []
    y_up : bool [ record && record.y_up ]
    bufs : vec GltfBuffer []
    views : vec BufferView []
    accs : vec Accessor []
    meshes : vec Mesh []
    nodes : vec Node []
    roots : vec i64 []
    if [ record ]
        record.firsts = vec i32 []
        record.sizes  = vec i32 []
        record.verts  = vec i32 []
    for [ o: Object ] in d.objects
        if [ !o.shown ] continue
        if [ only && only.count > 0 ]
            named : bool [ false ]
            for [ word: string ] in only
                if [ word.compare[ o.name ] == 0 ] named = true
            if [ !named ] continue
        mk : made_of[ d, o, y_up ]
        if [ !mk ] continue
        bi : i64 [ bufs.count ]
        bufs += mk.buffer
        nv : i64 [ mk.verts.count ]
        pb : i64 [ nv * 12 ]
        ub : i64 [ nv * 8 ]
        cb : i64 [ nv * 16 ]
        names : o.materials
        vbase : i32 [ (record) ? record.verts.count : 0 ]
        parts : vec Primitive []
        for [ i: i32 0, i < mk.firsts.count, i += 1 ]
            n : i64 [ mk.counts[ i ] ]
            at : i64 [ mk.firsts[ i ] ]
            ifirst : i64 [ mk.ifirsts[ i ] ]
            icount : i64 [ mk.icounts[ i ] ]
            views += BufferView [ buffer: bi, byteOffset: at * 12,
                                  byteLength: n * 12 ]
            views += BufferView [ buffer: bi, byteOffset: pb + at * 12,
                                  byteLength: n * 12 ]
            views += BufferView [ buffer: bi,
                                  byteOffset: pb * 2 + at * 8,
                                  byteLength: n * 8 ]
            views += BufferView [ buffer: bi,
                                  byteOffset: pb * 2 + ub + at * 16,
                                  byteLength: n * 16 ]
            views += BufferView [ buffer: bi,
                byteOffset: pb * 2 + ub + cb + ifirst * 4,
                byteLength: icount * 4 ]
            va : i64 [ accs.count ]
            accs += Accessor [ bufferView: views.count - 5,
                componentType: ComponentType.FLOAT,
                type: CompoundType.VEC3, count: n ]
            accs += Accessor [ bufferView: views.count - 4,
                componentType: ComponentType.FLOAT,
                type: CompoundType.VEC3, count: n ]
            accs += Accessor [ bufferView: views.count - 3,
                componentType: ComponentType.FLOAT,
                type: CompoundType.VEC2, count: n ]
            accs += Accessor [ bufferView: views.count - 2,
                componentType: ComponentType.FLOAT,
                type: CompoundType.VEC4, count: n ]
            accs += Accessor [ bufferView: views.count - 1,
                componentType: ComponentType.UNSIGNED_INT,
                type: CompoundType.SCALAR, count: icount ]
            # each part's material, one gltf material a name
            nm : string (names && names.count > 0)
                ? names[ mk.mats[ i ] ] : 'none'
            panel : o.panel[]
            if [ panel ] nm = '{d.base[]}/{panel.file}'
            found : i32 [ -1 ]
            for [ g: i32 0, g < matnames.count, g += 1 ]
                if [ matnames[ g ].compare[ nm ] == 0 ] found = g
            if [ found < 0 ]
                found = matnames.count
                matnames.push[ nm ]
                # a panel's colour is its picture: no finish file
                fin : Finish [ null ]
                if [ !panel ] fin = d.finish_of[ nm ]
                mat : finish_material[ fin, nm ]
                if [ panel ]
                    imgs += GltfImage [ name: panel.file,
                                        uri: path [ nm ] ]
                    texs += GltfTexture [ name: panel.file, sampler: -1,
                                          source: imgs.count - 1 ]
                    ti : TextureInfo [ index: texs.count - 1 ]
                    mat.pbrMetallicRoughness.baseColorTexture = ti
                mats.push[ mat ]
            am : map i64 [ string ] [ ]
            am[ 'POSITION' ]   = va
            am[ 'NORMAL' ]     = va + 1
            am[ 'TEXCOORD_0' ] = va + 2
            am[ 'COLOR_0' ]    = va + 3
            parts += Primitive [ name: 'part', attributes: am,
                                 indices: u64[ va + 4 ],
                                 material: found,
                                 mode: Mode.TRIANGLES ]
            if [ record ]
                start : i32 [ vbase + mk.firsts[ i ] ]
                size : i32 [ mk.counts[ i ] ]
                record.firsts.push[ start ]
                record.sizes.push[ size ]
        if [ record ]
            record.names.push[ o.name ]
            record.counts.push[ mk.firsts.count ]
            for [ v: i32 0, v < mk.verts.count, v += 1 ]
                at : i32 [ mk.verts[ v ] ]
                record.verts.push[ at ]
        # named by the object: a shader's groups pick by name
        roots += i64[ nodes.count ]
        meshes += Mesh [ name: o.name, primitives: parts ]
        nodes += Node [ name: o.name, mesh: meshes.count - 1 ]
    scenes : vec Scene []
    scenes += Scene [ name: 'design', nodes: roots ]
    return GltfModel [ nodes: nodes, meshes: meshes, scenes: scenes,
        scene: 0, buffers: bufs, bufferViews: views, accessors: accs,
        materials: mats, textures: texs, images: imgs ]

# metal and roughness under two lights and a plain sky
ModelViewProject AeonLit
    mutable eye : vec4f

    attrib color    : LayoutBinding [ type:typeid[ Surface ],
                                      id:Surface.color, count:1,
                                      format: typeid[ rgba8 ] ]
    attrib emission : LayoutBinding [ type:typeid[ Surface ],
                                      id:Surface.emission, count:1,
                                      format: typeid[ rgbaf ] ]
    attrib rough    : LayoutBinding [ type:typeid[ Surface ],
                                      id:Surface.rough, count:1,
                                      format: typeid[ u8 ] ]
    attrib metal    : LayoutBinding [ type:typeid[ Surface ],
                                      id:Surface.metal, count:1,
                                      format: typeid[ u8 ] ]

    attrib a_pos     : VertexInput    [ type:typeid[ vec3f ] ]
    attrib a_normal  : VertexInput    [ type:typeid[ vec3f ] ]
    attrib a_uv      : VertexInput    [ type:typeid[ vec2f ] ]
    attrib a_color_0 : VertexInput    [ type:typeid[ vec4f ] ]

    attrib v_normal  : VertexOutput   [ type:typeid[ vec3f ] ]
    attrib v_world   : VertexOutput   [ type:typeid[ vec3f ] ]
    attrib v_uv      : VertexOutput   [ type:typeid[ vec2f ] ]
    attrib fragColor : FragmentOutput [ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    func vertex [] -> GLSL none {
        vec4 w      = ubo.model * vec4(a_pos, 1.0);
        v_world     = w.xyz;
        v_uv        = a_uv;
        v_normal    = mat3(ubo.model) * a_normal;
        gl_Position = ubo.proj * ubo.view * w;
    }

    # the sky a direction sees: z is up, as in blender
    func sky [ d: vec3f ] -> GLSL vec3f {
        float up = clamp(d.z, -1.0, 1.0);
        vec3 top = vec3(0.55, 0.62, 0.75);
        vec3 mid = vec3(0.85, 0.80, 0.72);
        vec3 low = vec3(0.10, 0.10, 0.12);
        return (up > 0.0) ? mix(mid, top, pow(up, 0.6))
                          : mix(mid, low, pow(-up, 0.4));
    }

    # a light's share: ggx specular and lambert diffuse
    func shine [ n: vec3f, v: vec3f, l: vec3f, base: vec3f,
                 f0: vec3f, r: float, m: float ] -> GLSL vec3f {
        vec3  h   = normalize(v + l);
        float nl  = max(dot(n, l), 0.0);
        float nv  = max(dot(n, v), 1e-4);
        float nh  = max(dot(n, h), 0.0);
        float a   = max(r * r, 0.002);
        float a2  = a * a;
        float dd  = nh * nh * (a2 - 1.0) + 1.0;
        float ggx = a2 / (3.14159265 * dd * dd);
        float k   = (r + 1.0) * (r + 1.0) / 8.0;
        float g   = nl / (nl * (1.0 - k) + k)
                  * nv / (nv * (1.0 - k) + k);
        float hv  = max(dot(h, v), 0.0);
        vec3  f   = f0 + (1.0 - f0) * pow(1.0 - hv, 5.0);
        vec3  spec = ggx * g * f / max(4.0 * nl * nv, 1e-4);
        vec3  diff = (1.0 - f) * (1.0 - m) * base / 3.14159265;
        return (diff + spec) * nl;
    }

    func fragment [] -> GLSL none {
        // a material's colour (1x1), or a picture by the uv
        vec4  bc    = texture(color, v_uv);
        // a picture's clear parts are no surface
        if (bc.a < 0.02) discard;
        vec3  base  = bc.rgb;
        float r     = clamp(texture(rough, vec2(0.5)).r, 0.04, 1.0);
        float m     = texture(metal, vec2(0.5)).r;
        vec4  e     = texture(emission, vec2(0.5));
        vec3  n     = normalize(v_normal);
        vec3  v     = normalize(ubo.eye.xyz - v_world);
        if (dot(n, v) < 0.0) n = -n;
        vec3  f0    = mix(vec3(0.04), base, m);
        vec3  c     = shine(n, v, normalize(vec3(0.5, -0.6, 0.8)),
                            base, f0, r, m) * 3.2;
        c += shine(n, v, normalize(vec3(-0.7, 0.4, 0.3)),
                   base, f0, r, m) * 1.1;
        // the sky: reflected, blurred toward its mean by roughness
        vec3  rd    = reflect(-v, n);
        vec3  env   = mix(sky(rd), vec3(0.6, 0.6, 0.62), r * r);
        float nv    = max(dot(n, v), 0.0);
        vec3  edge  = max(vec3(1.0 - r), f0) - f0;
        vec3  fr    = f0 + edge * pow(1.0 - nv, 5.0);
        c += env * fr;
        c += sky(n) * base * (1.0 - m) * 0.35;
        c += e.rgb * e.a;
        c  = c / (1.0 + c);
        fragColor = vec4(pow(c, vec3(1.0 / 2.2)), 1.0);
    }

# an object's new shape into its parts' vertex buffers, parts
# first .. first + parts of the model; same topology, so each
# vertex takes its recorded mesh point
func refill [ m: Model, first: i32, parts: i32, rec: ModelParts,
              o: Object, dir: path ] -> bool
    p : o.evaluate_shape[ dir ]
    if [ !p ] return false
    normals : point_normals[ p ]
    where : Placement [ at: o.at, turn: o.turn, size: o.size ]
    place : where.matrix[]
    for [ k: i32 first, k < first + parts, k += 1 ]
        if [ k >= m.pipelines.count ] return false
        gp : m.pipelines[ k ].vbo
        n : i32 [ rec.sizes[ k ] ]
        # aeonlit's vertex: position, normal, uv, colour (48 bytes)
        if [ !gp || gp.vertex_size != 48
             || gp.vertex_data.count != n * 48 ]
            return false
        out : @f32 [ @gp.vertex_data[ 0 ] ]
        at : i32 [ rec.firsts[ k ] ]
        for [ v: i32 0, v < n, v += 1 ]
            pv : i32 [ rec.verts[ at + v ] * 3 ]
            x : f32 [ p.pos[ pv ] ]
            y : f32 [ p.pos[ pv + 1 ] ]
            z : f32 [ p.pos[ pv + 2 ] ]
            nx : f32 [ normals[ pv ] ]
            ny : f32 [ normals[ pv + 1 ] ]
            nz : f32 [ normals[ pv + 2 ] ]
            slot : i32 [ v * 12 ]
            # y up: y to the third place, negated; z to the second
            ty : i32 [ (rec.y_up) ? 2 : 1 ]
            tz : i32 [ (rec.y_up) ? 1 : 2 ]
            flip : f32 [ (rec.y_up) ? -1.0 : 1.0 ]
            for [ r: i32 0, r < 3, r += 1 ]
                wp : f32 [ place[ r * 4 ] * x + place[ r * 4 + 1 ] * y
                           + place[ r * 4 + 2 ] * z
                           + place[ r * 4 + 3 ] ]
                wn : f32 [ place[ r * 4 ] * nx + place[ r * 4 + 1 ] * ny
                           + place[ r * 4 + 2 ] * nz ]
                to : i32 [ (r == 0) ? 0 : (r == 1) ? ty : tz ]
                sign : f32 [ (r == 1) ? flip : 1.0 ]
                out[ slot + to ] = wp * sign
                out[ slot + 3 + to ] = wn * sign
        gp.upload_verts[]
    return true

# one image over another, both premultiplied: a layer of a pass
# (the names are Surface's: color under, emission over)
ModelViewProject AeonOver
    attrib color     : LayoutBinding [ type:typeid[ Surface ],
                                       id:Surface.color, count:1,
                                       format: typeid[ rgba8 ] ]
    attrib emission  : LayoutBinding [ type:typeid[ Surface ],
                                       id:Surface.emission, count:1,
                                       format: typeid[ rgba8 ] ]

    attrib pos       : VertexInput    [ type:typeid[ vec3f ] ]
    attrib uv        : VertexInput    [ type:typeid[ vec2f ] ]
    attrib v_uv      : VertexOutput   [ type:typeid[ vec2f ] ]
    attrib fragColor : FragmentOutput [ type:typeid[ vec4f ] ]

    func init []
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    func vertex [] -> GLSL none {
        v_uv        = uv;
        gl_Position = vec4(pos.x, pos.y, 0.0, 1.0);
    }

    func fragment [] -> GLSL none {
        vec4 under = texture(color, v_uv);
        vec4 over  = texture(emission, v_uv);
        fragColor  = over + under * (1.0 - over.a);
    }
