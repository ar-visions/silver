# the stage: a design's render graph, its own passes and
# targets; the host draws what it hands back, where it likes
extend design

import <dlfcn.h>

# one draw in a pass: a shader over objects, or over a quad
class Draw
    public name     : string
    # the design's objects it draws; none named: all of them
    public objects  : vec string
    # a quad over the pass in place of objects (a screen pass)
    public quad     : bool
    # back faces drawn too (else culled)
    public both_sides : bool
    # the shader's class, found in any loaded module
    public shader   : string
    # the shader's own members, by name (a project file: its path)
    public settings : map Au [ string ]
    # a sampler, by name: 'pass.color' (.depth, .reduction),
    # 'image:<file>', 'env:<file>' or 'color:r g b a'
    public inputs   : map Au [ string ]

# one render pass: its size and its draws, in order
class Pass
    public name    : string
    # of the host's size; most caps the larger side (0: none)
    public scale   : f32 [ 1.0 ]
    public most    : i32
    public depth   : bool
    public reduce  : bool
    public clear   : vec f32
    # glTF's axes (y up) for shaders written that way
    public y_up    : bool
    public draws   : vec Draw
    # one draw, written on the pass itself
    public objects : vec string
    public quad    : bool
    public both_sides : bool
    public shader  : string
    public inputs  : map Au [ string ]

# the design's render: block: the modules its shaders come
# from, the passes in order, then what is shown
class StageGraph
    public modules : vec string
    public passes  : vec Pass
    public out     : vec string

# a draw as it runs: its shader, model and what the model holds
class DrawRun
    public draw  : Draw
    public shade : shader
    public model : Model
    public parts : ModelParts
    # the pipelines a filter keeps: (index, first, count) a run
    public keep  : vec i32
    # depth only: the others, drawn first so they hide what is
    # behind them (an occluding stage)
    public ghost : bool
    # its inputs, kept for a model made again
    public smp   : map Au [ string ]

# a pass as it runs: its draws and its target
class Running
    public pass   : Pass
    public draws  : vec DrawRun
    public target : Render

# the graph without a file: one lit pass of every object
func default_graph [] -> StageGraph
    lit : Pass [ name: 'lit', scale: 2.0, depth: true,
                 shader: 'AeonLit', both_sides: true,
                 clear: vec f32 [] [ 0.08, 0.08, 0.1, 1.0 ] ]
    return StageGraph [ passes: vec Pass [] [ lit ],
                        out: vec string [] [ 'lit' ] ]

# a draw's shader (by its class) samples the objects' materials:
# a colour binding none of the draw's inputs fills
func draw_reads_materials [ d: Draw ] -> bool
    if [ !d || d.quad || !d.shader ] return false
    ty : Au.find_type[ d.shader.chars, null ]
    while [ ty && ty != typeid[ shader ] ]
        for [ i: i32 0, i < ty.members.count, i += 1 ]
            mem : Au_t [ ty.members.origin[ i ] ]
            if [ mem.src != typeid[ LayoutBinding ] ] continue
            if [ strcmp[ mem.ident, "color" ] != 0 ] continue
            fed : bool [ d.inputs && d.inputs.contains[ 'color' ] ]
            return !fed
        ty = ty.context
    return false

class Stage
    public design : Design
    public graph  : StageGraph
    # the camera in the design's axes (z up)
    public eye    : vec3f
    public middle : vec3f
    public proj   : mat4f
    # clears to nothing: drawn over another stage's picture
    public transparent : bool
    # a host's own shaders, by draw name: it drives them
    public given  : map shader [ string ]
    # the model's turn (glTF axes for y up passes), each frame
    public model  : mat4f
    # the camera's up in the design's axes; none: the default
    public up     : vec3f
    # the host's projection flips y (a picture not mirrored): the
    # faces toward the eye wind the other way, so culled draws
    # cull the other side
    public flip_y : bool
    # the host gives the shaders' clock (else seconds since built)
    public host_time : bool
    public time   : f32
    # hovered, pressed, focused: the targets' state
    public state_mask : i32
    # objects alone: a screen draw that reads no pass's picture
    # (light of its own, as the halo) is off
    public objects_only : bool
    # the shown objects hide what they stand in front of: each
    # draw has a depth-only copy for the objects not shown
    public occlude : bool
    # objects the user hid: no copy of them hides anything
    public unseen  : vec string
    intern runs   : vec Running
    intern born   : i64
    # what build was given: an object's models are made again
    intern made_vk : vk_context
    intern made_w  : Window
    # each object's GPU passes, made the first time it moves
    intern gpus    : map ObjectGpu [ string ]

    # an object's GPU passes: its steps from the cage, its normals,
    # and a scatter into every draw holding it; null when a draw's
    # vertices are not the 12-float kind the scatter writes
    func gpu_of [ o: Object ] -> ObjectGpu
        if [ !gpus ] gpus = map ObjectGpu [ string ] []
        if [ gpus.contains[ o.name ] ] return gpus[ o.name ]
        c : o.cage[]
        m : o.evaluate[ design.base[] ]
        if [ !c || !c.poly || !m || !made_vk ] return null
        # every draw's vertices the kind the scatter writes, first
        for [ r: Running ] in runs
            for [ d: DrawRun ] in r.draws
                if [ !d.parts || d.parts.names.index_of[ o.name ] < 0 ]
                    continue
                for [ p: Pipeline ] in d.model.pipelines
                    if [ p.vbo && p.vbo.vertex_size != 48 ] return null
        tables : o.stencils[ design.base[] ]
        g : ObjectGpu [ vk: made_vk, w: made_w, tables: tables,
                        shape: m, n_cage: c.poly.verts[] ]
        for [ r: Running ] in runs
            for [ d: DrawRun ] in r.draws
                if [ !d.parts ] continue
                first : i32 [ 0 ]
                for [ i: i32 0, i < d.parts.names.count, i += 1 ]
                    if [ d.parts.names[ i ].compare[ o.name ] == 0 ]
                        for [ k: i32 first, k < first + d.parts.counts[ i ],
                              k += 1 ]
                            gp : d.model.pipelines[ k ].vbo
                            if [ !gp ] continue
                            g.add_target[ gp, d.parts.verts,
                                d.parts.firsts[ k ], d.parts.sizes[ k ],
                                d.parts.y_up ]
                        break
                    first += d.parts.counts[ i ]
        gpus[ o.name ] = g
        return g
    # the host size it was built for: wired inputs hold its textures
    public built_w : i32
    public built_h : i32

    # the graph from the design's render: block, else the default
    func init []
        runs = vec Running []
        model = mat4f.identity[]
        if [ !graph && design ] graph = design.render
        if [ !graph ] graph = default_graph[]
        if [ !graph.modules ] graph.modules = vec string []
        if [ !graph.passes ] graph.passes = vec Pass []
        if [ !graph.out ] graph.out = vec string []

    # a graph read again: the same passes, draws, shaders and
    # wiring take the new settings in place; else false
    func retune [ fresh: StageGraph ] -> bool
        if [ !fresh || !fresh.passes ] return false
        if [ fresh.passes.count != runs.count ] return false
        for [ i: i32 0, i < runs.count, i += 1 ]
            r : runs[ i ]
            np : fresh.passes[ i ]
            if [ np.name.compare[ r.pass.name ] != 0 ] return false
            # only the draws written out take settings
            if [ !np.draws || np.draws.count != r.draws.count ]
                return np.draws == null && r.draws.count == 1
                    && same_wiring[ np, r.pass ]
            for [ k: i32 0, k < r.draws.count, k += 1 ]
                d : np.draws[ k ]
                old : r.draws[ k ].draw
                if [ d.shader.compare[ old.shader ] != 0 ] return false
        # the structure holds: settings onto the running shaders
        for [ i: i32 0, i < runs.count, i += 1 ]
            r : runs[ i ]
            np : fresh.passes[ i ]
            if [ !np.draws ] continue
            for [ k: i32 0, k < r.draws.count, k += 1 ]
                apply[ r.draws[ k ].shade, np.draws[ k ] ]
                r.draws[ k ].draw.settings = np.draws[ k ].settings
        graph = fresh
        return true

    # a one-draw pass whose shader and objects are unchanged
    func same_wiring [ np: Pass, op: Pass ] -> bool
        if [ !np.shader || !op.shader ] return false
        return np.shader.compare[ op.shader ] == 0

    func running [ name: string ] -> Running
        for [ r: Running ] in runs
            if [ r.pass.name.compare[ name ] == 0 ] return r
        return null

    # 'pass.color' (or .depth, .reduction) of a built pass
    func output [ wire: string ] -> Texture
        dot : i32 [ wire.index_of[ '.' ] ]
        nm : string (dot > 0) ? wire.mid[ 0, dot ] : wire
        part : string (dot > 0)
            ? wire.mid[ dot + 1, wire.count - dot - 1 ] : 'color'
        r : running[ nm ]
        if [ !r || !r.target ] return null
        if [ part.compare[ 'depth' ] == 0 ] return r.target.depth
        if [ part.compare[ 'reduction' ] == 0 ]
            return r.target.reduction
        return r.target.color

    # a project file's full path, or null when there is none
    func project_file [ name: string ] -> path
        p : path '{design.dir}/{name}'
        if [ p.exists[] ] return p
        return null

    # one sampler's source, as its input names it
    func source [ vk: vk_context, w: Window, wire: string ] -> Au
        if [ wire.starts_with[ 'image:' ] ]
            f : project_file[ wire.mid[ 6, wire.count - 6 ] ]
            if [ !f ] return null
            return Texture [ w: w, vk: vk, sampler: Image [ uri: f ] ]
        if [ wire.starts_with[ 'env:' ] ]
            f : project_file[ wire.mid[ 4, wire.count - 4 ] ]
            if [ !f ] return null
            img : Image [ uri: f, surface: Surface.environment ]
            return environment[ vk, img, vec3f [ 0.0, 1.0, 0.0 ], 0.0 ]
        if [ wire.starts_with[ 'color:' ] ]
            parts : wire.mid[ 6, wire.count - 6 ].split[ ' ' ]
            im : Image [ width: 1, height: 1, format: Pixel.rgba8,
                         channels: 4 ]
            px : @u8 im.vdata[]
            for [ k: i32 0, k < 4, k += 1 ]
                c : f32 [ 1.0 ]
                if [ k < parts.count ] c = f32[ parts[ k ] ]
                px[ k ] = u8[ c * 255.0 + 0.5 ]
            return im
        return output[ wire ]

    # the shader by class name, its settings applied
    func make_shader [ vk: vk_context, d: Draw, pname: string ]
                     -> shader
        mine : shader [ (given) ? given[ d.name ] : null ]
        if [ mine ]
            # the host made it: the file's values onto it
            apply[ mine, d ]
            return mine
        f : Au.find_type[ d.shader.chars, null ]
        if [ !f ]
            log 'aeon: stage {pname}: no shader class {d.shader}'
            return null
        made : Au.new_object[ f, null, null, false, __FILE__,
                              __LINE__, __SEQUENCE__ ]
        s : cast shader [ made ]
        s.vk   = vk
        s.name = 'aeon-{pname}-{d.name}'
        apply[ s, d ]
        s.initialize[]
        # its init sets defaults: the file's values win
        apply[ s, d ]
        return s

    # each setting onto the shader's member of that name
    func apply [ s: shader, d: Draw ]
        if [ !d.settings ] return
        for [ v: Au, k: string ] in d.settings
            member : find_member[ typeid[ s ], k.chars,
                                  AU_MEMBER_VAR, 0, true ]
            if [ !member ]
                log 'aeon: {d.shader} has no {k}'
                continue
            text : string [ v ]
            f : project_file[ text ]
            val : Au.convert[ member.src, (f) ? '{f}' : text ]
            if [ val ] s.set_property[ k, val ]

    # every pass's target and draws, in the file's order
    func build [ vk: vk_context, w: Window, pw: i32, ph: i32 ]
        born = Au.epoch_millis[]
        made_vk = vk
        made_w  = w
        built_w = pw
        built_h = ph
        lib : path.path_install[]
        if [ graph.modules ]
            for [ m: string ] in graph.modules
                ln : string 'silver-{m}'
                so : path '{lib}/build/{path.path_library[ ln.chars ]}'
                if [ !dlopen[ so.chars, 258 ] ]
                    log 'aeon: stage could not load {so}'
        for [ p: Pass ] in graph.passes
            list : p.draws
            if [ !list || list.count == 0 ]
                list = vec Draw [] [ Draw [ name: p.name,
                    objects: p.objects, quad: p.quad,
                    both_sides: p.both_sides, shader: p.shader,
                    inputs: p.inputs ] ]
            r : Running [ pass: p, draws: vec DrawRun [] ]
            models : vec Model []
            for [ d: Draw ] in list
                s : make_shader[ vk, d, p.name ]
                if [ !s ] continue
                smp : map Au [ string ] []
                if [ d.inputs ]
                    for [ v: Au, k: string ] in d.inputs
                        wire : string [ v ]
                        got : source[ vk, w, wire ]
                        if [ got ]
                            smp[ k ] = got
                        el
                            log 'aeon: stage {p.name}: no {wire}'
                # a shader with an environment named loads its own
                if [ s.env_id && !smp[ 'environment' ] ]
                    ew : string 'env:images/{s.env_id}.exr'
                    env : source[ vk, w, ew ]
                    if [ env ] smp[ 'environment' ] = env
                # the others first, depth only: colour times 0, the
                # target's times 1
                if [ occlude && !d.quad ]
                    gp : ModelParts [ names: vec string [],
                        counts: vec i32 [], y_up: p.y_up ]
                    gid : design_model[ design, d.objects, gp ]
                    # its own shader: a draw is switched by its shader
                    gs : make_shader[ vk, d, p.name ]
                    gm : Model [ vk: vk, w: w, s: gs, rigid_s: gs,
                        cull_none: d.both_sides, cull_front: flip_y,
                        samplers: smp,
                        blend: BlendState [ src: VK_BLEND_FACTOR_ZERO,
                            dst: VK_BLEND_FACTOR_ONE,
                            src_a: VK_BLEND_FACTOR_ZERO,
                            dst_a: VK_BLEND_FACTOR_ONE ] ]
                    gm.id = gid
                    panel_pictures[ gm ]
                    models.push[ gm ]
                    r.draws.push[ DrawRun [ draw: d, shade: gs,
                        model: gm, parts: gp, ghost: true, smp: smp ] ]
                run : DrawRun [ draw: d, shade: s, smp: smp ]
                if [ !d.quad ]
                    run.parts = ModelParts [ names: vec string [],
                        counts: vec i32 [], y_up: p.y_up ]
                    gm : design_model[ design, d.objects, run.parts ]
                    run.model = Model [ vk: vk, w: w, s: s, rigid_s: s,
                        cull_none: d.both_sides, cull_front: flip_y,
                        samplers: smp ]
                    run.model.id = gm
                    panel_pictures[ run.model ]
                el
                    run.model = Model [ w: w, s: s, samplers: smp ]
                models.push[ run.model ]
                r.draws.push[ run ]
            cc : vec4f [ 0.0, 0.0, 0.0, 0.0 ]
            if [ p.clear && p.clear.count >= 4 && !transparent ]
                cc = vec4f [ p.clear[ 0 ], p.clear[ 1 ], p.clear[ 2 ],
                             p.clear[ 3 ] ]
            sz : size_of[ p, pw, ph ]
            r.target = Render [ vk: vk, w: w, tag: 'aeon-{p.name}',
                width: i32[ sz.x ], height: i32[ sz.y ],
                use_depth: p.depth,
                reduce: p.reduce, clear_color: cc, models: models ]
            r.target.wscale = 0.0
            runs.push[ r ]

    # every svg panel's picture into a model's texture cache, by
    # the path its material names (the file is no image to load)
    func panel_pictures [ m: Model ]
        for [ o: Object ] in design.objects
            pn : o.panel[]
            if [ !pn ] continue
            tx : pn.picture_of[ made_vk, made_w ]
            if [ tx ] m.tex_cache[ '{design.base[]}/{pn.file}' ] = tx

    # a pass's pixel size at the host's size
    func size_of [ p: Pass, pw: i32, ph: i32 ] -> vec2f
        fw : f32 [ f32[ pw ] * p.scale ]
        fh : f32 [ f32[ ph ] * p.scale ]
        top : f32 [ (fw > fh) ? fw : fh ]
        if [ p.most > 0 && top > f32[ p.most ] ]
            fw = fw * f32[ p.most ] / top
            fh = fh * f32[ p.most ] / top
        # a target is never empty: one pixel a side at least
        return vec2f [ x: max[ 1.0, floor[ fw ] ],
                       y: max[ 1.0, floor[ fh ] ] ]

    # the view for a pass: the design's axes, or glTF's (y up)
    func view_of [ p: Pass ] -> mat4f
        u : vec3f [ up ]
        if [ u.x == 0.0 && u.y == 0.0 && u.z == 0.0 ]
            u = vec3f [ 0.0, 0.0, -1.0 ]
        if [ !p.y_up ] return mat4f.look_at[ eye, middle, u ]
        e : vec3f [ eye.x, eye.z, 0.0 - eye.y ]
        m : vec3f [ middle.x, middle.z, 0.0 - middle.y ]
        gu : vec3f [ u.x, u.z, 0.0 - u.y ]
        return mat4f.look_at[ e, m, gu ]

    # each pass drawn in order at the size given; the outputs
    func frame [ pw: i32, ph: i32 ] -> vec Texture
        shown : vec Texture []
        secs : f32 [ f32[ Au.epoch_millis[] - born ] / 1000.0 ]
        if [ host_time ] secs = time
        resized : bool [ false ]
        for [ r: Running ] in runs
            sz : size_of[ r.pass, pw, ph ]
            want_w : i32 [ sz.x ]
            want_h : i32 [ sz.y ]
            if [ r.target.width != want_w || r.target.height != want_h ]
                r.target.width  = want_w
                r.target.height = want_h
                resized = true
            # a pass made new textures: what reads them reads anew
            if [ resized ] rewire[ r ]
            r.target.state_mask = state_mask
            vw : view_of[ r.pass ]
            ep : vec3f [ eye ]
            if [ r.pass.y_up ] ep = vec3f [ eye.x, eye.z, 0.0 - eye.y ]
            for [ d: DrawRun ] in r.draws
                mvp : d.shade inherits ModelViewProject
                if [ mvp ]
                    mvp.model = model
                    mvp.view  = vw
                    mvp.proj  = proj
                    mvp.time  = secs
                lit : d.shade inherits AeonLit
                if [ lit ] lit.eye = vec4f [ ep.x, ep.y, ep.z, 1.0 ]
                # a shader with an eye position takes it
                pm : find_member[ typeid[ d.shade ], 'pos',
                                  AU_MEMBER_VAR, 0, true ]
                if [ pm && pm.src == typeid[ vec4f ] ]
                    at : vec4f [ ep.x, ep.y, ep.z, 1.0 ]
                    d.shade.set_property[ 'pos', at ]
            r.target.update[]
            r.target.draw[]
            r.target.sync_fence[]
        for [ o: string ] in graph.out
            tx : output[ o ]
            if [ tx ] shown.push[ tx ]
        return shown

    # the depth of the first pass drawing objects: what a host's
    # overlay (the floor's grid) hides behind
    func object_depth [] -> Texture
        for [ r: Running ] in runs
            if [ !r.pass.depth || !r.target ] continue
            for [ d: DrawRun ] in r.draws
                if [ d.parts ] return r.target.depth
        return null

    # each draw's pass wires read again, after a resize
    func rewire [ r: Running ]
        for [ d: DrawRun ] in r.draws
            if [ !d.draw.inputs ] continue
            again : bool [ false ]
            for [ v: Au, k: string ] in d.draw.inputs
                wire : string [ v ]
                tx : output[ wire ]
                if [ !tx ] continue
                d.model.samplers[ k ] = tx
                again = true
            if [ again ] d.model.rebind_model[]

    # one draw's setting changed in memory: its shader takes it
    func set_setting [ pname: string, dname: string, key: string,
                       text: string ]
        r : running[ pname ]
        if [ !r ] return
        for [ d: DrawRun ] in r.draws
            if [ d.draw.name.compare[ dname ] != 0 ] continue
            if [ !d.draw.settings ]
                d.draw.settings = map Au [ string ] []
            d.draw.settings[ key ] = text
            apply[ d.shade, d.draw ]

    # only the named objects drawn (invert: all but them); a draw
    # holding none of them is skipped by its shader's state
    func show_only [ names: vec string, invert: bool,
                     off: vec string ]
        for [ r: Running ] in runs
            for [ d: DrawRun ] in r.draws
                # a quad is decided below, by the passes it reads
                if [ !d.parts ] continue
                # its card, or its pass's, switched off
                if [ off && (quiet[ off, r.pass.name ]
                     || quiet[ off, '{r.pass.name}/{d.draw.name}' ]) ]
                    d.model.run_n = 0
                    d.shade.states = State.disable
                    continue
                d.keep = vec i32 []
                first : i32 [ 0 ]
                all : bool [ true ]
                for [ i: i32 0, i < d.parts.names.count, i += 1 ]
                    pn : d.parts.names[ i ]
                    named : bool [ false ]
                    for [ nm: string ] in names
                        if [ nm.compare[ pn ] == 0 ] named = true
                    want : bool [ named != invert ]
                    # a copy: the others, while one is shown, unless
                    # the user hid them
                    if [ d.ghost ]
                        hid : bool [ unseen
                                     && unseen.index_of[ pn ] >= 0 ]
                        want = !named && !hid && names.count > 0
                    if [ !want ] all = false
                    for [ k: i32 0, k < d.parts.counts[ i ], k += 1 ]
                        if [ want ]
                            at : i32 [ first + k ]
                            d.keep.push[ at ]
                            d.keep.push[ 0 ]
                            d.keep.push[ 0 ]
                    first += d.parts.counts[ i ]
                if [ all ]
                    d.model.run_n = 0
                    d.shade.states = State.none
                el [ d.keep.count == 0 ]
                    d.model.run_n = 0
                    # no state the target ever has: never drawn
                    d.shade.states = State.disable
                el
                    d.model.runs = @d.keep[ 0 ]
                    d.model.run_n = d.keep.count / 3
                    d.shade.states = State.none
        # a quad draws while its own node is on
        for [ r: Running ] in runs
            for [ d: DrawRun ] in r.draws
                if [ d.parts ] continue
                key : '{r.pass.name}/{d.draw.name}'
                hush : bool [ (off && (quiet[ off, key ]
                                  || quiet[ off, r.pass.name ]))
                              || (objects_only && !passes_on[ d.draw ]) ]
                d.shade.states = (hush) ? State.disable : State.none

    # an object changed shape (a step's value, one added or
    # removed): the models of the draws holding it are made again
    # and take the old ones' places; the passes and shaders stay
    func remake [ name: string ]
        # its shape changed: its GPU passes are made again when next
        # needed
        if [ gpus && gpus.contains[ name ] ] gpus.rm[ name ]
        for [ r: Running ] in runs
            fresh : vec Model []
            for [ d: DrawRun ] in r.draws
                if [ !d.parts || d.parts.names.index_of[ name ] < 0 ]
                    continue
                parts : ModelParts [ names: vec string [],
                    counts: vec i32 [], y_up: r.pass.y_up ]
                gid : design_model[ design, d.draw.objects, parts ]
                nm : Model [ vk: made_vk, w: made_w, s: d.shade,
                    rigid_s: d.shade, cull_none: d.draw.both_sides,
                    cull_front: flip_y,
                    samplers: d.smp, blend: d.model.blend ]
                nm.id = gid
                panel_pictures[ nm ]
                for [ i: i32 0, i < r.target.models.count, i += 1 ]
                    if [ r.target.models[ i ] == d.model ]
                        r.target.models[ i ] = nm
                d.model = nm
                d.parts = parts
                fresh.push[ nm ]
            if [ fresh.count == 0 ] continue
            r.target.sync_fence[]
            for [ m: Model ] in fresh
                m.finish[ r.target, 0 ]

    # a draw's shader samples its objects' materials: a colour
    # binding no input of the draw fills
    func reads_materials [ pass: string, draw: string ] -> bool
        for [ r: Running ] in runs
            if [ r.pass.name.compare[ pass ] != 0 ] continue
            for [ d: DrawRun ] in r.draws
                if [ d.draw.name.compare[ draw ] != 0 || !d.parts ]
                    continue
                return draw_reads_materials[ d.draw ]
        return false

    # a draw reads another pass's picture (its colour or reduction)
    func passes_on [ d: Draw ] -> bool
        if [ !d.inputs ] return false
        for [ v: Au, k: string ] in d.inputs
            wire : string [ v ]
            if [ wire.ends_with[ '.color' ]
                 || wire.ends_with[ '.reduction' ] ] return true
        return false

    func quiet [ off: vec string, key: string ] -> bool
        for [ k: string ] in off
            if [ k.compare[ key ] == 0 ] return true
        return false

    # an edited object redrawn in every draw that holds it
    func refresh [ o: Object ]
        # on the GPU: the cage's points and the place in, its steps,
        # normals and every draw's vertices out
        g : gpu_of[ o ]
        c : o.cage[]
        # what is kept for it is old now
        design.moved[ o.name ]
        if [ g && c && c.poly ]
            where : Placement [ at: o.at, turn: o.turn, size: o.size ]
            g.run[ c.poly.pos, where.matrix[] ]
            return
        for [ r: Running ] in runs
            for [ d: DrawRun ] in r.draws
                if [ !d.parts ] continue
                first : i32 [ 0 ]
                for [ i: i32 0, i < d.parts.names.count, i += 1 ]
                    if [ d.parts.names[ i ].compare[ o.name ] == 0 ]
                        done : refill[ d.model, first,
                            d.parts.counts[ i ], d.parts, o,
                            design.base[] ]
                        if [ !done ]
                            log 'aeon: {o.name} could not be refilled'
                        break
                    first += d.parts.counts[ i ]
