            cca : f32 [ 1.0 ]
            if [ rig ] cca = 0.0
            vrender   = Render [ vk: cv.vk, w: w, width: gw, height: gh, use_depth: true, clear_color: vec4f [ 0.015, 0.015, 0.015, cca ], models: array Model [ vmodel ] ]
            w.element_targets[ 'hs2_{id}' ] = vrender
            vrender.wscale = 0.0
            # anchors + pins first, so nothing can ever move the corners
            setup_cage_anchors[]
            if [ face_idx == 0 ]
                fpm : picker[]
                if [ fpm ]
                    if [ fpm.reset ]
                        fpm.save_mask[ a ]
                    el
                        fpm.load_mask[ a ]
                    # --gen N: batch generation starts itself at launch
                    if [ fpm.gen > 0 && !fpm.cap_started ]
                        fpm.cap_started = true
                        fpm.start_capture[]
                    # --fit: solve the user's metrics from the records
                    if [ fpm.fit && !fpm.cap_started ]
                        fpm.cap_started = true
                        fpm.run_fit[]
        tgt : vec3f [ look_x, look_y, look_z ]
        eye : vec3f [
            tgt.x + dist * cos[ pitch ] * sin[ yaw ],
            tgt.y + dist * sin[ pitch ],
            tgt.z + dist * cos[ pitch ] * cos[ yaw ] ]
        up  : vec3f [ 0.0f, -1.0f, 0.0f ]
        asp : f32 [ bounds.w / bounds.h ]
        fy  : f32 [ 2.0f * atan[ tan[ radians[ fov_x ] * 0.5f ] / asp ] ]
        mdlm : mat4f [ mat4f.identity[] ]
        if [ capture_left > 0 ] mdlm = cap_rot
        lgx : f32 [ eye.x ]
        lgy : f32 [ eye.y ]
        lgz : f32 [ eye.z ]
        if [ capture_left > 0 && capture_state == 2 ]
            lgx = cap_camx
            lgy = cap_camy
            lgz = cap_camz
        vshader.model = mdlm
        vshader.view  = mat4f.look_at[ eye, tgt, up ]
        vshader.proj  = mat4f.perspective[ fy, asp, 0.05f, 200.0f ]
        vshader.light_x = lgx
        vshader.light_y = lgy
        vshader.light_z = lgz
        vshader.eye_lx = eyec_lx
        vshader.eye_ly = eyec_ly
        vshader.eye_lz = eyec_lz
        vshader.eye_rx = eyec_rx
        vshader.eye_ry = eyec_ry
        vshader.eye_rz = eyec_rz
        vshader.globe_r = globe_rad
        if [ rshader ]
            rshader.model = mdlm
            rshader.view  = vshader.view
            rshader.proj  = vshader.proj
            rshader.light_x = lgx
            rshader.light_y = lgy
            rshader.light_z = lgz
        if [ cshader ]
            cshader.model = mdlm
            cshader.view  = vshader.view
            cshader.proj  = vshader.proj
            cshader.light_x = lgx
            cshader.light_y = lgy
            cshader.light_z = lgz
            if [ capture_left == 0 ]
                ph : f32 [ f32[ frame_n ] * 0.02f ]
                cshader.pupil_r = 0.35f + 0.20f * sin[ ph ]
        update_palette[]
        if [ vmodel ] vmodel.update_animated[]
        vrender.update[]
        frame_n += 1
        cv.draw_image[ vrender.color, rect [ x: 0.0, y: 0.0, w: bounds.w, h: bounds.h ] ]

# placement subclasses: the css file no longer loads; area lives
# per class in embedded style (ported from style/hyperspace.css)
ModelView FaceMain
    style : CSS {
        area: l0 t0 r0 b384px
    }

ModelView Vote0
    style : CSS {
        area: l0px t640px w512px b0
    }

ModelView Vote1
    style : CSS {
        area: l512px t640px w512px b0
    }

ModelView CapRoot
    style : CSS {
        area: l0 t0 r0 b0
    }

CameraView CamTop
    style : CSS {
        area: l0 t32px w496px h496px
    }

CameraView CamBot
    style : CSS {
        area: l500px t32px w496px h496px
    }

# record mode: the feed fills the screen. one cam takes it all,
# two stack as halves matching their top/bot names
CameraView RecFull
    style : CSS {
        area: l0 t32px r0 b0
    }

CameraView RecTop
    style : CSS {
        area: l0 t32px r0 b50%
    }

CameraView RecBot
    style : CSS {
        area: l0 t50% r0 b0
    }

Toolbar HsToolbar
    style : CSS {
        area: l0 t0 r0 h32px
    }

Button HsButton
    area   : Region { l0+ t4px w88px h24px }
    tlabel : Layer [ label_color: rgba [ '#fff' ], label_size: 14,
        label_align: vec2f [ x: 0.5, y: 0.5 ] ]
    style : CSS {
        layers.body:
            fill_color: #2a2440
            radius: 6
            inner_glow: #8af2 12
        :hovered
            layers.body:
                fill_color: #3a3458
                inner_glow: #acf4 16
        :pressed
            layers.body:
                fill_color: #438
                inner_glow: #ccf8 18
    }

# validation stations: wider pill, same look
HsButton VButton
    area : Region { l0+ t4px w112px h24px }

element hyperspace : trinity
    public model      : path   [ path 'models/uface.gltf' ]
    public width      : i32    [ 1024 ]
    public height     : i32    [ 1024 ]
    public title      : string [ 'hyperspace' ]
    public background : string [ 'Background' ]
    mutable seeded   : bool
    mutable regen_i  : i32                      # r-key regeneration counter
    public  face_main : ModelView              # auto-binds to e['face_main']
    public  vote_0    : ModelView              # auto-binds to e['vote_0']
    public  vote_1    : ModelView              # auto-binds to e['vote_1']
    mutable cap_os    : offscreen              # headless host for capture
    mutable cap_view  : ModelView              # the element inside it
    mutable cage_ci   : i32 [ -1 ]             # last main-view pick: cage
    mutable cage_v    : i32 [ -1 ]             # last main-view pick: vert
    public  session   : string [ 'top2' ]
    public  reset     : bool
    # views keyed by camera name (tl, tr) — the element system owns the
    # instances, so this is filled from elements rather than auto-bound
    mutable camera_views : map CameraView[string]
    # name=dev,x,y,z,tilt,fov ; next camera. the name is how the rest of
    # the app refers to a camera (tl, tr) instead of a /dev path
    # both sit on the top edge, 1.5in above it (0.199 + 0.0381 = 0.237) and
    # 0.25in forward toward the user (+z). x is quarter and three-quarter
    # across the 0.708 width: (0.25-0.5)*0.708 = -0.177, (0.75-0.5)*0.708 = 0.177
    public  cameras   : string [ 'tl=/dev/video2,-0.1416,0.237,0.00635,15,60;tr=/dev/video6,0.177,0.237,0.00635,15,60' ]
    mutable nose_k    : new f32 [ 8 ]      # per-camera neutral nose drop
    mutable nose_k_done : bool
    mutable cam_rig   : CamRig             # the only camera parser
    mutable cam_name  : array string
    mutable cam_dev   : array string
    mutable cam_cfg   : @f32                # x y z tilt fov per camera
    mutable cam_n     : i32
    mutable rec_mode  : string [ '' ]
    mutable rec_i     : i32
    mutable rec_last  : i64
    mutable rec_noise : bool                   # recording negatives (no face)
    mutable rec_fast  : bool                   # form 2: gaze locked with head
    mutable rec_seed  : i64 [ 987654321 ]
    mutable au_phase  : i32                    # 0: wait for space at new head spot
    mutable au_hx     : f32                    # head box center, 0..1
    mutable au_hy     : f32
    mutable au_dx     : f32                    # gaze dot, 0..1
    mutable au_dy     : f32
    mutable au_tx     : f32
    mutable au_ty     : f32
    mutable au_sx     : f32
    mutable au_sy     : f32
    mutable au_t0     : i64
    mutable au_T      : f32
    mutable au_cap    : i64
    mutable au_dwell  : i64
    mutable au_leg    : i32
    mutable au_px     : f32
    mutable au_py     : f32
    mutable au_u      : f32                    # spiral pitch per leg
    mutable au_zero   : i32                    # frame id of the group's zero pair
    mutable au_b0     : i64                    # burst start: 4s per SPACE
    mutable ann_files : array string
    mutable ann_i     : i32
    mutable ann_cam   : i32
    mutable ann_sub   : i32
    mutable ann_ext   : bool                   # shift: include inner corners
    mutable ann_tex   : Texture
    mutable ann_img   : Image                  # loaded pair image, pre-GPU
    mutable ann_rect  : rect
    mutable ann_last  : i64
    mutable ann_px    : f32                    # first click (left corner)
    mutable ann_py    : f32
    mutable ann_m0    : vec2f                  # saved plots of the image
    mutable ann_m1    : vec2f                  # on screen: left, right,
    mutable ann_m2    : vec2f                  # nose base (-999 = absent)
    mutable ann_m3    : vec2f                  # left pupil center
    mutable ann_m4    : vec2f                  # right pupil center
    mutable ann_m5    : vec2f                  # left inner corner
    mutable ann_m6    : vec2f                  # right inner corner
    mutable ann_m7    : vec2f                  # hair flag (h key at cursor)
    mutable ann_lf    : string                 # loaded (fid, cam) — avoids
    mutable ann_lc    : i32 [ -1 ]             # reloading per click
    public  redo_oc   : bool                   # re-plot everything, overwrite

    # CamRig owns the only parser; cam_cfg mirrors it flat so the
    # generation math keeps indexing by camera without a lookup
    func sync_cams []
        if [ cam_n > 0 ] return
        if [ !cam_rig ]
            cam_rig = CamRig [ cameras: cameras ]
            cam_rig.hold[]
        n9 : i32 [ cam_rig.count[] ]
        cam_name = array string [ ]
        cam_name.hold[]
        cam_dev = array string [ ]
        cam_dev.hold[]
        sz9 : i32 [ n9 * 5 ]
        cam_cfg = new f32 [ sz9 ]
        for [ i9: i32 0, i9 < n9, i9 += 1 ]
            c9 : cam_rig.at[ i9 ]
            cam_name += c9.name
            cam_dev  += c9.dev
            cam_cfg[ i9 * 5 + 0 ] = c9.x
            cam_cfg[ i9 * 5 + 1 ] = c9.y
            cam_cfg[ i9 * 5 + 2 ] = c9.z
            cam_cfg[ i9 * 5 + 3 ] = c9.tilt
            cam_cfg[ i9 * 5 + 4 ] = c9.fov
        cam_n = n9

    # index of a named camera (tl, tr); -1 when there is no such name
    func cam_index [ nm: string ] -> i32
        sync_cams[]
        for [ i9: i32 0, i9 < cam_n, i9 += 1 ]
            if [ cam_name[ i9 ].compare[ nm ] == 0 ] return i9
        return -1

    # /dev path of a named camera; null when unknown
    func cam_by_name [ nm: string ] -> string
        i9 : i32 [ cam_index[ nm ] ]
        if [ i9 < 0 ] return null
        return cam_dev[ i9 ]

    # role prefix for camera i: the configured name (tl, tr), so
    # filenames and .agi keys carry the rig's identities
    func cam_role [ i9: i32 ] -> string
        sync_cams[]
        if [ i9 >= 0 && i9 < cam_n ] return cam_name[ i9 ]
        return '{i9}'

    # live view for a camera name; resolved through elements so it is never
    # a stale instance, and cached in camera_views for callers that iterate
    func camera_view [ nm: string ] -> CameraView
        if [ !elements ] return null
        v9 : cast CameraView [ elements[ nm ] ]
        if [ v9 ]
            if [ !camera_views ] camera_views = map CameraView[string] [ ]
            camera_views[ nm ] = v9
        return v9

    func cam_view [ i9: i32 ] -> CameraView
        return camera_view[ cam_role[ i9 ] ]

    func rec_dir [] -> path
        mkdir[ '/src/hyperspace-sessions', 493 ]
        mkdir[ '/src/hyperspace-sessions/{session}', 493 ]
        rd : path '/src/hyperspace-sessions/{session}/record'
        rd.make_dir[]
        return rd

    func init [ ]
        # batch generation never shows a window
        if [ gen > 0 ] hidden = true

    func start_record [ noise: bool ]
        # every listed camera must exist or recording is a lie
        sync_cams[]
        for [ cd: i32 0, cd < cam_n, cd += 1 ]
            dv9 : cam_dev[ cd ]
            dp9 : path '{dv9}'
            if [ !dp9.exists[] ]
                puts 'record ERROR: camera missing — {dv9}'
                return
        rd : rec_dir[]
        rec_i = 0
        k7 : i32 [ 0 ]
        miss7 : i32 [ 0 ]
        while [ miss7 < 500 ]
            fp : path '{rd}/{k7}.agi'
            if [ fp.exists[] ]
                rec_i = k7 + 1
                miss7 = 0
            el
                miss7 += 1
            k7 += 1
        rec_last = 0
        rec_noise = noise
        if [ !noise ]
            rec_seed = epoch_millis[]
            au_new_position[]
        rec_mode = 'record'
        ux.set_fullscreen[ true ]
        kind : string [ (noise) ? 'NOISE negatives' : 'face pairs' ]
        puts 'record {kind}: -> {rd} starting at {rec_i} (click to stop)'

    func rec_frand [] -> f32
        rec_seed = rec_seed * 1664525 + 1013904223
        return f32[ (rec_seed >> 8) & 16777215 ] / 16777216.0

    func au_next_fast []
        # form 2: the whole target leaps across the screen, quick —
        # head and gaze ride it together
        au_sx = au_dx
        au_sy = au_dy
        au_tx = 0.1 + rec_frand[] * 0.8
        au_ty = 0.1 + rec_frand[] * 0.8
        au_t0 = epoch_millis[]
        fdxT : f32 [ au_tx - au_sx ]
        fdyT : f32 [ au_ty - au_sy ]
        au_T = sqrt[ fdxT * fdxT + fdyT * fdyT ] / 0.30 * 1.0
        if [ au_T < 0.5 ] au_T = 0.5
        au_dwell = 0

    func au_next_dot []
        # the dot: a new random spot AROUND the circle, quick glide
        au_sx = au_dx
        au_sy = au_dy
        ang9 : f32 [ rec_frand[] * 6.2831853 ]
        rad9 : f32 [ 0.06 + rec_frand[] * 0.16 ]
        au_tx = au_hx + cos[ ang9 ] * rad9
        au_ty = au_hy + sin[ ang9 ] * rad9
        if [ au_tx < 0.03 ] au_tx = 0.03
        if [ au_tx > 0.97 ] au_tx = 0.97
        if [ au_ty < 0.03 ] au_ty = 0.03
        if [ au_ty > 0.97 ] au_ty = 0.97
        au_t0 = epoch_millis[]
        ddxT : f32 [ au_tx - au_sx ]
        ddyT : f32 [ au_ty - au_sy ]
        au_T = sqrt[ ddxT * ddxT + ddyT * ddyT ] / 0.145 * 1.5
        if [ au_T < 0.35 ] au_T = 0.35
        au_dwell = 0

    func au_new_position []
        au_phase = 0
        au_hx = 0.2 + rec_frand[] * 0.6
        au_hy = 0.2 + rec_frand[] * 0.6
        au_dx = au_hx
        au_dy = au_hy
        au_tx = au_hx
        au_ty = au_hy

    func rec_capture []
        rd : rec_dir[]
        r0 : cam_role[ 0 ]
        r1 : cam_role[ 1 ]
        tp : path '{rd}/{rec_i}-{r0}.png'
        bp : path '{rd}/{rec_i}-{r1}.png'
        v0 : cam_view[ 0 ]
        v1 : cam_view[ 1 ]
        okt : bool [ (v0) ? v0.save_frame[ tp ] : false ]
        okb : bool [ (v1) ? v1.save_frame[ bp ] : false ]
        lu : f32 [ au_dx - 0.5 ]
        lv : f32 [ au_dy - 0.5 ]
        hu2 : f32 [ au_hx - 0.5 ]
        hv2 : f32 [ au_hy - 0.5 ]
        s : string 'images:\n    {r0}: {rec_i}-{r0}.png\n'
        if [ cam_n > 1 ] s = string '{s}    {r1}: {rec_i}-{r1}.png\n'
        s = string '{s}cameras: {cam_n}\nlook: {lu} {lv}\nhead: {hu2} {hv2}\n'
        ag : path '{rd}/{rec_i}.agi'
        ag.save[ s, null ]
        rec_i += 1

    # write or REPLACE `key: value` in a recorded pair's agi
    func agi_put2 [ fid: i32, key: string, val: string ]
        p : path '{rec_dir[]}/{fid}.agi'
        line : string '{key}: {val}\n'
        s : cast string [ p.load[ typeid[ string ], null ] ]
        if [ !s ]
            p.save[ line, null ]
            return
        k2 : string '{key}:'
        ix : num [ s.index_of[ k2 ] ]
        if [ ix < 0 ]
            ns2 : string '{s}{line}'
            p.save[ ns2, null ]
            return
        st : i32 [ i32[ ix ] ]
        hd2 : s.mid[ 0, st ]
        rest : s.mid[ st, s.count - st ]
        nl : num [ rest.index_of[ '\n' ] ]
        tail : string ''
        if [ nl >= 0 ] tail = rest.mid[ i32[ nl ] + 1, rest.count - i32[ nl ] - 1 ]
        ns3 : string '{hd2}{line}{tail}'
        p.save[ ns3, null ]

    func rec_pair_missing [ fid: i32 ] -> bool
        p : path '{rec_dir[]}/{fid}.agi'
        s : cast string [ p.load[ typeid[ string ], null ] ]
        if [ !s ] return true
        # negatives have no face: nothing to plot
        if [ s.index_of[ 'noise: true' ] >= 0 ] return false
        # overwrite pass: every face pair re-enters the queue
        if [ redo_oc ] return true
        # a hidden camera has nothing to plot; otherwise every point is required
        c0 : cam_role[ 0 ]
        if [ s.index_of[ '{c0}_hidden:' ] < 0 ]
            if [ s.index_of[ '{c0}_left_oc:' ] < 0 ] return true
            if [ s.index_of[ '{c0}_right_oc:' ] < 0 ] return true
            if [ s.index_of[ '{c0}_nose_base:' ] < 0 ] return true
            if [ s.index_of[ '{c0}_left_pupil:' ] < 0 ] return true
            if [ s.index_of[ '{c0}_right_pupil:' ] < 0 ] return true
            if [ s.index_of[ '{c0}_left_ic:' ] < 0 ] return true
            if [ s.index_of[ '{c0}_right_ic:' ] < 0 ] return true
        # single-camera pairs have no second image to plot
        c1 : cam_role[ 1 ]
        if [ s.index_of[ '    {c1}:' ] >= 0 && s.index_of[ '{c1}_hidden:' ] < 0 ]
            if [ s.index_of[ '{c1}_left_oc:' ] < 0 ] return true
            if [ s.index_of[ '{c1}_right_oc:' ] < 0 ] return true
            if [ s.index_of[ '{c1}_nose_base:' ] < 0 ] return true
            if [ s.index_of[ '{c1}_left_pupil:' ] < 0 ] return true
            if [ s.index_of[ '{c1}_right_pupil:' ] < 0 ] return true
            if [ s.index_of[ '{c1}_left_ic:' ] < 0 ] return true
            if [ s.index_of[ '{c1}_right_ic:' ] < 0 ] return true
        return false

    func rec_read [ fid: string, cam: i32, sub: i32 ] -> vec2f
        r : vec2f [ x: -999.0, y: -999.0 ]
        cs : cam_role[ cam ]
        k6 : string '{cs}_left_oc:'
        if [ sub == 1 ] k6 = string '{cs}_right_oc:'
        if [ sub == 2 ] k6 = string '{cs}_nose_base:'
        if [ sub == 3 ] k6 = string '{cs}_left_pupil:'
        if [ sub == 4 ] k6 = string '{cs}_right_pupil:'
        if [ sub == 5 ] k6 = string '{cs}_left_ic:'
        if [ sub == 6 ] k6 = string '{cs}_right_ic:'
        if [ sub == 7 ] k6 = string '{cs}_hair:'
        if [ sub == 8 ] k6 = string 'look:'
        if [ sub == 9 ] k6 = string 'head:'
        p : path '{rec_dir[]}/{fid}.agi'
        s : cast string [ p.load[ typeid[ string ], null ] ]
        if [ !s ] return r
        ix : num [ s.index_of[ k6 ] ]
        if [ ix < 0 ] return r
        st : i32 [ i32[ ix ] + k6.count ]
        ln : i32 [ s.count - st ]
        if [ ln > 48 ] ln = 48
        rest : s.mid[ st, ln ].trim[]
        parts : rest.split[ ' ' ]
        if [ parts.count < 2 ] return r
        r = vec2f [ x: f32[ atof[ parts[0].chars ] ], y: f32[ atof[ parts[1].chars ] ] ]
        return r

    func ann_refresh_marks []
        fid : ann_files[ ann_i ]
        ann_m0 = rec_read[ fid, ann_cam, 0 ]
        ann_m1 = rec_read[ fid, ann_cam, 1 ]
        ann_m2 = rec_read[ fid, ann_cam, 2 ]
        ann_m3 = rec_read[ fid, ann_cam, 3 ]
        ann_m4 = rec_read[ fid, ann_cam, 4 ]
        ann_m5 = rec_read[ fid, ann_cam, 5 ]
        ann_m6 = rec_read[ fid, ann_cam, 6 ]
        ann_m7 = rec_read[ fid, ann_cam, 7 ]

    func ann_mark [ cv: Canvas, mv: vec2f, col: string ]
        if [ mv.x < -100.0 ] return
        mx : f32 [ ann_rect.x + mv.x * ann_rect.w ]
        my : f32 [ ann_rect.y + mv.y * ann_rect.h ]
        cv.arc[ mx, my, 7.0, 0.0, 6.2831853 ]
        cv.fill_color[ '#0000' ]
        cv.stroke_color[ col ]
        cv.stroke_width[ 2.0 ]
        cv.paint[]
        cv.arc[ mx, my, 1.5, 0.0, 6.2831853 ]
        cv.fill_color[ col ]
        cv.stroke_width[ 0.0 ]
        cv.paint[]

    func ann_have [ fid: string, cam: i32, sub: i32 ] -> bool
        cs : cam_role[ cam ]
        k6 : string '{cs}_left_oc:'
        if [ sub == 1 ] k6 = string '{cs}_right_oc:'
        if [ sub == 2 ] k6 = string '{cs}_nose_base:'
        if [ sub == 3 ] k6 = string '{cs}_left_pupil:'
        if [ sub == 4 ] k6 = string '{cs}_right_pupil:'
        if [ sub == 5 ] k6 = string '{cs}_left_ic:'
        if [ sub == 6 ] k6 = string '{cs}_right_ic:'
        if [ sub == 7 ] k6 = string '{cs}_hair:'
        p : path '{rec_dir[]}/{fid}.agi'
        s : cast string [ p.load[ typeid[ string ], null ] ]
        if [ !s ] return false
        # hidden: the face is not visible to this camera, nothing to plot
        if [ s.index_of[ '{cs}_hidden:' ] >= 0 ] return true
        return s.index_of[ k6 ] >= 0

    func ann_seek [ advance: bool ]
        if [ advance ] ann_sub += 1
        lim7 : i32 [ (ann_ext) ? 7 : 5 ]
        while [ true ]
            if [ ann_sub >= lim7 ]
                ann_sub = 0
                ann_cam += 1
            if [ ann_cam >= 2 ]
                ann_cam = 0
                ann_i += 1
            if [ ann_i >= ann_files.count ]
                rec_mode = ''
                ann_tex = null
                ann_img = null
                ann_lc = -1
                puts 'annotate: all pairs plotted'
                return
            fid9 : ann_files[ ann_i ]
            cs9 : cam_role[ ann_cam ]
            ip9 : path '{rec_dir[]}/{fid9}-{cs9}.png'
            if [ !ip9.exists[] ]
                ann_sub += 1
                continue
            if [ redo_oc ] break
            if [ !ann_have[ fid9, ann_cam, ann_sub ] ] break
            ann_sub += 1
        ann_load2[]

    func ann_load2 []
        fid : ann_files[ ann_i ]
        if [ ann_img && ann_lc == ann_cam && ann_lf && ann_lf == fid ] return
        cam : cam_role[ ann_cam ]
        ip : path '{rec_dir[]}/{fid}-{cam}.png'
        im : Image [ uri: ip ]
        if [ im.width <= 0 ]
            puts 'annotate ERROR: cannot load {ip}'
            return
        im.hold[]
        ann_img = im
        ann_tex = null
        ann_lf = fid
        ann_lf.hold[]
        ann_lc = ann_cam
        ann_refresh_marks[]
        puts 'annotate {fid}-{cam} ({im.width}x{im.height}) ({ann_i + 1}/{ann_files.count})'

    func start_annotate []
        rd : rec_dir[]
        ann_files = array string [ ]
        k : i32 [ 0 ]
        miss7 : i32 [ 0 ]
        while [ miss7 < 500 ]
            fp : path '{rd}/{k}.agi'
            if [ !fp.exists[] ]
                k += 1
                miss7 += 1
                continue
            miss7 = 0
            if [ rec_pair_missing[ k ] ] ann_files += string '{k}'
            k += 1
        if [ ann_files.count == 0 ]
            puts 'annotate: nothing to plot (record first, or all done)'
            return
        n5 : i32 [ ann_files.count ]
        fs5 : new i64 [ n5 ]
        for [ i: i32 0, i < n5, i += 1 ]
            fs5[ i ] = i64[ atof[ ann_files[ i ].chars ] ]
        for [ si: i32 1, si < n5, si += 1 ]
            cur : i64 [ fs5[ si ] ]
            kv : i64 [ cur * 2654435761 % 1000003 ]
            sj : i32 [ si ]
            while [ sj > 0 ]
                pv : i64 [ fs5[ sj - 1 ] * 2654435761 % 1000003 ]
                if [ pv <= kv ] break
                fs5[ sj ] = fs5[ sj - 1 ]
                sj -= 1
            fs5[ sj ] = cur
        af5 : array string [ ]
        for [ i: i32 0, i < n5, i += 1 ]
            fi5 : i64 [ fs5[ i ] ]
            fn5 : string '{fi5}'
            if [ ann_have[ fn5, 0, 0 ] ] af5 += fn5
        for [ i: i32 0, i < n5, i += 1 ]
            fi5 : i64 [ fs5[ i ] ]
            fn5 : string '{fi5}'
            if [ !ann_have[ fn5, 0, 0 ] ] af5 += fn5
        ann_files = af5
        ann_i = 0
        ann_cam = 0
        ann_sub = 0
        rec_mode = 'annotate'
        ann_seek[ false ]

    func crop_tensor2 [ src: Image, cx: f32, cy: f32, side: f32, mir: bool ] -> tensor
        t : tensor [ tensor_shape: 32x32x1 ]
        data : @u8 [ src.vdata[] ]
        bpp : i32 [ (src.format == Pixel.u8) ? 1 : 4 ]
        iw2 : f32 [ f32[ src.width ] ]
        spx : f32 [ side * iw2 ]
        x0 : f32 [ cx * iw2 - spx * 0.5 ]
        y0 : f32 [ cy * iw2 - spx * 0.5 ]
        step : f32 [ spx / 32.0 ]
        for [ oy: i32 0, oy < 32, oy += 1 ]
            ys : i32 [ i32[ y0 + f32[ oy ] * step ] ]
            ye : i32 [ i32[ y0 + (f32[ oy ] + 1.0) * step ] ]
            if [ ye <= ys ] ye = ys + 1
            for [ ox: i32 0, ox < 32, ox += 1 ]
                xs : i32 [ i32[ x0 + f32[ ox ] * step ] ]
                xe : i32 [ i32[ x0 + (f32[ ox ] + 1.0) * step ] ]
                if [ xe <= xs ] xe = xs + 1
                acc : f32 [ 0.0 ]
                cnt : i32 [ 0 ]
                for [ sy: i32 ys, sy < ye, sy += 1 ]
                    for [ sx: i32 xs, sx < xe, sx += 1 ]
                        cnt += 1
                        if [ sy < 0 || sy >= src.height ] continue
                        if [ sx < 0 || sx >= src.width ] continue
                        acc += f32[ data[ (sy * src.width + sx) * bpp ] ]
                dox : i32 [ (mir) ? (31 - ox) : ox ]
                t.floats[ oy * 32 + dox ] = acc / (f32[ cnt ] * 255.0)
        return t

    func crop_tensor16 [ src: Image, cx: f32, cy: f32, side: f32 ] -> tensor
        t : tensor [ tensor_shape: 16x16x1 ]
        data : @u8 [ src.vdata[] ]
        bpp : i32 [ (src.format == Pixel.u8) ? 1 : 4 ]
        iw2 : f32 [ f32[ src.width ] ]
        spx : f32 [ side * iw2 ]
        x0 : f32 [ cx * iw2 - spx * 0.5 ]
        y0 : f32 [ cy * iw2 - spx * 0.5 ]
        step : f32 [ spx / 16.0 ]
        for [ oy: i32 0, oy < 16, oy += 1 ]
            ys : i32 [ i32[ y0 + f32[ oy ] * step ] ]
            ye : i32 [ i32[ y0 + (f32[ oy ] + 1.0) * step ] ]
            if [ ye <= ys ] ye = ys + 1
            for [ ox: i32 0, ox < 16, ox += 1 ]
                xs : i32 [ i32[ x0 + f32[ ox ] * step ] ]
                xe : i32 [ i32[ x0 + (f32[ ox ] + 1.0) * step ] ]
                if [ xe <= xs ] xe = xs + 1
                acc : f32 [ 0.0 ]
                cnt : i32 [ 0 ]
                for [ sy: i32 ys, sy < ye, sy += 1 ]
                    for [ sx: i32 xs, sx < xe, sx += 1 ]
                        cnt += 1
                        if [ sy < 0 || sy >= src.height ] continue
                        if [ sx < 0 || sx >= src.width ] continue
                        acc += f32[ data[ (sy * src.width + sx) * bpp ] ]
                t.floats[ oy * 16 + ox ] = acc / (f32[ cnt ] * 255.0)
        return t

    func upload_tensor2 [ tex: Texture, t: tensor ]
        img2 : Image [ width: 32, height: 32, format: Pixel.rgba8 ]
        d : @u8 [ img2.vdata[] ]
        for [ i: i32 0, i < 1024, i += 1 ]
            v : f32 [ t.floats[i] * 255.0 ]
            if [ v < 0.0 ]   v = 0.0
            if [ v > 255.0 ] v = 255.0
            b : u8 [ u8[ i32[ v ] ] ]
            d[i * 4]     = b
            d[i * 4 + 1] = b
            d[i * 4 + 2] = b
            d[i * 4 + 3] = u8[ 255 ]
        tex.upload[ img2.vdata[], 4096 ]

    func tb_cam2 [ c: i32, gray: Image ] -> bool
        for [ e2: i32 0, e2 < 2, e2 += 1 ]
            b3 : i32 [ (c * 2 + e2) * 3 ]
            ex : f32 [ tb_ex[ b3 + 0 ] ]
            ey : f32 [ tb_ex[ b3 + 1 ] ]
            es : f32 [ tb_ex[ b3 + 2 ] ]
            mir : bool [ e2 == 1 ]
            # target on a wide window around the last known spot
            tw : f32 [ es * 2.5 ]
            tt : crop_tensor2[ gray, ex, ey, tw, mir ]
            o3 : tensor [ tensor_shape: 1x3 ]
            ts_target.forward1[ tt, o3, 32 ]
            tdx : f32 [ (mir) ? (0.0 - o3.floats[0]) : o3.floats[0] ]
            ex = ex + tdx * tw
            ey = ey + o3.floats[1] * tw
            # exp[] on a subscript feeds the GEP unloaded: local first
            td3 : f32 [ o3.floats[2] ]
            es = exp[ td3 ] * tw
            if [ es < 0.02 ] es = 0.02
            if [ es > 0.35 ] es = 0.35
            # refine at the look crop convention
            c0x : f32 [ ex ]
            c0y : f32 [ ey ]
            rt : crop_tensor2[ gray, c0x, c0y, es, mir ]
            o5 : tensor [ tensor_shape: 1x5 ]
            ts_refine.forward1[ rt, o5, 32 ]
            rdx : f32 [ (mir) ? (0.0 - o5.floats[0]) : o5.floats[0] ]
            rox : f32 [ (mir) ? (0.0 - o5.floats[2]) : o5.floats[2] ]
            ex = c0x + rdx * es
            ey = c0y + o5.floats[1] * es
            b4 : i32 [ (c * 2 + e2) * 2 ]
            tb_oc[ b4 + 0 ] = c0x + rox * es
            tb_oc[ b4 + 1 ] = c0y + o5.floats[3] * es
            rd5 : f32 [ o5.floats[4] ]
            es = exp[ rd5 ] * es
            if [ es < 0.02 ] es = 0.02
            if [ es > 0.35 ] es = 0.35
            # a track that ran off frame resets to its seat prior
            if [ ex < 0.02 || ex > 0.98 || ey < 0.02 || ey > 0.98 ]
                ex = (e2 == 0) ? 0.58 : 0.42
                ey = 0.45
                es = 0.07
            tb_ex[ b3 + 0 ] = ex
            tb_ex[ b3 + 1 ] = ey
            tb_ex[ b3 + 2 ] = es
        bl3 : i32 [ c * 6 ]
        elx : f32 [ tb_ex[ bl3 + 0 ] ]
        ely : f32 [ tb_ex[ bl3 + 1 ] ]
        erx : f32 [ tb_ex[ bl3 + 3 ] ]
        ery : f32 [ tb_ex[ bl3 + 4 ] ]
        sdx5 : f32 [ elx - erx ]
        sdy5 : f32 [ ely - ery ]
        sc5 : f32 [ sqrt[ sdx5*sdx5 + sdy5*sdy5 ] ]
        if [ sc5 < 0.02 ] return false
        side5 : f32 [ sc5 / 2.12 ]
        lc : crop_tensor2[ gray, elx, ely, side5, false ]
        rc : crop_tensor2[ gray, erx, ery, side5, false ]
        fmx : f32 [ (elx + erx) * 0.5 ]
        fmy : f32 [ (ely + ery) * 0.5 ]
        fc5 : crop_tensor2[ gray, fmx, fmy, sc5 * 1.75, false ]
        # face box + the exact 32px net inputs, for the overlay
        tb_fb[ c * 3 + 0 ] = fmx
        tb_fb[ c * 3 + 1 ] = fmy
        tb_fb[ c * 3 + 2 ] = sc5 * 1.75
        if [ tb_pv && tb_pv.count >= 6 ]
            upload_tensor2[ tb_pv[ c * 3 + 0 ], lc ]
            upload_tensor2[ tb_pv[ c * 3 + 1 ], rc ]
            upload_tensor2[ tb_pv[ c * 3 + 2 ], fc5 ]
        ax : tensor [ tensor_shape: 1x18 ]
        bo4 : i32 [ c * 4 ]
        ax.floats[0] = elx - 0.5
        ax.floats[1] = ely - 0.5
        ax.floats[2] = erx - 0.5
        ax.floats[3] = ery - 0.5
        ax.floats[4] = tb_oc[ bo4 + 0 ] - 0.5
        ax.floats[5] = tb_oc[ bo4 + 1 ] - 0.5
        ax.floats[6] = tb_oc[ bo4 + 2 ] - 0.5
        ax.floats[7] = tb_oc[ bo4 + 3 ] - 0.5
        ax.floats[8] = sc5
        ax.floats[9]  = elx - 0.5
        ax.floats[10] = ely - 0.5
        ax.floats[11] = side5
        ax.floats[12] = erx - 0.5
        ax.floats[13] = ery - 0.5
        ax.floats[14] = side5
        ax.floats[15] = fmx - 0.5
        ax.floats[16] = fmy - 0.5
        ax.floats[17] = sc5 * 1.75
        fd9 : tb_f0
        ld9 : tb_l0
        rd9 : tb_r0
        if [ c == 1 ]
            fd9 = tb_f1
            ld9 = tb_l1
            rd9 = tb_r1
        for [ q9: i32 0, q9 < 1024, q9 += 1 ]
            fd9.floats[ q9 ] = fc5.floats[ q9 ]
            ld9.floats[ q9 ] = lc.floats[ q9 ]
            rd9.floats[ q9 ] = rc.floats[ q9 ]
        for [ q8: i32 0, q8 < 18, q8 += 1 ]
            tb_a36[ c * 18 + q8 ] = ax.floats[ q8 ]
        return true

    public func start_test []
        mp : model.parent_dir[]
        ts_target = ts_model [ uri: path '{mp}/target2.ptc' ]
        ts_target.hold[]
        ts_refine = ts_model [ uri: path '{mp}/refine2.ptc' ]
        ts_refine.hold[]
        ts_look = ts_model [ uri: path '{mp}/look2.ptc' ]
        ts_look.hold[]
        ts_off = ts_model [ uri: path '{mp}/offset2.ptc' ]
        ts_off.hold[]
        tb_f0 = tensor [ tensor_shape: 32x32x1 ]
        tb_f0.hold[]
        tb_f1 = tensor [ tensor_shape: 32x32x1 ]
        tb_f1.hold[]
        tb_l0 = tensor [ tensor_shape: 32x32x1 ]
        tb_l0.hold[]
        tb_r0 = tensor [ tensor_shape: 32x32x1 ]
        tb_r0.hold[]
        tb_l1 = tensor [ tensor_shape: 32x32x1 ]
        tb_l1.hold[]
        tb_r1 = tensor [ tensor_shape: 32x32x1 ]
        tb_r1.hold[]
        tb_a36 = new f32 [ 36 ]
        tb_ohave = false
        tb_ex = new f32 [ 12 ]
        tb_oc = new f32 [ 8 ]
        tb_ok = new f32 [ 2 ]
        tb_fb = new f32 [ 6 ]
        for [ c6: i32 0, c6 < 2, c6 += 1 ]
            b6 : i32 [ c6 * 6 ]
            tb_ex[ b6 + 0 ] = 0.58
            tb_ex[ b6 + 1 ] = 0.45
            tb_ex[ b6 + 2 ] = 0.07
            tb_ex[ b6 + 3 ] = 0.42
            tb_ex[ b6 + 4 ] = 0.45
            tb_ex[ b6 + 5 ] = 0.07
        tb_gx = 0.0
        tb_gy = 0.0
        rec_mode = 'test'
        ux.set_fullscreen[ true ]
        puts 'testbed: cascade live (esc to quit)'

    func bench_dir [] -> path
        mkdir[ '/src/hyperspace-sessions', 493 ]
        mkdir[ '/src/hyperspace-sessions/{session}', 493 ]
        bd : path '/src/hyperspace-sessions/{session}/benchmark'
        bd.make_dir[]
        return bd

    public func start_bench []
        sync_cams[]
        for [ cd: i32 0, cd < cam_n, cd += 1 ]
            dv9 : cam_dev[ cd ]
            dp9 : path '{dv9}'
            if [ !dp9.exists[] ]
                puts 'benchmark ERROR: camera missing — {dv9}'
                return
        bd : bench_dir[]
        bench_i = 0
        k7 : i32 [ 0 ]
        miss7 : i32 [ 0 ]
        while [ miss7 < 500 ]
            fp : path '{bd}/{k7}.agi'
            if [ fp.exists[] ]
                bench_i = k7 + 1
                miss7 = 0
            el
                miss7 += 1
            k7 += 1
        bench_t0 = epoch_millis[]
        bench_at = bench_t0 + 3000
        bench_last = 0
        rec_mode = 'bench'
        ux.set_fullscreen[ true ]
        puts 'benchmark: -> {bd} starting at {bench_i} — follow the mark (click to stop)'

    func cam_ray [ c: i32, nx: f32, ny: f32, ox: @f32, dx: @f32 ]
        c5 : i32 [ c * 5 ]
        ox[0] = cam_cfg[ c5 + 0 ]
        ox[1] = cam_cfg[ c5 + 1 ]
        # this solve space runs +z toward the person
        ox[2] = 0.0 - cam_cfg[ c5 + 2 ]
        tl : f32 [ radians[ cam_cfg[ c5 + 3 ] ] ]
        fx : f32 [ 0.0 ]
        fy : f32 [ 0.0 - sin[ tl ] ]
        fz : f32 [ cos[ tl ] ]
        # camera basis from forward x world-up
        rx : f32 [ fy * 0.0 - fz * 1.0 ]
        ry : f32 [ 0.0 ]
        rz : f32 [ fx * 1.0 - fy * 0.0 ]
        rl : f32 [ sqrt[ rx*rx + rz*rz ] ]
        if [ rl < 0.0001 ] rl = 0.0001
        rx = rx / rl
        rz = rz / rl
        cux : f32 [ ry*fz - rz*fy ]
        cuy : f32 [ rz*fx - rx*fz ]
        cuz : f32 [ rx*fy - ry*fx ]
        ht : f32 [ tan[ radians[ rec_fov ] * 0.5 ] ]
        px : f32 [ (nx - 0.5) * 2.0 * ht ]
        py : f32 [ (0.5 - ny) * 2.0 * ht ]
        vx : f32 [ fx + rx*px + cux*py ]
        vy : f32 [ fy + ry*px + cuy*py ]
        vz : f32 [ fz + rz*px + cuz*py ]
        vl : f32 [ sqrt[ vx*vx + vy*vy + vz*vz ] ]
        if [ vl < 0.0001 ] vl = 0.0001
        dx[0] = vx / vl
        dx[1] = vy / vl
        dx[2] = vz / vl

    func fit_pass []
        rd : rec_dir[]
        cap9 : i32 [ 4096 ]
        spans : new f32 [ cap9 ]
        noses : new f32 [ cap9 ]
        dists : new f32 [ cap9 ]
        gaps  : new f32 [ cap9 ]
        nfit : i32 [ 0 ]
        k : i32 [ 0 ]
        miss7 : i32 [ 0 ]
        while [ miss7 < 500 ]
            fp9 : path '{rd}/{k}.agi'
            if [ !fp9.exists[] ]
                k += 1
                miss7 += 1
                continue
            miss7 = 0
            fid : string '{k}'
            k += 1
            ok9 : bool [ true ]
            for [ c9: i32 0, c9 < 2, c9 += 1 ]
                for [ s9: i32 0, s9 < 3, s9 += 1 ]
                    if [ !ann_have[ fid, c9, s9 ] ] ok9 = false
            if [ !ok9 ] continue
            pw : local f32 [ 9 ]
            gq : f32 [ 0.0 ]
            for [ s9: i32 0, s9 < 3, s9 += 1 ]
                pt : rec_read[ fid, 0, s9 ]
                pb : rec_read[ fid, 1, s9 ]
                o1 : local f32 [ 3 ]
                d1 : local f32 [ 3 ]
                o2 : local f32 [ 3 ]
                d2 : local f32 [ 3 ]
                cam_ray[ 0, pt.x, pt.y, o1, d1 ]
                cam_ray[ 1, pb.x, pb.y, o2, d2 ]
                w0x : f32 [ o1[0] - o2[0] ]
                w0y : f32 [ o1[1] - o2[1] ]
                w0z : f32 [ o1[2] - o2[2] ]
                b9 : f32 [ d1[0]*d2[0] + d1[1]*d2[1] + d1[2]*d2[2] ]
                dd : f32 [ d1[0]*w0x + d1[1]*w0y + d1[2]*w0z ]
                ee : f32 [ d2[0]*w0x + d2[1]*w0y + d2[2]*w0z ]
                den : f32 [ 1.0 - b9 * b9 ]
                if [ den < 0.000001 ] den = 0.000001
                t1 : f32 [ (b9 * ee - dd) / den ]
                t2 : f32 [ (ee - b9 * dd) / den ]
                p1x : f32 [ o1[0] + d1[0]*t1 ]
                p1y : f32 [ o1[1] + d1[1]*t1 ]
                p1z : f32 [ o1[2] + d1[2]*t1 ]
                p2x : f32 [ o2[0] + d2[0]*t2 ]
                p2y : f32 [ o2[1] + d2[1]*t2 ]
                p2z : f32 [ o2[2] + d2[2]*t2 ]
                gxq : f32 [ p1x - p2x ]
                gyq : f32 [ p1y - p2y ]
                gzq : f32 [ p1z - p2z ]
                gq += sqrt[ gxq*gxq + gyq*gyq + gzq*gzq ]
                pw[ s9*3 + 0 ] = (p1x + p2x) * 0.5
                pw[ s9*3 + 1 ] = (p1y + p2y) * 0.5
                pw[ s9*3 + 2 ] = (p1z + p2z) * 0.5
            if [ nfit >= cap9 ] break
            sdx : f32 [ pw[0] - pw[3] ]
            sdy : f32 [ pw[1] - pw[4] ]
            sdz : f32 [ pw[2] - pw[5] ]
            spans[ nfit ] = sqrt[ sdx*sdx + sdy*sdy + sdz*sdz ] * 1000.0
            mx9 : f32 [ (pw[0] + pw[3]) * 0.5 ]
            my9 : f32 [ (pw[1] + pw[4]) * 0.5 ]
            mz9 : f32 [ (pw[2] + pw[5]) * 0.5 ]
            ndx : f32 [ pw[6] - mx9 ]
            ndy : f32 [ pw[7] - my9 ]
            ndz : f32 [ pw[8] - mz9 ]
            noses[ nfit ] = sqrt[ ndx*ndx + ndy*ndy + ndz*ndz ] * 1000.0
            dists[ nfit ] = sqrt[ mx9*mx9 + my9*my9 + mz9*mz9 ]
            gaps[ nfit ] = gq / 3.0 * 1000.0
            nfit += 1
        if [ nfit == 0 ]
            puts 'fit: no fully annotated pairs in {rd}'
            exit[ 1 ]
        # medians via insertion sort (counts are small)
        for [ a9: i32 0, a9 < 4, a9 += 1 ]
            arr : @f32 [ spans ]
            if [ a9 == 1 ] arr = noses
            if [ a9 == 2 ] arr = dists
            if [ a9 == 3 ] arr = gaps
            for [ i9: i32 1, i9 < nfit, i9 += 1 ]
                cv9 : f32 [ arr[ i9 ] ]
                j9 : i32 [ i9 ]
                while [ j9 > 0 ]
                    if [ arr[ j9 - 1 ] <= cv9 ] break
                    arr[ j9 ] = arr[ j9 - 1 ]
                    j9 -= 1
                arr[ j9 ] = cv9
        mid9 : i32 [ nfit / 2 ]
        fit_n = nfit
        fit_span = spans[ mid9 ]
        fit_nose = noses[ mid9 ]
        fit_seat = dists[ mid9 ]
        fit_gap = gaps[ mid9 ]

    # a camera is usable when its three anchor points carry real values.
    # hidden cameras read -999, which ann_have cannot distinguish from a
    # plotted point — it only knows the key exists
    func rec_cam_ok [ fid: string, c9: i32 ] -> bool
        for [ s9: i32 0, s9 < 3, s9 += 1 ]
            v9 : rec_read[ fid, c9, s9 ]
            if [ v9.x < -100.0 ] return false
        return true

    # which camera saw the face: 0 = tl only, 1 = tr only, 2 = both,
    # -1 = neither. carried into the sample as a signal to the network
    func rec_vis [ fid: string ] -> i32
        ok0 : bool [ rec_cam_ok[ fid, 0 ] ]
        ok1 : bool [ rec_cam_ok[ fid, 1 ] ]
        if [ ok0 && ok1 ] return 2
        if [ ok0 ] return 0
        if [ ok1 ] return 1
        return -1

    # neutral nose-drop ratio per camera. 0.55 was fitted to a single
    # top-centre camera; tl and tr sit 0.15m to either side with their own
    # tilt, so the same head reads as a different drop. measured from the
    # records, this stops tr-mono poses solving 40 degrees nose-down
    func calib_nose []
        if [ nose_k_done ] return
        nose_k_done = true
        for [ c9: i32 0, c9 < cam_n && c9 < 8, c9 += 1 ]
            acc9 : f32 [ 0.0 ]
            cnt9 : i32 [ 0 ]
            k9 : i32 [ 0 ]
            miss9 : i32 [ 0 ]
            while [ miss9 < 500 ]
                fid9 : string '{k9}'
                fp9 : path '{rec_dir[]}/{k9}.agi'
                if [ !fp9.exists[] ]
                    k9 += 1
                    miss9 += 1
                    continue
                miss9 = 0
                if [ rec_cam_ok[ fid9, c9 ] ]
                    l9 : rec_read[ fid9, c9, 0 ]
                    r9 : rec_read[ fid9, c9, 1 ]
                    n9 : rec_read[ fid9, c9, 2 ]
                    sxq : f32 [ l9.x - r9.x ]
                    syq : f32 [ l9.y - r9.y ]
                    spq : f32 [ sqrt[ sxq*sxq + syq*syq ] ]
                    if [ spq > 0.01 ]
                        myq : f32 [ (l9.y + r9.y) * 0.5 ]
                        acc9 += (n9.y - myq) / spq
                        cnt9 += 1
                k9 += 1
            nose_k[ c9 ] = (cnt9 > 0) ? acc9 / f32[ cnt9 ] : 0.55
            puts 'calib: {cam_role[ c9 ]} nose drop {nose_k[ c9 ]} from {cnt9} records'

    func rec_solve [ fid: string, out9: @f32 ] -> bool
        vis9 : i32 [ rec_vis[ fid ] ]
        if [ vis9 < 0 ] return false
        if [ vis9 < 2 ]
            # one camera has the shot — solve from that one, whichever it is
            l5 : rec_read[ fid, vis9, 0 ]
            r5 : rec_read[ fid, vis9, 1 ]
            n5 : rec_read[ fid, vis9, 2 ]
            mx5 : f32 [ (l5.x + r5.x) * 0.5 ]
            my5 : f32 [ (l5.y + r5.y) * 0.5 ]
            sx5 : f32 [ l5.x - r5.x ]
            sy5 : f32 [ l5.y - r5.y ]
            sp5 : f32 [ sqrt[ sx5*sx5 + sy5*sy5 ] ]
            if [ sp5 < 0.01 ] return false
            # one camera: yaw from nose asymmetry, pitch from nose drop,
            # roll from the corner line. mean bias is removed downstream
            ya5 : f32 [ 2.0 * (n5.x - mx5) / sp5 ]
            if [ ya5 > 1.0 ] ya5 = 1.0
            if [ ya5 < -1.0 ] ya5 = -1.0
            out9[0] = asin[ ya5 ] * 0.7
            pa5 : f32 [ ((n5.y - my5) / sp5 - nose_k[ vis9 ]) * 1.4 ]
            if [ pa5 > 1.0 ] pa5 = 1.0
            if [ pa5 < -1.0 ] pa5 = -1.0
            out9[1] = asin[ pa5 ]
            rr5 : f32 [ atan2[ sy5, sx5 ] ]
            if [ rr5 > 1.5707963 ] rr5 = rr5 - 3.1415926
            if [ rr5 < -1.5707963 ] rr5 = rr5 + 3.1415926
            out9[2] = rr5
            out9[3] = mx5
            out9[4] = my5
            out9[5] = sp5
            out9[6] = mx5
            out9[7] = my5
            out9[8] = sp5
            # one camera cannot fix a point in space, only a ray
            out9[9]  = -999.0
            out9[10] = -999.0
            out9[11] = -999.0
            return true
        pw : local f32 [ 9 ]
        for [ s9: i32 0, s9 < 3, s9 += 1 ]
            pt : rec_read[ fid, 0, s9 ]
            pb : rec_read[ fid, 1, s9 ]
            o1 : local f32 [ 3 ]
            d1 : local f32 [ 3 ]
            o2 : local f32 [ 3 ]
            d2 : local f32 [ 3 ]
            cam_ray[ 0, pt.x, pt.y, o1, d1 ]
            cam_ray[ 1, pb.x, pb.y, o2, d2 ]
            w0x : f32 [ o1[0] - o2[0] ]
            w0y : f32 [ o1[1] - o2[1] ]
            w0z : f32 [ o1[2] - o2[2] ]
            b9 : f32 [ d1[0]*d2[0] + d1[1]*d2[1] + d1[2]*d2[2] ]
            dd : f32 [ d1[0]*w0x + d1[1]*w0y + d1[2]*w0z ]
            ee : f32 [ d2[0]*w0x + d2[1]*w0y + d2[2]*w0z ]
            den : f32 [ 1.0 - b9 * b9 ]
            if [ den < 0.000001 ] den = 0.000001
            t1 : f32 [ (b9 * ee - dd) / den ]
            t2 : f32 [ (ee - b9 * dd) / den ]
            pw[ s9*3 + 0 ] = (o1[0] + d1[0]*t1 + o2[0] + d2[0]*t2) * 0.5
            pw[ s9*3 + 1 ] = (o1[1] + d1[1]*t1 + o2[1] + d2[1]*t2) * 0.5
            pw[ s9*3 + 2 ] = (o1[2] + d1[2]*t1 + o2[2] + d2[2]*t2) * 0.5
        xax : local f32 [ 3 ]
        xax[0] = 0.0 - (pw[0] - pw[3])
        xax[1] = pw[1] - pw[4]
        xax[2] = 0.0 - (pw[2] - pw[5])
        xl : f32 [ sqrt[ xax[0]*xax[0] + xax[1]*xax[1] + xax[2]*xax[2] ] ]
        if [ xl < 0.0001 ] return false
        xax[0] = xax[0] / xl
        xax[1] = xax[1] / xl
        xax[2] = xax[2] / xl
        # up-ish: eye midpoint minus subnasale, mapped to gen frame
        upx : f32 [ 0.0 - ((pw[0] + pw[3]) * 0.5 - pw[6]) ]
        upy : f32 [ (pw[1] + pw[4]) * 0.5 - pw[7] ]
        upz : f32 [ 0.0 - ((pw[2] + pw[5]) * 0.5 - pw[8]) ]
        zx : f32 [ upy*xax[2] - upz*xax[1] ]
        zy : f32 [ upz*xax[0] - upx*xax[2] ]
        zz : f32 [ upx*xax[1] - upy*xax[0] ]
        zl : f32 [ sqrt[ zx*zx + zy*zy + zz*zz ] ]
        if [ zl < 0.0001 ] return false
        zx = zx / zl
        zy = zy / zl
        zz = zz / zl
        if [ zz < 0.0 ]
            zx = 0.0 - zx
            zy = 0.0 - zy
            zz = 0.0 - zz
        yx : f32 [ zy*xax[2] - zz*xax[1] ]
        yy : f32 [ zz*xax[0] - zx*xax[2] ]
        yz : f32 [ zx*xax[1] - zy*xax[0] ]
        hy9 : f32 [ atan2[ zx, zz ] ]
        sp9 : f32 [ 0.0 - zy ]
        if [ sp9 > 1.0 ] sp9 = 1.0
        if [ sp9 < -1.0 ] sp9 = -1.0
        hp9 : f32 [ asin[ sp9 ] ]
        cy9 : f32 [ cos[ hy9 ] ]
        sy9 : f32 [ sin[ hy9 ] ]
        cp9 : f32 [ cos[ hp9 ] ]
        sp10 : f32 [ sin[ hp9 ] ]
        # R_yp x-hat and y-hat columns (Ry*Rx applied to unit axes)
        ax1 : f32 [ cy9 ]
        ay1 : f32 [ 0.0 ]
        az1 : f32 [ 0.0 - sy9 ]
        bx1 : f32 [ sy9 * sp10 ]
        by1 : f32 [ cp9 ]
        bz1 : f32 [ cy9 * sp10 ]
        hr9 : f32 [ atan2[ yx*ax1 + yy*ay1 + yz*az1, yx*bx1 + yy*by1 + yz*bz1 ] ]
        out9[0] = hy9
        out9[1] = hp9
        out9[2] = hr9
        for [ c9: i32 0, c9 < 2, c9 += 1 ]
            l2 : rec_read[ fid, c9, 0 ]
            r2 : rec_read[ fid, c9, 1 ]
            sx2 : f32 [ l2.x - r2.x ]
            sy2 : f32 [ l2.y - r2.y ]
            out9[ 3 + c9*3 + 0 ] = (l2.x + r2.x) * 0.5
            out9[ 3 + c9*3 + 1 ] = (l2.y + r2.y) * 0.5
            out9[ 3 + c9*3 + 2 ] = sqrt[ sx2*sx2 + sy2*sy2 ]
        # eye midpoint in space, mapped to the gen frame like xax
        out9[9]  = 0.0 - (pw[0] + pw[3]) * 0.5
        out9[10] = (pw[1] + pw[4]) * 0.5
        out9[11] = 0.0 - (pw[2] + pw[5]) * 0.5
        return true

    # load every solvable record for generation
    func load_recs []
        calib_nose[]
        rd : rec_dir[]
        recs_dat = new f32 [ 4096 * 9 ]
        recs_pos = new f32 [ 4096 * 3 ]
        recs_fid = new i32 [ 4096 ]
        recs_look = new f32 [ 8192 ]
        recs_head = new f32 [ 8192 ]
        tmp_dat : new f32 [ 36864 ]
        tmp_pos : new f32 [ 12288 ]
        tmp_fid : new i32 [ 4096 ]
        tmp_look : new f32 [ 8192 ]
        tmp_head : new f32 [ 8192 ]
        recs_noise = new i32 [ 512 ]
        recs_noise_n = 0
        hair_pat = new u8 [ 262144 ]
        hair_n = 0
        tn : i32 [ 0 ]
        k : i32 [ 0 ]
        miss7 : i32 [ 0 ]
        while [ miss7 < 500 ]
            fp9 : path '{rd}/{k}.agi'
            if [ !fp9.exists[] ]
                k += 1
                miss7 += 1
                continue
            miss7 = 0
            fid : string '{k}'
            k += 1
            if [ tn >= 4096 ] break
            # noise pairs (no face) become composite background patches
            ns9 : cast string [ fp9.load[ typeid[ string ], null ] ]
            if [ ns9 && ns9.index_of[ 'noise: true' ] >= 0 ]
                if [ recs_noise_n < 512 ]
                    recs_noise[ recs_noise_n ] = k - 1
                    recs_noise_n += 1
                continue
            for [ hc9: i32 0, hc9 < 2, hc9 += 1 ]
                if [ hair_n >= 256 ] break
                hv9 : rec_read[ fid, hc9, 7 ]
                if [ hv9.x < -100.0 ] continue
                hnm : cam_role[ hc9 ]
                him : Image [ uri: path '{rd}/{k - 1}-{hnm}.png' ]
                if [ him.width <= 0 ] continue
                hp8 : @u8 [ him.pixels ]
                hnc : i32 [ him.channels ]
                hs9 : f32 [ f32[ him.width ] * 0.16 ]
                hx9 : f32 [ hv9.x * f32[ him.width ] ]
                hy9 : f32 [ hv9.y * f32[ him.height ] ]
                for [ py9: i32 0, py9 < 32, py9 += 1 ]
                    sy9 : i32 [ i32[ hy9 + (f32[ py9 ] / 31.0 - 0.5) * hs9 ] ]
                    if [ sy9 < 0 ] sy9 = 0
                    if [ sy9 > him.height - 1 ] sy9 = him.height - 1
                    for [ px9: i32 0, px9 < 32, px9 += 1 ]
                        sx9 : i32 [ i32[ hx9 + (f32[ px9 ] / 31.0 - 0.5) * hs9 ] ]
                        if [ sx9 < 0 ] sx9 = 0
                        if [ sx9 > him.width - 1 ] sx9 = him.width - 1
                        ho9 : i64 [ (i64[ sy9 ] * i64[ him.width ] + i64[ sx9 ]) * i64[ hnc ] ]
                        hd9 : i64 [ i64[ hair_n ] * 1024 + i64[ py9 ] * 32 + i64[ px9 ] ]
                        hair_pat[ hd9 ] = hp8[ ho9 ]
                hair_n += 1
            o9 : local f32 [ 12 ]
            if [ !rec_solve[ fid, o9 ] ] continue
            for [ q9: i32 0, q9 < 9, q9 += 1 ]
                tmp_dat[ tn * 9 + q9 ] = o9[ q9 ]
            for [ q8: i32 0, q8 < 3, q8 += 1 ]
                tmp_pos[ tn * 3 + q8 ] = o9[ 9 + q8 ]
            lk9 : rec_read[ fid, 0, 8 ]
            tmp_look[ tn * 2 + 0 ] = lk9.x
            tmp_look[ tn * 2 + 1 ] = lk9.y
            hd9 : rec_read[ fid, 0, 9 ]
            tmp_head[ tn * 2 + 0 ] = hd9.x
            tmp_head[ tn * 2 + 1 ] = hd9.y
            tmp_fid[ tn ] = k - 1
            tn += 1
        recs_n = 0
        if [ tn == 0 ]
            puts 'records: 0 fitted poses loaded for generation'
            return
        sya : new f32 [ tn ]
        spa : new f32 [ tn ]
        for [ i6: i32 0, i6 < tn, i6 += 1 ]
            sya[ i6 ] = tmp_dat[ i6 * 9 + 0 ]
            spa[ i6 ] = tmp_dat[ i6 * 9 + 1 ]
        for [ i6: i32 1, i6 < tn, i6 += 1 ]
            for [ j6: i32 i6, j6 > 0, j6 -= 1 ]
                if [ sya[ j6 ] < sya[ j6 - 1 ] ]
                    ty6 : f32 [ sya[ j6 ] ]
                    sya[ j6 ] = sya[ j6 - 1 ]
                    sya[ j6 - 1 ] = ty6
                if [ spa[ j6 ] < spa[ j6 - 1 ] ]
                    tp6 : f32 [ spa[ j6 ] ]
                    spa[ j6 ] = spa[ j6 - 1 ]
                    spa[ j6 - 1 ] = tp6
        my6 : f32 [ sya[ tn / 2 ] ]
        mp6 : f32 [ spa[ tn / 2 ] ]
        for [ i6: i32 0, i6 < tn, i6 += 1 ]
            dy9 : f32 [ (tmp_dat[ i6 * 9 + 0 ] - my6) * 57.29578 ]
            dp9 : f32 [ (tmp_dat[ i6 * 9 + 1 ] - mp6) * 57.29578 ]
            dr9 : f32 [ tmp_dat[ i6 * 9 + 2 ] * 57.29578 ]
            bad9 : bool [ false ]
            if [ dy9 > 60.0 || dy9 < -60.0 ] bad9 = true
            if [ dp9 > 40.0 || dp9 < -40.0 ] bad9 = true
            if [ dr9 > 40.0 || dr9 < -40.0 ] bad9 = true
            fid6 : i32 [ tmp_fid[ i6 ] ]
            if [ bad9 ]
                puts 'rec {fid6}: REJECTED yaw={dy9} pitch={dp9} roll={dr9}'
                continue
            recs_dat[ recs_n * 9 + 0 ] = dy9 / 57.29578
            recs_dat[ recs_n * 9 + 1 ] = dp9 / 57.29578
            for [ q9: i32 2, q9 < 9, q9 += 1 ]
                recs_dat[ recs_n * 9 + q9 ] = tmp_dat[ i6 * 9 + q9 ]
            for [ q8: i32 0, q8 < 3, q8 += 1 ]
                recs_pos[ recs_n * 3 + q8 ] = tmp_pos[ i6 * 3 + q8 ]
            recs_look[ recs_n * 2 + 0 ] = tmp_look[ i6 * 2 + 0 ]
            recs_look[ recs_n * 2 + 1 ] = tmp_look[ i6 * 2 + 1 ]
            recs_head[ recs_n * 2 + 0 ] = tmp_head[ i6 * 2 + 0 ]
            recs_head[ recs_n * 2 + 1 ] = tmp_head[ i6 * 2 + 1 ]
            recs_fid[ recs_n ] = fid6
            recs_n += 1
        mydeg : f32 [ my6 * 57.29578 ]
        mpdeg : f32 [ mp6 * 57.29578 ]
        puts 'records: {recs_n} of {tn} poses usable, {recs_noise_n} noise frames, {hair_n} hair patches (bias removed: yaw={mydeg} pitch={mpdeg})'
        np9 : i32 [ 0 ]
        for [ i9: i32 0, i9 < recs_n, i9 += 1 ]
            if [ recs_pos[ i9 * 3 ] > -900.0 ] np9 += 1
        puts 'records: {np9} of {recs_n} fix the head in space (both cameras annotated)'

    func run_fit []
        if [ span_known > 0.0 ]
            lo9 : f32 [ 15.0 ]
            hi9 : f32 [ 80.0 ]
            for [ b9: i32 0, b9 < 24, b9 += 1 ]
                rec_fov = (lo9 + hi9) * 0.5
                fit_pass[]
                if [ fit_span < span_known ]
                    lo9 = rec_fov
                el
                    hi9 = rec_fov
        fit_pass[]
        puts 'fit: {fit_n} pairs  fov={rec_fov}  span={fit_span}mm  nose={fit_nose}mm  seat={fit_seat}m  ray-gap={fit_gap}mm'
        fs : string 'fit:\n    count: {fit_n}\n    rec_fov: {rec_fov}\n    span_mm: {fit_span}\n    nose_mm: {fit_nose}\n    seat_m: {fit_seat}\n    ray_gap_mm: {fit_gap}\n'
        fo : path '/src/hyperspace-sessions/{session}/fit.agi'
        fo.save[ fs, null ]
        puts 'fit -> /src/hyperspace-sessions/{session}/fit.agi'
        exit[ 0 ]

    public func on_click [ ev: Event ]
        # batch generation is non-interactive: stray input on the gen
        # window must never switch modes (cameras would open and trap)
        if [ gen > 0 ] return
        if [ rec_mode == 'record' ]
            rec_mode = ''
            ux.set_fullscreen[ false ]
            puts 'record: stopped at {rec_i} pairs'
            ev.stop[]
            return
        if [ rec_mode == 'bench' ]
            rec_mode = ''
            ux.set_fullscreen[ false ]
            puts 'benchmark: stopped at {bench_i} pairs'
            ev.stop[]
            return
        if [ rec_mode == 'annotate' ]
            if [ ann_tex && ann_rect.w > 0.0 ]
                now2 : i64 [ epoch_millis[] ]
                if [ now2 - ann_last >= 250 ]
                    ann_last = now2
                    nx : f32 [ (ev.mouse.pos.x - ann_rect.x) / ann_rect.w ]
                    ny : f32 [ (ev.mouse.pos.y - ann_rect.y) / ann_rect.h ]
                    cam : cam_role[ ann_cam ]
                    key : string '{cam}_left_oc'
                    if [ ann_sub == 1 ] key = string '{cam}_right_oc'
                    if [ ann_sub == 2 ] key = string '{cam}_nose_base'
                    if [ ann_sub == 3 ] key = string '{cam}_left_pupil'
                    if [ ann_sub == 4 ] key = string '{cam}_right_pupil'
                    if [ ann_sub == 5 ] key = string '{cam}_left_ic'
                    if [ ann_sub == 6 ] key = string '{cam}_right_ic'
                    fidn : i32 [ i32[ atof[ ann_files[ ann_i ].chars ] ] ]
                    agi_put2[ fidn, key, string '{nx} {ny}' ]
                    ann_refresh_marks[]
                    ann_ext = ev.key.shift
                    ann_seek[ true ]
            ev.stop[]
            return
        oe : cast element [ ev.origin ]
        if [ !oe ] return
        if [ oe.id == 'record' ]
            rec_fast = false
            start_record[ false ]
            ev.stop[]
        el [ oe.id == 'record2' ]
            rec_fast = true
            start_record[ false ]
            ev.stop[]
        el [ oe.id == 'noise' ]
            start_record[ true ]
            ev.stop[]
        el [ oe.id == 'plot-oc' ]
            start_annotate[]
            ev.stop[]
        el [ oe.id == 'testbed' ]
            start_test[]
            ev.stop[]
        el [ oe.id == 'bench' ]
            start_bench[]
            ev.stop[]

    public func on_overlay [ cv: Canvas ]
        sw : f32 [ f32[ ux.width ] ]
        sh : f32 [ f32[ ux.height ] ]
        # screen-center reference: solid fill, half bright — the pixel
        # grid resolving inside it is the user's own distance judge
        cv.arc[ sw * 0.5, sh * 0.5, 5.0, 0.0, 6.2831853 ]
        cv.fill_color[ '#888' ]
        cv.stroke_width[ 0.0 ]
        cv.paint[]
        if [ rec_mode == 'record' && !rec_noise ]
            cv.sync_fence[]
            nowA : i64 [ epoch_millis[] ]
            if [ au_phase == 1 && nowA - au_b0 >= 4000 ]
                # burst over: the circle jumps to its next spot;
                # reposition the head, SPACE runs the next burst
                au_phase = 0
                au_hx = 0.15 + rec_frand[] * 0.7
                au_hy = 0.15 + rec_frand[] * 0.7
                au_dx = au_hx
                au_dy = au_hy
                au_tx = au_hx
                au_ty = au_hy
            if [ au_phase == 1 ]
                # form 1: head focus STATIC, the dot glides around
                # it. form 2: gaze locked with head — the circle
                # itself leaps and the dot rides its center
                uA : f32 [ f32[ nowA - au_t0 ] * 0.001 / au_T ]
                if [ uA >= 1.0 ]
                    au_dx = au_tx
                    au_dy = au_ty
                    if [ au_dwell == 0 ] au_dwell = nowA
                    if [ nowA - au_dwell >= ((rec_fast) ? 150 : 200) ]
                        if [ rec_fast ] au_next_fast[]
                        el              au_next_dot[]
                el
                    sA : f32 [ uA * uA * (3.0 - 2.0 * uA) ]
                    au_dx = au_sx + (au_tx - au_sx) * sA
                    au_dy = au_sy + (au_ty - au_sy) * sA
                if [ rec_fast ]
                    au_hx = au_dx
                    au_hy = au_dy
                if [ nowA - au_cap >= 250 ]
                    au_cap = nowA
                    rec_capture[]
            cv.sync_fence[]
            cxA : f32 [ au_hx * sw ]
            cyA : f32 [ au_hy * sh ]
            cv.arc[ cxA, cyA, 48.0, 0.0, 6.2831853 ]
            cv.fill_color[ '#0000' ]
            cv.stroke_color[ (au_phase == 0) ? '#ff0' : '#fff' ]
            cv.stroke_width[ 2.0 ]
            cv.paint[]
            cv.sync_fence[]
            dxA : f32 [ au_dx * sw ]
            dyA : f32 [ au_dy * sh ]
            cv.arc[ dxA, dyA, 1.5, 0.0, 6.2831853 ]
            cv.fill_color[ '#fff' ]
            cv.stroke_width[ 0.0 ]
            cv.paint[]
            return
        if [ test && rec_mode != 'test' ]
            test_wait += 1
            if [ test_wait > 90 ] start_test[]
        if [ benchmark && rec_mode != 'bench' ]
            test_wait += 1
            if [ test_wait > 90 ] start_bench[]
        if [ rec_mode == 'test' ]
            if [ !ts_look ] return
            test_settle += 1
            if [ test_settle < 5 ] return
            if [ !tb_pv ]
                tb_pv = array Texture [ ]
                tb_pv.hold[]
                for [ p9: i32 0, p9 < 6, p9 += 1 ]
                    tp9 : Texture [ vk: cv.vk, w: ux, width: 32, height: 32, linear: true ]
                    tb_pv += tp9
            n7 : i32 [ 0 ]
            for [ c7: i32 0, c7 < 2, c7 += 1 ]
                v7 : cam_view[ c7 ]
                if [ !v7 ] continue
                if [ !v7.camera ] continue
                gr7 : v7.frame_image[]
                if [ !gr7 ] continue
                if [ tb_cam2[ c7, gr7 ] ] n7 += 1
            if [ n7 == 2 && ts_off && ts_look ]
                ax7 : tensor [ tensor_shape: 1x36 ]
                for [ q7: i32 0, q7 < 36, q7 += 1 ]
                    ax7.floats[ q7 ] = tb_a36[ q7 ]
                o5 : tensor [ tensor_shape: 1x7 ]
                ts_off.forward2i[ tb_f0, tb_f1, ax7, o5, 32, 36 ]
                ox5 : f32 [ o5.floats[0] ]
                oy5 : f32 [ o5.floats[1] ]
                oz5 : f32 [ o5.floats[2] ]
                if [ !tb_ohave ]
                    tb_ox = ox5
                    tb_oy = oy5
                    tb_oz = oz5
                    tb_ohave = true
                el
                    tb_ox = tb_ox * 0.7 + ox5 * 0.3
                    tb_oy = tb_oy * 0.7 + oy5 * 0.3
                    tb_oz = tb_oz * 0.7 + oz5 * 0.3
                ax9 : tensor [ tensor_shape: 1x39 ]
                for [ q6: i32 0, q6 < 36, q6 += 1 ]
                    ax9.floats[ q6 ] = tb_a36[ q6 ]
                ax9.floats[36] = ox5
                ax9.floats[37] = oy5
                ax9.floats[38] = oz5
                o6 : tensor [ tensor_shape: 1x4 ]
                ts_look.forward6i[ tb_l0, tb_r0, tb_f0, tb_l1, tb_r1, tb_f1, ax9, o6, 32, 39 ]
                h7x : f32 [ o6.floats[0] ]
                h7y : f32 [ o6.floats[1] ]
                g7x : f32 [ o6.floats[2] ]
                g7y : f32 [ o6.floats[3] ]
                if [ !tb_have ]
                    tb_gx = g7x
                    tb_gy = g7y
                    tb_hx = h7x
                    tb_hy = h7y
                    tb_have = true
                el
                    tb_gx = tb_gx * 0.7 + g7x * 0.3
                    tb_gy = tb_gy * 0.7 + g7y * 0.3
                    tb_hx = tb_hx * 0.7 + h7x * 0.3
                    tb_hy = tb_hy * 0.7 + h7y * 0.3
            if [ tb_have ]
                gpx : f32 [ (tb_gx + 0.5) * sw ]
                gpy : f32 [ (tb_gy + 0.5) * sh ]
                hpx : f32 [ (tb_hx + 0.5) * sw ]
                hpy : f32 [ (tb_hy + 0.5) * sh ]
                cv.arc[ gpx, gpy, 16.0, 0.0, 6.2831853 ]
                cv.fill_color[ '#0000' ]
                cv.stroke_color[ '#0f8' ]
                cv.stroke_width[ 3.0 ]
                cv.paint[]
                cv.arc[ gpx, gpy, 3.0, 0.0, 6.2831853 ]
                cv.fill_color[ '#0f8' ]
                cv.stroke_width[ 0.0 ]
                cv.paint[]
                cv.arc[ hpx, hpy, 11.0, 0.0, 6.2831853 ]
                cv.fill_color[ '#0000' ]
                cv.stroke_color[ '#f80' ]
                cv.stroke_width[ 2.0 ]
                cv.paint[]
            if [ tb_ohave ]
                od5 : f32 [ sqrt[ tb_ox*tb_ox + tb_oy*tb_oy + tb_oz*tb_oz ] ]
                cv.sync_fence[]
                cv.fill_color[ '#9ab' ]
                cv.draw_text[ 'eyes off screen center ({tb_ox}, {tb_oy}, {tb_oz})m  dist {od5}m',
                    rect [ x: sw * 0.5 - 300.0, y: sh - 40.0, w: 600.0, h: 20.0 ],
                    vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
                cv.paint[]
            for [ c8: i32 0, c8 < 2, c8 += 1 ]
                # member ternary yields the slot, not the value: assign
                ve : cam_view[ c8 ]
                if [ !ve ] continue
                if [ ve.bounds.w <= 0.0 ] continue
                vbx : f32 [ ve.bounds.x ]
                vby : f32 [ ve.bounds.y ]
                vbw : f32 [ ve.bounds.w ]
                vbh : f32 [ ve.bounds.h ]
                for [ e8: i32 0, e8 < 2, e8 += 1 ]
                    b8 : i32 [ (c8 * 2 + e8) * 3 ]
                    ex8 : f32 [ tb_ex[ b8 + 0 ] ]
                    ey8 : f32 [ tb_ex[ b8 + 1 ] ]
                    es8 : f32 [ tb_ex[ b8 + 2 ] ]
                    cv.rect_to[ vbx + (ex8 - es8 * 0.5) * vbw, vby + (ey8 - es8 * 0.5) * vbh, es8 * vbw, es8 * vbh ]
                    cv.fill_color[ '#0000' ]
                    cv.stroke_color[ '#ff0' ]
                    cv.stroke_width[ 2.0 ]
                    cv.paint[]
                    b9 : i32 [ (c8 * 2 + e8) * 2 ]
                    cv.arc[ vbx + tb_oc[ b9 + 0 ] * vbw, vby + tb_oc[ b9 + 1 ] * vbh, 3.0, 0.0, 6.2831853 ]
                    cv.fill_color[ '#f80' ]
                    cv.stroke_width[ 0.0 ]
                    cv.paint[]
                # face crop box (cyan) — the region look actually reads
                fbx : f32 [ tb_fb[ c8 * 3 + 0 ] ]
                fby : f32 [ tb_fb[ c8 * 3 + 1 ] ]
                fbs : f32 [ tb_fb[ c8 * 3 + 2 ] ]
                if [ fbs > 0.0 ]
                    cv.rect_to[ vbx + (fbx - fbs * 0.5) * vbw, vby + (fby - fbs * 0.5) * vbh, fbs * vbw, fbs * vbh ]
                    cv.fill_color[ '#0000' ]
                    cv.stroke_color[ '#0cf' ]
                    cv.stroke_width[ 2.0 ]
                    cv.paint[]
                # the EXACT 32px inputs look consumed: left, right, face
                if [ tb_pv && tb_pv.count >= 6 ]
                    ps8 : f32 [ vbw * 0.3 ]
                    for [ p8: i32 0, p8 < 3, p8 += 1 ]
                        cv.draw_image[ tb_pv[ c8 * 3 + p8 ],
                            rect [ x: vbx + f32[ p8 ] * (ps8 + 4.0), y: vby - ps8 - 6.0, w: ps8, h: ps8 ] ]
                    cv.paint[]
            if [ tb_have ]
                cv.sync_fence[]
                cv.fill_color[ '#9ab' ]
                cv.draw_text[ 'head ({tb_hx}, {tb_hy})  gaze ({tb_gx}, {tb_gy})',
                    rect [ x: sw * 0.5 - 300.0, y: sh - 64.0, w: 600.0, h: 20.0 ],
                    vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
                cv.paint[]
            return
        if [ rec_mode == 'bench' ]
            now8 : i64 [ epoch_millis[] ]
            tsec : f32 [ f32[ now8 - bench_t0 ] / 1000.0 ]
            th8 : f32 [ tsec * 1.1 ]
            rr8 : f32 [ 0.5 - 0.5 * cos[ tsec * 0.1396 ] ]
            bench_u = 0.47 * rr8 * cos[ th8 ]
            bench_v = 0.47 * rr8 * sin[ th8 ]
            mpx : f32 [ (bench_u + 0.5) * sw ]
            mpy : f32 [ (bench_v + 0.5) * sh ]
            hpx8 : f32 [ (head_u + 0.5) * sw ]
            hpy8 : f32 [ (head_v + 0.5) * sh ]
            cv.rounded_rect[ hpx8 - 64.0, hpy8 - 64.0, 128.0, 128.0, 64.0, 64.0, 64.0, 64.0 ]
            cv.fill_color[ '#0000' ]
            cv.stroke_color[ '#08f' ]
            cv.stroke_width[ 2.0 ]
            cv.paint[]
            cv.move_to[ mpx - 8.0, mpy ]
            cv.line_to[ mpx + 8.0, mpy ]
            cv.move_to[ mpx, mpy - 8.0 ]
            cv.line_to[ mpx, mpy + 8.0 ]
            cv.fill_color[ '#0000' ]
            cv.stroke_color[ '#0f8' ]
            cv.stroke_width[ 2.0 ]
            cv.paint[]
            if [ now8 >= bench_at && now8 - bench_last >= 600 ]
                bench_last = now8
                bd : bench_dir[]
                q0 : cam_role[ 0 ]
                q1 : cam_role[ 1 ]
                tp : path '{bd}/{bench_i}-{q0}.png'
                bp : path '{bd}/{bench_i}-{q1}.png'
                b0 : cam_view[ 0 ]
                b1 : cam_view[ 1 ]
                okt : bool [ (b0) ? b0.save_frame[ tp ] : false ]
                okb : bool [ (b1) ? b1.save_frame[ bp ] : false ]
                s : string 'images:\n    {q0}: {bench_i}-{q0}.png\n    {q1}: {bench_i}-{q1}.png\ncameras: {cam_n}\nlook: {bench_u} {bench_v}\nhead: {head_u} {head_v}\nhead_in: {head_in}\n'
                ag : path '{bd}/{bench_i}.agi'
                ag.save[ s, null ]
                if [ bench_i % 10 == 0 ] puts 'benchmark: {bench_i} pairs ({q0}={okt} {q1}={okb})'
                bench_i += 1
            return

    public func on_canvas [ cv: Canvas ]
        sw : f32 [ f32[ ux.width ] ]
        sh : f32 [ f32[ ux.height ] ]
        if [ rec_mode == 'record' ]
            c0v : cam_view[ 0 ]
            c1v : cam_view[ 1 ]
            if [ rec_i % 50 == 0 && c0v && c0v.camera && c1v && c1v.camera ]
                puts 'rec cams: {cam_role[ 0 ]} dev={c0v.camera.device} {cam_role[ 1 ]} dev={c1v.camera.device}'
            now3 : i64 [ epoch_millis[] ]
            if [ rec_noise && now3 - rec_last >= 600 ]
                rec_last = now3
                rd : rec_dir[]
                w0 : cam_role[ 0 ]
                w1 : cam_role[ 1 ]
                tp : path '{rd}/{rec_i}-{w0}.png'
                bp : path '{rd}/{rec_i}-{w1}.png'
                okt : bool [ (c0v) ? c0v.save_frame[ tp ] : false ]
                okb : bool [ (c1v) ? c1v.save_frame[ bp ] : false ]
                # list only the cameras we actually have
                s : string 'images:\n    {w0}: {rec_i}-{w0}.png\n'
                if [ cam_n > 1 ] s = string '{s}    {w1}: {rec_i}-{w1}.png\n'
                s = string '{s}cameras: {cam_n}\n'
                if [ rec_noise ] s = string '{s}noise: true\n'
                ag : path '{rd}/{rec_i}.agi'
                ag.save[ s, null ]
                if [ rec_i % 10 == 0 ] puts 'record: {rec_i} pairs ({w0}={okt} {w1}={okb})'
                rec_i += 1
            return
        if [ rec_mode == 'annotate' ]
            if [ ann_img && !ann_tex ]
                ann_tex = Texture [ vk: cv.vk, w: ux, linear: true, mip_levels: 1, sampler: ann_img ]
                ann_tex.hold[]
            if [ !ann_tex ] return
            side : f32 [ (sw < sh) ? sw : sh ]
            ann_rect = rect [ x: (sw - side) * 0.5, y: (sh - side) * 0.5, w: side, h: side ]
            cv.draw_image[ ann_tex, ann_rect ]
            # instruction line: what to plot, which camera, which pair
            fid0 : ann_files[ ann_i ]
            cam0 : cam_role[ ann_cam ]
            lbl0 : string 'left oc'
            if [ ann_sub == 1 ] lbl0 = string 'right oc'
            if [ ann_sub == 2 ] lbl0 = string 'nose base'
            if [ ann_sub == 3 ] lbl0 = string 'left pupil'
            if [ ann_sub == 4 ] lbl0 = string 'right pupil'
            if [ ann_sub == 5 ] lbl0 = string 'left ic'
            if [ ann_sub == 6 ] lbl0 = string 'right ic'
            cv.sync_fence[]
            cv.fill_color[ '#9ab' ]
            cv.draw_text[ 'plot {lbl0}  {cam0}  #{fid0}  ({ann_i + 1}/{ann_files.count})  x = hidden (any eye covered)  n = noise',
                rect [ x: 16.0, y: 12.0, w: sw - 32.0, h: 28.0 ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
            cv.paint[]
            ann_mark[ cv, ann_m0, '#f80' ]
            ann_mark[ cv, ann_m1, '#08f' ]
            ann_mark[ cv, ann_m2, '#ff0' ]
            ann_mark[ cv, ann_m3, '#c0f' ]
            ann_mark[ cv, ann_m4, '#0fc' ]
            ann_mark[ cv, ann_m5, '#f4a' ]
            ann_mark[ cv, ann_m6, '#0dd' ]
            ann_mark[ cv, ann_m7, '#4c4' ]
    public  screen_w  : f32 [ 0.708 ]          # LCD width, meters
    public  screen_h  : f32 [ 0.398 ]          # LCD height, meters
    public  face_dist : f32 [ 0.55 ]           # camera to face, meters
    public  dist_min  : f32 [ 0.2032 ]         # nearest seat the face still fits (8in)
    public  dist_max  : f32 [ 0.635 ]          # farthest seat distance (25in)
    public  check_obj : bool                   # write 3D confirm .obj, first 4
    public  dump_iris : bool                   # dump 1024 iris variants as pngs
    public  move_x    : f32 [ 0.08 ]           # max lateral shift, meters
    public  move_y    : f32 [ 0.05 ]           # max vertical shift, meters
    public  rot_yaw   : f32 [ 0.35 ]           # turn left/right (~20 deg)
    public  rot_pitch : f32 [ 0.2 ]            # nod up/down (~11 deg)
    public  rot_roll  : f32 [ 0.12 ]           # tilt (~7 deg)
    public  plot_extent : f32 [ 0.5 ]
    public  side_verify : bool                 # proof camera beside the face
    public  free_gaze : bool                   # test: no mechanical range gates
    public  eyes_down : f32 [ 1.0 ]            # eyes-down morph percentage
    public  plot_fx : f32 [ -999.0 ]
    public  plot_fy : f32 [ -999.0 ]
    public  cap_w      : i32 [ 2048 ]
    public  cap_h      : i32 [ 2048 ]
    public  hidden     : bool
    public  gen        : i32
    public  looks      : i32 [ 10 ]
    public  test       : bool
    # tape-measured screen-center-to-face distance for this recording
    # session, meters; 0 = untagged. 12in station = 0.3048
    public  true_dist  : f32
    mutable ts_target  : ts_model
    mutable ts_refine  : ts_model
    mutable ts_look    : ts_model
    mutable tb_ex      : @f32               # 2 cams x 2 eyes x (x,y,side)
    mutable tb_oc      : @f32               # 2 cams x 2 eyes x (ocx,ocy)
    mutable tb_ok      : @f32               # per-cam cascade success
    mutable tb_gx      : f32
    mutable tb_gy      : f32
    mutable tb_hx      : f32
    mutable tb_hy      : f32
    mutable tb_have    : bool
    mutable test_wait  : i32                   # draws until autostart
    mutable test_settle : i32                  # frames since test began
    mutable tb_fb      : @f32               # 2 cams x (face cx, cy, side)
    mutable tb_pv      : array Texture         # net-input panels: l/r/face per cam
    mutable ts_off     : ts_model
    mutable tb_f0      : tensor                # top cam face crop
    mutable tb_f1      : tensor                # bottom cam face crop
    mutable tb_l0      : tensor                # top cam left eye crop
    mutable tb_r0      : tensor                # top cam right eye crop
    mutable tb_l1      : tensor                # bottom cam left eye
    mutable tb_r1      : tensor                # bottom cam right eye
    mutable tb_a36     : @f32               # both cams' 18-aux
    mutable tb_ox      : f32
    mutable tb_oy      : f32
    mutable tb_oz      : f32
    mutable tb_ohave   : bool
    public  verify     : bool
    public  benchmark  : bool
    public  head_u     : f32 [ 0.0 ]          # eye-mid screen x, -0.5..0.5
    public  head_v     : f32 [ 0.0 ]          # eye-mid screen y, +down
    public  head_in    : f32 [ 24.0 ]         # head to monitor, inches
    mutable bench_i    : i32
    mutable bench_last : i64
    mutable bench_at   : i64                  # captures start (3s settle)
    mutable bench_t0   : i64                  # spiral clock zero
    mutable bench_u    : f32
    mutable bench_v    : f32
    public  fit        : bool
    mutable recs_n     : i32
    mutable recs_dat   : @f32               # 9 per record, see rec_solve
    mutable recs_pos   : @f32               # 3 per record: triangulated head, -999 mono
    mutable recs_fid   : @i32               # record file id per loaded record
    mutable recs_look  : @f32               # 2 per record: the followed gaze
    mutable recs_head  : @f32               # 2 per record: the head circle
    mutable recs_noise : @i32               # noise (no-face) record file ids
    mutable recs_noise_n : i32
    mutable hair_pat : @u8                  # 32x32 hair patches from h plots
    mutable hair_n   : i32
    public  rec_fov    : f32 [ 31.5 ]
    public  span_known : f32 [ 88.0 ]
    mutable fit_n      : i32
    mutable fit_span   : f32
    mutable fit_nose   : f32
    mutable fit_seat   : f32
    mutable fit_gap    : f32
    mutable cap_started : bool
    mutable rng      : i64 [ 88172645463325252 ]
    mutable ab_sigma : f32 [ 1.0 ]            # challenger spread
    mutable c_eye : f32 [ 91.0 ]             # champion (running centre), mm
    mutable c_nos : f32 [ 38.5 ]
    mutable c_mid : f32 [ 33.9 ]
    mutable c_ny  : f32 [ 42.3 ]
    mutable veye : array f32
    mutable vnos : array f32
    mutable vmid : array f32
    mutable vny  : array f32
    mutable yaw    : f32
    mutable pitch  : f32 [ 0.05 ]
    mutable dist   : f32 [ 3.5 ]
    mutable look_x : f32
    mutable look_y : f32 [ 1.0 ]
    mutable look_z : f32
    mutable cam_ready : bool                    # a face has auto-framed once

    public func cage_click [ mv: ModelView, mx: f32, my: f32 ]
        if [ !face_main || !face_main.vmodel ] return
        if [ mv.face_idx == 0 ]
            if [ !mv.pick_cage[ mx, my ] ] return
            cage_ci = mv.picked_cage
            cage_v  = mv.picked_vert
            cage_scatter[ vote_0 ]
            cage_scatter[ vote_1 ]
            puts 'cage propose: cage={cage_ci} vert={cage_v}'
        el
            if [ !mv.vmodel ] return
            face_main.vmodel.cage_copy_from[ mv.vmodel ]
            save_mask[ face_main ]
            puts 'cage merge: face_idx={mv.face_idx} -> main'

    public func save_mask [ mv: ModelView ]
        if [ !mv || !mv.vmodel || !mv.vmodel.cages ] return
        mkdir[ '/src/hyperspace-sessions', 493 ]
        sdir : '/src/hyperspace-sessions/{session}'
        mkdir[ sdir.chars, 493 ]
        fpn : '{sdir}/user.cage'
        fh : @FILE [ fopen[ fpn.chars, 'wb' ] ]
        if [ !fh ]
            puts 'mask save failed: {fpn}'
            return
        hdr : local i32 [ 2 ]
        hdr[0] = 777001
        hdr[1] = i32[ mv.vmodel.cages.count ]
        fwrite[ hdr, 4, i64[ 2 ], fh ]
        for [ ci: i32 0, ci < mv.vmodel.cages.count, ci += 1 ]
            t : mv.vmodel.cages[ ci ]
            nvh : local i32 [ 1 ]
            nvh[0] = t.nv
            fwrite[ nvh, 4, i64[ 1 ], fh ]
            if [ !t.cage_buf || !t.base ] continue
            cur : @f32 [ t.cage_buf.data ]
            n3 : i32 [ t.nv * 3 ]
            dbuf : new f32 [ n3 ]
            for [ i: i32 0, i < n3, i += 1 ] dbuf[ i ] = cur[ i ] - t.base[ i ]
            fwrite[ dbuf, 4, i64[ n3 ], fh ]
        fclose[ fh ]
        puts 'mask saved: {fpn}'

    public func load_mask [ mv: ModelView ]
        if [ !mv || !mv.vmodel || !mv.vmodel.cages ] return
        fpn : '/src/hyperspace-sessions/{session}/user.cage'
        fh : @FILE [ fopen[ fpn.chars, 'rb' ] ]
        if [ !fh ] return
        hdr : local i32 [ 2 ]
        fread[ hdr, 4, i64[ 2 ], fh ]
        if [ hdr[0] != 777001 || hdr[1] != i32[ mv.vmodel.cages.count ] ]
            puts 'mask mismatch (header): {fpn}'
            fclose[ fh ]
            return
        for [ ci: i32 0, ci < mv.vmodel.cages.count, ci += 1 ]
            t : mv.vmodel.cages[ ci ]
            nvh : local i32 [ 1 ]
            fread[ nvh, 4, i64[ 1 ], fh ]
            if [ nvh[0] != t.nv ]
                puts 'mask mismatch (cage {ci}): {fpn}'
                fclose[ fh ]
                return
            if [ !t.cage_buf || !t.base ] continue
            n3 : i32 [ t.nv * 3 ]
            dbuf : new f32 [ n3 ]
            fread[ dbuf, 4, i64[ n3 ], fh ]
            cur : @f32 [ t.cage_buf.data ]
            for [ i: i32 0, i < n3, i += 1 ] cur[ i ] = t.base[ i ] + dbuf[ i ]
        fclose[ fh ]

    func cage_scatter [ vv: ModelView ]
        if [ !vv || !vv.vmodel || cage_v < 0 ] return
        vv.vmodel.cage_copy_from[ face_main.vmodel ]
        rng = rng * 6364136223846793005 + 1442695040888963407
        vv.vmodel.cage_shuffle[ cage_ci, cage_v, vv.paint_radius, vv.paint_amount, rng ]

    func rnd [] -> f32
        rng = rng * 6364136223846793005 + 1442695040888963407
        r : i64 [ (rng >> 33) & 2147483647 ]
        return f32[ r ] / 2147483647.0

    # ~zero-mean noise (triangular), range about [-1.5, 1.5]
    func gauss [] -> f32
        return rnd[] + rnd[] + rnd[] - 1.5

    func resample []
        veye = array f32 [ ]
        vnos = array f32 [ ]
        vmid = array f32 [ ]
        vny  = array f32 [ ]
        for [ i: i32 0, i < 4, i += 1 ]
            s : f32 [ (i == 0) ? 0.0 : ab_sigma ]
            veye += c_eye + gauss[] * 6.0 * s
            vnos += c_nos + gauss[] * 5.0 * s
            vmid += c_mid + gauss[] * 4.0 * s
            vny  += c_ny  + gauss[] * 5.0 * s

    public func pick [ i: i32 ]
        if [ i < 0 || i >= 4 ] return
        if [ !veye || veye.count < 4 ] return
        ne  : f32 [ veye[i] ]
        nn  : f32 [ vnos[i] ]
        nm  : f32 [ vmid[i] ]
        nyv : f32 [ vny[i] ]
        den : f32 [ ab_sigma ]
        if [ den < 0.001 ] den = 0.001
        de : f32 [ ne  - c_eye ]
        dn : f32 [ nn  - c_nos ]
        dm : f32 [ nm  - c_mid ]
        dy : f32 [ nyv - c_ny ]
        se : f32 [ ((de < 0.0) ? (0.0 - de) : de) / (6.0 * den) ]
        sn : f32 [ ((dn < 0.0) ? (0.0 - dn) : dn) / (5.0 * den) ]
        sm : f32 [ ((dm < 0.0) ? (0.0 - dm) : dm) / (4.0 * den) ]
        sy : f32 [ ((dy < 0.0) ? (0.0 - dy) : dy) / (5.0 * den) ]
        step : f32 [ (se + sn + sm + sy) * 0.25 ]
        c_eye = ne
        c_nos = nn
        c_mid = nm
        c_ny  = nyv
        if [ i == 0 ]
            ab_sigma = ab_sigma * 0.7
        el
            ab_sigma = ab_sigma * (0.55 + step)
        if [ ab_sigma > 1.5 ]  ab_sigma = 1.5
        if [ ab_sigma < 0.15 ] ab_sigma = 0.15
        resample[]
        puts 'hyperspace: pick {i} sigma={ab_sigma} eye={c_eye} nos={c_nos} mid={c_mid} ny={c_ny}'

    public func on_key [ ev: Event ]
        if [ !ev.key.state ] return
        if [ gen > 0 ] return
        if [ rec_mode == 'record' && !rec_noise && ev.key.unicode == 32 ]
            if [ au_phase == 0 ]
                au_phase = 1
                au_b0 = epoch_millis[]
                au_cap = au_b0
                if [ rec_fast ] au_next_fast[]
                el              au_next_dot[]
            return
        # X: this camera cannot see the eyes. mark hidden if EITHER eye is
        # covered at all — a partly clipped face is still usable, since
        # off-screen clipping is augmented, but an occluded eye is not.
        # must precede the global X binding, which starts generation
        if [ rec_mode == 'annotate' && ev.key.unicode == 88 ]
            camx : cam_role[ ann_cam ]
            fidx : i32 [ i32[ atof[ ann_files[ ann_i ].chars ] ] ]
            agi_put2[ fidx, '{camx}_hidden', 'true' ]
            puts 'annotate: #{fidx} {camx} hidden'
            ann_refresh_marks[]
            ann_sub = 7
            ann_ext = ev.key.shift
            ann_seek[ false ]
            return
        if [ rec_mode == 'annotate' && ev.key.unicode == 72 ]
            if [ ann_rect.w > 0.0 ]
                nx8 : f32 [ (ux.mouse.x - ann_rect.x) / ann_rect.w ]
                ny8 : f32 [ (ux.mouse.y - ann_rect.y) / ann_rect.h ]
                cam8 : cam_role[ ann_cam ]
                fidh : i32 [ i32[ atof[ ann_files[ ann_i ].chars ] ] ]
                agi_put2[ fidh, '{cam8}_hair', '{nx8} {ny8}' ]
                puts 'annotate: #{fidh} {cam8} hair at ({nx8}, {ny8})'
                ann_refresh_marks[]
            return
        if [ rec_mode == 'annotate' && ev.key.unicode == 70 ]
            fidn7 : i32 [ i32[ atof[ ann_files[ ann_i ].chars ] ] ]
            agi_put2[ fidn7, 'face_id', 'true' ]
            puts 'annotate: #{fidn7} marked face identifier'
            return
        if [ rec_mode == 'annotate' && ev.key.unicode == 78 ]
            fidn6 : i32 [ i32[ atof[ ann_files[ ann_i ].chars ] ] ]
            agi_put2[ fidn6, string 'noise', string 'true' ]
            puts 'annotate: #{fidn6} marked noise'
            ann_sub = 7
            ann_cam = 1
            ann_ext = ev.key.shift
            ann_seek[ false ]
            return
        if [ ev.key.unicode == 49 ] pick[ 0 ]     # 1: top-left
        if [ ev.key.unicode == 50 ] pick[ 1 ]     # 2: top-right
        if [ ev.key.unicode == 51 ] pick[ 2 ]     # 3: bottom-left
        if [ ev.key.unicode == 52 ] pick[ 3 ]     # 4: bottom-right
        if [ ev.key.unicode == 82 ] regen_i += 1
        if [ ev.key.unicode == 71 ]
            if [ face_main ] face_main.begin_export[]
        if [ ev.key.unicode == 88 && rec_mode == '' ] start_capture[]
        if [ face_main ] face_main.on_key[ ev ]

    public func start_capture []
        sync_cams[]
        if [ cap_view && cap_view.capture_left != 0 ] return
        if [ recs_n == 0 ]
            load_recs[]
        if [ recs_n < 10 ]
            puts 'generation needs 10 annotated records, have {recs_n} — record + plot oc first'
            if [ gen > 0 ] exit[ 1 ]
            return
        if [ !cap_os ]
            cv2 : CapRoot [ model_path: model, face_idx: 0, id: 'cap_root' ]
            cv2.rig = a
            cap_os = offscreen [ vk: vk, width: cap_w, height: cap_h, root: cv2, st: ux.st ]
            cap_os.hold[]
            cap_view = cv2
            ux.offscreens.push[ cap_os ]
            # one headless frame builds the model, cages and anchors
            cap_os.frame[]
        if [ !cap_view.vmodel ]
            puts 'capture view not ready yet'
            return
        if [ face_main && face_main.vmodel ]
            cap_view.vmodel.cage_copy_from[ face_main.vmodel ]
        for [ di: i32 0, true, di += 1 ]
            da : path '/src/hyperspace-sessions/{session}/{di}.agi'
            if [ !da.exists[] ] break
            da.remove[]
            df : path '/src/hyperspace-sessions/{session}/{di}-face.png'
            if [ df.exists[] ] df.remove[]
            dv : path '/src/hyperspace-sessions/{session}/{di}-verify.png'
            if [ dv.exists[] ] dv.remove[]
            dp : path '/src/hyperspace-sessions/{session}/{di}-preview.png'
            if [ dp.exists[] ] dp.remove[]
            for [ dc: i32 0, dc < 4, dc += 1 ]
                dfc : path '/src/hyperspace-sessions/{session}/{di}-face{dc}.png'
                if [ dfc.exists[] ] dfc.remove[]
                dpc : path '/src/hyperspace-sessions/{session}/{di}-preview{dc}.png'
                if [ dpc.exists[] ] dpc.remove[]
                dic : path '/src/hyperspace-sessions/{session}/{di}-inputs{dc}.png'
                if [ dic.exists[] ] dic.remove[]
        np5 : i32 [ (gen > 0) ? gen : 100 ]
        lk5 : i32 [ (looks > 0) ? looks : 1 ]
        n5 : i32 [ np5 * lk5 ]
        cap_view.begin_capture[ n5 ]
        puts 'plot capture: {np5} poses x {lk5} looks = {n5} samples -> session {session}'

    public func render [] -> Elements
        if [ !seeded ]
            sync_cams[]
            resample[]
            # the stdout overlay sits below our toolbar row
            ux.stdout_y = 32.0
            seeded = true
        e : Elements [ ]
        if [ rec_mode == 'annotate' ]
            return e
        if [ rec_mode == 'record' ]
            e['rec-toolbar'] = HsToolbar [ elements: Elements [
                'record':  HsButton [ label: 'stop' ] ] ]
            # animated: live feeds must repaint every frame, never cache
            for [ i9: i32 0, i9 < cam_n, i9 += 1 ]
                nm9 : cam_role[ i9 ]
                if [ cam_n < 2 ]
                    e[ nm9 ] = RecFull [ device: cam_dev[ i9 ], animated: true, paint_off: !rec_noise ]
                el [ i9 == 0 ]
                    e[ nm9 ] = RecTop [ device: cam_dev[ i9 ], animated: true, paint_off: !rec_noise ]
                el
                    e[ nm9 ] = RecBot [ device: cam_dev[ i9 ], animated: true, paint_off: !rec_noise ]
            return e
        if [ rec_mode == 'test' ]
            # small live feeds; the cascade + gaze dot draw in on_canvas
            for [ i9: i32 0, i9 < cam_n, i9 += 1 ]
                nm9 : cam_role[ i9 ]
                if [ i9 == 0 ] e[ nm9 ] = CamTop [ device: cam_dev[ i9 ], animated: true ]
                el             e[ nm9 ] = CamBot [ device: cam_dev[ i9 ], animated: true ]
            return e
        if [ rec_mode == 'bench' ]
            # cameras pump invisibly; ONLY the spiral mark shows
            for [ i9: i32 0, i9 < cam_n, i9 += 1 ]
                nm9 : cam_role[ i9 ]
                if [ i9 == 0 ] e[ nm9 ] = CamTop [ device: cam_dev[ i9 ], animated: true, paint_off: true ]
                el             e[ nm9 ] = CamBot [ device: cam_dev[ i9 ], animated: true, paint_off: true ]
            return e
        e['face_main'] = FaceMain [ model_path: model, face_idx: 0,
            yaw: yaw, pitch: pitch, dist: dist, look_x: look_x, look_y: look_y, look_z: look_z ]
        e['vote_0'] = Vote0 [ model_path: model, face_idx: 10 + regen_i * 100,
            yaw: yaw, pitch: pitch, dist: dist, look_x: look_x, look_y: look_y, look_z: look_z ]
        e['vote_1'] = Vote1 [ model_path: model, face_idx: 11 + regen_i * 100,
            yaw: yaw, pitch: pitch, dist: dist, look_x: look_x, look_y: look_y, look_z: look_z ]
        if [ rec_mode != 'annotate' ]
            e['toolbar'] = HsToolbar [ elements: Elements [
                'record': VButton [ label: 'record' ],
                'record2': VButton [ label: 'record 2' ],
                'noise':   HsButton [ label: 'noise' ],
                'plot-oc': HsButton [ label: 'plot oc' ],
                'testbed': HsButton [ label: 'test' ],
                'bench':   HsButton [ label: 'bench' ] ] ]
        return e
