
export 0.8.8

import <stdio.h>


struct Point
    x : f32
    y : f32

app test
    func init[]
        pts : array Point []
        p0  : Point [ x: 1.0, y: 2.0 ]
        pts.push[ p0 ]
        p1  : Point [ x: 3.0, y: 4.0 ]
        pts.push[ p1 ]
        pts[ 0 ] = p1
        puts 'array of struct: ok'
        s : string [ 'hello' ]
        s.hold[]
        s.drop[]
        puts 'instance-style smethod: ok'
