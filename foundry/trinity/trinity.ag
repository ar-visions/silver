Control Button
    public icon  : string
    iconl : Layer [ image_align: Align [ x: XAlign.middle, y: YAlign.middle ], image_scale: 1.7 ]
    intern icon_cur : string
    public  icon_fit : f32

    func sync_icon []
        if [ icon_fit > 0.0 ] iconl.image_fit = icon_fit
        if [ !icon || icon.count == 0 ] return
        if [ icon_cur && icon_cur.compare[ icon ] == 0 ] return
        icon_cur = icon
        iconl.image_svg = SVGModel [ 'images/{icon}.svg' ]
        pristine    = false
        needs_frame = true
        if [ ux ] ux.will_animate = true

    func init []
        sync_icon[]

    func render[] -> Elements
        sync_icon[]
        return null

Button Check
    func on_click[ ev:Event ]
        selected = !selected
    
    func render[] -> Elements
        return null

Button Option
    public left_view  : bool
    public right_view : bool
    public toggle     : bool
    public manual_mode : bool
    func on_press[ ev:Event ]
        if [ manual_mode ] return
        if [ ev.mouse.pos.y != (0 ..< 48) ]
            return
        if [ selected && !toggle ]
            return
        new_state : bool [ !selected ]
        for [ e:element, id:string ] in parent.elements
            op : Option e
            if [ op ]
                op.selected = (new_state && a == e)
                op.pristine = false

    func render[] -> Elements
        return null

element Toolbar
    func render[] -> Elements
        return null

Control Tabs
    public  etype : Au_t
    public  value : i32
    mutable bound : @i32

    func member_value [ mem: Au_t ] -> i32
        pv : cast @i32 [ mem.value ]
        return pv[0]

    func on_press [ ev: Event ]
        e : cast element [ ev.origin ]
        if [ !e || !etype ] return
        for [ m: i32 0, m < etype.members.count, m += 1 ]
            mem : Au_t etype.members.origin[m]
            if [ mem.member_type != 10 ] continue          # AU_MEMBER_ENUMV
            nm : string mem.ident
            if [ nm == e.id ]
                value = member_value[ mem ]
                if [ bound ] bound[0] = value
                if [ ux ] ux.restyle = true
                ev.stop_propagation[]
                return

    func render [] -> Elements
        if [ !etype ] return null
        els : Elements [ ]
        for [ m: i32 0, m < etype.members.count, m += 1 ]
            mem : Au_t etype.members.origin[m]
            if [ mem.member_type != 10 ] continue          # AU_MEMBER_ENUMV
            nm : string mem.ident
            sel : bool [ member_value[ mem ] == value ]
            els[ nm ] = Option [ label: nm, manual_mode: true, selected: sel ]
        return els

Control Slider
    animated : true
    mutable target : element
    mutable mem    : Au_t
    mutable minv   : f32
    mutable maxv   : f32 [ 1.0 ]

    func read [] -> f32
        if [ value ] return f32[ value ]
        if [ target && mem ]
            pf : @f32 [ target.member_ref[ mem ] ]
            return pf[0]
        return 0.0

    func write [ lx: f32 ]
        hr : f32 [ bounds.h / 2.0 - 2.0 ]
        span : f32 [ bounds.w - 2.0 * hr ]
        t : f32 [ (span > 0.0) ? (lx - hr) / span : 0.0 ]
        if [ t < 0.0 ] t = 0.0
        if [ t > 1.0 ] t = 1.0
        v : f32 [ minv + t * (maxv - minv) ]
        value = v
        if [ target && mem ]
            pf : @f32 [ target.member_ref[ mem ] ]
            pf[0] = v
        pristine = false

    func on_press [ ev: Event ]
        write[ ev.mouse.pos.x ]
        ev.stop_propagation[]

    func on_move [ ev: Event ]
        if [ pressed ] write[ ev.mouse.pos.x ]

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !target || !mem ] return
        cv : Canvas w.screen
        v  : f32 [ read[] ]
        t  : f32 [ (maxv > minv) ? (v - minv) / (maxv - minv) : 0.0 ]
        cy : f32 [ bounds.h / 2.0 ]
        rr : f32 [ 2.5 ]
        hr : f32 [ bounds.h / 2.0 - 2.0 ]
        kx : f32 [ hr + t * (bounds.w - 2.0 * hr) ]
        cv.fill_color[ rgba[ '#ffffff20' ] ]
        cv.rounded_rect[ 0.0, cy - rr, bounds.w, rr * 2.0, rr, rr, rr, rr ]
        cv.paint[]
        cv.fill_color[ rgba[ '#3b6fe0' ] ]
        cv.rounded_rect[ 0.0, cy - rr, kx, rr * 2.0, rr, rr, rr, rr ]
        cv.paint[]
        # handle: a circle = rounded_rect at full (half-size) radius
        cv.fill_color[ rgba[ '#ffffff' ] ]
        cv.rounded_rect[ kx - hr, cy - hr, hr * 2.0, hr * 2.0, hr, hr, hr, hr ]
        cv.paint[]

Control ColorPicker
    animated : true
    mutable target : element
    mutable mem    : Au_t

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        col : rgba [ (value) ? rgba[ value ] : rgba[ '#000000' ] ]
        cv : Canvas w.screen
        if [ !selected ]
            # collapsed: a rounded swatch of the current color
            cv.fill_color[ col ]
            cv.rounded_rect[ 0.0, 0.0, bounds.w, bounds.h, 6.0, 6.0, 6.0, 6.0 ]
            cv.paint[]
            return
        cx : f32 [ bounds.w / 2.0 ]
        cy : f32 [ bounds.h / 2.0 ]
        rad : f32 [ ((bounds.w < bounds.h) ? bounds.w : bounds.h) / 2.0 - 6.0 ]
        g : Gradient conic_gradient[ cx, cy, 0.0 ]
        g.add_stop[ 0.0,     0xffff0000 ]
        g.add_stop[ 0.1667,  0xffffff00 ]
        g.add_stop[ 0.3333,  0xff00ff00 ]
        g.add_stop[ 0.5,     0xff00ffff ]
        g.add_stop[ 0.6667,  0xff0000ff ]
        g.add_stop[ 0.8333,  0xffff00ff ]
        g.add_stop[ 1.0,     0xffff0000 ]
        cv.set_fill_gradient[ g ]
        cv.rounded_rect[ cx - rad, cy - rad, rad * 2.0, rad * 2.0, rad, rad, rad, rad ]
        cv.paint[]
        cv.clear_fill_gradient[]
        # punch the center hole + show the current color there
        inr : f32 [ rad * 0.62 ]
        cv.fill_color[ col ]
        cv.rounded_rect[ cx - inr, cy - inr, inr * 2.0, inr * 2.0, inr, inr, inr, inr ]
        cv.paint[]

Option Edit
    func on_press[ ev:Event ] return
    func render[] -> Elements
        return null

Option UXMenuButton
    area    : Region { r0.22+ t0.22 w1.0 h1.0 }
    public wait_state : bool
    public live_state : bool
    outline : Layer [ radius: Radius [ '8' ], stroke_width: 0.0,
        stroke_color: rgba [ '#0000' ], fill_color: rgba [ '#0000' ] ]
    hover   : Layer [ states: State.hovered, radius: Radius [ '8' ],
        stroke_width: 0.5, stroke_color: rgba [ '#ffff' ], fill_color: rgba [ '#ffffff14' ] ]
    active  : Layer [ states: State.selected, radius: Radius [ '8' ],
        stroke_width: 0.5, stroke_color: rgba [ '#ffff' ], fill_color: rgba [ '#0000' ] ]

    func render [] -> Elements
        sync_icon[]
        if [ selected ]
            iconl.image_color = rgba [ '#c8641e' ]
        el [ hovered ]
            iconl.image_color = rgba [ '#ffffff' ]
        el
            iconl.image_color = rgba [ '#ffffff80' ]
        if [ live_state ]
            outline.stroke_width = 1.0
            outline.stroke_color = rgba [ '#3b6fe0' ]
        el [ wait_state ]
            outline.stroke_width = 1.0
            outline.stroke_color = rgba [ '#e08a1e' ]
        el
            outline.stroke_width = 0.0
            outline.stroke_color = rgba [ '#0000' ]
        return null

UXMenuButton UXMenuLeft
    area : Region { l0.22+ t0.22 w1.0 h1.0 }

UXMenuButton UXMenuRight
    area : Region { r0.22+ t0.22 w1.0 h1.0 }


element IDEOverlay
    area       : Region { l0 t0 r0 b0 }
    animated   : true
    focusable  : true
    mutable tex0    : Texture
    mutable tex1    : Texture
    mutable gen     : i32
    mutable fitx    : f32
    mutable fity    : f32
    mutable fitw    : f32
    mutable fith    : f32
    mutable dim     : f32
    mutable closing : bool
    mutable req_w   : i32
    mutable req_h   : i32

    func service [ cv: Canvas ]
        g9 : i32 [ host_tex_gen[ host_slot[], 1 ] ]
        if [ g9 == gen || g9 <= 0 ] return
        w9 : i32
        h9 : i32
        f9 : i32
        fd0 : i32 [ host_tex_pull[ host_slot[], 1, 0, @w9, @h9, @f9 ] ]
        fd1 : i32 [ host_tex_pull[ host_slot[], 1, 1, @w9, @h9, @f9 ] ]
        if [ fd0 < 0 || fd1 < 0 ]
            puts 'overlay: pull failed gen {g9} fds {fd0},{fd1}'
            return
        tex0 = cv.vk.import_shared_tex[ fd0, w9, h9, f9, cv.w ]
        tex1 = cv.vk.import_shared_tex[ fd1, w9, h9, f9, cv.w ]
        gen = g9
        puts 'overlay: imported orbiter surface {w9}x{h9} gen {g9}'

    func front [] -> Texture
        fr : i32 [ host_tex_front[ host_slot[], 1 ] ]
        if [ fr < 0 || !tex0 ] return null
        return (fr == 0) ? tex0 : tex1

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        cv : Canvas w.screen
        service[ cv ]
        nw : i32 [ i32[ bounds.w ] ]
        nh : i32 [ i32[ bounds.h ] ]
        if [ nw > 0 && nh > 0 && (nw != req_w || nh != req_h) ]
            req_w = nw
            req_h = nh
            host_post[ 0, i32[ HM.resize ], nw, nh, 0 ]
        if [ ux.ide_close ]
            ux.ide_close = false
            ux.shell_tex  = null
            ux.ide_active = false
            host_post[ 0, i32[ HM.shell ], 0, 0, 0 ]
            ux.ide_restore_size[]
            ux.restyle    = true
            return
        fitx = 0.0
        fity = 0.0
        fitw = bounds.w
        fith = bounds.h
        ux.shell_tex = front[]

    func post_mouse [ ev: Event, kind: i32 ]
        if [ fitw <= 0.0 || !tex0 ] return
        aw : f32 [ f32[ tex0.width ] ]
        ah : f32 [ f32[ tex0.height ] ]
        bx : f32 [ (ev.mouse.pos.x - fitx) / fitw * aw ]
        by : f32 [ (ev.mouse.pos.y - fity) / fith * ah ]
        if [ bx < 0.0 ] bx = 0.0
        if [ by < 0.0 ] by = 0.0
        if [ bx >= aw ] bx = aw - 1.0
        if [ by >= ah ] by = ah - 1.0
        host_post[ 0, kind, i32[ bx ], i32[ by ], ev.mouse.button ]

    func on_press [ ev: Event ]
        set_focus[]
        post_mouse[ ev, i32[ HM.press ] ]
        ev.stop_propagation[]

    func on_release [ ev: Event ]
        post_mouse[ ev, i32[ HM.release ] ]

    func on_move [ ev: Event ]
        post_mouse[ ev, i32[ HM.move ] ]

    func on_char [ ev: Event ]
        if [ !ev.key.text || ev.key.text.count == 0 ] return
        for [ i: i32 0, i < i32[ ev.key.text.count ], i += 1 ]
            host_post[ 0, i32[ HM.text ], (i32 ev.key.text.chars[ i ]) & 255, 0, 0 ]

    func on_key [ ev: Event ]
        if [ ev.key.unicode == 256 && ev.key.shift && ev.key.state ]
            ux.ide_close = true
            return
        mods : i32 [ 0 ]
        if [ ev.key.shift ] mods = mods | 1
        if [ ev.key.ctrl ]  mods = mods | 2
        if [ ev.key.alt ]   mods = mods | 4
        if [ ev.key.meta ]  mods = mods | 8
        act : i32 [ (ev.key.state) ? 1 : 0 ]
        host_post[ 0, i32[ HM.key ], i32[ ev.key.unicode ], act, mods ]

