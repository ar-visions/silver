    cast -> sec [ a / 1000 ]
    cast -> ns  [ a * 1000000 ]

scalar ns : i64
    cast -> sec [ a / 1000000000 ]
    cast -> ms  [ a / 1000000 ]

class Background
    context window: Window
    public color:  rgba
    public render: Render
    public models: array Model

    func update[]
        return

enum HM
    none    : 0
    dictate : 1
    live    : 2
    press   : 3
    release : 4
    move    : 5
    key     : 6
    text    : 7
    resize  : 9
    close   : 10
    shell   : 11

func host_ask_orbiter [] -> i32
func host_dictate_set [ v: i32 ]
func host_live_set    [ v: i32 ]
func host_log_setup   [ name: cstr ]
func host_pid_alive   [ pid: i32 ] -> i32
func host_slot        [] -> i32
func host_post        [ ring: i32, type: i32, a: i32, b: i32, c: i32 ]
func host_poll        [ ring: i32 ] -> i32
func host_post2       [ slot: i32, ring: i32, type: i32, a: i32, b: i32, c: i32 ]
func host_poll2       [ slot: i32, ring: i32 ] -> i32
func host_pa          [] -> i32
func host_pb          [] -> i32
func host_pc          [] -> i32
func host_tex_publish [ slot: i32, side: i32, fd0: i32, fd1: i32, w2: i32, h2: i32, fmt: i32 ]
func host_tex_gen     [ slot: i32, side: i32 ] -> i32
func host_tex_flip    [ slot: i32, side: i32, front: i32 ]
func host_tex_front   [ slot: i32, side: i32 ] -> i32
func host_tex_pull    [ slot: i32, side: i32, which: i32, w2: @i32, h2: @i32, fmt: @i32 ] -> i32
func host_app_request [ nm: cstr ] -> i32
func host_app_state   [ slot: i32 ] -> i32
func host_app_pid     [ slot: i32 ] -> i32
func host_app_stop    [ slot: i32 ]
func host_app_verdict [ slot: i32 ] -> i32
func host_app_pause   [ slot: i32 ]
func host_app_resume  [ slot: i32 ]
func au_live_set_reload [ on: i32 ]

abstract live_app media_app
    context w           : Display*
    context vk          : vk_context
    intern  arg         : object
    intern  destroyed   : bool
    public  width       : i32
    public  height      : i32
    public  live_reload : bool [ true ]
    public  text_mode   : bool [ false ]
    public  screenshot  : path
    # --shot-frame N: which frame to capture (default 60)
    public  shot_frame  : i32 [ 60 ]
    intern  shot_frames : i32
    intern  next_second : i64
    intern  frames      : i32
    public  attach      : path
    # the shared surface pair + which one we fill next
    intern  share_tex0  : Texture
    intern  share_tex1  : Texture
    intern  share_back  : i32
    intern  app_pid : i32

    public func parse_app_pid [] -> i32
        pe : getenv[ 'SILVER_ISOLATE_APP_PID' ]
        if [ !pe ] return 0
        ps : string [ pe ]
        return i32[ ps.integer_value[] ]

    func run [ ]
        au_live_set_reload[ (live_reload) ? 1 : 0 ]
        Au.auto_free[true]

    func ux_serialize [ e: element ] -> map object [string]
        em : map object [string] []
        if [ !e ] return em
        hdr : Au.header[ e ]
        em['type'] = string [ hdr.au.ident ]
        if [ e.bounds ]
            em['bounds'] = array f32 [ e.bounds.x, e.bounds.y, e.bounds.w, e.bounds.h ]
        if [ e.label && e.label.count > 0 ]
            em['label'] = e.label
        if [ e.hide      ] em['hide']      = string 'true'
        if [ e.focusable ] em['focusable'] = string 'true'
        if [ e.elements ]
            inner : map object [string] []
            for [ ch: element, k: string ] in e.elements
                if [ ch ] inner[k] = ux_serialize[ ch ]
            if [ inner.count > 0 ] em['elements'] = inner
        return em

    func frame [ ] -> bool
        if [ w ]
            bwn : Window [ w ]
            if [ !attach ]
                for [ pk: i32 0, pk < 128, pk += 1 ]
                    ht : i32 [ host_poll[ 1 ] ]
                    if [ ht == 0 ] break
                    if [ ht == i32[ HM.live ] ]
                        bwn.dict_live = host_pa[] != 0
                        bwn.restyle   = true
                    el [ ht == i32[ HM.close ] ]
                        bwn.ide_close = true
        ifdef [ linux ]
            if [ attach && getenv[ 'SILVER_ISOLATE_APP' ] ]
                render*[]
                share_publish[ 1 ]
                ide_pump[]
                Au.auto_free[ false ]
                usleep[ 4000 ]
                if [ app_pid == 0 ] app_pid = parse_app_pid[]
                if [ app_pid > 0 && host_pid_alive[ app_pid ] == 0 ] return false
                return !Au.quit_requested[]
            if [ attach ]
                render*[]
                share_publish[ 0 ]
                alive : bool [ attach_pump[] ]
                Au.auto_free[ false ]
                usleep[ 4000 ]
                return alive && !Au.quit_requested[]
        if [ text_mode ]
            render*[]
            Au.auto_free[false]
            usleep[ 16000 ]
            return !Au.quit_requested[]
        glfwPollEvents[]
        second : epoch_millis[] / 1000
        if [ next_second != second ]
            next_second = second
            puts 'SAMP rcolor={vk.samp_rcolor} sdf={vk.samp_sdf} svg={vk.samp_svg} band={vk.samp_band} line={vk.samp_line} cons={vk.samp_cons} flist={vk.samp_flist} atlas={vk.samp_atlas} other={vk.samp_other} born={vk.render_allocs} died={vk.ring_frees} samplers={vk.sampler_count}'
            vk.pipe_draws   = 0
            vk.resize_us    = 0
            vk.resize_calls = 0
            frames = 0
            vk.submit_calls = 0
            vk.sync_calls   = 0
            vk.sync_us      = 0
            vk.update_us    = 0
            vk.draw_us      = 0
            vk.paint_calls  = 0
            vk.sdf_hit      = 0
            vk.sdf_miss     = 0
            vk.geom_us      = 0
            vk.render_allocs = 0
            vk.ring_frees    = 0
            vk.bindres_calls = 0
            vk.bindres_us    = 0
            vk.br_schema_us  = 0
        render*[]
        ifdef [ linux ]
            wp9 : Window [ w ]
            sup9 : bool [ getenv[ 'SILVER_ISOLATE_CHILD' ] != null ]
            if [ (wp9.ide_asked || sup9) && !wp9.ide_active ] share_publish[ 0 ]
        if [ screenshot ]
            shot_frames += 1
            if [ shot_frames >= shot_frame ]
                im : Image [ w.last_render[].color ]
                im.png[ screenshot ]
                puts 'screenshot: {screenshot}'
                exit[ 0 ]
        Au.auto_free[false]
        afp9 : path 'afprobe'
        afh9 : Au.header[ afp9 ]
        if [ afh9.managed > 100000 ] puts 'AFPOOL ix={afh9.managed} — pool NOT draining'
        return !glfwWindowShouldClose[ w.glfw ] && !Au.quit_requested[]

    ifdef [ linux ]
        func share_publish [ side: i32 ]
            wn : Window [ w ]
            scv : Canvas [ wn.screen ]
            if [ !scv ] return
            tx : Texture [ scv.color ]
            if [ !tx || !tx.vk_image ] return
            if [ !share_tex0 || share_tex0.width != tx.width || share_tex0.height != tx.height ]
                share_tex0 = Texture [ vk: vk, w: wn, width: tx.width, height: tx.height,
                    vk_format: tx.vk_format, shareable: true ]
                share_tex1 = Texture [ vk: vk, w: wn, width: tx.width, height: tx.height,
                    vk_format: tx.vk_format, shareable: true ]
                share_back = 0
                host_tex_publish[ host_slot[], side, share_tex0.shared_fd, share_tex1.shared_fd,
                    tx.width, tx.height, i32[ tx.vk_format ] ]
                puts 'share: published {tx.width}x{tx.height} (fds {share_tex0.shared_fd},{share_tex1.shared_fd}, side {side})'
            bt : (share_back == 0) ? share_tex0 : share_tex1
            vk.copy_image[ tx, bt ]
            host_tex_flip[ host_slot[], side, share_back ]
            share_back = 1 - share_back

        func attach_pump [] -> bool
            wn : Window [ w ]
            for [ i: i32 0, i < 64, i += 1 ]
                t : i32 [ host_poll[ 1 ] ]
                if [ t == 0 ] break
                if [ t == i32[ HM.close ] ] return false
                if [ t == i32[ HM.key ] ]
                    wn.ev.clear[]
                    wn.ev.key.unicode = host_pa[]
                    wn.ev.key.state   = host_pb[]
                    m8 : i32 [ host_pc[] ]
                    wn.ev.key.shift = (m8 & 1) != 0
                    wn.ev.key.ctrl  = (m8 & 2) != 0
                    wn.ev.key.alt   = (m8 & 4) != 0
                    wn.ev.key.meta  = (m8 & 8) != 0
                    wn.key_event[ wn.ev ]
                el [ t == i32[ HM.text ] ]
                    wn.ev.clear[]
                    tb : local i8 [ 2 ]
                    tb[0] = i8[ host_pa[] ]
                    tb[1] = 0
                    wn.ev.key.text = string[ @tb[0] ]
                    wn.text_event[ wn.ev ]
                el [ t == i32[ HM.press ] ]
                    wn.ev.clear[]
                    wn.mouse.x        = f64[ host_pa[] ]
                    wn.mouse.y        = f64[ host_pb[] ]
                    wn.ev.mouse.pos.x = f32[ host_pa[] ]
                    wn.ev.mouse.pos.y = f32[ host_pb[] ]
                    wn.ev.mouse.button = host_pc[]
                    wn.ev.mouse.state  = 1
                    wn.press_event[ wn.ev ]
                el [ t == i32[ HM.release ] ]
                    wn.ev.clear[]
                    wn.ev.mouse.pos.x = f32[ host_pa[] ]
                    wn.ev.mouse.pos.y = f32[ host_pb[] ]
                    wn.ev.mouse.button = host_pc[]
                    wn.ev.mouse.state  = 0
                    wn.release_event[ wn.ev ]
                el [ t == i32[ HM.move ] ]
                    wn.ev.clear[]
                    wn.mouse.x        = f64[ host_pa[] ]
                    wn.mouse.y        = f64[ host_pb[] ]
                    wn.ev.mouse.pos.x = f32[ host_pa[] ]
                    wn.ev.mouse.pos.y = f32[ host_pb[] ]
                    wn.move_event[ wn.ev ]
                el [ t == i32[ HM.resize ] ]
                    rw : i32 [ host_pa[] ]
                    rh : i32 [ host_pb[] ]
                    if [ rw > 0 && rh > 0 && (rw != wn.width || rh != wn.height) ]
                        vkQueueWaitIdle[ vk.queue ]
                        wn.resize[ rw, rh ]
                        width  = rw
                        height = rh
            return true

        func ide_pump []
            wn : Window [ w ]
            ae9 : cast element [ wn.app_object ]
            for [ i: i32 0, i < 64, i += 1 ]
                t : i32 [ host_poll[ 0 ] ]
                if [ t == 0 ] return
                if [ t == i32[ HM.dictate ] || t == i32[ HM.shell ] ]
                    if [ ae9 ] ae9.on_host*[ t, host_pa[], host_pb[], host_pc[] ]
                el [ t == i32[ HM.press ] ]
                    wn.ev.clear[]
                    wn.ev.mouse.pos.x = f32[ host_pa[] ]
                    wn.ev.mouse.pos.y = f32[ host_pb[] ]
                    wn.ev.mouse.button = host_pc[]
                    wn.ev.mouse.state  = 1
                    wn.mouse.x = f64[ host_pa[] ]
                    wn.mouse.y = f64[ host_pb[] ]
                    wn.press_event[ wn.ev ]
                el [ t == i32[ HM.release ] ]
                    wn.ev.clear[]
                    wn.ev.mouse.pos.x = f32[ host_pa[] ]
                    wn.ev.mouse.pos.y = f32[ host_pb[] ]
                    wn.ev.mouse.button = host_pc[]
                    wn.ev.mouse.state  = 0
                    wn.release_event[ wn.ev ]
                el [ t == i32[ HM.move ] ]
                    wn.ev.clear[]
                    wn.ev.mouse.pos.x = f32[ host_pa[] ]
                    wn.ev.mouse.pos.y = f32[ host_pb[] ]
                    wn.mouse.x = f64[ host_pa[] ]
                    wn.mouse.y = f64[ host_pb[] ]
                    wn.move_event[ wn.ev ]
                el [ t == i32[ HM.key ] ]
                    wn.ev.clear[]
                    wn.ev.key.unicode = host_pa[]
                    wn.ev.key.state   = host_pb[]
                    m9 : i32 [ host_pc[] ]
                    wn.ev.key.shift = (m9 & 1) != 0
                    wn.ev.key.ctrl  = (m9 & 2) != 0
                    wn.ev.key.alt   = (m9 & 4) != 0
                    wn.ev.key.meta  = (m9 & 8) != 0
                    wn.key_event[ wn.ev ]
                el [ t == i32[ HM.text ] ]
                    wn.ev.clear[]
                    tb9 : local i8 [ 2 ]
                    tb9[0] = i8[ host_pa[] ]
                    tb9[1] = 0
                    wn.ev.key.text = string[ @tb9[0] ]
                    wn.text_event[ wn.ev ]
                el [ t == i32[ HM.resize ] ]
                    rw9 : i32 [ host_pa[] ]
                    rh9 : i32 [ host_pb[] ]
                    if [ rw9 > 0 && rh9 > 0 ]
                        wn.resize[ rw9, rh9 ]
    func destroy [ ]
        if [ destroyed ] return
        destroyed = true
        if [ text_mode && w ]
            cwin : Window [ w ]
            cwin.console_input_close[]
        if [ w ]
            rwin : Window [ w ]
            if [ rwin.root ]
                rwin.root.unload_tree[]
                rwin.root.release_tree[]
        if [ vk ]
            vk.font_cache = null
            vk.shader_cache = null
        if [ w ]
            w.drop[]

    func render [ ]
        return

    func init [ ]
        next_second = epoch_millis[] / 1000
        if [ text_mode ]
            return
        if [ !Au.live_window_get[] ]
            init_res : glfwInit[]
            expect init_res, "glfw init"
            if [ !glfwVulkanSupported[] ]
                fault "glfw does not support vulkan"
                glfwTerminate[]
                return
        existing_vk : handle Au.live_vk_get[]
        if [ existing_vk ]
            vk = cast vk_context [ existing_vk ]
            vk.font_cache = null
        el
            vk = vk_context[]
            Au.live_vk_set[ handle[vk] ]

    func dealloc [ ]
        puts 'DSTR Display dealloc runs'
        destroy[]


class CursorPos
    public x : f32
    public y : f32
    public h : f32

Display Window
    mutable app_object          : element*
    mutable ide_active        : bool
