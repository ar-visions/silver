import vec
import img
import trinity
import <stdio.h>

enum Quality
    low:    0
    medium: 1
    high:   2

enum Theme
    dark:   0
    light:  1
    auto:   2

Button ClickButton
    style : CSS {
        area: l2 t2 w123px h64px
        focusable: true
        layers.body:
            fill_color: #2e7d32
            radius: 8
        layers.face:
            label_color: #fff
            label_size: 14
            label_align: 0.5 0.5
    :hovered
        layers.body:
            fill_color: #388e3c
            radius: 8
    }

element buttontest : trinity
    intern clicks     : i32    0
    public ux_generics : bool  [ true ]
    public width      : i32    [ 480 ]
    public height     : i32    [ 560 ]
    public background : string [ 'Background' ]
    public title      : string [ 'buttontest' ]
    public wireframe  : bool
    public paused     : bool [ true ]
    public show_grid  : bool
    public vsync      : bool [ true ]
    public quality    : Quality [ Quality.medium ]
    public theme      : Theme [ Theme.dark ]
    public tint       : rgba [ '#e0508c' ]
    # public f32 becomes a range slider (0..1)
    public volume     : f32 [ 0.7 ]
    public opacity    : f32 [ 0.35 ]

    public func on_click [ ev: Event ]
        e : cast element [ ev.origin ]
        if [ !e ] return
        if [ e.id == 'hello' ]
            clicks += 1
            puts 'button clicked! count={clicks}'
        ev.stop_propagation[]

    public func render [] -> Elements
        return Elements [
            "hello": ClickButton [ label: 'click me' ]
        ]
