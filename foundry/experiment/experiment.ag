import vec
import img
import trinity
import <stdio.h>

Background ExperimentBackground
    func init[]
        color = rgba[ '#ff0000' ]

Button MidButton
    area  : Region { m0 m0 w3 h1 }
    body  : Layer [ fill_color: rgba [ '#2e7d32' ], radius: Radius [ '8' ] ]
    hover : Layer [ states: State.hovered, fill_color: rgba [ '#388e3c' ], radius: Radius [ '8' ] ]
    face  : Layer [ label_color: rgba [ '#fff' ], label_size: 14, label_align: vec2f [ x: 0.5, y: 0.5 ] ]

element experiment : trinity
    public width      : i32    [ 480 ]
    public height     : i32    [ 560 ]
    public background : string [ 'ExperimentBackground' ]
    public title      : string [ 'experiment' ]
    # the framework shade — the only thing this window shows
    public ux_generics : bool [ true ]
    public tint        : rgba [ '#e0508c' ]

    public func render [] -> Elements
        return Elements [
            "mid": MidButton [ label: 'click me' ]
        ]
