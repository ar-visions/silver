# backdrop scenes: exported for any app to read in at runtime
export 0.1.0
export scenes ['Earth', 'Moon', 'Mars', 'Terra', 'Olympus', 'MilkyWay', 'Titan', 'Europa', 'Enceladus', 'Uranus', 'Neptune', 'Pluto']

import vec
import img
import gltf
import trinity

import <stdio.h>
import <stdlib.h>

enum PurpleSurface
    color        : 0
    cloud        : 1

enum EarthSurface
    color        : 0
    normal       : 1
    elevation    : 2
    water        : 3
    water_blur   : 4
    cloud        : 5
    bathymetry   : 6
    lights       : 7

ModelViewProject EarthShader
    mutable _pad0   : f32
    mutable _pad1   : f32
    mutable _pad2   : f32
    mutable cam_pos : vec4f

    attrib color        : LayoutBinding [ type:typeid[ EarthSurface ], id:EarthSurface.color,      count:1, format: typeid[ rgba8 ] ]
    attrib normal       : LayoutBinding [ type:typeid[ EarthSurface ], id:EarthSurface.normal,     count:1, format: typeid[ rgba8 ] ]
    attrib elevation    : LayoutBinding [ type:typeid[ EarthSurface ], id:EarthSurface.elevation,  count:1, format: typeid[ rgba8 ] ]
    attrib water        : LayoutBinding [ type:typeid[ EarthSurface ], id:EarthSurface.water,      count:1, format: typeid[ rgba8 ] ]
    attrib water_blur   : LayoutBinding [ type:typeid[ EarthSurface ], id:EarthSurface.water_blur, count:1, format: typeid[ rgba8 ] ]
    attrib cloud        : LayoutBinding [ type:typeid[ EarthSurface ], id:EarthSurface.cloud,      count:1, format: typeid[ rgba8 ] ]
    attrib bathymetry   : LayoutBinding [ type:typeid[ EarthSurface ], id:EarthSurface.bathymetry, count:1, format: typeid[ rgba8 ] ]
    attrib lights       : LayoutBinding [ type:typeid[ EarthSurface ], id:EarthSurface.lights,     count:1, format: typeid[ rgba8 ] ]

    attrib a_pos        : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal     : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv         : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_normal     : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_uv         : VertexOutput  [ type:typeid[ vec2f ] ]
    attrib v_tangent    : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_bitangent  : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_world_pos  : VertexOutput  [ type:typeid[ vec4f ] ]

    attrib fragColor    : FragmentOutput[ type:typeid[ vec4f ] ]

    func init[]
        fov_deg : 60.0f
        aspect  : 1920.0f / 1080.0f
        near    : 0.1f
        far     : 100.0f
        eye2    : vec3f [0.0f,  0.0f,  1.5f]
        target2 : vec3f [0.0f,  0.0f,  0.0f]
        up2     : vec3f [0.0f, -1.0f,  0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[70.0f], 1.0f, 0.1f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func rotateY [ angle: f32 ] -> GLSL mat3f {
        float c = cos(angle);
        float s = sin(angle);
        return mat3(
            vec3(c, 0.0, -s),
            vec3(0.0, 1.0, 0.0),
            vec3(s, 0.0, c)
        );
    }

    func sdf_sphere [ p: vec3f, radius: f32, squash: f32 ] -> GLSL float {
        // squash factor < 1.0 flattens vertically
        vec3 q = vec3(p.x, p.y / squash, p.z);
        return length(q) - radius;
    }

    func sdf_cylinder [ p: vec3f, h: f32, r: f32 ] -> GLSL float {
        vec2 d = abs(vec2(length(p.xz), p.y)) - vec2(r, h);
        return min(max(d.x, d.y), 0.0) + length(max(d, vec2(0.0)));
    }

    # permutation function
    func permute4 [ x: vec4f ] -> GLSL vec4f {
        return mod((x * 34.0 + 1.0) * x, vec4(289.0));
    }

    # fast inverse sqrt
    func taylorInvSqrt4 [ r: vec4f ] -> GLSL vec4f {
        return 1.79284291400159 - 0.85373472095314 * r;
    }

    # smootherstep fade curve
    func fade [ t: vec3f ] -> GLSL vec3f {
        return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
    }

    # basic perlin 3D noise
    func perlin3D [ P: vec3f ] -> GLSL float {
        vec3 Pi0 = mod(floor(P), vec3(289.0));
        vec3 Pi1 = mod(Pi0 + vec3(1.0), vec3(289.0));
        vec3 Pf0 = fract(P);
        vec3 Pf1 = Pf0 - vec3(1.0);

        vec4 ix = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
        vec4 iy = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
        vec4 iz0 = vec4(Pi0.z);
        vec4 iz1 = vec4(Pi1.z);

        vec4 ixy = permute4(permute4(ix) + iy);
        vec4 ixy0 = permute4(ixy + iz0);
        vec4 ixy1 = permute4(ixy + iz1);

        vec4 gx0 = fract(ixy0 / 7.0) * 2.0 - 1.0;
        vec4 gy0 = fract(floor(ixy0 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz0 = 1.0 - abs(gx0) - abs(gy0);

        vec4 gx1 = fract(ixy1 / 7.0) * 2.0 - 1.0;
        vec4 gy1 = fract(floor(ixy1 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz1 = 1.0 - abs(gx1) - abs(gy1);

        vec4 sz0 = step(gz0, vec4(0.0));
        gx0 -= sz0 * (step(0.0, gx0) - 0.5);
        gy0 -= sz0 * (step(0.0, gy0) - 0.5);

        vec4 sz1 = step(gz1, vec4(0.0));
        gx1 -= sz1 * (step(0.0, gx1) - 0.5);
        gy1 -= sz1 * (step(0.0, gy1) - 0.5);

        vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
        vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
        vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
        vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
        vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
        vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
        vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
        vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);

        vec4 norm0 = taylorInvSqrt4(vec4(dot(g000, g000), dot(g010, g010), dot(g100, g100), dot(g110, g110)));
        g000 *= norm0.x;
        g010 *= norm0.y;
        g100 *= norm0.z;
        g110 *= norm0.w;
        vec4 norm1 = taylorInvSqrt4(vec4(dot(g001, g001), dot(g011, g011), dot(g101, g101), dot(g111, g111)));
        g001 *= norm1.x;
        g011 *= norm1.y;
        g101 *= norm1.z;
        g111 *= norm1.w;

        float n000 = dot(g000, Pf0);
        float n100 = dot(g100, vec3(Pf1.x, Pf0.y, Pf0.z));
        float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
        float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
        float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
        float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
        float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
        float n111 = dot(g111, Pf1);

        vec3 fade_xyz = fade(Pf0);
        vec4 n_z = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fade_xyz.z);
        vec2 n_yz = mix(n_z.xy, n_z.zw, fade_xyz.y);
        float n_xyz = mix(n_yz.x, n_yz.y, fade_xyz.x);

        return n_xyz * 0.5 + 0.5;
    }

    # fractal brownian motion (fbm) using perlin noise
    func fbm [ pos: vec3f, y_translate: f32 ] -> GLSL float {
        float value = 0.0;
        float amplitude = 0.5;
        float frequency = 0.1;
        for (int i = 0; i < 6; ++i) {
            value += amplitude * perlin3D(pos * frequency + vec3(0.0, y_translate * 11.0, 0.0));
            amplitude *= 0.5;
            frequency *= 2.0;
        }
        return value;
    }

    func atmos_tint [ surf: vec3f, n: vec3f, vdir: vec3f, sdir: vec3f ] -> GLSL vec3f {
        float ndv      = max(dot(n, vdir), 0.0);
        float raw_sl   = dot(n, sdir);
        float cosZ     = max(raw_sl, -0.10);
        float air_mass = 1.0 / (cosZ + 0.22);

        vec3  sigma         = vec3(0.06, 0.15, 0.38);
        vec3  transmittance = exp(-sigma * air_mass);
        float sun_intensity = smoothstep(-0.10, 0.18, raw_sl);
        vec3  sun_c         = transmittance * (0.4 + 1.8 * sun_intensity);

        // atmospheric extinction — wide GENTLE fade from surface through blue
        // atmosphere into space clear-color, no hard silhouette during day.
        float limb_rim  = pow(1.0 - ndv, 5.0);
        float limb_soft = pow(1.0 - ndv, 2.2);
        float limb_wide = pow(1.0 - ndv, 0.9);    // very wide soft ramp
        float day_f     = smoothstep(0.00, 0.35, raw_sl);
        float grazing   = smoothstep(-0.20, 0.08, raw_sl) * smoothstep(0.55, 0.08, raw_sl);

        vec3  rayleigh = vec3(0.14, 0.40, 0.92);
        vec3  tint     = rayleigh * day_f * 0.70 + sun_c * grazing * 1.6;

        // fade to scene clear color at silhouette, matches background exactly.
        vec3  space_c    = vec3(0.088, 0.088, 0.188);
        vec3  surf_faded = mix(surf, space_c, clamp(limb_wide, 0.0, 1.0));

        // in-scatter tint peaks INSIDE the disk (gated by ndv), NOT at the
        // silhouette — so silhouette pixel = space_c = background, no edge.
        float in_scatter = ndv * limb_soft;
        float mix_amt    = in_scatter * (0.15 + 0.40 * day_f);
        return mix(surf_faded, tint, clamp(mix_amt, 0.0, 0.50));
    }

    func fragment[] -> GLSL none {
        vec2 uv = v_uv;

        // === Lighting setup ===
        // locals are prefixed (n_/w_/b_/e_/l_/c_) so they don't shadow the
        // sampler2Ds named `normal`/`water`/`bathymetry`/`elevation`/`lights`/`color`.
        vec3 n_view   = normalize(v_normal);
        vec3 sun_dir  = normalize(vec3(0.2, 0.0, 0.8)); // fixed light source
        vec3 view_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);

        vec3  normal_map        = texture(normal, v_uv).rgb * 2.0 - 1.0;
        mat3  TBN               = mat3(normalize(v_tangent), normalize(v_bitangent), n_view);
        vec3  perturbed_normal2 = normalize(TBN * normal_map);

        float NdotL    = max(dot(perturbed_normal2, sun_dir), 0.0);
        vec3  half_dir = normalize(sun_dir + view_dir);
        float spec     = pow(max(dot(perturbed_normal2, half_dir), 0.0), 28.0);

        // === Textures ===
        vec3  albedo = texture(color, uv).rgb;

        float w_amt  = texture(water, uv).r;
        float clouds = texture(cloud,      uv).r;
        float e_amt  = texture(elevation,  uv).r;
        float b_amt  = texture(bathymetry, uv).r;
        float l_amt  = texture(lights,     uv).r;

        // === Water coloring ===
        vec3 water_color = mix(vec3(0.0, 0.1, 0.1), vec3(0.2, 0.6, 1.0), b_amt);
        albedo = mix(albedo, water_color, w_amt);

        // === Elevation / bathymetry tint ===
        float elevation_effect = smoothstep(0.5, 1.0, e_amt);
        float bathy_effect     = w_amt * smoothstep(0.0, 0.5, b_amt);
        vec3  terrain_tint     = mix(vec3(0.8, 0.6, 0.3), vec3(0.2, 0.4, 0.7), bathy_effect);
        albedo = mix(albedo, terrain_tint, 0.3 * bathy_effect + 0.2 * elevation_effect);

        // === Specular reflection on water ===
        float edge_fade = pow(1.0 - dot(perturbed_normal2, view_dir), 2.0);
        vec3  specular  = vec3(1.0) * spec * 0.4 * w_amt;
        specular       += vec3(1.0) * w_amt * edge_fade;

        // === Ambient + Diffuse ===
        float ambient = 0.01;
        vec3  final   = albedo * (ambient + NdotL) + specular;

        // === Optional Gamma Correction (sRGB)
        vec3 f1 = pow(final, vec3(1.0 / 1.8));
        vec3 f2 = pow(final, vec3(1.0 / 6.4));

        float NdotV = max(0.0, pow(1.0 - dot(perturbed_normal2, view_dir), 1.0)) * 2.0;

        // animated FBM-based distortion
        float t = ubo.time * 0.2;
        vec3  offset  = vec3(uv * 50.0, t * 0.3) * 10.0;
        float noise_x = fbm(offset + vec3(100.0, 0.0, 0.0), 0.0);
        float noise_y = fbm(offset + vec3(0.0, 500.0, 0.0), 0.0);
        float noise_z = fbm(offset + vec3(0.0, 0.0,  15.0), 0.0);

        vec3 distortion       = normalize(vec3(noise_x, noise_y, noise_z) * 2.0 - 1.0) * 0.06;
        vec3 perturbed_normal = normalize(perturbed_normal2 + distortion);

        float spec2 = 0.0;

        // === Add tight central specular glint ===
        spec2 += max(0.0, pow(dot(n_view, view_dir), 244.0) * 0.88);

        float e = texture(elevation, v_uv).x;

        vec3 earth_rgb = mix(f1, f2, spec2) + vec3(e * 2.2 * spec2) * vec3(0.8, 1.0, 0.8);
        earth_rgb      = atmos_tint(earth_rgb, n_view, view_dir, sun_dir);
        fragColor = vec4(earth_rgb, 1.0);
    }

    func vertex[] -> GLSL none {
        const float M_PI = 3.1415926535897932384;

        v_uv        = vec2(1.0 - a_uv.x, a_uv.y);
        float theta = v_uv.x * 2.0 * M_PI; // longitude
        float phi   = v_uv.y * M_PI;       // latitude

        // Tangent: derivative of position w.r.t. u (around equator)
        v_tangent = normalize(vec3(-sin(theta), 0.0, cos(theta)));

        // Bitangent: derivative w.r.t. v (from pole to pole)
        v_bitangent = normalize(cross(v_tangent, a_pos)); // orthogonalized

        // Correctly rotate normal into world space
        mat3 normal_matrix = transpose(inverse(mat3(ubo.model)));
        v_normal    = normalize(normal_matrix * a_normal);
        v_tangent   = normalize(normal_matrix * v_tangent);
        v_bitangent = normalize(normal_matrix * v_bitangent);

        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }


EarthShader OceanShader
    func fragment[] -> GLSL none {
        vec2 uv = v_uv;

        // === Lighting setup ===
        // locals are prefixed (n_/w_/c_/b_) so they don't shadow the
        // sampler2Ds named `normal`/`water`/`cloud`/`bathymetry`/etc.
        vec3 n_view = normalize(v_normal);

        // animated FBM-based distortion
        float t = ubo.time * 0.2;
        vec3 offset = vec3(uv * 100.0, t * 0.3) * 5.0;
        float noise_x = fbm(offset + vec3(100.0, 0.0, 0.0), 0.0);
        float noise_y = fbm(offset + vec3(0.0, 500.0, 0.0), 0.0);
        float noise_z = fbm(offset + vec3(0.0, 0.0, 15.0), 0.0);

        // fade the ripple once its cycle drops under a pixel: it dashes.
        // gate on the TOP octave, not the base coordinate: fbm runs 6
        // octaves from 0.1 doubling to 3.2, so the finest detail is at
        // uv*1600, and 500 leaves it half-on while it is already aliasing
        float d_px = fwidth(uv.x) * 1600.0;
        float d_aa = clamp(1.0 - d_px, 0.0, 1.0);
        vec3 distortion = normalize(vec3(noise_x, noise_y, noise_z) * 2.0 - 1.0) * 0.084 * d_aa;
        vec3 perturbed_normal = normalize(n_view + distortion);

        vec3 sun_dir  = normalize(vec3(0.2, 0.0, 0.8));
        vec3 view_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);

        float NdotL   = max(dot(perturbed_normal, sun_dir), 0.0);
        vec3 half_dir = normalize(sun_dir + view_dir);

        // sharp Blinn-Phong highlight — tight sun glint on water.
        // fresnel boost makes grazing-angle water mirror-like.
        float spec    = pow(max(dot(perturbed_normal, half_dir), 0.0), 96.0);
        float fresnel = pow(1.0 - max(dot(perturbed_normal, view_dir), 0.0), 5.0);
        // gate on the true normal: a perturbed one sparkles past the terminator
        float day_s   = smoothstep(-0.02, 0.12, dot(n_view, sun_dir));
        spec          = (spec + fresnel * 0.3) * 3.0 * day_s;

        // === Textures ===
        const float kernel[7] = float[](
            0.006, 0.061, 0.242, 0.383, 0.242, 0.061, 0.006
        );

        vec2 texel = 1.0 / vec2(textureSize(cloud, 0));
        float c_amt = 0.0;

        for (int i = -3; i <= 3; ++i) {
            for (int j = -3; j <= 3; ++j) {
                vec2 offset = vec2(i, j) * texel * 2.0;
                float weight = kernel[i + 3] * kernel[j + 3];
                c_amt += texture(cloud, uv + offset).r * weight;
            }
        }

        float w_amt = (texture(water, uv).r + texture(water_blur, uv).r) / 2.0;

        // === Water coloring ===
        vec3 water_color = vec3(0.022, 0.11, 0.22);

        // === Specular reflection on water ===
        float edge_fade = pow(1.0 - dot(n_view, view_dir), 2.0);
        // sun glint scaled by NdotL so we don't see highlights on night side
        vec3 s1 = vec3(1.0, 0.98, 0.92) * spec * w_amt * NdotL;
        s1 += vec3(0.1, 0.2, 0.3) * w_amt * edge_fade;

        float ambient = 0.005;

        water_color -= c_amt * (0.22 * (1.0 - (2.0 * spec)));
        vec3 final = water_color * (ambient + NdotL) + s1;

        float facing = max(0.0, pow(dot(n_view, view_dir), 144.0) * 0.44);
        vec3 glint   = vec3(1.0) * facing;

        float b_amt = texture(bathymetry, uv).r;
        vec3 water_color2 = vec3(0.4, 0.4, 0.4) * b_amt;

        vec4 ocean_out = mix(vec4(water_color2 + glint, w_amt), vec4(final, w_amt), 1.0 - (glint.x * 1.44));
        ocean_out.rgb  = atmos_tint(ocean_out.rgb, n_view, view_dir, sun_dir);
        fragColor      = ocean_out;
    }

    func vertex[] -> GLSL none {
        v_uv           = vec2(1.0 - a_uv.x, a_uv.y);

        // Correctly rotate normal into world space
        mat3 normal_matrix = transpose(inverse(mat3(ubo.model)));
        v_normal = normalize(normal_matrix * a_normal);

        float scale     = 0.00044;
        vec3  surface   = a_pos + (a_normal * 1.0 * scale);
        vec4  wpos      = ubo.model * vec4(surface, 1.0);
        v_world_pos     = wpos;
        gl_Position     = ubo.proj * ubo.view * wpos;
    }

EarthShader CloudShader
    attrib v_cloud_avg  : VertexOutput [ type:typeid[ f32 ] ]

    func vertex[] -> GLSL none {
        v_uv = vec2(1.0 - a_uv.x, a_uv.y);

        // Correctly rotate normal into world space
        mat3 normal_matrix = transpose(inverse(mat3(ubo.model)));
        v_normal = normalize(normal_matrix * a_normal);

        // === Pre-blur the cloud sample with a 7-tap separable kernel,
        //     so the fragment can do `cloud / (2.0 - v_cloud_avg)` for
        //     a smoother contrast normalization than the raw sample.
        const float kernel[7] = float[](
            0.006, 0.061, 0.242, 0.383, 0.242, 0.061, 0.006
        );

        vec2  texel = 1.0 / vec2(textureSize(cloud, 0));
        float c_avg = 0.0;

        for (int i = -3; i <= 3; ++i) {
            for (int j = -3; j <= 3; ++j) {
                vec2  offset = vec2(i, j) * texel * 2.0;
                float weight = kernel[i + 3] * kernel[j + 3];
                c_avg += texture(cloud, v_uv + offset).r * weight;
            }
        }

        v_cloud_avg = c_avg;

        float scale   = 0.008; //0.0044 + clouds * 0.0044;
        vec3  surface = a_pos + (a_normal * 1.0 * scale);
        vec4  wpos    = ubo.model * vec4(surface, 1.0);
        v_world_pos   = wpos;
        gl_Position   = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        vec2 uv = v_uv;

        vec3 n_view   = normalize(v_normal);
        vec3 sun_dir  = normalize(vec3(0.2, 0.0, 0.8)); // fixed light source
        vec3 view_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);

        float NdotL    = max(dot(n_view, sun_dir), 0.0);
        vec3  half_dir = normalize(sun_dir + view_dir);
        float spec     = pow(max(dot(n_view, half_dir), 0.0), 128.0);

        float c_amt = texture(cloud, uv).x / (2.0 - v_cloud_avg);

        float ndv = max(dot(n_view, view_dir), 0.0);
        // silhouette fade: ramps back to 0 at the geometric limb so we don't
        // slam a bright rim into jagged mesh-edge pixels. widened further for
        // a very gentle transition into the background.
        float silh_fade = smoothstep(0.0, 0.24, ndv);
        float edge      = pow(1.0 - ndv, 4.0) * silh_fade;
        float rim       = pow(1.0 - ndv, 2.0) * silh_fade;
        float limb_wide = pow(1.0 - ndv, 0.9);
        c_amt *= clamp(1.0 - limb_wide, 0.0, 1.0);

        // === physical sun color through atmosphere — Beer/Rayleigh.
        // air_mass ≈ 1/cos(zenith) = 1/NdotL; clamped so terminator still glows.
        // per-channel optical depth: blue scatters ~5x red, giving the real
        // white→yellow→orange→red progression as the sun descends toward horizon.
        float raw_sl = dot(n_view, sun_dir);
        // Kasten-Young-ish soft secant: flattens air_mass near the horizon
        // so reds/yellows don't blow out saturation at the terminator.
        float cosZ     = max(raw_sl, -0.10);
        float air_mass = 1.0 / (cosZ + 0.22);

        vec3  sigma         = vec3(0.06, 0.15, 0.38);
        vec3  transmittance = exp(-sigma * air_mass);

        float sun_intensity = smoothstep(-0.10, 0.18, raw_sl);
        vec3  sun_color     = transmittance * (0.4 + 1.8 * sun_intensity);

        float day     = smoothstep(0.00, 0.35, raw_sl);
        // grazing = terminator aura strength (peaks where sun just grazes horizon)
        float grazing = smoothstep(-0.20, 0.08, raw_sl) * smoothstep(0.55, 0.08, raw_sl);

        vec3 base_color = vec3(1.0) * (0.12 + 0.88 * day);
        vec3 haze_color = mix(base_color, sun_color, edge);

        // === Day atmosphere = ULTRA soft extended glow, not a glass dome.
        // wide gaussian so the color bleeds far into the disk AND out toward
        // space; low alpha overall means the cloud shell lets earth show
        // through while gaining an atmospheric glow on top.
        vec3  col_deep   = vec3(0.25, 0.55, 0.98);
        vec3  col_light  = vec3(0.55, 0.75, 1.00);
        float band       = exp(-pow((ndv - 0.18) / 0.22, 2.0));   // much wider, peak deeper in
        float inward     = smoothstep(0.02, 0.25, ndv);
        vec3  limb_c     = mix(col_light, col_deep, inward);
        float alpha_fade = smoothstep(0.0, 0.10, ndv);
        vec3  day_limb   = limb_c * band * alpha_fade * 0.55 * day;
        float day_haze   = band * alpha_fade * 0.55 * day;

        // === aura: warm crescent at terminator limb — smooth everywhere,
        // silh_fade guarantees no sharp edge at silhouette.
        float aura_gain = grazing * edge * 2.0;
        vec3  aura      = sun_color * aura_gain;

        // === aurora: uses the same fbm as Earth/Ocean distortion, integrated
        // across the atmosphere depth. the cloud shell sits from earth surface
        // up to atmosphere top; sample several depths along world-space and sum
        // for a volumetric look. night-side only, polar-concentrated.
        float night_f = smoothstep(0.05, -0.25, raw_sl);
        float polar   = pow(1.0 - abs(n_view.y), 1.5);
        float t_a     = ubo.time * 0.25;
        // ray-march 4 altitude slices along the view direction. stepping
        // inward toward earth gives parallax + color stratification — lower
        // altitudes emit green (atomic oxygen ~557nm), higher emit magenta/
        // red (~630nm + nitrogen pinks). summed + weighted by altitude.
        // === TRUE volumetric ray-march through a VIRTUAL aurora shell.
        // aurora in reality spans ~100-400km altitude (0.016-0.063 units).
        // we march through that entire thick volume, NOT the thin cloud shell.
        // ray/sphere intersections give real slice; 12 samples along it.
        // shells are earth-local; the sky earth is not at the origin
        mat4  m_inv   = inverse(ubo.model);
        vec3  ro      = (m_inv * vec4(ubo.cam_pos.xyz, 1.0)).xyz;
        vec3  rd      = normalize((m_inv * v_world_pos).xyz - ro);
        float R_top   = 1.044;                         // aurora top (~400km)
        float R_bot   = 1.022;                         // aurora bottom (~90km)
        float R_earth = 1.000;
        float b       = dot(ro, rd);
        float c_top   = dot(ro, ro) - R_top   * R_top;
        float c_bot   = dot(ro, ro) - R_bot   * R_bot;
        float c_earth = dot(ro, ro) - R_earth * R_earth;

        float disc_top   = b * b - c_top;
        float disc_bot   = b * b - c_bot;
        float disc_earth = b * b - c_earth;

        // ray must enter the top shell for aurora to exist along it
        float t_enter = -b - sqrt(max(disc_top, 0.0));
        float t_exit  = -b + sqrt(max(disc_top, 0.0));

        // clip to the near side of the bottom shell (first earth-ward boundary)
        if (disc_bot > 0.0) {
            float t_bot_near = -b - sqrt(disc_bot);
            if (t_bot_near > t_enter) t_exit = min(t_exit, t_bot_near);
        }
        // clip against earth occlusion (ray hits earth before aurora exit)
        if (disc_earth > 0.0) {
            float t_earth = -b - sqrt(disc_earth);
            if (t_earth > t_enter) t_exit = min(t_exit, t_earth);
        }

        float slice_len = max(t_exit - t_enter, 0.0);
        vec3  aur_low   = vec3(0.15, 1.00, 0.55);
        vec3  aur_high  = vec3(0.85, 0.30, 0.90);
        vec3  aur_sum   = vec3(0.0);
        float dens      = 0.0;

        // 12-sample ray-march — real 3D positions, altitude colors, front-to-back.
        for (int i = 0; i < 12; i++) {
            float ki  = (float(i) + 0.5) / 12.0;
            vec3  wp  = ro + rd * (t_enter + slice_len * ki);
            float alt = length(wp) - R_earth;
            float alt_n = clamp((alt - (R_bot - R_earth)) / (R_top - R_bot), 0.0, 1.0);

            if (disc_top <= 0.0 || slice_len <= 0.0) break;

            // lower frequency + softer threshold = larger, hazier shapes,
            // still gated so aurora has form rather than a smooth fog.
            vec3  sp   = wp * 28.0 + vec3(0.0, t_a + ki * 2.0, 0.0);
            float ss   = fbm(sp, ki * 0.4);
            float sc   = smoothstep(0.44, 0.72, ss);
            // front-to-back attenuation keeps parallax readable
            float atten = 1.0 - ki * 0.35;
            aur_sum += mix(aur_high, aur_low, alt_n) * sc * atten;
            dens    += sc * atten;
        }

        float curtain = smoothstep(0.4, 3.0, dens);
        vec3  aur_col = aur_sum / max(dens, 0.01);
        // depth proxy through haze — limb looks through more atmosphere.
        // silh_fade keeps aurora from clipping hard at the mesh silhouette.
        float depth_f  = pow(1.0 - ndv, 2.0) * silh_fade;
        float aurora_g = night_f * polar * curtain * depth_f * 2.2;
        vec3  aurora   = aur_col * aurora_g;

        vec3  color_out   = haze_color + aura + day_limb + aurora;
        float cloud_alpha = c_amt + edge * 0.4 + aura_gain * 0.5 + day_haze * 0.7 + aurora_g * 0.8;

        fragColor = vec4(color_out, cloud_alpha);
    }


element Earth
    frost : true
    # eased camera distance / angle; p_set marks the first frame
    intern e_cur  : f32
    intern p_cur  : f32
    intern p_set  : bool
    intern earth  : EarthShader
    intern ocean  : OceanShader
    intern cloud  : CloudShader
    intern models : array Model
    intern target : Render
    intern built  : bool
    # async load: worker decodes, draw waits on ready for vk work
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    public color  : rgba [ r:0.022, g:0.088, b:0.122, a:1.0 ]

    func build_models[]
        built     = true
        gltf_path : path '../scenes/models/earth.gltf'
        gltf      : GltfModel.open[ gltf_path ]
        earth     = EarthShader [ vk: vk ]
        ocean     = OceanShader [ vk: vk ]
        cloud     = CloudShader [ vk: vk ]
        #purple = Purple [ vk: vk ]

        u : path '../scenes/textures/earth-color-8192x4096.png'
        earth_color : Image [ uri: u, surface: EarthSurface.color ]
        earth_samplers : map Image [string] [
            'color':      earth_color,
            'normal':     Image [ uri: path '../scenes/textures/earth-normal-8192x4096.png',     surface: EarthSurface.normal ],
            'elevation':  Image [ uri: path '../scenes/textures/earth-elevation-8192x4096.png',  surface: EarthSurface.elevation ],
            'water':      Image [ uri: path '../scenes/textures/earth-water-8192x4096.png',      surface: EarthSurface.water ],
            'water_blur': Image [ uri: path '../scenes/textures/earth-water-blur-8192x4096.png', surface: EarthSurface.water_blur ],
            'cloud':      Image [ uri: path '../scenes/textures/earth-cloud-8192x4096.png',      surface: EarthSurface.cloud ],
            'bathymetry': Image [ uri: path '../scenes/textures/earth-bathymetry-8192x4096.png', surface: EarthSurface.bathymetry ],
            'lights':     Image [ uri: path '../scenes/textures/earth-lights-8192x4096.png',     surface: EarthSurface.lights ]
        ]
        earth_model : Model [ vk: vk, w: ux, id: gltf, s: earth, samplers: earth_samplers, straight_alpha: true ]
        ocean_model : Model [ vk: vk, w: ux, id: gltf, s: ocean, samplers: earth_samplers, straight_alpha: true ]
        cloud_model : Model [ vk: vk, w: ux, id: gltf, s: cloud, samplers: earth_samplers, straight_alpha: true ]
        models      = array Model [ earth_model, ocean_model, cloud_model ]

    # own render pass; the window composites its color as the backdrop
    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        ux.element_targets[ id ] = target

    # unregister only; we keep our ref so the GPU graph outlives the frame
    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    func load_bg [ arg: object ]
        t0 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg start at {t0}'
        build_models[]
        t1 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg done in {t1 - t0}ms at {t1}'
        ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : array []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: @load_bg, work: w9 ]
        if [ !ready ] return
        create_target[]
        orbit[]

    func orbit[]
        # ux.time is KILOseconds: x64 advanced 0.016 deg a second, which
        # is slower than the per-frame jitter that used to sit under it
        time : ux.time * 1460.0
        if [time == 0.0]
            time = -54.0
        # a surface flyover: altitude above the ground, not eye distance.
        # low is the original 0.063 -- the ladder only goes outward
        a_t      : f32 [ (ux.orbit_mode == OrbitView.low)  ? 0.063 :
                         (ux.orbit_mode == OrbitView.high) ? 0.200 : 0.600 ]
        if [ e_cur == 0.0 ] e_cur = a_t
        e_cur = filter_n[ e_cur, a_t, 0.08, ux.frame_factor ]
        altitude : f32 [ e_cur ]
        eye_dist : f32 [ 1.0 + altitude ]
        # aim, in degrees off NADIR. flat must be 0 or it points away
        # from the planet centre and the body sits off-frame at far orbit
        t_deg    : f32 [ (ux.angle_mode == ViewAngle.flat)   ? 0.0 :
                         (ux.angle_mode == ViewAngle.angled) ? 50.0 : 68.0 ]
        if [ p_cur == 0.0 && !p_set ] p_cur = t_deg
        p_set    = true
        p_cur    = filter_n[ p_cur, t_deg, 0.08, ux.frame_factor ]
        # set AFTER both eases, and OR them: whichever is still moving
        # has to hold the frame skip off
        ux.orbit_moving = abs[ e_cur - a_t ] > 0.0004 || abs[ p_cur - t_deg ] > 0.05
        tilt     : f32 [ radians[ p_cur ] ]
        # follow the window, never a fixed 16:9 -- a hardcoded aspect
        # stretches the disc the moment the window is not that shape
        aspect   : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]

        # NO per-frame nudge here: `time` is a local recomputed from
        # ux.time every frame, so a -= cannot accumulate. all it did
        # was add frame_factor's millisecond jitter on top
        orbit_a : radians[ time ]
        co      : cos[ orbit_a ]
        so      : sin[ orbit_a ]

        ex_l  : f32 [ 0.0 ]
        ey_l  : f32 [ 0.0 ]
        ez_l  : f32 [ eye_dist ]
        fx_l  : f32 [ -sin[ tilt ] ]
        fy_l  : f32 [ 0.0 ]
        fz_l  : f32 [ -cos[ tilt ] ]
        tx_l  : f32 [ ex_l + fx_l * 2.0 ]
        ty_l  : f32 [ ey_l + fy_l * 2.0 ]
        tz_l  : f32 [ ez_l + fz_l * 2.0 ]
        ux_l  : f32 [ 1.0 ]
        uy_l  : f32 [ 0.0 ]
        uz_l  : f32 [ 0.0 ]

        # rotate each vector around Y by orbit_a
        _eye2    : vec3f [  co * ex_l + so * ez_l, ey_l, -so * ex_l + co * ez_l ]
        _target2 : vec3f [  co * tx_l + so * tz_l, ty_l, -so * tx_l + co * tz_l ]
        _up2     : vec3f [  co * ux_l + so * uz_l, uy_l, -so * ux_l + co * uz_l ]

        _model   : mat4f.identity   []
        _proj    : mat4f.perspective[ radians[ 60.0 ], aspect, 0.001, 10.0 ]
        _view    : mat4f.look_at    [ _eye2, _target2, _up2 ]

        # earth no longer spins — only the optional axial tilt stays
        tilt_axis : vec4f [ 1.0, 0.0, 0.0, radians[ 0 ] ]
        q_tilt    : quatf [ tilt_axis ]
        m : mat4f.identity[]
        m = m.rotate[ q_tilt ]

        earth.model = m
        earth.view  = _view
        earth.proj  = _proj

        ocean.model = m
        ocean.view  = _view
        ocean.proj  = _proj

        cloud.model = m
        cloud.view  = _view
        cloud.proj  = _proj

        _cam : vec4f [ _eye2.x, _eye2.y, _eye2.z, 1.0 ]

        earth.time    = time
        ocean.time    = time
        cloud.time    = time
        earth.cam_pos = _cam
        ocean.cam_pos = _cam
        cloud.cam_pos = _cam


# vantage the scenes share; each maps it to its own distance, since
# a globe view and a surface flyover need very different numbers
enum OrbitView
    low  : 0
    high : 1
    far  : 2
    wide : 3

# how far off flat-on the camera sits. a globe scene reads it as pitch
# above the equator; a surface flyover reads it as how far its aim
# swings up toward the horizon
enum ViewAngle
    flat   : 0
    angled : 1
    steep  : 2

enum MoonSurface
    color  : 0
    height : 1
    cloud  : 2
    jungle : 3

ModelViewProject MoonShader
    mutable gain     : f32
    mutable regolith : f32
    # relief from the height map; 0 leaves the normal alone
    mutable relief   : f32
    mutable cam_pos : vec4f

    attrib color  : LayoutBinding [ type:typeid[ MoonSurface ], id:MoonSurface.color,  count:1, format: typeid[ rgba8 ] ]
    attrib height : LayoutBinding [ type:typeid[ MoonSurface ], id:MoonSurface.height, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos        : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal     : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv         : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_normal     : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_uv         : VertexOutput  [ type:typeid[ vec2f ] ]
    attrib v_world_pos  : VertexOutput  [ type:typeid[ vec4f ] ]

    attrib fragColor    : FragmentOutput[ type:typeid[ vec4f ] ]

    func init[]
        eye2    : vec3f [0.0f,  0.0f,  1.5f]
        target2 : vec3f [0.0f,  0.0f,  0.0f]
        up2     : vec3f [0.0f, -1.0f,  0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[70.0f], 1.0f, 0.1f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_uv        = vec2(1.0 - a_uv.x, a_uv.y);
        mat3 nm     = transpose(inverse(mat3(ubo.model)));
        v_normal    = normalize(nm * a_normal);
        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func hash31 [ p: vec3f ] -> GLSL float {
        return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);
    }

    # value noise; one octave, continent scale is set by the caller
    func vnoise [ p: vec3f ] -> GLSL float {
        vec3 i = floor(p);
        vec3 f = fract(p);
        vec3 u = f * f * (3.0 - 2.0 * f);
        float n000 = hash31(i + vec3(0.0, 0.0, 0.0));
        float n100 = hash31(i + vec3(1.0, 0.0, 0.0));
        float n010 = hash31(i + vec3(0.0, 1.0, 0.0));
        float n110 = hash31(i + vec3(1.0, 1.0, 0.0));
        float n001 = hash31(i + vec3(0.0, 0.0, 1.0));
        float n101 = hash31(i + vec3(1.0, 0.0, 1.0));
        float n011 = hash31(i + vec3(0.0, 1.0, 1.0));
        float n111 = hash31(i + vec3(1.0, 1.0, 1.0));
        return mix(mix(mix(n000, n100, u.x), mix(n010, n110, u.x), u.y),
                   mix(mix(n001, n101, u.x), mix(n011, n111, u.x), u.y), u.z);
    }

    func p_permute4 [ x: vec4f ] -> GLSL vec4f {
        return mod((x * 34.0 + 1.0) * x, vec4(289.0));
    }

    func p_invsqrt4 [ r: vec4f ] -> GLSL vec4f {
        return 1.79284291400159 - 0.85373472095314 * r;
    }

    # gradient noise. value noise interpolates CORNER VALUES, so its
    # isocontours run along the lattice and any mask built on it cuts
    # square edges. gradient noise interpolates corner GRADIENTS and
    # is zero at every lattice point, so nothing aligns to the grid
    func gnoise [ P: vec3f ] -> GLSL float {
        vec3 Pi0 = mod(floor(P), vec3(289.0));
        vec3 Pi1 = mod(Pi0 + vec3(1.0), vec3(289.0));
        vec3 Pf0 = fract(P);
        vec3 Pf1 = Pf0 - vec3(1.0);
        vec4 ix  = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
        vec4 iy  = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
        vec4 iz0 = vec4(Pi0.z);
        vec4 iz1 = vec4(Pi1.z);
        vec4 ixy  = p_permute4(p_permute4(ix) + iy);
        vec4 ixy0 = p_permute4(ixy + iz0);
        vec4 ixy1 = p_permute4(ixy + iz1);
        vec4 gx0 = fract(ixy0 / 7.0) * 2.0 - 1.0;
        vec4 gy0 = fract(floor(ixy0 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz0 = 1.0 - abs(gx0) - abs(gy0);
        vec4 gx1 = fract(ixy1 / 7.0) * 2.0 - 1.0;
        vec4 gy1 = fract(floor(ixy1 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz1 = 1.0 - abs(gx1) - abs(gy1);
        vec4 sz0 = step(gz0, vec4(0.0));
        gx0 -= sz0 * (step(0.0, gx0) - 0.5);
        gy0 -= sz0 * (step(0.0, gy0) - 0.5);
        vec4 sz1 = step(gz1, vec4(0.0));
        gx1 -= sz1 * (step(0.0, gx1) - 0.5);
        gy1 -= sz1 * (step(0.0, gy1) - 0.5);
        vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
        vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
        vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
        vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
        vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
        vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
        vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
        vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);
        vec4 nm0 = p_invsqrt4(vec4(dot(g000,g000), dot(g010,g010), dot(g100,g100), dot(g110,g110)));
        g000 *= nm0.x; g010 *= nm0.y; g100 *= nm0.z; g110 *= nm0.w;
        vec4 nm1 = p_invsqrt4(vec4(dot(g001,g001), dot(g011,g011), dot(g101,g101), dot(g111,g111)));
        g001 *= nm1.x; g011 *= nm1.y; g101 *= nm1.z; g111 *= nm1.w;
        float n000 = dot(g000, Pf0);
        float n100 = dot(g100, vec3(Pf1.x, Pf0.y, Pf0.z));
        float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
        float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
        float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
        float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
        float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
        float n111 = dot(g111, Pf1);
        vec3  fxyz = Pf0 * Pf0 * Pf0 * (Pf0 * (Pf0 * 6.0 - 15.0) + 10.0);
        vec4  n_z  = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fxyz.z);
        vec2  n_yz = mix(n_z.xy, n_z.zw, fxyz.y);
        return mix(n_yz.x, n_yz.y, fxyz.x) * 0.5 + 0.5;
    }

    # three octaves on offset domains, over gradient noise
    func fnoise [ p: vec3f ] -> GLSL float {
        float a = gnoise(p);
        float b = gnoise(p * 2.17 + vec3( 37.2, 11.7, 91.3));
        float c = gnoise(p * 4.41 + vec3(-19.4, 63.1, 27.8));
        return a * 0.56 + b * 0.30 + c * 0.14;
    }

    func fragment[] -> GLSL none {
        vec3  n      = normalize(v_normal);
        vec3  sun    = normalize(vec3(0.2, 0.0, 0.8));
        // relief: tilt the normal by the height gradient, east/north basis
        float e_uv   = 1.0 / 4096.0;
        float h_l    = texture(height, v_uv + vec2(-e_uv, 0.0)).r;
        float h_r    = texture(height, v_uv + vec2( e_uv, 0.0)).r;
        float h_d    = texture(height, v_uv + vec2(0.0, -e_uv)).r;
        float h_u    = texture(height, v_uv + vec2(0.0,  e_uv)).r;
        vec3  t_e    = normalize(cross(vec3(0.0, 1.0, 0.0), n));
        vec3  t_n    = cross(n, t_e);
        vec3  bump   = t_e * (h_l - h_r) + t_n * (h_d - h_u);
        float r_aa   = clamp(1.0 - fwidth(v_uv.x) * 4096.0, 0.0, 1.0);
        n            = normalize(n + bump * ubo.relief * 24.0 * r_aa);
        float ndl    = max(dot(n, sun), 0.0);
        vec3  albedo = texture(color, v_uv).rgb;
        // one blob spans most of the visible ground from low orbit
        float g      = ubo.regolith;
        float nz     = vnoise(normalize(v_world_pos.xyz) * 1.15);
        float ctr    = 1.0 + g * (nz - 0.5) * 0.8;
        vec3  alb    = clamp((albedo - 0.5) * ctr + 0.5, 0.0, 1.0);
        alb          = mix(alb, alb * vec3(1.06, 0.99, 0.90), g * nz);
        alb         *= (1.0 - 0.08 * g);
        // regolith: no specular, a little ambient so the limb reads
        vec3  lit    = alb * (0.05 + 0.95 * ndl) * ubo.gain;
        fragColor    = vec4(lit / (1.0 + lit), 1.0);
    }


element Moon
    frost : true
    frost_sharp : true
    # eased camera distance / angle; p_set marks the first frame
    intern e_cur  : f32
    intern p_cur  : f32
    intern p_set  : bool
    intern moon   : MoonShader
    # the earth in the sky gets the Earth scene's full stack
    intern earth  : EarthShader
    intern ocean  : OceanShader
    intern cloud  : CloudShader
    intern models : array Model
    intern target : Render
    intern built  : bool
    # async load: worker decodes, draw waits on ready for vk work
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    public color  : rgba [ r:0.004, g:0.006, b:0.014, a:1.0 ]

    func build_models[]
        built     = true
        gltf_path : path '../scenes/models/earth.gltf'
        gltf      : GltfModel.open[ gltf_path ]
        moon      = MoonShader  [ vk: vk ]
        earth     = EarthShader [ vk: vk ]
        ocean     = OceanShader [ vk: vk ]
        cloud     = CloudShader [ vk: vk ]

        # the ground: one map, lit flat with the regolith noise
        moon_samplers : map Image [string] [
            'color':  Image [ uri: path '../scenes/textures/moon-color-8192x4096.jpg',    surface: MoonSurface.color ],
            'height': Image [ uri: path '../scenes/textures/moon-displace-2048x1024.png', surface: MoonSurface.height ]
        ]
        earth_samplers : map Image [string] [
            'color':      Image [ uri: path '../scenes/textures/earth-color-8192x4096.png',      surface: EarthSurface.color ],
            'normal':     Image [ uri: path '../scenes/textures/earth-normal-8192x4096.png',     surface: EarthSurface.normal ],
            'elevation':  Image [ uri: path '../scenes/textures/earth-elevation-8192x4096.png',  surface: EarthSurface.elevation ],
            'water':      Image [ uri: path '../scenes/textures/earth-water-8192x4096.png',      surface: EarthSurface.water ],
            'water_blur': Image [ uri: path '../scenes/textures/earth-water-blur-8192x4096.png', surface: EarthSurface.water_blur ],
            'cloud':      Image [ uri: path '../scenes/textures/earth-cloud-8192x4096.png',      surface: EarthSurface.cloud ],
            'bathymetry': Image [ uri: path '../scenes/textures/earth-bathymetry-8192x4096.png', surface: EarthSurface.bathymetry ],
            'lights':     Image [ uri: path '../scenes/textures/earth-lights-8192x4096.png',     surface: EarthSurface.lights ]
        ]
        moon_model  : Model [ vk: vk, w: ux, id: gltf, s: moon,  samplers: moon_samplers,  straight_alpha: true ]
        earth_model : Model [ vk: vk, w: ux, id: gltf, s: earth, samplers: earth_samplers, straight_alpha: true ]
        ocean_model : Model [ vk: vk, w: ux, id: gltf, s: ocean, samplers: earth_samplers, straight_alpha: true ]
        cloud_model : Model [ vk: vk, w: ux, id: gltf, s: cloud, samplers: earth_samplers, straight_alpha: true ]
        models      = array Model [ moon_model, earth_model, ocean_model, cloud_model ]

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        ux.element_targets[ id ] = target

    # unregister only; we keep our ref so the GPU graph outlives the frame
    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    # regolith: the editor's purples go gray under a lunar sky
    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#1c1c20cc',
            '#140a2a80':  '#1c1c2080',
            '#4258':      '#8a8a8a22',
            '#ff6a2e55':  '#9a9a9a55',
            '#220022aa':  '#20202aaa',
            '#614':       '#3c3c42',
            '#413':       '#2e2e34',
            '#826':       '#565660',
            '#625a':      '#333a',
            '#8af2':      '#8882',
            '#425':       '#3a3a42',
            '#44225588':  '#8a8a8a66'
        ]

    func load_bg [ arg: object ]
        t0 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg start at {t0}'
        build_models[]
        t1 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg done in {t1 - t0}ms at {t1}'
        ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : array []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: @load_bg, work: w9 ]
        if [ !ready ] return
        create_target[]
        orbit[]

    func orbit[]
        # ux.time is KILOseconds: x64 advanced 0.016 deg a second, which
        # is slower than the per-frame jitter that used to sit under it
        time : ux.time * 1460.0
        if [time == 0.0]
            time = -54.0
        # a surface flyover: altitude above the ground, not eye distance.
        # low is the original 0.063 -- the ladder only goes outward
        a_t      : f32 [ (ux.orbit_mode == OrbitView.low)  ? 0.063 :
                         (ux.orbit_mode == OrbitView.high) ? 0.200 : 0.600 ]
        if [ e_cur == 0.0 ] e_cur = a_t
        e_cur = filter_n[ e_cur, a_t, 0.08, ux.frame_factor ]
        altitude : f32 [ e_cur ]
        eye_dist : f32 [ 1.0 + altitude ]
        # limb sits at 70.2; aim above it or there is no sky to fill
        # off NADIR: flat is 0 so the body centres at any altitude. the
        # limb sits at 70.2 at low orbit, so steep must clear it for sky
        t_deg    : f32 [ (ux.angle_mode == ViewAngle.flat)   ? 0.0 :
                         (ux.angle_mode == ViewAngle.angled) ? 74.0 : 82.0 ]
        if [ p_cur == 0.0 && !p_set ] p_cur = t_deg
        p_set    = true
        p_cur    = filter_n[ p_cur, t_deg, 0.08, ux.frame_factor ]
        # set AFTER both eases, and OR them: whichever is still moving
        # has to hold the frame skip off
        ux.orbit_moving = abs[ e_cur - a_t ] > 0.0004 || abs[ p_cur - t_deg ] > 0.05
        tilt     : f32 [ radians[ p_cur ] ]
        # follow the window, never a fixed 16:9 -- a hardcoded aspect
        # stretches the disc the moment the window is not that shape
        aspect   : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]

        # NO per-frame nudge here: `time` is a local recomputed from
        # ux.time every frame, so a -= cannot accumulate. all it did
        # was add frame_factor's millisecond jitter on top
        orbit_a : radians[ time ]
        co      : cos[ orbit_a ]
        so      : sin[ orbit_a ]

        ex_l  : f32 [ 0.0 ]
        ey_l  : f32 [ 0.0 ]
        ez_l  : f32 [ eye_dist ]
        fx_l  : f32 [ -sin[ tilt ] ]
        fy_l  : f32 [ 0.0 ]
        fz_l  : f32 [ -cos[ tilt ] ]
        tx_l  : f32 [ ex_l + fx_l * 2.0 ]
        ty_l  : f32 [ ey_l + fy_l * 2.0 ]
        tz_l  : f32 [ ez_l + fz_l * 2.0 ]
        ux_l  : f32 [ 1.0 ]
        uy_l  : f32 [ 0.0 ]
        uz_l  : f32 [ 0.0 ]

        _eye2    : vec3f [  co * ex_l + so * ez_l, ey_l, -so * ex_l + co * ez_l ]
        _target2 : vec3f [  co * tx_l + so * tz_l, ty_l, -so * tx_l + co * tz_l ]
        _up2     : vec3f [  co * ux_l + so * uz_l, uy_l, -so * ux_l + co * uz_l ]

        _proj    : mat4f.perspective[ radians[ 60.0 ], aspect, 0.001, 10.0 ]
        _view    : mat4f.look_at    [ _eye2, _target2, _up2 ]

        # the moon holds the middle
        mm : mat4f.identity[]
        moon.model = mm
        moon.view  = _view
        moon.proj  = _proj
        moon.gain  = 1.0
        moon.regolith = 1.0
        moon.relief   = 0.0

        # fixed in the sky; the limb sits at 70.2 from straight down
        rise   : f32 [ radians[ 14.0 ] ]
        aim    : f32 [ tilt + rise ]
        e_dist : f32 [ 6.0 ]
        e_off  : vec3f [ -e_dist * sin[ aim ], 0.0, eye_dist - e_dist * cos[ aim ] ]
        # world +y is the screen's x axis here; north must follow screen up
        nx_l : f32 [ -cos[ tilt ] ]
        nz_l : f32 [  sin[ tilt ] ]
        n_x  : f32 [  co * nx_l + so * nz_l ]
        n_z  : f32 [ -so * nx_l + co * nz_l ]
        # 90 degrees about this carries the model's +y onto north
        e_axis : vec4f [ n_z, 0.0, -n_x, radians[ 90.0 ] ]
        q_axis : quatf [ e_axis ]
        # ux.time counts kiloseconds: 6000 = one turn per minute
        spin_d : f32 [ ux.time * 6000.0 ]
        e_spin : vec4f [ 0.0, 1.0, 0.0, radians[ spin_d ] ]
        q_spin : quatf [ e_spin ]
        e_sc   : vec3f [ 1.5, 1.5, 1.5 ]
        em : mat4f.identity[]
        em = em.translate[ e_off ]
        em = em.rotate   [ q_axis ]
        em = em.rotate   [ q_spin ]
        em = em.scale    [ e_sc ]
        earth.model = em
        earth.view  = _view
        earth.proj  = _proj
        ocean.model = em
        ocean.view  = _view
        ocean.proj  = _proj
        cloud.model = em
        cloud.view  = _view
        cloud.proj  = _proj

        _cam2 : vec4f [ _eye2.x, _eye2.y, _eye2.z, 1.0 ]
        moon.cam_pos  = _cam2
        earth.cam_pos = _cam2
        ocean.cam_pos = _cam2
        cloud.cam_pos = _cam2
        earth.time    = time
        ocean.time    = time
        cloud.time    = time


MoonShader TerraShader
    # sea level on mars-height; land is the mars color map, unaltered
    mutable sea_level : f32
    # more water at the equator, falling off toward the poles. sea_lat
    # is how much is added at the equator, sea_curve the falloff shape:
    # 1.0 is a straight ramp, higher keeps the extra water in the tropics
    mutable sea_lat   : f32
    mutable sea_curve : f32
    # a very slight wander on the sea level itself, so coastlines are
    # not a pure contour of the height map
    mutable sea_noise : f32
    mutable sea_scale : f32
    # perlin scales picking between the two green and two water tones
    mutable land_scale  : f32
    mutable water_scale : f32
    # forest patches: patch size, strength, and the altitude it dies at
    mutable forest_scale : f32
    mutable forest_amt   : f32
    mutable tree_line    : f32
    mutable veg_amt      : f32
    # ground lifted near the equator, in height-map units (0.01 = 1%)
    mutable eq_rise      : f32
    # land bands above the waterline, in height-map units
    mutable sand_band    : f32
    mutable green_band   : f32
    mutable sand_amt     : f32
    mutable lush_curve   : f32
    # how much cyan the equator takes, and how fast it falls off
    mutable cyan_amt    : f32
    mutable cyan_curve  : f32
    # pink across the equatorial band: strength, and how far out it
    # reaches as a fraction of pole distance (0.667 = two thirds)
    mutable pink_amt    : f32
    mutable pink_span   : f32
    # keep this LOW: one lobe should span an ocean, not speckle it
    mutable pink_scale  : f32
    # depth at which the pink patches start showing (1 = deepest only)
    mutable pink_deep   : f32
    # sun glint: LOW power = wide and soft, high = a tight hot dot
    mutable spec_power  : f32
    mutable spec_amt    : f32
    # the broad sheen under it; keep the amount low, it covers a lot
    mutable wide_power  : f32
    mutable wide_amt    : f32
    # sheen on the vegetated land: tightness, strength, and the perlin
    # that breaks it up. keep leaf_scale HIGH -- this is the fine detail
    mutable leaf_power  : f32
    mutable leaf_amt    : f32
    mutable leaf_scale  : f32
    # light blue at the equator: strength, patch scale, latitude falloff
    mutable lblue_amt   : f32
    mutable lblue_scale : f32
    mutable lblue_curve : f32
    # vertex displacement, in sphere radii, above the sea surface
    mutable displace  : f32

    attrib jungle : LayoutBinding [ type:typeid[ MoonSurface ], id:MoonSurface.jungle, count:1, format: typeid[ rgba8 ] ]

    # how many times the tile wraps the globe. MUST stay a whole number:
    # u = 0 and u = 1 have to land on the same texel or the dateline
    # shows a seam straight down the map
    mutable jungle_tiles : f32

    attrib v_east  : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_north : VertexOutput [ type:typeid[ vec3f ] ]

    func vertex[] -> GLSL none {
        v_uv     = vec2(1.0 - a_uv.x, a_uv.y);
        mat3 nm  = transpose(inverse(mat3(ubo.model)));
        v_normal = normalize(nm * a_normal);

        // tangent frame from the OBJECT normal, rotated like the normal.
        // built from world +y it ignores the 25.2 deg axial tilt, so the
        // relief is lit in a frame that does not turn with the surface
        vec3 ax  = abs(a_normal.y) > 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3 o_e = normalize(cross(ax, a_normal));
        vec3 o_n = normalize(cross(a_normal, o_e));
        v_east   = normalize(nm * o_e);
        v_north  = normalize(nm * o_n);

        vec2  huv   = v_uv - vec2(0.0635, 0.0);
        // must match the fragment stage exactly or the displaced coast
        // sits away from the shaded one
        float lat_r = (v_uv.y - 0.5) * 3.1415927;
        float lon_r = v_uv.x * 6.2831853;
        vec3  sp    = vec3(cos(lat_r) * cos(lon_r), sin(lat_r), cos(lat_r) * sin(lon_r));
        float sea   = ubo.sea_level
                    + ubo.sea_lat   * pow(max(cos(lat_r), 0.0), ubo.sea_curve)
                    + ubo.sea_noise * (vnoise(sp * ubo.sea_scale) - 0.5);
        // no derivatives in the vertex stage: must be an explicit lod
        float hv    = textureLod(height, huv, 0.0).r;
        // lift the ground itself near the equator so less of it floods
        hv         += ubo.eq_rise * pow(max(cos(lat_r), 0.0), 1.5);
        // the sea surface stays a clean sphere; only land rises out of
        // it, so the ocean reads flat the way real water does
        float d     = max(hv - sea, 0.0) * ubo.displace;

        vec4  wpos  = ubo.model * vec4(a_pos + a_normal * d, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        vec3  n0   = normalize(v_normal);
        // the sun sits well off the view axis: a sun behind the camera
        // lights the disc evenly and no relief anywhere can read
        vec3  sun  = normalize(vec3(-0.56, 0.14, 0.82));
        vec3  surf = texture(color, v_uv).rgb;
        float lum  = dot(surf, vec3(0.299, 0.587, 0.114));

        // the two maps use a different prime meridian: 22.9 deg of
        // longitude, no latitude shift. registered on edge magnitude,
        // which tracks crater rims and canyon walls, not albedo
        vec2  huv  = v_uv - vec2(0.0635, 0.0);

        // height arrives f32 and gaussian'd at load, so it can be
        // differentiated tight — one texel — without banding
        vec2  st   = max(fwidth(huv), vec2(1.0 / 8192.0, 1.0 / 4096.0));
        float h    = texture(height, huv).r;
        // object-space point from the uv, NOT from v_world_pos: world
        // space turns with the model, so any noise keyed off it swims
        // across the surface instead of staying pinned to the ground
        float lat_r = (v_uv.y - 0.5) * 3.1415927;
        float lon_r = v_uv.x * 6.2831853;
        vec3  sp    = vec3(cos(lat_r) * cos(lon_r), sin(lat_r), cos(lat_r) * sin(lon_r));
        float eq    = max(cos(lat_r), 0.0);

        // must match the vertex stage exactly
        float sea   = ubo.sea_level
                    + ubo.sea_lat   * pow(eq, ubo.sea_curve)
                    + ubo.sea_noise * (vnoise(sp * ubo.sea_scale) - 0.5);
        // lift the ground itself near the equator so less of it floods
        h          += ubo.eq_rise * pow(eq, 1.5);

        float h_l  = texture(height, huv - vec2(st.x, 0.0)).r;
        float h_r  = texture(height, huv + vec2(st.x, 0.0)).r;
        float h_d  = texture(height, huv - vec2(0.0, st.y)).r;
        float h_u  = texture(height, huv + vec2(0.0, st.y)).r;
        float dhdu = (h_r - h_l) / (2.0 * st.x);
        float dhdv = (h_u - h_d) / (2.0 * st.y);

        // v_uv.x runs west, so the u slope tilts against east
        vec3  t_e  = normalize(v_east);
        vec3  t_n  = normalize(v_north);
        vec3  bump = t_e * dhdu - t_n * dhdv;
        vec3  n    = normalize(n0 - bump * ubo.relief * 0.030);

        // shore: a wide band in height units. an edge cut at the screen
        // footprint lands inside one 8-bit step and reads as a mask
        float d_h  = sea - h;
        float is_w = smoothstep(-0.014, 0.014, d_h);

        // cast shadow: march the height map toward the sun. perturbing
        // the normal only shades a slope by its own tilt -- it can never
        // throw a shadow onto the ground beside it, so nothing sweeps
        // when the planet turns. east is +u, north is -v, matching bump
        float shade = 1.0;
        vec3  s_t   = vec3(dot(sun, t_e), dot(sun, t_n), dot(sun, n0));
        vec2  s_uv  = vec2(s_t.x, -s_t.y);
        float s_len = length(s_uv);
        if (s_len > 0.001 && s_t.z > 0.0) {
            s_uv        /= s_len;
            float tanel  = s_t.z / s_len;
            // u shrinks toward the poles; v does not
            float coslat = max(cos((v_uv.y - 0.5) * 3.1415927), 0.12);
            vec2  arc_uv = vec2(6.2831853 * coslat, 3.1415927);
            float occ    = 0.0;
            float h0     = h * ubo.displace;
            for (int i = 1; i <= 16; ++i) {
                float t   = float(i) * 0.0022;
                vec2  duv = s_uv * t;
                float arc = length(duv * arc_uv);
                float hs  = textureLod(height, huv + duv, 0.0).r * ubo.displace;
                occ = max(occ, clamp((hs - (h0 + arc * tanel)) * 260.0, 0.0, 1.0));
            }
            shade = 1.0 - occ * 0.88;
        }

        // view vectors up here: the land sheen needs them too, not just
        // the water, and they must be one shared definition
        vec3  v_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        vec3  h_dir = normalize(sun + v_dir);
        float nh    = max(dot(n0, h_dir), 0.0);
        float day_s = smoothstep(-0.02, 0.12, dot(n0, sun));

        // land keeps the relief; the sea takes a trace of it so the light
        // still plays over the shelves instead of sitting dead flat
        vec3  n_w   = normalize(mix(n0, n, 0.16));
        float ndl_l = max(dot(n,   sun), 0.0) * shade;
        float ndl_w = max(dot(n_w, sun), 0.0);

        // land climbs in bands off the waterline: sand, then green,
        // then the REAL mars colour map taking over as the top stop.
        // the red is the albedo itself, not a tint standing in for it
        float alt0  = h - sea;
        float a_snd = ubo.sand_band;
        float a_grn = a_snd + ubo.green_band;
        float gn0   = clamp((fnoise(sp * ubo.land_scale) - 0.5) * 1.7 + 0.5, 0.0, 1.0);

        vec3  c_snd = vec3(0.80, 0.72, 0.54);
        vec3  c_grn = mix(vec3(0.17, 0.40, 0.15), vec3(0.36, 0.56, 0.22), gn0);

        vec3  lnd   = c_snd;
        lnd = mix(lnd, c_grn, smoothstep(0.0, a_snd, alt0) * pow(eq, ubo.lush_curve));
        lnd = mix(lnd, surf,  smoothstep(a_snd, a_grn, alt0));

        // growth follows the water: a green belt just above the shore
        // that thins out with altitude, so the mids carry the colour
        float alt  = h - sea;
        float veg  = smoothstep(0.002, 0.035, alt)
                   * (1.0 - smoothstep(0.050, 0.230, alt));
        // two green levels, chosen by their own perlin: a deep growth
        // and a paler scrub, so the belt is not one flat tone
        float g_n  = clamp((fnoise(sp * ubo.land_scale) - 0.5) * 1.7 + 0.5, 0.0, 1.0);
        vec3  g_lo = vec3(0.34, 0.47, 0.28);
        vec3  g_hi = vec3(0.66, 0.68, 0.46);
        vec3  moss = mix(g_lo, g_hi, g_n);
        lnd        = mix(lnd, moss * (0.65 + 1.00 * lum), veg * ubo.veg_amt);

        // forest in perlin patches laid over the elevation. three
        // octaves so the edges are ragged instead of round blobs
        float f_s  = ubo.forest_scale;
        float f_n  = fnoise(sp * f_s);
        // thins out climbing to the tree line, and toward the poles
        float alt_f = 1.0 - smoothstep(ubo.tree_line * 0.45, ubo.tree_line, alt);
        float lat_f = smoothstep(0.04, 0.42, eq);
        // and it will not grow straight out of the surf
        float sh_f  = smoothstep(0.0005, 0.010, alt);
        float frst  = smoothstep(0.38, 0.68, f_n) * alt_f * lat_f * sh_f;

        // the jungle tile, wrapped whole times around the globe so the
        // dateline matches. v gets half the count: the map is 2:1, so
        // equal counts would stretch every tile to twice its height
        float j_u   = ubo.jungle_tiles;
        float j_v   = ubo.jungle_tiles * 0.5;
        // the tile is a photo, not a seamless one: warp the lookup so
        // the repeat never lines up into a visible grid of squares
        vec2  j_w   = vec2(fnoise(sp *  9.0),
                           fnoise(sp * 11.3 + vec3(21.7, 5.3, 48.1))) - 0.5;
        vec3  jung  = texture(jungle, vec2(v_uv.x * j_u, v_uv.y * j_v) + j_w * 3.0).rgb;
        float j_lum = dot(jung, vec3(0.299, 0.587, 0.114));

        vec3  t_lo  = vec3(0.15, 0.26, 0.13);
        vec3  t_hi  = vec3(0.34, 0.45, 0.21);
        vec3  tree  = mix(t_lo, t_hi, clamp((fnoise(sp * f_s * 3.3) - 0.5) * 1.7 + 0.5, 0.0, 1.0));
        // canopy detail rides the tile's luminance; its chroma stays ours
        tree        = tree * (0.55 + 1.05 * j_lum);
        lnd         = mix(lnd, tree * (0.70 + 0.85 * lum), frst * ubo.forest_amt * 0.30);

        // the first band of elevation above the water goes lush, and
        // only near the equator. laid last so it owns the coastal strip
        // a sandy strip right at the waterline, over everything else
        float shore = 1.0 - smoothstep(0.0, ubo.sand_band, alt);
        lnd         = mix(lnd, c_snd * (0.72 + 0.72 * lum), shore * ubo.sand_amt);

        // canopy sheen: only the GREEN catches it, and a tight perlin
        // breaks it into leaf-scale detail instead of a flat gloss.
        // measured off the pixel's own green bias, so it tracks
        // whatever the bands and the forest actually put down
        float grn_w = clamp((lnd.g - 0.5 * (lnd.r + lnd.b)) * 6.0, 0.0, 1.0);
        float leaf  = fnoise(sp * ubo.leaf_scale);
        lnd        += vec3(0.62, 0.78, 0.55)
                    * pow(nh, ubo.leaf_power) * day_s * grn_w
                    * (0.25 + 1.15 * leaf) * ubo.leaf_amt;

        // a lit body still bounces light into its own shade; a low floor
        // drives every slope to full black and the contrast tears
        lnd       *= 0.30 + 0.70 * ndl_l;

        // sea: a narrow shelf at the coast, then open water. the seabed
        // never fades out completely or the deep reads as flat paint
        // clarity varies at continental scale only — one perlin lobe spans
        // an ocean, so the water never picks up fine detail of its own
        float clar = fnoise(sp * 1.7);
        float dep  = clamp(d_h / 0.090, 0.0, 1.0);
        dep        = clamp(dep * (0.70 + 0.62 * clar), 0.0, 1.0);
        // two water tones on their own perlin: the violet and a deeper
        // blue. shallow and deep stops are carried per tone, so the
        // depth ramp stays a ramp instead of crossfading flat colours
        // a gentle contrast stretch, NOT a smoothstep. thresholding this
        // draws the noise's own isoline across the sea as a hard polygon
        float w_n   = clamp((fnoise(sp * ubo.water_scale) - 0.5) * 1.7 + 0.5, 0.0, 1.0);
        vec3  p_sh  = vec3(0.44, 0.38, 0.53);
        vec3  p_dp  = vec3(0.38, 0.26, 0.46);
        vec3  b_sh  = vec3(0.30, 0.42, 0.62);
        vec3  b_dp  = vec3(0.11, 0.19, 0.42);
        vec3  w_sh  = mix(p_sh, b_sh, w_n);
        vec3  w_dp  = mix(p_dp, b_dp, w_n);
        vec3  w_hue = mix(w_sh, w_dp, dep);

        // the equator runs to cyan, falling off fast so it stays tropical
        vec3  c_sh  = vec3(0.38, 0.68, 0.72);
        vec3  c_dp  = vec3(0.09, 0.33, 0.45);
        w_hue       = mix(w_hue, mix(c_sh, c_dp, dep),
                          pow(eq, ubo.cyan_curve) * ubo.cyan_amt);

        float t_lat = abs(v_uv.y - 0.5) * 2.0;

        // light blue owns the equator. latitude drives it; the perlin
        // only ragged-edges it so it is not a clean band of colour
        float lb_n  = fnoise(sp * ubo.lblue_scale + vec3(51.3, 8.9, 33.4));
        float lblue = pow(eq, ubo.lblue_curve) * (0.68 + 0.52 * lb_n);
        lblue       = clamp(lblue, 0.0, 1.0);
        vec3  l_sh  = vec3(0.56, 0.74, 0.88);
        vec3  l_dp  = vec3(0.24, 0.43, 0.70);
        w_hue       = mix(w_hue, mix(l_sh, l_dp, dep), lblue * ubo.lblue_amt);

        // pink only where the water is DEEP, and only in patches. it
        // goes on last so it reads over the light blue, not under it
        // a balanced split: fnoise clusters near 0.5, so a narrow band
        // across it hands roughly half the equator to pink. depth is a
        // WEIGHT now, not a gate -- gating it killed the colour outright
        float p_n   = fnoise(sp * ubo.pink_scale);
        float pink  = smoothstep(0.475, 0.525, p_n)
                    * (1.0 - smoothstep(0.0, ubo.pink_span, t_lat))
                    * (0.45 + 0.55 * smoothstep(ubo.pink_deep, 1.0, dep));
        vec3  k_sh  = vec3(0.88, 0.49, 0.62);
        vec3  k_dp  = vec3(0.55, 0.19, 0.37);
        w_hue       = mix(w_hue, mix(k_sh, k_dp, dep), pink * ubo.pink_amt);
        // the seabed stays readable at depth; water tints it, never hides it.
        // gain kept low or the shelf blooms into a white ring at the coast
        float bedl = lum * (1.0 - 0.45 * dep);
        vec3  wat  = w_hue * (0.34 + 1.25 * bedl);
        wat       *= 0.26 + 0.74 * ndl_w;

        // glint: tight only. the broad sheen term smeared a pale blob over
        // a third of the ocean and read as a lamp, not sun on water
        float glit  = 0.62 + 0.55 * fnoise(sp * 26.0);
        float fres  = 0.02 + 0.98 * pow(1.0 - max(dot(n0, v_dir), 0.0), 5.0);
        // two lobes. the exponent sets the angular size: the half-power
        // half-angle is acos(0.5^(1/n)), so n=130 is about 6 deg and
        // n=2.5 about 40 deg -- four times wider again
        wat        += vec3(0.95, 0.92, 0.98)
                    * pow(nh, ubo.spec_power) * day_s * glit * ubo.spec_amt;
        wat        += vec3(0.72, 0.74, 0.86)
                    * pow(nh, ubo.wide_power) * day_s * ubo.wide_amt;
        // sky reflection climbs toward the limb
        wat         = mix(wat, vec3(0.46, 0.43, 0.62) * day_s, fres * 0.26);

        vec3  col  = mix(lnd, wat, is_w);

        col        *= ubo.gain;
        fragColor   = vec4(clamp(col, 0.0, 1.0), 1.0);
    }


# the sky shell: clouds, limb haze and the rim, drawn over the surface.
# same construction as Earth's CloudShader — an offset sphere with the
# cloud map prefiltered in the vertex stage and faded off the silhouette
enum SkySurface
    cloud : 0

# its own enum and its own samplers map: a third LayoutBinding added to
# an inherited shader lands on the parent's slot and reads the height map
ModelViewProject TerraSky
    mutable gain    : f32
    mutable cam_pos : vec4f

    attrib cloud : LayoutBinding [ type:typeid[ SkySurface ], id:SkySurface.cloud, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos        : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal     : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv         : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_normal     : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_uv         : VertexOutput  [ type:typeid[ vec2f ] ]
    attrib v_world_pos  : VertexOutput  [ type:typeid[ vec4f ] ]
    attrib v_cloud_avg  : VertexOutput  [ type:typeid[ f32 ] ]

    attrib fragColor    : FragmentOutput[ type:typeid[ vec4f ] ]

    func init[]
        eye2    : vec3f [0.0f,  0.0f,  1.5f]
        target2 : vec3f [0.0f,  0.0f,  0.0f]
        up2     : vec3f [0.0f, -1.0f,  0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[70.0f], 1.0f, 0.1f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_uv     = vec2(1.0 - a_uv.x, a_uv.y);
        mat3 nm  = transpose(inverse(mat3(ubo.model)));
        v_normal = normalize(nm * a_normal);

        // prefilter the cloud map so the fragment can normalise contrast
        const float kernel[7] = float[](
            0.006, 0.061, 0.242, 0.383, 0.242, 0.061, 0.006);
        vec2  texel = 1.0 / vec2(textureSize(cloud, 0));
        float c_avg = 0.0;
        for (int i = -3; i <= 3; ++i) {
            for (int j = -3; j <= 3; ++j) {
                vec2 o = vec2(i, j) * texel * 2.0;
                c_avg += texture(cloud, v_uv + o).r * kernel[i + 3] * kernel[j + 3];
            }
        }
        v_cloud_avg = c_avg;

        // just clear of the tallest displaced peak. any higher and the
        // deck reads as a glass dome standing off the planet
        vec3 shell  = a_pos + a_normal * 0.008;
        vec4 wpos   = ubo.model * vec4(shell, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        vec3  n     = normalize(v_normal);
        vec3  sun   = normalize(vec3(-0.56, 0.14, 0.82));
        vec3  v_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        float ndl   = max(dot(n, sun),   0.0);
        float ndv   = max(dot(n, v_dir), 0.0);

        // ramp the rim back to zero at the geometric limb, or the mesh
        // edge pixels take a bright line along the jagged silhouette
        float silh  = smoothstep(0.0, 0.24, ndv);
        float limb  = pow(1.0 - ndv, 2.2) * silh;
        float rim   = pow(1.0 - ndv, 5.0) * silh;

        float c_amt = texture(cloud, v_uv).r / (2.0 - v_cloud_avg);
        c_amt       = smoothstep(0.14, 0.66, c_amt);
        // clouds thin out into the limb so they never stack on the haze
        c_amt      *= clamp(1.0 - pow(1.0 - ndv, 0.9), 0.0, 1.0);

        float day   = 0.16 + 0.84 * ndl;
        vec3  c_col = vec3(0.88, 0.85, 0.90) * day;

        // thin air scatters short wavelengths: violet on the limb, and
        // it brightens hard where the line of sight grazes the terminator
        vec3  air   = vec3(0.40, 0.34, 0.72) * (0.20 + 1.05 * ndl);
        vec3  glow  = air * limb * 0.85 + air * rim * 0.55;

        // straight_alpha multiplies by a in the blend, so emit unpremultiplied
        // colour here: folding coverage into rgb too applies it squared
        float a     = clamp(c_amt * 0.94 + (limb * 0.50 + rim * 0.35) * ndl, 0.0, 1.0);
        vec3  col   = (c_col * c_amt * 0.94 + glow) / max(a, 0.001);
        fragColor   = vec4(col, a);
    }


element Mars
    frost : true
    frost_sharp : true
    # eased camera distance / angle; p_set marks the first frame
    intern e_cur  : f32
    intern p_cur  : f32
    intern p_set  : bool
    intern mars   : MoonShader
    intern models : array Model
    intern target : Render
    intern built  : bool
    # async load: worker decodes, draw waits on ready for vk work
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    public color  : rgba [ r:0.010, g:0.005, b:0.006, a:1.0 ]

    func build_models[]
        built     = true
        gltf_path : path '../scenes/models/earth.gltf'
        gltf      : GltfModel.open[ gltf_path ]
        mars      = MoonShader [ vk: vk ]

        mars_samplers : map Image [string] [
            'color':  Image [ uri: path '../scenes/textures/mars-color-8192x4096.jpg',  surface: MoonSurface.color ],
            'height': Image [ uri: path '../scenes/textures/mars-height-8192x4096.png', surface: MoonSurface.height ]
        ]
        mars_model : Model [ vk: vk, w: ux, id: gltf, s: mars, samplers: mars_samplers, straight_alpha: true ]
        models     = array Model [ mars_model ]

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        ux.element_targets[ id ] = target

    # unregister only; we keep our ref so the GPU graph outlives the frame
    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    # iron oxide: the editor's purples go rust under a martian sky
    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#4108',   # editor pane background
            '#140a2a80':  '#429a',   # console pane background
            '#4258':      '#8a5a4a58',   # unused (line_color moved to #44225588)
            '#ff6a2e55':  '#ff8a4a55',   # search highlight fill
            '#220022aa':  '#2a1a16aa',   # run console base fill
            '#614':       '#54281a',     # TButtons / nav rest fill
            '#413':       '#3c1c10',     # TButtons hover fill
            '#826':       '#7c3c22',     # TButtons lit / nav selected
            '#625a':      '#408a',       # bottom status bar fill
            '#8af2':      '#fa62',       # status bar inner glow
            '#425':       '#52281e',     # editor selection color
            '#44225588':  '#5a3a2e33'    # editor line highlight
        ]

    func load_bg [ arg: object ]
        t0 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg start at {t0}'
        build_models[]
        t1 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg done in {t1 - t0}ms at {t1}'
        ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : array []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: @load_bg, work: w9 ]
        if [ !ready ] return
        create_target[]
        orbit[]

    func orbit[]
        # follow the window, never a fixed 16:9 -- a hardcoded aspect
        # stretches the disc the moment the window is not that shape
        aspect : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]
        # a globe, not a surface: far enough for the whole disc
        # Mars was authored as a whole-disc view, so its 2.70 is `far`
        e_t    : f32 [ (ux.orbit_mode == OrbitView.low)  ? 1.55 :
                       (ux.orbit_mode == OrbitView.high) ? 2.05 : 2.70 ]
        if [ e_cur == 0.0 ] e_cur = e_t
        e_cur = filter_n[ e_cur, e_t, 0.08, ux.frame_factor ]

        p_t    : f32 [ (ux.angle_mode == ViewAngle.flat)   ? 0.0 :
                       (ux.angle_mode == ViewAngle.angled) ? 0.156 : 0.480 ]
        if [ p_cur == 0.0 && p_t != 0.0 && !p_set ] p_cur = p_t
        p_set  = true
        p_cur  = filter_n[ p_cur, p_t, 0.08, ux.frame_factor ]

        ux.orbit_moving = abs[ e_cur - e_t ] > 0.002 || abs[ p_cur - p_t ] > 0.001
        e_d    : f32 [ e_cur ]
        _eye   : vec3f [ 0.0,  e_d * p_cur, e_d ]
        _tgt   : vec3f [ 0.0,  0.0,  0.0  ]
        # world +y reads up on screen only when up is negated
        _up    : vec3f [ 0.0, -1.0,  0.0  ]

        _proj  : mat4f.perspective[ radians[ 60.0 ], aspect, 0.01, 20.0 ]
        _view  : mat4f.look_at    [ _eye, _tgt, _up ]

        # ux.time counts kiloseconds: 6000 = one turn per minute
        spin_d : f32 [ ux.time * 6000.0 ]
        m_spin : vec4f [ 0.0, 1.0, 0.0, radians[ spin_d ] ]
        q_spin : quatf [ m_spin ]
        # 25.2 degrees of axial tilt, applied after the spin
        m_axis : vec4f [ 0.0, 0.0, 1.0, radians[ 25.2 ] ]
        q_axis : quatf [ m_axis ]
        mm : mat4f.identity[]
        mm = mm.rotate[ q_axis ]
        mm = mm.rotate[ q_spin ]

        mars.model = mm
        mars.view  = _view
        mars.proj  = _proj
        mars.gain  = 2.0
        mars.regolith = 0.0
        mars.relief   = 1.0
        mars.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]


# gltf material colors arrive as 1x1 textures on Surface.color, so the
# steel, glass and tire parts each keep their own tone with no map.
# lit by the same sun vector the terra surface uses, or the monument
# would hold noon while the ground under it turns into night
ModelViewProject CyberTruck
    attrib color : LayoutBinding [ type:typeid[ Surface ], id:Surface.color, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos     : VertexInput    [ type:typeid[ vec3f ] ]
    attrib a_normal  : VertexInput    [ type:typeid[ vec3f ] ]
    attrib a_uv      : VertexInput    [ type:typeid[ vec2f ] ]

    attrib v_normal  : VertexOutput   [ type:typeid[ vec3f ] ]
    attrib v_uv      : VertexOutput   [ type:typeid[ vec2f ] ]
    attrib fragColor : FragmentOutput [ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    func vertex [] -> GLSL none {
        mat3 nm     = transpose(inverse(mat3(ubo.model)));
        v_normal    = normalize(nm * a_normal);
        v_uv        = a_uv;
        gl_Position = ubo.proj * ubo.view * ubo.model * vec4(a_pos, 1.0);
    }

    func fragment [] -> GLSL none {
        vec3  n   = normalize(v_normal);
        vec3  sun = normalize(vec3(-0.56, 0.14, 0.82));
        float d   = max(dot(n, sun), 0.0);
        // stainless: a tight highlight over a dim body, so the facets
        // read as flat sheets instead of a soft diffuse lump
        vec3  h   = normalize(sun + vec3(0.0, 0.0, 1.0));
        float sp  = pow(max(dot(n, h), 0.0), 48.0);
        vec4  c   = texture(color, v_uv);
        vec3  lit = c.rgb * (0.16 + d * 0.92) + vec3(sp * 0.38);
        fragColor = vec4(lit, 1.0);
    }


element Terra
    frost : true
    frost_sharp : true
    frost_lift : 0.92
    # eased camera distance / angle; p_set marks the first frame
    intern e_cur  : f32
    intern p_cur  : f32
    intern p_set  : bool
    intern terra  : TerraShader
    intern sky    : TerraSky
    intern truck  : CyberTruck
    intern models : array Model
    intern target : Render
    intern built  : bool
    # async load: worker decodes, draw waits on ready for vk work
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    public color  : rgba [ r:0.006, g:0.008, b:0.016, a:1.0 ]

    func build_models[]
        built     = true
        gltf_path : path '../scenes/models/earth.gltf'
        gltf      : GltfModel.open[ gltf_path ]
        terra     = TerraShader [ vk: vk ]
        sky       = TerraSky    [ vk: vk ]

        # the height png is 8-bit: differentiating it draws contour rings.
        # carry it to f32 and gaussian it once, here, not per fragment
        h_src : Image [ uri: path '../scenes/textures/mars-height-8192x4096.png' ]
        h_f32 : h_src.gray[].to_f32[ true ].gaussian[ 2.0 ]
        h_f32.surface = MoonSurface.height
        h_f32.linear  = true
        h_f32.wrap_u  = true

        # the mars maps only: color is the land, height sets the sea
        terra_samplers : map Image [string] [
            'color':  Image [ uri: path '../scenes/textures/mars-color-8192x4096.jpg',   surface: MoonSurface.color,  linear: true, wrap_u: true ],
            'height': h_f32,
            'jungle': Image [ uri: path '../scenes/textures/jungle.png', surface: MoonSurface.jungle, linear: true, wrap_u: true, wrap_v: true ]
        ]
        # the sky pass carries one sampler, on its own enum
        sky_samplers : map Image [string] [
            'cloud':  Image [ uri: path '../scenes/textures/earth-cloud-8192x4096.png',  surface: SkySurface.cloud, linear: true, wrap_u: true ]
        ]
        terra_model : Model [ vk: vk, w: ux, id: gltf, s: terra, samplers: terra_samplers, straight_alpha: true ]
        sky_model   : Model [ vk: vk, w: ux, id: gltf, s: sky,   samplers: sky_samplers,   straight_alpha: true ]

        # Low Poly Tesla Cybertruck by kulonee (sketchfab.com/ynesolefru),
        # Sketchfab Standard license — see models/cybertruck/license.txt
        truck_gltf  : GltfModel.open[ path '../scenes/models/cybertruck/scene.gltf' ]
        truck       = CyberTruck [ vk: vk ]
        truck_model : Model [ vk: vk, w: ux, id: truck_gltf, s: truck ]

        # truck before sky: the cloud shell blends over it
        models      = array Model [ terra_model, truck_model, sky_model ]

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        # 2x supersample: the coast and the limb alias badly at 1x
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      (ux.frost_eff[] == 3) ? 2.0 : 1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        ux.element_targets[ id ] = target

    # unregister only; we keep our ref so the GPU graph outlives the frame
    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    # a living mars: the editor purples go to moss and wine.
    # the pane fill is the backdrop dimmer, so it carries the #0008;
    # the second layer keeps its original ratio to the first
    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#101a',        # editor pane background
            '#140a2a80':  '#0005',        # console pane background
            '#4258':      '#c87a9a58',    # unused (line_color moved to #44225588)
            '#ff6a2e55':  '#c8d05a55',    # search highlight fill
            '#220022aa':  '#16221eaa'     # run console base fill
        ]

    func load_bg [ arg: object ]
        t0 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg start at {t0}'
        build_models[]
        t1 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg done in {t1 - t0}ms at {t1}'
        ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : array []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: @load_bg, work: w9 ]
        if [ !ready ] return
        create_target[]
        # NOTE: wscale is fixed at create_target. resizing a live Render
        # here destroys its image view while bound descriptor sets and
        # an in-flight command buffer still reference it -- instant
        # device loss the moment the frost stage is toggled
        orbit[]

    func orbit[]
        # follow the window, never a fixed 16:9 -- a hardcoded aspect
        # stretches the disc the moment the window is not that shape
        aspect : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]
        # low is the 1.38 this scene already had; far shows the disc
        e_t    : f32 [ (ux.orbit_mode == OrbitView.low)  ? 1.38 :
                       (ux.orbit_mode == OrbitView.high) ? 1.85 : 2.60 ]
        # ease to it rather than cut; first frame snaps so we do not
        # fly in from zero on mount
        if [ e_cur == 0.0 ] e_cur = e_t
        e_cur = filter_n[ e_cur, e_t, 0.08, ux.frame_factor ]

        # pitch above the equator, as a rise over the eye distance.
        # 0 is dead flat-on; the ladder tips the pole toward the camera
        p_t    : f32 [ (ux.angle_mode == ViewAngle.flat)   ? 0.0 :
                       (ux.angle_mode == ViewAngle.angled) ? 0.094 : 0.420 ]
        if [ p_cur == 0.0 && p_t != 0.0 && !p_set ] p_cur = p_t
        p_set  = true
        p_cur  = filter_n[ p_cur, p_t, 0.08, ux.frame_factor ]

        ux.orbit_moving = abs[ e_cur - e_t ] > 0.002 || abs[ p_cur - p_t ] > 0.001
        e_d    : f32 [ e_cur ]
        _eye   : vec3f [ 0.0,  e_d * p_cur, e_d ]
        _tgt   : vec3f [ 0.0,  0.0,  0.0  ]
        _up    : vec3f [ 0.0, -1.0,  0.0  ]

        _proj  : mat4f.perspective[ radians[ 60.0 ], aspect, 0.01, 20.0 ]
        _view  : mat4f.look_at    [ _eye, _tgt, _up ]

        # base angle brings Valles Marineris around; ux.time counts
        # kiloseconds, so 4000 is roughly one turn in ninety seconds
        spin_d : f32 [ 60.0 + ux.time * 4000.0 ]
        m_spin : vec4f [ 0.0, 1.0, 0.0, radians[ spin_d ] ]
        q_spin : quatf [ m_spin ]
        m_axis : vec4f [ 0.0, 0.0, 1.0, radians[ 25.2 ] ]
        q_axis : quatf [ m_axis ]
        mm : mat4f.identity[]
        mm = mm.rotate[ q_axis ]
        mm = mm.rotate[ q_spin ]

        terra.model = mm
        terra.view  = _view
        terra.proj  = _proj

        # parked on the upper flank of Olympus Mons, three degrees south
        # of the caldera. the summit is the height map's global maximum,
        # at mesh uv 0.8705, 0.4012 -- the shader flips u, so that is
        # 0.1295 in map space, and the flank here still stands well clear
        # of the 0.302 sea. lat/lon below are that point on the sphere
        t_lat : f32 [ radians[   14.78 ] ]
        t_lon : f32 [ radians[ -133.38 ] ]
        tcl : f32 [ cos[ t_lat ] ]
        tnx : f32 [ tcl * cos[ t_lon ] ]
        tny : f32 [ sin[ t_lat ] ]
        tnz : f32 [ tcl * sin[ t_lon ] ]
        # 0.0375 sphere radii of truck, against a 0.177 Olympus Mons
        t_len : f32 [ 0.0375 ]
        # a straight hull on a round planet lifts its ends by the sag over
        # its own length. sink half of that, so nose and tail hang as far
        # above the ground as the middle sits under it. derived, not typed:
        # a hardcoded sink is only right for the length it was measured at
        t_gnd : f32 [ 1.00211 ]
        t_hl  : f32 [ t_len * 0.5 ]
        t_sag : f32 [ t_gnd - sqrt[ t_gnd * t_gnd - t_hl * t_hl ] ]
        t_rad : f32 [ t_gnd - t_sag * 0.5 ]
        # stand the model's own up axis on the surface normal: turn
        # about y cross n, by the angle between them
        tax : f32 [ tnz ]
        taz : f32 [ 0.0 - tnx ]
        tal : f32 [ sqrt[ tax * tax + taz * taz ] ]
        if [ tal > 0.0 ]
            tax = tax / tal
            taz = taz / tal
        q_up : quatf [ vec4f [ tax, 0.0, taz, acos[ tny ] ] ]
        # 6.53 model units long, measured off the gltf's world bounds
        t_scl : f32 [ t_len / 6.53 ]
        tmm : mat4f.identity[]
        tmm = tmm.translate[ vec3f [ tnx * t_rad, tny * t_rad, tnz * t_rad ] ]
        tmm = tmm.rotate[ q_up ]
        tmm = tmm.scale[ vec3f [ t_scl, t_scl, t_scl ] ]
        # under mm, so it turns with the planet instead of sliding over it
        truck.model = mm.mul[ tmm ]
        truck.view  = _view
        truck.proj  = _proj

        terra.gain  = 1.22
        terra.regolith = 0.0
        terra.relief   = 1.0
        terra.sea_level = 0.302
        terra.sea_lat   = 0.0
        terra.sea_curve = 2.2
        terra.sea_noise = 0.012
        terra.sea_scale = 3.4
        terra.land_scale  = 5.5
        terra.water_scale = 2.8
        # light blue carries the equator now, so cyan only seasons it
        terra.cyan_amt    = 0.24
        terra.cyan_curve  = 4.0
        terra.pink_amt    = 0.85
        terra.pink_span   = 0.90
        terra.pink_scale  = 1.3
        terra.pink_deep   = 0.25
        terra.spec_power  = 130.0
        terra.spec_amt    = 0.55
        terra.wide_power  = 2.5
        terra.wide_amt    = 0.13
        terra.leaf_power  = 16.0
        terra.leaf_amt    = 0.10
        terra.leaf_scale  = 210.0
        terra.lblue_amt   = 0.55
        terra.lblue_scale = 2.3
        terra.lblue_curve = 1.6
        terra.forest_scale = 4.0
        terra.forest_amt   = 0.80
        terra.tree_line    = 0.20
        terra.veg_amt      = 0.45
        terra.jungle_tiles = 48.0
        terra.eq_rise      = 0.010
        terra.sand_band    = 0.008
        terra.green_band   = 0.080
        terra.sand_amt     = 0.80
        terra.lush_curve   = 1.5
        terra.displace  = 0.00875
        terra.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]

        sky.model   = mm
        sky.view    = _view
        sky.proj    = _proj
        sky.gain    = 1.0
        sky.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]


shader PurpleShader
    mutable model   : mat4f
    mutable view    : mat4f
    mutable proj    : mat4f
    mutable cam_pos : vec4f
    
    attrib  color : LayoutBinding [ type:typeid[ PurpleSurface ], id:PurpleSurface.color, count:1, format: typeid[ rgba8 ] ]
    attrib  cloud : LayoutBinding [ type:typeid[ PurpleSurface ], id:PurpleSurface.cloud, count:1, format: typeid[ rgba8 ] ]
    
    attrib a_pos        : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal     : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv         : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_normal     : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_uv         : VertexOutput  [ type:typeid[ vec2f ] ]
    attrib v_tangent    : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_bitangent  : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_world_pos  : VertexOutput  [ type:typeid[ vec4f ] ]

    attrib outColor     : FragmentOutput[ type:typeid[ vec4f ] ]


    func init[]
        fov_deg : f32 60.0f
        aspect  : f32 1920.0f / 1080.0f
        near    : f32 0.1f
        far     : f32 100.0f
        eye2    : vec3f [0.0f,  0.0f,  1.5f]
        target2 : vec3f [0.0f,  0.0f,  0.0f]
        up2     : vec3f [0.0f, -1.0f,  0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[70.0f], 1.0f, 0.1f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]


    func rotateY [ angle: f32 ] -> GLSL mat3f {
        float c = cos(angle);
        float s = sin(angle);
        return mat3(
            vec3(c, 0.0, -s),
            vec3(0.0, 1.0, 0.0),
            vec3(s, 0.0, c)
        );
    }

    func sdf_sphere [ p: vec3f, radius: f32, squash: f32 ] -> GLSL float {
        // squash factor < 1.0 flattens vertically
        vec3 q = vec3(p.x, p.y / squash, p.z);
        return length(q) - radius;
    }

    func sdf_cylinder [ p: vec3f, h: f32, r: f32 ] -> GLSL float {
        vec2 d = abs(vec2(length(p.xz), p.y)) - vec2(r, h);
        return min(max(d.x, d.y), 0.0) + length(max(d, vec2(0.0)));
    }

    # permutation function
    func permute4 [ x: vec4f ] -> GLSL vec4f {
        return mod((x * 34.0 + 1.0) * x, vec4(289.0));
    }

    # fast inverse sqrt
    func taylorInvSqrt4 [ r: vec4f ] -> GLSL vec4f {
        return 1.79284291400159 - 0.85373472095314 * r;
    }

    # smootherstep fade curve
    func fade [ t: vec3f ] -> GLSL vec3f {
        return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
    }

    # basic perlin 3D noise
    func perlin3D [ P: vec3f ] -> GLSL float {
        vec3 Pi0 = mod(floor(P), vec3(289.0));
        vec3 Pi1 = mod(Pi0 + vec3(1.0), vec3(289.0));
        vec3 Pf0 = fract(P);
        vec3 Pf1 = Pf0 - vec3(1.0);

        vec4 ix = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
        vec4 iy = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
        vec4 iz0 = vec4(Pi0.z);
        vec4 iz1 = vec4(Pi1.z);

        vec4 ixy = permute4(permute4(ix) + iy);
        vec4 ixy0 = permute4(ixy + iz0);
        vec4 ixy1 = permute4(ixy + iz1);

        vec4 gx0 = fract(ixy0 / 7.0) * 2.0 - 1.0;
        vec4 gy0 = fract(floor(ixy0 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz0 = 1.0 - abs(gx0) - abs(gy0);

        vec4 gx1 = fract(ixy1 / 7.0) * 2.0 - 1.0;
        vec4 gy1 = fract(floor(ixy1 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz1 = 1.0 - abs(gx1) - abs(gy1);

        vec4 sz0 = step(gz0, vec4(0.0));
        gx0 -= sz0 * (step(0.0, gx0) - 0.5);
        gy0 -= sz0 * (step(0.0, gy0) - 0.5);

        vec4 sz1 = step(gz1, vec4(0.0));
        gx1 -= sz1 * (step(0.0, gx1) - 0.5);
        gy1 -= sz1 * (step(0.0, gy1) - 0.5);

        vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
        vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
        vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
        vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
        vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
        vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
        vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
        vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);

        vec4 norm0 = taylorInvSqrt4(vec4(dot(g000, g000), dot(g010, g010), dot(g100, g100), dot(g110, g110)));
        g000 *= norm0.x;
        g010 *= norm0.y;
        g100 *= norm0.z;
        g110 *= norm0.w;
        vec4 norm1 = taylorInvSqrt4(vec4(dot(g001, g001), dot(g011, g011), dot(g101, g101), dot(g111, g111)));
        g001 *= norm1.x;
        g011 *= norm1.y;
        g101 *= norm1.z;
        g111 *= norm1.w;

        float n000 = dot(g000, Pf0);
        float n100 = dot(g100, vec3(Pf1.x, Pf0.y, Pf0.z));
        float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
        float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
        float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
        float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
        float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
        float n111 = dot(g111, Pf1);

        vec3 fade_xyz = fade(Pf0);
        vec4 n_z = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fade_xyz.z);
        vec2 n_yz = mix(n_z.xy, n_z.zw, fade_xyz.y);
        float n_xyz = mix(n_yz.x, n_yz.y, fade_xyz.x);

        return n_xyz * 0.5 + 0.5;
    }

    # fractal brownian motion (fbm) using perlin noise
    func fbm [ pos: vec3f, y_translate: f32 ] -> GLSL float {
        float value = 0.0;
        float amplitude = 0.5;
        float frequency = 0.1;
        for (int i = 0; i < 6; ++i) {
            value += amplitude * perlin3D(pos * frequency + vec3(0.0, y_translate * 11.0, 0.0));
            amplitude *= 0.5;
            frequency *= 2.0;
        }
        return value;
    }

    func fragment [] -> GLSL none {
        vec2 uv = v_uv;

        // === Lighting setup ===
        vec3  normal   = normalize(v_normal);
        vec3  sun_dir  = normalize(vec3(0.2, 0.0, 0.8)); // fixed light source
        vec3  view_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);

        // animated FBM-based distortion
        float t          = ubo.time * 0.2; // pass this as uniform in seconds
        vec3  offset     = vec3(uv * 10.0, t * 0.3) * 5.0;
        float noise_x    = fbm(offset + vec3(100.0 + (1.0 - (uv.y - 0.5)) * 100.0, 0.0, 0.0), 0.0);
        float noise_y    = fbm(offset + vec3(0.0, 500.0, 0.0), 0.0);
        float noise_z    = fbm(offset + vec3(0.0, 0.0, 15.0), 0.0);

        vec3  distortion = normalize(vec3(noise_x, noise_y, noise_z) * 2.0 - 1.0) * 0.188;

        float NdotL      = max(dot(normal, sun_dir), 0.0);
        vec3  half_dir   = normalize(view_dir);
        float spec       = pow(max(dot(normal, half_dir), 0.0) * 0.9, 12.0); // shininess

        float edge_fade   = pow(1.0 - dot(normal, view_dir), 2.0);
        vec3 s1           = vec3(1.0) * spec  * 10.4;
        s1 += vec3(0.3, 0.0, 0.6) * edge_fade;

        vec3  color1   = texture(color, uv).rgb;
        vec3  cloud1   = texture(color, uv).rgb;
        outColor       = vec4(distortion + s1 * color1 + cloud1, 1.0);
    }

    func vertex[] -> GLSL none {
        const float M_PI = 3.1415926535897932384;

        v_uv        = vec2(1.0 - a_uv.x, a_uv.y);
        float theta = v_uv.x * 2.0 * M_PI; // longitude
        float phi   = v_uv.y * M_PI;       // latitude

        // Tangent: derivative of position w.r.t. u (around equator)
        v_tangent = normalize(vec3(-sin(theta), 0.0, cos(theta)));

        // Bitangent: derivative w.r.t. v (from pole to pole)
        v_bitangent = normalize(cross(v_tangent, a_pos)); // orthogonalized

        // Correctly rotate normal into world space
        mat3 normal_matrix = transpose(inverse(mat3(ubo.model)));
        v_normal    = normalize(normal_matrix * a_normal);
        v_tangent   = normalize(normal_matrix * v_tangent);
        v_bitangent = normalize(normal_matrix * v_bitangent);

        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }


##
shader Aura2
    mutable model          : mat4f
    mutable view           : mat4f
    mutable proj           : mat4f
    mutable v_model        : mat4f
    mutable v_view         : mat4f
    mutable v_proj         : mat4f
    mutable time           : f32
    mutable thrust         : f32
    mutable magnitude      : f32
    mutable colors         : f32
    mutable halo_space     : f32
    mutable halo_separate  : f32
    mutable halo_attenuate : f32
    mutable halo_thickness : f32
    mutable pad0           : f32
    mutable pad1           : f32
    mutable pad2           : f32
    public  cv             : Canvas
    public  core           : Canvas
    public  beam           : Canvas
    intern  w              : Window

    attrib  color : LayoutBinding [ type:typeid[ Surface ], id:Surface.color, count:2, format: typeid[ rgba8 ] ]

    func init []
        cv_size : i32 [ 128 ]

        cv   = Canvas [ vk: vk, format: Pixel.rgba8, width: cv_size, height: cv_size ]
        core = Canvas [ vk: vk, format: Pixel.rgba8, width: cv_size, height: cv_size ]
        beam = Canvas [ vk: vk, format: Pixel.rgba8, width: cv_size, height: cv_size ]

        # outer color
        core.clear[ '#0000' ]
        core.rect_to[ 0, 0, 800, 800 ]
        core.fill_color[ '#f00' ]
        core.paint[]

        # inner core
        core.arc[ 400.0, 400.0, 100.0, 0.0, 360.0 ]
        core.fill_color[ '#a0f' ]
        core.paint[]

        # core mantle
        core.arc[ 400.0, 400.0, 40.0, 0.0, 360.0 ]
        core.fill_color[ '#aff' ]
        core.paint[]

        # beam
        beam.clear[ '#0000' ]
        beam.rect_to[ 0, 0, 800, 800 ]
        beam.fill_color[ '#00f' ]
        beam.paint[]
        beam.arc[ 400.0, 400.0, 40.0, 0.0, 360.0 ]
        beam.fill_color[ '#aff' ]
        beam.paint[]

 ##

enum GaiaSurface
    color : 0

# sky sphere: viewed from INSIDE — no lighting, just the star map
ModelViewProject GaiaShader
    mutable gain : f32

    attrib color : LayoutBinding [ type:typeid[ GaiaSurface ], id:GaiaSurface.color, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_uv      : VertexOutput  [ type:typeid[ vec2f ] ]
    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]

    func init[]
        eye2    : vec3f [0.0f, 0.0f, 0.0f]
        target2 : vec3f [0.0f, 0.0f, 1.0f]
        up2     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[70.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_uv        = a_uv;
        gl_Position = ubo.proj * ubo.view * ubo.model * vec4(a_pos, 1.0);
    }

    func g_hash31 [ p: vec3f ] -> GLSL float {
        return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453);
    }

    func g_vnoise [ p: vec3f ] -> GLSL float {
        vec3 i = floor(p);
        vec3 f = fract(p);
        vec3 u = f * f * (3.0 - 2.0 * f);
        float n000 = g_hash31(i + vec3(0.0, 0.0, 0.0));
        float n100 = g_hash31(i + vec3(1.0, 0.0, 0.0));
        float n010 = g_hash31(i + vec3(0.0, 1.0, 0.0));
        float n110 = g_hash31(i + vec3(1.0, 1.0, 0.0));
        float n001 = g_hash31(i + vec3(0.0, 0.0, 1.0));
        float n101 = g_hash31(i + vec3(1.0, 0.0, 1.0));
        float n011 = g_hash31(i + vec3(0.0, 1.0, 1.0));
        float n111 = g_hash31(i + vec3(1.0, 1.0, 1.0));
        return mix(mix(mix(n000, n100, u.x), mix(n010, n110, u.x), u.y),
                   mix(mix(n001, n101, u.x), mix(n011, n111, u.x), u.y), u.z);
    }

    func fragment[] -> GLSL none {
        vec3 sky  = texture(color, v_uv).rgb;
        // galactic band: full boost at the equator, falling to the poles
        float band = 1.0 - abs(v_uv.y - 0.5) * 2.0;
        float g    = ubo.gain * mix(0.5, 2.3, smoothstep(0.0, 1.0, band));
        // violet cast: red and blue lifted over green
        vec3 tint  = vec3(1.12, 0.90, 1.32);
        // dust: a 2D slice of drifting 3D noise darkens the field.
        // value noise cells ran 1/5 of the map wide and smoothstep drew
        // their isoline as a hard diamond -- finer scales, four octaves
        // on offset domains, and a soft stretch instead of a threshold
        // six octaves, each on its own offset domain and drifting at
        // its own rate, so no two share a cell boundary. the top one
        // stops near 450 -- past that a cell is a pixel and it shimmers
        float t9 = ubo.time * 0.03;
        float d1 = g_vnoise(vec3(v_uv *  29.0, t9));
        float d2 = g_vnoise(vec3(v_uv *  61.0 + vec2( 7.0,  3.0), t9 * 1.7));
        float d3 = g_vnoise(vec3(v_uv * 127.0 + vec2(23.0, 11.0), t9 * 2.3));
        float d4 = g_vnoise(vec3(v_uv * 251.0 + vec2( 5.0, 29.0), t9 * 3.1));
        float d5 = g_vnoise(vec3(v_uv * 449.0 + vec2(31.0, 17.0), t9 * 4.3));
        float dn = 0.30 * d1 + 0.24 * d2 + 0.19 * d3
                 + 0.15 * d4 + 0.12 * d5;
        // a third of the previous bite: 0.62 took 38% out of the field,
        // this takes about 13%
        float dust = mix(1.0, 0.873, clamp((dn - 0.5) * 1.9 + 0.5, 0.0, 1.0));
        fragColor  = vec4(sky * tint * g * dust, 1.0);
    }

element MilkyWay
    frost : true
    frost_sharp : true
    # eased field of view; orbit steps zoom the gaze, not a distance
    intern e_cur  : f32
    intern p_cur  : f32
    intern gaia   : GaiaShader
    intern models : array Model
    intern target : Render
    intern built  : bool
    # async load: worker decodes, draw waits on ready for vk work
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    # decoded by the worker; the vk objects are built on the main thread.
    # the worker fills plain members only — a collection built on the worker
    # does not survive its pool drain intact
    intern geom      : GltfModel
    intern img_color : Image
    # flat clear-color pass; the backdrop from frame one
    intern plain     : Render
    public color  : rgba [ r:0.0, g:0.0, b:0.004, a:1.0 ]

    # worker thread: file reads and pixel decodes only, never a vk call
    func load_files[]
        gltf_path : path '../scenes/models/earth.gltf'
        geom      = GltfModel.open[ gltf_path ]
        img_color = Image [ uri: path '../scenes/textures/gaia.png', surface: GaiaSurface.color ]

    # main thread: every vk object this scene owns
    func build_models[]
        built     = true
        gaia      = GaiaShader [ vk: vk ]
        gaia_samplers : map Image [string] [ 'color': img_color ]
        gaia_model : Model [ vk: vk, w: ux, id: geom, s: gaia, samplers: gaia_samplers,
            straight_alpha: true, cull_none: true ]
        models     = array Model [ gaia_model ]

    # a modelless pass that just clears to the scene color, so the ux has a
    # backdrop to composite while the real one is still decoding
    func create_plain[]
        if [ plain || target ] return
        plain = Render [
            vk:          vk,
            w:           ux,
            wscale:      1.0,
            use_depth:   false,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      array Model [] ]
        plain.owner = a
        ux.element_targets[ id ] = plain

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        # swapping the map entry is what the window reads as a new backdrop;
        # it restarts reveal at 0 and fades the loaded scene in over the flat
        ux.element_targets[ id ] = target

    # unregister only; we keep our ref so the GPU graph outlives the frame
    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    # deep space: near-black panes, starlight blues
    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#0a0a1288',   # editor pane background
            '#140a2a80':  '#418a',   # console pane background
            '#ff6a2e55':  '#8a8ad455',   # search highlight fill
            '#220022aa':  '#0e0e18aa',   # run console base fill
            '#614':       '#424a',     # TButtons / nav rest fill
            '#413':       '#424e',     # TButtons hover fill
            '#826':       '#534e',     # TButtons lit / nav selected
            '#625a':      '#4248',       # bottom status bar fill
            '#8af2':      '#88a2',       # status bar inner glow
            '#425':       '#4184',     # editor selection color
            '#44225588':  '#8a8aaa11'    # editor line highlight
        ]

    func load_bg [ arg: object ]
        t0 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg start at {t0}'
        load_files[]
        t1 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg done in {t1 - t0}ms at {t1}'
        ready = true

    func draw [ w: Window ]
        animated = true
        create_plain[]
        if [ !loading ]
            loading = true
            w9 : array []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: @load_bg, work: w9 ]
        if [ !ready ] return
        if [ !built ] build_models[]
        create_target[]
        orbit[]

    func orbit[]
        aspect : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]
        # orbit steps become zoom: field of view narrows from far to low
        e_t    : f32 [ (ux.orbit_mode == OrbitView.low)  ? 45.0 :
                       (ux.orbit_mode == OrbitView.high) ? 65.0 : 85.0 ]
        if [ e_cur == 0.0 ] e_cur = e_t
        e_cur = filter_n[ e_cur, e_t, 0.08, ux.frame_factor ]

        # angle steps pitch the gaze off the galactic plane
        p_t    : f32 [ (ux.angle_mode == ViewAngle.flat)   ? 0.0 :
                       (ux.angle_mode == ViewAngle.angled) ? 0.35 : 0.80 ]
        p_cur  = filter_n[ p_cur, p_t, 0.08, ux.frame_factor ]
        ux.orbit_moving = abs[ e_cur - e_t ] > 0.02 || abs[ p_cur - p_t ] > 0.001

        _eye   : vec3f [ 0.0, 0.0, 0.0 ]
        _tgt   : vec3f [ 0.0, p_cur, 1.0 ]
        _up    : vec3f [ 0.0, -1.0, 0.0 ]
        _proj  : mat4f.perspective[ radians[ e_cur ], aspect, 0.01, 20.0 ]
        _view  : mat4f.look_at    [ _eye, _tgt, _up ]

        # ux.time counts kiloseconds: a slow drift across the sky
        spin_d : f32 [ ux.time * 900.0 ]
        m_spin : vec4f [ 0.0, 1.0, 0.0, radians[ spin_d ] ]
        q_spin : quatf [ m_spin ]
        mm : mat4f.identity[]
        mm = mm.rotate[ q_spin ]

        gaia.model = mm
        gaia.view  = _view
        gaia.proj  = _proj
        gaia.gain  = 0.88
        gaia.time  = ux.time * 60000.0


enum TitanSurface
    color  : 0
    height : 1
    height2 : 2
    nrm_a  : 3
    nrm_b  : 4

# Titan to spec: 1.45 bar N2, tholin haze — orange thickening at the
# limb, detached bluish upper layer, seasonal north polar hood
ModelViewProject TitanShader
    mutable gain    : f32
    mutable cam_pos : vec4f

    attrib color : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.color, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_normal    : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_uv        : VertexOutput [ type:typeid[ vec2f ] ]
    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]

    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]

    func init[]
        eye2    : vec3f [0.0f, 0.0f, 2.5f]
        target2 : vec3f [0.0f, 0.0f, 0.0f]
        up2     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_uv        = vec2(1.0 - a_uv.x, a_uv.y);
        mat3 nm     = transpose(inverse(mat3(ubo.model)));
        v_normal    = normalize(nm * a_normal);
        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        vec3  n        = normalize(v_normal);
        // half phase: the sun sits off to the side for both bodies
        vec3  sun      = normalize(vec3(0.85, -0.10, 0.15));
        vec3  view_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        float mu       = clamp(dot(n, view_dir), 0.0, 1.0);
        float h        = 1.0 - mu;
        // surface reads at disc center, dissolving into haze mid-disc
        float alb      = texture(color, v_uv).r;
        vec3  surf     = mix(vec3(0.30, 0.17, 0.07), vec3(1.0, 0.70, 0.34), alb);
        float sread    = (1.0 - smoothstep(0.0, 0.55, h)) * 0.45;
        // haze body with the lensing bands near the limb — the
        // classic cassini butterscotch, pale and creamy; the blue
        // layer is a DARK thin rim, not a glow
        vec3  warm     = vec3(0.95, 0.78, 0.54);
        vec3  cream    = vec3(0.99, 0.90, 0.72);
        vec3  blue     = vec3(0.20, 0.28, 0.58);
        vec3  hazec    = mix(warm, cream, smoothstep(0.62, 0.84, h));
        hazec          = mix(hazec, blue, smoothstep(0.86, 0.96, h));
        // seasonal hood: haze thickens over the north pole
        float hood     = smoothstep(0.78, 0.92, 1.0 - v_uv.y) * 0.35;
        vec3  col      = mix(hazec, surf, clamp(sread - hood, 0.0, 1.0));
        // terminator crosses the disc; the haze wraps it slightly
        float wrap     = clamp(dot(n, sun) * 0.5 + 0.5, 0.0, 1.0);
        float ndl      = max(dot(n, sun), 0.0);
        // wrapped haze light plus real diffuse so the ball reads round
        float lit      = 0.55 * wrap * wrap + 0.45 * ndl;
        col           *= (0.02 + 1.10 * lit) * ubo.gain;
        // tangent path absorption dims the disc toward its edges
        col           *= (0.78 + 0.22 * mu);
        // sun side gets a faint cool cast in the upper haze
        float sunside  = clamp(dot(n, sun), 0.0, 1.0);
        col           += vec3(0.10, 0.15, 0.32) * (sunside * sunside)
                       * smoothstep(0.60, 0.94, h) * 0.35 * ubo.gain;
        // soft outer edge: exponential falloff like a real scale
        // height — opaque core, then a long asymptotic feather
        float t        = clamp((h - 0.74) / 0.23, 0.0, 1.0);
        float a        = exp(-6.0 * t * t);
        fragColor      = vec4(col, a);
    }

# the rings: a squashed sphere shaded radially from the strip
# texture — model-space xz radius IS the ring coordinate
ModelViewProject RingShader
    mutable gain    : f32
    mutable cam_pos : vec4f

    attrib color : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.color, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_mpos      : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]

    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]

    func init[]
        eye2    : vec3f [0.0f, 0.0f, 2.5f]
        target2 : vec3f [0.0f, 0.0f, 0.0f]
        up2     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_mpos      = a_pos;
        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        // D-ring inner edge at 74500/140220 of the F-ring outer
        float rad = length(v_mpos.xz);
        float r0  = 0.531;
        float t   = (rad - r0) / (1.0 - r0);
        if (t < 0.0 || t > 1.0) { fragColor = vec4(0.0); return; }
        vec4  band = texture(color, vec2(t, 0.5));
        vec3  sun  = normalize(vec3(0.85, -0.10, 0.15));
        // the ring plane normal in world; both faces take light
        vec3  pn   = normalize((ubo.model * vec4(0.0, 1.0, 0.0, 0.0)).xyz);
        float ndl  = abs(dot(pn, sun));
        // saturn's shadow: anti-sun side, within the ball's cylinder
        vec3  ctr  = (ubo.model * vec4(0.0, 0.0, 0.0, 1.0)).xyz;
        float rout = length((ubo.model * vec4(1.0, 0.0, 0.0, 0.0)).xyz);
        vec3  p    = v_world_pos.xyz - ctr;
        vec3  q    = p - sun * dot(p, sun);
        float rp   = 0.430 * rout;
        float sh   = (dot(p, sun) < 0.0)
                   ? mix(0.12, 1.0, smoothstep(rp * 0.96, rp * 1.04, length(q)))
                   : 1.0;
        vec3  col  = band.rgb * (0.03 + 0.97 * ndl) * sh * ubo.gain;
        float a    = band.a * smoothstep(0.0, 0.012, t) * (1.0 - smoothstep(0.985, 1.0, t));
        fragColor  = vec4(col, a);
    }

# saturn seen from titan: side-lit to the same half phase
ModelViewProject SaturnShader
    mutable gain    : f32
    mutable cam_pos : vec4f

    attrib color  : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.color,  count:1, format: typeid[ rgba8 ] ]
    # the ring strip: its alpha at the sun-crossing radius IS the shadow
    attrib height : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.height, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_normal    : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_uv        : VertexOutput [ type:typeid[ vec2f ] ]
    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]
    attrib v_mpos      : VertexOutput [ type:typeid[ vec3f ] ]

    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]

    func init[]
        eye2    : vec3f [0.0f, 0.0f, 2.5f]
        target2 : vec3f [0.0f, 0.0f, 0.0f]
        up2     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_uv        = vec2(1.0 - a_uv.x, a_uv.y);
        v_mpos      = a_pos;
        mat3 nm     = transpose(inverse(mat3(ubo.model)));
        v_normal    = normalize(nm * a_normal);
        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        vec3  n        = normalize(v_normal);
        vec3  sun      = normalize(vec3(0.85, -0.10, 0.15));
        vec3  view_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        // ring shadow: trace this point toward the sun in MODEL space;
        // where the ray crosses the equator inside the annulus, the
        // ring strip's alpha at that radius blocks the light
        vec3  sm  = normalize(transpose(mat3(ubo.model)) * sun);
        float shad = 1.0;
        if (abs(sm.y) > 1e-4) {{
            float tr = -v_mpos.y / sm.y;
            if (tr > 0.0) {{
                vec3  q  = v_mpos + sm * tr;
                float rr = length(q.xz) / 2.325;
                float ur = (rr - 0.531) / 0.469;
                if (ur > 0.0 && ur < 1.0) {{
                    float ra = texture(height, vec2(ur, 0.5)).a;
                    shad = 1.0 - ra * 0.85;
                }}
            }}
        }}
        // zonal winds: the equatorial jet plus alternating lobes —
        // neighboring bands shear past each other like the real thing
        float la = v_uv.y - 0.5;
        float w  = 0.60 * exp(-la * la / 0.012)
                 + 0.22 * cos(la * 43.98) * exp(-abs(la) * 1.8);
        // flow ping-pong: two half-cycle phases crossfaded, so shear
        // stays bounded and the bands slide forever without smearing
        float t9 = ubo.time * 0.05;
        float p0 = fract(t9);
        float p1 = fract(t9 + 0.5);
        float s0 = w * (p0 - 0.5) * 0.16;
        float s1 = w * (p1 - 0.5) * 0.16;
        float bl = abs(2.0 * p0 - 1.0);
        vec3  alb = mix(texture(color, vec2(v_uv.x + s0, v_uv.y)).rgb,
                        texture(color, vec2(v_uv.x + s1, v_uv.y)).rgb, bl);
        // wrapped like the moon, or opposite phases read as broken
        float wr9      = clamp(dot(n, sun) * 0.5 + 0.5, 0.0, 1.0);
        float ndl      = wr9 * wr9 * shad;
        float mu       = clamp(dot(n, view_dir), 0.0, 1.0);
        vec3  col      = alb * (0.08 + 0.92 * ndl) * ubo.gain;
        // slight edge softening at this distance
        float a        = smoothstep(0.0, 0.18, mu);
        fragColor      = vec4(col, a);
    }

element Titan
    frost : true
    frost_sharp : true
    # eased camera distance / angle; p_set marks the first frame
    intern e_cur  : f32
    intern p_cur  : f32
    intern p_set  : bool
    intern titan  : TitanShader
    intern saturn : SaturnShader
    intern rings  : RingShader
    intern models : array Model
    intern target : Render
    intern built  : bool
    # async load: worker decodes, draw waits on ready for vk work
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    public color  : rgba [ r:0.004, g:0.003, b:0.006, a:1.0 ]

    func build_models[]
        built     = true
        gltf_path : path '../scenes/models/earth.gltf'
        gltf      : GltfModel.open[ gltf_path ]
        titan     = TitanShader [ vk: vk ]
        t_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/titan-color.png', surface: TitanSurface.color ]
        ]
        titan_model : Model [ vk: vk, w: ux, id: gltf, s: titan, samplers: t_samplers, straight_alpha: true ]
        saturn    = SaturnShader [ vk: vk ]
        s_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/saturn-color.png', surface: TitanSurface.color,
                wrap_u: true ],
            'height': Image [ uri: path '../scenes/textures/saturn-ring-alpha.png', surface: TitanSurface.height ]
        ]
        saturn_model : Model [ vk: vk, w: ux, id: gltf, s: saturn, samplers: s_samplers, straight_alpha: true ]
        rings     = RingShader [ vk: vk ]
        r_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/saturn-ring-alpha.png', surface: TitanSurface.color ]
        ]
        ring_model : Model [ vk: vk, w: ux, id: gltf, s: rings, samplers: r_samplers,
            straight_alpha: true ]
        models = array Model [ saturn_model, ring_model, titan_model ]

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        ux.element_targets[ id ] = target

    # unregister only; we keep our ref so the GPU graph outlives the frame
    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    # tholin sky: the ui goes deep amber-brown under the haze
    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#432a',       # editor pane background
            '#140a2a80':  '#148a',       # console pane background
            '#ff6a2e55':  '#ffb04a55',   # search highlight fill
            '#220022aa':  '#1e1206aa',   # run console base fill
            '#614':       '#4c3210',     # TButtons / nav rest fill
            '#413':       '#38240c',     # TButtons hover fill
            '#826':       '#6e4a18',     # TButtons lit / nav selected
            '#625a':      '#5428',       # bottom status bar fill
            '#8af2':      '#fc82',       # status bar inner glow
            '#425':       '#18a8',     # editor selection color
            '#44225588':  '#18a4'    # editor line highlight
        ]

    func load_bg [ arg: object ]
        t0 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg start at {t0}'
        build_models[]
        t1 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg done in {t1 - t0}ms at {t1}'
        ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : array []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: @load_bg, work: w9 ]
        if [ !ready ] return
        create_target[]
        orbit[]

    func orbit[]
        aspect : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]
        # pulled back: titan reads small with saturn owning the sky
        e_t    : f32 [ (ux.orbit_mode == OrbitView.low)  ? 2.60 :
                       (ux.orbit_mode == OrbitView.high) ? 3.40 : 4.60 ]
        if [ e_cur == 0.0 ] e_cur = e_t
        e_cur = filter_n[ e_cur, e_t, 0.08, ux.frame_factor ]

        p_t    : f32 [ (ux.angle_mode == ViewAngle.flat)   ? 0.0 :
                       (ux.angle_mode == ViewAngle.angled) ? 0.156 : 0.480 ]
        if [ p_cur == 0.0 && p_t != 0.0 && !p_set ] p_cur = p_t
        p_set  = true
        p_cur  = filter_n[ p_cur, p_t, 0.08, ux.frame_factor ]

        ux.orbit_moving = abs[ e_cur - e_t ] > 0.002 || abs[ p_cur - p_t ] > 0.001
        e_d    : f32 [ e_cur ]
        _eye   : vec3f [ 0.0,  e_d * p_cur, e_d ]
        _tgt   : vec3f [ 0.0,  0.0,  0.0  ]
        _up    : vec3f [ 0.0, -1.0,  0.0  ]

        _proj  : mat4f.perspective[ radians[ 60.0 ], aspect, 0.01, 60.0 ]
        _view  : mat4f.look_at    [ _eye, _tgt, _up ]

        # Titan turns once per 15.9 days — a gentle drift here
        spin_d : f32 [ ux.time * 2400.0 ]
        m_spin : vec4f [ 0.0, 1.0, 0.0, radians[ spin_d ] ]
        q_spin : quatf [ m_spin ]
        mm : mat4f.identity[]
        mm = mm.rotate[ q_spin ]

        titan.model   = mm
        titan.view    = _view
        titan.proj    = _proj
        titan.gain    = 1.15
        titan.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]

        # Saturn hangs huge in the sky, up and left, tidally fixed
        s_off  : vec3f [ -8.0, -4.5, -20.0 ]
        s_sc   : vec3f [ 10.5, 10.5, 10.5 ]
        s_axis : vec4f [ 0.0, 0.0, 1.0, radians[ 26.7 ] ]
        sq     : quatf [ s_axis ]
        # tip the whole assembly toward the viewer: the ring plane
        # opens into an ellipse instead of slicing the scene edge-on
        s_tip  : vec4f [ 1.0, 0.0, 0.0, radians[ 20.0 ] ]
        sq3    : quatf [ s_tip ]
        s_spin : vec4f [ 0.0, 1.0, 0.0, radians[ ux.time * 9000.0 ] ]
        sq2    : quatf [ s_spin ]
        sm : mat4f.identity[]
        sm = sm.translate[ s_off ]
        sm = sm.rotate   [ sq3 ]
        sm = sm.rotate   [ sq ]
        sm = sm.rotate   [ sq2 ]
        sm = sm.scale    [ s_sc ]
        saturn.model    = sm
        saturn.view     = _view
        saturn.proj     = _proj
        saturn.gain     = 1.9
        saturn.cam_pos  = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        saturn.time     = ux.time * 60000.0

        # rings share saturn's frame: F-ring outer = 2.325x the ball
        r_sc : vec3f [ 24.4, 0.02, 24.4 ]
        rm : mat4f.identity[]
        rm = rm.translate[ s_off ]
        rm = rm.rotate   [ sq3 ]
        rm = rm.rotate   [ sq ]
        rm = rm.scale    [ r_sc ]
        rings.model   = rm
        rings.view    = _view
        rings.proj    = _proj
        rings.gain    = 1.9
        rings.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]


# enceladus geysers: procedural jets fanning off the south cone
# into a soft veil — a shell around the moon, nothing textured
ModelViewProject PlumeShader
    mutable gain    : f32
    mutable cam_pos : vec4f

    attrib color : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.color, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_mpos      : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]

    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]

    func init[]
        eye2    : vec3f [0.0f, 0.0f, 2.5f]
        target2 : vec3f [0.0f, 0.0f, 0.0f]
        up2     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_mpos      = a_pos;
        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func p_perm4 [ x: vec4f ] -> GLSL vec4f {
        return mod((x * 34.0 + 1.0) * x, vec4(289.0));
    }

    func p_isqrt4 [ r: vec4f ] -> GLSL vec4f {
        return 1.79284291400159 - 0.85373472095314 * r;
    }

    func p_gnoise [ P: vec3f ] -> GLSL float {
        vec3 Pi0 = mod(floor(P), vec3(289.0));
        vec3 Pi1 = mod(Pi0 + vec3(1.0), vec3(289.0));
        vec3 Pf0 = fract(P);
        vec3 Pf1 = Pf0 - vec3(1.0);
        vec4 ix  = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
        vec4 iy  = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
        vec4 iz0 = vec4(Pi0.z);
        vec4 iz1 = vec4(Pi1.z);
        vec4 ixy  = p_perm4(p_perm4(ix) + iy);
        vec4 ixy0 = p_perm4(ixy + iz0);
        vec4 ixy1 = p_perm4(ixy + iz1);
        vec4 gx0 = fract(ixy0 / 7.0) * 2.0 - 1.0;
        vec4 gy0 = fract(floor(ixy0 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz0 = 1.0 - abs(gx0) - abs(gy0);
        vec4 gx1 = fract(ixy1 / 7.0) * 2.0 - 1.0;
        vec4 gy1 = fract(floor(ixy1 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz1 = 1.0 - abs(gx1) - abs(gy1);
        vec4 sz0 = step(gz0, vec4(0.0));
        gx0 -= sz0 * (step(0.0, gx0) - 0.5);
        gy0 -= sz0 * (step(0.0, gy0) - 0.5);
        vec4 sz1 = step(gz1, vec4(0.0));
        gx1 -= sz1 * (step(0.0, gx1) - 0.5);
        gy1 -= sz1 * (step(0.0, gy1) - 0.5);
        vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
        vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
        vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
        vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
        vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
        vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
        vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
        vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);
        vec4 nm0 = p_isqrt4(vec4(dot(g000,g000), dot(g010,g010), dot(g100,g100), dot(g110,g110)));
        g000 *= nm0.x; g010 *= nm0.y; g100 *= nm0.z; g110 *= nm0.w;
        vec4 nm1 = p_isqrt4(vec4(dot(g001,g001), dot(g011,g011), dot(g101,g101), dot(g111,g111)));
        g001 *= nm1.x; g011 *= nm1.y; g101 *= nm1.z; g111 *= nm1.w;
        float n000 = dot(g000, Pf0);
        float n100 = dot(g100, vec3(Pf1.x, Pf0.y, Pf0.z));
        float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
        float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
        float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
        float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
        float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
        float n111 = dot(g111, Pf1);
        vec3  fxyz = Pf0 * Pf0 * Pf0 * (Pf0 * (Pf0 * 6.0 - 15.0) + 10.0);
        vec4  n_z  = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fxyz.z);
        vec2  n_yz = mix(n_z.xy, n_z.zw, fxyz.y);
        return mix(n_yz.x, n_yz.y, fxyz.x) * 0.5 + 0.5;
    }

    # the surface's province field, verbatim — a vent only ignites in
    # the darkest terrain, so placement is seeded by the image
    func vent_weight [ pm: vec3f ] -> GLSL float {
        float pv = p_gnoise(pm * 2.2 + vec3(5.0, 11.0, 3.0));
        return 1.0 - smoothstep(0.30, 0.70, pv);
    }

    func fragment[] -> GLSL none {
        // ray march through a field of vent cones: the quad is only
        // screen coverage — the columns are computed in 3d along the
        // view ray, so they stand in space and occlude correctly
        // 4 vent clusters spread over the whole ball, 3 sources each;
        // every jet fires along its surface normal — nearby cluster
        // members diverge like a fan by geometry alone: the streaks
        // a forest: 8 skewed fissure clusters over the whole ball —
        // a ray through the planet's vicinity threads several jets
        const float AZ[48]   = float[](0.38, 0.52, 0.63,  1.24, 1.31, 1.35,  2.16, 2.21, 2.24,  2.94, 3.05, 3.13,
                                       3.78, 3.91, 4.02,  4.62, 4.68, 4.77,  5.40, 5.52, 5.60,  6.02, 6.10, 6.14,
                                       0.90, 1.70, 2.60, 3.40, 4.30, 5.00, 5.90, 0.10,
                                       1.68, 1.76, 1.83,  3.29, 3.36, 3.41,  4.08, 4.16, 4.24,  5.79, 5.86, 5.92,
                                       0.65, 2.50, 3.60, 5.15);
        const float LAT[48]  = float[](0.545, 0.585, 0.610,  -0.88, -0.82, -0.76,  -0.30, -0.19, -0.09,  0.86, 0.91, 0.98,
                                       0.10, 0.17, 0.26,  -1.18, -1.12, -1.08,  -0.64, -0.72, -0.76,  0.30, 0.37, 0.41,
                                       -0.45, 0.72, 0.45, -1.00, 0.62, -0.05, 0.95, -0.52,
                                       0.34, 0.42, 0.47,  -0.58, -0.50, -0.45,  0.60, 0.68, 0.72,  -0.34, -0.26, -0.21,
                                       -0.15, 0.78, 1.05, -0.95);
        vec3 e_p0[48];
        for (int i = 0; i < 48; i++) {{
            float cl = cos(LAT[i]);
            e_p0[i] = vec3(cl * sin(AZ[i]), sin(LAT[i]), cl * cos(AZ[i]));
        }}
        vec3  ro  = ubo.cam_pos.xyz;
        vec3  rd  = normalize(v_world_pos.xyz - ro);
        // one shell layer only: inside we see its far side, outside
        // its near side — the guard stops the outside double-count
        if (dot(ro, ro) >= 1.69 && !gl_FrontFacing) { fragColor = vec4(0.0); return; }
        // the moon blocks the march past its surface
        float b     = dot(ro, rd);
        float c     = dot(ro, ro) - 1.0;
        float dsc   = b * b - c;
        float s_hit = (dsc > 0.0) ? (-b - sqrt(dsc)) : 1e9;
        if (s_hit < 0.0) s_hit = 1e9;
        // march the segment crossing the plume bounding sphere
        // small jets (~1/8 former scale): stepping under-samples them,
        // so each contributes its ANALYTIC ray integral at closest
        // approach — the ray walks the 3d emitter list exactly
        float sumc = 0.0;
        float sumh = 0.0;
        for (int i = 0; i < 48; i++) {{
            vec3  p0 = e_p0[i];
            vec3  w0 = ro - p0;
            float aa = dot(rd, p0);
            float d0 = dot(rd, w0);
            float d1 = dot(p0, w0);
            float dn = max(1.0 - aa * aa, 1e-4);
            float s9 = (aa * d1 - d0) / dn;
            float t9 = (d1 - aa * d0) / dn;
            if (s9 < 0.02) continue;
            // soft occlusion at the limb — nothing pops binary
            float occ = 1.0 - smoothstep(s_hit - 0.10, s_hit + 0.10, s9);
            if (occ <= 0.0) continue;
            float tt  = max(t9, 0.0);
            // soft emergence at the vent, pure attenuation outward —
            // no end cut: the exp IS the ending
            float env = smoothstep(-0.015, 0.025, t9) * exp(-9.0 * tt);
            vec3  qp = w0 + s9 * rd - t9 * p0;
            float d2 = dot(qp, qp);
            // a real cone: the plume flares open as it rises
            float sg = 0.008 + 0.10 * tt;
            float gc = exp(-d2 / (sg * sg));
            float gh = 0.15 * exp(-d2 / (9.0 * sg * sg));
            float boost = 1.0 / sqrt(max(dn, 0.20));
            // emission rides a 3d perlin field: each frame renders a
            // moving cross-section — advected along the axis it ROLLS
            // continuous modulation: |qp| never flips across the axis
            // (the vector form did — hard wedge edges), the seed rides
            // the source position, and time evolves the slice
            float rq = length(qp);
            float sd = dot(p0, vec3(37.7, 17.3, 29.1));
            vec3  sp = vec3(rq * 30.0, sd, ubo.time * 0.15);
            float n1 = p_gnoise(sp);
            // azimuthal desync, faded to zero at the axis where the
            // qp direction flips — continuous everywhere, async around
            vec3  sq = qp * 24.0 + vec3(sd, ubo.time * 0.13, 0.0);
            float n2 = p_gnoise(sq);
            float aw = smoothstep(0.0, sg * 1.2, rq);
            float nn = mix(n1, 0.45 * n1 + 0.55 * n2, aw);
            float m  = 0.45 + 1.10 * (nn * nn * (3.0 - 2.0 * nn));
            // fingers: the azimuthal perlin sharpened hard at the
            // source, dissolving to a smooth column by half height
            float fing = pow(clamp(n2, 0.0, 1.0), 3.0);
            float fw   = exp(-4.6 * tt) * aw;
            m *= mix(1.0, 0.20 + 2.4 * fing, fw);
            // seeded by the surface: dark provinces erupt, bright ice
            // stays quiet — placement emerges from the image field
            float vw = vent_weight(p0);
            float w9 = env * boost * occ * m * 0.30 * (0.22 + 0.78 * vw * vw);
            sumc += gc * w9;
            sumh += gh * w9;
        }}
        // soft horizon: a whisper-thin exponential atmosphere at the
        // ray's closest approach — the lens hugs the limb tight
        float tca = 0.0 - dot(ro, rd);
        if (tca > 0.0) {{
            vec3  pca  = ro + rd * tca;
            float rc   = length(pca);
            // outward: a long slow fade into space — the rim breathes
            float od   = exp(-max(rc - 1.0, 0.0) / 0.014) * smoothstep(0.930, 0.995, rc);
            // smooth occlusion: the binary cut stamped the analytic
            // sphere's silhouette as a dark circle over the terrain
            float dip  = clamp((1.0 - rc) / 0.060, 0.0, 1.0);
            float hocc = mix(1.0, 0.60, dip);
            vec3  sunh = normalize(vec3(0.85, -0.10, 0.15));
            float hw   = clamp(dot(pca / max(rc, 1e-4), sunh) * 0.5 + 0.5, 0.0, 1.0);
            // blaze where the graze kisses the surface: the light
            // itself dissolves the terrain edge
            float nearg = exp(-abs(rc - 1.0) / 0.010);
            sumc += od * hocc * (0.10 + 0.40 * hw) * (1.0 + 2.5 * nearg);
        }}
        // pale ice spine wrapped in rich blue breadth
        float tot = sumc + sumh;
        vec3  icy = (vec3(0.85, 0.92, 1.0) * sumc + vec3(0.30, 0.50, 1.0) * sumh)
                  / max(tot, 1e-5);
        fragColor = vec4(icy, clamp(tot * ubo.gain, 0.0, 0.9));
    }

# the icy surface with the vent field casting light onto it —
# emitter positions mirror PlumeShader's list exactly
ModelViewProject EnceladusShader
    mutable gain    : f32
    mutable cam_pos : vec4f
    # real geometry displacement, in sphere radii
    mutable displace : f32

    attrib height  : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.height,  count:1, format: typeid[ rgba8 ] ]
    attrib detail2 : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.height2, count:1, format: typeid[ rgba8 ] ]
    # baked offline from the two height maps: RG = normal xy, B = cavity
    attrib nrmA    : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.nrm_a,   count:1, format: typeid[ rgba8 ] ]
    attrib nrmB    : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.nrm_b,   count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_normal    : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_uv        : VertexOutput [ type:typeid[ vec2f ] ]
    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]

    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]
    # object-space point, so the noise stays pinned as the moon turns
    attrib v_sp        : VertexOutput [ type:typeid[ vec3f ] ]
    # the displacement height, carried down so the fragment never has
    # to sample the map itself -- that is what shattered into speckle
    attrib v_h         : VertexOutput [ type:typeid[ f32 ] ]

    func e_perm4 [ x: vec4f ] -> GLSL vec4f {
        return mod((x * 34.0 + 1.0) * x, vec4(289.0));
    }

    func e_isqrt4 [ r: vec4f ] -> GLSL vec4f {
        return 1.79284291400159 - 0.85373472095314 * r;
    }

    # gradient noise: zero at every lattice point, so nothing it drives
    # lines up with the grid the way value noise does
    func e_gnoise [ P: vec3f ] -> GLSL float {
        vec3 Pi0 = mod(floor(P), vec3(289.0));
        vec3 Pi1 = mod(Pi0 + vec3(1.0), vec3(289.0));
        vec3 Pf0 = fract(P);
        vec3 Pf1 = Pf0 - vec3(1.0);
        vec4 ix  = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
        vec4 iy  = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
        vec4 iz0 = vec4(Pi0.z);
        vec4 iz1 = vec4(Pi1.z);
        vec4 ixy  = e_perm4(e_perm4(ix) + iy);
        vec4 ixy0 = e_perm4(ixy + iz0);
        vec4 ixy1 = e_perm4(ixy + iz1);
        vec4 gx0 = fract(ixy0 / 7.0) * 2.0 - 1.0;
        vec4 gy0 = fract(floor(ixy0 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz0 = 1.0 - abs(gx0) - abs(gy0);
        vec4 gx1 = fract(ixy1 / 7.0) * 2.0 - 1.0;
        vec4 gy1 = fract(floor(ixy1 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz1 = 1.0 - abs(gx1) - abs(gy1);
        vec4 sz0 = step(gz0, vec4(0.0));
        gx0 -= sz0 * (step(0.0, gx0) - 0.5);
        gy0 -= sz0 * (step(0.0, gy0) - 0.5);
        vec4 sz1 = step(gz1, vec4(0.0));
        gx1 -= sz1 * (step(0.0, gx1) - 0.5);
        gy1 -= sz1 * (step(0.0, gy1) - 0.5);
        vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
        vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
        vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
        vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
        vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
        vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
        vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
        vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);
        vec4 nm0 = e_isqrt4(vec4(dot(g000,g000), dot(g010,g010), dot(g100,g100), dot(g110,g110)));
        g000 *= nm0.x; g010 *= nm0.y; g100 *= nm0.z; g110 *= nm0.w;
        vec4 nm1 = e_isqrt4(vec4(dot(g001,g001), dot(g011,g011), dot(g101,g101), dot(g111,g111)));
        g001 *= nm1.x; g011 *= nm1.y; g101 *= nm1.z; g111 *= nm1.w;
        float n000 = dot(g000, Pf0);
        float n100 = dot(g100, vec3(Pf1.x, Pf0.y, Pf0.z));
        float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
        float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
        float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
        float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
        float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
        float n111 = dot(g111, Pf1);
        vec3  fxyz = Pf0 * Pf0 * Pf0 * (Pf0 * (Pf0 * 6.0 - 15.0) + 10.0);
        vec4  n_z  = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fxyz.z);
        vec2  n_yz = mix(n_z.xy, n_z.zw, fxyz.y);
        return mix(n_yz.x, n_yz.y, fxyz.x) * 0.5 + 0.5;
    }

    # the map patched in at three scales on offset domains, mixed by a
    # large perlin. ONE straight equirect lookup pinches at the pole and
    # reads as hair; this stops any single scale carrying the surface
    func h_patch [ uv: vec2f, sp: vec3f ] -> GLSL float {
        float w1 = e_gnoise(sp * 1.30);
        float w2 = e_gnoise(sp * 2.70 + vec3(19.0, 7.0, 41.0));
        // TWO different maps, each turned to its own angle and scale,
        // so neither one's grain lines up with the other or with the
        // equirect grid. the perlin picks which one owns each region
        float c1 = cos(0.70);  float s1 = sin(0.70);
        float c2 = cos(2.30);  float s2 = sin(2.30);
        // meridian mirror-blend: the u-wrap lands mid-tile under
        // these rotations — evaluate a half-turn clone and
        // interpolate across the seam band
        float sd  = min(uv.x, 1.0 - uv.x);
        float sk  = smoothstep(0.0, 0.06, sd);
        vec2  uvb = vec2(fract(uv.x + 0.5), uv.y);
        vec2  ua  = mat2(c1, s1, -s1, c1) * uv  * 1.60 + vec2(0.13, 0.41);
        vec2  ub  = mat2(c2, s2, -s2, c2) * uv  * 3.10 + vec2(0.61, 0.07);
        vec2  ua2 = mat2(c1, s1, -s1, c1) * uvb * 1.60 + vec2(0.13, 0.41);
        vec2  ub2 = mat2(c2, s2, -s2, c2) * uvb * 3.10 + vec2(0.61, 0.07);
        float a  = mix(textureLod(height,  ua2, 0.0).r, textureLod(height,  ua, 0.0).r, sk);
        float b  = mix(textureLod(detail2, ub2, 0.0).r, textureLod(detail2, ub, 0.0).r, sk);
        return mix(a, b, smoothstep(0.30, 0.70, w1)) * (0.85 + 0.30 * w2);
    }

    func init[]
        eye2    : vec3f [0.0f, 0.0f, 2.5f]
        target2 : vec3f [0.0f, 0.0f, 0.0f]
        up2     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_uv        = vec2(1.0 - a_uv.x, a_uv.y);
        v_sp        = normalize(a_pos);
        mat3 nm     = transpose(inverse(mat3(ubo.model)));
        v_normal    = normalize(nm * a_normal);
        // displace the SPHERE. the surface was a perfect ball before,
        // with all its relief faked by a normal tilt -- which is what
        // painted the hairline black and white over it
        float hv    = h_patch(v_uv, v_sp);
        v_h         = hv;
        vec3  disp  = a_pos + a_normal * (hv - 0.5) * ubo.displace;
        vec4 wpos   = ubo.model * vec4(disp, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        const float AZ[48]   = float[](0.38, 0.52, 0.63,  1.24, 1.31, 1.35,  2.16, 2.21, 2.24,  2.94, 3.05, 3.13,
                                       3.78, 3.91, 4.02,  4.62, 4.68, 4.77,  5.40, 5.52, 5.60,  6.02, 6.10, 6.14,
                                       0.90, 1.70, 2.60, 3.40, 4.30, 5.00, 5.90, 0.10,
                                       1.68, 1.76, 1.83,  3.29, 3.36, 3.41,  4.08, 4.16, 4.24,  5.79, 5.86, 5.92,
                                       0.65, 2.50, 3.60, 5.15);
        const float LAT[48]  = float[](0.545, 0.585, 0.610,  -0.88, -0.82, -0.76,  -0.30, -0.19, -0.09,  0.86, 0.91, 0.98,
                                       0.10, 0.17, 0.26,  -1.18, -1.12, -1.08,  -0.64, -0.72, -0.76,  0.30, 0.37, 0.41,
                                       -0.45, 0.72, 0.45, -1.00, 0.62, -0.05, 0.95, -0.52,
                                       0.34, 0.42, 0.47,  -0.58, -0.50, -0.45,  0.60, 0.68, 0.72,  -0.34, -0.26, -0.21,
                                       -0.15, 0.78, 1.05, -0.95);
        vec3  n        = normalize(v_normal);
        vec3  sun      = normalize(vec3(0.85, -0.10, 0.15));
        vec3  view_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        float dist9 = length(ubo.cam_pos.xyz - v_world_pos.xyz);

        // baked normal + cavity sampled with REAL mips (lod-0 is what
        // speckled), through the same patch transforms as the mesh so
        // shading always agrees with the displacement
        float w1 = e_gnoise(v_sp * 1.30);
        float c1 = cos(0.70);  float s1 = sin(0.70);
        float c2 = cos(2.30);  float s2 = sin(2.30);
        // same meridian mirror-blend as the mesh displacement
        float sd  = min(v_uv.x, 1.0 - v_uv.x);
        float sk  = smoothstep(0.0, 0.06, sd);
        vec2  uvb = vec2(fract(v_uv.x + 0.5), v_uv.y);
        vec2  ua  = mat2(c1, s1, -s1, c1) * v_uv * 1.60 + vec2(0.13, 0.41);
        vec2  ub  = mat2(c2, s2, -s2, c2) * v_uv * 3.10 + vec2(0.61, 0.07);
        vec2  ua2 = mat2(c1, s1, -s1, c1) * uvb  * 1.60 + vec2(0.13, 0.41);
        vec2  ub2 = mat2(c2, s2, -s2, c2) * uvb  * 3.10 + vec2(0.61, 0.07);
        vec4  pa = mix(texture(nrmA, ua2), texture(nrmA, ua), sk);
        vec4  pb = mix(texture(nrmB, ub2), texture(nrmB, ub), sk);
        float wA = smoothstep(0.30, 0.70, w1);
        vec2  nxy = mix(pa.rg, pb.rg, wA) * 2.0 - 1.0;
        float cav = mix(pa.b, pb.b, wA);
        float dfade = 1.0 - smoothstep(0.9, 2.6, dist9);
        if (dfade > 0.0) {{
            vec3 t_e = normalize(cross(vec3(0.0, 1.0, 0.0), n));
            vec3 t_n = cross(n, t_e);
            n = normalize(n + (t_e * nxy.x + t_n * nxy.y) * 2.0 * dfade);
        }}

        // AO: the broad height term plus the baked cavity darkening
        // scar field: proximity to ACTIVE vents (same seeding as the
        // plume), driving the local deep-crack brushing
        float scar9 = 0.0;
        for (int i = 0; i < 48; i++) {{
            float cl = cos(LAT[i]);
            vec3  p0 = vec3(cl * sin(AZ[i]), sin(LAT[i]), cl * cos(AZ[i]));
            float pv0 = e_gnoise(p0 * 2.2 + vec3(5.0, 11.0, 3.0));
            float vw0 = 1.0 - smoothstep(0.30, 0.70, pv0);
            vec3  dv0 = v_world_pos.xyz - p0;
            scar9 += exp(-dot(dv0, dv0) / 0.045) * (0.10 + 0.90 * vw0 * vw0);
        }}
        scar9 = clamp(scar9, 0.0, 1.0);
        // perlin-brushed deep cracks: the cavity source re-sampled
        // tighter and rotated, patched in organically by the brush —
        // floored so every emitting site visibly scars
        float br  = e_gnoise(v_sp * 9.0 + vec3(2.0, 17.0, 8.0));
        float brm = (0.35 + 0.65 * smoothstep(0.35, 0.75, br)) * scar9;
        float cav2 = mix(texture(nrmA, ua2 * 3.7 + vec2(0.37, 0.71)).b,
                         texture(nrmA, ua  * 3.7 + vec2(0.37, 0.71)).b, sk);
        float ao = (0.88 + 0.12 * clamp(v_h, 0.0, 1.0)) * (1.0 - cav * 0.50 * dfade);
        // base scar darkening plus crack accents: the cavity channel
        // is sparse (mean 0.15), so gating everything on it hid it all
        ao *= 1.0 - (0.28 + cav2 * 0.55) * brm;
        // darker body: ridges pop against it and the cuts run deep
        vec3  alb = mix(vec3(0.62, 0.66, 0.75), vec3(0.88, 0.90, 0.96),
                        clamp(v_h, 0.0, 1.0));
        alb = mix(alb, vec3(0.38, 0.48, 0.72), cav * 0.70 * dfade);
        // large perlin provinces: broad dark terrain regions, not one
        // uniform reflecting white — plus general contrast stretch
        float pv = e_gnoise(v_sp * 2.2 + vec3(5.0, 11.0, 3.0));
        alb *= 0.60 + 0.50 * smoothstep(0.25, 0.75, pv);
        // the scarred ice around live vents runs deep glacial blue
        alb = mix(alb, vec3(0.30, 0.42, 0.64), (0.30 + cav2 * 0.55) * brm);
        // wrapped light: the night side dims, never goes void.
        // squaring wr crushed the mids, and a 0.06 floor sent anything
        // angled to black -- on the most reflective body in the system
        // SAME response curve as saturn: equal geometry must show
        // equal phase, or a full moon sits under a new saturn
        float wr       = clamp(dot(n, sun) * 0.5 + 0.5, 0.0, 1.0);
        float lit      = wr * wr;
        // silhouette alpha rides the SMOOTH geometric normal — the
        // detail tilt drove it negative in patches and punched holes
        float mu       = clamp(dot(normalize(v_normal), view_dir), 0.0, 1.0);
        // night sweep: the dark side goes truly dark, and the deep
        // ice answers — the ao/texture field becomes the light source
        float night = 1.0 - smoothstep(0.10, 0.50, wr);
        float amb   = mix(0.26, 0.02, night);
        vec3  col   = alb * ao * (amb + 0.74 * lit) * ubo.gain;
        // coverage tiers: ~5% of the surface glows at full strength,
        // ~25% at an eighth, the rest stays dark ice
        float gm    = e_gnoise(v_sp * 3.4 + vec3(7.0, 3.0, 23.0));
        float gmask = 0.125 * smoothstep(0.50, 0.56, gm)
                    + 0.875 * smoothstep(0.70, 0.78, gm);
        // FAINT: thin ice glowing from beneath — only the deepest
        // hollows, and only a glimmer, against a truly dark night
        float sink = smoothstep(0.55, 0.95, clamp((0.5 - v_h) * 2.0, 0.0, 1.0));
        vec3  iceglow = vec3(0.20, 0.45, 0.85) * sink * night * gmask;
        col += iceglow * 0.18 * ubo.gain;
        // fresnel ice light: the terrain limb keeps a soft lift
        float fr = pow(1.0 - mu, 4.0);
        col += vec3(0.70, 0.82, 1.00) * fr * (0.12 + 0.35 * lit) * ubo.gain;
        // the outermost fragments — normals turned toward space —
        // darken away, handing the silhouette to the horizon light
        col *= 0.30 + 0.70 * smoothstep(0.0, 0.12, mu);
        // the vents glow onto the ice around them, night side included
        float gl9 = 0.0;
        for (int i = 0; i < 48; i++) {{
            float cl = cos(LAT[i]);
            vec3  p0 = vec3(cl * sin(AZ[i]), sin(LAT[i]), cl * cos(AZ[i]));
            // same seeding as the plume: quiet vents cast no glow
            float pv = e_gnoise(p0 * 2.2 + vec3(5.0, 11.0, 3.0));
            float vw = 1.0 - smoothstep(0.30, 0.70, pv);
            vec3  dv = v_world_pos.xyz - p0;
            gl9 += exp(-dot(dv, dv) / 0.0064) * (0.15 + 0.85 * vw * vw);
        }}
        col += vec3(0.55, 0.70, 0.95) * gl9 * 0.55;
        // opaque to the edge: the marched horizon owns the softness —
        // an alpha fade here reads as a dark ring against space
        fragColor = vec4(col, 1.0);
    }

element Enceladus
    frost : true
    frost_sharp : true
    intern e_cur  : f32
    intern p_cur  : f32
    intern p_set  : bool
    intern enc    : EnceladusShader
    intern sky    : GaiaShader
    intern plume  : PlumeShader
    intern saturn : SaturnShader
    intern rings  : RingShader
    intern models : array Model
    intern target : Render
    intern built  : bool
    # async load: worker decodes, draw waits on ready for vk work
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    public color  : rgba [ r:0.002, g:0.003, b:0.006, a:1.0 ]

    func build_models[]
        built     = true
        gltf_path : path '../scenes/models/earth.gltf'
        gltf      : GltfModel.open[ gltf_path ]
        enc       = EnceladusShader [ vk: vk ]
        e_samplers : map Image [string] [
            'height': Image [ uri: path '../scenes/textures/enceladus-detail.png', surface: TitanSurface.height,
                wrap_u: true, wrap_v: true ],
            # a second, unrelated map so the surface is not one grain
            'height2': Image [ uri: path '../scenes/textures/moon-displace-2048x1024.png', surface: TitanSurface.height2,
                wrap_u: true, wrap_v: true ],
            'nrm_a': Image [ uri: path '../scenes/textures/enceladus-na.png', surface: TitanSurface.nrm_a,
                wrap_u: true, wrap_v: true ],
            'nrm_b': Image [ uri: path '../scenes/textures/enceladus-nb.png', surface: TitanSurface.nrm_b,
                wrap_u: true, wrap_v: true ]
        ]
        enc_model : Model [ vk: vk, w: ux, id: gltf, s: enc, samplers: e_samplers, straight_alpha: true ]
        plume     = PlumeShader [ vk: vk ]
        p_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/enceladus-color.png', surface: TitanSurface.color ]
        ]
        plume_model : Model [ vk: vk, w: ux, id: gltf, s: plume, samplers: p_samplers,
            straight_alpha: true, cull_none: true, depth_no_test: true ]
        saturn    = SaturnShader [ vk: vk ]
        s_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/saturn-color.png', surface: TitanSurface.color,
                wrap_u: true ],
            'height': Image [ uri: path '../scenes/textures/saturn-ring-alpha.png', surface: TitanSurface.height ]
        ]
        saturn_model : Model [ vk: vk, w: ux, id: gltf, s: saturn, samplers: s_samplers, straight_alpha: true ]
        rings     = RingShader [ vk: vk ]
        r_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/saturn-ring-alpha.png', surface: TitanSurface.color ]
        ]
        ring_model : Model [ vk: vk, w: ux, id: gltf, s: rings, samplers: r_samplers,
            straight_alpha: true ]
        sky       = GaiaShader [ vk: vk ]
        sky_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/gaia.png', surface: GaiaSurface.color ]
        ]
        sky_model : Model [ vk: vk, w: ux, id: gltf, s: sky, samplers: sky_samplers,
            straight_alpha: true, cull_none: true ]
        models = array Model [ sky_model, saturn_model, ring_model, enc_model, plume_model ]

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        ux.element_targets[ id ] = target

    # unregister only; we keep our ref so the GPU graph outlives the frame
    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    # ice light: pale cold panes, glacier blue accents
    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#000a',   # editor pane background
            '#140a2a80':  '#0e141a80',   # console pane background
            '#ff6a2e55':  '#7ac8e855',   # search highlight fill
            '#220022aa':  '#0c1216aa',   # run console base fill
            '#614':       '#28343e',     # TButtons / nav rest fill
            '#413':       '#1e2830',     # TButtons hover fill
            '#826':       '#3e5060',     # TButtons lit / nav selected
            '#625a':      '#268a',       # bottom status bar fill
            '#8af2':      '#8cf2',       # status bar inner glow
            '#425':       '#16a8',     # editor selection color
            '#44225588':  '#16a4'    # editor line highlight
        ]

    func load_bg [ arg: object ]
        t0 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg start at {t0}'
        build_models[]
        t1 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg done in {t1 - t0}ms at {t1}'
        ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : array []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: @load_bg, work: w9 ]
        if [ !ready ] return
        create_target[]
        orbit[]

    func orbit[]
        # surface flyover like Earth's close shot: the ice fills the
        # frame at low orbit and saturn hangs above the limb.
        # negative rate: the gaze leads the motion — flying FORWARD
        time : 0.0 - ux.time * 1460.0
        if [ time == 0.0 ] time = -54.0
        a_t      : f32 [ (ux.orbit_mode == OrbitView.low)  ? 0.25 :
                         (ux.orbit_mode == OrbitView.high) ? 0.70 : 2.60 ]
        if [ e_cur == 0.0 ] e_cur = a_t
        e_cur = filter_n[ e_cur, a_t, 0.08, ux.frame_factor ]
        altitude : f32 [ e_cur ]
        eye_dist : f32 [ 1.0 + altitude ]
        t_deg    : f32 [ (ux.angle_mode == ViewAngle.flat)   ? 0.0 :
                         (ux.angle_mode == ViewAngle.angled) ? 60.0 : 76.0 ]
        if [ p_cur == 0.0 && !p_set ] p_cur = t_deg
        p_set    = true
        p_cur    = filter_n[ p_cur, t_deg, 0.08, ux.frame_factor ]
        ux.orbit_moving = abs[ e_cur - a_t ] > 0.0004 || abs[ p_cur - t_deg ] > 0.05
        tilt     : f32 [ radians[ p_cur ] ]
        aspect   : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]
        orbit_a : radians[ time ]
        co      : cos[ orbit_a ]
        so      : sin[ orbit_a ]
        ex_l  : f32 [ 0.0 ]
        ey_l  : f32 [ 0.0 ]
        ez_l  : f32 [ eye_dist ]
        fx_l  : f32 [ -sin[ tilt ] ]
        fy_l  : f32 [ 0.0 ]
        fz_l  : f32 [ -cos[ tilt ] ]
        tx_l  : f32 [ ex_l + fx_l * 2.0 ]
        ty_l  : f32 [ ey_l + fy_l * 2.0 ]
        tz_l  : f32 [ ez_l + fz_l * 2.0 ]
        _eye   : vec3f [  co * ex_l + so * ez_l, ey_l, -so * ex_l + co * ez_l ]
        _tgt   : vec3f [  co * tx_l + so * tz_l, ty_l, -so * tx_l + co * tz_l ]
        _up    : vec3f [  co, 0.0, 0.0 - so ]

        _proj  : mat4f.perspective[ radians[ 60.0 ], aspect, 0.001, 60.0 ]
        _view  : mat4f.look_at    [ _eye, _tgt, _up ]

        enc.model   = mat4f.identity[]
        enc.view    = _view
        enc.proj    = _proj
        enc.gain    = 1.5
        enc.displace = 0.010
        enc.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]

        # the galaxy wraps the whole scene from a big inner sphere,
        # tilted so the band cuts the sky diagonally
        skq9 : vec4f [ 1.0, 0.0, 0.0, radians[ 45.0 ] ]
        skq  : quatf [ skq9 ]
        skm : mat4f.identity[]
        skm = skm.rotate[ skq ]
        skm = skm.scale [ vec3f [ 30.0, 30.0, 30.0 ] ]
        sky.model = skm
        sky.view  = _view
        sky.proj  = _proj
        sky.gain  = 0.45
        sky.time  = ux.time * 60000.0

        # the proxy: a shell just past jet reach — from inside its far
        # side covers the WHOLE sky (no rim to cut a beam at any gaze),
        # from outside its near side covers the planet region
        hm : mat4f.identity[]
        hm = hm.scale [ vec3f [ 1.30, 1.30, 1.30 ] ]
        plume.model   = hm
        plume.view    = _view
        plume.proj    = _proj
        plume.gain    = 1.0
        plume.time    = ux.time * 60000.0
        plume.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]

        # saturn fixed in the sky above the limb, darker, near edge-on.
        # the offset must ride the SAME orbit rotation as the eye or
        # the camera walks away from it and it slides off-frame
        rise   : f32 [ radians[ 14.0 ] ]
        aim    : f32 [ tilt + rise ]
        s_dist : f32 [ 24.0 ]
        sx9    : f32 [ 0.0 - s_dist * sin[ aim ] ]
        sz9    : f32 [ eye_dist - s_dist * cos[ aim ] ]
        s_off  : vec3f [ co * sx9 + so * sz9, 0.0, (0.0 - so) * sx9 + co * sz9 ]
        s_sc   : vec3f [ 8.5, 8.5, 8.5 ]
        s_axis : vec4f [ 0.0, 0.0, 1.0, radians[ -22.0 ] ]
        sq     : quatf [ s_axis ]
        s_tip  : vec4f [ 1.0, 0.0, 0.0, radians[ 8.0 ] ]
        sq3    : quatf [ s_tip ]
        s_spin : vec4f [ 0.0, 1.0, 0.0, radians[ ux.time * 9000.0 ] ]
        sq2    : quatf [ s_spin ]
        sm : mat4f.identity[]
        sm = sm.translate[ s_off ]
        sm = sm.rotate   [ sq3 ]
        sm = sm.rotate   [ sq ]
        sm = sm.rotate   [ sq2 ]
        sm = sm.scale    [ s_sc ]
        saturn.model    = sm
        saturn.view     = _view
        saturn.proj     = _proj
        saturn.gain     = 0.75
        saturn.cam_pos  = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        saturn.time     = ux.time * 60000.0

        r_sc : vec3f [ 19.8, 0.02, 19.8 ]
        rm : mat4f.identity[]
        rm = rm.translate[ s_off ]
        rm = rm.rotate   [ sq3 ]
        rm = rm.rotate   [ sq ]
        rm = rm.scale    [ r_sc ]
        rings.model   = rm
        rings.view    = _view
        rings.proj    = _proj
        rings.gain    = 0.8
        rings.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]

# europa bake: cpu gradient perlin, quintic fade, mod-289 lattice
func eu_perm [ x: f32 ] -> f32
    p : f32 [ (x * 34.0 + 1.0) * x ]
    return p - floor[ p / 289.0 ] * 289.0

# gradient dot for one lattice corner, glsl e_gnoise rules
func eu_grad [ h9: f32, x: f32, y: f32, z: f32 ] -> f32
    h7 : f32 [ floor[ h9 / 7.0 ] ]
    gx : f32 [ (h9 / 7.0 - h7) * 2.0 - 1.0 ]
    gy : f32 [ (h7 / 7.0 - floor[ h7 / 7.0 ]) * 2.0 - 1.0 ]
    gz : f32 [ 1.0 - abs[ gx ] - abs[ gy ] ]
    if [ gz < 0.0 ]
        if [ gx >= 0.0 ]
            gx = gx - 0.5
        el
            gx = gx + 0.5
        if [ gy >= 0.0 ]
            gy = gy - 0.5
        el
            gy = gy + 0.5
    r9 : f32 [ gx * gx + gy * gy + gz * gz ]
    nm : f32 [ 1.79284291400159 - 0.85373472095314 * r9 ]
    return (gx * x + gy * y + gz * z) * nm

func eu_fade [ t: f32 ] -> f32
    return t * t * t * (t * (t * 6.0 - 15.0) + 10.0)

func eu_gnoise [ px: f32, py: f32, pz: f32 ] -> f32
    ix : f32 [ floor[ px ] ]
    iy : f32 [ floor[ py ] ]
    iz : f32 [ floor[ pz ] ]
    fx : f32 [ px - ix ]
    fy : f32 [ py - iy ]
    fz : f32 [ pz - iz ]
    ix = ix - floor[ ix / 289.0 ] * 289.0
    iy = iy - floor[ iy / 289.0 ] * 289.0
    iz = iz - floor[ iz / 289.0 ] * 289.0
    hx0  : f32 [ eu_perm[ ix ] ]
    hx1  : f32 [ eu_perm[ ix + 1.0 ] ]
    h00  : f32 [ eu_perm[ hx0 + iy ] ]
    h10  : f32 [ eu_perm[ hx1 + iy ] ]
    h01  : f32 [ eu_perm[ hx0 + iy + 1.0 ] ]
    h11  : f32 [ eu_perm[ hx1 + iy + 1.0 ] ]
    n000 : f32 [ eu_grad[ eu_perm[ h00 + iz ],       fx,       fy,       fz ] ]
    n100 : f32 [ eu_grad[ eu_perm[ h10 + iz ],       fx - 1.0, fy,       fz ] ]
    n010 : f32 [ eu_grad[ eu_perm[ h01 + iz ],       fx,       fy - 1.0, fz ] ]
    n110 : f32 [ eu_grad[ eu_perm[ h11 + iz ],       fx - 1.0, fy - 1.0, fz ] ]
    n001 : f32 [ eu_grad[ eu_perm[ h00 + iz + 1.0 ], fx,       fy,       fz - 1.0 ] ]
    n101 : f32 [ eu_grad[ eu_perm[ h10 + iz + 1.0 ], fx - 1.0, fy,       fz - 1.0 ] ]
    n011 : f32 [ eu_grad[ eu_perm[ h01 + iz + 1.0 ], fx,       fy - 1.0, fz - 1.0 ] ]
    n111 : f32 [ eu_grad[ eu_perm[ h11 + iz + 1.0 ], fx - 1.0, fy - 1.0, fz - 1.0 ] ]
    ux9 : f32 [ eu_fade[ fx ] ]
    uy9 : f32 [ eu_fade[ fy ] ]
    uz9 : f32 [ eu_fade[ fz ] ]
    nx00 : f32 [ n000 + (n100 - n000) * ux9 ]
    nx10 : f32 [ n010 + (n110 - n010) * ux9 ]
    nx01 : f32 [ n001 + (n101 - n001) * ux9 ]
    nx11 : f32 [ n011 + (n111 - n011) * ux9 ]
    ny0  : f32 [ nx00 + (nx10 - nx00) * uy9 ]
    ny1  : f32 [ nx01 + (nx11 - nx01) * uy9 ]
    return (ny0 + (ny1 - ny0) * uz9) * 0.5 + 0.5

func eu_hash2 [ x: f32, y: f32, s9: f32 ] -> f32
    v : f32 [ sin[ x * 12.9898 + y * 78.233 + s9 * 37.719 ] * 43758.5453 ]
    return v - floor[ v ]

# fold a tile coordinate into mirrored repeat: edges continue
# into their own reflection, so no source seam can print
func eu_mirr [ t: f32 ] -> f32
    m : f32 [ t * 0.5 - floor[ t * 0.5 ] ]
    m = m * 2.0
    if [ m > 1.0 ] m = 2.0 - m
    return m

# bilinear over a luminance field, mirrored on both axes
func eu_bilin [ S: @f32, w: i32, h: i32, u: f32, v: f32 ] -> f32
    x : f32 [ eu_mirr[ u ] * f32[ w - 1 ] ]
    y : f32 [ eu_mirr[ v ] * f32[ h - 1 ] ]
    x0 : i32 [ i32[ x ] ]
    y0 : i32 [ i32[ y ] ]
    tx : f32 [ x - f32[ x0 ] ]
    ty : f32 [ y - f32[ y0 ] ]
    if [ x0 >= w - 1 ] x0 = w - 2
    if [ y0 >= h - 1 ] y0 = h - 2
    x1 : i32 [ x0 + 1 ]
    y1 : i32 [ y0 + 1 ]
    a9 : f32 [ S[ y0 * w + x0 ] ]
    b9 : f32 [ S[ y0 * w + x1 ] ]
    c9 : f32 [ S[ y1 * w + x0 ] ]
    d9 : f32 [ S[ y1 * w + x1 ] ]
    return (a9 * (1.0 - tx) + b9 * tx) * (1.0 - ty) + (c9 * (1.0 - tx) + d9 * tx) * ty

# mirror-blended rotated sample of one source across the u seam;
# sx != sy stretches the pattern into elongated grain
func eu_pat [ S: @f32, sw: i32, sh: i32, u: f32, v: f32, ub9: f32,
              sk9: f32, ang: f32, sx: f32, sy: f32, ox: f32, oy: f32 ] -> f32
    rc : f32 [ cos[ ang ] ]
    rs : f32 [ sin[ ang ] ]
    ax : f32 [ (u   * rc - v * rs) * sx + ox ]
    ay : f32 [ (u   * rs + v * rc) * sy + oy ]
    bx : f32 [ (ub9 * rc - v * rs) * sx + ox ]
    by : f32 [ (ub9 * rs + v * rc) * sy + oy ]
    sa : f32 [ eu_bilin[ S, sw, sh, ax, ay ] ]
    sb : f32 [ eu_bilin[ S, sw, sh, bx, by ] ]
    return sb + (sa - sb) * sk9

func eu_sstep [ e0: f32, e1: f32, x: f32 ] -> f32
    t : f32 [ (x - e0) / (e1 - e0) ]
    if [ t < 0.0 ] t = 0.0
    if [ t > 1.0 ] t = 1.0
    return t * t * (3.0 - 2.0 * t)

# luminance field from an Image, any channel count
func eu_lum [ im: Image, L: @f32 ]
    d : @u8 [ im.vdata[] ]
    ps : i32 [ im.pixel_size ]
    n : i32 [ im.width * im.height ]
    if [ ps >= 3 ]
        for [ i: i32 0, i < n, i += 1 ]
            b2 : i32 [ i * ps ]
            L[ i ] = (f32[ d[ b2 ] ] * 0.299 + f32[ d[ b2 + 1 ] ] * 0.587 + f32[ d[ b2 + 2 ] ] * 0.114) / 255.0
    el
        for [ i: i32 0, i < n, i += 1 ]
            L[ i ] = f32[ d[ i * ps ] ] / 255.0

# 3x3 box blur passes, wrap x clamp y
func eu_blur [ H: @f32, T: @f32, w: i32, h: i32, passes: i32 ]
    for [ p9: i32 0, p9 < passes, p9 += 1 ]
        for [ y: i32 0, y < h, y += 1 ]
            ym : i32 [ (y > 0) ? y - 1 : 0 ]
            yp : i32 [ (y < h - 1) ? y + 1 : h - 1 ]
            for [ x: i32 0, x < w, x += 1 ]
                xm : i32 [ (x > 0) ? x - 1 : w - 1 ]
                xp : i32 [ (x < w - 1) ? x + 1 : 0 ]
                T[ y * w + x ] = (H[ ym * w + xm ] + H[ ym * w + x ] + H[ ym * w + xp ]
                                + H[ y  * w + xm ] + H[ y  * w + x ] + H[ y  * w + xp ]
                                + H[ yp * w + xm ] + H[ yp * w + x ] + H[ yp * w + xp ]) / 9.0
        for [ i: i32 0, i < w * h, i += 1 ]
            H[ i ] = T[ i ]

# 8-dir horizon walk on the equirect height, wrap x clamp y
func eu_bake_ao [ H: @f32, AO: @f32, w: i32, h: i32, hscale: f32 ]
    dxs : new f32 [ 8 ]
    dys : new f32 [ 8 ]
    for [ d: i32 0, d < 8, d += 1 ]
        aa : f32 [ f32[ d ] * 0.7853982 ]
        dxs[ d ] = cos[ aa ]
        dys[ d ] = sin[ aa ]
    for [ y: i32 0, y < h, y += 1 ]
        fy3 : f32 [ f32[ y ] ]
        for [ x: i32 0, x < w, x += 1 ]
            h0 : f32 [ H[ y * w + x ] ]
            fx3 : f32 [ f32[ x ] ]
            occ : f32 [ 0.0 ]
            for [ d: i32 0, d < 8, d += 1 ]
                m : f32 [ 0.0 ]
                jt : f32 [ eu_hash2[ fx3, fy3, f32[ d ] ] * 4.0 ]
                for [ s: i32 1, s <= 12, s += 1 ]
                    dist : f32 [ f32[ s * 4 ] + jt ]
                    px : i32 [ x + i32[ dxs[ d ] * dist ] ]
                    py : i32 [ y + i32[ dys[ d ] * dist ] ]
                    px = px % w
                    if [ px < 0 ] px += w
                    if [ py < 0 ] py = 0
                    if [ py >= h ] py = h - 1
                    sl : f32 [ (H[ py * w + px ] - h0) * hscale / dist ]
                    if [ sl > m ] m = sl
                occ += m / (1.0 + m)
            v2 : f32 [ 1.0 - occ * 0.17 ]
            if [ v2 < 0.0 ] v2 = 0.0
            AO[ y * w + x ] = v2

# jupiter overhead: saturn's ball minus the rings, winds kept
ModelViewProject JupiterShader
    mutable gain    : f32
    mutable cam_pos : vec4f

    attrib color : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.color, count:1, format: typeid[ rgba8 ] ]
    # baked sobel contrast of the color map: where storms live
    attrib height : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.height, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_normal    : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_uv        : VertexOutput [ type:typeid[ vec2f ] ]
    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]

    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]

    func jp_perm4 [ x: vec4f ] -> GLSL vec4f {
        return mod((x * 34.0 + 1.0) * x, vec4(289.0));
    }

    func jp_isqrt4 [ r: vec4f ] -> GLSL vec4f {
        return 1.79284291400159 - 0.85373472095314 * r;
    }

    func jp_gnoise [ P: vec3f ] -> GLSL float {
        vec3 Pi0 = mod(floor(P), vec3(289.0));
        vec3 Pi1 = mod(Pi0 + vec3(1.0), vec3(289.0));
        vec3 Pf0 = fract(P);
        vec3 Pf1 = Pf0 - vec3(1.0);
        vec4 ix  = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
        vec4 iy  = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
        vec4 iz0 = vec4(Pi0.z);
        vec4 iz1 = vec4(Pi1.z);
        vec4 ixy  = jp_perm4(jp_perm4(ix) + iy);
        vec4 ixy0 = jp_perm4(ixy + iz0);
        vec4 ixy1 = jp_perm4(ixy + iz1);
        vec4 gx0 = fract(ixy0 / 7.0) * 2.0 - 1.0;
        vec4 gy0 = fract(floor(ixy0 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz0 = 1.0 - abs(gx0) - abs(gy0);
        vec4 gx1 = fract(ixy1 / 7.0) * 2.0 - 1.0;
        vec4 gy1 = fract(floor(ixy1 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz1 = 1.0 - abs(gx1) - abs(gy1);
        vec4 sz0 = step(gz0, vec4(0.0));
        gx0 -= sz0 * (step(0.0, gx0) - 0.5);
        gy0 -= sz0 * (step(0.0, gy0) - 0.5);
        vec4 sz1 = step(gz1, vec4(0.0));
        gx1 -= sz1 * (step(0.0, gx1) - 0.5);
        gy1 -= sz1 * (step(0.0, gy1) - 0.5);
        vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
        vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
        vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
        vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
        vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
        vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
        vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
        vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);
        vec4 nm0 = jp_isqrt4(vec4(dot(g000,g000), dot(g010,g010), dot(g100,g100), dot(g110,g110)));
        g000 *= nm0.x; g010 *= nm0.y; g100 *= nm0.z; g110 *= nm0.w;
        vec4 nm1 = jp_isqrt4(vec4(dot(g001,g001), dot(g011,g011), dot(g101,g101), dot(g111,g111)));
        g001 *= nm1.x; g011 *= nm1.y; g101 *= nm1.z; g111 *= nm1.w;
        float n000 = dot(g000, Pf0);
        float n100 = dot(g100, vec3(Pf1.x, Pf0.y, Pf0.z));
        float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
        float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
        float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
        float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
        float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
        float n111 = dot(g111, Pf1);
        vec3  fxyz = Pf0 * Pf0 * Pf0 * (Pf0 * (Pf0 * 6.0 - 15.0) + 10.0);
        vec4  n_z  = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fxyz.z);
        vec2  n_yz = mix(n_z.xy, n_z.zw, fxyz.y);
        return mix(n_yz.x, n_yz.y, fxyz.x) * 0.5 + 0.5;
    }

    func init[]
        eye2    : vec3f [0.0f, 0.0f, 2.5f]
        target2 : vec3f [0.0f, 0.0f, 0.0f]
        up2     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_uv        = vec2(1.0 - a_uv.x, a_uv.y);
        mat3 nm     = transpose(inverse(mat3(ubo.model)));
        v_normal    = normalize(nm * a_normal);
        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        vec3  n        = normalize(v_normal);
        vec3  sun      = normalize(vec3(0.85, -0.10, 0.15));
        vec3  view_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        // zonal winds: a hot equatorial jet plus thin alternating
        // lobes — jupiter runs more bands than saturn
        float la = v_uv.y - 0.5;
        float w  = 0.55 * exp(-la * la / 0.010)
                 + 0.25 * cos(la * 56.55) * exp(-abs(la) * 1.6);
        // flow ping-pong: two half-cycle phases crossfaded, so shear
        // stays bounded and the bands slide forever without smearing
        float t9 = ubo.time * 0.0125;
        float p0 = fract(t9);
        float p1 = fract(t9 + 0.5);
        float s0 = w * (p0 - 0.5) * 0.16;
        float s1 = w * (p1 - 0.5) * 0.16;
        float bl = abs(2.0 * p0 - 1.0);
        vec3  alb = mix(texture(color, vec2(v_uv.x + s0, v_uv.y)).rgb,
                        texture(color, vec2(v_uv.x + s1, v_uv.y)).rgb, bl);
        float wr9      = clamp(dot(n, sun) * 0.5 + 0.5, 0.0, 1.0);
        float ndl      = wr9 * wr9;
        float mu       = clamp(dot(n, view_dir), 0.0, 1.0);
        vec3  col      = alb * (0.08 + 0.92 * ndl) * ubo.gain;
        // thunderstorm plasma: rare drifting perlin peaks fade in
        // and out, gated to the baked sobel contrast of the bands
        float sob   = texture(height, v_uv).r;
        float st9   = jp_gnoise(vec3(v_uv * 22.0, ubo.time * 0.030));
        float flash = smoothstep(0.82, 0.94, st9);
        float st2   = jp_gnoise(vec3(v_uv * 47.0 + 7.0, ubo.time * 0.055));
        flash *= 0.55 + 0.45 * st2;
        col += vec3(0.72, 0.80, 1.00) * flash * smoothstep(0.25, 0.75, sob) * 2.2;
        float a        = smoothstep(0.0, 0.18, mu);
        fragColor      = vec4(col, a);
    }

# the patched ice: displaced by the baked equirect height, lit by
# the baked AO and normals, rust rising in the cavities
ModelViewProject EuropaShader
    mutable gain     : f32
    mutable cam_pos  : vec4f
    # real geometry displacement, in sphere radii
    mutable displace : f32

    # baked at scene build: R height hi, A height lo, G AO, B cavity
    attrib height : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.height, count:1, format: typeid[ rgba8 ] ]
    # baked normals: RG = normal xy, B = cavity
    attrib nrmA   : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.nrm_a,  count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_normal    : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_uv        : VertexOutput [ type:typeid[ vec2f ] ]
    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]
    attrib v_sp        : VertexOutput [ type:typeid[ vec3f ] ]
    attrib v_h         : VertexOutput [ type:typeid[ f32 ] ]

    attrib fragColor : FragmentOutput[ type:typeid[ vec4f ] ]

    func eg_perm4 [ x: vec4f ] -> GLSL vec4f {
        return mod((x * 34.0 + 1.0) * x, vec4(289.0));
    }

    func eg_isqrt4 [ r: vec4f ] -> GLSL vec4f {
        return 1.79284291400159 - 0.85373472095314 * r;
    }

    func eg_gnoise [ P: vec3f ] -> GLSL float {
        vec3 Pi0 = mod(floor(P), vec3(289.0));
        vec3 Pi1 = mod(Pi0 + vec3(1.0), vec3(289.0));
        vec3 Pf0 = fract(P);
        vec3 Pf1 = Pf0 - vec3(1.0);
        vec4 ix  = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
        vec4 iy  = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
        vec4 iz0 = vec4(Pi0.z);
        vec4 iz1 = vec4(Pi1.z);
        vec4 ixy  = eg_perm4(eg_perm4(ix) + iy);
        vec4 ixy0 = eg_perm4(ixy + iz0);
        vec4 ixy1 = eg_perm4(ixy + iz1);
        vec4 gx0 = fract(ixy0 / 7.0) * 2.0 - 1.0;
        vec4 gy0 = fract(floor(ixy0 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz0 = 1.0 - abs(gx0) - abs(gy0);
        vec4 gx1 = fract(ixy1 / 7.0) * 2.0 - 1.0;
        vec4 gy1 = fract(floor(ixy1 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz1 = 1.0 - abs(gx1) - abs(gy1);
        vec4 sz0 = step(gz0, vec4(0.0));
        gx0 -= sz0 * (step(0.0, gx0) - 0.5);
        gy0 -= sz0 * (step(0.0, gy0) - 0.5);
        vec4 sz1 = step(gz1, vec4(0.0));
        gx1 -= sz1 * (step(0.0, gx1) - 0.5);
        gy1 -= sz1 * (step(0.0, gy1) - 0.5);
        vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
        vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
        vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
        vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
        vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
        vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
        vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
        vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);
        vec4 nm0 = eg_isqrt4(vec4(dot(g000,g000), dot(g010,g010), dot(g100,g100), dot(g110,g110)));
        g000 *= nm0.x; g010 *= nm0.y; g100 *= nm0.z; g110 *= nm0.w;
        vec4 nm1 = eg_isqrt4(vec4(dot(g001,g001), dot(g011,g011), dot(g101,g101), dot(g111,g111)));
        g001 *= nm1.x; g011 *= nm1.y; g101 *= nm1.z; g111 *= nm1.w;
        float n000 = dot(g000, Pf0);
        float n100 = dot(g100, vec3(Pf1.x, Pf0.y, Pf0.z));
        float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
        float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
        float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
        float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
        float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
        float n111 = dot(g111, Pf1);
        vec3  fxyz = Pf0 * Pf0 * Pf0 * (Pf0 * (Pf0 * 6.0 - 15.0) + 10.0);
        vec4  n_z  = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fxyz.z);
        vec2  n_yz = mix(n_z.xy, n_z.zw, fxyz.y);
        return mix(n_yz.x, n_yz.y, fxyz.x) * 0.5 + 0.5;
    }

    func init[]
        eye2    : vec3f [0.0f, 0.0f, 2.5f]
        target2 : vec3f [0.0f, 0.0f, 0.0f]
        up2     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        v_uv        = vec2(1.0 - a_uv.x, a_uv.y);
        v_sp        = normalize(a_pos);
        mat3 nm     = transpose(inverse(mat3(ubo.model)));
        v_normal    = normalize(nm * a_normal);
        // two-byte height: one byte terraces at the terminator
        vec4  hp    = textureLod(height, v_uv, 0.0);
        float hv    = (hp.r * 65280.0 + hp.a * 255.0) / 65535.0;
        v_h         = hv;
        vec3  disp  = a_pos + a_normal * (hv - 0.5) * ubo.displace;
        vec4  wpos  = ubo.model * vec4(disp, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        vec3  n        = normalize(v_normal);
        vec3  sun      = normalize(vec3(0.85, -0.10, 0.15));
        vec3  view_dir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        float dist9    = length(ubo.cam_pos.xyz - v_world_pos.xyz);
        vec4  hp  = texture(height, v_uv);
        vec4  np  = texture(nrmA, v_uv);
        float ao9 = hp.g;
        vec2  nxy = np.rg * 2.0 - 1.0;
        float cav = hp.b;
        float met = np.b;
        // the smooth-sphere daylight gates the detail tilt: the dark
        // side must not catch extreme grazing light off micro normals
        float wrs = clamp(dot(n, sun) * 0.5 + 0.5, 0.0, 1.0);
        float dfade = 1.0 - smoothstep(0.9, 2.6, dist9);
        float ntilt = dfade * (0.25 + 0.75 * wrs);
        if (ntilt > 0.0) {{
            vec3 t_e = normalize(cross(vec3(0.0, 1.0, 0.0), n));
            vec3 t_n = cross(n, t_e);
            n = normalize(n + (t_e * nxy.x + t_n * nxy.y) * 1.2 * ntilt);
        }}
        // cav carries the deep-carve mask: snow at surface level,
        // europa's light tan orange on the lineae floors, darker
        // bits in the deepest cores; ao stays a whisper
        float deep = cav;
        float ao = mix(0.96, 1.0, ao9) * (1.0 - deep * 0.10 * dfade);
        // depressions sit slightly darker; plains rest at 0.62
        float low = clamp((0.62 - v_h) / 0.35, 0.0, 1.0);
        ao *= 1.0 - low * 0.10;
        float dm  = smoothstep(0.12, 0.70, deep);
        float dm2 = smoothstep(0.55, 0.95, deep);
        // perlin variance breathes over the tan floors, two octaves
        float tn1 = eg_gnoise(v_sp * 14.0 + vec3(5.0, 2.0, 9.0));
        float tn2 = eg_gnoise(v_sp * 41.0 + vec3(1.0, 8.0, 3.0));
        vec3  tan9 = vec3(0.80, 0.64, 0.44) * (0.74 + 0.36 * tn1 + 0.16 * (tn2 - 0.5));
        vec3  alb = mix(vec3(0.94, 0.96, 0.99), tan9, dm);
        alb = mix(alb, vec3(0.48, 0.36, 0.25), dm2 * 0.6);
        // ~15% of the snow fields carry a darkening overlay that
        // settles into their minor depressions
        float sgate = smoothstep(0.58, 0.66, eg_gnoise(v_sp * 5.5 + vec3(9.0, 4.0, 21.0)));
        float lm    = smoothstep(0.02, 0.22, low) * (1.0 - dm);
        alb *= 1.0 - sgate * lm * 0.22;
        // and everywhere outside the orange, minor dips gray a bit
        alb = mix(alb, vec3(0.72, 0.74, 0.77), lm * 0.30);
        // metal4 dresses the highlands: cool steel grain, reflective
        alb = mix(alb, vec3(0.68, 0.72, 0.78) * (0.50 + 0.70 * met),
                  clamp(met * 1.6, 0.0, 0.75));
        // wrapped light, same response curve as saturn and enceladus
        float wr    = clamp(dot(n, sun) * 0.5 + 0.5, 0.0, 1.0);
        float lit   = wr * wr;
        float mu    = clamp(dot(normalize(v_normal), view_dir), 0.0, 1.0);
        float night = 1.0 - smoothstep(0.10, 0.50, wrs);
        // floor: the dark side dims, it never goes void
        float amb   = mix(0.26, 0.08, night);
        vec3  col   = alb * ao * (amb + 0.74 * lit) * ubo.gain;
        // fresnel ice light: the terrain limb keeps a soft lift
        float fr = pow(1.0 - mu, 4.0);
        col += vec3(0.70, 0.82, 1.00) * fr * (0.12 + 0.35 * lit) * ubo.gain;
        // outermost fragments darken away toward the silhouette
        col *= 0.30 + 0.70 * smoothstep(0.0, 0.12, mu);
        // the atmospheric haze continues into the crack interiors at
        // quarter strength — its EXACT overlay color, unrelit; the
        // mask is the fine etch and the blur bowl mixed
        float inner = clamp((deep + low) * 0.5, 0.0, 1.0);
        col = mix(col, vec3(0.36, 0.16, 0.70), inner * 0.25);
        // the metal highlands catch the sun: broad specular sheen
        float mspec = pow(clamp(dot(reflect(-sun, n), view_dir), 0.0, 1.0), 24.0);
        col += vec3(0.85, 0.90, 1.00) * mspec * met * 0.45 * (0.25 + 0.75 * lit);
        // glowing water in the crack centers: emissive teal, and a
        // sun glint off the flat pool read from the smooth normal
        float wmask = smoothstep(0.78, 0.96, deep);
        if (wmask > 0.0) {{
            // pink pools running blue where the carve is deepest
            vec3  water = mix(vec3(0.70, 0.38, 0.66), vec3(0.25, 0.45, 0.95),
                              smoothstep(0.88, 0.99, deep));
            vec3  nsm   = normalize(v_normal);
            float spec  = pow(clamp(dot(reflect(-sun, nsm), view_dir), 0.0, 1.0), 48.0);
            col = mix(col, water * (0.35 + 0.65 * lit), wmask * 0.85);
            col += water * wmask * 0.25;
            col += vec3(0.90, 0.97, 1.00) * spec * wmask * (0.35 + 0.65 * lit);
        }}
        // the finest fracture filaments emit light of their own,
        // night side included — the baked detail2 mask
        float em = np.a;
        col += vec3(0.30, 0.62, 0.90) * em * 0.35;
        // soft shoulder: bright ice rolls off, it never clips white
        col = 1.0 - exp(-col * 1.25);
        // fuzzy limb: the land blends away at the horizon instead
        // of cutting an aliased hard edge against space
        float ha = smoothstep(0.0, 0.10, mu);
        fragColor = vec4(col, ha);
    }

# the marched horizon lens from enceladus — plus geysers risen from
# the LAKES: the shell ray samples the baked deep mask under each
# march point, so the columns stand exactly on the water
ModelViewProject EuropaGlowShader
    mutable gain    : f32
    mutable cam_pos : vec4f
    # jet emitters: xyz = unit surface position of a lake, w = strength
    mutable j0  : vec4f
    mutable j1  : vec4f
    mutable j2  : vec4f
    mutable j3  : vec4f
    mutable j4  : vec4f
    mutable j5  : vec4f
    mutable j6  : vec4f
    mutable j7  : vec4f
    mutable j8  : vec4f
    mutable j9  : vec4f
    mutable j10 : vec4f
    mutable j11 : vec4f
    mutable j12 : vec4f
    mutable j13 : vec4f
    mutable j14 : vec4f
    mutable j15 : vec4f
    mutable j16 : vec4f
    mutable j17 : vec4f
    mutable j18 : vec4f
    mutable j19 : vec4f
    mutable j20 : vec4f
    mutable j21 : vec4f
    mutable j22 : vec4f
    mutable j23 : vec4f
    mutable j24 : vec4f
    mutable j25 : vec4f
    mutable j26 : vec4f
    mutable j27 : vec4f
    mutable j28 : vec4f
    mutable j29 : vec4f
    mutable j30 : vec4f
    mutable j31 : vec4f

    # the packed surface bake: B is the deep-carve (lake) mask
    attrib height : LayoutBinding [ type:typeid[ TitanSurface ], id:TitanSurface.height, count:1, format: typeid[ rgba8 ] ]

    attrib a_pos    : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_normal : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv     : VertexInput [ type:typeid[ vec2f ] ]

    attrib v_world_pos : VertexOutput [ type:typeid[ vec4f ] ]
    attrib fragColor   : FragmentOutput[ type:typeid[ vec4f ] ]


    func gp_perm4 [ x: vec4f ] -> GLSL vec4f {
        return mod((x * 34.0 + 1.0) * x, vec4(289.0));
    }

    func gp_isqrt4 [ r: vec4f ] -> GLSL vec4f {
        return 1.79284291400159 - 0.85373472095314 * r;
    }

    func gp_gnoise [ P: vec3f ] -> GLSL float {
        vec3 Pi0 = mod(floor(P), vec3(289.0));
        vec3 Pi1 = mod(Pi0 + vec3(1.0), vec3(289.0));
        vec3 Pf0 = fract(P);
        vec3 Pf1 = Pf0 - vec3(1.0);
        vec4 ix  = vec4(Pi0.x, Pi1.x, Pi0.x, Pi1.x);
        vec4 iy  = vec4(Pi0.y, Pi0.y, Pi1.y, Pi1.y);
        vec4 iz0 = vec4(Pi0.z);
        vec4 iz1 = vec4(Pi1.z);
        vec4 ixy  = gp_perm4(gp_perm4(ix) + iy);
        vec4 ixy0 = gp_perm4(ixy + iz0);
        vec4 ixy1 = gp_perm4(ixy + iz1);
        vec4 gx0 = fract(ixy0 / 7.0) * 2.0 - 1.0;
        vec4 gy0 = fract(floor(ixy0 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz0 = 1.0 - abs(gx0) - abs(gy0);
        vec4 gx1 = fract(ixy1 / 7.0) * 2.0 - 1.0;
        vec4 gy1 = fract(floor(ixy1 / 7.0) / 7.0) * 2.0 - 1.0;
        vec4 gz1 = 1.0 - abs(gx1) - abs(gy1);
        vec4 sz0 = step(gz0, vec4(0.0));
        gx0 -= sz0 * (step(0.0, gx0) - 0.5);
        gy0 -= sz0 * (step(0.0, gy0) - 0.5);
        vec4 sz1 = step(gz1, vec4(0.0));
        gx1 -= sz1 * (step(0.0, gx1) - 0.5);
        gy1 -= sz1 * (step(0.0, gy1) - 0.5);
        vec3 g000 = vec3(gx0.x, gy0.x, gz0.x);
        vec3 g100 = vec3(gx0.y, gy0.y, gz0.y);
        vec3 g010 = vec3(gx0.z, gy0.z, gz0.z);
        vec3 g110 = vec3(gx0.w, gy0.w, gz0.w);
        vec3 g001 = vec3(gx1.x, gy1.x, gz1.x);
        vec3 g101 = vec3(gx1.y, gy1.y, gz1.y);
        vec3 g011 = vec3(gx1.z, gy1.z, gz1.z);
        vec3 g111 = vec3(gx1.w, gy1.w, gz1.w);
        vec4 nm0 = gp_isqrt4(vec4(dot(g000,g000), dot(g010,g010), dot(g100,g100), dot(g110,g110)));
        g000 *= nm0.x; g010 *= nm0.y; g100 *= nm0.z; g110 *= nm0.w;
        vec4 nm1 = gp_isqrt4(vec4(dot(g001,g001), dot(g011,g011), dot(g101,g101), dot(g111,g111)));
        g001 *= nm1.x; g011 *= nm1.y; g101 *= nm1.z; g111 *= nm1.w;
        float n000 = dot(g000, Pf0);
        float n100 = dot(g100, vec3(Pf1.x, Pf0.y, Pf0.z));
        float n010 = dot(g010, vec3(Pf0.x, Pf1.y, Pf0.z));
        float n110 = dot(g110, vec3(Pf1.xy, Pf0.z));
        float n001 = dot(g001, vec3(Pf0.xy, Pf1.z));
        float n101 = dot(g101, vec3(Pf1.x, Pf0.y, Pf1.z));
        float n011 = dot(g011, vec3(Pf0.x, Pf1.yz));
        float n111 = dot(g111, Pf1);
        vec3  fxyz = Pf0 * Pf0 * Pf0 * (Pf0 * (Pf0 * 6.0 - 15.0) + 10.0);
        vec4  n_z  = mix(vec4(n000, n100, n010, n110), vec4(n001, n101, n011, n111), fxyz.z);
        vec2  n_yz = mix(n_z.xy, n_z.zw, fxyz.y);
        return mix(n_yz.x, n_yz.y, fxyz.x) * 0.5 + 0.5;
    }

    # one analytic tube: returns rgb*w in xyz and w in w — no noise
    func g_tube [ p0: vec3f, jw: f32, ro: vec3f, rd: vec3f, s_hit: f32 ] -> GLSL vec4f {
        vec3  w0 = ro - p0;
        float aa = dot(rd, p0);
        float d0 = dot(rd, w0);
        float d1 = dot(p0, w0);
        float dn = max(1.0 - aa * aa, 1e-4);
        float s9 = (aa * d1 - d0) / dn;
        float t9 = (d1 - aa * d0) / dn;
        if (s9 < 0.02) return vec4(0.0);
        float occ = 1.0 - smoothstep(s_hit - 0.10, s_hit + 0.10, s9);
        if (occ <= 0.0) return vec4(0.0);
        float tt  = max(t9, 0.0);
        float env = smoothstep(-0.015, 0.025, t9) * exp(-8.0 * tt);
        vec3  qp = w0 + s9 * rd - t9 * p0;
        float d2 = dot(qp, qp);
        float sg = 0.008 + 0.05 * tt;
        float gc = exp(-d2 / (sg * sg));
        float gh = 0.15 * exp(-d2 / (9.0 * sg * sg));
        float boost = 1.0 / sqrt(max(dn, 0.20));
        float w9 = env * boost * occ * jw * (gc + gh);
        float cm = clamp(tt / 0.45, 0.0, 1.0);
        // blue at the vent, rising into hot pink
        vec3  cc = mix(vec3(0.25, 0.45, 0.95), vec3(1.00, 0.24, 0.72), cm);
        return vec4(cc * w9, w9);
    }

    # each site is a FAN of three tubes, like the enceladus vents —
    # lone tubes were too sparse to ever hold the visible limb
    func g_jet [ J: vec4f, ro: vec3f, rd: vec3f, s_hit: f32 ] -> GLSL vec4f {
        if (J.w <= 0.0) return vec4(0.0);
        vec3 p0 = J.xyz;
        // perlin breathing: each vent emits between 20% and 70%
        float pm = gp_gnoise(vec3(p0.x * 5.0 + ubo.time * 0.008,
                                  p0.y * 5.0, p0.z * 5.0 + ubo.time * 0.005));
        float jw = J.w * (0.20 + 0.50 * pm);
        vec3 te = normalize(cross(vec3(0.0, 1.0, 0.0), p0));
        vec4 acc = g_tube(p0, jw, ro, rd, s_hit);
        acc += g_tube(normalize(p0 + te * 0.014), jw * 0.7, ro, rd, s_hit);
        acc += g_tube(normalize(p0 - te * 0.012), jw * 0.7, ro, rd, s_hit);
        return acc;
    }

    func init[]
        eye2    : vec3f [0.0f, 0.0f, 2.5f]
        target2 : vec3f [0.0f, 0.0f, 0.0f]
        up2     : vec3f [0.0f, -1.0f, 0.0f]
        model   = mat4f.identity   []
        proj    = mat4f.perspective[radians[60.0f], 1.0f, 0.01f, 100.0f]
        view    = mat4f.look_at    [eye2, target2, up2]

    func vertex[] -> GLSL none {
        vec4 wpos   = ubo.model * vec4(a_pos, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment[] -> GLSL none {
        vec3  ro  = ubo.cam_pos.xyz;
        vec3  rd  = normalize(v_world_pos.xyz - ro);
        // one shell layer only: inside we see its far side, outside
        // its near side — the guard stops the outside double-count
        if (dot(ro, ro) >= 1.69 && !gl_FrontFacing) { fragColor = vec4(0.0); return; }
        // geysers: pure analytic tubes standing on the lakes — the
        // emitter list arrives from the bake as uniforms
        float b9  = dot(ro, rd);
        float c9  = dot(ro, ro) - 1.0;
        float dsc = b9 * b9 - c9;
        float s_hit = (dsc > 0.0) ? (0.0 - b9 - sqrt(dsc)) : 1e9;
        if (s_hit < 0.0) s_hit = 1e9;
        vec3  gcol = vec3(0.0);
        float gsum = 0.0;
        vec4  a9;
        a9 = g_jet(ubo.j0,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j1,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j2,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j3,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j4,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j5,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j6,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j7,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j8,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j9,  ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j10, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j11, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j12, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j13, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j14, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j15, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j16, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j17, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j18, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j19, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j20, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j21, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j22, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j23, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j24, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j25, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j26, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j27, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j28, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j29, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j30, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        a9 = g_jet(ubo.j31, ro, rd, s_hit); gcol += a9.rgb; gsum += a9.a;
        float sum = 0.0;
        float tca = 0.0 - dot(ro, rd);
        if (tca > 0.0) {{
            vec3  pca  = ro + rd * tca;
            float rc   = length(pca);
            // the condensed rim band at HALF thickness, the glow
            // dragged farther inside the face at lower intensity;
            // the outward edge into space stays as it was
            float din  = max(1.0 - rc, 0.0);
            float inw  = 0.40 * exp(-din / 0.018) + 0.34 * exp(-din / 0.75);
            float od   = exp(-max(rc - 1.0, 0.0) / 0.014) * inw;
            float dip  = clamp(din / 0.75, 0.0, 1.0);
            float hocc = mix(1.0, 0.85, dip);
            vec3  sunh = normalize(vec3(0.85, -0.10, 0.15));
            float hw   = clamp(dot(pca / max(rc, 1e-4), sunh) * 0.5 + 0.5, 0.0, 1.0);
            float nearg = exp(-abs(rc - 1.0) / 0.006);
            sum = od * hocc * (0.06 + 0.26 * hw) * (1.0 + 4.0 * nearg);
        }}
        vec3  icy = vec3(0.36, 0.16, 0.70);
        float tot = sum + gsum;
        vec3  fc  = (icy * sum + gcol) / max(tot, 1e-5);
        fragColor = vec4(fc, clamp(tot * ubo.gain, 0.0, 0.9));
    }

# patch the active source set over the 4k equirect: a large
# perlin owns regions per source, a small one works the blend
func europa_build_maps [ H: @f32, AO: @f32, CV: @f32, EM: @f32, MM: @f32, w: i32, h: i32 ]
    names : array string [ 'europa-greybase', 'europa-fracture', 'europa-crevasses',
        'europa-metal2', 'europa-fracture-blur', 'europa-fracture-detail2',
        'europa-scratch', 'europa-metal4' ]
    ns : i32 [ names.count ]
    sw : new i32 [ ns ]
    sh : new i32 [ ns ]
    so : new i32 [ ns ]
    imgs : array Image []
    total : i32 [ 0 ]
    for [ i: i32 0, i < ns, i += 1 ]
        p9 : path '../scenes/textures/{names[i]}.png'
        im : Image [ uri: p9 ]
        imgs.push[ im ]
        sw[i] = im.width
        sh[i] = im.height
        so[i] = total
        total += im.width * im.height
    SB : new f32 [ total ]
    for [ i: i32 0, i < ns, i += 1 ]
        si : Image imgs[i]
        eu_lum[ si, @SB[ so[i] ] ]
    g0 : @f32 [ @SB[ so[0] ] ]
    g1 : @f32 [ @SB[ so[1] ] ]
    g2 : @f32 [ @SB[ so[2] ] ]
    g3 : @f32 [ @SB[ so[3] ] ]
    g4 : @f32 [ @SB[ so[4] ] ]
    g5 : @f32 [ @SB[ so[5] ] ]
    g6 : @f32 [ @SB[ so[6] ] ]
    g7 : @f32 [ @SB[ so[7] ] ]
    puts 'europa: patching {ns} sources over {w}x{h}'
    for [ y: i32 0, y < h, y += 1 ]
        v : f32 [ (f32[ y ] + 0.5) / f32[ h ] ]
        lat : f32 [ (0.5 - v) * 3.14159265 ]
        cl : f32 [ cos[ lat ] ]
        sl : f32 [ sin[ lat ] ]
        for [ x: i32 0, x < w, x += 1 ]
            u : f32 [ (f32[ x ] + 0.5) / f32[ w ] ]
            lon : f32 [ u * 6.2831853 ]
            spx : f32 [ cl * sin[ lon ] ]
            spy : f32 [ sl ]
            spz : f32 [ cl * cos[ lon ] ]
            # meridian mirror-blend factor for the u seam
            sd9 : f32 [ u ]
            if [ 1.0 - u < sd9 ] sd9 = 1.0 - u
            sk9 : f32 [ sd9 / 0.06 ]
            if [ sk9 > 1.0 ] sk9 = 1.0
            sk9 = sk9 * sk9 * (3.0 - 2.0 * sk9)
            ub9 : f32 [ u + 0.5 ]
            ub9 = ub9 - floor[ ub9 ]
            # smooth rolling plains from the grey base, two octaves
            b1 : f32 [ eu_pat[ g0, sw[0], sh[0], u, v, ub9, sk9, 0.70, 0.9, 0.9, 0.13, 0.41 ] ]
            b2 : f32 [ eu_pat[ g0, sw[0], sh[0], u, v, ub9, sk9, 2.30, 2.1, 2.1, 0.61, 0.07 ] ]
            # ONE fracture domain, three registered levels: the
            # blur presses, the sharp etches, detail2 finest —
            # a second independent domain crossed the first and
            # read as misaligned paint; it is gone
            s1 : f32 [ eu_pat[ g1, sw[1], sh[1], u, v, ub9, sk9, 1.10, 1.2, 1.8, 0.29, 0.53 ] ]
            d1 : f32 [ eu_pat[ g4, sw[4], sh[4], u, v, ub9, sk9, 1.10, 1.2, 1.8, 0.29, 0.53 ] ]
            e1 : f32 [ eu_pat[ g5, sw[5], sh[5], u, v, ub9, sk9, 1.10, 1.2, 1.8, 0.29, 0.53 ] ]
            f1 : f32 [ eu_pat[ g2, sw[2], sh[2], u, v, ub9, sk9, 0.35, 5.0, 11.0, 0.47, 0.83 ] ]
            m1 : f32 [ eu_pat[ g3, sw[3], sh[3], u, v, ub9, sk9, 1.85, 1.7, 3.4, 0.09, 0.67 ] ]
            cb1 : f32 [ 1.0 - eu_sstep[ 0.45, 0.72, d1 ] ]
            cs1 : f32 [ 1.0 - eu_sstep[ 0.30, 0.55, s1 ] ]
            em1 : f32 [ 1.0 - eu_sstep[ 0.90, 0.995, e1 ] ]
            c3  : f32 [ 1.0 - eu_sstep[ 0.15, 0.40, f1 ] ]
            # metal2 runs the opposite way: its BRIGHT streaks etch
            c4  : f32 [ eu_sstep[ 0.62, 0.85, m1 ] ]
            # region perlins move the carving families around
            r1 : f32 [ 0.35 + 0.65 * eu_sstep[ 0.35, 0.65,
                eu_gnoise[ spx * 1.3, spy * 1.3, spz * 1.3 ] ] ]
            r3 : f32 [ eu_sstep[ 0.40, 0.70,
                eu_gnoise[ spx * 2.6, spy * 2.6 + 7.0, spz * 2.6 ] ] ]
            r4 : f32 [ eu_sstep[ 0.42, 0.72,
                eu_gnoise[ spx * 1.5 + 23.0, spy * 1.5, spz * 1.5 ] ] ]
            # reduction perlin on the sharp etch: only ever removes
            rp1 : f32 [ eu_sstep[ 0.25, 0.80,
                eu_gnoise[ spx * 4.7 + 41.0, spy * 4.7, spz * 4.7 ] ] ]
            # deep is ALSO the basis for the bottom texture
            deep : f32 [ cb1 * r1 ]
            if [ deep > 1.0 ] deep = 1.0
            # thin rivers: independent shallow families
            t1 : f32 [ eu_pat[ g6, sw[6], sh[6], u, v, ub9, sk9, 0.85, 2.2, 7.7, 0.21, 0.39 ] ]
            t2 : f32 [ eu_pat[ g6, sw[6], sh[6], u, v, ub9, sk9, 2.15, 4.0, 13.0, 0.57, 0.93 ] ]
            ct1 : f32 [ 1.0 - eu_sstep[ 0.30, 0.55, t1 ] ]
            ct2 : f32 [ 1.0 - eu_sstep[ 0.28, 0.52, t2 ] ]
            det : f32 [ cs1 * (0.05 + 0.28 * cb1) * r1 * rp1
                      + em1 * (0.06 + 0.16 * cb1)
                      + ct1 * 0.030 * (0.40 + 0.60 * r1)
                      + ct2 * 0.020
                      + c3 * 0.05 * r3 + c4 * 0.06 * r4 ]
            h9 : f32 [ 0.62 + (b1 - 0.5) * 0.30 + (b2 - 0.5) * 0.12 ]
            h9 -= deep * 0.55 + det
            if [ h9 < 0.0 ] h9 = 0.0
            if [ h9 > 1.0 ] h9 = 1.0
            H[ y * w + x ] = h9
            # the fine detail IS water: filaments sit at lake
            # level immediately, wherever they mark
            lk9 : f32 [ deep ]
            if [ em1 * 0.96 > lk9 ] lk9 = em1 * 0.96
            CV[ y * w + x ] = lk9
            ev9 : f32 [ em1 * (0.40 + 0.60 * cb1) * r1 ]
            if [ ev9 > 1.0 ] ev9 = 1.0
            EM[ y * w + x ] = ev9
            # metal4 dresses the higher elevations, about a
            # quarter of the moon under its own region perlin
            hm : f32 [ eu_sstep[ 0.64, 0.70, h9 ]
                * (0.45 + 0.55 * eu_sstep[ 0.40, 0.60,
                    eu_gnoise[ spx * 1.4 + 51.0, spy * 1.4, spz * 1.4 ] ]) ]
            m4 : f32 [ eu_pat[ g7, sw[7], sh[7], u, v, ub9, sk9, 1.35, 2.2, 2.9, 0.51, 0.13 ] ]
            m4 = (m4 - 0.21) / 0.61
            if [ m4 < 0.0 ] m4 = 0.0
            if [ m4 > 1.0 ] m4 = 1.0
            MM[ y * w + x ] = hm * m4
    n9 : i32 [ w * h ]
    puts 'europa: baking AO'
    eu_bake_ao[ H, AO, w, h, 60.0 ]
    AB : new f32 [ n9 ]
    eu_blur[ AO, AB, w, h, 2 ]
# the full europa surface bake: maps packed and written to the
# bundle; runs under SILVER_EXPORT, or once live if never baked
func europa_bake []
    w9 : i32 [ 8192 ]
    h9 : i32 [ 4096 ]
    n9 : i32 [ w9 * h9 ]
    H  : new f32 [ n9 ]
    AO : new f32 [ n9 ]
    CV : new f32 [ n9 ]
    EM : new f32 [ n9 ]
    MM : new f32 [ n9 ]
    europa_build_maps[ H, AO, CV, EM, MM, w9, h9 ]
    # pack: R height hi, A height lo, G AO, B cavity
    pk : Image [ width: w9, height: h9, format: Pixel.rgba8, linear: true, wrap_u: true ]
    pd : @u8 [ pk.vdata[] ]
    for [ i: i32 0, i < n9, i += 1 ]
        b2 : i32 [ i * 4 ]
        hq : i32 [ i32[ H[ i ] * 65535.0 ] ]
        pd[ b2 ]     = u8[ hq / 256 ]
        pd[ b2 + 1 ] = u8[ AO[ i ] * 255.0 ]
        pd[ b2 + 2 ] = u8[ CV[ i ] * 255.0 ]
        pd[ b2 + 3 ] = u8[ hq % 256 ]
    # normals from central differences, wrap x clamp y
    nk : Image [ width: w9, height: h9, format: Pixel.rgba8, linear: true, wrap_u: true ]
    nd : @u8 [ nk.vdata[] ]
    for [ y: i32 0, y < h9, y += 1 ]
        ym : i32 [ (y > 0) ? y - 1 : 0 ]
        yp : i32 [ (y < h9 - 1) ? y + 1 : h9 - 1 ]
        for [ x: i32 0, x < w9, x += 1 ]
            xm : i32 [ (x > 0) ? x - 1 : w9 - 1 ]
            xp : i32 [ (x < w9 - 1) ? x + 1 : 0 ]
            dx : f32 [ (H[ y * w9 + xp ] - H[ y * w9 + xm ]) * 4.0 ]
            dy : f32 [ (H[ yp * w9 + x ] - H[ ym * w9 + x ]) * 4.0 ]
            if [ dx < -1.0 ] dx = -1.0
            if [ dx >  1.0 ] dx = 1.0
            if [ dy < -1.0 ] dy = -1.0
            if [ dy >  1.0 ] dy = 1.0
            b3 : i32 [ (y * w9 + x) * 4 ]
            nd[ b3 ]     = u8[ (0.0 - dx) * 127.0 + 128.0 ]
            nd[ b3 + 1 ] = u8[ (0.0 - dy) * 127.0 + 128.0 ]
            nd[ b3 + 2 ] = u8[ MM[ y * w9 + x ] * 255.0 ]
            nd[ b3 + 3 ] = u8[ EM[ y * w9 + x ] * 255.0 ]
    bd : path '../scenes/baked'
    bd.make_dir[]
    pk.png[ path '../scenes/baked/europa-pk.png' ]
    nk.png[ path '../scenes/baked/europa-nk.png' ]
    puts 'europa: baked maps written'

export func europa_maps []
    # token hash of the bake code: recompute only when it changes
    hv : u64 [ @europa_build_maps ]
    hb : u64 [ @europa_bake ]
    stamp : string '{hv}-{hb}'
    sp  : path '../scenes/baked/europa.hash'
    pkp : path '../scenes/baked/europa-pk.png'
    nkp : path '../scenes/baked/europa-nk.png'
    if [ sp.exists[] && pkp.exists[] && nkp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            puts 'europa: baked maps current ({stamp})'
            return
    europa_bake[]
    sp.save[ stamp, null ]

element Europa
    frost : true
    frost_sharp : true
    intern e_cur  : f32
    intern p_cur  : f32
    intern p_set  : bool
    intern eur    : EuropaShader
    intern glow   : EuropaGlowShader
    intern sky    : GaiaShader
    intern jup    : JupiterShader
    intern models : array Model
    intern target : Render
    intern built  : bool
    # async load: worker decodes, draw waits on ready for vk work
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    # geyser plots from the bake; pushed to the shader every frame
    intern jetv   : new f32 [ 128 ]
    public color  : rgba [ r:0.002, g:0.003, b:0.006, a:1.0 ]

    # dense uv sphere built in memory: the displacement needs verts
    func build_sphere [] -> GltfModel
        nlon : i32 [ 768 ]
        nlat : i32 [ 384 ]
        n1 : i32 [ nlon + 1 ]
        m1 : i32 [ nlat + 1 ]
        nv : i32 [ n1 * m1 ]
        nv3 : i32 [ nv * 3 ]
        nv2 : i32 [ nv * 2 ]
        ni : i32 [ nlon * nlat * 6 ]
        vb : i32 [ nv3 * 4 ]
        tb : i32 [ nv2 * 4 ]
        ib : i32 [ ni * 4 ]
        tsz : i32 [ vb + vb + tb + ib ]
        data : new u8 [ tsz ]
        pf : @f32 [ data ]
        ip : @data[ vb + vb + tb ]
        iu : @u32 [ ip ]
        for [ iy: i32 0, iy <= nlat, iy += 1 ]
            lat : f32 [ -1.5707963 + f32[ iy ] * 3.14159265 / f32[ nlat ] ]
            cl : f32 [ cos[ lat ] ]
            sl : f32 [ sin[ lat ] ]
            for [ ix: i32 0, ix <= nlon, ix += 1 ]
                lon : f32 [ f32[ ix ] * 6.2831853 / f32[ nlon ] ]
                dx : f32 [ cl * cos[ lon ] ]
                dy : f32 [ sl ]
                dz : f32 [ cl * sin[ lon ] ]
                vi : i32 [ iy * n1 + ix ]
                i3 : i32 [ vi * 3 ]
                pf[ i3 ]     = dx
                pf[ i3 + 1 ] = dy
                pf[ i3 + 2 ] = dz
                pf[ nv3 + i3 ]     = dx
                pf[ nv3 + i3 + 1 ] = dy
                pf[ nv3 + i3 + 2 ] = dz
                i2 : i32 [ nv3 * 2 + vi * 2 ]
                pf[ i2 ]     = f32[ ix ] / f32[ nlon ]
                pf[ i2 + 1 ] = 1.0 - f32[ iy ] / f32[ nlat ]
        k : i32 [ 0 ]
        for [ iy: i32 0, iy < nlat, iy += 1 ]
            for [ ix: i32 0, ix < nlon, ix += 1 ]
                i0 : i32 [ iy * n1 + ix ]
                iu[ k ]     = u32[ i0 ]
                iu[ k + 1 ] = u32[ i0 + n1 ]
                iu[ k + 2 ] = u32[ i0 + 1 ]
                iu[ k + 3 ] = u32[ i0 + 1 ]
                iu[ k + 4 ] = u32[ i0 + n1 ]
                iu[ k + 5 ] = u32[ i0 + n1 + 1 ]
                k += 6
        bufs : array GltfBuffer [ ]
        bufs += GltfBuffer [ byteLength: u64[ tsz ], data: data ]
        views : array BufferView [ ]
        views += BufferView [ buffer: 0, byteOffset: 0,            byteLength: vb ]
        views += BufferView [ buffer: 0, byteOffset: vb,           byteLength: vb ]
        views += BufferView [ buffer: 0, byteOffset: vb + vb,      byteLength: tb ]
        views += BufferView [ buffer: 0, byteOffset: vb + vb + tb, byteLength: ib ]
        accs : array Accessor [ ]
        accs += Accessor [ bufferView: 0, componentType: ComponentType.FLOAT, type: CompoundType.VEC3, count: nv ]
        accs += Accessor [ bufferView: 1, componentType: ComponentType.FLOAT, type: CompoundType.VEC3, count: nv ]
        accs += Accessor [ bufferView: 2, componentType: ComponentType.FLOAT, type: CompoundType.VEC2, count: nv ]
        accs += Accessor [ bufferView: 3, componentType: ComponentType.UNSIGNED_INT, type: CompoundType.SCALAR, count: ni ]
        am : map i64 [ string ] [ ]
        am[ 'POSITION' ]   = i64[ 0 ]
        am[ 'NORMAL' ]     = i64[ 1 ]
        am[ 'TEXCOORD_0' ] = i64[ 2 ]
        prs : array Primitive [ ]
        prs += Primitive [ name: 'europa', attributes: am, indices: u64[ 3 ], material: 0, mode: Mode.TRIANGLES ]
        mshs : array Mesh [ ]
        mshs += Mesh [ name: 'europa', primitives: prs ]
        nds : array Node [ ]
        nds += Node [ name: 'europa', mesh: 0 ]
        sn : array i64 [ ]
        sn += 0
        scns : array Scene [ ]
        scns += Scene [ name: 'scene', nodes: sn ]
        gm : GltfModel [ nodes: nds, meshes: mshs, scenes: scns, scene: 0,
            buffers: bufs, bufferViews: views, accessors: accs ]
        return gm

    func build_models[]
        built = true
        gltf_path : path '../scenes/models/earth.gltf'
        gltf      : GltfModel.open[ gltf_path ]
        pkp : path '../scenes/baked/europa-pk.png'
        nkp : path '../scenes/baked/europa-nk.png'
        if [ !pkp.exists[] || !nkp.exists[] ]
            puts 'europa: no baked maps — baking live (SILVER_EXPORT=1 bakes at build)'
            europa_bake[]
        pk : Image [ uri: pkp, linear: true, wrap_u: true ]
        nk : Image [ uri: nkp, linear: true, wrap_u: true ]
        w9 : i32 [ pk.width ]
        h9 : i32 [ pk.height ]
        pd9 : @u8 [ pk.vdata[] ]
        e_gltf : build_sphere[]
        e_gltf.hold[]
        e_gltf.compute_worlds[]
        eur = EuropaShader [ vk: vk ]
        e_samplers : map Image [string] [
            'height': pk,
            'nrm_a':  nk
        ]
        eur_model : Model [ vk: vk, w: ux, id: e_gltf, s: eur, samplers: e_samplers, straight_alpha: true ]
        # jet emitters: the strongest lake cells, one per neighborhood
        cw : i32 [ 96 ]
        ch : i32 [ 48 ]
        cavg : new f32 [ cw * ch ]
        for [ cy: i32 0, cy < ch, cy += 1 ]
            for [ cx: i32 0, cx < cw, cx += 1 ]
                y0 : i32 [ cy * h9 / ch ]
                y1 : i32 [ (cy + 1) * h9 / ch ]
                x0 : i32 [ cx * w9 / cw ]
                x1 : i32 [ (cx + 1) * w9 / cw ]
                mx9 : f32 [ 0.0 ]
                for [ yy: i32 y0, yy < y1, yy += 4 ]
                    for [ xx: i32 x0, xx < x1, xx += 4 ]
                        cv9 : f32 [ f32[ pd9[ (yy * w9 + xx) * 4 + 2 ] ] / 255.0 ]
                        if [ cv9 > mx9 ] mx9 = cv9
                # the MAX finds a lake in the cell; averages drowned
                # thin water webs below any threshold
                cavg[ cy * cw + cx ] = mx9
        for [ i: i32 0, i < 128, i += 1 ] jetv[i] = 0.0
        used : new i32 [ cw * ch ]
        for [ i: i32 0, i < cw * ch, i += 1 ] used[i] = 0
        # random lake plots, enceladus-style: seeded picks over every
        # qualifying cell, spaced by the suppression grid — the scan
        # order must never decide, or they all pool at one pole
        nj : i32 [ 0 ]
        seed : i64 [ 48271 ]
        for [ t: i32 0, t < 800, t += 1 ]
            if [ nj >= 32 ] break
            seed = (seed * 1103515245 + 12345) % 2147483647
            ci : i32 [ i32[ seed % i64[ cw * ch ] ] ]
            if [ used[ ci ] != 0 ] continue
            if [ cavg[ ci ] < 0.60 ] continue
            cy9 : i32 [ ci / cw ]
            cx9 : i32 [ ci % cw ]
            # anywhere but the polar caps
            if [ cy9 < 8 || cy9 >= 40 ] continue
            for [ dyi: i32 0, dyi < 3, dyi += 1 ]
                for [ dxi: i32 0, dxi < 3, dxi += 1 ]
                    ny9 : i32 [ cy9 + dyi - 1 ]
                    nx9 : i32 [ (cx9 + dxi - 1 + cw) % cw ]
                    if [ ny9 >= 0 && ny9 < ch ] used[ ny9 * cw + nx9 ] = 1
            U : f32 [ (f32[ cx9 ] + 0.5) / f32[ cw ] ]
            V : f32 [ (f32[ cy9 ] + 0.5) / f32[ ch ] ]
            latj : f32 [ (0.5 - V) * 3.14159265 ]
            lonj : f32 [ (1.0 - U) * 6.2831853 ]
            clj : f32 [ cos[ latj ] ]
            st : f32 [ 0.7 + cavg[ ci ] * 0.4 ]
            if [ st > 1.1 ] st = 1.1
            jetv[ nj * 4 ]     = clj * cos[ lonj ]
            jetv[ nj * 4 + 1 ] = sin[ latj ]
            jetv[ nj * 4 + 2 ] = clj * sin[ lonj ]
            jetv[ nj * 4 + 3 ] = st
            nj += 1
        puts 'europa: {nj} geyser sites'
        puts 'europa: j0 {jetv[0]} {jetv[1]} {jetv[2]} w{jetv[3]}'
        puts 'europa: j1 {jetv[4]} {jetv[5]} {jetv[6]} w{jetv[7]}'
        puts 'europa: j2 {jetv[8]} {jetv[9]} {jetv[10]} w{jetv[11]}'
        glow = EuropaGlowShader [ vk: vk ]
        gl_samplers : map Image [string] [
            'height': pk
        ]
        glow_model : Model [ vk: vk, w: ux, id: gltf, s: glow, samplers: gl_samplers,
            straight_alpha: true, cull_none: true, depth_no_test: true ]
        # storm map: sobel contrast of the jupiter texture, baked at
        # startup — discharges live where the bands shear hardest
        ji : Image [ uri: path '../scenes/textures/jupiter-color.png' ]
        jw : i32 [ ji.width ]
        jh : i32 [ ji.height ]
        jl : new f32 [ jw * jh ]
        eu_lum[ ji, jl ]
        sbi : Image [ width: jw, height: jh, format: Pixel.rgba8, linear: true, wrap_u: true ]
        sd : @u8 [ sbi.vdata[] ]
        for [ y: i32 0, y < jh, y += 1 ]
            ym : i32 [ (y > 0) ? y - 1 : 0 ]
            yp : i32 [ (y < jh - 1) ? y + 1 : jh - 1 ]
            for [ x: i32 0, x < jw, x += 1 ]
                xm : i32 [ (x > 0) ? x - 1 : jw - 1 ]
                xp : i32 [ (x < jw - 1) ? x + 1 : 0 ]
                gx : f32 [ jl[ y * jw + xp ] - jl[ y * jw + xm ] ]
                gy : f32 [ jl[ yp * jw + x ] - jl[ ym * jw + x ] ]
                mg : f32 [ sqrt[ gx * gx + gy * gy ] * 4.0 ]
                if [ mg > 1.0 ] mg = 1.0
                b4 : i32 [ (y * jw + x) * 4 ]
                sd[ b4 ]     = u8[ mg * 255.0 ]
                sd[ b4 + 1 ] = 0
                sd[ b4 + 2 ] = 0
                sd[ b4 + 3 ] = 255
        jup = JupiterShader [ vk: vk ]
        j_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/jupiter-color.png', surface: TitanSurface.color,
                wrap_u: true ],
            'height': sbi
        ]
        jup_model : Model [ vk: vk, w: ux, id: gltf, s: jup, samplers: j_samplers, straight_alpha: true ]
        sky       = GaiaShader [ vk: vk ]
        sky_samplers : map Image [string] [
            'color': Image [ uri: path '../scenes/textures/gaia.png', surface: GaiaSurface.color ]
        ]
        sky_model : Model [ vk: vk, w: ux, id: gltf, s: sky, samplers: sky_samplers,
            straight_alpha: true, cull_none: true ]
        models = array Model [ sky_model, jup_model, eur_model, glow_model ]

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        ux.element_targets[ id ] = target

    # unregister only; we keep our ref so the GPU graph outlives the frame
    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    # ice light: pale cold panes, glacier blue accents
    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#000a',       # editor pane background
            '#140a2a80':  '#0e141a80',   # console pane background
            '#ff6a2e55':  '#7ac8e855',   # search highlight fill
            '#220022aa':  '#0c1216aa',   # run console base fill
            '#614':       '#28343e',     # TButtons / nav rest fill
            '#413':       '#1e2830',     # TButtons hover fill
            '#826':       '#3e5060',     # TButtons lit / nav selected
            '#625a':      '#268a',       # bottom status bar fill
            '#8af2':      '#8cf2',       # status bar inner glow
            '#425':       '#16a8',       # editor selection color
            '#44225588':  '#16a4'        # editor line highlight
        ]

    func load_bg [ arg: object ]
        t0 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg start at {t0}'
        build_models[]
        t1 : i64 [ Au.epoch_millis[] ]
        puts 'scene load_bg done in {t1 - t0}ms at {t1}'
        ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : array []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: @load_bg, work: w9 ]
        if [ !ready ] return
        create_target[]
        orbit[]

    func orbit[]
        # surface flyover like enceladus: ice fills the frame at low
        # orbit and jupiter hangs above the limb ahead
        time : 0.0 - ux.time * 1460.0
        if [ time == 0.0 ] time = -54.0
        a_t      : f32 [ (ux.orbit_mode == OrbitView.low)  ? 0.25 :
                         (ux.orbit_mode == OrbitView.high) ? 0.70 : 2.60 ]
        if [ e_cur == 0.0 ] e_cur = a_t
        e_cur = filter_n[ e_cur, a_t, 0.08, ux.frame_factor ]
        altitude : f32 [ e_cur ]
        eye_dist : f32 [ 1.0 + altitude ]
        t_deg    : f32 [ (ux.angle_mode == ViewAngle.flat)   ? 0.0 :
                         (ux.angle_mode == ViewAngle.angled) ? 60.0 : 76.0 ]
        if [ p_cur == 0.0 && !p_set ] p_cur = t_deg
        p_set    = true
        p_cur    = filter_n[ p_cur, t_deg, 0.08, ux.frame_factor ]
        ux.orbit_moving = abs[ e_cur - a_t ] > 0.0004 || abs[ p_cur - t_deg ] > 0.05
        tilt     : f32 [ radians[ p_cur ] ]
        aspect   : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]
        orbit_a : radians[ time ]
        co      : cos[ orbit_a ]
        so      : sin[ orbit_a ]
        ex_l  : f32 [ 0.0 ]
        ey_l  : f32 [ 0.0 ]
        ez_l  : f32 [ eye_dist ]
        fx_l  : f32 [ -sin[ tilt ] ]
        fy_l  : f32 [ 0.0 ]
        fz_l  : f32 [ -cos[ tilt ] ]
        tx_l  : f32 [ ex_l + fx_l * 2.0 ]
        ty_l  : f32 [ ey_l + fy_l * 2.0 ]
        tz_l  : f32 [ ez_l + fz_l * 2.0 ]
        _eye   : vec3f [  co * ex_l + so * ez_l, ey_l, -so * ex_l + co * ez_l ]
        _tgt   : vec3f [  co * tx_l + so * tz_l, ty_l, -so * tx_l + co * tz_l ]
        _up    : vec3f [  co, 0.0, 0.0 - so ]

        _proj  : mat4f.perspective[ radians[ 60.0 ], aspect, 0.001, 60.0 ]
        _view  : mat4f.look_at    [ _eye, _tgt, _up ]

        eur.model    = mat4f.identity[]
        eur.view     = _view
        eur.proj     = _proj
        eur.gain     = 1.5
        eur.displace = 0.016
        eur.cam_pos  = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]

        # the glow shell just past the terrain, whole sky from inside
        gm9 : mat4f.identity[]
        gm9 = gm9.scale [ vec3f [ 1.30, 1.30, 1.30 ] ]
        glow.model   = gm9
        glow.view    = _view
        glow.proj    = _proj
        glow.gain    = 1.0
        glow.time    = ux.time * 60000.0
        glow.cam_pos = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        # the emitter list re-arms every frame like cam_pos: set once
        # at build, the values died with the frame pool
        glow.j0  = vec4f [ jetv[0] + 0.0,   jetv[1] + 0.0,   jetv[2] + 0.0,   jetv[3] + 0.0]
        glow.j1  = vec4f [ jetv[4] + 0.0,   jetv[5] + 0.0,   jetv[6] + 0.0,   jetv[7] + 0.0]
        glow.j2  = vec4f [ jetv[8] + 0.0,   jetv[9] + 0.0,   jetv[10] + 0.0,  jetv[11] + 0.0]
        glow.j3  = vec4f [ jetv[12] + 0.0,  jetv[13] + 0.0,  jetv[14] + 0.0,  jetv[15] + 0.0]
        glow.j4  = vec4f [ jetv[16] + 0.0,  jetv[17] + 0.0,  jetv[18] + 0.0,  jetv[19] + 0.0]
        glow.j5  = vec4f [ jetv[20] + 0.0,  jetv[21] + 0.0,  jetv[22] + 0.0,  jetv[23] + 0.0]
        glow.j6  = vec4f [ jetv[24] + 0.0,  jetv[25] + 0.0,  jetv[26] + 0.0,  jetv[27] + 0.0]
        glow.j7  = vec4f [ jetv[28] + 0.0,  jetv[29] + 0.0,  jetv[30] + 0.0,  jetv[31] + 0.0]
        glow.j8  = vec4f [ jetv[32] + 0.0,  jetv[33] + 0.0,  jetv[34] + 0.0,  jetv[35] + 0.0]
        glow.j9  = vec4f [ jetv[36] + 0.0,  jetv[37] + 0.0,  jetv[38] + 0.0,  jetv[39] + 0.0]
        glow.j10 = vec4f [ jetv[40] + 0.0,  jetv[41] + 0.0,  jetv[42] + 0.0,  jetv[43] + 0.0]
        glow.j11 = vec4f [ jetv[44] + 0.0,  jetv[45] + 0.0,  jetv[46] + 0.0,  jetv[47] + 0.0]
        glow.j12 = vec4f [ jetv[48] + 0.0,  jetv[49] + 0.0,  jetv[50] + 0.0,  jetv[51] + 0.0]
        glow.j13 = vec4f [ jetv[52] + 0.0,  jetv[53] + 0.0,  jetv[54] + 0.0,  jetv[55] + 0.0]
        glow.j14 = vec4f [ jetv[56] + 0.0,  jetv[57] + 0.0,  jetv[58] + 0.0,  jetv[59] + 0.0]
        glow.j15 = vec4f [ jetv[60] + 0.0,  jetv[61] + 0.0,  jetv[62] + 0.0,  jetv[63] + 0.0]
        glow.j16 = vec4f [ jetv[64] + 0.0,  jetv[65] + 0.0,  jetv[66] + 0.0,  jetv[67] + 0.0]
        glow.j17 = vec4f [ jetv[68] + 0.0,  jetv[69] + 0.0,  jetv[70] + 0.0,  jetv[71] + 0.0]
        glow.j18 = vec4f [ jetv[72] + 0.0,  jetv[73] + 0.0,  jetv[74] + 0.0,  jetv[75] + 0.0]
        glow.j19 = vec4f [ jetv[76] + 0.0,  jetv[77] + 0.0,  jetv[78] + 0.0,  jetv[79] + 0.0]
        glow.j20 = vec4f [ jetv[80] + 0.0,  jetv[81] + 0.0,  jetv[82] + 0.0,  jetv[83] + 0.0]
        glow.j21 = vec4f [ jetv[84] + 0.0,  jetv[85] + 0.0,  jetv[86] + 0.0,  jetv[87] + 0.0]
        glow.j22 = vec4f [ jetv[88] + 0.0,  jetv[89] + 0.0,  jetv[90] + 0.0,  jetv[91] + 0.0]
        glow.j23 = vec4f [ jetv[92] + 0.0,  jetv[93] + 0.0,  jetv[94] + 0.0,  jetv[95] + 0.0]
        glow.j24 = vec4f [ jetv[96] + 0.0,  jetv[97] + 0.0,  jetv[98] + 0.0,  jetv[99] + 0.0]
        glow.j25 = vec4f [ jetv[100] + 0.0, jetv[101] + 0.0, jetv[102] + 0.0, jetv[103] + 0.0]
        glow.j26 = vec4f [ jetv[104] + 0.0, jetv[105] + 0.0, jetv[106] + 0.0, jetv[107] + 0.0]
        glow.j27 = vec4f [ jetv[108] + 0.0, jetv[109] + 0.0, jetv[110] + 0.0, jetv[111] + 0.0]
        glow.j28 = vec4f [ jetv[112] + 0.0, jetv[113] + 0.0, jetv[114] + 0.0, jetv[115] + 0.0]
        glow.j29 = vec4f [ jetv[116] + 0.0, jetv[117] + 0.0, jetv[118] + 0.0, jetv[119] + 0.0]
        glow.j30 = vec4f [ jetv[120] + 0.0, jetv[121] + 0.0, jetv[122] + 0.0, jetv[123] + 0.0]
        glow.j31 = vec4f [ jetv[124] + 0.0, jetv[125] + 0.0, jetv[126] + 0.0, jetv[127] + 0.0]

        # the galaxy wraps the whole scene from a big inner sphere
        skq9 : vec4f [ 1.0, 0.0, 0.0, radians[ 45.0 ] ]
        skq  : quatf [ skq9 ]
        skm : mat4f.identity[]
        skm = skm.rotate[ skq ]
        skm = skm.scale [ vec3f [ 30.0, 30.0, 30.0 ] ]
        sky.model = skm
        sky.view  = _view
        sky.proj  = _proj
        sky.gain  = 0.45
        sky.time  = ux.time * 60000.0

        # jupiter fixed in the sky above the limb, huge and near
        # upright — the offset rides the SAME orbit rotation as the
        # eye or the camera walks away from it
        rise   : f32 [ radians[ 14.0 ] ]
        aim    : f32 [ tilt + rise ]
        s_dist : f32 [ 24.0 ]
        sx9    : f32 [ 0.0 - s_dist * sin[ aim ] ]
        sz9    : f32 [ eye_dist - s_dist * cos[ aim ] ]
        s_off  : vec3f [ co * sx9 + so * sz9, 0.0, (0.0 - so) * sx9 + co * sz9 ]
        s_sc   : vec3f [ 11.0, 11.0, 11.0 ]
        s_axis : vec4f [ 0.0, 0.0, 1.0, radians[ -3.0 ] ]
        sq     : quatf [ s_axis ]
        s_tip  : vec4f [ 1.0, 0.0, 0.0, radians[ 8.0 ] ]
        sq3    : quatf [ s_tip ]
        s_spin : vec4f [ 0.0, 1.0, 0.0, radians[ ux.time * 6000.0 ] ]
        sq2    : quatf [ s_spin ]
        sm : mat4f.identity[]
        sm = sm.translate[ s_off ]
        sm = sm.rotate   [ sq3 ]
        sm = sm.rotate   [ sq ]
        sm = sm.rotate   [ sq2 ]
        sm = sm.scale    [ s_sc ]
        jup.model    = sm
        jup.view     = _view
        jup.proj     = _proj
        jup.gain     = 0.75
        jup.cam_pos  = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        jup.time     = ux.time * 60000.0


# ======================================================================
# Olympus: a GROUND STAGE on Mars, not a globe. mars-height carries the
# real geography and the clone patches add the resolution it does not
# have -- 8192 across the planet is 400m a texel, which is a smooth
# ramp at walking distance. its own enum: a binding added to an
# inherited shader lands on the parent's slot
# MOLA elevations are metres against the areoid; this turns them into
# sphere radii. everything downstream is in radii
func mars_radius [] -> f32
    return 3390000.0

# the Valles Marineris box, in our uv space. the valley runs roughly
# 255E to 335E just south of the equator; this is 240E..340E by
# 15N..25S, which holds it end to end with room to orbit along it.
# u = 0 is longitude 180, so 240E lands at 0.1667
func mars_vu0 [] -> f32
    return 0.166667
func mars_vu1 [] -> f32
    return 0.444444
func mars_vv0 [] -> f32
    return 0.416667
func mars_vv1 [] -> f32
    return 0.638889

# packing range for the baked height, in sphere radii. MOLA runs
# -8208m (Hellas floor) to +21229m (Olympus summit); this spans that
# with a little headroom either side
func mars_hmin [] -> f32
    return -0.0028
func mars_hmax [] -> f32
    return 0.0068

# the slope either baked component carries before it clamps. real
# martian slopes averaged over 463m stay well under 1.0, so 1.5 keeps
# far more precision than the 4.0 a synthetic field needed
func mars_smax [] -> f32
    return 1.5

# relief exaggeration. applied to height AND slope TOGETHER, in the
# bake, so the shading can never disagree with the silhouette. 1.0 is
# true scale -- and true scale is subtle: all of Mars is 0.87% of its
# own radius, so from orbit a real planet looks nearly smooth
func mars_exag [] -> f32
    return 1.0

# MOLA MEGDR, 128 pixels per degree: 16 tiles of 11520 x 5632, 16-bit
# signed big-endian metres. four latitude bands running down from +88,
# four longitudes running east from 0. assembled here into one
# 46080 x 22528 grid, north row first, longitude 0 at column 0
func mola_load [ M: @i16 ] -> bool
    # the export runs with cwd at the bundle, so a relative path finds
    # nothing. SILVER is the source root and is set for every build
    root : path.path_startup[]
    ev : symbol [ getenv[ 'SILVER' ] ]
    if [ ev ] root = path [ string [ ev ] ]
    if [ !root ]
        puts 'mola: no SILVER root — cannot locate the tiles'
        return false
    puts 'mola: reading tiles from {root}/checkout/mola'
    bands : array string [ '88n', '44n', '00n', '44s' ]
    lons  : array string [ '000', '090', '180', '270' ]
    tw : i32 [ 11520 ]
    th : i32 [ 5632 ]
    gw : i32 [ 46080 ]
    row : new u8 [ tw * 2 ]
    for [ b: i32 0, b < 4, b += 1 ]
        for [ l: i32 0, l < 4, l += 1 ]
            fn : string '{root}/checkout/mola/megt{bands[b]}{lons[l]}hb.img'
            fp : handle [ fopen[ fn.chars, 'rb' ] ]
            if [ !fp ]
                puts 'mola: cannot open {fn}'
                return false
            for [ y: i32 0, y < th, y += 1 ]
                nr : i32 [ i32[ fread[ @row[0], 1, tw * 2, fp ] ] ]
                if [ nr < tw * 2 ]
                    puts 'mola: short read in {fn} row {y}'
                    fclose[ fp ]
                    return false
                base : i32 [ (b * th + y) * gw + l * tw ]
                for [ x: i32 0, x < tw, x += 1 ]
                    # big-endian, and the sign has to be put back by
                    # hand: the high byte carries it
                    v : i32 [ i32[ row[ x * 2 ] ] * 256 + i32[ row[ x * 2 + 1 ] ] ]
                    if [ v > 32767 ] v = v - 65536
                    M[ base + x ] = i16[ v ]
            fclose[ fp ]
    puts 'mola: loaded 16 tiles into 46080x22528'
    return true

# our uv space is not MOLA's: u = 0 sits at longitude 180, and v spans
# the full pole-to-pole 180 while MOLA stops at +/-88. so a column is
# a pure rotation by half the grid, and a row is an offset of 256 with
# the two-degree polar caps clamped to the nearest real data
func mola_at [ M: @i16, ux: i32, uy: i32 ] -> f32
    gw : i32 [ 46080 ]
    gh : i32 [ 22528 ]
    mx : i32 [ ux - 23040 ]
    if [ mx < 0 ] mx = mx + gw
    if [ mx >= gw ] mx = mx - gw
    my : i32 [ uy - 256 ]
    if [ my < 0 ] my = 0
    if [ my >= gh ] my = gh - 1
    return f32[ M[ my * gw + mx ] ]

# CPU twin of the shader's old height field. the guide steers the patch
# exactly as it did per-fragment, but now it runs ONCE at 8192x4096
# instead of three times per pixel per frame
func mars_build_height [ H: @f32, w: i32, h: i32 ]
    bim : Image [ uri: path '../scenes/textures/mars-height-8192x4096.png' ]
    bw : i32 [ bim.width ]
    bh : i32 [ bim.height ]
    B : new f32 [ bw * bh ]
    eu_lum[ bim, B ]

    names : array string [ 'europa-caldera', 'europa-stardunes', 'europa-grain-granite' ]
    ns : i32 [ names.count ]
    sw : new i32 [ ns ]
    sh : new i32 [ ns ]
    so : new i32 [ ns ]
    imgs : array Image []
    total : i32 [ 0 ]
    for [ i: i32 0, i < ns, i += 1 ]
        p9 : path '../scenes/textures/{names[i]}.png'
        im : Image [ uri: p9 ]
        imgs.push[ im ]
        sw[i] = im.width
        sh[i] = im.height
        so[i] = total
        total += im.width * im.height
    SB : new f32 [ total ]
    for [ i: i32 0, i < ns, i += 1 ]
        si : Image imgs[i]
        eu_lum[ si, @SB[ so[i] ] ]
    g0 : @f32 [ @SB[ so[0] ] ]
    g1 : @f32 [ @SB[ so[1] ] ]
    g2 : @f32 [ @SB[ so[2] ] ]

    disp : f32 [ 0.0088 ]
    detl : f32 [ 0.00030 ]
    ee : f32 [ 1.0 / 8192.0 ]
    puts 'mars: patching {ns} sources over {w}x{h}'
    for [ y: i32 0, y < h, y += 1 ]
        v : f32 [ (f32[ y ] + 0.5) / f32[ h ] ]
        for [ x: i32 0, x < w, x += 1 ]
            u : f32 [ (f32[ x ] + 0.5) / f32[ w ] ]
            # the guide, read with the same offset the shader uses to
            # line the height map up with the color map
            bu : f32 [ u - 0.0635 ]
            b : f32 [ eu_bilin[ B, bw, bh, bu, v ] ]
            gx : f32 [ eu_bilin[ B, bw, bh, bu + ee, v ] - eu_bilin[ B, bw, bh, bu - ee, v ] ]
            gy : f32 [ eu_bilin[ B, bw, bh, bu, v + ee ] - eu_bilin[ B, bw, bh, bu, v - ee ] ]
            rug : f32 [ sqrt[ gx * gx + gy * gy ] * 55.0 ]
            if [ rug > 1.0 ] rug = 1.0
            # detail follows the guide's own slope: torn ground gets the
            # roughness, the plains stay smooth. never zero, or the
            # flats turn to glass
            amp : f32 [ 0.22 + 0.78 * rug ]
            # meridian mirror-blend: the wrap lands mid-tile under these
            # rotations, so a half-turn clone covers the seam band
            sd : f32 [ (u < 1.0 - u) ? u : 1.0 - u ]
            sk : f32 [ eu_sstep[ 0.0, 0.06, sd ] ]
            ub : f32 [ u + 0.5 ]
            if [ ub > 1.0 ] ub = ub - 1.0
            sp3 : f32 [ 0.0 ]
            # four octaves, each source on its own angle and scale so no
            # two grains line up with each other or with the equirect
            for [ oi: i32 0, oi < 4, oi += 1 ]
                oc : f32 [ (oi == 0) ? 1.0 : ((oi == 1) ? 3.7 : ((oi == 2) ? 13.0 : 47.0)) ]
                wt : f32 [ (oi == 0) ? 1.0 : ((oi == 1) ? 0.46 : ((oi == 2) ? 0.21 : 0.09)) ]
                pa : f32 [ eu_pat[ g0, sw[0], sh[0], u, v, ub, sk, 0.70,  61.0 * oc,  61.0 * oc, 0.13, 0.41 ] ]
                pb : f32 [ eu_pat[ g1, sw[1], sh[1], u, v, ub, sk, 2.30,  97.0 * oc,  97.0 * oc, 0.61, 0.07 ] ]
                pc : f32 [ eu_pat[ g2, sw[2], sh[2], u, v, ub, sk, 4.10, 149.0 * oc, 149.0 * oc, 0.29, 0.83 ] ]
                # the noise decides which source owns each region; a
                # single lerp would leave the third as a constant wash
                w1 : f32 [ eu_gnoise[ u * 1.7 * oc, v * 1.7 * oc, 0.0 ] ]
                w3 : f32 [ eu_gnoise[ u * 0.9 * oc + 5.0, v * 0.9 * oc + 61.0, 13.0 ] ]
                w2 : f32 [ eu_gnoise[ u * 3.9 * oc + 19.0, v * 3.9 * oc + 7.0, 41.0 ] ]
                ab : f32 [ pa + (pb - pa) * eu_sstep[ 0.30, 0.70, w1 ] ]
                cc : f32 [ ab + (pc - ab) * eu_sstep[ 0.35, 0.75, w3 ] ]
                sp3 += (cc * (0.80 + 0.40 * w2) - 0.5) * wt
            H[ y * w + x ] = b * disp + sp3 * detl * amp

func mars_bake []
    w9 : i32 [ 8192 ]
    h9 : i32 [ 4096 ]
    n9 : i32 [ w9 * h9 ]
    H : new f32 [ n9 ]
    mars_build_height[ H, w9, h9 ]
    hmx : f32 [ mars_hmax[] ]
    # height packed 16-bit across R and A: 8 bits of 0.0104 radii is a
    # 40m stair, and the terminator finds every one of them
    pk : Image [ width: w9, height: h9, format: Pixel.rgba8, linear: true, wrap_u: true ]
    pd : @u8 [ pk.vdata[] ]
    for [ i: i32 0, i < n9, i += 1 ]
        t : f32 [ H[ i ] / hmx ]
        if [ t < 0.0 ] t = 0.0
        if [ t > 1.0 ] t = 1.0
        hq : i32 [ i32[ t * 65535.0 ] ]
        b2 : i32 [ i * 4 ]
        pd[ b2 ]     = u8[ hq / 256 ]
        pd[ b2 + 1 ] = 0
        pd[ b2 + 2 ] = 0
        pd[ b2 + 3 ] = u8[ hq % 256 ]
    # normals as real surface SLOPE, not a fudge: dH over the world
    # distance between texels, so the shading matches the displacement
    smx : f32 [ mars_smax[] ]
    du : f32 [ 6.2831853 / f32[ w9 ] ]
    dv : f32 [ 3.1415927 / f32[ h9 ] ]
    nk : Image [ width: w9, height: h9, format: Pixel.rgba8, linear: true, wrap_u: true ]
    nd : @u8 [ nk.vdata[] ]
    for [ y: i32 0, y < h9, y += 1 ]
        ym : i32 [ (y > 0) ? y - 1 : 0 ]
        yp : i32 [ (y < h9 - 1) ? y + 1 : h9 - 1 ]
        # meridians converge: a degree of longitude is cos(lat) as wide
        lat9 : f32 [ (0.5 - (f32[ y ] + 0.5) / f32[ h9 ]) * 3.1415927 ]
        cl9 : f32 [ cos[ lat9 ] ]
        if [ cl9 < 0.02 ] cl9 = 0.02
        for [ x: i32 0, x < w9, x += 1 ]
            xm : i32 [ (x > 0) ? x - 1 : w9 - 1 ]
            xp : i32 [ (x < w9 - 1) ? x + 1 : 0 ]
            su : f32 [ (H[ y * w9 + xp ] - H[ y * w9 + xm ]) / (2.0 * du * cl9) ]
            sv : f32 [ (H[ yp * w9 + x ] - H[ ym * w9 + x ]) / (2.0 * dv) ]
            su = su / smx
            sv = sv / smx
            if [ su < -1.0 ] su = -1.0
            if [ su >  1.0 ] su = 1.0
            if [ sv < -1.0 ] sv = -1.0
            if [ sv >  1.0 ] sv = 1.0
            b3 : i32 [ (y * w9 + x) * 4 ]
            nd[ b3 ]     = u8[ su * 127.0 + 128.0 ]
            nd[ b3 + 1 ] = u8[ sv * 127.0 + 128.0 ]
            nd[ b3 + 2 ] = 0
            nd[ b3 + 3 ] = 255
    bd : path '../scenes/baked'
    bd.make_dir[]
    pk.png[ path '../scenes/baked/mars-pk.png' ]
    nk.png[ path '../scenes/baked/mars-nk.png' ]
    puts 'mars: baked maps written'

# the real thing: MOLA straight through, no invented detail. the
# displacement map stays at 8192 (the mesh is 3072 wide, so that is
# already generous) while the SLOPE goes out at MOLA's full 46080,
# split into four longitude tiles -- 46080 is past what any GPU will
# take as one image, and slope is where 463m actually shows
func mars_bake_mola [] -> bool
    gw : i32 [ 46080 ]
    gh : i32 [ 22528 ]
    ow : i32 [ 46080 ]
    oh : i32 [ 23040 ]
    M : new i16 [ gw * gh ]
    if [ !mola_load[ M ] ]
        puts 'mars: MOLA tiles missing — run the download first'
        return false
    R : f32 [ mars_radius[] ]
    ex : f32 [ mars_exag[] ]
    hlo : f32 [ mars_hmin[] ]
    hhi : f32 [ mars_hmax[] ]
    hsp : f32 [ hhi - hlo ]

    # displacement map: box-averaged down from 46080, because point
    # sampling a 5.6x reduction aliases every ridge into sparkle
    dw : i32 [ 8192 ]
    dh : i32 [ 4096 ]
    # 46080/8192 is 5.625, NOT 5. integer division here walks the whole
    # map out of register -- the elevation range still looks right
    # because it still sweeps the planet, just to the wrong places
    fsx : f32 [ f32[ ow ] / f32[ dw ] ]
    fsy : f32 [ f32[ oh ] / f32[ dh ] ]
    pk : Image [ width: dw, height: dh, format: Pixel.rgba8, linear: true, wrap_u: true ]
    pd : @u8 [ pk.vdata[] ]
    for [ y: i32 0, y < dh, y += 1 ]
        by0 : i32 [ i32[ f32[ y ] * fsy ] ]
        by1 : i32 [ i32[ f32[ y + 1 ] * fsy ] ]
        if [ by1 <= by0 ] by1 = by0 + 1
        for [ x: i32 0, x < dw, x += 1 ]
            bx0 : i32 [ i32[ f32[ x ] * fsx ] ]
            bx1 : i32 [ i32[ f32[ x + 1 ] * fsx ] ]
            if [ bx1 <= bx0 ] bx1 = bx0 + 1
            acc : f32 [ 0.0 ]
            nsm : i32 [ 0 ]
            for [ by: i32 by0, by < by1, by += 1 ]
                for [ bx: i32 bx0, bx < bx1, bx += 1 ]
                    acc += mola_at[ M, bx, by ]
                    nsm += 1
            mv : f32 [ acc / f32[ nsm ] ]
            hr : f32 [ mv / R * ex ]
            t : f32 [ (hr - hlo) / hsp ]
            if [ t < 0.0 ] t = 0.0
            if [ t > 1.0 ] t = 1.0
            hq : i32 [ i32[ t * 65535.0 ] ]
            b2 : i32 [ (y * dw + x) * 4 ]
            pd[ b2 ]     = u8[ hq / 256 ]
            pd[ b2 + 1 ] = 0
            pd[ b2 + 2 ] = 0
            pd[ b2 + 3 ] = u8[ hq % 256 ]
    bd : path '../scenes/baked'
    bd.make_dir[]
    pk.png[ path '../scenes/baked/mars-pk.png' ]
    puts 'mars: displacement map written ({dw}x{dh})'

    # slope. one degree of latitude is a fixed distance; one of
    # longitude shrinks as cos(lat), so the east-west run has to carry
    # that or every pole turns into a spike
    smx : f32 [ mars_smax[] ]
    dstep : f32 [ 3.1415927 / 180.0 / 128.0 ]

    # global slope, at the displacement map's resolution: this is what
    # the rest of the planet is shaded with
    nk : Image [ width: dw, height: dh, format: Pixel.rgba8, linear: true, wrap_u: true ]
    nd : @u8 [ nk.vdata[] ]
    gstep : f32 [ dstep * fsx ]
    isx : i32 [ i32[ fsx ] ]
    isy : i32 [ i32[ fsy ] ]
    for [ y: i32 0, y < dh, y += 1 ]
        lat9 : f32 [ (0.5 - (f32[ y ] + 0.5) / f32[ dh ]) * 3.1415927 ]
        cl9 : f32 [ cos[ lat9 ] ]
        if [ cl9 < 0.004 ] cl9 = 0.004
        for [ x: i32 0, x < dw, x += 1 ]
            cx9 : i32 [ i32[ (f32[ x ] + 0.5) * fsx ] ]
            cy9 : i32 [ i32[ (f32[ y ] + 0.5) * fsy ] ]
            hu : f32 [ (mola_at[ M, cx9 + isx, cy9 ] - mola_at[ M, cx9 - isx, cy9 ]) / R * ex ]
            hv2 : f32 [ (mola_at[ M, cx9, cy9 + isy ] - mola_at[ M, cx9, cy9 - isy ]) / R * ex ]
            pu : f32 [ hu / (2.0 * gstep * cl9) / smx ]
            pv : f32 [ hv2 / (2.0 * gstep) / smx ]
            if [ pu < -1.0 ] pu = -1.0
            if [ pu >  1.0 ] pu = 1.0
            if [ pv < -1.0 ] pv = -1.0
            if [ pv >  1.0 ] pv = 1.0
            b3 : i32 [ (y * dw + x) * 4 ]
            nd[ b3 ]     = u8[ pu * 127.0 + 128.0 ]
            nd[ b3 + 1 ] = u8[ pv * 127.0 + 128.0 ]
            nd[ b3 + 2 ] = 0
            nd[ b3 + 3 ] = 255
    nk.png[ path '../scenes/baked/mars-nk.png' ]
    puts 'mars: global slope written ({dw}x{dh})'

    # the valley, at MOLA's own 463m. only this box gets it: the whole
    # planet at full resolution is a gigapixel of slope nobody orbits
    # over. 240E..340E by 15N..25S covers Valles Marineris end to end
    vx0 : i32 [ i32[ mars_vu0[] * f32[ ow ] ] ]
    vy0 : i32 [ i32[ mars_vv0[] * f32[ oh ] ] ]
    vw : i32 [ i32[ (mars_vu1[] - mars_vu0[]) * f32[ ow ] ] ]
    vh : i32 [ i32[ (mars_vv1[] - mars_vv0[]) * f32[ oh ] ] ]
    vsu : Image [ width: vw, height: vh, format: Pixel.u8, linear: true ]
    vsv : Image [ width: vw, height: vh, format: Pixel.u8, linear: true ]
    vud : @u8 [ vsu.vdata[] ]
    vvd : @u8 [ vsv.vdata[] ]
    for [ y: i32 0, y < vh, y += 1 ]
        gy : i32 [ vy0 + y ]
        lat9 : f32 [ (0.5 - (f32[ gy ] + 0.5) / f32[ oh ]) * 3.1415927 ]
        cl9 : f32 [ cos[ lat9 ] ]
        if [ cl9 < 0.004 ] cl9 = 0.004
        for [ x: i32 0, x < vw, x += 1 ]
            gx : i32 [ vx0 + x ]
            hu : f32 [ (mola_at[ M, gx + 1, gy ] - mola_at[ M, gx - 1, gy ]) / R * ex ]
            hv2 : f32 [ (mola_at[ M, gx, gy + 1 ] - mola_at[ M, gx, gy - 1 ]) / R * ex ]
            pu : f32 [ hu / (2.0 * dstep * cl9) / smx ]
            pv : f32 [ hv2 / (2.0 * dstep) / smx ]
            if [ pu < -1.0 ] pu = -1.0
            if [ pu >  1.0 ] pu = 1.0
            if [ pv < -1.0 ] pv = -1.0
            if [ pv >  1.0 ] pv = 1.0
            o : i32 [ y * vw + x ]
            vud[ o ] = u8[ pu * 127.0 + 128.0 ]
            vvd[ o ] = u8[ pv * 127.0 + 128.0 ]
    vsu.png[ path '../scenes/baked/mars-vsu.png' ]
    vsv.png[ path '../scenes/baked/mars-vsv.png' ]
    puts 'mars: valles slope written ({vw}x{vh})'
    puts 'mars: MOLA bake complete'
    return true

# how many times the rock material repeats across the equator, and how
# far it tilts the normal. 2048 tiles over 21300km of equator is a
# 10.4km tile, so its own 2048 texels land at 5m each -- against MOLA's
# 2600m, which is what makes the surface mush from 13km up
func mars_dtile [] -> f32
    return 2048.0
# the gate spans 0.10 to 2.00 on its own, so this stays at unity and
# the numbers in the shader mean what they say
func mars_damp [] -> f32
    return 1.0
# how far the rock material lifts the MESH, in sphere radii, before
# the edge map scales it. 0.00004 is 136m of relief where MOLA has none
func mars_dh [] -> f32
    return 0.00004

# relief multiplier applied at DRAW time, not in the bake -- the bake
# reads 2GB of MOLA tiles and this is a look control. it must scale
# hmax and smax TOGETHER: hmax sets how far the mesh lifts, smax how
# hard the slope map shades, and moving one without the other makes
# the shading disagree with the silhouette
func mars_relief [] -> f32
    return 3.0

# ONE tileable rock material for the whole planet: normal in RG,
# cavity in B, roughness in A. this is the slot a real terrain PBR
# normal map drops into -- point mars-dn at it and delete nothing else.
#
# EVERY source read uses an EVEN integer scale. eu_bilin addresses
# mirrored, whose period is 2, so an even scale is exactly periodic
# over one output tile and no seam can print at any tiling frequency.
# free rotation would break that, which is why there is none here
func mars_bake_detail [] -> bool
    # sources chosen by MEASURED structure-tensor coherence, because
    # Mars has no grain direction and a source that does prints its own
    # across the whole planet. stardunes ran 0.482 at -42 degrees --
    # that was the diagonal streaking -- and granite 0.335 at 0, which
    # banded it horizontally. these three are the flattest we own:
    # scratch 0.012, metal4 0.042, fracture 0.056
    names : array string [ 'europa-scratch', 'europa-metal4', 'europa-fracture', 'europa-caldera' ]
    ns : i32 [ names.count ]
    sw : new i32 [ ns ]
    sh : new i32 [ ns ]
    so : new i32 [ ns ]
    imgs : array Image []
    total : i32 [ 0 ]
    for [ i: i32 0, i < ns, i += 1 ]
        p9 : path '../scenes/textures/{names[i]}.png'
        im : Image [ uri: p9 ]
        if [ im.width == 0 ]
            puts 'mars: detail source {names[i]} missing'
            return false
        imgs.push[ im ]
        sw[i] = im.width
        sh[i] = im.height
        so[i] = total
        total += im.width * im.height
    SB : new f32 [ total ]
    for [ i: i32 0, i < ns, i += 1 ]
        si : Image imgs[i]
        eu_lum[ si, @SB[ so[i] ] ]
    g0 : @f32 [ @SB[ so[0] ] ]
    g1 : @f32 [ @SB[ so[1] ] ]
    g2 : @f32 [ @SB[ so[2] ] ]
    g3 : @f32 [ @SB[ so[3] ] ]

    w9 : i32 [ 2048 ]
    h9 : i32 [ 2048 ]
    n9 : i32 [ w9 * h9 ]
    D : new f32 [ n9 ]
    puts 'mars: patching rock detail over {w9}x{h9}'
    for [ y: i32 0, y < h9, y += 1 ]
        v : f32 [ f32[ y ] / f32[ h9 ] ]
        for [ x: i32 0, x < w9, x += 1 ]
            u : f32 [ f32[ x ] / f32[ w9 ] ]
            # the selector decides which source owns each region, read
            # at its own even scale so it tiles with everything else
            s1 : f32 [ eu_bilin[ g3, sw[3], sh[3], u * 2.0 + 0.13, v * 2.0 + 0.41 ] ]
            s2 : f32 [ eu_bilin[ g3, sw[3], sh[3], v * 6.0 + 0.61, u * 6.0 + 0.07 ] ]
            acc : f32 [ 0.0 ]
            # granite is the rock grain, scratch the fracture, dunes the
            # wind ripple. each on its own even scale and axis order so
            # no two line up with each other or with the tile grid
            for [ oi: i32 0, oi < 4, oi += 1 ]
                oc : f32 [ (oi == 0) ? 1.0 : ((oi == 1) ? 3.0 : ((oi == 2) ? 9.0 : 27.0)) ]
                wt : f32 [ (oi == 0) ? 1.0 : ((oi == 1) ? 0.52 : ((oi == 2) ? 0.27 : 0.13)) ]
                pa : f32 [ eu_bilin[ g0, sw[0], sh[0], u * 4.0 * oc + 0.13, v * 4.0 * oc + 0.41 ] ]
                pb : f32 [ eu_bilin[ g1, sw[1], sh[1], v * 2.0 * oc + 0.61, u * 2.0 * oc + 0.07 ] ]
                pc : f32 [ eu_bilin[ g2, sw[2], sh[2], u * 6.0 * oc + 0.29, v * 6.0 * oc + 0.83 ] ]
                ab : f32 [ pa + (pb - pa) * eu_sstep[ 0.30, 0.70, s1 ] ]
                cc : f32 [ ab + (pc - ab) * eu_sstep[ 0.35, 0.75, s2 ] ]
                acc += (cc - 0.5) * wt
            D[ y * w9 + x ] = acc

    # the blurred twin is the local datum: where the surface sits under
    # it the ground is a crevice, and how far it strays is the grain
    T : new f32 [ n9 ]
    tmp : new f32 [ n9 ]
    for [ i: i32 0, i < n9, i += 1 ] T[ i ] = D[ i ]
    eu_blur[ T, tmp, w9, h9, 3 ]

    # the field's own spread, so B spends its 8 bits on the range the
    # material occupies rather than on outliers
    dsum : f32 [ 0.0 ]
    for [ i: i32 0, i < n9, i += 1 ] dsum += D[ i ]
    dmean : f32 [ dsum / f32[ n9 ] ]
    dvar : f32 [ 0.0 ]
    for [ i: i32 0, i < n9, i += 1 ]
        dd9 : f32 [ D[ i ] - dmean ]
        dvar += dd9 * dd9
    dsig : f32 [ sqrt[ dvar / f32[ n9 ] ] ]
    if [ dsig < 0.000001 ] dsig = 0.000001
    puts 'mars: detail height mean {dmean} sigma {dsig}'

    # scale the packed slope by the field's own gradient RMS, so the
    # 8 bits are spent on the range the material actually occupies
    acc2 : f32 [ 0.0 ]
    for [ y: i32 0, y < h9, y += 1 ]
        ym : i32 [ (y > 0) ? y - 1 : h9 - 1 ]
        yp : i32 [ (y < h9 - 1) ? y + 1 : 0 ]
        for [ x: i32 0, x < w9, x += 1 ]
            xm : i32 [ (x > 0) ? x - 1 : w9 - 1 ]
            xp : i32 [ (x < w9 - 1) ? x + 1 : 0 ]
            gx : f32 [ D[ y * w9 + xp ] - D[ y * w9 + xm ] ]
            gy : f32 [ D[ yp * w9 + x ] - D[ ym * w9 + x ] ]
            acc2 += gx * gx + gy * gy
    rms : f32 [ sqrt[ acc2 / f32[ n9 ] ] ]
    if [ rms < 0.000001 ] rms = 0.000001
    gsc : f32 [ 1.0 / (rms * 3.0) ]
    puts 'mars: detail gradient rms {rms}'

    dn : Image [ width: w9, height: h9, format: Pixel.rgba8, linear: true, wrap_u: true, wrap_v: true ]
    dd : @u8 [ dn.vdata[] ]
    for [ y: i32 0, y < h9, y += 1 ]
        ym : i32 [ (y > 0) ? y - 1 : h9 - 1 ]
        yp : i32 [ (y < h9 - 1) ? y + 1 : 0 ]
        for [ x: i32 0, x < w9, x += 1 ]
            xm : i32 [ (x > 0) ? x - 1 : w9 - 1 ]
            xp : i32 [ (x < w9 - 1) ? x + 1 : 0 ]
            gx : f32 [ (D[ y * w9 + xp ] - D[ y * w9 + xm ]) * gsc ]
            gy : f32 [ (D[ yp * w9 + x ] - D[ ym * w9 + x ]) * gsc ]
            if [ gx < -1.0 ] gx = -1.0
            if [ gx >  1.0 ] gx =  1.0
            if [ gy < -1.0 ] gy = -1.0
            if [ gy >  1.0 ] gy =  1.0
            o : i32 [ y * w9 + x ]
            # B is the detail HEIGHT, centred on 128 -- the mesh
            # displaces by it, and RG is exactly its own gradient, so
            # the shading can never disagree with the geometry
            hn : f32 [ (D[ o ] - dmean) / (dsig * 3.0) ]
            if [ hn < -1.0 ] hn = -1.0
            if [ hn >  1.0 ] hn =  1.0
            dv : f32 [ T[ o ] - D[ o ] ]
            rg : f32 [ ((dv < 0.0) ? 0.0 - dv : dv) * 9.0 ]
            if [ rg > 1.0 ] rg = 1.0
            b4 : i32 [ o * 4 ]
            dd[ b4 ]     = u8[ gx * 127.0 + 128.0 ]
            dd[ b4 + 1 ] = u8[ gy * 127.0 + 128.0 ]
            dd[ b4 + 2 ] = u8[ hn * 127.0 + 128.0 ]
            dd[ b4 + 3 ] = u8[ rg * 255.0 ]
    bd : path '../scenes/baked'
    bd.make_dir[]
    dn.png[ path '../scenes/baked/mars-dn.png' ]
    puts 'mars: rock detail written ({w9}x{h9})'
    return true

# WHERE to augment. the colour map is useless as albedo -- it has
# shadows baked in -- but it is the finest EDGE source we own: crater
# rims, scarps and canyon walls at 8192 across, structure the height
# map lost. sobel it for edge magnitude, then build an INTEGRAL IMAGE
# so the mean edge energy over any box costs four lookups instead of
# a blur per scale. three scales come out of one pass.
#
# R = edge over 4 texels (10km), G = 16 (42km), B = 64 (166km),
# A = the raw sobel. the shader scales BOTH the geometry patch and the
# normal amplitude by these: busy ground gets high frequency, dead
# flat plains stay flat
func mars_bake_edge [] -> bool
    cim : Image [ uri: path '../scenes/textures/mars-color-8192x4096.png' ]
    if [ cim.width == 0 ]
        puts 'mars: colour map missing — cannot build the edge map'
        return false
    w9 : i32 [ cim.width ]
    h9 : i32 [ cim.height ]
    n9 : i32 [ w9 * h9 ]
    puts 'mars: sobel over {w9}x{h9}'
    L : new f32 [ n9 ]
    eu_lum[ cim, L ]

    S : new f32 [ n9 ]
    for [ y: i32 0, y < h9, y += 1 ]
        ym : i32 [ (y > 0) ? y - 1 : 0 ]
        yp : i32 [ (y < h9 - 1) ? y + 1 : h9 - 1 ]
        for [ x: i32 0, x < w9, x += 1 ]
            # longitude wraps; latitude clamps at the caps
            xm : i32 [ (x > 0) ? x - 1 : w9 - 1 ]
            xp : i32 [ (x < w9 - 1) ? x + 1 : 0 ]
            a1 : f32 [ L[ ym * w9 + xm ] ]
            a2 : f32 [ L[ ym * w9 + x  ] ]
            a3 : f32 [ L[ ym * w9 + xp ] ]
            b1 : f32 [ L[ y  * w9 + xm ] ]
            b3 : f32 [ L[ y  * w9 + xp ] ]
            c1 : f32 [ L[ yp * w9 + xm ] ]
            c2 : f32 [ L[ yp * w9 + x  ] ]
            c3 : f32 [ L[ yp * w9 + xp ] ]
            gx : f32 [ (a3 + 2.0 * b3 + c3) - (a1 + 2.0 * b1 + c1) ]
            gy : f32 [ (c1 + 2.0 * c2 + c3) - (a1 + 2.0 * a2 + a3) ]
            S[ y * w9 + x ] = sqrt[ gx * gx + gy * gy ]

    # the integral image, one row of padding on each leading edge so a
    # box query never has to special-case the border. f64: an f32
    # accumulator runs out of mantissa a third of the way down 33M texels
    iw : i32 [ w9 + 1 ]
    I : new f64 [ iw * (h9 + 1) ]
    puts 'mars: integral image {iw}x{h9 + 1}'
    for [ y: i32 0, y < h9, y += 1 ]
        rs : f64 [ 0.0 ]
        for [ x: i32 0, x < w9, x += 1 ]
            rs += f64[ S[ y * w9 + x ] ]
            I[ (y + 1) * iw + (x + 1) ] = I[ y * iw + (x + 1) ] + rs

    ek : Image [ width: w9, height: h9, format: Pixel.rgba8, linear: true, wrap_u: true ]
    ed : @u8 [ ek.vdata[] ]
    r1 : i32 [ 4 ]
    r2 : i32 [ 16 ]
    r3 : i32 [ 64 ]
    # each scale normalised by its own spread, or the wide box -- which
    # averages far more texels -- comes out black next to the narrow one
    m1 : f64 [ 0.0 ]
    m2 : f64 [ 0.0 ]
    m3 : f64 [ 0.0 ]
    for [ y: i32 0, y < h9, y += 1 ]
        for [ x: i32 0, x < w9, x += 1 ]
            m1 += f64[ mars_box[ I, iw, w9, h9, x, y, r1 ] ]
            m2 += f64[ mars_box[ I, iw, w9, h9, x, y, r2 ] ]
            m3 += f64[ mars_box[ I, iw, w9, h9, x, y, r3 ] ]
    fn9 : f64 [ f64[ n9 ] ]
    a1m : f32 [ f32[ m1 / fn9 ] ]
    a2m : f32 [ f32[ m2 / fn9 ] ]
    a3m : f32 [ f32[ m3 / fn9 ] ]
    if [ a1m < 0.000001 ] a1m = 0.000001
    if [ a2m < 0.000001 ] a2m = 0.000001
    if [ a3m < 0.000001 ] a3m = 0.000001
    puts 'mars: edge means {a1m} {a2m} {a3m}'
    smx9 : f32 [ 0.0 ]
    for [ i: i32 0, i < n9, i += 1 ]
        if [ S[i] > smx9 ] smx9 = S[i]
    if [ smx9 < 0.000001 ] smx9 = 0.000001
    for [ y: i32 0, y < h9, y += 1 ]
        for [ x: i32 0, x < w9, x += 1 ]
            e1 : f32 [ mars_box[ I, iw, w9, h9, x, y, r1 ] / (a1m * 2.5) ]
            e2 : f32 [ mars_box[ I, iw, w9, h9, x, y, r2 ] / (a2m * 2.5) ]
            e3 : f32 [ mars_box[ I, iw, w9, h9, x, y, r3 ] / (a3m * 2.5) ]
            if [ e1 > 1.0 ] e1 = 1.0
            if [ e2 > 1.0 ] e2 = 1.0
            if [ e3 > 1.0 ] e3 = 1.0
            e4 : f32 [ S[ y * w9 + x ] / smx9 ]
            if [ e4 > 1.0 ] e4 = 1.0
            b4 : i32 [ (y * w9 + x) * 4 ]
            ed[ b4 ]     = u8[ e1 * 255.0 ]
            ed[ b4 + 1 ] = u8[ e2 * 255.0 ]
            ed[ b4 + 2 ] = u8[ e3 * 255.0 ]
            ed[ b4 + 3 ] = u8[ e4 * 255.0 ]
    bd : path '../scenes/baked'
    bd.make_dir[]
    ek.png[ path '../scenes/baked/mars-ek.png' ]
    puts 'mars: edge map written ({w9}x{h9})'
    return true

# mean of the sobel field over a box, from the integral image: four
# lookups, whatever the radius
func mars_box [ I: @f64, iw: i32, w9: i32, h9: i32, x: i32, y: i32, r: i32 ] -> f32
    x0 : i32 [ x - r ]
    y0 : i32 [ y - r ]
    x1 : i32 [ x + r ]
    y1 : i32 [ y + r ]
    if [ x0 < 0 ] x0 = 0
    if [ y0 < 0 ] y0 = 0
    if [ x1 > w9 - 1 ] x1 = w9 - 1
    if [ y1 > h9 - 1 ] y1 = h9 - 1
    s9 : f64 [ I[ (y1 + 1) * iw + (x1 + 1) ]
             - I[ y0 * iw + (x1 + 1) ]
             - I[ (y1 + 1) * iw + x0 ]
             + I[ y0 * iw + x0 ] ]
    cnt : f32 [ f32[ (x1 - x0 + 1) * (y1 - y0 + 1) ] ]
    return f32[ s9 ] / cnt

func mars_edge_map []
    h1 : u64 [ @mars_bake_edge ]
    h2 : u64 [ @mars_box ]
    h3 : u64 [ @eu_lum ]
    stamp : string '{h1}-{h2}-{h3}'
    sp : path '../scenes/baked/mars-ek.hash'
    ekp : path '../scenes/baked/mars-ek.png'
    if [ sp.exists[] && ekp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            puts 'mars: edge map current ({stamp})'
            return
    if [ mars_bake_edge[] ] sp.save[ stamp, null ]

export func mars_maps []
    # EVERY function the output depends on, not just the two big ones.
    # a stamp over the bake alone stayed identical when a constant
    # moved, so the build reported the maps current and shipped stale
    # ones -- which is how a misaligned map survived three rebuilds
    h1 : u64 [ @mola_load ]
    h2 : u64 [ @mola_at ]
    h3 : u64 [ @mars_bake_mola ]
    h4 : u64 [ @mars_radius ]
    h5 : u64 [ @mars_hmin ]
    h6 : u64 [ @mars_hmax ]
    h7 : u64 [ @mars_smax ]
    h8 : u64 [ @mars_exag ]
    h9 : u64 [ @mars_vu0 ]
    ha : u64 [ @mars_vu1 ]
    hb : u64 [ @mars_vv0 ]
    hc : u64 [ @mars_vv1 ]
    stamp : string '{h1}-{h2}-{h3}-{h4}-{h5}-{h6}-{h7}-{h8}-{h9}-{ha}-{hb}-{hc}'
    sp : path '../scenes/baked/mars.hash'
    pkp : path '../scenes/baked/mars-pk.png'
    nkp : path '../scenes/baked/mars-nk.png'
    if [ sp.exists[] && pkp.exists[] && nkp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            puts 'mars: baked maps current ({stamp})'
            mars_detail_map[]
            mars_edge_map[]
            return
    # stamp ONLY on success: saving it after a failed bake caches the
    # failure forever, and the next build reports everything current
    if [ mars_bake_mola[] ] sp.save[ stamp, null ]
    mars_detail_map[]
    mars_edge_map[]

# the rock material shares NO input with the MOLA bake, so it carries
# its own stamp: touching one must not re-read 2GB of tiles for the other
func mars_detail_map []
    h1 : u64 [ @mars_bake_detail ]
    h2 : u64 [ @eu_bilin ]
    h3 : u64 [ @eu_blur ]
    h4 : u64 [ @eu_sstep ]
    h5 : u64 [ @eu_lum ]
    stamp : string '{h1}-{h2}-{h3}-{h4}-{h5}'
    sp : path '../scenes/baked/mars-dn.hash'
    dnp : path '../scenes/baked/mars-dn.png'
    if [ sp.exists[] && dnp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            puts 'mars: rock detail current ({stamp})'
            return
    if [ mars_bake_detail[] ] sp.save[ stamp, null ]

# no colour map: it has shadows baked into it and fights every light
enum OlympusSurface
    height  : 0
    nrm     : 1
    detail  : 2
    edge    : 3
    color   : 4
    veg_a   : 5
    veg_b   : 6
    veg_c   : 7

ModelViewProject OlympusShader
    # unpack scale for the baked height, and the slope range the baked
    # normal encodes. both must match what mars_bake wrote
    mutable hmax     : f32
    mutable smax     : f32
    mutable sun_dir  : vec4f
    mutable cam_pos  : vec4f
    mutable haze     : f32
    # how many times the rock material repeats across the equator, and
    # how far it tilts the normal
    mutable dtile    : f32
    mutable damp     : f32
    # the craft in MODEL space, and the horizon arc in radians: the
    # carpet mesh is laid out relative to both
    mutable eye_m    : vec4f
    mutable hdist    : f32
    # how far the rock material displaces the mesh, in sphere radii
    mutable dh       : f32

    attrib height  : LayoutBinding [ type:typeid[ OlympusSurface ], id:OlympusSurface.height, count:1, format: typeid[ rgba8 ] ]
    attrib nrm     : LayoutBinding [ type:typeid[ OlympusSurface ], id:OlympusSurface.nrm,    count:1, format: typeid[ rgba8 ] ]
    attrib detail  : LayoutBinding [ type:typeid[ OlympusSurface ], id:OlympusSurface.detail, count:1, format: typeid[ rgba8 ] ]
    attrib edge    : LayoutBinding [ type:typeid[ OlympusSurface ], id:OlympusSurface.edge,   count:1, format: typeid[ rgba8 ] ]
    attrib color   : LayoutBinding [ type:typeid[ OlympusSurface ], id:OlympusSurface.color,  count:1, format: typeid[ rgba8 ] ]
    attrib veg_a   : LayoutBinding [ type:typeid[ OlympusSurface ], id:OlympusSurface.veg_a,  count:1, format: typeid[ rgba8 ] ]
    attrib veg_b   : LayoutBinding [ type:typeid[ OlympusSurface ], id:OlympusSurface.veg_b,  count:1, format: typeid[ rgba8 ] ]
    attrib veg_c   : LayoutBinding [ type:typeid[ OlympusSurface ], id:OlympusSurface.veg_c,  count:1, format: typeid[ rgba8 ] ]

    attrib a_pos        : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal     : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv         : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_normal     : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_uv         : VertexOutput  [ type:typeid[ vec2f ] ]
    attrib v_sp         : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_world_pos  : VertexOutput  [ type:typeid[ vec4f ] ]
    attrib v_h          : VertexOutput  [ type:typeid[ f32   ] ]

    attrib fragColor    : FragmentOutput[ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    # the bake, unpacked. 16 bits across R and A, scaled by hmax.
    # the hardware interpolates those two bytes INDEPENDENTLY, so
    # everywhere the low byte wraps 255->0 it ramps backwards across a
    # whole texel and the ground ripples like water. decode four
    # texels FIRST, then interpolate. the coarse mesh averaged this
    # away; a metre-scale mesh resolves every one of them
    func o_ground [ uv: vec2f ] -> GLSL float {
        vec2  ts = vec2(8192.0, 4096.0);
        vec2  pp = uv * ts - 0.5;
        vec2  fr = fract(pp);
        vec2  b0 = (floor(pp) + 0.5) / ts;
        vec2  e1 = 1.0 / ts;
        vec4  q00 = textureLod(height, b0, 0.0);
        vec4  q10 = textureLod(height, b0 + vec2(e1.x, 0.0), 0.0);
        vec4  q01 = textureLod(height, b0 + vec2(0.0, e1.y), 0.0);
        vec4  q11 = textureLod(height, b0 + e1, 0.0);
        float h00 = q00.r * 65280.0 + q00.a * 255.0;
        float h10 = q10.r * 65280.0 + q10.a * 255.0;
        float h01 = q01.r * 65280.0 + q01.a * 255.0;
        float h11 = q11.r * 65280.0 + q11.a * 255.0;
        float hh  = mix(mix(h00, h10, fr.x), mix(h01, h11, fr.x), fr.y);
        return hh / 65535.0 * ubo.hmax;
    }



    func vertex [] -> GLSL none {
        // the mesh arrives as a FLAT polar grid centred on the craft,
        // its radius a fraction of the horizon arc. wrap it onto the
        // sphere here, so altitude rescales it and nothing rebuilds
        float rn = length(a_pos.xz);
        vec2  pd = rn > 0.0 ? a_pos.xz / rn : vec2(1.0, 0.0);
        vec3  up_m = normalize(ubo.eye_m.xyz);
        vec3  ax9  = abs(up_m.y) > 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3  t_e  = normalize(cross(ax9, up_m));
        vec3  t_n  = cross(up_m, t_e);
        float s9   = rn * ubo.hdist;
        vec3  dir  = normalize(up_m * cos(s9) + (t_e * pd.x + t_n * pd.y) * sin(s9));

        // longitude measured FROM the craft, never absolute: that is
        // what keeps the +/-pi meridian from splitting a triangle.
        // u runs 0.5-based to match the height map's 0.0635 offset
        float lon0 = atan(ubo.eye_m.z, ubo.eye_m.x);
        float dl   = atan(dir.z, dir.x) - lon0;
        if (dl >  3.14159265) dl -= 6.28318531;
        if (dl < -3.14159265) dl += 6.28318531;
        vec2 uv = vec2(0.5 + (lon0 + dl) / 6.28318531,
                       0.5 - asin(clamp(dir.y, -1.0, 1.0)) / 3.14159265);

        v_uv     = uv;
        v_sp     = dir;
        mat3 nm  = transpose(inverse(mat3(ubo.model)));
        v_normal = normalize(nm * dir);
        float g  = o_ground(uv);
        v_h      = g;

        // patch geometry WHERE THE EDGES ARE. the integral image says
        // how much structure the colour map holds around this point;
        // busy ground earns high frequency, dead flat plains stay flat
        vec4  ee = textureLod(edge, uv, 0.0);
        float aug = clamp(ee.r * 0.55 + ee.g * 0.30 + ee.b * 0.15, 0.0, 1.0);
        // the same height-difference gate the shading uses, so the
        // geometry gets patched exactly where the ground moves and a
        // flat plain stays a flat plain
        vec2  vsl  = (textureLod(nrm, uv, 0.0).rg * 2.0 - 1.0) * ubo.smax;
        float vrug = clamp(length(vsl) / 0.12, 0.0, 1.0);
        float vclat = sqrt(max(1.0 - dir.y * dir.y, 0.0025));
        vec2  duv   = vec2(uv.x * vclat * 2.0, uv.y);
        float dsum = 0.0;
        float dw   = 0.0;
        float dfq  = ubo.dtile / 256.0;
        float dwt  = 1.0;
        for (int i = 0; i < 3; i++) {{
            float an = 0.61 * float(i);
            float ca = cos(an);
            float sa = sin(an);
            vec2  ru = mat2(ca, sa, -sa, ca) * duv * dfq + vec2(0.37, 0.71) * float(i);
            dsum += (textureLod(detail, ru, 0.0).b * 2.0 - 1.0) * dwt;
            dw   += dwt;
            dfq  *= 3.0;
            dwt  *= 0.78;
        }}
        vec3 disp = dir * (1.0 + g + dsum / dw * ubo.dh
                                   * (0.10 + 1.90 * vrug) * (0.55 + 0.45 * aug));
        vec4 wpos = ubo.model * vec4(disp, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment [] -> GLSL none {
        vec3 sp = normalize(v_sp);
        // the mesh normal is the ball's and would light this flat. the
        // bake carries the real surface slope at 8192 across, far finer
        // than any mesh we can afford to displace
        vec3 ax = abs(sp.y) > 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3 ea = normalize(cross(ax, sp));
        vec3 no = normalize(cross(sp, ea));
        vec2 sl = (texture(nrm, v_uv).rg * 2.0 - 1.0) * ubo.smax;
        // slope is rise over run along each axis: tilt the sphere normal
        // by it rather than treating the map as a tangent-space normal
        vec3 n = normalize(sp - ea * sl.x - no * sl.y);

        // MOLA is 2600m a texel, so from 13km up the ground is pure
        // bilinear mush. the rock material fills the whole span below
        // that -- SIX octaves from 1300m a texel down to 5m -- so
        // relief exists at every scale between the map and the eye.
        // SHADING ONLY: the silhouette stays MOLA's
        float dist = length(v_world_pos.xyz - ubo.cam_pos.xyz);
        // same aspect correction the vertex used, or the shading grain
        // walks off the geometry it is meant to describe
        float clat = sqrt(max(1.0 - sp.y * sp.y, 0.0025));
        vec2  duv  = vec2(v_uv.x * clat * 2.0, v_uv.y);
        vec2  dxy  = vec2(0.0);
        float cav  = 0.0;
        float rgh  = 0.0;
        float wsum = 0.0;
        // start at 1/256 of the tiling rate, which is where MOLA stops
        float fq = ubo.dtile / 256.0;
        float wt = 1.0;
        // NO per-pixel downslope rotation here. sl comes from an 8-BIT
        // map, so its direction quantises, and duv is already scaled by
        // ~2000 -- one 8-bit step of angle throws the sample eight
        // whole tiles sideways between neighbouring pixels. that is
        // what came out as hard rectangular blocks
        for (int i = 0; i < 6; i++) {{
            // each octave on its own angle and origin, or the ladder
            // stacks into one self-similar pattern instead of terrain
            float an = 0.61 * float(i);
            float ca = cos(an);
            float sa = sin(an);
            vec2  ru = mat2(ca, sa, -sa, ca) * duv * fq + vec2(0.37, 0.71) * float(i);
            vec4  dv = texture(detail, ru);
            dxy  += (dv.rg * 2.0 - 1.0) * wt;
            // B is the material's height: below its own mean is a
            // crevice, above it is a crest catching the light
            cav  += (dv.b * 2.0 - 1.0) * wt;
            rgh  += dv.a * wt;
            wsum += wt;
            // three per step spans 1300m to 5m in six reads. no
            // distance crossfade: the mip chain already retires an
            // octave the moment its texel drops under the pixel, and
            // fading them in bands is what left ONE octave live at a
            // time -- which is why it read as bare grain
            fq *= 3.0;
            wt *= 0.78;
        }}
        dxy /= wsum;
        cav /= wsum;
        rgh /= wsum;
        // amplitude rides REAL HEIGHT DIFFERENCE. sl is the surface's
        // own rise over run, so it IS the height change per metre --
        // where the ground actually moves, the material goes hard, and
        // a dead flat plain keeps almost nothing. 0.12 instead of 0.35
        // brings ordinary martian slopes into range: at 0.35 nearly
        // everything read as flat and the detail sat at its floor
        vec4  ee9 = texture(edge, v_uv);
        float aug = clamp(ee9.r * 0.55 + ee9.g * 0.30 + ee9.b * 0.15, 0.0, 1.0);
        float rug = clamp(length(sl) / 0.12, 0.0, 1.0);
        // a TWENTYFOLD span: a tenth on dead flat ground, double where
        // the surface actually moves. the edge map only trims it
        n = normalize(n + (ea * dxy.x + no * dxy.y)
                        * ubo.damp * (0.10 + 1.90 * rug) * (0.55 + 0.45 * aug));

        mat3 nmm = transpose(inverse(mat3(ubo.model)));
        vec3 nw = normalize(nmm * n);

        vec3 sun = normalize(ubo.sun_dir.xyz);
        float ndl = max(dot(nw, sun), 0.0);
        // TERRAFORMED. the mars map is the ground underneath -- its
        // baked shadows matter far less once vegetation covers it --
        // and the planting mixes on top
        vec3  c_rock = vec3(0.26, 0.16, 0.11);
        vec3  c_dust = vec3(0.64, 0.43, 0.28);
        float crest = clamp(cav * 0.5 + 0.5, 0.0, 1.0);
        float flat9 = 1.0 - clamp(length(sl) / 0.30, 0.0, 1.0);
        vec3  bare  = texture(color, v_uv).rgb;
        bare = mix(bare, mix(c_rock, c_dust, flat9 * (0.35 + 0.65 * crest)), 0.45);
        bare *= 0.78 + 0.44 * crest;
        bare = mix(bare, vec3(dot(bare, vec3(0.35, 0.48, 0.17))), rgh * 0.25);

        // WHERE it grows. deep ground holds water and air, slope sheds
        // both -- so altitude and steepness decide, and a perlin brush
        // wanders the boundary so it never reads as a contour line.
        // v_h is the packed ground height: low is a basin floor
        float lowl = 1.0 - smoothstep(0.10, 0.62, v_h / max(ubo.hmax, 1e-6));
        float hold = flat9 * flat9;
        // the brush is the detail tile read very slowly -- it is
        // already a multi-octave patched field, so it wanders the way
        // perlin would with no second noise to carry. e_gnoise lives
        // on the enceladus shader and is not in scope here.
        // TWO independent fields: one decides where cover reaches, the
        // other which patch scale owns the ground. sharing one would
        // lock the planting boundary to the texture change
        float brush  = texture(detail, duv * ubo.dtile * 0.0045 + vec2(0.19, 0.63)).b * 0.60
                     + texture(detail, duv * ubo.dtile * 0.0180 + vec2(0.71, 0.29)).b * 0.40;
        float b_fine = texture(detail, duv * ubo.dtile * 0.0091 + vec2(0.47, 0.11)).b * 0.55
                     + texture(detail, duv * ubo.dtile * 0.0330 + vec2(0.23, 0.87)).b * 0.45;
        // the plateau is planted too, just not forested, so the low
        // ground only leans the odds -- it does not gate cover off
        float cover = clamp((0.45 + 0.55 * lowl) * hold * (0.40 + 1.20 * brush)
                            - 0.15, 0.0, 1.0);
        cover *= 1.0 - aug * 0.45;

        // THREE tiers by distance. sand is the far base, grass the
        // middle, canopy only near -- each one's own tiling rate, and
        // crossfaded so no tier pops as the craft closes
        vec2  vuv = duv * ubo.dtile;
        float t_c = 1.0 - smoothstep(0.010, 0.055, dist);
        float t_b = (1.0 - smoothstep(0.045, 0.180, dist)) * (1.0 - t_c * 0.55);

        // STOCHASTIC PATCHING. one tap at one rate repeats on a grid,
        // which is what you were looking at. three taps at scales that
        // share no common multiple, with the brush choosing which one
        // OWNS each patch, pushes the repeat period out past the
        // horizon. the brush drives the WEIGHTS, never the coordinate:
        // a scale that varies per pixel multiplies its own gradient by
        // uv -- about 3000 here -- and aliases, the same way the
        // downslope rotation did
        float k1 = smoothstep(0.28, 0.72, brush);
        float k2 = smoothstep(0.34, 0.78, b_fine);
        vec3  gA = texture(veg_b, vuv * 0.180 + vec2(0.13, 0.41)).rgb;
        vec3  gB = texture(veg_b, vuv * 0.4884 + vec2(0.61, 0.07)).rgb;
        vec3  gC = texture(veg_b, vuv * 1.3171 + vec2(0.29, 0.83)).rgb;
        vec3  v_gras = mix(mix(gA, gB, k1), gC, k2 * 0.65);
        vec3  cA = texture(veg_c, vuv * 0.640 + vec2(0.37, 0.71)).rgb;
        vec3  cB = texture(veg_c, vuv * 1.7363 + vec2(0.07, 0.53)).rgb;
        vec3  cC = texture(veg_c, vuv * 4.6823 + vec2(0.83, 0.19)).rgb;
        vec3  v_tree = mix(mix(cA, cB, k2), cC, k1 * 0.60);
        vec3  v_sand = texture(veg_a, vuv * 0.035).rgb;
        // sand is 0.849 coherent at -57 degrees: its dune ripples would
        // print one diagonal over the whole planet. take its LEVEL only
        // and carry the hue ourselves, so no direction can survive
        vec3  c_base = vec3(0.42, 0.50, 0.30) * (0.55 + 0.90 * dot(v_sand, vec3(0.33)));
        vec3  veg = c_base;
        veg = mix(veg, v_gras, t_b);
        veg = mix(veg, v_tree, t_c * smoothstep(0.25, 0.75, cover));
        vec3  base = mix(bare, veg, cover);

        // a grazing sun throws long shadow: the terminator on a slope is
        // hard, so keep the ambient low or the shadows turn to grey mud
        // gain under 1: the map is already a bright albedo, and pushing
        // it past full white flattens every ridge into paper
        vec3 lit = base * (0.16 + ndl * 1.25);
        // dust forward-scatters hard toward a low sun, which is the
        // orange wash that fills the canyons in the reference
        vec3 vd = normalize(v_world_pos.xyz - ubo.cam_pos.xyz);
        float fw = max(dot(vd, sun), 0.0);
        float fs = pow(fw, 6.0);
        // haze builds with distance, and much faster looking into the sun
        float hz = 1.0 - exp(-dist * ubo.haze * (1.0 + fs * 5.0));
        vec3 dust = mix(vec3(0.44, 0.26, 0.16), vec3(1.30, 0.86, 0.56), fs);
        vec3 outc = mix(lit, dust, clamp(hz, 0.0, 1.0));
        fragColor = vec4(outc, 1.0);
    }


element Olympus
    frost : true
    frost_sharp : true
    intern olymp  : OlympusShader
    intern models : array Model
    intern target : Render
    intern built  : bool
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    intern e_cur  : f32
    intern dbg_n  : i32
    public color  : rgba [ r:0.004, g:0.003, b:0.004, a:1.0 ]

    # a UNIFORM globe spends its triangles where nobody is looking. at
    # 3072x1536 that was 9.4M triangles, 252MB, and STILL only 6.93km a
    # quad -- fifteen times coarser than the MOLA data underneath it,
    # so nothing under 7km could ever reach the silhouette.
    #
    # from altitude h the entire visible planet is the spherical cap out
    # to the horizon arc, and nothing past it shows except peaks tall
    # enough to clear the bulge. so a polar grid CENTRED ON THE CRAFT
    # covers everything the globe did, with the rings packed under the
    # camera: 573k triangles, 16MB, and about a metre a quad up close.
    #
    # ring radius is stored as a FRACTION of the horizon arc, so the
    # vertex shader scales it by altitude and the mesh never rebuilds
    func carpet_steps [] -> i32
        return 1024
    # rings grow by this fraction near the craft...
    func carpet_grow [] -> f32
        return 0.0296
    # ...but a step NEVER exceeds this, which is a quarter of the
    # height map's 2600m texel. past a texel the mesh undersamples the
    # map, and a map sliding under an undersampled mesh is the ripple
    func carpet_cap [] -> f32
        return 0.00215
    # the innermost ring, and how far past the horizon the outer one
    # reaches -- 1.35 catches peaks standing above it
    func carpet_rmin [] -> f32
        return 0.0004
    func carpet_rmax [] -> f32
        return 1.35

    func build_carpet [] -> GltfModel
        na : i32 [ carpet_steps[] ]
        n1 : i32 [ na + 1 ]
        # ring radii first: geometric while the steps are small, then
        # CAPPED so no step ever outruns a height-map texel
        rmn9 : f32 [ carpet_rmin[] ]
        rmx9 : f32 [ carpet_rmax[] ]
        cap9 : f32 [ carpet_cap[] ]
        gro9 : f32 [ carpet_grow[] ]
        RR : new f32 [ 4096 ]
        RR[ 0 ] = 0.0
        kk : i32 [ 1 ]
        rc : f32 [ rmn9 ]
        while [ rc < rmx9 && kk < 4095 ]
            RR[ kk ] = rc
            kk += 1
            st9 : f32 [ rc * gro9 ]
            if [ st9 > cap9 ] st9 = cap9
            rc = rc + st9
        RR[ kk ] = rmx9
        kk += 1
        m1 : i32 [ kk ]
        nr : i32 [ kk - 1 ]
        puts 'CARPET rings={nr} steps={na} tris={nr * na * 2}'
        nv : i32 [ n1 * m1 ]
        nv3 : i32 [ nv * 3 ]
        nv2 : i32 [ nv * 2 ]
        ni : i32 [ na * nr * 6 ]
        vb : i32 [ nv3 * 4 ]
        tb : i32 [ nv2 * 4 ]
        ib : i32 [ ni * 4 ]
        tsz : i32 [ vb + vb + tb + ib ]
        data : new u8 [ tsz ]
        pf : @f32 [ data ]
        ip : @data[ vb + vb + tb ]
        iu : @u32 [ ip ]
        for [ ir: i32 0, ir <= nr, ir += 1 ]
            # ring 0 collapses to the point under the craft; its quads
            # are degenerate and cost nothing
            rn : f32 [ RR[ ir ] ]
            for [ ia: i32 0, ia <= na, ia += 1 ]
                th : f32 [ f32[ ia ] * 6.2831853 / f32[ na ] ]
                vi : i32 [ ir * n1 + ia ]
                i3 : i32 [ vi * 3 ]
                # the plane offset from the craft, in horizon fractions.
                # the shader wraps it onto the sphere
                pf[ i3 ]     = rn * cos[ th ]
                pf[ i3 + 1 ] = 0.0
                pf[ i3 + 2 ] = rn * sin[ th ]
                pf[ nv3 + i3 ]     = 0.0
                pf[ nv3 + i3 + 1 ] = 1.0
                pf[ nv3 + i3 + 2 ] = 0.0
                # uv comes from the wrapped direction, per vertex, in
                # the shader -- there is none to store here
                i2 : i32 [ nv3 * 2 + vi * 2 ]
                pf[ i2 ]     = 0.0
                pf[ i2 + 1 ] = 0.0
        k : i32 [ 0 ]
        # SAME order as the globe's. the opposite order renders only a
        # strip just past the tangent point -- the back of the bulge,
        # seen because everything nearer was facing away and culled
        for [ ir: i32 0, ir < nr, ir += 1 ]
            for [ ia: i32 0, ia < na, ia += 1 ]
                i0 : i32 [ ir * n1 + ia ]
                iu[ k ]     = u32[ i0 ]
                iu[ k + 1 ] = u32[ i0 + n1 ]
                iu[ k + 2 ] = u32[ i0 + 1 ]
                iu[ k + 3 ] = u32[ i0 + 1 ]
                iu[ k + 4 ] = u32[ i0 + n1 ]
                iu[ k + 5 ] = u32[ i0 + n1 + 1 ]
                k += 6
        bufs : array GltfBuffer [ ]
        bufs += GltfBuffer [ byteLength: u64[ tsz ], data: data ]
        views : array BufferView [ ]
        views += BufferView [ buffer: 0, byteOffset: 0,            byteLength: vb ]
        views += BufferView [ buffer: 0, byteOffset: vb,           byteLength: vb ]
        views += BufferView [ buffer: 0, byteOffset: vb + vb,      byteLength: tb ]
        views += BufferView [ buffer: 0, byteOffset: vb + vb + tb, byteLength: ib ]
        accs : array Accessor [ ]
        accs += Accessor [ bufferView: 0, componentType: ComponentType.FLOAT, type: CompoundType.VEC3, count: nv ]
        accs += Accessor [ bufferView: 1, componentType: ComponentType.FLOAT, type: CompoundType.VEC3, count: nv ]
        accs += Accessor [ bufferView: 2, componentType: ComponentType.FLOAT, type: CompoundType.VEC2, count: nv ]
        accs += Accessor [ bufferView: 3, componentType: ComponentType.UNSIGNED_INT, type: CompoundType.SCALAR, count: ni ]
        am : map i64 [ string ] [ ]
        am[ 'POSITION' ]   = i64[ 0 ]
        am[ 'NORMAL' ]     = i64[ 1 ]
        am[ 'TEXCOORD_0' ] = i64[ 2 ]
        prs : array Primitive [ ]
        prs += Primitive [ name: 'olympus', attributes: am, indices: u64[ 3 ], material: 0, mode: Mode.TRIANGLES ]
        mshs : array Mesh [ ]
        mshs += Mesh [ name: 'olympus', primitives: prs ]
        nds : array Node [ ]
        nds += Node [ name: 'olympus', mesh: 0 ]
        sn : array i64 [ ]
        sn += 0
        scns : array Scene [ ]
        scns += Scene [ name: 'scene', nodes: sn ]
        gm : GltfModel [ nodes: nds, meshes: mshs, scenes: scns, scene: 0,
            buffers: bufs, bufferViews: views, accessors: accs ]
        return gm

    func build_models[]
        built = true
        puts 'OLY build_models: start'
        o_gltf : build_carpet[]
        o_gltf.hold[]
        o_gltf.compute_worlds[]
        puts 'OLY build_models: sphere built'
        olymp = OlympusShader [ vk: vk ]
        pkp : path '../scenes/baked/mars-pk.png'
        nkp : path '../scenes/baked/mars-nk.png'
        dnp : path '../scenes/baked/mars-dn.png'
        ekp : path '../scenes/baked/mars-ek.png'
        if [ !pkp.exists[] || !nkp.exists[] ]
            puts 'mars: no baked maps — baking live (SILVER_EXPORT=1 bakes at build)'
            mars_bake_mola[]
        if [ !dnp.exists[] ]
            puts 'mars: no rock detail — baking live'
            mars_bake_detail[]
        if [ !ekp.exists[] ]
            puts 'mars: no edge map — baking live'
            mars_bake_edge[]
        # data maps MUST be linear or the sampler re-linearizes them and
        # the whole surface drops below its real height
        o_samplers : map Image [string] [
            'height': Image [ uri: pkp, surface: OlympusSurface.height, linear: true, wrap_u: true ],
            'nrm':    Image [ uri: nkp, surface: OlympusSurface.nrm,    linear: true, wrap_u: true ],
            'detail': Image [ uri: dnp, surface: OlympusSurface.detail, linear: true, wrap_u: true, wrap_v: true ],
            'edge':   Image [ uri: ekp, surface: OlympusSurface.edge,   linear: true, wrap_u: true ],
            'color':  Image [ uri: path '../scenes/textures/mars-color-8192x4096.jpg', surface: OlympusSurface.color, linear: true, wrap_u: true ],
            'veg_a':  Image [ uri: path '../scenes/textures/mars-veg-sand.png',   surface: OlympusSurface.veg_a, linear: true, wrap_u: true, wrap_v: true ],
            'veg_b':  Image [ uri: path '../scenes/textures/mars-veg-grass.png',  surface: OlympusSurface.veg_b, linear: true, wrap_u: true, wrap_v: true ],
            'veg_c':  Image [ uri: path '../scenes/textures/mars-veg-forest.png', surface: OlympusSurface.veg_c, linear: true, wrap_u: true, wrap_v: true ]
        ]
        puts 'OLY build_models: maps loaded'
        o_model : Model [ vk: vk, w: ux, id: o_gltf, s: olymp, samplers: o_samplers, straight_alpha: true ]
        models  = array Model [ o_model ]
        puts 'OLY build_models: done, {models.count} model(s)'

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      (ux.frost_eff[] == 3) ? 2.0 : 1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.hold[]
        target.owner  = a
        ux.element_targets[ id ] = target

    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    func load_bg [ arg: object ]
        build_models[]
        ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : array []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: @load_bg, work: w9 ]
        if [ !ready ] return
        create_target[]
        orbit[]

    func orbit[]
        aspect : f32 [ (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]
        # ORBIT DISTANCE from the centre, not eye height. this was left
        # over from the ground-stage version and put the camera 0.0035
        # from the origin -- inside the planet, looking at its core,
        # with the whole surface backface-culled around it
        # ALTITUDE above the datum, not orbit distance: this is a craft
        # over the deck. 0.004 is 13km, 0.05 is 170km
        # the two lowest rungs are gone. 13km and 51km sat so far under
        # the deck that Valles ran off both edges; this starts where the
        # old ladder ENDED and climbs. 0.130 is the rung that holds the
        # whole 3280km trunk inside the horizon at once
        e_t : f32 [ (ux.orbit_mode == OrbitView.low)  ? 0.050 :
                    (ux.orbit_mode == OrbitView.high) ? 0.130 :
                    (ux.orbit_mode == OrbitView.far)  ? 0.340 : 0.800 ]
        if [ e_cur == 0.0 ] e_cur = e_t
        e_cur = filter_n[ e_cur, e_t, 0.06, ux.frame_factor ]

        # the spin has to come FIRST now: the craft's latitude is a
        # function of how far along the canyon it has flown
        # 184.39 puts the craft at the trunk's western end; 900 per
        # kilosecond is the drift east along it
        spin_d : f32 [ 184.39 + ux.time * 900.0 ]

        # the craft rides over Valles Marineris' own latitude while the
        # planet turns under it -- that IS the flight, no path needed
        # MEASURED off mars-pk by weighted fit of the trunk's own axis:
        #   lat = -0.03489 * lon - 12.388
        # so Ius-Melas-Coprates runs 2.03 degrees SOUTH OF DUE EAST. a
        # constant latitude is a parallel, and a parallel cannot stay
        # in a canyon that trends -- it enters at one rim and leaves by
        # the other, which is the angle you were looking at. drifting
        # the craft south as it runs east puts the track ON the axis.
        # the 25.2 tilt means model latitude is not world latitude, so
        # the drift is stated in world terms: -0.0387 per degree of spin
        vlat : f32 [ radians[ -10.718 - 0.0387 * (spin_d - 184.39) ] ]
        cx : f32 [ 0.0 ]
        cy : f32 [ sin[ vlat ] ]
        cz : f32 [ cos[ vlat ] ]
        e_r : f32 [ 1.0 + e_cur ]
        _eye : vec3f [ cx * e_r, cy * e_r, cz * e_r ]

        # the ground flows past in the direction Y cross up, because the
        # model spins about Y. look that way, not at the planet centre --
        # aiming at the centre is nadir by definition, which is the
        # straight-down view you were getting
        # Y x c is the direction the GROUND flows. the craft travels the
        # other way, so forward is the negative of it -- aiming along
        # the flow puts you on the stern watching the wake
        gx : f32 [ 0.0 - cz ]
        gy : f32 [ 0.0 ]
        gz : f32 [ cx ]
        gl : f32 [ sqrt[ gx * gx + gz * gz ] ]
        if [ gl > 0.0 ]
            gx = gx / gl
            gz = gz / gl

        # yaw 15 degrees to starboard, about the SCREEN up (-c, the same
        # inversion look_at gets), so right here means right on screen.
        # g is horizontal and c is radial, so their cross is already unit
        yaw : f32 [ radians[ 25.0 ] ]
        yc : f32 [ cos[ yaw ] ]
        ys : f32 [ sin[ yaw ] ]
        rx : f32 [ 0.0 - (gy * cz - gz * cy) ]
        ry : f32 [ 0.0 - (gz * cx - gx * cz) ]
        rz : f32 [ 0.0 - (gx * cy - gy * cx) ]
        gx2 : f32 [ gx * yc + rx * ys ]
        gy2 : f32 [ gy * yc + ry * ys ]
        gz2 : f32 [ gz * yc + rz * ys ]
        gx = gx2
        gy = gy2
        gz = gz2

        # the horizon sits BELOW local horizontal by the dip angle, and
        # from this low that is only a few degrees. six degrees past it
        # drops the limb into the upper third, like the reference
        dip : f32 [ acos[ 1.0 / e_r ] ]
        pit : f32 [ dip + radians[ 6.0 ] ]
        pc : f32 [ cos[ pit ] ]
        ps : f32 [ sin[ pit ] ]
        dx : f32 [ gx * pc - cx * ps ]
        dy : f32 [ gy * pc - cy * ps ]
        dz : f32 [ gz * pc - cz * ps ]
        _tgt : vec3f [ _eye.x + dx, _eye.y + dy, _eye.z + dz ]
        # screen up is the negated local up, same inversion the globe
        # scenes make with world +y
        _up : vec3f [ 0.0 - cx, 0.0 - cy, 0.0 - cz ]
        # near must be tight: at 13km altitude a 0.002 near plane clips
        # the ground out from under the craft
        _proj : mat4f.perspective[ radians[ 55.0 ], aspect, 0.00005, 24.0 ]
        _view : mat4f.look_at[ _eye, _tgt, _up ]

        # 160 degrees puts Valles Marineris (290E) square in front at
        # t=0; the tilt is about Z, which leaves that facing alone.
        # ux.time counts kiloseconds, so 900 drifts east slowly enough
        # to read the canyon rather than smear past it
        q_spin : quatf [ vec4f [ 0.0, 1.0, 0.0, radians[ spin_d ] ] ]
        q_axis : quatf [ vec4f [ 0.0, 0.0, 1.0, radians[ 25.2 ] ] ]
        mm : mat4f.identity[]
        mm = mm.rotate[ q_axis ]
        mm = mm.rotate[ q_spin ]

        olymp.model = mm
        olymp.view  = _view
        olymp.proj  = _proj
        # must match what mars_bake packed, or the terrain reads at the
        # wrong height and the shading disagrees with the silhouette
        olymp.hmax     = mars_hmax[] * mars_relief[]
        olymp.smax     = mars_smax[] * mars_relief[]
        olymp.haze     = 0.04
        olymp.dtile    = mars_dtile[]
        olymp.damp     = mars_damp[]
        olymp.dh       = mars_dh[]
        # the carpet is laid out around the craft, so the shader needs
        # the eye in MODEL space -- the planet turns, the craft does not
        mi : mat4f [ mm.inverse[] ]
        # by hand, NOT mi.mul_v4: a C function returning a 16-byte
        # all-float struct comes back in two registers, and the call
        # reads one float from each -- x and z arrive, y and w never
        # get written. see the note in orbit's header
        emx : f32 [ mi.m[0] * _eye.x + mi.m[4] * _eye.y + mi.m[8]  * _eye.z + mi.m[12] ]
        emy : f32 [ mi.m[1] * _eye.x + mi.m[5] * _eye.y + mi.m[9]  * _eye.z + mi.m[13] ]
        emz : f32 [ mi.m[2] * _eye.x + mi.m[6] * _eye.y + mi.m[10] * _eye.z + mi.m[14] ]
        em : vec4f [ emx, emy, emz, 1.0 ]
        olymp.eye_m = em
        # the arc from under the craft to the horizon: everything
        # visible lies inside it, which is why the cap is enough
        olymp.hdist = acos[ 1.0 / e_r ]
        olymp.cam_pos  = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        # the sun sits low, dead ahead, and stays there as the craft
        # flies: that is what backlights the dust and rakes every wall
        # 4 degrees put almost every facet in its own shadow -- the
        # relief was there and unreadable. 15 still rakes hard enough
        # to throw the canyon walls but actually lights the ground
        sel : f32 [ radians[ 15.0 ] ]
        sc : f32 [ cos[ sel ] ]
        ss : f32 [ sin[ sel ] ]
        olymp.sun_dir = vec4f [ gx * sc + cx * ss, gy * sc + cy * ss, gz * sc + cz * ss, 0.0 ]
        dbg_n += 1
        if [ dbg_n < 3 ]
            puts 'OLY mode={i32[ ux.orbit_mode ]} e_cur={e_cur} hmax={olymp.hmax} smax={olymp.smax}'
            puts 'OLY eye={_eye.x},{_eye.y},{_eye.z} eye_m={em.x},{em.y},{em.z},{em.w} hdist={olymp.hdist} e_r={e_r}'