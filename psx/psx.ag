# psx: a PlayStation. The CPU, its devices, and the GPU drawing
# through trinity alone; OpenBIOS (PCSX-Redux, MIT) boots it
export 0.1.0
export software ['games']
export extensions ['.cue']
export icon ['3d']

import vec
import img
import trinity
import spectra

# OpenBIOS (PCSX-Redux's nugget, MIT) for MIPS I by our own clang,
# lld and llvm-objcopy: nugget.diff and nugget/silver adapt it
import pcsx-redux:nugget/20b63161065d9198bbb6a2543cd4163548e8da6d
    > sh silver/build.sh {install}

import <stdio.h>
import <stdlib.h>
import <string.h>
import <math.h>
import <vulkan/vulkan.h>
import <pthread.h>
import <unistd.h>

import Bus
import Cpu
import Dma
import Timers
import Gpu
import Cdrom
import Spu
import Pad
import Mdec
import Gte
import State

# NTSC: the CPU clock, one scanline, the lines of a frame
CPU_HZ       : i64 [ 33868800 ]
LINE_CYCLES  : i64 [ 2153 ]
FRAME_LINES  : i32 [ 263 ]
VBLANK_LINE  : i32 [ 240 ]
# frames a second: the CPU clock over a frame's cycles
FRAME_HZ     : f64 [ 33868800.0 / (2153.0 * 263.0) ]
# the sound ring's aim, in samples: about four frames
SOUND_AIM    : i64 [ 2940 ]
SOUND_BLOCK  : i32 [ 512 ]

element psx : trinity
    public  width    : i32    [ 960 ]
    public  height   : i32    [ 720 ]
    public  title    : string [ 'psx' ]
    # a disc is its folder: the .cue in it is found
    expect default [ Live, Directory ] disc : resource
        # a new disc while it runs: the same instance boots it next
        # frame; the old machine's sound stops first
        if [ booted ] unboot[]
    mutable bus      : Bus
    mutable cpu      : Cpu
    mutable booted   : bool
    mutable failed   : bool
    mutable frames   : i64
    # the sound card, fed by its own thread from the SPU's ring
    mutable sound    : AudioOut
    mutable sound_on : bool
    # the sound thread, joined when the machine goes
    mutable sound_tid : u64
    # P / L, or the host's menu: taken at the next frame's edge
    mutable save_req : bool
    mutable load_req : bool
    # the free camera (O): 0 off, 1 live, 2 frozen on the shown frame
    mutable cam_mode : i32
    # WASD held, and the last camera step's clock
    mutable cam_keys : i32
    mutable cam_us   : i64
    # frames owed by the clock, and the clock's last reading
    mutable owed     : f64
    mutable last_us  : i64

    # the machine goes; the next frame boots one on the disc
    func unboot []
        if [ sound_on ]
            sound_on = false
            # the sound thread ends after its last block (about 12 ms)
            pthread_join[ sound_tid, null ]
            sound.close[]
        booted = false
        failed = false
        frames = 0

    # the host's menu: taken on the next frame
    action func save_state []
        save_req = true

    action func load_state []
        load_req = true

    # in psx's own storage, by the disc's name: its folder may be a
    # read only share
    func state_file [] -> path
        return path '{path.path_storage[ 'psx' ]}/{disc.stem[]}.state'

    # every device, in one order both ways
    func state_all [ s: StateIO ]
        tag : u32 [ STATE_TAG ]
        ver : u32 [ STATE_VER ]
        s.n32[ @tag ]
        s.n32[ @ver ]
        if [ tag != STATE_TAG || ver != STATE_VER ]
            s.bad = true
            return
        s.s64[ @frames ]
        cpu.state_io[ s ]
        bus.state_io[ s ]
        cpu.gte.state_io[ s ]
        bus.dma.state_io[ s ]
        bus.timers.state_io[ s ]
        bus.pad.state_io[ s ]
        bus.cd.state_io[ s ]
        bus.spu.state_io[ s ]
        bus.gpu.state_io[ s ]

    # the whole machine into the disc's state file
    func state_save [] -> bool
        s : StateIO [ saving: true ]
        state_all[ s ]
        if [ s.bad ] return false
        sp : path state_file[]
        f : @FILE [ fopen[ sp.chars, 'wb' ] ]
        if [ !f ] return false
        fwrite[ @s.buf[ 0 ], 1, s.pos, f ]
        fclose[ f ]
        log 'psx: state saved, {s.pos} bytes, {sp}'
        return true

    # the machine as saved: it goes on from that frame
    func state_load [] -> bool
        sp : path state_file[]
        f : @FILE [ fopen[ sp.chars, 'rb' ] ]
        if [ !f ]
            log 'psx: no state at {sp}'
            return false
        s : StateIO [ saving: false ]
        fread[ @s.buf[ 0 ], 1, STATE_MAX, f ]
        fclose[ f ]
        state_all[ s ]
        if [ s.bad ]
            log 'psx: {sp} is not a state of this version'
            return false
        cpu.gte.frame = frames
        log 'psx: state loaded, {sp}'
        return true

    # closing: the sound thread stops before the machine goes
    public func on_unload []
        unboot[]

    func dealloc []
        unboot[]

    # OpenBIOS, as the import built it into our share folder
    func load_bios [] -> bool
        file : path '../{share_name}/openbios.bin'
        f : @FILE [ fopen[ file.chars, "rb" ] ]
        if [ !f ]
            log 'psx: no BIOS at {file}'
            return false
        got : i64 [ i64[ fread[ bus.bios, 1, BIOS_SIZE, f ] ] ]
        fclose[ f ]
        if [ got != i64[ BIOS_SIZE ] ]
            log 'psx: BIOS is {got} bytes, not {BIOS_SIZE}'
            return false
        return true

    func boot []
        booted = true
        bus = Bus [ ]
        bus.gpu = PsxGpu [ bus: bus ]
        bus.dma = Dma [ bus: bus ]
        bus.timers = Timers [ bus: bus ]
        bus.cd = Cdrom [ bus: bus ]
        bus.spu = Spu [ bus: bus ]
        bus.pad = Pad [ bus: bus ]
        bus.mdec = Mdec [ bus: bus ]
        cpu = Cpu [ bus: bus, gte: Gte [ ] ]
        bus.gpu.gte = cpu.gte
        bus.pad.cpu = cpu
        if [ !load_bios[] ]
            failed = true
            return
        log 'psx: BIOS loaded'
        cue : '{disc}'
        if [ !bus.cd.insert[ cue ] ] log 'psx: no disc read from {cue}'
        el
            vol : bus.cd.disc.volume_name[]
            if [ vol.count > 0 ] set_title[ vol ]
        sound = AudioOut [ sample_rate: 44100, channels: 2,
                           buffer_size: SOUND_BLOCK ]
        if [ sound.open[] ]
            sound_on   = true
            pthread_create[ @sound_tid, null, @sound_entry, a ]
        el
            log 'psx: no sound device; running silent'

    # the sound thread: the SPU's samples to the card, which waits
    func sound_entry [] -> none
        while [ sound_on ]
            bus.spu.take[ sound.buffer, SOUND_BLOCK ]
            sound.write[ SOUND_BLOCK ]

    # the BIOS's character calls print, whichever BIOS it is
    func bios_calls []
        at : u32 [ cpu.pc & 0x1FFFFFFF ]
        fn : u32 [ cpu.r[ 9 ] ]
        if [ at == 0xA0 && fn == 0x3C ] bus.putc[ cpu.r[ 4 ] & 0xFF ]
        el [ at == 0xB0 && fn == 0x3D ] bus.putc[ cpu.r[ 4 ] & 0xFF ]

    # one frame: 263 scanlines, vblank at line 240
    func frame []
        for [ line: i32 0, line < FRAME_LINES, line += 1 ]
            bus.gpu.line = line
            bus.gpu.vblank = line >= VBLANK_LINE
            stop : i64 [ cpu.cycles + LINE_CYCLES ]
            while [ cpu.cycles < stop ]
                pc_low : u32 [ cpu.pc & 0x1FFFFFFF ]
                if [ pc_low == 0xA0 || pc_low == 0xB0 ] bios_calls[]
                cpu.step[]
                due : i64 [ bus.pad.ack_at ]
                if [ due != 0 && cpu.cycles >= due ]
                    bus.pad.ack_now[]
            bus.timers.tick[ LINE_CYCLES ]
            bus.cd.tick[ LINE_CYCLES ]
            bus.spu.run[ LINE_CYCLES ]
            bus.timers.hblank[]
            if [ line == VBLANK_LINE ]
                bus.irq[ IRQ_VBLANK ]
                bus.gpu.field = !bus.gpu.field
        frames += 1
        cpu.gte.frame = frames

    # the frames the clock owes, trimmed to keep the sound fed
    func run_due []
        now : i64 [ epoch_micros[] ]
        if [ last_us == 0 ] last_us = now
        owed += f64[ now - last_us ] * FRAME_HZ / 1000000.0
        last_us = now
        if [ sound_on ]
            q : i64 [ bus.spu.queued[] ]
            if [ q < SOUND_AIM / 2 ] owed += 0.25
            if [ q > SOUND_AIM * 2 ] owed -= 0.25
        runs : i32 [ 0 ]
        while [ owed >= 1.0 && runs < 4 ]
            frame[]
            owed -= 1.0
            runs += 1
        # far behind: start counting again from here
        if [ owed > 4.0 ] owed = 0.0

    # keys to the pad: arrows, Enter Start, Backspace Select,
    # X Cross, C Circle, Z Square, S Triangle, Q/E L1/R1, 1/3 L2/R2
    public func on_key [ ev: Event ]
        if [ !bus ] return
        code : i32 [ ev.key.unicode ]
        down : bool [ ev.key.state ]
        if [ down && code == 79 ]
            cam_cycle[]
            return
        if [ down && code == 80 ]
            save_req = true
            return
        if [ down && code == 76 ]
            load_req = true
            return
        if [ cam_mode > 0 ]
            # W A S D, shift faster: the camera's, not the pad's
            kb : i32 [ 0 ]
            if   [ code == 87 ]  kb = 1
            el [ code == 83 ]  kb = 2
            el [ code == 65 ]  kb = 4
            el [ code == 68 ]  kb = 8
            el [ code == 340 ] kb = 16
            if [ kb != 0 ]
                cam_keys = (down) ? (cam_keys | kb) : (cam_keys & ~kb)
                return
        bit : i32 [ -1 ]
        if   [ code == 265 ] bit = 4
        el [ code == 262 ] bit = 5
        el [ code == 264 ] bit = 6
        el [ code == 263 ] bit = 7
        el [ code == 257 ] bit = 3
        el [ code == 259 ] bit = 0
        el [ code == 88 ]  bit = 14
        el [ code == 67 ]  bit = 13
        el [ code == 90 ]  bit = 15
        el [ code == 83 ]  bit = 12
        el [ code == 81 ]  bit = 10
        el [ code == 69 ]  bit = 11
        el [ code == 49 ]  bit = 8
        el [ code == 51 ]  bit = 9
        if [ bit >= 0 ] bus.pad.press[ bit, down ]

    # O: off, live, frozen, off; the mouse looks while it is on
    func cam_cycle []
        cam_mode = (cam_mode + 1) % 3
        g : PsxGpu bus.gpu
        if [ cam_mode == 1 ]
            g.cam_x = 0.0
            g.cam_y = 0.0
            g.cam_z = 0.0
            g.cam_yaw = 0.0
            g.cam_pitch = 0.0
            g.cam_on = true
            cam_keys = 0
            ux.mouse_lock[ a ]
        g.show_drawn = cam_mode == 2
        if [ cam_mode == 0 ]
            g.cam_on = false
            ux.mouse_unlock[]
        cam_us = 0
        names : vec string [] [ 'off', 'live', 'frozen' ]
        log 'psx: camera {names[ cam_mode ]}'

    public func on_move [ ev: Event ]
        if [ cam_mode == 0 || ux.locked != a ] return
        g : PsxGpu bus.gpu
        g.cam_yaw += ev.mouse.delta.x * 0.003
        g.cam_pitch = clamp[ g.cam_pitch + ev.mouse.delta.y * 0.003,
                             -1.5, 1.5 ]

    public func on_press [ ev: Event ]
        if [ cam_mode > 0 && !ux.locked ] ux.mouse_lock[ a ]

    # the camera moves along its own look: world units a second
    func cam_step []
        now : i64 [ epoch_micros[] ]
        dt : f32 [ (cam_us == 0) ? 0.0 : f32[ now - cam_us ] / 1e6 ]
        cam_us = now
        if [ cam_keys == 0 || dt <= 0.0 ] return
        g : PsxGpu bus.gpu
        sp : f32 [ ((cam_keys & 16) != 0) ? 16000.0 : 4000.0 ]
        f : f32 [ 0.0 ]
        r : f32 [ 0.0 ]
        if [ (cam_keys & 1) != 0 ] f += 1.0
        if [ (cam_keys & 2) != 0 ] f -= 1.0
        if [ (cam_keys & 8) != 0 ] r += 1.0
        if [ (cam_keys & 4) != 0 ] r -= 1.0
        cy : f32 [ cos[ g.cam_yaw ] ]
        sy : f32 [ sin[ g.cam_yaw ] ]
        cp : f32 [ cos[ g.cam_pitch ] ]
        spt : f32 [ sin[ g.cam_pitch ] ]
        d : f32 [ sp * dt ]
        g.cam_x += (sy * cp * f + cy * r) * d
        g.cam_y += spt * f * d
        g.cam_z += (cy * cp * f - sy * r) * d

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        # a machine running: drawn every frame
        animated = true
        ux.will_animate = true
        if [ !booted ] boot[]
        if [ failed ] return
        cv : Canvas [ w.screen ]
        if [ !bus.gpu.ready ] w.set_resizable[ true ]
        bus.gpu.start_on[ cv.vk, w ]
        # a save waits for no VRAM upload in flight (its buffer is the
        # one a save reads VRAM through)
        if [ save_req && bus.gpu.img_left == 0 ]
            save_req = false
            state_save[]
        if [ load_req ]
            load_req = false
            state_load[]
        if [ cam_mode > 0 ] cam_step[]
        # frozen: the shown frame again, from the camera
        if [ cam_mode == 2 ]
            bus.gpu.replay[]
        el
            run_due[]
        # VRAM drawn at the scale that fills the window's pixels
        tall : f32 [ min[ bounds.h, bounds.w * 0.75 ] * w.scale ]
        # by 240 lines, so a switch to 480 keeps the same scale
        want : i32 [ i32[ ceil[ tall / 240.0 ] ] ]
        bus.gpu.set_scale[ clamp[ want, 1, 8 ] ]
        shown : bus.gpu.present[]
        cv.fill_color[ '#000' ]
        cv.fill_rect_fast[ 0.0, 0.0, bounds.w, bounds.h ]
        if [ !shown || bus.gpu.disp_off ] return
        # 4:3, as large as the window holds
        sw : f32 [ bounds.w ]
        sh : f32 [ bounds.w * 0.75 ]
        if [ sh > bounds.h ]
            sh = bounds.h
            sw = bounds.h / 0.75
        cv.draw_image[ shown, rect [ x: (bounds.w - sw) / 2.0,
                                     y: (bounds.h - sh) / 2.0,
                                     w: sw, h: sh ] ]
