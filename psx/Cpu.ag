# the R3000A: an interpreter with load and branch delay slots,
# coprocessor 0 (status, cause, EPC) and its exceptions
extend psx

# exception codes, Cause bits 2..6
EXC_INT  : u32 [ 0 ]
EXC_ADEL : u32 [ 4 ]
EXC_ADES : u32 [ 5 ]
EXC_SYS  : u32 [ 8 ]
EXC_BP   : u32 [ 9 ]
EXC_RI   : u32 [ 10 ]
EXC_CPU  : u32 [ 11 ]
EXC_OV   : u32 [ 12 ]

class Cpu
    public bus      : Bus
    public gte      : Gte
    public r        : new u32
    # a register holding a GTE screen word: its word and exact x y z
    public rx_word  : new u32
    public rx_x     : new f32
    public rx_y     : new f32
    public rx_z     : new f32
    public hi       : u32
    public lo       : u32
    public pc       : u32 [ 0xBFC00000 ]
    public next_pc  : u32 [ 0xBFC00004 ]
    # the instruction now running, for EPC
    public cur_pc   : u32
    public sr       : u32
    public cause    : u32
    public epc      : u32
    public badv     : u32
    # a load's value lands one instruction late: the one this
    # instruction made, and the older one landing after it
    public ld_reg   : u32
    public ld_val   : u32
    public pend_reg : u32
    public pend_val : u32
    # this instruction sits in a branch's delay slot
    public in_delay : bool
    public branched : bool
    public cycles   : i64
    public steps    : i64

    func init []
        r = new u32 [ 32 ]
        rx_word = new u32 [ 32 ]
        rx_x = new f32 [ 32 ]
        rx_y = new f32 [ 32 ]
        rx_z = new f32 [ 32 ]
        # PRId of the R3000A
        sr = 0x10900000

    # Rd/Rt written by an ALU op: a load landing on it is dropped
    func set [ i: u32, v: u32 ]
        if [ i == 0 ] return
        r[ i ] = v
        if [ pend_reg == i ] pend_reg = 0

    func load_later [ i: u32, v: u32 ]
        if [ i == 0 ] return
        ld_reg = i
        ld_val = v

    func sext16 [ v: u32 ] -> u32
        return u32[ i32[ v << 16 ] >> 16 ]

    func sext8 [ v: u32 ] -> u32
        return u32[ i32[ v << 24 ] >> 24 ]

    # enter the handler: the mode stack shifts, EPC, BD, the vector
    public func exception [ code: u32 ]
        handler : u32 [ ((sr & 0x400000) != 0) ? 0xBFC00180
                        : 0x80000080 ]
        sr = (sr & 0xFFFFFFC0) | ((sr << 2) & 0x3F)
        cause = (cause & 0xFFFFFF83) | (code << 2)
        epc = cur_pc
        if [ in_delay ]
            epc = cur_pc - 4
            cause = cause | 0x80000000
        el
            cause = cause & 0x7FFFFFFF
        pc = handler
        next_pc = handler + 4

    func branch [ target: u32 ]
        next_pc = target
        branched = true

    # one instruction, its pending load, and any interrupt
    public func step []
        cycles += 2
        steps += 1
        # the interrupt line from the I/O side, Cause bit 10
        if [ bus.irq_pending[] ] cause = cause | 0x400
        el                       cause = cause & 0xFFFFFBFF
        cur_pc = pc
        in_delay = branched
        branched = false
        if [ (sr & 1) != 0 && (sr & cause & 0xFF00) != 0 ]
            # a GTE command about to run finishes first on hardware
            op0 : u32 [ bus.read32[ pc ] ]
            if [ (op0 >> 25) == 0x25 ]
                gte.command[ op0 ]
            exception[ EXC_INT ]
            in_delay = false
            return
        if [ (pc & 3) != 0 ]
            badv = pc
            exception[ EXC_ADEL ]
            return
        op : u32 [ bus.read32[ pc ] ]
        pc = next_pc
        next_pc = next_pc + 4
        pend_reg = ld_reg
        pend_val = ld_val
        ld_reg = 0
        execute[ op, pend_reg, pend_val ]
        # the older load lands, unless a new one replaces it
        if [ pend_reg != 0 && pend_reg != ld_reg ]
            r[ pend_reg ] = pend_val

    # the register as this instruction sees it: an older load lands
    # only after it, so reads here see the value from before
    func execute [ op: u32, lr: u32, lv: u32 ]
        rs : u32 [ (op >> 21) & 31 ]
        rt : u32 [ (op >> 16) & 31 ]
        rd : u32 [ (op >> 11) & 31 ]
        sh : u32 [ (op >> 6) & 31 ]
        imm : u32 [ op & 0xFFFF ]
        simm : u32 [ sext16[ imm ] ]
        vs : u32 [ r[ rs ] ]
        vt : u32 [ r[ rt ] ]
        switch [ op >> 26 ]
            case 0x00
                special[ op, rs, rt, rd, sh, vs, vt ]
            case 0x01
                # BLTZ BGEZ, and the link forms BLTZAL BGEZAL
                neg : bool [ i32[ vs ] < 0 ]
                take : bool [ ((rt & 1) != 0) ? !neg : neg ]
                if [ (rt & 0x1E) == 0x10 ] set[ 31, pc + 4 ]
                if [ take ] branch[ pc + (simm << 2) ]
            case 0x02
                branch[ (pc & 0xF0000000) | ((op & 0x3FFFFFF) << 2) ]
            case 0x03
                set[ 31, pc + 4 ]
                branch[ (pc & 0xF0000000) | ((op & 0x3FFFFFF) << 2) ]
            case 0x04
                if [ vs == vt ] branch[ pc + (simm << 2) ]
            case 0x05
                if [ vs != vt ] branch[ pc + (simm << 2) ]
            case 0x06
                if [ i32[ vs ] <= 0 ] branch[ pc + (simm << 2) ]
            case 0x07
                if [ i32[ vs ] > 0 ] branch[ pc + (simm << 2) ]
            case 0x08
                sum : u32 [ vs + simm ]
                if [ ((vs ^ sum) & (simm ^ sum) & 0x80000000) != 0 ]
                    exception[ EXC_OV ]
                    return
                set[ rt, sum ]
            case 0x09
                set[ rt, vs + simm ]
            case 0x0A
                set[ rt, (i32[ vs ] < i32[ simm ]) ? 1 : 0 ]
            case 0x0B
                set[ rt, (vs < simm) ? 1 : 0 ]
            case 0x0C
                set[ rt, vs & imm ]
            case 0x0D
                set[ rt, vs | imm ]
            case 0x0E
                set[ rt, vs ^ imm ]
            case 0x0F
                set[ rt, imm << 16 ]
            case 0x10
                cop0[ op, rs, rt, rd, vt ]
            case 0x12
                cop2[ op, rs, rt, rd, vt ]
            case 0x20
                ea : u32 [ vs + simm ]
                load_later[ rt, sext8[ bus.read8[ ea ] ] ]
            case 0x21
                ea : u32 [ vs + simm ]
                if [ (ea & 1) != 0 ]
                    badv = ea
                    exception[ EXC_ADEL ]
                    return
                load_later[ rt, sext16[ bus.read16[ ea ] ] ]
            case 0x22
                # LWL merges into the value a pending load brings
                ea : u32 [ vs + simm ]
                cur : u32 [ (lr == rt) ? lv : vt ]
                w : u32 [ bus.read32[ ea & 0xFFFFFFFC ] ]
                k : u32 [ ea & 3 ]
                v : u32 [ 0 ]
                if [ k == 0 ]      v = (cur & 0x00FFFFFF) | (w << 24)
                el [ k == 1 ]      v = (cur & 0x0000FFFF) | (w << 16)
                el [ k == 2 ]      v = (cur & 0x000000FF) | (w << 8)
                el                 v = w
                load_later[ rt, v ]
            case 0x23
                ea : u32 [ vs + simm ]
                if [ (ea & 3) != 0 ]
                    badv = ea
                    exception[ EXC_ADEL ]
                    return
                if [ (sr & 0x10000) == 0 ]
                    w : u32 [ bus.read32[ ea ] ]
                    load_later[ rt, w ]
                    # an exact screen word carried into the register
                    rx_z[ rt ] = 0.0
                    if [ bus.exact_at[ ea, w, gte ] ]
                        rx_word[ rt ] = w
                        rx_x[ rt ] = gte.hit_x
                        rx_y[ rt ] = gte.hit_y
                        rx_z[ rt ] = gte.hit_z
            case 0x24
                ea : u32 [ vs + simm ]
                load_later[ rt, bus.read8[ ea ] ]
            case 0x25
                ea : u32 [ vs + simm ]
                if [ (ea & 1) != 0 ]
                    badv = ea
                    exception[ EXC_ADEL ]
                    return
                load_later[ rt, bus.read16[ ea ] ]
            case 0x26
                ea : u32 [ vs + simm ]
                cur : u32 [ (lr == rt) ? lv : vt ]
                w : u32 [ bus.read32[ ea & 0xFFFFFFFC ] ]
                k : u32 [ ea & 3 ]
                v : u32 [ 0 ]
                if [ k == 0 ]      v = w
                el [ k == 1 ]      v = (cur & 0xFF000000) | (w >> 8)
                el [ k == 2 ]      v = (cur & 0xFFFF0000) | (w >> 16)
                el                 v = (cur & 0xFFFFFF00) | (w >> 24)
                load_later[ rt, v ]
            case 0x28
                # stores with the cache isolated touch no memory
                if [ (sr & 0x10000) == 0 ] bus.write8[ vs + simm, vt ]
            case 0x29
                ea : u32 [ vs + simm ]
                if [ (ea & 1) != 0 ]
                    badv = ea
                    exception[ EXC_ADES ]
                    return
                if [ (sr & 0x10000) == 0 ] bus.write16[ ea, vt ]
            case 0x2A
                ea : u32 [ vs + simm ]
                w : u32 [ bus.read32[ ea & 0xFFFFFFFC ] ]
                k : u32 [ ea & 3 ]
                v : u32 [ 0 ]
                if [ k == 0 ]      v = (w & 0xFFFFFF00) | (vt >> 24)
                el [ k == 1 ]      v = (w & 0xFFFF0000) | (vt >> 16)
                el [ k == 2 ]      v = (w & 0xFF000000) | (vt >> 8)
                el                 v = vt
                if [ (sr & 0x10000) == 0 ]
                    bus.write32[ ea & 0xFFFFFFFC, v ]
            case 0x2B
                ea : u32 [ vs + simm ]
                if [ (ea & 3) != 0 ]
                    badv = ea
                    exception[ EXC_ADES ]
                    return
                if [ (sr & 0x10000) == 0 ]
                    bus.write32[ ea, vt ]
                    # an exact word still unchanged in its register
                    if [ rx_z[ rt ] > 0.0 && rx_word[ rt ] == vt ]
                        bus.put_exact[ ea, vt, rx_x[ rt ], rx_y[ rt ],
                                       rx_z[ rt ] ]
            case 0x2E
                ea : u32 [ vs + simm ]
                w : u32 [ bus.read32[ ea & 0xFFFFFFFC ] ]
                k : u32 [ ea & 3 ]
                v : u32 [ 0 ]
                if [ k == 0 ]      v = vt
                el [ k == 1 ]      v = (w & 0x000000FF) | (vt << 8)
                el [ k == 2 ]      v = (w & 0x0000FFFF) | (vt << 16)
                el                 v = (w & 0x00FFFFFF) | (vt << 24)
                if [ (sr & 0x10000) == 0 ]
                    bus.write32[ ea & 0xFFFFFFFC, v ]
            case 0x32
                # LWC2: a GTE data register from memory
                ea : u32 [ vs + simm ]
                gte.write_data[ rt, bus.read32[ ea ] ]
            case 0x3A
                # SWC2: a GTE data register to memory
                ea : u32 [ vs + simm ]
                w : u32 [ gte.read_data[ rt ] ]
                bus.write32[ ea, w ]
                bus.shadow[ ea, w, rt, gte ]
            default
                exception[ EXC_RI ]

    func special [ op: u32, rs: u32, rt: u32, rd: u32, sh: u32,
                   vs: u32, vt: u32 ]
        switch [ op & 0x3F ]
            case 0x00
                set[ rd, vt << sh ]
            case 0x02
                set[ rd, vt >> sh ]
            case 0x03
                set[ rd, u32[ i32[ vt ] >> i32[ sh ] ] ]
            case 0x04
                set[ rd, vt << (vs & 31) ]
            case 0x06
                set[ rd, vt >> (vs & 31) ]
            case 0x07
                set[ rd, u32[ i32[ vt ] >> i32[ vs & 31 ] ] ]
            case 0x08
                branch[ vs ]
            case 0x09
                set[ rd, pc + 4 ]
                branch[ vs ]
            case 0x0C
                exception[ EXC_SYS ]
            case 0x0D
                exception[ EXC_BP ]
            case 0x10
                set[ rd, hi ]
            case 0x11
                hi = vs
            case 0x12
                set[ rd, lo ]
            case 0x13
                lo = vs
            case 0x18
                m : i64 [ i64[ i32[ vs ] ] * i64[ i32[ vt ] ] ]
                lo = u32[ m ]
                hi = u32[ m >> 32 ]
            case 0x19
                m : u64 [ u64[ vs ] * u64[ vt ] ]
                lo = u32[ m ]
                hi = u32[ m >> 32 ]
            case 0x1A
                divide[ vs, vt ]
            case 0x1B
                if [ vt == 0 ]
                    lo = 0xFFFFFFFF
                    hi = vs
                el
                    lo = vs / vt
                    hi = vs % vt
            case 0x20
                sum : u32 [ vs + vt ]
                if [ ((vs ^ sum) & (vt ^ sum) & 0x80000000) != 0 ]
                    exception[ EXC_OV ]
                    return
                set[ rd, sum ]
            case 0x21
                set[ rd, vs + vt ]
            case 0x22
                diff : u32 [ vs - vt ]
                if [ ((vs ^ vt) & (vs ^ diff) & 0x80000000) != 0 ]
                    exception[ EXC_OV ]
                    return
                set[ rd, diff ]
            case 0x23
                set[ rd, vs - vt ]
            case 0x24
                set[ rd, vs & vt ]
            case 0x25
                set[ rd, vs | vt ]
            case 0x26
                set[ rd, vs ^ vt ]
            case 0x27
                set[ rd, ~(vs | vt) ]
            case 0x2A
                set[ rd, (i32[ vs ] < i32[ vt ]) ? 1 : 0 ]
            case 0x2B
                set[ rd, (vs < vt) ? 1 : 0 ]
            default
                exception[ EXC_RI ]

    # DIV: by zero and the one overflow give the hardware's values
    func divide [ vs: u32, vt: u32 ]
        n : i32 [ i32[ vs ] ]
        d : i32 [ i32[ vt ] ]
        if [ d == 0 ]
            hi = vs
            lo = (n >= 0) ? 0xFFFFFFFF : 1
            return
        if [ vs == 0x80000000 && vt == 0xFFFFFFFF ]
            lo = 0x80000000
            hi = 0
            return
        lo = u32[ n / d ]
        hi = u32[ n % d ]

    func cop0 [ op: u32, rs: u32, rt: u32, rd: u32, vt: u32 ]
        if [ rs == 0x00 ]
            # MFC0: a load, one instruction late
            v : u32 [ 0 ]
            if [ rd == 12 ]      v = sr
            el [ rd == 13 ]      v = cause
            el [ rd == 14 ]      v = epc
            el [ rd == 8 ]       v = badv
            el [ rd == 15 ]      v = 0x00000002
            load_later[ rt, v ]
        el [ rs == 0x04 ]
            if [ rd == 12 ]      sr = vt
            # only the two software interrupt bits are writable
            el [ rd == 13 ]
                cause = (cause & 0xFFFFFCFF) | (vt & 0x300)
        el [ rs == 0x10 && (op & 0x3F) == 0x10 ]
            # RFE: the mode stack shifts back
            sr = (sr & 0xFFFFFFF0) | ((sr >> 2) & 0x0F)
        el
            exception[ EXC_RI ]

    func cop2 [ op: u32, rs: u32, rt: u32, rd: u32, vt: u32 ]
        if [ (op & 0x2000000) != 0 ]
            gte.command[ op ]
            return
        if [ rs == 0x00 ]
            w : u32 [ gte.read_data[ rd ] ]
            load_later[ rt, w ]
            rx_z[ rt ] = 0.0
            if [ gte.exact_of[ rd ] ]
                rx_word[ rt ] = w
                rx_x[ rt ] = gte.hit_x
                rx_y[ rt ] = gte.hit_y
                rx_z[ rt ] = gte.hit_z
        el [ rs == 0x02 ]       load_later[ rt, gte.read_ctrl[ rd ] ]
        el [ rs == 0x04 ]       gte.write_data[ rd, vt ]
        el [ rs == 0x06 ]       gte.write_ctrl[ rd, vt ]
        el                      exception[ EXC_RI ]
