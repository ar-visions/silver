# bootcube: the boot picture, orbiter's avatar in the dark until the
# shell takes the screen (init starts it as the gpu driver loads)
export 1.0.0

import vec
import img
import trinity
import avatar

# the avatar, a square of 20 units in the middle, resting
OrbiterAvatar BootAvatar
    style : CSS {
        area: l50%-10 t50%-10 w20 h20
    }

element bootcube : trinity
    width      : i32    [ 1116 ]
    height     : i32    [ 2484 ]
    public title      : string [ 'bootcube' ]
    intern t0         : i64

    func init []
        animated = true

    public func render [] -> Elements
        return Elements [ 'avatar': BootAvatar [ settled: false ] ]

    public func on_canvas [ cv: Canvas ]
        if [ !cv || !bounds ] return
        # the window draws only when asked: ask for the next frame
        if [ ux ] ux.will_animate = true
        if [ t0 == 0 ]
            t0 = epoch_micros[]
            # how long the boot took to show it: the kernel's clock
            ut : path [ '/proc/uptime' ]
            up : string ut.load[ typeid[ string ], null ]
            if [ up ] log 'bootcube: first frame at {up}'
        cv.fill_color[ rgba [ '#06050a' ] ]
        cv.rect_to[ 0.0, 0.0, bounds.w, bounds.h ]
        cv.paint[]
