# neptune's storm from a still orbit: three repeating maps on shells
# under the limb, each carried along its hand drawn currents
export 0.1.0
export scenes ['NeptuneStorm']
export dependencies ['orbiter']
import vec
import img
import gltf
import trinity
import tls
import scenes

import <stdio.h>
import <stdlib.h>
ifdef [ windows ]
    import <posix.h>
ifndef [ windows ]
    import <unistd.h>
        +_DEFAULT_SOURCE
        +_XOPEN_SOURCE=500

enum StormSurface
    swirls : 0
    haze   : 1
    wisps  : 2
    flow   : 3

func to_unit [ v: f32 ] -> u8
    s : f32 [ v * 255.0 + 0.5 ]
    if [ s < 0.0 ] s = 0.0
    if [ s > 255.0 ] s = 255.0
    return u8[ i32[ s ] ]

# a map's edges faded into each other, so it repeats unseen
func bake_tile [ src: path, out: path ]
    g : Image [ uri: src ]
    w : i32 [ g.width ]
    h : i32 [ g.height ]
    c : i32 [ (g.channels > 0) ? g.channels : 4 ]
    px : @u8 [ g.vdata[] ]
    band : i32 [ 48 ]
    ow : i32 [ w - band ]
    oh : i32 [ h - band ]
    im : Image [ width: ow, height: oh, format: Pixel.rgba8,
                 surface: Surface.color ]
    d : @u8 [ im.vdata[] ]
    for [ y: i32 0, y < oh, y += 1 ]
        yw : f32 [ (y < band) ? f32[ y ] / f32[ band ] : 1.0 ]
        oy : i32 [ (y < band) ? oh + y : y ]
        for [ x: i32 0, x < ow, x += 1 ]
            xw : f32 [ (x < band) ? f32[ x ] / f32[ band ] : 1.0 ]
            ox : i32 [ (x < band) ? ow + x : x ]
            at : i32 [ (y * ow + x) * 4 ]
            for [ k: i32 0, k < 3, k += 1 ]
                near : f32 [ px[ (y * w + x) * c + k ] ]
                sx : f32 [ px[ (y * w + ox) * c + k ] ]
                sy : f32 [ px[ (oy * w + x) * c + k ] ]
                sd : f32 [ px[ (oy * w + ox) * c + k ] ]
                top : f32 [ near * xw + sx * (1.0 - xw) ]
                low : f32 [ sy * xw + sd * (1.0 - xw) ]
                d[ at + k ] =
                    to_unit[ (top * yw + low * (1.0 - yw)) / 255.0 ]
            d[ at + 3 ] = 255
    im.png[ out ]

# the clouds' map as a mask: a gaussian (three box blurs, wrapping),
# its middle at 0 and its brightest at 1
func bake_blur [ src: path, out: path, r: i32 ]
    g : Image [ uri: src ]
    w : i32 [ g.width ]
    h : i32 [ g.height ]
    c : i32 [ (g.channels > 0) ? g.channels : 4 ]
    px : @u8 [ g.vdata[] ]
    n : i32 [ w * h ]
    v : new f32 [ n ]
    tmp : new f32 [ n ]
    for [ i: i32 0, i < n, i += 1 ]
        v[ i ] = f32[ px[ i * c ] ] / 255.0
    wide : f32 [ 2 * r + 1 ]
    for [ pass: i32 0, pass < 3, pass += 1 ]
        for [ y: i32 0, y < h, y += 1 ]
            sum : f32 [ 0.0 ]
            for [ i: i32 -r, i <= r, i += 1 ]
                sum += v[ y * w + (i + w) % w ]
            for [ x: i32 0, x < w, x += 1 ]
                tmp[ y * w + x ] = sum / wide
                sum += v[ y * w + (x + r + 1) % w ]
                sum -= v[ y * w + (x - r + w) % w ]
        for [ x: i32 0, x < w, x += 1 ]
            sum : f32 [ 0.0 ]
            for [ i: i32 -r, i <= r, i += 1 ]
                sum += tmp[ (i + h) % h * w + x ]
            for [ y: i32 0, y < h, y += 1 ]
                v[ y * w + x ] = sum / wide
                sum += tmp[ (y + r + 1) % h * w + x ]
                sum -= tmp[ (y - r + h) % h * w + x ]
    bins : new i32 [ 2048 ]
    for [ i: i32 0, i < n, i += 1 ]
        bins[ i32[ v[ i ] * 2047.0 ] ] += 1
    low : f32 [ 0.0 ]
    top : f32 [ 1.0 ]
    seen : i32 [ 0 ]
    for [ b: i32 0, b < 2048, b += 1 ]
        before : i32 [ seen ]
        seen += bins[ b ]
        if [ before < n / 2 && seen >= n / 2 ] low = f32[ b ] / 2047.0
        if [ before < n - n / 500 && seen >= n - n / 500 ]
            top = f32[ b ] / 2047.0
    log 'storm: blur middle {low} top {top}'
    im : Image [ width: w, height: h, format: Pixel.rgba8,
                 surface: Surface.color ]
    d : @u8 [ im.vdata[] ]
    for [ i: i32 0, i < n, i += 1 ]
        m : f32 [ (v[ i ] - low) / (top - low) ]
        d[ i * 4 ] = to_unit[ m ]
        d[ i * 4 + 1 ] = d[ i * 4 ]
        d[ i * 4 + 2 ] = d[ i * 4 ]
        d[ i * 4 + 3 ] = 255
    im.png[ out ]

# the user's arrows in frame pixels; x under 0 ends a current
func storm_arrows [] -> vec f32
    return vec f32 [] [
        1278.0, 425.0, 1100.0, 355.0, 1000.0, 335.0, 800.0, 322.0,
        650.0, 305.0, 490.0, 280.0, -1.0, 0.0,
        1350.0, 260.0, 1290.0, 248.0, 1225.0, 250.0, -1.0, 0.0,
        1500.0, 233.0, 1455.0, 218.0, -1.0, 0.0,
        310.0, 355.0, 330.0, 430.0, 380.0, 500.0, 430.0, 545.0,
        -1.0, 0.0,
        258.0, 643.0, 400.0, 680.0, 560.0, 730.0, 680.0, 760.0,
        780.0, 810.0, 835.0, 850.0, -1.0, 0.0,
        1285.0, 582.0, 1200.0, 535.0, 1100.0, 518.0, 960.0, 512.0,
        860.0, 530.0, 820.0, 575.0, 835.0, 625.0, 875.0, 650.0,
        950.0, 700.0, 1040.0, 735.0, 1200.0, 760.0, 1355.0, 770.0,
        -1.0, 0.0 ]

# the storm's own way in, the deck's alone
func storm_spiral [] -> vec f32
    return vec f32 [] [
        1355.0, 770.0, 1372.0, 730.0, 1340.0, 680.0, 1250.0, 620.0,
        1160.0, 590.0, 1080.0, 583.0, 1048.0, 620.0, 1065.0, 660.0,
        1130.0, 680.0, -1.0, 0.0 ]

# points along each current, each with its way: x y dx dy
func current_points [ lines: vec f32, out: vec f32 ]
    for [ k: i32 0, k + 3 < lines.count, k += 2 ]
        ax : f32 [ lines[ k ] ]
        bx : f32 [ lines[ k + 2 ] ]
        if [ ax >= 0.0 && bx >= 0.0 ]
            ay : f32 [ lines[ k + 1 ] ]
            by : f32 [ lines[ k + 3 ] ]
            ex : f32 [ bx - ax ]
            ey : f32 [ by - ay ]
            len : f32 [ sqrt[ ex * ex + ey * ey ] ]
            steps : i32 [ i32[ len / 10.0 ] + 1 ]
            for [ s: i32 0, s < steps, s += 1 ]
                f : f32 [ (f32[ s ] + 0.5) / f32[ steps ] ]
                px : f32 [ ax + ex * f ]
                py : f32 [ ay + ey * f ]
                dx : f32 [ ex / len ]
                dy : f32 [ ey / len ]
                out.push[ px ]
                out.push[ py ]
                out.push[ dx ]
                out.push[ dy ]

# nearer currents count more; a far spot is their mean
func wind_at [ pts: vec f32, x: f32, y: f32, out: @f32 ]
    sx : f32 [ 0.0 ]
    sy : f32 [ 0.0 ]
    sw : f32 [ 0.0 ]
    p : @f32 [ @pts[ 0 ] ]
    n : i32 [ pts.count / 4 ]
    for [ i: i32 0, i < n, i += 1 ]
        ex : f32 [ p[ i * 4 ] - x ]
        ey : f32 [ p[ i * 4 + 1 ] - y ]
        q : f32 [ ex * ex + ey * ey + 1600.0 ]
        wt : f32 [ 1.0 / (q * sqrt[ q ]) ]
        sx += wt * p[ i * 4 + 2 ]
        sy += wt * p[ i * 4 + 3 ]
        sw += wt
    out[ 0 ] = sx / sw
    out[ 1 ] = sy / sw

# the storm's currents as a picture, in r g
func bake_flow [ w: i32, h: i32, out: path ]
    full : vec f32 []
    current_points[ storm_arrows[], full ]
    current_points[ storm_spiral[], full ]
    fw : i32 [ w / 4 ]
    fh : i32 [ h / 4 ]
    im : Image [ width: fw, height: fh, format: Pixel.rgba8,
                 linear: true ]
    d : @u8 [ im.vdata[] ]
    v : new f32 [ 2 ]
    for [ y: i32 0, y < fh, y += 1 ]
        gy : f32 [ (f32[ y ] + 0.5) * 4.0 ]
        # far off a pixel spans more ground; the limb holds still
        far : f32 [ (gy - 180.0) / 700.0 ]
        if [ far < 0.0 ] far = 0.0
        if [ far > 1.0 ] far = 1.0
        hold : f32 [ (gy - 175.0) / 75.0 ]
        if [ hold < 0.0 ] hold = 0.0
        if [ hold > 1.0 ] hold = 1.0
        s : f32 [ (0.25 + 0.75 * far) * hold * hold * 0.5 ]
        for [ x: i32 0, x < fw, x += 1 ]
            gx : f32 [ (f32[ x ] + 0.5) * 4.0 ]
            i : i32 [ (y * fw + x) * 4 ]
            wind_at[ full, gx, gy, v ]
            d[ i ]     = to_unit[ 0.5 + v[ 0 ] * s ]
            d[ i + 1 ] = to_unit[ 0.5 + v[ 1 ] * s ]
            d[ i + 2 ] = 128
            d[ i + 3 ] = 255
    im.png[ out ]

ModelViewProject StormShader
    # x flow time, y aspect, z real seconds
    mutable clock : vec4f
    attrib swirls : LayoutBinding [ type:typeid[ StormSurface ],
                                    id: StormSurface.swirls, count:1,
                                    format: typeid[ rgba8 ] ]
    attrib haze   : LayoutBinding [ type:typeid[ StormSurface ],
                                    id: StormSurface.haze, count:1,
                                    format: typeid[ rgba8 ] ]
    attrib wisps  : LayoutBinding [ type:typeid[ StormSurface ],
                                    id: StormSurface.wisps, count:1,
                                    format: typeid[ rgba8 ] ]
    attrib flow   : LayoutBinding [ type:typeid[ StormSurface ],
                                    id: StormSurface.flow, count:1,
                                    format: typeid[ rgba8 ] ]
    attrib pos       : VertexInput    [ type:typeid[ vec3f ] ]
    attrib uv        : VertexInput    [ type:typeid[ vec2f ] ]
    attrib v_uv      : VertexOutput   [ type:typeid[ vec2f ] ]
    attrib fragColor : FragmentOutput [ type:typeid[ vec4f ] ]

    func init []
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    func vertex [] -> GLSL none {
        v_uv        = uv;
        gl_Position = vec4(pos.x, pos.y, 0.0, 1.0);
    }

    # frame place to view ray: 1672 x 941 pixels, a 30 degree lens
    func s_ray [ q: @vec2f ] -> GLSL vec3f {
        const float cr = 0.99990, sr = -0.0138;
        float px = q.x * 1672.0 - 836.0;
        float py = 470.5 - q.y * 941.0;
        float rx = px * cr - py * sr;
        float ry = px * sr + py * cr;
        const float ca = 0.9483, sa = 0.3173;
        vec3 v = vec3(rx, ry * ca - 1756.0 * sa,
                      ry * sa + 1756.0 * ca);
        return normalize(v);
    }

    # where a ray meets the shell of radius r, as a place on the ground
    func s_at [ q: @vec2f, r: @f32 ] -> GLSL vec2f {
        const float high = 1.0108;
        vec3 d = s_ray(q);
        float b = high * d.y;
        float e = b * b - high * high + r * r;
        float t = -b - sqrt(max(e, 0.0));
        vec3 p = vec3(0.0, high, 0.0) + d * t;
        // far ground held wider than true: long bands, no ripples
        float far = max(p.z / r, 0.005) / 0.0252;
        return vec2(p.x / r * pow(far, -0.7), 0.0252 * log(far));
    }

    func s_grad [ c: @vec3f ] -> GLSL vec3f {
        uvec3 v = uvec3(ivec3(c) + 1048576);
        v = v * 1664525u + 1013904223u;
        v.x += v.y * v.z;
        v.y += v.z * v.x;
        v.z += v.x * v.y;
        v ^= v >> 16u;
        v.x += v.y * v.z;
        v.y += v.z * v.x;
        v.z += v.x * v.y;
        return vec3(v) / 2147483647.5 - 1.0;
    }

    # perlin's gradient noise, about -1 to 1
    func s_perlin [ p: @vec3f ] -> GLSL f32 {
        vec3 i = floor(p);
        vec3 f = p - i;
        vec3 u = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
        float n000 = dot(s_grad(i), f);
        float n100 = dot(s_grad(i + vec3(1, 0, 0)), f - vec3(1, 0, 0));
        float n010 = dot(s_grad(i + vec3(0, 1, 0)), f - vec3(0, 1, 0));
        float n110 = dot(s_grad(i + vec3(1, 1, 0)), f - vec3(1, 1, 0));
        float n001 = dot(s_grad(i + vec3(0, 0, 1)), f - vec3(0, 0, 1));
        float n101 = dot(s_grad(i + vec3(1, 0, 1)), f - vec3(1, 0, 1));
        float n011 = dot(s_grad(i + vec3(0, 1, 1)), f - vec3(0, 1, 1));
        float n111 = dot(s_grad(i + vec3(1, 1, 1)), f - vec3(1, 1, 1));
        float x0 = mix(mix(n000, n100, u.x), mix(n010, n110, u.x), u.y);
        float x1 = mix(mix(n001, n101, u.x), mix(n011, n111, u.x), u.y);
        return mix(x0, x1, u.z) * 1.6;
    }

    # the trade winds' two pale bands: their middles, frame pixels
    func s_upper [ x: @f32 ] -> GLSL f32 {
        return 258.0 + 0.000061 * x * x;
    }

    func s_lower [ x: @f32 ] -> GLSL f32 {
        float bend = max(x - 700.0, 0.0);
        return 520.0 + 0.17 * x + 0.00045 * bend * bend;
    }

    func fragment [] -> GLSL none {
        float t = ubo.clock.x;
        // the frame fills the window, its middle kept
        const vec2 size = vec2(1672.0, 941.0);
        vec2 q = v_uv;
        float want = size.x / size.y;
        if (ubo.clock.y > want) q.y = 0.5 + (q.y - 0.5) * want
                                      / ubo.clock.y;
        else q.x = 0.5 + (q.x - 0.5) * ubo.clock.y / want;
        // the ray against the deck and the top of the air, radii
        const float high = 1.0108;
        const float air = 0.002;
        vec3 ray = s_ray(q);
        float rb = high * ray.y;
        float reach = sqrt(max(high * high - rb * rb, 0.0));
        float over = reach - 1.0;
        float sd = rb * rb - high * high + 1.0;
        float se = rb * rb - high * high + (1.0 + air) * (1.0 + air);
        float path = 2.0 * sqrt(max(se, 0.0));
        if (sd > 0.0) path = sqrt(se) - sqrt(sd);
        path /= air;
        // the map's vortex on the storm, map x turned to spin its way
        const float r0 = 1.0;
        const float r1 = 1.0004;
        const float r2 = 1.001;
        vec2 eye = vec2(1110.0, 630.0) / size;
        vec2 cen = s_at(eye, r0);
        vec2 g0 = s_at(q, r0);
        vec2 g1 = s_at(q, r1);
        vec2 g2 = s_at(q, r2);
        const vec2 k0 = vec2(-27.0, -21.0);
        const vec2 k1 = vec2(19.0, -15.0);
        const vec2 k2 = vec2(30.0, -24.0);
        vec2 m0 = (g0 - cen) * k0 + vec2(0.78, 0.605);
        vec2 m1 = (g1 - cen) * k1 + vec2(0.31, 0.17);
        vec2 m2 = (g2 - cen) * k2 + vec2(0.64, 0.88);
        // the trade winds' regions: how far off each middle
        float fx = q.x * 1672.0;
        float fy = q.y * 941.0;
        float mid_u = s_upper(fx);
        float mid_l = s_lower(fx);
        float half_u = 60.0 + 0.02 * fx;
        float half_l = max(150.0 - 0.07 * fx, 60.0);
        float off_u = (fy - mid_u) / half_u;
        float off_l = (fy - mid_l) / half_l;
        float band_u = exp(-off_u * off_u);
        float band_l = exp(-off_l * off_l);
        // the two sheets meet between the bands
        float meet = fy - 0.5 * (mid_u + mid_l)
                   + 22.0 * sin(q.x * 9.0 + 0.7);
        float lower = smoothstep(-70.0, 70.0, meet);
        // ground a second: upper left and away, lower right and near
        const vec2 way_up = vec2(-1.0, 0.3);
        const vec2 way_low = vec2(1.0, -0.7);
        const float deck_v = 0.00006;
        const float haze_v = 0.00009;
        const float high_v = 0.00015;
        // a map moves one way when read from the other
        vec2 d_up = m0 - fract(way_up * k0 * deck_v * t);
        vec2 d_low = m0 + vec2(0.37, 0.21)
                   - fract(way_low * k0 * deck_v * t);
        vec2 h_up = m1 - fract(way_up * k1 * haze_v * t);
        vec2 h_low = m1 + vec2(0.53, 0.41)
                   - fract(way_low * k1 * haze_v * t);
        vec2 w_up = m2 - fract(way_up * k2 * high_v * t);
        vec2 w_low = m2 + vec2(0.29, 0.67)
                   - fract(way_low * k2 * high_v * t);
        // the storm alone is carried round its currents, in turns
        const float cycle = 14.0;
        // each spot takes its turn: no pulse across the storm
        float ph = 0.09 * sin(q.x * 7.3 + 1.1) * sin(q.y * 9.1 + 0.4)
                 + 0.05 * sin(q.x * 17.0 - q.y * 13.0);
        // frame pixels a second at the foot of the frame
        const float deck_px = 13.0;
        float da = fract(t / cycle + ph);
        float db = fract(da + 0.5);
        float dw = smoothstep(0.3, 0.7, 1.0 - abs(2.0 * da - 1.0));
        vec2 scale = vec2(1.0) / size;
        // the wind on the ground; halfway along, so a bend is followed
        vec2 w0 = (texture(flow, q).xy - 0.502) * 2.0;
        vec2 ws = w0 * deck_px * scale * cycle;
        vec2 w1 = (texture(flow, q - ws * (da - 0.5) * 0.5).xy
                   - 0.502) * 2.0;
        vec2 w2 = (texture(flow, q - ws * (db - 0.5) * 0.5).xy
                   - 0.502) * 2.0;
        vec2 da0 = (s_at(q + w1 * deck_px * scale, r0) - g0)
                 * k0 * cycle * (da - 0.5);
        vec2 db0 = (s_at(q + w2 * deck_px * scale, r0) - g0)
                 * k0 * cycle * (db - 0.5);
        vec2 sq = (q - eye) / vec2(0.24, 0.2);
        float storm = 1.0 - smoothstep(0.55, 1.25, length(sq));
        vec3 open = mix(texture(swirls, d_up).rgb,
                        texture(swirls, d_low).rgb, lower) * 1.05;
        vec3 held = mix(texture(swirls, m0 - db0).rgb,
                        texture(swirls, m0 - da0).rgb, dw);
        // the storm a level down: dark, its arms lit
        held = max(held - 0.05, 0.0) * vec3(1.5, 1.5, 1.45);
        // lightning: one source at a time, somewhere new each beat,
        // phasing in and out; the darker the deck, the more shows
        float beat = ubo.clock.z * 0.62;
        float slot = floor(beat);
        float a = beat - slot;
        vec3 pick = s_grad(vec3(slot, 17.0, 3.0));
        if (pick.z > -0.5) {
            float round_at = (pick.x + 1.0) * 3.14159;
            vec2 source = vec2(cos(round_at), sin(round_at))
                        * (0.3 + 0.4 * abs(pick.y));
            vec3 nq = vec3(sq * 5.0, a * 1.2) + pick * 40.0;
            float reach = length((sq - source) / vec2(1.0, 0.8))
                        + 0.05 * s_perlin(nq);
            float blob = exp(-reach * reach / 0.035);
            float flick = 0.72
                        + 0.28 * s_perlin(vec3(a * 26.0, slot, 5.0));
            float env = smoothstep(0.0, 0.05, a)
                      * (1.0 - smoothstep(0.1, 0.55, a)) * flick;
            float tone = dot(held, vec3(0.2, 0.3, 0.5));
            float dark = 1.0 - smoothstep(0.08, 0.24, tone);
            held += vec3(0.72, 0.8, 1.0) * blob * env * dark;
        }
        vec3 col = mix(open, held, storm);
        vec3 veil = mix(texture(haze, h_up).rgb,
                        texture(haze, h_low).rgb, lower);
        float thick = 1.0 - exp(-0.085 * path);
        float patchy = 0.7 + 1.65 * dot(veil, vec3(0.3, 0.6, 0.1));
        float al = clamp(thick * patchy, 0.0, 1.0)
                 * (1.0 - 0.8 * storm);
        vec3 lift = veil * 0.9 + vec3(0.3, 0.22, 0.12) * thick
                  + vec3(0.18, 0.18, 0.12) * pow(thick, 6.0);
        col = mix(col, lift, al);
        // the regions are only a weight: paler colour, more white
        col = mix(col, vec3(0.5, 0.6, 0.8), band_u * 0.32);
        col = mix(col, vec3(0.4, 0.45, 0.6), band_l * 0.32);
        float region = clamp(band_u + band_l, 0.0, 1.0);
        // only the clouds' blur: a mask that brightens the blue below
        float cloud = mix(texture(wisps, w_up).r,
                          texture(wisps, w_low).r, lower);
        // banks ride with their sheet: white never comes from nowhere
        vec2 bu = w_up * vec2(0.733, -0.583);
        vec2 bl = w_low * vec2(0.733, -0.583);
        float banks = mix(texture(haze, bu, 5.0).b
                          + 0.6 * texture(swirls, bu.yx * 1.7, 4.0).b,
                          texture(haze, bl, 5.0).b
                          + 0.6 * texture(swirls, bl.yx * 1.7, 4.0).b,
                          lower);
        // more of the banks open up inside the regions
        float open_at = 0.8 - 0.2 * region;
        float keep = smoothstep(open_at, open_at + 0.12, banks);
        // none in the eye
        keep *= 1.0 - 0.75 * (1.0 - smoothstep(0.1, 0.8, length(sq)));
        keep = max(keep, thick * thick * 0.7);
        keep *= 0.22 + 0.78 * region;
        float lit = cloud * keep * (0.65 + 0.55 * region);
        col *= 1.0 + 1.3 * lit;
        col = 1.0 - (1.0 - col)
                  * (1.0 - vec3(0.34, 0.33, 0.3) * lit * lit);
        // the sun low on the right, the far left falling away
        float sun = 0.5 + 0.3 * smoothstep(0.0, 0.55, q.x)
                  + 0.55 * smoothstep(0.85, 0.3, q.y);
        // the limb: off the planet, thin air thinning with height
        float sky_x = 0.45 + 0.55 * smoothstep(0.0, 0.62, q.x);
        float up = max(over, 0.0);
        vec3 sky = vec3(0.17, 0.36, 0.95) * exp(-up / 0.0059)
                 + vec3(0.4, 0.42, 0.28) * exp(-up / 0.0008);
        col *= sun;
        vec3 line = vec3(0.36, 0.38, 0.26)
                  * exp(min(over, 0.0) / 0.0006);
        col += line * sky_x;
        float land = smoothstep(0.00008, -0.00008, over);
        col = mix(sky * sky_x, col, land);
        float ign = fract(52.9829189 * fract(dot(gl_FragCoord.xy,
                          vec2(0.06711056, 0.00583715))));
        col += (ign - 0.5) / 255.0;
        fragColor = vec4(col, 1.0);
    }

Backdrop NeptuneStorm
    frost : true
    public func bg_color [ ] -> rgba
        return rgba [ r: 0.002, g: 0.004, b: 0.016, a: 1.0 ]
    frost_sharp : true
    mutable shader  : StormShader
    mutable target  : Render
    mutable last_us : i64
    # the flow's own clock
    public  flow    : f32
    mutable steady  : f32
    # lightning keeps real seconds, whatever the weather's step
    public  spark   : f32

    func baked_tex [ name: string ] -> Texture
        im : Image [ uri: path '../{share_name}/baked/{name}.png' ]
        return Texture [ w: ux, vk: vk, linear: true, sampler: im ]

    # a repeating map: read at a slant, so filtered along it
    func tile_tex [ name: string ] -> Texture
        im : Image [ uri: path '../{share_name}/baked/{name}.png' ]
        return Texture [ w: ux, vk: vk, linear: true, sampler: im,
                         mip_levels: 11, anisotropy: 16,
                         wrap_u: true, wrap_v: true ]

    func create_target []
        if [ target ] return
        shader = StormShader [ vk: vk, name: 'neptune-storm' ]
        shader.hold[]
        samp : map Au [string] [ 'swirls': tile_tex[ 'storm-swirls' ],
                                 'haze': tile_tex[ 'storm-haze' ],
                                 'wisps': tile_tex[ 'storm-wisps' ],
                                 'flow': baked_tex[ 'storm-flow' ] ]
        m : Model [ vk: vk, w: ux, s: shader, samplers: samp ]
        # a pixel a point on retina, as the other scenes
        target = Render [ vk: vk, w: ux,
            wscale: (ux.scale > 1.0) ? 1.0 / ux.scale : 1.0,
            tag: 'neptune-storm',
            clear_color: vec4f [ 0.0, 0.0, 0.0, 1.0 ],
            models: [ m ] ]
        target.owner = a
        ux.element_targets[ id ] = target

    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    func draw [ w: Window ]
        animated = true
        create_target[]
        now : i64 [ epoch_micros[] ]
        dt : f32 [ 0.0 ]
        if [ last_us > 0 ] dt = f32[ now - last_us ] / 1000000.0
        if [ dt > 0.1 ] dt = 0.1
        last_us = now
        steady = (steady > 0.0) ? steady * 0.9 + dt * 0.1 : dt
        # the steps: how fast the weather runs
        rate : f32 [ (speed == BackdropSpeed.fast) ? 4.0
                   : (speed == BackdropSpeed.medium) ? 1.0 : 0.25 ]
        flow += steady * rate
        spark += steady
        if [ spark > 3000.0 ] spark -= 3000.0
        aspect : f32 [ (ux.height > 0)
                       ? f32[ ux.width ] / f32[ ux.height ] : 1.7778 ]
        shader.clock = vec4f [ flow, aspect, spark, 0.0 ]

# frames at chosen flow times, into STORM_SHOTS (a folder)
expect func t_storm_frames [] -> bool
    dir : getenv[ 'STORM_SHOTS' ]
    if [ !dir ] return true
    vk : vk_context []
    vk.hold[]
    wide : getenv[ 'STORM_W' ]
    tall : getenv[ 'STORM_H' ]
    w  : Window [ vk: vk, format: Pixel.rgba8, backbuffer: true,
        width: (wide) ? atoi[ wide ] : 1280,
        height: (tall) ? atoi[ tall ] : 720 ]
    w.hold[]
    if [ !w.element_targets ]
        w.element_targets = map Render [string] []
    e : NeptuneStorm [ ]
    e.hold[]
    e.id = 'NeptuneStorm'
    e.ux = w
    e.vk = w.vk
    at : vec f32 [] [ 400.0, 401.0, 402.0, 403.0, 404.0, 405.0, 406.0,
                      407.0, 408.0, 409.0, 410.0, 411.0, 412.0, 413.0,
                      414.0, 415.0 ]
    for [ k: i32 0, k < at.count, k += 1 ]
        e.last_us = 0
        e.flow = at[ k ]
        e.spark = at[ k ]
        began : i64 [ Au.epoch_millis[] ]
        e.draw[ w ]
        r : w.element_targets[ 'NeptuneStorm' ]
        r.draw[]
        r.sync_fence[]
        took : i64 [ Au.epoch_millis[] - began ]
        log 'storm: frame {k} {took} ms'
        im : Image [ r.color ]
        im.png[ path '{string[ dir ]}/frame{k}.png' ]
    return true

# the maps and currents; the picker's picture last
export func storm_export []
    bd : path '../{share_name}/baked'
    bd.make_dir[]
    maps : vec string [] [ 'swirls', 'haze', 'wisps' ]
    for [ k: i32 0, k < maps.count, k += 1 ]
        m : maps[ k ]
        src : path '../{share_name}/images/{m}.png'
        out : path '../{share_name}/baked/storm-{m}.png'
        bake_tile[ src, out ]
    tile : path '../{share_name}/baked/storm-wisps.png'
    bake_blur[ tile, path '../{share_name}/baked/storm-wisps.png', 5 ]
    fp : path '../{share_name}/baked/storm-flow.png'
    bake_flow[ 1672, 941, fp ]
    names : vec string [] [ 'NeptuneStorm' ]
    dir   : path '../{share_name}/thumbs'
    scene_thumbs_for[ names, dir ]
