extend hyperspace

import <stdio.h>
import <stdlib.h>

# hyperspace's drawer: its apps, the same module on a view
MenuSource HyperspaceApps
    func entries [] -> vec TrayEntry
        return vec TrayEntry []

    func launches [] -> vec string
        return vec string [] [ 'record\t--as HsRecord',
            'gaze\t--as HsGaze', 'edges\t--as HsEdges',
            'negatives\t--as HsNegatives', 'hands\t--as HsHands',
            'point\t--as HsPoint',
            'testbed\t--as HsTestbed', 'training\t--as HsTraining',
            'annotate\t--as HsAnnotate',
            'hand boxes\t--as HsHandBox',
            'recordings\t--as HsRecordings' ]

expect func t_hs_apps [] -> bool
    apps : HyperspaceApps []
    ls : vec string apps.launches*[]
    return ls.count == 11 && ls[ 0 ].starts_with[ 'record\t' ]
