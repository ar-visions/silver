export software ['developer']
# a service: the gaze on, for every app that says export gaze
export serves ['--view gaze']
export panels ['HyperspacePanel']
export menus ['HyperspaceApps']
export contains ['.local/state/hyperspace']
export cameras ['v4l2']
# its training, run by name from this folder (in orbiter, orbiter
# runs the line)
export jobs [
    'eyes ../install/bin/hytrain --hidden true --eyes true',
    'gaze ../install/bin/hytrain --hidden true --gaze true --steps 24000 --slew 0.2 --camera 1',
    'hands ../install/bin/hytrain --hidden true --hands true --epochs 30 --size 8000 --batch 64',
    'point ../install/bin/hytrain --hidden true --point true --epochs 30 --size 8000 --batch 64',
    'handfind ../install/bin/hytrain --hidden true --handfind true --epochs 30 --size 8000 --batch 64']

import vec
import img
import trinity
import devices
ifndef [ windows ]
    import <signal.h>
import tray

import Mounts
import Menus
import Panel
import Eyes
import Jobs
import Recordings
import hand

# the app's storage, one folder for the app and its panel: in its
# view (a hosted slot) its own home's; drawn by orbiter (the panel),
# that same home under install, not the user's own
# the record dot's time from one point to the next, in ms
MOVE_MS : i64 [ 1600 ]
# gaze's: 80 points at 7.5 s each, ten minutes
GAZE_MOVE_MS : i64 [ 6400 ]
# the record run's times round the grid
ROUNDS : i32 [ 4 ]
# edges: the dot this far in from the screen's sides, a share of it,
# once round them at one speed in this many ms
EDGE_IN : f32 [ 0.02 ]
EDGE_MS : i64 [ 120000 ]
# negatives: each prompt held this long, captured from this far in
# (time to act it out), every prompt this many times in all
NEG_MS : i64 [ 8000 ]
NEG_SETTLE_MS : i64 [ 1500 ]
NEG_ROUNDS : i32 [ 2 ]

# negatives: each one's label (kept as the capture's gesture) and
# its prompt
func hs_neg_keys [] -> vec string
    return vec string [] [ 'hand_left', 'hand_right', 'hand_both',
        'hair', 'shut', 'away', 'chin' ]

func hs_neg_says [] -> vec string
    return vec string [] [ 'cover your left eye with your hand',
        'cover your right eye with your hand',
        'cover both eyes with your hands',
        'let your hair fall over your eyes',
        'close your eyes', 'look away from the screen',
        'rest your chin on your hand, look at the screen' ]

# a prompt run's labels and words: negatives' or gestures'
func hs_prompt_keys [ route: string ] -> vec string
    if [ route == 'gestures' ] return vec string [] [ 'pose' ]
    return hs_neg_keys[]

func hs_prompt_says [ route: string ] -> vec string
    if [ route == 'gestures' ]
        return vec string [] [ 'copy this hand, then hold it still' ]
    return hs_neg_says[]

func hs_dir [] -> path
    d : path path.path_storage[ 'hyperspace' ]
    if [ !getenv[ 'SILVER_APP_SLOT' ] ]
        home : string '{path.path_install[]}/home/hyperspace'
        d = path '{home}/.local/state/hyperspace'
    if [ !d.exists[] ] d.make_dir[]
    return d

func hs_records [] -> path
    d : path '{hs_dir[]}/records'
    if [ !d.exists[] ] d.make_dir[]
    return d

# words on the canvas, the panels' font
func hs_text [ cv: Canvas, s: string, x: f32, y: f32, w: f32,
               h: f32, size: f32, color: string ]
    fr : string 'fonts/BarlowCondensed-Regular.ttf'
    cv.set_font[ shared_font[ cv, fr, label_px[ cv, size ] ] ]
    cv.fill_color[ rgba [ color ] ]
    cv.draw_text[ s, rect [ x: x, y: y, w: w, h: h ],
        vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip,
        null, true ]
    cv.paint[]

func hs_models [] -> path
    d : path '{hs_dir[]}/models'
    if [ !d.exists[] ] d.make_dir[]
    return d

element hyperspace : trinity
    width  : i32 [ 640 ]
    height : i32 [ 360 ]
    public title : string [ 'hyperspace' ]
    public [ Launch ] cameras : string [ '/dev/video0' ]
    # record (the dot), testbed (the cameras), training, annotate,
    # or gaze (the service: no picture, the gaze sent to orbiter)
    public [ Launch ] view : string [ 'testbed' ]
    # record's folder: records (the eye nets' data) or gaze
    public [ Launch ] into : string [ 'records' ]
    # record's dot: grid (over the screen), edges (round its sides)
    # or negatives (prompts, no dot)
    public [ Launch ] route : string [ 'grid' ]
    # orbiter's socket (it runs the training jobs for this app)
    public [ Launch ] opener : string
    # the app that started this one for itself (its pid): when it
    # ends, so does this
    public [ Launch ] owner : i32
    intern owner_seen : i64
    # other apps alone using this one ('join <pid> <socket>'): each
    # gets the gaze; it ends once the owner and all of them have
    intern joined : vec string
    intern devices : vec string
    intern rig : HsRig
    intern command_at : i64
    intern pending : vec string
    intern capture_at : i64
    intern last_poll : i64
    intern rig_at : i64
    # record: the dot's points (x, y as 0 to 1 shares of the
    # screen), the one it goes to, when it left the last
    intern points : vec f32
    intern at : i32
    intern left_us : i64
    intern taken : i32
    # this record run's session: when it began (ms)
    intern session : i64
    # the captures this record run made (their ids)
    intern rec_ids : vec string
    # gaze: the first camera's lit frame last captured
    intern shot_at : i64
    intern cancelled : bool
    # gestures: recording this pose (a press starts and ends it),
    # since when (us)
    intern g_on : bool
    intern g_rec_us : i64
    # Escape gave the screen back: the run goes on in its window
    intern left_full : bool
    # the view left_full was set in (another view goes full again)
    intern full_view : string
    intern full_on : bool
    # annotate: the frames (names under the app's storage), the one
    # shown, its clicks so far (x, y as shares of the picture)
    intern ann_files : vec string
    intern ann_i : i32
    intern ann_clicks : vec f32
    intern ann_img : Image
    intern ann_tex : Texture
    intern ann_rect : rect
    intern ann_done : i32
    # hand boxes: the bottom camera's hand frames, mixed across the
    # sessions; the one shown, and the drag (its middle where it
    # began, its half side to the pointer, shares of the picture)
    intern hb_files : vec string
    intern hb_i : i32
    intern hb_done : i32
    intern hb_img : Image
    intern hb_tex : Texture
    intern hb_rect : rect
    intern hb_drag : bool
    intern hb_x : f32
    intern hb_y : f32
    intern hb_half : f32
    # testbed: the gaze from both cameras
    intern hub : GazeHub
    # recordings: the list as last read (again after a delete), and
    # the trash's captures
    intern recs : vec HsSession
    intern trash_n : i64
    # a click arrives twice: a delete takes the first alone
    intern del_ms : i64
    intern job_ms : i64
    # Train all: the jobs still to run in turn, the one running, and
    # when it was asked for (orbiter starts it a moment later)
    intern all_left : vec string
    intern all_now : string
    intern all_ms : i64
    # a fixed dot for checking the testbed's placement: the monitor's
    # -0.5..0.5, shown until aim_until (ms)
    intern aim_x : f32
    intern aim_y : f32
    intern aim_until : i64
    # the gaze as last sent ('x y', 'none'), and when
    intern gaze_sent : string
    intern gaze_sent_at : i64
    # when sends to the opener began failing (ms), 0 while they work
    intern gaze_lost_at : i64
    # the head's answer last sent (its count)
    intern head_sent : i32

    func ann_dir [] -> path
        d : path '{hs_dir[]}/annotate'
        if [ !d.exists[] ] d.make_dir[]
        return d

    # the frames to mark: the annotate folder's, then the records';
    # those already in points.txt left out
    func ann_start []
        done : vec string []
        pf : path '{ann_dir[]}/points.txt'
        if [ pf.exists[] ]
            tx : string pf.load[ typeid[ string ], null ]
            if [ tx ]
                for [ ln: string ] in tx.split[ '\n' ]
                    ws : vec string ln.trim[].split[ ' ' ]
                    if [ ws.count > 1 ] done.push[ ws[ 0 ] ]
        ann_done = i32[ done.count ]
        ann_files = vec string []
        subs : vec string [] [ 'annotate', 'records' ]
        for [ sub: string ] in subs
            d : path '{hs_dir[]}/{sub}'
            if [ !d.exists[] ] continue
            for [ f: path ] in d.ls[ null, false ]
                if [ f.ext[] != 'png' ] continue
                nm : string '{sub}/{f.filename[]}'
                seen : bool [ false ]
                for [ dn: string ] in done
                    if [ dn == nm ] seen = true
                if [ !seen ] ann_files.push[ nm ]
        ann_i = 0
        ann_load[]

    # the shown frame's picture; one that does not load is passed
    func ann_load []
        ann_clicks = vec f32 []
        ann_img = null
        ann_tex = null
        while [ ann_i < ann_files.count ]
            im : Image [ uri: path '{hs_dir[]}/{ann_files[ ann_i ]}' ]
            if [ im && im.width > 0 ]
                ann_img = im
                return
            ann_i += 1

    # a line of points.txt: the frame, then its left and right outer
    # corners and left and right eye centers, in its pixels (as seen
    # on the screen); or the frame and 'skip'
    func ann_save [ skip: bool ]
        pf : path '{ann_dir[]}/points.txt'
        old : string ''
        if [ pf.exists[] ] old = pf.load[ typeid[ string ], null ]
        nm : string ann_files[ ann_i ]
        line : string '{nm} skip'
        if [ !skip ]
            w : f32 [ ann_img.width ]
            h : f32 [ ann_img.height ]
            c : vec f32 ann_clicks
            line = '{nm} {c[0] * w} {c[1] * h} {c[6] * w} {c[7] * h} '
                + '{c[2] * w} {c[3] * h} {c[4] * w} {c[5] * h}'
        pf.save[ '{old}{line}\n', null ]
        ann_done += 1
        ann_i += 1
        ann_load[]

    func rig_use [ next: HsRig ]
        rig = next
        devices = vec string []
        for [ mount: HsMount ] in rig.mounts
            devices.push[ hs_camera_node[ mount.device ] ]
        pristine = false
        if [ ux ] ux.restyle = true

    func init []
        animated = true
        # seen by no one, its cameras still need every frame
        if [ view == 'gaze' ] unseen_full_rate = true
        rig_use[ hs_rig_load[ cameras ] ]
        file : path '{hs_dir[]}/mounts.agi'
        if [ file.exists[] ] rig_at = file.modified_time[]

    func rig_poll []
        file : path '{hs_dir[]}/mounts.agi'
        if [ !file.exists[] ] return
        at : i64 file.modified_time[]
        if [ at == rig_at ] return
        rig_at = at
        rig_use[ hs_rig_load[ cameras ] ]

    func command_poll []
        now : i64 epoch_millis[]
        if [ now - last_poll < 100 ] return
        last_poll = now
        f : path '{hs_dir[]}/command.agi'
        if [ !f.exists[] ] return
        at : i64 f.modified_time[]
        if [ at == command_at ] return
        command_at = at
        tx : string f.load[ typeid[ string ], null ]
        if [ !tx ] return
        fields : vec string tx.trim[].split[ "\t" ]
        if [ fields.count < 10 || fields[ 0 ] != 'capture' ]
            return
        pending = fields
        capture_at = now + 600

    func camera_view [ i: i32 ] -> CameraView
        if [ !elements ] return null
        return cast CameraView [ elements[ 'camera{i}' ] ]

    # where this record run saves
    func rec_dir [] -> path
        d : path '{hs_dir[]}/{into}'
        if [ !d.exists[] ] d.make_dir[]
        return d

    func capture []
        if [ !pending || pending.count < 10 ] return
        id : i64 epoch_millis[]
        recs : path rec_dir[]
        for [ i: i32 0, i < devices.count, i += 1 ]
            cv : CameraView camera_view[ i ]
            if [ !cv ] return
            pic : path '{recs}/{id}-camera{i}.png'
            if [ !cv.save_frame[ pic ] ] return
        tx :
            'source=user session={session} cameras={devices.count} '
            + 'screen_width_m={rig.screen_width_m} '
            + 'screen_height_m={rig.screen_height_m} '
            + 'target_x={pending[1]} target_y={pending[2]} '
            + 'gesture={pending[3]} gesture_scale={pending[4]} '
            + 'left_hand_x={pending[5]} '
            + 'left_hand_y={pending[6]} '
            + 'left_hand_scale={pending[7]} '
            + 'right_hand_x={pending[8]} '
            + 'right_hand_y={pending[9]} '
            + 'right_hand_scale='
            + ((pending.count > 10) ? pending[10] : '-1')
        for [ i: i32 0, i < rig.mounts.count, i += 1 ]
            mount : HsMount rig.mounts[i]
            tx += ' camera_device{i}={mount.device}'
                + ' camera_x_m{i}={mount.x_m}'
                + ' camera_y_m{i}={mount.y_m}'
                + ' camera_z_m{i}={mount.z_m}'
                + ' camera_tilt_deg{i}={mount.tilt_deg}'
                + ' camera_fov_deg{i}={mount.fov_deg}'
        f : path '{recs}/{id}.agi'
        f.save[ '{tx}\n', null ]
        if [ !rec_ids ] rec_ids = vec string []
        rec_ids.push[ '{id}' ]
        log 'hyperspace: captured {devices.count} camera images'
        pending = null

    func on_frame [ w: Window ]
        owner_check[]
        rig_poll[]
        command_poll[]
        if [ view == 'record' ] record_step[]
        if [ view == 'gaze' && hub ]
            hub.step[]
            hub.ease[ w.frame_factor ]
            if [ hub.has ] gaze_send[ '{hub.x} {hub.y}' ]
            el gaze_send[ 'none' ]
            head_send[]
        all_step[]
        # record takes the whole screen while its dot runs, the
        # testbed always (its dot plotted as record's is)
        n : i32 [ (points) ? i32[ points.count ] / 2 : 0 ]
        if [ full_view != view ]
            full_view = view
            left_full = false
        on : bool [ !left_full && ((view == 'record' && !cancelled
                    && (n == 0 || at < n)) || view == 'testbed') ]
        if [ ux && on != full_on ]
            full_on = on
            ux.set_fullscreen[ on ]
        if [ pending && epoch_millis[] >= capture_at ]
            capture[]
            taken += 1

    # Train all: the next job once the last has ended (a job that
    # failed or was stopped by hand: the rest go on)
    func all_step []
        if [ !all_left ] return
        if [ all_now && all_now.count > 0 ]
            if [ epoch_millis[] - all_ms < 3000 ] return
            if [ hs_job_state[ all_now ] == 'running' ] return
        if [ all_left.count == 0 ]
            all_left = null
            all_now = ''
            log 'hyperspace: every job run'
            if [ ux ] ux.restyle = true
            return
        all_now = all_left[ 0 ]
        rest : vec string []
        for [ i: i64 1, i < all_left.count, i += 1 ]
            rest.push[ all_left[ i ] ]
        all_left = rest
        all_ms = epoch_millis[]
        log 'hyperspace: Train all: {all_now}'
        hs_job_go[ all_now, opener ]
        if [ ux ] ux.restyle = true

    # record's menu: Cancel stops this run and deletes what it took
    action func cancel []
        if [ view != 'record' ] return
        n : i32 [ 0 ]
        if [ rec_ids ]
            recs : path rec_dir[]
            for [ id: string ] in rec_ids
                for [ i: i32 0, i < devices.count, i += 1 ]
                    pic : path '{recs}/{id}-camera{i}.png'
                    if [ pic.exists[] ] pic.remove[]
                ag : path '{recs}/{id}.agi'
                if [ ag.exists[] ] ag.remove[]
                n += 1
        log 'hyperspace: recording cancelled, {n} captures deleted'
        rec_ids = vec string []
        pending = null
        taken = 0
        if [ points ] at = i32[ points.count ] / 2
        cancelled = true
        if [ ux ] ux.restyle = true

    # ROUNDS times a 5 by 4 grid over the screen: each round in a
    # new order, the whole grid nudged up to 3% of the screen, so no
    # round's stops are the last's
    func record_start []
        points = vec f32 []
        seed : i64 epoch_millis[]
        if [ route == 'edges' ] edge_points[]
        if [ route == 'gestures' ] pose_points[ seed ]
        el [ prompted[] ] neg_points[ seed ]
        grid_run : bool [ route == 'grid' || route == 'point' ]
        for [ rd: i32 0, rd < ROUNDS && grid_run, rd += 1 ]
            seed = (seed * 1103515245 + 12345) % 2147483648
            nx : f32 [ f32[ seed % 61 ] / 1000.0 - 0.03 ]
            seed = (seed * 1103515245 + 12345) % 2147483648
            ny : f32 [ f32[ seed % 61 ] / 1000.0 - 0.03 ]
            grid : vec f32 []
            for [ r: i32 0, r < 4, r += 1 ]
                for [ c: i32 0, c < 5, c += 1 ]
                    grid += 0.08 + f32[ c ] * 0.21 + nx
                    grid += 0.1 + f32[ r ] * 0.2667 + ny
            n : i32 [ i32[ grid.count ] / 2 ]
            for [ i: i32 n - 1, i > 0, i -= 1 ]
                seed = (seed * 1103515245 + 12345) % 2147483648
                j : i32 [ i32[ seed % i64[ i + 1 ] ] ]
                for [ k: i32 0, k < 2, k += 1 ]
                    t : f32 grid[ i * 2 + k ]
                    grid[ i * 2 + k ] = grid[ j * 2 + k ]
                    grid[ j * 2 + k ] = t
            for [ v: f32 ] in grid
                points += v
        at = 0
        taken = 0
        session = epoch_millis[]
        rec_ids = vec string []
        left_us = epoch_micros[]

    # negatives: a stop a prompt, each round in a new order; a stop's
    # x the prompt's number
    func neg_points [ start: i64 ]
        seed : i64 start
        n : i32 [ i32[ hs_prompt_keys[ route ].count ] ]
        for [ rd: i32 0, rd < NEG_ROUNDS, rd += 1 ]
            order : vec i32 []
            for [ i: i32 0, i < n, i += 1 ] order += i
            for [ i: i32 n - 1, i > 0, i -= 1 ]
                seed = (seed * 1103515245 + 12345) % 2147483648
                j : i32 [ i32[ seed % i64[ i + 1 ] ] ]
                t : i32 order[ i ]
                order[ i ] = order[ j ]
                order[ j ] = t
            for [ v: i32 ] in order
                points += f32[ v ]
                points += 0.0

    # gestures: the hand course (hand_course_names), each pose once,
    # with either hand: an entry's x its place in the course
    func pose_points [ start: i64 ]
        n : i32 [ i32[ hand_course_names[].count ] ]
        for [ i: i32 0, i < n, i += 1 ]
            points += f32[ i ]
            points += 0.0

    # edges: one stop for the run's count; the dot's place is by time
    func edge_points []
        points += 0.5
        points += 0.5

    # edges: the dot's place on its way round the sides, clockwise
    # from the top left, the same pixels a second all the way
    func edge_at [] -> vec2f
        lo : f32 EDGE_IN
        span : f32 [ 1.0 - 2.0 * EDGE_IN ]
        bw : f32 [ (bounds && bounds.w > 0.0) ? bounds.w : 1.0 ]
        bh : f32 [ (bounds && bounds.h > 0.0) ? bounds.h : 1.0 ]
        # each side's length in pixels; the share of the run gone
        sw : f32 [ span * bw ]
        sh : f32 [ span * bh ]
        f : f32 [ f32[ epoch_micros[] - left_us ]
                  / (f32[ EDGE_MS ] * 1000.0) ]
        d : f32 [ min[ max[ f, 0.0 ], 1.0 ] * 2.0 * (sw + sh) ]
        if [ d < sw ] return vec2f [ lo + d / bw, lo ]
        d -= sw
        if [ d < sh ] return vec2f [ lo + span, lo + d / bh ]
        d -= sh
        if [ d < sw ] return vec2f [ lo + span - d / bw, lo + span ]
        d -= sw
        return vec2f [ lo, lo + span - d / bh ]

    # each point: MOVE_MS to it, then still. record takes one frame
    # 0.6 s into the stop; gaze every lit frame, the dot moving too
    func record_step []
        if [ !points ] record_start[]
        if [ at >= points.count / 2 ] return
        if [ pressed[] ]
            gesture_step[]
            return
        el_ms : i64 [ (epoch_micros[] - left_us) / 1000 ]
        mv : i64 move_ms[]
        cam : CameraView camera_view[ 0 ]
        # the eyes (or the pointing hand) start after the dot: none
        # in the first 0.2 s
        if [ follows[] && cam && cam.camera && !pending
             && el_ms >= 200 && cam.camera.taken != shot_at ]
            shot_at = cam.camera.taken
            d : vec2f dot_at[]
            take_at[ d.x, d.y, 0 ]
            # point_at: not the old 'point' pose (index out)
            if [ route == 'point' ] pending[ 3 ] = 'point_at'
        el [ prompted[] ]
            # every lit frame once the prompt has been acted out
            if [ cam && cam.camera && !pending && el_ms >= NEG_SETTLE_MS
                 && cam.camera.taken != shot_at ]
                shot_at = cam.camera.taken
                take_at[ -1.0, -1.0, 0 ]
                pending[ 3 ] =
                    hs_prompt_keys[ route ][ i32[ points[ at * 2 ] ] ]
        el [ !follows[] && el_ms >= mv && !pending
             && el_ms < mv + 100 ]
            ask_capture[ 600 ]
        # edges: one run round the sides, at its end the last stop
        done : bool [ (route == 'edges') ? el_ms >= EDGE_MS
                      : (prompted[]) ? el_ms >= NEG_MS
                      : el_ms >= mv + 1100 ]
        if [ done ]
            at += 1
            # the last point: the cameras close (render again)
            if [ at >= points.count / 2 && ux ] ux.restyle = true
            left_us = epoch_micros[]

    # every lit frame while a pose records, labelled with the pose;
    # its target where on the screen the hand was shown (0 to 1)
    func gesture_step []
        if [ !g_on ] return
        cam : CameraView camera_view[ 0 ]
        if [ !cam || !cam.camera || pending
             || cam.camera.taken == shot_at ]
            return
        shot_at = cam.camera.taken
        d : vec2f hand_place[]
        take_at[ d.x, d.y, 0 ]
        pending[ 3 ] = prompt_key[]
        # the pose's name in the course (hand_course makes it again)
        if [ route == 'gestures' ]
            pending[ 4 ] = course_name[]

    # the shown entry's pose in the hand course
    func course_name [] -> string
        names : vec string hand_course_names[]
        return names[ i32[ points[ at * 2 ] ] ]

    # the shown prompt's label: gestures', the pose; else its key
    func prompt_key [] -> string
        if [ route == 'gestures' ] return 'pose'
        return hs_prompt_keys[ route ][ i32[ points[ at * 2 ] ] ]

    # the shown hand's place (shares of the screen): one spot
    func hand_place [] -> vec2f
        return vec2f [ 0.3, 0.52 ]

    # a press: the shown pose starts recording, or ends and the next
    # one shows
    func gesture_press []
        n : i32 [ (points) ? i32[ points.count ] / 2 : 0 ]
        if [ view != 'record' || !pressed[] || at >= n ]
            return
        if [ !g_on ]
            g_on = true
            g_rec_us = epoch_micros[]
            return
        g_on = false
        at += 1
        if [ at >= n && ux ] ux.restyle = true

    # the pose's armature: bones from each joint to its parent, the
    # joints as dots; turning about its up, seen 20
    # degrees from above, the near parts thicker and brighter; the
    # wrist at x y
    func draw_hand [ cv: Canvas, pose: HandPose, x: f32, y: f32,
                     size: f32, touch: bool, left: bool ]
        pts : vec f32 hand_points[ pose ]
        par : vec i32 hand_parents[]
        # turning round its up once each 8 s, so every side shows
        tu : i64 [ epoch_millis[] % 8000 ]
        spin : f32 [ f32[ tu ] / 8000.0 * 6.2831853 ]
        cs : f32 [ cos[ spin ] ]
        ss : f32 [ sin[ spin ] ]
        ct : f32 [ cos[ 0.35 ] ]
        st : f32 [ sin[ 0.35 ] ]
        # the hand's middle turns in place, not the wrist
        my : f32 [ 0.08 ]
        sx : vec f32 []
        sy : vec f32 []
        sz : vec f32 []
        for [ i: i32 0, i < par.count, i += 1 ]
            # the left hand the right's mirror
            px : f32 [ (left) ? 0.0 - pts[ i * 3 ] : pts[ i * 3 ] ]
            py : f32 [ pts[ i * 3 + 1 ] - my ]
            pz : f32 pts[ i * 3 + 2 ]
            rx : f32 [ px * cs + pz * ss ]
            rz : f32 [ pz * cs - px * ss ]
            ty : f32 [ py * ct - rz * st ]
            tz : f32 [ rz * ct + py * st ]
            sx += x + rx * size
            sy += y - ty * size
            sz += tz
        # the hand's colour: teal the left, violet the right, full
        # with its palm to us, grey as its back turns to us
        face : f32 [ min[ max[ 0.5 + 0.7 * cs, 0.0 ], 1.0 ] ]
        hr : f32 [ (left) ? 0.29 : 0.5 ]
        hg : f32 [ (left) ? 0.84 : 0.42 ]
        hb : f32 [ (left) ? 0.78 : 1.0 ]
        hr = 0.42 + (hr - 0.42) * face
        hg = 0.42 + (hg - 0.42) * face
        hb = 0.46 + (hb - 0.46) * face
        cv.fill_color[ rgba [ '#0000' ] ]
        cv.set_stroke_cap[ Cap.round ]
        # the palm's edge across the knuckles, under the bones
        cv.stroke_color[ rgba [ r: hr, g: hg, b: hb, a: 0.45 ] ]
        cv.stroke_width[ 3.0 ]
        knuckles : vec i32 [] [ 1, 5, 9, 13, 17 ]
        cv.move_to[ sx[ 1 ], sy[ 1 ] ]
        for [ kn: i32 ] in knuckles
            cv.line_to[ sx[ kn ], sy[ kn ] ]
        cv.paint[]
        # far bones first: the near ones over them
        order : vec i32 []
        for [ i: i32 1, i < par.count, i += 1 ] order += i
        for [ i: i32 1, i < order.count, i += 1 ]
            for [ j: i32 i, j > 0, j -= 1 ]
                ja : i32 order[ j - 1 ]
                jb : i32 order[ j ]
                da : f32 [ sz[ ja ] + sz[ par[ ja ] ] ]
                db : f32 [ sz[ jb ] + sz[ par[ jb ] ] ]
                if [ da <= db ] break
                order[ j - 1 ] = jb
                order[ j ] = ja
        for [ i: i32 ] in order
            near : f32 [ min[ max[ (sz[ i ] + sz[ par[ i ] ]) * 5.0
                                   + 0.5, 0.0 ], 1.0 ] ]
            al : i32 [ i32[ 90.0 + 165.0 * near ] ]
            cv.stroke_color[ rgba [ r: hr, g: hg, b: hb,
                                    a: f32[ al ] / 255.0 ] ]
            cv.stroke_width[ 4.0 + 6.0 * near ]
            cv.move_to[ sx[ par[ i ] ], sy[ par[ i ] ] ]
            cv.line_to[ sx[ i ], sy[ i ] ]
            cv.paint[]
            cv.stroke_color[ rgba [ '#0000' ] ]
            cv.fill_color[ rgba [ r: 1.0, g: 1.0, b: 1.0,
                                  a: 0.4 + 0.5 * near ] ]
            cv.arc[ sx[ i ], sy[ i ], 3.0 + 3.0 * near, 0.0, 6.2832 ]
            cv.paint[]
            cv.fill_color[ rgba [ '#0000' ] ]
        # thumb and index tips touching: the touch drawn
        if [ touch ]
            cv.stroke_color[ rgba [ '#ffcf4a' ] ]
            cv.stroke_width[ 5.0 ]
            cv.move_to[ sx[ 4 ], sy[ 4 ] ]
            cv.line_to[ sx[ 8 ], sy[ 8 ] ]
            cv.paint[]
            cv.stroke_color[ rgba [ '#0000' ] ]
            cv.fill_color[ rgba [ '#ffcf4a' ] ]
            mid_x : f32 [ (sx[ 4 ] + sx[ 8 ]) * 0.5 ]
            mid_y : f32 [ (sy[ 4 ] + sy[ 8 ]) * 0.5 ]
            cv.arc[ mid_x, mid_y, 6.0, 0.0, 6.2832 ]
            cv.paint[]
            cv.fill_color[ rgba [ '#0000' ] ]
        if [ ux ] ux.will_animate = true

    # gestures' screen: the pose to make, what to do, the pad
    func draw_gesture [ cv: Canvas ]
        key : string prompt_key[]
        say : string hs_prompt_says[ route ][ 0 ]
        n : i32 [ i32[ points.count ] / 2 ]
        pose : HandPose hand_gesture[ 'open' ]
        if [ key == 'pose' ]
            pose = hand_course[ course_name[] ]
        if [ key != 'none' ]
            p : vec2f hand_place[]
            draw_hand[ cv, pose, bounds.w * p.x, bounds.h * p.y,
                bounds.h * 2.4, key == 'pinch' || key == 'ok', false ]
        hs_text[ cv, say, bounds.w * 0.08, bounds.h * 0.1,
            bounds.w * 0.5, 50.0, 32.0, '#ffffffd0' ]
        word : string 'make the pose    space or click: start'
        if [ g_on ]
            word = 'recording: hold the pose' + '    space: next'
        hs_text[ cv, word, bounds.w * 0.08, bounds.h * 0.9,
            bounds.w * 0.84, 30.0, 20.0,
            (g_on) ? '#ff8a8ae0' : '#ffffffa0' ]
        hs_text[ cv, '{route}   {at + 1} / {n}', 20.0, 16.0, 600.0,
            24.0, 17.0, '#ffffff80' ]

    # a run of prompts (no dot): negatives or gestures
    func prompted [] -> bool
        return route == 'negatives' || pressed[]

    # a run whose poses start and end by a press: gestures
    func pressed [] -> bool
        return route == 'gestures'

    # every lit frame taken as the dot moves: gaze (looked at) and
    # point (pointed at)
    func follows [] -> bool
        return into == 'gaze' || route == 'point'

    # the dot's time from point to point
    func move_ms [] -> i64
        return (follows[]) ? GAZE_MOVE_MS : MOVE_MS

    # a capture of the dot's point, after_ms from now
    func ask_capture [ after_ms: i64 ]
        take_at[ points[ at * 2 ], points[ at * 2 + 1 ], after_ms ]

    # a capture with the dot at (x, y), after_ms from now
    func take_at [ x: f32, y: f32, after_ms: i64 ]
        pending = vec string [] [ 'capture', '{x}', '{y}', 'none', '1',
            '-1', '-1', '-1', '-1', '-1', '-1' ]
        capture_at = epoch_millis[] + after_ms

    # the dot's place now, eased from the last point to this one
    func dot_at [] -> vec2f
        if [ route == 'edges' ] return edge_at[]
        n : i32 [ i32[ points.count ] / 2 ]
        k : i32 [ min[ at, n - 1 ] ]
        if [ k < 0 ] return vec2f [ 0.5, 0.5 ]
        p : vec2f [ points[ k * 2 ], points[ k * 2 + 1 ] ]
        if [ k == 0 || at >= n ] return p
        q : vec2f [ points[ k * 2 - 2 ], points[ k * 2 - 1 ] ]
        f : f32 [ min[ f32[ epoch_micros[] - left_us ]
            / (f32[ move_ms[] ] * 1000.0), 1.0 ] ]
        # eased in and out with no jolt: its speed and its change
        # of speed both start and end at nothing
        f = f * f * f * (f * (f * 6.0 - 15.0) + 10.0)
        return vec2f [ q.x + (p.x - q.x) * f, q.y + (p.y - q.y) * f ]

    # the testbed's dot fixed at a point (-0.5..0.5 from the view's
    # middle) for 10 s, in place of the gaze: its placement checked
    action func aim [ x: f32, y: f32 ]
        aim_x = x
        aim_y = y
        aim_until = epoch_millis[] + 10000

    # testbed: the gaze as a dot where the eyes look, the model's
    # -0.5 to 0.5 over the view (full screen, as record's dot)
    func gaze_draw [ w: Window, cv: Canvas ]
        cv.fill_color[ rgba [ '#050508' ] ]
        cv.rect_to[ 0.0, 0.0, bounds.w, bounds.h ]
        cv.paint[]
        point_draw[ cv ]
        if [ !hub ] return
        hub.step[]
        hub.ease[ w.frame_factor ]
        if [ hub.missing ]
            gaze_send[ 'none' ]
            hs_text[ cv, 'no gaze model: train gaze', 20.0,
                16.0, 600.0, 24.0, 17.0, '#ffffff80' ]
            return
        gx : f32 hub.x
        gy : f32 hub.y
        aiming : bool [ epoch_millis[] < aim_until ]
        if [ aiming ]
            gx = aim_x
            gy = aim_y
        el [ !hub.has ]
            gaze_send[ 'none' ]
            return
        gaze_send[ '{gx} {gy}' ]
        x : f32 [ floor[ (gx + 0.5) * bounds.w ] ]
        y : f32 [ floor[ (gy + 0.5) * bounds.h ] ]
        if [ x < 0.0 || y < 0.0 || x > bounds.w || y > bounds.h ] return
        cv.fill_color[ rgba [ '#806bff60' ] ]
        cv.arc[ x, y, 22.0, 0.0, 6.2832 ]
        cv.paint[]
        cv.fill_color[ rgba [ '#ffffff' ] ]
        cv.arc[ x, y, 5.0, 0.0, 6.2832 ]
        cv.paint[]

    # another app alone uses this one: 'join <pid> <its socket>'
    public func on_agent [ s: string ]
        ws : vec string s.trim[].split[ ' ' ]
        if [ ws.count < 3 || ws[ 0 ] != 'join' ] return
        jn : string '{ws[ 1 ]} {ws[ 2 ]}'
        if [ !joined ] joined = vec string []
        if [ joined.index_of[ jn ] >= 0 ] return
        joined.push[ jn ]
        gaze_sent = null
        log 'hyperspace: {ws[ 1 ]} joined ({ws[ 2 ]})'

    # the apps using this one gone (checked each second): the
    # cameras go with the last of them
    func owner_check []
        if [ owner <= 0 ] return
        now : i64 epoch_millis[]
        if [ now - owner_seen < 1000 ] return
        owner_seen = now
        ifndef [ windows ]
            keep : vec string []
            if [ joined ]
                for [ jn: string ] in joined
                    jw : vec string jn.split[ ' ' ]
                    pw : string jw[ 0 ]
                    pid : i32 [ i32[ pw.integer_value[] ] ]
                    if [ kill[ pid, 0 ] == 0 ] keep.push[ jn ]
            joined = keep
            if [ kill[ owner, 0 ] != 0 && keep.count == 0 ]
                log 'hyperspace: its apps ended: so does this'
                exit[ 0 ]

    # a line to each app that joined
    func joined_send [ ln: string ]
        if [ !joined ] return
        for [ jn: string ] in joined
            ws : vec string jn.split[ ' ' ]
            if [ ws.count >= 2 ] agent_path_send[ ws[ 1 ].chars, ln.chars ]

    # the gaze to the opener ('x y' from the monitor's middle in
    # -0.5..0.5, or 'none'): orbiter hands it on to the apps that take
    # it; an app that started this one alone takes it itself. Sent on
    # a change, again every 2 s; the gaze service ends when no one is
    # there to take it
    func gaze_send [ words: string ]
        if [ !opener || opener.count == 0 ] return
        now : i64 epoch_millis[]
        if [ gaze_sent && gaze_sent == words
             && now - gaze_sent_at < 2000 ] return
        gaze_sent = words
        gaze_sent_at = now
        ln : string 'app system hyperspace {hs_slot[]} gaze {words}\n'
        joined_send[ ln ]
        if [ agent_path_send[ opener.chars, ln.chars ] != 0 ]
            gaze_lost_at = 0
            return
        # a busy opener refuses a send now and then: wait it out
        gaze_sent = null
        if [ gaze_lost_at == 0 ] gaze_lost_at = now
        # gone: 3 s with its socket's file gone, else a minute (one
        # still loading refuses for a while; a stale file stays)
        op : path [ opener ]
        wait : i64 [ (op.exists[]) ? 60000 : 3000 ]
        # an owner's end is owner_check's: others may still use it
        if [ view == 'gaze' && hs_slot[] <= 0 && owner <= 0
             && now - gaze_lost_at > wait ]
            log 'hyperspace: {opener} is gone: the gaze ends'
            exit[ 0 ]

    # the head's place from the top camera ('x y gap', each answer
    # once): orbiter hands it on to the apps that say export head
    func head_send []
        if [ !opener || opener.count == 0 ] return
        ev : EyeView [ cast EyeView [ camera_view[ 0 ] ] ]
        if [ !ev || ev.head_seen == head_sent ] return
        head_sent = ev.head_seen
        ln : string 'app system hyperspace {hs_slot[]} head '
            + '{ev.head_x} {ev.head_y} {ev.head_gap}\n'
        joined_send[ ln ]
        agent_path_send[ opener.chars, ln.chars ]

    # where the hand points (the bottom camera's point model), a
    # yellow dot on the screen
    func point_draw [ cv: Canvas ]
        ev : EyeView [ cast EyeView [ camera_view[ 1 ] ] ]
        if [ !ev || !ev.pt_on ] return
        x : f32 [ floor[ (ev.pt_x + 0.5) * bounds.w ] ]
        y : f32 [ floor[ (ev.pt_y + 0.5) * bounds.h ] ]
        cv.fill_color[ rgba [ '#ffcf4a50' ] ]
        cv.arc[ x, y, 22.0, 0.0, 6.2832 ]
        cv.paint[]
        cv.fill_color[ rgba [ '#ffcf4a' ] ]
        cv.arc[ x, y, 5.0, 0.0, 6.2832 ]
        cv.paint[]

    func render [] -> Elements
        e : Elements []
        # record's cameras close once its run is done or cancelled;
        # annotate and training need none
        rn : i32 [ (points) ? i32[ points.count ] / 2 : 0 ]
        done : bool [ cancelled || (rn > 0 && at >= rn) ]
        # recordings: a row each, newest first; ctrl / cmd shows every
        # row's Delete, shift the hovered row's
        if [ view == 'recordings' ]
            if [ !recs ]
                recs = hs_sessions[]
                trash_n = hs_trash_count[]
            all : bool [ ux && ux.cmd ]
            y : f32 [ 3.0 ]
            for [ i: i32 0, i < i32[ recs.count ], i += 1 ]
                was : cast element [ (elements) ? elements[ 'rec_{i}' ]
                                     : null ]
                e[ 'rec_{i}' ] = RecRow [ s: recs[ i ],
                    area: Region [ 'l1 t{y} r8 h1.3' ] ]
                if [ all || (ux && ux.shift && was && was.hovered) ]
                    e[ 'del_{i}' ] = RecDelete [ label: 'Delete',
                        area: Region [ 'r1 t{y} w6 h1.3' ] ]
                y += 1.5
            if [ trash_n > 0 && (all || (ux && ux.shift)) ]
                e[ 'trash_empty' ] = RecDelete [
                    label: 'Empty trash ({trash_n} captures)',
                    area: Region [ 'l1 t{y + 0.5} w12 h1.3' ] ]
            return e
        # training: a button a job (its Stop while it runs), and the
        # last job's words
        if [ view == 'training' ]
            x : f32 [ 1.0 ]
            e[ 'job_all' ] = PageButton [
                label: (all_left) ? 'Stop all' : 'Train all',
                area: Region [ 'l{x} t1 w6 h1.3' ] ]
            x += 7.5
            for [ jn: string ] in hs_job_names[]
                run : bool [ hs_job_state[ jn ] == 'running' ]
                e[ 'job_{jn}' ] = PageButton [
                    label: (run) ? 'Stop' : hs_job_label[ jn ],
                    area: Region [ 'l{x} t1 w6 h1.3' ] ]
                x += 6.5
            e[ 'joblog' ] = JobLog [ animated: true,
                area: Region { l1 t3 r1 b1 } ]
            return e
        if [ view == 'annotate' || view == 'handbox'
             || (view == 'record' && done) ]
            return e
        # record takes the frames but shows none; the service finds
        # the eyes and shows nothing
        show : bool [ view == 'testbed' ]
        eyes : bool [ show || view == 'gaze' ]
        n : i32 [ max[ i32[ devices.count ], 1 ] ]
        if [ eyes && !hub ] hub = GazeHub []
        for [ i: i32 0, i < devices.count, i += 1 ]
            # the testbed's cameras: side by side in the screen's
            # lower right quarter's corner, a quarter wide and high
            l : f32 [ 75.0 + 25.0 * f32[ i ] / f32[ n ] ]
            r : f32 [ 25.0 - 25.0 * f32[ i + 1 ] / f32[ n ] ]
            ar : string [ (show) ? 'l{l}% t75% r{r}% b0'
                                 : 'l0 t0 w1 h1' ]
            # the testbed's cameras find the eyes as they run
            if [ eyes ]
                e[ 'camera{i}' ] = EyeView [ device: devices[ i ],
                    animated: true, area: Region [ ar ], hub: hub,
                    slot: i, paint_off: !show ]
            el
                e[ 'camera{i}' ] = CameraView [
                    device: devices[ i ], animated: true,
                    paint_off: true, area: Region [ ar ] ]
        return e

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        cv : Canvas w.screen
        if [ view == 'annotate' ]
            ann_draw[ cv ]
            return
        if [ view == 'handbox' ]
            hb_draw[ cv ]
            return
        if [ view == 'testbed' ]
            gaze_draw[ w, cv ]
            return
        if [ view == 'recordings' ]
            cv.fill_color[ rgba [ '#050508' ] ]
            cv.rect_to[ 0.0, 0.0, bounds.w, bounds.h ]
            cv.paint[]
            n : i64 [ (recs) ? recs.count : 0 ]
            hs_text[ cv, '{n} recordings     hold ctrl / cmd to delete '
                + '(into the trash; empty it after)',
                20.0, 16.0, bounds.w - 40.0, 24.0, 17.0, '#ffffff80' ]
            return
        if [ view == 'record' ]
            cv.fill_color[ rgba [ '#050508' ] ]
            cv.rect_to[ 0.0, 0.0, bounds.w, bounds.h ]
            cv.paint[]
            n : i32 [ (points) ? i32[ points.count ] / 2 : 0 ]
            if [ at < n && pressed[] ]
                draw_gesture[ cv ]
            el [ at < n && prompted[] ]
                # the prompt, large; the time left on it as a bar
                say : string
                    hs_prompt_says[ route ][ i32[ points[ at * 2 ] ] ]
                hs_text[ cv, say, bounds.w * 0.15, bounds.h * 0.42,
                    bounds.w * 0.7, 60.0, 40.0, '#ffffffd0' ]
                gone : f32 [ f32[ (epoch_micros[] - left_us) / 1000 ]
                             / f32[ NEG_MS ] ]
                cv.fill_color[ rgba [ '#806bff' ] ]
                cv.rect_to[ bounds.w * 0.15, bounds.h * 0.42 + 70.0,
                    bounds.w * 0.7 * min[ gone, 1.0 ], 4.0 ]
                cv.paint[]
                hs_text[ cv, '{route}   {at + 1} / {n}',
                    20.0, 16.0, 600.0, 24.0, 17.0, '#ffffff80' ]
            el [ at < n ]
                # a 3 x 3 pixel dot on whole pixels, a slight edge
                # a pixel round it
                d : vec2f dot_at[]
                x : f32 [ floor[ d.x * bounds.w ] - 1.0 ]
                y : f32 [ floor[ d.y * bounds.h ] - 1.0 ]
                cv.fill_color[ rgba [ '#806bff' ] ]
                cv.rect_to[ x - 1.0, y - 1.0, 5.0, 5.0 ]
                cv.paint[]
                cv.fill_color[ rgba [ '#ffffff' ] ]
                cv.rect_to[ x, y, 3.0, 3.0 ]
                cv.paint[]
                say : string [ (route == 'point')
                    ? 'point at the dot' : 'look at the dot' ]
                hs_text[ cv, '{say}   {at + 1} / {n}',
                    20.0, 16.0, 600.0, 24.0, 17.0, '#ffffff80' ]
            el [ cancelled ]
                hs_text[ cv, 'recording cancelled: its frames deleted',
                    20.0, 16.0, 600.0, 24.0, 17.0, '#ffffff80' ]
            el
                hs_text[ cv, 'recorded {taken} frames: open training',
                    20.0, 16.0, 600.0, 24.0, 17.0, '#ffffff80' ]
        el [ view == 'training' ]
            cv.fill_color[ rgba [ '#050508' ] ]
            cv.rect_to[ 0.0, 0.0, bounds.w, bounds.h ]
            cv.paint[]

    # annotate: the frame as large as the window holds, the clicks
    # made on it, and what to click next
    func ann_draw [ cv: Canvas ]
        if [ !ann_files ] ann_start[]
        cv.fill_color[ rgba [ '#050508' ] ]
        cv.rect_to[ 0.0, 0.0, bounds.w, bounds.h ]
        cv.paint[]
        n : i32 [ i32[ ann_files.count ] ]
        if [ !ann_img ]
            hs_text[ cv, 'every frame marked: {ann_done} in '
                + 'annotate/points.txt', 20.0, 16.0, 800.0, 24.0,
                17.0, '#ffffff80' ]
            return
        if [ !ann_tex ]
            ann_tex = Texture [ vk: cv.vk, w: cv.w, sampler: ann_img,
                                linear: true ]
        iw : f32 [ ann_img.width ]
        ih : f32 [ ann_img.height ]
        k : f32 [ min[ bounds.w / iw, bounds.h / ih ] ]
        ann_rect = rect [ x: (bounds.w - iw * k) / 2.0,
                          y: (bounds.h - ih * k) / 2.0,
                          w: iw * k, h: ih * k ]
        cv.draw_image[ ann_tex, ann_rect ]
        cols : vec string [] [ '#ff4a4a', '#4aff6e', '#4aff6e',
                               '#ff4a4a' ]
        for [ i: i32 0, i < ann_clicks.count / 2, i += 1 ]
            x : f32 [ ann_rect.x + ann_clicks[ i * 2 ] * ann_rect.w ]
            y : f32 [ ann_rect.y + ann_clicks[ i * 2 + 1 ] * ann_rect.h ]
            cv.stroke_color[ rgba [ cols[ i ] ] ]
            cv.stroke_width[ 2.0 ]
            cv.fill_color[ rgba [ '#0000' ] ]
            cv.arc[ x, y, 7.0, 0.0, 6.2832 ]
            cv.paint[]
        steps : vec string [] [ 'left outer corner', 'left eye',
                                'right eye', 'right outer corner' ]
        at : i32 [ i32[ ann_clicks.count ] / 2 ]
        hs_text[ cv, 'click the {steps[ at ]}  ({at + 1} / 4)    '
            + 'frame {ann_i + 1} / {n}    backspace: undo    '
            + 'space: no eyes, pass',
            20.0, 16.0, bounds.w - 40.0,
            24.0, 17.0, '#ffffffc0' ]

    func hb_list [] -> path
        return path '{ann_dir[]}/hands.txt'

    # every hands camera1 frame not yet in hands.txt, taken a prime
    # apart so a few hundred cover every session and pose
    func hb_start []
        done : vec string []
        pf : path hb_list[]
        if [ pf.exists[] ]
            tx : string pf.load[ typeid[ string ], null ]
            if [ tx ]
                for [ ln: string ] in tx.split[ '\n' ]
                    ws : vec string ln.trim[].split[ ' ' ]
                    if [ ws.count > 1 ] done.push[ ws[ 0 ] ]
        hb_done = i32[ done.count ]
        all : vec string []
        d : path '{hs_dir[]}/hands'
        if [ d.exists[] ]
            for [ f: path ] in d.ls[ null, false ]
                nm : string f.filename[]
                if [ nm.ends_with[ '-camera1.png' ] ]
                    all.push[ 'hands/{nm}' ]
        n : i64 all.count
        step : i64 [ 7919 ]
        if [ n > 0 && n % step == 0 ] step = 7907
        hb_files = vec string []
        for [ i: i64 0, i < n, i += 1 ]
            nm : string all[ (i * step) % n ]
            seen : bool [ false ]
            for [ dn: string ] in done
                if [ dn == nm ] seen = true
            if [ !seen ] hb_files.push[ nm ]
        hb_i = 0
        hb_load[]

    func hb_load []
        hb_img = null
        hb_tex = null
        hb_drag = false
        while [ hb_i < hb_files.count ]
            im : Image [ uri: path '{hs_dir[]}/{hb_files[ hb_i ]}' ]
            if [ im && im.width > 0 ]
                hb_img = im
                return
            hb_i += 1

    # a line of hands.txt: the frame, its box's middle and side in
    # its pixels; or the frame and 'none'
    func hb_save [ none: bool ]
        pf : path hb_list[]
        old : string ''
        if [ pf.exists[] ] old = pf.load[ typeid[ string ], null ]
        nm : string hb_files[ hb_i ]
        line : string '{nm} none'
        if [ !none ]
            w : f32 [ hb_img.width ]
            h : f32 [ hb_img.height ]
            line = '{nm} {hb_x * w} {hb_y * h} {hb_half * 2.0 * w}'
        pf.save[ '{old}{line}\n', null ]
        hb_done += 1
        hb_i += 1
        hb_load[]

    # the last line taken back, its frame shown again
    func hb_undo []
        pf : path hb_list[]
        if [ !pf.exists[] || hb_i == 0 ] return
        tx : string pf.load[ typeid[ string ], null ]
        lines : vec string tx.trim[].split[ '\n' ]
        if [ lines.count == 0 ] return
        last : vec string lines[ lines.count - 1 ].split[ ' ' ]
        if [ last[ 0 ] != hb_files[ hb_i - 1 ] ] return
        keep : string ''
        for [ i: i64 0, i < lines.count - 1, i += 1 ]
            keep += '{lines[ i ]}\n'
        pf.save[ keep, null ]
        hb_done -= 1
        hb_i -= 1
        hb_load[]

    func hb_draw [ cv: Canvas ]
        if [ !hb_files ] hb_start[]
        cv.fill_color[ rgba [ '#050508' ] ]
        cv.rect_to[ 0.0, 0.0, bounds.w, bounds.h ]
        cv.paint[]
        if [ !hb_img ]
            hs_text[ cv, 'every hand frame boxed: {hb_done} in '
                + 'annotate/hands.txt', 20.0, 16.0, 800.0, 24.0,
                17.0, '#ffffff80' ]
            return
        if [ !hb_tex ]
            hb_tex = Texture [ vk: cv.vk, w: cv.w, sampler: hb_img,
                               linear: true ]
        iw : f32 [ hb_img.width ]
        ih : f32 [ hb_img.height ]
        k : f32 [ min[ bounds.w / iw, bounds.h / ih ] ]
        hb_rect = rect [ x: (bounds.w - iw * k) / 2.0,
                         y: (bounds.h - ih * k) / 2.0,
                         w: iw * k, h: ih * k ]
        cv.draw_image[ hb_tex, hb_rect ]
        cv.paint[]
        if [ hb_drag ]
            x : f32 [ hb_rect.x + hb_x * hb_rect.w ]
            y : f32 [ hb_rect.y + hb_y * hb_rect.h ]
            r : f32 [ hb_half * hb_rect.w ]
            cv.save[]
            cv.fill_color[ rgba [ '#0000' ] ]
            cv.stroke_color[ rgba [ '#4aff6e' ] ]
            cv.stroke_width[ 2.0 ]
            cv.rect_to[ x - r, y - r, r * 2.0, r * 2.0 ]
            cv.paint[]
            cv.restore[]
            cv.fill_color[ rgba [ '#4aff6e' ] ]
            cv.rect_to[ x - 2.0, y - 2.0, 4.0, 4.0 ]
            cv.paint[]
        hs_text[ cv, 'press on the hand\'s middle, drag out to its '
            + 'edge, let go: next    frame {hb_done + 1}    '
            + 'space: no hand    backspace: back one',
            20.0, 16.0, bounds.w - 40.0, 24.0, 17.0, '#ffffffc0' ]

    # the pointer as a share of the hand frame
    func hb_at [ ev: Event ] -> vec2f
        return vec2f [ (ev.mouse.pos.x - hb_rect.x) / hb_rect.w,
                       (ev.mouse.pos.y - hb_rect.y) / hb_rect.h ]

    public func on_move [ ev: Event ]
        if [ view != 'handbox' || !hb_drag ] return
        a : vec2f hb_at[ ev ]
        hb_half = max[ abs[ a.x - hb_x ], abs[ a.y - hb_y ]
                       * hb_rect.h / hb_rect.w ]
        if [ ux ] ux.will_animate = true

    public func on_release [ ev: Event ]
        if [ view != 'handbox' || !hb_drag || !hb_img ] return
        hb_drag = false
        # under 4 of its pixels across: a slip, not a box
        if [ hb_half * 2.0 * f32[ hb_img.width ] < 4.0 ] return
        hb_save[ false ]

    public func on_press [ ev: Event ]
        if [ view == 'handbox' && hb_img ]
            a : vec2f hb_at[ ev ]
            if [ a.x < 0.0 || a.x > 1.0 || a.y < 0.0 || a.y > 1.0 ]
                return
            hb_x = a.x
            hb_y = a.y
            hb_half = 0.0
            hb_drag = true
            return
        if [ view == 'record' ]
            gesture_press[]
            return
        if [ view != 'annotate' || !ann_img ] return
        x : f32 [ (ev.mouse.pos.x - ann_rect.x) / ann_rect.w ]
        y : f32 [ (ev.mouse.pos.y - ann_rect.y) / ann_rect.h ]
        if [ x < 0.0 || x > 1.0 || y < 0.0 || y > 1.0 ] return
        ann_clicks += x
        ann_clicks += y
        if [ ann_clicks.count == 8 ] ann_save[ false ]

    # backspace takes the last click back; space passes a frame with
    # no eyes to mark
    public func on_key [ ev: Event ]
        if [ (view == 'record' || view == 'testbed') && ev.key.state
             && ev.key.unicode == 256 ]
            left_full = true
        if [ view == 'record' && ev.key.state && ev.key.unicode == 32 ]
            gesture_press[]
        if [ view == 'handbox' && ev.key.state && hb_img ]
            if [ ev.key.unicode == 32 ] hb_save[ true ]
            el [ ev.key.unicode == 259 ] hb_undo[]
            return
        if [ view != 'annotate' || !ev.key.state || !ann_img ] return
        if [ ev.key.unicode == 259 && ann_clicks.count >= 2 ]
            keep : vec f32 []
            for [ i: i32 0, i < ann_clicks.count - 2, i += 1 ]
                keep += ann_clicks[ i ]
            ann_clicks = keep
        if [ ev.key.unicode == 32 ] ann_save[ true ]


    public func on_click [ ev: Event ]
        item : cast element [ ev.origin ]
        if [ !item || !item.id ] return
        if [ item.id.starts_with[ 'del_' ]
             || item.id == 'trash_empty' ]
            if [ epoch_millis[] - del_ms < 300 ] return
            del_ms = epoch_millis[]
        if [ item.id.starts_with[ 'del_' ] && recs ]
            i : i32 [ item.id.mid[ 4, item.id.count - 4 ].integer_value[] ]
            if [ i >= 0 && i < i32[ recs.count ] ]
                hs_session_trash[ recs[ i ] ]
            recs = null
            if [ ux ] ux.restyle = true
            return
        if [ item.id == 'trash_empty' ]
            hs_trash_empty[]
            recs = null
            if [ ux ] ux.restyle = true
            return
        if [ item.id.starts_with[ 'job_' ] ]
            # a click arrives twice: the toggle takes the first alone
            if [ epoch_millis[] - job_ms < 300 ] return
            job_ms = epoch_millis[]
            jn : string item.id.mid[ 4, item.id.count - 4 ]
            if [ jn == 'all' ]
                if [ all_left ]
                    if [ all_now && all_now.count > 0 ]
                        hs_job_stop[ all_now, opener ]
                    all_left = null
                    all_now = ''
                el
                    all_left = hs_job_names[]
                    all_now = ''
                if [ ux ] ux.restyle = true
                return
            if [ hs_job_state[ jn ] == 'running' ]
                hs_job_stop[ jn, opener ]
            el hs_job_go[ jn, opener ]
            if [ ux ] ux.restyle = true

# Microsoft's FaceSynthetics (rendered faces at every angle, the
# pupils labelled; non-commercial research licence), fetched and
# unpacked once where hytrain's eye training reads it; the training
# itself is hytrain's (the eyes job)
export func hs_faces []
    cache : path path.path_cache[ 'hyperspace' ]
    if [ !cache.exists[] ] cache.make_dir[]
    site : 'https://facesyntheticspubwedata.z6.web.core.windows.net'
    for [ n: string ] in vec string [] [ '001', '002', '003', '004' ]
        part : string '{cache}/facesynth.{n}'
        get : command {
            test -s "{part}" || (curl -sfL -o "{part}.part"
                {site}/iccv-2021/dataset_100000.zip.{n}
                && mv "{part}.part" "{part}")
        }
        if [ get.exec[ false ] != 0 ]
            log 'hyperspace: FaceSynthetics part {n} did not download'
            return
    open : command {
        test -d "{cache}/facesynth/dataset_100000" || (
            cat "{cache}"/facesynth.00? > "{cache}/facesynth.zip"
            && unzip -q -o "{cache}/facesynth.zip"
                -d "{cache}/facesynth")
    }
    if [ open.exec[ false ] != 0 ]
        log 'hyperspace: FaceSynthetics did not unpack'

# the views, each one launchable: the app on its own props
hyperspace HsRecord
    view : 'record'

hyperspace HsGaze
    view : 'record'
    into : 'gaze'

hyperspace HsEdges
    view  : 'record'
    into  : 'gaze'
    route : 'edges'

hyperspace HsNegatives
    view  : 'record'
    into  : 'negatives'
    route : 'negatives'

hyperspace HsHands
    view  : 'record'
    into  : 'hands'
    route : 'gestures'

hyperspace HsPoint
    view  : 'record'
    into  : 'hands'
    route : 'point'

hyperspace HsTestbed
    view : 'testbed'

hyperspace HsTraining
    view : 'training'

hyperspace HsAnnotate
    view : 'annotate'

hyperspace HsHandBox
    view : 'handbox'

hyperspace HsRecordings
    view : 'recordings'
