export software ['developer']
export startup ['hyperspace']
export panels ['HyperspacePanel']
export menus ['HyperspaceApps']
export contains ['.local/state/hyperspace']
export cameras ['v4l2']

import vec
import img
import trinity
import tray

import Mounts
import Menus
import Panel
import Eyes

# the app's storage, one folder for the app and its panel: in its
# view (a hosted slot) its own home's; drawn by orbiter (the panel),
# that same home under install, not the user's own
# the record dot's time from one point to the next, in ms
MOVE_MS : i64 [ 1600 ]
# gaze's: 80 points at 7.5 s each, ten minutes
GAZE_MOVE_MS : i64 [ 6400 ]
# the record run's times round the grid
ROUNDS : i32 [ 4 ]

func hs_dir [] -> path
    d : path path.path_storage[ 'hyperspace' ]
    if [ !getenv[ 'SILVER_APP_SLOT' ] ]
        home : string '{path.path_install[]}/home/hyperspace'
        d = path '{home}/.local/state/hyperspace'
    if [ !d.exists[] ] d.make_dir[]
    return d

func hs_records [] -> path
    d : path '{hs_dir[]}/records'
    if [ !d.exists[] ] d.make_dir[]
    return d

# words on the canvas, the panels' font
func hs_text [ cv: Canvas, s: string, x: f32, y: f32, w: f32,
               h: f32, size: f32, color: string ]
    fr : string 'fonts/BarlowCondensed-Regular.ttf'
    cv.set_font[ shared_font[ cv, fr, label_px[ cv, size ] ] ]
    cv.fill_color[ rgba [ color ] ]
    cv.draw_text[ s, rect [ x: x, y: y, w: w, h: h ],
        vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip,
        null, true ]
    cv.paint[]

func hs_models [] -> path
    d : path '{hs_dir[]}/models'
    if [ !d.exists[] ] d.make_dir[]
    return d

element hyperspace : trinity
    width  : i32 [ 640 ]
    height : i32 [ 360 ]
    public title : string [ 'hyperspace' ]
    public [ Launch ] cameras : string [ '/dev/video0' ]
    # record (the dot), testbed (the cameras), training or annotate
    public [ Launch ] view : string [ 'testbed' ]
    # record's folder: records (the eye nets' data) or gaze
    public [ Launch ] into : string [ 'records' ]
    intern devices : vec string
    intern rig : HsRig
    intern command_at : i64
    intern pending : vec string
    intern capture_at : i64
    intern last_poll : i64
    intern rig_at : i64
    # record: the dot's points (x, y as 0 to 1 shares of the
    # screen), the one it goes to, when it left the last
    intern points : vec f32
    intern at : i32
    intern left_us : i64
    intern taken : i32
    # this record run's session: when it began (ms)
    intern session : i64
    # the captures this record run made (their ids)
    intern rec_ids : vec string
    # gaze: the first camera's lit frame last captured
    intern shot_at : i64
    intern cancelled : bool
    # Escape gave the screen back: the run goes on in its window
    intern left_full : bool
    intern full_on : bool
    # annotate: the frames (names under the app's storage), the one
    # shown, its clicks so far (x, y as shares of the picture)
    intern ann_files : vec string
    intern ann_i : i32
    intern ann_clicks : vec f32
    intern ann_img : Image
    intern ann_tex : Texture
    intern ann_rect : rect
    intern ann_done : i32
    # testbed: the gaze from both cameras
    intern hub : GazeHub

    func ann_dir [] -> path
        d : path '{hs_dir[]}/annotate'
        if [ !d.exists[] ] d.make_dir[]
        return d

    # the frames to mark: the annotate folder's, then the records';
    # those already in points.txt left out
    func ann_start []
        done : vec string []
        pf : path '{ann_dir[]}/points.txt'
        if [ pf.exists[] ]
            tx : string pf.load[ typeid[ string ], null ]
            if [ tx ]
                for [ ln: string ] in tx.split[ '\n' ]
                    ws : vec string ln.trim[].split[ ' ' ]
                    if [ ws.count > 1 ] done.push[ ws[ 0 ] ]
        ann_done = i32[ done.count ]
        ann_files = vec string []
        subs : vec string [] [ 'annotate', 'records' ]
        for [ sub: string ] in subs
            d : path '{hs_dir[]}/{sub}'
            if [ !d.exists[] ] continue
            for [ f: path ] in d.ls[ null, false ]
                if [ f.ext[] != 'png' ] continue
                nm : string '{sub}/{f.filename[]}'
                seen : bool [ false ]
                for [ dn: string ] in done
                    if [ dn == nm ] seen = true
                if [ !seen ] ann_files.push[ nm ]
        ann_i = 0
        ann_load[]

    # the shown frame's picture; one that does not load is passed
    func ann_load []
        ann_clicks = vec f32 []
        ann_img = null
        ann_tex = null
        while [ ann_i < ann_files.count ]
            im : Image [ uri: path '{hs_dir[]}/{ann_files[ ann_i ]}' ]
            if [ im && im.width > 0 ]
                ann_img = im
                return
            ann_i += 1

    # a line of points.txt: the frame, then its left and right outer
    # corners and left and right eye centers, in its pixels (as seen
    # on the screen); or the frame and 'skip'
    func ann_save [ skip: bool ]
        pf : path '{ann_dir[]}/points.txt'
        old : string ''
        if [ pf.exists[] ] old = pf.load[ typeid[ string ], null ]
        nm : string ann_files[ ann_i ]
        line : string '{nm} skip'
        if [ !skip ]
            w : f32 [ ann_img.width ]
            h : f32 [ ann_img.height ]
            c : vec f32 ann_clicks
            line = '{nm} {c[0] * w} {c[1] * h} {c[6] * w} {c[7] * h} '
                + '{c[2] * w} {c[3] * h} {c[4] * w} {c[5] * h}'
        pf.save[ '{old}{line}\n', null ]
        ann_done += 1
        ann_i += 1
        ann_load[]

    func rig_use [ next: HsRig ]
        rig = next
        devices = vec string []
        for [ mount: HsMount ] in rig.mounts
            devices.push[ mount.device ]
        pristine = false
        if [ ux ] ux.restyle = true

    func init []
        animated = true
        rig_use[ hs_rig_load[ cameras ] ]
        file : path '{hs_dir[]}/mounts.agi'
        if [ file.exists[] ] rig_at = file.modified_time[]

    func rig_poll []
        file : path '{hs_dir[]}/mounts.agi'
        if [ !file.exists[] ] return
        at : i64 file.modified_time[]
        if [ at == rig_at ] return
        rig_at = at
        rig_use[ hs_rig_load[ cameras ] ]

    func command_poll []
        now : i64 epoch_millis[]
        if [ now - last_poll < 100 ] return
        last_poll = now
        f : path '{hs_dir[]}/command.agi'
        if [ !f.exists[] ] return
        at : i64 f.modified_time[]
        if [ at == command_at ] return
        command_at = at
        tx : string f.load[ typeid[ string ], null ]
        if [ !tx ] return
        fields : vec string tx.trim[].split[ "\t" ]
        if [ fields.count < 10 || fields[ 0 ] != 'capture' ]
            return
        pending = fields
        capture_at = now + 600

    func camera_view [ i: i32 ] -> CameraView
        if [ !elements ] return null
        return cast CameraView [ elements[ 'camera{i}' ] ]

    # where this record run saves
    func rec_dir [] -> path
        d : path '{hs_dir[]}/{into}'
        if [ !d.exists[] ] d.make_dir[]
        return d

    func capture []
        if [ !pending || pending.count < 10 ] return
        id : i64 epoch_millis[]
        recs : path rec_dir[]
        for [ i: i32 0, i < devices.count, i += 1 ]
            cv : CameraView camera_view[ i ]
            if [ !cv ] return
            pic : path '{recs}/{id}-camera{i}.png'
            if [ !cv.save_frame[ pic ] ] return
        tx :
            'source=user session={session} cameras={devices.count} '
            + 'screen_width_m={rig.screen_width_m} '
            + 'screen_height_m={rig.screen_height_m} '
            + 'target_x={pending[1]} target_y={pending[2]} '
            + 'gesture={pending[3]} gesture_scale={pending[4]} '
            + 'left_hand_x={pending[5]} '
            + 'left_hand_y={pending[6]} '
            + 'left_hand_scale={pending[7]} '
            + 'right_hand_x={pending[8]} '
            + 'right_hand_y={pending[9]} '
            + 'right_hand_scale='
            + ((pending.count > 10) ? pending[10] : '-1')
        for [ i: i32 0, i < rig.mounts.count, i += 1 ]
            mount : HsMount rig.mounts[i]
            tx += ' camera_device{i}={mount.device}'
                + ' camera_x_m{i}={mount.x_m}'
                + ' camera_y_m{i}={mount.y_m}'
                + ' camera_z_m{i}={mount.z_m}'
                + ' camera_tilt_deg{i}={mount.tilt_deg}'
                + ' camera_fov_deg{i}={mount.fov_deg}'
        f : path '{recs}/{id}.agi'
        f.save[ '{tx}\n', null ]
        if [ !rec_ids ] rec_ids = vec string []
        rec_ids.push[ '{id}' ]
        log 'hyperspace: captured {devices.count} camera images'
        pending = null

    func on_frame [ w: Window ]
        rig_poll[]
        command_poll[]
        if [ view == 'record' ] record_step[]
        # record takes the whole screen while its dot runs
        n : i32 [ (points) ? i32[ points.count ] / 2 : 0 ]
        on : bool [ view == 'record' && !cancelled && !left_full
                    && (n == 0 || at < n) ]
        if [ ux && on != full_on ]
            full_on = on
            ux.set_fullscreen[ on ]
        if [ pending && epoch_millis[] >= capture_at ]
            capture[]
            taken += 1

    # record's menu: Cancel stops this run and deletes what it took
    action func cancel []
        if [ view != 'record' ] return
        n : i32 [ 0 ]
        if [ rec_ids ]
            recs : path rec_dir[]
            for [ id: string ] in rec_ids
                for [ i: i32 0, i < devices.count, i += 1 ]
                    pic : path '{recs}/{id}-camera{i}.png'
                    if [ pic.exists[] ] pic.remove[]
                ag : path '{recs}/{id}.agi'
                if [ ag.exists[] ] ag.remove[]
                n += 1
        log 'hyperspace: recording cancelled, {n} captures deleted'
        rec_ids = vec string []
        pending = null
        taken = 0
        if [ points ] at = i32[ points.count ] / 2
        cancelled = true
        if [ ux ] ux.restyle = true

    # ROUNDS times a 5 by 4 grid over the screen: each round in a
    # new order, the whole grid nudged up to 3% of the screen, so no
    # round's stops are the last's
    func record_start []
        points = vec f32 []
        seed : i64 epoch_millis[]
        for [ rd: i32 0, rd < ROUNDS, rd += 1 ]
            seed = (seed * 1103515245 + 12345) % 2147483648
            nx : f32 [ f32[ seed % 61 ] / 1000.0 - 0.03 ]
            seed = (seed * 1103515245 + 12345) % 2147483648
            ny : f32 [ f32[ seed % 61 ] / 1000.0 - 0.03 ]
            grid : vec f32 []
            for [ r: i32 0, r < 4, r += 1 ]
                for [ c: i32 0, c < 5, c += 1 ]
                    grid += 0.08 + f32[ c ] * 0.21 + nx
                    grid += 0.1 + f32[ r ] * 0.2667 + ny
            n : i32 [ i32[ grid.count ] / 2 ]
            for [ i: i32 n - 1, i > 0, i -= 1 ]
                seed = (seed * 1103515245 + 12345) % 2147483648
                j : i32 [ i32[ seed % i64[ i + 1 ] ] ]
                for [ k: i32 0, k < 2, k += 1 ]
                    t : f32 grid[ i * 2 + k ]
                    grid[ i * 2 + k ] = grid[ j * 2 + k ]
                    grid[ j * 2 + k ] = t
            for [ v: f32 ] in grid
                points += v
        at = 0
        taken = 0
        session = epoch_millis[]
        rec_ids = vec string []
        left_us = epoch_micros[]

    # each point: MOVE_MS to it, then still. record takes one frame
    # 0.6 s into the stop; gaze every lit frame, the dot moving too
    func record_step []
        if [ !points ] record_start[]
        if [ at >= points.count / 2 ] return
        el_ms : i64 [ (epoch_micros[] - left_us) / 1000 ]
        mv : i64 move_ms[]
        cam : CameraView camera_view[ 0 ]
        # the eyes start after the dot: none in the first 0.2 s
        if [ into == 'gaze' && cam && cam.camera && !pending
             && el_ms >= 200 && cam.camera.taken != shot_at ]
            shot_at = cam.camera.taken
            d : vec2f dot_at[]
            take_at[ d.x, d.y, 0 ]
        el [ into != 'gaze' && el_ms >= mv && !pending
             && el_ms < mv + 100 ]
            ask_capture[ 600 ]
        if [ el_ms >= mv + 1100 ]
            at += 1
            # the last point: the cameras close (render again)
            if [ at >= points.count / 2 && ux ] ux.restyle = true
            left_us = epoch_micros[]

    # the dot's time from point to point
    func move_ms [] -> i64
        return (into == 'gaze') ? GAZE_MOVE_MS : MOVE_MS

    # a capture of the dot's point, after_ms from now
    func ask_capture [ after_ms: i64 ]
        take_at[ points[ at * 2 ], points[ at * 2 + 1 ], after_ms ]

    # a capture with the dot at (x, y), after_ms from now
    func take_at [ x: f32, y: f32, after_ms: i64 ]
        pending = vec string [] [ 'capture', '{x}', '{y}', 'none', '1',
            '-1', '-1', '-1', '-1', '-1', '-1' ]
        capture_at = epoch_millis[] + after_ms

    # the dot's place now, eased from the last point to this one
    func dot_at [] -> vec2f
        n : i32 [ i32[ points.count ] / 2 ]
        k : i32 [ min[ at, n - 1 ] ]
        if [ k < 0 ] return vec2f [ 0.5, 0.5 ]
        p : vec2f [ points[ k * 2 ], points[ k * 2 + 1 ] ]
        if [ k == 0 || at >= n ] return p
        q : vec2f [ points[ k * 2 - 2 ], points[ k * 2 - 1 ] ]
        f : f32 [ min[ f32[ epoch_micros[] - left_us ]
            / (f32[ move_ms[] ] * 1000.0), 1.0 ] ]
        # eased in and out with no jolt: its speed and its change
        # of speed both start and end at nothing
        f = f * f * f * (f * (f * 6.0 - 15.0) + 10.0)
        return vec2f [ q.x + (p.x - q.x) * f, q.y + (p.y - q.y) * f ]

    # testbed: the gaze as a dot where the eyes look: on the monitor
    # (the model's -0.5 to 0.5), then this window's place on it, then
    # this view's in the window; off the view, not drawn
    func gaze_draw [ w: Window, cv: Canvas ]
        cv.fill_color[ rgba [ '#050508' ] ]
        cv.rect_to[ 0.0, 0.0, bounds.w, bounds.h ]
        cv.paint[]
        if [ !hub ] return
        hub.step[]
        if [ hub.missing ]
            hs_text[ cv, 'no gaze model: run train_gaze.py', 20.0,
                16.0, 600.0, 24.0, 17.0, '#ffffff80' ]
            return
        if [ !hub.has ] return
        m : rect w.on_monitor[]
        if [ m.w <= 0.0 || m.h <= 0.0 ] return
        sc : f32 [ cv.transform_scale[] ]
        if [ sc <= 0.0 ] sc = 1.0
        x : f32 [ floor[ ((hub.x + 0.5) * m.w - m.x - cv.transform_tx[])
                         / sc ] ]
        y : f32 [ floor[ ((hub.y + 0.5) * m.h - m.y - cv.transform_ty[])
                         / sc ] ]
        if [ x < 0.0 || y < 0.0 || x > bounds.w || y > bounds.h ] return
        cv.fill_color[ rgba [ '#806bff60' ] ]
        cv.arc[ x, y, 22.0, 0.0, 6.2832 ]
        cv.paint[]
        cv.fill_color[ rgba [ '#ffffff' ] ]
        cv.arc[ x, y, 5.0, 0.0, 6.2832 ]
        cv.paint[]

    func render [] -> Elements
        e : Elements []
        # record's cameras close once its run is done or cancelled;
        # annotate and training need none
        rn : i32 [ (points) ? i32[ points.count ] / 2 : 0 ]
        done : bool [ cancelled || (rn > 0 && at >= rn) ]
        if [ view == 'training' ]
            e[ 'train' ] = PageButton [ label: 'Train',
                area: Region { l1 t3.2 w6 h1.3 } ]
            return e
        if [ view == 'annotate' || (view == 'record' && done) ]
            return e
        # record takes the frames but shows none
        show : bool [ view == 'testbed' ]
        n : i32 [ max[ i32[ devices.count ], 1 ] ]
        if [ show && !hub ] hub = GazeHub []
        for [ i: i32 0, i < devices.count, i += 1 ]
            # the testbed's cameras: side by side in the screen's
            # lower right quarter's corner, a quarter wide and high
            l : f32 [ 75.0 + 25.0 * f32[ i ] / f32[ n ] ]
            r : f32 [ 25.0 - 25.0 * f32[ i + 1 ] / f32[ n ] ]
            ar : string [ (show) ? 'l{l}% t75% r{r}% b0'
                                 : 'l0 t0 w1 h1' ]
            # the testbed's cameras find the eyes as they run
            if [ show ]
                e[ 'camera{i}' ] = EyeView [ device: devices[ i ],
                    animated: true, area: Region [ ar ], hub: hub,
                    slot: i ]
            el
                e[ 'camera{i}' ] = CameraView [
                    device: devices[ i ], animated: true,
                    paint_off: true, area: Region [ ar ] ]
        return e

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        cv : Canvas w.screen
        if [ view == 'annotate' ]
            ann_draw[ cv ]
            return
        if [ view == 'testbed' ]
            gaze_draw[ w, cv ]
            return
        if [ view == 'record' ]
            cv.fill_color[ rgba [ '#050508' ] ]
            cv.rect_to[ 0.0, 0.0, bounds.w, bounds.h ]
            cv.paint[]
            n : i32 [ (points) ? i32[ points.count ] / 2 : 0 ]
            if [ at < n ]
                # a 3 x 3 pixel dot on whole pixels, a slight edge
                # a pixel round it
                d : vec2f dot_at[]
                x : f32 [ floor[ d.x * bounds.w ] - 1.0 ]
                y : f32 [ floor[ d.y * bounds.h ] - 1.0 ]
                cv.fill_color[ rgba [ '#806bff' ] ]
                cv.rect_to[ x - 1.0, y - 1.0, 5.0, 5.0 ]
                cv.paint[]
                cv.fill_color[ rgba [ '#ffffff' ] ]
                cv.rect_to[ x, y, 3.0, 3.0 ]
                cv.paint[]
                hs_text[ cv, 'look at the dot   {at + 1} / {n}',
                    20.0, 16.0, 600.0, 24.0, 17.0, '#ffffff80' ]
            el [ cancelled ]
                hs_text[ cv, 'recording cancelled: its frames deleted',
                    20.0, 16.0, 600.0, 24.0, 17.0, '#ffffff80' ]
            el
                hs_text[ cv, 'recorded {taken} frames: open training',
                    20.0, 16.0, 600.0, 24.0, 17.0, '#ffffff80' ]
        el [ view == 'training' ]
            u : f32 [ 22.0 ]
            hs_text[ cv, 'training', u, u, 400.0, 30.0, 24.0,
                '#e4e4ea' ]
            hs_text[ cv, '{hs_record_count[]} records', u, 2.0 * u,
                400.0, 24.0, 17.0, '#ffffff80' ]
            lf : path '{hs_dir[]}/train.log'
            tx : string lf.load[ typeid[ string ], null ]
            if [ tx ]
                ls : vec string tx.trim[].split[ '\n' ]
                y : f32 [ 8.0 * u ]
                from : i32 [ max[ i32[ ls.count ] - 16, 0 ] ]
                for [ i: i32 from, i < ls.count, i += 1 ]
                    hs_text[ cv, ls[ i ], u, y, bounds.w - 2.0 * u,
                        20.0, 14.0, '#ffffff99' ]
                    y += 20.0

    # annotate: the frame as large as the window holds, the clicks
    # made on it, and what to click next
    func ann_draw [ cv: Canvas ]
        if [ !ann_files ] ann_start[]
        cv.fill_color[ rgba [ '#050508' ] ]
        cv.rect_to[ 0.0, 0.0, bounds.w, bounds.h ]
        cv.paint[]
        n : i32 [ i32[ ann_files.count ] ]
        if [ !ann_img ]
            hs_text[ cv, 'every frame marked: {ann_done} in '
                + 'annotate/points.txt', 20.0, 16.0, 800.0, 24.0,
                17.0, '#ffffff80' ]
            return
        if [ !ann_tex ]
            ann_tex = Texture [ vk: cv.vk, w: cv.w, sampler: ann_img,
                                linear: true ]
        iw : f32 [ ann_img.width ]
        ih : f32 [ ann_img.height ]
        k : f32 [ min[ bounds.w / iw, bounds.h / ih ] ]
        ann_rect = rect [ x: (bounds.w - iw * k) / 2.0,
                          y: (bounds.h - ih * k) / 2.0,
                          w: iw * k, h: ih * k ]
        cv.draw_image[ ann_tex, ann_rect ]
        cols : vec string [] [ '#ff4a4a', '#4aff6e', '#4aff6e',
                               '#ff4a4a' ]
        for [ i: i32 0, i < ann_clicks.count / 2, i += 1 ]
            x : f32 [ ann_rect.x + ann_clicks[ i * 2 ] * ann_rect.w ]
            y : f32 [ ann_rect.y + ann_clicks[ i * 2 + 1 ] * ann_rect.h ]
            cv.stroke_color[ rgba [ cols[ i ] ] ]
            cv.stroke_width[ 2.0 ]
            cv.fill_color[ rgba [ '#0000' ] ]
            cv.arc[ x, y, 7.0, 0.0, 6.2832 ]
            cv.paint[]
        steps : vec string [] [ 'left outer corner', 'left eye',
                                'right eye', 'right outer corner' ]
        at : i32 [ i32[ ann_clicks.count ] / 2 ]
        hs_text[ cv, 'click the {steps[ at ]}  ({at + 1} / 4)    '
            + 'frame {ann_i + 1} / {n}    backspace: undo    '
            + 'space: no eyes, pass',
            20.0, 16.0, bounds.w - 40.0,
            24.0, 17.0, '#ffffffc0' ]

    public func on_press [ ev: Event ]
        if [ view != 'annotate' || !ann_img ] return
        x : f32 [ (ev.mouse.pos.x - ann_rect.x) / ann_rect.w ]
        y : f32 [ (ev.mouse.pos.y - ann_rect.y) / ann_rect.h ]
        if [ x < 0.0 || x > 1.0 || y < 0.0 || y > 1.0 ] return
        ann_clicks += x
        ann_clicks += y
        if [ ann_clicks.count == 8 ] ann_save[ false ]

    # backspace takes the last click back; space passes a frame with
    # no eyes to mark
    public func on_key [ ev: Event ]
        if [ view == 'record' && ev.key.state && ev.key.unicode == 256 ]
            left_full = true
        if [ view != 'annotate' || !ev.key.state || !ann_img ] return
        if [ ev.key.unicode == 259 && ann_clicks.count >= 2 ]
            keep : vec f32 []
            for [ i: i32 0, i < ann_clicks.count - 2, i += 1 ]
                keep += ann_clicks[ i ]
            ann_clicks = keep
        if [ ev.key.unicode == 32 ] ann_save[ true ]


    public func on_click [ ev: Event ]
        item : cast element [ ev.origin ]
        if [ item && item.id == 'train' ] hs_train[]

# the base models (find, target) from Microsoft's FaceSynthetics:
# rendered faces at every angle, the pupils labelled (non-commercial
# research licence), at the build; again only when this module
# changes. training starts from them (install/share/silver-hyperspace
# /base)
export func hs_base_model []
    ip : path path.path_install[]
    ins : string '{ip.absolute[]}'
    out : string '{ins}/share/silver-hyperspace/base'
    cache : path path.path_cache[ 'hyperspace' ]
    if [ !cache.exists[] ] cache.make_dir[]
    site : 'https://facesyntheticspubwedata.z6.web.core.windows.net'
    for [ n: string ] in vec string [] [ '001', '002', '003', '004' ]
        part : string '{cache}/facesynth.{n}'
        get : command {
            test -s "{part}" || (curl -sfL -o "{part}.part"
                {site}/iccv-2021/dataset_100000.zip.{n}
                && mv "{part}.part" "{part}")
        }
        if [ get.exec[ false ] != 0 ]
            log 'hyperspace: FaceSynthetics part {n} did not download'
            return
    run : command {
        python3 "{ins}/../hyperspace/train_eyes.py"
            --faces "{cache}/facesynth.zip" --out "{out}"
    }
    if [ run.exec[ false ] != 0 ]
        log 'hyperspace: the base model did not build'
