extend hyperspace

# hyperspace.c: the eye nets on a thread a camera
func hs_worker_open [ dir: cstr ] -> handle
func hs_worker_put [ worker: handle, grey: @u8, w: i32, h: i32 ]
func hs_worker_get [ worker: handle, out: @f32, ms: @f32, grey: @u8,
                     w: i32, h: i32 ] -> i32
func hs_worker_free [ worker: handle ]
func hs_worker_gaze [ worker: handle, clips: @f32, aux: @f32,
                      sound: @i32 ] -> i32
func hs_gaze_load [ path: cstr ] -> handle
func hs_gaze_free [ net: handle ]
func hs_gaze_uses [ net: handle, c: i32 ] -> i32
func hs_gaze_run [ net: handle, clips0: @f32, aux0: @f32, sound0: i32,
                   clips1: @f32, aux1: @f32, sound1: i32,
                   out: @f32 ] -> i32
# the hand nets on a thread: hands.hsn, point.hsn, handfind.hsn
func hs_hand_open [ dir: cstr ] -> handle
func hs_hand_has [ hand: handle ] -> i32
func hs_hand_put [ hand: handle, grey: @u8, w: i32, h: i32 ]
func hs_hand_get [ hand: handle, out: @f32, ms: @f32 ] -> i32
func hs_hand_free [ hand: handle ]

# the gaze from both cameras: their workers' clips, numbers and
# checks to the gaze net (models/gaze.hsg)
class GazeHub
    intern first : handle
    intern second : handle
    intern net : handle
    intern tried : bool
    intern used : i32
    intern clips : vec f32
    intern aux : vec f32
    intern clips2 : vec f32
    intern aux2 : vec f32
    # the dot on the screen, -0.5 to 0.5 from its middle, and the
    # last answer it eases to
    public x : f32
    public y : f32
    intern goal_x : f32
    intern goal_y : f32
    public has : bool
    public missing : bool

    func dealloc []
        if [ net ] hs_gaze_free[ net ]

    # the gaze net, read once (none: missing)
    func load []
        if [ tried ] return
        tried = true
        p : string '{hs_models[]}/gaze.hsg'
        net = hs_gaze_load[ p.chars ]
        missing = !net
        clips = vec f32 []
        aux = vec f32 []
        clips2 = vec f32 []
        aux2 = vec f32 []
        for [ i: i32 0, i < 3 * 32 * 32, i += 1 ]
            clips.push[ 0.0 ]
            clips2.push[ 0.0 ]
        for [ i: i32 0, i < 18, i += 1 ]
            aux.push[ 0.0 ]
            aux2.push[ 0.0 ]

    # a camera the gaze net reads (no net: the first alone): only
    # those look for eyes
    func reads [ slot: i32 ] -> bool
        load[]
        if [ !net ] return slot == 0
        return hs_gaze_uses[ net, slot ] != 0

    func put [ slot: i32, worker: handle ]
        if [ slot == 0 ] first = worker
        el [ slot == 1 ] second = worker

    # a new dot when either camera has a new answer
    func step []
        load[]
        if [ !net ] return
        # only the cameras the net reads (one, or both)
        one : bool [ hs_gaze_uses[ net, 0 ] != 0 ]
        two : bool [ hs_gaze_uses[ net, 1 ] != 0 ]
        if [ (one && !first) || (two && !second) ] return
        s0 : i32 [ 0 ]
        s1 : i32 [ 0 ]
        n0 : i32 [ 0 ]
        n1 : i32 [ 0 ]
        if [ one ]
            n0 = hs_worker_gaze[ first, @clips[ 0 ], @aux[ 0 ], @s0 ]
            if [ n0 == 0 ] return
        if [ two ]
            n1 = hs_worker_gaze[ second, @clips2[ 0 ], @aux2[ 0 ],
                                 @s1 ]
            if [ n1 == 0 ] return
        if [ n0 + n1 == used ] return
        used = n0 + n1
        out : vec f32 [] [ 0.0, 0.0 ]
        hs_gaze_run[ net, @clips[ 0 ], @aux[ 0 ], s0, @clips2[ 0 ],
            @aux2[ 0 ], s1, @out[ 0 ] ]
        goal_x = out[ 0 ]
        goal_y = out[ 1 ]
        if [ !has ]
            x = goal_x
            y = goal_y
            has = true

    # each display frame the dot eases toward the last answer: 30% of
    # the way a 60th of a second, whatever the display's rate
    func ease [ factor: f32 ]
        if [ !has ] return
        x = filter_n[ x, goal_x, 0.3, factor ]
        y = filter_n[ y, goal_y, 0.3, factor ]

# a camera with the eyes its worker found drawn over it
CameraView EyeView
    # the gaze its worker feeds, and which camera this is
    public hub : GazeHub
    public slot : i32
    intern worker : handle
    intern tried  : bool
    intern found  : vec f32
    intern took   : f32
    intern seen   : i32
    intern taken_at : i64
    # the frame the shown answer came from, and its picture
    intern grey   : vec u8
    intern pic    : Texture
    intern drawn  : i32
    # the hand nets (the bottom camera's) and their last answer
    intern hand   : handle
    intern hand_tried : bool
    intern hand_out : vec f32
    intern hand_at : i64
    # where the hand points on the screen (from its middle, shares
    # of its width and height), when a hand is there
    public pt_on : bool
    public pt_x : f32
    public pt_y : f32
    # the head (the top camera): the outer corners' midpoint from
    # the frame's middle (shares of its width, height), their gap
    # (a share of its width), and the answer it came from
    public head_x : f32
    public head_y : f32
    public head_gap : f32
    public head_seen : i32

    func dealloc []
        if [ worker ] hs_worker_free[ worker ]
        if [ hand ] hs_hand_free[ hand ]

    # a square of a colour, centred on a point of the frame
    func mark [ cv: Canvas, x: f32, y: f32, size: f32, color: string ]
        cv.fill_color[ rgba [ color ] ]
        cv.rect_to[ x - size / 2.0, y - size / 2.0, size, size ]
        cv.paint[]

    # the camera pumped; its picture drawn only before the first
    # answer: then each answer over the frame it came from
    func draw [ w: Window ]
        if [ !camera || !camera.image ] return
        camera.src_rect = (src_rect) ? src_rect :
            rect [ x: 0.0, y: 0.0, w: f32[ camera.width ],
                   h: f32[ camera.height ] ]
        camera.update[]
        # the service: the eyes found, nothing drawn
        if [ paint_off ]
            if [ (hub && hub.reads[ slot ]) || slot == 0 ] feed[]
            if [ slot == 0 ] head_read[]
            return
        cv : Canvas w.screen
        full : rect [ x: 0.0, y: 0.0, w: bounds.w, h: bounds.h ]
        # the eyes only on a camera the gaze reads; the hands on the
        # bottom one
        if [ !hub || hub.reads[ slot ] ] eyes_draw[ cv, full ]
        el
            cv.draw_image[ camera.image, full ]
            cv.paint[]
        if [ slot == 1 ] hand_draw[ cv ]

    # the bottom camera's hand nets: fed each new frame, their answer
    # drawn over it (the bends and spread as bars, the finder's box);
    # the point kept for the screen
    func hand_draw [ cv: Canvas ]
        if [ !hand_tried ]
            hand_tried = true
            dir : string '{hs_models[]}/hands'
            hand = hs_hand_open[ dir.chars ]
            hand_out = vec f32 [ 14 ]
        if [ !hand ]
            hs_text[ cv, 'no hand models in {hs_models[]}/hands', 12.0,
                bounds.h - 28.0, bounds.w, 20.0, 14.0, '#ffffffa0' ]
            return
        if [ camera.taken != hand_at ]
            hand_at = camera.taken
            img : Image frame_image[]
            if [ img ]
                px : @u8 img.vdata[]
                hs_hand_put[ hand, px, camera.width, camera.height ]
        ms : f32 [ 0.0 ]
        if [ hs_hand_get[ hand, @hand_out[ 0 ], @ms ] == 0 ] return
        has : i32 hs_hand_has[ hand ]
        o : vec f32 hand_out
        # the bends and spread only while the hand model sees a hand
        if [ (has & 1) != 0 && o[ 0 ] > 0.5 ]
            names : vec string [] [ 'hand', 'thumb', 'index', 'middle',
                'ring', 'little', 'spread' ]
            for [ i: i32 0, i < 7, i += 1 ]
                y : f32 [ 32.0 + 18.0 * f32[ i ] ]
                v : f32 [ min[ max[ o[ i ], 0.0 ], 1.0 ] ]
                cv.fill_color[ rgba [ '#00000080' ] ]
                cv.rect_to[ 70.0, y + 4.0, 100.0, 10.0 ]
                cv.paint[]
                cv.fill_color[ rgba [ (i == 0) ? '#46ff6e' : '#806bff' ] ]
                cv.rect_to[ 70.0, y + 4.0, 100.0 * v, 10.0 ]
                cv.paint[]
                hs_text[ cv, names[ i ], 12.0, y, 56.0, 18.0, 13.0,
                    '#ffffffc0' ]
        pt_on = (has & 2) != 0 && o[ 7 ] > 0.5
        pt_x = o[ 8 ]
        pt_y = o[ 9 ]
        if [ (has & 4) != 0 && o[ 10 ] > 0.5 ]
            # the finder's box, and the crop the point model reads
            # (a quarter larger: every joint inside)
            bx : f32 [ o[ 11 ] * bounds.w ]
            by : f32 [ o[ 12 ] * bounds.h ]
            for [ g: i32 0, g < 2, g += 1 ]
                hs : f32 [ o[ 13 ] * bounds.w / 2.0
                           * ((g == 0) ? 1.0 : 1.25) ]
                cv.save[]
                cv.fill_color[ rgba [ '#0000' ] ]
                cv.stroke_color[ rgba [ (g == 0) ? '#4aff6e'
                                                 : '#4aff6e60' ] ]
                cv.stroke_width[ 2.0 ]
                cv.rect_to[ bx - hs, by - hs, hs * 2.0, hs * 2.0 ]
                cv.paint[]
                cv.restore[]
            # and a circle round the hand, the box's width across
            cv.save[]
            cv.fill_color[ rgba [ '#0000' ] ]
            cv.stroke_color[ rgba [ '#4aff6e' ] ]
            cv.stroke_width[ 2.0 ]
            cv.arc[ bx, by, o[ 13 ] * bounds.w / 2.0, 0.0, 6.2832 ]
            cv.paint[]
            cv.restore[]
        hs_text[ cv, 'hand {i32[ ms ]} ms', 12.0, bounds.h - 28.0,
            bounds.w, 20.0, 14.0, '#ffffffa0' ]

    # the eye nets: fed each new frame, the eyes drawn over the frame
    # their answer came from
    # the worker made once; each new lit frame goes to it (false:
    # no models)
    func feed [] -> bool
        if [ !tried ]
            tried = true
            dir : string '{hs_models[]}'
            worker = hs_worker_open[ dir.chars ]
            found = vec f32 []
            for [ i: i32 0, i < 11, i += 1 ]
                found.push[ 0.0 ]
        if [ !worker ] return false
        if [ hub ] hub.put[ slot, worker ]
        if [ camera.taken != taken_at ]
            taken_at = camera.taken
            img : Image frame_image[]
            if [ img ]
                px : @u8 img.vdata[]
                hs_worker_put[ worker, px, camera.width, camera.height ]
        return true

    # the worker's newest corners as the head's place (service only:
    # eyes_draw reads the answer itself)
    func head_read []
        if [ !worker ] return
        cw : i32 camera.width
        chh : i32 camera.height
        if [ !grey || grey.count != cw * chh ]
            grey = vec u8 [ cw * chh ]
        ms : f32 [ 0.0 ]
        n : i32 hs_worker_get[ worker, @found[ 0 ], @ms, @grey[ 0 ], cw,
                               chh ]
        if [ n == 0 || n == head_seen ] return
        head_seen = n
        dx : f32 [ found[ 5 ] - found[ 3 ] ]
        dy : f32 [ found[ 6 ] - found[ 4 ] ]
        head_x = (found[ 3 ] + found[ 5 ]) / 2.0 / f32[ cw ] - 0.5
        head_y = (found[ 4 ] + found[ 6 ]) / 2.0 / f32[ chh ] - 0.5
        head_gap = sqrt[ dx * dx + dy * dy ] / f32[ cw ]

    func eyes_draw [ cv: Canvas, full: rect ]
        if [ !feed[] ]
            cv.draw_image[ camera.image, full ]
            cv.paint[]
            hs_text[ cv, 'no models in {hs_models[]}', 12.0, 8.0,
                bounds.w, 20.0, 14.0, '#ffffffa0' ]
            return
        cw : i32 camera.width
        chh : i32 camera.height
        if [ !grey || grey.count != cw * chh ]
            grey = vec u8 [ cw * chh ]
            pic = Texture [ vk: vk, w: ux, width: cw, height: chh,
                pixel_format: Pixel.u8, surface: Surface.color ]
            drawn = 0
        ms : f32 [ 0.0 ]
        seen = hs_worker_get[ worker, @found[ 0 ], @ms, @grey[ 0 ], cw,
                              chh ]
        took = ms
        if [ seen == 0 ]
            cv.draw_image[ camera.image, full ]
            cv.paint[]
            return
        if [ seen != drawn ]
            pic.upload[ @grey[ 0 ], cw * chh ]
            drawn = seen
        cv.draw_image[ pic, full ]
        cv.paint[]
        # the frame is drawn stretched over the element
        sx : f32 [ bounds.w / f32[ camera.width ] ]
        sy : f32 [ bounds.h / f32[ camera.height ] ]
        # find's square, a pixel wide
        fx : f32 [ found[ 0 ] * bounds.w ]
        fy : f32 [ found[ 1 ] * bounds.h ]
        hw : f32 [ found[ 2 ] * bounds.w / 2.0 ]
        hh : f32 [ found[ 2 ] * bounds.h / 2.0 ]
        cv.fill_color[ rgba [ '#806bff' ] ]
        cv.rect_to[ fx - hw, fy - hh, hw * 2.0, 1.0 ]
        cv.rect_to[ fx - hw, fy + hh, hw * 2.0, 1.0 ]
        cv.rect_to[ fx - hw, fy - hh, 1.0, hh * 2.0 ]
        cv.rect_to[ fx + hw, fy - hh, 1.0, hh * 2.0 ]
        cv.paint[]
        # outer corners red, pupils green
        for [ k: i32 0, k < 4, k += 1 ]
            x : f32 [ found[ 3 + 2 * k ] * sx ]
            y : f32 [ found[ 4 + 2 * k ] * sy ]
            col : string [ (k < 2) ? '#ff4646' : '#46ff6e' ]
            mark[ cv, x, y, 7.0, '#000000' ]
            mark[ cv, x, y, 5.0, col ]
        hs_text[ cv, '{i32[ took ]} ms a frame', 12.0, 8.0, bounds.w,
            20.0, 14.0, '#ffffffa0' ]
