# colortest — one solid color: proves a display path end to end
export 1.0.0
export software ['developer']

import vec
import img
import trinity

element colortest : trinity
    public width      : i32    [ 1280 ]
    public height     : i32    [ 800 ]
    public title      : string [ 'colortest' ]

    func init []
        animated = true

    # the whole screen painted magenta, over trinity's ground (a clear
    # would be painted over)
    public func on_canvas [ cv: Canvas ]
        if [ !cv ] return
        cv.fill_color[ rgba [ '#ff00ff' ] ]
        cv.rect_to[ 0.0, 0.0, f32[ cv.width ], f32[ cv.height ] ]
        cv.paint[]
