extend instancing

import <signal.h>

class AppView
    # what it runs: the module's source
    mutable src : path
    mutable loaded : bool
    # its picture's place in the pane, as last laid out
    mutable vx : f32
    mutable vy : f32
    mutable vw : f32
    mutable vh : f32
    # the pane's scroll at draw time (the press is content space)
    mutable vsx : f32
    mutable vsy : f32
    # what it runs for: a console's program, a service's args ('' or
    # null: the app itself); the registry keeps one per purpose
    mutable what : string
    # the host that holds it (the registry gives it)
    mutable host : InstHost
    mutable slot       : i32 [ -1 ]  # our channel slot at silver-host
    # module name (orbiter resolves its binary to attach)
    mutable app_mod    : string
    mutable arg_text   : string      # its live argument, as last sent
    # the app's history, as it last said
    public  nav_back_on : bool
    # the app has a panel (its strip's toggle), and it is open
    public  has_panel   : bool
    public  panel_on    : bool
    # the app has an outline (its toggle left of the title), open
    public  has_outline : bool
    public  outline_on  : bool
    # the app's focus takes words (a phone's keyboard comes up)
    public  app_words   : bool
    # wheel the app left unused (its ends), for the host's view
    public  wheel_back  : f32
    # the display language last told to the app (-1 none yet)
    intern  lang_told   : i32 [ -1 ]
    # the app's focus types plainly (a console): nothing composed
    public  app_plain   : bool
    # the app asked for a file pick (its + or open button)
    public  pick_ask    : bool
    public  nav_fwd_on  : bool
    # the app's own title, shown on the pane
    public  app_title   : string
    mutable title_buf   : vec u8     # its bytes as they arrive
    # the app's address (a URL), as it last said, and its bytes
    public  app_address : string
    mutable addr_buf    : vec u8
    # the class of the app's own keyboard ('' none), its bytes
    public  app_keys    : string
    mutable keys_buf    : vec u8
    # an address the app asked to open (orbiter takes it), its bytes
    public  open_asked  : string
    mutable open_buf    : vec u8
    # the app's views (its orbiter bar's chips), the one it shows
    # (-1 its source), and their names' bytes as they arrive
    public  app_views   : vec string
    public  app_view_on : i32 [ -1 ]
    mutable views_buf   : vec u8
    # orbiter's tail args, forwarded to the module
    mutable module_args : string
    # a desktop widget: whether it was told it sits on top (-1 never)
    mutable top_sent    : i32 [ -1 ]
    # the home filter last told it (a widget)
    mutable filter_sent : string
    # a widget with nothing matching the home filter
    mutable no_match    : bool
    # the Wayland window this instance's program opened (0: none)
    mutable wl_window   : u64
    # run in no pane (a startup app in its tray): a button only while
    # its window is open, the window in a floating pane
    mutable background  : bool
    # orbiter has attached lldb to this app's pid
    public  attached   : bool
    # lldb attach is running on a worker
    public  attaching  : bool
    mutable debugger   : dbg
    mutable pause_pending : bool
    mutable iid        : i32
    # made, not running: a click on its row starts it
    mutable held       : bool
    # shown small beside the source: the instance's own state
    mutable pip        : bool
    # 0 pip, 1 full (the pane), 2 its own window, 3 that window
    # full-screen
    public  display    : i32
    # the module a program run came from (its apps view card): its
    # Code shows it, not the console the program runs in
    public  origin     : path
    # that module's agent shell (claude, codex, gemini): it reads the
    # app's title for when the agent waits for the user
    public  agent      : AgentRun
    mutable props      : string
    # the app's shared surface pair, imported
    mutable tex0       : Texture
    mutable tex1       : Texture
    # the last size's picture, shown until the new size has a whole
    # frame (its textures start empty: a black flash)
    mutable was_tex    : Texture
    mutable was_other  : Texture
    mutable was_w      : i32
    mutable was_h      : i32
    # the texture last shown whole (0 or 1)
    mutable shown_fr   : i32
    # flips seen since the pair's import, and the last front seen
    mutable flips_in   : i32
    mutable last_fr    : i32
    # generation of the imported surface
    mutable gen        : i32
    # it ended as a library does: nothing there to run
    mutable no_app     : bool
    # console command (streams the app's log)
    mutable cmd        : string
    # cmd handed to its console session (once per run)
    mutable dispatched : bool
    public  clean_build : bool       # silver-host runs --clean first
    # the module builds -O0 -g for the debugger
    public  debug_build : bool
    # silver --coverage: the run writes coverage.lcov
    public  cov_build   : bool
    # silver --verbose: the whole build in the console
    public  verbose_build : bool
    # a file handler: hosted to view, never under the debugger
    public  viewer      : bool
    mutable doc        : path
    mutable pend_w     : i32
    mutable pend_h     : i32
    mutable req_w      : i32
    mutable req_h      : i32
    mutable pend_us    : i64
    mutable started    : bool
    mutable asking     : bool        # its bare argument is being picked
    mutable did_build  : bool        # its log shows a module compiled
    mutable build_ms   : i64         # when the log was last read for it
    mutable ready      : bool
    # mouse lock asked by the app (HM.lock): 1 lock, 2 release; centre
    # in app px; carried fractions
    mutable lock_req   : i32
    mutable lock_cx    : i32
    mutable lock_cy    : i32
    mutable lock_ax    : f32
    mutable lock_ay    : f32
    mutable ended       : bool
    # peer frozen (SIGSTOP) — last frame shows
    mutable paused     : bool
    # parked in the debugger: never ask it anything
    mutable stopped    : bool
    mutable note       : string
    mutable aw         : i32
    mutable ah         : i32
    # the picture's shape as the app told it (HM.aspect); 0 = unknown
    mutable pic_w      : i32
    # shown nowhere this frame (a tab behind another): set by the
    # host before service, which tells the app once
    public  unseen     : bool
    intern  told_seen  : bool [ true ]
    mutable pic_h      : i32
    # the frame the app showed as its window switched to orbiter: the
    # pip until the instance runs and its own frames arrive
    mutable still      : Texture
    # the app asked for its orbiter: this one comes forward
    mutable wants_ide  : bool
    # the app's exchange mic asked: 3 start, 0 stop, 2 cancel
    mutable dict_req   : i32 [ -1 ]
    # the display's pixels per point: the app's texture is in device
    # pixels, the pane and the app's own events are in points
    mutable ascale     : f32 [ 1.0 ]
    mutable have_frame : bool
    mutable fade_us    : i64
    # stopped last frame; resumed at (ms, the switch waits 150 ms);
    # its frame fading in over the source since (ms)
    mutable halt_was   : bool
    mutable resume_ms  : i64
    mutable fade_in_ms : i64
    # it was in view while it ran: only then does a resume bring it
    mutable in_view    : bool
    mutable seen_us    : i64
    # picture in picture: its box from the pane's right and bottom
    mutable pip_r      : f32 [ 16.0 ]
    mutable pip_b      : f32 [ 16.0 ]
    # its width asked (0: the default), and the box as now shown
    mutable pip_w      : f32
    mutable pip_sr     : f32
    mutable pip_sb     : f32
    mutable pip_sw     : f32
    mutable fitx       : f32
    mutable fity       : f32
    mutable fitw       : f32
    mutable fith       : f32
    # the app locked its aspect: letterbox it. otherwise clip
    mutable locked     : bool
    # the gain the app started at; -1 until it answers, then adopted
    # once
    mutable app_vol    : f32 [ -1.0 ]
    # its own volume (the bar's App mode), its mute, and what it was
    # last sent (master x own)
    mutable vol        : f32 [ -1.0 ]
    mutable vol_mute   : bool
    mutable vol_sent   : f32 [ -1.0 ]
    # what the running instance says it can show, asked once
    mutable instr_names : vec string
    mutable instr_ask   : bool
    # the instruments actually up, and the surface each one publishes
    mutable instr_live  : vec string
    mutable instr_side  : map i32     [string]
    mutable instr_logs  : map i32     [string]
    mutable instr_gen   : map i32     [string]
    mutable instr_pw    : map i32     [string]
    mutable instr_ms    : i64
    mutable instr_ak    : i64
    # the last props re-ask: live values read back twice a second
    mutable props_ak    : i64
    # when the user last picked a display: the app's echo lags it
    mutable disp_ms     : i64
    # a display the app reported that orbiter has yet to follow
    mutable disp_pending : i32 [ -1 ]
    # this display's refresh, given by the pane that starts it
    mutable host_hz     : i32
    # DIAG: frame requests posted this second
    mutable pane_req    : i32
    # DIAG: front flips seen this second
    mutable pane_flip   : i32
    # DIAG: last front + 1 (0 = none yet)
    mutable pane_seen   : i32
    mutable pane_sec    : i64
    mutable itex0       : map Texture [string]
    mutable itex1       : map Texture [string]
    mutable dbg_nw     : i32
    mutable dbg_nh     : i32
    mutable dbg_aw     : i32
    mutable dbg_ah     : i32
    # the pane's draw posted this frame's request itself
    mutable req_drawn  : bool
    # a program run for debugging: pause attaches lldb to it
    mutable prog_debug : bool
    # started from its code's editor (play): the pane keeps its
    # debug bar; a dock or home launch shows none
    mutable edited     : bool
    # its builds applied as they land (the app's own default), or
    # held until Reload
    mutable manual_reload : bool

    func extensions [] -> vec string
        return vec string []

    func is_app_host [] -> bool
        return true

    func continuous [] -> bool
        return true

    func service [ cv: Canvas ]
        if [ held ] return
        if [ !started ]
            if [ asking ] return
            if [ host && host.ask_default*[ a ] ] return
            start[]
        if [ slot < 0 ] return
        # the display language: told once, again on a change
        lv : i32 [ i32[ display_language ] ]
        if [ ready && lang_told != lv ]
            host_post2[ slot, 1, i32[ HM.language ], lv, 0, 0 ]
            lang_told = lv
        for [ i: i32 0, i < 16, i += 1 ]
            t : i32 [ host_poll2[ slot, 0 ] ]
            if [ t == 0 ] break
            if [ t == i32[ HM.lock ] ]
                lock_req = (host_pa[] != 0) ? 1 : 2
                lock_cx  = host_pb[]
                lock_cy  = host_pc[]
            # the app's orbiter button: this orbiter is its orbiter
            el [ t == i32[ HM.shell ] && host_pa[] == 1 ]
                wants_ide = true
            # the app's exchange mic: orbiter transcribes it (it takes
            # the request from here), and types the take back
            el [ t == i32[ HM.dictate ] ]
                dict_req = host_pa[]
            # the app's picture shape: a pip is sized to it
            el [ t == i32[ HM.aspect ] ]
                pic_w = host_pa[]
                pic_h = host_pb[]
                # a widget: the home filter left it nothing
                no_match = host_pc[] != 0
                # a desktop widget's box takes the new height
                wg : cast Window [ cv.w ]
                if [ wg ] wg.restyle = true
            # the app's history moved: the title's arrows follow
            el [ t == i32[ HM.panel_state ] ]
                has_panel   = (host_pa[] & 1) != 0
                panel_on    = (host_pb[] & 1) != 0
                has_outline = (host_pa[] & 2) != 0
                outline_on  = (host_pb[] & 2) != 0
                wp : cast Window [ cv.w ]
                if [ wp ] wp.restyle = true
            el [ t == i32[ HM.pick ] ]
                pick_ask = true
                wk : cast Window [ cv.w ]
                if [ wk ] wk.restyle = true
            el [ t == i32[ HM.wheel_left ] ]
                wheel_back += f32[ host_pb[] ] / 100.0
            el [ t == i32[ HM.words ] ]
                app_words = host_pa[] != 0
                app_plain = host_pa[] == 2
                ww : cast Window [ cv.w ]
                if [ ww ] ww.restyle = true
            el [ t == i32[ HM.nav_state ] ]
                nav_back_on = host_pa[] != 0
                nav_fwd_on  = host_pb[] != 0
                wn : cast Window [ cv.w ]
                if [ wn ] wn.restyle = true
            # the app's views, '|' between, three bytes a message
            el [ t == i32[ HM.views ] ]
                if [ !views_buf ] views_buf = vec u8 []
                vb_ : local i32 [ 3 ]
                vb_[0] = host_pa[]
                vb_[1] = host_pb[]
                vb_[2] = host_pc[]
                for [ k_: i32 0, k_ < 3, k_ += 1 ]
                    if [ vb_[k_] != 0 ]
                        views_buf.push[ u8 vb_[k_] ]
                        continue
                    vt : local i8 [ 1024 ]
                    vn_ : i32 [
                        (views_buf.count < 1023)
                        ? i32[ views_buf.count ] : 1023 ]
                    for [ j_: i32 0, j_ < vn_, j_ += 1 ]
                        vt[ j_ ] = i8[ views_buf[ j_ ] ]
                    vt[ vn_ ] = 0
                    joined : string [ @vt[0] ]
                    app_views = vec string []
                    if [ joined.count > 0 ]
                        for [ vw: string ] in joined.split[ '|' ]
                            app_views.push[ vw ]
                    views_buf = vec u8 []
                    wv_ : cast Window [ cv.w ]
                    if [ wv_ ] wv_.restyle = true
                    break
            # the view the app shows (-1 its source)
            el [ t == i32[ HM.view_state ] ]
                app_view_on = host_pa[]
                ws_ : cast Window [ cv.w ]
                if [ ws_ ] ws_.restyle = true
            # the app's address, as its title
            el [ t == i32[ HM.address ] ]
                if [ !addr_buf ] addr_buf = vec u8 []
                ab : local i32 [ 3 ]
                ab[0] = host_pa[]
                ab[1] = host_pb[]
                ab[2] = host_pc[]
                for [ k_: i32 0, k_ < 3, k_ += 1 ]
                    if [ ab[k_] != 0 ]
                        addr_buf.push[ u8 ab[k_] ]
                        continue
                    app_address = inst_text[ addr_buf ]
                    addr_buf = vec u8 []
                    wa_ : cast Window [ cv.w ]
                    if [ wa_ ] wa_.restyle = true
                    break
            # an address the app asks opened, as its keyboard comes
            el [ t == i32[ HM.open ] ]
                if [ !open_buf ] open_buf = vec u8 []
                ob : local i32 [ 3 ]
                ob[0] = host_pa[]
                ob[1] = host_pb[]
                ob[2] = host_pc[]
                for [ k_: i32 0, k_ < 3, k_ += 1 ]
                    if [ ob[k_] != 0 ]
                        open_buf.push[ u8 ob[k_] ]
                        continue
                    open_asked = inst_text[ open_buf ]
                    open_buf = vec u8 []
                    break
            # the app's keyboard class, as its address comes
            el [ t == i32[ HM.keys ] ]
                if [ !keys_buf ] keys_buf = vec u8 []
                kb : local i32 [ 3 ]
                kb[0] = host_pa[]
                kb[1] = host_pb[]
                kb[2] = host_pc[]
                for [ k_: i32 0, k_ < 3, k_ += 1 ]
                    if [ kb[k_] != 0 ]
                        keys_buf.push[ u8 kb[k_] ]
                        continue
                    app_keys = inst_text[ keys_buf ]
                    keys_buf = vec u8 []
                    wk_ : cast Window [ cv.w ]
                    if [ wk_ ] wk_.restyle = true
                    break
            # the app's title, three bytes a message; a 0 byte ends it
            el [ t == i32[ HM.title ] ]
                if [ !title_buf ] title_buf = vec u8 []
                bs_ : local i32 [ 3 ]
                bs_[0] = host_pa[]
                bs_[1] = host_pb[]
                bs_[2] = host_pc[]
                for [ k_: i32 0, k_ < 3, k_ += 1 ]
                    if [ bs_[k_] != 0 ]
                        title_buf.push[ u8 bs_[k_] ]
                        continue
                    # string[ @vec[0] ] is a pointer cast: copy to a
                    # local
                    tb : local i8 [ 1024 ]
                    tn : i32 [
                        (title_buf.count < 1023)
                        ? i32[ title_buf.count ] : 1023 ]
                    for [ j_: i32 0, j_ < tn, j_ += 1 ]
                        tb[ j_ ] = i8[ title_buf[ j_ ] ]
                    tb[ tn ] = 0
                    app_title = string[ @tb[0] ]
                    title_buf = vec u8 []
                    wt_ : cast Window [ cv.w ]
                    if [ wt_ ] wt_.restyle = true
                    break
        st : i32 [ host_app_state[ slot ] ]
        if [ st == 4 && !paused ]
            paused = true
            v8 : i32 [ host_app_verdict[ slot ] ]
            sg : i32 [ 0 - v8 ]
            note = 'frozen — signal {sg}'
        if [ st == 3 && !ended ]
            ended   = true
            paused = false
            # its view rect goes with it: left set, a click on the
            # source in the same pane (where the app was drawn)
            # restarted the app
            fitw = 0.0
            fith = 0.0
            instr_clear[]
            v_ : i32 [ host_app_verdict[ slot ] ]
            # a library builds, then has no program to start (the host
            # says it as a failed build)
            no_app = v_ <= -1000 && app_mod
                && !is_app_module[ app_mod, cv ]
            if [ no_app ]
                note = '{app_mod} is a library: it has no app to run'
            el [ v_ <= -1000 ]
                note = 'build failed'
                # the first error in the app's own log names file and
                # line
                if [ host && app_mod ]
                    bl : string host.build_error*[ app_mod,
                        '{inst_root[]}/tmp/{app_mod}.{slot}.log' ]
                    if [ bl.count > 0 ] note = bl
            el [ v_ < 0 ]
                sig : i32 [ 0 - v_ ]
                note = 'crashed — signal {sig}'
            el [ v_ > 1 ]
                ec : i32 [ v_ - 1 ]
                note = 'exited — code {ec}'
            # ended with no word and nothing drawn: say why it is not
            # running (a library has no app to run)
            el [ gen <= 0 ]
                no_app = app_mod && !is_app_module[ app_mod, cv ]
                note = (no_app)
                    ? '{app_mod} is a library: it has no app to run'
                    : '{app_mod} ended before its first frame'
            el
                note = 'app exited'
            # the console shows its log: the reason goes there too,
            # unless the log already said it (a build's own error)
            if [ failed[] && v_ > -1000 || no_app ] log_reason[]
        if [ ended ] return
        g_ : i32 [ host_tex_gen[ slot, 0 ] ]
        if [ g_ != gen && g_ > 0 ]
            w_ : i32
            h_ : i32
            f_ : i32
            fd0 : i32 [ host_tex_pull[ slot, 0, 0, @w_, @h_, @f_ ] ]
            fd1 : i32 [ host_tex_pull[ slot, 0, 1, @w_, @h_, @f_ ] ]
            if [ fd0 < 0 || fd1 < 0 ]
                fq : fopen[ '/tmp/orbiter-resz.log', 'a' ]
                if [ fq ]
                    fprintf[ fq,
                             "PULL FAIL gen=%d->%d fd0=%d fd1=%d %dx%d slot=%d\n",
                        gen, g_, fd0, fd1, w_, h_, slot ]
                    fclose[ fq ]
            if [ fd0 >= 0 && fd1 >= 0 ]
                # a pair that never showed a whole frame is not kept:
                # the older picture stays
                if [ tex0 && flips_in >= 3 ]
                    if [ was_tex ]
                        was_tex.drop[]
                        was_other.drop[]
                    was_tex   = (shown_fr == 1) ? tex1 : tex0
                    was_other = (shown_fr == 1) ? tex0 : tex1
                    was_w = aw
                    was_h = ah
                el [ tex0 ]
                    tex0.drop[]
                    tex1.drop[]
                flips_in = 0
                last_fr  = -1
                tex0 = cv.vk.import_shared_tex[ fd0, w_, h_, f_, cv.w ]
                tex1 = cv.vk.import_shared_tex[ fd1, w_, h_, f_, cv.w ]
                tex0.hold[]
                tex1.hold[]
                aw  = w_
                ah  = h_
                gen = g_
                ready      = true
                have_frame = true
                if [ seen_us == 0 ] seen_us = epoch_micros[]
                dw : i32 [ i32[ vw ] - i32[ awp[] ] ]
                dh_ : i32 [ i32[ vh ] - i32[ ahp[] ] ]
                if [ dw < 0 ] dw = 0 - dw
                if [ dh_ < 0 ] dh_ = 0 - dh_
                if [ fade_us == 0 && dw <= 2 && dh_ <= 2 ]
                    fade_us = epoch_micros[]

        # ask what it offers. KEEP asking until it answers — the app
        # opens its agent socket a moment after it is ready, and a
        # one-shot ask that lands in that gap leaves the bar with no
        # instruments button
        if [
            ready && !instr_ask && !stopped && !paused && app_mod
            && app_mod.count > 0 ]
            ak : i64 [ epoch_millis[] ]
            if [ instr_ak == 0 || ak - instr_ak > 500 ]
                instr_ak = ak
                vb : local i8 [ 512 ]
                if [
                    agent_sock_ask[ sock_name[].chars, 'instruments\n',
                                    @vb[0], 512 ] > 0 ]
                    vs8 : string [ @vb[0] ]
                    vt : string vs8.trim[]
                    if [ vt && vt.count > 0 ]
                        instr_names = vt.split[ ' ' ]
                        instr_ask   = true
                        if [
                            agent_sock_ask[ sock_name[].chars,
                                            'aspect\n', @vb[0],
                                            512 ] > 0 ]
                            la : string [ @vb[0] ]
                            lw : vec string la.trim[].split[ ' ' ]
                            locked = lw.count > 0 && lw[ 0 ] == '1'
                            # its locked shape, unless it sent its own
                            if [ locked && lw.count >= 3 && pic_w <= 0 ]
                                pic_w = i32[ lw[ 1 ].integer_value[] ]
                                pic_h = i32[ lw[ 2 ].integer_value[] ]
                        # the app enumerates its own Launch/Live members
                        pb8 : local i8 [ 16384 ]
                        if [
                            agent_sock_ask_block[ sock_name[].chars,
                                                  'props\n', @pb8[0],
                                                  16384 ] > 0 ]
                            ps8 : string [ @pb8[0] ]
                            props = ps8.trim[]
                        # the app's own gain seeds the slider, once
                        if [
                            agent_sock_ask[ sock_name[].chars,
                                            'volume\n', @vb[0],
                                            512 ] > 0 ]
                            lv : string [ @vb[0] ]
                            app_vol = f32[ lv.trim[].real_value[] ]
        # a pane that draws asks for the next frame as it reads this one
        # (draw_frame); one shown nowhere is told so, and asked nothing
        # (it runs on at a few frames a second)
        seen : bool [ req_drawn || !unseen ]
        if [ started && slot >= 0 && seen != told_seen ]
            told_seen = seen
            host_post2[ slot, 1, i32[ HM.shown ], (seen) ? 1 : 0, 0, 0 ]
        if [ !req_drawn && !unseen ] request_frame[ cv ]
        req_drawn = false
        unseen    = false
        # the app's sound rides its slot's ring: into the recording, if
        # one is on
        if [ started && slot >= 0 && !held && !ended ]
            pa_ : Window [ cv.w ]
            if [ pa_ ] pa_.record_pull[ slot ]
        # the app's live props, re-read twice a second: a value the app
        # changed itself (esc leaving full-screen) shows here without a
        # round trip. gated on the process, not on a frame: a windowed
        # or still-loading instance answers its socket long before (or
        # without) drawing here
        if [
            started && slot >= 0 && !stopped && !paused && !ended
            && !held && app_mod && app_mod.count > 0 ]
            pk : i64 [ epoch_millis[] ]
            if [ props_ak == 0 || pk - props_ak > 500 ]
                props_ak = pk
                pb_ : local i8 [ 16384 ]
                if [
                    agent_sock_ask_block[ sock_name[].chars, 'props\n',
                                          @pb_[0], 16384 ] > 0 ]
                    ps_ : string [ @pb_[0] ]
                    pt_ : string ps_.trim[]
                    if [ pt_ && pt_.count > 0 ] props = pt_
                    # the app's display is the truth: a change it made
                    # (esc, its own code) is followed here, unless the
                    # user's pick is in flight
                    if [ props && pk - disp_ms > 1500 ]
                        ps8 : LaunchProps []
                        Au.parse_agi[ null, props.chars, ps8 ]
                        if [ ps8.props ]
                            for [ p8: Prop ] in ps8.props
                                if [ p8.ident != 'display' || !p8.stops || !p8.value ]
                                    continue
                                for [ i8: i32 0,
                                      i8 < p8.stops.count && i8 <= 3,
                                      i8 += 1 ]
                                    if [ p8.stops[ i8 ] == p8.value && i8 != display ]
                                        disp_pending = i8
        instr_service[ cv ]
        # the window's pixels per point (a cached canvas carries no
        # device scale in its transform, which read 1 here and drew the
        # app 2x)
        wn : Window [ cv.w ]
        if [ wn && wn.scale > 0.0 ] ascale = wn.scale
        if [ ready && fade_us == 0 && seen_us != 0 ]
            if [ epoch_micros[] - seen_us > 1500000 ]
                fade_us = epoch_micros[]
        nw : i32[ vw ]
        nh : i32[ vh ]
        if [
            nw != dbg_nw || nh != dbg_nh || aw != dbg_aw
            || ah != dbg_ah ]
            dbg_nw = nw
            dbg_nh = nh
            dbg_aw = aw
            dbg_ah = ah
            fz_ : fopen[ '/tmp/orbiter-resz.log', 'a' ]
            if [ fz_ ]
                fprintf[ fz_,
                         "RESZ view=%dx%d actual=%dx%d req=%dx%d pend=%dx%d ready=%d slot=%d gen=%d shared=%d\n",
                    nw, nh, aw, ah, req_w, req_h, pend_w, pend_h,
                    (ready) ? 1 : 0, slot,
                    gen, host_tex_gen[ slot, 0 ] ]
                fclose[ fz_ ]
        # embed (and a file viewer, which always fills its pane) gives
        # the app the editor's whole area: pip, window and screen never
        # resize
        if [ ready && nw > 0 && nh > 0 && (display == 1 || viewer) ]
            if [ nw != pend_w || nh != pend_h ]
                pend_w  = nw
                pend_h  = nh
                pend_us = epoch_micros[]
            if [ nw != i32[ awp[] ] || nh != i32[ ahp[] ] ]
                # told at once, no wait; a size a pixel off the last
                # asked is the layout settling: not a new size
                far : bool [ abs[ nw - req_w ] > 1
                             || abs[ nh - req_h ] > 1 ]
                if [ far ]
                    req_w = nw
                    req_h = nh
                    host_post2[ slot, 1, i32[ HM.resize ], nw, nh, 0 ]

    # the app's size in points
    func awp [] -> f32
        return f32[ aw ] / ((ascale > 0.0) ? ascale : 1.0)
    func ahp [] -> f32
        return f32[ ah ] / ((ascale > 0.0) ? ascale : 1.0)

    func front [] -> Texture
        fr : i32 [ host_tex_front[ slot, 0 ] ]
        if [ fr < 0 || !tex0 ] return null
        if [ fr != last_fr ]
            last_fr   = fr
            flips_in += 1
        # the import may wipe a frame drawn before it: three flips
        # since, and both textures hold frames drawn after it
        if [ flips_in < 3 ] return null
        shown_fr = fr
        # the new size has a whole frame: the old picture goes
        if [ was_tex ]
            was_tex.drop[]
            was_other.drop[]
            was_tex = null
            was_other = null
        return (fr == 0) ? tex0 : tex1

    # 'name:side:log' from the app, straight into our live state. side
    # is
    # -1 for the usual case: an instrument that is entries and no view
    func instr_apply [ s: string ]
        instr_live = vec string []
        if [ !instr_side ] instr_side = map i32 [string] []
        if [ !instr_logs ] instr_logs = map i32 [string] []
        if [ !s ] return
        t_ : string s.trim[]
        if [ t_.count == 0 ] return
        ps : t_.split[ ' ' ]
        for [ i: i32 0, i < ps.count, i += 1 ]
            f_ : ps[i].split[ ':' ]
            if [ f_.count < 3 ] continue
            nm : string f_[0]
            instr_live.push[ nm ]
            instr_side[ nm ] = i32[ f_[1].integer_value[] ]
            instr_logs[ nm ] = i32[ f_[2].integer_value[] ]

    # a missing key is not a zero: reading one dereferences null
    func instr_num [ m: map i32 [string], nm: string, dflt: i32 ] -> i32
        if [ !m || !nm ] return dflt
        if [ !m.contains[ nm ] ] return dflt
        return m[ nm ]

    func instr_is_logging [ nm: string ] -> bool
        return instr_num[ instr_logs, nm, 0 ] != 0

    # the ONLY toggle: logging for one instrument. the reply is state
    func instr_toggle [ nm: string, logging: bool ]
        if [ !app_mod || !nm || nm.count == 0 ] return
        cb : local i8 [ 512 ]
        if [
            agent_sock_ask[ sock_name[].chars, 'instr-log {nm}\n',
                            @cb[0], 512 ] > 0 ]
            instr_apply[ string [ @cb[0] ] ]

    # one instrument on at a time: nm turns on and every other turns
    # off; nm already on turns off, leaving none
    func instr_select [ nm: string ]
        if [ !instr_names ] return
        was : bool [ instr_is_logging[ nm ] ]
        for [ i: i32 0, i < instr_names.count, i += 1 ]
            on : string instr_names[ i ]
            if [ on.compare[ nm ] != 0 && instr_is_logging[ on ] ]
                instr_toggle[ on, false ]
        # the lit one again goes off: none is up then
        instr_toggle[ nm, !was ]

    # the process is gone: no instrument is up, and the next one asks
    # again
    func instr_clear []
        instr_names = null
        instr_ask   = false
        instr_live  = null
        instr_logs  = null
        instr_side  = null
        instr_gen   = null
        instr_pw    = null

    func instr_active [] -> string
        if [ !instr_names ] return null
        for [ i: i32 0, i < instr_names.count, i += 1 ]
            if [ instr_is_logging[ instr_names[ i ] ] ]
                return instr_names[ i ]
        return null

    # pull each instrument's own surface. gen 0 means it has none
    func instr_service [ cv: Canvas ]
        # a stopped or frozen app answers nothing: every ask would wait
        # its full timeout
        if [ stopped || paused ] return
        # nothing toggles any more, so the state has to be asked for
        nw : i64 [ epoch_millis[] ]
        if [ app_mod && (instr_ms == 0 || nw - instr_ms > 1000) ]
            instr_ms = nw
            sb : local i8 [ 1024 ]
            if [
                agent_sock_ask[ sock_name[].chars, 'instr\n', @sb[0],
                                1024 ] > 0 ]
                instr_apply[ string [ @sb[0] ] ]
        if [ !instr_live || instr_live.count == 0 ] return
        if [ !itex0 ]     itex0     = map Texture [string] []
        if [ !itex1 ]     itex1     = map Texture [string] []
        if [ !instr_gen ] instr_gen = map i32 [string] []
        for [ i: i32 0, i < instr_live.count, i += 1 ]
            nm : string instr_live[i]
            sd : i32 [ instr_num[ instr_side, nm, -1 ] ]
            if [ sd < 2 ] continue
            g_ : i32 [ host_tex_gen[ slot, sd ] ]
            if [ g_ == instr_num[ instr_gen, nm, -1 ] ] continue
            if [ g_ <= 0 ]
                instr_gen[ nm ] = 0
                continue
            w_ : i32
            h_ : i32
            f_ : i32
            fd0 : i32 [ host_tex_pull[ slot, sd, 0, @w_, @h_, @f_ ] ]
            fd1 : i32 [ host_tex_pull[ slot, sd, 1, @w_, @h_, @f_ ] ]
            if [ fd0 < 0 || fd1 < 0 ] continue
            e0 : itex0[ nm ]
            if [ e0 ]
                e0.drop[]
                itex1[ nm ].drop[]
            t0 : cv.vk.import_shared_tex[ fd0, w_, h_, f_, cv.w ]
            t1 : cv.vk.import_shared_tex[ fd1, w_, h_, f_, cv.w ]
            t0.hold[]
            t1.hold[]
            itex0[ nm ] = t0
            itex1[ nm ] = t1
            instr_gen[ nm ] = g_

    # the completed frame of one instrument, or null when it has no view
    func instr_front [ nm: string ] -> Texture
        if [ !instr_side || !itex0 || !nm ] return null
        sd : i32 [ instr_num[ instr_side, nm, -1 ] ]
        if [ sd < 2 ] return null
        fr : i32 [ host_tex_front[ slot, sd ] ]
        if [ fr < 0 || !itex0[ nm ] ] return null
        return (fr == 0) ? itex0[ nm ] : itex1[ nm ]

    # we say the width; the height is the app's own. only on a change —
    # this runs on the draw path
    func instr_width [ nm: string, iw: i32 ]
        if [ !app_mod || !nm || iw <= 0 ] return
        if [ !instr_pw ] instr_pw = map i32 [string] []
        if [ instr_num[ instr_pw, nm, -1 ] == iw ] return
        instr_pw[ nm ] = iw
        agent_sock_send[ sock_name[].chars, 'instr-width {nm} {iw}\n' ]

    # the entries themselves, asked of the running instance
    func instr_entries [ nm: string ] -> vec string
        if [ !app_mod || !nm || nm.count == 0 ] return null
        # a parked peer answers nothing: the ask would sit its whole
        # timeout, every frame
        if [ stopped || paused ] return null
        rb : local i8 [ 8192 ]
        if [ agent_sock_ask[ sock_name[].chars, 'instr-read {nm}\n', @rb[0], 8192 ] <= 0 ]
            return null
        rs : string [ @rb[0] ]
        rt : string rs.trim[]
        if [ rt.count == 0 ] return null
        return rt.split[ '\n' ]

    func draw_frame [ cv: Canvas, bounds: rect ]
        ft : front[]
        # the new size not drawn yet: the old picture at its own size
        if [ !ft && was_tex && have_frame ]
            ow : f32 [ f32[ was_w ] / ((ascale > 0.0) ? ascale : 1.0) ]
            oh : f32 [ f32[ was_h ] / ((ascale > 0.0) ? ascale : 1.0) ]
            if [ locked && was_h > 0 ]
                ar : f32 [ f32[ was_w ] / f32[ was_h ] ]
                ow = bounds.w
                oh = ow / ar
                if [ oh > bounds.h ]
                    oh = bounds.h
                    ow = oh * ar
                cv.draw_image[ was_tex,
                    rect [ x: bounds.x + (bounds.w - ow) * 0.5,
                           y: bounds.y + (bounds.h - oh) * 0.5,
                           w: ow, h: oh ] ]
            el
                cw : f32 [ (bounds.w < ow) ? bounds.w : ow ]
                ch : f32 [ (bounds.h < oh) ? bounds.h : oh ]
                cv.draw_image_crop[ was_tex,
                    rect [ x: bounds.x, y: bounds.y, w: cw, h: ch ],
                    0.0, 0.0, cw / ow, ch / oh ]
            return
        if [ ft && have_frame ]
            request_frame[ cv ]
            req_drawn = true
            if [ locked ]
                ar : f32 [ f32[ aw ] / f32[ ah ] ]
                fw : f32 [ bounds.w ]
                fh : f32 [ fw / ar ]
                if [ fh > bounds.h ]
                    fh = bounds.h
                    fw = fh * ar
                fitx = bounds.x + (bounds.w - fw) * 0.5
                fity = bounds.y + (bounds.h - fh) * 0.5
                fitw = fw
                fith = fh
                cv.draw_image[ ft,
                               rect [ x: fitx, y: fity, w: fitw,
                                      h: fith ] ]
            el
                # the app at its own size (points, not device pixels),
                # cropped to the pane until the resize lands
                fitx = bounds.x
                fity = bounds.y
                fitw = awp[]
                fith = ahp[]
                cw : f32 [ (bounds.w < fitw) ? bounds.w : fitw ]
                ch : f32 [ (bounds.h < fith) ? bounds.h : fith ]
                cv.draw_image_crop[ ft,
                                    rect [ x: fitx, y: fity, w: cw,
                                           h: ch ],
                    0.0, 0.0, cw / fitw, ch / fith ]
        # no frame yet: say what it is doing instead of drawing nothing
        if [ ended || halted[] || !have_frame ]
            overlay[ cv, bounds ]

    # its picture scaled whole into a box (picture in picture)
    func draw_fitted [ cv: Canvas, box: rect ]
        ft : front[]
        if [ !ft || !have_frame || aw <= 0 || ah <= 0 ] return
        request_frame[ cv ]
        req_drawn = true
        cv.draw_image[ ft, box ]

    # a paned app draws one frame per frame we draw. the request goes
    # out as the pane reads the last one, after the tick's work, so the
    # app renders while we finish, submit and wait on the refresh, and
    # the frame it answers is read a whole refresh later: every frame
    # shown once, in order, as long as it answers within a refresh.
    # asked at the tick, the answer landed before or after the read by
    # chance, and a frame was shown twice or skipped
    func request_frame [ cv: Canvas ]
        if [
            !started || slot < 0 || display > 1 || held || ended
            || paused ]
            return
        host_post2[ slot, 1, i32[ HM.frame ], 0, 0, 0 ]
        pane_req += 1
        fr : i32 [ host_tex_front[ slot, 0 ] + 1 ]
        if [ fr != pane_seen ]
            pane_seen  = fr
            pane_flip += 1
        ps_ : i64 [ epoch_millis[] / 1000 ]
        if [ ps_ != pane_sec ]
            pw_ : Window [ cv.w ]
            if [ pane_sec != 0 && pw_ && pw_.stats ]
                log 'PANE slot={slot} req={pane_req} flips={pane_flip}'
                # the app's own counters beside ours: a leak shows in
                # either
                sb_ : local i8 [ 8192 ]
                if [
                    agent_sock_ask[ sock_name[].chars, 'stats\n',
                                    @sb_[0], 8192 ] > 0 ]
                    sl_ : string [ @sb_[0] ]
                    log 'APP {app_mod}-{slot}: {sl_.trim[]}'
            pane_sec  = ps_
            pane_req  = 0
            pane_flip = 0

    func render [ cv: Canvas, bounds: rect ]
        service[ cv ]
        draw_frame[ cv, bounds ]

    # width over height of the picture: the app's word, else its frame
    func pic_aspect [] -> f32
        if [ pic_w > 0 && pic_h > 0 ] return f32[ pic_w ] / f32[ pic_h ]
        if [ aw > 0 && ah > 0 ] return f32[ aw ] / f32[ ah ]
        return 0.0

    # what its build is doing now, read from the build's log (four
    # times a second at most): compiling, testing, linking
    intern step_ms  : i64
    intern step_txt : string

    func building [] -> bool
        return slot >= 0 && host_app_state[ slot ] == 1

    # a module really compiled, not only found up to date
    func compiled [] -> bool
        if [ did_build ] return true
        ms : i64 epoch_millis[]
        if [ ms - build_ms < 250 ] return false
        build_ms = ms
        lp : path '{inst_root[]}/tmp/{app_mod}.{slot}.log'
        if [ !lp.exists[] ] return false
        body : string lp.load[ typeid[string], null ]
        if [ !body ] return false
        did_build = body.index_of[ '] compiling ' ] >= 0
            || body.index_of[ '] linking ' ] >= 0
        return did_build

    func build_step [] -> string
        ms : i64 epoch_millis[]
        if [ step_txt && ms - step_ms < 250 ] return step_txt
        step_ms  = ms
        step_txt = 'compiling {app_mod}'
        lp : path '{inst_root[]}/tmp/{app_mod}.{slot}.log'
        if [ !lp.exists[] ] return step_txt
        body : string lp.load[ typeid[string], null ]
        if [ !body ] return step_txt
        rows : body.split[ '\n' ]
        for [ i: i32 i32[ rows.count ] - 1, i >= 0, i -= 1 ]
            ln : string rows[ i ]
            # its own words, then the module in brackets
            if [ !ln.starts_with[ '[' ] ] continue
            ce : i32 [ ln.index_of[ ']' ] ]
            if [ ce < 2 ] continue
            who : string ln.mid[ 1, ce - 1 ]
            rest : string ln.mid[ ce + 1, ln.count - ce - 1 ].trim[]
            if [ who.starts_with[ 'import ' ] ]
                who = who.mid[ 7, who.count - 7 ]
                if [ who.starts_with[ 'silver-' ] ]
                    who = who.mid[ 7, who.count - 7 ]
            if [ rest.starts_with[ 'expect: ' ] ]
                tn : string rest.mid[ 8, rest.count - 8 ]
                sp : i32 [ tn.index_of[ ' ' ] ]
                if [ sp > 0 ] tn = tn.mid[ 0, sp ]
                step_txt = 'testing {who}: {tn}'
                return step_txt
            if [ rest.starts_with[ 'compiling' ] ]
                step_txt = 'compiling {who}'
                return step_txt
            if [ rest.starts_with[ 'linking' ] ]
                step_txt = 'linking {who}'
                return step_txt
            if [ rest.starts_with[ 'built' ] ]
                step_txt = 'built {who}'
                return step_txt
        return step_txt

    # what the shell should SAY about this app right now. null once it
    # is up and drawing — waiting blind is the thing this exists to stop
    func status_text [] -> string
        if [ ended ]
            return (note && note.count > 0) ? note : 'exited'
        if [ paused ]
            return (note && note.count > 0) ? note : 'paused'
        if [ attaching ] return 'attaching debugger to {app_mod}...'
        st7 : i32 [ (slot >= 0) ? host_app_state[ slot ] : 0 ]
        if [ st7 == 1 ]  return '{build_step[]}...'
        # its own window: no frame ever arrives here, so nothing is
        # awaited
        if [ display >= 2 ] return null
        if [ !ready ]    return 'starting {app_mod}...'
        return null

    # one word for the instance chip; empty once the app is up and
    # drawing
    # stopped: under a debugger, while it holds the app at a stop;
    # else the host's pause
    func halted [] -> bool
        if [ debugger && debugger.active ] return !debugger.running
        return paused

    func status_word [] -> string
        if [ held ]      return 'not running'
        if [ ended ]     return 'exited'
        if [ halted[] ]  return 'paused'
        if [ attaching ] return 'attaching'
        st8 : i32 [ (slot >= 0) ? host_app_state[ slot ] : 0 ]
        if [ st8 == 1 ]  return 'compiling'
        if [ display >= 2 ] return ''
        if [ !ready ]    return 'starting'
        return ''

    # why it ended, as a red line at the foot of its log (its console)
    func log_reason []
        if [ !app_mod || slot < 0 ] return
        lp : string '{inst_root[]}/tmp/{app_mod}.{slot}.log'
        f : fopen[ lp.chars, 'a' ]
        if [ !f ] return
        line : string '\x1b[31merror: {note}\x1b[0m\n'
        fputs[ line.chars, f ]
        fclose[ f ]

    # a module with an app element: its export wrote a props record
    func is_app_module [ m: string, cv: Canvas ] -> bool
        if [ !host ] return true
        return host.is_app_src*[ path '{m}.ag' ]

    func overlay [ cv: Canvas, bounds: rect ]
        st_ : i32 [ (slot >= 0) ? host_app_state[ slot ] : 0 ]
        msg : string [
            (st_ == 1) ? '{build_step[]}…'
            : 'starting {app_mod}…' ]
        if [ ended ]
            msg = (failed[]) ? '{note} — F5 or play to run again'
                : '{note} — F5 or click to restart'
        el [ halted[] ]
            msg = (note && note.count > 0) ? '{note} — F5 to relaunch' : 'paused — F8 or click to resume'
        el [ attaching ]
            msg = 'attaching debugger to {app_mod}…'
        cv.font_size[ 16 ]
        cv.fill_color[ '#dddddd' ]
        cv.draw_text[ msg,
                      rect [ x: bounds.x, y: bounds.y + 16.0,
                             w: bounds.w, h: 24.0 ],
            vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible,
            null, false ]
        cv.paint[]
        if [ !ended && !paused && app_mod ]
            lp_ : string '/tmp/{app_mod}.log'
            fp_ : fopen[ lp_.chars, 'rb' ]
            if [ fp_ ]
                fseek[ fp_, 0, SEEK_END ]
                sz : i32 [ ftell[ fp_ ] ]
                back : i32 [ (sz < 4000) ? sz : 4000 ]
                fseek[ fp_, sz - back, SEEK_SET ]
                b_ : local i8 [ 4096 ]
                n_ : i32 [ fread[ @b_[0], 1, back, fp_ ] ]
                fclose[ fp_ ]
                if [ n_ > 0 ]
                    b_[n_] = 0
                    txt_   : string [ @b_[0] ]
                    lines_ : txt_.split[ '\n' ]
                    lh  : f32 [ 16.0 ]
                    maxn : i32 [ (bounds.h - 56.0) / lh ]
                    st0  : i32 [
                        (lines_.count > maxn) ? lines_.count - maxn
                        : 0 ]
                    cv.font_size[ 12 ]
                    cv.fill_color[ '#8899aa' ]
                    y_ : f32 [ bounds.y + 44.0 ]
                    for [ i: i32 st0, i < lines_.count, i += 1 ]
                        ln : string lines_[ i ]
                        if [ ln && ln.count > 0 ]
                            cv.draw_text[ ln,
                                          rect [ x: bounds.x + 16.0,
                                                 y: y_,
                                                 w: bounds.w - 32.0,
                                                 h: lh ],
                                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                                Overflow.clip, null, false ]
                        y_ += lh
                    cv.paint[]

    func module_name [] -> string
        fn : src.filename[]
        di : i32 [ fn.index_of[ '.' ] ]
        return (di > 0) ? fn.mid[ 0, di ] : fn

    func start []
        started = true
        lang_told = -1
        did_build = false
        build_ms  = 0
        mod : string module_name[]
        # the host's launch flags (silver-host HOST_APP_*): 1 stops the
        # app for the debugger, a debug launch only (a plain run is
        # never traced); 2 builds clean; 4 builds -O0 -g; bits 8-15:
        # this display's refresh, the pace of an app shown in the pane;
        # bit 16: a coverage build
        hz : i32 [ (host_hz > 0) ? host_hz : 60 ]
        fl : i32 [
            ((debug_build) ? 1 : 0) | ((clean_build) ? 2 : 0) | ((debug_build) ? 4 : 0) |
            ((display & 3) << 3) | ((hz & 255) << 8) | ((cov_build) ? (1 << 16) : 0)
            | ((verbose_build) ? (1 << 17) : 0) ]
        # flags BEFORE the doc: Au_with_cstrs stops parsing at the first
        # positional, so a trailing flag would never reach the app's
        # schema
        ma_ : string [
            (module_args && module_args.count > 0) ? ' {module_args}'
            : '' ]
        # no size of ours: the app starts at its own, the shape it keeps
        # a module outside silver's folder goes by its folder's path
        rt_ : path.path_startup[]
        dir_ : path src.directory[]
        bm_ : string mod
        if [ '{dir_.filename[]}' == mod && '{dir_}' != '{rt_}/{mod}' ]
            bm_ = '{dir_}'
        # an app with an opener launch prop takes orbiter's socket:
        # its picks come back as `app nav` lines
        if [ ma_.index_of[ '--opener' ] < 0 && takes_opener[ mod ] ]
            ma_ = ' --opener {opener_sock[]}{ma_}'
        # a file named with spaces is one word to the host: quoted
        dq : string [ (doc) ? '{doc}' : '' ]
        if [ dq.index_of[ ' ' ] >= 0 ] dq = '"{dq}"'
        req : string [ (doc) ? '{bm_}{ma_} {dq}' : '{bm_}{ma_}' ]
        # a fresh process knows nothing of the last one's resize
        req_w  = 0
        req_h  = 0
        pend_w = 0
        pend_h = 0
        app_mod = mod
        slot = host_app_request[ req.chars, fl ]
        log 'start: {req} -> slot {slot} (host bits {fl})'
        if [ slot < 0 ]
            ended = true
            note = (slot == -2)
                ? 'every app slot is in use: close an app to run this one'
                : 'no silver-host supervisor'
            return
        # orbiter plays its sound: a debugger's pause is silence
        host_audio_player_start[ slot ]
        ir : path inst_root[]
        cmd = 'tail -n +1 -F {ir}/tmp/{mod}.{slot}.log'

    # the module declares an opener launch prop of its own
    func takes_opener [ mod: string ] -> bool
        agi : path '{inst_root[]}/export/silver-{mod}.props.agi'
        if [ !agi.exists[] ] return false
        sp : string agi.load[ typeid[string], null ]
        if [ !sp || sp.count == 0 ] return false
        lp : LaunchProps []
        Au.parse_agi[ null, sp.chars, lp ]
        if [ !lp.props ] return false
        for [ p: Prop ] in lp.props
            if [ p.ident == 'opener' && p.module == mod ] return true
        return false

    # orbiter's own socket by its path: the app's view shares it
    func opener_sock [] -> string
        rt : cstr getenv[ 'XDG_RUNTIME_DIR' ]
        return (rt) ? '{string [ rt ]}/trinity-orbiter.sock' : ''

    # hosted apps open one socket per instance:
    # trinity-<mod>-<slot>.sock
    func sock_name [] -> string
        return (slot > 0) ? '{app_mod}-{slot}' : app_mod

    func console_id [] -> string
        return 'ed:{app_mod}'

    func on_key [ ev: Event ]
        k_ : i32 [ ev.key.unicode ]
        if [ ev.key.state && k_ == 294 ]
            restart[ ev.key.shift ]
            return
        if [ ev.key.state && k_ == 297 ]
            pause_toggle[]
            return
        if [ ended || paused || slot < 0 ] return
        mods : i32 [ 0 ]
        if [ ev.key.shift ] mods = mods | 1
        if [ ev.key.ctrl ]  mods = mods | 2
        if [ ev.key.alt ]   mods = mods | 4
        if [ ev.key.meta ]  mods = mods | 8
        act : i32 [ (ev.key.state) ? 1 : 0 ]
        host_post2[ slot, 1, i32[ HM.key ], i32[ ev.key.unicode ], act,
                    mods ]

    # the app's text input: each byte of what was typed
    func on_text [ ev: Event ]
        if [ ended || paused || slot < 0 || !ev.key.text ] return
        tx : string ev.key.text
        for [ i: i32 0, i < i32[ tx.count ], i += 1 ]
            c : i32 [ (i32 tx.chars[ i ]) & 255 ]
            host_post2[ slot, 1, i32[ HM.text ], c, 0, 0 ]

    # dropped paths go to the app as one text, a 0 byte last
    func on_drop_text [ t: string ] -> bool
        if [ ended || paused || slot < 0 || !t ] return false
        n : i32 [ i32[ t.count ] ]
        for [ i: i32 0, i < n, i += 3 ]
            lead : i32 [ (i32 t.chars[ i ]) & 255 ]
            mid  : i32 [ (i + 1 < n) ? (i32 t.chars[ i + 1 ]) & 255 : 0 ]
            tail : i32 [ (i + 2 < n) ? (i32 t.chars[ i + 2 ]) & 255 : 0 ]
            host_post2[ slot, 1, i32[ HM.drop ], lead, mid, tail ]
        if [ n % 3 == 0 ] host_post2[ slot, 1, i32[ HM.drop ], 0, 0, 0 ]
        return true

    # where the app is on screen right now
    func view_rect [] -> rect
        return rect [ x: fitx, y: fity, w: fitw, h: fith ]

    func view_rect_at [ x: f32, y: f32 ] -> rect
        return rect [ x: fitx, y: fity, w: fitw, h: fith ]

    # it ended on an error: only play starts it again
    func failed [] -> bool
        return ended && note && note.count > 0 && note != 'app exited'

    func view_press [ ev: Event ] -> bool
        if [ ended ]
            if [ !failed[] ] restart[ false ]
            return true
        if [ paused ]
            pause_toggle[]
            return true
        if [ !ready || slot < 0 ] return false
        px : f32 [ ev.mouse.pos.x - vsx ]
        py : f32 [ ev.mouse.pos.y - vsy ]
        r_ : view_rect_at[ px, py ]
        if [ r_.w <= 0.0 ] return false
        bx : f32 [ (px - r_.x) / r_.w * awp[] ]
        by : f32 [ (py - r_.y) / r_.h * ahp[] ]
        if [ bx < 0.0 || by < 0.0 || bx >= awp[] || by >= ahp[] ]
            return false
        host_post2[ slot, 1, i32[ HM.press ], i32[ bx ], i32[ by ],
                    ev.mouse.button ]
        return true

    # the button stays down until the real release, or the app can never
    # see a drag: it would get down+up before the mouse ever moved
    func view_release [ ev: Event ]
        if [ ended || !ready || slot < 0 ] return
        px : f32 [ ev.mouse.pos.x - vsx ]
        py : f32 [ ev.mouse.pos.y - vsy ]
        r_ : view_rect_at[ px, py ]
        if [ r_.w <= 0.0 ] return
        bx : f32 [ (px - r_.x) / r_.w * awp[] ]
        by : f32 [ (py - r_.y) / r_.h * ahp[] ]
        host_post2[ slot, 1, i32[ HM.release ], i32[ bx ], i32[ by ],
                    ev.mouse.button ]

    func view_move [ ev: Event ] -> bool
        if [ ended || !ready || slot < 0 ] return false
        px : f32 [ ev.mouse.pos.x - vsx ]
        py : f32 [ ev.mouse.pos.y - vsy ]
        r_ : view_rect_at[ px, py ]
        if [ r_.w <= 0.0 ] return false
        bx : f32 [ (px - r_.x) / r_.w * awp[] ]
        by : f32 [ (py - r_.y) / r_.h * ahp[] ]
        if [ bx < 0.0 || by < 0.0 || bx >= awp[] || by >= ahp[] ]
            return false
        host_post2[ slot, 1, i32[ HM.move ], i32[ bx ], i32[ by ], 0 ]
        return true

    # locked: the delta scales to app pixels and rides as a move from
    # the app's lock centre
    func view_lock_move [ ev: Event ]
        if [ ended || !ready || slot < 0 ] return
        r_ : view_rect[]
        if [ r_.w <= 0.0 ] return
        lock_ax += ev.mouse.delta.x * awp[] / r_.w
        lock_ay += ev.mouse.delta.y * ahp[] / r_.h
        dx : i32 [ lock_ax ]
        dy : i32 [ lock_ay ]
        if [ dx == 0 && dy == 0 ] return
        lock_ax -= f32[ dx ]
        lock_ay -= f32[ dy ]
        host_post2[ slot, 1, i32[ HM.move ], lock_cx + dx, lock_cy + dy,
                    0 ]

    func view_wheel [ ev: Event ] -> bool
        if [ ended || !ready || slot < 0 ] return false
        px : f32 [ ev.mouse.pos.x - vsx ]
        py : f32 [ ev.mouse.pos.y - vsy ]
        r_ : view_rect_at[ px, py ]
        if [ r_.w <= 0.0 ] return false
        bx : f32 [ (px - r_.x) / r_.w * awp[] ]
        by : f32 [ (py - r_.y) / r_.h * ahp[] ]
        if [ bx < 0.0 || by < 0.0 || bx >= awp[] || by >= ahp[] ]
            return false
        mods : i32 [ 0 ]
        if [ ev.key.shift ] mods = mods | 1
        if [ ev.key.ctrl ]  mods = mods | 2
        if [ ev.key.alt ]   mods = mods | 4
        if [ ev.key.meta ]  mods = mods | 8
        # the app scrolls at the cursor, so place it before the notch
        host_post2[ slot, 1, i32[ HM.move ], i32[ bx ], i32[ by ], 0 ]
        host_post2[ slot, 1, i32[ HM.wheel ],
            i32[ ev.mouse.wheel_delta.x * 100.0 ],
            i32[ ev.mouse.wheel_delta.y * 100.0 ], mods ]
        return true

    func pause_toggle []
        if [ ended || slot < 0 ] return
        if [ debugger && debugger.active ]
            if [ paused ] debugger.cont[]
            el            debugger.pause[]
            paused = !paused
            return
        if [ paused ]
            host_app_resume[ slot ]
            paused = false
        el
            host_app_pause[ slot ]
            paused = true

    func is_paused [] -> bool
        return paused

    func restart [ clean: bool ]
        clean_build = clean
        cleanup[]
        started    = false
        ready      = false
        ended       = false
        paused     = false
        have_frame = false
        fade_us    = 0
        seen_us    = 0
        note       = ''
        # the new process parks for the debugger like the first did:
        # release it again
        attached   = false
        attaching  = false
        debugger   = null

    intern func cleanup []
        instr_clear[]
        # a debugger-held app is let run so it closes itself (its sound
        # stops cleanly). never a SIGTERM there: the debugger stops on
        # it and the frozen app loops its sound. it ends it only if
        # still there
        dbg : bool [ debugger && debugger.active ]
        if [ dbg && !debugger.running ] debugger.cont[]
        if [ slot > 0 ] host_audio_player_stop[ slot ]
        if [ slot >= 0 ]
            if [ paused ] host_app_resume[ slot ]
            if [ slot > 0 ]
                host_post2[ slot, 1, i32[ HM.close ], 0, 0, 0 ]
            if [ dbg && slot > 0 ]
                pd_ : i32 [ host_app_pid[ slot ] ]
                for [ i_: i32 0,
                      i_ < 100 && pd_ > 0 && host_pid_alive[ pd_ ] != 0,
                      i_ += 1 ]
                    usleep[ 10000 ]
            el
                host_app_stop[ slot ]
            slot = 0 - 1
        if [ dbg ] debugger.stop[]
        if [ tex0 ]
            tex0.drop[]
            tex1.drop[]
            tex0 = null
            tex1 = null
        if [ was_tex ]
            was_tex.drop[]
            was_other.drop[]
            was_tex = null
            was_other = null
        gen        = 0
        have_frame = false
        fade_us    = 0
        seen_us    = 0

    func release []
        cleanup[]

