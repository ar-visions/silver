expect func t_canvas_glyphs_then_fill [] -> bool
    n     : i64 [ 0 ]
    bytes : read_file[ 'fonts/SpaceMono-Combined.ttf', @n ]
    if [ !bytes ] return false
    font  : webgfx_font_open[ bytes, n, 0 ]
    id    : webgfx_canvas_new[ 120, 40 ]
    red   : new f32 [ 4 ]
    red[0] = 1.0
    red[1] = 0.0
    red[2] = 0.0
    red[3] = 1.0
    grn   : new f32 [ 4 ]
    grn[0] = 0.0
    grn[1] = 1.0
    grn[2] = 0.0
    grn[3] = 1.0
    webgfx_canvas_fill_rect[ id, 0.0, 0.0, 120.0, 40.0, red, null ]
    ids   : new u32 [ 1 ]
    xs    : new f32 [ 1 ]
    ys    : new f32 [ 1 ]
    ids[0] = webgfx_font_glyph_index[ font, 72 ]
    xs[0]  = 8.0
    ys[0]  = 28.0
    webgfx_canvas_glyphs[ id, font, 20.0, ids, xs, ys, 1, grn ]
    webgfx_canvas_fill_rect[ id, 60.0, 10.0, 10.0, 10.0, grn, null ]
    px    : new u8 [ 120 * 40 * 4 ]
