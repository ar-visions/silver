    webgfx_canvas_read[ id, px ]
    far : i32 [ (20 * 120 + 100) * 4 ]
    mid : i32 [ (20 * 120 + 25) * 4 ]
    log 'rounded: far {px[far]} {px[far + 1]} {px[far + 2]} {px[far + 3]} mid {px[mid]} {px[mid + 1]} {px[mid + 2]} {px[mid + 3]}'
    webgfx_canvas_free[ id ]
