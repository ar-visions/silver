    webgfx_path_cubic_to[ p, 16.34, 7.91, 15.6, 8.0, 14.97, 8.34 ]
    webgfx_path_close[ p ]
    one : new f32 [ 4 ]
    one[0] = 1.0
    one[1] = 1.0
    one[2] = 1.0
    one[3] = 1.0
    tint : new f32 [ 4 ]
    tint[3] = 0.8
    src : webgfx_canvas_new[ 26, 26 ]
    ms : new f32 [ 6 ]
    ms[0] = 1.0
    ms[3] = 1.0
    ms[4] = 1.0
    ms[5] = 1.0
    webgfx_canvas_transform[ src, ms ]
    webgfx_canvas_fill_path[ src, p, one, true ]
    res : webgfx_canvas_new[ 26, 26 ]
    webgfx_canvas_filter_blur[ res, src, 0.0, 0.0, 1.0, 1.0, tint ]
    ident : new f32 [ 6 ]
    ident[0] = 1.0
    ident[3] = 1.0
    webgfx_canvas_save[ res ]
    webgfx_canvas_transform[ res, ident ]
    webgfx_canvas_compose[ res, src, 0, false, 1.0, 0.0, 0.0, 26.0, 26.0 ]
    webgfx_canvas_restore[ res ]
    px : new u8 [ 26 * 26 * 4 ]
    webgfx_canvas_read[ res, px ]
    y : i32 [ 13 ]
    for [ x: i32 0, x < 26, x += 1 ]
        at : i32 [ (y * 26 + x) * 4 ]
        log 'shadow row x {x}: r {px[at]} a {px[at + 3]}'
    # beside the ring: the shadow alone, black and partial
    at4 : i32 [ (13 * 26 + 4) * 4 ]
    ok : bool [ px[at4] == 0 && px[at4 + 3] > 20 && px[at4 + 3] < 140 ]
    webgfx_path_free[ p ]
    webgfx_canvas_free[ src ]
    webgfx_canvas_free[ res ]
    return ok

