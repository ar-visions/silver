    far   : i32 [ (30 * 120 + 100) * 4 ]
    log 'glyphs then fill, far pixel {px[far]} {px[far + 1]} {px[far + 2]} {px[far + 3]}'
    webgfx_canvas_free[ id ]
    webgfx_font_close[ font ]
    free [ bytes ]
    return px[far] > 200 && px[far + 1] < 40

expect func t_canvas_yuv [] -> bool
    id    : webgfx_canvas_new[ 64, 64 ]
    y     : webgfx_plane_new[ 64, 64 ]
    u     : webgfx_plane_new[ 32, 32 ]
    v     : webgfx_plane_new[ 32, 32 ]
    yb    : new u8 [ 4096 ]
    cb    : new u8 [ 1024 ]
    for [ i: i32 0, i < 4096, i += 1 ]
        yb[i] = 180
    for [ i: i32 0, i < 1024, i += 1 ]
        cb[i] = 128
    webgfx_plane_update[ y, yb, 64, 64 ]
    webgfx_plane_update[ u, cb, 32, 32 ]
    webgfx_plane_update[ v, cb, 32, 32 ]
    # full range bt709 rows, chroma centred at 128
    rows  : new f32 [ 12 ]
    for [ i: i32 0, i < 12, i += 1 ]
        rows[i] = 0.0
    rows[0]  = 1.0
    rows[4]  = 1.0
    rows[8]  = 1.0
    dst   : new f32 [ 4 ]
    dst[0] = 0.0
    dst[1] = 0.0
    dst[2] = 64.0
    dst[3] = 64.0
    webgfx_canvas_draw_yuv[ id, y, u, v, dst, rows ]
    px    : new u8 [ 64 * 64 * 4 ]
    webgfx_canvas_read[ id, px ]
    mid   : i32 [ (32 * 64 + 32) * 4 ]
    log 'yuv gray, mid pixel {px[mid]} {px[mid + 1]} {px[mid + 2]} {px[mid + 3]}'
    webgfx_canvas_free[ id ]
    return px[mid] > 170 && px[mid] < 190 && px[mid + 3] == 255

# red, green, blue stops across a 90 px wide rect
expect func t_canvas_ramp [] -> bool
    id    : webgfx_canvas_new[ 100, 20 ]
    stops : new u8 [ 256 * 4 ]
    for [ i: i32 0, i < 256, i += 1 ]
        t : f32 [ f32 i / 255.0 ]
        r : f32 [ (t < 0.5) ? 1.0 - t * 2.0 : 0.0 ]
        g : f32 [ (t < 0.5) ? t * 2.0 : 2.0 - t * 2.0 ]
        b : f32 [ (t < 0.5) ? 0.0 : t * 2.0 - 1.0 ]
        stops[i * 4 + 0] = u8 [ r * 255.0 + 0.5 ]
        stops[i * 4 + 1] = u8 [ g * 255.0 + 0.5 ]
        stops[i * 4 + 2] = u8 [ b * 255.0 + 0.5 ]
        stops[i * 4 + 3] = 255
    img : webgfx_image_new[ stops, 256, 1 ]
    m   : new f32 [ 6 ]
    m[0] = 1.0
    m[1] = 0.0
    m[2] = 0.0
    m[3] = 0.0
    m[4] = 1.0
    m[5] = 0.0
    pts : new f32 [ 4 ]
    pts[0] = 5.0
    pts[1] = 0.0
    pts[2] = 95.0
    pts[3] = 0.0
    white : new f32 [ 4 ]
    white[0] = 1.0
    white[1] = 1.0
    white[2] = 1.0
    white[3] = 1.0
    webgfx_canvas_set_ramp[ id, img, 1, 0, 1.0, m, pts, 0.0, 0.0 ]
    webgfx_canvas_fill_rect[ id, 0.0, 0.0, 100.0, 20.0, white, null ]
    webgfx_canvas_set_ramp[ id, 0, 0, 0, 0.0, m, pts, 0.0, 0.0 ]
    px : new u8 [ 100 * 20 * 4 ]
    webgfx_canvas_read[ id, px ]
    left  : i32 [ (10 * 100 + 2) * 4 ]
    mid   : i32 [ (10 * 100 + 50) * 4 ]
    right : i32 [ (10 * 100 + 98) * 4 ]
    log 'ramp left {px[left]},{px[left+1]},{px[left+2]} mid {px[mid]},{px[mid+1]},{px[mid+2]} right {px[right]},{px[right+1]},{px[right+2]}'
    webgfx_image_free[ img ]
    webgfx_canvas_free[ id ]
    return px[left] > 240 && px[left + 2] < 15 && px[mid + 1] > 230 && px[mid] < 25 && px[right + 2] > 240 && px[right] < 15

# a 5 px red square at 10,10 read through a 10 px window at 8,8
expect func t_canvas_read_region [] -> bool
    id  : webgfx_canvas_new[ 40, 40 ]
    red : new f32 [ 4 ]
    red[0] = 1.0
    red[1] = 0.0
    red[2] = 0.0
    red[3] = 1.0
    webgfx_canvas_fill_rect[ id, 10.0, 10.0, 5.0, 5.0, red, null ]
    px : new u8 [ 10 * 10 * 4 ]
    webgfx_canvas_read_region[ id, 8, 8, 10, 10, px ]
    inside  : i32 [ (3 * 10 + 3) * 4 ]
    outside : i32 [ (0 * 10 + 0) * 4 ]
    beyond  : i32 [ (8 * 10 + 8) * 4 ]
    log 'region inside {px[inside]},{px[inside+3]} outside {px[outside+3]} beyond {px[beyond+3]}'
    webgfx_canvas_free[ id ]
    return px[inside] > 240 && px[inside + 3] > 240 && px[outside + 3] < 10 && px[beyond + 3] < 10

# alpha at x, y of a w-wide rgba8 read back
func alpha_at [ px: @u8, w: i32, x: i32, y: i32 ] -> i32
    return i32 px[ (y * w + x) * 4 + 3 ]

# a 40 px rounded clip with 16 px corners on a full fill
expect func t_canvas_clip_rounded [] -> bool
    id  : webgfx_canvas_new[ 60, 60 ]
    one : new f32 [ 4 ]
    one[0] = 1.0
    one[1] = 1.0
    one[2] = 1.0
    one[3] = 1.0
    r   : new f32 [ 4 ]
    r[0] = 16.0
    r[1] = 16.0
    r[2] = 16.0
    r[3] = 16.0
    webgfx_canvas_save[ id ]
    webgfx_canvas_clip_rounded_rect[ id, 10.0, 10.0, 40.0, 40.0, r ]
    webgfx_canvas_fill_rect[ id, 0.0, 0.0, 60.0, 60.0, one, null ]
    webgfx_canvas_restore[ id ]
    px : new u8 [ 60 * 60 * 4 ]
    webgfx_canvas_read[ id, px ]
    center : alpha_at[ px, 60, 30, 30 ]
    corner : alpha_at[ px, 60, 11, 11 ]
    edge   : alpha_at[ px, 60, 30, 11 ]
    out    : alpha_at[ px, 60, 5, 30 ]
    log 'rounded clip center {center} corner {corner} edge {edge} outside {out}'
    webgfx_canvas_free[ id ]
    return center > 250 && corner < 10 && edge > 250 && out < 5

# a circle path clip, then a clip-out of its middle
expect func t_canvas_clip_path_out [] -> bool
    id  : webgfx_canvas_new[ 60, 60 ]
    one : new f32 [ 4 ]
    one[0] = 1.0
    one[1] = 1.0
    one[2] = 1.0
    one[3] = 1.0
    circle : webgfx_path_new[]
    webgfx_path_move_to[ circle, 55.0, 30.0 ]
    webgfx_path_arc_to[ circle, 5.0, 30.0, 25.0, 25.0, 0.0, false, true ]
    webgfx_path_arc_to[ circle, 55.0, 30.0, 25.0, 25.0, 0.0, false, true ]
    webgfx_path_close[ circle ]
    hole : webgfx_path_new[]
    webgfx_path_move_to[ hole, 25.0, 25.0 ]
    webgfx_path_line_to[ hole, 35.0, 25.0 ]
    webgfx_path_line_to[ hole, 35.0, 35.0 ]
    webgfx_path_line_to[ hole, 25.0, 35.0 ]
    webgfx_path_close[ hole ]
    webgfx_canvas_save[ id ]
    webgfx_canvas_clip_path[ id, circle, false ]
    webgfx_canvas_clip_out_path[ id, hole ]
    webgfx_canvas_fill_rect[ id, 0.0, 0.0, 60.0, 60.0, one, null ]
    webgfx_canvas_restore[ id ]
    px : new u8 [ 60 * 60 * 4 ]
    webgfx_canvas_read[ id, px ]
    ring   : alpha_at[ px, 60, 15, 30 ]
    middle : alpha_at[ px, 60, 30, 30 ]
    corner : alpha_at[ px, 60, 3, 3 ]
    log 'path clip ring {ring} hole {middle} corner {corner}'
    webgfx_path_free[ circle ]
    webgfx_path_free[ hole ]
    webgfx_canvas_free[ id ]
    return ring > 250 && middle < 5 && corner < 5

# a clip mask from a smaller reuse fits the new size
expect func t_clip_mask_after_reuse [] -> bool
    small : webgfx_canvas_new[ 300, 300 ]
    tri   : webgfx_path_new[]
    webgfx_path_move_to[ tri, 0.0, 0.0 ]
    webgfx_path_line_to[ tri, 300.0, 0.0 ]
    webgfx_path_line_to[ tri, 0.0, 300.0 ]
    webgfx_path_close[ tri ]
    webgfx_canvas_save[ small ]
    webgfx_canvas_clip_path[ small, tri, false ]
    webgfx_canvas_restore[ small ]
    webgfx_path_free[ tri ]
    webgfx_canvas_free[ small ]
    webgfx_drain[]
    # the drain frees this function's own pool arrays too
    one : new f32 [ 4 ]
    one[0] = 1.0
    one[1] = 1.0
    one[2] = 1.0
    one[3] = 1.0
    id   : webgfx_canvas_new[ 310, 310 ]
    full : webgfx_path_new[]
    webgfx_path_move_to[ full, 0.0, 0.0 ]
    webgfx_path_line_to[ full, 310.0, 0.0 ]
    webgfx_path_line_to[ full, 310.0, 305.0 ]
    webgfx_path_line_to[ full, 150.0, 307.0 ]
    webgfx_path_line_to[ full, 0.0, 305.0 ]
    webgfx_path_close[ full ]
    webgfx_canvas_save[ id ]
    webgfx_canvas_clip_path[ id, full, false ]
    webgfx_canvas_fill_rect[ id, 0.0, 0.0, 310.0, 310.0, one, null ]
    webgfx_canvas_restore[ id ]
    px : new u8 [ 310 * 310 * 4 ]
    webgfx_canvas_read[ id, px ]
    inside : alpha_at[ px, 310, 305, 20 ]
    below  : alpha_at[ px, 310, 20, 308 ]
    log 'clip after reuse: inside {inside} below the clip {below}'
    webgfx_path_free[ full ]
    webgfx_canvas_free[ id ]
    return inside > 250 && below < 5

# copy of transparent clears only its rect; restore ends copy
expect func t_clear_part [] -> bool
    id   : webgfx_canvas_new[ 40, 20 ]
    red  : new f32 [ 4 ]
    red[0] = 1.0
    red[1] = 0.0
    red[2] = 0.0
    red[3] = 1.0
    none : new f32 [ 4 ]
    blue : new f32 [ 4 ]
    blue[2] = 1.0
    blue[3] = 0.5
    webgfx_canvas_fill_rect[ id, 0.0, 0.0, 40.0, 20.0, red, null ]
    webgfx_canvas_save[ id ]
    webgfx_canvas_set_composite[ id, 1 ]
    webgfx_canvas_fill_rect[ id, 0.0, 0.0, 20.0, 20.0, none, null ]
    webgfx_canvas_restore[ id ]
    webgfx_canvas_fill_rect[ id, 10.0, 0.0, 20.0, 20.0, blue, null ]
    px : new u8 [ 40 * 20 * 4 ]
    webgfx_canvas_read[ id, px ]
    gone  : i32 [ (10 * 40 + 5) * 4 ]
    over  : i32 [ (10 * 40 + 15) * 4 ]
    mixed : i32 [ (10 * 40 + 25) * 4 ]
    kept  : i32 [ (10 * 40 + 35) * 4 ]
    log 'clear part: gone a {px[gone + 3]}; over empty b {px[over + 2]} a {px[over + 3]}; over red r {px[mixed]} b {px[mixed + 2]}; kept r {px[kept]}'
    webgfx_canvas_free[ id ]
    return px[gone + 3] == 0 && px[over + 3] > 120 && px[over + 3] < 136 && px[mixed] > 120 && px[mixed + 2] > 120 && px[kept] == 255

# destination-in keeps the red square only under the blue dot
expect func t_canvas_destination_in [] -> bool
    id   : webgfx_canvas_new[ 40, 40 ]
    red  : new f32 [ 4 ]
    red[0] = 1.0
    red[1] = 0.0
    red[2] = 0.0
    red[3] = 1.0
    blue : new f32 [ 4 ]
    blue[0] = 0.0
    blue[1] = 0.0
    blue[2] = 1.0
    blue[3] = 1.0
    webgfx_canvas_fill_rect[ id, 0.0, 0.0, 40.0, 40.0, red, null ]
    webgfx_canvas_set_composite[ id, 7 ]
    webgfx_canvas_fill_rect[ id, 10.0, 10.0, 10.0, 10.0, blue, null ]
    webgfx_canvas_set_composite[ id, 2 ]
    px : new u8 [ 40 * 40 * 4 ]
    webgfx_canvas_read[ id, px ]
    kept  : i32 [ (15 * 40 + 15) * 4 ]
    log 'destination-in kept {px[kept]},{px[kept+1]},{px[kept+2]},{px[kept+3]}'
    webgfx_canvas_free[ id ]
    return px[kept] > 240 && px[kept + 2] < 10 && px[kept + 3] > 240

# a 20 px square with a black 10 px outer shadow: darkest at
# its edge, half-strength near the edge, clear past the reach
expect func t_canvas_shadow_outer [] -> bool
    id    : webgfx_canvas_new[ 80, 80 ]
    white : new f32 [ 4 ]
    white[0] = 1.0
    white[1] = 1.0
    white[2] = 1.0
    white[3] = 1.0
    black : new f32 [ 4 ]
    black[0] = 0.0
    black[1] = 0.0
    black[2] = 0.0
    black[3] = 1.0
    webgfx_canvas_set_shadow[ id, 0, black, 0.0, 0.0, 10.0, 0.0, false ]
    webgfx_canvas_fill_rect[ id, 30.0, 30.0, 20.0, 20.0, white, null ]
    webgfx_canvas_clear_shadows[ id ]
    px : new u8 [ 80 * 80 * 4 ]
    webgfx_canvas_read[ id, px ]
    inside : alpha_at[ px, 80, 40, 40 ]
    near   : alpha_at[ px, 80, 28, 40 ]
    mid    : alpha_at[ px, 80, 24, 40 ]
    far    : alpha_at[ px, 80, 5, 40 ]
    log 'shadow alpha inside {inside} at 2px {near} at 6px {mid} at 25px {far}'
    webgfx_canvas_free[ id ]
    return inside > 250 && near > 90 && near < 200 && mid > 15 && mid < near && far < 3

# an inset shadow darkens the box's edge and leaves its middle
expect func t_canvas_shadow_inset [] -> bool
    id    : webgfx_canvas_new[ 80, 80 ]
    white : new f32 [ 4 ]
    white[0] = 1.0
    white[1] = 1.0
    white[2] = 1.0
    white[3] = 1.0
    black : new f32 [ 4 ]
    black[0] = 0.0
    black[1] = 0.0
    black[2] = 0.0
    black[3] = 1.0
    webgfx_canvas_set_shadow[ id, 0, black, 0.0, 0.0, 8.0, 0.0, true ]
    webgfx_canvas_fill_rect[ id, 10.0, 10.0, 60.0, 60.0, white, null ]
    webgfx_canvas_clear_shadows[ id ]
    px : new u8 [ 80 * 80 * 4 ]
    webgfx_canvas_read[ id, px ]
    edge   : i32 [ i32 px[ (40 * 80 + 11) * 4 ] ]
    middle : i32 [ i32 px[ (40 * 80 + 40) * 4 ] ]
    log 'inset shadow red at the edge {edge} in the middle {middle}'
    webgfx_canvas_free[ id ]
    return edge < 170 && middle > 250

# saturate(0) turns pure red to grey
expect func t_canvas_filter_saturate [] -> bool
    id  : webgfx_canvas_new[ 20, 20 ]
    red : new f32 [ 4 ]
    red[0] = 1.0
    red[1] = 0.0
    red[2] = 0.0
    red[3] = 1.0
    webgfx_canvas_set_filter[ id, 0.0, 0.0, 1.0 ]
    webgfx_canvas_fill_rect[ id, 0.0, 0.0, 20.0, 20.0, red, null ]
    webgfx_canvas_set_filter[ id, 0.0, 1.0, 1.0 ]
    px : new u8 [ 20 * 20 * 4 ]
    webgfx_canvas_read[ id, px ]
    c : i32 [ (10 * 20 + 10) * 4 ]
    log 'saturate(0) red -> {px[c]},{px[c+1]},{px[c+2]}'
    webgfx_canvas_free[ id ]
    return px[c] > 45 && px[c] < 65 && px[c + 1] > 45 && px[c + 1] < 65

# six clipped-out 5 px squares: 4 analytic, 2 by mask
expect func t_canvas_clip_out_rects [] -> bool
    id  : webgfx_canvas_new[ 70, 20 ]
    one : new f32 [ 4 ]
    one[0] = 1.0
    one[1] = 1.0
    one[2] = 1.0
    one[3] = 1.0
    webgfx_canvas_save[ id ]
    for [ i: i32 0, i < 6, i += 1 ]
        webgfx_canvas_clip_out_rect[ id, f32 (5 + i * 10), 5.0, 5.0, 5.0 ]
    webgfx_canvas_fill_rect[ id, 0.0, 0.0, 70.0, 20.0, one, null ]
    webgfx_canvas_restore[ id ]
    px : new u8 [ 70 * 20 * 4 ]
    webgfx_canvas_read[ id, px ]
    first : alpha_at[ px, 70, 7, 7 ]
    fifth : alpha_at[ px, 70, 47, 7 ]
    sixth : alpha_at[ px, 70, 57, 7 ]
    kept  : alpha_at[ px, 70, 12, 7 ]
    below : alpha_at[ px, 70, 7, 15 ]
    log 'clip out analytic {first} mask {fifth},{sixth} between {kept} below {below}'
    webgfx_canvas_free[ id ]
    return first < 5 && fifth < 5 && sixth < 5 && kept > 250 && below > 250

expect func t_canvas_triangle_not_box [] -> bool
    id  : webgfx_canvas_new[ 40, 40 ]
    p   : webgfx_path_new[]
    # move, three lines back to the start, close: 4 edges
    webgfx_path_move_to[ p, 8.0, 5.0 ]
    webgfx_path_line_to[ p, 30.0, 20.0 ]
    webgfx_path_line_to[ p, 8.0, 35.0 ]
    webgfx_path_line_to[ p, 8.0, 5.0 ]
    webgfx_path_close[ p ]
    blk : new f32 [ 4 ]
    blk[0] = 0.0
    blk[1] = 0.0
    blk[2] = 0.0
    blk[3] = 1.0
    webgfx_canvas_fill_path[ id, p, blk, false ]
    px  : new u8 [ 40 * 40 * 4 ]
    webgfx_canvas_read[ id, px ]
    inside  : i32 [ (20 * 40 + 14) * 4 + 3 ]
    outside : i32 [ (7 * 40 + 28) * 4 + 3 ]
    log 'triangle alpha inside {px[inside]} outside (in its box) {px[outside]}'
    webgfx_path_free[ p ]
    webgfx_canvas_free[ id ]
    return px[inside] > 200 && px[outside] < 40

# the clip's h.264 through the vulkan decoder, in display order
expect func t_video_decode [] -> bool
    d9   : gfx_display[]
    root : path.path_startup[]
    src  : path '{root}/webgfx/media/clip.mp4'
    n    : i64 [ 0 ]
    bytes : @u8 [ read_file[ src.chars, @n ] ]
    if [ !bytes ] return false
    mp : Demux []
    if [ !mp.read_bytes[ bytes, n ] ] return false
    vt : DemuxTrack [ null ]
    for [ t: DemuxTrack ] in mp.tracks
        if [ t.kind == 1 ] vt = t
    if [ !vt ] return false
    dec : Decoder [ vk: gfx.vk ]
    if [ !dec.config[ @vt.config[ 0 ], i32[ vt.config.count ] ] ] return false
    for [ i: i64 0, i < vt.samples[], i += 1 ]
        pts : i64 [ vt.pts[ i ] ]
        dec.decode[ @bytes[ vt.offsets[ i ] ], i32[ vt.sizes[ i ] ], pts ]
    dec.finish[]
    # every frame, rgba, for a comparison against a reference decode
    out : path '{root}/install/tmp/clip-decoded.rgba'
    fp : fopen[ out.chars, 'wb' ]
    ordered : bool [ true ]
    last : i64 [ -1 ]
    rgba : new u8 [ dec.width * dec.height * 4 ]
    for [ f: VideoFrame ] in dec.frames
        f.rgba[ dec.width, dec.height, rgba, false ]
        fwrite[ rgba, 1, u64[ dec.width ] * u64[ dec.height ] * 4, fp ]
        if [ f.pts <= last ] ordered = false
        last = f.pts
    fclose[ fp ]
    log 'video decode: {dec.frames.count} of {vt.samples[]} frames, {dec.width}x{dec.height}, ordered {ordered}'
    free[ bytes ]
    return dec.frames.count == vt.samples[] && ordered && dec.width == 320 && dec.height == 240

# fragments in 997-byte pieces match the plain file
expect func t_demux_fragments [] -> bool
    root  : path.path_startup[]
    plain : path '{root}/webgfx/media/clip.mp4'
    frag  : path '{root}/webgfx/media/clip.frag.mp4'
    pn : i64 [ 0 ]
    fn : i64 [ 0 ]
    pb : @u8 [ read_file[ plain.chars, @pn ] ]
    fb : @u8 [ read_file[ frag.chars, @fn ] ]
    if [ !pb || !fb ] return false
    whole : Demux []
    if [ !whole.read_bytes[ pb, pn ] ] return false
    vt : DemuxTrack whole.tracks[ 0 ]
    mp : Demux []
    for [ at: i64 0, at < fn, at += 997 ]
        step : i64 [ (fn - at < 997) ? fn - at : 997 ]
        if [ !mp.append[ @fb[ at ], step ] ] return false
    same : i64 [ 0 ]
    for [ i: i64 0, i < mp.ready.count && i < vt.samples[], i += 1 ]
        s : DemuxSample mp.ready[ i ]
        want : i64 [ vt.sizes[ i ] ]
        raw : i64 [ vt.dts[ i ] + vt.cts[ i ] - mp.tracks[ 0 ].shift ]
        ok : bool [ s.data.count == want && s.pts == raw && s.dts == vt.dts[ i ] && s.sync == (vt.sync[ i ] != 0) ]
        if [ ok && memcmp[ @s.data[ 0 ], @pb[ vt.offsets[ i ] ], want ] == 0 ] same += 1
    t0 : DemuxTrack mp.tracks[ 0 ]
    log 'demux fragments: inits {mp.inits}, {mp.ready.count} samples of {vt.samples[]}, {same} match, {t0.width}x{t0.height}'
    free[ pb ]
    free[ fb ]
    return mp.inits == 1 && mp.ready.count == vt.samples[] && same == vt.samples[] && t0.width == 320

# fragments decoded ahead, shown on a 60 Hz clock, then a seek
expect func t_video_stream [] -> bool
    d9   : gfx_display[]
    root : path.path_startup[]
    frag : path '{root}/webgfx/media/clip.frag.mp4'
    fn : i64 [ 0 ]
    fb : @u8 [ read_file[ frag.chars, @fn ] ]
    if [ !fb ] return false
    mp : Demux []
    mp.append[ fb, fn ]
    free[ fb ]
    tr : DemuxTrack mp.tracks[ 0 ]
    st : VideoStream [ vk: gfx.vk ]
    st.config[ @tr.config[ 0 ], i32[ tr.config.count ] ]
    for [ s: DemuxSample ] in mp.ready
        st.push[ @s.data[ 0 ], s.data.count, s.pts * 1000000 / s.timescale, s.sync, true ]
    st.finish[]
    seen : i32 [ 0 ]
    last : i64 [ -1 ]
    ordered : bool [ true ]
    for [ k: i64 0, k < 150, k += 1 ]
        f : st.frame_at[ k * 1000000 / 60, seen == 0 ]
        if [ f ]
            if [ f.pts <= last ] ordered = false
            last = f.pts
            seen += 1
        usleep[ 16667 ]
    # a seek to 1 s: from its key frame, earlier pictures hidden
    target : i64 [ 1000000 ]
    key : i64 [ 0 ]
    for [ i: i64 0, i < mp.ready.count, i += 1 ]
        s : DemuxSample mp.ready[ i ]
        if [ s.sync && s.pts * 1000000 / s.timescale <= target ] key = i
    st.flush[]
    st.config[ @tr.config[ 0 ], i32[ tr.config.count ] ]
    for [ i: i64 key, i < mp.ready.count, i += 1 ]
        s : DemuxSample mp.ready[ i ]
        at  : i64 [ s.pts * 1000000 / s.timescale ]
        end : i64 [ (s.pts + s.duration) * 1000000 / s.timescale ]
        st.push[ @s.data[ 0 ], s.data.count, at, s.sync, end > target ]
    first : VideoFrame [ null ]
    for [ w: i32 0, w < 200 && !first, w += 1 ]
        first = st.frame_at[ target, true ]
        if [ !first ] usleep[ 5000 ]
    shown : i64 [ (first) ? first.pts : -1 ]
    log 'video stream: {seen} of {mp.ready.count} pictures once each, ordered {ordered}, decoded {st.decoded}; seek to 1 s shows {shown} us'
    return seen == i32[ mp.ready.count ] && ordered && shown >= 960000 && shown <= target

# aac fragments streamed: a 440 Hz tone and a clock of 1 s
expect func t_audio_stream [] -> bool
    root : path.path_startup[]
    frag : path '{root}/webgfx/media/av.audio.frag.mp4'
    fn : i64 [ 0 ]
    fb : @u8 [ read_file[ frag.chars, @fn ] ]
    if [ !fb ] return false
    mp : Demux []
    mp.append[ fb, fn ]
    free[ fb ]
    tr : DemuxTrack mp.tracks[ 0 ]
    st : AudioStream []
    if [ !st.config[ @tr.config[ 0 ], i32[ tr.config.count ] ] ] return false
    for [ s: DemuxSample ] in mp.ready
        st.push[ @s.data[ 0 ], s.data.count, s.pts * 1000000 / s.timescale ]
    held : i64 [ st.buffered[] ]
    t0 : i64 [ st.time[] ]
    st.playing = true
    acc : new i32 [ 2048 ]
    crossings : i32 [ 0 ]
    prev : i32 [ 0 ]
    for [ k: i32 0, k < 48000 / 1024 + 1, k += 1 ]
        memset[ acc, 0, 2048 * 4 ]
        n : i32 [ (k == 48000 / 1024) ? 48000 % 1024 : 1024 ]
        st.mix_into[ acc, n, 48000 ]
        for [ i: i32 0, i < n, i += 1 ]
            l : i32 [ acc[ i * 2 ] ]
            if [ (l > 0 && prev <= 0) || (l < 0 && prev >= 0) ] crossings += 1
            if [ l != 0 ] prev = l
    moved : i64 [ st.time[] - t0 ]
    log 'audio stream: {st.rate} Hz, {st.channels} ch, {held} us held, {crossings / 2} cycles in 1 s, clock moved {moved} us'
    return st.rate > 0 && held > 1500000 && crossings / 2 >= 435 && crossings / 2 <= 445 && moved > 995000 && moved < 1005000

func video_of [ id: i32 ] -> WebVideo
    pthread_mutex_lock[ @gfx_lock ]
    v : WebVideo [ null ]
    if [ gfx.videos && id >= 1 && id <= i32 gfx.videos.count ]
        v = gfx.videos[ id - 1 ]
    pthread_mutex_unlock[ @gfx_lock ]
    return v

# a whole media file: its h.264 track ready to decode; 0 if unplayable
func webgfx_video_new [ bytes: @u8, n: i64 ] -> i32
    d9 : gfx_display[]
    v : WebVideo [ size: n ]
    v.bytes = malloc[ n ]
    memcpy[ v.bytes, bytes, n ]
    v.demux = Demux []
    if [ !v.demux.read_bytes[ v.bytes, n ] ] return 0
    for [ t: DemuxTrack ] in v.demux.tracks
        if [ t.kind == 1 && t.config.count > 0 && !v.track ] v.track = t
    if [ !v.track || v.track.samples[] == 0 ] return 0
    v.dec = Decoder [ vk: gfx.vk ]
    if [ !v.dec.config[ @v.track.config[ 0 ], i32[ v.track.config.count ] ] ] return 0
    v.bt709  = v.dec.height >= 720
    # the first aac track plays beside the picture
    for [ t: DemuxTrack ] in v.demux.tracks
        if [ t.kind == 2 && t.config.count > 0 && !v.audio ]
            v.audio = aac_clip[ @t.config[ 0 ], i32[ t.config.count ], v.bytes, t.offsets, t.sizes, t.shift ]
    v.planes = vec i32 []
    v.planes.push[ webgfx_plane_new[ v.dec.width, v.dec.height ] ]
    v.planes.push[ webgfx_plane_new[ v.dec.width / 2, v.dec.height / 2 ] ]
    v.planes.push[ webgfx_plane_new[ v.dec.width / 2, v.dec.height / 2 ] ]
    return video_put[ v ]

# a player into the table; its id
func video_put [ v: WebVideo ] -> i32
    pthread_mutex_lock[ @gfx_lock ]
    if [ !gfx.videos ]
        gfx.videos = vec WebVideo []
        gfx.videos.hold[]
    t  : gfx.videos
    id : i32 [ 0 ]
    for [ i: i32 0, i < i32 t.count, i += 1 ]
        if [ !t[i] ]
            t[i] = v
            id = i + 1
            break
    if [ id == 0 ]
        t.push[ v ]
        id = i32 t.count
    pthread_mutex_unlock[ @gfx_lock ]
    return id

func webgfx_video_free [ id: i32 ]
    v : video_of[ id ]
    if [ !v ] return
    webgfx_video_pause[ id ]
    if [ v.sound && gfx.mixer ] gfx.mixer.remove_stream[ v.sound ]
    for [ p: i32 ] in v.planes
        webgfx_image_free[ p ]
    pthread_mutex_lock[ @gfx_lock ]
    gfx.videos[ id - 1 ] = null
    pthread_mutex_unlock[ @gfx_lock ]

# display size and length in seconds
func webgfx_video_info [ id: i32, w: @i32, h: @i32, duration: @f64 ]
    v : video_of[ id ]
    if [ !v ] return
    w[0] = v.dec.width
    h[0] = v.dec.height
    duration[0] = f64[ v.track.duration ] / f64[ v.track.timescale ]

func webgfx_video_has_audio [ id: i32 ] -> i32
    v : video_of[ id ]
    return (v && v.audio) ? 1 : 0

# one mixer for every video, started on first sound
func gfx_mixer [] -> AudioMixer
    if [ !gfx.mixer ]
        m : AudioMixer [ sample_rate: 48000 ]
        if [ !m.start[] ] return null
        gfx.mixer = m
        gfx.mixer.hold[]
    return gfx.mixer

# sound from seconds on; the picture follows the caller's clock
func webgfx_video_play [ id: i32, seconds: f64 ]
    v : video_of[ id ]
    if [ !v || !v.audio ] return
    m : gfx_mixer[]
    if [ !m ] return
    if [ v.voice > 0 ] m.voice_stop[ v.voice ]
    v.voice = m.play_voice[ v.audio, false, v.gain, 1.0 ]
    if [ v.voice > 0 ] m.voice_seek[ v.voice, seconds * f64[ v.audio.rate ] ]

func webgfx_video_pause [ id: i32 ]
    v : video_of[ id ]
    if [ !v || v.voice <= 0 || !gfx.mixer ] return
    gfx.mixer.voice_stop[ v.voice ]
    v.voice = 0

func webgfx_video_volume [ id: i32, gain: f32 ]
    v : video_of[ id ]
    if [ !v ] return
    v.gain = gain
    if [ v.voice > 0 && gfx.mixer ] gfx.mixer.voice_gain[ v.voice, gain ]

# decode up to time t; 1 when a newer frame went on screen
func webgfx_video_advance [ id: i32, t: f64 ] -> i32
    v : video_of[ id ]
    if [ !v ] return 0
    tr : v.track
    # enough decoded that the frame for t is known
    while [ v.next < tr.samples[] ]
        last : VideoFrame (v.dec.frames.count > 0) ? v.dec.frames.last[] : null
        if [ last && v.seconds[ last.pts ] > t ] break
        v.dec.decode[ @v.bytes[ tr.offsets[ v.next ] ], i32[ tr.sizes[ v.next ] ], tr.pts[ v.next ] ]
        v.next += 1
        if [ v.next == tr.samples[] ] v.dec.finish[]
    # the latest frame at or before t goes up; older ones go.
    # a later frame waits, unless nothing is on screen yet
    pick : VideoFrame [ null ]
    while [ v.dec.frames.count > 0 ]
        f : VideoFrame v.dec.frames[ 0 ]
        if [ v.seconds[ f.pts ] > t ]
            if [ !pick && v.shown < 0 ]
                pick = f
                v.dec.frames.shift[]
            break
        pick = f
        v.dec.frames.shift[]
    if [ !pick || pick.pts == v.shown ] return 0
    w9 : i32 [ v.dec.width ]
    h9 : i32 [ v.dec.height ]
    webgfx_plane_update[ v.planes[0], @pick.y[ 0 ], w9, h9 ]
    webgfx_plane_update[ v.planes[1], @pick.u[ 0 ], w9 / 2, h9 / 2 ]
    webgfx_plane_update[ v.planes[2], @pick.v[ 0 ], w9 / 2, h9 / 2 ]
    v.shown = pick.pts
    return 1

# back to the key frame at or before t; the frame for t comes next
func webgfx_video_seek [ id: i32, t: f64 ]
    v : video_of[ id ]
    if [ !v ] return
    tr : v.track
    key : i64 [ 0 ]
    for [ i: i64 0, i < tr.samples[], i += 1 ]
        if [ tr.sync[ i ] != 0 && v.seconds[ tr.pts[ i ] ] <= t ] key = i
    v.dec = Decoder [ vk: gfx.vk ]
    v.dec.config[ @tr.config[ 0 ], i32[ tr.config.count ] ]
    v.next  = key
    v.shown = -1

func demux_of [ id: i32 ] -> Demux
    pthread_mutex_lock[ @gfx_lock ]
    m : Demux [ null ]
    if [ gfx.demuxes && id >= 1 && id <= i32 gfx.demuxes.count ]
        m = gfx.demuxes[ id - 1 ]
    pthread_mutex_unlock[ @gfx_lock ]
    return m

# a fragmented mp4 reader for one source buffer
func webgfx_demux_new [] -> i32
    m : Demux []
    pthread_mutex_lock[ @gfx_lock ]
    if [ !gfx.demuxes ]
        gfx.demuxes = vec Demux []
        gfx.demuxes.hold[]
    t  : gfx.demuxes
    id : i32 [ 0 ]
    for [ i: i32 0, i < i32 t.count, i += 1 ]
        if [ !t[i] ]
            t[i] = m
            id = i + 1
            break
    if [ id == 0 ]
        t.push[ m ]
        id = i32 t.count
    pthread_mutex_unlock[ @gfx_lock ]
    return id

func webgfx_demux_free [ id: i32 ]
    if [ !demux_of[ id ] ] return
    pthread_mutex_lock[ @gfx_lock ]
    gfx.demuxes[ id - 1 ] = null
    pthread_mutex_unlock[ @gfx_lock ]

# bytes as they arrive; 0 when they are not mp4
func webgfx_demux_append [ id: i32, bytes: @u8, n: i64 ] -> i32
    m : demux_of[ id ]
    if [ !m ] return 0
    return (m.append[ bytes, n ]) ? 1 : 0

# every byte not yet parsed goes (a parser reset)
func webgfx_demux_reset [ id: i32 ]
    m : demux_of[ id ]
    if [ m ] m.reset[]

# init segments read so far, and the tracks of the last one
func webgfx_demux_inits [ id: i32 ] -> i32
    m : demux_of[ id ]
    return (m) ? m.inits : 0

func webgfx_demux_tracks [ id: i32 ] -> i32
    m : demux_of[ id ]
    return (m) ? i32[ m.tracks.count ] : 0

# 8 values: id, kind, codec, timescale, w, h, channels, rate
func webgfx_demux_track [ id: i32, i: i32, info: @i64 ]
    m : demux_of[ id ]
    if [ !m || i < 0 || i >= i32[ m.tracks.count ] ] return
    t : DemuxTrack m.tracks[ i ]
    info[0] = t.id
    info[1] = i64[ t.kind ]
    info[2] = t.codec
    info[3] = t.timescale
    info[4] = i64[ t.width ]
    info[5] = i64[ t.height ]
    info[6] = i64[ t.channels ]
    info[7] = i64[ t.rate ]

# the track's avcC or AudioSpecificConfig; its length
func webgfx_demux_track_config [ id: i32, i: i32, out: @u8, cap: i32 ] -> i32
    m : demux_of[ id ]
    if [ !m || i < 0 || i >= i32[ m.tracks.count ] ] return 0
    t : DemuxTrack m.tracks[ i ]
    n : i32 [ i32[ t.config.count ] ]
    if [ n > 0 && n <= cap && out ] memcpy[ out, @t.config[ 0 ], n ]
    return n

# samples ready, and the one at i: 6 values and its bytes
func webgfx_demux_samples [ id: i32 ] -> i32
    m : demux_of[ id ]
    return (m) ? i32[ m.ready.count ] : 0

# track, dts, pts, duration, timescale, sync; returns its size
func webgfx_demux_sample [ id: i32, i: i32, info: @i64 ] -> i64
    m : demux_of[ id ]
    if [ !m || i < 0 || i >= i32[ m.ready.count ] ] return -1
    s : DemuxSample m.ready[ i ]
    info[0] = s.track
    info[1] = s.dts
    info[2] = s.pts
    info[3] = s.duration
    info[4] = s.timescale
    info[5] = (s.sync) ? 1 : 0
    return s.data.count

func webgfx_demux_sample_data [ id: i32, i: i32, out: @u8 ]
    m : demux_of[ id ]
    if [ !m || i < 0 || i >= i32[ m.ready.count ] ] return
    s : DemuxSample m.ready[ i ]
    if [ s.data.count > 0 ] memcpy[ out, @s.data[ 0 ], s.data.count ]

# the ready samples were taken
func webgfx_demux_clear [ id: i32 ]
    m : demux_of[ id ]
    if [ m ] m.ready.clear[]

# a media source player: samples pushed, the clock from its sound
func webgfx_stream_new [] -> i32
    d9 : gfx_display[]
    v : WebVideo []
    v.planes = vec i32 []
    v.stream = VideoStream [ vk: gfx.vk ]
    v.sound  = AudioStream []
    return video_put[ v ]

func webgfx_stream_video_config [ id: i32, avcc: @u8, n: i32 ]
    v : video_of[ id ]
    if [ v && v.stream ] v.stream.config[ avcc, n ]

# pts in microseconds; show false: decoded for later pictures only
func webgfx_stream_video_sample [ id: i32, bytes: @u8, n: i64, pts: i64, sync: i32, show: i32 ]
    v : video_of[ id ]
    if [ v && v.stream ] v.stream.push[ bytes, n, pts, sync != 0, show != 0 ]

func webgfx_stream_video_end [ id: i32 ]
    v : video_of[ id ]
    if [ v && v.stream ] v.stream.finish[]

func webgfx_stream_audio_config [ id: i32, asc: @u8, n: i32 ] -> i32
    v : video_of[ id ]
    if [ !v || !v.sound || !v.sound.config[ asc, n ] ] return 0
    # no sound device: 0, so the player keeps its own clock
    m : gfx_mixer[]
    if [ !m ] return 0
    m.remove_stream[ v.sound ]
    m.add_stream[ v.sound ]
    return 1

func webgfx_stream_audio_sample [ id: i32, bytes: @u8, n: i64, pts: i64 ]
    v : video_of[ id ]
    if [ v && v.sound ] v.sound.push[ bytes, n, pts ]

# kind 1 video, 2 sound: everything queued goes (a seek)
func webgfx_stream_flush [ id: i32, kind: i32 ]
    v : video_of[ id ]
    if [ !v ] return
    if [ kind == 1 && v.stream ]
        v.stream.flush[]
        v.shown = -1
    if [ kind == 2 && v.sound ] v.sound.flush[]

# video samples waiting and pictures ready
func webgfx_stream_video_queued [ id: i32 ] -> i32
    v : video_of[ id ]
    return (v && v.stream) ? v.stream.queued[] : 0

# sound decoded and not yet heard, microseconds
func webgfx_stream_audio_buffered [ id: i32 ] -> i64
    v : video_of[ id ]
    return (v && v.sound) ? v.sound.buffered[] : 0

func webgfx_stream_playing [ id: i32, on: i32 ]
    v : video_of[ id ]
    if [ v && v.sound ] v.sound.playing = on != 0

func webgfx_stream_gain [ id: i32, gain: f32 ]
    v : video_of[ id ]
    if [ v && v.sound ] v.sound.gain = gain

# the time being heard, microseconds; -1 with no sound yet
func webgfx_stream_time [ id: i32 ] -> i64
    v : video_of[ id ]
    return (v && v.sound) ? v.sound.time[] : -1

# the picture for t (microseconds) up; 1 when a new one went up
func webgfx_stream_advance [ id: i32, t: i64 ] -> i32
    v : video_of[ id ]
    if [ !v || !v.stream ] return 0
    f : v.stream.frame_at[ t, v.shown < 0 ]
    if [ !f || f.pts == v.shown ] return 0
    if [ f.width != v.pw || f.height != v.ph ]
        for [ p: i32 ] in v.planes
            webgfx_image_free[ p ]
        v.planes = vec i32 []
        v.planes.push[ webgfx_plane_new[ f.width, f.height ] ]
        v.planes.push[ webgfx_plane_new[ f.width / 2, f.height / 2 ] ]
        v.planes.push[ webgfx_plane_new[ f.width / 2, f.height / 2 ] ]
        v.pw    = f.width
        v.ph    = f.height
        v.bt709 = f.height >= 720
    webgfx_plane_update[ v.planes[0], @f.y[ 0 ], f.width, f.height ]
    webgfx_plane_update[ v.planes[1], @f.u[ 0 ], f.width / 2, f.height / 2 ]
    webgfx_plane_update[ v.planes[2], @f.v[ 0 ], f.width / 2, f.height / 2 ]
    v.shown = f.pts
    return 1

# the picture for t kept for the compositor; 1 when new
func webgfx_stream_next [ id: i32, t: i64, w: @i32, h: @i32 ] -> i32
    v : video_of[ id ]
    if [ !v || !v.stream ] return 0
    f : v.stream.frame_at[ t, v.shown < 0 ]
    if [ !f || f.pts == v.shown ] return 0
    v.taken = f
    v.shown = f.pts
    v.pw    = f.width
    v.ph    = f.height
    w[0] = f.width
    h[0] = f.height
    return 1

# the kept picture's planes: y at w x h, u and v at half each way
func webgfx_stream_planes [ id: i32, y: @u8, u: @u8, v: @u8 ]
    s : video_of[ id ]
    if [ !s || !s.taken ] return
    f : s.taken
    memcpy[ y, @f.y[ 0 ], f.y.count ]
    memcpy[ u, @f.u[ 0 ], f.u.count ]
    memcpy[ v, @f.v[ 0 ], f.v.count ]
    s.taken = null

# the picture's size once one is up
func webgfx_stream_size [ id: i32, w: @i32, h: @i32 ]
    v : video_of[ id ]
    if [ !v ] return
    w[0] = v.pw
    h[0] = v.ph

# the frame on screen into dst (x, y, w, h), limited-range colour
func webgfx_canvas_draw_video [ id: i32, video: i32, dst: @f32 ]
    v : video_of[ video ]
    if [ !v || v.shown < 0 ] return
    # rgb = row . (y, u, v) + add, all in 0..1
    ky : f32 [ 255.0 / 219.0 ]
    kc : f32 [ 255.0 / 224.0 ]
    rv : f32 [ (v.bt709) ? 1.5748 : 1.402 ]
    gu : f32 [ (v.bt709) ? 0.1873 : 0.3441 ]
    gv : f32 [ (v.bt709) ? 0.4681 : 0.7141 ]
    bu : f32 [ (v.bt709) ? 1.8556 : 1.772 ]
    y0 : f32 [ 16.0 / 255.0 * ky ]
    c0 : f32 [ 128.0 / 255.0 * kc ]
    rows : new f32 [ 12 ]
    rows[0]  = ky
    rows[1]  = 0.0
    rows[2]  = rv * kc
    rows[3]  = 0.0 - y0 - rv * c0
    rows[4]  = ky
    rows[5]  = 0.0 - gu * kc
    rows[6]  = 0.0 - gv * kc
    rows[7]  = 0.0 - y0 + (gu + gv) * c0
    rows[8]  = ky
    rows[9]  = bu * kc
    rows[10] = 0.0
    rows[11] = 0.0 - y0 - bu * c0
    webgfx_canvas_draw_yuv[ id, v.planes[0], v.planes[1], v.planes[2], dst, rows ]

# the clip played through the webgfx calls and drawn on a canvas
expect func t_video_draw [] -> bool
    root  : path.path_startup[]
    src   : path '{root}/webgfx/media/clip.mp4'
    n     : i64 [ 0 ]
    bytes : @u8 [ read_file[ src.chars, @n ] ]
    if [ !bytes ] return false
    vid : webgfx_video_new[ bytes, n ]
    free[ bytes ]
    if [ vid == 0 ] return false
    w : i32 [ 0 ]
    h : i32 [ 0 ]
    dur : f64 [ 0.0 ]
    webgfx_video_info[ vid, @w, @h, @dur ]
    # one second in: frame 24 of the 24 fps clip
    shown : i32 [ webgfx_video_advance[ vid, 1.0 ] ]
    id  : webgfx_canvas_new[ w, h ]
    dst : new f32 [ 4 ]
    dst[0] = 0.0
    dst[1] = 0.0
    dst[2] = f32[ w ]
    dst[3] = f32[ h ]
    webgfx_canvas_draw_video[ id, vid, dst ]
    px : new u8 [ w * h * 4 ]
    webgfx_canvas_read[ id, px ]
    out : path '{root}/install/tmp/clip-frame24.rgba'
    fp : fopen[ out.chars, 'wb' ]
    fwrite[ px, 1, u64[ w * h * 4 ], fp ]
    fclose[ fp ]
    log 'video draw: {w}x{h}, {dur} s, shown {shown}'
    webgfx_canvas_free[ id ]
    webgfx_video_free[ vid ]
    return shown == 1 && w == 320 && h == 240 && dur > 1.9

# advancing in steps shows the frame for each time
expect func t_video_steps [] -> bool
    root  : path.path_startup[]
    src   : path '{root}/webgfx/media/clip.mp4'
    n     : i64 [ 0 ]
    bytes : @u8 [ read_file[ src.chars, @n ] ]
    if [ !bytes ] return false
    vid : webgfx_video_new[ bytes, n ]
    free[ bytes ]
    if [ vid == 0 ] return false
    v : video_of[ vid ]
    ok : bool [ true ]
    # 60 steps a second: most steps fall between frames
    for [ k: i32 0, k < 90, k += 1 ]
        t : f64 [ f64[ k ] / 60.0 ]
        webgfx_video_advance[ vid, t ]
        frame : i64 [ v.shown * 24 / v.track.timescale ]
        want  : i64 [ i64[ t * 24.0 + 0.000001 ] ]
        if [ frame != want ]
            log 'video step t {t}: frame {frame}, want {want}'
            ok = false
    webgfx_video_free[ vid ]
    return ok

# the aac track decodes whole: a 440 Hz tone, 2 s at 48 kHz
expect func t_video_audio [] -> bool
    root  : path.path_startup[]
    src   : path '{root}/webgfx/media/av.mp4'
    n     : i64 [ 0 ]
    bytes : @u8 [ read_file[ src.chars, @n ] ]
    if [ !bytes ] return false
    vid : webgfx_video_new[ bytes, n ]
    free[ bytes ]
    if [ vid == 0 ] return false
    v : video_of[ vid ]
    if [ !v.audio ]
        log 'video audio: no clip'
        return false
    c : v.audio
    # zero crossings over the middle second give the pitch
    crossings : i64 [ 0 ]
    peak : i32 [ 0 ]
    for [ i: i64 c.rate / 2, i < c.rate * 3 / 2 && i < c.frames, i += 1 ]
        a : i32 [ c.pcm[ i * c.channels ] ]
        b : i32 [ c.pcm[ (i + 1) * c.channels ] ]
        if [ a < 0 && b >= 0 ] crossings += 1
        if [ a > peak ] peak = a
    log 'video audio: {c.rate} Hz, {c.channels} ch, {c.frames} frames, {crossings} cycles a second, peak {peak}'
    webgfx_video_free[ vid ]
    return c.rate == 48000 && c.frames > 90000 && crossings > 430 && crossings < 450 && peak > 1000

# one pixel's alpha after a stroke of the path on a clear canvas
func stroke_alpha [ pid: i32, width: f32, cap: i32, x: i32, y: i32 ] -> i32
    id : webgfx_canvas_new[ 64, 32 ]
    bg : new f32 [ 4 ]
    webgfx_canvas_clear[ id, bg ]
    ink : new f32 [ 4 ]
    ink[0] = 1.0
    ink[3] = 1.0
    copy : webgfx_path_clone[ pid ]
    webgfx_canvas_stroke_path[ id, copy, ink, width, cap ]
    px : new u8 [ 64 * 32 * 4 ]
    webgfx_canvas_read[ id, px ]
    webgfx_canvas_free[ id ]
    webgfx_path_free[ copy ]
    return i32[ px[ (y * 64 + x) * 4 + 3 ] ]

# strokes are centred on the path; open ends take the cap
expect func t_stroke_caps [] -> bool
    ln : webgfx_path_new[]
    webgfx_path_move_to[ ln, 16.0, 16.0 ]
    webgfx_path_line_to[ ln, 48.0, 16.0 ]
    on9    : i32 [ stroke_alpha[ ln, 4.0, 0, 32, 16 ] ]
    off9   : i32 [ stroke_alpha[ ln, 4.0, 0, 32, 19 ] ]
    butt9  : i32 [ stroke_alpha[ ln, 4.0, 0, 14, 16 ] ]
    round9 : i32 [ stroke_alpha[ ln, 4.0, 1, 14, 16 ] ]
    sq9    : i32 [ stroke_alpha[ ln, 4.0, 2, 14, 17 ] ]
    # an open v: nothing across its top where a fill would close it
    vee : webgfx_path_new[]
    webgfx_path_move_to[ vee, 8.0, 4.0 ]
    webgfx_path_line_to[ vee, 32.0, 28.0 ]
    webgfx_path_line_to[ vee, 56.0, 4.0 ]
    top9  : i32 [ stroke_alpha[ vee, 2.0, 1, 32, 4 ] ]
    side9 : i32 [ stroke_alpha[ vee, 2.0, 1, 20, 16 ] ]
    log 'stroke: on {on9} off {off9}; past the end butt {butt9} round {round9} square {sq9}; v top {top9} side {side9}'
    webgfx_path_free[ ln ]
    webgfx_path_free[ vee ]
    return on9 > 200 && off9 < 30 && butt9 < 30 && round9 > 100 && sq9 > 100 && top9 < 30 && side9 > 100

# the ui's inside border: offset in by half the width
expect func t_stroke_inside [] -> bool
    cv : Canvas canvas_of[ webgfx_canvas_new[ 64, 32 ] ]
    cv.reset[ vec4f [ 0.0, 0.0, 0.0, 0.0 ] ]
    cv.fill_color[ rgba [ '#0000' ] ]
    cv.stroke_color[ rgba [ '#fff' ] ]
    cv.stroke_width[ 2.0 ]
    cv.stroke_offset[ -1.0 ]
    cv.rect_to[ 10.0, 8.0, 40.0, 16.0 ]
    cv.paint[]
    cv.stroke_width[ 0.0 ]
    cv.stroke_offset[ 0.0 ]
    cv.sync_all[]
    im : Image [ cv.color ]
    px : @u8 [ im.vdata[] ]
    inner : i32 [ i32[ px[ (16 * 64 + 10) * 4 + 3 ] ] ]
    edge  : i32 [ i32[ px[ (16 * 64 + 9) * 4 + 3 ] ] ]
    outer : i32 [ i32[ px[ (16 * 64 + 8) * 4 + 3 ] ] ]
    # the pixel outside the box carries only edge smoothing
    log 'stroke inside: border column {inner}, next out {edge}, two out {outer}'
    return inner > 200 && edge < 60 && outer < 10

# WebKit's filter result trip: canvas pixels read back, made an
# image, drawn on a page canvas: the edge keeps its coverage
expect func t_result_image_keeps_aa [] -> bool
    one : new f32 [ 4 ]
    one[0] = 1.0
    one[1] = 1.0
    one[2] = 1.0
    one[3] = 1.0
    gray : new f32 [ 4 ]
    gray[0] = 0.435
    gray[1] = 0.435
    gray[2] = 0.435
    gray[3] = 1.0
    c : webgfx_path_new[]
    webgfx_path_move_to[ c, 21.0, 11.0 ]
    webgfx_path_arc_to[ c, 1.0, 11.0, 10.0, 10.0, 0.0, false, true ]
    webgfx_path_arc_to[ c, 21.0, 11.0, 10.0, 10.0, 0.0, false, true ]
    webgfx_path_close[ c ]
    src : webgfx_canvas_new[ 22, 22 ]
    webgfx_canvas_fill_path[ src, c, one, false ]
    ps : new u8 [ 22 * 22 * 4 ]
    webgfx_canvas_read[ src, ps ]
    # straight alpha, as copyNativeImage makes it
    for [ i: i32 0, i < 22 * 22 * 4, i += 4 ]
        al : i32 [ i32 ps[i + 3] ]
        if [ al > 0 && al < 255 ]
            ps[i]     = u8 (i32 ps[i] * 255 / al)
            ps[i + 1] = u8 (i32 ps[i + 1] * 255 / al)
            ps[i + 2] = u8 (i32 ps[i + 2] * 255 / al)
    img : webgfx_image_new[ ps, 22, 22 ]
    page : webgfx_canvas_new[ 60, 30 ]
    webgfx_canvas_fill_rect[ page, 0.0, 0.0, 60.0, 30.0, gray, null ]
    dst : new f32 [ 4 ]
    dst[0] = 4.0
    dst[1] = 4.0
    dst[2] = 22.0
    dst[3] = 22.0
    uv : new f32 [ 4 ]
    uv[2] = 1.0
    uv[3] = 1.0
    webgfx_canvas_draw_image[ page, img, dst, uv ]
    # the same circle drawn straight onto the page beside it
    m : new f32 [ 6 ]
    m[0] = 1.0
    m[3] = 1.0
    m[4] = 32.0
    m[5] = 4.0
    webgfx_canvas_transform[ page, m ]
    webgfx_canvas_fill_path[ page, c, one, false ]
    pp : new u8 [ 60 * 30 * 4 ]
    webgfx_canvas_read[ page, pp ]
    for [ x: i32 4, x < 12, x += 1 ]
        at : i32 [ (8 * 60 + x) * 4 ]
        bt : i32 [ (8 * 60 + x + 28) * 4 ]
        log 'result image x {x}: via image r {pp[at]} a {pp[at + 3]} | direct r {pp[bt]}'
    ok : bool [ true ]
    for [ x: i32 4, x < 12, x += 1 ]
        at : i32 [ (8 * 60 + x) * 4 ]
        bt : i32 [ (8 * 60 + x + 28) * 4 ]
        d9 : i32 [ i32 pp[at] - i32 pp[bt] ]
        if [ d9 > 8 || d9 < -8 ] ok = false
    webgfx_path_free[ c ]
    webgfx_image_free[ img ]
    webgfx_canvas_free[ src ]
    webgfx_canvas_free[ page ]
    return ok

# a circle's edge keeps its coverage through a layer's compose
expect func t_compose_keeps_aa [] -> bool
    one : new f32 [ 4 ]
    one[0] = 1.0
    one[1] = 1.0
    one[2] = 1.0
    one[3] = 1.0
    c : webgfx_path_new[]
    webgfx_path_move_to[ c, 21.0, 11.0 ]
    webgfx_path_arc_to[ c, 1.0, 11.0, 10.0, 10.0, 0.0, false, true ]
    webgfx_path_arc_to[ c, 21.0, 11.0, 10.0, 10.0, 0.0, false, true ]
    webgfx_path_close[ c ]
    src : webgfx_canvas_new[ 22, 22 ]
    webgfx_canvas_fill_path[ src, c, one, false ]
    ps : new u8 [ 22 * 22 * 4 ]
    webgfx_canvas_read[ src, ps ]
    res : webgfx_canvas_new[ 22, 22 ]
    ident : new f32 [ 6 ]
    ident[0] = 1.0
    ident[3] = 1.0
    webgfx_canvas_save[ res ]
    webgfx_canvas_transform[ res, ident ]
    webgfx_canvas_compose[ res, src, 0, false, 1.0, 0, 0, 22, 22 ]
    webgfx_canvas_restore[ res ]
    pr : new u8 [ 22 * 22 * 4 ]
    webgfx_canvas_read[ res, pr ]
    for [ x: i32 0, x < 8, x += 1 ]
        at : i32 [ (4 * 22 + x) * 4 ]
        log 'compose aa x {x}: src a {ps[at + 3]} res a {pr[at + 3]} res r {pr[at]}'
    e3 : i32 [ (4 * 22 + 3) * 4 ]
    same : bool [ ps[e3 + 3] == pr[e3 + 3] && ps[e3 + 3] > 60 && ps[e3 + 3] < 200 ]
    webgfx_path_free[ c ]
    webgfx_canvas_free[ src ]
    webgfx_canvas_free[ res ]
    return same

# one white pixel through the shadow blur: the kernel itself
expect func t_blur_kernel [] -> bool
    one : new f32 [ 4 ]
    one[0] = 1.0
    one[1] = 1.0
    one[2] = 1.0
    one[3] = 1.0
    tint : new f32 [ 4 ]
    tint[3] = 1.0
    src : webgfx_canvas_new[ 26, 26 ]
    webgfx_canvas_fill_rect[ src, 13.0, 13.0, 1.0, 1.0, one, null ]
    res : webgfx_canvas_new[ 26, 26 ]
    webgfx_canvas_filter_blur[ res, src, 0.0, 0.0, 1.0, 1.0, tint ]
    px : new u8 [ 26 * 26 * 4 ]
    webgfx_canvas_read[ res, px ]
    for [ x: i32 8, x < 19, x += 1 ]
        at : i32 [ (13 * 26 + x) * 4 ]
        log 'kernel row x {x}: a {px[at + 3]}'
    for [ y: i32 8, y < 19, y += 1 ]
        at : i32 [ (y * 26 + 13) * 4 ]
        log 'kernel col y {y}: a {px[at + 3]}'
    mid  : alpha_at[ px, 26, 13, 13 ]
    one9 : alpha_at[ px, 26, 14, 13 ]
    two9 : alpha_at[ px, 26, 15, 13 ]
    webgfx_canvas_free[ src ]
    webgfx_canvas_free[ res ]
    # a sigma 1 gaussian: 0.159, 0.097, 0.022 of the pixel
    return mid >= 38 && mid <= 44 && one9 >= 22 && one9 <= 28 && two9 >= 4 && two9 <= 9

# the icon through a drop shadow as WebKit applies it: the box's
# inside carries only the shadow's alpha, never the icon's white
expect func t_cc_drop_shadow [] -> bool
    p : webgfx_path_new[]
    webgfx_path_move_to[ p, 21.2, 3.01 ]
    webgfx_path_line_to[ p, 21.0, 3.0 ]
    webgfx_path_line_to[ p, 3.0, 3.0 ]
    webgfx_path_line_to[ p, 2.79, 3.01 ]
    webgfx_path_cubic_to[ p, 2.3, 3.06, 1.84, 3.29, 1.51, 3.65 ]
    webgfx_path_cubic_to[ p, 1.18, 4.02, 0.99, 4.5, 1.0, 5.0 ]
    webgfx_path_line_to[ p, 1.0, 19.0 ]
    webgfx_path_line_to[ p, 1.01, 19.2 ]
    webgfx_path_cubic_to[ p, 1.05, 19.66, 1.26, 20.08, 1.58, 20.41 ]
    webgfx_path_cubic_to[ p, 1.91, 20.73, 2.33, 20.94, 2.79, 20.99 ]
    webgfx_path_line_to[ p, 3.0, 21.0 ]
    webgfx_path_line_to[ p, 21.0, 21.0 ]
    webgfx_path_line_to[ p, 21.2, 20.98 ]
    webgfx_path_cubic_to[ p, 21.66, 20.94, 22.08, 20.73, 22.41, 20.41 ]
    webgfx_path_cubic_to[ p, 22.73, 20.08, 22.94, 19.66, 22.99, 19.2 ]
    webgfx_path_line_to[ p, 23.0, 19.0 ]
