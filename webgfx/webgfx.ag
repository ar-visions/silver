    r[0] = 6.0
    r[1] = 6.0
    r[2] = 6.0
    r[3] = 6.0
    webgfx_canvas_fill_rect[ id, 0.0, 0.0, 120.0, 40.0, red, null ]
    webgfx_canvas_fill_rect[ id, 10.0, 10.0, 30.0, 20.0, grn, r ]
    px  : new u8 [ 120 * 40 * 4 ]
    webgfx_canvas_read[ id, px ]
    far : i32 [ (20 * 120 + 100) * 4 ]
    mid : i32 [ (20 * 120 + 25) * 4 ]
    log 'rounded: far {px[far]} {px[far + 1]} {px[far + 2]} {px[far + 3]} mid {px[mid]} {px[mid + 1]} {px[mid + 2]} {px[mid + 3]}'
    webgfx_canvas_free[ id ]
