# webgfx — trinity behind Ladybird's LibGfx, as plain C calls
export 1.0.0

import vec
import img
import trinity
import spectra
import <stdio.h>
import <stdlib.h>
import <math.h>
import <pthread.h>
import <unistd.h>
    +_DEFAULT_SOURCE
import <dlfcn.h>
    +_GNU_SOURCE
import <string.h>

# one <video>'s media: the file, its h.264 track, the frame on screen
class WebVideo
    public  bytes  : @u8
    public  size   : i64
    public  demux  : Demux
    public  track  : DemuxTrack
    public  dec    : Decoder
    public  next   : i64                 # the next sample to decode
    public  shown  : i64 [ -1 ]          # pts of the frame on screen
    public  planes : vec i32             # image ids: y, u, v
    public  bt709  : bool
    public  audio  : AudioClip           # the aac track, decoded whole
    public  voice  : i32                 # its mixer voice while playing
    public  gain   : f32 [ 1.0 ]
    public  stream : VideoStream         # media source: pictures
    public  sound  : AudioStream         # media source: aac
    public  pw     : i32                 # planes' luma size
    public  ph     : i32
    public  taken  : VideoFrame          # next picture for the compositor

    # seconds of sample pts
    func seconds [ pts: i64 ] -> f64
        return f64[ pts ] / f64[ track.timescale ]

    func dealloc []
        if [ bytes ] free[ bytes ]

struct GfxState
    fonts    : vec CanvasFont
    paths    : vec CanvasPath
    canvases : vec Canvas
    spare    : vec Canvas                # freed canvases kept for reuse
    images   : vec Texture
    videos   : vec WebVideo
    demuxes  : vec Demux
    mixer    : AudioMixer
    vk       : vk_context
    disp     : Display

intern gfx : GfxState

# ids come from any thread (fonts load on a worker); zero is unlocked
intern gfx_lock : pthread_mutex_t

func path_table [] -> vec CanvasPath
    if [ !gfx.paths ]
        gfx.paths = vec CanvasPath []
        gfx.paths.hold[]
    return gfx.paths

func path_of [ id: i32 ] -> CanvasPath
    pthread_mutex_lock[ @gfx_lock ]
    t : path_table[]
    p : CanvasPath [ null ]
    if [ id >= 1 && id <= i32 t.count ]
        p = t[ id - 1 ]
    pthread_mutex_unlock[ @gfx_lock ]
    return p

# a free slot is reused, so ids stay small
func webgfx_path_new [] -> i32
    fresh : CanvasPath []
    pthread_mutex_lock[ @gfx_lock ]
    t  : path_table[]
    id : i32 [ 0 ]
    for [ i: i32 0, i < i32 t.count, i += 1 ]
        if [ !t[i] ]
            t[i] = fresh
            id = i + 1
            break
    if [ id == 0 ]
        t.push[ fresh ]
        id = i32 t.count
    pthread_mutex_unlock[ @gfx_lock ]
    return id

func webgfx_path_free [ id: i32 ]
    pthread_mutex_lock[ @gfx_lock ]
    t : path_table[]
    if [ id >= 1 && id <= i32 t.count ] t[ id - 1 ] = null
    pthread_mutex_unlock[ @gfx_lock ]

func webgfx_path_clone [ id: i32 ] -> i32
    src : path_of[ id ]
    n   : webgfx_path_new[]
    dst : path_of[ n ]
    if [ src ]
        for [ i: i32 0, i < src.pcount, i += 1 ]
            dst.append[ src.points[i] ]
        dst.start_x  = src.start_x
        dst.start_y  = src.start_y
        dst.cursor_x = src.cursor_x
        dst.cursor_y = src.cursor_y
    return n

func webgfx_path_move_to [ id: i32, x: f32, y: f32 ]
    p : path_of[ id ]
    if [ p ] p.move_to[ x, y ]

func webgfx_path_line_to [ id: i32, x: f32, y: f32 ]
    p : path_of[ id ]
    if [ p ] p.line_to[ x, y ]

func webgfx_path_quad_to [ id: i32, cx: f32, cy: f32, x: f32, y: f32 ]
    p : path_of[ id ]
    if [ p ] p.quad_to[ cx, cy, x, y ]

func webgfx_path_cubic_to [ id: i32, c1x: f32, c1y: f32, c2x: f32, c2y: f32, x: f32, y: f32 ]
    p : path_of[ id ]
    if [ p ] p.cubic_to[ c1x, c1y, c2x, c2y, x, y ]

func webgfx_path_arc_to [ id: i32, x: f32, y: f32, rx: f32, ry: f32, rot: f32, large: bool, sweep: bool ]
    p : path_of[ id ]
    if [ p ] p.elliptical_arc_to[ x, y, rx, ry, rot, large, sweep ]

func webgfx_path_close [ id: i32 ]
    p : path_of[ id ]
    if [ p ] p.close_path[]

func webgfx_path_count [ id: i32 ] -> i32
    p : path_of[ id ]
    return (p) ? p.pcount : 0

# out: cmd, x, y, cx1, cy1, cx2, cy2
func webgfx_path_point [ id: i32, i: i32, out: @f32 ]
    p : path_of[ id ]
    if [ !p || i < 0 || i >= p.pcount ] return
    pt : PathPt [ p.points[i] ]
    out[0] = f32 i32 pt.cmd
    out[1] = pt.x
    out[2] = pt.y
    out[3] = pt.cx1
    out[4] = pt.cy1
    out[5] = pt.cx2
    out[6] = pt.cy2

# out: x, y (the cursor)
func webgfx_path_cursor [ id: i32, out: @f32 ]
    p : path_of[ id ]
    if [ !p ] return
    out[0] = p.cursor_x
    out[1] = p.cursor_y

func webgfx_path_bounds [ id: i32, out: @f32 ]
    p : path_of[ id ]
    if [ !p ] return
    b : vec4f [ p.bounds[] ]
    out[0] = b.x
    out[1] = b.y
    out[2] = b.z
    out[3] = b.w

func webgfx_path_contains [ id: i32, x: f32, y: f32, even_odd: bool ] -> bool
    p : path_of[ id ]
    return (p) ? p.contains[ x, y, even_odd ] : false

func webgfx_path_length [ id: i32 ] -> f32
    p : path_of[ id ]
    return (p) ? p.length[] : 0.0

# out: x, y, tangent angle, 1 when found
func webgfx_path_point_at [ id: i32, dist: f32, out: @f32 ]
    p : path_of[ id ]
    if [ !p ] return
    r : vec4f [ p.point_at[ dist ] ]
    out[0] = r.x
    out[1] = r.y
    out[2] = r.z
    out[3] = r.w

# m: a, b, c, d, e, f
func webgfx_path_transform [ id: i32, m: @f32 ]
    p : path_of[ id ]
    if [ p ] p.transform[ m[0], m[1], m[2], m[3], m[4], m[5] ]

func webgfx_font_outline [ font: i32, glyph: u32, pid: i32, x: f32, y: f32, px: f32 ]
    f : font_of[ font ]
    p : path_of[ pid ]
    if [ f && p ] f.outline[ glyph, p, x, y, px ]

func font_table [] -> vec CanvasFont
    if [ !gfx.fonts ]
        gfx.fonts = vec CanvasFont []
        gfx.fonts.hold[]
    return gfx.fonts

func font_of [ id: i32 ] -> CanvasFont
    pthread_mutex_lock[ @gfx_lock ]
    t : font_table[]
    f : CanvasFont [ null ]
    if [ id >= 1 && id <= i32 t.count ]
        f = t[ id - 1 ]
    pthread_mutex_unlock[ @gfx_lock ]
    return f

# font file bytes -> font id; the bytes must outlive the font
# FreeType's library is shared: faces are made under the lock
func webgfx_font_open [ data: @u8, size: i64, index: i32 ] -> i32
    pthread_mutex_lock[ @gfx_lock ]
    t : font_table[]
    f : CanvasFont [ ft_lib: ft_init[], data: data, data_size: size,
        face_index: index, size_px: 16 ]
    n : i32 [ 0 ]
    if [ f.loaded[] ]
        t.push[ f ]
        n = i32 t.count
    pthread_mutex_unlock[ @gfx_lock ]
    return n

func webgfx_font_close [ id: i32 ]
    pthread_mutex_lock[ @gfx_lock ]
    t : font_table[]
    if [ id >= 1 && id <= i32 t.count ] t[ id - 1 ] = null
    pthread_mutex_unlock[ @gfx_lock ]

func webgfx_font_glyph_count [ id: i32 ] -> i32
    f : font_of[ id ]
    return (f) ? f.glyph_count : 0

func webgfx_font_units_per_em [ id: i32 ] -> i32
    f : font_of[ id ]
    return (f) ? f.units_per_em : 0

func webgfx_font_glyph_index [ id: i32, codepoint: u32 ] -> u32
    f : font_of[ id ]
    return (f) ? f.glyph_index[ codepoint ] : 0

# out: ascent, descent, x height, advance of '0' at px
func webgfx_font_metrics [ id: i32, px: f32, out: @f32 ]
    f : font_of[ id ]
    if [ !f || f.units_per_em == 0 ] return
    s : f32 [ px / f32 f.units_per_em ]
    out[0] = f32 f.ascender_units * s
    out[1] = f32 -f.descender_units * s
    out[2] = f32 f.x_height_units * s
    out[3] = f32 f.advance_units[ f.glyph_index[ 48 ] ] * s

# family name into buf; returns its length, -1 if it won't fit
func webgfx_font_family [ id: i32, buf: @u8, cap: i32 ] -> i32
    f : font_of[ id ]
    if [ !f || !f.family_name || i32 f.family_name.count >= cap ]
        return -1
    memcpy[ buf, f.family_name.chars, f.family_name.count + 1 ]
    return i32 f.family_name.count

# out: weight (100..900), width (1..9), slope (0, 1 italic, 2 oblique)
func webgfx_font_style [ id: i32, out: @i32 ]
    f : font_of[ id ]
    if [ !f ] return
    out[0] = f.weight_class
    out[1] = f.width_class
    out[2] = f.slope_code

func webgfx_font_set_axes [ id: i32, tags: @u32, values: @f32, count: i32 ]
    f : font_of[ id ]
    if [ f ] f.set_axes[ tags, values, count ]

func webgfx_font_advance [ id: i32, glyph: u32, px: f32 ] -> f32
    f : font_of[ id ]
    if [ !f || f.units_per_em == 0 ] return 0.0
    return f32 f.advance_units[ glyph ] * px / f32 f.units_per_em

# system font lookup; file and family land in the buffers
func webgfx_font_match [ family: cstr, weight: i32, width: i32, slope: i32, codepoint: u32,
        emoji: bool, file: @u8, file_cap: i32, fam: @u8, fam_cap: i32, index: @i32 ] -> bool
    name : string [ null ]
    if [ family ]
        name = string [ family ]
    m : font_match[ name, weight, width, slope, codepoint, emoji ]
    if [ !m.found || i32 m.file.count >= file_cap || i32 m.family.count >= fam_cap ]
        return false
    memcpy[ file, m.file.chars, m.file.count + 1 ]
    memcpy[ fam, m.family.chars, m.family.count + 1 ]
    index[0] = m.index
    return true

# one device and headless display per process, made on use
# trinity opens assets (models/, shaders) from the working dir;
# a host that is not a silver app starts elsewhere
func enter_share_dir []
    info : Dl_info
    if [ dladdr[ @gfx_lock, @info ] == 0 || !info.dli_fname ] return
    lib   : path [ string [ info.dli_fname ] ]
    root  : path lib.parent_dir[].parent_dir[]
    share : path '{root}/share/silver-webgfx'
    chdir[ share.chars ]

func gfx_display [] -> Display
    if [ !gfx.disp ]
        enter_share_dir[]
        gfx.vk = vk_context []
        gfx.vk.hold[]
        gfx.disp = Display [ vk: gfx.vk, format: Pixel.rgba8, backbuffer: true, width: 64, height: 64 ]
        gfx.disp.hold[]
        gfx.canvases = vec Canvas []
        gfx.canvases.hold[]
    return gfx.disp

# opens the GPU now, before a sandbox closes the device files
func webgfx_gpu_init []
    gfx_display[]

func canvas_of [ id: i32 ] -> Canvas
    if [ !gfx.canvases || id < 1 || id > i32 gfx.canvases.count ] return null
    return gfx.canvases[ id - 1 ]

# a freed canvas of this size if one is kept, else a new one
func webgfx_canvas_new [ width: i32, height: i32 ] -> i32
    d  : gfx_display[]
    cv : Canvas [ null ]
    if [ gfx.spare ]
        for [ i: i64 0, i < gfx.spare.count, i += 1 ]
            c : Canvas gfx.spare[ i ]
            if [ c.content_w == width && c.content_h == height ]
                # rotate it to the front; remove would free it
                for [ k: i64 0, k < i, k += 1 ]
                    gfx.spare.push[ gfx.spare.shift[] ]
                cv = gfx.spare.shift[]
                break
    if [ cv ]
        # draws that read its old pixels go to the GPU first
        for [ c: Canvas ] in gfx.canvases
            if [ c ] c.flush_submit[]
        cv.flush_submit[]
        cv.restart[]
    el
        # each new pass must keep what earlier passes drew
        # a page is one batch: 1024 draws before a GPU wait
        cv = Canvas [ vk: gfx.vk, w: d, width: width, height: height, load_existing: true, paint_n: 1024 ]
        cv.update[]
    cv.reset[ vec4f [ 0.0, 0.0, 0.0, 0.0 ] ]
    t : gfx.canvases
    for [ i: i32 0, i < i32 t.count, i += 1 ]
        if [ !t[i] ]
            t[i] = cv
            return i + 1
    t.push[ cv ]
    return i32 t.count

# kept for reuse: up to 32 canvases of 4 megapixels or less
func webgfx_canvas_free [ id: i32 ]
    cv : canvas_of[ id ]
    if [ !cv ] return
    # kept before its slot goes: the slot held the last reference
    if [ i64[ cv.content_w ] * i64[ cv.content_h ] <= 4194304 ]
        if [ !gfx.spare ]
            gfx.spare = vec Canvas []
            gfx.spare.hold[]
        if [ gfx.spare.count >= 32 ] gfx.spare.shift[]
        gfx.spare.push[ cv ]
    gfx.canvases[ id - 1 ] = null

func webgfx_canvas_clear [ id: i32, c: @f32 ]
    cv : canvas_of[ id ]
    if [ cv ] cv.clear_recorded[ vec4f [ c[0], c[1], c[2], c[3] ] ]

func webgfx_canvas_save [ id: i32 ]
    cv : canvas_of[ id ]
    if [ cv ] cv.save[]

func webgfx_canvas_restore [ id: i32 ]
    cv : canvas_of[ id ]
    if [ cv ] cv.restore[]

# m: a, b, c, d, e, f (x' = a x + c y + e)
func webgfx_canvas_transform [ id: i32, m: @f32 ]
    cv : canvas_of[ id ]
    if [ cv ] cv.set_transform[ m[0], m[2], m[1], m[3], m[4], m[5] ]

# device pixels, intersected with the current clip
func webgfx_canvas_clip [ id: i32, x: i32, y: i32, cw: i32, ch: i32 ]
    cv : canvas_of[ id ]
    if [ cv ] cv.set_clip[ x, y, cw, ch ]

# r: top-left, top-right, bottom-right, bottom-left radii
func webgfx_canvas_fill_rect [ id: i32, x: f32, y: f32, rw: f32, rh: f32, c: @f32, r: @f32 ]
    cv : canvas_of[ id ]
    if [ !cv ] return
    cv.path.clear[]
    if [ r ]
        cv.rounded_rect[ x, y, rw, rh, r[0], r[1], r[2], r[3] ]
    el
        cv.rect_to[ x, y, rw, rh ]
    cv.stroke_width[ 0.0 ]
    cv.fill_rgba[ c[0], c[1], c[2], c[3] ]
    cv.paint[]

func canvas_take_path [ cv: Canvas, pid: i32 ] -> bool
    p : path_of[ pid ]
    if [ !p ] return false
    cv.path.clear[]
    for [ i: i32 0, i < p.pcount, i += 1 ]
        cv.path.append[ p.points[i] ]
    return true

func webgfx_canvas_fill_path [ id: i32, pid: i32, c: @f32, even_odd: bool ]
    cv : canvas_of[ id ]
    if [ !cv || !canvas_take_path[ cv, pid ] ] return
    cv.stroke_width[ 0.0 ]
    cv.fill_rgba[ c[0], c[1], c[2], c[3] ]
    cv.even_odd = even_odd
    cv.paint[]
    cv.even_odd = false

func webgfx_canvas_stroke_path [ id: i32, pid: i32, c: @f32, width: f32 ]
    cv : canvas_of[ id ]
    if [ !cv || !canvas_take_path[ cv, pid ] ] return
    cv.fill_rgba[ 0.0, 0.0, 0.0, 0.0 ]
    cv.stroke_rgba[ c[0], c[1], c[2], c[3] ]
    cv.stroke_width[ width ]
    cv.paint[]
    cv.stroke_width[ 0.0 ]

# glyph numbers at baseline pens (xs, ys), font at px
func webgfx_canvas_glyphs [ id: i32, font: i32, px: f32, ids: @u32, xs: @f32, ys: @f32, n: i32, c: @f32 ]
    cv : canvas_of[ id ]
    f  : font_of[ font ]
    if [ !cv || !f ] return
    f.set_size[ i32 roundf[ px ] ]
    cv.fill_rgba[ c[0], c[1], c[2], c[3] ]
    cv.draw_glyphs[ f, ids, xs, ys, n ]

# rgba8 pixels into dst; uv picks the source part
func webgfx_canvas_image [ id: i32, pixels: @u8, iw: i32, ih: i32, dst: @f32, uv: @f32 ]
    cv : canvas_of[ id ]
    if [ !cv ] return
    # image bytes are already sRGB: no decode on sampling
    tx : Texture [ vk: gfx.vk, w: gfx.disp, width: iw, height: ih, linear: true,
        pixel_format: Pixel.rgba8, surface: Surface.color, tag: 'webgfx' ]
    tx.upload_region[ 0, 0, iw, ih, pixels, iw * ih * 4 ]
    cv.draw_image_crop[ tx, rect [ x: dst[0], y: dst[1], w: dst[2], h: dst[3] ], uv[0], uv[1], uv[2], uv[3] ]

func image_of [ id: i32 ] -> Texture
    pthread_mutex_lock[ @gfx_lock ]
    t  : Texture [ null ]
    if [ gfx.images && id >= 1 && id <= i32 gfx.images.count ]
        t = gfx.images[ id - 1 ]
    pthread_mutex_unlock[ @gfx_lock ]
    return t

# rgba8 pixels uploaded once; drawn by id until freed
func webgfx_image_new [ pixels: @u8, iw: i32, ih: i32 ] -> i32
    d  : gfx_display[]
    tx : Texture [ vk: gfx.vk, w: d, width: iw, height: ih, linear: true,
        pixel_format: Pixel.rgba8, surface: Surface.color, tag: 'webgfx' ]
    tx.upload_region[ 0, 0, iw, ih, pixels, iw * ih * 4 ]
    return image_put[ tx ]

# a texture into the image table; its id
func image_put [ tx: Texture ] -> i32
    pthread_mutex_lock[ @gfx_lock ]
    if [ !gfx.images ]
        gfx.images = vec Texture []
        gfx.images.hold[]
    t  : gfx.images
    id : i32 [ 0 ]
    for [ i: i32 0, i < i32 t.count, i += 1 ]
        if [ !t[i] ]
            t[i] = tx
            id = i + 1
            break
    if [ id == 0 ]
        t.push[ tx ]
        id = i32 t.count
    pthread_mutex_unlock[ @gfx_lock ]
    return id

# a one-channel image (a video plane), filled by plane_update
func webgfx_plane_new [ iw: i32, ih: i32 ] -> i32
    d  : gfx_display[]
    tx : Texture [ vk: gfx.vk, w: d, width: iw, height: ih, linear: true,
        pixel_format: Pixel.u8, surface: Surface.color, tag: 'webgfx-plane' ]
    return image_put[ tx ]

# a whole plane of bytes; waits only for its own last copy
func webgfx_plane_update [ id: i32, bytes: @u8, iw: i32, ih: i32 ]
    tx : image_of[ id ]
    if [ !tx ] return
    tx.upload[ bytes, iw * ih ]

# planes y, u, v; rows: 12 floats, 3 of (ky, ku, kv, add)
func webgfx_canvas_draw_yuv [ id: i32, y: i32, u: i32, v: i32, dst: @f32, rows: @f32 ]
    cv : canvas_of[ id ]
    ty : image_of[ y ]
    tu : image_of[ u ]
    tv : image_of[ v ]
    if [ !cv || !ty || !tu || !tv ] return
    cv.draw_yuv[ ty, tu, tv, dst[0], dst[1], dst[2], dst[3], rows ]

# new pixels for an image of the same size (a video frame)
func webgfx_image_update [ id: i32, pixels: @u8, iw: i32, ih: i32 ]
    tx : image_of[ id ]
    if [ !tx ] return
    tx.upload_region[ 0, 0, iw, ih, pixels, iw * ih * 4 ]

func webgfx_image_free [ id: i32 ]
    pthread_mutex_lock[ @gfx_lock ]
    if [ gfx.images && id >= 1 && id <= i32 gfx.images.count ]
        gfx.images[ id - 1 ] = null
    pthread_mutex_unlock[ @gfx_lock ]

func webgfx_canvas_draw_image [ id: i32, img: i32, dst: @f32, uv: @f32 ]
    cv : canvas_of[ id ]
    tx : image_of[ img ]
    if [ !cv || !tx ] return
    cv.draw_image_crop[ tx, rect [ x: dst[0], y: dst[1], w: dst[2], h: dst[3] ], uv[0], uv[1], uv[2], uv[3] ]

# CSS shadow slot i (4): rgba; x y offset, blur, spread; inset
func webgfx_canvas_set_shadow [ id: i32, i: i32, c: @f32, x: f32, y: f32, blur: f32, spread: f32, inset: bool ]
    cv : canvas_of[ id ]
    if [ !cv ] return
    col : rgba [ r: c[0], g: c[1], b: c[2], a: c[3] ]
    cv.shadow[ i, col, x, y, blur, spread, inset ]

func webgfx_canvas_clear_shadows [ id: i32 ]
    cv : canvas_of[ id ]
    if [ cv ] cv.no_shadows[]

# CSS filter: hue-rotate degrees, saturate, brightness
func webgfx_canvas_set_filter [ id: i32, hue: f32, saturate: f32, brightness: f32 ]
    cv : canvas_of[ id ]
    if [ cv ] cv.color_filter[ hue, saturate, brightness ]

# W3C composite operator (WebKit's CompositeOperator order)
func webgfx_canvas_set_composite [ id: i32, op: i32 ]
    cv : canvas_of[ id ]
    if [ cv ] cv.set_composite[ Composite op ]

# clip to a rounded rect; r: tl tr br bl (null: square)
func webgfx_canvas_clip_rounded_rect [ id: i32, x: f32, y: f32, rw: f32, rh: f32, r: @f32 ]
    cv : canvas_of[ id ]
    if [ !cv ] return
    if [ r ]
        cv.clip_rounded_rect[ x, y, rw, rh, r[0], r[1], r[2], r[3] ]
    el
        cv.clip_rounded_rect[ x, y, rw, rh, 0.0, 0.0, 0.0, 0.0 ]

func webgfx_canvas_clip_path [ id: i32, pid: i32, even_odd: bool ]
    cv : canvas_of[ id ]
    if [ cv && canvas_take_path[ cv, pid ] ] cv.clip_to_path[ even_odd ]

func webgfx_canvas_clip_out_rect [ id: i32, x: f32, y: f32, rw: f32, rh: f32 ]
    cv : canvas_of[ id ]
    if [ cv ] cv.clip_out_rect[ x, y, rw, rh ]

func webgfx_canvas_clip_out_path [ id: i32, pid: i32 ]
    cv : canvas_of[ id ]
    if [ cv && canvas_take_path[ cv, pid ] ] cv.clip_out_path[]

# clip to image img's alpha over dst (x, y, w, h)
func webgfx_canvas_clip_image [ id: i32, img: i32, dst: @f32 ]
    cv : canvas_of[ id ]
    tx : image_of[ img ]
    if [ cv && tx ] cv.clip_to_image[ tx, rect [ x: dst[0], y: dst[1], w: dst[2], h: dst[3] ] ]

# fills use image img (a 256x1 stops ramp) until img is 0
func webgfx_canvas_set_ramp [ id: i32, img: i32, kind: i32, spread: i32, alpha: f32, m: @f32, pts: @f32, r0: f32, r1: f32 ]
    cv : canvas_of[ id ]
    if [ !cv ] return
    tx : image_of[ img ]
    if [ !tx ]
        cv.fill_ramp_off[]
        return
    cv.fill_ramp[ tx, kind, spread, alpha, m, pts, r0, r1 ]

# the top-left lw x lh of layer src onto canvas id at x, y,
# pixel for pixel; through mask's alpha (luma: luminance)
func webgfx_canvas_draw_layer [ id: i32, src: i32, mask: i32, luma: bool, x: i32, y: i32, lw: i32, lh: i32 ]
    webgfx_canvas_compose[ id, src, mask, luma, 1.0, x, y, lw, lh ]

# draw_layer at an opacity
func webgfx_canvas_compose [ id: i32, src: i32, mask: i32, luma: bool, alpha: f32, x: i32, y: i32, lw: i32, lh: i32 ]
    cv : canvas_of[ id ]
    sc : canvas_of[ src ]
    if [ !cv || !sc ] return
    cv.compose[ sc, canvas_of[ mask ], luma, alpha, f32 x, f32 y, f32 lw, f32 lh ]

# finished pixels, rgba8, width * height * 4 bytes
func webgfx_canvas_read [ id: i32, out: @u8 ]
    cv : canvas_of[ id ]
    if [ !cv ] return
    cv.sync_all[]
    img : Image [ cv.color ]
    memcpy[ out, img.vdata[], cv.width * cv.height * 4 ]

# rgba8 pixels of a region, rw * 4 bytes a row
func webgfx_canvas_read_region [ id: i32, x: i32, y: i32, rw: i32, rh: i32, out: @u8 ]
    cv : canvas_of[ id ]
    if [ !cv ] return
    cv.sync_all[]
    cv.color.read_region[ x, y, rw, rh, out ]

func read_file [ name: cstr, size: @i64 ] -> @u8
    fp : fopen [ name, 'rb' ]
    if [ !fp ] return null
    fseek [ fp, 0, 2 ]
    n : i64 ftell [ fp ]
    fseek [ fp, 0, 0 ]
    bytes : @u8 malloc [ n ]
    fread [ bytes, 1, n, fp ]
    fclose [ fp ]
    size[0] = n
    return bytes

expect func t_font_from_bytes [] -> bool
    n  : i64 [ 0 ]
    bytes : read_file[ 'fonts/SpaceMono-Combined.ttf', @n ]
    if [ !bytes ] return false
    id : webgfx_font_open[ bytes, n, 0 ]
    m  : new f32 [ 4 ]
    webgfx_font_metrics[ id, 20.0, m ]
    ga : webgfx_font_glyph_index[ id, 65 ]
    pth : CanvasPath []
    font_of[ id ].outline[ ga, pth, 0.0, 0.0, 20.0 ]
    log 'glyphs {webgfx_font_glyph_count[ id ]} upem {webgfx_font_units_per_em[ id ]} A={ga} points {pth.pcount} metrics {m[0]} {m[1]} {m[2]} {m[3]}'
    ok : bool [ ga > 0 && pth.pcount > 4 && m[0] > 10.0 && m[2] > 5.0 && m[3] > 5.0 ]
    webgfx_font_close[ id ]
    free [ bytes ]
    return ok

expect func t_path_geometry [] -> bool
    id : webgfx_path_new[]
    webgfx_path_move_to[ id, 10.0, 10.0 ]
    webgfx_path_line_to[ id, 110.0, 10.0 ]
    webgfx_path_line_to[ id, 110.0, 60.0 ]
    webgfx_path_line_to[ id, 10.0, 60.0 ]
    webgfx_path_close[ id ]
    b : new f32 [ 4 ]
    webgfx_path_bounds[ id, b ]
    inside  : webgfx_path_contains[ id, 50.0, 30.0, false ]
    outside : webgfx_path_contains[ id, 150.0, 30.0, false ]
    perim   : webgfx_path_length[ id ]
    at      : new f32 [ 4 ]
    webgfx_path_point_at[ id, 150.0, at ]
    arc : webgfx_path_new[]
    webgfx_path_move_to[ arc, 0.0, 0.0 ]
    webgfx_path_arc_to[ arc, 100.0, 0.0, 50.0, 50.0, 0.0, false, true ]
    ab : new f32 [ 4 ]
    webgfx_path_bounds[ arc, ab ]
    arclen : webgfx_path_length[ arc ]
    log 'rect {b[0]} {b[1]} {b[2]} {b[3]} in {inside} out {outside} len {perim} at {at[0]} {at[1]}; arc {ab[1]} {ab[3]} len {arclen}'
    ok : bool [ b[2] == 100.0 && b[3] == 50.0 && inside && !outside ]
    ok = ok && abs[ perim - 300.0 ] < 0.01
    ok = ok && abs[ at[0] - 110.0 ] < 0.01 && abs[ at[1] - 60.0 ] < 0.01
    ok = ok && abs[ arclen - 157.08 ] < 0.5 && ab[1] < -45.0
    webgfx_path_free[ id ]
    webgfx_path_free[ arc ]
    return ok

expect func t_font_match [] -> bool
    file  : new u8 [ 1024 ]
    fam   : new u8 [ 256 ]
    index : i32 [ 0 ]
    mono  : webgfx_font_match[ 'monospace', 400, 5, 0, 0, false, file, 1024, fam, 256, @index ]
    mono_file : string [ file ]
    none  : webgfx_font_match[ 'NoSuchFamilyXyz', 400, 5, 0, 0, false, file, 1024, fam, 256, @index ]
    a     : webgfx_font_match[ null, 400, 5, 0, 65, false, file, 1024, fam, 256, @index ]
    log 'monospace {mono} {mono_file}; unknown {none}; for A {a} {string [ fam ]}'
    return mono && !none && a

expect func t_font_bad_bytes [] -> bool
    junk : new u8 [ 64 ]
    return webgfx_font_open[ junk, 64, 0 ] == 0

expect func t_font_variable [] -> bool
    n     : i64 [ 0 ]
    bytes : read_file[ 'fonts/RobotoCondensed-VariableFont_wght.ttf', @n ]
    if [ !bytes ] return false
    id    : webgfx_font_open[ bytes, n, 0 ]
    fam   : new u8 [ 128 ]
    fl    : webgfx_font_family[ id, fam, 128 ]
    st    : new i32 [ 3 ]
    webgfx_font_style[ id, st ]
    h     : webgfx_font_glyph_index[ id, 72 ]
    thin  : webgfx_font_advance[ id, h, 100.0 ]
    tags  : new u32 [ 1 ]
    vals  : new f32 [ 1 ]
    tags[0] = 0x77676874
    vals[0] = 700.0
    webgfx_font_set_axes[ id, tags, vals, 1 ]
    bold  : webgfx_font_advance[ id, h, 100.0 ]
    log 'family {string [ fam ]} ({fl}) weight {st[0]} width {st[1]} slope {st[2]}; H at 100px {thin} -> wght 700 {bold}'
    # fontTools: H is 1270 units at wght 400, 1257 at 700
    ok : bool [ fl > 0 && abs[ thin - 62.0117 ] < 0.01 && abs[ bold - 61.377 ] < 0.01 ]
    webgfx_font_close[ id ]
    free [ bytes ]
    return ok

expect func t_canvas_draw [] -> bool
    id  : webgfx_canvas_new[ 64, 32 ]
    bg  : new f32 [ 4 ]
    bg[0] = 0.0
    bg[1] = 0.0
    bg[2] = 0.0
    bg[3] = 1.0
    webgfx_canvas_clear[ id, bg ]
    red : new f32 [ 4 ]
    red[0] = 1.0
    red[1] = 0.0
    red[2] = 0.0
    red[3] = 1.0
    webgfx_canvas_fill_rect[ id, 4.0, 4.0, 16.0, 16.0, red, null ]
    px  : new u8 [ 64 * 32 * 4 ]
    webgfx_canvas_read[ id, px ]
    inside  : i32 [ (10 * 64 + 10) * 4 ]
    outside : i32 [ (10 * 64 + 40) * 4 ]
    log 'canvas inside {px[inside]} {px[inside + 1]} {px[inside + 2]} {px[inside + 3]}; outside {px[outside]} {px[outside + 1]} {px[outside + 2]} {px[outside + 3]}'
    ok : bool [ px[inside] > 200 && px[inside + 1] < 40 && px[inside + 2] < 40 ]
    ok = ok && px[outside] < 40 && px[outside + 1] < 40 && px[outside + 2] < 40 && px[outside + 3] > 200
    webgfx_canvas_free[ id ]
    return ok

expect func t_canvas_glyphs [] -> bool
    n     : i64 [ 0 ]
    bytes : read_file[ 'fonts/SpaceMono-Combined.ttf', @n ]
    if [ !bytes ] return false
    font  : webgfx_font_open[ bytes, n, 0 ]
    id    : webgfx_canvas_new[ 120, 40 ]
    bg    : new f32 [ 4 ]
    bg[0] = 0.0
    bg[1] = 0.0
    bg[2] = 0.0
    bg[3] = 1.0
    webgfx_canvas_clear[ id, bg ]
    ids   : new u32 [ 5 ]
    xs    : new f32 [ 5 ]
    ys    : new f32 [ 5 ]
    word  : vec u32 [] [ 72, 101, 108, 108, 111 ]
    for [ i: i32 0, i < 5, i += 1 ]
        ids[i] = webgfx_font_glyph_index[ font, word[i] ]
        xs[i]  = 8.0 + f32 i * 12.0
        ys[i]  = 28.0
    white : new f32 [ 4 ]
    white[0] = 1.0
    white[1] = 1.0
    white[2] = 1.0
    white[3] = 1.0
    webgfx_canvas_glyphs[ id, font, 20.0, ids, xs, ys, 5, white ]
    px    : new u8 [ 120 * 40 * 4 ]
    webgfx_canvas_read[ id, px ]
    lit   : i32 [ 0 ]
    for [ i: i32 0, i < 120 * 40, i += 1 ]
        if [ px[i * 4] > 128 ]
            lit += 1
    img : Image [ width: 120, height: 40, format: Pixel.rgba8 ]
    memcpy[ img.vdata[], px, 120 * 40 * 4 ]
    img.png[ path 'glyphs_test.png' ]
    log 'glyphs lit pixels {lit}'
    webgfx_canvas_free[ id ]
    webgfx_font_close[ font ]
    free [ bytes ]
    return lit > 60

expect func t_canvas_image_then_fill [] -> bool
    id  : webgfx_canvas_new[ 64, 32 ]
    bg  : new f32 [ 4 ]
    bg[0] = 0.0
    bg[1] = 0.0
    bg[2] = 0.0
    bg[3] = 0.0
    webgfx_canvas_clear[ id, bg ]
    src : new u8 [ 64 * 32 * 4 ]
    for [ i: i32 0, i < 64 * 32 * 4, i += 1 ]
        src[i] = 255
    dst : new f32 [ 4 ]
    dst[0] = 0.0
    dst[1] = 0.0
    dst[2] = 64.0
    dst[3] = 32.0
    uv  : new f32 [ 4 ]
    uv[0] = 0.0
    uv[1] = 0.0
    uv[2] = 1.0
    uv[3] = 1.0
    webgfx_canvas_image[ id, src, 64, 32, dst, uv ]
    red : new f32 [ 4 ]
    red[0] = 1.0
    red[1] = 0.0
    red[2] = 0.0
    red[3] = 1.0
    webgfx_canvas_fill_rect[ id, 4.0, 4.0, 16.0, 16.0, red, null ]
    px  : new u8 [ 64 * 32 * 4 ]
    webgfx_canvas_read[ id, px ]
    inside  : i32 [ (10 * 64 + 10) * 4 ]
    outside : i32 [ (10 * 64 + 40) * 4 ]
    log 'image+fill inside {px[inside]} {px[inside + 1]} {px[inside + 2]} {px[inside + 3]}; outside {px[outside]} {px[outside + 1]} {px[outside + 2]} {px[outside + 3]}'
    webgfx_canvas_free[ id ]
    return px[inside] > 200 && px[inside + 1] < 40 && px[outside + 1] > 200

expect func t_canvas_large [] -> bool
    id  : webgfx_canvas_new[ 896, 656 ]
    red : new f32 [ 4 ]
    red[0] = 1.0
    red[1] = 0.0
    red[2] = 0.0
    red[3] = 1.0
    webgfx_canvas_fill_rect[ id, 0.0, 0.0, 640.0, 400.0, red, null ]
    px  : new u8 [ 896 * 656 * 4 ]
    webgfx_canvas_read[ id, px ]
    a : i32 [ 0 ]
    b : i32 [ (300 * 896 + 500) * 4 ]
    log 'large (0,0) {px[a]} {px[a + 1]} {px[a + 2]} {px[a + 3]}; (500,300) {px[b]} {px[b + 1]} {px[b + 2]} {px[b + 3]}'
    webgfx_canvas_free[ id ]
    return px[a] > 200 && px[b] > 200

expect func t_canvas_save_transform [] -> bool
    id  : webgfx_canvas_new[ 64, 32 ]
    m   : new f32 [ 6 ]
    m[0] = 1.0
    m[1] = 0.0
    m[2] = 0.0
    m[3] = 1.0
    m[4] = 0.0
    m[5] = 0.0
    red : new f32 [ 4 ]
    red[0] = 1.0
    red[1] = 0.0
    red[2] = 0.0
    red[3] = 1.0
    webgfx_canvas_save[ id ]
    webgfx_canvas_transform[ id, m ]
    webgfx_canvas_fill_rect[ id, 0.0, 0.0, 40.0, 20.0, red, null ]
    webgfx_canvas_restore[ id ]
    px  : new u8 [ 64 * 32 * 4 ]
    webgfx_canvas_read[ id, px ]
    a : i32 [ (10 * 64 + 10) * 4 ]
    log 'save+transform (10,10) {px[a]} {px[a + 1]} {px[a + 2]} {px[a + 3]}'
    webgfx_canvas_free[ id ]
    return px[a] > 200

# a reused canvas starts clean; earlier reads keep its old pixels
expect func t_canvas_reuse [] -> bool
    red  : new f32 [ 4 ]
    blue : new f32 [ 4 ]
    green : new f32 [ 4 ]
    for [ i: i32 0, i < 4, i += 1 ]
        red[i]   = (i == 0 || i == 3) ? 1.0 : 0.0
        blue[i]  = (i == 2 || i == 3) ? 1.0 : 0.0
        green[i] = (i == 1 || i == 3) ? 1.0 : 0.0
    moved : new f32 [ 6 ]
    moved[0] = 1.0
    moved[1] = 0.0
    moved[2] = 0.0
    moved[3] = 1.0
    moved[4] = 20.0
    moved[5] = 20.0
    a9 : webgfx_canvas_new[ 40, 40 ]
    webgfx_canvas_fill_rect[ a9, 0.0, 0.0, 40.0, 40.0, red, null ]
    # c reads a, recorded and not yet sent to the gpu
    c9 : webgfx_canvas_new[ 50, 50 ]
    webgfx_canvas_compose[ c9, a9, 0, false, 1.0, 0, 0, 40, 40 ]
    webgfx_canvas_transform[ a9, moved ]
    webgfx_canvas_clip_out_rect[ a9, 0.0, 0.0, 5.0, 5.0 ]
    webgfx_canvas_free[ a9 ]
    b9 : webgfx_canvas_new[ 40, 40 ]
    px : new u8 [ 40 * 40 * 4 ]
    webgfx_canvas_read[ b9, px ]
    stale : i32 [ px[ (5 * 40 + 5) * 4 + 3 ] ]
    webgfx_canvas_fill_rect[ b9, 0.0, 0.0, 10.0, 10.0, green, null ]
    webgfx_canvas_read[ b9, px ]
    g5 : i32 [ px[ (5 * 40 + 5) * 4 + 1 ] ]
    cp : new u8 [ 50 * 50 * 4 ]
    webgfx_canvas_read[ c9, cp ]
    r5 : i32 [ cp[ (5 * 50 + 5) * 4 ] ]
    c5 : i32 [ cp[ (5 * 50 + 5) * 4 + 1 ] ]
    log 'canvas reuse: fresh alpha {stale}, green at 5,5 {g5}; earlier read red {r5} green {c5}'
    webgfx_canvas_free[ b9 ]
    webgfx_canvas_free[ c9 ]
    return stale == 0 && g5 > 250 && r5 > 250 && c5 < 5

expect func t_canvas_two_alive [] -> bool
    one : webgfx_canvas_new[ 64, 32 ]
    two : webgfx_canvas_new[ 64, 32 ]
    red : new f32 [ 4 ]
    red[0] = 1.0
    red[1] = 0.0
    red[2] = 0.0
    red[3] = 1.0
    webgfx_canvas_fill_rect[ one, 0.0, 0.0, 40.0, 20.0, red, null ]
    px  : new u8 [ 64 * 32 * 4 ]
    webgfx_canvas_read[ one, px ]
    a : i32 [ (10 * 64 + 10) * 4 ]
    log 'two alive, first (10,10) {px[a]} {px[a + 1]} {px[a + 2]} {px[a + 3]}'
    webgfx_canvas_free[ one ]
    webgfx_canvas_free[ two ]
    return px[a] > 200

