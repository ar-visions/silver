    one : new f32 [ 4 ]
    one[0] = 1.0
    one[1] = 1.0
    one[2] = 1.0
    one[3] = 1.0
    small : webgfx_canvas_new[ 26, 26 ]
    ms : new f32 [ 6 ]
    ms[0] = 1.0
    ms[3] = 1.0
    ms[4] = 1.0
    ms[5] = 1.0
    webgfx_canvas_transform[ small, ms ]
    webgfx_canvas_fill_path[ small, p, one, true ]
    ps : new u8 [ 26 * 26 * 4 ]
    webgfx_canvas_read[ small, ps ]
    big : webgfx_canvas_new[ 200, 200 ]
    mb : new f32 [ 6 ]
    mb[0] = 1.0
    mb[3] = 1.0
    mb[4] = 51.0
    mb[5] = 51.0
    webgfx_canvas_transform[ big, mb ]
    webgfx_canvas_fill_path[ big, p, one, true ]
    pb : new u8 [ 200 * 200 * 4 ]
    webgfx_canvas_read[ big, pb ]
    # inside the box beside the ring, above the letters, between them
    s1 : alpha_at[ ps, 26, 5, 13 ]
    s2 : alpha_at[ ps, 26, 13, 6 ]
    s3 : alpha_at[ ps, 26, 13, 13 ]
    sr : alpha_at[ ps, 26, 2, 13 ]
    b1 : alpha_at[ pb, 200, 55, 63 ]
    b2 : alpha_at[ pb, 200, 63, 56 ]
    b3 : alpha_at[ pb, 200, 63, 63 ]
    br : alpha_at[ pb, 200, 52, 63 ]
    log 'cc icon small: ring {sr} inside {s1} {s2} {s3}; big: ring {br} inside {b1} {b2} {b3}'
    webgfx_path_free[ p ]
    webgfx_canvas_free[ small ]
    webgfx_canvas_free[ big ]
    d1 : i32 [ s1 - b1 ]
    d2 : i32 [ s2 - b2 ]
    d3 : i32 [ s3 - b3 ]
    return sr > 200 && br > 200 && s1 < 8 && d1 < 4 && d1 > -4 && d2 < 4 && d2 > -4 && d3 < 4 && d3 > -4
