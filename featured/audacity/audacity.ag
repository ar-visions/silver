# Audacity 3.7.9 (wxWidgets on GTK 3) and the libraries it needs;
# GTK 3, PortAudio, expat, sqlite, uuid and zlib are the system's
export 3.7.9
export software ['creative']
export icon ['audacity']
export build none

# wxWidgets 3.2: Audacity's whole interface
import wxWidgets/3.2.8 from https://github.com/wxWidgets/wxWidgets/releases/download/v3.2.8/wxWidgets-3.2.8.tar.bz2
    PATH={install}/bin:$PATH
    LDFLAGS=-Wl,-rpath,{install}/lib
    PKG_CONFIG_PATH={install}/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig
    -DwxBUILD_TOOLKIT=gtk3
    -DwxBUILD_SHARED=ON
    -DwxBUILD_SAMPLES=OFF
    -DwxBUILD_TESTS=OFF
    -DwxBUILD_DEMOS=OFF
    -DwxUSE_LIBPNG=builtin
    -DwxUSE_LIBJPEG=builtin
    -DwxUSE_ZLIB=builtin
    -DwxUSE_REGEX=builtin
    -DwxUSE_EXPAT=sys
    -DwxUSE_LIBTIFF=OFF
    -DwxUSE_OPENGL=OFF
    -DwxUSE_WEBVIEW=OFF
    -DwxUSE_MEDIACTRL=OFF
    -DwxUSE_SECRETSTORE=OFF
    -DwxUSE_LIBSDL=OFF
    -DwxUSE_LIBNOTIFY=OFF
    -DwxUSE_SPELLCHECK=OFF

# mp3 export
import lame/3.100 from https://downloads.sourceforge.net/project/lame/lame/3.100/lame-3.100.tar.gz
    LDFLAGS=-Wl,-rpath,{install}/lib
    --disable-static
    --disable-frontend

# the xiph codecs, each on the last
import libogg/1.3.5 from https://downloads.xiph.org/releases/ogg/libogg-1.3.5.tar.xz
    -DBUILD_SHARED_LIBS=ON
    -DBUILD_TESTING=OFF
import libvorbis/1.3.7 from https://downloads.xiph.org/releases/vorbis/libvorbis-1.3.7.tar.xz
    "-DCMAKE_SHARED_LINKER_FLAGS=-Wl,-rpath,{install}/lib"
    -DBUILD_SHARED_LIBS=ON
import flac/1.4.3 from https://downloads.xiph.org/releases/flac/flac-1.4.3.tar.xz
    "-DCMAKE_SHARED_LINKER_FLAGS=-Wl,-rpath,{install}/lib"
    -DBUILD_SHARED_LIBS=ON
    -DBUILD_PROGRAMS=OFF
    -DBUILD_EXAMPLES=OFF
    -DBUILD_TESTING=OFF
    -DBUILD_DOCS=OFF
    -DINSTALL_MANPAGES=OFF
import opus/1.5.2 from https://downloads.xiph.org/releases/opus/opus-1.5.2.tar.gz
    -DBUILD_SHARED_LIBS=ON
    -DOPUS_BUILD_PROGRAMS=OFF
    -DOPUS_BUILD_TESTING=OFF
import opusfile/0.12 from https://downloads.xiph.org/releases/opus/opusfile-0.12.tar.gz
    LDFLAGS=-Wl,-rpath,{install}/lib
    PKG_CONFIG_PATH={install}/lib/pkgconfig
    --disable-static
    --disable-http
    --disable-examples
    --disable-doc

# wav, aiff and the rest; mp3 is Audacity's own (lame, mpg123)
import libsndfile/1.2.2 from https://github.com/libsndfile/libsndfile/releases/download/1.2.2/libsndfile-1.2.2.tar.xz
    "-DCMAKE_SHARED_LINKER_FLAGS=-Wl,-rpath,{install}/lib"
    -DBUILD_SHARED_LIBS=ON
    -DBUILD_PROGRAMS=OFF
    -DBUILD_EXAMPLES=OFF
    -DBUILD_TESTING=OFF
    -DENABLE_MPEG=OFF

# mp3 tags and wavpack files
import libid3tag/0.16.3 from https://codeberg.org/tenacityteam/libid3tag/archive/0.16.3.tar.gz
    -DBUILD_SHARED_LIBS=ON
import wavpack/5.7.0 from https://www.wavpack.com/wavpack-5.7.0.tar.xz
    -DBUILD_SHARED_LIBS=ON
    -DWAVPACK_BUILD_PROGRAMS=OFF
    -DWAVPACK_BUILD_DOCS=OFF
    -DWAVPACK_INSTALL_DOCS=OFF
    -DWAVPACK_ENABLE_LIBCRYPTO=OFF
    -DBUILD_TESTING=OFF

# MIDI devices (note tracks link it)
import portmidi/2.0.4 from https://github.com/PortMidi/portmidi/archive/refs/tags/v2.0.4.tar.gz
    -DBUILD_SHARED_LIBS=ON

# headers only
import rapidjson/1.1.0 from https://github.com/Tencent/rapidjson/archive/refs/tags/v1.1.0.tar.gz
    -DRAPIDJSON_BUILD_DOCS=OFF
    -DRAPIDJSON_BUILD_EXAMPLES=OFF
    -DRAPIDJSON_BUILD_TESTS=OFF

# Audacity itself, into install/bin; no conan, nothing fetched at
# build time, no network features, crash reports or VST3 sdk
import audacity/3.7.9 from https://github.com/audacity/audacity/releases/download/Audacity-3.7.9/audacity-sources-3.7.9.tar.gz
    PATH={install}/bin:$PATH
    PKG_CONFIG_PATH={install}/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig
    "-DCMAKE_SHARED_LINKER_FLAGS=-Wl,-rpath,{install}/lib"
    "-DCMAKE_EXE_LINKER_FLAGS=-Wl,-rpath,{install}/lib"
    -DCMAKE_PREFIX_PATH={install}
    -Daudacity_conan_enabled=Off
    -Daudacity_has_networking=Off
    -Daudacity_has_vst3=Off
    -Daudacity_has_tests=Off
    -Daudacity_has_whats_new=Off
    -Daudacity_use_midi=system
    -Daudacity_use_lv2=off
    -Daudacity_use_ffmpeg=loaded
