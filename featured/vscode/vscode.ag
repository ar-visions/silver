# Code - OSS 1.142.0: Visual Studio Code's open source build, made
# by its own build on Node 24 into install/lib/code-oss
export 1.142.0
export software ['developer']
export icon ['vscode']
export build none

# Node 24, the version VS Code's .nvmrc names, in its own folder
import node/24.18.0 from https://nodejs.org/dist/v24.18.0/node-v24.18.0.tar.xz
    > ./configure --prefix={install}/node
    > make -j32
    > make install

# the headers its native modules build against: keyboard layouts
# (native-keymap), the keyring, and Kerberos (kerberos)
import libxkbfile/1.1.3 from https://xorg.freedesktop.org/archive/individual/lib/libxkbfile-1.1.3.tar.xz
    LDFLAGS=-Wl,-rpath,{install}/lib
    PKG_CONFIG_PATH={install}/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig
    --disable-static
import libsecret/0.21.7 from https://download.gnome.org/sources/libsecret/0.21/libsecret-0.21.7.tar.xz
    PATH={install}/bin:$PATH
    LDFLAGS=-Wl,-rpath,{install}/lib
    PKG_CONFIG_PATH={install}/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig
    -Dmanpage=false
    -Dgtk_doc=false
    -Dvapi=false
    -Dintrospection=false
    -Dbash_completion=disabled
import krb5/1.21.3 from https://kerberos.org/dist/krb5/1.21/krb5-1.21.3.tar.gz
    LDFLAGS=-Wl,-rpath,{install}/lib
    > cd src && ./configure --prefix={install} --disable-static --without-keyutils --without-system-verto
    > make -C src -j32
    > make -C src install

# VS Code itself: its packages, then its linux build, copied into
# install/lib/code-oss; install/bin/vscode starts it
# no root-owned chrome-sandbox: AppArmor lets it use userns
import vscode/1.142.0 from https://github.com/microsoft/vscode
    PATH={install}/node/bin:{install}/bin:$PATH
    PKG_CONFIG_PATH={install}/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig
    CPATH={install}/include
    LIBRARY_PATH={install}/lib
    LDFLAGS=-Wl,-rpath,{install}/lib
    npm_config_devdir={install}/tmp/node-gyp
    > npm ci
    > npm run gulp vscode-linux-x64-min
    > rm -rf {install}/lib/code-oss && cp -a ../VSCode-linux-x64 {install}/lib/code-oss
    > rm -f {install}/lib/code-oss/chrome-sandbox {install}/bin/vscode
    > install -m 755 silver-vscode.sh {install}/bin/vscode
    > sh silver-apparmor.sh {install}
