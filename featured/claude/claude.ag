# claude: Anthropic's Claude Code, an agent shell. Installed from
# the apps view (its build fetches the native binary into silver's
# install); installed, it is an agent the exchange offers, run in
# its own terminal
export 1.0.0
export agent ['ClaudeAgent']
export software ['developer']
export icon ['claude']

import trinity
import <stdlib.h>
import <stdio.h>

# the version taken, and its linux-x64 binary's sha256 as its
# release manifest gives it
func claude_ver [] -> string
    return '2.1.304'
func claude_sum [] -> string
    return 'ea0f135784631619a7a409d07322ecec964f9cc4fd377508ed1ba3f141f27912'

AgentRun ClaudeAgent
    # its terminal's session: claude keeps its record under it
    intern sess_id : string
    # the record read at most every 300 ms
    intern seen_ms : i64
    intern seen_w  : bool

    func program [] -> string
        return 'claude'

    func keeps [] -> bool
        return true

    func argv [ model: string, text: string, image: string ]
            -> vec string
        a : vec string [] [ '-p', '--input-format', 'stream-json',
            '--output-format', 'stream-json', '--verbose',
            '--replay-user-messages', '--permission-mode',
            'acceptEdits', '--no-session-persistence',
            '--strict-mcp-config' ]
        # the silver install (its screenshots and logs) and the
        # silver folder (its sources)
        a.push[ '--add-dir' ]
        a.push[ install[] ]
        sv : cstr getenv[ 'SILVER' ]
        if [ sv ]
            a.push[ '--add-dir' ]
            a.push[ string [ sv ] ]
        if [ model.count > 0 ]
            a.push[ '--model' ]
            a.push[ model ]
        if [ allow && allow.count > 0 ]
            a.push[ '--allowedTools' ]
            a.push[ allow ]
        return a

    # its own program in its terminal on orbiter's platform: it acts
    # without asking, the silver install and folder in reach, and is
    # told its part there
    func terminal [ model: string ] -> vec string
        a : vec string [] [ '--dangerously-skip-permissions',
                            '--append-system-prompt', role[],
                            '--add-dir', install[] ]
        sv : cstr getenv[ 'SILVER' ]
        if [ sv ]
            a.push[ '--add-dir' ]
            a.push[ string [ sv ] ]
        if [ model.count > 0 ]
            a.push[ '--model' ]
            a.push[ model ]
        sess_id = new_session[]
        a.push[ '--session-id' ]
        a.push[ sess_id ]
        return a

    # its part in orbiter, and what it tells orbiter as it works
    func role [] -> string
        sock : string '$XDG_RUNTIME_DIR/trinity-orbiter.sock'
        # orbiter names each instance in its terminal's environment
        say : string 'echo "app home $ORBITER_AGENT <state> <words>"'
        r : string 'You are {name}, one of the agents on the agent'
        r = '{r} platform of orbiter (the silver desktop). The user'
        r = '{r} sees you as an avatar on the platform, your'
        r = '{r} terminal under your title. Tell orbiter what you'
        r = '{r} are doing as you go, before each phase of work,'
        r = '{r} by running: {say} | nc -U -N {sock}'
        r = '{r} where <state> is one of: research (reading,'
        r = '{r} searching), writing (editing files), build'
        r = '{r} (compiling), testing (running tests or the app),'
        r = '{r} done (the request finished). Keep the words short;'
        return '{r} always send done when you finish.'

    # its title: a spinning dot while it works, ✳ when it waits
    func waiting [ title: string ] -> bool
        return title && title.starts_with[ '✳' ]

    # at work, its record's last entry is its own: it writes (its
    # answer or an edit); the user's (a message, a tool's result):
    # it thinks
    func writing [ title: string ] -> bool
        if [ !title || waiting[ title ] ] return false
        now : i64 [ Au.epoch_millis[] ]
        if [ now - seen_ms < 300 ] return seen_w
        seen_ms = now
        t : string record_tail[ 65536 ]
        wa : i32 [ t.rindex_of[ '"type":"assistant"' ] ]
        wu : i32 [ t.rindex_of[ '"type":"user"' ] ]
        seen_w = wa >= 0 && wa > wu
        return seen_w

    # a session id: a version 4 uuid
    func new_session [] -> string
        seed : u64 [ u64[ Au.epoch_micros[] ] ]
        digits : string '0123456789abcdef'
        out : string ''
        for [ i: i32 0, i < 32, i += 1 ]
            seed = seed * 6364136223846793005 + 1442695040888963407
            d : i32 [ i32[ seed >> 60 ] ]
            if [ i == 12 ] d = 4
            if [ i == 16 ] d = 8 + d % 4
            if [ i == 8 || i == 12 || i == 16 || i == 20 ]
                out = '{out}-'
            out = '{out}{digits.mid[ d, 1 ]}'
        return out

    # its record's folder: the working folder, every mark that is
    # not a letter or digit made a dash
    func project_dir [ r: string ] -> string
        marks : string '/._ ~'
        out : string ''
        for [ i: i32 0, i < r.count, i += 1 ]
            c : string r.mid[ i, 1 ]
            if [ marks.index_of[ c ] >= 0 ]
                out = '{out}-'
            el
                out = '{out}{c}'
        return out

    # the last n bytes of its record, '' none
    func record_tail [ n: i64 ] -> string
        home : cstr getenv[ 'HOME' ]
        if [ !home || !sess_id || !root ] return ''
        dir : string project_dir[ root ]
        p : '{string [ home ]}/.claude/projects/{dir}/{sess_id}.jsonl'
        fp : fopen[ p.chars, "rb" ]
        if [ !fp ] return ''
        fseek[ fp, 0, SEEK_END ]
        size : i64 [ ftell[ fp ] ]
        at : i64 [ (size > n) ? size - n : 0 ]
        fseek[ fp, at, SEEK_SET ]
        buf : malloc[ size - at + 1 ]
        rd : i64 [ fread[ buf, 1, size - at, fp ] ]
        fclose[ fp ]
        bp : @u8 [ buf ]
        bp[ rd ] = 0
        s : string [ cast cstr [ buf ] ]
        free[ buf ]
        return s

    # it keeps file checkpoints for the rewind only when asked
    func env [] -> vec string
        kv : string 'CLAUDE_CODE_ENABLE_FILE_CHECKPOINTING=1'
        return vec string [] [ kv ]

    func message [ text: string ] -> string
        q : string quote[ text ]
        m : string '{{"role":"user","content":{q}}}'
        return '{{"type":"user","message":{m}}}\n'

    # files back to before our last message: claude's control
    # request names that message's id
    func rewind [] -> string
        if [ !users || users.count == 0 ] return ''
        id : string users.pop[]
        rq : string 'rewind-{users.count}'
        qi : string quote[ id ]
        ids : string '"user_message_id":{qi}'
        body : string '{{"subtype":"rewind_files",{ids}}}'
        rid : string '"request_id":"{rq}"'
        return '{{"type":"control_request",{rid},"request":{body}}}\n'

    func event [ e: map ]
        type : str[ e, 'type' ]
        if [ type == 'system' && str[ e, 'subtype' ] == 'init' ]
            status[ 'busy', 'working' ]
        # our message played back with its id: a rewind names it
        el [ type == 'user' && str[ e, 'uuid' ].count > 0 ]
            users.push[ str[ e, 'uuid' ] ]
        el [ type == 'control_response' ]
            r : map obj[ e, 'response' ]
            if [ str[ r, 'subtype' ] == 'success' ]
                status[ 'note', 'rewound to before the last message' ]
            el
                er : str[ r, 'error' ]
                why : string [ (er.count > 0) ? er
                               : 'the rewind failed' ]
                status[ 'needs', why ]
        el [ type == 'assistant' ]
            cs : array list[ obj[ e, 'message' ], 'content' ]
            if [ !cs ] return
            for [ v: Au ] in cs
                c : map v
                ct : str[ c, 'type' ]
                if [ ct == 'text' ] notes[ str[ c, 'text' ] ]
                el [ ct == 'tool_use' ]
                    tool[ str[ c, 'name' ], obj[ c, 'input' ] ]
        el [ type == 'result' ]
            if [ flag[ e, 'is_error' ] ]
                say[ 'needs', str[ e, 'result' ] ]
                status[ 'needs', 'error' ]
                done = true
            el end[]

    # a tool it called: an edit as its diff, else what it works on
    func tool [ name: string, given: map ]
        if [ name == 'Edit' || name == 'Write' || name == 'MultiEdit' ]
            edit_diff[ given ]
            status[ 'busy', base[ str[ given, 'file_path' ] ] ]
        el [ name == 'Bash' ]
            d : str[ given, 'description' ]
            cm : str[ given, 'command' ]
            status[ 'busy', (d.count > 0) ? d : cm ]
        el
            t : str[ given, 'file_path' ]
            if [ t.count == 0 ] t = str[ given, 'pattern' ]
            on : string [ (t.count > 0) ? '{name} {base[ t ]}' : name ]
            status[ 'busy', on ]

# at the build: Anthropic's binary for this version, checked, kept
# in install/lib/claude/<version> and linked as install/bin/claude
export func install_claude []
    ins : string '{path.path_install[]}'
    ver : claude_ver[]
    dir : '{ins}/lib/claude/{ver}'
    exe : path '{dir}/claude'
    if [ !exe.exists[] ]
        url : 'https://downloads.claude.ai/claude-code-releases/{ver}/linux-x64/claude'
        part : '{dir}/claude.part'
        get : command { mkdir -p {dir} && curl -fsSL {url} -o {part}
            && echo "{claude_sum[]}  {part}" | sha256sum -c --quiet
            && chmod 755 {part} && mv {part} {exe} }
        if [ get.exec[ false ] != 0 ]
            log 'claude: {ver} failed'
            return
    ln : command { ln -sfn {exe} {ins}/bin/claude }
    if [ ln.exec[ false ] == 0 ] log 'claude: {ver}'
