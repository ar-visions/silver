diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
index 6b945bd..fd2b628 100644
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -2476,6 +2476,37 @@ static UINT gcd( UINT a, UINT b )
     }
 }
 
+/* pack num / den as (den << 16) | num, each in 16 bits; a ratio that
+ * does not fit in lowest terms (an odd mode size against a large one)
+ * is approximated instead of failing */
+static UINT pack_dpi_ratio( UINT num, UINT den )
+{
+    UINT d = gcd( num, den );
+
+    if (d)
+    {
+        num /= d;
+        den /= d;
+    }
+    if (num >= 65536 || den >= 65536)
+    {
+        UINT64 n = num, m = den;
+
+        if (n >= m)
+        {
+            den = max( 65535 * m / n, 1 );
+            num = min( (n * den + m / 2) / m, 65535 );
+        }
+        else
+        {
+            num = max( 65535 * n / m, 1 );
+            den = min( (m * num + n / 2) / n, 65535 );
+        }
+    }
+    if (den == 1) den = 0;
+    return (den << 16) | num;
+}
+
