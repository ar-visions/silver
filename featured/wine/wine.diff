+/*********************************************************************
+ * ?__ExceptionPtrSwap@@YAXPAX0@Z
+ * ?__ExceptionPtrSwap@@YAXPEAX0@Z
+ */
+void __cdecl __ExceptionPtrSwap(exception_ptr *ep, exception_ptr *other)
+{
+    exception_ptr tmp;
+
+    TRACE("(%p %p)\n", ep, other);
+
+    tmp = *ep;
+    *ep = *other;
+    *other = tmp;
+}
