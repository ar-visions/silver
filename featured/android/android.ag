    --with-system-libdir=/usr/lib
    >> ln -sf pkgconf {install}/bin/pkg-config
import meson/1.8.3 from https://github.com/mesonbuild/meson/releases/download/1.8.3/meson-1.8.3.tar.gz
    > python3 packaging/create_zipapp.py --outfile {install}/bin/meson .
