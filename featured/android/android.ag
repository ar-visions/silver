# android: Android apps as programs (as Wine runs Windows ones),
# on Android Translation Layer: ART runs an apk's code, Android's
# APIs are made on GTK 4, bionic_translation loads its native
# libraries; no Android system boots. Its card signs in to Google
# Play and lists the account's apps; each one fetched is a card
export 0.0.0
export software ['everyday']
export platforms ['x64']
export extensions ['.apk']
export run ['android-run']
export pages ['play.google.com/store/apps/details']

import <stdlib.h>

# every library below comes from these imports alone; the lines
# shared with wine are the same text (one build, one cache key)

# the build tools
import bison/3.8.2 from https://ftp.gnu.org/gnu/bison/bison-3.8.2.tar.xz
    PATH={install}/bin:$PATH
    --disable-nls
import flex/2.6.4 from https://github.com/westes/flex/releases/download/v2.6.4/flex-2.6.4.tar.gz
    PATH={install}/bin:$PATH
    --disable-nls
import cmake/3.31.6 from https://github.com/Kitware/CMake/releases/download/v3.31.6/cmake-3.31.6.tar.gz
    PATH={install}/bin:$PATH
    > ./bootstrap --prefix={install} --parallel=16 -- -DCMAKE_USE_OPENSSL=ON -DBUILD_TESTING=OFF
    > make -j16 install
    -DCMAKE_USE_OPENSSL=ON
    -DBUILD_TESTING=OFF
import pkgconf/2.3.0 from https://distfiles.ariadne.space/pkgconf/pkgconf-2.3.0.tar.xz
