# Inkscape 1.3.2 (GTK 3) and the libraries it needs
export 1.3.2
export software ['creative']
export icon ['inkscape']
export build none

# gtkmm 3 and its C++ bindings, each on the last
import libsigcplusplus/2.12.1 from https://download.gnome.org/sources/libsigc++/2.12/libsigc++-2.12.1.tar.xz
    PATH={install}/bin:$PATH
    LDFLAGS=-Wl,-rpath,{install}/lib
    PKG_CONFIG_PATH={install}/lib/pkgconfig:{install}/share/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig
    -Dmaintainer-mode=false
    -Dbuild-documentation=false
    -Dbuild-examples=false
    -Dbuild-tests=false
import glibmm/2.66.7 from https://download.gnome.org/sources/glibmm/2.66/glibmm-2.66.7.tar.xz
    PATH={install}/bin:$PATH
    LDFLAGS=-Wl,-rpath,{install}/lib
    PKG_CONFIG_PATH={install}/lib/pkgconfig:{install}/share/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig
    -Dmaintainer-mode=false
    -Dbuild-documentation=false
    -Dbuild-examples=false
import cairomm/1.14.5 from https://www.cairographics.org/releases/cairomm-1.14.5.tar.xz
    PATH={install}/bin:$PATH
    LDFLAGS=-Wl,-rpath,{install}/lib
    PKG_CONFIG_PATH={install}/lib/pkgconfig:{install}/share/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig
    -Dmaintainer-mode=false
    -Dbuild-documentation=false
    -Dbuild-examples=false
    -Dbuild-tests=false
import pangomm/2.46.4 from https://download.gnome.org/sources/pangomm/2.46/pangomm-2.46.4.tar.xz
    PATH={install}/bin:$PATH
    LDFLAGS=-Wl,-rpath,{install}/lib
    LIBRARY_PATH={install}/lib
    PKG_CONFIG_PATH={install}/lib/pkgconfig:{install}/share/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig
    -Dmaintainer-mode=false
    -Dbuild-documentation=false
import atkmm/2.28.4 from https://download.gnome.org/sources/atkmm/2.28/atkmm-2.28.4.tar.xz
    PATH={install}/bin:$PATH
    LDFLAGS=-Wl,-rpath,{install}/lib
    LIBRARY_PATH={install}/lib
    PKG_CONFIG_PATH={install}/lib/pkgconfig:{install}/share/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig
    -Dmaintainer-mode=false
    -Dbuild-documentation=false
import gtkmm/3.24.9 from https://download.gnome.org/sources/gtkmm/3.24/gtkmm-3.24.9.tar.xz
    PATH={install}/bin:$PATH
    LDFLAGS=-Wl,-rpath,{install}/lib
    LIBRARY_PATH={install}/lib
    PKG_CONFIG_PATH={install}/lib/pkgconfig:{install}/share/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig
    -Dmaintainer-mode=false
    -Dbuild-documentation=false
    -Dbuild-demos=false
    -Dbuild-tests=false

# libsoup 2.4: Inkscape 1.3 asks for it (aura's is 3)
import libsoup/2.74.3 from https://download.gnome.org/sources/libsoup/2.74/libsoup-2.74.3.tar.xz
    PATH={install}/bin:$PATH
    LDFLAGS=-Wl,-rpath,{install}/lib
    PKG_CONFIG_PATH={install}/lib/pkgconfig:{install}/share/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig
    -Dgssapi=disabled
    -Dntlm=disabled
    -Dbrotli=disabled
    -Dtls_check=false
    -Dgnome=false
    -Dintrospection=disabled
    -Dvapi=disabled
    -Dgtk_doc=false
    -Dtests=false
    -Dsysprof=disabled

# the C libraries Inkscape requires
import gc/8.2.8 from https://github.com/ivmai/bdwgc/releases/download/v8.2.8/gc-8.2.8.tar.gz
    LDFLAGS=-Wl,-rpath,{install}/lib
    -Denable_cplusplus=ON
    -Denable_docs=OFF
    -DCMAKE_INSTALL_RPATH={install}/lib
import lcms2/2.16 from https://github.com/mm2/Little-CMS/releases/download/lcms2.16/lcms2-2.16.tar.gz
    LDFLAGS=-Wl,-rpath,{install}/lib
    --disable-static
    --without-jpeg
    --without-tiff
import gsl/2.8 from https://ftp.gnu.org/gnu/gsl/gsl-2.8.tar.gz
    LDFLAGS=-Wl,-rpath,{install}/lib
    --disable-static
    > make -j32
    > make install
# its CMake wants libxml2's CMake file (Ubuntu ships none):
# libxslt.deleted drops it, so configure builds it
import libxslt/1.1.42 from https://download.gnome.org/sources/libxslt/1.1/libxslt-1.1.42.tar.xz
    LDFLAGS=-Wl,-rpath,{install}/lib
    PKG_CONFIG_PATH={install}/lib/pkgconfig:/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig
    --disable-static
    --without-python
    --without-crypto
import potrace/1.16 from https://potrace.sourceforge.net/download/1.16/potrace-1.16.tar.gz
    LDFLAGS=-Wl,-rpath,{install}/lib
    --disable-static
    --with-libpotrace
import double-conversion/3.3.0 from https://github.com/google/double-conversion/archive/refs/tags/v3.3.0.tar.gz
    -DBUILD_SHARED_LIBS=ON
    -DCMAKE_INSTALL_RPATH={install}/lib

# boost: only filesystem and stacktrace are compiled
import boost/1.86.0 from https://archives.boost.io/release/1.86.0/source/boost_1_86_0.tar.bz2
    > ./bootstrap.sh --prefix={install} --with-libraries=filesystem,stacktrace
    > ./b2 -j32 link=shared variant=release install

# Inkscape itself, into install/bin; the system first: our
# freetype is a static library, not one for a shared object
import inkscape/1.3.2 from https://media.inkscape.org/dl/resources/file/inkscape-1.3.2.tar.xz
    PATH={install}/bin:$PATH
    PKG_CONFIG_PATH=/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/share/pkgconfig:{install}/lib/pkgconfig:{install}/share/pkgconfig
    XDG_DATA_DIRS={install}/share:/usr/share
    -DCMAKE_PREFIX_PATH={install}
    -DBoost_ROOT={install}
    -DCMAKE_INSTALL_RPATH={install}/lib
    "-DCMAKE_SHARED_LINKER_FLAGS=-L/usr/lib/x86_64-linux-gnu -Wl,-rpath,{install}/lib"
    "-DCMAKE_EXE_LINKER_FLAGS=-L/usr/lib/x86_64-linux-gnu -Wl,-rpath,{install}/lib"
    -DWITH_INTERNAL_2GEOM=ON
    -DENABLE_POPPLER=OFF
    -DENABLE_POPPLER_CAIRO=OFF
    -DWITH_IMAGE_MAGICK=OFF
    -DWITH_GRAPHICS_MAGICK=OFF
    -DWITH_LIBCDR=OFF
    -DWITH_LIBVISIO=OFF
    -DWITH_LIBWPG=OFF
    -DWITH_GNU_READLINE=OFF
    -DWITH_GSOURCEVIEW=OFF
    -DWITH_NLS=OFF
    -DWITH_MANPAGE_COMPRESSION=OFF
    -DBUILD_TESTING=OFF
