# waydroid: Android (LineageOS with Google Play) in an LXC container
# on our own kernel; each Android app is a window on orbiter's
# Wayland display. Its build fetches LXC, libgbinder and Waydroid,
# and the system and vendor images, into silver's install
export 1.6.3
export software ['everyday']
export platforms ['x64']
export icon ['waydroid']
# run by orbiter itself: the container needs root and binder
export host ['waydroid-up']

import <stdlib.h>
import <stdio.h>

# the build tools
import pkgconf/2.3.0 from https://distfiles.ariadne.space/pkgconf/pkgconf-2.3.0.tar.xz
    --with-system-includedir=/usr/include
    --with-system-libdir=/usr/lib
    >> ln -sf pkgconf {install}/bin/pkg-config
import meson/1.8.3 from https://github.com/mesonbuild/meson/releases/download/1.8.3/meson-1.8.3.tar.gz
    > python3 packaging/create_zipapp.py --outfile {install}/bin/meson .

# the base libraries (the same lines as wine's: one build for both)
import madler:zlib/51b7f2abdade71cd9bb0e7a373ef2610ec6f9daf <zlib.h>
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
    -lz
import libffi/3.4.6 from https://github.com/libffi/libffi/releases/download/v3.4.6/libffi-3.4.6.tar.gz
    PATH={install}/bin:$PATH
    --disable-docs
import glib/2.84.4 from https://download.gnome.org/sources/glib/2.84/glib-2.84.4.tar.xz
    PATH={install}/bin:$PATH
    LDFLAGS=-Wl,-rpath,{install}/lib
    -Dtests=false
    -Dintrospection=disabled
    -Dman-pages=disabled
    -Ddocumentation=false
    -Dnls=disabled

# LXC and what it links: capabilities and the syscall filter
import libcap/2.73 from https://mirrors.edge.kernel.org/pub/linux/libs/security/linux-privs/libcap2/libcap-2.73.tar.xz
    > make -C libcap prefix={install} lib=lib GOLANG=no PAM_CAP=no
    > make -C libcap prefix={install} lib=lib GOLANG=no PAM_CAP=no RAISE_SETFCAP=no install
import libseccomp/2.5.5 from https://github.com/seccomp/libseccomp/releases/download/v2.5.5/libseccomp-2.5.5.tar.gz
    PATH={install}/bin:$PATH
# Ubuntu confines with AppArmor: LXC must speak it (Waydroid's
# config names a profile)
import autoconf-archive/2024.10.16 from https://ftp.gnu.org/gnu/autoconf-archive/autoconf-archive-2024.10.16.tar.xz
    PATH={install}/bin:$PATH
import apparmor/4.1.8 from https://gitlab.com/apparmor/apparmor/-/archive/v4.1.8/apparmor-v4.1.8.tar.gz
    PATH={install}/bin:$PATH
    ACLOCAL_PATH={install}/share/aclocal
    > cd libraries/libapparmor && sh autogen.sh
    > cd libraries/libapparmor && ./configure --prefix={install} --without-perl --without-python --without-ruby
    > make -C libraries/libapparmor -j16
    > make -C libraries/libapparmor install
import lxc/6.0.6 from https://linuxcontainers.org/downloads/lxc/lxc-6.0.6.tar.gz
    PATH={install}/bin:$PATH
    PKG_CONFIG_PATH={install}/lib/pkgconfig
    LDFLAGS=-Wl,-rpath,{install}/lib
    -Dinit-script=[]
    -Dman=false
    -Dexamples=false
    -Dselinux=false
    -Dopenssl=false
    -Ddbus=false
    -Dspecfile=false
    -Dinstall-init-files=false
    -Dinstall-state-dirs=false
    -Dtests=false

# binder from user space, and its python module (Waydroid's)
import libglibutil/1.0.83 from https://github.com/sailfishos/libglibutil/archive/refs/tags/1.0.83.tar.gz
    PATH={install}/bin:$PATH
    PKG_CONFIG_PATH={install}/lib/pkgconfig
    LDFLAGS=-Wl,-rpath,{install}/lib
    > make LIBDIR={install}/lib KEEP_SYMBOLS=1 release pkgconfig
    > make LIBDIR={install}/lib INSTALL_INCLUDE_DIR={install}/include/gutil install-dev
    >> sed -i 's|^includedir=.*|includedir={install}/include|' {install}/lib/pkgconfig/libglibutil.pc
import libgbinder/1.1.54 from https://github.com/mer-hybris/libgbinder/archive/refs/tags/1.1.54.tar.gz
    PATH={install}/bin:$PATH
    PKG_CONFIG_PATH={install}/lib/pkgconfig
    LDFLAGS=-Wl,-rpath,{install}/lib
    > make LIBDIR={install}/lib KEEP_SYMBOLS=1 release pkgconfig
    > make LIBDIR={install}/lib INSTALL_INCLUDE_DIR={install}/include/gbinder install-dev
    >> sed -i 's|^includedir=.*|includedir={install}/include|' {install}/lib/pkgconfig/libgbinder.pc
import gbinder-python/1.3.1 from https://github.com/waydroid/gbinder-python/archive/86b8feba4cacd0952b010d1c3af6a29a0c146ced.tar.gz
    PATH={install}/bin:$PATH
    PKG_CONFIG_PATH={install}/lib/pkgconfig
    > test -d {install}/pylib/Cython || python3 -m pip install --quiet --target {install}/pylib Cython
    > env PYTHONPATH={install}/pylib LDFLAGS=-Wl,-rpath,{install}/lib python3 setup.py build_ext --inplace
    > cp gbinder*.so {install}/pylib/

# Waydroid itself: python, run from its own folder
import waydroid/1.6.3 from https://github.com/waydroid/waydroid/archive/refs/tags/1.6.3.tar.gz
    > rm -rf {install}/lib/waydroid && mkdir -p {install}/lib/waydroid
    > cp -r waydroid.py tools data dbus LICENSE {install}/lib/waydroid/

# where the images live
func image_dir [] -> string
    ip : path.path_install[]
    return '{ip.absolute[]}/share/waydroid/images'

# the newest file of a channel: Waydroid's OTA list, its first entry
func ota_url [ list: string, dir: string ] -> string
    js : '{dir}/ota.json'
    got : command { mkdir -p {dir} && curl -fsSL {list} -o {js} }
    if [ got.exec[ false ] != 0 ] return ''
    f : path [ js ]
    s : string f.load[ typeid[ string ], null ]
    if [ !s ] return ''
    at : s.index_of[ '"url": "' ]
    if [ at < 0 ] return ''
    rest : s.mid[ at + 8, s.count - at - 8 ]
    q : rest.index_of[ '"' ]
    if [ q <= 0 ] return ''
    return rest.mid[ 0, q ]

# one image: the zip fetched, its .img kept, the zip gone
func fetch_image [ list: string, name: string ] -> bool
    dir : image_dir[]
    img : path '{dir}/{name}.img'
    if [ img.exists[] ] return true
    url : ota_url[ list, dir ]
    if [ url.count == 0 ]
        log 'waydroid: no {name} image listed'
        return false
    log 'waydroid: fetching {url}'
    zip : '{dir}/{name}.zip'
    get : command { mkdir -p {dir} && curl -fsSL {url} -o {zip}
        && cd {dir} && unzip -o -q {zip} {name}.img && rm -f {zip} }
    return get.exec[ false ] == 0

# at the build: the GAPPS system and MAINLINE vendor images, then
# install/bin/waydroid running Waydroid on our LXC and python module
export func install_waydroid []
    ip : path.path_install[]
    ins : string '{ip.absolute[]}'
    ota : 'https://ota.waydro.id'
    sys : '{ota}/system/lineage/waydroid_x86_64/GAPPS.json'
    ven : '{ota}/vendor/waydroid_x86_64/MAINLINE.json'
    if [ !fetch_image[ sys, 'system' ] ] return
    if [ !fetch_image[ ven, 'vendor' ] ] return
    sh : string '#!/bin/sh\nexport PATH={ins}/bin:$PATH\n'
    sh = '{sh}export PYTHONPATH={ins}/pylib:{ins}/lib/waydroid'
    sh = '{sh}${{PYTHONPATH:+:$PYTHONPATH}}\n'
    # the system bus where the system keeps it (our libdbus looks
    # under silver's folder by default)
    sh = '{sh}export DBUS_SYSTEM_BUS_ADDRESS='
    sh = '{sh}${{DBUS_SYSTEM_BUS_ADDRESS:-'
    sh = '{sh}unix:path=/run/dbus/system_bus_socket}}\n'
    # the system's gi first: gbinder's libraries then take the glib
    # it loaded (ours under the system's bindings crashed them)
    py : 'import gi, runpy, sys; sys.argv = sys.argv[1:]; '
    rp : 'runpy.run_path(sys.argv[0], run_name="__main__")'
    sh = '{sh}exec python3 -c \'{py}{rp}\' '
    sh = '{sh}{ins}/lib/waydroid/waydroid.py "$@"\n'
    bin : path '{ins}/bin/waydroid'
    bin.save[ sh, null ]
    # as root (orbiter runs it through pkexec): the bus policy once,
    # the images taken once, then the container's manager
    imgs : image_dir[]
    pol : '/etc/dbus-1/system.d/id.waydro.Container.conf'
    rt : string '#!/bin/sh\nset -e\n'
    rt = '{rt}if [ ! -f {pol} ]; then\n'
    wd : '{ins}/lib/waydroid'
    rt = '{rt}  cp {wd}/dbus/id.waydro.Container.conf {pol}\n'
    rt = '{rt}  dbus-send --system --type=method_call '
    rt = '{rt}--dest=org.freedesktop.DBus / '
    rt = '{rt}org.freedesktop.DBus.ReloadConfig\nfi\n'
    # ours as Waydroid's preinstalled images: init downloads none
    ex : '/etc/waydroid-extra'
    cfg : '/var/lib/waydroid/waydroid.cfg'
    # Android's system user is uid 1000, often the desktop's user
    # too: they share the kernel's inotify cap (128 by default)
    rt = '{rt}sysctl -qw fs.inotify.max_user_instances=8192\n'
    rt = '{rt}mkdir -p {ex} && ln -sfn {imgs} {ex}/images\n'
    rt = '{rt}if ! grep -qs {ex}/images {cfg}; then\n'
    rt = '{rt}  {bin} init -f\nfi\n'
    rt = '{rt}exec {bin} container start\n'
    root : path '{ins}/bin/waydroid-root'
    root.save[ rt, null ]
    # as the user, beside orbiter: the manager started once (one
    # password a start), then Android's session on WAYLAND_DISPLAY,
    # every app a window of its own
    nm : 'id.waydro.Container'
    has : string 'dbus-send --system --print-reply '
    has = '{has}--dest=org.freedesktop.DBus / '
    has = '{has}org.freedesktop.DBus.NameHasOwner string:{nm}'
    up : string '#!/bin/sh\nexport DBUS_SYSTEM_BUS_ADDRESS='
    up = '{up}unix:path=/run/dbus/system_bus_socket\n'
    up = '{up}has() {{ {has} 2>/dev/null'
    up = '{up} | grep -q true; }}\n'
    up = '{up}if ! has; then\n  pkexec {root} &\n'
    up = '{up}  i=0; until has; do i=$((i+1)); '
    up = '{up}[ $i -gt 120 ] && exit 1; sleep 0.5; done\nfi\n'
    up = '{up}( until {bin} status | grep -q RUNNING; '
    up = '{up}do sleep 1; done\n  {bin} prop set '
    up = '{up}persist.waydroid.multi_windows true ) &\n'
    # the display it is bound to (a new orbiter makes a new one)
    sk : '"$HOME/.cache/waydroid-wayland"'
    sock : '"$XDG_RUNTIME_DIR/${{WAYLAND_DISPLAY##*/}}"'
    up = '{up}mkdir -p "$HOME/.cache"; stat -Lc %i {sock} > {sk}\n'
    up = '{up}exec {bin} session start\n'
    upf : path '{ins}/bin/waydroid-up'
    upf.save[ up, null ]
    # an Android app's card: the session started again when it is
    # down or bound to an orbiter display that is gone, then the app
    run : string '#!/bin/sh\nst() {{ {bin} status 2>/dev/null'
    run = '{run} | grep -q "Session:.*RUNNING"; }}\n'
    run = '{run}now=$(stat -Lc %i {sock})\n'
    run = '{run}was=$(cat {sk} 2>/dev/null)\n'
    run = '{run}if ! st || [ "$now" != "$was" ]; then\n'
    run = '{run}  {bin} session stop >/dev/null 2>&1\n'
    run = '{run}  setsid {upf} >/dev/null 2>&1 &\n'
    run = '{run}  i=0; until st; do i=$((i+1)); '
    run = '{run}[ $i -gt 120 ] && exit 1; sleep 1; done\nfi\n'
    run = '{run}exec {bin} app launch "$1"\n'
    runf : path '{ins}/bin/waydroid-app'
    runf.save[ run, null ]
    ch : command { chmod +x {bin} {root} {upf} {runf} }
    if [ ch.exec[ false ] == 0 ] log 'waydroid: installed'

# a desktop entry's value for a key ('Name='), '' when it has none
func entry_value [ text: string, key: string ] -> string
    for [ ln: string ] in text.split[ '\n' ]
        if [ ln.starts_with[ key ] ]
            return ln.mid[ key.count, ln.count - key.count ]
    return ''

# each Android app Waydroid lists (its desktop entries) becomes a
# module of the waydroid store, install/stores/waydroid/<name>; its
# line runs beside orbiter, as binder needs; one gone goes
export func waydroid_store []
    ins : path.path_install[]
    store : string '{ins.absolute[]}/stores/waydroid'
    sd : path [ store ]
    sd.make_dir[]
    home : string [ getenv[ 'HOME' ] ]
    apps : path '{home}/.local/share/applications'
    icons : string '{home}/.local/share/waydroid/data/icons'
    made : map string[string] []
    es : apps.ls[ null, false ]
    if [ es ]
        for [ e: path ] in es
            fn : string e.filename[]
            if [ !fn.starts_with[ 'waydroid.' ]
                 || e.ext[] != 'desktop' ]
                continue
            text : string e.load[ typeid[string], null ]
            if [ !text ] continue
            # waydroid.<package>.desktop
            pkg : string fn.mid[ 9, fn.count - 17 ]
            title : entry_value[ text, 'Name=' ]
            if [ title.count == 0 || pkg.count == 0 ] continue
            name : string ''
            for [ part: string ] in pkg.lcase[].split[ '.' ]
                name = (name.count > 0) ? '{name}_{part}' : part
            made[ name ] = name
            src : string '# {title}: an Android app ({pkg}); '
            src = '{src}the waydroid store wrote this\nexport 1.0.0\n'
            src = '{src}export software [\'everyday\']\n'
            src = '{src}export host [\'waydroid-app {pkg}\']\n'
            src = '{src}export build none\n'
            dir : string '{store}/{name}'
            dp : path [ dir ]
            dp.make_dir[]
            art : path '{icons}/{pkg}.png'
            ic : path '{dir}/images/icon.png'
            if [ art.exists[] && !ic.exists[] ]
                ims : path '{dir}/images'
                ims.make_dir[]
                art.cp[ ic, false, false ]
            out : path '{dir}/{name}.ag'
            was : string ''
            if [ out.exists[] ] was = out.load[ typeid[string], null ]
            if [ was == src ] continue
            out.save[ src, null ]
            log 'waydroid store: {title} ({pkg})'
    have : sd.ls[ null, false ]
    if [ !have ] return
    for [ d: path ] in have
        dn : string d.filename[]
        if [ !d.is_dir[] || made.get[ dn ] ] continue
        rm : command { rm -rf {d} }
        rm.exec[ false ]
