# the properties view: a grid of named controls, one a row,
# shared by every app that edits properties (orbiter, aeon)
export 0.1.0

import vec
import trinity

Option NavButton
    style : CSS {
        layers.body:
            fill_color: #ffffff0c
            radius: 8
            stroke_width: 1
            stroke_color: #ffffff1a
            box_shadow: none
        :hovered
            layers.body:
                fill_color: #ffffff1c
                stroke_color: #ffffff55
                box_shadow: inset 0 0 10px #fcc6
        :pressed
            layers.body:
                fill_color: #ffffff2e
                stroke_color: #ffffff66
        :selected
            layers.body:
                fill_color: #c8641e
                stroke_color: #ffae5e88
    }

# geometry-only tweaks stay code members; base css inherits through
NavButton LabelButton
    area   : Region { r0+ t0 w2.2 h0.9 }
    tlabel : Layer [ label_color: rgba [ '#fffa' ], label_size: 17,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
        label_align: vec2f [ x: 0.5, y: 0.5 ] ]

# a launch path: name and value on a button; a press brings the nav list
# to pick the file
NavButton LaunchPath
    # picked from the module's own extensions across the search path
    public is_resource : bool
    # a folder: double-click one in the nav list to take it
    public is_dir      : bool
    # the full path; the label shows only its name
    public path_value  : string
    tlabel : Layer [ label_color: rgba [ '#fff6' ], label_size: 17,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
        label_align: vec2f [ x: 0.0, y: 0.5 ],
        label_offset: vec2f [ x: 8.0, y: 0.0 ] ]
    # inside the grid: no border, no rounding, a flat fill that lifts on
    # hover
    body : Layer [ fill_color: rgba [ '#0000' ], radius: Radius [ '0' ],
                   stroke_width: 0.0 ]
    style : CSS {
        layers.body:
            fill_color: #0000
            radius: 0
            stroke_width: 0
        :hovered
            layers.body:
                fill_color: #ffffff10
    }

# a field's clear: flush right in its cell, the cell's height
LabelButton LaunchClear
    tlabel : Layer [ label_color: rgba [ '#fffa' ], label_size: 15,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
        label_align: vec2f [ x: 0.5, y: 0.5 ] ]
    body : Layer [ fill_color: rgba [ '#0000' ], radius: Radius [ '0' ],
                   stroke_width: 0.0 ]
    style : CSS {
        layers.body:
            fill_color: #0000
            radius: 0
            stroke_width: 0
        :hovered
            layers.body:
                fill_color: #ffffff10
    }

# a GLFW keycode as the user would name it
func key_name [ code: i32 ] -> string
    if [ code <= 0 ] return 'none'
    if [ code >= 65 && code <= 90 ]
        letters : 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'
        return letters.mid[ code - 65, 1 ]
    if [ code >= 48 && code <= 57 ]
        digits : '0123456789'
        return digits.mid[ code - 48, 1 ]
    if [ code >= 290 && code <= 301 ] return 'f{code - 289}'
    if [ code == 32 ]  return 'space'
    if [ code == 256 ] return 'esc'
    if [ code == 257 ] return 'enter'
    if [ code == 258 ] return 'tab'
    if [ code == 259 ] return 'backspace'
    if [ code == 261 ] return 'delete'
    if [ code == 262 ] return 'right'
    if [ code == 263 ] return 'left'
    if [ code == 264 ] return 'down'
    if [ code == 265 ] return 'up'
    if [ code == 340 ] return 'left shift'
    if [ code == 341 ] return 'left ctrl'
    if [ code == 342 ] return 'left alt'
    if [ code == 344 ] return 'right shift'
    if [ code == 345 ] return 'right ctrl'
    if [ code == 346 ] return 'right alt'
    return 'key {code}'

# a key binding: the label names the key; a press arms it and reads
# 'press key' until the next key lands, which becomes the value
NavButton KeyField
    public  code    : i32
    mutable armed   : bool
    public  changed : bool
    focusable : true
    tlabel : Layer [ label_color: rgba [ '#fff6' ], label_size: 17,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
        label_align: vec2f [ x: 0.0, y: 0.5 ],
        label_offset: vec2f [ x: 8.0, y: 0.0 ] ]
    body : Layer [ fill_color: rgba [ '#0000' ], radius: Radius [ '0' ],
                   stroke_width: 0.0 ]
    style : CSS {
        layers.body:
            fill_color: #0000
            radius: 0
            stroke_width: 0
        :hovered
            layers.body:
                fill_color: #ffffff10
        :focused
            layers.body:
                fill_color: #2f6b4a40
    }
    func on_press [ ev: Event ]
        armed = true
        label = 'press key'
        if [ ux ] ux.set_focus[ a ]
        pristine = false
        ev.no_default     = true
        ev.no_propagation = true
    func on_key [ ev: Event ]
        if [ !armed || !ev.key.state ] return
        # escape backs out: the binding stays what it was
        if [ ev.key.unicode == 256 ]
            armed    = false
            label    = key_name[ code ]
            pristine = false
            ev.no_default = true
            return
        code    = i32[ ev.key.unicode ]
        label   = key_name[ code ]
        armed   = false
        changed = true
        pristine = false
        ev.no_default = true

# a gamepad button as the user would name it
func pad_name [ code: i32 ] -> string
    if [ code < 0 ] return 'none'
    names : 'A B X Y LB RB back start guide L3 R3 up right down left'
    parts : names.split[ ' ' ]
    if [ code < parts.count ] return parts[ code ]
    return 'pad {code}'

# a gamepad binding: a press arms it and reads 'press button' until the
# next pad button lands, which becomes the value
NavButton PadField
    public  code    : i32
    mutable armed   : bool
    public  changed : bool
    focusable : true
    tlabel : Layer [ label_color: rgba [ '#fff6' ], label_size: 17,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
        label_align: vec2f [ x: 0.0, y: 0.5 ],
        label_offset: vec2f [ x: 8.0, y: 0.0 ] ]
    body : Layer [ fill_color: rgba [ '#0000' ], radius: Radius [ '0' ],
                   stroke_width: 0.0 ]
    style : CSS {
        layers.body:
            fill_color: #0000
            radius: 0
            stroke_width: 0
        :hovered
            layers.body:
                fill_color: #ffffff10
        :focused
            layers.body:
                fill_color: #2f6b4a40
    }
    func on_press [ ev: Event ]
        armed = true
        label = 'press button'
        if [ ux ] ux.set_focus[ a ]
        pristine = false
        ev.no_default     = true
        ev.no_propagation = true
    func on_pad [ ev: Event ]
        if [ !armed || !ev.pad.state ] return
        code    = ev.pad.button
        label   = pad_name[ code ]
        armed   = false
        changed = true
        pristine = false
        ev.no_default = true

# a number stepped in place: - at the left, + at the right, the value
# between
element StepField
    public  value   : f32
    public  min     : f32
    public  max     : f32 [ 100.0 ]
    public  step    : f32 [ 1.0 ]
    public  whole   : bool          # an integer member: no decimals
    public  changed : bool
    body : Layer [ fill_color: rgba [ '#0000' ], radius: Radius [ '0' ],
                   stroke_width: 0.0 ]
    style : CSS {
        layers.body:
            fill_color: #0000
            radius: 0
            stroke_width: 0
        :hovered
            layers.body:
                fill_color: #ffffff10
    }
    func text [] -> string
        return (whole) ? '{value.0f}' : '{value.2f}'
    func on_press [ ev: Event ]
        bw : f32 [ 24.0 ]
        if      [ ev.mouse.pos.x < bw ]            value -= step
        el [ ev.mouse.pos.x > bounds.w - bw ] value += step
        el return
        if [ value < min ] value = min
        if [ value > max ] value = max
        changed  = true
        pristine = false
        ev.no_default     = true
        ev.no_propagation = true
    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || bounds.w <= 0.0 ]
            return
        cv : Canvas [ w.screen ]
        bw : f32 [ 24.0 ]
        cv.set_font[ shared_font[ cv,
            'fonts/BarlowCondensed-Regular.ttf', 17 ] ]
        cv.font_size[ 17 ]
        cv.fill_color[ '#fff6' ]
        cv.draw_text[ '-', rect [ x: 0.0, y: 0.0, w: bw, h: bounds.h ],
            vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible,
            null ]
        cv.draw_text[ '+',
                      rect [ x: bounds.w - bw, y: 0.0, w: bw,
                             h: bounds.h ],
            vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible,
            null ]
        cv.fill_color[ '#e8e8ec' ]
        cv.draw_text[ text[],
                      rect [ x: bw, y: 0.0, w: bounds.w - bw * 2.0,
                             h: bounds.h ],
            vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible,
            null ]
        cv.paint[]
        cv.set_font[ null ]

# an Action of the app: a press calls it on the running instance
NavButton LaunchAction
    tlabel : Layer [ label_color: rgba [ '#cfe' ], label_size: 17,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
        label_align: vec2f [ x: 0.0, y: 0.5 ],
        label_offset: vec2f [ x: 8.0, y: 0.0 ] ]
    body : Layer [ fill_color: rgba [ '#2f6b4a40' ],
                   radius: Radius [ '0' ], stroke_width: 0.0 ]
    style : CSS {
        layers.body:
            fill_color: #2f6b4a40
            radius: 0
            stroke_width: 0
        :hovered
            layers.body:
                fill_color: #2f6b4a80
    }

# run arguments for the pane's app; sits in the run band header
element ArgsField
    style : CSS {
        area: l0+ t0 w8 h0.9
        layers.body:
            fill_color: #0000
            radius: 8
            stroke_width: 1
            stroke_color: #fff1
        layers.face:
            label_color: #fff6
            label_size: 18
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            editable: true
            label_align: 0.0 0.5
            label_offset: 10.0 0.0
        :focused
            layers.body:
                fill_color: #2f6b4a40
            layers.face:
                label_color: #ffff
    }

# launch panel: the app's `[ Launch ]` members as controls, over the
# console
Check LaunchCheck
    body : Layer [ fill_color: rgba [ '#ffffff0c' ],
                   radius: Radius [ '0' ],
        stroke_width: 0.0, stroke_color: rgba [ '#ffffff33' ] ]
    face : Layer [ label_color: rgba [ '#e8e8ec' ], label_size: 16,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
        label_align: vec2f [ x: 0.5, y: 0.5 ] ]
    style : CSS {
        layers.body:
            fill_color: #ffffff0c
            stroke_color: #ffffff33
        :selected
            layers.body:
                fill_color: #6cb6ff66
                stroke_color: #8fd0ff
    }
    # the panel's press toggles it; a click toggling it again would undo
    # that
    func on_click [ ev: Event ]
        return
    # the mark: a filled check inside the box while selected
    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !selected || !bounds ]
            return
        cv : Canvas [ w.screen ]
        s  : f32 [ (bounds.w < bounds.h) ? bounds.w : bounds.h ]
        cv.stroke_width[ 0.0 ]
        cv.fill_color[ rgba [ '#e8f4ff' ] ]
        cv.move_to[ s * 0.20, s * 0.52 ]
        cv.line_to[ s * 0.42, s * 0.74 ]
        cv.line_to[ s * 0.82, s * 0.30 ]
        cv.line_to[ s * 0.72, s * 0.20 ]
        cv.line_to[ s * 0.42, s * 0.54 ]
        cv.line_to[ s * 0.30, s * 0.42 ]
        cv.close_path[]
        cv.paint[]

# one element per parameter: the name sits inside, the value edits to
# its right the name takes its word plus two spaces; the value begins
# right after
func launch_name_w [ name: string ] -> f32
    # glyph advance at label_size 13 is ~0.25 units; ~2 spaces after, no
    # clip
    return 0.25 * f32[ (name) ? i32[ name.count ] : 0 ] + 0.45

ArgsField LaunchField
    name : Layer [ label_color: rgba [ '#c9c4dd' ], label_size: 16,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
        label_align: vec2f [ x: 0.0, y: 0.5 ] ]
    face : Layer [ label_color: rgba [ '#fff6' ], label_size: 17,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
                   editable: true,
        label_align: vec2f [ x: 0.0, y: 0.5 ] ]
    # inside the grid: the rules are the borders
    style : CSS {
        layers.body:
            fill_color: #0000
            radius: 0
            stroke_width: 0
        :focused
            layers.body:
                fill_color: #2f6b4a40
    }
    func init []
        # no name (a panel's cell): no gap for one
        bare : bool [ !label || label.count == 0 ]
        nw : f32 [ (bare) ? 0.0 : launch_name_w[ label ] ]
        vx : f32 [ (bare) ? 0.25 : 0.4 + nw ]
        name.area = Region [ 'l0.4 t0 w{nw} b0' ]
        face.area = Region [ 'l{vx} t0 r0.3 b0' ]

# a number as a field shows it: up to 3 decimals, no trailing zeros
func num_text [ v: f32, whole: bool ] -> string
    if [ whole ] return '{v.0f}'
    t : '{v.3f}'
    while [ t.ends_with[ '0' ] ]
        t = t.mid[ 0, t.count - 1 ]
    if [ t.ends_with[ '.' ] ] t = t.mid[ 0, t.count - 1 ]
    if [ t.compare[ '-0' ] == 0 ] t = '0'
    return t

# a number: a press and a drag left or right changes it (shift:
# a tenth as fast); a click with no drag types it as text
LaunchField DragField
    public  whole   : bool
    # a 0..1 value: the cell fills from the left by it
    public  bar     : bool
    # one part of a vector's cell: no gap for a name
    public  part    : bool
    mutable held    : bool
    mutable dragged : bool
    mutable press_x : f32
    mutable base    : f32
    mutable rate    : f32
    # a bar's full value (1, or 100 for a percent)
    public  top     : f32 [ 1.0 ]
    style : CSS {
        layers.body:
            fill_color: #0000
            radius: 0
            stroke_width: 0
        :hovered
            layers.body:
                fill_color: #ffffff0a
        :focused
            layers.body:
                fill_color: #2f6b4a40
    }

    func init []
        # no name (a part, or a panel's cell): no gap for one
        bare : bool [ part || !label || label.count == 0 ]
        nw : f32 [ (bare) ? 0.0 : launch_name_w[ label ] ]
        vx : f32 [ (bare) ? 0.25 : 0.4 + nw ]
        name.area = Region [ 'l0.4 t0 w{nw} b0' ]
        face.area = Region [ 'l{vx} t0 r0.15 b0' ]

    public func on_press [ ev: Event ]
        # typing: the caret is the text field's own
        if [ focused || ev.mouse.button != 0 ] return
        held    = true
        dragged = false
        press_x = ev.mouse.pos.x
        base    = (edit) ? f32[ edit.real_value[] ] : 0.0
        # a step a pixel by the value's size, never under 0.002
        rate    = abs[ base ] * 0.004
        if [ rate < 0.002 ] rate = 0.002
        if [ whole ] rate = 0.1
        # a bar: the cell's width is the whole 0..1
        if [ bar && bounds && bounds.w > 0.0 ] rate = top / bounds.w
        ux.set_capture[ a ]
        ev.no_default     = true
        ev.no_propagation = true

    public func on_move [ ev: Event ]
        if [ !held ] return
        dx : f32 [ ev.mouse.pos.x - press_x ]
        if [ !dragged && abs[ dx ] < 3.0 ] return
        dragged = true
        fine : f32 [ (ux && ux.shift) ? 0.1 : 1.0 ]
        v : f32 [ base + dx * rate * fine ]
        if [ whole ] v = round[ v ]
        if [ bar ] v = clamp[ v, 0.0, top ]
        # a percent in tenths
        if [ top == 100.0 ] v = round[ v * 10.0 ] / 10.0
        edit       = num_text[ v, whole ]
        sel_col    = edit.count
        anchor_col = edit.count
        pristine   = false
        ev.no_propagation = true

    # enter or escape: done typing (the value already applied)
    public func on_key [ ev: Event ]
        k : i32 [ ev.key.unicode ]
        if [ ev.key.state && (k == 257 || k == 335 || k == 256) ]
            # a number left empty is 0, shown so
            if [ !edit || edit.count == 0 ]
                edit       = '0'
                sel_col    = 1
                anchor_col = 1
                pristine   = false
            ux.release_focus[ a ]

    # the bar: the value's share of the cell, over the text dimly
    public func draw [ w: Window ]
        if [ !bar || w.draw_stage != CanvasType.screen ] return
        v : f32 [ (edit && edit.count > 0)
                  ? f32[ edit.real_value[] ] : 0.0 ]
        cv : Canvas [ w.screen ]
        cv.save[]
        cv.stroke_width[ 0.0 ]
        cv.fill_color[ rgba [ '#806bff40' ] ]
        cv.rect_to[ 0.0, 0.0, bounds.w * clamp[ v / top, 0.0, 1.0 ],
                    bounds.h ]
        cv.paint[]
        # a percent says so at the cell's right
        if [ top == 100.0 ]
            cv.fill_color[ '#fff6' ]
            cv.set_font[ shared_font[ cv,
                'fonts/BarlowCondensed-Regular.ttf', 16 ] ]
            cv.font_size[ 16 ]
            cv.draw_text[ '%', rect [ x: bounds.w - 22.0, y: 0.0,
                                      w: 16.0, h: bounds.h ],
                vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ],
                Overflow.visible, null ]
            cv.paint[]
            cv.set_font[ null ]
        cv.restore[]

    public func on_release [ ev: Event ]
        if [ !held ] return
        held = false
        ux.release_capture[ a ]
        # no drag: a click, so the text takes the typing
        if [ !dragged && edit ]
            ux.set_focus[ a ]
            sel_col    = edit.count
            anchor_col = 0
            pristine   = false

# a colour's #rrggbbaa, typed: a click puts the caret in it,
# enter or escape leaves (ColorPick reads it as it changes)
LaunchField ColorHex
    # being typed in: a click then only moves the caret
    mutable typing : bool
    style : CSS {
        layers.body:
            fill_color: #0000
            radius: 0
            stroke_width: 0
        layers.face:
            label_size: 16
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_offset: 2.0 0.0
        :hovered
            layers.body:
                fill_color: #ffffff0a
        :focused
            layers.body:
                fill_color: #2f6b4a40
    }

    func init []
        name.area = Region [ 'l0 t0 w0 b0' ]
        face.area = Region [ 'l0 t0 r0 b0' ]

    public func on_key [ ev: Event ]
        k : i32 [ ev.key.unicode ]
        if [ ev.key.state && (k == 257 || k == 335 || k == 256) ]
            typing = false
            ux.release_focus[ a ]

    # the first click: the whole value chosen to type over; a
    # click while typing only places the caret
    public func on_release [ ev: Event ]
        if [ ev.mouse.button != 0 || !ux || typing ] return
        if [ !focused ] ux.set_focus[ a ]
        typing     = true
        sel_col    = (edit) ? edit.count : 0
        anchor_col = 0
        pristine   = false

    # each repaint (a key typed) hands the text to the picker
    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        if [ !focused ] typing = false
        pk : parent inherits ColorPick
        if [ !pk ] return
        pk.hex_sync[]
        pk.pristine = false

# a colour as 0..1 numbers, linear as materials keep them; a
# paint may be a gradient (stops: an offset and a colour each):
# the preview strip across the top (a gradient's stops on it),
# a saturation and brightness square, a hue bar, an alpha bar;
# right of them a paint's kinds, the #rrggbbaa (typed when
# clicked) and clear. Picked in display (sRGB) space.
# The value: 'r, g, b, a', '' none, or 'linear | 0: r, g, b, a
# | 1: r, g, b, a' (radial the same)
element ColorPick
    mutable hue     : f32
    mutable sat     : f32
    mutable val     : f32
    mutable alpha   : f32 [ 1.0 ]
    # the text the hue, saturation and value were read from
    mutable read_of : string
    # 1 the square held, 2 the hue bar, 3 the alpha bar, 4 a stop
    mutable held    : i32
    # a paint (an svg's fill): its kinds and a clear button
    public paint    : bool
    # 0 solid, 1 linear, 2 radial; the stops' offsets
    # and linear r g b a each; the stop chosen
    mutable kind    : i32
    mutable offs    : vec f32
    mutable cols    : vec f32
    mutable sel     : i32
    # a stop dragged off the strip goes at the release
    mutable dropping : bool
    # a paint that is one colour (a glow's): no kinds
    public solid    : bool

    func strip_h [] -> f32
        return 22.0

    # the square's and the bars' top
    func top_y [] -> f32
        return 4.0 + strip_h[] + 6.0

    # the square: what the row leaves, 56 px at most (the kinds'
    # words need the room right of the bars)
    func box [] -> f32
        return clamp[ bounds.h - top_y[] - 4.0, 8.0, 56.0 ]

    # the hue bar's, the alpha bar's (10 px each) and the right
    # column's left
    func hue_x [] -> f32
        return 4.0 + box[] + 4.0
    func alpha_x [] -> f32
        return hue_x[] + 14.0
    func swatch_x [] -> f32
        return alpha_x[] + 14.0

    func render [] -> Elements
        out : Elements []
        rx : f32 [ swatch_x[] ]
        ty : f32 [ top_y[] ]
        # a paint: the kinds in one row, the hex and clear under
        kinds : bool [ paint && !solid ]
        hy : f32 [ (kinds) ? ty + 20.0 : ty ]
        hr : string [ (paint) ? 'r64px' : 'r0' ]
        out[ 'hex' ] = ColorHex [ label: '', focusable: true,
            area: Region [ 'l{rx}px t{hy}px {hr} h20px' ] ]
        if [ kinds ]
            out[ 'kinds' ] = TButtons [
                buttons: vec string [] [ 'k_solid', 'k_linear',
                                         'k_radial' ],
                labels: vec string [] [ 'solid', 'linear',
                                        'radial' ],
                icons: false, manual: true, label_px: 10.0,
                rest_glow: rgba [ '#ccf2' ], rest_px: 6.0,
                area: Region [ 'l{rx}px t{ty}px r4px h16px' ] ]
        if [ paint ]
            out[ 'clear' ] = TButtons [
                buttons: vec string [] [ 'clear' ],
                labels: vec string [] [ 'clear' ], icons: false,
                manual: true, label_px: 11.0,
                rest_glow: rgba [ '#ccf2' ], rest_px: 6.0,
                area: Region [ 'r4px t{hy + 2.0}px w56px h16px' ] ]
        return out

    func hex_field [] -> ColorHex
        if [ !elements || !elements.contains[ 'hex' ] ] return null
        return elements[ 'hex' ] inherits ColorHex

    # the numbers of a 'r, g, b, a' text
    func nums_of [ t: string ] -> vec f32
        out : vec f32 []
        if [ !t ] return out
        for [ w: string ] in t.split[ ',' ]
            s : w.trim[]
            if [ s.count > 0 ] out.push[ f32[ s.real_value[] ] ]
        return out

    # the value read into kind and stops
    func parse_paint [ t: string ]
        offs = vec f32 []
        cols = vec f32 []
        kind = 0
        if [ !t || t.count == 0 ] return
        if [ t.index_of[ '|' ] < 0 ]
            nums : nums_of[ t ]
            if [ nums.count < 3 ] return
            offs.push[ 0.0 ]
            for [ k: i32 0, k < 3, k += 1 ]
                cols.push[ nums[ k ] ]
            cols.push[ (nums.count > 3) ? nums[ 3 ] : 1.0 ]
            return
        parts : t.split[ '|' ]
        word : parts[ 0 ].trim[]
        kind = 1
        if [ word.compare[ 'radial' ] == 0 ] kind = 2
        for [ k: i32 1, k < parts.count, k += 1 ]
            p : parts[ k ]
            ci : i32 [ p.index_of[ ':' ] ]
            if [ ci <= 0 ] continue
            head : p.mid[ 0, ci ].trim[]
            nums : nums_of[ p.mid[ ci + 1, p.count - ci - 1 ] ]
            if [ nums.count < 3 ] continue
            offs.push[ f32[ head.real_value[] ] ]
            for [ j: i32 0, j < 3, j += 1 ]
                cols.push[ nums[ j ] ]
            cols.push[ (nums.count > 3) ? nums[ 3 ] : 1.0 ]

    # stop i's colour as 'r, g, b, a'
    func num4 [ i: i32 ] -> string
        if [ i < 0 || i * 4 + 3 >= cols.count ] return ''
        r : num_text[ cols[ i * 4 ], false ]
        g : num_text[ cols[ i * 4 + 1 ], false ]
        b : num_text[ cols[ i * 4 + 2 ], false ]
        al : num_text[ cols[ i * 4 + 3 ], false ]
        return '{r}, {g}, {b}, {al}'

    # kind and stops as the value
    func paint_text [] -> string
        if [ !offs || offs.count == 0 ] return ''
        if [ kind == 0 ] return num4[ 0 ]
        words : vec string [] [ 'solid', 'linear', 'radial' ]
        out : words[ kind ]
        for [ i: i32 0, i < offs.count, i += 1 ]
            ot : num_text[ offs[ i ], false ]
            out = '{out} | {ot}: {num4[ i ]}'
        return out

    # the value set from kind and stops
    func store []
        edit     = paint_text[]
        read_of  = null
        pristine = false

    # the chosen stop's colour set ('r, g, b, a'); none yet: one
    func set_current [ t: string ]
        nums : nums_of[ t ]
        if [ nums.count < 3 ] return
        if [ !offs || offs.count == 0 ]
            offs = vec f32 [] [ 0.0 ]
            cols = vec f32 [] [ 0.0, 0.0, 0.0, 1.0 ]
            kind = 0
            sel  = 0
        for [ k: i32 0, k < 4, k += 1 ]
            cols[ sel * 4 + k ] = (k < nums.count) ? nums[ k ] : 1.0
        store[]

    # a 0..1 number as a byte's two hex digits
    func hex2 [ v: f32 ] -> string
        n : i32 [ round[ clamp[ v, 0.0, 1.0 ] * 255.0 ] ]
        digits : '0123456789abcdef'
        hi : digits.mid[ n / 16, 1 ]
        lo : digits.mid[ n % 16, 1 ]
        return '{hi}{lo}'

    # linear numbers as #rrggbbaa ('' none yet)
    func hex_of [ t: string ] -> string
        nums : nums_of[ t ]
        if [ nums.count < 3 ] return ''
        al : f32 [ (nums.count > 3) ? nums[ 3 ] : 1.0 ]
        r : hex2[ to_srgb[ nums[ 0 ] ] ]
        g : hex2[ to_srgb[ nums[ 1 ] ] ]
        b : hex2[ to_srgb[ nums[ 2 ] ] ]
        return '#{r}{g}{b}{hex2[ al ]}'

    # a hex digit's value (-1 not one)
    func digit [ ch: string ] -> i32
        low : '0123456789abcdef'
        up  : '0123456789ABCDEF'
        i : i32 [ low.index_of[ ch ] ]
        if [ i < 0 ] i = up.index_of[ ch ]
        return i

    # #rgb, #rgba, #rrggbb or #rrggbbaa as linear numbers (''
    # when it is not one yet)
    func linear_of [ t: string ] -> string
        if [ !t ] return ''
        s : t.trim[]
        if [ s.starts_with[ '#' ] ] s = s.mid[ 1, s.count - 1 ]
        n : i32 [ s.count ]
        if [ n != 3 && n != 4 && n != 6 && n != 8 ] return ''
        wide : i32 [ (n > 4) ? 2 : 1 ]
        vals : vec f32 []
        for [ i: i32 0, i < n / wide, i += 1 ]
            hi : i32 [ digit[ s.mid[ i * wide, 1 ] ] ]
            lo : i32 [ (wide == 2) ? digit[ s.mid[ i * 2 + 1, 1 ] ]
                       : hi ]
            if [ hi < 0 || lo < 0 ] return ''
            vals.push[ f32[ hi * 16 + lo ] / 255.0 ]
        if [ vals.count == 3 ] vals.push[ 1.0 ]
        r : num_text[ pow[ vals[ 0 ], 2.2 ], false ]
        g : num_text[ pow[ vals[ 1 ], 2.2 ], false ]
        b : num_text[ pow[ vals[ 2 ], 2.2 ], false ]
        return '{r}, {g}, {b}, {num_text[ vals[ 3 ], false ]}'

    # the typed hex in: a whole one is the chosen colour at once;
    # not typing, the field shows the chosen colour
    func hex_sync []
        f : hex_field[]
        if [ !f ] return
        sync[]
        if [ f.focused ]
            got : linear_of[ f.edit ]
            if [ got.count > 0 && got.compare[ num4[ sel ] ] != 0 ]
                set_current[ got ]
            return
        want : hex_of[ num4[ sel ] ]
        if [ !f.edit || f.edit.compare[ want ] != 0 ]
            f.edit       = want
            f.sel_col    = want.count
            f.anchor_col = want.count
            f.pristine   = false

    # the value read: kind, stops, and the chosen stop's colour as
    # hue, saturation and value
    func sync []
        now : string [ (edit) ? edit : '' ]
        if [ read_of && read_of.compare[ now ] == 0 ] return
        read_of = now
        parse_paint[ now ]
        if [ sel >= offs.count ] sel = 0
        if [ offs.count == 0 ] return
        r : f32 [ to_srgb[ cols[ sel * 4 ] ] ]
        g : f32 [ to_srgb[ cols[ sel * 4 + 1 ] ] ]
        b : f32 [ to_srgb[ cols[ sel * 4 + 2 ] ] ]
        alpha = cols[ sel * 4 + 3 ]
        hi : f32 [ max[ r, max[ g, b ] ] ]
        lo : f32 [ min[ r, min[ g, b ] ] ]
        val = hi
        sat = (hi > 0.0) ? (hi - lo) / hi : 0.0
        if [ hi - lo <= 0.00001 ] return
        h : f32 [ 0.0 ]
        if [ hi == r ] h = (g - b) / (hi - lo)
        el [ hi == g ] h = 2.0 + (b - r) / (hi - lo)
        el h = 4.0 + (r - g) / (hi - lo)
        h = h / 6.0
        if [ h < 0.0 ] h += 1.0
        hue = h

    func to_srgb [ c: f32 ] -> f32
        return pow[ clamp[ c, 0.0, 1.0 ], 1.0 / 2.2 ]

    # hue, saturation and value as display red, green, blue
    func shown [ h: f32, sv: f32, vv: f32 ] -> rgba
        k : f32 [ (h - floor[ h ]) * 6.0 ]
        r : f32 [ clamp[ abs[ k - 3.0 ] - 1.0, 0.0, 1.0 ] ]
        g : f32 [ clamp[ 2.0 - abs[ k - 2.0 ], 0.0, 1.0 ] ]
        b : f32 [ clamp[ 2.0 - abs[ k - 4.0 ], 0.0, 1.0 ] ]
        return rgba [ r: vv * (1.0 - sv + sv * r),
                      g: vv * (1.0 - sv + sv * g),
                      b: vv * (1.0 - sv + sv * b), a: 1.0 ]

    # the picked colour into the chosen stop (linear numbers)
    func put []
        c : shown[ hue, sat, val ]
        r : num_text[ pow[ c.r, 2.2 ], false ]
        g : num_text[ pow[ c.g, 2.2 ], false ]
        b : num_text[ pow[ c.b, 2.2 ], false ]
        set_current[ '{r}, {g}, {b}, {num_text[ alpha, false ]}' ]
        read_of = edit

    # a kind chosen: solid keeps the chosen stop's colour; a
    # gradient from a colour fades it to clear
    func set_kind [ n: i32 ]
        if [ !offs || offs.count == 0 ]
            offs = vec f32 [] [ 0.0 ]
            cols = vec f32 [] [ 0.0, 0.0, 0.0, 1.0 ]
            sel  = 0
        if [ n == 0 ]
            keep : vec f32 []
            for [ k: i32 0, k < 4, k += 1 ]
                keep.push[ cols[ sel * 4 + k ] ]
            offs = vec f32 [] [ 0.0 ]
            cols = keep
            sel  = 0
        el [ kind == 0 ]
            offs = vec f32 [] [ 0.0, 1.0 ]
            cols = vec f32 [] [ cols[ 0 ], cols[ 1 ], cols[ 2 ],
                                cols[ 3 ], cols[ 0 ], cols[ 1 ],
                                cols[ 2 ], 0.0 ]
            sel = 0
        kind = n
        store[]

    # the press's button (a kind or clear): true when it was one
    func button_hit [ ev: Event ] -> bool
        o : ev.origin
        if [ !o || !o.id ] return false
        if [ o.id == 'clear' ]
            edit     = ''
            read_of  = null
            pristine = false
            f : hex_field[]
            if [ f ]
                f.edit     = ''
                f.typing   = false
                f.pristine = false
        el [ o.id == 'k_solid' ]
            set_kind[ 0 ]
        el [ o.id == 'k_linear' ]
            set_kind[ 1 ]
        el [ o.id == 'k_radial' ]
            set_kind[ 2 ]
        el
            return false
        ev.no_propagation = true
        return true

    # the strip's colour at f (linear r g b a)
    func sample [ f: f32 ] -> vec f32
        n : i32 [ offs.count ]
        out : vec f32 []
        lo : i32 [ 0 ]
        while [ lo + 1 < n && offs[ lo + 1 ] <= f ]
            lo += 1
        hi : i32 [ (lo + 1 < n) ? lo + 1 : lo ]
        span : f32 [ offs[ hi ] - offs[ lo ] ]
        t : f32 [ (span > 1e-6) ? clamp[ (f - offs[ lo ]) / span,
                                          0.0, 1.0 ] : 0.0 ]
        for [ k: i32 0, k < 4, k += 1 ]
            out.push[ cols[ lo * 4 + k ]
                      + (cols[ hi * 4 + k ] - cols[ lo * 4 + k ]) * t ]
        return out

    # stops i and j swapped (offsets and colours)
    func swap_stops [ i: i32, j: i32 ]
        o : f32 [ offs[ i ] ]
        offs[ i ] = offs[ j ]
        offs[ j ] = o
        for [ k: i32 0, k < 4, k += 1 ]
            c : f32 [ cols[ i * 4 + k ] ]
            cols[ i * 4 + k ] = cols[ j * 4 + k ]
            cols[ j * 4 + k ] = c

    # the strip's x as a gradient's 0..1
    func strip_at [ x: f32 ] -> f32
        return clamp[ (x - 4.0) / max[ bounds.w - 8.0, 1.0 ], 0.0, 1.0 ]

    # a press on the strip: a stop chosen (near one) or put in
    func strip_press [ x: f32 ]
        fr : f32 [ strip_at[ x ] ]
        wd : f32 [ bounds.w - 8.0 ]
        hit_at : i32 [ -1 ]
        for [ i: i32 0, i < offs.count, i += 1 ]
            if [ abs[ offs[ i ] * wd - fr * wd ] < 6.0 ] hit_at = i
        if [ hit_at < 0 ]
            c : sample[ fr ]
            at : i32 [ 0 ]
            while [ at < offs.count && offs[ at ] <= fr ]
                at += 1
            offs.insert[ fr, at ]
            for [ k: i32 0, k < 4, k += 1 ]
                cols.insert[ c[ k ], at * 4 + k ]
            hit_at = at
        sel = hit_at
        store[]

    # the chosen stop moved to x (kept in order), or marked to go
    # when dragged well off the strip
    func strip_move [ x: f32, y: f32 ]
        offs[ sel ] = strip_at[ x ]
        while [ sel > 0 && offs[ sel ] < offs[ sel - 1 ] ]
            swap_stops[ sel, sel - 1 ]
            sel -= 1
        while [ sel + 1 < offs.count && offs[ sel ] > offs[ sel + 1 ] ]
            swap_stops[ sel, sel + 1 ]
            sel += 1
        far : bool [ y > 4.0 + strip_h[] + 28.0 || y < -24.0 ]
        dropping = far && offs.count > 2
        store[]

    func pick [ x: f32, y: f32 ]
        bx : f32 [ box[] ]
        ty : f32 [ top_y[] ]
        if [ held == 1 ]
            sat = clamp[ (x - 4.0) / bx, 0.0, 1.0 ]
            val = clamp[ 1.0 - (y - ty) / bx, 0.0, 1.0 ]
        if [ held == 2 ]
            hue = clamp[ (y - ty) / bx, 0.0, 0.999 ]
        if [ held == 3 ]
            alpha = clamp[ 1.0 - (y - ty) / bx, 0.0, 1.0 ]
        put[]

    public func on_press [ ev: Event ]
        if [ ev.mouse.button != 0 || button_hit[ ev ] ] return
        sync[]
        bx : f32 [ box[] ]
        x : f32 [ ev.mouse.pos.x ]
        y : f32 [ ev.mouse.pos.y ]
        held = 0
        # the strip: a gradient's stops
        if [ y < top_y[] - 2.0 ]
            if [ kind == 0 || offs.count == 0 ] return
            strip_press[ x ]
            held = 4
        el [ x < 4.0 + bx ] held = 1
        el [ x < alpha_x[] - 3.0 ] held = 2
        el [ x < swatch_x[] - 3.0 ] held = 3
        if [ held == 0 ] return
        ux.set_capture[ a ]
        if [ held != 4 ] pick[ x, y ]
        ev.no_default     = true
        ev.no_propagation = true

    public func on_move [ ev: Event ]
        if [ held == 0 ] return
        if [ held == 4 ]
            strip_move[ ev.mouse.pos.x, ev.mouse.pos.y ]
        el
            pick[ ev.mouse.pos.x, ev.mouse.pos.y ]
        ev.no_propagation = true

    public func on_release [ ev: Event ]
        if [ held == 0 ] return
        # a stop dragged off goes (two always stay)
        if [ held == 4 && dropping && offs.count > 2 ]
            offs.remove[ sel ]
            for [ k: i32 0, k < 4, k += 1 ]
                cols.remove[ sel * 4 ]
            sel = max[ sel - 1, 0 ]
            store[]
        dropping = false
        held = 0
        ux.release_capture[ a ]

    # a display colour and alpha as a stop (0xAABBGGRR)
    func packed_a [ c: rgba, al: f32 ] -> u32
        r : u32 [ u32[ clamp[ c.r, 0.0, 1.0 ] * 255.0 ] ]
        g : u32 [ u32[ clamp[ c.g, 0.0, 1.0 ] * 255.0 ] ]
        b : u32 [ u32[ clamp[ c.b, 0.0, 1.0 ] * 255.0 ] ]
        av : u32 [ u32[ clamp[ al, 0.0, 1.0 ] * 255.0 ] ]
        return (av << 24) | (b << 16) | (g << 8) | r

    func packed [ c: rgba ] -> u32
        return packed_a[ c, 1.0 ]

    # stop i in display colours
    func stop_rgba [ i: i32 ] -> rgba
        return rgba [ r: to_srgb[ cols[ i * 4 ] ],
                      g: to_srgb[ cols[ i * 4 + 1 ] ],
                      b: to_srgb[ cols[ i * 4 + 2 ] ],
                      a: cols[ i * 4 + 3 ] ]

    # light and dark squares, 4 px, under what is see-through
    func checker [ cv: Canvas, x: f32, y: f32, w: f32, h: f32 ]
        cv.clear_fill_gradient[]
        cv.stroke_width[ 0.0 ]
        cv.fill_color[ rgba [ '#9a9aa2' ] ]
        cv.rect_to[ x, y, w, h ]
        cv.paint[]
        cv.fill_color[ rgba [ '#5c5c64' ] ]
        rows : i32 [ i32[ ceil[ h / 4.0 ] ] ]
        cols_n : i32 [ i32[ ceil[ w / 4.0 ] ] ]
        for [ j: i32 0, j < rows, j += 1 ]
            for [ i: i32 0, i < cols_n, i += 1 ]
                if [ (i + j) % 2 == 0 ] continue
                cx : f32 [ x + f32[ i ] * 4.0 ]
                cy : f32 [ y + f32[ j ] * 4.0 ]
                cv.rect_to[ cx, cy, min[ 4.0, x + w - cx ],
                            min[ 4.0, y + h - cy ] ]
                cv.paint[]

    # the preview across the top: the colour, or the gradient
    # left to right with its stops marked under it
    # a 1 px white outline round the strip, on half pixels so it
    # covers one pixel row, not two
    func strip_outline [ cv: Canvas, x: f32, y: f32, wd: f32,
                         ht: f32 ]
        x0 : f32 [ floor[ x ] + 0.5 ]
        y0 : f32 [ floor[ y ] + 0.5 ]
        x1 : f32 [ floor[ x + wd ] - 0.5 ]
        y1 : f32 [ floor[ y + ht ] - 0.5 ]
        cv.fill_color[ rgba [ '#0000' ] ]
        cv.stroke_color[ rgba [ '#ffffff' ] ]
        cv.stroke_width[ 1.0 ]
        cv.rect_to[ x0, y0, x1 - x0, y1 - y0 ]
        cv.paint[]
        cv.stroke_width[ 0.0 ]

    func draw_strip [ cv: Canvas ]
        sx : f32 [ 4.0 ]
        sy : f32 [ 4.0 ]
        wd : f32 [ bounds.w - 8.0 ]
        ht : f32 [ strip_h[] ]
        if [ offs.count == 0 ]
            cv.stroke_width[ 1.0 ]
            cv.stroke_color[ rgba [ '#fff6' ] ]
            cv.fill_color[ rgba [ '#0000' ] ]
            cv.rounded_rect[ sx, sy, wd, ht, 3.0, 3.0, 3.0, 3.0 ]
            cv.paint[]
            # no colour: a diagonal across the box
            cv.stroke_color[ rgba [ '#ff5a5a' ] ]
            cv.stroke_width[ 1.5 ]
            cv.move_to[ sx + 3.0, sy + ht - 3.0 ]
            cv.line_to[ sx + wd - 3.0, sy + 3.0 ]
            cv.paint[]
            cv.stroke_width[ 0.0 ]
            return
        checker[ cv, sx, sy, wd, ht ]
        if [ kind == 0 ]
            sw : stop_rgba[ 0 ]
            cv.fill_color[ sw ]
            cv.rect_to[ sx, sy, wd, ht ]
            cv.paint[]
            strip_outline[ cv, sx, sy, wd, ht ]
            return
        gg : linear_gradient[ sx, 0.0, sx + wd, 0.0 ]
        for [ i: i32 0, i < offs.count, i += 1 ]
            sc : stop_rgba[ i ]
            gg.add_stop[ offs[ i ], packed_a[ sc, sc.a ] ]
        cv.set_fill_gradient[ gg ]
        cv.rect_to[ sx, sy, wd, ht ]
        cv.paint[]
        cv.clear_fill_gradient[]
        strip_outline[ cv, sx, sy, wd, ht ]
        # the stops: a little house each on the strip's foot, its
        # peak up at its place; on the pixel grid, so a 1 px
        # outline sits on half pixels and a 2 px one on whole
        for [ i: i32 0, i < offs.count, i += 1 ]
            mx : f32 [ sx + offs[ i ] * wd ]
            lit : bool [ i == sel ]
            half : f32 [ (lit) ? 0.0 : 0.5 ]
            cx : f32 [ floor[ mx ] + half ]
            yb : f32 [ floor[ sy + ht ] - 1.0 + half ]
            mc : stop_rgba[ i ]
            mc.a = 1.0
            cv.fill_color[ mc ]
            cv.stroke_color[ rgba [ (lit) ? '#ffcf4a' : '#ffffff' ] ]
            cv.stroke_width[ (lit) ? 2.0 : 1.0 ]
            if [ lit && dropping ] cv.set_opacity[ 0.35 ]
            cv.move_to[ cx - 4.0, yb ]
            cv.line_to[ cx + 4.0, yb ]
            cv.line_to[ cx + 4.0, yb - 6.0 ]
            cv.line_to[ cx, yb - 10.0 ]
            cv.line_to[ cx - 4.0, yb - 6.0 ]
            cv.close_path[]
            cv.paint[]
            cv.set_opacity[ 1.0 ]
        cv.stroke_width[ 0.0 ]

    # the kind lit on its buttons
    func light_kinds []
        if [ !paint || !elements ] return
        if [ elements.contains[ 'kinds' ] ]
            k1 : elements[ 'kinds' ] inherits TButtons
            want : i32 [ 1 << kind ]
            if [ k1 && k1.sel_mask != want ]
                k1.sel_mask = want
                k1.pristine = false

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || bounds.w <= 0.0 ]
            return
        hex_sync[]
        sync[]
        light_kinds[]
        cv : Canvas [ w.screen ]
        bx : f32 [ box[] ]
        ty : f32 [ top_y[] ]
        cv.save[]
        cv.stroke_width[ 0.0 ]
        draw_strip[ cv ]
        # the square: the hue, white from the left, black from below
        cv.fill_color[ shown[ hue, 1.0, 1.0 ] ]
        cv.rect_to[ 4.0, ty, bx, bx ]
        cv.paint[]
        wg : linear_gradient[ 4.0, 0.0, 4.0 + bx, 0.0 ]
        wg.add_stop[ 0.0, 0xffffffff ]
        wg.add_stop[ 1.0, 0x00ffffff ]
        cv.set_fill_gradient[ wg ]
        cv.rect_to[ 4.0, ty, bx, bx ]
        cv.paint[]
        bg : linear_gradient[ 0.0, ty, 0.0, ty + bx ]
        bg.add_stop[ 0.0, 0x00000000 ]
        bg.add_stop[ 1.0, 0xff000000 ]
        cv.set_fill_gradient[ bg ]
        cv.rect_to[ 4.0, ty, bx, bx ]
        cv.paint[]
        # the hue bar, top to bottom
        hx : f32 [ hue_x[] ]
        hg : linear_gradient[ 0.0, ty, 0.0, ty + bx ]
        for [ i: i32 0, i <= 6, i += 1 ]
            t : f32 [ f32[ i ] / 6.0 ]
            hg.add_stop[ t, packed[ shown[ t, 1.0, 1.0 ] ] ]
        cv.set_fill_gradient[ hg ]
        cv.rect_to[ hx, ty, 10.0, bx ]
        cv.paint[]
        # the alpha bar: the colour to clear, over squares
        ax : f32 [ alpha_x[] ]
        checker[ cv, ax, ty, 10.0, bx ]
        c : shown[ hue, sat, val ]
        ag : linear_gradient[ 0.0, ty, 0.0, ty + bx ]
        ag.add_stop[ 0.0, packed[ c ] ]
        ag.add_stop[ 1.0, 0x00000000 ]
        cv.set_fill_gradient[ ag ]
        cv.rect_to[ ax, ty, 10.0, bx ]
        cv.paint[]
        cv.clear_fill_gradient[]
        # where the chosen colour sits on each
        if [ offs.count > 0 ]
            cv.stroke_width[ 1.5 ]
            cv.stroke_color[ rgba [ '#fff' ] ]
            cv.fill_color[ rgba [ '#0000' ] ]
            mx : f32 [ 4.0 + sat * bx ]
            my : f32 [ ty + (1.0 - val) * bx ]
            cv.rounded_rect[ mx - 4.0, my - 4.0, 8.0, 8.0, 4.0, 4.0,
                             4.0, 4.0 ]
            cv.paint[]
            cv.rect_to[ hx - 2.0, ty + hue * bx - 1.5, 14.0, 3.0 ]
            cv.paint[]
            cv.rect_to[ ax - 2.0, ty + (1.0 - alpha) * bx - 1.5,
                        14.0, 3.0 ]
            cv.paint[]
        cv.stroke_width[ 0.0 ]
        cv.restore[]

# a '#rrggbb' hex edits as text; the color itself sits as a swatch at
# the right
ArgsField LaunchColor
    name : Layer [ label_color: rgba [ '#c9c4dd' ], label_size: 16,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
        label_align: vec2f [ x: 0.0, y: 0.5 ] ]
    face : Layer [ label_color: rgba [ '#fff6' ], label_size: 17,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
                   editable: true,
        label_align: vec2f [ x: 0.0, y: 0.5 ] ]
    style : CSS {
        layers.body:
            fill_color: #0000
            radius: 0
            stroke_width: 0
        :focused
            layers.body:
                fill_color: #2f6b4a40
    }
    func init []
        name.area = Region [ 'l0.4 t0 w0 b0' ]
        face.area = Region [ 'l0.4 t0 r30px b0' ]
    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || bounds.w <= 0.0 ]
            return
        hx : string edit
        if [ !hx || !hx.starts_with[ '#' ] || !(hx.count == 7 || hx.count == 9) ]
            return
        cv : Canvas [ w.screen ]
        cv.stroke_width[ 0.0 ]
        cv.fill_color[ rgba [ hx ] ]
        cv.rect_to[ bounds.w - 26.0, 4.0, 20.0, bounds.h - 8.0 ]
        cv.paint[]

VolumeSlider LaunchSlider
    name : Layer [ label_color: rgba [ '#c9c4dd' ], label_size: 16,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
        label_align: vec2f [ x: 0.0, y: 0.5 ] ]
    func init []
        pad_l = 12.0
        pad_r = 12.0
        nw : f32 [ launch_name_w[ label ] ]
        name.area = Region [ 'l0.4 t0 w{nw} b0' ]
    # the panel's changing property is this one while it is held; the id
    # is 'lp_<name>'
    func prop_name [] -> string
        return (id && id.count > 3) ? id.mid[ 3, id.count - 3 ] : ''
    public func on_press [ ev: Event ]
        if [ parent && parent inherits LaunchPanel ]
            lp : LaunchPanel parent
            lp.changing = prop_name[]
        super.on_press[ ev ]
    public func on_release [ ev: Event ]
        if [ parent && parent inherits LaunchPanel ]
            lp : LaunchPanel parent
            if [ lp.changing && lp.changing == prop_name[] ]
                lp.changing = ''
        super.on_release[ ev ]

element LaunchLabel
    face : Layer [ label_color: rgba [ '#c9c4dd' ], label_size: 17,
        label_font: 'fonts/BarlowCondensed-Regular.ttf',
        label_align: vec2f [ x: 0.0, y: 0.5 ] ]

element LaunchPanel
    # the ground under the rows only, never the space below (render
    # sizes it)
    body : Layer [ fill_color: rgba [ '#0f122088' ] ]
    # the standard scrollbar: the rows scroll when the section is
    # shorter than they are
    scrollbar : ScrollLayer [ overlay: true,
                              area: Region { l0 t0 r0 b0 },
        thumb_color: '#fff3', thumb_w: 6.0, thumb_min_h: 32.0,
        thumb_radius: 4.0 ]
    # the instance's props, agi (trinity Props)
    public spec : string
    public args : string        # the file's current run args
    # the property the user is engaged with (one at a time): a value
    # received for it is not applied while it is set
    public changing : string 
    # content_h is the element's own: a redeclaration here would be a
    # SECOND member, and trinity's scroll, crop and scrollbar read the
    # base one
    mutable rows_h    : f32
    mutable col_x     : f32
    # the bottom of every row: rows are not all one height
    mutable rule_ys   : vec f32
    # the instance shown; a change re-seeds every control
    public  inst      : i32
    # the spec's defaults are the running instance's own values
    public  live_vals : bool
    # the instance's own rows above its properties (coverage, pid)
    public  dbg_row   : bool
    public  cov_on    : bool        # a coverage build on its next start
    # the running process, shown read-only; 0 = none
    public  pid_val   : i32
    # the scene's props: a change goes to the live scene, no instance
    public  scene     : bool
    mutable last_spec : string
    mutable last_inst : i32

    # --name's value in args, else the default
    func arg_value [ name: string, deflt: string ] -> string
        if [ !args ] return deflt
        parts : args.split[ ' ' ]
        for [ i: i32 0, i + 1 < parts.count, i += 1 ]
            if [ parts[ i ] == '--{name}' ] return parts[ i + 1 ]
        return deflt

    # the positional arg (a resource): the token that is neither a
    # --flag nor a flag's value. compose writes it bare, so arg_value
    # can't see it
    func arg_positional [] -> string
        if [ !args ] return ''
        parts : args.split[ ' ' ]
        i : i32 [ 0 ]
        while [ i < parts.count ]
            p : string parts[ i ]
            if [ p.starts_with[ '--' ] ]
                i += 2
            el
                return p
        return ''

    public  fields     : LaunchProps
    mutable fields_src : string
    # the name column's share of the width (last: orbiter's
    # build reads the members before it where they were)
    public  name_frac  : f32 [ 0.266 ]
    # rows that span both cells: top, height each
    mutable spans      : vec f32
    # a value held back from the field being changed
    mutable owed       : string
    # a vector cell's dividers: x, top and height each
    mutable cuts       : vec f32

    # the spec parsed once per change: every row reads a Prop
    func parse_fields []
        if [ fields && fields_src && spec && fields_src.compare[ spec ] == 0 ]
            return
        fields_src = spec
        fields     = LaunchProps []
        if [ spec && spec.count > 0 ]
            Au.parse_agi[ null, spec.chars, fields ]
        if [ !fields.props ] fields.props = vec Prop []
        # the display is the instance panel's own bar, never a row
        kept : vec Prop []
        for [ p: Prop ] in fields.props
            if [ p.ident != 'display' ] kept.push[ p ]
        fields.props = kept

    # another module's prop (trinity's display) is flagged with its
    # module: --trinity.display never clashes with the app's own name
    func flag_name [ p: Prop ] -> string
        if [ p.module && fields.module && p.module != fields.module ]
            return '{p.module}.{p.ident}'
        return p.ident

    func prop_of [ nm: string ] -> Prop
        parse_fields[]
        for [ p: Prop ] in fields.props
            if [ p.ident == nm ] return p
        return null

    func has_meta [ p: Prop, m: string ] -> bool
        if [ !p.meta ] return false
        for [ q: string ] in p.meta
            if [ q == m ] return true
        return false

    # the control's trinity base by name; a control with no members
    # arrives as its bare type name
    func ctl [ p: Prop ] -> string
        if [ !p.control ] return ''
        if [ p.control inherits string ]    return '{p.control}'
        if [ p.control inherits Range ]     return 'Range'
        if [ p.control inherits Stepper ]   return 'Stepper'
        if [ p.control inherits KeyBind ]   return 'KeyBind'
        if [ p.control inherits Color ]     return 'Color'
        if [ p.control inherits PadBind ]   return 'PadBind'
        if [ p.control inherits Directory ] return 'Directory'
        if [ p.control inherits Multiline ] return 'Multiline'
        return ''

    func prop_live [ p: Prop ] -> bool
        return p.type == 'func' || has_meta[ p, 'Live' ] || has_meta[ p,
                                                                      'Action' ]

    # a vector's parts: vec2f 2, vec3f 3, vec4f 4, else 0
    func vec_n [ ty: string ] -> i32
        if [ ty == 'vec2f' ] return 2
        if [ ty == 'vec3f' ] return 3
        if [ ty == 'vec4f' ] return 4
        return 0

    func has_stops [ p: Prop ] -> bool
        return (p.stops && p.stops.count > 0) ? true : false

    # a resource or a default member is the bare positional argument
    func prop_pos [ p: Prop ] -> bool
        return p.type == 'resource' || p.access == 'default'

    func range_of [ p: Prop ] -> vec2f
        if [ p.control && p.control inherits Range ]
            rg : Range p.control
            if [ rg.max > rg.min ] return vec2f [ rg.min, rg.max ]
        return vec2f [ 0.0, 1.0 ]

    func stepper_of [ p: Prop ] -> vec f32
        out : vec f32 [] [ 0.0, 100.0, 1.0 ]
        if [ p.control && p.control inherits Stepper ]
            sp : Stepper p.control
            out[ 0 ] = sp.min
            out[ 1 ] = sp.max
            out[ 2 ] = (sp.step > 0.0) ? sp.step : 1.0
        return out

    # the stop named cur, else the value's, else the first
    func enum_index [ p: Prop, cur: string ] -> i32
        if [ !p.stops ] return 0
        for [ i: i32 0, i < p.stops.count, i += 1 ]
            if [ p.stops[ i ] == cur ] return i
        for [ i: i32 0, i < p.stops.count, i += 1 ]
            if [ p.value && p.stops[ i ] == p.value ] return i
        return 0

    # a mounted text field keeps its own text (trinity never copies
    # edit): a reseed sets it, unless the user is in it
    func reseed_text [ nm: string, cur: string ]
        if [ !elements || !elements.contains[ 'lp_{nm}' ] ] return
        f : element elements[ 'lp_{nm}' ]
        if [ f.focused ] return
        if [ f inherits DragField ]
            df : DragField f
            if [ df.held ] return
        if [ f inherits ColorPick ]
            cp : ColorPick f
            if [ cp.held != 0 ] return
        # held back while it changes; given once it is let go
        if [ changing && changing == nm ]
            owed = nm
            return
        if [ owed && owed == nm ] owed = ''
        if [ f.edit && f.edit.compare[ cur ] == 0 ] return
        f.edit       = cur
        f.sel_col    = cur.count
        f.anchor_col = cur.count
        f.pristine   = false

    # a field view: one property per row, the name at the left, the
    # value filling the rest
    func render [] -> Elements
        t : Elements []
        # a grid like the callstack's: 20px rows, a name column, 1px
        # rules between
        pw : f32 [ (bounds && bounds.w > 0.0) ? bounds.w : 280.0 ]
        lw : f32 [ round[ pw * name_frac ] ]
        # 15% taller than the callstack's 24 px
        rh : f32 [ 27.6 * ux_unit[ ux ] ]
        # the value column's button, 48 px at rest
        vw : f32 [ 48.0 * ux_unit[ ux ] ]
        # px rows do not follow the element's scroll on their own: the
        # offset goes into their areas, and the same offset serves the
        # hit test
        vh9 : f32 [ (bounds) ? bounds.h : 0.0 ]
        if [ vh9 > 0.0 && scroll.y > content_h - vh9 ]
            scroll.y = (content_h > vh9) ? content_h - vh9 : 0.0
        if [ scroll.y < 0.0 ] scroll.y = 0.0
        y  : f32 [ 0.0 - scroll.y ]
        # another instance, or a new spec: every control takes its value
        # again
        reseed : bool [
            inst != last_inst || !last_spec
            || last_spec.compare[ spec ] != 0 ]
        last_inst = inst
        last_spec = spec
        rule_ys   = vec f32 []
        cuts      = vec f32 []
        spans     = vec f32 []
        # no export: not compiling, so none of our rows either
        parse_fields[]
        runs : bool [ dbg_row && fields.props.count > 0 ]
        # coverage: its build switch, and clear for the one map
        if [ runs ]
            t['lp_coverage_lbl'] = LaunchLabel [ label: 'coverage',
                                                 area: Region [
                                                     'l6px t{y}px w{lw - 6.0}px h{rh}px' ] ]
            t['lp_coverage'] = LaunchCheck [ label: '',
                                             selected: cov_on,
                area: Region [
                    'l{lw + 1.0}px t{y}px w{rh}px h{rh}px' ] ]
            t['lp_coverage_clear'] = LaunchClear [ label: 'clear',
                                                   manual_mode: true,
                area: Region [ 'r0 t{y}px w{vw}px h{rh}px' ] ]
            y += rh
            rule_ys.push[ y ]
        # the instance's pid: orbiter's row, read-only, given every
        # frame
        if [ runs ]
            t['lp_pid_lbl'] = LaunchLabel [ label: 'pid',
                                            area: Region [
                                                'l6px t{y}px w{lw - 6.0}px h{rh}px' ] ]
            t['lp_pid_val'] = LaunchLabel [
                label: (pid_val > 0) ? '{pid_val}' : '-',
                area: Region [ 'l{lw + 7.0}px t{y}px r0 h{rh}px' ] ]
            y += rh
            rule_ys.push[ y ]
        if [ fields.props.count == 0 ]
            # no export: the module has not compiled; rule stops here
            rows_h = y + scroll.y
            t['lp_none'] = LaunchLabel [
                label: 'no properties available',
                area: Region [ 'l6px t{y}px r0 h{rh}px' ] ]
            y += rh
            content_h = y + scroll.y
            col_x     = lw
            body.area = Region [ 'l0 t0 r0 h{i32[ y ]}px' ]
            return t
        for [ p: Prop ] in fields.props
            nm : string p.ident
            ty : string p.type
            df : string (p.value) ? p.value : ''
            # a shown instance reports its own values as the defaults:
            # those are what it holds now. with no instance the file's
            # args are the config
            cur : string (live_vals) ? df : ((prop_pos[ p ]) ? arg_positional[] : arg_value[ flag_name[ p ], df ])
            ck : string ctl[ p ]
            sl : bool [ ck == 'Range' ]
            en : bool [ has_stops[ p ] ]
            isp : bool [
                ty == 'path' || ty == 'resource' || ck == 'Directory' ]
            # a Text field is two rows tall; every other control is one
            rhx : f32 [ (ck == 'Multiline') ? rh * 2.0 : rh ]
            colour : bool [ ty == 'rgba' || ty == 'paint'
                            || ty == 'tint' ]
            if [ colour ] rhx = rh * 4.5
            cx : f32 [ lw + 1.0 ]
            # a colour spans both cells, its name in a band on top
            wide : bool [ colour ]
            lh : f32 [ (wide) ? 18.0 * ux_unit[ ux ] : rhx ]
            t['lp_{nm}_lbl'] = LaunchLabel [ label: nm,
                                             area: Region [
                                                 'l6px t{y}px w{lw - 6.0}px h{lh}px' ] ]
            if [ wide ]
                spans.push[ y ]
                spans.push[ rhx ]
            # the panel rebuilds every frame. a control's value is given
            # ONCE, when it first mounts; after that the mounted control
            # owns it — a pick, a keystroke or a drag must never be
            # stamped over by the stored args a reseed (the instance
            # reported its values, so the spec changed) never touches
            # the one property the user is changing: its echo arriving
            # mid-drag would set the slider under them
            ex : element (elements && (!reseed || (changing && changing == nm))) ? elements['lp_{nm}'] : null
            vn : i32 [ vec_n[ ty ] ]
            vals : cur.split[ ',' ]
            if [ (reseed || (owed && owed == nm)) && vn == 0 ]
                reseed_text[ nm, cur ]
            ar9 : Region [ 'l{cx}px t{y}px r0 h{rhx}px' ]
            if [ vn > 0 ]
                # one cell, a dragged number a part
                cw : f32 [ (pw - cx) / vn ]
                for [ i: i32 0, i < vn, i += 1 ]
                    pt : string [
                        (i < vals.count) ? vals[ i ].trim[] : '0' ]
                    pn : string '{nm}_{i}'
                    if [ reseed ] reseed_text[ pn, pt ]
                    mounted : bool [ elements
                        && elements.contains[ 'lp_{pn}' ]
                        && (!reseed || changing == nm) ]
                    pa : Region [
                        'l{cx + cw * i}px t{y}px w{cw}px h{rhx}px' ]
                    if [ mounted ]
                        t['lp_{pn}'] = DragField [ label: '',
                                                   part: true,
                                                   focusable: true,
                                                   area: pa ]
                    el
                        t['lp_{pn}'] = DragField [ label: '', edit: pt,
                                                   part: true,
                                                   sel_col: pt.count,
                                                   anchor_col: pt.count,
                            focusable: true, area: pa ]
                    if [ i > 0 ]
                        cuts.push[ cx + cw * i ]
                        cuts.push[ y ]
                        cuts.push[ rhx ]
            el [ ty == 'func' ]
                t['lp_{nm}'] = LaunchAction [ label: nm,
                                              manual_mode: true,
                                              area: ar9 ]
            el [ ty == 'bool' ]
                ck9 : Region [ 'l{cx}px t{y}px w{rh}px h{rh}px' ]
                if [ ex ]
                    t['lp_{nm}'] = LaunchCheck [ label: '', area: ck9 ]
                el
                    t['lp_{nm}'] = LaunchCheck [ label: '',
                                                 selected: cur == 'true',
                                                 area: ck9 ]
            el [ isp ]
                # a path is picked from the nav list: a button, not an
                # editable field
                pv : string cur
                if [ ex && ex inherits LaunchPath ]
                    lpx : LaunchPath ex
                    # mounted, it owns its value: a clear stays empty
                    pv = (lpx.path_value) ? lpx.path_value : ''
                dsp : string pv
                if [ pv.count > 0 ]
                    pp : path pv
                    dsp = pp.filename[]
                ap : Region [ 'l{cx}px t{y}px r{vw}px h{rhx}px' ]
                t['lp_{nm}'] = LaunchPath [ label: dsp, edit: pv,
                                            path_value: pv,
                                            manual_mode: true,
                    is_resource: ty == 'resource',
                    is_dir: ck == 'Directory', area: ap ]
                t['lp_{nm}_clear'] = LaunchClear [ label: 'clear',
                                                   manual_mode: true,
                    area: Region [ 'r0 t{y}px w{vw}px h{rhx}px' ] ]
            el [ ck == 'KeyBind' ]
                # the mounted field sets its own label; the rebuild
                # echoes it back unchanged, since a changed or missing
                # label drops the focus
                if [ ex && ex inherits KeyField ]
                    kfx : KeyField ex
                    t['lp_{nm}'] = KeyField [ label: kfx.label,
                                              code: kfx.code,
                                              manual_mode: true,
                                              area: ar9 ]
                el
                    kc : i32 [ cur.integer_value[] ]
                    t['lp_{nm}'] = KeyField [ label: key_name[ kc ],
                                              code: kc,
                                              manual_mode: true,
                                              area: ar9 ]
            el [ ck == 'PadBind' ]
                if [ ex && ex inherits PadField ]
                    pfx : PadField ex
                    t['lp_{nm}'] = PadField [ label: pfx.label,
                                              code: pfx.code,
                                              manual_mode: true,
                                              area: ar9 ]
                el
                    pc9 : i32 [ cur.integer_value[] ]
                    t['lp_{nm}'] = PadField [ label: pad_name[ pc9 ],
                                              code: pc9,
                                              manual_mode: true,
                                              area: ar9 ]
            el [ ck == 'Stepper' ]
                if [ ex ]
                    t['lp_{nm}'] = StepField [ area: ar9 ]
                el
                    sr : vec f32 stepper_of[ p ]
                    t['lp_{nm}'] = StepField [ value: cur.real_value[],
                                               min: sr[ 0 ],
                                               max: sr[ 1 ],
                                               step: sr[ 2 ],
                        whole: !(ty == 'f32' || ty == 'f64'),
                        area: ar9 ]
            el [ ck == 'Color' ]
                if [ ex ]
                    t['lp_{nm}'] = LaunchColor [ label: '',
                                                 focusable: true,
                                                 area: ar9 ]
                el
                    t['lp_{nm}'] = LaunchColor [ label: '', edit: cur,
                                                 sel_col: cur.count,
                                                 anchor_col: cur.count,
                        focusable: true, area: ar9 ]
            el [ en ]
                names : p.stops
                if [ ex ]
                    t['lp_{nm}'] = TButtons [ buttons: names,
                                              icons: false,
                                              manual: false,
                                              seg_radius: 0.0,
                        label_px: rh * 0.5 - 2.0, area: ar9 ]
                el
                    idx9 : i32 [ enum_index[ p, cur ] ]
                    t['lp_{nm}'] = TButtons [ buttons: names,
                                              icons: false,
                                              manual: false,
                                              seg_radius: 0.0,
                        selected: idx9, label_px: rh * 0.5 - 2.0,
                        area: ar9 ]
            el [ sl ]
                if [ ex ]
                    t['lp_{nm}'] = LaunchSlider [ label: '', area: ar9 ]
                el
                    rg : vec2f [ range_of[ p ] ]
                    cv : f32 [ cur.real_value[] ]
                    fr : f32 [
                        (rg.y > rg.x) ? (cv - rg.x) / (rg.y - rg.x)
                        : 0.0 ]
                    t['lp_{nm}'] = LaunchSlider [ label: '', value: fr,
                                                  area: ar9 ]
            # a paint (an svg's fill) can be cleared to none
            el [ colour ]
                cl : bool [ ty == 'paint' || ty == 'tint' ]
                one : bool [ ty == 'tint' ]
                ar9 = Region [ 'l0 t{y + 18.0}px r0 h{rhx - 18.0}px' ]
                if [ ex ]
                    t['lp_{nm}'] = ColorPick [ paint: cl, solid: one,
                                               area: ar9 ]
                el
                    t['lp_{nm}'] = ColorPick [ edit: cur,
                        paint: cl, solid: one, area: ar9 ]
            # a unit (0..1, an opacity) drags with its bar
            el [ ck == '' && (ty == 'f32' || ty == 'f64'
                               || ty == 'i32' || ty == 'i64'
                               || ty == 'unit' || ty == 'percent') ]
                wh : bool [ ty == 'i32' || ty == 'i64' ]
                un : bool [ ty == 'unit' || ty == 'percent' ]
                tp : f32 [ (ty == 'percent') ? 100.0 : 1.0 ]
                if [ ex ]
                    t['lp_{nm}'] = DragField [ label: '', whole: wh,
                                               bar: un, top: tp,
                                               focusable: true,
                                               area: ar9 ]
                el
                    t['lp_{nm}'] = DragField [ label: '', edit: cur,
                                               whole: wh, bar: un,
                                               top: tp,
                                               sel_col: cur.count,
                                               anchor_col: cur.count,
                        focusable: true, area: ar9 ]
            el
                # a mounted field keeps its text, unless it is empty and
                # the value has arrived since (the export lists no
                # defaults)
                fe : element (ex) ? elements[ 'lp_{nm}' ] : null
                if [
                    ex
                    && !(cur.count > 0 && (!fe.edit || fe.edit.count == 0)) ]
                    t['lp_{nm}'] = LaunchField [ label: '',
                                                 focusable: true,
                                                 area: ar9 ]
                el
                    t['lp_{nm}'] = LaunchField [ label: '', edit: cur,
                                                 sel_col: cur.count,
                                                 anchor_col: cur.count,
                        focusable: true, area: ar9 ]
            y += rhx
            rule_ys.push[ y ]
        content_h = y + scroll.y
        rows_h    = content_h
        col_x     = lw
        body.area = Region [ 'l0 t0 r0 h{i32[ y ]}px' ]
        return t

    # the 1px rules: one under every row, one between the name and value
    # columns
    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds || rows_h <= 0.0 ]
            return
        cv : Canvas w.screen
        cv.stroke_width[ 0.0 ]
        cv.fill_color[ rgba [ '#ffffff1a' ] ]
        if [ rule_ys ]
            for [ y9: f32 ] in rule_ys
                cv.rect_to[ 0.0, y9 - 1.0, bounds.w, 1.0 ]
                cv.paint[]
        # the column rule, broken where a row spans both cells
        at : f32 [ 0.0 - scroll.y ]
        if [ spans ]
            for [ i: i32 0, i + 1 < spans.count, i += 2 ]
                if [ spans[ i ] > at ]
                    cv.rect_to[ col_x, at, 1.0, spans[ i ] - at ]
                    cv.paint[]
                at = spans[ i ] + spans[ i + 1 ]
        if [ rows_h - scroll.y > at ]
            cv.rect_to[ col_x, at, 1.0, rows_h - scroll.y - at ]
            cv.paint[]
        if [ cuts ]
            for [ i: i32 0, i + 2 < cuts.count, i += 3 ]
                cv.rect_to[ cuts[ i ], cuts[ i + 1 ], 1.0,
                            cuts[ i + 2 ] - 1.0 ]
                cv.paint[]

    # the control's current value as the app takes it; null when the
    # control is not up
    func value_of [ p: Prop ] -> string
        if [ !elements || !p.ident ] return null
        vn : i32 [ vec_n[ p.type ] ]
        if [ vn > 0 ]
            joined : string ''
            for [ i: i32 0, i < vn, i += 1 ]
                pk : string 'lp_{p.ident}_{i}'
                if [ !elements.contains[ pk ] ] return null
                pe : element elements[ pk ]
                # an emptied part is 0: the value keeps its parts
                pv : string [ (pe.edit && pe.edit.count > 0)
                              ? pe.edit : '0' ]
                joined = (i == 0) ? pv : '{joined}, {pv}'
            return joined
        key : string 'lp_{p.ident}'
        if [ !elements.contains[ key ] ] return null
        c : element elements[ key ]
        # an action has no value: it is called, never composed or set
        if [ p.type == 'func' ] return null
        if [ p.type == 'bool' ] return (c.selected) ? 'true' : 'false'
        if [ c inherits StepField ]
            sf : StepField c
            return sf.text[]
        if [ c inherits PadField ]
            pf : PadField c
            return '{pf.code}'
        if [ has_stops[ p ] ]
            if [ !(c inherits TButtons) ] return null
            tb : TButtons c
            if [ tb.selected < 0 || tb.selected >= p.stops.count ]
                return null
            return p.stops[ tb.selected ]
        if [ ctl[ p ] == 'Range' ]
            if [ !(c inherits VolumeSlider) ] return null
            vs : VolumeSlider c
            rg : vec2f [ range_of[ p ] ]
            val : f32 [ rg.x + vs.value * (rg.y - rg.x) ]
            return (p.type == 'f32' || p.type == 'f64') ? '{val.2f}' : '{val.0f}'
        if [ c inherits LaunchPath ]
            lp : LaunchPath c
            if [ lp.path_value && lp.path_value.count > 0 ]
                return lp.path_value
        if [ c inherits KeyField ]
            kf : KeyField c
            return '{kf.code}'
        return c.edit

    # the live property whose control is the one that changed:
    # only it is sent (a set the app did not need is a change)
    func live_prop [ only: element ] -> Prop
        if [ !only ] return null
        parse_fields[]
        for [ p: Prop ] in fields.props
            if [ !prop_live[ p ] ] continue
            if [ !elements ] continue
            for [ i: i32 0, i < vec_n[ p.type ], i += 1 ]
                pk : string 'lp_{p.ident}_{i}'
                if [ elements.contains[ pk ] && elements[ pk ] == only ]
                    return p
            key : string 'lp_{p.ident}'
            if [ !elements.contains[ key ] ] continue
            if [ elements[ key ] == only ] return p
        return null

    # the args line the controls describe: only values off their
    # defaults
    func compose [] -> string
        out : string ''
        pos : string ''
        if [ !elements ] return out
        parse_fields[]
        for [ p: Prop ] in fields.props
            nm : string p.ident
            df : string (p.value) ? p.value : ''
            v : string value_of[ p ]
            # an empty field writes no flag: `--mouse_sens ` took the
            # rom as its value
            if [ !v || v.count == 0 ] continue
            ck : string ctl[ p ]
            # a binding at 0 was never set here: the app keeps its own
            if [ (ck == 'KeyBind' || ck == 'PadBind') && v == '0' ]
                continue
            if [ has_stops[ p ] ]
                # the module converts an enum arg by its value NAME
                if [ v == df ] continue
            el [ ck == 'Range' || ck == 'Stepper' ]
                val : f32 [ v.real_value[] ]
                dv  : f32 [ df.real_value[] ]
                if [ val - dv < 0.001 && dv - val < 0.001 ] continue
            # a path is never "the default": a running instance reports
            # its own path as the default, and dropping it here emptied
            # the box
            el [ !(p.type == 'path' || p.type == 'resource') && v == df ]
                continue
            # a resource or a default member is the app's positional
            # argument
            # (bare); every other field is a --name flag. flags first,
            # positional last
            if [ prop_pos[ p ] ]
                pos = (pos.count > 0) ? '{pos} {v}' : v
            el
                fl : string flag_name[ p ]
                out = (out.count > 0) ? '{out} --{fl} {v}' : '--{fl} {v}'
        if [ pos.count > 0 ] out = (out.count > 0) ? '{out} {pos}' : pos
        return out
