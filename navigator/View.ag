                cv.stroke_width[ 0.0 ]
                cv.rect_to[ ccx, ccy + 4.0 * u, 2.0 * u, lh - 8.0 * u ]
                cv.paint[ ]
            nav_font[ cv, fs ]
            # the commit row: where the commit goes, then the button
            # named for what it does there, at the right
            gy : f32 [ yb + f32[ trs + 4 ] * lh ]
            ct : Contrib nav.contrib_of[]
            st : RepoState (ct) ? ct.state : null
            md : i32 [ (st) ? st.mode[] : 1 ]
            gl : string [ (md == 2) ? 'propose'
                : ((md == 3) ? 'update proposal'
                : ((cb.ux.shift) ? 'commit' : 'commit & push')) ]
            gw : f32 [ f32[ gl.count ] * mtm.w + 22.0 * u ]
