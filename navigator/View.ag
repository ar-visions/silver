                for [ i: i32 0, i < 3 && i < cb.commit_text.count,
                      i += 1 ]
                    ml : string cb.commit_text[i]
                    if [ !ml ] continue
                    cv.fill_color[ rgba['#e6e2f5'] ]
                    cv.draw_text[ ml,
                        rect [ x: x0 + 8.0 * u, y: by + f32[ i ] * lh,
