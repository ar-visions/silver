# the navigator view: the side column (users, projects, the
# drives, the pins), the git band and its commit form, the browse
# list; the model it reads is handed in (CommitView.nav)
extend navigator

func nav_font [ cv: Canvas, px: i32 ]
    sz : i32 [ i32[ round[ f32[ px ] * nav_unit[ cv ] ] ] ]
    cv.set_font[ shared_font[ cv, 'fonts/BarlowCondensed-Regular.ttf',
                              sz ] ]
    cv.font_size[ sz ]

func draw_card [ cv: Canvas, oa: Au, h: FindHit, cx_: f32, ry: f32,
                 cdw: f32, rh: f32, hov: bool ]
    u : f32 nav_unit[ cv ]
    # the model class is declared after this signature: cast here
    nav : cast Navigator [ oa ]
    if [ hov ]
        cv.save[ ]
        cv.rounded[ 8.0 * u, 8.0 * u, 8.0 * u, 8.0 * u ]
        cv.fill_color[ rgba['#ff6a2e2a'] ]
        cv.stroke_width[ 1.0 ]
        cv.stroke_offset[ -0.5 ]
        cv.stroke_color[ rgba['#ff8a3a99'] ]
        cv.box_shadow[ rgba['#ff8a3a99'], 0.0, 0.0, 6.0 * u, 0.0, true ]
        cv.rect_to[ cx_ - 4.0 * u, ry + 1.0, cdw - 8.0 * u,
                    rh - 2.0 * u ]
        cv.paint[ ]
        cv.restore[ ]
    host : NavHost nav.host
    # an instance's picture (a program's window, else its frame)
    ft : Texture (h.inst > 0) ? host.instance_tex*[ h.inst ] : null
    sc_ : bool [ h.card[] && h.inst == 0 ]
    if [ sc_ ] ft = nav.scene_tex[ h ]
    tw : f32 [ cdw - 24.0 * u ]
    if [ ft && ft.width > 0 && ft.height > 0 ]
        tw = 96.0 * u * f32[ ft.width ] / f32[ ft.height ]
        if [ tw > cdw - 24.0 * u ] tw = cdw - 24.0 * u
    # the picture sits centered in the card box, which starts 4px
    # left of the content and is 8px narrower than the cell
    tx_ : f32 [ round[ cx_ - 4.0 * u + (cdw - 8.0 * u - tw) * 0.5 ] ]
    # the picture with 6px corners and a thin border around it
    cv.save[ ]
    cv.rounded[ 6.0 * u, 6.0 * u, 6.0 * u, 6.0 * u ]
    cv.stroke_width[ 0.0 ]
    if [ ft && ft.width > 0 && ft.height > 0 ]
        cv.draw_image[ ft,
                       rect [ x: tx_, y: round[ ry + 6.0 * u ],
                              w: round[ tw ], h: 96.0 * u ] ]
    el
        cv.fill_color[ rgba['#000000'] ]
        cv.rect_to[ tx_, round[ ry + 6.0 * u ], tw, 96.0 * u ]
        cv.paint[ ]
    cv.fill_color[ rgba['#0000'] ]
    cv.stroke_width[ 1.0 ]
    cv.stroke_offset[ -0.5 ]
    cv.stroke_color[ rgba['#ffffff40'] ]
    cv.rect_to[ tx_, round[ ry + 6.0 * u ], round[ tw ], 96.0 * u ]
    cv.paint[ ]
    cv.restore[ ]
    # two lines: the instance's name, and its state in blue under it
    st_ : string (h.inst > 0) ? host.instance_status*[ h.inst ] : ''
    if [ h.inst > 0 && (!st_ || st_.count == 0) ] st_ = 'running'
    if [ sc_ ]
        if [ host.scene_current*[].compare[ h.scene ] == 0 ]
            st_ = 'current'
    nav_font[ cv, 21 ]
    cv.fill_color[ rgba['#fff'] ]
    cv.draw_text[ (h.inst > 0) ? host.instance_name*[ h.inst ] : h.text,
        rect [ x: cx_ - 4.0 * u, y: ry + 104.0 * u, w: cdw - 8.0 * u,
               h: 20.0 * u ],
        vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.ellipsis,
        null, true ]
    cv.fill_color[ rgba['#6cb6ff'] ]
    cv.draw_text[ st_,
        rect [ x: cx_ - 4.0 * u, y: ry + 124.0 * u, w: cdw - 8.0 * u,
               h: 20.0 * u ],
        vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.ellipsis,
        null, true ]


# the navigation column (users, projects, the drives, the pinned
# folders): its own element, so its scroll fades at its ends
element NavSide
    content : NavSideLayer []

Layer NavSideLayer
    func draw [ cv: Canvas ]
        u : f32 nav_unit[ cv ]
        sd : element parent
        cb : CommitView [ (sd) ? sd.parent : null ]
        if [ !cb ] return
        nav : Navigator cb.nav
        if [ !nav ] return
        cv.stroke_width[ 0.0 ]
        wtx : f32 [ cv.transform_tx[] ]
        wty : f32 [ cv.transform_ty[] ]
        # the navigation column, fixed, right of the rail: users and
        # projects
        cb.side_w = cb.side_fit[ u ]
        if [ cb.side_w <= 0.0 ] return
        sw_ : f32 [ cb.side_w ]
        sx_ : f32 [ bounds.x + 6.0 * u ]
        cv.set_crop[ wtx + sx_, wty + bounds.y, wtx + sx_ + sw_,
                     wty + bounds.y + bounds.h ]
        cb.side_keys = vec string []
        cb.side_ys   = vec f32 []
        nav_font[ cv, 16 ]
        # the column's own eased scroll, kept within what it holds
        smax_ : f32 [ cb.side_h - bounds.h ]
        if [ smax_ < 0.0 ] smax_ = 0.0
        if [ sd.scroll.y > smax_ ] sd.scroll.y = smax_
        if [ sd.scroll_goal > smax_ ] sd.scroll_goal = smax_
        sy_ : f32 [ bounds.y + 10.0 * u - sd.scroll.y ]
        srh : f32 [ 24.0 * u ]
        # users, projects, then the computer's drives and the pinned
        # folders
        for [ sec: i32 0, sec < 4, sec += 1 ]
            names_ : vec string nav.repo_users
            if [ sec == 0 ]
                # you first, always there and never removable: the login
                # the key answers to, then everyone added
                me_ : string nav.self_user_of[]
                users_ : vec string []
                if [ me_ && me_.count > 0 ] users_.push[ me_ ]
                if [ nav.repo_users ]
                    for [ u_: string ] in nav.repo_users
                        if [
                            me_ && me_.count > 0
                            && u_.compare[ me_ ] == 0 ]
                            continue
                        users_.push[ u_ ]
                names_ = users_
            el [ sec == 1 ]
                names_ = nav.side_projects_of[]
            el [ sec == 2 ]
                names_ = nav.side_drives[]
            el
                names_ = nav.side_pinned[]
            # nothing pinned: no heading either
            if [ sec == 3 && names_.count == 0 ] continue
            hd_ : string (sec == 0) ? 'users'
                : ((sec == 1) ? 'projects'
                : ((sec == 2) ? 'system' : 'pinned'))
            cv.fill_color[ rgba['#ffffff55'] ]
            cv.draw_text[ hd_,
                rect [ x: sx_ + 4.0 * u, y: sy_, w: sw_ - 12.0 * u,
                       h: srh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip,
                null, true ]
            if [ sec == 0 ]
                # the + that adds a user: gray, lit under the pointer
                cb.plus_y = sy_ - bounds.y
                cv.fill_color[
                    (cb.hov_plus) ? rgba['#8fd0ff']
                    : rgba['#ffffff55'] ]
                cv.draw_text[ '+',
                    rect [ x: sx_ + sw_ - 30.0 * u, y: sy_, w: 20.0 * u,
                           h: srh ],
                    vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ],
                    Overflow.clip, null, true ]
            sy_ += srh
            if [ sec == 0 && cb.add_user ]
                # the row being typed: a box with the name so far and a
                # caret
                cv.save[ ]
                cv.rounded[ 6.0 * u, 6.0 * u, 6.0 * u, 6.0 * u ]
                cv.fill_color[ rgba['#ffffff10'] ]
                cv.stroke_width[ 1.0 ]
                cv.stroke_offset[ -0.5 ]
                cv.stroke_color[ rgba['#8fd0ff88'] ]
                cv.rect_to[ sx_, sy_ + 1.0, sw_ - 8.0 * u,
                            srh - 2.0 * u ]
                cv.paint[ ]
                cv.restore[ ]
                at_ : string (cb.add_text) ? cb.add_text : ''
                cv.fill_color[ rgba['#ffffff'] ]
                cv.draw_text[ at_,
                    rect [ x: sx_ + 8.0 * u, y: sy_, w: sw_ - 20.0 * u,
                           h: srh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                    Overflow.clip, null, true ]
                atw : f32 [ cv.measure_text[ at_ ].w ]
                cv.stroke_width[ 0.0 ]
                cv.rect_to[ sx_ + 8.0 * u + atw + 1.0, sy_ + 5.0 * u,
                            1.5,
                            srh - 10.0 * u ]
                cv.paint[ ]
                cb.side_keys.push[ 'e:' ]
                oye : f32 [ sy_ - bounds.y ]
                cb.side_ys.push[ oye ]
                sy_ += srh
            # a selected user narrows the projects to that user's
            # checkouts
            # (yours are the plain names); none selected shows them all
            su : string (sec == 1) ? nav.side_user : null
            me8 : string (sec == 1) ? nav.self_user_of[] : null
            if [ names_ ]
                for [ nm_: string ] in names_
                    if [ su && su.count > 0 ]
                        own_ : bool [ nm_.index_of[ '/' ] < 0 ]
                        if [
                            me8 && me8.count > 0
                            && su.compare[ me8 ] == 0 ]
                            if [ !own_ ] continue
                        el
                            if [ !nm_.starts_with[ '{su}/' ] ] continue
                    key_ : string (sec == 0) ? 'u:{nm_}'
                        : ((sec == 1) ? 'p:{nm_}'
                        : ((sec == 2) ? 'd:{nm_}' : 'f:{nm_}'))
                    on_ : bool [ false ]
                    if [ sec == 0 ]
                        on_ = nav.side_user && nav.side_user.compare[
                            nm_ ] == 0
                    el [ sec == 1 ]
                        on_ = nav.side_lit[ nm_ ]
                    el
                        on_ = nav.nav_root && '{nav.nav_root}' == nm_
                    hov_ : bool [ cb.hov_side == cb.side_keys.count ]
                    if [ on_ || hov_ ]
                        cv.save[ ]
                        cv.rounded[ 6.0 * u, 6.0 * u, 6.0 * u, 6.0 * u ]
                        cv.fill_color[
                            (on_) ? rgba['#6cb6ff22']
                            : rgba['#ffffff10'] ]
                        cv.stroke_width[ 0.0 ]
                        cv.rect_to[ sx_, sy_ + 1.0, sw_ - 8.0 * u,
                                    srh - 2.0 * u ]
                        cv.paint[ ]
                        cv.restore[ ]
                    dk : bool [ sec == 1 && nav.repo_docked[ nm_ ] ]
                    # another user's checkout reads user:repository (the
                    # disk path stays user/repository)
                    # ...unless that user is the one selected: then the
                    # list is already theirs and the name alone fits
                    lbl_ : string nm_
                    # a drive or folder by its last name; / is the
                    # system
                    if [ sec >= 2 ]
                        lbl_ = (nm_ == '/') ? 'system'
                            : (path nm_).filename[]
                    sl_ : i32 [ nm_.index_of[ '/' ] ]
                    if [ sec == 1 && sl_ > 0 ]
                        own8 : string nm_.mid[ 0, sl_ ]
                        if [
                            su && su.count > 0
                            && su.compare[ own8 ] == 0 ]
                            lbl_ = nm_.mid[ sl_ + 1,
                                            nm_.count - sl_ - 1 ]
                        el
                            lbl_ = own8 + ':' + nm_.mid[ sl_ + 1,
                                                         nm_.count - sl_
                                                         - 1 ]
                    cv.fill_color[
                        (on_) ? rgba['#ffffff']
                        : ((dk) ? rgba['#9fd0ff'] : rgba['#c8c2d8']) ]
                    cv.draw_text[ lbl_,
                        rect [ x: sx_ + 8.0 * u, y: sy_,
                               w: sw_ - 36.0 * u,
                               h: srh ],
                        vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                        Overflow.ellipsis, null, true ]
                    # shift held: a - next to every added user (never
                    # you) removes it
                    if [
                        ((sec == 0 && cb.side_keys.count > 0)
                         || sec == 3) && cb.ux.shift ]
                        cv.fill_color[
                            (hov_) ? rgba['#ff8a8a']
                            : rgba['#ffffff55'] ]
                        cv.draw_text[ '-',
                            rect [ x: sx_ + sw_ - 30.0 * u, y: sy_,
                                   w: 20.0 * u,
                                   h: srh ],
                            vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ],
                            Overflow.clip, null, true ]
                    # the dock toggle at the row's right: lit when the
                    # checkout is in the search set
                    if [ sec == 1 ]
                        cv.save[ ]
                        cv.rounded[ 4.0 * u, 4.0 * u, 4.0 * u, 4.0 * u ]
                        cv.fill_color[
                            (dk) ? rgba['#6cb6ff'] : rgba['#0000'] ]
                        cv.stroke_width[ 1.0 ]
                        cv.stroke_offset[ -0.5 ]
                        cv.stroke_color[
                            (dk) ? rgba['#6cb6ff'] : rgba['#ffffff33'] ]
                        cv.rect_to[ sx_ + sw_ - 24.0 * u, sy_ + 8.0 * u,
                                    8.0 * u,
                                    8.0 * u ]
                        cv.paint[ ]
                        cv.restore[ ]
                    oy : f32 [ sy_ - bounds.y ]
                    cb.side_keys.push[ key_ ]
                    cb.side_ys.push[ oy ]
                    sy_ += srh
            sy_ += 10.0 * u
        cb.side_h = sy_ + sd.scroll.y - bounds.y
        sd.content_h = cb.side_h
        # a hairline between the column and the content
        cv.fill_color[ rgba['#ffffff14'] ]
        cv.stroke_width[ 0.0 ]
        cv.rect_to[ sx_ + sw_ - 1.0, bounds.y + 8.0 * u, 1.0,
                    bounds.h - 16.0 * u ]
        cv.paint[ ]

# the navigator's right column: the file's views (its git
# reference, b16 ...) as buttons, icon over name; the one on is
# outlined; a press shows it
Layer CommitLayer
    func draw [ cv: Canvas ]
        u : f32 nav_unit[ cv ]
        cb : CommitView [ parent ]
        if [ !cb ] return
        nav : Navigator cb.nav
        if [ !nav ] return
        host : NavHost nav.host
        # no ground of its own: the host's background is ours
        cv.stroke_width[ 0.0 ]
        wtx : f32 [ cv.transform_tx[] ]
        wty : f32 [ cv.transform_ty[] ]
        # the navigation column is its own child (NavSide): it fades
        # by its own scroll
        cb.side_w = cb.side_fit[ u ]
        sw_ : f32 [ cb.side_w ]
        # content right of the column; everything below rides one scroll
        x0  : f32 [ bounds.x + 14.0 * u + sw_ ]
        cw : f32 [ bounds.w - 14.0 * u - sw_ - cb.rail_w ]
        cv.set_crop[ wtx + x0, wty + bounds.y,
                     wtx + bounds.x + bounds.w,
                     wty + bounds.y + bounds.h ]
        # picking a path for a launch field: files only, no git tabs or
        # summary
        picking : bool [ nav.pick_on ]
        files : vec string (nav.git_snap && !picking) ? nav.git_snap.files : null
        nfl : i32 [ (files) ? files.count : 0 ]
        cap : i32 [ nav.commit_cap[ cw ] ]
        trs : i32 [
            (nfl > 0) ? nav.commit_tab_rows[ cw, cb.reveal_all ] : 0 ]
        open_ : bool [ cb.commit_open && trs > 0 ]
        band_ : i32 [ (trs > 0) ? trs + 1 + ((open_) ? 4 : 0) : 0 ]
        lh  : f32 [ 36.0 * u ]
        fs  : i32 [ 17 ]
        nav_font[ cv, fs ]
        mtm : cv.measure_text[ 'x' ]
        cb.cap_st  = cap
        cb.cw_st   = mtm.w
        cb.band_st = band_
        # content tops at +4 so the first tab row meets the chips
        yb : f32 [ bounds.y + 4.0 * u - cb.scroll.y ]
        # tabs: 144px pills on a 150 stride
        rep_ : string [ (nav.git_snap) ? nav.git_snap.repo : '' ]
        shown : i32 [ trs * cap ]
        if [ shown > nfl ] shown = nfl
        for [ i: i32 0, i < shown, i += 1 ]
            rp : string files[i]
            fx : i32 [ rp.rindex_of[ '/' ] ]
            nm : string [
                (fx >= 0) ? rp.mid[ fx + 1, rp.count - fx - 1 ] : rp ]
            rw : i32 [ i / cap ]
            cl_ : i32 [ i % cap ]
            tx : f32 [ x0 + f32[ cl_ ] * (150.0 * u) ]
            ty : f32 [ yb + f32[ rw ] * lh ]
            if [ ty + lh < bounds.y || ty > bounds.y + bounds.h ]
                continue
            if [ tx + 144.0 * u > bounds.x + bounds.w - 12.0 * u ]
                continue
            thov : bool [ cb.hov_row == rw && cb.hov_tab == cl_ ]
            # bold + white border when the host holds unsaved edits
            dirty : bool [ host.file_dirty*[ path '{rp}' ] ]
            # the row-highlight look, pinkish red — theme-bound
            cv.save[ ]
            cv.rounded[ 8.0 * u, 8.0 * u, 8.0 * u, 8.0 * u ]
            # every tab at half alpha: fill, border and glow alike
            ft : cb.theme_rgba['#22002280']
            # the hovered tab stands apart: twice the fill
            cv.fill_color[
                rgba [ r: ft.r, g: ft.g, b: ft.b,
                       a: (thov) ? min[ ft.a * 2.0, 1.0 ] : ft.a ] ]
            cv.stroke_width[ 1.0 ]
            cv.stroke_offset[ -0.5 ]
            # the border rests at a quarter; the pointer's near light
            # brings it and the inner glow up, 30% past the tabs' amount
            # theme colours are shared objects: copies, never edits
            bt : (dirty) ? cb.theme_rgba['#ffffff80'] : ((thov) ? cb.theme_rgba['#ff7aa480'] : cb.theme_rgba['#ff5a8a80'])
            cv.stroke_color[
                rgba [ r: bt.r, g: bt.g, b: bt.b,
                       a: (dirty || thov) ? min[ bt.a * 2.0, 1.0 ]
                       : bt.a * 0.5 ] ]
            ht : cb.theme_rgba['#ff7aa480']
            cv.box_shadow[
                rgba [ r: ht.r, g: ht.g, b: ht.b,
                       a: (thov) ? min[ ht.a * 2.0, 1.0 ]
                       : ht.a * 0.25 ], 0.0, 0.0,
                       (thov) ? 14.0 * u : 9.0 * u,
                       0.0, true ]
            nc : rgba [ r: ht.r, g: ht.g, b: ht.b, a: 1.0 ]
            cb.ux.near_light_on[ cv, cb, 0.0, 0.0 ]
            cv.near_style[ 1.3, (thov) ? 3.9 * u : 1.95, nc,
                           cb.ux.near_y_fade ]
            cv.rect_to[ tx, ty + 3.0 * u, 144.0 * u, lh - 6.0 * u ]
            cv.paint[ ]
            cv.restore[ ]
            if [ dirty ]
                if [ !cb.bold_font ]
                    bfp : path 'fonts/BarlowCondensed-Bold.ttf'
                    if [ bfp.exists[] ]
                        # match ensure_font's display scaling
                        bsc : f32 [
                            (cv.w && cv.w.scale > 0.0) ? cv.w.scale
                            : 1.0 ]
                        cb.bold_font = CanvasFont [ ft_lib: cv.ft_lib,
                            uri: 'fonts/BarlowCondensed-Bold.ttf',
                            size_px: i32[ f32[ fs ] * bsc ] ]
                if [ cb.bold_font ] cv.set_font[ cb.bold_font ]
            # its ring: filled while in the next commit
            out_ : bool nav.commit_skips[ rp ]
            cv.save[ ]
            rr_ : f32 [ 5.0 * u ]
            cv.rounded[ rr_, rr_, rr_, rr_ ]
            cv.fill_color[ (out_) ? rgba['#0000'] : rgba['#ff7aa4cc'] ]
            cv.stroke_width[ 1.0 ]
            cv.stroke_offset[ -0.5 ]
            cv.stroke_color[ rgba['#ff9ab9cc'] ]
            cv.rect_to[ tx + 9.0 * u, ty + lh * 0.5 - rr_,
                        rr_ * 2.0, rr_ * 2.0 ]
            cv.paint[ ]
            cv.restore[ ]
            cv.fill_color[ (out_) ? rgba['#9a8a95']
                : ((thov) ? rgba['#ffffff'] : rgba['#ffd9e4']) ]
            cv.draw_text[ nm,
                rect [ x: tx + 22.0 * u, y: ty, w: 118.0 * u, h: lh ],
                vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ],
                Overflow.ellipsis, null, true ]
            if [ dirty ] nav_font[ cv, fs ]
        # control row: reveal-all pill left, totals + make commit right
        cy : f32 [ yb + f32[ trs ] * lh ]
        if [ trs > 0 ]
            # what the commit takes: chosen files and their lines
            tot_ : vec i32 nav.commit_totals[]
            rvl : string '{tot_[ 0 ]} files changed'
            # every width here is its words measured: the font is
            # proportional
            rvw : f32 [ cv.measure_text[ rvl ].w + 16.0 * u ]
            lhov : bool [ cb.hov_ctl == 0 ]
            cv.save[ ]
            cv.rounded[ 8.0 * u, 8.0 * u, 8.0 * u, 8.0 * u ]
            cv.fill_color[ (lhov) ? rgba['#6cb6ff22'] : rgba['#0000'] ]
            cv.stroke_width[ 0.0 ]
            cv.rect_to[ x0, cy + 5.0 * u, rvw, 26.0 * u ]
            cv.paint[ ]
            cv.restore[ ]
            cv.fill_color[ (lhov) ? rgba['#ffffff'] : rgba['#9a94b0'] ]
            cv.draw_text[ rvl,
                rect [ x: x0, y: cy, w: rvw, h: lh ],
                vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip,
                null, true ]
            cb.lx0 = x0 - bounds.x
            cb.lx1 = x0 + rvw - bounds.x
            # totals after the count pill; make commit is a centered
            # button that dodges anything sequenced before it
            rhov : bool [ cb.hov_ctl == 1 ]
            lbl : string [ (open_) ? 'cancel' : 'make commit' ]
            lw_ : f32 [ cv.measure_text[ lbl ].w ]
            as_ : string '+{tot_[ 1 ]}'
            ds : string '-{tot_[ 2 ]}'
            asw : f32 [ cv.measure_text[ as_ ].w ]
            dsw : f32 [ cv.measure_text[ ds ].w ]
            asx : f32 [ x0 + rvw + 16.0 * u ]
            dsx : f32 [ asx + asw + mtm.w ]
            bw : f32 [ lw_ + 22.0 * u ]
            cxc : f32 [
                x0 + (bounds.x + bounds.w - 24.0 * u - x0 - bw) * 0.5 ]
            mnx : f32 [ dsx + dsw + 16.0 * u ]
            bx_ : f32 [ (cxc > mnx) ? cxc : mnx ]
            cb.rx0 = bx_ - bounds.x
            cb.rx1 = bx_ + bw - bounds.x
            # borderless, same 26px height as the create buttons
            cv.save[ ]
            cv.rounded[ 8.0 * u, 8.0 * u, 8.0 * u, 8.0 * u ]
            cv.fill_color[
                (open_) ? rgba['#7a2f2fcc']
                : ((rhov) ? rgba['#6cb6ff22'] : rgba['#0000']) ]
            cv.stroke_width[ 0.0 ]
            cv.rect_to[ bx_, cy + 5.0 * u, bw, 26.0 * u ]
            cv.paint[ ]
            cv.restore[ ]
            cv.fill_color[ rgba['#6a9955'] ]
            cv.draw_text[ as_,
                rect [ x: asx, y: cy, w: asw + 4.0 * u, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip,
                null, true ]
            cv.fill_color[ rgba['#e06c75'] ]
            cv.draw_text[ ds,
                rect [ x: dsx, y: cy, w: dsw + 4.0 * u, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip,
                null, true ]
            # the last send's result, after the totals, while closed
            ct8 : Contrib (open_) ? null : nav.contrib
            nt8 : string [ (ct8 && ct8.state && ct8.state.note)
                ? ct8.state.note : '' ]
            if [ nt8.count > 0 && bx_ - mnx > 40.0 * u ]
                cv.fill_color[ rgba['#6a9955'] ]
                cv.draw_text[ nt8,
                    rect [ x: mnx, y: cy, w: bx_ - mnx - 12.0 * u,
                           h: lh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                    Overflow.ellipsis, null, true ]
            cv.fill_color[
                (open_) ? rgba['#ffd9d2']
                : ((rhov) ? rgba['#ffffff'] : rgba['#9a94b0']) ]
            cv.draw_text[ lbl,
                rect [ x: bx_, y: cy, w: bw, h: lh ],
                vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip,
                null, true ]
            # divider under the whole band, 4px clear of the button
