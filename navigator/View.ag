                    cv.stroke_width[ 1.0 ]
                    cv.stroke_offset[ -0.5 ]
                    cv.stroke_color[
                        (nfh) ? rgba['#8fd0ff'] : rgba['#fff3'] ]
                    cv.rect_to[ nbx, ry + 2.0 * u, nfw, 26.0 * u ]
