            cv.stroke_width[ 0.0 ]
            cv.rect_to[ x0, round[ yb + f32[ band_ ] * lh + 3.0 * u ],
                        bounds.x + bounds.w - x0 - 24.0 * u, 1.0 ]
            cv.paint[ ]
        if [ open_ ]
            # the message box: three lines of the app's commit text
            by : f32 [ yb + f32[ trs + 1 ] * lh ]
            cv.save[ ]
            cv.rounded[ 8.0 * u, 8.0 * u, 8.0 * u, 8.0 * u ]
            cv.fill_color[ cb.theme_rgba['#220022aa'] ]
            cv.stroke_width[ 1.0 ]
            cv.stroke_offset[ -0.5 ]
            cv.stroke_color[ rgba['#6cb6ff55'] ]
            cv.rect_to[ x0, by + 3.0 * u,
                        bounds.x + bounds.w - x0 - 24.0 * u,
                        lh * 3.0 - 6.0 * u ]
            cv.paint[ ]
            cv.restore[ ]
            # the message keeps the canvas's own lettering (monospace):
