export 0.2.0

import vec
import img
import trinity

import <stdio.h>
import <stdlib.h>
import <string.h>

# clouds: real-time volumetric cloudscapes after Nubis (Schneider,
# Guerrilla: SIGGRAPH 2015 / 2017 / Nubis Evolved 2022) with the
# Frostbite scattering integration (Hillaire 2016).
#   model: perlin-worley shape 128^3, worley detail 32^3, curl 128^2,
#          weather field (coverage / type), height profiles
#          per cloud type, wind scroll + skew, anvils
#   light: 6-sample cone light march, 3-octave multiple scattering,
#          dual-lobe Henyey-Greenstein + silver lining, in-scatter
#          probability (dark edges), sky ambient, rain darkening,
#          energy-conserving step integration
#   sky:   single-scatter atmosphere (Rayleigh + Mie), sun disc,
#          aerial perspective, cloud shadows on the ground
# the noise set is baked once at build time (export func) to
# share/clouds/baked as png strips

enum CloudSurface
    shape   : 0
    detail  : 1
    curl    : 2
    weather : 3
    island  : 4
    waves   : 5
    stars   : 6
    envmap  : 7
    tvar    : 5

# ---------------------------------------------------------------
# bake: tileable noises
# ---------------------------------------------------------------
class CloudBake
    intern seed : u32 [ 1234567 ]
    intern perm : vec i32

    func rnd [] -> f32
        seed = seed * 1664525 + 1013904223
        return f32[ seed >> 8 ] / 16777216.0

    func init []
        perm = vec i32 [ 512 ]
        for [ i: i32 0, i < 256, i += 1 ] perm[ i ] = i
        for [ i: i32 255, i > 0, i = i - 1 ]
            j : i32 [ i32[ rnd[] * f32[ i + 1 ] ] ]
            if [ j > i ] j = i
            t : i32 [ perm[ i ] ]
            perm[ i ] = perm[ j ]
            perm[ j ] = t
        for [ i: i32 0, i < 256, i += 1 ] perm[ 256 + i ] = perm[ i ]

    func fade [ t: f32 ] -> f32
        return t * t * t * (t * (t * 6.0 - 15.0) + 10.0)

    func grad3 [ h: i32, x: f32, y: f32, z: f32 ] -> f32
        g : i32 [ h & 15 ]
        u : f32 [ (g < 8) ? x : y ]
        v : f32 [ (g < 4) ? y : ((g == 12 || g == 14) ? x : z) ]
        return (((g & 1) == 0) ? u : 0.0 - u) + (((g & 2) == 0) ? v : 0.0 - v)

    func hash3 [ x: i32, y: i32, z: i32 ] -> i32
        return perm[ (perm[ (perm[ x & 255 ] + y) & 255 ] + z) & 255 ]

    # tileable perlin, period P (power of two) in lattice units
    func perlin3 [ x: f32, y: f32, z: f32, P: i32 ] -> f32
        fx : f32 [ floor[ x ] ]
        fy : f32 [ floor[ y ] ]
        fz : f32 [ floor[ z ] ]
        xi : i32 [ i32[ fx ] ]
        yi : i32 [ i32[ fy ] ]
        zi : i32 [ i32[ fz ] ]
        xf : f32 [ x - fx ]
        yf : f32 [ y - fy ]
        zf : f32 [ z - fz ]
        m : i32 [ P - 1 ]
        x0 : i32 [ xi & m ]
        y0 : i32 [ yi & m ]
        z0 : i32 [ zi & m ]
        x1 : i32 [ (xi + 1) & m ]
        y1 : i32 [ (yi + 1) & m ]
        z1 : i32 [ (zi + 1) & m ]
        u : f32 [ fade[ xf ] ]
        v : f32 [ fade[ yf ] ]
        w : f32 [ fade[ zf ] ]
        n000 : f32 [ grad3[ hash3[ x0, y0, z0 ], xf,       yf,       zf ] ]
        n100 : f32 [ grad3[ hash3[ x1, y0, z0 ], xf - 1.0, yf,       zf ] ]
        n010 : f32 [ grad3[ hash3[ x0, y1, z0 ], xf,       yf - 1.0, zf ] ]
        n110 : f32 [ grad3[ hash3[ x1, y1, z0 ], xf - 1.0, yf - 1.0, zf ] ]
        n001 : f32 [ grad3[ hash3[ x0, y0, z1 ], xf,       yf,       zf - 1.0 ] ]
        n101 : f32 [ grad3[ hash3[ x1, y0, z1 ], xf - 1.0, yf,       zf - 1.0 ] ]
        n011 : f32 [ grad3[ hash3[ x0, y1, z1 ], xf,       yf - 1.0, zf - 1.0 ] ]
        n111 : f32 [ grad3[ hash3[ x1, y1, z1 ], xf - 1.0, yf - 1.0, zf - 1.0 ] ]
        a0 : f32 [ n000 + (n100 - n000) * u ]
        a1 : f32 [ n010 + (n110 - n010) * u ]
        b0 : f32 [ n001 + (n101 - n001) * u ]
        b1 : f32 [ n011 + (n111 - n011) * u ]
        c0 : f32 [ a0 + (a1 - a0) * v ]
        c1 : f32 [ b0 + (b1 - b0) * v ]
        return c0 + (c1 - c0) * w

    # tileable perlin fbm in 0..1; x,y,z in 0..1; base period P
    func perlin_fbm3 [ x: f32, y: f32, z: f32, P: i32, octaves: i32 ] -> f32
        sum : f32 [ 0.0 ]
        amp : f32 [ 1.0 ]
        norm : f32 [ 0.0 ]
        p : i32 [ P ]
        for [ o: i32 0, o < octaves, o += 1 ]
            f : f32 [ f32[ p ] ]
            sum += perlin3[ x * f, y * f, z * f, p ] * amp
            norm += amp
            amp *= 0.5
            p *= 2
            if [ p > 128 ] break
        v : f32 [ sum / norm ]
        # perlin lives in about -0.7..0.7: stretch to 0..1
        return sat[ v * 0.75 + 0.5 ]

    # feature points for a worley frequency F: F^3 cells, 3 floats each
    func worley_points [ F: i32 ] -> vec f32
        n : i32 [ F * F * F * 3 ]
        pts : vec f32 [ n ]
        for [ i: i32 0, i < n, i += 1 ] pts[ i ] = rnd[]
        return pts

    # inverted tileable worley; x,y,z in 0..1
    func worley3 [ x: f32, y: f32, z: f32, F: i32, pts: vec f32 ] -> f32
        px : f32 [ x * f32[ F ] ]
        py : f32 [ y * f32[ F ] ]
        pz : f32 [ z * f32[ F ] ]
        cx : i32 [ i32[ floor[ px ] ] ]
        cy : i32 [ i32[ floor[ py ] ] ]
        cz : i32 [ i32[ floor[ pz ] ] ]
        md : f32 [ 1e9 ]
        for [ dz: i32 -1, dz <= 1, dz += 1 ]
            zz : i32 [ cz + dz ]
            wz : i32 [ (zz + F) % F ]
            for [ dy: i32 -1, dy <= 1, dy += 1 ]
                yy : i32 [ cy + dy ]
                wy : i32 [ (yy + F) % F ]
                for [ dx: i32 -1, dx <= 1, dx += 1 ]
                    xx : i32 [ cx + dx ]
                    wx : i32 [ (xx + F) % F ]
                    i : i32 [ ((wz * F + wy) * F + wx) * 3 ]
                    fx : f32 [ f32[ xx ] + pts[ i ] - px ]
                    fy : f32 [ f32[ yy ] + pts[ i + 1 ] - py ]
                    fz : f32 [ f32[ zz ] + pts[ i + 2 ] - pz ]
                    d2 : f32 [ fx * fx + fy * fy + fz * fz ]
                    if [ d2 < md ] md = d2
        d : f32 [ sqrt[ md ] ]
        if [ d > 1.0 ] d = 1.0
        return 1.0 - d

    func worley2 [ x: f32, y: f32, F: i32, pts: vec f32 ] -> f32
        px : f32 [ x * f32[ F ] ]
        py : f32 [ y * f32[ F ] ]
        cx : i32 [ i32[ floor[ px ] ] ]
        cy : i32 [ i32[ floor[ py ] ] ]
        md : f32 [ 1e9 ]
        for [ dy: i32 -1, dy <= 1, dy += 1 ]
            yy : i32 [ cy + dy ]
            wy : i32 [ (yy + F) % F ]
            for [ dx: i32 -1, dx <= 1, dx += 1 ]
                xx : i32 [ cx + dx ]
                wx : i32 [ (xx + F) % F ]
                i : i32 [ (wy * F + wx) * 3 ]
                fx : f32 [ f32[ xx ] + pts[ i ] - px ]
                fy : f32 [ f32[ yy ] + pts[ i + 1 ] - py ]
                d2 : f32 [ fx * fx + fy * fy ]
                if [ d2 < md ] md = d2
        d : f32 [ sqrt[ md ] ]
        if [ d > 1.0 ] d = 1.0
        return 1.0 - d

    func remap [ v: f32, lo: f32, hi: f32, nlo: f32, nhi: f32 ] -> f32
        return nlo + ((v - lo) / (hi - lo)) * (nhi - nlo)

    func sat [ v: f32 ] -> f32
        return (v < 0.0) ? 0.0 : ((v > 1.0) ? 1.0 : v)

    func to_byte [ v: f32 ] -> u8
        s : f32 [ sat[ v ] * 255.0 + 0.5 ]
        return u8[ i32[ s ] ]

    func run []
        t0 : i64 [ epoch_micros[] ]
        bd : path '../clouds/baked'
        bd.make_dir[]
        bake_shape[ path '../clouds/baked/shape.png' ]
        bake_detail[ path '../clouds/baked/detail.png' ]
        bake_curl[ path '../clouds/baked/curl.png' ]
        bake_weather[ path '../clouds/baked/weather.png' ]
        bake_tops[ path '../clouds/baked/tops.png' ]
        bake_ms : i64 [ (epoch_micros[] - t0) / 1000 ]
        puts 'clouds: noise set baked in {bake_ms} ms'

    # shape 128^3: R perlin-worley, G/B/A worley fbm at rising freq
    func bake_shape [ out: path ]
        N : i32 [ 128 ]
        img : Image [ width: N, height: N * N, format: Pixel.rgba8, linear: true, wrap_u: true, wrap_v: true ]
        d : @u8 [ img.vdata[] ]
        w4  : worley_points[ 4 ]
        w8  : worley_points[ 8 ]
        w16 : worley_points[ 16 ]
        w32 : worley_points[ 32 ]
        w64 : worley_points[ 64 ]
        inv : f32 [ 1.0 / f32[ N ] ]
        for [ z: i32 0, z < N, z += 1 ]
            fz : f32 [ (f32[ z ] + 0.5) * inv ]
            for [ y: i32 0, y < N, y += 1 ]
                fy : f32 [ (f32[ y ] + 0.5) * inv ]
                for [ x: i32 0, x < N, x += 1 ]
                    fx : f32 [ (f32[ x ] + 0.5) * inv ]
                    p  : f32 [ perlin_fbm3[ fx, fy, fz, 4, 6 ] ]
                    a4  : f32 [ worley3[ fx, fy, fz, 4,  w4 ] ]
                    a8  : f32 [ worley3[ fx, fy, fz, 8,  w8 ] ]
                    a16 : f32 [ worley3[ fx, fy, fz, 16, w16 ] ]
                    a32 : f32 [ worley3[ fx, fy, fz, 32, w32 ] ]
                    a64 : f32 [ worley3[ fx, fy, fz, 64, w64 ] ]
                    wlow : f32 [ a4 * 0.625 + a8 * 0.25 + a16 * 0.125 ]
                    # perlin dilated by worley: billows in the low perlin
                    pw : f32 [ sat[ remap[ p, 0.0, 1.0, wlow, 1.0 ] ] ]
                    i : i32 [ ((z * N + y) * N + x) * 4 ]
                    d[ i ]     = to_byte[ pw ]
                    d[ i + 1 ] = to_byte[ a8 * 0.625 + a16 * 0.25 + a32 * 0.125 ]
                    d[ i + 2 ] = to_byte[ a16 * 0.625 + a32 * 0.25 + a64 * 0.125 ]
                    d[ i + 3 ] = to_byte[ a32 * 0.75 + a64 * 0.25 ]
        img.png[ out ]

    # detail 32^3: worley fbm, three rising frequencies
    func bake_detail [ out: path ]
        N : i32 [ 32 ]
        img : Image [ width: N, height: N * N, format: Pixel.rgba8, linear: true, wrap_u: true, wrap_v: true ]
        d : @u8 [ img.vdata[] ]
        w2  : worley_points[ 2 ]
        w4  : worley_points[ 4 ]
        w8  : worley_points[ 8 ]
        w16 : worley_points[ 16 ]
        inv : f32 [ 1.0 / f32[ N ] ]
        for [ z: i32 0, z < N, z += 1 ]
            fz : f32 [ (f32[ z ] + 0.5) * inv ]
            for [ y: i32 0, y < N, y += 1 ]
                fy : f32 [ (f32[ y ] + 0.5) * inv ]
                for [ x: i32 0, x < N, x += 1 ]
                    fx : f32 [ (f32[ x ] + 0.5) * inv ]
                    a2  : f32 [ worley3[ fx, fy, fz, 2,  w2 ] ]
                    a4  : f32 [ worley3[ fx, fy, fz, 4,  w4 ] ]
                    a8  : f32 [ worley3[ fx, fy, fz, 8,  w8 ] ]
                    a16 : f32 [ worley3[ fx, fy, fz, 16, w16 ] ]
                    i : i32 [ ((z * N + y) * N + x) * 4 ]
                    d[ i ]     = to_byte[ a2 * 0.625 + a4 * 0.25 + a8 * 0.125 ]
                    d[ i + 1 ] = to_byte[ a4 * 0.625 + a8 * 0.25 + a16 * 0.125 ]
                    d[ i + 2 ] = to_byte[ a8 * 0.75 + a16 * 0.25 ]
                    d[ i + 3 ] = to_byte[ 1.0 ]
        img.png[ out ]

    # curl 128^2: rotated gradient of a perlin field (divergence free)
    func bake_curl [ out: path ]
        N : i32 [ 128 ]
        img : Image [ width: N, height: N, format: Pixel.rgba8, linear: true, wrap_u: true, wrap_v: true ]
        d : @u8 [ img.vdata[] ]
        inv : f32 [ 1.0 / f32[ N ] ]
        e : f32 [ inv ]
        for [ y: i32 0, y < N, y += 1 ]
            fy : f32 [ (f32[ y ] + 0.5) * inv ]
            for [ x: i32 0, x < N, x += 1 ]
                fx : f32 [ (f32[ x ] + 0.5) * inv ]
                px1 : f32 [ perlin_fbm3[ fx + e, fy, 0.37, 4, 3 ] ]
                px0 : f32 [ perlin_fbm3[ fx - e, fy, 0.37, 4, 3 ] ]
                py1 : f32 [ perlin_fbm3[ fx, fy + e, 0.37, 4, 3 ] ]
                py0 : f32 [ perlin_fbm3[ fx, fy - e, 0.37, 4, 3 ] ]
                qx1 : f32 [ perlin_fbm3[ fx + e, fy, 0.71, 4, 3 ] ]
                qx0 : f32 [ perlin_fbm3[ fx - e, fy, 0.71, 4, 3 ] ]
                gx : f32 [ (px1 - px0) / (2.0 * e) ]
                gy : f32 [ (py1 - py0) / (2.0 * e) ]
                gz : f32 [ (qx1 - qx0) / (2.0 * e) ]
                i : i32 [ (y * N + x) * 4 ]
                d[ i ]     = to_byte[ gy * 0.08 + 0.5 ]
                d[ i + 1 ] = to_byte[ 0.5 - gx * 0.08 ]
                d[ i + 2 ] = to_byte[ gz * 0.08 + 0.5 ]
                d[ i + 3 ] = to_byte[ 1.0 ]
        img.png[ out ]

    # tops 256^2: the height field. its own perlin section, coarser than
    # coverage, so a cloud's top is half to one and a half times nominal
    func bake_tops [ out: path ]
        N : i32 [ 256 ]
        img : Image [ width: N, height: N, format: Pixel.rgba8, linear: true, wrap_u: true, wrap_v: true ]
        d : @u8 [ img.vdata[] ]
        inv : f32 [ 1.0 / f32[ N ] ]
        for [ y: i32 0, y < N, y += 1 ]
            fy : f32 [ (f32[ y ] + 0.5) * inv ]
            for [ x: i32 0, x < N, x += 1 ]
                fx : f32 [ (f32[ x ] + 0.5) * inv ]
                hv : f32 [ perlin_fbm3[ fx + 0.17, fy + 0.83, 0.41, 3, 3 ] ]
                bv : f32 [ perlin_fbm3[ fx + 0.71, fy + 0.29, 0.62, 5, 2 ] ]
                i : i32 [ (y * N + x) * 4 ]
                d[ i ]     = to_byte[ sat[ remap[ hv, 0.3, 0.7, 0.0, 1.0 ] ] ]
                d[ i + 1 ] = to_byte[ sat[ remap[ bv, 0.35, 0.65, 0.0, 1.0 ] ] ]
                d[ i + 2 ] = to_byte[ 0.5 ]
                d[ i + 3 ] = to_byte[ 1.0 ]
        img.png[ out ]

    # weather 512^2: R perlin coverage field, G perlin-worley islands,
    # B cloud type field, A unused
    func bake_weather [ out: path ]
        N : i32 [ 512 ]
        img : Image [ width: N, height: N, format: Pixel.rgba8, linear: true, wrap_u: true, wrap_v: true ]
        d : @u8 [ img.vdata[] ]
        w3 : worley_points[ 3 ]
        inv : f32 [ 1.0 / f32[ N ] ]
        for [ y: i32 0, y < N, y += 1 ]
            fy : f32 [ (f32[ y ] + 0.5) * inv ]
            for [ x: i32 0, x < N, x += 1 ]
                fx : f32 [ (f32[ x ] + 0.5) * inv ]
                # large air masses times the cloud footprints inside them
                big : f32 [ perlin_fbm3[ fx, fy, 0.11, 2, 2 ] ]
                pf  : f32 [ perlin_fbm3[ fx, fy, 0.53, 4, 5 ] ]
                wf  : f32 [ worley2[ fx, fy, 3, w3 ] ]
                cov : f32 [ sat[ remap[ pf, 0.0, 1.0, big * 0.5 - 0.25, 1.0 ] ] ]
                isl : f32 [ sat[ remap[ pf, 1.0 - wf * 0.9, 1.0, 0.0, 1.0 ] ] ]
                typ : f32 [ perlin_fbm3[ fx + 0.3, fy + 0.7, 0.29, 2, 3 ] ]
                stm : f32 [ perlin_fbm3[ fx + 0.6, fy + 0.2, 0.83, 6, 3 ] ]
                i : i32 [ (y * N + x) * 4 ]
                d[ i ]     = to_byte[ cov ]
                d[ i + 1 ] = to_byte[ isl ]
                d[ i + 2 ] = to_byte[ typ ]
                d[ i + 3 ] = to_byte[ sat[ remap[ stm, 0.40, 0.88, 0.0, 1.0 ] ] ]
        img.png[ out ]

func clouds_bake []
    b : CloudBake [ ]
    b.hold[]
    b.run[]

# bump bake_version whenever CloudBake changes: the stamp hashes
# only the wrapper below
func bake_version [] -> i32
    return 7

export func clouds_export []
    h1 : u64 [ @clouds_bake ]
    bv : i32 [ bake_version[] ]
    stamp : string '{h1}-{bv}'
    sp : path '../clouds/baked/clouds.hash'
    p1 : path '../clouds/baked/shape.png'
    p2 : path '../clouds/baked/detail.png'
    p3 : path '../clouds/baked/curl.png'
    p4 : path '../clouds/baked/weather.png'
    force : getenv[ 'SILVER_EXPORT_FORCE' ]
    if [ !force && sp.exists[] && p1.exists[] && p2.exists[] && p3.exists[] && p4.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            puts 'clouds: noise set current'
            return
    clouds_bake[]
    sp.save[ stamp, null ]

# ---------------------------------------------------------------
# the sky shader: atmosphere + cloud layer, one fullscreen pass
# ---------------------------------------------------------------
ModelViewProject NubisSky
    mutable cam_pos   : vec4f     # xyz metres above ground, w unused
    mutable cam_right : vec4f     # w: tan(half fov) * aspect
    mutable cam_up    : vec4f     # w: tan(half fov)
    mutable cam_fwd   : vec4f     # w: exposure
    mutable sun_dir   : vec4f     # w: sun intensity
    mutable wind      : vec4f     # xyz m/s, w: seconds
    mutable layer     : vec4f     # x cloud bottom, y cloud top, z planet radius, w atmosphere radius
    mutable weather_a : vec4f     # x coverage, y type, z unused, w island mix
    mutable weather_b : vec4f     # x anvil, y skew m, z density, w detail strength
    mutable light_a   : vec4f     # x g forward, y silver intensity, z silver spread, w ambient
    mutable light_b   : vec4f     # x ms scatter, y ms extinction, z ms phase, w extinction / m
    mutable scales    : vec4f     # x shape tile m, y detail tile m, z curl tile m, w weather tile m
    mutable march     : vec4f     # x quality, y curl strength, z max distance, w fog
    mutable tops      : vec4f     # type tops above the base, m: stratus, stratocumulus, cumulus
    mutable world     : vec4f     # xy: how far we have flown, in metres
    mutable key_tint  : vec4f     # rgb: the key light's colour, w: night
    # a strike is a short chain of points inside the cloud: xyz and the
    # power of each. bolt_col carries its colour and how bright it is
    # right now, which is zero for all but a fraction of a second
    mutable bolt_a    : vec4f
    mutable bolt_b    : vec4f
    mutable bolt_c    : vec4f
    mutable bolt_d    : vec4f
    mutable bolt_col  : vec4f
    mutable sea       : vec4f     # x wave count, y choppiness, z foam start, w detail fade m
    mutable sea_b     : vec4f     # x wind m/s, y reflect quality, z swell, w unused
    mutable jitter    : vec4f     # xy: sub-pixel uv offset of this frame's samples
    # x: render an equirect environment instead of the camera view
    mutable env       : vec4f
    mutable view_mode : i32
    mutable frame     : i32

    attrib shape   : LayoutBinding [ type:typeid[ CloudSurface ], id: CloudSurface.shape,   count:1, format: typeid[ rgba8 ], volume: true ]
    attrib detail  : LayoutBinding [ type:typeid[ CloudSurface ], id: CloudSurface.detail,  count:1, format: typeid[ rgba8 ], volume: true ]
    attrib curl    : LayoutBinding [ type:typeid[ CloudSurface ], id: CloudSurface.curl,    count:1, format: typeid[ rgba8 ] ]
    attrib weather : LayoutBinding [ type:typeid[ CloudSurface ], id: CloudSurface.weather, count:1, format: typeid[ rgba8 ] ]
    # distance (in cells of the weather tile / 256) to the nearest cloud island
    attrib island  : LayoutBinding [ type:typeid[ CloudSurface ], id: CloudSurface.island,  count:1, format: typeid[ rgba8 ] ]
    # one Gerstner component per record: xy wave vector, z amplitude, w phase
    attrib envmap  : LayoutBinding [ type:typeid[ CloudSurface ], id: CloudSurface.envmap,  count:1, format: typeid[ rgba8 ] ]
    attrib stars   : LayoutBinding [ type:typeid[ CloudSurface ], id: CloudSurface.stars,   count:1, format: typeid[ rgba8 ] ]
    attrib waves   : StorageBuffer [ type:typeid[ CloudSurface ], id: CloudSurface.waves,   count:1, format: typeid[ vec4f ] ]
    # R: cloud top height scale, G: base height offset
    attrib tvar    : LayoutBinding [ type:typeid[ CloudSurface ], id: CloudSurface.tvar,    count:1, format: typeid[ rgba8 ] ]

    attrib pos       : VertexInput    [ type:typeid[ vec3f ] ]
    attrib uv        : VertexInput    [ type:typeid[ vec2f ] ]
    attrib v_uv      : VertexOutput   [ type:typeid[ vec2f ] ]
    attrib fragColor : FragmentOutput [ type:typeid[ vec4f ] ]

    func init []
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    func vertex [] -> GLSL none {
        v_uv        = uv;
        gl_Position = vec4(pos.x, pos.y, 0.0, 1.0);
    }

    func remap [ v: @f32, lo: @f32, hi: @f32, nlo: @f32, nhi: @f32 ] -> GLSL f32 {
        return nlo + ((v - lo) / (hi - lo)) * (nhi - nlo);
    }

    func hg [ c: @f32, g: @f32 ] -> GLSL f32 {
        float g2 = g * g;
        return (1.0 - g2) / (4.0 * 3.14159265 * pow(1.0 + g2 - 2.0 * g * c, 1.5));
    }

    # near / far hits of a sphere at the origin; (-1,-1) on a miss
    func ray_sphere [ o: @vec3f, d: @vec3f, r: @f32 ] -> GLSL vec2f {
        float b = dot(o, d);
        float c = dot(o, o) - r * r;
        float h = b * b - c;
        if (h < 0.0) return vec2(-1.0);
        float s = sqrt(h);
        return vec2(-b - s, -b + s);
    }

    # single-scatter atmosphere (Rayleigh + Mie) from o along d up to
    # tmax: rgb in-scattered light, a = transmittance
    func atmosphere [ o: @vec3f, d: @vec3f, tmax: @f32 ] -> GLSL vec4f {
        vec3  C  = vec3(0.0, -ubo.layer.z, 0.0);
        float R  = ubo.layer.z;
        float Ra = ubo.layer.w;
        vec3  oc = o - C;
        vec2  ta = ray_sphere(oc, d, Ra);
        if (ta.y < 0.0) return vec4(0.0, 0.0, 0.0, 1.0);
        float t0 = max(ta.x, 0.0);
        float t1 = min(ta.y, tmax);
        if (t1 <= t0) return vec4(0.0, 0.0, 0.0, 1.0);
        vec3  betaR = vec3(9.5e-6, 21.5e-6, 54.0e-6);
        float betaM = 7.0e-6;
        float Hr = 8000.0;
        float Hm = 1200.0;
        vec3  sun = ubo.sun_dir.xyz;
        float mu  = dot(d, sun);
        float phR = 3.0 / (16.0 * 3.14159265) * (1.0 + mu * mu);
        float phM = hg(mu, 0.70);
        // samples cluster toward the camera: along a horizon ray nearly
        // all the air is in the first tens of km, and even spacing there
        // reads as a dark saturated band
        float span = t1 - t0;
        vec3  sumR = vec3(0.0);
        vec3  sumM = vec3(0.0);
        float odR = 0.0;
        float odM = 0.0;
        for (int i = 0; i < 12; i++) {{
            float a0 = float(i) / 12.0;
            float a1 = float(i + 1) / 12.0;
            float s0 = a0 * a0;
            float s1 = a1 * a1;
            float ds = span * (s1 - s0);
            vec3  p  = oc + d * (t0 + span * (s0 + s1) * 0.5);
            float h  = max(length(p) - R, 0.0);
            float hr = exp(-h / Hr) * ds;
            float hm = exp(-h / Hm) * ds;
            odR += hr;
            odM += hm;
            vec2  tl  = ray_sphere(p, sun, Ra);
            float dsl = tl.y / 4.0;
            float olR = 0.0;
            float olM = 0.0;
            for (int j = 0; j < 4; j++) {{
                vec3  q  = p + sun * dsl * (float(j) + 0.5);
                float hq = max(length(q) - R, 0.0);
                olR += exp(-hq / Hr) * dsl;
                olM += exp(-hq / Hm) * dsl;
            }}
            vec3 tau = betaR * (odR + olR) + betaM * 1.1 * (odM + olM);
            vec3 att = exp(-tau);
            sumR += att * hr;
            sumM += att * hm;
        }}
        vec3 L = ubo.sun_dir.w * (sumR * betaR * phR + sumM * betaM * phM);
        vec3 T = exp(-(betaR * odR + betaM * 1.1 * odM));
        float Ta = (T.r + T.g + T.b) / 3.0;
        // multiple scattering stand-in: thick air glows sky-blue, not orange
        float ms_air = clamp(odR * 5.0e-5, 0.0, 1.0);
        L += vec3(0.30, 0.42, 0.92) * ubo.sun_dir.w * 0.034 * ms_air * clamp(sun.y * 3.0 + 0.62, 0.0, 1.0);
        // by night the long horizon path still reddens, but under a moon
        // there is no warm band to see: the sky goes cool and desaturated,
        // over a floor of starlight
        float ng = ubo.key_tint.w;
        if (ng > 0.0) {{
            float lum = dot(L, vec3(0.2126, 0.7152, 0.0722));
            L = mix(L, vec3(lum) * vec3(0.66, 0.82, 1.16), ng);
            L += vec3(0.0016, 0.0022, 0.0044) * ng;
        }}
        return vec4(L, Ta);
    }

    # sunlight reaching p: the sun's transmittance through the air
    func sun_light [ p: @vec3f ] -> GLSL vec3f {
        vec3  C  = vec3(0.0, -ubo.layer.z, 0.0);
        float R  = ubo.layer.z;
        vec3  pc = p - C;
        vec3  sun = ubo.sun_dir.xyz;
        vec2  tl = ray_sphere(pc, sun, ubo.layer.w);
        float dsl = max(tl.y, 0.0) / 6.0;
        float oR = 0.0;
        float oM = 0.0;
        for (int j = 0; j < 6; j++) {{
            vec3  q  = pc + sun * dsl * (float(j) + 0.5);
            float hq = max(length(q) - R, 0.0);
            oR += exp(-hq / 8000.0) * dsl;
            oM += exp(-hq / 1200.0) * dsl;
        }}
        vec3 tau = vec3(9.5e-6, 21.5e-6, 54.0e-6) * oR + 7.0e-6 * 1.1 * oM;
        return exp(-tau) * ubo.sun_dir.w * ubo.key_tint.rgb;
    }

    func height_frac [ p: @vec3f ] -> GLSL f32 {
        float r = length(p - vec3(0.0, -ubo.layer.z, 0.0)) - ubo.layer.z;
        return clamp((r - ubo.layer.x) / (ubo.layer.y - ubo.layer.x), 0.0, 1.0);
    }

    # weather at p: x coverage, y type, z height scale
    func weather_at [ p: @vec3f ] -> GLSL vec3f {
        vec2 uv = (p.xz + ubo.world.xy) / ubo.scales.w + 0.5;
        vec4 w  = texture(weather, uv);
        // fields stretched to 0..1 from the bake's 10th..90th percentiles
        float fr = clamp(remap(w.r, 0.30, 0.72, 0.0, 1.0), 0.0, 1.0);
        float fg = clamp(remap(w.g, 0.0, 0.5, 0.0, 1.0), 0.0, 1.0);
        float field = mix(fr, fg, ubo.weather_a.w);
        float c   = ubo.weather_a.x;
        float cov = clamp(remap(field, 1.0 - c, 1.0 - c + 0.35, 0.0, 1.0), 0.0, 1.0) * 0.95;
        float typ = clamp(remap(w.b, 0.35, 0.72, 0.0, 1.0) * 0.5 + ubo.weather_a.y - 0.25, 0.0, 1.0);
        // a separate perlin field scales each cloud's own height
        float hsc = texture(tvar, p.xz / ubo.scales.w * 3.0 + 0.5).r;
        return vec3(cov, typ, hsc);
    }

    # top of the cloud type at this weather, metres above the base:
    # stratus, stratocumulus, cumulus
    func type_top [ p: @vec3f, w: @vec3f ] -> GLSL f32 {
        float t  = w.y;
        float a  = mix(ubo.tops.x, ubo.tops.y, clamp(t * 2.0, 0.0, 1.0));
        float cu = mix(a, ubo.tops.z, clamp(t * 2.0 - 1.0, 0.0, 1.0));
        // a separate perlin field: this cloud is half to 1.5x as tall
        return cu * mix(0.5, 1.5, w.z);
    }

    # height fraction within this type's own top
    func type_frac [ p: @vec3f, w: @vec3f ] -> GLSL f32 {
        float r = length(p - vec3(0.0, -ubo.layer.z, 0.0)) - ubo.layer.z;
        return clamp((r - ubo.layer.x) / type_top(p, w), 0.0, 1.0);
    }

    # density over height: a sharp condensation level at the base,
    # stratus -> stratocumulus -> cumulus tops
    func height_gradient [ h: @f32, w: @vec3f ] -> GLSL f32 {
        float t  = w.y;
        // cumulus bases are flat at the condensation level, stratus fades in
        float base = clamp(remap(h, 0.0, mix(0.18, 0.05, clamp(t * 1.5, 0.0, 1.0)), 0.0, 1.0), 0.0, 1.0);
        float st = clamp(remap(h, 0.35, 0.75, 1.0, 0.0), 0.0, 1.0);
        float sc = clamp(remap(h, 0.55, 0.9, 1.0, 0.0), 0.0, 1.0);
        float cu = clamp(remap(h, 0.7, 1.0, 1.0, 0.0), 0.0, 1.0);
        float a  = mix(st, sc, clamp(t * 2.0, 0.0, 1.0));
        return base * mix(a, cu, clamp(t * 2.0 - 1.0, 0.0, 1.0));
    }

    # the Nubis density sampler. lod 0 = full detail, 1 = shape only
    func cloud_density [ p: @vec3f, hl: @f32, w: @vec3f, lod: @f32 ] -> GLSL f32 {
        float h = type_frac(p, w);
        // deformation runs on METRES above the base, never on the type
        // fraction: a tall tower would stretch the same shear over its
        // whole column and smear it into wavy fibres
        float hm = length(p - vec3(0.0, -ubo.layer.z, 0.0)) - ubo.layer.z - ubo.layer.x;
        float hd = clamp(hm / 2500.0, 0.0, 1.0);
        vec3 q = p + vec3(ubo.world.x, 0.0, ubo.world.y) + ubo.wind.xyz * ubo.wind.w;
        q += ubo.wind.xyz * (hd * ubo.weather_b.y / max(length(ubo.wind.xyz), 0.01));
        vec4 low = texture(shape, q / ubo.scales.x);
        float lfbm = low.g * 0.625 + low.b * 0.25 + low.a * 0.125;
        // the composite spans 0.71..0.93 in the bake: stretch to 0..1
        float comp = remap(low.r, -(1.0 - lfbm), 1.0, 0.0, 1.0);
        comp = clamp(remap(comp, 0.70, 0.94, 0.0, 1.0), 0.0, 1.0);
        float cov = w.x;
        float profile = height_gradient(h, w) * cov;
        float base = clamp(comp - (1.0 - profile), 0.0, 1.0) * clamp(cov * 1.5, 0.0, 1.0);
        if (base <= 0.0) return 0.0;
        if (lod < 0.5) {{
            vec3 cn = texture(curl, q.xz / ubo.scales.z).rgb * 2.0 - 1.0;
            // curl is a low-level turbulence: it fades out with height
            q += cn * ubo.march.y * (1.0 - hd) * ubo.scales.y * 0.15;
            vec3  hi   = texture(detail, q / ubo.scales.y).rgb;
            float hfbm = hi.r * 0.625 + hi.g * 0.25 + hi.b * 0.125;
            // wispy bottoms, billowy tops; the flat base keeps its edge
            float m = mix(hfbm, 1.0 - hfbm, clamp(hm / 250.0, 0.0, 1.0));
            m *= mix(0.35, 1.0, clamp(h * 6.0, 0.0, 1.0));
            base = remap(base, m * ubo.weather_b.w, 1.0, 0.0, 1.0);
        }}
        // a thin cloud is translucent; a deep one is dense
        return clamp(base, 0.0, 1.0) * ubo.weather_b.z * mix(0.45, 1.2, w.z);
    }

    # optical depth toward the sun: five cone samples and one far
    func light_march [ p: @vec3f ] -> GLSL f32 {
        vec3  sun = ubo.sun_dir.xyz;
        float ls = 225.0;
        vec3 k0 = vec3( 0.38, -0.14,  0.24);
        vec3 k1 = vec3(-0.24,  0.36, -0.12);
        vec3 k2 = vec3( 0.07,  0.32,  0.41);
        vec3 k3 = vec3(-0.44, -0.08,  0.26);
        vec3 k4 = vec3( 0.29, -0.38, -0.30);
        float od = 0.0;
        for (int i = 1; i <= 5; i++) {{
            vec3 k = (i == 1) ? k0 : (i == 2) ? k1 : (i == 3) ? k2 : (i == 4) ? k3 : k4;
            float s = ls * float(i);
            vec3  q = p + sun * s + k * s * 0.45;
            float h = height_frac(q);
            if (h <= 0.0 || h >= 1.0) continue;
            vec3  w = weather_at(q);
            od += cloud_density(q, h, w, (i > 2) ? 1.0 : 0.0) * ls;
        }}
        vec3  qf = p + sun * ls * 9.0;
        float hf = height_frac(qf);
        if (hf > 0.0 && hf < 1.0) od += cloud_density(qf, hf, weather_at(qf), 1.0) * ls * 3.0;
        return od;
    }

    # sunlight transmittance from a ground point up through the layer
    func ground_shadow [ p: @vec3f ] -> GLSL f32 {
        vec3  C  = vec3(0.0, -ubo.layer.z, 0.0);
        vec3  sun = ubo.sun_dir.xyz;
        if (sun.y <= 0.02) return 1.0;
        vec2 t0 = ray_sphere(p - C, sun, ubo.layer.z + ubo.layer.x);
        vec2 t1 = ray_sphere(p - C, sun, ubo.layer.z + ubo.layer.y);
        float ds = (t1.y - t0.y) / 6.0;
        float od = 0.0;
        for (int i = 0; i < 6; i++) {{
            vec3 q = p + sun * (t0.y + ds * (float(i) + 0.5));
            od += cloud_density(q, height_frac(q), weather_at(q), 1.0) * ds;
        }}
        return exp(-od * ubo.light_b.w * 0.3);
    }

    # the galaxy, and only where the sky has gone dark enough to show
    # it. the band is tilted off the horizon and turns with the hours
    func night_stars [ d: @vec3f ] -> GLSL vec3f {
        float ng = ubo.key_tint.w;
        if (ng <= 0.001) return vec3(0.0);
        float ca = 0.6216;
        float sa = 0.7833;
        vec3  r  = vec3(d.x, d.y * ca - d.z * sa, d.y * sa + d.z * ca);
        float u  = atan(r.z, r.x) * 0.15915494 + 0.5 + ubo.sea_b.w;
        float v  = acos(clamp(r.y, -1.0, 1.0)) * 0.31830989;
        vec3  c  = texture(stars, vec2(u, v)).rgb;
        // squaring holds the band and drops the wash between the stars.
        // low in the sky there is too much air to see any of it
        float up = smoothstep(0.03, 0.70, d.y);
        return c * c * ng * 0.05 * up;
    }

    # light arriving at a point from the strike: the chain lights the
    # cloud around it, falling off with distance from each point
    func bolt_at [ p: @vec3f ] -> GLSL vec3f {
        if (ubo.bolt_col.w <= 0.0) return vec3(0.0);
        vec3  da = ubo.bolt_a.xyz - p;
        vec3  db = ubo.bolt_b.xyz - p;
        vec3  dc = ubo.bolt_c.xyz - p;
        vec3  dd = ubo.bolt_d.xyz - p;
        // the cloud swallows the flash within a few hundred metres, so
        // what lights up is the cell around the channel, not the deck
        float ra = length(da);
        float rb = length(db);
        float rc = length(dc);
        float rd = length(dd);
        float e  = ubo.bolt_a.w * exp(-ra / 500.0) / (ra * ra + 900.0)
                 + ubo.bolt_b.w * exp(-rb / 500.0) / (rb * rb + 900.0)
                 + ubo.bolt_c.w * exp(-rc / 500.0) / (rc * rc + 900.0)
                 + ubo.bolt_d.w * exp(-rd / 500.0) / (rd * rd + 900.0);
        // inside a cloud the flash does not stay a point: it scatters.
        // it still has to sit under the sky it lights, not blow it out
        return ubo.bolt_col.rgb * (e * ubo.bolt_col.w);
    }

    func aces [ x: @vec3f ] -> GLSL vec3f {
        return clamp((x * (2.51 * x + 0.03)) / (x * (2.43 * x + 0.59) + 0.14), 0.0, 1.0);
    }

    # the sea surface: a sum of spectral components (JONSWAP frequency
    # spectrum, Donelan-Banner spreading) as Gerstner waves. returns the
    # displacement: xz sideways, y up
    func ocean_disp [ q: @vec2f, n: @f32, kmax: @f32 ] -> GLSL vec3f {
        vec3  D = vec3(0.0);
        float t = ubo.wind.w;
        float Q = ubo.sea.y;
        for (int i = 0; i < 128; i++) {{
            if (float(i) >= n) break;
            vec4  wv = waves[i];
            float k  = length(wv.xy);
            // a wave does not vanish the moment it passes under a pixel:
            // it fades out across its own range of distances, or the
            // levels step as the footprint grows. sorted long to short,
            // so once one is gone the rest are too
            float wl = smoothstep(kmax * 2.0, kmax * 0.5, k);
            if (wl <= 0.002) break;
            float om = sqrt(9.81 * k);
            float a  = dot(wv.xy, q + ubo.world.xy) - om * t + wv.w;
            float amp = wv.z * wl;
            D.y  += amp * cos(a);
            D.xz -= (wv.xy / k) * (amp * Q * sin(a));
        }}
        return D;
    }

    # normal and folding of the same surface. w carries the Jacobian:
    # below 1 the surface is compressing, and that is where foam is
    func ocean_ndj [ q: @vec2f, n: @f32, kmax: @f32 ] -> GLSL vec4f {
        float t = ubo.wind.w;
        float Q = ubo.sea.y;
        float hx = 0.0;
        float hz = 0.0;
        float jxx = 0.0;
        float jzz = 0.0;
        float jxz = 0.0;
        for (int i = 0; i < 128; i++) {{
            if (float(i) >= n) break;
            vec4  wv = waves[i];
            float k  = length(wv.xy);
            // the same fade the displacement uses, so slope and shape
            // stay in step as the levels blend
            float wl = smoothstep(kmax * 2.0, kmax * 0.5, k);
            if (wl <= 0.002) break;
            float om = sqrt(9.81 * k);
            float a  = dot(wv.xy, q + ubo.world.xy) - om * t + wv.w;
            float sa = sin(a);
            float ca = cos(a);
            float amp = wv.z * wl;
            hx  -= amp * wv.x * sa;
            hz  -= amp * wv.y * sa;
            float qa = Q * amp * ca / k;
            jxx -= qa * wv.x * wv.x;
            jzz -= qa * wv.y * wv.y;
            jxz -= qa * wv.x * wv.y;
        }}
        vec3 nrm = normalize(vec3(-hx, 1.0, -hz));
        float J  = (1.0 + jxx) * (1.0 + jzz) - jxz * jxz;
        return vec4(nrm, J);
    }

    func fragment [] -> GLSL none {
        vec2  uvj = v_uv + ubo.jitter.xy;
        vec2  ndc = vec2(uvj.x * 2.0 - 1.0, 1.0 - uvj.y * 2.0);
        vec3  o   = ubo.cam_pos.xyz;
        vec3  d   = normalize(ubo.cam_fwd.xyz + ubo.cam_right.xyz * (ndc.x * ubo.cam_right.w) + ubo.cam_up.xyz * (ndc.y * ubo.cam_up.w));
        // the environment pass walks the whole sky instead of the frame:
        // longitude across, latitude down, so the sea can sample it
        if (ubo.env.x > 0.5) {{
            float lon = (v_uv.x * 2.0 - 1.0) * 3.14159265;
            float lat = (0.5 - v_uv.y) * 3.14159265;
            float cl  = cos(lat);
            d = vec3(cl * sin(lon), sin(lat), cl * cos(lon));
        }}
        vec3  C   = vec3(0.0, -ubo.layer.z, 0.0);
        float R   = ubo.layer.z;
        vec3  sun = ubo.sun_dir.xyz;
        float mu  = dot(d, sun);
        // per-pixel, per-frame jitter for the march start
        float jit = fract(52.9829189 * fract(dot(gl_FragCoord.xy + float(ubo.frame % 8) * 5.588238, vec2(0.06711056, 0.00583715))));

        // ground
        vec2  tg = ray_sphere(o - C, d, R);
        bool  ground = tg.y > 0.0 && tg.x > 0.0 && ubo.env.x < 0.5;
        float t_ground = ground ? tg.x : 1e12;

        // sky behind everything
        vec4 sky = atmosphere(o, d, t_ground);
        vec3 bg  = sky.rgb;
        if (!ground) {{
            float sd = smoothstep(0.99985, 0.99995, mu);
            bg += vec3(1.0, 0.96, 0.9) * sd * sky.a * ubo.sun_dir.w * 0.5;
            // stars sit behind the air, so the haze thins them out
            bg += night_stars(d) * sky.a;
        }} else {{
            vec3  gp  = o + d * tg.x;
            vec3  up  = normalize(gp - C);
            vec3  up0 = normalize(o - C);
            float ch0 = length(o - C) - R;
            vec3  sc  = sun_light(gp);
            float sh  = ground_shadow(gp);
            // a wave shorter than a few pixels can only alias: cut the
            // spectrum at the pixel footprint and carry what is left as
            // surface roughness instead
            float fp   = max(tg.x * ubo.sea_b.z, 0.02);
            float kmax = 6.2831853 / (fp * 8.0);
            // the waves give way to the flat surface as soon as they
            // stop covering pixels: by a few km there is nothing left to
            // resolve, and holding onto them there is what aliases
            float fade = clamp(1.0 - fp / 32.0, 0.0, 1.0);
            vec3  disp = ocean_disp(gp.xz, ubo.sea.x, kmax);
            vec4  ndj  = ocean_ndj(gp.xz, ubo.sea.x, kmax);
            // close in the waves carry the reflection; far out they are
            // under a pixel, so the flat surface normal takes over and
            // what is left of them widens the specular lobe instead
            vec3  n    = normalize(mix(up, ndj.xyz, fade));
            vec3  V    = -d;
            // whitecaps break where the surface folds over itself, and
            // only once the wind is strong enough to tear the crests
            float wind_f = smoothstep(6.0, 16.0, ubo.sea_b.x);
            float foam = clamp((ubo.sea.z - ndj.w) * 1.6, 0.0, 1.0);
            float crest = smoothstep(0.95, 1.5, disp.y * fade / max(ubo.sea_b.x * 0.16, 0.25));
            foam = clamp(foam + crest * 0.5, 0.0, 1.0) * wind_f;
            // break the sheet up so it never reads as paint
            vec3  fuv = vec3((gp.xz + ubo.world.xy) * 0.0037, ubo.wind.w * 0.006);
            float fn  = texture(detail, fuv).r * 0.5 + texture(detail, fuv * 5.3 + 0.37).g * 0.5;
            // foam belongs to waves we can still resolve: kept at any
            // distance it reads as white speckle on the flat sea
            foam = clamp(foam * (0.15 + 1.5 * fn) - 0.12, 0.0, 1.0) * fade;
            // the mirror normal settles to the water's up direction
            // sooner than the shading one: a reflected ray swings twice
            // as fast as the surface tilts. EVERYTHING mirror-like reads
            // off this — the direction AND the Fresnel, which at grazing
            // angles flips between sky and water with the least tilt and
            // is what aliases along the ripples
            // with a filtered environment map behind it the reflection can
            // follow the waves again: what used to alias is now handled by
            // the mip the roughness picks
            vec3  nr = normalize(mix(up, ndj.xyz, fade));
            // the waves we dropped still scatter: they widen the lobe
            float e_rough = mix(0.06, 0.22, clamp(ubo.sea_b.x / 20.0, 0.0, 1.0)) + clamp(fp * 0.01, 0.0, 0.22);
            float ndl = max(dot(n, sun), 0.0);
            float ndv = max(dot(nr, V), 0.0);
            float F = 0.02 + 0.98 * pow(1.0 - ndv, 5.0);
            vec3  Rd = reflect(d, nr);
            if (dot(Rd, up) < 0.0004) Rd = normalize(Rd + up * (0.0004 - dot(Rd, up)));
            // the sky was already drawn once into an environment map with
            // a mip chain: sampling that lets the hardware filter the
            // reflection (anisotropically, along the ray's own footprint)
            // instead of marching it per pixel and aliasing
            vec2  euv = vec2(atan(Rd.x, Rd.z) * 0.15915494 + 0.5,
                             0.5 - asin(clamp(Rd.y, -1.0, 1.0)) * 0.31830989);
            // an explicit level turns anisotropic filtering OFF and the
            // levels show as bands. hand the sampler the footprint of
            // this pixel's reflection instead — widened by how rough the
            // water is — and it blends across levels along that axis
            vec2  ex = dFdx(euv);
            vec2  ey = dFdy(euv);
            // the map wraps in longitude: a step across the seam is not
            // a step across the map
            if (abs(ex.x) > 0.5) ex.x -= sign(ex.x);
            if (abs(ey.x) > 0.5) ey.x -= sign(ey.x);
            float cone = e_rough * 0.12;
            ex = clamp(ex, vec2(-0.25), vec2(0.25)) + vec2(cone, cone * 0.5);
            ey = clamp(ey, vec2(-0.25), vec2(0.25)) + vec2(cone * 0.5, cone);
            vec3  rf = pow(textureGrad(envmap, euv, ex, ey).rgb, vec3(2.2)) * 1.15;
            // the sun's own reflection: a rough mirror lobe on the slopes
            vec3  H  = normalize(Rd + sun);
            float rough = e_rough;
            float a2 = rough * rough * rough * rough;
            float dh = max(dot(nr, normalize(V + sun)), 0.0);
            float dd = dh * dh * (a2 - 1.0) + 1.0;
            float spec = a2 / (3.14159265 * dd * dd);
            rf += sc * sh * spec * 0.6;
            // what comes back up out of the water: sky light scattered in
            // the top metres, greener where a crest is thin and lit
            vec3  deep = vec3(0.004, 0.016, 0.031);
            // the crest colour has to fade with the waves themselves,
            // or the flat distance still ripples through its shading
            vec3  sss  = vec3(0.02, 0.10, 0.09) * (0.4 + 0.6 * clamp(disp.y * fade * 0.35 + 0.5, 0.0, 1.0));
            vec3  skyl = atmosphere(gp, up, 1e12).rgb + vec3(0.016, 0.020, 0.034) * ubo.key_tint.w
                       + bolt_at(gp) * 0.5;
            vec3  wat  = deep * skyl * 6.0 + sss * (sc * sh * max(sun.y, 0.0) * 0.35 + skyl * 0.6);
            vec3  gc   = mix(wat, rf, F);
            // the sea has to sink into the sky just above the horizon,
            // or it ends at a hard line there. how far out the horizon
            // sits depends on how high we are, so the fade follows that
            // marine haze sits in a layer near the surface, so how much
            // of it a ray crosses depends on how steeply it looks down,
            // not just how far it goes: from up high the near sea stays
            // clear while the horizon still dissolves
            float up0d = max(-dot(d, up0), 1e-4);
            float hz_H = 1000.0;
            float tau  = (hz_H / up0d) * (1.0 - exp(-ch0 / hz_H)) * 1.0e-4;
            float wf   = 1.0 - exp(-tau);
            // the sky the sea has to match is the sky AT the horizon,
            // which sits BELOW horizontal by the dip angle — mirroring
            // the ray about the horizontal aimed too high and left a
            // one-pixel crease along the horizon line
            float dip  = sqrt(max(2.0 * ch0 / R, 1e-12));
            float ev   = dot(d, up0);
            vec3  hzd  = normalize(d + up0 * (max(ev, 0.0002 - dip) - ev));
            vec3  fogc = atmosphere(o, hzd, 1e12).rgb;
            // foam sits on top: lit by sun and sky, not a mirror
            vec3  fc   = (sc * sh * ndl * 0.30 + skyl * 0.85) * 0.55;
            gc = mix(gc, fc, foam);
            // the haze goes on AFTER the aerial perspective, or the far
            // sea ends up brighter than the sky it is dissolving into
            bg = mix(gc * sky.a + sky.rgb, fogc, wf);
            if (ubo.view_mode == 4) bg = vec3(fade, wf, 0.0);
        }}

        // the cloud layer shells
        float r1 = R + ubo.layer.x;
        float r2 = R + ubo.layer.y;
        vec2  ti = ray_sphere(o - C, d, r1);
        vec2  to = ray_sphere(o - C, d, r2);
        float rc = length(o - C);
        float t_start = -1.0;
        float t_end   = -1.0;
        if (rc < r1) {{
            if (!ground) {{ t_start = ti.y; t_end = to.y; }}
        }} else if (rc < r2) {{
            t_start = 0.0;
            t_end   = (ti.x > 0.0) ? ti.x : to.y;
        }} else {{
            if (to.x > 0.0) {{ t_start = to.x; t_end = (ti.x > 0.0) ? ti.x : to.y; }}
        }}
        if (ground) t_end = min(t_end, t_ground);
        t_end = min(t_end, t_start + ubo.march.z);

        vec3  col = vec3(0.0);
        float T   = 1.0;
        float depth = -1.0;
        float steps_taken = 0.0;
        if (t_start >= 0.0 && t_end > t_start) {{
            float fine   = (6.0 + t_start * 0.01) / ubo.march.x;
            float coarse = fine * 3.0;
            float t = t_start + jit * fine;
            bool  in_cloud = false;
            int   zeros = 0;
            vec3  sun_c = vec3(-1.0);
            vec3  amb_top = vec3(0.0);
            vec3  amb_bot = vec3(0.0);
            float sigma = ubo.light_b.w;
            float ga = ubo.light_a.x;
            for (int i = 0; i < 512; i++) {{
                if (t > t_end || T < 0.004) break;
                fine   = (6.0 + t * 0.01) / ubo.march.x;
                coarse = fine * 3.0;
                vec3  p = o + d * t;
                float h = height_frac(p);
                vec3  w = weather_at(p);
                steps_taken += 1.0;
                if (!in_cloud) {{
                    // outside an island: leap by the island distance field
                    float isd = texture(island, (p.xz + ubo.world.xy) / ubo.scales.w + 0.5).r * 255.0 - 1.5;
                    if (isd > 0.0) {{
                        float leap = isd * (ubo.scales.w / 256.0) / max(length(d.xz), 0.02);
                        t += max(leap, coarse);
                        continue;
                    }}
                    float dl = cloud_density(p, h, w, 1.0);
                    if (dl > 0.0) {{
                        in_cloud = true;
                        t = max(t - coarse, t_start);
                        continue;
                    }}
                    t += coarse;
                    continue;
                }}
                float dens = cloud_density(p, h, w, 0.0);
                // fade out toward the march cap so no cut face shows
                dens *= clamp((t_start + ubo.march.z - t) / 8000.0, 0.0, 1.0);
                if (dens <= 0.0) {{
                    zeros += 1;
                    if (zeros > 8) {{ in_cloud = false; zeros = 0; }}
                    t += fine;
                    continue;
                }}
                zeros = 0;
                if (sun_c.x < 0.0) {{
                    // lit once per pixel at the first cloud sample
                    sun_c   = sun_light(p);
                    vec3 upv = normalize(p - C);
                    amb_top = atmosphere(p, upv, 1e12).rgb + vec3(0.016, 0.020, 0.034) * ubo.key_tint.w;
                    amb_bot = sun_c * max(sun.y, 0.0) * 0.05 * vec3(0.30, 0.31, 0.33) + amb_top * 0.35;
                }}
                float ext = sigma;
                float od  = light_march(p) * ext;
                // Nubis in-scatter probability: dark edges, dark bottoms
                float ht = type_frac(p, w);
                float lod_d = cloud_density(p, h, w, 1.0);
                float depth_p = 0.05 + pow(clamp(lod_d, 0.0, 1.0), clamp(remap(ht, 0.3, 0.85, 0.5, 2.0), 0.5, 2.0));
                float vert_p  = pow(clamp(remap(ht, 0.07, 0.14, 0.1, 1.0), 0.1, 1.0), 0.8);
                // how much light reaches this point at all: it occludes
                // the sky ambient wherever we are deep in the cloud
                float occ     = depth_p * vert_p;
                // the dark-edge (powder) look only shows with the sun
                // behind us. backlit, a thin edge passes the sun straight
                // through while the thick middle stays dark: silver lining
                float inscat  = mix(1.0, occ, clamp(0.5 - mu * 0.5, 0.0, 1.0));
                // three octaves of multiple scattering (Wrenninge / Frostbite)
                vec3  direct = vec3(0.0);
                float oa = 1.0;
                float ob = 1.0;
                float oc = 1.0;
                for (int k = 0; k < 3; k++) {{
                    float ph = mix(hg(mu, ga * oc), hg(mu, -0.25 * oc), 0.3);
                    ph = max(ph, ubo.light_a.y * hg(mu, (0.99 - ubo.light_a.z) * oc));
                    direct += exp(-od * ob) * ph * oa;
                    oa *= ubo.light_b.x;
                    ob *= ubo.light_b.y;
                    oc *= ubo.light_b.z;
                }}
                direct *= sun_c * inscat;
                // the strike lights the cloud from the inside
                direct += bolt_at(p);
                // ambient: the sky from above, the ground from below,
                // attenuated by the cloud still overhead — that is what
                // keeps a thick middle dark while its edges pass light
                float above = (1.0 - ht) * type_top(p, w) * lod_d;
                float amb_t = exp(-above * ext * 0.15);
                vec3  amb   = mix(amb_bot, amb_top, ht) * amb_t * ubo.light_a.w;
                vec3  S    = (direct + amb) * dens * ext;
                float e    = max(dens * ext, 1e-6);
                float Ts   = exp(-e * fine);
                col += T * (S - S * Ts) / e;
                T   *= Ts;
                if (depth < 0.0 && T < 0.5) depth = t;
                t += fine;
            }}
        }}
        if (depth < 0.0) depth = t_start;
        // aerial perspective: the air between us and the cloud
        if (T < 0.995 && depth > 0.0) {{
            vec4 ap = atmosphere(o, d, depth);
            col = col * ap.a + ap.rgb * (1.0 - T);
            // Nubis: the far band dissolves into the horizon haze
            float far = clamp((depth - 25000.0) / 40000.0, 0.0, 1.0);
            col = mix(col, bg * (1.0 - T), far);
        }}
        vec3 final = col + T * bg;

        if (ubo.view_mode == 1) final = vec3(1.0 - T);
        if (ubo.view_mode == 2) final = mix(vec3(0.0, 0.05, 0.3), vec3(1.0, 0.3, 0.0), steps_taken / 200.0);
        vec3 tm = (ubo.view_mode == 0) ? aces(final * ubo.cam_fwd.w) : clamp(final, 0.0, 1.0);
        // alpha carries the cloud depth for the temporal reprojection
        float dn = (depth > 0.0) ? clamp(depth / 60000.0, 0.0, 1.0) : 1.0;
        fragColor = vec4(pow(tm, vec3(1.0 / 2.2)), (ubo.jitter.z > 0.5) ? 1.0 : dn);
    }

# ---------------------------------------------------------------
# temporal upsampling: the half-res jittered pass accumulates into a
# full-res history reprojected by the camera rotation (Nubis 2015:
# a fraction of the pixels per frame, the rest reprojected)
# ---------------------------------------------------------------
enum TemporalSurface
    fresh   : 0
    history : 1

ModelViewProject TemporalCompose
    mutable cam_right  : vec4f    # w: tan(half fov) * aspect
    mutable cam_up     : vec4f    # w: tan(half fov)
    mutable cam_fwd    : vec4f
    mutable prev_right : vec4f
    mutable prev_up    : vec4f
    mutable prev_fwd   : vec4f
    mutable jitter     : vec4f    # xy: uv offset the fresh pass used, zw: fresh texel size
    mutable blend      : vec4f    # x: history weight, y: history valid
    mutable cam_pos    : vec4f
    mutable prev_pos   : vec4f

    attrib fresh   : LayoutBinding [ type:typeid[ TemporalSurface ], id: TemporalSurface.fresh,   count:1, format: typeid[ rgba8 ] ]
    attrib history : LayoutBinding [ type:typeid[ TemporalSurface ], id: TemporalSurface.history, count:1, format: typeid[ rgba8 ] ]

    attrib pos       : VertexInput    [ type:typeid[ vec3f ] ]
    attrib uv        : VertexInput    [ type:typeid[ vec2f ] ]
    attrib v_uv      : VertexOutput   [ type:typeid[ vec2f ] ]
    attrib fragColor : FragmentOutput [ type:typeid[ vec4f ] ]

    func init []
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    func vertex [] -> GLSL none {
        v_uv        = uv;
        gl_Position = vec4(pos.x, pos.y, 0.0, 1.0);
    }

    func fragment [] -> GLSL none {
        vec2  ndc = vec2(v_uv.x * 2.0 - 1.0, 1.0 - v_uv.y * 2.0);
        vec3  d   = normalize(ubo.cam_fwd.xyz + ubo.cam_right.xyz * (ndc.x * ubo.cam_right.w) + ubo.cam_up.xyz * (ndc.y * ubo.cam_up.w));
        // the fresh texel at uv holds the ray at uv + jitter: read back by it
        vec2  fuv = v_uv - ubo.jitter.xy;
        vec2  ts  = ubo.jitter.zw;
        vec4  f4  = texture(fresh, fuv);
        vec3  f   = f4.rgb;
        // the neighbourhood's own spread decides how far the history may
        // stray: tight where the sky is flat, wide across a cloud edge,
        // so old samples still accumulate into the edges instead of
        // aliasing, while a stale one in open sky is cut
        vec3  m1  = vec3(0.0);
        vec3  m2  = vec3(0.0);
        for (int j = -1; j <= 1; j++)
            for (int i = -1; i <= 1; i++) {{
                vec3 n = texture(fresh, fuv + vec2(float(i), float(j)) * ts).rgb;
                m1 += n;
                m2 += n * n;
            }}
        vec3  mu  = m1 / 9.0;
        vec3  sg  = sqrt(max(m2 / 9.0 - mu * mu, vec3(0.0)));
        vec3  mn  = mu - 1.4 * sg;
        vec3  mx  = mu + 1.4 * sg;
        // where did this cloud point fall last frame (depth from the fresh alpha)
        vec3  wp = ubo.cam_pos.xyz + d * (f4.a * 60000.0);
        vec3  pd = normalize(wp - ubo.prev_pos.xyz);
        float pz = dot(pd, ubo.prev_fwd.xyz);
        vec3  out_c = f;
        if (pz > 0.0 && ubo.blend.y > 0.5) {{
            vec2 pn = vec2(dot(pd, ubo.prev_right.xyz) / (pz * ubo.prev_right.w), dot(pd, ubo.prev_up.xyz) / (pz * ubo.prev_up.w));
            vec2 puv = vec2(pn.x * 0.5 + 0.5, 0.5 - pn.y * 0.5);
            if (puv.x > 0.0 && puv.x < 1.0 && puv.y > 0.0 && puv.y < 1.0) {{
                vec3 h = texture(history, puv).rgb;
                // a loose clamp lets a stale sample survive where the
                // cloud has moved on: that is what leaves streaks
                h = clamp(h, mn, mx);
                out_c = mix(h, f, ubo.blend.x);
            }}
        }}
        fragColor = vec4(out_c, 1.0);
    }

# ---------------------------------------------------------------
# weather states: the Nubis preset set, blended over seconds
# ---------------------------------------------------------------
class WeatherState
    public name      : string
    public coverage  : f32
    public ctype     : f32
    public island    : f32
    public anvil     : f32
    public skew      : f32
    public density   : f32
    public detail    : f32
    public wind      : f32
    public sun_el    : f32
    public sun_az    : f32

# the view: owns the textures and the render target
element SkyView
    style : CSS {
        area: l0 t0 r0 b0
    }
    public yaw       : f32
    public pitch     : f32
    public cam_h     : f32 [ 2.0 ]
    public cam_x     : f32
    public cam_z     : f32
    public exposure  : f32 [ 1.0 ]
    public quality   : f32 [ 1.0 ]
    public view_mode : i32
    public wscale    : f32 [ 0.5 ]
    public night     : f32
    public speed     : f32
    public bolts     : f32 [ 1.0 ]
    mutable last_dt  : f32 [ 0.016 ]
    public seconds   : f32
    public temporal  : bool [ true ]
    public cur       : WeatherState
    mutable sky      : NubisSky
    mutable vmodel   : Model
    mutable vrender  : Render
    mutable comp_a   : TemporalCompose
    mutable comp_b   : TemporalCompose
    mutable hist_a   : Render
    mutable hist_b   : Render
    mutable model_a  : Model
    mutable model_b  : Model
    mutable prev_right : vec4f
    mutable prev_up    : vec4f
    mutable prev_fwd   : vec4f
    mutable prev_pos   : vec4f
    mutable hist_valid : bool
    mutable tx_shape : Texture
    mutable tx_detail: Texture
    mutable tx_curl  : Texture
    mutable tx_weather : Texture
    mutable tx_tvar    : Texture
    mutable tx_island  : Texture
    mutable tx_stars   : Texture
    mutable env_model  : Model
    mutable env_render : Render
    mutable wave_buf   : Buffer
    mutable wave_n     : i32
    mutable wave_wind  : f32 [ -1.0 ]
    mutable bolt       : vec f32
    mutable bolt_t     : f32
    mutable bolt_dur   : f32 [ 0.55 ]
    mutable bolt_wait  : f32 [ 0.5 ]
    mutable bolt_dark  : f32
    mutable wseed      : u32 [ 987654321 ]
    mutable old_islands : vec Texture
    mutable wimg     : Image
    mutable timg     : Image
    mutable frame    : i32
    mutable last_secs : f32
    mutable gpu_ms   : f32
    mutable isl_cov  : f32 [ -1.0 ]
    mutable isl_mix  : f32
    mutable isl_secs : f32 [ -10.0 ]
    mutable edt_v    : vec i32
    mutable edt_z    : vec f32
    mutable edt_f    : vec f32
    mutable edt_d    : vec f32

    func sat [ v: f32 ] -> f32
        return (v < 0.0) ? 0.0 : ((v > 1.0) ? 1.0 : v)

    func remap [ v: f32, lo: f32, hi: f32, nlo: f32, nhi: f32 ] -> f32
        return nlo + ((v - lo) / (hi - lo)) * (nhi - nlo)

    # 1D squared distance transform (Felzenszwalb-Huttenlocher)
    func edt1d [ n: i32 ]
        k : i32 [ 0 ]
        edt_v[ 0 ] = 0
        edt_z[ 0 ] = -1e20
        edt_z[ 1 ] = 1e20
        for [ q: i32 1, q < n, q += 1 ]
            fq : f32 [ f32[ q ] ]
            s : f32 [ 0.0 ]
            while [ true ]
                vi : i32 [ edt_v[ k ] ]
                fv : f32 [ f32[ vi ] ]
                s = ((edt_f[ q ] + fq * fq) - (edt_f[ vi ] + fv * fv)) / (2.0 * fq - 2.0 * fv)
                if [ s <= edt_z[ k ] && k > 0 ]
                    k = k - 1
                el
                    break
            k += 1
            edt_v[ k ] = q
            edt_z[ k ] = s
            edt_z[ k + 1 ] = 1e20
        k = 0
        for [ q: i32 0, q < n, q += 1 ]
            fq : f32 [ f32[ q ] ]
            while [ edt_z[ k + 1 ] < fq ] k += 1
            vi : i32 [ edt_v[ k ] ]
            fv : f32 [ f32[ vi ] ]
            edt_d[ q ] = (fq - fv) * (fq - fv) + edt_f[ vi ]

    # the island map: where the weather field, thresholded by the
    # current coverage, has cloud. distance in cells, wrapped
    func build_island [ vkc: vk_context, win: Window ]
        N : i32 [ 256 ]
        if [ !edt_v ]
            edt_v = vec i32 [ N * 3 + 2 ]
            edt_z = vec f32 [ N * 3 + 2 ]
            edt_f = vec f32 [ N * 3 ]
            edt_d = vec f32 [ N * 3 ]
        wd : @u8 [ wimg.vdata[] ]
        ww : i32 [ wimg.width ]
        c  : f32 [ cur.coverage ]
        mask : vec f32 [ N * N ]
        for [ y: i32 0, y < N, y += 1 ]
            for [ x: i32 0, x < N, x += 1 ]
                inside : bool [ false ]
                # max over the 2x2 source pixels: conservative
                for [ sy: i32 0, sy < 2, sy += 1 ]
                    for [ sx: i32 0, sx < 2, sx += 1 ]
                        px : i32 [ (x * 2 + sx) % ww ]
                        py : i32 [ (y * 2 + sy) % ww ]
                        i : i32 [ (py * ww + px) * 4 ]
                        r : f32 [ f32[ wd[ i ] ] / 255.0 ]
                        g : f32 [ f32[ wd[ i + 1 ] ] / 255.0 ]
                        fr : f32 [ sat[ remap[ r, 0.30, 0.72, 0.0, 1.0 ] ] ]
                        fg : f32 [ sat[ remap[ g, 0.0, 0.5, 0.0, 1.0 ] ] ]
                        field : f32 [ fr + (fg - fr) * cur.island ]
                        cov : f32 [ sat[ remap[ field, 1.0 - c, 1.0 - c + 0.35, 0.0, 1.0 ] ] ]
                        if [ cov > 0.002 ] inside = true
                mask[ y * N + x ] = (inside) ? 0.0 : 1e10
        # rows, tripled for the wrap
        for [ y: i32 0, y < N, y += 1 ]
            for [ x: i32 0, x < N * 3, x += 1 ] edt_f[ x ] = mask[ y * N + (x % N) ]
            edt1d[ N * 3 ]
            for [ x: i32 0, x < N, x += 1 ] mask[ y * N + x ] = edt_d[ N + x ]
        # columns
        for [ x: i32 0, x < N, x += 1 ]
            for [ y: i32 0, y < N * 3, y += 1 ] edt_f[ y ] = mask[ (y % N) * N + x ]
            edt1d[ N * 3 ]
            for [ y: i32 0, y < N, y += 1 ] mask[ y * N + x ] = edt_d[ N + y ]
        im : Image [ width: N, height: N, format: Pixel.rgba8, linear: true, wrap_u: true, wrap_v: true ]
        im.hold[]
        d : @u8 [ im.vdata[] ]
        for [ i: i32 0, i < N * N, i += 1 ]
            dist : f32 [ sqrt[ mask[ i ] ] ]
            if [ dist > 255.0 ] dist = 255.0
            d[ i * 4 ]     = u8[ i32[ dist ] ]
            d[ i * 4 + 1 ] = u8[ i32[ dist ] ]
            d[ i * 4 + 2 ] = u8[ i32[ dist ] ]
            d[ i * 4 + 3 ] = u8[ 255 ]
        if [ tx_island ]
            if [ !old_islands ] old_islands = vec Texture []
            old_islands += tx_island
        tx_island = Texture [ vk: vkc, w: win, sampler: im, mip_levels: 1, linear: true, wrap_u: true, wrap_v: true ]
        tx_island.hold[]
        isl_cov   = c
        isl_mix   = cur.island
        isl_secs  = seconds

    func wrnd [] -> f32
        wseed = wseed * 1664525 + 1013904223
        return f32[ wseed >> 8 ] / 16777216.0

    # JONSWAP: the deep-water frequency spectrum for a wind of U over a
    # fetch of F metres (Hasselmann 1973, as used by Arc Blanc 2025)
    func omega_p [ wind: f32 ] -> f32
        U : f32 [ (wind < 0.5) ? 0.5 : wind ]
        return 22.0 * pow[ 9.81 * 9.81 / (U * 100000.0), 0.33333 ]

    func jonswap [ om: f32, wind: f32 ] -> f32
        U : f32 [ (wind < 0.5) ? 0.5 : wind ]
        al : f32 [ 0.076 * pow[ U * U / (100000.0 * 9.81), 0.22 ] ]
        omp : f32 [ omega_p[ wind ] ]
        sg : f32 [ (om <= omp) ? 0.07 : 0.09 ]
        dd : f32 [ om - omp ]
        r : f32 [ exp[ 0.0 - dd * dd / (2.0 * sg * sg * omp * omp) ] ]
        return al * 9.81 * 9.81 / pow[ om, 5.0 ] * exp[ 0.0 - 1.25 * pow[ omp / om, 4.0 ] ] * pow[ 3.3, r ]

    # Donelan-Banner directional spreading: how tightly the waves of a
    # given frequency hold the wind's direction
    func db_beta [ rw: f32 ] -> f32
        if [ rw < 0.95 ] return 2.61 * pow[ rw, 1.3 ]
        if [ rw < 1.6 ]  return 2.28 * pow[ rw, 0.0 - 1.3 ]
        eps : f32 [ 0.8393 * exp[ 0.0 - 0.567 * log[ rw * rw ] ] - 0.4 ]
        return pow[ 10.0, eps ]

    func sech2 [ x: f32 ] -> f32
        ax : f32 [ (x < 0.0) ? 0.0 - x : x ]
        if [ ax > 12.0 ] return 0.0
        e : f32 [ exp[ ax ] ]
        c : f32 [ (e + 1.0 / e) * 0.5 ]
        return 1.0 / (c * c)

    func tanh_f [ x: f32 ] -> f32
        if [ x > 12.0 ] return 1.0
        e : f32 [ exp[ 2.0 * x ] ]
        return (e - 1.0) / (e + 1.0)

    # sample the spectrum into Gerstner components, longest wave first
    # so a distant pixel can use a prefix of the list
    func build_waves [ vkc: vk_context, wind: f32 ]
        NK : i32 [ 40 ]
        ND : i32 [ 3 ]
        n : i32 [ NK * ND ]
        if [ !wave_buf ]
            wave_buf = Buffer [ vk: vkc, size: i64[ n ] * 16,
                u_storage: true, m_host_visible: true, m_host_coherent: true ]
            wave_buf.hold[]
        wd : @f32 [ wave_buf.data ]
        th0 : f32 [ atan2[ 0.6, 0.8 ] ]
        lmin : f32 [ 1.6 ]
        lmax : f32 [ 780.0 ]
        omp : f32 [ omega_p[ wind ] ]
        idx : i32 [ 0 ]
        for [ i: i32 0, i < NK, i += 1 ]
            f0 : f32 [ f32[ i ] / f32[ NK ] ]
            f1 : f32 [ f32[ i + 1 ] / f32[ NK ] ]
            l0 : f32 [ lmax * pow[ lmin / lmax, f0 ] ]
            l1 : f32 [ lmax * pow[ lmin / lmax, f1 ] ]
            lm : f32 [ sqrt[ l0 * l1 ] ]
            k : f32 [ 6.2831853 / lm ]
            om : f32 [ sqrt[ 9.81 * k ] ]
            om0 : f32 [ sqrt[ 9.81 * 6.2831853 / l0 ] ]
            om1 : f32 [ sqrt[ 9.81 * 6.2831853 / l1 ] ]
            dom : f32 [ om1 - om0 ]
            S : f32 [ jonswap[ om, wind ] ]
            bs : f32 [ db_beta[ om / omp ] ]
            qn : f32 [ 1.0 / tanh_f[ bs * 3.14159265 ] ]
            sp : f32 [ 3.2 / bs ]
            if [ sp > 3.14159265 ] sp = 3.14159265
            dth : f32 [ sp / f32[ ND ] ]
            for [ j: i32 0, j < ND, j += 1 ]
                u : f32 [ (f32[ j ] + wrnd[]) / f32[ ND ] ]
                th : f32 [ (u - 0.5) * sp ]
                D : f32 [ 0.5 * bs * sech2[ bs * th ] * qn ]
                A : f32 [ sqrt[ 2.0 * S * D * dom * dth ] ]
                wd[ idx * 4 ]     = k * cos[ th0 + th ]
                wd[ idx * 4 + 1 ] = k * sin[ th0 + th ]
                wd[ idx * 4 + 2 ] = A
                wd[ idx * 4 + 3 ] = wrnd[] * 6.2831853
                idx += 1
        wave_n = idx
        wave_wind = wind

    # a strike lives for a moment and flickers as real ones do: a first
    # stroke, then one or two return strokes down the same channel
    func bolt_env [ u: f32 ] -> f32
        e : f32 [ exp[ 0.0 - 9.0 * u ] ]
        if [ u > 0.22 ] e += 0.60 * exp[ 0.0 - 11.0 * (u - 0.22) ]
        if [ u > 0.52 ] e += 0.32 * exp[ 0.0 - 12.0 * (u - 0.52) ]
        return e

    # the weather field at a spot, read exactly as the shader reads it
    func cov_at [ x: f32, z: f32 ] -> f32
        wd : @u8 [ wimg.vdata[] ]
        ww : i32 [ wimg.width ]
        u : f32 [ (x + cam_x) / 60000.0 + 0.5 ]
        v : f32 [ (z + cam_z) / 60000.0 + 0.5 ]
        px : i32 [ i32[ (u - floor[ u ]) * f32[ ww ] ] ]
        py : i32 [ i32[ (v - floor[ v ]) * f32[ ww ] ] ]
        i : i32 [ (py * ww + px) * 4 ]
        r : f32 [ f32[ wd[ i ] ] / 255.0 ]
        g : f32 [ f32[ wd[ i + 1 ] ] / 255.0 ]
        fr : f32 [ sat[ remap[ r, 0.30, 0.72, 0.0, 1.0 ] ] ]
        fg : f32 [ sat[ remap[ g, 0.0, 0.5, 0.0, 1.0 ] ] ]
        field : f32 [ fr + (fg - fr) * cur.island ]
        return sat[ remap[ field, 1.0 - cur.coverage, 1.0 - cur.coverage + 0.35, 0.0, 1.0 ] ]

    # how tall this particular cloud stands, the same figure the shader
    # builds from the type field and the per-cloud height map
    func top_at [ x: f32, z: f32 ] -> f32
        wd : @u8 [ wimg.vdata[] ]
        ww : i32 [ wimg.width ]
        u : f32 [ (x + cam_x) / 60000.0 + 0.5 ]
        v : f32 [ (z + cam_z) / 60000.0 + 0.5 ]
        px : i32 [ i32[ (u - floor[ u ]) * f32[ ww ] ] ]
        py : i32 [ i32[ (v - floor[ v ]) * f32[ ww ] ] ]
        bch : f32 [ f32[ wd[ (py * ww + px) * 4 + 2 ] ] / 255.0 ]
        t : f32 [ sat[ remap[ bch, 0.35, 0.72, 0.0, 1.0 ] * 0.5 + cur.ctype - 0.25 ] ]
        a : f32 [ 1100.0 + (1800.0 - 1100.0) * sat[ t * 2.0 ] ]
        cu : f32 [ a + (3000.0 - a) * sat[ t * 2.0 - 1.0 ] ]
        hs : f32 [ 0.5 ]
        if [ timg ]
            td : @u8 [ timg.vdata[] ]
            tw : i32 [ timg.width ]
            tu : f32 [ (x + cam_x) / 60000.0 * 3.0 + 0.5 ]
            tv : f32 [ (z + cam_z) / 60000.0 * 3.0 + 0.5 ]
            tx2 : i32 [ i32[ (tu - floor[ tu ]) * f32[ tw ] ] ]
            ty2 : i32 [ i32[ (tv - floor[ tv ]) * f32[ tw ] ] ]
            hs = f32[ td[ (ty2 * tw + tx2) * 4 ] ] / 255.0
        return cu * (0.5 + hs)

    # a strike belongs in the BODY of a heavy cloud: pick the spot whose
    # neighbours are cloudy too, so it never starts on a face or outside
    func bolt_strike []
        best : f32 [ 0.0 ]
        bx : f32 [ 0.0 ]
        bz : f32 [ 0.0 ]
        for [ tries: i32 0, tries < 24, tries += 1 ]
            ang : f32 [ wrnd[] * 6.2831853 ]
            rad : f32 [ 2200.0 + wrnd[] * 11000.0 ]
            tx : f32 [ cos[ ang ] * rad ]
            tz : f32 [ sin[ ang ] * rad ]
            c0 : f32 [ cov_at[ tx, tz ] ]
            if [ c0 < 0.7 ] continue
            c1 : f32 [ cov_at[ tx + 500.0, tz ] ]
            c2 : f32 [ cov_at[ tx - 500.0, tz ] ]
            c3 : f32 [ cov_at[ tx, tz + 500.0 ] ]
            c4 : f32 [ cov_at[ tx, tz - 500.0 ] ]
            score : f32 [ c0 ]
            if [ c1 < score ] score = c1
            if [ c2 < score ] score = c2
            if [ c3 < score ] score = c3
            if [ c4 < score ] score = c4
            if [ score > best ]
                best = score
                bx = tx
                bz = tz
        if [ best < 0.55 ] return
        # halfway up that cloud's own column, never at its base or top
        top : f32 [ top_at[ bx, bz ] ]
        y0 : f32 [ 1500.0 + top * (0.38 + wrnd[] * 0.22) ]
        pw : f32 [ 7.5e5 * (0.6 + wrnd[] * 0.8) ]
        bolt[ 0 ] = bx
        bolt[ 1 ] = y0
        bolt[ 2 ] = bz
        bolt[ 3 ] = pw
        # the channel stays inside the cloud: short steps, small kicks
        for [ k: i32 1, k < 4, k += 1 ]
            bolt[ k * 4 ]     = bolt[ (k - 1) * 4 ] + (wrnd[] - 0.5) * 170.0
            bolt[ k * 4 + 1 ] = bolt[ (k - 1) * 4 + 1 ] - (60.0 + wrnd[] * 120.0)
            bolt[ k * 4 + 2 ] = bolt[ (k - 1) * 4 + 2 ] + (wrnd[] - 0.5) * 170.0
            bolt[ k * 4 + 3 ] = pw * (0.75 - 0.15 * f32[ k ])
        bolt_t = 0.55
        bolt_dur = 0.55

    # how often a sky like this flashes at all
    func bolt_tick [ dt: f32 ]
        if [ !bolt ]
            bolt = vec f32 [ 16 ]
        if [ bolt_t > 0.0 ]
            bolt_t -= dt
            if [ bolt_t < 0.0 ] bolt_t = 0.0
            return
        bolt_wait -= dt
        if [ bolt_wait > 0.0 ] return
        # storms only show their lightning once the light has gone: by
        # day the flash is lost in the sun anyway
        lam : f32 [ (cur.coverage - 0.6) * cur.density * 0.35 * bolt_dark ]
        if [ lam < 0.0 ] lam = 0.0
        lam = lam * bolts
        if [ lam < 0.001 ]
            bolt_wait = 2.0
            return
        u : f32 [ 0.02 + wrnd[] * 0.98 ]
        bolt_wait = 0.0 - log[ u ] / lam
        bolt_strike[]

    func load_texture [ vk: vk_context, w: Window, p: path, depth: i32 ] -> Texture
        expect p.exists[], 'baked noise missing: {p}'
        im : Image [ uri: p, linear: true, wrap_u: true, wrap_v: true ]
        im.hold[]
        tx : Texture [ vk: vk, w: w, sampler: im, depth: depth, mip_levels: 1, linear: true, wrap_u: true, wrap_v: true ]
        tx.hold[]
        return tx

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        ux.will_animate = true
        cv : Canvas [ w.screen ]
        if [ !vrender ]
            p1 : path '../clouds/baked/shape.png'
            if [ !p1.exists[] ]
                puts 'clouds: no baked noise — baking live (SILVER_EXPORT=1 bakes at build)'
                clouds_bake[]
            tx_shape   = load_texture[ cv.vk, w, path '../clouds/baked/shape.png', 128 ]
            tx_detail  = load_texture[ cv.vk, w, path '../clouds/baked/detail.png', 32 ]
            tx_curl    = load_texture[ cv.vk, w, path '../clouds/baked/curl.png', 1 ]
            tx_weather = load_texture[ cv.vk, w, path '../clouds/baked/weather.png', 1 ]
            tx_tvar    = load_texture[ cv.vk, w, path '../clouds/baked/tops.png', 1 ]
            tx_stars   = load_texture[ cv.vk, w, path '../scenes/textures/gaia.png', 1 ]
            wimg = Image [ uri: path '../clouds/baked/weather.png', linear: true ]
            wimg.hold[]
            timg = Image [ uri: path '../clouds/baked/tops.png', linear: true ]
            timg.hold[]
            build_island[ cv.vk, w ]
            build_waves[ cv.vk, cur.wind ]
            sky = NubisSky [ vk: cv.vk, name: 'nubis-sky' ]
            sky.hold[]
            smp : map Au[string] [ 'shape': tx_shape, 'detail': tx_detail, 'curl': tx_curl, 'weather': tx_weather, 'island': tx_island, 'tvar': tx_tvar, 'waves': wave_buf, 'stars': tx_stars ]
            # the environment pass: the SAME shader instance, told to draw
            # the whole sky into a small mipped map the sea reflects. each
            # draw snapshots the uniforms, so the flag can differ per pass
            env_model = Model [ vk: cv.vk, w: w, s: sky, samplers: smp ]
            env_model.hold[]
            env_render = Render [ vk: cv.vk, w: w, width: 512, height: 256, wscale: 0.0,
                tag: 'nubis-env', mips: 6, aniso: 8,
                clear_color: vec4f [ 0.0, 0.0, 0.0, 1.0 ], models: [ env_model ] ]
            env_render.hold[]
            smp[ 'envmap' ] = env_render.color
            vmodel = Model [ vk: cv.vk, w: w, s: sky, samplers: smp ]
            vmodel.hold[]
            vrender = Render [ vk: cv.vk, w: w, wscale: wscale * 0.5, tag: 'clouds',
                clear_color: vec4f [ 0.0, 0.0, 0.0, 1.0 ], models: [ vmodel ] ]
            vrender.hold[]
            vrender.timing = true
            w.element_targets[ 'sky_{id}' ] = vrender
            # history ping-pong: each compose reads the other's last frame
            hist_a = Render [ vk: cv.vk, w: w, wscale: wscale, tag: 'clouds-ha', clear_color: vec4f [ 0.0, 0.0, 0.0, 1.0 ] ]
            hist_b = Render [ vk: cv.vk, w: w, wscale: wscale, tag: 'clouds-hb', clear_color: vec4f [ 0.0, 0.0, 0.0, 1.0 ] ]
            hist_a.hold[]
            hist_b.hold[]
            hist_a.timing = true
            hist_b.timing = true
            comp_a = TemporalCompose [ vk: cv.vk, name: 'temporal-a' ]
            comp_b = TemporalCompose [ vk: cv.vk, name: 'temporal-b' ]
            comp_a.hold[]
            comp_b.hold[]
            sa : map Au[string] [ 'fresh': vrender.color, 'history': hist_b.color ]
            sb : map Au[string] [ 'fresh': vrender.color, 'history': hist_a.color ]
            model_a = Model [ vk: cv.vk, w: w, s: comp_a, samplers: sa ]
            model_b = Model [ vk: cv.vk, w: w, s: comp_b, samplers: sb ]
            model_a.hold[]
            model_b.hold[]
            hist_a.models = vec Model [] [ model_a ]
            hist_b.models = vec Model [] [ model_b ]
            model_a.finish[ hist_a, 0 ]
            model_b.finish[ hist_b, 0 ]
            w.element_targets[ 'skya_{id}' ] = hist_a
            w.element_targets[ 'skyb_{id}' ] = hist_b
        frame += 1
        sdt : f32 [ seconds - last_secs ]
        if [ sdt <= 0.0 ] sdt = 0.016
        if [ sdt > 0.5 ] sdt = 0.016
        last_dt = sdt
        last_secs = seconds
        # the island map follows the weather blend, a few times a second
        dc : f32 [ cur.coverage - isl_cov ]
        dm : f32 [ cur.island - isl_mix ]
        if [ dc < 0.0 ] dc = 0.0 - dc
        if [ dm < 0.0 ] dm = 0.0 - dm
        if [ (dc > 0.01 || dm > 0.02) && seconds - isl_secs > 0.25 ]
            build_island[ cv.vk, w ]
            vmodel.samplers[ 'island' ] = tx_island
            vmodel.rebind_model[]
        # camera basis from yaw / pitch
        cp : f32 [ cos[ pitch ] ]
        fx : f32 [ cp * sin[ yaw ] ]
        fy : f32 [ sin[ pitch ] ]
        fz : f32 [ cp * cos[ yaw ] ]
        rx : f32 [ 0.0 - fz ]
        rz : f32 [ fx ]
        rl : f32 [ sqrt[ rx * rx + rz * rz ] ]
        if [ rl < 0.0001 ] rl = 0.0001
        rx = rx / rl
        rz = rz / rl
        ux2 : f32 [ 0.0 - rz * fy ]
        uy2 : f32 [ rz * fx - rx * fz ]
        uz2 : f32 [ rx * fy ]
        th : f32 [ 0.577 ]
        aspect : f32 [ bounds.w / bounds.h ]
        sky.cam_pos   = vec4f [ 0.0, cam_h, 0.0, 0.0 ]
        sky.cam_right = vec4f [ rx, 0.0, rz, th * aspect ]
        sky.cam_up    = vec4f [ ux2, uy2, uz2, th ]
        sky.cam_fwd   = vec4f [ fx, fy, fz, exposure ]
        se : f32 [ cos[ cur.sun_el ] ]
        sky.sun_dir   = vec4f [ se * sin[ cur.sun_az ], sin[ cur.sun_el ], se * cos[ cur.sun_az ], 22.0 * (1.0 - night) + 1.3 * night ]
        sky.wind      = vec4f [ cur.wind * 0.8, 0.0, cur.wind * 0.6, seconds ]
        sky.layer     = vec4f [ 1500.0, 6000.0, 6371000.0, 6471000.0 ]
        sky.tops      = vec4f [ 1100.0, 1800.0, 3000.0, 0.0 ]
        sky.weather_a = vec4f [ cur.coverage, cur.ctype, 0.0, cur.island ]
        sky.weather_b = vec4f [ 0.6, cur.skew, cur.density, cur.detail ]
        sky.light_a   = vec4f [ 0.6, 1.4, 0.18, 1.0 ]
        sky.light_b   = vec4f [ 0.4, 0.75, 0.5, 0.016 ]
        sky.scales    = vec4f [ 6000.0, 650.0, 3000.0, 60000.0 ]
        sky.march     = vec4f [ quality, 1.0, 60000.0, 1.0 / 45000.0 ]
        # the sea state follows the wind: rebuild when it has moved
        dw : f32 [ cur.wind - wave_wind ]
        if [ dw < 0.0 ] dw = 0.0 - dw
        if [ dw > 0.5 ] build_waves[ cv.vk, cur.wind ]
        bolt_dark = sat[ (0.16 - cur.sun_el) / 0.16 ]
        if [ night > 0.5 ] bolt_dark = 1.0
        bolt_tick[ last_dt ]
        be : f32 [ (bolt_t > 0.0) ? bolt_env[ 1.0 - bolt_t / bolt_dur ] : 0.0 ]
        # each element is read into its own value first: a vec4f built
        # straight out of vector reads arrives at the shader as zeros
        for [ bi: i32 0, bi < 4, bi += 1 ]
            q0 : f32 [ bolt[ bi * 4 ] ]
            q1 : f32 [ bolt[ bi * 4 + 1 ] ]
            q2 : f32 [ bolt[ bi * 4 + 2 ] ]
            q3 : f32 [ bolt[ bi * 4 + 3 ] ]
            bv : vec4f [ q0, q1, q2, q3 ]
            if [ bi == 0 ] sky.bolt_a = bv
            if [ bi == 1 ] sky.bolt_b = bv
            if [ bi == 2 ] sky.bolt_c = bv
            if [ bi == 3 ] sky.bolt_d = bv
        sky.bolt_col = vec4f [ 0.82, 0.88, 1.0, be ]
        sky.world     = vec4f [ cam_x, cam_z, 0.0, 0.0 ]
        sky.key_tint  = vec4f [ 1.0 - 0.30 * night, 1.0 - 0.16 * night, 1.0, night ]
        sky.sea       = vec4f [ f32[ wave_n ], 1.15, 0.55, 12000.0 ]
        sky.view_mode = view_mode
        sky.frame     = frame
        sky.time      = seconds
        # 2x2 sub-pixel cycle: every full-res pixel is sampled once per 4 frames
        ph : i32 [ frame % 4 ]
        ox : f32 [ ((ph & 1) == 0) ? -0.25 : 0.25 ]
        oy : f32 [ ((ph & 2) == 0) ? -0.25 : 0.25 ]
        vrender.wscale = (temporal) ? wscale * 0.5 : wscale
        vrender.update[]
        lw : f32 [ f32[ vrender.width ] ]
        lh : f32 [ f32[ vrender.height ] ]
        jx : f32 [ (temporal) ? ox / lw : 0.0 ]
        jy : f32 [ (temporal) ? oy / lh : 0.0 ]
        sky.jitter = vec4f [ jx, jy, (temporal) ? 0.0 : 1.0, 0.0 ]
        # sea_b.z = the angle one pixel covers: the wave LOD works off it
        sky.sea_b  = vec4f [ cur.wind, 1.0, 2.0 * th / lh, seconds * 0.0008 ]
        # the sky into the environment map first, then its mip chain, so
        # the sea's reflection has something filtered to read
        sky.env    = vec4f [ 1.0, 0.0, 0.0, 0.0 ]
        sky.jitter = vec4f [ 0.0, 0.0, 1.0, 0.0 ]
        env_render.update[]
        env_render.draw[]
        env_render.sync_fence[]
        env_render.gen_mips[]
        sky.env    = vec4f [ 0.0, 0.0, 0.0, 0.0 ]
        sky.jitter = vec4f [ jx, jy, (temporal) ? 0.0 : 1.0, 0.0 ]
        gpu_ms = vrender.gpu_us / 1000.0
        if [ !temporal ]
            hist_a.skip = true
            hist_b.skip = true
            hist_valid = false
            cv.draw_image[ vrender.color, rect [ x: 0.0, y: 0.0, w: bounds.w, h: bounds.h ] ]
            return
        use_a : bool [ (frame & 1) == 0 ]
        hist_a.skip = !use_a
        hist_b.skip = use_a
        hist_a.update[]
        hist_b.update[]
        # attachments are rebuilt on resize: keep the samplers current
        if [ model_a.samplers[ 'fresh' ] != vrender.color || model_a.samplers[ 'history' ] != hist_b.color ]
            model_a.samplers[ 'fresh' ] = vrender.color
            model_a.samplers[ 'history' ] = hist_b.color
            model_a.rebind_model[]
            hist_valid = false
        if [ model_b.samplers[ 'fresh' ] != vrender.color || model_b.samplers[ 'history' ] != hist_a.color ]
            model_b.samplers[ 'fresh' ] = vrender.color
            model_b.samplers[ 'history' ] = hist_a.color
            model_b.rebind_model[]
            hist_valid = false
        cm : TemporalCompose [ (use_a) ? comp_a : comp_b ]
        cm.cam_right  = sky.cam_right
        cm.cam_up     = sky.cam_up
        cm.cam_fwd    = sky.cam_fwd
        cm.prev_right = prev_right
        cm.prev_up    = prev_up
        cm.prev_fwd   = prev_fwd
        cm.jitter     = vec4f [ jx, jy, 1.0 / lw, 1.0 / lh ]
        cm.cam_pos    = sky.cam_pos
        cm.prev_pos   = prev_pos
        # the faster we move, the less the history can be trusted
        bw : f32 [ 0.22 + speed / 700.0 ]
        if [ bw > 0.75 ] bw = 0.75
        cm.blend      = vec4f [ bw, (hist_valid) ? 1.0 : 0.0, 0.0, 0.0 ]
        gpu_ms = (vrender.gpu_us + ((use_a) ? hist_b.gpu_us : hist_a.gpu_us)) / 1000.0
        prev_right = sky.cam_right
        prev_up    = sky.cam_up
        prev_fwd   = sky.cam_fwd
        prev_pos   = sky.cam_pos
        hist_valid = true
        out : Render [ (use_a) ? hist_a : hist_b ]
        cv.draw_image[ out.color, rect [ x: 0.0, y: 0.0, w: bounds.w, h: bounds.h ] ]

element clouds : trinity
    public width      : i32    [ 1280 ]
    public height     : i32    [ 720 ]
    public title      : string [ 'clouds' ]
    public preset     : i32    [ 2 ]
    public sun_el     : f32    [ 0.06 ]
    public sun_az     : f32    [ 0.0 ]
    public night      : f32    [ 0.0 ]
    public bolts      : f32    [ 1.0 ]
    public yaw        : f32    [ 0.0 ]
    public pitch      : f32    [ 0.14 ]
    public cam_h      : f32    [ 400.0 ]
    public cam_x      : f32
    public cam_z      : f32
    public fly_speed  : f32    [ 0.0 ]
    public exposure   : f32    [ 0.9 ]
    public quality    : f32    [ 2.0 ]
    public view_mode  : i32
    public wscale     : f32    [ 1.0 ]
    public blend_secs : f32    [ 8.0 ]
    public temporal   : bool   [ true ]
    public spin       : f32    [ 0.0 ]
    public tstart     : f32    [ 0.0 ]
    mutable states    : vec WeatherState
    mutable cur       : WeatherState
    mutable goal    : WeatherState
    mutable last_us   : i64
    mutable seconds   : f32
    mutable frame_ms  : f32 [ 16.0 ]
    mutable blend_t   : f32 [ 1.0 ]
    mutable prev      : WeatherState

    func make_states []
        states = vec WeatherState []
        states += WeatherState [ name: 'clear, a few cumulus', coverage: 0.4, ctype: 0.85, island: 0.8, anvil: 0.0, skew: 300.0, density: 1.0, detail: 0.3, wind: 6.0, sun_el: 0.9, sun_az: 1.2 ]
        states += WeatherState [ name: 'fair weather cumulus',  coverage: 0.62, ctype: 0.8, island: 0.5, anvil: 0.1, skew: 500.0, density: 1.0, detail: 0.32, wind: 8.0, sun_el: 0.75, sun_az: 5.9 ]
        states += WeatherState [ name: 'stratocumulus sheet',   coverage: 0.85, ctype: 0.45, island: 0.2, anvil: 0.0, skew: 400.0, density: 1.1, detail: 0.28, wind: 10.0, sun_el: 0.6, sun_az: 0.0 ]
        states += WeatherState [ name: 'overcast stratus',      coverage: 0.97, ctype: 0.08, island: 0.0, anvil: 0.0, skew: 200.0, density: 1.4, detail: 0.22, wind: 5.0, sun_el: 0.7, sun_az: 2.0 ]
        states += WeatherState [ name: 'heavy cumulus',         coverage: 0.62, ctype: 0.9, island: 0.4, anvil: 1.0, skew: 900.0, density: 1.3, detail: 0.3, wind: 18.0, sun_el: 0.45, sun_az: 5.6 ]
        states += WeatherState [ name: 'sunset towers',         coverage: 0.45, ctype: 0.95, island: 0.7, anvil: 0.4, skew: 600.0, density: 1.0, detail: 0.3, wind: 7.0, sun_el: 0.07, sun_az: 6.0 ]

    func copy_state [ s: WeatherState ] -> WeatherState
        return WeatherState [ name: s.name, coverage: s.coverage, ctype: s.ctype, island: s.island,
            anvil: s.anvil, skew: s.skew, density: s.density, detail: s.detail, wind: s.wind, sun_el: s.sun_el, sun_az: s.sun_az ]

    func set_preset [ i: i32 ]
        if [ i < 0 || i >= states.count ] return
        preset = i
        prev   = copy_state[ cur ]
        prev.hold[]
        goal = states[ i ]
        blend_t = 0.0

    func lerp_f [ x: f32, y: f32, t: f32 ] -> f32
        return x + (y - x) * t

    func init []
        make_states[]
        if [ preset < 0 || preset >= states.count ] preset = 1
        cur = copy_state[ states[ preset ] ]
        cur.hold[]
        goal = states[ preset ]
        if [ sun_el >= 0.0 ] cur.sun_el = sun_el
        if [ sun_az >= 0.0 ] cur.sun_az = sun_az
        prev = copy_state[ cur ]
        prev.hold[]
        puts 'clouds: 1-6 weather  arrows look  t/g sun  e/d exposure  q quality  v view  f fly  +/- speed  pgup/pgdn height  r temporal'

    public func on_key [ ev: Event ]
        if [ !ev.key.state ] return
        k : i32 [ ev.key.unicode ]
        if [ k >= 49 && k <= 54 ] set_preset[ k - 49 ]
        if [ k == 263 ] yaw -= 0.08
        if [ k == 262 ] yaw += 0.08
        if [ k == 265 ] pitch += 0.05
        if [ k == 264 ] pitch -= 0.05
        if [ k == 84 ] cur.sun_el += 0.04
        if [ k == 71 ] cur.sun_el -= 0.04
        if [ k == 69 ] exposure *= 1.15
        if [ k == 68 ] exposure /= 1.15
        if [ k == 81 ] quality = (quality >= 2.0) ? 0.5 : quality * 2.0
        if [ k == 86 ] view_mode = (view_mode + 1) % 5
        if [ k == 70 ] fly_speed = (fly_speed > 0.0) ? 0.0 : 80.0
        if [ k == 61 || k == 334 ] fly_speed = (fly_speed > 0.0) ? fly_speed * 1.5 : 20.0
        if [ k == 45 || k == 333 ] fly_speed = fly_speed / 1.5
        if [ k == 266 ] cam_h += 150.0
        if [ k == 267 ] cam_h = (cam_h > 152.0) ? cam_h - 150.0 : 2.0
        if [ k == 82 ] temporal = !temporal
        if [ pitch > 1.5 ] pitch = 1.5
        if [ pitch < -0.3 ] pitch = -0.3
        if [ cur.sun_el > 1.5 ] cur.sun_el = 1.5
        if [ cur.sun_el < -0.1 ] cur.sun_el = -0.1
        if [ k == 84 || k == 71 ]
            goal.sun_el = cur.sun_el
            prev.sun_el = cur.sun_el

    public func on_overlay [ cv: Canvas ]
        fps : i32 [ i32[ 1000.0 / ((frame_ms > 0.1) ? frame_ms : 0.1) ] ]
        ms1 : i32 [ i32[ frame_ms * 10.0 ] ]
        ms_i : i32 [ ms1 / 10 ]
        ms_f : i32 [ ms1 % 10 ]
        sel : i32 [ i32[ cur.sun_el * 57.3 ] ]
        cv9 : i32 [ i32[ cur.coverage * 100.0 ] ]
        wnd : i32 [ i32[ cur.wind ] ]
        pn : i32 [ preset + 1 ]
        nm : string [ cur.name ]
        vm : string [ (view_mode == 0) ? 'lit' : (view_mode == 1) ? 'alpha' : 'steps' ]
        alt : i32 [ i32[ cam_h ] ]
        spd : i32 [ i32[ fly_speed ] ]
        v : cast SkyView [ elements[ 'sky' ] ]
        g10 : i32 [ (v) ? i32[ v.gpu_ms * 100.0 ] : 0 ]
        g_i : i32 [ g10 / 100 ]
        g_f : i32 [ g10 % 100 ]
        lines : vec string [] [
            'nubis clouds  {pn} {nm}  coverage {cv9}%  sun {sel} deg  wind {wnd} m/s',
            '{fps} fps  frame {ms_i}.{ms_f} ms  gpu pass {g_i}.{g_f} ms  quality x{quality}  view {vm}  temporal {temporal}  alt {alt} m  speed {spd} m/s' ]
        y : f32 [ 10.0 ]
        for [ s: string ] in lines
            cv.fill_color[ '#0008' ]
            cv.rect_to[ 8.0, y - 2.0, 900.0, 20.0 ]
            cv.paint[]
            cv.fill_color[ '#e8eef4' ]
            cv.draw_text[ s, rect [ x: 14.0, y: y, w: 900.0, h: 18.0 ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
            cv.paint[]
            y += 22.0

    public func render [] -> Elements
        now : i64 [ epoch_micros[] ]
        dt : f32 [ 0.0 ]
        if [ last_us > 0 ]
            dt = f32[ now - last_us ] / 1000000.0
            frame_ms = frame_ms * 0.9 + dt * 100.0
        last_us = now
        if [ seconds == 0.0 ] seconds = tstart
        seconds += dt
        yaw += spin * dt
        if [ fly_speed > 0.0 ]
            # the flight follows the heading and HOLDS its altitude;
            # looking up must not fly us into the cloud deck
            cam_x += sin[ yaw ] * fly_speed * dt
            cam_z += cos[ yaw ] * fly_speed * dt
        # Nubis: a weather change is a lerp between states over seconds
        if [ blend_t < 1.0 ]
            blend_t += dt / blend_secs
            if [ blend_t > 1.0 ] blend_t = 1.0
            t : f32 [ blend_t * blend_t * (3.0 - 2.0 * blend_t) ]
            cur.coverage = lerp_f[ prev.coverage, goal.coverage, t ]
            cur.ctype    = lerp_f[ prev.ctype,    goal.ctype,    t ]
            cur.island   = lerp_f[ prev.island,   goal.island,   t ]
            cur.anvil    = lerp_f[ prev.anvil,    goal.anvil,    t ]
            cur.skew     = lerp_f[ prev.skew,     goal.skew,     t ]
            cur.density  = lerp_f[ prev.density,  goal.density,  t ]
            cur.detail   = lerp_f[ prev.detail,   goal.detail,   t ]
            cur.wind     = lerp_f[ prev.wind,     goal.wind,     t ]
            cur.sun_el   = lerp_f[ prev.sun_el,   goal.sun_el,   t ]
            cur.sun_az   = lerp_f[ prev.sun_az,   goal.sun_az,   t ]
            cur.name     = goal.name
        e : Elements [ ]
        e['sky'] = SkyView [ yaw: yaw, pitch: pitch, cam_h: cam_h, cam_x: cam_x, cam_z: cam_z, exposure: exposure, quality: quality,
            view_mode: view_mode, wscale: wscale, seconds: seconds, cur: cur, temporal: temporal, night: night, bolts: bolts, speed: fly_speed, animated: true ]
        return e
