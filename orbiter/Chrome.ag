            stroke_width: 1
            stroke_color: #fff1
        layers.face:
            label_color: #fff6
            label_size: 16
            editable: true 
            label_align: 0.0 0.5
            label_offset: 10.0 0.0
        :focused
            layers.body:
                fill_color: #8c4a6440
                stroke_color: #fff2
            layers.face:
                label_color: #ffff
        :has_value
            layers.body:
                fill_color: #8c4a6440
                stroke_color: #fff2
