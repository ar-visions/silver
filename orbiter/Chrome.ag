extend orbiter

# the bars, the dock and their buttons, tabs and fields

# the companion row beside the title: the same chip, two points smaller
LabelButton CompanionButton
    tlabel : Layer [ label_color: rgba [ '#fffa' ], label_font: 'fonts/BarlowCondensed-Regular.ttf', label_size: 12,
        label_align: vec2f [ x: 0.5, y: 0.5 ] ]

# a running instance: name at the left, its [x] sits a little in from
# the right edge
NavButton InstChip
    public tlabel : Layer [ label_color: rgba [ '#fffa' ], label_font: 'fonts/BarlowCondensed-Regular.ttf', label_size: 14,
        label_align: vec2f [ x: 0.0, y: 0.5 ],
        label_offset: vec2f [ x: 10.0, y: 0.0 ] ]


# centered in the title: icon at the left, 'close <mode>' beside it
NavButton CloseChip
    area   : Region { l50%-2.6 t0 w5.2 h0.9 }
    public tlabel : Layer [ label_color: rgba [ '#fffa' ], label_font: 'fonts/BarlowCondensed-Regular.ttf', label_size: 14,
        label_align: vec2f [ x: 0.5, y: 0.5 ],
        label_offset: vec2f [ x: 10.0, y: 0.0 ] ]
    func init []
        iconl.image_align = Align [ x: XAlign.left, y: YAlign.middle ]
        iconl.image_scale = 0.8

# staged live-reload: small button centred in the status bar
Option ReloadButton
    no_cache : true
    # the label after the body: a hover fill never covers it; the
    # hover is mostly an orange glow
    style : CSS {
        area: l50%-1.45 t0.12 w2.91 h0.67
        layers.body:
            fill_color: #0000
            radius: 4
            box_shadow: none
        layers.face:
            label_color: #fff
            label_size: 14
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.5 0.5
            label_offset: 0.0 -1.0
        :hovered
            layers.body:
                fill_color: #c8641e22
                box_shadow: inset 0 0 8px #ffae5ecc
        :pressed
            layers.body:
                fill_color: #c8641e55
                box_shadow: inset 0 0 8px #ffae5ecc
    }

# center of the status bar: hides everything above it but the scene
# find bar switch: search the docked remote checkouts too
Option RemoteToggle
    no_cache : true
    style : CSS {
        # edge to edge in the bar (over its 0.2 spacing above and
        # below), square, a line on its left alone
        area: r0+ t-0.2 w2.7 b-0.2
        layers.body:
            fill_color: #0000
            radius: 0
            stroke_width: 0 0 0 1
            stroke_color: #fff1
            near_border: true
            near_inset: 2.0
            near_inset_color: #c890ffaa
        layers.face:
            label_color: #fff6
            label_size: 16
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.5 0.5
            label_offset: 0 -3
        :selected
            layers.body:
                fill_color: #8c4a6440
                stroke_color: #fff4
            layers.face:
                label_color: #ffff
        :hovered
            layers.body:
                near_inset: 4.0
    }

# non-clickable chip in the same spot: what the reload is doing right
# now the editor's tooltip: the class and function the caret sits in,
# and at a debugger stop the clicked name's type and value, so it reads
# here instead of scrolling up to its # annotation. a plain label from
# the bar's left edge, after the agent's word when that shows; it gives
# the spot up while a reload chip is showing
element DebugValue
    no_cache : true
    style : CSS {
        # the bar's height, between the steps and the tasks
        # 0.5 units in from the bar's left
        area: l0.5 t0 w5.5 b0
        layers.body:
            fill_color: #0000
            radius: 0
            box_shadow: none
        layers.face:
            label_color: #cfe6ff
            label_size: 14
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.0 0.5
            label_offset: 0.0 -1.0
    }

# same tab, build failed: click jumps to the error line
Option ErrorButton
    public tlabel : Layer [ label_color: rgba [ '#fff' ], label_font: 'fonts/BarlowCondensed-Regular.ttf', label_size: 16,
        label_align: vec2f [ x: 0.5, y: 0.5 ],
        label_overflow: Overflow.ellipsis ]
    style : CSS {
        area: l50%-6 t0 w12 h1.68
        layers.body:
            fill_color: #d94a6a
            radius: 0 0 8 8
            box_shadow: inset 0 0 9px #ff8fa8a2
        :hovered
            layers.body:
                fill_color: #ec5f7e
                box_shadow: inset 0 0 11px #ffb0c2a2
        :pressed
            layers.body:
                fill_color: #ad3852
    }

# the same error, centered on the run band. l50% is an ABSOLUTE anchor,
# so it holds the middle whatever the l0+/r0+ runs either side of it do
Option AppError
    # the same slot says what the app is DOING when there is no error
    public info : bool
    public tlabel : Layer [ label_color: rgba [ '#fff' ], label_font: 'fonts/BarlowCondensed-Regular.ttf', label_size: 14,
        label_align: vec2f [ x: 0.5, y: 0.5 ],
        label_overflow: Overflow.ellipsis ]
    style : CSS {
        layers.body:
            fill_color: #822
            radius: 6
            stroke_width: 2
            stroke_color: #faa4
            box_shadow: none
        layers.face:
            label_color: #fff
            label_size: 14
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.5 0.5
        :info
            layers.body:
                fill_color: #234
                stroke_color: #7fb2ff55
                box_shadow: inset 0 0 6px #7fb2ff33
        :hovered
            layers.body:
                fill_color: #a33
                stroke_color: #c44
                box_shadow: inset 0 0 6px #f66c4
        :pressed
            layers.body:
                fill_color: #611
                stroke_color: #a22
    }

# window-wide strip; the pane splitter stops above it.
# the bar owns every gap in here, edges included, instead of each
# control carrying its own l8px/r0 offset
Group StatusBar
    style : CSS {
        area: l0 b1.06 r0 h1.06
        spacing_x: 1px
        spacing_y: 2px
        # 80% black; a faint border always, the pointer's light on it
        layers.sbar:
            fill_color: #000c, 400ms cubic outward
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            stroke_color: #fff1
            near_border: true
            near_inset: 1.0
            near_inset_color: #c890ffaa
    }

# the side panel's toolbar: no ground of its own, the panel's shows
StatusBar SideBar
    style : CSS {
        # the bar takes no light: its buttons do
        layers.sbar:
            fill_color: #0000
            box_shadow: none
            stroke_width: 0
            near_border: false
            near_inset: 0.0
    }

# the side panel's shade over the editors: dark at the seam, clear
# 12 px in; it takes no input
element SeamShade
    style : CSS {
        area: r0 t0 w0.36 b1.06
        layers.shade:
            fill_color: #00000040
            fill_color_pos: 1.0 0.0
            fill_gradient: linear
            fill_gradient_color: #0000
            fill_gradient_angle: 180.0
            fill_gradient_radius: 12.0
            stroke_width: 0
    :use_mobile
        area: r0 t0 w0.36 b0
    }

# the nav list's view column: a shaded right edge, its buttons lit
Group ViewBar
    # at the window's edge (the side panel folded): no shading
    public on_edge : bool
    style : CSS {
        # a quarter-dark right edge, clear from three quarters across
        layers.vbar:
            fill_color: #00000040, 400ms cubic outward
            fill_color_pos: 1.0 0.0
            fill_gradient: linear
            fill_gradient_color: #0000
            fill_gradient_angle: 180.0
            fill_gradient_radius: 14.0
            # the bar itself takes no light: its buttons do
            stroke_width: 0
        :on_edge
            layers.vbar:
                fill_color: #0000
                fill_gradient: none
    }

# a view toggle in that column: a border only the pointer lights
TButtons ViewTab
    outline : rgba [ '#0000' ]
    style : CSS {
        layers.edge:
            fill_color: #0000
            stroke_width: 1
            stroke_color: #ffffff01
            near_border: true
            near_inset: 2.0
            near_inset_color: #c890ffaa
    }

# the status bar's words, in the middle of it
element StatusText
    no_cache : true
    style : CSS {
        layers.face:
            label_color: #cfe6ff
            label_size: 14
            label_align: 0.5 0.5
    }

# the status bar's debug buttons: the orbiter button's near light
TButtons StatusTab
    # the near glow's violet, see-through: the glow shows under it
    lit_fill : rgba [ '#c890ff40' ]
    # its icon: full when selected, dimmer when not, gone when off
    rest_alpha : f32 [ 0.7 ]
    off_alpha  : f32 [ 0.0 ]
    # nothing to press: the pointer's light leaves it alone too
    public unavailable : bool
    # showing its second action: AltTab's yellow
    public second : bool
    style : CSS {
        layers.edge:
            fill_color: #0000
            box_shadow: inset 0 0 13px #8af0
            stroke_width: 1
            stroke_color: #fff1
            near_border: true
            near_inset: 2.0
            near_reach: 0.5
            near_inset_color: #c890ffff
        :second
            layers.edge:
                box_shadow: inset 0 0 13px #ffd84a66
                near_inset: 4.0
                near_inset_color: #ffd84aff
        :unavailable
            layers.edge:
                near_border: false
                near_inset: 0.0
    }

# a button with a second action: cmd shows it on every such button,
# shift only on the one under the pointer, its glow then yellow
TButtons AltTab
    public second : bool
    style : CSS {
        layers.edge:
            fill_color: #0000
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            # 1/255: unseen at rest, yet the near light lights it
            stroke_color: #ffffff01
            near_border: true
            near_reach: 0.5
            near_inset: 4.0
            near_inset_color: #c890ffff
        :second
            layers.edge:
                box_shadow: inset 0 0 13px #ffd84a66
                near_inset_color: #ffd84aff
    }
    # a cmd press is this button's second action, not the inspector's
    func on_press [ ev: Event ]
        super.on_press[ ev ]
        if [ ev.key.meta || ev.key.ctrl ] ev.no_default = true

# an icon alone in a bar (find, find in files): no edge, no light
TButtons BarIcon
    style : CSS {
        layers.edge:
            fill_color: #0000
            stroke_width: 0
            box_shadow: none
            near_border: false
            near_inset: 0.0
    }

# the system menu's buttons and tiles: AltTab's light on a round edge
# (a radius past half the height is a circle, or a pill)
AltTab RoundTab
    style : CSS {
        layers.edge:
            fill_color: #0000
            radius: 999
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            # 1/255: unseen at rest, yet the near light lights it
            stroke_color: #ffffff01
            near_border: true
            near_reach: 0.5
            near_inset: 4.0
            near_inset_color: #c890ffff
        :second
            layers.edge:
                box_shadow: inset 0 0 13px #ffd84a66
                near_inset_color: #ffd84aff
    }

# on the status bar: a faint border the pointer's light brings up
StatusTab StatusButton
    outline : rgba [ '#0000' ]
    style : CSS {
        layers.edge:
            stroke_color: #ffffff08
    }

# the bottom bar's volume: the slider inside a 1 px outline (room
# for a spectrum behind the track later)
# the system menu's level (the screen's light): a round thumb (4/5
# of the height, a round button's look) on a thin pill track half its
# height; inside the track, set in from its edge, solid white from
# the left to the thumb. pad_l / pad_r set the track so the thumb
# sits inside the pill at both ends; an icon in pad_l
VolumeSlider BarLevel
    # the backdrop moves under it
    animated : true
    # images/<icon>.svg, drawn in pad_l
    public icon : string
    mutable icon_svg : SVGModel
    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        cv : Canvas w.screen
        h : f32 [ bounds.h ]
        kd : f32 [ round[ h * 0.8 ] ]
        kr : f32 [ kd * 0.5 ]
        th : f32 [ round[ kd * 0.5 ] ]
        ty : f32 [ round[ (h - th) * 0.5 ] ]
        tr : f32 [ th * 0.5 ]
        cv.save[ ]
        cv.save[ ]
        cv.clip_rounded_rect[ pad_l, ty, bounds.w - pad_l - pad_r, th,
                              tr, tr, tr, tr ]
        w.draw_blur[ cv, a, BlurStage.blur ]
        cv.restore[ ]
        # the track's border: the round buttons' edge, lit by the
        # pointer as theirs
        cv.save[ ]
        w.near_light_reach[ cv, a, 0.0, 0.0, 0.5 ]
        cv.near_style[ 1.0, 2.0, rgba [ '#c890ffff' ], w.near_y_fade ]
        cv.rounded[ tr, tr, tr, tr ]
        cv.fill_color[ rgba [ '#ffffff08' ] ]
        cv.stroke_width[ 1.0 ]
        cv.stroke_offset[ -0.5 ]
        cv.stroke_color[ rgba [ '#ffffff1c' ] ]
        cv.rect_to[ pad_l, ty, bounds.w - pad_l - pad_r, th ]
        cv.paint[ ]
        cv.restore[ ]
        if [ icon && pad_l > 0.0 ]
            if [ !icon_svg ] icon_svg = SVGModel [ 'images/{icon}.svg' ]
            ic : f32 [ round[ min[ pad_l, h ] * 0.7 ] ]
            cv.draw_svg[ icon_svg, round[ (pad_l - ic) * 0.5 ],
                         round[ (h - ic) * 0.5 ], ic, ic ]
        # the track VolumeSlider's hit math uses (its inset is 7 px)
        tx : f32 [ 7.0 + pad_l ]
        tw : f32 [ bounds.w - 14.0 - pad_l - pad_r ]
        kx : f32 [ tx + tw * clamp[ value, 0.0, 1.0 ] ]
        # the level: white, inside the track, up to the thumb
        ins : f32 [ 4.0 ]
        lh : f32 [ th - ins * 2.0 ]
        lw : f32 [ round[ kx - pad_l - ins ] ]
        if [ lh > 0.5 && lw > 1.0 ]
            if [ lw < lh ] lw = lh
            cv.stroke_width[ 0.0 ]
            cv.rounded[ lh * 0.5, lh * 0.5, lh * 0.5, lh * 0.5 ]
            cv.fill_color[ rgba [ '#ffffffdd' ] ]
            cv.rect_to[ pad_l + ins, ty + ins, lw, lh ]
            cv.paint[ ]
        # the thumb: a round button: an opaque ground (the track's line
        # stays under it), the faint fill, the inner glow, the edge the
        # pointer lights
        ky : f32 [ round[ (h - kd) * 0.5 ] ]
        cv.rounded[ kr, kr, kr, kr ]
        cv.stroke_width[ 0.0 ]
        cv.fill_color[ rgba [ '#211a33' ] ]
        cv.rect_to[ kx - kr, ky, kd, kd ]
        cv.paint[ ]
        cv.save[ ]
        w.near_light_reach[ cv, a, 0.0, 0.0, 0.5 ]
        cv.near_style[ 1.0, 4.0, rgba [ '#c890ffff' ], w.near_y_fade ]
        cv.box_shadow[ rgba [ '#8af2' ], 0.0, 0.0, 13.0, 0.0, true ]
        cv.rounded[ kr, kr, kr, kr ]
        cv.fill_color[ rgba [ (hovered) ? '#ffffff1c' : '#ffffff10' ] ]
        cv.stroke_width[ 1.0 ]
        cv.stroke_offset[ -0.5 ]
        cv.stroke_color[ rgba [ '#ffffff10' ] ]
        cv.rect_to[ kx - kr, ky, kd, kd ]
        cv.paint[ ]
        cv.no_shadows[ ]
        cv.restore[ ]
        cv.restore[ ]

# a group whose buttons each take the light, a disabled one none
StatusButton StatusSegs
    seg_near  : rgba [ '#ffffff08' ]
    seg_reach : f32 [ 0.5 ]
    style : CSS {
        layers.edge:
            stroke_width: 0
            near_border: false
            near_inset: 0.0
    }

