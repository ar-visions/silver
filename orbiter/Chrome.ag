Button PillButton
    style : CSS {
        area: l6+px t3px w3.6 h1.2
        layers.body:
            fill_color: #114
            fill_gradient: linear
            fill_gradient_color: #315f
            fill_gradient_angle: 90.0
            box_shadow: inset 0 0 8px #ccf2
            radius: 8
            stroke_width: 1
            stroke_color: #fff1
        layers.face:
            label_color: #fff
            label_size: 14
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.5 0.5
        :hovered
            layers.body:
                fill_color: #216
                fill_gradient_color: #327f
                box_shadow: inset 0 0 8px #ccf4
        :selected
            layers.body:
                fill_color: #c8641e
                fill_gradient_color: #425f
                box_shadow: inset 0 0 9px #ffae5ea2
    }


Option  ProjectTab
    public state : string


func au_space_clear[] -> none

func au_capture_stdout[] -> i32
func au_stdout_orig[] -> i32

# the active pane's window menu, read again when the window changes
# (and each second while it has none: GTK names it after mapping)
func orbiter.menu_sync [] -> bool
    if [ sys_up[] ] return sys_menu_sync[]
    wn : u64 pane_window[ active_pane ]
    if [ wn == 0 ] return own_menu_sync[]
    menu_own = null
    now : i64 [ epoch_millis[] ]
    empty : bool [ !menu_items || menu_items.count == 0 ]
    # the window gave none yet (it builds its menu after mapping):
    # asked again each second; the pane's own entries do not count
    stale : bool [ menu_got == 0 && wn != 0
                   && now - menu_ms > 1000 ]
    if [ wn == menu_win && !stale ] return false
    fresh : vec TrayEntry menu_read[ wn ]
    # still none: what shows (our entries, an open drawer) stays
    if [ wn == menu_win && fresh.count == 0 ]
        menu_ms = now
        return false
    had : bool [ !empty ]
    # an open drawer stays on the name it shows, by its label
    was : string [ (wn == menu_win && menu_items && menu_top >= 0
        && menu_top < menu_items.count)
        ? menu_items[ menu_top ].label : '' ]
    menu_win = wn
    menu_ms  = now
    menu_top = -1
    menu_items = fresh
    menu_got = i32[ menu_items.count ]
    if [ was.count > 0 ]
        pane_menu[]
        for [ i: i32 0, i < menu_items.count, i += 1 ]
            e : TrayEntry menu_items[ i ]
            if [ menu_top < 0 && e.depth == 0 && e.label == was ]
                menu_top = i
    return had || menu_items.count > 0

# the main menu's own menus in the bar: Agents
func orbiter.sys_menu_sync [] -> bool
    if [ menu_win == 0 && menu_own && menu_own == 'sys' ]
        return false
    menu_win = 0
    menu_own = 'sys'
    menu_top = -1
    menu_items = vec TrayEntry []
    return true

# a member's name as a menu says it: save_state -> Save state
func orbiter.menu_words [ id: string ] -> string
    out : string ''
    for [ i: i32 0, i < id.count, i += 1 ]
        c : i32 [ id.chars[ i ] ]
        if [ c == 95 ] out = out + ' '
        el [ i == 0 && c >= 97 && c <= 122 ]
            out = out + id.mid[ 0, 1 ].ucase[]
        el out = out + id.mid[ i, 1 ]
    return out

func orbiter.menu_read [ wn: u64 ] -> vec TrayEntry
    if [ wn == 0 ] return vec TrayEntry []
    k : i32 wlc_window_menu_kind[ wn ]
    if [ k == 0 ] return sock_menu[ wn ]
    return app_menu[].read[ k, string[ wlc_window_menu_bus[ wn ] ],
        string[ wlc_window_menu_path[ wn ] ],
        string[ wlc_window_menu_app[ wn ] ],
        string[ wlc_window_menu_win[ wn ] ] ]

# the orbiter menu's place: the selected docked half under the
# bar; a phone's, or with none docked, the whole window
# the main menu's width: its pane's, else the window's
func orbiter.sys_room [] -> f32
    pv : element pane_view[ active_pane ]
    if [ mobile_on[] || !pv || !pv.bounds
         || pane_floats[ active_pane ] ]
        return (ux) ? ux.width : 0.0
    return pv.bounds.w

# the main menu is a master switch: the whole window under the bar,
# never one pane's part
func orbiter.sys_area [ top: f32 ] -> string
    return 'l0 t{top}px r0 b0'

# the main menu's left edge: the window's
func orbiter.sys_x [] -> f32
    return 0.0

func orbiter.menu_open_at [ mt: MenuTop, same: bool ]
    at : i32 [ mt.at ]
    # the desktop, a folder open with its module's menus
    fs : MenuSource [ (pane_empty[ active_pane ]) ? fold_now[]
                      : null ]
    if [ fs ]
        menu_items = fold_items[ fs ]
        menu_own   = ''
        menu_top   = at
        drawer_anchor[ mt ]
        drawer_toggle[ 'menu', same ]
        return
    menu_top = at
    drawer_anchor[ mt ]
    if [ menu_win != 0 ]
        menu_items = menu_read[ menu_win ]
        menu_got = i32[ menu_items.count ]
    el
        menu_own = null
        if [ sys_up[] ] sys_menu_sync[]
        el own_menu_sync[]
        menu_top = at
    if [ !sys_up[] ] pane_menu[]
    drawer_toggle[ 'menu', same ]

# any of the bar's drawers open (a menu, a path's, the system
# menu): the pointer onto another name opens that one
func orbiter.bar_drawer_up [] -> bool
    return drawer_open && (menu_kind == 'menu'
        || menu_kind == 'crumb' || menu_kind == 'system')

func orbiter.menu_hover [ mt: MenuTop ]
    if [ !bar_drawer_up[] || mt.close_part ] return
    # the desktop's name: the system menu
    if [ mt.at == -2 ]
        if [ menu_kind != 'system' ] desk_menu_at[ mt ]
        return
    if [ mt.pane != active_pane ] return
    # the main menu alone: its own names open on a press only
    if [ menu_kind == 'system' ] return
    if [ menu_kind == 'menu' && mt.at == menu_top ] return
    menu_open_at[ mt, false ]

func orbiter.drawer_toggle [ kind: string, same: bool ]
    # another menu: the exchange's slideout is put away (kept)
    if [ ux && ux.shot_ask && !ux.agent_min
         && ux.exchange_region && ux.exchange_region.count > 0 ]
        ux.agent_min = true
        ux.restyle   = true
    if [ drawer_open && menu_kind == kind && same ]
        drawer_shut[]
        return
    # a menu opened over the main menu: it stays under
    if [ kind == 'system' ] sys_under = false
    el [ drawer_open && menu_kind == 'system' ] sys_under = true
    # a menu and the switcher never show together
    switcher     = false
    drawer_open  = true
    menu_kind    = kind
    menu_page    = ''
    menu_slide   = 0.0
    menu_open_us = epoch_micros[]
    # over the main menu: its one background, not taken again
    if [ !sys_under ] drawer_fresh = false
    menu_filter  = ''
    menu_lit     = -1
    drawer_focus = true
    if [ ux ] ux.restyle = true

func orbiter.drawer_shut []
    if [ !drawer_open ] return
    menu_lit       = -1
    menu_page      = ''
    # a menu over the main menu: back to the main menu
    if [ sys_under && menu_kind != 'system' ]
        sys_under = false
        menu_kind = 'system'
        filter_done[ 'filter' ]
        if [ ux ] ux.restyle = true
        return
    drawer_open    = false
    filter_done[ 'filter' ]
    menu_shut_ms = epoch_millis[]
    if [ ux ] ux.restyle = true

# the screen as drawn so far, blurred: once as the drawer opens,
# again only for a new window size
func orbiter.drawer_blur [ w: Window, live: bool ] -> ReduceBlur
    sc : Canvas w.screen
    if [ !sc || !sc.color ] return null
    tx : Texture sc.color
    if [ !drawer_snap ]
        drawer_snap = Texture [ vk: w.vk, w: w, width: tx.width,
            height: tx.height, vk_format: tx.vk_format ]
        drawer_rb = ReduceBlur []
        drawer_rb.build[ vk_context[ w.vk ], w, drawer_snap, 1.0, 2 ]
        drawer_fresh = false
    el [ drawer_snap.width != tx.width
         || drawer_snap.height != tx.height ]
        drawer_snap.resize[ tx.width, tx.height ]
        drawer_rb.resize[ drawer_snap ]
        drawer_fresh = false
    if [ drawer_fresh && !live ] return drawer_rb
    drawer_fresh = true
    sc.sync_fence[]
    w.vk.copy_image[ tx, drawer_snap ]
    drawer_rb.run[]
    return drawer_rb

# mounted while open, and while it slides away
func orbiter.drawer_on [] -> bool
    return drawer_open || epoch_millis[] - menu_shut_ms < 400

func orbiter.drawer_els [] -> Elements
    t : Elements []
    if [ menu_kind == 'tray' ]
        t['tray_panel'] = TrayPanel [ filter: menu_filter,
            lit: menu_lit, area: Region { l0 t0 r0 b0 } ]
    el [ menu_kind == 'crumb' ]
        t['menu_panel'] = MenuPanel [ items: crumb_items, top: 0,
            filter: menu_filter, lit: menu_lit,
            area: Region { l0 t0 r0 b0 } ]
    el [ menu_kind == 'login' ]
        if [ login_el ]
            login_el.area = Region { l0 t0 r0 b0 }
            t['login'] = login_el
    el [ menu_kind == 'popup' ]
        t['menu_panel'] = MenuPanel [ items: popup_items, top: 0,
            filter: menu_filter, lit: menu_lit,
            area: Region { l0 t0 r0 b0 } ]
        # the devices: under their rows, a host by its name or its
        # address, connected to as it is (none of devices.agi's)
        if [ popup_for == 'device' && popup_items ]
            y : f32 [ f32[ popup_items.count - 1 ] * 1.05 + 0.9 ]
            t['dev_addr'] = PageField [ label: 'host: name, IPv4 or IPv6',
                area: Region [ 'l0.6 t{y} r0.6 h1.2' ] ]
            un : f32 unit_px[]
            ch : f32 [ round[ 1.1 * un ] ]
            t['dev_connect'] = RoundTab [
                buttons: vec string [] [ 'dev_connect' ],
                icon_ids: vec string [] [ '_text' ],
                labels: vec string [] [ 'Connect' ],
                label_font: 'fonts/BarlowCondensed-Regular.ttf',
                label_px: 0.5 * ch, manual: true,
                seg_radius: ch * 0.5, use_spacing: false,
                rest_fill: rgba [ '#00000026' ],
                area: Region [ 'l0.6 t{y + 1.45} r0.6 h1.1' ] ]
            if [ dev_problem && dev_problem.count > 0 ]
                t['dev_note'] = PageNote [ label: dev_problem,
                    wrong: true,
                    area: Region [ 'l0.7 t{y + 2.75} r0.7 h1.4' ] ]
    el [ menu_kind == 'appinfo' ]
        t['menu_page'] = MenuPage [ info: true, panel: 'info_props',
            elements: app_info_els[], area: Region { l0 t0 r0 b0 } ]
    el
        # the rows, and the page slid over them (clipped to the
        # drawer): each as far along as the slide is
        sl : element find_el[ a, 'menu_slide' ]
        dw : f32 [ (sl && sl.bounds) ? sl.bounds.w
            : 10.91 * unit_px[] ]
        ox : f32 [ round[ menu_slide * dw ] ]
        se : Elements []
        se['menu_panel'] = MenuPanel [ items: menu_items,
            top: menu_top, filter: menu_filter, lit: menu_lit,
            area: Region [ 'l{-ox}px t0 w{dw}px b0' ] ]
        if [ menu_slide > 0.0 ]
            se['menu_page'] = MenuPage [ form: menu_page == 'fold',
                elements: menu_page_els[],
                area: Region [ 'l{dw - ox}px t0 w{dw}px b0' ] ]
        t['menu_slide'] = MenuSlide [ elements: se,
            area: Region { l0 t0 r0 b0 } ]
    return t

# the properties page: a back row at the top, then the instance's
# property panel (the side panel's, its edits the same)
func orbiter.menu_page_els [] -> Elements
    if [ menu_page == 'fold' && fold_page ] return fold_page_els[]
    t : Elements []
    bk : TrayEntry own_entry[ '‹  Properties', 'orb.pback', 1 ]
    mb : MenuBuild []
    mb.row[ 'back', bk, -1, 0 ]
    mb.finish[]
    t['head'] = PanelRows [ elements: mb.out,
        area: Region { l0 t0.3 r0 h1.35 } ]
    ed : Editor pane_at[ active_pane ]
    av : AppView pane_av[ active_pane ]
    if [ !av ] return t
    lv : bool [ av.props && av.props.count > 0 ]
    am : string av.app_mod
    mod : string (am && am.count > 0) ? am : av.src.stem[]
    sp : string (lv) ? av.props : module_spec[ mod ]
    # before it runs: the display it will launch as
    if [ !(sp && sp.count > 0) ]
        dp : Prop [ ident: 'display', module: 'trinity',
                    type: 'DisplayMode', access: 'public' ]
        dp.meta  = vec string [] [ 'Live' ]
        dp.stops = vec string [] [ 'PIP', 'Embed', 'Window',
                                   'Screen' ]
        dp.value = (av.display >= 0 && av.display < 4)
            ? dp.stops[ av.display ] : 'PIP'
        ps : LaunchProps [ module: mod ]
        ps.props = vec Prop []
        ps.props.push[ dp ]
        sp = Au.string_agi[ ps ]
    up : bool [ av.slot >= 0 && !av.ended && !av.held ]
    t['menu_props'] = LaunchPanel [ spec: sp,
        args: (av.module_args) ? av.module_args : '',
        inst: av.iid, live_vals: lv, dbg_row: true,
        cov_on: av.cov_build,
        pid_val: (up) ? host_app_pid[ av.slot ] : 0,
        area: Region { l0 t1.8 r0 b0.3 } ]
    return t

# a folder's page: its entry's name to go back, a field each
# its module asked for, and the entry's go row
func orbiter.fold_page_els [] -> Elements
    t : Elements []
    bk : TrayEntry own_entry[ '‹  {fold_page.label}', 'orb.pback',
                              1 ]
    mb : MenuBuild []
    mb.row[ 'back', bk, -1, 0 ]
    mb.finish[]
    t['head'] = PanelRows [ elements: mb.out,
        area: Region { l0 t0.3 r0 h1.35 } ]
    y : f32 [ 2.0 ]
    fl : vec string page_fields[ fold_page ].split[ '|' ]
    for [ i: i32 0, i < fl.count, i += 1 ]
        nm : string field_name[ fl[ i ] ]
        hid : bool nm.starts_with[ '*' ]
        tg  : bool nm.starts_with[ '?' ]
        if [ hid || tg ] nm = nm.mid[ 1, nm.count - 1 ]
        ar : Region Region [ 'l0.6 t{y} r0.6 h1.2' ]
        # a field's name stays beside it, its value filled or not
        fa : Region Region [ 'l8 t{y} r0.6 h1.2' ]
        if [ !tg ]
            t['pn_{i}'] = PageNote [ label: nm,
                area: Region [ 'l0.7 t{y + 0.3} w7 h0.9' ] ]
        if [ tg ] t['pf_{i}'] = PageCheck [ label: nm, area: ar ]
        el [ hid ] t['pf_{i}'] = PageSecret [ label: nm, area: fa ]
        el t['pf_{i}'] = PageField [ label: nm, area: fa ]
        y += 1.45
    gw : string page_part[ fold_page, 2 ]
    go : TrayEntry own_entry[ (gw.count > 0) ? gw
        : fold_page.label.trim[], 'orb.pgo', 1 ]
    gb : MenuBuild []
    gb.row[ 'pgo', go, -1, 0 ]
    gb.finish[]
    t['go'] = PanelRows [ elements: gb.out,
        area: Region [ 'l0 t{y + 0.3} r0 h1.35' ] ]
    y += 1.9
    # what was wrong with the last go, then the module's note
    if [ fold_problem && fold_problem.count > 0 ]
        t['pwrong'] = PageNote [ label: fold_problem, wrong: true,
            area: Region [ 'l0.7 t{y} r0.7 h1.4' ] ]
        y += 1.5
    nt : string page_part[ fold_page, 1 ]
    if [ nt.count > 0 ]
        t['pnote'] = PageNote [ label: nt,
            area: Region [ 'l0.7 t{y} r0.7 h4' ] ]
    return t

# a page's target in its parts by #: its fields (each name=value,
# by |), a note, the go button's word
func orbiter.page_part [ e: TrayEntry, n: i32 ] -> string
    ps : vec string e.target.split[ '#' ]
    return (n < ps.count) ? ps[ n ] : ''

func orbiter.page_fields [ e: TrayEntry ] -> string
    return page_part[ e, 0 ]

# the page's fields given their values once they are mounted
func orbiter.fold_page_seed []
    if [ !fold_seed || !fold_page ] return
    if [ !find_el[ a, 'pf_0' ] ] return
    fold_seed = false
    fl : vec string page_fields[ fold_page ].split[ '|' ]
    for [ i: i32 0, i < fl.count, i += 1 ]
        eq : i32 [ i32[ fl[ i ].index_of[ '=' ] ] ]
        if [ eq < 0 ] continue
        v : string fl[ i ].mid[ eq + 1, fl[ i ].count - eq - 1 ]
        fe : element find_el[ a, 'pf_{i}' ]
        if [ !fe ] continue
        pc : PageCheck [ (fe inherits PageCheck)
            ? cast PageCheck [ fe ] : null ]
        if [ pc ] pc.set_on[ v == 'on' ]
        el fe.edit = v
        fe.pristine = false

# the page's go: its fields' words, tab between, to its module
func orbiter.fold_page_go []
    fs : MenuSource fold_now[]
    if [ !fs || !fold_page ] return
    n : i32 [ i32[ page_fields[ fold_page ].split[ '|' ].count ] ]
    words : string fold_page.action.mid[ 5,
                                         fold_page.action.count - 5 ]
    for [ i: i32 0, i < n, i += 1 ]
        fe : element find_el[ a, 'pf_{i}' ]
        v : string [ (fe && fe.edit) ? fe.edit : '' ]
        if [ fe && fe inherits PageCheck ]
            v = ((cast PageCheck [ fe ]).on) ? 'on' : 'off'
        words = '{words}\t{v}'
    fs.pick*[ words ]
    fold_problem = (fs.problem) ? fs.problem : ''
    menu_items = fold_items[ fs ]
    # wrong: the page stays, the problem on it
    if [ fold_problem.count == 0 ] menu_page = ''
    if [ ux ] ux.restyle = true

# the page's back row: the rows slide back
func orbiter.menu_page_back []
    menu_page = ''
    if [ ux ] ux.restyle = true

# the entries the open drawer would run, in the order shown
func orbiter.drawer_choices [] -> vec i32
    out : vec i32 []
    if [ menu_kind == 'system' ] return out
    if [ menu_kind == 'tray' ]
        it : TrayItem tray_shared[].shown_item[]
        if [ !it ] return out
        for [ i: i32 0, i < it.entries.count, i += 1 ]
            e : TrayEntry it.entries[ i ]
            if [ e.enabled && !e.rule
                 && entry_matches[ e, menu_filter ] ]
                out.push[ i ]
        return out
    if [ menu_kind == 'crumb' || menu_kind == 'popup' ]
        its : vec TrayEntry [ (menu_kind == 'crumb') ? crumb_items
                                                     : popup_items ]
        if [ !its ] return out
        for [ i: i32 1, i < its.count, i += 1 ]
            ce : TrayEntry its[ i ]
            if [ ce.enabled && !ce.rule
                 && entry_matches[ ce, menu_filter ] ]
                out.push[ i ]
        return out
    if [ !menu_items ] return out
    for [ i: i32 menu_top + 1, i < menu_items.count, i += 1 ]
        e : TrayEntry menu_items[ i ]
        if [ e.depth <= 0 ] break
        deeper : bool [ i + 1 < menu_items.count
            && menu_items[ i + 1 ].depth > e.depth ]
        if [ !deeper && e.enabled && !e.rule
             && entry_matches[ e, menu_filter ] ]
            out.push[ i ]
    return out

# the app's own name at the bar's start (the desktop's orbiter)
func orbiter.bar_lead [ e: element ] -> element
    if [ !e ] return null
    if [ e inherits MenuTop ]
        mt : cast MenuTop [ e ]
        if [ mt.at == -2 || (mt.tab_on && mt.pane == active_pane) ]
            return e
    if [ !e.elements ] return null
    for [ c: element, k: string ] in e.elements
        f : element bar_lead[ c ]
        if [ f ] return f
    return null

# an Alt tap: the bar takes the keys, the app's name lit; again,
# it lets them go
func orbiter.bar_key_toggle []
    if [ bar_hl.count > 0 ]
        bar_hl = ''
    el
        ld : element bar_lead[ a ]
        if [ ld && ld.id ] bar_hl = ld.id
    if [ ux ] ux.restyle = true

# the bar has the keys: left and right move along it, down or
# enter opens the lit name, escape leaves it
func orbiter.bar_key [ ev: Event ] -> bool
    if [ bar_hl.count == 0 || !ev.key.state ] return false
    k : i32 [ ev.key.unicode ]
    cur : element find_el[ a, bar_hl ]
    if [ !cur ]
        bar_hl = ''
        return false
    if [ k == 263 || k == 262 ]
        nx : element bar_next[ cur, (k == 262) ? 1 : -1 ]
        if [ nx && nx.id ] bar_hl = nx.id
    el [ k == 264 || k == 257 || k == 335 ]
        bar_open[ cur ]
    el [ k == 256 ]
        bar_hl = ''
    el
        return false
    if [ ux ] ux.restyle = true
    return true

# a name in the bar: a menu's or a path's piece, or the globe
func orbiter.bar_piece [ e: element ] -> bool
    return e && (e inherits MenuTop || e inherits BarCrumb
        || (e inherits AltTab && e.id == 'bar_title'))

# the bar's name whose drawer is open, anywhere under e
func orbiter.bar_open_piece [ e: element ] -> element
    if [ !e ] return null
    if [ bar_piece[ e ] && e.selected ] return e
    if [ !e.elements ] return null
    for [ c: element, k: string ] in e.elements
        f : element bar_open_piece[ c ]
        if [ f ] return f
    return null

# left or right along the bar: the next name's drawer opens, as
# a press on it would
func orbiter.bar_step [ dir: i32 ]
    nx : element bar_next[ bar_open_piece[ a ], dir ]
    if [ !nx ] return
    # onto the globe: the drawer shuts, the globe lit for the keys
    if [ nx.id == 'bar_title' ]
        drawer_shut[]
        bar_hl = 'bar_title'
        if [ ux ] ux.restyle = true
        return
    bar_open[ nx ]

# the bar's name beside cur, dir to the right (null: none)
func orbiter.bar_next [ cur: element, dir: i32 ] -> element
    if [ !cur || !cur.parent || !cur.parent.elements ] return null
    # the names beside it, left to right
    row : vec element []
    for [ c: element, k: string ] in cur.parent.elements
        if [ !bar_piece[ c ] || !c.bounds ] continue
        at : i32 [ row.count ]
        for [ j: i32 0, j < row.count, j += 1 ]
            if [ at == row.count && c.bounds.x < row[ j ].bounds.x ]
                at = j
        row.insert[ c, at ]
    here : i32 [ -1 ]
    for [ i: i32 0, i < row.count, i += 1 ]
        if [ row[ i ] == cur ] here = i
    to : i32 [ here + dir ]
    if [ here < 0 || to < 0 || to >= row.count ] return null
    return row[ to ]

# a name of the bar opened, as a press on it would
func orbiter.bar_open [ nx: element ]
    menu_lit = -1
    bar_hl   = ''
    if [ nx.id == 'bar_title' ]
        globe_press[]
        if [ ux ] ux.restyle = true
        return
    if [ nx inherits BarCrumb ]
        crumb_press[ cast BarCrumb [ nx ] ]
    el
        mt : cast MenuTop [ nx ]
        if [ mt.at == -2 ]
            desk_menu_at[ mt ]
        el
            if [ mt.pane >= 0 && mt.pane != active_pane ]
                raise_pane[ mt.pane ]
                menu_sync[]
            menu_open_at[ mt, false ]
    if [ ux ] ux.restyle = true

# up or down a row among the drawer's entries
func orbiter.drawer_step [ dir: i32 ]
    ch : vec i32 drawer_choices[]
    if [ ch.count == 0 ] return
    at : i32 [ -1 ]
    for [ i: i32 0, i < ch.count, i += 1 ]
        if [ ch[ i ] == menu_lit ] at = i
    if [ at < 0 ] at = (dir > 0) ? 0 : ch.count - 1
    el at = clamp[ at + dir, 0, ch.count - 1 ]
    menu_lit = ch[ at ]
    if [ ux ] ux.restyle = true

# Enter in the drawer: the first entry the filter shows runs
func orbiter.drawer_enter []
    if [ menu_kind == 'system' ] return
    # the arrow keys' choice, while the drawer still shows it
    lit : i32 [ menu_lit ]
    menu_lit = -1
    shown : bool [ false ]
    for [ c: i32 ] in drawer_choices[]
        if [ c == lit ] shown = true
    if [ lit >= 0 && shown ]
        if [ menu_kind == 'tray' ]
            tr : Tray tray_shared[]
            it : TrayItem tr.shown_item[]
            if [ it ]
                tr.pick[ it, it.entries[ lit ] ]
                drawer_shut[]
        el
            menu_pick[ lit ]
        return
    if [ menu_kind == 'tray' ]
        tr : Tray tray_shared[]
        it : TrayItem tr.shown_item[]
        if [ !it ] return
        for [ e: TrayEntry ] in it.entries
            if [ e.enabled && !e.rule
                 && entry_matches[ e, menu_filter ] ]
                tr.pick[ it, e ]
                drawer_shut[]
                return
        return
    # the path's drawer or a popup: the first entry shown
    if [ menu_kind == 'crumb' || menu_kind == 'popup' ]
        its : vec TrayEntry [ (menu_kind == 'crumb') ? crumb_items
                                                     : popup_items ]
        if [ !its ] return
        for [ i: i32 1, i < its.count, i += 1 ]
            if [ its[ i ].enabled
                 && entry_matches[ its[ i ], menu_filter ] ]
                menu_pick[ i ]
                return
        return
    if [ !menu_items ] return
    for [ i: i32 menu_top + 1, i < menu_items.count, i += 1 ]
        e : TrayEntry menu_items[ i ]
        if [ e.depth <= 0 ] break
        deeper : bool [ i + 1 < menu_items.count
            && menu_items[ i + 1 ].depth > e.depth ]
        if [ !deeper && e.enabled && !e.rule
             && entry_matches[ e, menu_filter ] ]
            menu_pick[ i ]
            return
    return t

func orbiter.menu_pick_side [ i: i32 ]
    if [ !menu_items || i < 0 || i >= menu_items.count ] return
    pe : TrayEntry menu_items[ i ]
    if [ !pe.side_action ] return
    # the open folder's menus: its class takes it, the menu
    # stays up, read again
    if [ pe.side_action.starts_with[ 'fold:' ] ]
        fs : MenuSource fold_now[]
        if [ fs ]
            sa : string pe.side_action
            fs.pick*[ sa.mid[ 5, sa.count - 5 ] ]
            menu_items = fold_items[ fs ]
        if [ ux ] ux.restyle = true
        return
    own_pick[ own_entry[ pe.side, pe.side_action, pe.depth ] ]
    drawer_shut[]
    menu_own = null
    if [ ux ] ux.restyle = true

func orbiter.menu_pick [ i: i32 ]
    # an anonymous menu: its setting takes the row's value
    if [ menu_kind == 'popup' ]
        if [ popup_items && i > 0 && i < popup_items.count ]
            setting_set[ popup_for, popup_items[ i ].target ]
        drawer_shut[]
        if [ ux ] ux.restyle = true
        return
    # the path's drawer: a folder chosen is browsed
    if [ menu_kind == 'crumb' ]
        if [ !crumb_items || i <= 0 || i >= crumb_items.count ]
            return
        ce : TrayEntry crumb_items[ i ]
        cp : path ce.target
        # the title's path: a folder opens its own drawer, a file
        # opens in the pane, Navigate opens the navigator there
        if [ crumb_code && ce.label != 'Navigate' ]
            if [ cp.is_dir[] ]
                crumb_open[ ce.target, crumb_x ]
            el
                drawer_shut[]
                open_in_pane[ cp, active_pane ]
            if [ ux ] ux.restyle = true
            return
        drawer_shut[]
        if [ crumb_code ]
            nav.nav_root = cp
            focus_finder[]
        el
            nav.nav_go[ cp ]
        if [ ux ] ux.restyle = true
        return
    if [ !menu_items || i < 0 || i >= menu_items.count ] return
    pe : TrayEntry menu_items[ i ]
    # the open folder's menus: its class takes the pick; a switch
    # leaves the menu up, read again
    if [ pe.action && pe.action.starts_with[ 'fold:' ]
         && pe.target && pe.target.count > 0 ]
        fold_page = pe
        fold_problem = ''
        fold_seed = true
        menu_page = 'fold'
        if [ ux ] ux.restyle = true
        return
    # the orbiter menu: a row with nothing to do does nothing
    if [ orb_mode[] && (!pe.action || pe.action.count == 0) ] return
    if [ pe.action && pe.action.starts_with[ 'fold:' ] ]
        fs : MenuSource fold_now[]
        if [ fs ]
            fs.pick*[ pe.action.mid[ 5, pe.action.count - 5 ] ]
            menu_items = fold_items[ fs ]
        # the orbiter menu's drawer stays up
        if [ !pe.action.starts_with[ 'fold:toggle ' ] && !orb_mode[] ]
            drawer_shut[]
        if [ ux ] ux.restyle = true
        return
    # a menu the program serves itself: the click goes back to it
    if [ pe.action && pe.action.starts_with[ 'sock.' ] ]
        ws : vec string pe.action.split[ '.' ]
        if [ ws.count == 3 ]
            nm : string 'menu-{ws[ 1 ]}'
            cl : string 'click {ws[ 2 ]}\n'
            agent_sock_send[ nm.chars, cl.chars ]
        drawer_shut[]
        menu_ms  = 0
        menu_win = 0
        if [ ux ] ux.restyle = true
        return
    # the properties page slides over the rows; the menu stays
    pa : string [ (pe.action) ? pe.action : '' ]
    if [ pa == 'orb.props' ]
        menu_page = 'props'
        if [ ux ] ux.restyle = true
        return
    if [ pe.action && pe.action.starts_with[ 'orb.' ] ]
        own_pick[ pe ]
        drawer_shut[]
        menu_own = null
        if [ ux ] ux.restyle = true
        return
    wn : u64 menu_win
    k : i32 wlc_window_menu_kind[ wn ]
    app_menu[].click[ k, string[ wlc_window_menu_bus[ wn ] ],
        string[ wlc_window_menu_path[ wn ] ],
        string[ wlc_window_menu_app[ wn ] ],
        string[ wlc_window_menu_win[ wn ] ], menu_items[ i ] ]
    drawer_shut[]
    # its state may change (a check mark): read it again next time
    menu_ms = 0
    menu_win = 0
    if [ ux ] ux.restyle = true

func orbiter.title_at [ i: i32 ] -> element
    pv : element pane_view[ i ]
    if [ !pv || !pv.elements ] return null
    return pv.elements[ 'title' ]

# arrowing into the list moves focus off the title; the menu stays.
# the commit form's focus keeps it open the same way
# the main menu up (alone, or under a menu opened over it)
# the orbiter menu covers the whole window, slid in (its slide is
# 260 ms; until then what is under it shows)
func orbiter.menu_covers [] -> bool
    return !use_mobile && drawer_open && menu_kind == 'system'
        && epoch_micros[] - menu_open_us > 400000

func orbiter.sys_up [] -> bool
    return drawer_open && (menu_kind == 'system' || sys_under)

# a press in the drawer, or on what opens one, keeps it up
func orbiter.drawer_keeps [ t: element ] -> bool
    if [ t inherits MenuTop || t.id == 'bar_title'
         || t.id == 'bar_orbiter' || t.id == 'sys_close'
         || t inherits NavRows || t inherits NavigationView
         || t inherits NavField
         || t inherits BarCrumb || t inherits TrayMark ]
        return true
    for [ e: element* t, e, e = e.parent ]
        if [ e inherits MenuDrawer ] return true
        # the orbiter menu's desktop: its cards and their forms
        if [ e inherits AppsGrid && orb_mode[] ] return true
    return false

# the orbiter menu's width, px: its bar name, and the system
# menu's column under it
func orbiter.menu_w [] -> f32
    return (7.0 * 9.5 + 22.0) * ux_unit[ ux ]

# the build the bar shows: orbiter's own, else the active
# window's app compiling ('' none); its share in bar_build_f
func orbiter.bar_build [] -> string
    bar_build_f = build_frac[ 'orbiter' ]
    if [ bar_build_f > -2.0 ] return 'orbiter'
    ba : Editor pane_at[ active_pane ]
    bv : AppView pane_av[ active_pane ]
    if [ !bv || bv.status_word[] != 'compiling' || !bv.app_mod ]
        return ''
    bar_build_f = build_frac[ bv.app_mod ]
    return bv.app_mod

# a path's drawer or a menu open: the pointer onto another piece
# opens that piece's drawer, as a menu bar's names do
func orbiter.crumb_hover [ bc: BarCrumb ]
    if [ !bar_drawer_up[] || !bc || !bc.dir ] return
    # the main menu alone (a path's drawer shut back to it): its
    # names open on a press only, so a second press stays shut
    if [ menu_kind == 'system' ] return
    # the same piece: its drawer is already the one open
    if [ menu_kind == 'crumb' && crumb_at && crumb_at == bc.dir ]
        return
    crumb_press[ bc ]

# a piece pressed (or reached by the pointer): its drawer, under
# it; a window's strip's under that strip
func orbiter.crumb_press [ bc: BarCrumb ]
    if [ !bc.bounds ] return
    ax : f32 [ 0.0 ]
    for [ e: element* bc, e, e = e.parent ]
        if [ e.bounds ] ax += e.bounds.x
    crumb_code = bc.code
    if [ bc.pane >= 0 ] active_pane = bc.pane
    # a path's drawer opens at its window's left edge
    drawer_anchor[ bc ]
    crumb_open[ bc.dir, ax ]
    if [ ux ] ux.restyle = true

# a drawer's place from the piece pressed: the window whose strip
# holds it (-1 the system bar); it opens at that window's left edge
func orbiter.drawer_anchor [ e: element ]
    drawer_pane = -1
    for [ p: element* e, p, p = p.parent ]
        if [ p inherits WinStrip ]
            drawer_pane = (cast WinStrip [ p ]).pane
            break
    if [ drawer_pane < 0 ] return
    active_pane = drawer_pane

# a folder of the path pressed: a drawer under it lists its
# folders (the folder itself first, a heading); again, it shuts
func orbiter.crumb_open [ at: string, x: f32 ]
    # again on the same piece: it shuts (the file's and its
    # folder's pieces show one folder, yet are two)
    same_at : bool [ crumb_at && crumb_at == at ]
    crumb_at = at
    # the file a pane shows: the drawer is its folder's
    dir : string at
    ap : path at
    if [ !ap.is_dir[] ]
        dir = '{ap.directory[]}'
    same : bool [ same_at ]
    crumb_dir = dir
    crumb_x   = x
    crumb_items = vec TrayEntry []
    p : path dir
    crumb_items.push[ TrayEntry [ label: (dir == '/') ? '/'
        : p.filename[], depth: 0, enabled: true, check: -1,
        target: dir ] ]
    subs : vec string []
    files : vec string []
    for [ e: path ] in p.ls[ null, false ]
        if [ e.is_dir[] ] subs.push[ e.filename[] ]
        el [ crumb_code ] files.push[ e.filename[] ]
    # by name, the hidden ones after
    srt : vec string []
    for [ n: string ] in subs
        at_ : i32 [ srt.count ]
        hn : bool [ n.starts_with[ '.' ] ]
        for [ j: i32 0, j < srt.count, j += 1 ]
            hj : bool [ srt[ j ].starts_with[ '.' ] ]
            lt : bool [ n.lcase[].compare[ srt[ j ].lcase[] ] < 0 ]
            if [ (hn == hj && lt) || (!hn && hj) ]
                at_ = j
                break
        srt.insert[ n, at_ ]
    # first, a group of its own: this folder itself, the back arrow
    li : path 'images/left.svg'
    crumb_items.push[ TrayEntry [ label: 'Navigate', depth: 1,
        enabled: true, check: -1, icon: '{li.absolute[]}',
        target: dir ] ]
    crumb_items.push[
        TrayEntry [ rule: true, depth: 1, check: -1 ] ]
    base : string [ (dir == '/') ? '' : dir ]
    for [ n: string ] in srt
        crumb_items.push[ TrayEntry [ label: n, depth: 1,
            enabled: true, check: -1, icon: 'folder',
            target: '{base}/{n}' ] ]
    # the title's path: the folder's files after its folders
    for [ n: string ] in name_sort[ files ]
        crumb_items.push[ TrayEntry [ label: n, depth: 1,
            enabled: true, check: -1, icon: 'text-x-generic',
            target: '{base}/{n}' ] ]
    drawer_toggle[ 'crumb', same ]
    # the navigator keeps the focus: it stays open under the drawer;
    # a file's path takes it, as a menu does (typing filters it,
    # never the code)
    drawer_focus = crumb_code

# the pane the system bar is the title of: the selected one
# docked, else the first docked one (-1: every window is free)
func orbiter.bar_pane [] -> i32
    if [ !pane_floats[ active_pane ] && !pane_hidden[ active_pane ]
         && !pane_below[ active_pane ] ]
        return active_pane
    for [ i: i32 0, i < editor_slots.count, i += 1 ]
        if [ !pane_floats[ i ] && !pane_hidden[ i ]
             && !pane_below[ i ] ]
            return i
    return -1

# the instances of the apps no pane shows (in the app menu)
# the address bar edited: the whole address chosen, so the
# first key replaces it
func orbiter.bar_type_start []
    f : element find_el[ a, 'bar_url' ]
    if [ !f || bar_typing ] return
    ed_ : Editor pane_at[ active_pane ]
    rv_ : AppView pane_av[ active_pane ]
    bar_text = (rv_ && rv_.app_address) ? rv_.app_address
        : ((rv_ && rv_.arg_text) ? rv_.arg_text
        : ((rv_) ? default_arg_of[ rv_.module_args ] : ''))
    bar_typing = true
    f.read_only  = false
    f.edit       = bar_text
    f.anchor_col = 0
    f.sel_col    = bar_text.count
    f.set_focus[]
    if [ ux ] ux.restyle = true

# the title after the app's name; its width back
func orbiter.bar_title_el [ t: Elements, tt: string, x: f32, xr: f32 ]
    if [ xr <= x ] return
    ed : Editor pane_at[ active_pane ]
    rv : AppView pane_av[ active_pane ]
    dm : string domain_of[ (rv) ? rv.app_address : null ]
    t['bar_url'] = BarTitle [ label: '', read_only: !bar_typing,
        typing: bar_typing, site: tt, domain: dm,
        area: Region [ 'l{x}px t0 w{xr - x}px b0' ] ]
    if [ bar_typing ] return
    # the name from the left, cut with a fade where the domain
    # needs the room; the domain at the right, yellow over https
    bt : cast BarTitle [ find_el[ a, 'bar_url' ] ]
    if [ !bt ] return
    uu : f32 ux_unit[ ux ]
    pad : f32 [ 10.0 * uu ]
    bw : f32 [ xr - x ]
    dw : f32 [ (dm.count > 0) ? bt.domain_w + 2.0 * pad : 0.0 ]
    # a module acts on this page: its chip left of the domain
    pm : string (ed && rv) ? ed.page_module[ rv.app_address ] : ''
    gw : f32 [ (pm.count > 0) ? round[ 56.0 * uu ] : 0.0 ]
    if [ gw > 0.0 && bw - dw - gw > 4.0 * pad ]
        t['bar_page'] = BarButton [ label: 'Get',
            use_spacing: false,
            area: Region [ 'l{xr - dw - gw}px t0 w{gw}px b0' ] ]
        dw += gw
    if [ dw > 0.0 ]
        t['bar_domain'] = BarDomain [ label: dm,
            secure: rv && rv.app_address
                && rv.app_address.starts_with[ 'https://' ],
            area: Region [
                'l{xr - dw + pad}px t0 w{dw - 2.0 * pad}px b0' ] ]

# the active pane shows a running app (not a window's)
func orbiter.bar_app_on [] -> bool
    return pane_app_on[ active_pane ]

# the active pane runs an app whose live argument is typed (a URL)
func orbiter.bar_url_on [] -> bool
    ed : Editor pane_at[ active_pane ]
    rv : AppView (pane_live[ active_pane ]) ? pane_av[ active_pane ] : null
    if [ !rv || rv.ended || window_of[ rv ] != 0 ] return false
    return url_app[ rv ]

# what the active pane holds, after the app's name: the app's URL
# or file, else the file shown, else the pane's own title
func orbiter.bar_title [] -> string
    return bar_title_of[ active_pane ]

func orbiter.bar_title_of [ pi: i32 ] -> string
    # an agent's terminal: the instance and its model
    pc : string [ (pi >= 0 && pi < pane_console.count)
                  ? pane_console[ pi ] : '' ]
    if [ pc.starts_with[ 'home:' ] ]
        hn : string pc.mid[ 5, pc.count - 5 ]
        ht : string home_title[ hn ]
        hm : string home_model_of[ hn ]
        return (hm.count > 0) ? '{ht}  {hm}' : ht
    ed : Editor pane_at[ pi ]
    rv : AppView pane_av[ pi ]
    if [ rv && !rv.ended && window_of[ rv ] == 0 ]
        # the app's own title (a site's name); its address once
        # pressed
        if [ rv.app_title && rv.app_title.count > 0 ]
            return rv.app_title
        if [ rv.app_address && rv.app_address.count > 0 ]
            return rv.app_address
        return ''
    if [ ed && ed.src ] return ed.src.filename[]
    pv : element pane_view[ pi ]
    if [ !pv || !(pv inherits EditorView) ] return ''
    ev_ : EditorView pv
    tx : string ev_.title_text[]
    return (tx) ? tx : ''

# a press on the bar's title: a typed argument (a URL) is edited
# here; a file opens the navigator; a pane with no app, too
func orbiter.bar_title_press []
    ed : Editor pane_at[ active_pane ]
    rv : AppView (pane_live[ active_pane ]) ? pane_av[ active_pane ] : null
    if [ rv && window_of[ rv ] != 0 ] rv = null
    if [ rv && !rv.ended ]
        if [ url_app[ rv ] ]
            bar_text = (rv.arg_text) ? rv.arg_text
                : default_arg_of[ rv.module_args ]
            url_entry_on  = true
            title_find_on = false
            pending_finder = active_pane
            force_update[]
            return
        hm : string band_mod_of[ ed ]
        cur : string (rv.arg_text) ? rv.arg_text
            : default_arg_of[ rv.module_args ]
        pick_default[ ed, null, hm, cur ]
        return
    focus_finder[]

# typing in the bar's title ends: its field lets the text go
func orbiter.bar_typing_end []
    bar_typing = false
    bt : element find_el[ a, 'bar_url' ]
    if [ bt ]
        bt.edit      = ''
        bt.read_only = true
        if [ bt.ux ] bt.ux.release_focus[ bt ]
    if [ ux ] ux.restyle = true

# Enter on a typed title: the running app takes it live
func orbiter.bar_title_apply []
    bar_typing_end[]
    ed : Editor pane_at[ active_pane ]
    rv : AppView pane_av[ active_pane ]
    dp : Prop (rv) ? live_arg_of[ rv ] : null
    if [ rv && dp && !rv.ended && bar_text.count > 0 ]
        rv.arg_text = bar_text
        agent_sock_send[ rv.sock_name[].chars,
                         'set {dp.ident} {rv.arg_text}\n' ]
        session_dirty = true
    if [ ux ] ux.restyle = true

# the pane's title finds in its file: the system bar's editor,
# unless the navigator was asked for
func orbiter.title_finds [] -> bool
    if [ !title_find_on || nav_req || !system_on[] ] return false
    ed : Editor pane_at[ active_pane ]
    if [ !ed || !ed.src || pane_live[ active_pane ] ] return false
    win : ux
    return win && win.focus && win.focus.id == 'title'

# the pane's title finds in its file, its focus here or in the
# replace row: its text and matches stay shown
func orbiter.title_finding [] -> bool
    if [ !title_find_on || nav_req || !system_on[] ] return false
    ed : Editor pane_at[ active_pane ]
    return ed && ed.src && !pane_live[ active_pane ]

# ctrl+f: the title starts finding in the file, or stops
func orbiter.title_find_toggle []
    te : element title_at[ active_pane ]
    if [ title_find_on ]
        title_find_end[ te ]
        return
    title_find_on = true
    nav_req       = false
    findbar_text  = ''
    ed : Editor pane_at[ active_pane ]
    find_from_line = (ed && ed.sel_line >= 0) ? ed.sel_line : 0
    find_from_col  = (ed && ed.sel_col >= 0) ? ed.sel_col : 0
    # the bar comes up for it: focused once it is there
    if [ te ]
        te.edit = ''
        te.set_focus[]
    el pending_finder = active_pane
    force_update[]

# the title stops finding: its text and focus go
func orbiter.title_find_end [ te: element ]
    title_find_on = false
    replace_on    = false
    findbar_text  = ''
    # its matches unlit
    ed : Editor pane_at[ active_pane ]
    if [ ed ]
        ed.find_query = ''
        ed.pristine   = false
    if [ te ]
        te.edit = ''
        if [ te.ux ] te.ux.release_focus[ te ]
    force_update[]

# the home's open folder, when its module has menus: their
# class, made here from its module
func orbiter.fold_now [] -> MenuSource
    # the orbiter menu: the drawer's app
    if [ orb_mode[] && cfg_ae ] return fold_of[ cfg_ae.name ]
    grid : cast AppsGrid [ find_el[ a, 'apps' ] ]
    return fold_of[ (grid && grid.open) ? grid.open : '' ]

# a module's menus class by its name
func orbiter.fold_of [ nm: string ] -> MenuSource
    if [ !nm || nm.count == 0 ] return null
    if [ fold_src && fold_name == nm ] return fold_src
    for [ ae: AppEntry ] in app_entries[]
        if [ ae.name != nm || !ae.menus || ae.menus.count == 0 ]
            continue
        module_load[ 'silver-{nm}', ae.menus ]
        t : Au_t Au.find_type[ ae.menus.chars, null ]
        if [ !t ]
            log 'orbiter: no class {ae.menus} in {nm}'
            return null
        made : Au.new_object[ t, null, null, false, __FILE__,
                              __LINE__, __SEQUENCE__ ]
        fold_src  = cast MenuSource [ made ]
        fold_name = nm
        return fold_src
    return null

# a folder's menu up: its entries read again each second, so a
# server's state follows as it starts or stops
func orbiter.fold_refresh [ w: Window ]
    if [ !drawer_open || menu_kind != 'menu' || menu_slide > 0.0 ]
        return
    now : i64 epoch_millis[]
    if [ now - fold_ms < 1000 ] return
    fold_ms = now
    fs : MenuSource [ (pane_empty[ active_pane ]) ? fold_now[]
                      : null ]
    if [ !fs ] return
    es : vec TrayEntry fold_items[ fs ]
    same : bool [ menu_items && menu_items.count == es.count ]
    if [ same ]
        for [ i: i32 0, i < es.count, i += 1 ]
            if [ es[ i ].label != menu_items[ i ].label
                 || es[ i ].check != menu_items[ i ].check ]
                same = false
    if [ same ] return
    menu_items = es
    w.restyle = true

# its entries, each action marked as the folder's own
func orbiter.fold_items [ src: MenuSource ] -> vec TrayEntry
    src.reveal = cmd_down || shift_down
    es : vec TrayEntry src.entries*[]
    for [ e: TrayEntry ] in es
        if [ e.action && e.action.count > 0 ]
            e.action = 'fold:{e.action}'
        if [ e.side_action && e.side_action.count > 0 ]
            e.side_action = 'fold:{e.side_action}'
    return es

func orbiter.sys_pick [ id: string ] -> bool
    if [ id == 'sys_power' || id == 'sys_restart' ]
        power[ id == 'sys_restart' ]
        return true
    if [ id == 'reload_ready' ]
        request_swap[]
        return true
    if [ !id.starts_with[ 'sv_' ] ] return false
    vw : id.mid[ 3, id.count - 3 ]
    sys_view = (sys_view == vw) ? '' : vw
    if [ ux ] ux.restyle = true
    return true

# a phone's system menu cells, along its foot: every view, a
# ready reload, then power, moved left by the strip's scroll
func orbiter.sys_strip_els [ shift: f32 ] -> Elements
    t : Elements []
    dw : f32 strip_cell[]
    ids : vec string sys_strip_ids[]
    net : Wifi wifi_shared[]
    cur : element find_el[ a, 'sys_power' ]
    again : bool [ cmd_down || (shift_down && cur && cur.hovered) ]
    for [ i: i32 0, i < ids.count, i += 1 ]
        ky : string ids[ i ]
        pn : string [ (ky.starts_with[ 'sv_' ])
            ? ky.mid[ 3, ky.count - 3 ] : '' ]
        ic : string [ (pn == 'scenes') ? 'saturn'
            : ((pn == 'wifi') ? net.mark[]
            : ((pn == 'bluetooth') ? bt_shared[].mark[]
            : ((pn == 'sound') ? 'volume_up'
            : ((ky == 'reload_ready') ? 'recycle'
            : ((pn.count > 0) ? pn
            : ((again) ? 'restart' : 'power')))))) ]
        cap : string pn.mid[ 0, 1 ].ucase[]
        nm : string [ (pn == 'wifi') ? 'Wi-Fi'
            : ((pn.count > 0) ? '{cap}{pn.mid[ 1, pn.count - 1 ]}'
            : ((ky == 'reload_ready') ? 'Reload'
            : ((again) ? 'Restart' : 'Power'))) ]
        id : string [ (ky == 'sys_power' && again)
            ? 'sys_restart' : ky ]
        # whole pixels: a cell's size and icon never change as it
        # slides; a desktop's go down the left, a phone's across
        x : f32 [ round[ f32[ i ] * dw - shift ] ]
        ar : string [ (use_mobile) ? 'l{x}px t0 w{dw}px b0'
            : 'l0 t{x}px r0 h{dw}px' ]
        t[ id ] = DockRow [ icon_id: ic, label: nm,
            selected: pn.count > 0 && sys_view == pn,
            second: ky == 'sys_power' && again,
            first: i == 0, last: i == ids.count - 1,
            user_events: false,
            area: Region [ ar ] ]
    return t

# the strip's cells in order, by id
func orbiter.sys_strip_ids [] -> vec string
    ids : vec string [] [ 'sv_scenes', 'sv_widgets' ]
    # Wi-Fi, Bluetooth, the mouse and power only on orbiter-os
    os : bool [ system_os || use_mobile ]
    if [ os ]
        ids.push[ 'sv_wifi' ]
        ids.push[ 'sv_bluetooth' ]
        ids.push[ 'sv_mouse' ]
    ids.push[ 'sv_keyboard' ]
    ids.push[ 'sv_display' ]
    ids.push[ 'sv_sound' ]
    if [ batt.sync[] && ux ] ux.restyle = true
    if [ batt.here[] ] ids.push[ 'sv_battery' ]
    if [ au_live_get_pending[] == 1 ] ids.push[ 'reload_ready' ]
    if [ os ] ids.push[ 'sys_power' ]
    return ids

# where the menu drawer opens: the active pane's left edge for
# its menu, the window's for a tray's
func orbiter.drawer_x [] -> f32
    if [ menu_kind == 'popup' && popup_right && ux && ux.root
         && ux.root.bounds ]
        return ux.root.bounds.w - round[ 10.91 * unit_px[] ]
    # a card's info menu: beside the dock, over the cards
    if [ menu_kind == 'appinfo' ] return dock_w[]
    # a popup over the main menu: at the menu's own left edge
    if [ menu_kind == 'popup' && popup_x >= 0.0 ] return popup_x
    if [ menu_kind == 'popup' ] return (sys_under) ? sys_x[] : 0.0
    # a path's drawer is a standard menu: the same places
    if [ menu_kind != 'menu' && menu_kind != 'crumb' ] return 0.0
    # over the main menu: in its area, from its left edge
    if [ sys_under ] return sys_x[]
    # a window's strip's: inside that window, from its left edge
    if [ win_menu[] ] return win_left[ drawer_pane ]
    return win_x[ active_pane ]

func orbiter.drawer_area [ top: f32 ] -> string
    dy : f32 drawer_y[ top ]
    # a phone's drawers are its whole width, down to the keyboard
    # while it is up (the bottom 41%), never over it
    if [ mobile_on[] ]
        # the whole width; over the main menu (the navigator in
        # it) down to that menu's own foot: its bottom row, or its
        # keyboard while words are wanted
        kb : bool [ keys_up[] || (ux && ux.words_wanted) ]
        db : string [ (kb) ? 'b41%'
            : ((sys_under) ? 'b{dock_w[]}px' : 'b0') ]
        return 'l0 t{dy}px r0 {db}'
    wm : bool win_menu[]
    pv : element (wm) ? pane_view[ drawer_pane ] : null
    if [ !wm || !pv || !pv.bounds ]
        return 'l{drawer_x[]}px t{dy}px w10.91 b0'
    ph : f32 [ max[ pv.bounds.h - (dy - win_y[ drawer_pane ]),
                    0.0 ] ]
    # no wider than the window
    rm : f32 [ pv.bounds.w ]
    dw : f32 [ max[ min[ 10.91 * unit_px[], rm ], 0.0 ] ]
    return 'l{drawer_x[]}px t{dy}px w{dw}px h{ph}px'

# a free window's menu opens under its strip, else under the bar
func orbiter.drawer_y [ top: f32 ] -> f32
    if [ !win_menu[] ] return top
    return win_y[ drawer_pane ] + round[ bar_units[] * unit_px[] ]

# a phone: the shown app whose own keyboard is up, else null
func orbiter.pad_view [] -> AppView
    if [ !use_mobile || !ux || ux.app_keys_hidden ] return null
    ed : Editor pane_at[ active_pane ]
    if [ !pane_live[ active_pane ] || !pane_av[ active_pane ] ] return null
    av : pane_av[ active_pane ]
    if [ av.ended || !av.app_keys || av.app_keys.count == 0 ]
        return null
    return av

func orbiter.toggle_listen [ src: path ]
    if [ orbit_cap_on ]
        dictation_stop[]
        orbit_cap_on   = false
        orbit_flushing = true
    el
        rc : dictation_start[]
        if [ rc == 0 ]
            orbit_cap_on = true
            listen_file  = src
    log 'orbiter: mic {orbit_cap_on} file {listen_file}'

# a file's companions sit BESIDE it, never in a subfolder: same
# folder, same stem, one of the source extensions
func orbiter.companion_exts [ p: path ] -> vec string
    if [ !p ] return vec string []
    # an address (a hosted page) has no source beside it
    s_ : string '{p}'
    if [ s_.index_of[ '://' ] >= 0 ] return vec string []
    return module_exts[ p.parent_dir[], p.stem[] ]

# the companion of p carrying this extension, or null
func orbiter.companion_path [ p: path, ex: string ] -> path
    if [ !p || !ex ] return null
    c_ : path '{p.parent_dir[]}/{p.stem[]}.{ex}'
    return (c_.exists[]) ? c_ : null

func orbiter.title_nav [ p: path, grp: vec path, has_diff: bool, win: Window,
                 dbg_locked: bool, dbg_open: bool, menu_open: bool,
                 is_resource: bool, rv: ResourceView, fb_on: bool,
                 tfoc: bool, pane_ix: i32 ] -> Elements
    hasfile  : bool [ p && p.exists[] ]
    els : Elements []
    browse_open : bool [ menu_open && nav_showing ]
    # nav_showing and pick_field are the SHELL's state, not this
    # pane's: unqualified they made every pane's title claim the
    # finder and show its close chip at once. only the pane that
    # owns the search does
    mine : bool [ search_pane[] == 'pane{pane_ix}' ]
    engaged : bool [ browse_open || fb_on || tfoc ||
                     (mine && (nav_showing || picking[])) ]
    # no close chip — Escape closes the finder
    edp : Editor pane_at[ pane_ix ]
    # the chip closes a view the user PICKED. the file's own natural
    # view (text, or a byte view for a binary format) closes to
    # nothing, and a console is not a closable state: the nav arrows
    # stay
    hx  : bool [ edp && edp.view_name && edp.view_name.count > 0
        && edp.view_name != edp.fallback_view_for[ edp.src ]
                  && !console_of[ edp.view_name ] ]
    dc  : bool [
        edp && edp.diff_commit && edp.diff_commit.count > 0 ]
    # the arrows' box: 1.8 font units square to the bar
    gw : f32 [
        1.8
        * ((win && win.vk && win.vk.font_unit > 0) ? f32[ win.vk.font_unit ] : 22.0) ]
    # a picked view is closed by its own lit button, not this
    if [ dc && !use_mobile ]
        # the dialog's own close, furthest right: the arrows keep
        # the left
        els['panel_close'] = PaneBox [
            area: Region [ 'r0+ t0 w1.66 b0' ] ]
    # a module: its run button; any other file: its type's icon
    # it stays in navigation: the app can start at any time
    mi : path module_src_of[ edp ]
    # a pane showing a program's window: its close, in the run
    # button's place (the top right is a dialog's)
    wid : u64 pane_window[ pane_ix ]
    # finding in the file (ctrl+f): a magnify where the file's
    # icon or play was
    fi_ : bool [ title_find_on && pane_ix == active_pane
        && system_on[] ]
    # the navigator (find in files): a folder, a magnify cut in it
    nv_ : bool [ engaged && system_on[] && !fi_ ]
    if [ fi_ || nv_ ]
        els['modicon'] = BarIcon [
            buttons: vec string [] [ 'find_icon' ],
            icon_ids: vec string [] [
                (nv_) ? 'find_in_files' : 'magnify' ],
            icon_scale: (nv_) ? 0.5 : 0.42,
            manual: true, seg_radius: 0.0, use_spacing: false,
            rest_fill: rgba [ '#0000' ],
            # finding in the file: the orbiter button's width
            area: Region [ (fi_)
                ? 'l-1px+ t0 w{dock_w[] + 1.0}px b0'
                : 'l-1px+ t0 w1.35 b0' ] ]
    # finding in the file: replace's switch at the right end (the
    # console toggle's size); on, its text and button beside it
    if [ fi_ ]
        els['find_replace'] = StatusTab [
            buttons: vec string [] [ 'find_replace' ],
            icon_ids: vec string [] [ 'find_replace' ],
            icon_scale: 0.6,
            manual: true, seg_radius: 0.0, use_spacing: false,
            rest_fill: rgba [ '#0000' ],
            sel_mask: (replace_on) ? 1 : 0,
            area: Region [ 'r0+ t0 w1.33 b0' ] ]
        if [ replace_on ]
            els['rep_all'] = FindSwitch [ label: 'All',
                manual_mode: true, use_spacing: false,
                area: Region [ 'r0+ t0 w3 b0' ] ]
            els['rep_one'] = FindSwitch [ label: 'Replace',
                manual_mode: true, use_spacing: false,
                area: Region [ 'r0+ t0 w4 b0' ] ]
            els['rep_text'] = RepText [ label: 'replace with',
                edit: replace_text, focusable: true,
                use_spacing: false,
                area: Region [ 'r0+ t0 w12 b0' ] ]
    el [ wid != 0 ]
        if [ !use_mobile ]
            els['win_close'] = PaneBox [
                area: Region [ 'l-1px+ t0 w1.35 b0' ] ]
    # a module's run button sits at the right, by find
    el [ !mi && edp && edp.src ]
        # a module's folder wears its module's icon
        tm_ : path '{edp.src}/{edp.src.filename[]}.ag'
        tmod : bool [ edp.src.is_dir[] && tm_.exists[] ]
        els['modicon'] = TitleIcon [ file: edp.src, module: tmod,
            plain: true, area: Region [ 'l0+ t0 w1.35 b0' ] ]
    # a folder pick (a program's, an app's setting): the folder
    # shown is the one chosen
    # it fills its slot edge to edge, as the view buttons beside it
    po_ : bool [ nv_ && pick_field == 'portal' && pick_dir ]
    if [ po_ ]
        els['portal_open'] = AltTab [
            buttons: vec string [] [ 'portal_open' ],
            icon_ids: vec string [] [ '_text' ],
            labels: vec string [] [ 'Open' ],
            label_font: 'fonts/BarlowCondensed-Regular.ttf',
            manual: true, seg_radius: 0.0, use_spacing: false,
            rest_fill: rgba [ '#0000' ],
            # a free window's round corner (its title's 8 px)
            corners: vec4f [ 0.0, 0.0,
                (pane_floats[ pane_ix ]) ? 8.0 : 0.0, 0.0 ],
            area: Region [ 'r0+ t0 w4 b0' ] ]

    # a right button: the top bar's button width (its own units),
    # plus the 1 px each overlaps its neighbour, so edges line up
    bu : f32 [ (win && win.vk && win.vk.font_unit > 0)
        ? f32[ win.vk.font_unit ] : 22.0 ]
    bwd : f32 [ 1.66 * bu + 1.0 ]
    closable : bool [
        pane_ix < editor_slots.count && hasfile && !engaged ]
    # the title's right group, the same in the editor and the
    # running app: find, play / stop, pause (while it runs), close
    # (a picked view back to its file, else the tab); built right
    # to left, each left of the last
    # with the system bar there is no close: the bar's title and
    # the navigator change what a pane holds
    sysb : bool system_on[]
    if [ !engaged && (hx || closable) && !sysb && !use_mobile ]
        els[ (hx) ? 'view_close' : 'tab_close' ] = PaneBox [
            area: Region [ 'r-1px+ t0 w{bwd}px b0' ] ]
    # pause while the app runs; stopped, its steps, one group: an
    # app run for debugging only (its launch's debug, or a
    # debugger on it)
    rvd : AppView (edp && mi) ? pane_av[ pane_ix ] : null
    dg8 : dbg (rvd) ? rvd.debugger : null
    dbo : bool [ rvd && (rvd.debug_build || (dg8 && dg8.active)) ]
    # not over the nav list, the finder or the find bar
    if [ rvd && dbo && !rvd.ended && !rvd.held && rvd.started
         && !engaged && !(mine && find_showing) ]
        stp : bool stopped_at[ rvd ]
        dbs : vec string (stp) ? vec string [] [ 'continue',
            'step_next', 'step_in', 'step_out' ]
            : vec string [] [ 'pause' ]
        els['debug'] = AltTab [ buttons: dbs, icon_ids: dbs,
            manual: true, seg_radius: 0.0, use_spacing: false,
            rest_fill: rgba [ '#0000' ], seg_reach: 0.5,
            icon_scale: 0.4125, area: Region [
                'r-1px+ t0 w{bwd * f32[ dbs.count ]}px b0' ] ]
    # a module: play; stop while it runs; shift: another
    if [ mi && wid == 0 && !engaged && !fi_ ]
        rvt : AppView pane_av[ pane_ix ]
        lvt : bool [ rvt && !rvt.ended && !rvt.held ]
        # stop is a debugging control: a plain run shows none
        if [ !lvt || dbo ]
            # with the system bar: at the left, as a file's icon
            pr_ : string [ (sysb) ? 'l-1px+ t0 w1.35 b0'
                : 'r-1px+ t0 w{bwd}px b0' ]
            els['modicon'] = alt_tab[ pane_ix, 'modicon', 'app_run',
                (lvt) ? 'stop' : 'play', 'app_run', 'add_instance',
                true, false, false, Region [ pr_ ] ]
    # find, leftmost of the group: lit while the bar is open; with
    # the system bar, find in files is the navigator's; the empty
    # pane ('Open') has nothing to find
    if [ p && (!engaged || fb_on) && !sysb ]
        els['tabnav'] = alt_tab[ pane_ix, 'tabnav', 'magnify',
            'magnify', 'magnify', 'magnify', false, false,
            fb_on, Region [ 'r-1px+ t0 w{bwd}px b0' ] ]
    # the pane's one status, left of find: its app compiling (errors
    # go here too)
    iw : string [ null ]
    rvs : AppView pane_av[ pane_ix ]
    if [ rvs && rvs.started && !rvs.ended
         && rvs.status_word[] == 'compiling' ]
        iw = 'compiling {instance_name[ rvs ]}'
    if [ iw && !engaged ]
        sww : f32 [ max[ bwd * 3.0,
            f32[ iw.count ] * 9.0 * (bu / 22.0) + bwd ] ]
        els['status'] = StatusLabel [ word: iw, info: true,
            area: Region [ 'r-1px+ t0 w{sww}px b0' ] ]
    # a silver module's companions: <name>.ag and whatever sits
    # beside it under the same name, one strip at the title's right
    # (left of find); ids cmp_<ext>, the open one lit
    # no file switch with the system bar, for now
    if [ hasfile && !engaged && !system_on[] ]
        cx_  : string p.ext[]
        cel : vec string companion_exts[ p ]
        # one format alone has nothing to switch to
        if [ cel.count > 1 ]
            fu   : f32 [
                (win && win.vk && win.vk.font_unit > 0)
                ? f32[ win.vk.font_unit ] / 22.0 : 1.0 ]
            # one round pill each, the system menu's look a little
            # smaller; laid from the right, so the last first
            for [ ci: i32 cel.count - 1, ci >= 0, ci -= 1 ]
                ex : string cel[ ci ]
                els['cmp_{ex}'] = RoundTab [
                    buttons: vec string [] [ 'cmp_{ex}' ],
                    labels: vec string [] [ ex ], icons: false,
                    manual: true, label_px: 15.0 * fu,
                    seg_radius: 999.0,
                    rest_fill: rgba [ '#ffffff10' ],
                    use_spacing: false,
                    sel_mask: (ex == cx_) ? 1 : 0,
                    area: Region { r0.15+ t0.15 w1.6 h1.0 } ]

    # the navigator's search: list or icons, at its right end
    if [ nv_ && !fb_on && !use_mobile ]
        nvb : vec string [] [ 'nav_list', 'nav_icons' ]
        els['nav_view'] = AltTab [ buttons: nvb,
            icon_ids: vec string [] [ 'view_list', 'grid_view' ],
            manual: true, seg_radius: 0.0, use_spacing: false,
            rest_fill: rgba [ '#0000' ], icon_scale: 0.45,
            sel_mask: (nav_icons) ? 2 : 1,
            # a free window's round corner (its title's 8 px), unless
            # Open holds that end
            corners: vec4f [ 0.0, 0.0,
                (pane_floats[ pane_ix ] && !po_) ? 8.0 : 0.0, 0.0 ],
            # each the console toggle's width (1.33 units)
            area: Region [ 'r0+ t0 w2.66 b0' ] ]

    if [ rv ]
        vel : Elements rv.title_elements*[]
        if [ vel ]
            for [ ve: element, vk: string ] in vel
                els[vk] = ve

    # the finder's close, furthest right (inserted first into the
    # right flow); find/replace has none: its search button toggles
    # it off
    # finding in the file: no navigator controls
    # with the system bar the navigator's foot has no close (Esc,
    # or the globe again)
    if [ engaged && !is_resource && !fb_on && !title_finds[]
         && !system_on[] ]
        els['finder_close'] = PaneBox [
            area: Region [ 'r0+ t0 w{bwd}px b0' ] ]
    if [ fb_on ]
        # right-flow: first inserted lands furthest right
        els['remotes'] = RemoteToggle [ label: 'remotes',
                                        manual_mode: true,
                                        selected: nav.search_remotes ]
        els['replace'] = ReplaceField [ label: 'replace',
                                        edit: replace_text,
                                        focusable: true ]
        els['pattern'] = PatternField [
            label: 'files (i.e *.ag)',
            edit: pattern_text,
            focusable: true ]
        els['find'] = FindField [ label: 'Find', edit: findbar_text,
                                  focusable: true ]
    el [ engaged && !is_resource && !picking[] && !title_finds[] ]
        els['remotes'] = RemoteToggle [ label: 'remotes',
                                        manual_mode: true,
                                        selected: nav.search_remotes ]
    # the coupled app, pinned left of the tabs: lit on its own
    # source
    if [ home_mod && home_mod.count > 0 && !engaged ]
        hs : path home_src[]
        on_ : bool [ p && hs && '{p}' == '{hs}' ]
        hw : f32 [ 24.0 + f32[ home_mod.count ] * 8.0 ]
        els['home_mod'] = CompanionButton [ label: home_mod,
                                            manual_mode: true,
            selected: on_,
            area: Region [ 'r0+ t0.065 w{i32[ hw ]}px h0.81' ] ]
    return els

# a title button and its second action, yellow when shown: shift
# shows it on the one under the pointer; with on_cmd, cmd shows it
# on every such button; off, it is never shown
func orbiter.alt_tab [ pane_ix: i32, key: string, id: string, icon: string,
               alt_id: string, alt_icon: string, on_cmd: bool,
               off: bool, lit: bool, area: Region ] -> AltTab
    pv : element pane_view[ pane_ix ]
    te : element (pv && pv.elements) ? pv.elements[ 'title' ] : null
    cur : element (te && te.elements) ? te.elements[ key ] : null
    hov : bool [ shift_down && !off && cur && cur.hovered ]
    cmd : bool [ on_cmd && cmd_down && !off ]
    use : bool [ hov || cmd ]
    return AltTab [ buttons: vec string [] [ (use) ? alt_id : id ],
        icon_ids: vec string [] [ (use) ? alt_icon : icon ],
        manual: true, seg_radius: 0.0, use_spacing: false,
        rest_fill: rgba [ '#0000' ], second: use, seg_reach: 0.5,
        sel_mask: (lit && !use) ? 1 : 0, area: area ]

# the pane's app without a window menu (a trinity app): one menu
# named for it, of ours; read again when the app or its view moves
func orbiter.own_menu_sync [] -> bool
    ed : Editor pane_at[ active_pane ]
    av : AppView pane_av[ active_pane ]
    pc : string [ (active_pane < pane_console.count)
                  ? pane_console[ active_pane ] : '' ]
    key : string [ (av) ? '{av.iid}:{pane_live[ active_pane ]}:{pc}'
                   : ((pc.count > 0) ? pc : '') ]
    if [ menu_win == 0 && menu_own && menu_own == key ] return false
    had : bool [ menu_items && menu_items.count > 0 ]
    menu_win = 0
    menu_own = key
    menu_top = -1
    menu_items = vec TrayEntry []
    if [ pc.starts_with[ 'home:' ] ]
        menu_items = agent_menu[ pc.mid[ 5, pc.count - 5 ] ]
    el [ av ]
        menu_items = own_menu[ av, pane_live[ active_pane ] ]
    return had || menu_items.count > 0

func orbiter.own_menu [ av: AppView, shown: bool ] -> vec TrayEntry
    m : vec TrayEntry []
    m.push[ own_entry[ app_name[ av ], '', 0 ] ]
    # an agent app: the agents view's instances, each the same
    # terminal shown here
    if [ av.agent && home_order && home_order.count > 0 ]
        ed : Editor pane_at[ active_pane ]
        pc : string [ (ed && ed.pane_index < pane_console.count)
                      ? pane_console[ ed.pane_index ] : '' ]
        for [ nm: string ] in home_order
            if [ !home_session[ nm ] ] continue
            md : string home_model_of[ nm ]
            ie : TrayEntry own_entry[
                (md.count > 0) ? '{home_title[ nm ]}  {md}'
                : home_title[ nm ],
                'orb.agent:{nm}', 1 ]
            ie.check = (pc == 'home:{nm}') ? 1 : 0
            m.push[ ie ]
        m.push[ TrayEntry [ rule: true, depth: 1, check: -1 ] ]
    # the app's properties (its own answer, else its module's
    # export): one row, its page slides over the menu
    lp : LaunchProps []
    am : string av.app_mod
    sp : string [ (av.props && av.props.count > 0) ? av.props
        : module_spec[ (am && am.count > 0) ? am : av.src.stem[] ] ]
    if [ sp && sp.count > 0 ] Au.parse_agi[ null, sp.chars, lp ]
    m.push[ TrayEntry [ rule: true, depth: 1, check: -1 ] ]
    m.push[ own_entry[ 'Properties', 'orb.props', 1 ] ]
    m.push[ TrayEntry [ rule: true, depth: 1, check: -1 ] ]
    # the app's own views (its orbiter bar's chips)
    if [ av.app_views && av.app_views.count > 0 ]
        m.push[ TrayEntry [ rule: true, depth: 1, check: -1 ] ]
        for [ vi: i32 0, vi < av.app_views.count, vi += 1 ]
            ve : TrayEntry own_entry[ menu_words[ av.app_views[ vi ] ],
                'orb.aview:{vi}', 1 ]
            ve.check = (shown && av.app_view_on == vi) ? 1 : 0
            m.push[ ve ]
    # the app's own Actions to call
    mine : vec TrayEntry []
    if [ lp.props ]
        for [ q: Prop ] in lp.props
            if [ q.type == 'func'
                 && (!q.params || q.params.count == 0) ]
                mine.push[ own_entry[ menu_words[ q.ident ],
                    'orb.call:{q.ident}', 1 ] ]
    if [ mine.count > 0 ]
        m.push[ TrayEntry [ rule: true, depth: 1, check: -1 ] ]
        for [ e: TrayEntry ] in mine
            m.push[ e ]
    # not running: it starts
    live : bool [ !av.ended && !av.held && av.slot >= 0 ]
    m.push[ TrayEntry [ rule: true, depth: 1, check: -1 ] ]
    if [ !live ] m.push[ own_entry[ 'Run', 'orb.run', 1 ] ]
    el
        # one row: Reload applies a build waiting; Auto, lit, has
        # each build applied as it lands
        re : TrayEntry own_entry[ 'Reload', 'orb.reload', 1 ]
        re.side = 'Auto'
        re.side_action = 'orb.reload_auto'
        re.side_check = !av.manual_reload
        m.push[ re ]
        m.push[ own_entry[ 'Quit', 'orb.quit', 1 ] ]
    return m

func orbiter.prop_live [ q: Prop ] -> bool
    if [ !q.meta ] return false
    for [ mm: string ] in q.meta
        if [ mm == 'Live' ] return true
    return false

# one of our own entries chosen
func orbiter.own_pick [ e: TrayEntry ]
    ed : Editor pane_at[ active_pane ]
    # its module built again (clean: from nothing), in its console
    if [ e.action == 'orb.build' || e.action == 'orb.clean' ]
        md : path app_module[]
        if [ md ]
            install_start[ AppEntry [ name: md.filename[], file: md,
                module: true ], e.action == 'orb.clean' ]
        return
    # an agents view instance: its terminal in this pane
    if [ e.action.starts_with[ 'orb.agent:' ] ]
        home_in_pane[ e.action.mid[ 10, e.action.count - 10 ],
                      active_pane ]
        return
    # a new instance of the agent, shown here
    if [ e.action.starts_with[ 'orb.agent_new:' ] ]
        nn : string home_new[ e.action.mid[ 14,
                                          e.action.count - 14 ] ]
        if [ nn.count > 0 ] home_in_pane[ nn, active_pane ]
        return
    # the window's console up or down
    if [ e.action == 'orb.con' ]
        con_flip[ active_pane ]
        if [ ux ] ux.restyle = true
        return
    if [ e.action == 'orb.git' && ed ]
        ed.git_on = !ed.git_on
        if [ ed.git_on ] set_pane_view[ ed, 'git' ]
        el [ ed.view_name == 'git' ] set_pane_view[ ed, '' ]
        ed.ghost_hunk = -1
        ed.pristine   = false
        force_update[]
        return
    # the switch: the pane's code, or one of its app's instances
    # an instance's Code: its source in the pane, the instance
    # its own (its debug session), not its window
    if [ e.action.starts_with[ 'orb.code:' ] && ed ]
        cav : AppView instance_by[ i32[ e.action.mid[ 9,
            e.action.count - 9 ] ] ]
        if [ cav ]
            show_instance[ cav.iid, active_pane ]
            # its code is the app's own module (n64.ag), never
            # the file it was opened on (a rom); else its origin
            own : path ed.module_path[ cav.app_mod ]
            if [ !own ] own = cav.origin
            if [ own && own.exists[] && (!ed.src
                 || '{ed.src.absolute[]}' != '{own.absolute[]}') ]
                open_in_pane[ own, active_pane ]
            pending_code = pending_show > 0
            # its code asked for: the app is in edit mode from now
            ed.win_code[]
            ed.pristine = false
        force_update[]
        return
    # a new instance: held, then played here as Run does; Debug,
    # the same in debug mode
    dbn : bool [ e.action == 'orb.inst_new_dbg' ]
    if [ (e.action == 'orb.inst_new' || dbn) && ed ]
        inst_debug_next = dbn
        inst_fresh = true
        ed.start_instance[ false ]
        inst_debug_next = false
        pending_run = ed.pane_index
        force_update[]
        return
    # the instance's own row: it comes into view, embedded, as a
    # task button's click brings it
    if [ e.action.starts_with[ 'orb.inst:' ] ]
        pick_instance[ i32[ e.action.mid[ 9,
            e.action.count - 9 ] ], active_pane ]
        force_update[]
        return
    if [ e.action.starts_with[ 'orb.pview:' ] && ed ]
        vn : string e.action.mid[ 10, e.action.count - 10 ]
        set_pane_view[ ed, (vn == ed.resolve_view[]) ? '' : vn ]
        force_update[]
        return
    # in the pane, as at startup: an app never run has no instance
    if [ e.action == 'orb.run' ]
        if [ ed ] pending_run = ed.pane_index
        return
    av : AppView pane_av[ active_pane ]
    if [ !av ] return
    # the app ends, as the switcher's flick ends it
    # its ready reload applied: the app's own ctrl + shift + R
    if [ e.action == 'orb.reload' ]
        if [ av && av.slot >= 0 && !av.ended ]
            host_post2[ av.slot, 1, i32[ HM.key ], 82, 1, 3 ]
            host_post2[ av.slot, 1, i32[ HM.key ], 82, 0, 3 ]
        return
    # applied as built, or held for Reload: the app's host told
    if [ e.action == 'orb.reload_auto' ]
        if [ av && av.slot >= 0 && !av.ended ]
            av.manual_reload = !av.manual_reload
            rb : local i8 [ 64 ]
            agent_sock_ask[ av.sock_name[].chars,
                (av.manual_reload) ? 'reload manual\n'
                                   : 'reload auto\n', @rb[0], 64 ]
            pane_menus = null
            menu_sync[]
        return
    if [ e.action == 'orb.quit' ]
        close_task[ av ]
        force_update[]
        return
    # one of the app's own views; the lit one again: its source
    if [ e.action.starts_with[ 'orb.aview:' ] ]
        vi : i32 [ e.action.mid[ 10, e.action.count - 10 ] ]
        lit : bool [ pane_live[ active_pane ] && av.app_view_on == vi ]
        if [ !pane_live[ active_pane ] ] embed_app[ ed, av ]
        if [ av.slot >= 0 && !av.ended ]
            host_post2[ av.slot, 1, i32[ HM.view ],
                        (lit) ? -1 : vi, 0, 0 ]
        return
    if [ e.action == 'orb.view' ]
        if [ pane_live[ active_pane ] ]
            # its code asked for: edit mode from now
            ed.win_code[]
        el embed_app[ ed, av ]
    el [ e.action == 'orb.shot' ]
        copy_shot[ av ]
    el [ e.action.starts_with[ 'orb.call:' ] ]
        nm : string e.action.mid[ 9, e.action.count - 9 ]
        agent_sock_send[ av.sock_name[].chars, 'call {nm}\n' ]

# an anonymous menu from the bar: a title, then rows; a pick
# sets the setting named, to the row's value. a row with no value
# is a group's heading: the rows after it are its group, a level
# in, as a submenu's (its own chip under its bold name)
func orbiter.popup [ title: string, setting: string, rows: vec string,
             values: vec string ]
    popup_items = vec TrayEntry []
    popup_items.push[ TrayEntry [ label: title, depth: 0,
        enabled: true, check: -1 ] ]
    grouped : bool [ false ]
    for [ i: i32 0, i < rows.count, i += 1 ]
        heading : bool [ values[ i ].count == 0 ]
        if [ heading ] grouped = true
        dp : i32 [ (grouped && !heading) ? 2 : 1 ]
        popup_items.push[ TrayEntry [ label: rows[ i ], depth: dp,
            enabled: true, check: -1, target: values[ i ] ] ]
    popup_for = setting
    popup_right = false
    popup_x = -1.0
    drawer_toggle[ 'popup', false ]

# a field's name, its value after an = left off
func orbiter.field_name [ f: string ] -> string
    eq : i32 [ i32[ f.index_of[ '=' ] ] ]
    return (eq >= 0) ? f.mid[ 0, eq ] : f

# the bar's globe: the navigator, or (up already) it closes
func orbiter.globe_press []
    bp : i32 bar_pane[]
    # a pick in a pane: the globe closes it
    if [ (nav_showing || picking[]) && bp == active_pane ]
        nav.nav_hist = null
        exit_finder[]
        exit_find_mode[]
        nav_showing  = false
        return
    nav_app_toggle[]

# the module a pane's launch page describes
func orbiter.band_mod_of [ ed: Editor ] -> string
    if [ ed.win_av[] && ed.win_av[].app_mod ]
        return ed.win_av[].app_mod
    return (ed.src) ? ed.src.stem[] : 'app'

# the fields own their text (editable layers): read it back before a
# search, or a shadow copy that drifted is what gets searched
func orbiter.findbar_sync []
    te : element title_at[ active_pane ]
    if [ !te || !te.elements ] return
    fe : element te.elements['find']
    if [ fe && fe.edit ] findbar_text = fe.edit
    pe : element te.elements['pattern']
    if [ pe ] pattern_text = (pe.edit) ? pe.edit.trim[] : ''
    re : element te.elements['replace']
    if [ re ] replace_text = (re.edit) ? re.edit : ''

func orbiter.pad[ n:i32 ] -> string
    str : local char[256]
    sprintf[str, "%04i", n]
    return str

# the selected view's history arrows, the pins under them,
# orbiter's button at the bottom
# one unit in px: the layout's own em (the default font's line)
func orbiter.unit_px [] -> f32
    return (fc > 0.0) ? fc : 22.0 * ux_unit[ ux ]

# a pane's globe: the dock's width, fixed
func orbiter.globe_w [ pi: i32 ] -> f32
    return dock_w[]

# the side panel's fold and the splitter agree: a drag past its
# floor folds it, the toggle opens it at its last width
func orbiter.side_sync []
    mn : element find_el[ a, 'main' ]
    sp : element (mn && mn.elements) ? mn.elements[ 'side' ] : null
    if [ !sp ] return
    if [ sp.extent > 0.0 ] side_saved = sp.extent
    shut : bool [ sp.extent < 0.0 ]
    if [ shut != side_closed ]
        # the drag folded it (keeping the width it began at) or
        # opened it
        if [ shut && sp.extent < -1.0 ] side_saved = -sp.extent
        side_closed = shut
        inst_hidden = shut
        session_dirty = true
    el [ inst_hidden != shut ]
        sp.extent   = (inst_hidden)
            ? -((side_saved > 0.0) ? side_saved : 1.0) : side_saved
        side_closed = inst_hidden
        session_dirty = true
        mn.pristine = false
        if [ ux ] ux.will_animate = true

# the system bar: as the OS, or asked for in a window
func orbiter.system_on [] -> bool
    if [ !system_known ]
        system_known = true
        system_os = on_the_os[]
    return system_os || force_system

# the clock in the middle; the tray at the right: the Wi-Fi
# mark, then power (restart with ctrl / cmd held, or shift
# over it)
func orbiter.system_els [] -> Elements
    t : Elements []
    # the active window's menu bar: its top menus, after it
    # after the dock by the task bar's group gap (0.24 units)
    # past the orbiter icon, which sits over the dock
    x0 : f32 [ (use_mobile) ? 0.0 : dock_w[] ]
    x : f32 [ x0 ]
    uu : f32 ux_unit[ ux ]
    # the selected window's menu alone, from the left edge of its
    # place in the split (a maximized window's, the bar's)
    pi : i32 bar_pane[]
    pv : element (pi >= 0 && !switcher) ? pane_view[ pi ] : null
    if [ pv && !pane_floats[ pi ] ]
        x0 = pane_left[ pi ]
    # over the dock, its width: orbiter's icon, the orbiter menu
    if [ !use_mobile ]
        t['bar_orbiter'] = BarHome [
            buttons: vec string [] [ 'bar_orbiter' ],
            icon_ids: vec string [] [ 'orbiter4' ], manual: true,
            sel_mask: (sys_up[]) ? 1 : 0,
            # lit: the blue of the menu's icons
            rest_fill: rgba [ '#0000' ], lit_fill: rgba [ '#2f4fd0cc' ],
            seg_radius: 0.0,
            use_spacing: false, icon_scale: 0.605,
            area: Region [ 'l0 t0 w{dock_w[]}px b0' ] ]
    x = menu_group_els[ t, x0, uu, pi, '' ]
    # the right end, short of the bar's own: the window's close
    # and its arrows, or the navigator's views
    re : f32 [ (bounds) ? bounds.w - right_w[] : 0.0 ]
    # the orbiter menu up: the bar is its, no window's part
    up : bool [ sys_up[] && !use_mobile ]
    # side by side: each other docked window's menu from its own
    # left edge; the selected one's part of the bar ends at its
    # own right edge when another follows it
    if [ pv && pv.bounds && !switcher && !pane_floats[ pi ] && !up ]
        for [ q: i32 ] in pane_order[]
            if [ q == pi || pane_floats[ q ] || pane_out[ q ]
                 || pane_below[ q ] ]
                continue
            qx : f32 pane_left[ q ]
            if [ qx > x0 ] re = min[ re, qx ]
            qe : f32 menu_group_els[ t, qx, uu, q, 'd{q}_' ]
            # the rest of its part of the bar: its title, a click
            # selects it, a drag pulls it free or splits
            qv : element pane_view[ q ]
            qr : f32 [ (qv && qv.bounds) ? qx + qv.bounds.w : qe ]
            # short of the bar's own buttons at its right end
            if [ bounds ] qr = min[ qr, bounds.w - right_w[] ]
            if [ qr > qe ]
                t['bar_grab_{q}'] = BarGrab [ pane: q,
                    area: Region [ 'l{qe}px t0 w{qr - qe}px b0' ] ]
    # the orbiter menu up: the close there is the menu's
    if [ up ]
        ub : f32 [ bar_units[] * unit_px[] ]
        t['sys_close'] = PaneBox [
            area: Region [ 'l{re - ub}px t0 w{ub}px b0' ] ]
    # the desktop: shows or hides its widgets (not while a navigator
    # holds the bar: its close sits there)
    if [ pi >= 0 && !switcher && pane_empty[ pi ] && !sys_up[]
         && !use_mobile && !(pv && pane_browsing[ pi ])
         && !nav_on_bar[ pi ] ]
        dw : f32 [ 1.33 * unit_px[] ]
        t['desk_side'] = bar_icon[ 'right_panel', 0.605, !desk_hide,
            false, re - dw, dw ]
    if [ !up && ((pv && pane_browsing[ pi ]) || nav_on_bar[ pi ]) ]
        # the navigator's own back and forward, over the folders
        # it has been in, by its close; the views left of them
        cw : f32 [ 1.33 * unit_px[] ]
        if [ !use_mobile ]
            # a square slot, as a window's close
            ch : f32 [ bar_units[] * unit_px[] ]
            if [ !up ]
                t['finder_close'] = PaneBox [
                    area: Region [ 'l{re - ch}px t0 w{ch}px b0' ] ]
            re -= cw
        # a phone shows no back / forward arrows
        aw : f32 [ (use_mobile) ? 0.0 : 2.39 * unit_px[] ]
        dm : i32 [ ((nav.nav_can[ -1 ]) ? 0 : 1)
                   | ((nav.nav_can[ 1 ]) ? 0 : 2) ]
        if [ !use_mobile ]
            t['finder_back'] = bar_icon[ 'left', 0.30, false,
                (dm & 1) != 0, re - aw, aw * 0.5 ]
            t['finder_fwd'] = bar_icon[ 'right', 0.30, false,
                (dm & 2) != 0, re - aw * 0.5, aw * 0.5 ]
        vx : f32 pane_views_el[ t, pi, re - aw ]
        ce : f32 crumbs_el[ t,
            (nav.nav_root) ? '{nav.nav_root.absolute[]}' : '', '', -1,
            false, x + 8.0 * uu, vx - 8.0 * uu, uu ]
        # past the path, the window's title still: pulled, it frees
        if [ !use_mobile && !pane_empty[ pi ] && vx > ce ]
            t['bar_grab'] = BarGrab [ pane: pi,
                area: Region [ 'l{ce}px t0 w{vx - ce}px b0' ] ]
    el [ pv && bounds && !pane_empty[ pi ] && !up ]
        # the close at the right end, the arrows left of it
        rx : f32 [ re - 1.33 * unit_px[] ]
        if [ !up ] rx = pane_close_el[ t, pi, re ]
        vx : f32 nav_arrows_el[ t, pi, rx ]
        # a URL app's address: up to the arrows; a press edits
        url : bool [ pi == active_pane && bar_url_on[] ]
        if [ url ]
            # under it, the bar's drag: its press is passed on
            if [ !bar_typing && vx > x ]
                t['bar_grab'] = BarGrab [ pane: pi, url: true,
                    area: Region [ 'l{x}px t0 w{vx - x}px b0' ] ]
            bar_title_el[ t, bar_title[], x, vx ]
        el [ pane_app_on[ pi ] ]
            x = pane_outline_el[ t, pi, x, '' ]
            bar_load_el[ t, x, vx, '', pi ]
        # a pane showing code (an app's own, a debugger's stop in
        # another file, any file): the file after the menu's name
        el [ pane_code_file[ pi ].count > 0 ]
            ed : Editor pane_at[ pi ]
            x = crumbs_el[ t, '{ed.src.absolute[]}', '', pi, true,
                           x, vx, uu ]
        # the bar is its docked window's title: pulled down, the
        # window comes free; it stops short of the load mark
        ge : f32 [ vx ]
        if [ t.contains[ 'bar_load' ] ] ge = vx - 1.33 * unit_px[]
        if [ !url && ge > x ]
            t['bar_grab'] = BarGrab [ pane: pi,
                area: Region [ 'l{x}px t0 w{ge - x}px b0' ] ]
    if [ grab_pane >= 0 && !t.contains[ 'bar_grab' ] ]
        gw : f32 [ max[ re - x, 8.0 ] ]
        t['bar_grab'] = BarGrab [ pane: grab_pane,
            area: Region [ 'l{x}px t0 w{gw}px b0' ] ]
    # the mobile network: its bars and name; a press, the phone
    sw : f32 end_w[]
    bw : f32 batt_w[]
    if [ bw > 0.0 && bounds ]
        t['bar_batt'] = BarBattery [ level: batt.level,
            power: batt.charging,
            area: Region [ 'l{bounds.w - sw - bw}px t0 w{bw}px b0' ] ]
    if [ signal_here[] && bounds ]
        mo : Modem modem_shared[]
        t['bar_signal'] = BarSignal [ bars: mo.bars[],
            label: mo.network[], off: mo.state < 8,
            area: Region [ 'l{bounds.w - sw}px t0 w{sw}px b0' ] ]
    # last: drawn over every menu on the bar
    if [ rec_iid != -2 ]
        t['rec_bar'] = RecBar [ area: Region { l0 b2px r0 b0 } ]
    return t

# the system bar's right end: nothing (the bottom bar holds them)
# the bar's right end: a phone's signal, else the date; either
# opens the main menu
func orbiter.right_w [] -> f32
    return batt_w[] + end_w[]

# the active pane's menu at x: its top menus, its title after
# the first (its app's name); the x where it ends
# a pane's menu: the selected one's as it stands, another's as
# last read (read again 2 s on)
func orbiter.menus_of [ pi: i32 ] -> vec TrayEntry
    if [ pi == active_pane ] return menu_items
    wn : u64 pane_window[ pi ]
    ed : Editor pane_at[ pi ]
    av : AppView pane_av[ pi ]
    # an agent's terminal: the agent's menu, as when selected
    pc : string [ (pi >= 0 && pi < pane_console.count)
                  ? pane_console[ pi ] : '' ]
    ag : bool pc.starts_with[ 'home:' ]
    key : string [ (wn != 0) ? 'w{wn}' : (ag) ? pc
        : ((av) ? 'a{av.iid}:{pane_live[ pi ]}' : '') ]
    if [ key.count == 0 ] return null
    if [ !pane_menus ] pane_menus = map PaneMenu [string] [ ]
    now : i64 [ epoch_millis[] ]
    pm : PaneMenu pane_menus[ key ]
    if [ pm && now - pm.ms < 2000 ] return pm.items
    items : vec TrayEntry [ (wn != 0) ? menu_read[ wn ]
        : (ag) ? agent_menu[ pc.mid[ 5, pc.count - 5 ] ]
        : own_menu[ av, pane_live[ pi ] ] ]
    pane_menus[ key ] = PaneMenu [ key: key, items: items,
                                   ms: now ]
    return items

# a pane's menus from x0, its ids led by pre ('' the bar's)
func orbiter.menu_group_els [ t: Elements, x0: f32, uu: f32, pi: i32,
                      pre: string ] -> f32
    # no orbiter button: the main menu opens from the bar's right
    # end (the clock, or a phone's signal)
    x : f32 [ x0 ]
    # the main menu up: its own menus (Agents), not the pane's
    sys : bool [ pre.count == 0 && sys_up[] ]
    mp : i32 [ (sys) ? active_pane : pi ]
    # the switcher up: no app's state, orbiter's toggle alone
    home : bool [ !sys
        && (switcher || mp < 0 || pane_empty[ mp ]) ]
    # an update coming in (within a minute of its last word)
    up : bool [ upd_frac >= 0.0
        && epoch_micros[] - upd_us < 60000000 ]
    # orbiter's menu is the icon over the dock: an update's share
    # received is a red line along its foot
    if [ pre.count == 0 && up ]
        fw : f32 [ round[ dock_w[] * upd_frac ] ]
        t['upd_bar'] = UpdBar [
            area: Region [ 'l0 b3px w{fw}px b0' ] ]
    # the desktop (the apps): a folder open with its module's
    # menus has them, else no other menu
    if [ home ]
        fs : MenuSource [ (pre.count == 0) ? fold_now[] : null ]
        if [ !fs ] return x
        if [ !(drawer_open && menu_kind == 'menu') ]
            menu_items = fold_items[ fs ]
            menu_own   = ''
        for [ i: i32 0, i < menu_items.count, i += 1 ]
            e : TrayEntry menu_items[ i ]
            if [ e.depth != 0 || e.rule || e.label.count == 0 ]
                continue
            mw : f32 [ min[ (f32[ e.label.count ] * 9.5 + 22.0)
                            * uu, 360.0 * uu ] ]
            lit : bool [ drawer_open && menu_kind == 'menu'
                         && menu_top == i ]
            t['{pre}menu_{i}'] = MenuTop [ label: e.label, at: i,
                pane: mp, selected: lit,
                area: Region [ 'l{x}px t0 w{mw}px b0' ] ]
            x += mw
        return x
    # the orbiter menu up: a layer over the pane, nothing of the
    # pane under it on the bar (its menus, its name); its devices,
    # the screen's (this machine, or the one picked)
    if [ sys ]
        lb : string [ (device_on && device_on.count > 0)
            ? device_on : 'Local' ]
        dw : f32 [ (f32[ lb.count ] * 9.5 + 22.0) * uu ]
        lit : bool [ drawer_open && menu_kind == 'popup'
                     && popup_for == 'device' ]
        t['devices_top'] = MenuTop [ label: lb, at: -3, pane: -1,
            selected: lit, area: Region [ 'l{x}px t0 w{dw}px b0' ] ]
        return x + dw
    if [ mp == active_pane && !sys ] pane_menu[]
    items : vec TrayEntry menus_of[ mp ]
    # a window's own menus (File ...) are all plain
    lead : bool [ !sys && pane_window[ mp ] == 0 ]
    # the first menu reads as its title: the window's or the
    # app's own (a site's name), not File
    named : string [ (sys) ? '' : tab_title[ mp ] ]
    if [ items ]
        for [ i: i32 0, i < items.count, i += 1 ]
            e : TrayEntry items[ i ]
            if [ e.depth != 0 || e.rule || e.label.count == 0 ]
                continue
            label : string [ (named.count > 0) ? named : e.label ]
            # the program's name takes the app tab's look, bold
            if [ named.count > 0 ] lead = true
            named = ''
            mw : f32 [ min[ (f32[ label.count ] * 9.5 + 22.0) * uu,
                            360.0 * uu ] ]
            lit : bool [ (drawer_open && menu_kind == 'menu'
                         && menu_top == i && mp == active_pane)
                         || bar_hl == '{pre}menu_{i}' ]
            # its group's members before it, in their own order
            if [ lead ] x = group_tabs[ t, pre, mp, x, uu, true ]
            # the app's name is the pane's tab, lit yellow: one
            # button (its code and instances are in its menu)
            t['{pre}menu_{i}'] = MenuTop [ label: label, at: i,
                pane: mp, selected: lit, tab_on: lead,
                progress: (lead) ? pane_build[ mp ] : -2.0,
                area: Region [ 'l{x}px t0 w{mw}px b0' ] ]
            x += mw
            if [ lead ] x = group_tabs[ t, pre, mp, x, uu, false ]
            lead = false
    # no menu read for it (a window not selected, nothing running):
    # its name, always
    if [ (!items || items.count == 0) && !sys ]
        pv : element pane_view[ mp ]
        nm : string [ (named.count > 0) ? named
            : ((pv && pv inherits EditorView)
               ? (cast EditorView [ pv ]).title_text[] : '') ]
        if [ nm.count > 0 ]
            nw : f32 [ min[ (f32[ nm.count ] * 9.5 + 22.0) * uu,
                            360.0 * uu ] ]
            x = group_tabs[ t, pre, mp, x, uu, true ]
            t['{pre}menu_0'] = MenuTop [ label: nm, at: 0,
                pane: mp, selected: false, tab_on: true,
                progress: pane_build[ mp ],
                area: Region [ 'l{x}px t0 w{nw}px b0' ] ]
            x += nw
            x = group_tabs[ t, pre, mp, x, uu, false ]
    return x

# the load mark at the right: browse for what the app loads, for
# one whose argument is a resource it takes live
func orbiter.bar_load_el [ t: Elements, x: f32, xr: f32, key: string,
                   pi: i32 ]
    lw : f32 [ 1.33 * unit_px[] ]
    if [ xr - lw > x && pane_loads[ pi ] ]
        t['bar_load{key}'] = bar_icon[ 'eject', 0.5, false, false,
            xr - lw, lw ]

# a bar button with an icon in place of a name
func orbiter.bar_icon [ icon: string, fit: f32, lit: bool, off: bool,
                x: f32, w: f32 ] -> BarButton
    return BarButton [ icon: icon, icon_fit: fit, selected: lit,
        disable: off, use_spacing: false,
        area: Region [ 'l{x}px t0 w{w}px b0' ] ]

# a system menu panel's settings, as chips
func orbiter.panel_settings [ tab: string ] -> vec Prop
    ps : vec Prop []
    if [ tab == 'mouse' ]
        ps.push[ setting[ 'scroll', '{num_text[ set_scroll ]}x',
            vec string [] [ '0.5x', '1x', '1.5x', '2x', '3x' ] ] ]
        ps.push[ setting[ 'easing', set_easing,
            vec string [] [ 'off', 'light', 'medium', 'heavy' ] ] ]
    el [ tab == 'keyboard' ]
        ps.push[ setting[ 'delay', '{set_delay} ms',
            vec string [] [ '200 ms', '300 ms', '400 ms', '600 ms',
                            '800 ms' ] ] ]
        ps.push[ setting[ 'rate', '{set_rate}/s',
            vec string [] [ '15/s', '25/s', '35/s', '50/s' ] ] ]
        ps.push[ setting[ 'on-screen', set_keys,
            vec string [] [ 'auto', 'on', 'off' ] ] ]
        if [ use_mobile ]
            ps.push[ setting[ 'haptics', set_haptic,
                vec string [] [ 'off', 'light', 'medium', 'strong' ] ] ]
        ps.push[ setting[ 'layout', set_layout,
            vec string [] [ 'us', 'gb', 'de', 'fr', 'es', 'it',
                            'se', 'us dvorak' ] ] ]
    el [ tab == 'display' ]
        ps.push[ setting[ 'time zone', zone_label[ zone_now[] ],
            vec string [] ] ]
        ps.push[ setting[ 'agent mirrors', set_mirrors,
            vec string [] [ 'off', 'on' ] ] ]
        ps.push[ setting[ 'dock names', set_dock_names,
            vec string [] [ 'off', 'on' ] ] ]
        # the phone's power: dark when untouched, then asleep
        if [ phone_here[] ]
            ps.push[ setting[ 'screen off', set_screen_off,
                vec string [] [ '30 s', '1 min', '2 min', '5 min',
                                '10 min', 'never' ] ] ]
            ps.push[ setting[ 'sleep', set_sleep,
                vec string [] [ 'at once', 'after 15 s',
                    'after 1 min', 'after 5 min', 'never' ] ] ]
        # the screen's mode: only where the screen is ours
        if [ screen_owned[] ]
            ms : vec string screen_modes[]
            cm : i32 screen_mode[]
            ps.push[ setting[ 'resolution',
                (cm >= 0 && cm < ms.count) ? ms[ cm ] : '', ms ] ]
        # a new mode waits on keep; untouched, it goes back
        if [ mode_until > 0 ]
            left : i64 [ (mode_until - epoch_millis[] + 999) / 1000 ]
            ps.push[ setting[ 'keep it', 'back in {left} s',
                vec string [] [ 'keep', 'go back' ] ] ]
    el [ tab == 'battery' ]
        lv : f32 [ 0.0 ]
        ci : i32 [ 0 ]
        host_battery_get[ @lv, @ci ]
        amps : f32 [ 0.0 ]
        volts : f32 [ 0.0 ]
        drawn : bool [ platform_battery_draw[ @amps, @volts ] != 0 ]
        ps.push[ setting[ 'charge',
            '{i32[ round[ lv * 100.0 ] ]}%', vec string [] ] ]
        # below 0 the battery gives; a cable plugged in is not
        # power enough by itself
        way : string [ (!drawn)
            ? ((ci != 0) ? 'charging' : 'on battery')
            : ((amps > 0.02) ? 'charging'
            : ((amps < -0.02) ? 'draining' : 'holding')) ]
        ps.push[ setting[ 'now', way, vec string [] ] ]
        if [ drawn ]
            wt : f32 [ abs[ amps * volts ] ]
            ps.push[ setting[ 'power', '{num_fixed[ wt ]} W',
                vec string [] ] ]
            ps.push[ setting[ 'voltage', '{num_fixed[ volts ]} V',
                vec string [] ] ]
        ps.push[ setting[ 'slept', '{slept_n} times', vec string [] ] ]
    el [ tab == 'sound' ]
        mv : f32 [ 0.0 ]
        mm : i32 [ 0 ]
        host_capture_get[ @mv, @mm ]
        ps.push[ setting[ 'mic', (mm != 0) ? 'muted' : 'on',
            vec string [] [ 'on', 'muted' ] ] ]
        # the devices: each by its description
        for [ inp: bool ] in vec bool [] [ false, true ]
            devs : vec string sound_devices[ inp ]
            labels : vec string []
            for [ d: string ] in devs
                labels.push[ d.mid[ d.index_of[ '|' ] + 1,
                    d.count - d.index_of[ '|' ] - 1 ] ]
            ps.push[ setting[ (inp) ? 'input' : 'speakers',
                sound_label[ devs, sound_default[ inp ] ], labels ] ]
    return ps

# a chip whose value or choices run long: a row of its own
func orbiter.chip_wide [ p: Prop ] -> bool
    if [ p.value && p.value.count > 16 ] return true
    if [ p.stops ]
        for [ sv: string ] in p.stops
            if [ sv.count > 16 ] return true
    return false

# a side view's elements, in the side panel or the system menu:
# the scene cards and props, the Wi-Fi list, the instance panel
func orbiter.side_view [ tab: string, body: string ] -> Elements
    t : Elements []
    if [ tab == 'scenes' ]
        # the cards, and under them the scene's settings as chips,
        # two a row; an open one's choices in a row under it
        sp : string scene_spec[]
        ps : LaunchProps []
        if [ sp.count > 0 ] Au.parse_agi[ null, sp.chars, ps ]
        chips : Elements chip_grid[ ps.props, scene_open, 's' ]
        ph : f32 [ chips_h ]
        grid : Elements []
        grid['scene_grid'] = SceneGrid [ scroll_fade: 24.0,
            area: Region [ 'l0 t0 r0 b{ph}px' ] ]
        grid['scene_props'] = element [ elements: chips,
            area: Region [ 'l0 b{ph}px r0 h{ph}px' ] ]
        t['scene_body'] = element [
            area: Region [ body ], elements: grid ]
    el [ tab == 'widgets' ]
        t['set_body'] = element [ area: Region [ body ],
            elements: widgets_body[] ]
    el [ tab == 'wifi' ]
        t['wifi_panel'] = WifiPanel [ area: Region [ body ] ]
    el [ tab == 'bluetooth' ]
        t['bt_panel'] = BluetoothPanel [ area: Region [ body ] ]
    el [ tab == 'display' ]
        t['set_body'] = element [ area: Region [ body ],
            elements: display_body[] ]
    el [ tab == 'sound' ]
        t['set_body'] = element [ area: Region [ body ],
            elements: sound_body[] ]
    el [ tab == 'keyboard' ]
        t['set_body'] = element [ area: Region [ body ],
            elements: keyboard_body[] ]
    el
        # any other panel with settings: its chips
        ps : vec Prop panel_settings[ tab ]
        if [ ps.count > 0 ]
            t['set_body'] = element [ area: Region [ body ],
                elements: chip_grid[ ps, set_open, 'x' ] ]
            return t
        t['instance_panel'] = InstancePanel [
            area: Region [ body ] ]
    return t

# the system menu: a row of round buttons (the side panel's views,
# reload when ready; power at the right), the sound, a Wi-Fi tile,
# a tile per tray app
func orbiter.system_menu_els [] -> Elements
    t : Elements []
    un : f32 unit_px[]
    rd : f32 [ 0.75 * un ]
    ready : bool [ au_live_get_pending[] == 1 ]
    dw : f32 dock_w[]
    # one strip along the foot, scrolled sideways, the view above
    # it; a phone's keyboard takes the foot while words are wanted
    kb : bool [ use_mobile && ux && ux.words_wanted ]
    foot : string [ (kb) ? '41%' : '{dw}px' ]
    # a desktop's toolbar is the left column (the dock's place), a
    # phone's the foot
    cl : f32 [ (use_mobile) ? 0.0 : dw ]
    cb : f32 [ (use_mobile) ? dw : 0.0 ]
    lt : f32 light_row[ t, '{cl / un + 0.6}' ]
    if [ sys_view.count > 0 ]
        # a desktop's view at most 19.2 units wide, centred
        room : f32 [ (sys_room[] - cl) / un ]
        side : f32 [ (use_mobile) ? 0.3
            : max[ 0.3, (room - 19.2) / 2.0 ] ]
        panel_w = (room - 2.0 * side) * un
        sv : Elements side_view[ sys_view,
            'l{cl / un + side} t{lt + 0.7} r{side} b{cb / un + 0.3}' ]
        for [ ve: element, vk: string ] in sv
            t[ vk ] = ve
    # no view chosen: the desktop's cards, arranged, their drawers
    # the apps' settings
    el [ !use_mobile ]
        t['sys_apps'] = AppsGrid [ pane: active_pane, menu: true,
            area: Region [ 'l{cl}px t{lt} r0 b0' ] ]
    # last: over the avatar where it reaches past its box
    if [ kb ]
        t['sys_keys'] = FlickKeys [
            area: Region { l0 b41% r0 b0 } ]
    el
        t['sys_strip'] = SysStrip [ area: Region [ (use_mobile)
            ? 'l0 b{dw}px r0 h{dw}px' : 'l0 t0 w{dw}px b0' ] ]
    return t

func orbiter.bytes_text [ n: i64 ] -> string
    if [ n >= 1073741824 ]
        return '{f32[ n ] / 1073741824.0} GB'
    if [ n >= 1048576 ] return '{i32[ n / 1048576 ]} MB'
    if [ n >= 1024 ] return '{i32[ n / 1024 ]} KB'
    return '{n} bytes'

func orbiter.str_replace_all [ s: string, find: string,
                       rep: string ] -> string                                     
    fn : i32 [
        find->count ]                                                                                
    if [ fn == 0 ]
        return s
    out : string [
        '' ]                                                                                     
    i   : i32 [
        0 ]                                                                                         
    n   : i32 [
        s->count ]                                                                                  
    while [
        i < n ]                                                                                         
        rem : string s.mid[ i, n - i ]                                                                      
        rel : i32 [
            rem.index_of[
                find ] ]                                                                  
        if [
            rel < 0 ]                                                                                      
            out = out + rem                                                                                 
            break                                                                                           
        out = out + rem.mid[ 0,
                             rel ] + rep                                                                 
        i   = i + rel + fn                                                                                  
    return out                                                                                              
                                                                                                            #

func orbiter.vec_has [ v: vec string, x: string ] -> bool
    for [ e: string ] in v
        if [ e.compare[ x ] == 0 ] return true
    return false

# a number as a choice reads
func orbiter.num_text [ v: f32 ] -> string
    if [ v == f32[ i32[ v ] ] ] return '{i32[ v ]}'
    return '{v}'
