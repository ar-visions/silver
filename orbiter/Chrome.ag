# the [x] on an instance chip: a little in from the right edge
LButton InstClose
    area : Region { r4px t0.15 w0.6 h0.6 }

RunButton SoundButton
    style : CSS {
        area: r0+ t0.15 w1.4 h0.6
        layers.body:
			image_scale: 1.2
    }

element PatternField
    selected : bool
    # the field edits, then orbiter reads its text (Enter searches)
    func on_key [ ev: Event ]
        field_key[ a, ev ]
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ orb ] orb.on_key[ ev ]
        ev.no_default = true
    style : CSS {
        area: r0+ t0 w7 h0.9
        layers.body:
            fill_color: #0000
            radius: 8
            stroke_width: 1
            stroke_color: #fff1
        layers.face:
            label_color: #fff6
            label_size: 16
            editable: true
            label_align: 0.0 0.5
            label_offset: 12.0 0.0
        :focused
            layers.body:
                fill_color: #2f6b4a40
                stroke_color: #fff2
            layers.face:
                label_color: #ffff
        :has_value
            layers.body:
                fill_color: #2f6b4a40
                stroke_color: #fff2
            layers.face:
                label_color: #ffff
        :selected
            layers.body:
                fill_color: #216
    }

# jump the pane back to the source of the app being debugged. lives on
# the title, inserted last so right-flow lands it left of the title's
# controls
LabelButton BandSource
    area : Region { r0+ t0 w2.5 h0.9 }

# step over / into / out, left-flow after the stop button.
# rest glow matches RunButton so the strip reads with play/stop
TButtons StepButtons
    rest_glow : rgba [ '#ccf2' ]
    rest_px   : f32  [ 16.0 ]
    style : CSS {
        area: l0+ t0 w5.76 h0.9
    }


# the title's task chips, between the module name and the right
# hand buttons; the wheel scrolls them sideways, no bar
element TaskStrip
    # the chips' whole width, and how far into it the strip shows
    public span  : f32
    public shift : f32
    # the shown instance the strip last scrolled to
    public shown : i32
    # the width the title last gave it
    public room  : f32
    # room round the chips: the clip keeps their borders whole
    public pad   : f32
    style : CSS {
        layers.body:
            overflow: clip
    }

    func on_wheel [ ev: Event ]
        mx : f32 [ max[ span - bounds.w + pad * 2.0, 0.0 ] ]
        d  : f32 [ f32[ ev.mouse.wheel_delta.y
            + ev.mouse.wheel_delta.x ] * 26.0 ]
        shift = clamp[ shift - d, 0.0, mx ]
        ev.no_propagation = true
        if [ ux ] ux.restyle = true

# a running app's live argument in the title: press to edit
element ArgButton
    # a file: the nav list picks it; else the text is typed
    public resource : bool
    value    : string
    # shift over it: a press picks its file anew; cmd: another
    public second   : bool
    # the instance this chip stands for
    public inst     : AppView
    style : CSS {
        # a faint border always; no fill until selected (the pane shows
        # the app)
        layers.body:
            fill_color: #0000
            radius: 10
            # a faint inner shadow: the near light brightens it
            box_shadow: inset 0 0 8px #c890ff04
            stroke_width: 1
            stroke_color: #fff1
            near_border: true
            near_inset: 2.0
            near_inset_color: #c890ffaa
        layers.face:
            label_color: #fffa
            label_size: 15
            editable: true
            label_align: 0.5 0.5
            label_offset: 0.0 0.0
        :focused
            layers.body:
                fill_color: #2f6b4a40
            layers.face:
                label_color: #ffff
        :resource
            layers.face:
                editable: false
        :selected
            layers.body:
                fill_color: #c890ff2e
                stroke_color: #c890ff55
        :second
            layers.body:
                box_shadow: inset 0 0 8px #ffd84a66
                near_inset_color: #ffd84aff
    }

    # a cmd press is the new instance, not the inspector's
    func on_press [ ev: Event ]
        if [ ev.key.meta || ev.key.ctrl ] ev.no_default = true

element FindField
    # the field edits, then orbiter reads its text (Enter searches)
    func on_key [ ev: Event ]
        field_key[ a, ev ]
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ orb ] orb.on_key[ ev ]
        ev.no_default = true
    style : CSS {
        area: l1.37 t0 r20 b0
        layers.face:
            label_color: #fff6
            label_size: 19
            editable: true
            label_align: 0.0 0.5
            label_offset: 20.0 0.0
        :focused
            layers.face:
                label_color: #ffff
    }

# findbar replace input: right-flow slot left of 'files'
element ReplaceField
