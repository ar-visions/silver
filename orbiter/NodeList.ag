extend orbiter

Option NodeList
    # a scrolling container owns its canvas (Button, its base, is uncached):
    # its rows clip at its bounds and repaint only when it changes
    no_cache : false
    
    mutable sel        : i32 [ -1 ]
    mutable row_height : f32 [ 20.0 ]
    mutable content_y  : f32 [ 0.0 ]
    mutable view_h     : f32 [ 0.0 ]

    # ---- subclass hooks (overridden) ----
    func row_count [] -> i32
        return 0
    func row_label [ i: i32 ] -> string
        return ''
    # two-column rows: left/right cells drawn at a fixed gutter so they
    # align down the list (empty left = single-label row_label mode)
    func row_col0 [ i: i32 ] -> string
        return ''
    func row_col1 [ i: i32 ] -> string
        return ''
    func activate [ idx: i32 ]
        return
    # a row that cannot be picked: drawn faint, never selected
    func row_enabled [ i: i32 ] -> bool
        return true

    func flt [] -> string
        if [ !elements ] return null
        t : element elements[ 'list_filter' ]
        if [ !t ] return null
        return t.edit

    func row_match [ i: i32, f: string ] -> bool
        if [ !f || f.count == 0 ] return true
        return row_label*[ i ].index_of[ f ] >= 0

    func visible_index [ vrow: i32, f: string ] -> i32
        seen : i32 [ 0 ]
        for [ i: i32 0, i < row_count*[], i += 1 ]
            if [ row_match[ i, f ] ]
                if [ seen == vrow ] return i
                seen += 1
        return -1

    # ---- shared behavior ----
    func scroll_to_sel []
        if [ sel < 0 || row_count*[] == 0 ] return
        item_y : f32 [ f32[sel] * row_height ]
        vh     : f32 [ (view_h > 0.0) ? view_h : content_h ]
        if [ item_y < scroll.y ]
            scroll.y = item_y
        el [ item_y + row_height > scroll.y + vh ]
            scroll.y = item_y + row_height - vh

    func select [ idx: i32 ]
        sel = idx
        if [ idx < 0 || idx >= row_count*[] ] return
        scroll_to_sel[]
        activate*[ idx ]
        pristine = false

    func on_press [ ev: Event ]
        # a modifier click belongs to the inspector, not the row
        if [ ev.key.meta || ev.key.ctrl ] return
        ev.stop[]
        rel_y : f32 [ ev.mouse.pos.y - content_y ]
        # only the rows' own area: a press below it is no row's
        if [ rel_y < 0.0 || (view_h > 0.0 && rel_y >= view_h) ] return
        idx   : i32 [ visible_index[ i32[ (rel_y + scroll.y) / row_height ], flt[] ] ]
        if [ idx < 0 || !row_enabled*[ idx ] ] return
        select[ idx ]

    func on_key [ ev: Event ]
        if [ !ev.key.state || row_count*[] == 0 ] return
        key : i32 [ ev.key.unicode ]
        if [ key == 265 ]    # Key.Up: the nearest pickable row above
            for [ j: i32 sel - 1, j >= 0, j -= 1 ]
                if [ row_enabled*[ j ] ]
                    sel = j
                    scroll_to_sel[]
                    pristine = false
                    break
        el [ key == 264 ]    # Key.Down: the nearest pickable row below
            for [ j: i32 sel + 1, j < row_count*[], j += 1 ]
                if [ row_enabled*[ j ] ]
                    sel = j
                    scroll_to_sel[]
                    pristine = false
                    break
        el [ key == 257 || key == 32 ]    # Key.Enter / Key.Space
            if [ sel >= 0 && row_enabled*[ sel ] ]
                select[ sel ]

    func render [] -> Elements
        return null

Layer NodeLayer
    public label_size  : f32
    public row_spacing : f32
    public sel_color   : string
    public sel_radius  : f32
    public text_color  : string
    # left-column width in px; >0 switches rows to two aligned columns
    public col_w       : f32

    func draw [ cv: Canvas ]
        nl : NodeList[ parent ]
        if [ !nl ] return
        cv.font_size[ i32[label_size] ]
        lh : f32 [ cv.get_line_height[] * ((row_spacing > 0.0) ? row_spacing : 1.0) ]
        n  : i32 [ nl.row_count*[] ]
        f  : string nl.flt[]
        mc : i32 [ 0 ]
        for [ i: i32 0, i < n, i += 1 ]
            if [ nl.row_match[ i, f ] ] mc += 1
        nl.row_height   = lh
        nl.content_y    = bounds.y
        nl.content_h    = f32[mc] * lh
        nl.view_h       = bounds.h
        nl.scroll_speed = lh
        x0 : f32 [ bounds.x ]
        y0 : f32 [ bounds.y ]
        wtx : f32 [ cv.transform_tx[] ]
        wty : f32 [ cv.transform_ty[] ]
        cv.set_crop[ wtx + bounds.x, wty + bounds.y, wtx + bounds.x + bounds.w, wty + bounds.y + bounds.h ]
        dr : i32 [ 0 ]
        for [ i: i32 0, i < n, i += 1 ]
            if [ !nl.row_match[ i, f ] ] continue
            y : f32 [ y0 + f32[dr] * lh - nl.scroll.y ]
            dr += 1
            if [ y + lh < bounds.y ] continue
            if [ y > bounds.y + bounds.h ] break
            # a row that cannot be picked is faint and never highlighted
            en : bool [ nl.row_enabled*[ i ] ]
            tc : string [ (en) ? ((text_color) ? text_color : '#d4d4d4') : '#ffffff40' ]
            if [ en && i == nl.sel ]
                r : f32 [ (sel_radius > 0.0) ? sel_radius : 0.0 ]
                cv.save[]
                cv.rounded[ r, r, r, r ]
                cv.fill_color[ (sel_color) ? sel_color : '#fff1' ]
                cv.stroke_width[ 0.0 ]
                cv.rect_to[ x0 + 1.5, y + 0.5, bounds.w - 4.0, lh - 1.0 ]
                cv.paint[]
                cv.restore[]
            cv.fill_color[ tc ]
            if [ col_w > 0.0 ]
                # left column, a thin divider, then the right column — the
                # gutter is fixed so every row lines up
                cv.draw_text[ nl.row_col0*[ i ],
                    rect [ x: x0 + 8.0, y: y, w: col_w - 6.0, h: lh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.ellipsis, null ]
                dx : f32 [ x0 + 8.0 + col_w ]
                cv.fill_color[ tc ]
                cv.draw_text[ nl.row_col1*[ i ],
                    rect [ x: dx + 10.0, y: y, w: bounds.w - (col_w + 26.0), h: lh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.ellipsis, null ]
            el
                cv.draw_text[ nl.row_label*[ i ],
                    rect [ x: x0 + 8.0, y: y, w: bounds.w - 16.0, h: lh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
        # one solid divider down the whole column, not a dash per row
        if [ col_w > 0.0 ]
            cv.fill_color[ '#ffffff26' ]
            cv.stroke_width[ 0.0 ]
            cv.rect_to[ x0 + 8.0 + col_w, bounds.y, 1.0, bounds.h ]
            cv.paint[]
        cv.clear_crop[]

class Frame
    public func_name : string
    public file      : path
    public line      : i32

NodeList Callstack
    style : CSS {
        area: l0 t0 r0 b0
        layers.cbase:
            fill_color: #202
            area: l0 t0 r0 b0
        layers.content: NodeLayer
            area: l4px t2px r4px b2px
            label_size: 15
            row_spacing: 1.2
            text_color: #cfe
            col_w: 100
    }
    public frames : vec Au

    func row_count [] -> i32
        if [ !frames ] return 0
        return frames.count

    func fr [ i: i32 ] -> Frame
        if [ !frames || i < 0 || i >= frames.count ] return null
        return Frame frames[i]

    # left column: filename:line. right column: function name (reversed
    # from the usual, per the design)
    func row_col0 [ i: i32 ] -> string
        f : Frame fr[ i ]
        if [ !f ] return ''
        # no line info (a release build, or system code): say so, not -1
        if [ f.line <= 0 || !f.file ] return '??'
        fn : f.file.filename[]
        return '{fn}:{f.line}'

    func row_col1 [ i: i32 ] -> string
        f : Frame fr[ i ]
        return (f) ? f.func_name : ''

    # a frame with no known location (??) has nowhere to go
    func row_enabled [ i: i32 ] -> bool
        f : Frame fr[ i ]
        return (f && f.file && f.line > 0) ? true : false

    # kept for the filter (row_match searches this)
    func row_label [ i: i32 ] -> string
        f : Frame fr[ i ]
        if [ !f ] return ''
        fn : string [ (f.file) ? f.file.filename[] : '' ]
        return '{fn}:{f.line} {f.func_name}'

    # a frame names a place in the source: go there. frames with no line
    # info (system code, a release build) have nowhere to go
    func activate [ idx: i32 ]
        f : Frame fr[ idx ]
        log 'STACKGO idx={idx} frame={(f) ? 1 : 0} file={(f && f.file) ? "{f.file}" : "-"} line={(f) ? f.line : -1}'
        if [ !f || !f.file || f.line <= 0 ] return
        if [ !f.file.exists[] ]
            log 'STACKGO no such file {f.file}'
            return
        orb : cast orbiter [ ux.app_object ]
        if [ !orb ]
            log 'STACKGO no orbiter'
            return
        # the pane this panel rides in, or the active one if it rides none
        pi : i32 [ orb.active_pane ]
        for [ e: element* a, e, e = e.parent ]
            if [ e inherits EditorView ]
                ev9 : EditorView e
                pi = ev9.pane_index
                break
        orb.open_at_line[ f.file, pi, f.line ]
        ed9 : Editor orb.pane_at[ pi ]
        log 'STACKGO opened pane={pi} src={(ed9 && ed9.src) ? "{ed9.src}" : "-"} sel={(ed9) ? ed9.sel_line : -1} rv={(ed9 && ed9.run_view) ? 1 : 0} av={(ed9 && ed9.app_view) ? 1 : 0}'

    func render [] -> Elements
        return null

# the members list's header: the type's name and where it lives
element TypeHead
    style : CSS {
        layers.hbar:
            fill_color: #ffffff0a
        layers.hdiv:
            fill_color: #fff2
            area: l0 b0 r0 h1px
        layers.face:
            label_color: #fff
            label_size: 15
            label_align: 0.0 0.5
            label_offset: 8.0 0.0
    }

# the members list's filter, in a bar the status bar's height
element FilterField
    style : CSS {
        layers.body:
            fill_color: #0006
            radius: 6
            stroke_width: 1
            stroke_color: #fff1
        layers.face:
            label_color: #fff6
            label_size: 14
            editable: true
            label_align: 0.0 0.5
            label_offset: 8.0 0.0
        :focused
            layers.body:
                stroke_color: #fff3
            layers.face:
                label_color: #ffff
    }

# the clicked name's type: a header, its rows, and a footer with
# the filter; only the rows scroll
element TypeMembers
    style : CSS {
        area: l0 t0 r0 b0
        layers.cbase:
            fill_color: #202
            area: l0 t0 r0 b0
        layers.tdiv:
            fill_color: #fff2
            area: l0 t0 r0 h1px
    }
    public file  : path
    # the type's name and its file:line, for the header
    public title : string
    public names : vec string
    public types : vec string
    public lines : vec i32
    # the filter's text as last typed: a remount keeps it
    mutable filter_text : string

    func filter_field [] -> element
        ft9 : element (elements) ? elements[ 'footer' ] : null
        return (ft9 && ft9.elements) ? ft9.elements[ 'list_filter' ] : null

    # a new filter: the rows narrow from the top
    public func tick [ w: Window ]
        fe9 : element filter_field[]
        f9 : string (fe9 && fe9.edit) ? fe9.edit : ''
        if [ !filter_text || filter_text != f9 ]
            filter_text = f9
            rw9 : element (elements) ? elements[ 'rows' ] : null
            if [ rw9 ]
                rw9.scroll.y = 0.0
                rw9.pristine = false

    func render [] -> Elements
        t : Elements []
        t['type_head'] = TypeHead [ label: title, area: Region { l0 t0 r0 h30px } ]
        t['rows'] = TypeRows [ file: file, names: names, types: types,
            lines: lines, area: Region { l0 t30px r0 b35px } ]
        # focused, the field holds its own text: no edit overwrites it
        fe9 : element filter_field[]
        ff9 : FilterField [ label: 'filter', focusable: true,
            area: Region { l4px t4px r4px b4px } ]
        if [ !(fe9 && ux && ux.focus == fe9) ]
            ff9.edit = (filter_text) ? filter_text : ''
        t['footer'] = element [ area: Region { l0 b35px r0 h35px },
            elements: Elements [ 'list_filter': ff9 ] ]
        return t

# the member rows; a row goes to its line
NodeList TypeRows
    style : CSS {
        area: l0 t0 r0 b0
        layers.content: NodeLayer
            area: l4px t2px r4px b2px
            label_size: 15
            row_spacing: 1.2
            text_color: #cfe
            col_w: 120
    }
    public file  : path
    public names : vec string
    public types : vec string
    public lines : vec i32

    # the filter is the footer's, beside the rows
    func flt [] -> string
        tm9 : TypeMembers (parent && parent inherits TypeMembers) ? TypeMembers[ parent ] : null
        return (tm9) ? tm9.filter_text : null

    func row_count [] -> i32
        return (names) ? names.count : 0

    func row_col0 [ i: i32 ] -> string
        return (names && i < names.count) ? names[ i ] : ''

    func row_col1 [ i: i32 ] -> string
        return (types && i < types.count) ? types[ i ] : ''

    func row_label [ i: i32 ] -> string
        return '{row_col0[ i ]} {row_col1[ i ]}'

    func activate [ idx: i32 ]
        orb : cast orbiter [ ux.app_object ]
        if [ !orb || !file || !lines || idx < 0 || idx >= lines.count ] return
        orb.open_at_line[ file, orb.active_pane, i32[ lines[ idx ] ] ]

    func render [] -> Elements
        return null

# a type's members read from its declaration: a silver type's
# lines one indent in, or a C struct's fields between its braces
class TypeInfo
    public file  : path
    # the type's own name, for the list's header
    public name  : string
    public names : vec string
    public types : vec string
    public lines : vec i32

    # the indent of a line, in columns (a tab is 4)
    func indent_of [ ln: string ] -> i32
        n : i32 [ 0 ]
        for [ k: i32 0, k < ln.count, k += 1 ]
            if [ ln[ k ] == 32 ] n += 1
            el [ ln[ k ] == 9 ] n += 4
            el break
        return n

    # the last word of a text: a name before its type
    func last_word [ t: string ] -> string
        e : i32 [ t.count - 1 ]
        while [ e >= 0 && !word_char[ i32[ t[ e ] ] ] ] e -= 1
        b : i32 [ e ]
        while [ b > 0 && word_char[ i32[ t[ b - 1 ] ] ] ] b -= 1
        return (e >= 0) ? t.mid[ b, e - b + 1 ] : ''

    func word_char [ c: i32 ] -> bool
        return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) ||
               (c >= 97 && c <= 122) || c == 95

    func add [ nm: string, ty: string, ln: i32 ]
        names.push[ nm ]
        types.push[ ty ]
        lines.push[ ln ]

    # a type loaded here: its members (bases' too) from the runtime
    func load_runtime [ ln: i32 ] -> bool
        if [ !name || name.count == 0 ] return false
        ty0 : Au.find_type[ name.chars, null ]
        if [ !ty0 ] return false
        # the fields first, then the methods
        for [ pass: i32 0, pass < 2, pass += 1 ]
            want : i32 [ (pass == 0) ? AU_MEMBER_VAR : AU_MEMBER_FUNC ]
            for [ ty : Au_t ty0, ty && ty != typeid[ Au ], ty = ty.context ]
                for [ i: i32 0, i < ty.members.count, i += 1 ]
                    mem : Au_t ty.members.origin[i]
                    if [ mem.member_type != want ] continue
                    nm : string [ mem.ident ]
                    tn : string (mem.src) ? string [ mem.src.ident ] : ''
                    if [ pass == 1 ] tn = '[] -> {tn}'
                    add[ nm, tn, (mem.src_line > 0) ? mem.src_line : ln ]
        return names.count > 0

    # ln: the declaration's 1-based line
    func load [ ln: i32 ]
        names = vec string []
        types = vec string []
        lines = vec i32 []
        if [ load_runtime[ ln ] ] return
        if [ !file || !file.exists[] || ln <= 0 ] return
        tx : string file.load[ typeid[string], null ]
        if [ !tx ] return
        all : vec string tx.split[ '\n' ]
        if [ ln > all.count ] return
        hd : string all[ ln - 1 ].trim[]
        # the name ends at a bracket, a brace or a colon
        pre : i32 [ -1 ]
        for [ k: i32 0, k < hd.count && pre < 0, k += 1 ]
            if [ hd[ k ] == 91 || hd[ k ] == 123 || hd[ k ] == 58 ] pre = k
        if [ !name || name.count == 0 ] name = last_word[ (pre > 0) ? hd.mid[ 0, pre ] : hd ]
        ext : string file.ext[]
        if [ ext && ext == 'ag' ]
            load_silver[ all, ln ]
        el
            load_c[ all, ln ]

    # one indent in from the header; comments and style blocks left out
    func load_silver [ all: vec string, ln: i32 ]
        base : i32 [ indent_of[ all[ ln - 1 ] ] ]
        kid  : i32 [ -1 ]
        for [ i: i32 ln, i < all.count, i += 1 ]
            raw : string all[ i ]
            t   : string raw.trim[]
            if [ t.count == 0 ] continue
            ind : i32 [ indent_of[ raw ] ]
            if [ ind <= base ] break
            if [ kid < 0 ] kid = ind
            if [ ind != kid || t[ 0 ] == 35 ] continue
            if [ t.index_of[ 'style' ] == 0 ] continue
            cx : i32 [ t.index_of[ ':' ] ]
            # a [ before any colon: a func, construct or cast
            bx : i32 [ t.index_of[ '[' ] ]
            if [ bx > 0 && (cx < 0 || bx < cx) ]
                add[ last_word[ t.mid[ 0, bx ] ], t.mid[ bx, t.count - bx ], i + 1 ]
                continue
            if [ cx <= 0 ] continue
            ty2 : string t.mid[ cx + 1, t.count - cx - 1 ].trim[]
            hx : i32 [ ty2.index_of[ ' #' ] ]
            if [ hx >= 0 ] ty2 = ty2.mid[ 0, hx ].trim[]
            add[ last_word[ t.mid[ 0, cx ] ], ty2, i + 1 ]

    # the fields at the struct's first brace depth: type then name
    func load_c [ all: vec string, ln: i32 ]
        depth : i32 [ 0 ]
        for [ i: i32 ln - 1, i < all.count, i += 1 ]
            t : string all[ i ].trim[]
            d0 : i32 [ depth ]
            for [ k: i32 0, k < t.count, k += 1 ]
                if [ t[ k ] == 123 ] depth += 1
                el [ t[ k ] == 125 ] depth -= 1
            if [ d0 > 0 && depth <= 0 ] break
            if [ d0 != 1 || t.count == 0 || t[ t.count - 1 ] != 59 ] continue
            f : string t.mid[ 0, t.count - 1 ]
            bx : i32 [ f.index_of[ '[' ] ]
            if [ bx > 0 ] f = f.mid[ 0, bx ]
            nm : string last_word[ f ]
            if [ nm.count == 0 ] continue
            ty : string f.mid[ 0, f.count - nm.count ].trim[]
            add[ nm, ty, i + 1 ]

NodeList Fields
    style : CSS {
        area: l0 t0 r0 b0
        layers.cbase:
            fill_color: #202
            area: l0 t0 r0 b0
        layers.content: FieldsLayer
            area: l4px t2px r4px b2px
            label_size: 15
            row_spacing: 1.2
    }
    public vars : vec Au

    func row_count [] -> i32
        if [ !vars ] return 0
        return vars.count

    func row_label [ i: i32 ] -> string
        if [ !vars || i < 0 || i >= vars.count ] return ''
        v : variable vars[i]
        return '{v.name}  {v.value}'

    func activate [ idx: i32 ]
        return

    func render [] -> Elements
        return null

# the one instrument on: its entries re-asked twice a second and its
# surface on the app's clock, in a canvas of its own for the same reason
element InstrView
    animated : true
    style : CSS {
        layers.ibase:
            fill_color: #0000
            area: l0 t0 r0 b0
    }
    mutable rows     : map Au [string]
    mutable ask_ms   : i64
    # while the split is being dragged the width changes every frame, and
    # each change makes the app rebuild every instrument canvas. sit out
    # the drag: titles only, then come back once the width holds still
    mutable last_w   : f32
    mutable settle   : i64
    func av [] -> AppView
        for [ e: element* a, e, e = e.parent ]
            if [ e inherits InstancePanel ]
                ip : InstancePanel e
                return ip.app[]
        return null
    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        av9 : AppView av[]
        if [ !av9 ] return
        act : string av9.instr_active[]
        if [ !act ] return
        cv : Canvas w.screen
        now : i64 [ epoch_millis[] ]
        if [ bounds.w != last_w ]
            last_w = bounds.w
            settle = now
        sizing : bool [ now - settle < 200 ]
        if [ !sizing && (ask_ms == 0 || now - ask_ms > 500) ]
            ask_ms = now
            if [ !rows ] rows = map Au [string] []
            rows[ act ] = av9.instr_entries[ act ]
        # mid-drag: nothing. asking for a new width here would rebuild
        # the canvas in the app on every frame
        if [ sizing ] return
        # we give the width, the app gives the height: its own size
        av9.instr_width[ act, i32[ bounds.w ] ]
        ft : av9.instr_front[ act ]
        if [ ft ]
            th : f32 [ f32[ ft.height ] ]
            if [ th > bounds.h ] th = bounds.h
            if [ th > 0.0 ] cv.draw_image[ ft, rect [ x: 0.0, y: 0.0, w: f32[ ft.width ], h: th ] ]
            return
        rw : vec string (rows && rows.contains[ act ]) ? rows[ act ] : null
        if [ !rw ] return
        cv.font_size[ 12 ]
        cv.fill_color[ rgba [ '#cfd6e4' ] ]
        y9 : f32 [ 0.0 ]
        for [ k: i32 0, k < rw.count, k += 1 ]
            if [ y9 > bounds.h - 12.0 ] break
            cv.draw_text[ '{rw[k]}', rect [ x: 8.0, y: y9, w: bounds.w - 12.0, h: 15.0 ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
            y9 += 15.0

# ONE column, right of the editor, holding every live instrument. the
# stack at the top selects which one shows; only that one is drawn.
# the panel itself is cached: tick dirties it when what it shows changes,
# and the instrument surface animates in a canvas of its own
# the one context panel: the selected instance's properties; the context bar's < folds it away
element SidePanel
    style : CSS {
        area: l0 t0 r0 b0
        # the context bar's ground and tint
        layers.sbase:
            fill_color: #140a2acc
            area: l0 t0 r0 b0
        layers.stint:
            fill_color: #3a1c8a40
            area: l0 t0 r0 b0
    }
    func render [] -> Elements
        t : Elements []
        orb : cast orbiter [ ux.app_object ]
        if [ orb && orb.side_tab == 'scenes' ]
            # the controls row level with the editor's title, the
            # cards under it
            t['scene_bar'] = element [ area: Region { l0 t0 r0 h1.3 }, elements: orb.scene_els[] ]
            grid : Elements []
            grid['scene_grid'] = SceneGrid [ ]
            t['scene_body'] = element [ area: Region { l0 t1.3 r0 b0 }, elements: grid ]
        el
            t['instance_panel'] = InstancePanel [ ]
        return t

# the scene cards as a grid in the side panel: a click loads
# that scene; the cards are the nav view's (draw_card)
Control SceneGrid
    style : CSS {
        area: l0 t0 r0 b0
    }
    mutable hov    : i32 [ -1 ]
    mutable sy     : f32
    mutable cards  : vec FindHit

    func cell_w [] -> f32
        return 152.0

    func cell_h [] -> f32
        return 148.0

    func per_row [] -> i32
        n : i32 [ i32[ bounds.w / cell_w[] ] ]
        return (n < 1) ? 1 : n

    # the row of cells sits centred in the panel
    func left_x [] -> f32
        return round[ (bounds.w - f32[ per_row[] ] * cell_w[]) * 0.5 ]

    # the card under x y (the grid's own space), or -1
    func card_at [ x: f32, y: f32 ] -> i32
        if [ !cards || !bounds ] return -1
        pr : i32 [ per_row[] ]
        x0 : f32 [ left_x[] ]
        if [ x < x0 || y + sy < 0.0 ] return -1
        col : i32 [ i32[ (x - x0) / cell_w[] ] ]
        row : i32 [ i32[ (y + sy) / cell_h[] ] ]
        if [ col >= pr ] return -1
        i : i32 [ row * pr + col ]
        return (i < cards.count) ? i : -1

    func on_move [ ev: Event ]
        h9 : i32 [ card_at[ ev.mouse.pos.x, ev.mouse.pos.y ] ]
        if [ h9 != hov ]
            hov      = h9
            pristine = false

    func on_leave [ ev: Event ]
        if [ hov >= 0 ]
            hov      = -1
            pristine = false

    func on_press [ ev: Event ]
        orb : cast orbiter [ ux.app_object ]
        i : i32 [ card_at[ ev.mouse.pos.x, ev.mouse.pos.y ] ]
        if [ orb && i >= 0 ]
            orb.scene_choose[ cards[ i ].scene ]
            pristine = false
        ev.no_default = true

    func on_wheel [ ev: Event ]
        if [ !cards || !bounds ] return
        rows : i32 [ (cards.count + per_row[] - 1) / per_row[] ]
        smax : f32 [ f32[ rows ] * cell_h[] - bounds.h ]
        sy += f32[ ev.mouse.wheel_delta.y ] * 26.0 * -1.0
        if [ sy > smax ] sy = smax
        if [ sy < 0.0 ] sy = 0.0
        pristine = false

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        orb : cast orbiter [ ux.app_object ]
        if [ !orb ] return
        if [ !cards ] cards = orb.scene_cards[]
        cv : Canvas w.screen
        pr : i32 [ per_row[] ]
        x0 : f32 [ left_x[] ]
        for [ i: i32 0, i < cards.count, i += 1 ]
            ry : f32 [ f32[ i / pr ] * cell_h[] - sy ]
            if [ ry + cell_h[] < 0.0 || ry > bounds.h ] continue
            # draw_card's x is the content's left: the box starts 4px before it
            cx : f32 [ x0 + f32[ i % pr ] * cell_w[] + 4.0 ]
            draw_card[ cv, orb, cards[ i ], cx, ry, cell_w[], cell_h[], i == hov ]

Control InstancePanel
    style : CSS {
        area: l0 t0 r0 b0
    }
    mutable chip_x   : f32
    mutable chip_y   : f32
    mutable chip_wd  : f32
    mutable icons    : map SVGModel [string]
    # what the rows showed last frame; a change repaints
    mutable row_sig  : string
    mutable last_pane : i32 [ -1 ]
    # the clicked name's type, read once per type
    mutable type_key : string
    mutable type_info : TypeInfo
    # the editor's touch count the type was last read at, and what
    # it found there
    mutable seen_touch : i64 [ -1 ]
    mutable caret_key  : string

    # the rows change on the instances' own clocks (a start, a crash, a
    # stop): compare what they would show and repaint only on a change
    public func tick [ w: Window ]
        li  : vec AppView inst_list[]
        ed9 : Editor editor[]
        orb : cast orbiter [ ux.app_object ]
        sig : string ''
        if [ li ]
            for [ av9: AppView ] in li
                sel9 : bool [ ed9 && ed9.run_view == av9 ]
                off9 : bool [ av9.ended || av9.held ]
                sw9  : string av9.status_word[]
                s9 : i32 [ (sel9) ? 1 : 0 ]
                o9 : i32 [ (off9) ? 1 : 0 ]
                sig = '{sig}|{av9.iid}:{sw9}:{s9}:{o9}'
        h9 : i32 [ (orb && orb.shift_down) ? 1 : 0 ]
        ct9 : string caret_type[]
        sig = '{sig}|{h9}|{ct9}'
        pn9 : i32 [ (orb) ? orb.active_pane : -1 ]
        if [ !row_sig || row_sig != sig || pn9 != last_pane ]
            # a new type at the caret: its list mounts on a restyle
            if [ ux && (!type_key || type_key != ct9) ] ux.restyle = true
            row_sig = sig
            row_sig.hold[]
            pristine = false
            # another editor selected: its instances, rebuilt
            if [ pn9 != last_pane && ux ] ux.restyle = true
            last_pane = pn9

    func icon [ nm: string ] -> SVGModel
        if [ !icons ] icons = map SVGModel [string] []
        if [ icons.contains[ nm ] ] return icons[ nm ]
        m : SVGModel [ path 'images/{nm}.svg' ]
        icons[ nm ] = m
        return m

    func row_h [] -> f32
        return 26.0

    # found at draw time, never passed in: taking it as a prop would
    # make the pane's shape depend on what is read back out of the pane
    func app [] -> AppView
        ed9 : Editor editor[]
        if [ !ed9 || !ed9.run_view ] return null
        return AppView ed9.run_view

    # the selected editor's view: the panel is its context
    func view [] -> EditorView
        orb : cast orbiter [ ux.app_object ]
        if [ !orb ] return null
        pv9 : element orb.pane_view[ orb.active_pane ]
        if [ !pv9 || !(pv9 inherits EditorView) ] return null
        return EditorView pv9

    func editor [] -> Editor
        orb : cast orbiter [ ux.app_object ]
        return (orb) ? orb.pane_at[ orb.active_pane ] : null

    func inst_list [] -> vec AppView
        ed9 : Editor editor[]
        return (ed9) ? ed9.instances[] : null

    # the type of the name at the caret: name|file|line (no file for
    # Au's own); only the user's own press or key moves it; a name with no
    # type, or a jump, keeps the last one
    func caret_type [] -> string
        e9 : Editor editor[]
        if [ !caret_key ] caret_key = ''
        if [ !e9 || e9.caret_touch == seen_touch ] return caret_key
        seen_touch = e9.caret_touch
        if [ e9.sel_line < 0 || e9.sel_line >= e9.line_count[] ] return caret_key
        ml : i32 [ e9.row_src[ e9.sel_line ] ]
        ln9 : string e9.line_get[ e9.sel_line ]
        sc9 : i32 [ e9.sel_col ]
        # the word the caret ends, then the one it starts; just past a
        # dot (rv9.|) it is the name before the dot
        dot9 : bool [ sc9 > 0 && ln9 && sc9 - 1 < ln9.count && ln9[ sc9 - 1 ] == 46 ]
        c0 : i32 [ (dot9) ? sc9 - 2 : sc9 - 1 ]
        c1 : i32 [ (dot9) ? sc9 - 2 : sc9 ]
        for [ c9: i32 c0, c9 <= c1, c9 += 1 ]
            if [ c9 < 0 ] continue
            cr : ColorRegion e9.region_at[ ml, c9 ]
            if [ cr && cr.tname ]
                ts9 : string (cr.tsrc) ? cr.tsrc : ''
                caret_key = '{cr.tname}|{ts9}|{cr.tline}'
                break
        return caret_key

    # the line of the caret type's declaration
    func type_line [] -> i32
        if [ !type_key ] return 0
        cx9 : i32 [ type_key.rindex_of[ '|' ] ]
        return i32[ type_key.mid[ cx9 + 1, type_key.count - cx9 - 1 ] ]

    # the members of the caret's type, read once per type
    func caret_info [] -> TypeInfo
        k9 : string caret_type[]
        if [ k9.count == 0 ] return null
        if [ type_key && type_key == k9 ] return type_info
        pt9 : vec string k9.split[ '|' ]
        fl9 : string (pt9.count > 1) ? pt9[ 1 ] : ''
        ti9 : TypeInfo [ name: pt9[ 0 ] ]
        if [ fl9.count > 0 ] ti9.file = path fl9
        ti9.load[ (pt9.count > 2) ? i32[ pt9[ 2 ] ] : 0 ]
        type_key  = k9
        type_info = ti9
        return ti9

    # the frames of the selected instance at a stop, none otherwise
    func stack_rows [] -> i32
        orb : cast orbiter [ ux.app_object ]
        av  : AppView app[]
        dv  : dbg (av) ? av.debugger : null
        if [ !orb || !dv || !dv.active || dv.running ] return 0
        fr : vec Au orb.debug_frames[]
        if [ !fr || fr.count == 0 ] return 0
        return (fr.count < 8) ? fr.count : 8

    # the accordion: properties, instruments, callstack. one is open and
    # fills; the others are headers, above it from the top, below it
    # from the bottom
    func open_ix [] -> i32
        orb : cast orbiter [ ux.app_object ]
        if [ !orb ] return -1
        if [ orb.props_open ] return 0
        if [ orb.instr_open ] return 1
        if [ orb.stack_open ] return 2
        return -1

    # the first render comes before any layout: no bounds yet
    func panel_h [] -> f32
        return (bounds) ? bounds.h : 0.0

    # ONE row of tabs for all three sections; the open one's content
    # runs from under it to the footer, so nothing folds above or below
    # any more
    func tab_y [] -> f32
        return 0.0

    # the tabs' row as laid out (h1.3, the title bar's height)
    func tabs_h [] -> f32
        se9 : element (elements) ? elements[ 'sections' ] : null
        if [ se9 && se9.bounds && se9.bounds.h > 0.0 ] return se9.bounds.h
        fu9 : f32 [ (ux && ux.vk && ux.vk.font_unit > 0) ? f32[ ux.vk.font_unit ] : 22.0 ]
        return round[ 1.3 * fu9 ]

    # a click on a header opens that section, closing the others; on the
    # open one it folds, leaving none
    func sect_toggle [ i: i32 ]
        orb : cast orbiter [ ux.app_object ]
        if [ !orb ] return
        was : bool [ open_ix[] == i ]
        orb.props_open = !was && i == 0
        orb.instr_open = !was && i == 1
        orb.stack_open = !was && i == 2

    # a section header: a fold marker at the left when asked, the name
    # beside it
    func section_title [ cv: Canvas, y: f32, text: string,
            open: bool, marker: bool ]
        rh : f32 [ row_h[] ]
        cv.save[]
        cv.fill_color[ (open) ? rgba [ '#312' ] : rgba [ '#212' ] ]
        # the open one glows from its edges, a touch brighter on red and
        # blue
        if [ open ] cv.box_shadow[ rgba [ '#615' ], 0.0, 0.0, 5.0, 0.0, true ]
        cv.rect_to[ 0.0, y, bounds.w, rh - 1.0 ]
        cv.paint[]
        cv.restore[]
        # the names line up whether or not a marker sits before them
        tx : f32 [ 22.0 ]
        if [ marker ]
            cv.fill_color[ rgba [ '#9a93b3' ] ]
            if [ open ]
                cv.move_to[ 8.0, y + 10.0 ]
                cv.line_to[ 16.0, y + 10.0 ]
                cv.line_to[ 12.0, y + 16.0 ]
            el
                cv.move_to[ 9.0, y + 8.0 ]
                cv.line_to[ 15.0, y + 13.0 ]
                cv.line_to[ 9.0, y + 18.0 ]
            cv.close_path[]
            cv.paint[]
        cv.font_size[ 13 ]
        cv.fill_color[ rgba [ '#e8e2f5' ] ]
        tr9 : rect [ x: tx, y: y, w: bounds.w - tx - 8.0, h: rh ]
        cv.draw_text[ text, tr9, vec2f [ 0.0, 0.5 ],
            vec2f [ 0.0, 0.0 ], Overflow.clip, null ]

    # the export lists the module's properties; a props answer (live or
    # the last one kept) gives their current values, and anything it
    # adds goes after
    func render [] -> Elements
        ev9 : EditorView view[]
        orb : cast orbiter [ ux.app_object ]
        if [ !ev9 || !orb ] return null
        t  : Elements []
        # the running instance's own props; else what the module
        # answered last; else its export
        av9 : AppView app[]
        lv9 : bool [ av9 && av9.props && av9.props.count > 0 ]
        # the spec is the INSTANCE's module, which need not be the
        # pane's file the INSTANCE's module, which need not be the
        # pane's file
        mod9 : string ev9.band_mod[]
        if [ av9 ]
            am9 : string av9.app_mod
            mod9 = (am9 && am9.count > 0) ? am9 : av9.src.stem[]
        sp9 : string (lv9) ? av9.props : orb.module_spec[ mod9 ]
        # trinity's display is a live prop of the running app; before it
        # runs the row still has to exist, holding what the instance
        # will launch as
        if [ av9 && !(sp9 && sp9.count > 0) ]
            dp9 : Prop [ ident: 'display', module: 'trinity', type: 'DisplayMode', access: 'public' ]
            dp9.meta  = vec string [] [ 'Live' ]
            dp9.stops = vec string [] [ 'PIP', 'Embed', 'Window', 'Screen' ]
            dp9.value = (av9.display >= 0 && av9.display < 4) ? dp9.stops[ av9.display ] : 'PIP'
            ps9 : LaunchProps [ module: mod9 ]
            ps9.props = vec Prop []
            ps9.props.push[ dp9 ]
            sp9 = Au.string_agi[ ps9 ]
        # the selected instance edits ITS args; with none selected there
        # is no list one row of tabs for properties, instruments and
        # callstack: the lit one is open and its content fills the panel
        # beneath
        # a module with no instance yet shows its properties too
        pm9 : bool [ av9 || orb.module_src_of[ editor[] ] ]
        # the tabs stay for any file: a section may simply be empty
        if [ editor[] ]
            ok9 : i32 [ open_ix[] ]
            t['sections'] = SectionTabs [
                icons: false, seg_radius: 0.0, manual: true, rest_hover: true,
                rest_fill: rgba [ '#5a1a4a22' ], lit_fill: rgba [ '#5a1a4a55' ],
                buttons: vec string [] [
                    'properties', 'instruments', 'callstack' ],
                sel_mask: (ok9 >= 0) ? (1 << ok9) : 0,
                label_px: row_h[] * 0.5 - 2.0,
                area: Region [ 'l0 t{tab_y[]}px r0 h1.3' ] ]
        if [ orb.props_open ]
            # no instance: the args its next start takes
            fs9 : file_state (av9) ? null : orb.args_state_of[ editor[] ]
            ar9 : string (av9) ? av9.module_args : ((fs9) ? fs9.args : null)
            if [ !ar9 ] ar9 = ''
            py9 : f32 [ tab_y[] + tabs_h[] ]
            # cached like any container: a control repaints only when it
            # changes
            up9 : bool [ av9 && av9.slot >= 0 && !av9.ended && !av9.held ]
            pd9 : i32 [ (up9) ? host_app_pid[ av9.slot ] : 0 ]
            # the clicked name's type, docked under the fields
            ti9 : TypeInfo caret_info[]
            mh9 : f32 [ 0.0 ]
            if [ ti9 && ti9.names && ti9.names.count > 0 ]
                # the row the list last drew, else a 15px line at 1.2
                me9 : element (elements) ? elements[ 'members' ] : null
                mr9 : NodeList (me9 && me9.elements) ? me9.elements[ 'rows' ] : null
                rw9 : f32 [ (mr9 && mr9.row_height > 20.0) ? mr9.row_height : 26.0 ]
                # the rows are capped; the header (30px) and the filter
                # bar (35px) always fit
                mh9 = min[ f32[ ti9.names.count ] * rw9, panel_h[] * 0.45 ] + 30.0 + 35.0
                where9 : string (ti9.file) ? '   {ti9.file.filename[]}:{type_line[]}' : ''
                t['members'] = TypeMembers [ file: ti9.file, names: ti9.names,
                    title: '{ti9.name}{where9}',
                    types: ti9.types, lines: ti9.lines,
                    area: Region [ 'l0 b{mh9}px r0 h{mh9}px' ] ]
            # the fields only for a module or an instance
            if [ pm9 ]
                t['launch_panel'] = LaunchPanel [
                    spec: sp9, args: ar9, inst: (av9) ? av9.iid : -1,
                    live_vals: lv9, dbg_row: av9 != null,
                    dbg_on: av9 && av9.debug_build, cov_on: av9 && av9.cov_build, pid_val: pd9,
                    area: Region [ 'l0 t{py9}px r0 b{mh9}px' ] ]
        in9 : bool [ av9 && orb.instr_open && av9.instr_names ]
        if [ in9 && av9.instr_active[] && bounds ]
            iy9 : f32 [ tab_y[] + tabs_h[] + chips_h[ av9.instr_names ] ]
            t['instr'] = InstrView [
                area: Region [ 'l0 t{iy9}px r0 b0' ] ]
        if [ av9 && orb.stack_open && stack_rows[] > 0 ]
            cy9 : f32 [ tab_y[] + tabs_h[] ]
            # one toggle over the list: frames with no known source,
            # listed or not
            t['stack_unknown'] = TButtons [
                icons: false, seg_radius: 0.0, manual: true,
                buttons: vec string [] [ 'show unknown source' ],
                sel_mask: (orb.stack_unknown) ? 1 : 0,
                label_px: row_h[] * 0.5 - 2.0,
                area: Region [ 'l0 t{cy9}px r0 h{row_h[]}px' ] ]
            ly9 : f32 [ cy9 + row_h[] ]
            t['callstack'] = Callstack [
                frames: orb.stack_frames[],
                area: Region [ 'l0 t{ly9}px r0 b0' ] ]
        return t

    func inst_color [ av: AppView ] -> rgba
        if [ av.held ]   return rgba [ '#8f89a3' ]
        if [ av.ended ]  return rgba [ '#ef5350' ]
        if [ av.paused ] return rgba [ '#ffb74d' ]
        return rgba [ '#66bb6a' ]

    func chip_w [ nm: string ] -> f32
        return 7.0 * f32[ nm.count ] + 16.0

    # chip ix in ONE flow that wraps at the panel width; lands in
    # chip_x/chip_y/chip_wd, measured from the top of the chip band, so
    # press and draw agree rows break at the width; every row that
    # breaks is stretched to fill it, the slack shared evenly across its
    # cells
    func chip_pos [ names: vec string, ix: i32 ] -> bool
        if [ ix < 0 || ix >= names.count ] return false
        y  : f32 [ 0.0 ]
        r0 : i32 [ 0 ]
        while [ r0 < names.count ]
            # the cells of this row, by their natural widths
            r1  : i32 [ r0 ]
            sum : f32 [ 0.0 ]
            while [ r1 < names.count ]
                w : f32 [ chip_w[ names[ r1 ] ] ]
                if [ r1 > r0 && sum + w > bounds.w ] break
                sum += w
                r1 += 1
            n9    : i32 [ r1 - r0 ]
            gap9  : f32 [ (bounds.w - sum) / f32[ n9 ] ]
            extra : f32 [ (bounds.w > sum) ? gap9 : 0.0 ]
            if [ ix < r1 ]
                x : f32 [ 0.0 ]
                for [ i: i32 r0, i < ix, i += 1 ]
                    x += chip_w[ names[ i ] ] + extra
                chip_x  = round[ x ]
                chip_y  = y
                cw9 : f32 [ chip_w[ names[ ix ] ] ]
                chip_wd = round[ x + cw9 + extra ] - round[ x ]
                return true
            y += row_h[]
            r0 = r1
        return false

    func chips_h [ names: vec string ] -> f32
        if [ !names || names.count == 0 ] return 0.0
        if [ !chip_pos[ names, names.count - 1 ] ] return 0.0
        return chip_y + row_h[]

    # one flow of chips at y: draws them, or with the press point given,
    # returns the hit
    func chip_row [ cv: Canvas, names: vec string, y: f32,
            lit: string, px: f32, py: f32 ] -> i32
        for [ i: i32 0, i < names.count, i += 1 ]
            nm : string names[ i ]
            if [ !chip_pos[ names, i ] ] continue
            cy : f32 [ y + chip_y ]
            rh : f32 [ row_h[] ]
            if [ !cv ]
                inx : bool [ px >= chip_x && px < chip_x + chip_wd ]
                iny : bool [ py >= cy && py < cy + rh ]
                if [ inx && iny ] return i
                continue
            # a pixel grid like the other controls: flat cells, 1px
            # rules, no rounding
            on9 : bool [ lit && lit.compare[ nm ] == 0 ]
            cv.stroke_width[ 0.0 ]
            bg9 : rgba [ (on9) ? '#6cb6ff' : '#2a2340' ]
            cv.fill_color[ bg9 ]
            cv.rect_to[ chip_x, cy, chip_wd, rh ]
            cv.paint[]
            cv.fill_color[ rgba [ '#ffffff1a' ] ]
            cv.rect_to[ chip_x + chip_wd - 1.0, cy, 1.0, rh ]
            cv.paint[]
            cv.rect_to[ chip_x, cy + rh - 1.0, chip_wd, 1.0 ]
            cv.paint[]
            cv.font_size[ 12 ]
            fg9 : rgba [ (on9) ? '#0f1220' : '#e8e2f5' ]
            cv.fill_color[ fg9 ]
            cr9 : rect [ x: chip_x, y: cy, w: chip_wd, h: rh ]
            cv.draw_text[ nm, cr9, vec2f [ 0.5, 0.5 ],
                vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
        return -1

    # instrument off — they are ALL shown, always
    func on_press [ ev: Event ]
        # a modifier click belongs to the inspector: claiming it here
        # (the no_default below) is what kept it from the source
        if [ ev.key.meta || ev.key.ctrl ] return
        av : app[]
        if [ !av ] return
        orb7 : cast orbiter [ ux.app_object ]
        if [ !av.instr_names || (orb7 && !orb7.instr_open) ] return
        top : f32 [ tab_y[] + tabs_h[] ]
        for [ i: i32 0, i < av.instr_names.count, i += 1 ]
            if [ !chip_pos[ av.instr_names, i ] ] continue
            cy : f32 [ top + chip_y ]
            mx8 : f32 [ ev.mouse.pos.x ]
            my8 : f32 [ ev.mouse.pos.y ]
            inx : bool [ mx8 >= chip_x && mx8 < chip_x + chip_wd ]
            iny : bool [ my8 >= cy && my8 < cy + row_h[] ]
            if [ inx && iny ]
                av.instr_select[ av.instr_names[ i ] ]
                pristine = false
                ev.no_default = true
                return

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        cv : Canvas w.screen
        orb : cast orbiter [ ux.app_object ]
        av : app[]
        if [ !av || !orb ] return
        # the sections are a tab row built in render; the chips once the
        # app answers
        if [ !orb.instr_open || !av.instr_names ] return
        # one flow of chips; the lit one is the single instrument on: it
        # logs and shows
        top : f32 [ tab_y[] + tabs_h[] ]
        act : string av.instr_active[]
        chip_row[ cv, av.instr_names, top, act, 0.0, 0.0 ]

# every running app as a task, centred in the status bar. a task's
# name is the app's own title
Control TaskBar
    # one per module folder, as the dock loads them
    mutable app_icons : map AppIcon [string]
    mutable task_sig : string
    # the task whose close the pointer is over, and the one pressed
    mutable close_hov  : i32 [ -1 ]
    mutable close_down : i32 [ -1 ]

    # a start, a stop, a new title: repaint on a change only
    public func tick [ w: Window ]
        li  : vec AppView inst_list[]
        ed9 : Editor editor[]
        orb : cast orbiter [ ux.app_object ]
        sig : string ''
        if [ li ]
            for [ av9: AppView ] in li
                s9 : i32 [ (ed9 && ed9.run_view == av9) ? 1 : 0 ]
                o9 : i32 [ (av9.ended || av9.held) ? 1 : ((av9.paused) ? 2 : 0) ]
                sig = '{sig}|{av9.iid}:{av9.app_title}:{s9}:{o9}'
        p9 : i32 [ (orb) ? orb.active_pane : -1 ]
        sig = '{sig}|{p9}'
        if [ !task_sig || task_sig != sig ]
            task_sig = sig
            task_sig.hold[]
            pristine = false

    func editor [] -> Editor
        orb : cast orbiter [ ux.app_object ]
        return (orb) ? orb.pane_at[ orb.active_pane ] : null

    func inst_list [] -> vec AppView
        orb : cast orbiter [ ux.app_object ]
        return (orb) ? orb.instances : null

    # the pane showing it, or null
    func shown_in [ av: AppView ] -> Editor
        orb : cast orbiter [ ux.app_object ]
        if [ !orb ] return null
        for [ i: i32 0, i < orb.editor_slots.count, i += 1 ]
            e9 : Editor orb.pane_at[ i ]
            if [ e9 && e9.run_view == av ] return e9
        return null

    # only instances whose app has named itself
    func tasks [] -> vec AppView
        li : vec AppView inst_list[]
        r  : vec AppView []
        if [ !li ] return r
        for [ av9: AppView ] in li
            if [ av9.app_title && av9.app_title.count > 0 ] r.push[ av9 ]
        return r

    # six bar heights a task
    func task_w [] -> f32
        return round[ bounds.h * 6.0 ]

    # a task and the dark line after it
    func task_step [] -> f32
        return task_w[] + 1.0

    # the tasks sit centred: the first one's left
    func task_x [] -> f32
        n : i32 [ tasks[].count ]
        return round[ (bounds.w - f32[ n ] * task_step[]) * 0.5 ]

    # the task whose close ring holds this point, else -1
    func close_at [ p: vec2f ] -> i32
        if [ !bounds ] return -1
        mx : f32 [ p.x - task_x[] ]
        if [ mx < 0.0 ] return -1
        i : i32 [ i32[ mx / task_step[] ] ]
        if [ i >= tasks[].count ] return -1
        dx : f32 [ mx - f32[ i ] * task_step[] - (task_w[] - bounds.h * 0.5) ]
        dy : f32 [ p.y - bounds.h * 0.5 ]
        # a little past the 8px ring
        return (dx * dx + dy * dy <= 100.0) ? i : -1

    func on_move [ ev: Event ]
        h9 : i32 [ close_at[ ev.mouse.pos ] ]
        if [ h9 != close_hov ]
            close_hov = h9
            pristine  = false

    func on_leave [ ev: Event ]
        if [ close_hov >= 0 ]
            close_hov = -1
            pristine  = false

    # the close acts on release, still over the ring it went down on
    func on_release [ ev: Event ]
        d9 : i32 [ close_down ]
        if [ d9 < 0 ] return
        close_down = -1
        pristine   = false
        tk  : vec AppView tasks[]
        orb : cast orbiter [ ux.app_object ]
        if [ !orb || close_at[ ev.mouse.pos ] != d9 || d9 >= tk.count ] return
        av9 : AppView tk[ d9 ]
        sp9 : Editor shown_in[ av9 ]
        if [ sp9 ]
            sp9.toggle_app_run[ false ]
        el
            av9.release*[]
            orb.remove_instance[ av9 ]
        if [ ux ] ux.restyle = true

    # shift makes a new instance in this tab; the close ring at the
    # right stops and closes it; the rest of the task selects it, or
    # unselects it
    func on_press [ ev: Event ]
        if [ ev.key.meta || ev.key.ctrl ] return
        tk  : vec AppView tasks[]
        li  : vec AppView inst_list[]
        ed9 : Editor editor[]
        orb : cast orbiter [ ux.app_object ]
        if [ !li || !ed9 || !orb || !bounds ] return
        mx : f32 [ ev.mouse.pos.x - task_x[] ]
        if [ mx < 0.0 ] return
        i : i32 [ i32[ mx / task_step[] ] ]
        if [ i >= tk.count ] return
        av9 : AppView tk[ i ]
        tx9 : f32 [ mx - f32[ i ] * task_step[] ]
        if [ ev.key.shift ]
            orb.show_app[ ed9, av9.src, true ]
        el [ close_at[ ev.mouse.pos ] == i ]
            close_down = i
        el [ ed9.run_view == av9 ]
            ed9.run_view = null
            ed9.app_view = false
            ed9.load_file[]
            orb.session_dirty = true
        el
            orb.embed_app[ ed9, av9 ]
        pristine = false
        ev.no_default = true
        if [ ux ] ux.restyle = true

    # the x: pressed, under the pointer, at rest
    func x_color [ i: i32 ] -> rgba
        if [ close_down == i ] return rgba [ '#ff7aa4' ]
        if [ close_hov == i ]  return rgba [ '#ffffff' ]
        return rgba [ '#a89fc4' ]

    # two strokes, 4.5px out from the centre, 1.6px thick
    func draw_x [ cv: Canvas, cx: f32, cy: f32, col: rgba ]
        d9 : f32 [ 4.5 * 0.7071 ]
        cv.save[]
        cv.fill_color[ rgba [ '#0000' ] ]
        cv.stroke_color[ col ]
        cv.stroke_width[ 1.6 ]
        cv.stroke_offset[ 0.0 ]
        cv.set_stroke_cap[ Cap.round ]
        cv.move_to[ cx - d9, cy - d9 ]
        cv.line_to[ cx + d9, cy + d9 ]
        cv.move_to[ cx + d9, cy - d9 ]
        cv.line_to[ cx - d9, cy + d9 ]
        cv.paint[]
        cv.restore[]

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        li  : vec AppView tasks[]
        ed9 : Editor editor[]
        orb : cast orbiter [ ux.app_object ]
        if [ !orb ] return
        cv : Canvas w.screen
        rh : f32 [ bounds.h ]
        tw : f32 [ task_w[] ]
        for [ i: i32 0, i < li.count, i += 1 ]
            av9 : AppView li[ i ]
            x8  : f32 [ task_x[] + f32[ i ] * task_step[] ]
            sel9 : bool [ ed9 && ed9.run_view == av9 ]
            cv.save[]
            cv.fill_color[ (sel9) ? rgba [ '#8826668c' ] : rgba [ '#0000' ] ]
            cv.box_shadow[ rgba [ '#c890ff04' ], 0.0, 0.0, 13.0, 0.0, true ]
            cv.stroke_width[ 1.0 ]
            cv.stroke_offset[ -0.5 ]
            cv.stroke_color[ rgba [ '#fff1' ] ]
            w.near_light_on[ cv, a, 0.0, 0.0 ]
            cv.near_style[ 2.0, 3.0, rgba [ '#c890ffaa' ], w.near_y_fade ]
            cv.rect_to[ x8, 0.0, tw, rh ]
            cv.paint[]
            cv.no_shadows[]
            cv.stroke_width[ 0.0 ]
            cv.stroke_offset[ 0.0 ]
            cv.restore[]
            # its module's app icon, as the dock shows it
            md9 : path (av9.src) ? av9.src.parent_dir[] : null
            if [ md9 ]
                if [ !app_icons ] app_icons = map AppIcon [string] []
                mk9 : string '{md9}'
                if [ !app_icons.contains[ mk9 ] ]
                    app_icons[ mk9 ] = AppIcon [ file: md9, module: true,
                        agi: path '{path.path_startup[]}/install/export/{orb.install_name_of[ md9.filename[] ]}.agi' ]
                is9 : f32 [ round[ rh * 0.5 ] ]
                im9 : f32 [ round[ (rh - is9) * 0.5 ] ]
                ai9 : AppIcon app_icons[ mk9 ]
                ai9.paint[ cv, x8 + im9, im9, is9 ]
            cv.font_size[ 13 ]
            cv.fill_color[ rgba [ '#e8e2f5' ] ]
            nr9 : rect [ x: x8 + rh, y: 0.0, w: tw - rh * 2.0, h: rh ]
            cv.draw_text[ av9.app_title, nr9, vec2f [ 0.0, 0.5 ],
                vec2f [ 0.0, 0.0 ], Overflow.ellipsis, null ]
            # the close: a 16px ring the pointer lights, an x inside
            cx9 : f32 [ x8 + tw - round[ rh * 0.5 ] ]
            cy9 : f32 [ round[ rh * 0.5 ] ]
            cv.save[]
            w.near_light_on[ cv, a, 0.0, 0.0 ]
            # the ring's own reach: 32px, round, so no y fade
            if [ near_glow > 0.0 ]
                sc9 : f32 [ cv.transform_scale[] ]
                if [ sc9 <= 0.0 ] sc9 = 1.0
                lx9 : f32 [ cv.transform_tx[] + (w.mouse.x - win_pos.x) * sc9 ]
                ly9 : f32 [ cv.transform_ty[] + (w.mouse.y - win_pos.y) * sc9 ]
                cv.near_light[ lx9, ly9, 32.0 * sc9, near_glow ]
            cv.near_style[ 1.3, 0.0, rgba [ '#c890ffff' ], 1.0 ]
            # black inside while the pointer is on it, or it is held
            hb9 : bool [ close_hov == i || close_down == i ]
            cv.fill_color[ (hb9) ? rgba [ '#00000080' ] : rgba [ '#0000' ] ]
            cv.stroke_color[ rgba [ '#fff2' ] ]
            cv.stroke_width[ 1.0 ]
            cv.stroke_offset[ 0.0 ]
            cv.rounded_rect[ cx9 - 8.0, cy9 - 8.0, 16.0, 16.0, 8.0, 8.0, 8.0, 8.0 ]
            cv.paint[]
            cv.restore[]
            draw_x[ cv, cx9, cy9, x_color[ i ] ]
        # a dark line just past each white right edge
        cv.fill_color[ rgba [ '#00000040' ] ]
        for [ i: i32 0, i < li.count, i += 1 ]
            cv.rect_to[ task_x[] + f32[ i ] * task_step[] + tw, 0.0, 1.0, rh ]
            cv.paint[]

NodeList Toolbox
    style : CSS {
        area: l0 t0 r0 b0
        layers.tbase:
            fill_color: #141a24
            area: l0 t0 r0 b0
        layers.content: NodeLayer
            area: l4px t2px r4px b2px
            label_size: 15
            row_spacing: 1.4
            sel_color: #2f6b4a40
            sel_radius: 6.0
            text_color: #cfe
    }
    public items : vec string

    func row_count [] -> i32
        if [ !items ] return 0
        return items.count

    func row_label [ i: i32 ] -> string
        if [ !items || i < 0 || i >= items.count ] return ''
        return items[i]

    func activate [ idx: i32 ]
        return

    func render [] -> Elements
        return null

NodeList Props
    style : CSS {
        area: l0 t0 r0 b0
        layers.pbase:
            fill_color: #1a1420
            area: l0 t0 r0 b0
        layers.content: PropsLayer
            area: l4px t2px r4px b2px
            label_size: 15
            row_spacing: 1.4
            key_color: #d8a8c4
            text_color: #e8cfe0
            line_color: #ffffff18
    }
    public  target : element
    intern  cur    : element
    intern  keys   : vec string
    intern  vals   : vec string

    # members of the inspected element, base class first
    func rebuild []
        cur  = target
        keys = vec string []
        vals = vec string []
        if [ !target ] return
        tys : vec Au_t []
        for [ ty : typeid[ target ], ty != typeid[ Au ], ty = ty.context ]
            tys.push[ ty ]
        for [ ti: i32 tys.count - 1, ti >= 0, ti -= 1 ]
            ty2 : Au_t tys[ti]
            for [ mi: i32 0, mi < ty2.members.count, mi += 1 ]
                mem : Au_t ty2.members.origin[mi]
                if [ mem.member_type != AU_MEMBER_VAR ] continue
                if [ !mem.src ] continue
                keys.push[ string[ mem.ident ] ]
                v : Au target.member_object[ mem ]
                vals.push[ (v) ? '{v}' : '' ]

    func row_count [] -> i32
        if [ target != cur ] rebuild[]
        if [ !keys ] return 0
        return keys.count

    func row_key [ i: i32 ] -> string
        if [ !keys || i < 0 || i >= keys.count ] return ''
        return keys[i]

    func row_val [ i: i32 ] -> string
        if [ !vals || i < 0 || i >= vals.count ] return ''
        return vals[i]

    func row_label [ i: i32 ] -> string
        return '{row_key[ i ]}  {row_val[ i ]}'

    func activate [ idx: i32 ]
        return

    func render [] -> Elements
        return null

Layer PropsLayer
    public label_size  : f32
    public row_spacing : f32
    public key_color   : string
    public text_color  : string
    public line_color  : string

    func draw [ cv: Canvas ]
        pl : Props[ parent ]
        if [ !pl ] return
        cv.font_size[ i32[label_size] ]
        lh : f32 [ cv.get_line_height[] * ((row_spacing > 0.0) ? row_spacing : 1.0) ]
        n  : i32 [ pl.row_count[] ]
        f  : string pl.flt[]
        mc : i32 [ 0 ]
        for [ i: i32 0, i < n, i += 1 ]
            if [ pl.row_match[ i, f ] ] mc += 1
        pl.row_height   = lh
        pl.content_y    = bounds.y
        pl.content_h    = f32[mc] * lh
        pl.view_h       = bounds.h
        pl.scroll_speed = lh
        x0   : f32 [ bounds.x ]
        y0   : f32 [ bounds.y ]
        colx : f32 [ round[ bounds.x + bounds.w * 0.45 ] ]
        lc   : rgba [ (line_color) ? line_color : rgba['#ffffff18'] ]
        wtx  : f32 [ cv.transform_tx[] ]
        wty  : f32 [ cv.transform_ty[] ]
        cv.set_crop[ wtx + bounds.x, wty + bounds.y, wtx + bounds.x + bounds.w, wty + bounds.y + bounds.h ]
        cv.save[]
        cv.plain[]
        cv.hard_edge[]
        cv.stroke_width[ 0.0 ]
        # one column rule, full height, exactly 1px
        cv.fill_color[ lc ]
        cv.rect_to[ colx, bounds.y, 1.0, bounds.h ]
        cv.paint[ ]
        dr : i32 [ 0 ]
        for [ i: i32 0, i < n, i += 1 ]
            if [ !pl.row_match[ i, f ] ] continue
            y : f32 [ round[ y0 + f32[dr] * lh - pl.scroll.y ] ]
            dr += 1
            if [ y + lh < bounds.y ] continue
            if [ y > bounds.y + bounds.h ] break
            if [ i == pl.sel ]
                cv.fill_color[ rgba['#8c4a6440'] ]
                cv.rect_to[ x0, y, bounds.w, lh ]
                cv.paint[ ]
            cv.fill_color[ lc ]
            cv.rect_to[ x0, y + lh - 1.0, bounds.w, 1.0 ]
            cv.paint[ ]
            cv.fill_color[ (key_color) ? key_color : '#d8a8c4' ]
            cv.draw_text[ pl.row_key[ i ],
                rect [ x: x0 + 6.0, y: y, w: colx - x0 - 10.0, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
            cv.fill_color[ (text_color) ? text_color : '#e8cfe0' ]
            cv.draw_text[ pl.row_val[ i ],
                rect [ x: colx + 6.0, y: y, w: bounds.x + bounds.w - colx - 10.0, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
        cv.restore[]
        cv.clear_crop[]

Layer FieldsLayer
    public label_size  : f32
    public row_spacing : f32
    public key_color   : string
    public text_color  : string
    public line_color  : string

    func draw [ cv: Canvas ]
        fl : Fields[ parent ]
        if [ !fl ] return
        cv.font_size[ i32[label_size] ]
        lh : f32 [ cv.get_line_height[] * ((row_spacing > 0.0) ? row_spacing : 1.0) ]
        n  : i32 [ fl.row_count[] ]
        fl.row_height   = lh
        fl.content_y    = bounds.y
        fl.content_h    = f32[n] * lh
        fl.view_h       = bounds.h
        fl.scroll_speed = lh
        x0   : f32 [ bounds.x ]
        y0   : f32 [ bounds.y ]
        colx : f32 [ bounds.x + bounds.w * 0.42 ]
        lc   : rgba [ (line_color) ? line_color : rgba['#ffffff18'] ]
        wtx  : f32 [ cv.transform_tx[] ]
        wty  : f32 [ cv.transform_ty[] ]
        cv.set_crop[ wtx + bounds.x, wty + bounds.y, wtx + bounds.x + bounds.w, wty + bounds.y + bounds.h ]
        cv.stroke_width[ 0.0 ]
        for [ i: i32 0, i < n, i += 1 ]
            y : f32 [ y0 + f32[i] * lh - fl.scroll.y ]
            if [ y + lh < bounds.y ] continue
            if [ y > bounds.y + bounds.h ] break
            v : variable fl.vars[i]
            if [ i == fl.sel ]
                cv.fill_color[ rgba['#264f7866'] ]
                cv.rect_to[ x0, y, bounds.w, lh ]
                cv.paint[ ]
            # per-row separator line (bottom edge)
            cv.fill_color[ lc ]
            cv.rect_to[ x0, y + lh - 1.0, bounds.w, 1.0 ]
            cv.paint[ ]
            # key (name) in the left column
            cv.fill_color[ (key_color) ? key_color : '#9fb6d8' ]
            cv.draw_text[ (v) ? v.name : '',
                rect [ x: x0 + 8.0, y: y, w: colx - x0 - 12.0, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
            # value in the right column
            cv.fill_color[ (text_color) ? text_color : '#cfe6ff' ]
            cv.draw_text[ (v) ? v.value : '',
                rect [ x: colx + 8.0, y: y, w: bounds.x + bounds.w - colx - 12.0, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
        cv.clear_crop[]
