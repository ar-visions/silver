extend orbiter

Option NodeList
    mutable sel        : i32 [ -1 ]
    mutable row_height : f32 [ 20.0 ]
    mutable content_y  : f32 [ 0.0 ]
    mutable view_h     : f32 [ 0.0 ]

    # ---- subclass hooks (overridden) ----
    func row_count [] -> i32
        return 0
    func row_label [ i: i32 ] -> string
        return ''
    func activate [ idx: i32 ]
        return

    func flt [] -> string
        if [ !elements ] return null
        t : element elements[ 'list_filter' ]
        if [ !t ] return null
        return t.edit

    func row_match [ i: i32, f: string ] -> bool
        if [ !f || f.count == 0 ] return true
        return row_label*[ i ].index_of[ f ] >= 0

    func visible_index [ vrow: i32, f: string ] -> i32
        seen : i32 [ 0 ]
        for [ i: i32 0, i < row_count*[], i += 1 ]
            if [ row_match[ i, f ] ]
                if [ seen == vrow ] return i
                seen += 1
        return -1

    # ---- shared behavior ----
    func scroll_to_sel []
        if [ sel < 0 || row_count*[] == 0 ] return
        item_y : f32 [ f32[sel] * row_height ]
        vh     : f32 [ (view_h > 0.0) ? view_h : content_h ]
        if [ item_y < scroll.y ]
            scroll.y = item_y
        el [ item_y + row_height > scroll.y + vh ]
            scroll.y = item_y + row_height - vh

    func select [ idx: i32 ]
        sel = idx
        if [ idx < 0 || idx >= row_count*[] ] return
        scroll_to_sel[]
        activate*[ idx ]
        pristine = false

    func on_press [ ev: Event ]
        ev.stop[]
        rel_y : f32 [ ev.mouse.pos.y - content_y ]
        if [ rel_y < 0.0 ] return
        idx   : i32 [ visible_index[ i32[ rel_y / row_height ], flt[] ] ]
        if [ idx < 0 ] return
        select[ idx ]

    func on_key [ ev: Event ]
        if [ !ev.key.state || row_count*[] == 0 ] return
        key : i32 [ ev.key.unicode ]
        if [ key == 265 ]    # Key.Up
            if [ sel > 0 ]
                sel -= 1
                scroll_to_sel[]
                pristine = false
        el [ key == 264 ]    # Key.Down
            if [ sel < row_count*[] - 1 ]
                sel += 1
                scroll_to_sel[]
                pristine = false
        el [ key == 257 || key == 32 ]    # Key.Enter / Key.Space
            if [ sel >= 0 ]
                select[ sel ]

    func render [] -> Elements
        return null

Layer NodeLayer
    public label_size  : f32
    public row_spacing : f32
    public sel_color   : string
    public sel_radius  : f32
    public text_color  : string

    func draw [ cv: Canvas ]
        nl : NodeList[ parent ]
        if [ !nl ] return
        cv.font_size[ i32[label_size] ]
        lh : f32 [ cv.get_line_height[] * ((row_spacing > 0.0) ? row_spacing : 1.0) ]
        n  : i32 [ nl.row_count*[] ]
        f  : string nl.flt[]
        mc : i32 [ 0 ]
        for [ i: i32 0, i < n, i += 1 ]
            if [ nl.row_match[ i, f ] ] mc += 1
        nl.row_height   = lh
        nl.content_y    = bounds.y
        nl.content_h    = f32[mc] * lh
        nl.view_h       = bounds.h
        nl.scroll_speed = lh
        x0 : f32 [ bounds.x ]
        y0 : f32 [ bounds.y ]
        wtx : f32 [ cv.transform_tx[] ]
        wty : f32 [ cv.transform_ty[] ]
        cv.set_crop[ wtx + bounds.x, wty + bounds.y, wtx + bounds.x + bounds.w, wty + bounds.y + bounds.h ]
        dr : i32 [ 0 ]
        for [ i: i32 0, i < n, i += 1 ]
            if [ !nl.row_match[ i, f ] ] continue
            y : f32 [ y0 + f32[dr] * lh - nl.scroll.y ]
            dr += 1
            if [ y + lh < bounds.y ] continue
            if [ y > bounds.y + bounds.h ] break
            if [ i == nl.sel ]
                r : f32 [ (sel_radius > 0.0) ? sel_radius : 0.0 ]
                cv.save[]
                cv.rounded[ r, r, r, r ]
                cv.fill_color[ (sel_color) ? sel_color : '#fff1' ]
                cv.stroke_width[ 0.0 ]
                cv.rect_to[ x0 + 1.5, y + 0.5, bounds.w - 4.0, lh - 1.0 ]
                cv.paint[]
                cv.restore[]
            cv.fill_color[ (text_color) ? text_color : '#d4d4d4' ]
            cv.draw_text[ nl.row_label*[ i ],
                rect [ x: x0 + 8.0, y: y, w: bounds.w - 16.0, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
        cv.clear_crop[]

class Frame
    public func_name : string
    public file      : path
    public line      : i32

NodeList Callstack
    style : CSS {
        area: l0 t0 r0 b0
        layers.cbase:
            fill_color: #202
            area: l0 t0 r0 b0
        layers.content: NodeLayer
            area: l4px t2px r4px b2px
            label_size: 15
            row_spacing: 1.2
            text_color: #cfe
    }
    public frames : vec Au

    func row_count [] -> i32
        if [ !frames ] return 0
        return frames.count

    func row_label [ i: i32 ] -> string
        if [ !frames || i < 0 || i >= frames.count ] return ''
        f : Frame frames[i]
        fn : string [ (f.file) ? f.file.filename[] : '' ]
        return '{f.func_name}   {fn}:{f.line}'

    func activate [ idx: i32 ]
        return

    func render [] -> Elements
        return null

NodeList Fields
    style : CSS {
        area: l0 t0 r0 b0
        layers.cbase:
            fill_color: #202
            area: l0 t0 r0 b0
        layers.content: FieldsLayer
            area: l4px t2px r4px b2px
            label_size: 15
            row_spacing: 1.2
    }
    public vars : vec Au

    func row_count [] -> i32
        if [ !vars ] return 0
        return vars.count

    func row_label [ i: i32 ] -> string
        if [ !vars || i < 0 || i >= vars.count ] return ''
        v : variable vars[i]
        return '{v.name}  {v.value}'

    func activate [ idx: i32 ]
        return

    func render [] -> Elements
        return null

# ONE column, right of the editor, holding every live instrument. the
# stack at the top selects which one shows; only that one is drawn
Option InstrumentColumn
    # the app publishes on its own clock, so this must repaint on ours.
    # without it the pane only redraws when input dirties it, which is
    # why it appeared to update on clicks and hovers
    animated : true
    style : CSS {
        area: l0 t0 r0 b0
        layers.ibase:
            fill_color: #14121c
            area: l0 t0 r0 b0
    }
    mutable rows     : map Au [string]
    mutable ask_ms   : i64
    # while the split is being dragged the width changes every frame, and
    # each change makes the app rebuild every instrument canvas. sit out
    # the drag: titles only, then come back once the width holds still
    mutable last_w   : f32
    mutable settle   : i64

    func row_h [] -> f32
        return 22.0

    # found at draw time, never passed in: taking it as a prop would make
    # the pane's shape depend on what is read back out of the pane
    func app [] -> AppView
        orb : cast orbiter [ ux.app_object ]
        if [ !orb ] return null
        for [ e: element* a, e, e = e.parent ]
            if [ e inherits EditorView ]
                ev9 : EditorView e
                ed9 : Editor orb.pane_at[ ev9.pane_index ]
                if [ !ed9 || !ed9.run_view ] return null
                return AppView ed9.run_view
        return null

    # the y each instrument's title sits at, so press and draw agree
    func title_y [ av: AppView, ix: i32 ] -> f32
        y9 : f32 [ 0.0 ]
        for [ i: i32 0, i < ix, i += 1 ]
            nm : string av.instr_names[i]
            y9 += row_h[]
            ft : av.instr_front[ nm ]
            if [ ft ] y9 += f32[ ft.height ]
            el      y9 += body_h[ av, nm ]
        return y9

    func body_h [ av: AppView, nm: string ] -> f32
        rw : vec string (rows) ? rows[ nm ] : null
        if [ !rw || rw.count == 0 ] return 0.0
        return f32[ rw.count ] * 16.0 + 4.0

    # a title toggles that one's logging. nothing here turns an
    # instrument off — they are ALL shown, always
    func on_press [ ev: Event ]
        av : app[]
        if [ !av || !av.instr_names ] return
        for [ i: i32 0, i < av.instr_names.count, i += 1 ]
            ty : f32 [ title_y[ av, i ] ]
            if [ ev.mouse.pos.y >= ty && ev.mouse.pos.y < ty + row_h[] ]
                av.instr_toggle[ av.instr_names[i], true ]
                pristine = false
                ev.no_default = true
                return

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        av : app[]
        if [ !bounds || !av || !av.instr_names ] return
        cv : Canvas w.screen
        n  : i32 [ av.instr_names.count ]
        rh : f32 [ row_h[] ]
        cv.stroke_width[ 0.0 ]
        now : i64 [ epoch_millis[] ]
        if [ bounds.w != last_w ]
            last_w = bounds.w
            settle = now
        sizing : bool [ now - settle < 200 ]
        # the entries of every instrument, re-asked twice a second
        if [ !sizing && (ask_ms == 0 || now - ask_ms > 500) ]
            ask_ms = now
            if [ !rows ] rows = map Au [string] []
            for [ i: i32 0, i < n, i += 1 ]
                nk : string av.instr_names[i]
                rows[ nk ] = av.instr_entries[ nk ]
        y9 : f32 [ 0.0 ]
        for [ i: i32 0, i < n, i += 1 ]
            nm : string av.instr_names[i]
            if [ y9 > bounds.h ] break
            # the title: the ONE thing you can click, and it logs
            cv.fill_color[ rgba [ '#2a2340' ] ]
            cv.rect_to[ 0.0, y9, bounds.w, rh - 1.0 ]
            cv.paint[]
            cv.font_size[ 13 ]
            cv.fill_color[ rgba [ '#e8e2f5' ] ]
            cv.draw_text[ nm, rect [ x: 8.0, y: y9, w: bounds.w - 26.0, h: rh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
            if [ av.instr_is_logging[ nm ] ]
                cv.fill_color[ rgba [ '#ff6b6b' ] ]
                cv.rounded_rect[ bounds.w - 15.0, y9 + 8.0, 6.0, 6.0, 3.0, 3.0, 3.0, 3.0 ]
                cv.paint[]
            y9 += rh
            # mid-drag: the title band only. asking for a new width here
            # would rebuild every canvas in the app on every frame
            if [ sizing ] continue
            # we give the width, the app gives the height: its own size
            av.instr_width[ nm, i32[ bounds.w ] ]
            ft : av.instr_front[ nm ]
            if [ ft ]
                th : f32 [ f32[ ft.height ] ]
                if [ y9 + th > bounds.h ] th = bounds.h - y9
                if [ th > 0.0 ]
                    cv.draw_image[ ft, rect [ x: 0.0, y: y9, w: f32[ ft.width ], h: th ] ]
                    y9 += th
                continue
            rw : vec string (rows) ? rows[ nm ] : null
            if [ !rw ] continue
            cv.font_size[ 12 ]
            cv.fill_color[ rgba [ '#cfd6e4' ] ]
            for [ k: i32 0, k < rw.count, k += 1 ]
                if [ y9 > bounds.h - 12.0 ] break
                cv.draw_text[ '{rw[k]}', rect [ x: 8.0, y: y9, w: bounds.w - 12.0, h: 15.0 ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                y9 += 15.0
            y9 += 4.0

NodeList Toolbox
    style : CSS {
        area: l0 t0 r0 b0
        layers.tbase:
            fill_color: #141a24
            area: l0 t0 r0 b0
        layers.content: NodeLayer
            area: l4px t2px r4px b2px
            label_size: 15
            row_spacing: 1.4
            sel_color: #2f6b4a40
            sel_radius: 6.0
            text_color: #cfe
    }
    public items : vec string

    func row_count [] -> i32
        if [ !items ] return 0
        return items.count

    func row_label [ i: i32 ] -> string
        if [ !items || i < 0 || i >= items.count ] return ''
        return items[i]

    func activate [ idx: i32 ]
        return

    func render [] -> Elements
        return null

NodeList Props
    style : CSS {
        area: l0 t0 r0 b0
        layers.pbase:
            fill_color: #1a1420
            area: l0 t0 r0 b0
        layers.content: PropsLayer
            area: l4px t2px r4px b2px
            label_size: 15
            row_spacing: 1.4
            key_color: #d8a8c4
            text_color: #e8cfe0
            line_color: #ffffff18
    }
    public  target : element
    intern  cur    : element
    intern  keys   : vec string
    intern  vals   : vec string

    # members of the inspected element, base class first
    func rebuild []
        cur  = target
        keys = vec string []
        vals = vec string []
        if [ !target ] return
        tys : vec Au_t []
        for [ ty : typeid[ target ], ty != typeid[ Au ], ty = ty.context ]
            tys.push[ ty ]
        for [ ti: i32 tys.count - 1, ti >= 0, ti -= 1 ]
            ty2 : Au_t tys[ti]
            for [ mi: i32 0, mi < ty2.members.count, mi += 1 ]
                mem : Au_t ty2.members.origin[mi]
                if [ mem.member_type != AU_MEMBER_VAR ] continue
                if [ !mem.src ] continue
                keys.push[ string[ mem.ident ] ]
                v : Au target.member_object[ mem ]
                vals.push[ (v) ? '{v}' : '' ]

    func row_count [] -> i32
        if [ target != cur ] rebuild[]
        if [ !keys ] return 0
        return keys.count

    func row_key [ i: i32 ] -> string
        if [ !keys || i < 0 || i >= keys.count ] return ''
        return keys[i]

    func row_val [ i: i32 ] -> string
        if [ !vals || i < 0 || i >= vals.count ] return ''
        return vals[i]

    func row_label [ i: i32 ] -> string
        return '{row_key[ i ]}  {row_val[ i ]}'

    func activate [ idx: i32 ]
        return

    func render [] -> Elements
        return null

Layer PropsLayer
    public label_size  : f32
    public row_spacing : f32
    public key_color   : string
    public text_color  : string
    public line_color  : string

    func draw [ cv: Canvas ]
        pl : Props[ parent ]
        if [ !pl ] return
        cv.font_size[ i32[label_size] ]
        lh : f32 [ cv.get_line_height[] * ((row_spacing > 0.0) ? row_spacing : 1.0) ]
        n  : i32 [ pl.row_count[] ]
        f  : string pl.flt[]
        mc : i32 [ 0 ]
        for [ i: i32 0, i < n, i += 1 ]
            if [ pl.row_match[ i, f ] ] mc += 1
        pl.row_height   = lh
        pl.content_y    = bounds.y
        pl.content_h    = f32[mc] * lh
        pl.view_h       = bounds.h
        pl.scroll_speed = lh
        x0   : f32 [ bounds.x ]
        y0   : f32 [ bounds.y ]
        colx : f32 [ round[ bounds.x + bounds.w * 0.45 ] ]
        lc   : rgba [ (line_color) ? line_color : rgba['#ffffff18'] ]
        wtx  : f32 [ cv.transform_tx[] ]
        wty  : f32 [ cv.transform_ty[] ]
        cv.set_crop[ wtx + bounds.x, wty + bounds.y, wtx + bounds.x + bounds.w, wty + bounds.y + bounds.h ]
        cv.save[]
        cv.plain[]
        cv.hard_edge[]
        cv.stroke_width[ 0.0 ]
        # one column rule, full height, exactly 1px
        cv.fill_color[ lc ]
        cv.rect_to[ colx, bounds.y, 1.0, bounds.h ]
        cv.paint[ ]
        dr : i32 [ 0 ]
        for [ i: i32 0, i < n, i += 1 ]
            if [ !pl.row_match[ i, f ] ] continue
            y : f32 [ round[ y0 + f32[dr] * lh - pl.scroll.y ] ]
            dr += 1
            if [ y + lh < bounds.y ] continue
            if [ y > bounds.y + bounds.h ] break
            if [ i == pl.sel ]
                cv.fill_color[ rgba['#8c4a6440'] ]
                cv.rect_to[ x0, y, bounds.w, lh ]
                cv.paint[ ]
            cv.fill_color[ lc ]
            cv.rect_to[ x0, y + lh - 1.0, bounds.w, 1.0 ]
            cv.paint[ ]
            cv.fill_color[ (key_color) ? key_color : '#d8a8c4' ]
            cv.draw_text[ pl.row_key[ i ],
                rect [ x: x0 + 6.0, y: y, w: colx - x0 - 10.0, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
            cv.fill_color[ (text_color) ? text_color : '#e8cfe0' ]
            cv.draw_text[ pl.row_val[ i ],
                rect [ x: colx + 6.0, y: y, w: bounds.x + bounds.w - colx - 10.0, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
        cv.restore[]
        cv.clear_crop[]

Layer FieldsLayer
    public label_size  : f32
    public row_spacing : f32
    public key_color   : string
    public text_color  : string
    public line_color  : string

    func draw [ cv: Canvas ]
        fl : Fields[ parent ]
        if [ !fl ] return
        cv.font_size[ i32[label_size] ]
        lh : f32 [ cv.get_line_height[] * ((row_spacing > 0.0) ? row_spacing : 1.0) ]
        n  : i32 [ fl.row_count[] ]
        fl.row_height   = lh
        fl.content_y    = bounds.y
        fl.content_h    = f32[n] * lh
        fl.view_h       = bounds.h
        fl.scroll_speed = lh
        x0   : f32 [ bounds.x ]
        y0   : f32 [ bounds.y ]
        colx : f32 [ bounds.x + bounds.w * 0.42 ]
        lc   : rgba [ (line_color) ? line_color : rgba['#ffffff18'] ]
        wtx  : f32 [ cv.transform_tx[] ]
        wty  : f32 [ cv.transform_ty[] ]
        cv.set_crop[ wtx + bounds.x, wty + bounds.y, wtx + bounds.x + bounds.w, wty + bounds.y + bounds.h ]
        cv.stroke_width[ 0.0 ]
        for [ i: i32 0, i < n, i += 1 ]
            y : f32 [ y0 + f32[i] * lh - fl.scroll.y ]
            if [ y + lh < bounds.y ] continue
            if [ y > bounds.y + bounds.h ] break
            v : variable fl.vars[i]
            if [ i == fl.sel ]
                cv.fill_color[ rgba['#264f7866'] ]
                cv.rect_to[ x0, y, bounds.w, lh ]
                cv.paint[ ]
            # per-row separator line (bottom edge)
            cv.fill_color[ lc ]
            cv.rect_to[ x0, y + lh - 1.0, bounds.w, 1.0 ]
            cv.paint[ ]
            # key (name) in the left column
            cv.fill_color[ (key_color) ? key_color : '#9fb6d8' ]
            cv.draw_text[ (v) ? v.name : '',
                rect [ x: x0 + 8.0, y: y, w: colx - x0 - 12.0, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
            # value in the right column
            cv.fill_color[ (text_color) ? text_color : '#cfe6ff' ]
            cv.draw_text[ (v) ? v.value : '',
                rect [ x: colx + 8.0, y: y, w: bounds.x + bounds.w - colx - 12.0, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
        cv.clear_crop[]
