extend orbiter

Option NodeList
    mutable sel        : i32 [ -1 ]
    mutable row_height : f32 [ 20.0 ]
    mutable content_y  : f32 [ 0.0 ]
    mutable view_h     : f32 [ 0.0 ]

    # ---- subclass hooks (overridden) ----
    func row_count [] -> i32
        return 0
    func row_label [ i: i32 ] -> string
        return ''
    # two-column rows: left/right cells drawn at a fixed gutter so they
    # align down the list (empty left = single-label row_label mode)
    func row_col0 [ i: i32 ] -> string
        return ''
    func row_col1 [ i: i32 ] -> string
        return ''
    func activate [ idx: i32 ]
        return

    func flt [] -> string
        if [ !elements ] return null
        t : element elements[ 'list_filter' ]
        if [ !t ] return null
        return t.edit

    func row_match [ i: i32, f: string ] -> bool
        if [ !f || f.count == 0 ] return true
        return row_label*[ i ].index_of[ f ] >= 0

    func visible_index [ vrow: i32, f: string ] -> i32
        seen : i32 [ 0 ]
        for [ i: i32 0, i < row_count*[], i += 1 ]
            if [ row_match[ i, f ] ]
                if [ seen == vrow ] return i
                seen += 1
        return -1

    # ---- shared behavior ----
    func scroll_to_sel []
        if [ sel < 0 || row_count*[] == 0 ] return
        item_y : f32 [ f32[sel] * row_height ]
        vh     : f32 [ (view_h > 0.0) ? view_h : content_h ]
        if [ item_y < scroll.y ]
            scroll.y = item_y
        el [ item_y + row_height > scroll.y + vh ]
            scroll.y = item_y + row_height - vh

    func select [ idx: i32 ]
        sel = idx
        if [ idx < 0 || idx >= row_count*[] ] return
        scroll_to_sel[]
        activate*[ idx ]
        pristine = false

    func on_press [ ev: Event ]
        ev.stop[]
        rel_y : f32 [ ev.mouse.pos.y - content_y ]
        if [ rel_y < 0.0 ] return
        idx   : i32 [ visible_index[ i32[ rel_y / row_height ], flt[] ] ]
        if [ idx < 0 ] return
        select[ idx ]

    func on_key [ ev: Event ]
        if [ !ev.key.state || row_count*[] == 0 ] return
        key : i32 [ ev.key.unicode ]
        if [ key == 265 ]    # Key.Up
            if [ sel > 0 ]
                sel -= 1
                scroll_to_sel[]
                pristine = false
        el [ key == 264 ]    # Key.Down
            if [ sel < row_count*[] - 1 ]
                sel += 1
                scroll_to_sel[]
                pristine = false
        el [ key == 257 || key == 32 ]    # Key.Enter / Key.Space
            if [ sel >= 0 ]
                select[ sel ]

    func render [] -> Elements
        return null

Layer NodeLayer
    public label_size  : f32
    public row_spacing : f32
    public sel_color   : string
    public sel_radius  : f32
    public text_color  : string
    # left-column width in px; >0 switches rows to two aligned columns
    public col_w       : f32

    func draw [ cv: Canvas ]
        nl : NodeList[ parent ]
        if [ !nl ] return
        cv.font_size[ i32[label_size] ]
        lh : f32 [ cv.get_line_height[] * ((row_spacing > 0.0) ? row_spacing : 1.0) ]
        n  : i32 [ nl.row_count*[] ]
        f  : string nl.flt[]
        mc : i32 [ 0 ]
        for [ i: i32 0, i < n, i += 1 ]
            if [ nl.row_match[ i, f ] ] mc += 1
        nl.row_height   = lh
        nl.content_y    = bounds.y
        nl.content_h    = f32[mc] * lh
        nl.view_h       = bounds.h
        nl.scroll_speed = lh
        x0 : f32 [ bounds.x ]
        y0 : f32 [ bounds.y ]
        wtx : f32 [ cv.transform_tx[] ]
        wty : f32 [ cv.transform_ty[] ]
        cv.set_crop[ wtx + bounds.x, wty + bounds.y, wtx + bounds.x + bounds.w, wty + bounds.y + bounds.h ]
        dr : i32 [ 0 ]
        for [ i: i32 0, i < n, i += 1 ]
            if [ !nl.row_match[ i, f ] ] continue
            y : f32 [ y0 + f32[dr] * lh - nl.scroll.y ]
            dr += 1
            if [ y + lh < bounds.y ] continue
            if [ y > bounds.y + bounds.h ] break
            if [ i == nl.sel ]
                r : f32 [ (sel_radius > 0.0) ? sel_radius : 0.0 ]
                cv.save[]
                cv.rounded[ r, r, r, r ]
                cv.fill_color[ (sel_color) ? sel_color : '#fff1' ]
                cv.stroke_width[ 0.0 ]
                cv.rect_to[ x0 + 1.5, y + 0.5, bounds.w - 4.0, lh - 1.0 ]
                cv.paint[]
                cv.restore[]
            cv.fill_color[ (text_color) ? text_color : '#d4d4d4' ]
            if [ col_w > 0.0 ]
                # left column, a thin divider, then the right column — the
                # gutter is fixed so every row lines up
                cv.draw_text[ nl.row_col0*[ i ],
                    rect [ x: x0 + 8.0, y: y, w: col_w - 6.0, h: lh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.ellipsis, null ]
                dx : f32 [ x0 + 8.0 + col_w ]
                cv.fill_color[ (text_color) ? text_color : '#d4d4d4' ]
                cv.draw_text[ nl.row_col1*[ i ],
                    rect [ x: dx + 10.0, y: y, w: bounds.w - (col_w + 26.0), h: lh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.ellipsis, null ]
            el
                cv.draw_text[ nl.row_label*[ i ],
                    rect [ x: x0 + 8.0, y: y, w: bounds.w - 16.0, h: lh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
        # one solid divider down the whole column, not a dash per row
        if [ col_w > 0.0 ]
            cv.fill_color[ '#ffffff26' ]
            cv.stroke_width[ 0.0 ]
            cv.rect_to[ x0 + 8.0 + col_w, bounds.y, 1.0, bounds.h ]
            cv.paint[]
        cv.clear_crop[]

class Frame
    public func_name : string
    public file      : path
    public line      : i32

NodeList Callstack
    style : CSS {
        area: l0 t0 r0 b0
        layers.cbase:
            fill_color: #202
            area: l0 t0 r0 b0
        layers.content: NodeLayer
            area: l4px t2px r4px b2px
            label_size: 15
            row_spacing: 1.2
            text_color: #cfe
            col_w: 100
    }
    public frames : vec Au

    func row_count [] -> i32
        if [ !frames ] return 0
        return frames.count

    func fr [ i: i32 ] -> Frame
        if [ !frames || i < 0 || i >= frames.count ] return null
        return Frame frames[i]

    # left column: filename:line. right column: function name (reversed
    # from the usual, per the design)
    func row_col0 [ i: i32 ] -> string
        f : Frame fr[ i ]
        if [ !f ] return ''
        # no line info (a release build, or system code): say so, not -1
        if [ f.line <= 0 || !f.file ] return '??'
        fn : f.file.filename[]
        return '{fn}:{f.line}'

    func row_col1 [ i: i32 ] -> string
        f : Frame fr[ i ]
        return (f) ? f.func_name : ''

    # kept for the filter (row_match searches this)
    func row_label [ i: i32 ] -> string
        f : Frame fr[ i ]
        if [ !f ] return ''
        fn : string [ (f.file) ? f.file.filename[] : '' ]
        return '{fn}:{f.line} {f.func_name}'

    func activate [ idx: i32 ]
        return

    func render [] -> Elements
        return null

NodeList Fields
    style : CSS {
        area: l0 t0 r0 b0
        layers.cbase:
            fill_color: #202
            area: l0 t0 r0 b0
        layers.content: FieldsLayer
            area: l4px t2px r4px b2px
            label_size: 15
            row_spacing: 1.2
    }
    public vars : vec Au

    func row_count [] -> i32
        if [ !vars ] return 0
        return vars.count

    func row_label [ i: i32 ] -> string
        if [ !vars || i < 0 || i >= vars.count ] return ''
        v : variable vars[i]
        return '{v.name}  {v.value}'

    func activate [ idx: i32 ]
        return

    func render [] -> Elements
        return null

# ONE column, right of the editor, holding every live instrument. the
# stack at the top selects which one shows; only that one is drawn
Option InstancePanel
    # the app publishes on its own clock, so this must repaint on ours.
    # without it the pane only redraws when input dirties it, which is
    # why it appeared to update on clicks and hovers
    animated : true
    style : CSS {
        area: l0 t0 r0 b0
        layers.ibase:
            fill_color: #14121c
            area: l0 t0 r0 b0
    }
    mutable rows     : map Au [string]
    mutable ask_ms   : i64
    # while the split is being dragged the width changes every frame, and
    # each change makes the app rebuild every instrument canvas. sit out
    # the drag: titles only, then come back once the width holds still
    mutable last_w   : f32
    mutable settle   : i64
    mutable chip_x   : f32
    mutable chip_y   : f32
    mutable chip_wd  : f32
    mutable icons    : map SVGModel [string]
    mutable pip_drag : bool          # a press went to the pip: moves and the release follow it

    func icon [ nm: string ] -> SVGModel
        if [ !icons ] icons = map SVGModel [string] []
        if [ icons.contains[ nm ] ] return icons[ nm ]
        m : SVGModel [ path 'images/{nm}.svg' ]
        icons[ nm ] = m
        return m

    # the selected instance's group: at a debugger stop continue and the steps.
    # closing is uncommon: shift shows an [x] on every row instead
    func action_chips [ av: AppView ] -> vec string
        b : vec string [] [ 'pip', 'pause', 'continue', 'step_next', 'step_in', 'step_out' ]
        return b

    # always the same six: pip and pause on a running instance, the four
    # steps only at a debugger stop
    func action_disabled [ av: AppView ] -> i32
        m : i32 [ 0 ]
        if [ av.ended || av.held ] m = m | 3
        if [ !(av.debugger && av.debugger.active && !av.debugger.running) ] m = m | 60
        return m

    func sel_index [] -> i32
        li  : vec AppView inst_list[]
        ed9 : Editor editor[]
        if [ !li || !ed9 || !ed9.run_view ] return -1
        for [ i: i32 0, i < li.count, i += 1 ]
            if [ li[ i ] == ed9.run_view ] return i
        return -1

    func row_h [] -> f32
        return 26.0

    # found at draw time, never passed in: taking it as a prop would make
    # the pane's shape depend on what is read back out of the pane
    func app [] -> AppView
        orb : cast orbiter [ ux.app_object ]
        if [ !orb ] return null
        for [ e: element* a, e, e = e.parent ]
            if [ e inherits EditorView ]
                ev9 : EditorView e
                ed9 : Editor orb.pane_at[ ev9.pane_index ]
                if [ !ed9 || !ed9.run_view ] return null
                return AppView ed9.run_view
        return null

    func view [] -> EditorView
        for [ e: element* a, e, e = e.parent ]
            if [ e inherits EditorView ] return EditorView e
        return null

    func editor [] -> Editor
        orb : cast orbiter [ ux.app_object ]
        ev9 : EditorView view[]
        return (orb && ev9) ? orb.pane_at[ ev9.pane_index ] : null

    func inst_list [] -> vec AppView
        ed9 : Editor editor[]
        return (ed9) ? ed9.instances[] : null

    func inst_px [] -> f32
        li : vec AppView inst_list[]
        return f32[ (li) ? li.count : 0 ] * row_h[]

    # the selected instance's group sits at the panel's bottom
    func foot_px [] -> f32
        s : i32 [ sel_index[] ]
        if [ s < 0 ] return 0.0
        li : vec AppView inst_list[]
        ac : vec string action_chips[ li[ s ] ]
        return (ac.count > 0) ? row_h[] + 8.0 : 0.0


    # the selected instance while it is in pip: the one pip the panel holds
    func pip_av [] -> AppView
        ed9 : Editor editor[]
        if [ !ed9 || !ed9.run_view ] return null
        av : AppView ed9.run_view
        return (av.pip && av.have_frame && av.ah > 0 && av.aw > 0) ? av : null

    func pip_px [] -> f32
        av : AppView pip_av[]
        if [ !av || !bounds ] return 0.0
        h : f32 [ bounds.w * f32[ av.ah ] / f32[ av.aw ] ]
        if [ h > 260.0 ] h = 260.0
        return h

    func head_px [] -> f32
        return inst_px[] + pip_px[]

    # the frames of the selected instance at a stop, none otherwise
    func stack_rows [] -> i32
        orb : cast orbiter [ ux.app_object ]
        av  : AppView app[]
        dv  : dbg (av) ? av.debugger : null
        if [ !orb || !dv || !dv.active || dv.running ] return 0
        fr : vec Au orb.debug_frames[]
        if [ !fr || fr.count == 0 ] return 0
        return (fr.count < 8) ? fr.count : 8

    # the accordion: properties, instruments, callstack. one is open and
    # fills; the others are headers, above it from the top, below it from
    # the bottom
    func open_ix [] -> i32
        orb : cast orbiter [ ux.app_object ]
        if [ !orb ] return -1
        if [ orb.props_open ] return 0
        if [ orb.instr_open ] return 1
        if [ orb.stack_open ] return 2
        return -1

    # the first render comes before any layout: no bounds yet
    func panel_h [] -> f32
        return (bounds) ? bounds.h : 0.0

    func sect_y [ i: i32 ] -> f32
        k : i32 [ open_ix[] ]
        if [ k < 0 || i <= k ] return head_px[] + f32[ i ] * row_h[]
        return panel_h[] - foot_px[] - f32[ 3 - i ] * row_h[]

    # where the open section's content ends: the folded headers under it
    func sect_bottom [] -> f32
        k : i32 [ open_ix[] ]
        if [ k < 0 ] return panel_h[] - foot_px[]
        return panel_h[] - foot_px[] - f32[ 2 - k ] * row_h[]

    # a click on a header opens that section, closing the others; on the
    # open one it folds, leaving none
    func sect_toggle [ i: i32 ]
        orb : cast orbiter [ ux.app_object ]
        if [ !orb ] return
        was : bool [ open_ix[] == i ]
        orb.props_open = !was && i == 0
        orb.instr_open = !was && i == 1
        orb.stack_open = !was && i == 2

    # a section header: a fold marker at the left when asked, the name beside it
    func section_title [ cv: Canvas, y: f32, text: string, open: bool, marker: bool ]
        rh : f32 [ row_h[] ]
        cv.save[]
        cv.fill_color[ (open) ? rgba [ '#312' ] : rgba [ '#212' ] ]
        # the open one glows from its edges, a touch brighter on red and blue
        if [ open ] cv.inner_glow[ rgba [ '#615' ], 10.0 ]
        cv.rect_to[ 0.0, y, bounds.w, rh - 1.0 ]
        cv.paint[]
        cv.restore[]
        # the names line up whether or not a marker sits before them
        tx : f32 [ 22.0 ]
        if [ marker ]
            cv.fill_color[ rgba [ '#9a93b3' ] ]
            if [ open ]
                cv.move_to[ 8.0, y + 10.0 ]
                cv.line_to[ 16.0, y + 10.0 ]
                cv.line_to[ 12.0, y + 16.0 ]
            el
                cv.move_to[ 9.0, y + 8.0 ]
                cv.line_to[ 15.0, y + 13.0 ]
                cv.line_to[ 9.0, y + 18.0 ]
            cv.close_path[]
            cv.paint[]
        cv.font_size[ 13 ]
        cv.fill_color[ rgba [ '#e8e2f5' ] ]
        cv.draw_text[ text, rect [ x: tx, y: y, w: bounds.w - tx - 8.0, h: rh ],
            vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]

    func render [] -> Elements
        ev9 : EditorView view[]
        orb : cast orbiter [ ux.app_object ]
        if [ !ev9 || !orb ] return null
        t  : Elements []
        # the running instance's own props; else what the module answered last; else its export
        av9 : AppView app[]
        lv9 : bool [ (av9 && av9.props && av9.props.count > 0) ? true : false ]
        sp9 : string (lv9) ? av9.props : orb.module_spec[ ev9.band_mod[] ]
        if [ !sp9 || sp9.count == 0 ] sp9 = ev9.launch_spec[]
        # the open section runs from under its header to the folded headers below
        fp : f32 [ foot_px[] ]
        sb9 : f32 [ panel_h[] - sect_bottom[] ]
        # the selected instance edits ITS args; with none selected there is no list
        if [ av9 && orb.props_open ]
            ar9 : string (av9.module_args) ? av9.module_args : ''
            py9 : f32 [ sect_y[ 0 ] + row_h[] ]
            # one canvas for the whole list: its controls paint straight onto this panel
            t['launch_panel'] = LaunchPanel [ spec: sp9, args: ar9, inst: av9.iid, live_vals: lv9, no_cache: true,
                area: Region [ 'l0 t{py9}px r0 b{sb9}px' ] ]
        if [ av9 && orb.stack_open && stack_rows[] > 0 ]
            cy9 : f32 [ sect_y[ 2 ] + row_h[] ]
            t['callstack'] = Callstack [ frames: orb.debug_frames[], area: Region [ 'l0 t{cy9}px r0 b{sb9}px' ] ]
        # the selected instance's group: square segments edge to edge at the bottom
        if [ fp > 0.0 ]
            li : vec AppView inst_list[]
            sv9 : AppView li[ sel_index[] ]
            ac : vec string action_chips[ sv9 ]
            ed9 : Editor editor[]
            # pip is the one toggle in the group: lit while the app sits in the pip
            sm : i32 [ ((ed9 && !ed9.app_view) ? 1 : 0) | ((sv9.paused) ? 2 : 0) ]
            t['steps'] = TButtons [ buttons: ac, manual: true, seg_radius: 0.0, sel_mask: sm,
                disable_mask: action_disabled[ sv9 ],
                area: Region [ 'l0 b{fp}px r0 h{fp}px' ] ]
        return t

    func inst_color [ av: AppView ] -> rgba
        if [ av.held ]   return rgba [ '#8f89a3' ]
        if [ av.ended ]  return rgba [ '#ef5350' ]
        if [ av.paused ] return rgba [ '#ffb74d' ]
        return rgba [ '#66bb6a' ]

    func chip_w [ nm: string ] -> f32
        return 7.0 * f32[ nm.count ] + 16.0

    # chip ix in ONE flow that wraps at the panel width; lands in chip_x/chip_y/chip_wd,
    # measured from the top of the chip band, so press and draw agree
    # rows break at the width; every row that breaks is stretched to fill it,
    # the slack shared evenly across its cells
    func chip_pos [ names: vec string, ix: i32 ] -> bool
        if [ ix < 0 || ix >= names.count ] return false
        y  : f32 [ 0.0 ]
        r0 : i32 [ 0 ]
        while [ r0 < names.count ]
            # the cells of this row, by their natural widths
            r1  : i32 [ r0 ]
            sum : f32 [ 0.0 ]
            while [ r1 < names.count ]
                w : f32 [ chip_w[ names[ r1 ] ] ]
                if [ r1 > r0 && sum + w > bounds.w ] break
                sum += w
                r1 += 1
            n9    : i32 [ r1 - r0 ]
            extra : f32 [ (bounds.w > sum) ? (bounds.w - sum) / f32[ n9 ] : 0.0 ]
            if [ ix < r1 ]
                x : f32 [ 0.0 ]
                for [ i: i32 r0, i < ix, i += 1 ]
                    x += chip_w[ names[ i ] ] + extra
                chip_x  = round[ x ]
                chip_y  = y
                chip_wd = round[ x + chip_w[ names[ ix ] ] + extra ] - round[ x ]
                return true
            y += row_h[]
            r0 = r1
        return false

    func chips_h [ names: vec string ] -> f32
        if [ !names || names.count == 0 ] return 0.0
        if [ !chip_pos[ names, names.count - 1 ] ] return 0.0
        return chip_y + row_h[]

    # one flow of chips at y: draws them, or with the press point given, returns the hit
    func chip_row [ cv: Canvas, names: vec string, y: f32, lit: string, px: f32, py: f32 ] -> i32
        for [ i: i32 0, i < names.count, i += 1 ]
            nm : string names[ i ]
            if [ !chip_pos[ names, i ] ] continue
            cy : f32 [ y + chip_y ]
            rh : f32 [ row_h[] ]
            if [ !cv ]
                if [ px >= chip_x && px < chip_x + chip_wd && py >= cy && py < cy + rh ] return i
                continue
            # a pixel grid like the other controls: flat cells, 1px rules, no rounding
            on9 : bool [ lit && lit.compare[ nm ] == 0 ]
            cv.stroke_width[ 0.0 ]
            cv.fill_color[ (on9) ? rgba [ '#6cb6ff' ] : rgba [ '#2a2340' ] ]
            cv.rect_to[ chip_x, cy, chip_wd, rh ]
            cv.paint[]
            cv.fill_color[ rgba [ '#ffffff1a' ] ]
            cv.rect_to[ chip_x + chip_wd - 1.0, cy, 1.0, rh ]
            cv.paint[]
            cv.rect_to[ chip_x, cy + rh - 1.0, chip_wd, 1.0 ]
            cv.paint[]
            cv.font_size[ 12 ]
            cv.fill_color[ (on9) ? rgba [ '#0f1220' ] : rgba [ '#e8e2f5' ] ]
            cv.draw_text[ nm, rect [ x: chip_x, y: cy, w: chip_wd, h: rh ],
                vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
        return -1

    # a title toggles that one's logging. nothing here turns an
    # the pip's app sees the mouse move over it and every drag to its release
    func on_move [ ev: Event ]
        pv : AppView pip_av[]
        if [ !pv ] return
        if [ pip_drag || ev.mouse.pos.y < head_px[] ]
            pv.vsx = 0.0
            pv.vsy = 0.0
            pv.view_move[ ev ]

    func on_release [ ev: Event ]
        if [ !pip_drag ] return
        pip_drag = false
        pv : AppView pip_av[]
        if [ pv ]
            pv.vsx = 0.0
            pv.vsy = 0.0
            pv.view_release[ ev ]

    # instrument off — they are ALL shown, always
    func on_press [ ev: Event ]
        li : vec AppView inst_list[]
        if [ ev.mouse.pos.y < inst_px[] ]
            rh  : f32 [ row_h[] ]
            ed9 : Editor editor[]
            orb : cast orbiter [ ux.app_object ]
            ev9 : EditorView view[]
            my  : f32 [ ev.mouse.pos.y ]
            if [ ed9 && orb && ev9 ]
                if [ li ]
                    y8 : f32 [ 0.0 ]
                    for [ i: i32 0, i < li.count, i += 1 ]
                        av9 : AppView li[ i ]
                        if [ my >= y8 && my < y8 + rh ]
                            if [ ev.mouse.pos.x < 24.0 ]
                                if [ ev.key.shift ] ed9.close_instance[ i ]
                                el orb.instance_action[ ed9, av9, (av9.ended || av9.held) ? 'play' : 'stop' ]
                            el [ i == sel_index[] ]
                                # the selected one again: unselect, the pane goes back to its file
                                ed9.run_view = null
                                ed9.app_view = false
                                ed9.load_file[]
                            el orb.show_instance[ av9.iid, ev9.pane_index ]
                            break
                        y8 += rh
            pristine = false
            ev.no_default = true
            if [ ux ] ux.restyle = true
            return
        # the pip is the app: its presses go to the instance, as in the editor
        pv : AppView pip_av[]
        if [ pv && ev.mouse.pos.y < head_px[] ]
            pv.vsx = 0.0
            pv.vsy = 0.0
            if [ pv.view_press[ ev ] ]
                pip_drag = true
                if [ ux ] ux.set_capture[ a ]
            pristine = false
            ev.no_default = true
            if [ ux ] ux.restyle = true
            return
        av : app[]
        if [ !av ] return
        # the three headers of the accordion
        orb7 : cast orbiter [ ux.app_object ]
        my7  : f32 [ ev.mouse.pos.y ]
        for [ si7: i32 0, si7 < 3, si7 += 1 ]
            hy7 : f32 [ sect_y[ si7 ] ]
            if [ my7 >= hy7 && my7 < hy7 + row_h[] ]
                sect_toggle[ si7 ]
                pristine = false
                ev.no_default = true
                if [ ux ] ux.restyle = true
                return
        if [ !av.instr_names || (orb7 && !orb7.instr_open) ] return
        top : f32 [ sect_y[ 1 ] + row_h[] ]
        for [ i: i32 0, i < av.instr_names.count, i += 1 ]
            if [ !chip_pos[ av.instr_names, i ] ] continue
            cy : f32 [ top + chip_y ]
            if [ ev.mouse.pos.x >= chip_x && ev.mouse.pos.x < chip_x + chip_wd &&
                 ev.mouse.pos.y >= cy && ev.mouse.pos.y < cy + row_h[] ]
                av.instr_select[ av.instr_names[ i ] ]
                pristine = false
                ev.no_default = true
                return

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        cv : Canvas w.screen
        rh : f32 [ row_h[] ]
        cv.stroke_width[ 0.0 ]
        li  : vec AppView inst_list[]
        ed9 : Editor editor[]
        orb : cast orbiter [ ux.app_object ]
        # the rows begin at the top: adding an instance is the tab bar's button
        if [ li && orb ]
            y8 : f32 [ 0.0 ]
            for [ i: i32 0, i < li.count, i += 1 ]
                av9 : AppView li[ i ]
                sel9 : bool [ ed9 && ed9.run_view == av9 ]
                # the selected row glows blue from its edges inward
                cv.save[]
                cv.fill_color[ (sel9) ? rgba [ '#2a2340' ] : rgba [ '#1a1726' ] ]
                if [ sel9 ] cv.inner_glow[ rgba [ '#4f9cffaa' ], 12.0 ]
                cv.rect_to[ 0.0, y8, bounds.w, rh - 1.0 ]
                cv.paint[]
                cv.restore[]
                # the one icon on the row: the state's color, and it IS the pause/resume
                # toggle. shift held turns it into the [x] that closes the instance
                sh9 : bool [ orb.shift_down ]
                # the row's one icon starts or stops the instance; pause lives in the step group
                ic9 : SVGModel icon[ (sh9) ? 'close' : ((av9.ended || av9.held) ? 'play' : 'stop') ]
                if [ ic9 ]
                    cv.fill_color[ (sh9) ? rgba [ '#ef5350' ] : inst_color[ av9 ] ]
                    cv.stroke_color[ (sh9) ? rgba [ '#ef5350' ] : inst_color[ av9 ] ]
                    cv.draw_svg[ ic9, 6.0, y8 + 6.0, 14.0, 14.0 ]
                # the name at the left; the status right-aligned and padded, running carries the pid
                nm9 : string orb.instance_name[ av9 ]
                sw9 : string av9.status_word[]
                if [ !sw9 || sw9.count == 0 ]
                    pid9 : i32 [ (av9.slot >= 0 && !av9.ended) ? host_app_pid[ av9.slot ] : 0 ]
                    sw9 = (av9.ended) ? 'stopped' : ((pid9 > 0) ? 'running ({pid9})' : 'running')
                cv.font_size[ 13 ]
                cv.fill_color[ rgba [ '#e8e2f5' ] ]
                cv.draw_text[ nm9, rect [ x: 24.0, y: y8, w: bounds.w - 100.0, h: rh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                cv.fill_color[ inst_color[ av9 ] ]
                cv.draw_text[ sw9, rect [ x: 24.0, y: y8, w: bounds.w - 34.0, h: rh ],
                    vec2f [ 1.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                y8 += rh
        pv : AppView pip_av[]
        if [ pv ]
            ph : f32 [ pip_px[] ]
            pw : f32 [ ph * f32[ pv.aw ] / f32[ pv.ah ] ]
            if [ pw > bounds.w ] pw = bounds.w
            # the pip rect is in this panel's own coordinates: no scroll offset
            pv.vsx = 0.0
            pv.vsy = 0.0
            pv.draw_pip_in[ cv, rect [ x: round[ (bounds.w - pw) * 0.5 ], y: inst_px[], w: pw, h: ph ] ]
        av : app[]
        if [ !av || !orb ] return
        # the accordion's three headers; the chips once the app answers
        nm9 : string orb.instance_name[ av ]
        section_title[ cv, sect_y[ 0 ], '{nm9} properties',  orb.props_open, false ]
        section_title[ cv, sect_y[ 1 ], '{nm9} instruments', orb.instr_open, false ]
        section_title[ cv, sect_y[ 2 ], '{nm9} callstack',   orb.stack_open, false ]
        if [ !orb.instr_open || !av.instr_names ] return
        n  : i32 [ av.instr_names.count ]
        now : i64 [ epoch_millis[] ]
        if [ bounds.w != last_w ]
            last_w = bounds.w
            settle = now
        sizing : bool [ now - settle < 200 ]
        # one flow of chips; the lit one is the single instrument on: it logs and shows
        top : f32 [ sect_y[ 1 ] + row_h[] ]
        act : string av.instr_active[]
        chip_row[ cv, av.instr_names, top, act, 0.0, 0.0 ]
        if [ !act ] return
        y9 : f32 [ top + chips_h[ av.instr_names ] ]
        # the entries of the one instrument on, re-asked twice a second
        if [ !sizing && (ask_ms == 0 || now - ask_ms > 500) ]
            ask_ms = now
            if [ !rows ] rows = map Au [string] []
            rows[ act ] = av.instr_entries[ act ]
        # mid-drag: chips only. asking for a new width here would rebuild
        # the canvas in the app on every frame
        if [ sizing ] return
        # we give the width, the app gives the height: its own size
        av.instr_width[ act, i32[ bounds.w ] ]
        ft : av.instr_front[ act ]
        if [ ft ]
            th : f32 [ f32[ ft.height ] ]
            if [ y9 + th > sect_bottom[] ] th = sect_bottom[] - y9
            if [ th > 0.0 ] cv.draw_image[ ft, rect [ x: 0.0, y: y9, w: f32[ ft.width ], h: th ] ]
            return
        rw : vec string (rows && rows.contains[ act ]) ? rows[ act ] : null
        if [ !rw ] return
        cv.font_size[ 12 ]
        cv.fill_color[ rgba [ '#cfd6e4' ] ]
        for [ k: i32 0, k < rw.count, k += 1 ]
            if [ y9 > sect_bottom[] - 12.0 ] break
            cv.draw_text[ '{rw[k]}', rect [ x: 8.0, y: y9, w: bounds.w - 12.0, h: 15.0 ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
            y9 += 15.0

NodeList Toolbox
    style : CSS {
        area: l0 t0 r0 b0
        layers.tbase:
            fill_color: #141a24
            area: l0 t0 r0 b0
        layers.content: NodeLayer
            area: l4px t2px r4px b2px
            label_size: 15
            row_spacing: 1.4
            sel_color: #2f6b4a40
            sel_radius: 6.0
            text_color: #cfe
    }
    public items : vec string

    func row_count [] -> i32
        if [ !items ] return 0
        return items.count

    func row_label [ i: i32 ] -> string
        if [ !items || i < 0 || i >= items.count ] return ''
        return items[i]

    func activate [ idx: i32 ]
        return

    func render [] -> Elements
        return null

NodeList Props
    style : CSS {
        area: l0 t0 r0 b0
        layers.pbase:
            fill_color: #1a1420
            area: l0 t0 r0 b0
        layers.content: PropsLayer
            area: l4px t2px r4px b2px
            label_size: 15
            row_spacing: 1.4
            key_color: #d8a8c4
            text_color: #e8cfe0
            line_color: #ffffff18
    }
    public  target : element
    intern  cur    : element
    intern  keys   : vec string
    intern  vals   : vec string

    # members of the inspected element, base class first
    func rebuild []
        cur  = target
        keys = vec string []
        vals = vec string []
        if [ !target ] return
        tys : vec Au_t []
        for [ ty : typeid[ target ], ty != typeid[ Au ], ty = ty.context ]
            tys.push[ ty ]
        for [ ti: i32 tys.count - 1, ti >= 0, ti -= 1 ]
            ty2 : Au_t tys[ti]
            for [ mi: i32 0, mi < ty2.members.count, mi += 1 ]
                mem : Au_t ty2.members.origin[mi]
                if [ mem.member_type != AU_MEMBER_VAR ] continue
                if [ !mem.src ] continue
                keys.push[ string[ mem.ident ] ]
                v : Au target.member_object[ mem ]
                vals.push[ (v) ? '{v}' : '' ]

    func row_count [] -> i32
        if [ target != cur ] rebuild[]
        if [ !keys ] return 0
        return keys.count

    func row_key [ i: i32 ] -> string
        if [ !keys || i < 0 || i >= keys.count ] return ''
        return keys[i]

    func row_val [ i: i32 ] -> string
        if [ !vals || i < 0 || i >= vals.count ] return ''
        return vals[i]

    func row_label [ i: i32 ] -> string
        return '{row_key[ i ]}  {row_val[ i ]}'

    func activate [ idx: i32 ]
        return

    func render [] -> Elements
        return null

Layer PropsLayer
    public label_size  : f32
    public row_spacing : f32
    public key_color   : string
    public text_color  : string
    public line_color  : string

    func draw [ cv: Canvas ]
        pl : Props[ parent ]
        if [ !pl ] return
        cv.font_size[ i32[label_size] ]
        lh : f32 [ cv.get_line_height[] * ((row_spacing > 0.0) ? row_spacing : 1.0) ]
        n  : i32 [ pl.row_count[] ]
        f  : string pl.flt[]
        mc : i32 [ 0 ]
        for [ i: i32 0, i < n, i += 1 ]
            if [ pl.row_match[ i, f ] ] mc += 1
        pl.row_height   = lh
        pl.content_y    = bounds.y
        pl.content_h    = f32[mc] * lh
        pl.view_h       = bounds.h
        pl.scroll_speed = lh
        x0   : f32 [ bounds.x ]
        y0   : f32 [ bounds.y ]
        colx : f32 [ round[ bounds.x + bounds.w * 0.45 ] ]
        lc   : rgba [ (line_color) ? line_color : rgba['#ffffff18'] ]
        wtx  : f32 [ cv.transform_tx[] ]
        wty  : f32 [ cv.transform_ty[] ]
        cv.set_crop[ wtx + bounds.x, wty + bounds.y, wtx + bounds.x + bounds.w, wty + bounds.y + bounds.h ]
        cv.save[]
        cv.plain[]
        cv.hard_edge[]
        cv.stroke_width[ 0.0 ]
        # one column rule, full height, exactly 1px
        cv.fill_color[ lc ]
        cv.rect_to[ colx, bounds.y, 1.0, bounds.h ]
        cv.paint[ ]
        dr : i32 [ 0 ]
        for [ i: i32 0, i < n, i += 1 ]
            if [ !pl.row_match[ i, f ] ] continue
            y : f32 [ round[ y0 + f32[dr] * lh - pl.scroll.y ] ]
            dr += 1
            if [ y + lh < bounds.y ] continue
            if [ y > bounds.y + bounds.h ] break
            if [ i == pl.sel ]
                cv.fill_color[ rgba['#8c4a6440'] ]
                cv.rect_to[ x0, y, bounds.w, lh ]
                cv.paint[ ]
            cv.fill_color[ lc ]
            cv.rect_to[ x0, y + lh - 1.0, bounds.w, 1.0 ]
            cv.paint[ ]
            cv.fill_color[ (key_color) ? key_color : '#d8a8c4' ]
            cv.draw_text[ pl.row_key[ i ],
                rect [ x: x0 + 6.0, y: y, w: colx - x0 - 10.0, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
            cv.fill_color[ (text_color) ? text_color : '#e8cfe0' ]
            cv.draw_text[ pl.row_val[ i ],
                rect [ x: colx + 6.0, y: y, w: bounds.x + bounds.w - colx - 10.0, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
        cv.restore[]
        cv.clear_crop[]

Layer FieldsLayer
    public label_size  : f32
    public row_spacing : f32
    public key_color   : string
    public text_color  : string
    public line_color  : string

    func draw [ cv: Canvas ]
        fl : Fields[ parent ]
        if [ !fl ] return
        cv.font_size[ i32[label_size] ]
        lh : f32 [ cv.get_line_height[] * ((row_spacing > 0.0) ? row_spacing : 1.0) ]
        n  : i32 [ fl.row_count[] ]
        fl.row_height   = lh
        fl.content_y    = bounds.y
        fl.content_h    = f32[n] * lh
        fl.view_h       = bounds.h
        fl.scroll_speed = lh
        x0   : f32 [ bounds.x ]
        y0   : f32 [ bounds.y ]
        colx : f32 [ bounds.x + bounds.w * 0.42 ]
        lc   : rgba [ (line_color) ? line_color : rgba['#ffffff18'] ]
        wtx  : f32 [ cv.transform_tx[] ]
        wty  : f32 [ cv.transform_ty[] ]
        cv.set_crop[ wtx + bounds.x, wty + bounds.y, wtx + bounds.x + bounds.w, wty + bounds.y + bounds.h ]
        cv.stroke_width[ 0.0 ]
        for [ i: i32 0, i < n, i += 1 ]
            y : f32 [ y0 + f32[i] * lh - fl.scroll.y ]
            if [ y + lh < bounds.y ] continue
            if [ y > bounds.y + bounds.h ] break
            v : variable fl.vars[i]
            if [ i == fl.sel ]
                cv.fill_color[ rgba['#264f7866'] ]
                cv.rect_to[ x0, y, bounds.w, lh ]
                cv.paint[ ]
            # per-row separator line (bottom edge)
            cv.fill_color[ lc ]
            cv.rect_to[ x0, y + lh - 1.0, bounds.w, 1.0 ]
            cv.paint[ ]
            # key (name) in the left column
            cv.fill_color[ (key_color) ? key_color : '#9fb6d8' ]
            cv.draw_text[ (v) ? v.name : '',
                rect [ x: x0 + 8.0, y: y, w: colx - x0 - 12.0, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
            # value in the right column
            cv.fill_color[ (text_color) ? text_color : '#cfe6ff' ]
            cv.draw_text[ (v) ? v.value : '',
                rect [ x: colx + 8.0, y: y, w: bounds.x + bounds.w - colx - 12.0, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
        cv.clear_crop[]
