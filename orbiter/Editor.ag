    # our own line diff: LCS over the middle after prefix/suffix trim.
    # kinds: 0 context, 1 removed (commit only), 2 added (our buffer)
    func diff_against [ base: vec string, cur: vec string,
                        out_k: vec i32 ] -> list string
        out : list string []
        nb9 : i32 [ base.count ]
        nc : i32 [ cur.count ]
        p9  : i32 [ 0 ]
        while [ p9 < nb9 && p9 < nc && base[ p9 ] == cur[ p9 ] ]
            out.push[ base[ p9 ] ]
            out_k.push[ 0 ]
            p9 += 1
        s9 : i32 [ 0 ]
        while [
            s9 < nb9 - p9 && s9 < nc - p9
            && base[ nb9 - 1 - s9 ] == cur[ nc - 1 - s9 ] ]
            s9 += 1
        wa  : i32 [ nb9 - p9 - s9 ]
        wb  : i32 [ nc - p9 - s9 ]
        big : i64 [ i64[wa] * i64[wb] ]
        if [ big > 25000000 ]
            # window too large for the table: whole middle is a replace
            for [ i: i32 0, i < wa, i += 1 ]
                out.push[ base[ p9 + i ] ]
                out_k.push[ 1 ]
            for [ j: i32 0, j < wb, j += 1 ]
                out.push[ cur[ p9 + j ] ]
                out_k.push[ 2 ]
        el [ wa > 0 || wb > 0 ]
            st   : i32 [ wb + 1 ]
            n_dp : i32 [ (wa + 1) * st ]
            dp   : new i32 [ n_dp ]
            for [ i: i32 wa, i >= 0, i -= 1 ]
                for [ j: i32 wb, j >= 0, j -= 1 ]
                    v9 : i32 [ 0 ]
                    if [ i < wa && j < wb ]
                        if [ base[ p9 + i ] == cur[ p9 + j ] ]
                            v9 = dp[ (i + 1) * st + j + 1 ] + 1
                        el
                            d9 : i32 [ dp[ (i + 1) * st + j ] ]
                            r9 : i32 [ dp[ i * st + j + 1 ] ]
                            v9 = (d9 > r9) ? d9 : r9
                    dp[ i * st + j ] = v9
            i9 : i32 [ 0 ]
            j9 : i32 [ 0 ]
            while [ i9 < wa || j9 < wb ]
                if [
                    i9 < wa && j9 < wb
                    && base[ p9 + i9 ] == cur[ p9 + j9 ] ]
                    out.push[ base[ p9 + i9 ] ]
                    out_k.push[ 0 ]
                    i9 += 1
                    j9 += 1
                el [
                    i9 < wa
                    && (j9 >= wb || dp[ (i9 + 1) * st + j9 ] >= dp[ i9 * st + j9 + 1 ]) ]
                    out.push[ base[ p9 + i9 ] ]
                    out_k.push[ 1 ]
                    i9 += 1
                el
                    out.push[ cur[ p9 + j9 ] ]
                    out_k.push[ 2 ]
                    j9 += 1
        for [ t9: i32 0, t9 < s9, t9 += 1 ]
            out.push[ base[ nb9 - s9 + t9 ] ]
            out_k.push[ 0 ]
        return out

    # project the merged view back to the live buffer (rows the commit
    # doesn't own), then re-diff — edits merge before your eyes
    func diff_rebuild [ project: bool ]
        key9 : '{src.absolute[]}'
        fcm : map FileBuf [string] buffers[]
        fb9  : FileBuf fcm[key9]
        if [ !fb9 ]
            fb9 = FileBuf []
            nl : list string []
            ft : string src.load[ typeid[string], null ]
            if [ ft ]
                pp : ft.split["\n"]
                for [ i: i32 0, i < pp.count, i += 1 ]
                    nl.push[ pp[i] ]
                if [ ft.count > 0 && ft[ ft.count - 1 ] == 10 ]
                    nl.push[ '' ]
            fb9.lines = nl
            fb9.mtime = src.modified_time[]
            fcm[key9] = fb9
        if [ project && diff_kinds && lines ]
            pj9 : list string []
            n7  : i32 [ lines.count ]
            for [ i: i32 0, i < n7, i += 1 ]
                k7 : i32 [ (i < diff_kinds.count) ? diff_kinds[i] : 0 ]
                if [ k7 != 1 ]
                    s7 : string lines.value_by_index[ i ]
                    pj9.push[ (s7) ? s7 : '' ]
            fb9.lines = pj9
            fb9.hist  = null
        cur9 : vec string []
        nb7  : i32 [ fb9.lines.count ]
        for [ i: i32 0, i < nb7, i += 1 ]
            cs8 : string fb9.lines.value_by_index[ i ]
            cur9.push[ (cs8) ? cs8 : '' ]
        dk : vec i32 []
        ml : list string diff_against[ diff_base, cur9, dk ]
        if [ ml.count == 0 ]
            ml.push[ '' ]
            dk.push[ 0 ]
        lines      = ml
        diff_kinds = dk
        rebuild_diff_src[]
        diff_dirty = false
        if [ sel_line >= lines.count ] sel_line = lines.count - 1
        pristine = false

    # glyphs collect here so the edge fade never touches fills or the
    # gutter
    func text_target [ cv: Canvas, b: rect ] -> Canvas
        tw : i32 [ ceil[ b.w ] ]
        th : i32 [ ceil[ b.h ] ]
        if [ tw <= 0 || th <= 0 ] return cv
        if [ !text_canvas ]
            text_canvas = Canvas [ vk: cv.vk, w: cv.w,
                                   format: Pixel.rgba8,
                width: tw, height: th, load_existing: true,
                quantize: true, tag: 'edtext' ]
            text_canvas.update[]
        el [
            text_canvas.content_w != tw || text_canvas.content_h != th ]
            text_canvas.resize[ tw, th ]
        text_canvas.reset[ vec4f [ 0.0, 0.0, 0.0, 0.0 ] ]
        return text_canvas

    # a straight ramp on whichever edges fade, made in the shader
    # pt: the pinned band's height; the fade starts under it and the
    # band's strip shows whole. kl: the gutter's width; the left ramp
    # starts at the text's edge, and the gutter is hidden
    func text_blit [ cv: Canvas, b: rect, ft: f32, fr: f32, fb: f32,
                     fl: f32, pt: f32, kl: f32 ]
        if [ !text_canvas ] return
        tw : i32 [ text_canvas.content_w ]
        th : i32 [ text_canvas.content_h ]
        if [
            ft <= 0.0 && fr <= 0.0 && fb <= 0.0 && fl <= 0.0
            && pt <= 0.0 ]
            cv.draw_canvas[ text_canvas, b.x, b.y, f32[ tw ],
                            f32[ th ] ]
            return
        cv.draw_canvas_ramp[ text_canvas, b.x, b.y, f32[ tw ], f32[ th ],
                             ft, fr, fb, fl, pt, kl ]

    # removed rows exist only in the base, so they consume no file line
    func rebuild_diff_src []
        if [ !diff_kinds ]
            diff_src = null
            return
        n  : i32 [ diff_kinds.count ]
        ds : vec i32 []
        s  : i32 [ 0 ]
        for [ i: i32 0, i < n, i += 1 ]
            if [ diff_kinds[i] == 1 ]
                ds.push[ -1 ]
            el
                ds.push[ s ]
                s += 1
        diff_src = ds

    func kinds_insert [ at: i32 ]
        if [ !diff_kinds ] return
        diff_kinds.push[ 2 ]
        for [ i: i32 diff_kinds.count - 1, i > at, i -= 1 ]
            diff_kinds[i] = diff_kinds[ i - 1 ]
        diff_kinds[at] = 2
        rebuild_diff_src[]

    func kinds_remove [ at: i32 ]
        if [ !diff_kinds || at >= diff_kinds.count ] return
        for [ i: i32 at, i < diff_kinds.count - 1, i += 1 ]
            diff_kinds[i] = diff_kinds[ i + 1 ]
        diff_kinds.pop[]
        rebuild_diff_src[]

    # the instance is serviced every frame; the pane repaints every
    # frame only while an app streams frames into it, or a view asks for
    # it
    public func tick [ w: Window ]
        if [ run_view ]
            run_view.stopped = stopped[]
            # not drawn yet: the launch takes the pane's content area as
            # its size
            cl9 : Layer (layers) ? layers[ 'content' ] : null
            if [
                run_view.vw <= 0.0 && cl9 && cl9.bounds
                && cl9.bounds.w > 0.0 ]
                run_view.vw = cl9.bounds.w
                run_view.vh = cl9.bounds.h
                bot : element (elements) ? elements[ 'bottom' ] : null
                if [ bot && bot.bounds && bot.bounds.h > 0.0 ]
                    lim : f32 [ bot.bounds.y - cl9.bounds.y ]
                    if [ lim > 0.0 && lim < cl9.bounds.h ]
                        run_view.vh = lim
            run_view.service[ w.screen ]
            if [ run_view.lock_req != 0 ]
                if [ run_view.lock_req == 1 ] ux.mouse_lock[ a ]
                el ux.mouse_unlock[]
                run_view.lock_req = 0
        live : bool [
            run_view && app_view && !show_hits && !run_view.held
            && !run_view.ended && !stopped[] ]
        animated = live || (rview && rview.continuous*[])

    # drop the in-pane view; the running app has its own lifetime
    func close_view []
        if [ rview ] rview.release*[]
        rview    = null
        animated = false

    # while an app runs, the run band belongs to IT — not to whatever
    # file the pane has navigated to (stepping into another module moves
    # the pane)
    func band_src [] -> path
        if [ run_view && run_view.src ] return run_view.src
        return src

    # stop the app this pane launched
    func close_app []
        orb : cast orbiter [ ux.app_object ]
        ms   : path band_src[]
        if [ run_view ]
            if [ orb && run_view.app_mod ]
                orb.stop_debug[ orb.dbg_key[ run_view ] ]
            run_view.release*[]
            if [ orb ] orb.remove_instance[ run_view ]
        # drop the closed instance; the newest remaining one is selected
        keep : vec AppView (orb) ? orb.instances_of[ ms ] : null
        run_view = (keep && keep.count > 0) ? keep[
            keep.count - 1 ] : null
        app_view = run_view != null

    # the instances of the module this pane shows: the shown instance's
    # own module when one was picked from the nav list, else the pane's
    # file
    func instances [] -> vec AppView
        orb : cast orbiter [ ux.app_object ]
        if [ !orb ] return null
        src9 : path (run_view && run_view.src) ? run_view.src : band_src[]
        return orb.instances_of[ src9 ]

    # which view this pane should show: the user's pick, else the
    # default
    func resolve_view [] -> string
        if [ view_name && view_name.count > 0 ] return view_name
        d : string default_view_for[ src ]
        if [ d && d.count > 0 ] return d
        if [ file_is_binary[ src ] ] return 'b16'
        return 'editor'

    # the only place a view is torn down or constructed
    func mount [ want: string ]
        sp9 : string [ (src) ? '{src}' : '' ]
        dc : string [ (diff_commit) ? diff_commit : '' ]
        key : string '{want}|{sp9}|{dc}'
        if [ mounted && mounted.compare[ key ] == 0 ] return
        mounted = key
        close_view[]
        # a hosted handler (the markdown viewer) gives way to any other
        # view
        if [ want.compare[ 'editor' ] == 0 ]
            if [ run_view && run_view.viewer ] close_app[]
            app_view = false
            load_text[]
            view_name = 'editor'
            return
        t    : Au_t view_type[ want ]
        orbc : cast orbiter [ ux.app_object ]
        # a console the project declares is a view we compose ourselves
        isc  : bool [ orbc && orbc.console_of[ want ] ]
        if [ t || isc ]
            if [ run_view && run_view.viewer ] close_app[]
            app_view = false
            if [ isc ]
                # the folder in view is what the process gets, not a
                # file
                fold : path [
                    (orbc.nav_root) ? orbc.nav_root
                    : orbc.project_root[] ]
                rview = ConsoleView [ session: want,
                                      sessions: orbc.ed_sessions,
                    launch: orbc.agent_cmd[ want ], folder: fold ]
            el
                rview = ResourceView [
                    Au.new_object[ t, null, null, true, __FILE__,
                                   __LINE__, __SEQUENCE__ ] ]
            rview.src = src
            # emulator panes redraw every frame
            animated  = rview.continuous*[]
            lines     = list string []
            pristine      = false
            scroll.x      = 0.0
            scroll.y      = 0.0
            scroll_target = 0.0
            content_h     = 0.0
            saved_scroll  = 0.0
            return
        # a peer module owns this view: it runs as its own process
        lines = list string []
        lines.push[ '' ]
        orbv : cast orbiter [ ux.app_object ]
        # want is either a registered view name or the module's own name
        # (the default action). only a real view travels as --view
        ow  : string [ (orbv) ? orbv.view_module[ want ] : null ]
        m9   : string [ (ow && ow.count > 0) ? ow : want ]
        # one instance for any given viewer, always new: picking a view
        # closes whatever was running and launches with it
        if [ run_view && run_view.viewer ] close_app[]
        if [ m9 ]
            launch_handler[ m9, src, (ow && ow.count > 0) ? want : '' ]

    # a disk change (agents editing) becomes ONE undo item: the buffer
    # swaps to disk content; cmd+Z restores what was here before
    func reload_from_disk []
        if [ !src || diff_commit || show_hits || (flat_active && !ghost_only[]) || !hist ]
            return
        key : '{src.absolute[]}'
        fcm : map FileBuf [string] buffers[]
        buf : FileBuf fcm[ key ]
        if [ !buf ] return
        mt : i64 [ src.modified_time[] ]
        if [ mt == buf.mtime ] return
        buf.mtime = mt
        ftext : string src.load[ typeid[string], null ]
        if [ !ftext ] return
        before9 : list string []
        for [ s: string ] in lines
            before9.push[ s ]
        after9 : list string []
        parts : ftext.split["\n"]
        for [ i: i32 0, i < parts.count, i += 1 ]
            after9.push[ parts[i] ]
        g : EditAction []
        g.full_before = before9
        g.full_after  = after9
        g.sl0 = sel_line
        g.sc0 = sel_col
        g.sl1 = clamp[ sel_line, 0, after9.count - 1 ]
        g.sc1 = sel_col
        # unsaved groups since the last sync replay on top afterwards
        sy9  : i32 [ (buf.sync_i >= 0) ? buf.sync_i : 0 ]
        rep9 : vec EditAction []
        if [ hist_i - sy9 <= 64 ]
            for [ k9: i32 sy9, k9 < hist_i, k9 += 1 ]
                gg : EditAction hist.value_by_index[ k9 ]
                if [
                    gg && !gg.full_after && gg.ops && gg.ops.count > 0 ]
                    rep9.push[ gg ]
        while [ hist.count > hist_i ]
            hist.pop[]
        hist.push[ g ]
        hist_i = hist.count
        buf.sync_i = hist.count
        touch_hist[]
        cur_group = null
        edit_kind = -1
        swap_lines[ after9 ]
        if [ sel_line >= lines.count ]    sel_line    = lines.count - 1
        if [ anchor_line >= lines.count ] anchor_line = lines.count - 1
        # walk oldest-first; the first group that fails to anchor stops
        # it
        t9 : vec i32 []
        for [ gg: EditAction ] in rep9
            for [ op: LineOp ] in gg.ops
                t9.push[ op.at ]
        lastl : i32 [ -1 ]
        lastc : i32 [ 0 ]
        for [ gg: EditAction ] in rep9
            d9 : i32 [ replay_offset[ gg, before9, t9 ] ]
            if [ d9 == -100000 ] break
            replay_group[ gg, d9 ]
            lastl = gg.sl1 + d9
            lastc = gg.sc1
        if [ lastl >= 0 ]
            sel_line    = clamp[ lastl, 0, lines.count - 1 ]
            sel_col     = lastc
            anchor_line = sel_line
            anchor_col  = sel_col
        pristine = false
        if [ ux ] ux.will_animate = true

    func check_disk []
        now : i64 [ epoch_millis[] ]
        if [ now - disk_ms < 500 ] return
        disk_ms = now
        reload_from_disk[]

    func op_touched [ t9: vec i32, ln: i32 ] -> bool
        for [ v9: i32 ] in t9
            if [ v9 == ln ] return true
        return false

    # every set/remove 'before' must match the buffer verbatim at d;
    # untouched neighbor lines must match too (wider fingerprint)
    func op_anchors [ g: EditAction, d: i32, old: list string,
                      t9: vec i32 ] -> bool
        n9    : i32 [ lines.count ]
        no9   : i32 [ old.count ]
        seen9 : bool [ false ]
        for [ op: LineOp ] in g.ops
            if [ op.kind == 1 ]
                if [ op.at + d < 0 || op.at + d > n9 ] return false
                continue
            seen9 = true
            at9 : i32 [ op.at + d ]
            if [ at9 < 0 || at9 >= n9 ] return false
            ln  : string lines.value_by_index[ at9 ]
            cmp : string [ (op.before) ? op.before : '' ]
            if [ !ln ] ln = ''
            if [ ln.compare[ cmp ] != 0 ] return false
            up9 : i32 [ op.at - 1 ]
            au : i32 [ at9 - 1 ]
            if [ up9 >= 0 && up9 < no9 && !op_touched[ t9, up9 ] ]
                if [ au < 0 ] return false
                a9 : string lines.value_by_index[ au ]
                b9 : string old.value_by_index[ up9 ]
                if [ !a9 ] a9 = ''
                if [ !b9 ] b9 = ''
                if [ a9.compare[ b9 ] != 0 ] return false
            dn : i32 [ op.at + 1 ]
            ad9 : i32 [ at9 + 1 ]
            if [ dn >= 0 && dn < no9 && !op_touched[ t9, dn ] ]
                if [ ad9 >= n9 ] return false
                c9 : string lines.value_by_index[ ad9 ]
                e9 : string old.value_by_index[ dn ]
                if [ !c9 ] c9 = ''
                if [ !e9 ] e9 = ''
                if [ c9.compare[ e9 ] != 0 ] return false
        # insert-only groups carry no context: trust position 0 only
        if [ !seen9 && d != 0 ] return false
        return true

    # the offset must be UNIQUE in the window; two candidates means
    # the file is locally self-similar — the reload stands, undo has it
    func replay_offset [ g: EditAction, old: list string,
                         t9: vec i32 ] -> i32
        found9 : i32 [ -100000 ]
        nf9    : i32 [ 0 ]
        for [ d9: i32 0 - 64, d9 <= 64, d9 += 1 ]
            if [ op_anchors[ g, d9, old, t9 ] ]
                nf9 += 1
                if [ nf9 > 1 ] return -100000
                found9 = d9
        return found9

    # re-record the group's ops at offset d as a fresh history item
    func replay_group [ g: EditAction, d: i32 ]
        cur_group = null
        edit_kind = -1
        pend_sl0  = g.sl0 + d
        pend_sc0  = g.sc0
        for [ op: LineOp ] in g.ops
            if [ op.kind == 0 ]
                ed_set[ op.at + d, op.after ]
            el [ op.kind == 1 ]
                ed_insert[ op.at + d, op.after ]
            el
                ed_remove[ op.at + d ]
        if [ cur_group ]
            cur_group.sl1 = g.sl1 + d
            cur_group.sc1 = g.sc1
        cur_group = null
        edit_kind  = -1

    func load_file []
        ns9 : string [ (src) ? '{src}' : '' ]
        ls : string [ (loaded_src) ? '{loaded_src}' : '' ]
        # a new file returns to the default view and drops the old
        # file's app
        if [ ns9.compare[ ls ] != 0 ]
            view_name = ''
            # a debugger stepping into another module moves the pane;
            # the app stays
            if [ run_view && run_view.viewer ] close_app[]
            # a module picked from the nav list lets go of the old
            # module's instance (it keeps running); an instance stopped
            # in the debugger stays: walking its frames opens other
            # modules
            el [
                run_view && src && stop_pending == 0 && !stopped[]
                && (!run_view.src || '{run_view.src.absolute[]}' != '{src.absolute[]}') ]
                run_view = null
            # back on a module: its instance again, the code in view
            orb : cast orbiter [ ux.app_object ]
            if [ !run_view && src && orb ]
                for [ v7: AppView ] in orb.instances_of[ src ]
                    if [ !v7.viewer ] run_view = v7
            app_view    = false
            sel_line    = -1
            anchor_line = -1
            anchor_col  = 0
            dragging    = false
        loaded_src = src
        # a console is not a file's view: it mounts with no file at all
        orbn : cast orbiter [ ux.app_object ]
        isc  : bool [
            orbn && view_name && orbn.console_of[ view_name ] ]
        if [ !src && !isc ]
            mounted = null
            close_view[]
            close_app[]
            lines = list string []
            lines.push[ '' ]
            return
        mount[ resolve_view[] ]
        # a stop that arrived before this file was in: land on it now
        if [ stop_pending > 0 ]
            apply_stop[ stop_pending, stop_pending_col ]
            stop_pending = 0
        # a navigation that opened this file lands now: the load reset
        # the caret
        if [ goto_pending > 0 ]
            land_on[ goto_pending ]
            goto_pending   = 0
            arrive_pending = false
        el [ arrive_pending ]
            arrive_pending = false
            if [ nav && src ]
                nav.record[ pane_index, '{src.absolute[]}',
                            (sel_line < 0) ? 0 : sel_line, sel_col,
                            scroll.y ]

    # the hunks are recomputed when the file, its saved state or the git
    # snapshot changed; git diff -U0 against HEAD, over the checkout the
    # file sits in
    func hunks_check []
        if [ !src || diff_commit ] return
        orb : cast orbiter [ ux.app_object ]
        if [ !orb ] return
        sa : string '{src.absolute[]}'
        fb9 : FileBuf (orb.file_cache) ? orb.file_cache[ sa ] : null
        ch9 : FileChg orb.file_changes[ src ]
        sd  : path src.directory[]
        root : path orb.checkout_root[ sd ]
        ref8 : string [ (root) ? orb.git_ref_of[ root ] : 'HEAD' ]
        sig : string '{sa}|{ref8}|{(fb9) ? fb9.sync_i : 0}|{(ch9) ? ch9.adds : 0}|{(ch9) ? ch9.dels : 0}'
        if [ hunk_sig && hunk_sig.compare[ sig ] == 0 ] return
        hunk_sig = sig
        hunks    = vec i32 []
        hunk_old = vec i32 []
        # the hunks moved under any open ghost rows: they close
        ghost_hunk = -1
        if [ !root ] return
        rt  : string '{root}'
        rel : string [
            (sa.count > rt.count)
            ? sa.mid[ rt.count + 1, sa.count - rt.count - 1 ] : sa ]
        hunk_root = root
        hunk_rel  = rel
        hunk_ref  = ref8
        out : vec string git_capture[ root, 'diff -U0 {ref8} -- "{rel}"', false ]
        for [ ln: string ] in out
            if [ !ln.starts_with[ '@@' ] ] continue
            # @@ -a,b +c,d @@ : c the first new row (1-based), d rows; b
            # old rows
            pl : i32 [ ln.index_of[ '+' ] ]
            if [ pl < 0 ] continue
            rest : string ln.mid[ pl + 1, ln.count - pl - 1 ]
            sp9  : i32 [ rest.index_of[ ' ' ] ]
            if [ sp9 > 0 ] rest = rest.mid[ 0, sp9 ]
            cm  : i32 [ rest.index_of[ ',' ] ]
            cs9  : string (cm >= 0) ? rest.mid[ 0, cm ] : rest
            ds  : string (cm >= 0) ? rest.mid[ cm + 1, rest.count - cm - 1 ] : '1'
            c9 : i32 [ cs9.integer_value[] ]
            d9 : i32 [ ds.integer_value[] ]
            # the old side: -a,b
            ml : i32 [ ln.index_of[ '-' ] ]
            a9 : i32 [ 0 ]
            b9 : i32 [ 1 ]
            if [ ml >= 0 && ml < pl ]
                orest : string ln.mid[ ml + 1, pl - ml - 1 ]
                osp : i32 [ orest.index_of[ ' ' ] ]
                if [ osp > 0 ] orest = orest.mid[ 0, osp ]
                ocm : i32 [ orest.index_of[ ',' ] ]
                as : string (ocm >= 0) ? orest.mid[ 0, ocm ] : orest
                a9 = i32[ as.integer_value[] ]
                b9 = (ocm >= 0) ? i32[
                    orest.mid[ ocm + 1,
                               orest.count - ocm
                               - 1 ].integer_value[] ] : 1
            # removed after line c: the mark above row c (0-based); else
            # the rows from c-1, added when nothing was there before,
            # changed otherwise
            hr : i32 [ (d9 == 0) ? c9 : c9 - 1 ]
            hrn : i32 [ d9 ]
            hkd : i32 [ (d9 == 0) ? 3 : ((b9 == 0) ? 1 : 2) ]
            hunks.push[ hr ]
            hunks.push[ hrn ]
            hunks.push[ hkd ]
            hunk_old.push[ a9 ]
            hunk_old.push[ b9 ]

    # the hunk holding row, -1 when none (a removal counts on its row)
    func hunk_at [ row: i32 ] -> i32
        if [ !hunks ] return -1
        n9 : i32 [ i32[ hunks.count ] / 3 ]
        for [ i: i32 0, i < n9, i += 1 ]
            r0 : i32 [ hunks[ i * 3 ] ]
            rn : i32 [ hunks[ i * 3 + 1 ] ]
            if [ rn == 0 ]
                if [ row == r0 ] return i
            el [ row >= r0 && row < r0 + rn ] return i
        return -1

    # the removal hunk whose edge band holds the pointer, -1 off: fy is
    # the pointer's y within view row vr. the edge sits on the row's top
    # line; its band reaches a quarter line into that row and a quarter
    # line into the row above, so the rest of both gutter rows stays a
    # breakpoint's
    func edge_hunk [ vr: i32, fy: f32, lh: f32 ] -> i32
        if [ !hunks || vr < 0 ] return -1
        sr : i32 [ row_src[ vr ] ]
        if [ sr < 0 ] return -1
        if [ fy < lh * 0.25 ]
            h0 : i32 [ hunk_at[ sr ] ]
            if [ h0 >= 0 && hunks[ h0 * 3 + 2 ] == 3 ] return h0
        if [ fy > lh * 0.75 ]
            h1 : i32 [ hunk_at[ sr + 1 ] ]
            if [ h1 >= 0 && hunks[ h1 * 3 + 2 ] == 3 ] return h1
        return -1

    # a hunk's first row as drawn: open ghost rows above it push it down
    func hunk_view_row [ i: i32 ] -> i32
        r0 : i32 [ hunks[ i * 3 ] ]
        if [ ghost_hunk < 0 || !ghost_lines ] return r0
        if [ i == ghost_hunk ] return ghost_at
        return (r0 >= ghost_at) ? r0 + i32[ ghost_lines.count ] : r0

    # a removed run shown or hidden in place: its old lines from HEAD's
    # file, as read-only ghost rows before the row it was removed above
    func ghost_toggle [ i: i32 ]
        if [ i == ghost_hunk ]
            ghost_hunk = -1
        el
            if [ !hunks || i < 0 || i * 3 + 2 >= hunks.count || hunks[ i * 3 + 2 ] != 3 ]
                return
            if [ !hunk_root || !hunk_old || i * 2 + 1 >= hunk_old.count ]
                return
            a0 : i32 [ hunk_old[ i * 2 ] ]
            an : i32 [ hunk_old[ i * 2 + 1 ] ]
            base : vec string git_capture[ hunk_root, 'show {hunk_ref}:"{hunk_rel}"', true ]
            gl : vec string []
            for [ k: i32 0, k < an, k += 1 ]
                bi : i32 [ a0 - 1 + k ]
                if [ bi < 0 || bi >= base.count ] break
                gl.push[ base[ bi ] ]
            if [ gl.count == 0 ] return
            ghost_lines = gl
            ghost_at    = hunks[ i * 3 ]
            ghost_hunk  = i
        pristine = false
        if [ ux ] ux.will_animate = true

    # a hunk's preview title: where it starts, and who last wrote its
    # old first line; a removal also keeps its old lines to show
    func peek_fill [ i: i32 ]
        peek_old = null
        if [ !hunks || i < 0 || i * 3 + 2 >= hunks.count ] return
        ln : i32 [ hunks[ i * 3 ] + 1 ]
        peek_title = 'line {ln}'
        if [ !hunk_root || !hunk_old || i * 2 + 1 >= hunk_old.count ]
            return
        a0 : i32 [ hunk_old[ i * 2 ] ]
        an : i32 [ hunk_old[ i * 2 + 1 ] ]
        # a removal: its old lines to show, no line of its own to blame
        if [ hunks[ i * 3 + 2 ] == 3 ]
            base : vec string git_capture[ hunk_root,
                'show {hunk_ref}:"{hunk_rel}"', true ]
            old : vec string []
            for [ k: i32 0, k < an && k < 16, k += 1 ]
                bi : i32 [ a0 - 1 + k ]
                if [ bi < 0 || bi >= base.count ] break
                old.push[ base[ bi ] ]
            peek_old = old
            return
        # a new entry: its line alone; blame is for lines that were
        if [ an <= 0 ] return
        # the line as it is now: our own edit is not committed yet, and
        # then there is no blame to show
        rng : string '-L {ln},{ln}'
        args : string 'blame {rng} --porcelain -- "{hunk_rel}"'
        bl : vec string git_capture[ hunk_root, args, true ]
        who  : string ''
        when : i64 [ 0 ]
        what : string ''
        for [ l: string ] in bl
            if [ l.starts_with[ 'author ' ] ]
                who = l.mid[ 7, l.count - 7 ]
            el [ l.starts_with[ 'author-time ' ] ]
                when = l.mid[ 12, l.count - 12 ].integer_value[]
            el [ l.starts_with[ 'summary ' ] ]
                what = l.mid[ 8, l.count - 8 ]
        if [ who.count == 0 || who.starts_with[ 'Not Committed' ] ]
            return
        days : i64 [ (Au.epoch_millis[] / 1000 - when) / 86400 ]
        ago : string (days < 1) ? 'today' : '{days}d ago'
        peek_title = 'line {ln}  {who}, {ago}: {what}'

    # the git rail under the pointer (index), -1 off: inside the
    # scrollbar's track, the same geometry the layer draws
    func rail_at [ mx: f32, my: f32 ] -> i32
        if [ !hunks || diff_kinds || show_hits || finder_list ]
            return -1
        ele : (layers) ? cast EditorLayer [ layers['content'] ] : null
        sb  : ScrollLayer (layers) ? cast ScrollLayer [
            layers['scrollbar'] ] : null
        if [ !ele || !ele.bounds || !sb || !sb.bounds || content_h <= ele.bounds.h ]
            return -1
        lh  : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
        top : f32 [ ele.bounds.y + 8.0 ]
        vis : f32 [ sb.bounds.y + sb.bounds.h - top ]
        if [ vis < 32.0 || content_h <= 0.0 ] return -1
        # the track's column at its widest, where the pointer is when it
        # presses
        cx  : f32 [ sb.bounds.x + sb.bounds.w - sb.thumb_w ]
        if [ mx < cx - sb.thumb_w || mx >= cx + sb.thumb_w ] return -1
        vy  : f32 [ my - scroll.y ]
        n   : i32 [ i32[ hunks.count ] / 3 ]
        for [ i: i32 0, i < n, i += 1 ]
            ry : f32 [
                top + f32[ hunk_view_row[ i ] ] * lh / content_h * vis ]
            rn : i32 [
                (i == ghost_hunk && ghost_lines)
                ? i32[ ghost_lines.count ] : hunks[ i * 3 + 1 ] ]
            rh : f32 [ f32[ rn ] * lh / content_h * vis ]
            if [ rh < 6.0 ] rh = 6.0
            if [ vy >= ry && vy < ry + rh ] return i
        return -1

    # a rail's click: the caret to the hunk's first row, brought into
    # view
    func hunk_goto [ i: i32 ]
        if [ !hunks || i < 0 || i * 3 + 2 >= hunks.count ] return
        rebuild_flat[]
        r0 : i32 [ hunk_view_row[ i ] ]
        if [ r0 >= line_count[] ] r0 = line_count[] - 1
        if [ r0 < 0 ] r0 = 0
        if [ nav && src ]
            nav.record[ pane_index, '{src.absolute[]}', sel_line,
                        sel_col, scroll.y ]
        sel_line    = r0
        sel_col     = 0
        anchor_line = r0
        anchor_col  = 0
        lh : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
        vh : f32 [ (bounds) ? bounds.h : 600.0 ]
        tp : f32 [ f32[ r0 ] * lh ]
        if [ tp < scroll.y || tp + lh > scroll.y + vh ]
            scroll.y = tp - vh * 0.4
            if [ scroll.y < 0.0 ] scroll.y = 0.0
            scroll_target = scroll.y
            scroll_goal   = scroll.y
            scroll_anim   = false
        pristine = false
        if [ ux ] ux.will_animate = true

    func load_text []
        pristine = false
        loaded_diff = diff_commit
        ghost_hunk  = -1
        diff_kinds  = null
        diff_src    = null
        diff_base   = null
        diff_dirty  = false
        if [ diff_commit && diff_commit.count > 0 ]
            orb : cast orbiter [ ux.app_object ]
            gr7  : path [ (orb) ? orb.project_root[] : src.directory[] ]
            # base = this commit's file; ours = the LIVE buffer (unsaved
            # edits count)
            rp  : string '{src.absolute[]}'
            rt  : string '{gr7}'
            rel : string [
                (rp.count > rt.count)
                ? rp.mid[ rt.count + 1, rp.count - rt.count - 1 ] : rp ]
            diff_base = git_capture[ gr7, 'show {diff_commit}:{rel}',
                                     true ]
            diff_rebuild[ false ]
            scroll.x      = 0.0
            scroll.y      = 0.0
            scroll_target = 0.0
            return
        key   : '{src.absolute[]}'
        mtime : i64    [ src.modified_time[] ]
        fcm  : map FileBuf [string] buffers[]
        buf   : FileBuf fcm[key]
        if [ buf && buf.mtime == mtime ]
            lines = buf.lines
            # restore this file's own undo/redo (or seed it)
            swap_history[ buf ]
            n9 : i32 [ (lines) ? lines.count : 0 ]
            log 'load_text: cached {key} lines={n9}'
            return
        ftext : string src.load[ typeid[string], null ]
        if [ !ftext ]
            log 'load_text: no text for {key}'
            return
        log 'load_text: read {key} bytes={ftext.count}'
        parts : ftext.split["\n"]
        new_lines : list string []
        for [ i: i32 0, i < parts.count, i += 1 ]
            new_lines.push[ parts[i] ]
        # split drops the piece after a trailing \n: that IS a line
        if [ ftext.count > 0 && ftext[ ftext.count - 1 ] == 10 ]
            new_lines.push[ '' ]
        if [ !buf ]
            buf = FileBuf []
            fcm[key] = buf
        buf.lines = new_lines
        buf.mtime = mtime
        lines = new_lines
        buf.hist = null
        buf.sync_i = 0
        swap_history[ buf ]

    func toggle_app_run [ clean: bool ]
        if [ run_view ]
            orb : cast orbiter [ ux.app_object ]
            if [ orb && run_view.app_mod ]
                es : ConsoleSession (orb.ed_sessions) ? orb.ed_sessions[
                    run_view.console_id[] ] : null
                if [ es ] es.print_text[ '\r\nstopped\r\n' ]
            close_app[]
            pristine  = false
            # another instance remains: it keeps the pane, or the pip
            if [ run_view ]
                if [ ux ] ux.restyle = true
                return
            no_scroll = false
            # stopping is a view choice: show the file, do not relaunch.
            # a binary format lands in a byte view, not in text
            view_name = fallback_view_for[ src ]
            load_file[]
            if [ ux ] ux.restyle = true
            return
        start_instance[ clean ]

    # play: a new instance beside the others, and it becomes the
    # selected one
    func start_instance [ clean: bool ]
        if [ !src ] return
        view_name = ''
        hm : handler_module_for[ src ]
        if [ hm ]
            launch_handler[ hm, src, '' ]
            return
        nv : AppView [ ]
        nv.src   = src
        nv.clean_build = clean
        orb : cast orbiter [ ux.app_object ]
        if [ orb ]
            fa : string orb.file_args[ src ]
            nv.module_args = (fa && fa.count > 0) ? fa : orb.module_args
        # not running until its row is clicked
        nv.held = true
        # a new instance shows by its display: PIP (the default) puts it
        # in the panel's pip once it has a frame, Full takes the pane.
        # the pip flag is the instance's own, as select_instance and
        # set_display keep it
        nv.pip  = nv.display == 0
        if [ orb ] orb.add_instance[ nv ]
        run_view = nv
        # held: the source stays in the pane until it starts (starting
        # sets the pane from its display)
        app_view = false
        pristine = false
        no_scroll = true
        if [ ux ] ux.restyle = true

    # another instance like av: its source, args and display, held
    # until its row starts it, as a new one is
    func copy_instance [ av: AppView ]
        if [ !av || !av.src ] return
        nv : AppView [ ]
        nv.src         = av.src
        nv.module_args = av.module_args
        nv.display     = av.display
        nv.pip         = av.display == 0
        nv.held        = true
        orb : cast orbiter [ ux.app_object ]
        if [ orb ] orb.add_instance[ nv ]
        pristine = false
        if [ ux ] ux.restyle = true

    func select_instance [ i: i32 ]
        li : vec AppView instances[]
        if [ !li || i < 0 || i >= li.count ] return
        run_view  = li[ i ]
        app_view  = run_view.display == 1
        pristine  = false
        no_scroll = true
        if [ ux ] ux.restyle = true

    # the chip's [x]: stop that instance; the last one left takes the
    # pane
    func close_instance [ i: i32 ]
        select_instance[ i ]
        toggle_app_run[ false ]

    func instance_name [ i: i32 ] -> string
        li : vec AppView instances[]
        av : AppView li[ i ]
        orb : cast orbiter [ ux.app_object ]
        if [ orb ] return orb.instance_name[ av ]
        m : string (av.app_mod && av.app_mod.count > 0) ? av.app_mod : ((src) ? src.stem[] : 'app')
        return m

    func attach_app_run [ mod: string ]
        if [ run_view ] return
        nv : AppView [ ]
        nv.src     = src
        nv.slot    = 0
        nv.app_mod = mod
        nv.started = true
        nv.cmd     = 'tail -n +1 -F /tmp/{mod}.log'
        run_view  = nv
        app_view  = false
        pristine  = false
        if [ ux ] ux.restyle = true

    # the live debugger, asked of orbiter: the debugger member only
    # refreshes on a re-render
    func active_dbg [] -> dbg
        orb : cast orbiter [ ux.app_object ]
        return (orb) ? orb.active_debugger[] : null

    # a debugger stop lifts the app off the pane: the source and its
    # arrow show
    func stopped [] -> bool
        # the pane's own instance says whether it is parked: another
        # instance of the same module at a stop must not hide this one
        if [ run_view ]
            d9 : dbg run_view.debugger
            return (d9 && d9.active && !d9.running) ? true : false
        d : dbg active_dbg[]
        return (d && !d.running) ? true : false

    func toggle_app_view []
        if [ !run_view ] return
        app_view = !app_view
        # the pip belongs to the instance: it keeps it when another is
        # selected
        run_view.pip = !app_view
        if [ run_view.display <= 1 ]
            run_view.display = (app_view) ? 1 : 0
        if [ !app_view ]
            run_view.fitw = 0.0
            run_view.fith = 0.0
        if [ !app_view ] load_file[]

    public func on_unload [ ]
        lines      = list string []
        code_lines = vec EdLineCache []
        super.on_unload[ ]

    func init [ ]
        if [ breakpoints ] breakpoints.hold[]
        lines = list string []
        lines.push[ '' ]
        load_file[]
        if [ !cur_buf ]
            sb : FileBuf []
            sb.lines = lines
            swap_history[ sb ]

    func grid_hit_index [ mx: f32, my: f32, bw: f32 ] -> i32
        if [ !hits ] return -1
        gcw  : f32 [ 140.0 ]
        gch  : f32 [ 178.0 ]
        lin : f32 [ (nav_tools && nav_tools.count > 0) ? 64.0 : 0.0 ]
        cols : i32 [ (g_cols > 0) ? g_cols : 1 ]
        ccol : i32 [ (mx - lin - 4.0) / gcw ]
        if [ my < 0.0 || mx < lin || ccol < 0 || ccol >= cols ]
            return -1
        pin_rows : i32 [ (g_pins + cols - 1) / cols ]
        pin_end  : f32 [ f32[ pin_rows ] * gch ]
        want_pin : bool [ false ]
        grow     : i32  [ 0 ]
        if [ g_pins > 0 && my < pin_end ]
            want_pin = true
            grow = i32[ my / gch ]
        el [ my >= g_resoff ]
            want_pin = false
            grow = i32[ (my - g_resoff) / gch ]
        el
            return -1
        target : i32 [ grow * cols + ccol ]
        gi : i32 [ 0 ]
        for [ li: i32 0, li < hits.count, li += 1 ]
            h : FindHit hits[ li ]
            if [ !h || !h.is_header || !h.file || h.is_spacer ] continue
            if [ row_cont[ li ] ] continue
            is_pin : bool [ li < dock_rows ]
            if [ is_pin != want_pin ] continue
            if [ gi == target ] return li
            gi += 1
        return -1

    # true means the click was CONSUMED (a definition jump); the caller
    # must not then place a caret or arm a drag in the file we just left
    func place_cursor [ ev: Event ] -> bool
        ele   : (layers) ? cast EditorLayer [ layers['content'] ] : null
        if [ !ele ] return false
        # nothing to place the cursor on (e.g. all results removed)
        if [ line_count[] <= 0 ]
            sel_line = -1
            return false
        lh    : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
        cw    : f32 [ (cw_cache > 0.0) ? cw_cache : 8.0 ]
        rel_y : f32 [
            ev.mouse.pos.y - ele.bounds.y - ((show_hits) ? 10.0 : 0.0) ]
        if [ rel_y < 0.0 ] return false
        if [ grid_mode && show_hits && hits ]
            gli : i32 [
                grid_hit_index[ ev.mouse.pos.x - ele.bounds.x, rel_y,
                                ele.bounds.w ] ]
            if [ gli >= 0 ]
                sel_line    = gli
                anchor_line = gli
            return false
        rel_x : f32 [ ev.mouse.pos.x - ele.bounds.x - gutter_w ]
        raw   : i32 [ clamp [ rel_y / lh, 0, line_count[] - 1 ] ]
        ln    : i32 [ snap_row[ raw ] ]
        if [ show_hits && tool_hit[ ev.mouse.pos.x, ev.mouse.pos.y ] >= 0 ]
            return false
        if [ show_hits && (dragging || ev.key.shift) ]
            ln = clamp[ ln, group_start[ anchor_line ],
                        group_end[ anchor_line ] ]
        # event pos is CONTENT space: scroll.x is already inside it
        vx    : f32 [ round[ (rel_x - row_indent[ ln ]) / cw ] ]
        cl    : i32 [ model_col[ line_get[ ln ], i32[ vx ] ] ]
        if [ nav && src && !dragging ]
            jd : i32 [ sel_line - ln ]
            if [ jd < 0 ] jd = 0 - jd
            if [ jd >= nav.significance_lines ]
                nav.record[ pane_index, '{src.absolute[]}', sel_line,
                            sel_col, scroll.y ]
        sel_line = ln
        sel_col  = cl

        # cmd/ctrl click -> the definition, straight off the type
        # record.
        # Au_t carries source/src_line now, so nothing here reads text.
        # only types LOADED in this process resolve: orbiter's own
        # sources and its imports, not an unrelated module's
        if [ ev.key.ctrl || ev.key.meta ]
            if [ jump_to_def[ ln, cl ] ]
                ev.no_default = true
                return true
            # a modifier click in here is OURS whether or not it
            # resolved. falling through hands it to the style inspector,
            # and cmd does not mean 'inspect this element' inside the
            # editor. unresolved, it is a plain click: the anchor moves
            # with the caret, or it reads as a shift-click from the old
            # anchor
            anchor_line = sel_line
            anchor_col  = sel_col
            ev.no_default = true
            return true
        return false

    # rail press: default is the first cell; the user navigates from
    # there
    func press_tool [ idx: i32 ]
        orb : cast orbiter [ ux.app_object ]
        bas : i32 [ tool_base[] ]
        nm  : string [
            (bas == 1 && idx == 0) ? '' : nav_tools[ idx - bas ] ]
        # a console is dir context: the pane lets go of its file first
        if [ orb && orb.console_of[ nm ] ]
            orb.pane_drop_file[ pane_index ]
        view_name = nm
        load_file[]
        if [ orb ] orb.exit_find_mode[]
        if [ ux ] ux.restyle = true

    func on_press [ ev: Event ]
        caret_touch += 1
        # the error band along the foot: a press goes to its line,
        # nothing else
        ebl : (layers) ? cast EditorLayer [ layers['content'] ] : null
        if [ ebl && ebl.bounds && err_band_text[] ]
            elh  : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
            # event pos is CONTENT space; the band is at the foot of the
            # VIEW
            erel : f32 [ ev.mouse.pos.y - ebl.bounds.y - scroll.y ]
            if [ erel >= ebl.bounds.h - elh && erel < ebl.bounds.h ]
                o9 : cast orbiter [ ux.app_object ]
                # shift copies the error with its file and line
                if [ shift_down ]
                    ux.set_clipboard[
                        '{src}:{err_band_line[]}: {err_band_text[]}' ]
                el [ o9 ] o9.goto_error[]
                ev.no_default = true
                return
        # the scrollbar's thumb and the git rails beside it come first:
        # the pinned band drawn under them must never take their press
        ele0 : (layers) ? cast EditorLayer [ layers['content'] ] : null
        sb0  : ScrollLayer (layers) ? cast ScrollLayer [
            layers['scrollbar'] ] : null
        if [ ele0 && ele0.bounds && sb0 && sb0.scroll_max > 0.0 ]
            grab : f32 [
                (sb0.thumb_w > 0.0) ? sb0.thumb_w * 2.0 + 8.0 : 16.0 ]
            if [ ev.mouse.pos.x - ele0.bounds.x > ele0.bounds.w - grab ]
                my0 : f32 [ ev.mouse.pos.y - ele0.bounds.y - scroll.y ]
                # the thumb itself first; off it, a rail under the
                # pointer goes to its hunk; else the track jumps the
                # thumb there
                if [
                    my0 < sb0.thumb_y_px
                    || my0 >= sb0.thumb_y_px + sb0.thumb_h_px ]
                    prl : i32 [
                        rail_at[ ev.mouse.pos.x, ev.mouse.pos.y ] ]
                    if [ prl >= 0 ]
                        if [ hunks[ prl * 3 + 2 ] == 3 && prl != ghost_hunk ]
                            ghost_toggle[ prl ]
                        hunk_goto[ prl ]
                        if [ ux ] ux.set_focus[ a ]
                        ev.no_default = true
                        return
                sb0.grab_at[ my0 ]
                sy0 : f32 [ sb0.drag_to[ my0 ] ]
                if [ sy0 >= 0.0 ]
                    scroll.y        = sy0
                    scroll_target   = sy0
                    scroll_dragging = true
                    sb0.active      = true
                    pristine        = false
                    ux.will_animate = true
                if [ rview ] ev.no_default = true
                return
        # the pinned band is drawn over everything else: a press on one
        # of its rows goes to that declaration and nothing else sees the
        # press
        pel  : (layers) ? cast EditorLayer [ layers['content'] ] : null
        pins : vec i32 pinned_rows[]
        if [ pel && pel.bounds && pins.count > 0 ]
            plh  : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
            # event pos is CONTENT space; the band is at the top of the
            # VIEW
            prel : f32 [ ev.mouse.pos.y - pel.bounds.y - scroll.y ]
            if [ prel >= 0.0 && prel < f32[ pins.count ] * plh ]
                pi : i32 [ prel / plh ]
                pr : i32 [ pins[ pi ] ]
                # shift goes to the next header under the same parent
                ptree : vec i32 cur_buf.line_parent
                pends : vec i32 cur_buf.line_last
                psrc  : i32 [ row_src[ pr ] ]
                if [
                    ev.key.shift && ptree && pends && psrc >= 0
                    && psrc < ptree.count ]
                    ppar  : i32 [ ptree[ psrc ] ]
                    plast : i32 [
                        (ppar >= 0) ? i32[ pends[ ppar ] ]
                        : i32[ ptree.count ] - 1 ]
                    for [ pj: i32 [ i32[ pends[ psrc ] ] + 1 ],
                          pj <= plast, pj += 1 ]
                        if [
                            i32[ ptree[ pj ] ] == ppar
                            && i32[ pends[ pj ] ] > pj ]
                            pr = vis_row[ pj ]
                            break
                # the line lands exactly where its header row was, so
                # the rows above it stay pinned and it reads as the same
                # thing the column comes off the header's own row, as a
                # click on that line would
                pcw  : f32 [ (cw_cache > 0.0) ? cw_cache : 8.0 ]
                pvx  : f32 [
                    round[
                        (ev.mouse.pos.x - pel.bounds.x - gutter_w - row_indent[ pr ]) / pcw ] ]
                pcl  : i32 [ model_col[ line_get[ pr ], i32[ pvx ] ] ]
                sel_line      = pr
                anchor_line   = pr
                sel_col       = pcl
                anchor_col    = pcl
                # cmd/ctrl on a header goes where its token resolves, as
                # in the body
                if [
                    (ev.key.ctrl || ev.key.meta)
                    && jump_to_def[ pr, pcl ] ]
                    ev.no_default     = true
                    ev.no_propagation = true
                    return
                scroll.y      = f32[ pr - pi ] * plh
                if [ scroll.y < 0.0 ] scroll.y = 0.0
                scroll_target = scroll.y
                # no easing left over to pull it a pixel off the row
                scroll_goal   = scroll.y
                scroll_anim   = false
                pristine      = false
                ev.no_default     = true
                ev.no_propagation = true
                return
        # the rail is first in line: nothing else may eat its press
        rail9 : i32 [ tool_hit[ ev.mouse.pos.x, ev.mouse.pos.y ] ]
        log 'EDPRESS rv={(run_view) ? 1 : 0} av={(app_view) ? 1 : 0} rail={rail9} hits={(show_hits) ? 1 : 0}'
        if [ rail9 >= 0 ]
            press_tool[ rail9 ]
            ev.no_default = true
            return
        if [ run_view && !stopped[] && app_view ]
            if [ run_view.view_press*[ ev ] ]
                if [ ux ] ux.set_focus[ a ]
                ev.no_default = true
                return
        if [ rview && !rview.view_text*[ rview.view_sel ] ]
            if [ rview.view_press*[ ev ] ]
                ev.no_default = true
                return
        if [ debugger ]
            if [ ev.target.id == 'dbg_continue' ]
                if [ debugger.running ] debugger.pause[]
                el                      debugger.cont[]
                ev.no_default = true
                return
            if [ ev.target.id == 'dbg_step_over' ]
                debugger.step_over[]
                ev.no_default = true
                return
            if [ ev.target.id == 'dbg_step_into' ]
                debugger.step_into[]
                ev.no_default = true
                return
            if [ ev.target.id == 'dbg_step_out' ]
                debugger.step_out[]
                ev.no_default = true
                return
            # StepButtons renames itself to the pressed segment
            if [ ev.target.id == 'step_next' ]
                debugger.step_over[]
                ev.no_default = true
                return
            if [ ev.target.id == 'step_in' ]
                debugger.step_into[]
                ev.no_default = true
                return
            if [ ev.target.id == 'step_out' ]
                debugger.step_out[]
                ev.no_default = true
                return
        if [ ev.target != a ]
            return
        is_dbl : bool [ ev.mouse.double_click ]
        ele   : (layers) ? cast EditorLayer [ layers['content'] ] : null
        rel_x : f32 [ (ele) ? ev.mouse.pos.x - ele.bounds.x : 0.0 ]
        dbg_el : element (elements) ? elements['dbg'] : null
        if [
            ele && dbg_el && dbg_el.bounds
            && rel_x > ele.bounds.w - dbg_el.bounds.w ]
            return
        if [ debug_vars ]
            lhp : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
            cwp : f32 [ (cw_cache > 0.0) ? cw_cache : 8.0 ]
            ry  : f32 [ ev.mouse.pos.y - ele.bounds.y ]
            if [ ry >= 0.0 ]
                cln : i32      [
                    clamp[ ry / lhp, 0, line_count[] - 1 ] ]
                rv  : variable row_var[ cln ]
                log 'var click row={cln} rel_x={rel_x} rowvar={(rv) ? rv.name : "-"} base={(base_var_of[ row_src[ cln ] ]) ? base_var_of[ row_src[ cln ] ].name : "-"}'
                if [ rv ]
                    # the [+]/[-] sits right after the row's text; the
                    # text itself selects like a comment
                    tgx : f32 [
                        gutter_w + row_indent[ cln ]
                        + f32[ line_get[ cln ].count ] * cwp ]
                    if [ var_expandable[ rv ] && rel_x >= tgx ]
                        if [ rv.expanded ] collapse_from[ rv ]
                        el                 expand_only[ rv ]
                        # a sibling above may have closed: keep the
                        # clicked row where it was
                        flat_lines = -1
                        rebuild_flat[]
                        nr : i32 [ var_row[ rv ] ]
                        if [ nr >= 0 ] scroll.y += f32[ nr - cln ] * lhp
                        if [ scroll.y < 0.0 ] scroll.y = 0.0
                        scroll_target = scroll.y
                        scroll_goal   = scroll.y
                        scroll_anim   = false
                        pristine = false
                        ux.will_animate = true
                        return
                el
                    bv : variable base_var_of[ row_src[ cln ] ]
                    if [ bv ]
                        if [ var_expandable[ bv ] ]
                            axp : f32 [
                                gutter_w + f32[ ann_col[ cln ] ] * cwp ]
                            if [ rel_x > axp ]
                                src9 : i32 [ row_src[ cln ] ]
                                if [ bv.expanded && open_src == src9 ]
                                    collapse_from[ bv ]
                                el
                                    open_src = src9
                                    expand_only[ bv ]
                                # rows above may have opened or closed:
                                # keep the clicked line where it was
                                flat_lines = -1
                                rebuild_flat[]
                                scroll.y += f32[
                                    vis_row[ src9 ] - cln ] * lhp
                                if [ scroll.y < 0.0 ] scroll.y = 0.0
                                scroll_target = scroll.y
                                scroll_goal   = scroll.y
                                scroll_anim   = false
                                pristine = false
                                ux.will_animate = true
                                return
        if [ ele && rel_x < gutter_w ]
            lh    : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
            rel_y : f32 [
                ev.mouse.pos.y - ele.bounds.y
                - ((show_hits) ? 10.0 : 0.0) ]
            if [ rel_y < 0.0 ] return
            vrl   : i32 [ clamp [ rel_y / lh, 0, line_count[] - 1 ] ]
            if [ row_header[ vrl ] ]
                # nav rows never react to a gutter press
                if [ nav_list ] return
                if [ show_hits && hits ]
                    remove_group[ vrl ]
                    pristine = false
                return
            if [ show_hits && hits ]
                remove_hit[ vrl ]
                pristine = false
                return
            if [ row_var[ vrl ] ] return
            # diff rows don't map to file lines
            if [ diff_commit ] return
            # shift turns the outline on; any press on an outline row
            # leaves it
            if [ ev.key.shift || outline ]
                # only the lit gutters take it; a miss sets no
                # breakpoint
                if [ outline_line[ row_src[ vrl ] ] ]
                    outline_toggle[ vrl ]
                return
            # the red edge of a removed run shows its lines; a ghost row
            # hides them
            if [ row_ghost[ vrl ] ]
                ghost_toggle[ ghost_hunk ]
                return
            # a press within a removal edge's band shows its lines; the
            # rest of the gutter row is the breakpoint's
            geh : i32 [ edge_hunk[ vrl, rel_y - f32[ vrl ] * lh, lh ] ]
            if [ geh >= 0 ]
                ghost_toggle[ geh ]
                return
            ln    : i32 [ row_src[ vrl ] ]
            key   : '{src}:{ln + 1}'
            cur   : breakpoints[key]
            if [ cur ]
                breakpoints.rm[ key ]
            el
                breakpoints[key] = string[]
            log 'breakpoint toggle {key} on={(cur) ? 0 : 1}'
            orbb : cast orbiter [ ux.app_object ]
            if [ orbb ] orbb.breakpoints_changed[]
            pristine = false
            return
        # a press on an outline row opens the full text at that line
        if [ outline && ele ]
            olh : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
            ory : f32 [ ev.mouse.pos.y - ele.bounds.y ]
            if [ ory >= 0.0 && ory < f32[ line_count[] ] * olh ]
                outline_toggle[ i32[ ory / olh ] ]
            return
        if [ !ev.key.shift ]
            # a definition jump consumed the click: we are in another
            # file now, so no anchor and no drag from the one we left
            if [ place_cursor[ ev ] ] return
            anchor_line = sel_line
            anchor_col  = sel_col
            # double-click selects the whole word under the caret
            if [ is_dbl ] select_word[]
        el
            if [ place_cursor[ ev ] ] return
        dragging = true
        pristine = false
        # the status bar's tooltip follows the caret: redraw it
        if [ ux ] ux.restyle = true
        log 'TIPPRESS pane={pane_index} sel={sel_line} col={sel_col} tok={cursor_token[]} scope={scope_of[ sel_line ]} vars={(debug_vars) ? debug_vars.count : -1} hits={(show_hits) ? 1 : 0} nav={(nav_list) ? 1 : 0}'

    func on_move [ ev: Event ]
        if [ run_view && ux.locked == a ]
            run_view.view_lock_move*[ ev ]
            return
        # not just when maximised: the side panel forwards hover too;
        # with the source showing, the moves are the editor's
        if [ run_view && app_view ]
            if [ run_view.view_move*[ ev ] ] return
        if [ !scroll_dragging && rview && rview.view_move*[ ev ] ]
            pristine = false
            ux.will_animate = true
            return
        ele : (layers) ? cast EditorLayer [ layers['content'] ] : null
        if [ scroll_dragging && ele ]
            sb : ScrollLayer (layers) ? cast ScrollLayer [
                layers['scrollbar'] ] : null
            if [ sb ]
                sy : f32 [
                    sb.drag_to[
                        ev.mouse.pos.y - ele.bounds.y - scroll.y ] ]
                if [ sy >= 0.0 ] scroll.y = sy
            scroll_target = scroll.y
            pristine = false
            ux.will_animate = true
            return
        if [ dragging ]
            place_cursor[ ev ]
            pristine = false
            return
        if [ !ele ] return
        lh    : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
        rel_y : f32 [
            ev.mouse.pos.y - ele.bounds.y - ((show_hits) ? 10.0 : 0.0) ]
        rel_x : f32 [ ev.mouse.pos.x - ele.bounds.x ]
        hl    : i32  [ 0 ]
        if [ grid_mode && show_hits && hits ]
            hl = grid_hit_index[ rel_x, rel_y, ele.bounds.w ]
        el
            hl = clamp [ rel_y / lh, 0, line_count[] - 1 ]
        th : i32 [ tool_hit[ ev.mouse.pos.x, ev.mouse.pos.y ] ]
        if [ th != tool_hover ]
            tool_hover = th
            pristine = false
            ux.will_animate = true
        if [ th >= 0 ] hl = -1
        hg    : bool [ rel_x >= 0.0 && rel_x < gutter_w ]
        if [ rel_y < 0 ]
            hl  = -1
            hg = false
        # the git rail in the scrollbar's track under the pointer, the
        # thumb aside
        rl1 : i32 [ rail_at[ ev.mouse.pos.x, ev.mouse.pos.y ] + 1 ]
        sbh : ScrollLayer (layers) ? cast ScrollLayer [
            layers['scrollbar'] ] : null
        if [ rl1 > 0 && sbh && ele && ele.bounds ]
            vyh : f32 [ ev.mouse.pos.y - ele.bounds.y - scroll.y ]
            if [ vyh >= sbh.thumb_y_px && vyh < sbh.thumb_y_px + sbh.thumb_h_px ]
                rl1 = 0
        if [ rl1 != rail_hover1 ]
            rail_hover1 = rl1
            if [ rl1 > 0 ] peek_fill[ rl1 - 1 ]
            pristine = false
            ux.will_animate = true
        # the preview follows the pointer along the track
        if [ rl1 > 0 && ele && ele.bounds ]
            peek_y = ev.mouse.pos.y - ele.bounds.y - scroll.y
            pristine = false
        if [ rl1 > 0 ] hl = -1
        # the pinned band hides the rows under it: the hover is the
        # band's
        pins : vec i32 pinned_rows[]
        hp   : i32 [ -1 ]
        # rel_y is CONTENT space; the band is at the top of the VIEW
        vy   : f32 [ rel_y - scroll.y ]
        if [
            pins.count > 0 && vy >= 0.0 && vy < f32[ pins.count ] * lh ]
            hl = -1
            hg = false
            hp = i32 [ vy / lh ]
        # a scrollbar drag crossing the band is not a hover on its rows
        if [ scroll_dragging ] hp = -1
        # the error band at the foot hides the rows under it too
        herr : bool [
            err_band_text[] != null && vy >= ele.bounds.h - lh
            && vy < ele.bounds.h ]
        if [ herr ]
            hl = -1
            hg = false
        if [ herr != hover_err ]
            hover_err = herr
            pristine  = false
            ux.will_animate = true
            ux.restyle = true
        if [ hp != hover_pin ]
            hover_pin = hp
            pristine  = false
            ux.will_animate = true
        ha : i32 [ -1 ]
        if [ hl >= 0 && row_var[ hl ] == null ]
            bvh : variable base_var_of[ row_src[ hl ] ]
            if [ bvh && var_expandable[ bvh ] ]
                cwh : f32 [ (cw_cache > 0.0) ? cw_cache : 8.0 ]
                axh : f32 [ gutter_w + f32[ ann_col[ hl ] ] * cwh ]
                if [ rel_x > axh ] ha = hl
        if [ ha != hover_ann ]
            hover_ann = ha
            pristine = false
            ux.will_animate = true
        if [ hl != hover_line || hg != hover_gutter ]
            in_list : bool [ finder_list || show_hits || outline ]
            oh : bool [
                hover_line >= 0
                && (row_header[ hover_line ] || (hover_line > 0 && row_header[ hover_line - 1 ])) ]
            nh : bool [
                hl >= 0
                && (row_header[ hl ] || (hl > 0 && row_header[ hl - 1 ])) ]
            hover_line   = hl
            hover_gutter = hg
            if [ in_list || oh || nh ]
                pristine = false
                ux.will_animate = true
        # a removal edge lights while the gutter pointer is in its band:
        # a change repaints, since plain rows never repaint on hover
        he : bool [
            hg && hl >= 0
            && edge_hunk[ hl, rel_y - f32[ hl ] * lh, lh ] >= 0 ]
        if [ he != hover_edge ]
            hover_edge = he
            pristine = false
            ux.will_animate = true

    func on_leave [ ev: Event ]
        if [
            hover_line != -1 || hover_gutter || hover_ann != -1
            || tool_hover != -1 ]
            hover_line   = -1
            hover_gutter = false
            hover_edge   = false
            hover_ann    = -1
            tool_hover   = -1
            pristine = false

    func on_release [ ev: Event ]
        if [ run_view ] run_view.view_release*[ ev ]
        if [ rview ] rview.view_release*[ ev ]
        dragging        = false
        scroll_dragging = false
        sb : ScrollLayer (layers) ? cast ScrollLayer [
            layers['scrollbar'] ] : null
        if [ sb ]
            sb.active = false
            ux.will_animate = true

    func on_wheel [ ev: Event ]
        # the app takes the wheel only while the pane shows it
        if [ run_view && app_view && run_view.view_wheel*[ ev ] ] return
        lh : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
        if [ ev.key.shift ]
            cw : f32 [ (cw_cache > 0.0) ? cw_cache : 8.0 ]
            scroll.x = scroll.x - ev.mouse.wheel_delta.y * cw * 3.0
            if [ scroll.x < 0.0 ] scroll.x = 0.0
        el
            pending_wheel = pending_wheel + ev.mouse.wheel_delta.y
        pristine = false
        ux.will_animate = true

    func ensure_caret_visible []
        if [ sel_line < 0 ] return
        ele : (layers) ? cast EditorLayer [ layers['content'] ] : null
        vh  : f32 [ (ele && ele.bounds) ? ele.bounds.h : 400.0 ]
        lh  : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
        top : f32 [ sel_line ] * lh
        bot : top + lh
        if [ bot > scroll.y + vh ] scroll.y = bot - vh
        if [ top < scroll.y ]      scroll.y = top
        scroll_target = scroll.y
        pristine = false
        ux.will_animate = true

    func on_char [ ev: Event ]
        if [ run_view && app_view && !run_view.held && !run_view.ended && !nav_list && !show_hits && !stopped[] ]
            return
        if [ flat_active && !ghost_only[] ] return
        if [ row_ghost[ sel_line ] ] return
        if [ line_count[] <= 0 ] return
        if [ sel_line < 0 ] sel_line = 0
        if [ sel_col  < 0 ] sel_col  = 0
        ch   : string [ ev.key.text ]
        if [ ch.count == 0 || (ch[0] >= 0 && ch[0] < 32) ] return
        begin_edit[ 0 ]
        delete_selection[]
        row  : i32 [ sel_line ]
        # file-title slots are not editable
        if [ row_header[ row ] ] return
        col  : i32 [ sel_col ]
        line : line_get[ row ]
        ed_set[ row,
                line.mid[0, col] + ch
                + line.mid[col, line.count - col] ]
        sel_col += 1
        anchor_line = sel_line
        anchor_col  = sel_col
        end_edit[]
        ensure_caret_visible[]
        pristine = false

    func insert_text [ s: string ]
        if [ !s || s.count == 0 ] return
        if [ line_count[] <= 0 ] return
        begin_edit[ 0 ]
        delete_selection[]
        if [ sel_line < 0 ] sel_line = 0
        if [ sel_col  < 0 ] sel_col  = 0
        row : i32 [ sel_line ]
        if [ row_header[ row ] ]
            end_edit[]
            return
        col    : i32 [ sel_col ]
        line   : string line_get[ row ]
        prefix : string line.mid[ 0, col ]
        suffix : string line.mid[ col, line.count - col ]
        parts  : s.split[ '\n' ]
        # split drops the last piece when the text ends on a newline
        if [ s[ s.count - 1 ] == 10 ] parts.push[ string [ '' ] ]
        if [ parts.count <= 1 ]
            ed_set[ row, prefix + s + suffix ]
            sel_col = col + s.count
        el
            # the tokens after the caret move to the last new line
            moved : vec i32 regs_from[ src_row[ row ], col ]
            ed_set[ row, prefix + parts[0] ]
            for [ i: i32 1, i < parts.count, i += 1 ]
                val : string [
                    (i == parts.count - 1) ? (parts[i] + suffix)
                    : parts[i] ]
                ed_insert[ row + i, val ]
            last_line : string parts[ parts.count - 1 ]
            sel_line = row + parts.count - 1
            sel_col  = last_line.count
            regs_to[ src_row[ sel_line ], moved, last_line.count - col ]
        anchor_line = sel_line
        anchor_col  = sel_col
        end_edit[]
        ensure_caret_visible[]
        pristine = false

    func selected_text [] -> string
        if [ sel_line < 0 ] return ''
        al : i32 [ anchor_line ]
        ac : i32 [ anchor_col ]
        sl : i32 [ sel_line ]
        sc : i32 [ sel_col ]
        before : bool [ al < sl || (al == sl && ac <= sc) ]
        s_line : i32 [ (before) ? al : sl ]
        s_col  : i32 [ (before) ? ac : sc ]
        e_line : i32 [ (before) ? sl : al ]
        e_col  : i32 [ (before) ? sc : ac ]
        out : string ''
        for [ li: i32 s_line, li <= e_line, li += 1 ]
            ln : string line_get[ li ]
            c0 : i32 [ (li == s_line) ? s_col : 0 ]
            c1 : i32 [ (li == e_line) ? e_col : ln.count ]
            if [ c0 < 0 ] c0 = 0
            if [ c1 > ln.count ] c1 = ln.count
            if [ c1 > c0 ] out = out + ln.mid[ c0, c1 - c0 ]
            if [ li < e_line ] out = out + '\n'
        return out

    func has_selection [] -> bool
        return sel_line >= 0 &&
            (anchor_line != sel_line || anchor_col != sel_col)

    func delete_selection [] -> bool
        if [ !has_selection[] || show_hits ] return false
        before : bool [
            anchor_line < sel_line
            || (anchor_line == sel_line && anchor_col <= sel_col) ]
        s_line : i32 [ (before) ? anchor_line : sel_line ]
        s_col  : i32 [ (before) ? anchor_col  : sel_col ]
        e_line : i32 [ (before) ? sel_line : anchor_line ]
        e_col  : i32 [ (before) ? sel_col  : anchor_col ]
        if [ s_line == e_line ]
            ln : line_get[ s_line ]
            ed_set[ s_line,
                    ln.mid[0, s_col] + ln.mid[e_col, ln.count - e_col] ]
        el
            sline  : line_get[ s_line ]
            eline  : line_get[ e_line ]
            merged : sline.mid[0, s_col] + eline.mid[e_col,
                                                      eline.count
                                                      - e_col]
            for [ r: i32 e_line, r > s_line, r -= 1 ]
                ed_remove[ r ]
            ed_set[ s_line, merged ]
        sel_line    = s_line
        sel_col     = s_col
        anchor_line = s_line
        anchor_col  = s_col
        pristine = false
        return true

    # the view a history point keeps; the plain editor is ''
    func view_key [] -> string
        # the file's own view (the editor, say) is no view: code level
        if [ !view_name || view_name == fallback_view_for[ src ] ]
            return ''
        return view_name

    # the dialog level: the views walked from the editor, the
    # editor ('') first; the code level is nav
    func view_note [ nm: string ]
        if [ !nm || nm.count == 0 ]
            view_hist = null
            return
        if [ !view_hist || view_key[].count == 0 ]
            view_hist = vec string [] [ '' ]
            view_ix   = 0
        while [ view_hist.count > view_ix + 1 ]
            view_hist.pop[]
        view_hist.push[ nm ]
        view_ix = view_hist.count - 1

    func view_can [ dir: i32 ] -> bool
        if [ !view_hist || view_key[].count == 0 ] return false
        n9 : i32 [ view_ix + dir ]
        return n9 >= 0 && n9 < view_hist.count

    func nav_walk [ dir: i32 ]
        # a hosted app walks its own history
        if [ app_view && run_view && run_view.slot >= 0 ]
            host_post2[ run_view.slot, 1, i32[ HM.nav ], dir, 0, 0 ]
            return
        # in a view the arrows walk the views; the editor ends it
        if [ view_key[].count > 0 ]
            if [ view_can[ dir ] ]
                view_ix   = view_ix + dir
                view_name = view_hist[ view_ix ]
                if [ view_name.count > 0 ] git_on = view_name == 'git'
                if [ view_name.count == 0 ] view_hist = null
                load_file[]
                pristine = false
            return
        if [ !nav || !src ] return
        nav.save_top[ pane_index, '{src.absolute[]}', sel_line, sel_col,
                      scroll.y ]
        np : NavPoint
        if [ dir < 0 ]
            np = nav.back[]
        el
            np = nav.forward[]
        if [ !np ] return
        same : bool [ '{src.absolute[]}' == np.path ]
        if [ !same ]
            # through the PANE, not by assigning src: orbiter owns which
            # file a pane holds, and setting src alone left it pointing
            # at the old one, so the line landed in the wrong file
            ob : cast orbiter [ ux.app_object ]
            if [ ob ] ob.bind_pane[ path '{np.path}', pane_index ]
            src = path '{np.path}'
            load_file[]
        sel_line      = np.line
        sel_col       = np.col
        anchor_line   = np.line
        anchor_col    = np.col
        scroll.y      = np.scroll_y
        scroll_target = np.scroll_y
        ensure_caret_visible[]
        pristine      = false

    func on_key [ ev: Event ]
        note_mod[ ev ]
        if [ ev.key.state ] caret_touch += 1
        # the finder owns the keyboard while it is up: forwarding to the
        # app ate escape, so the list could not be closed
        ui_keys : bool [ nav_list || show_hits ]
        if [
            run_view && app_view && !run_view.held && !run_view.ended
            && !ui_keys && !ev.key.ctrl && !ev.key.meta ]
            run_view.on_key*[ ev ]
            return
        if [ rview && !ui_keys && !ev.key.ctrl && !ev.key.meta ]
            if [ rview.continuous*[] ]
                rview.on_key*[ ev ]
                return
        if [ !ev.key.state ] return
        mk : i32 [ i32 ev.key.unicode ]
        if [ mk >= 340 && mk <= 347 ] return
        if [ mk == 294 ]
            if [ run_view ]
                run_view.restart*[ ev.key.shift ]
            el
                toggle_app_run[ ev.key.shift ]
            return
        if [ mk == 297 && run_view ]
            orb8 : cast orbiter [ ux.app_object ]
            if [ orb8 ] orb8.app_pause_toggle[ run_view ]
            if [ app_view == run_view.is_paused*[] ] toggle_app_view[]
            return
        # escape leaves the outline for where it was entered from
        if [ ev.key.unicode == 256 && outline ]
            outline_cancel[]
            return
        # escape collapses the innermost open field expansion
        if [ ev.key.unicode == 256 && collapse_last[] ]
            pristine = false
            if [ ux ] ux.will_animate = true
            return

        # Key.S
        if [ (ev.key.ctrl || ev.key.meta) && ev.key.unicode == 83 ]
            save_current[]
            pristine = false
            return

        # Key.R
        if [ (ev.key.ctrl || ev.key.meta) && ev.key.unicode == 82 ]
            toggle_app_run[ ev.key.shift ]
            return

        # Key.C
        if [ (ev.key.ctrl || ev.key.meta) && ev.key.unicode == 67 ]
            txt : string selected_text[]
            log 'copy: len={txt.count} ux={(ux) ? 1 : 0}'
            if [ txt.count > 0 && ux ] ux.set_clipboard[ txt ]
            return

        # Key.X
        if [ (ev.key.ctrl || ev.key.meta) && ev.key.unicode == 88 ]
            txt : string selected_text[]
            log 'cut: len={txt.count} ux={(ux) ? 1 : 0}'
            if [ txt.count > 0 && ux ]
                ux.set_clipboard[ txt ]
                delete_selection[]
                ux.will_animate = true
            return

        # ctrl/cmd+k cuts the caret's line; presses in a row collect
        # Key.K
        if [ (ev.key.ctrl || ev.key.meta) && ev.key.unicode == 75 ]
            cut_line[]
            return
        kill_chain = false

        # Key.V
        if [ (ev.key.ctrl || ev.key.meta) && ev.key.unicode == 86 ]
            if [ ux ]
                clip : string ux.get_clipboard[]
                log 'paste: len={clip.count}'
                if [ clip && clip.count > 0 ]
                    insert_text[ clip ]
                    ux.will_animate = true
            return

        # Key.Z
        if [ (ev.key.ctrl || ev.key.meta) && ev.key.unicode == 90 ]
            if [ ev.key.shift ]
                redo[]
            el
                undo[]
            ux.will_animate = true
            return
        # Key.Y
        if [ (ev.key.ctrl || ev.key.meta) && ev.key.unicode == 89 ]
            redo[]
            ux.will_animate = true
            return

        if [
            (ev.key.ctrl || ev.key.meta)
            && (ev.key.unicode == 263 || ev.key.unicode == 262) ]
            # the nav view up: its folders, not this file's places
            ob : cast orbiter [ ux.app_object ]
            if [ ob && ob.nav_showing ]
                ob.nav_step[ (ev.key.unicode == 263) ? -1 : 1 ]
            el
                nav_walk[ (ev.key.unicode == 263) ? -1 : 1 ]
            return

        if [ line_count[] <= 0 ] return
        if [ sel_line < 0 ] sel_line = 0
        if [ sel_col  < 0 ] sel_col  = 0
        row  : i32 [ sel_line ]
        col  : i32 [ sel_col ]
        key  : i32 [ ev.key.unicode ]

        if [ key == 266 || key == 267 ]    # Key.PageUp / Key.PageDown
            ele  : (layers) ? cast EditorLayer [
                layers['content'] ] : null
            vh   : f32 [ (ele && ele.bounds) ? ele.bounds.h : 400.0 ]
            lh   : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
            half : i32 [ (vh / lh) * 0.5 ]
            if [ half < 1 ] half = 1
            if [ key == 266 ]    # Key.PageUp
                sel_line = snap_row[
                    clamp[ sel_line - half, 0, line_count[] - 1 ] ]
                scroll.y = scroll.y - f32[ half ] * lh
            el
                sel_line = snap_row[
                    clamp[ sel_line + half, 0, line_count[] - 1 ] ]
                scroll.y = scroll.y + f32[ half ] * lh
            scroll_target = scroll.y
            sel_col  = clamp[ sel_col, 0, line_get[ sel_line ].count ]
            if [ !ev.key.shift ]
                anchor_line = sel_line
                anchor_col  = sel_col
            pristine = false
            return

        edits_locked : bool [
            row_header[ row ] || (flat_active && !ghost_only[])
            || row_ghost[ row ] ]

        # printables arrive via on_char — they must not collapse the
        # anchor
        if [ key != 257 && key != 258 && key != 259 && !(key >= 262 && key <= 265) ]
            return

        if [ key == 257 ]    # Key.Enter
            if [ show_hits || edits_locked ] return
            begin_edit[ 1 ]
            if [ delete_selection[] ]
                row = sel_line
                col = sel_col
            line  : line_get[ row    ]
            left  : line.mid[ 0, col ]
            right : line.mid[col, line.count - col]
            # the new line keeps this one's indent (up to the caret)
            ni : i32 [ 0 ]
            while [ ni < col && (line[ ni ] == 32 || line[ ni ] == 9) ]
                ni += 1
            # the tokens after the caret move to the new line
            moved : vec i32 regs_from[ src_row[ row ], col ]
            ed_set[ row, left ]
            ed_insert[ row + 1, line.mid[ 0, ni ] + right ]
            regs_to[ src_row[ row + 1 ], moved, ni - col ]
            sel_line += 1
            sel_col   = ni
            anchor_line = sel_line
            anchor_col  = sel_col
            end_edit[]

        # Key.Tab — insert a real tab. tabs are the primary indent;
        el [ key == 258 ]
            if [ show_hits || edits_locked ] return
            # a tab is an inserted char — coalesces with the typing run
            begin_edit[ 0 ]
            if [ delete_selection[] ]
                row = sel_line
                col = sel_col
            line : line_get[ row ]
            ed_set[ row,
                    line.mid[0, col] + '\t'
                    + line.mid[col, line.count - col] ]
            sel_col += 1
            anchor_line = sel_line
            anchor_col  = sel_col
            end_edit[]

        el [ key == 259 ]    # Key.Backspace
            if [ edits_locked ] return
            # delete group (kind 2): coalesces a run of backspaces
            begin_edit[ 2 ]
            if [ delete_selection[] ]
                pristine = false
            el [ col > 0 ]
                line : line_get[ row ]
                ed_set[ row,
                        line.mid[0, col - 1]
                        + line.mid[col, line.count - col] ]
                sel_col -= 1
            el [ row > 0 && !show_hits ]
                prev : line_get[ row - 1 ]
                sel_col  = prev.count
                ed_set[ row - 1, prev + line_get[ row ] ]
                ed_remove[ row ]
                sel_line -= 1
            end_edit[]

        el [ key == 265 ]    # Key.Up
            if [ finder_list || show_hits ]
                # off the top of the list: focus goes back to the title
                if [ !hover_step[ -1 ] ]
                    hover_line = -1
                    orb5 : cast orbiter [ ux.app_object ]
                    if [ orb5 ] orb5.focus_finder[]
            el
                np : i32 [ prev_editable[ sel_line - 1 ] ]
                if [ np >= 0 ]
                    sel_line = np
                    sel_col = clamp[ sel_col, 0,
                                     line_get[ sel_line ].count ]

        el [ key == 264 ]    # Key.Down
            if [ finder_list || show_hits ]
                hover_step[ 1 ]
            el
                np : i32 [ next_editable[ sel_line + 1 ] ]
                if [ np < line_count[] ]
                    sel_line = np
                    sel_col = clamp[ sel_col, 0,
                                     line_get[ sel_line ].count ]

        el [ key == 263 ]    # Key.Left
            if [ col > 0 ]
                sel_col -= 1
            el [ row > 0 ]
                np : i32 [ prev_editable[ row - 1 ] ]
                if [ np >= 0 ]
                    sel_line = np
                    sel_col = line_get[ np ].count

        el [ key == 262 ]    # Key.Right
            if [ col < line_get[ row ].count ]
                sel_col += 1
            el [ row < line_count[] - 1 ]
                np : i32 [ next_editable[ row + 1 ] ]
                if [ np < line_count[] ]
                    sel_line = np
                    sel_col = 0

        if [ !ev.key.shift ]
            anchor_line = sel_line
            anchor_col  = sel_col
        ensure_caret_visible[]
        pristine = false