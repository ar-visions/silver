                    if [ !showing && (li == lo || li == hi) ]
                        cv.save[ ]
                        # stroked, so they take the pointer's near light
                        editor.ux.near_light_on[ cv, editor, 0.0, 0.0 ]
                        cv.fill_color[ rgba['#0000'] ]
                        cv.stroke_color[
                            (line_edge) ? line_edge
                            : rgba['#ffffff22'] ]
                        cv.stroke_width[ 1.0 ]
                        cv.stroke_offset[ 0.0 ]
