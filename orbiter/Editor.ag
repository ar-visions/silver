							bounds.x + 1.0, yg + 1.0,
							bounds.w - rin - 3.0,
							lh - 2.0, 3.0, 3.0, 3.0, 3.0 ]
                    el
                        cv.rect_to[ bounds.x, yg, bounds.w - rin - 1.0,
                                    lh ]
                    cv.paint[ ]
