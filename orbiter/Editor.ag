        el
            hl = clamp [ rel_y / lh, 0, line_count[] - 1 ]
        th9 : i32 [ tool_hit[ ev.mouse.pos.x, ev.mouse.pos.y ] ]
        if [ th9 != tool_hover ]
            tool_hover = th9
            pristine = false
            ux.will_animate = true
        if [ th9 >= 0 ] hl = -1
        hg    : bool [ rel_x >= 0.0 && rel_x < gutter_w ]
        if [ rel_y < 0 ]
            hl  = -1
            hg = false
        ha : i32 [ -1 ]
        if [ hl >= 0 && row_var[ hl ] == null ]
            bvh : variable base_var_of[ row_src[ hl ] ]
            if [ bvh && var_expandable[ bvh ] ]
                cwh : f32 [ (cw_cache > 0.0) ? cw_cache : 8.0 ]
                axh : f32 [ gutter_w + f32[ ann_col[ hl ] ] * cwh ]
