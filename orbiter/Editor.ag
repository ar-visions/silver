extend orbiter

import <signal.h>

class FileBuf
    public lines : list string
    public mtime : i64 [ 0 ] # test

    public hist       : list EditAction
    public hist_i     : i32 [ 0 ]
    # history index of the last buffer<->disk agreement (save/reload)
    public sync_i     : i32 [ 0 ]
    # one vec ColorRegion per source line, parallel to lines
    public line_regs  : vec Au
    # the definition each line sits inside, parallel to lines
    public line_scope : vec Au

class FindHit
    public is_header : bool
    public text      : string
    public dir       : string
    public is_dir    : bool
    public is_spacer : bool
    public session   : string
    public file      : path
    public line      : i32
    # bordered trailing row: enters the title bar's create mode
    public is_newfile : bool
    # directory holds <stem>/<stem>.ag: a silver module
    public is_module  : bool

class VRow
    public src   : i32 [ -1 ]
    public var   : variable
    public depth : i32 [ 0 ]

class LineOp
    public at     : i32 [ 0 ]
    public kind   : i32 [ 0 ]
    public before : string
    public after  : string

class EditAction
    public ops : vec LineOp
    # set = whole-buffer swap (disk reload); ops are unused then
    public full_before : list string
    public full_after  : list string
    public sl0 : i32 [ 0 ]   # caret line/col before the group
    public sc0 : i32 [ 0 ]
    public sl1 : i32 [ 0 ]   # caret line/col after the group
    public sc1 : i32 [ 0 ]

class ColorRegion
    public col   : i32 [ 0 ]
    public len   : i32 [ 0 ]
    public color : rgba
    # the token's own kind, not just its colour: navigation needs to
    # tell a module name from an ordinary identifier
    public kind  : i32 [ 0 ]
    # where this token was declared, straight from the syntax map. a C
    # function is not a type, so no registry lookup can find it
    public dsrc  : string
    public dline : i32 [ 0 ]

class EdLineCache
    mutable canvas : Canvas
    mutable hash   : i64 [ -1 ]
    mutable frame  : i32 [ -1 ]

class ResourceView
    mutable src    : path
    mutable loaded : bool
    func extensions [] -> vec string
        return vec string []
    # rail name; '' = not user-selectable, keyed by class ident
    func view_id [] -> string
        return ''
    # which files this view can open
    func applies [] -> FileType
        return FileType.agnostic
    # a view built from elements composes here instead of painting
    func view_element [] -> element
        return null
    # views that scroll in the pane report their extent; 0 = no scrolling
    func content_height [ cv: Canvas, bounds: rect ] -> f32
        return 0.0
    func content_width [ cv: Canvas, bounds: rect ] -> f32
        return 0.0
    # the editor owns the scroll value; the view is told where it landed
    func set_scroll [ x: f32, y: f32 ]
        return
    func render [ cv: Canvas, bounds: rect ]
        return
    # drop held resources when the pane switches away or closes.
    func release []
        loaded = false
    func is_app_host [] -> bool
        return false
    func restart [ clean: bool ]
        return
    func pause_toggle []
        return
    func is_paused [] -> bool
        return false
    func continuous [] -> bool
        return false
    func title_elements [] -> Elements
        return null
    func title_press [ tid: string, ev: Event ] -> bool
        return false
    mutable view_sel : i32
    func views [] -> vec string
        return null
    func view_unload [ which: i32 ]
        return
    func view_text [ which: i32 ] -> bool
        return false
    func view_lines [ which: i32 ] -> list string
        return null
    func commit_line [ text: string ] -> bool
        return false
    mutable vx : f32
    mutable vy : f32
    mutable vw : f32
    mutable vh : f32
    # the owner's scroll at draw time. find_target folds scroll INTO
    # ev.mouse.pos, so on_press gets CONTENT space -- right for text,
    # wrong for a hosted app, which never scrolls with the source. the
    # fit rect is viewport space, so the scroll comes back out first
    mutable vsx : f32
    mutable vsy : f32
    func view_press [ ev: Event ] -> bool
        return false
    func view_move [ ev: Event ] -> bool
        return false
    func view_wheel [ ev: Event ] -> bool
        return false
    func view_release [ ev: Event ]
        return
    func view_undo [] -> bool
        return false
    func view_redo [] -> bool
        return false
    func context_request [] -> bool
        return false
    func context_feed [] -> string
        return null
    func on_key [ ev: Event ]
        return
    func thumbnail [ cv: Canvas ] -> Texture
        return null

ResourceView B16
    func view_id [] -> string
        return 'b16'
    func applies [] -> FileType
        return FileType.agnostic
    mutable hx_fh     : handle
    mutable hx_size   : i64
    mutable hx_win    : ref u8         # 16KB read window over the file
    mutable hx_woff   : i64 [ -1 ]     # window's byte offset (-1 = empty)
    mutable hx_wlen   : i32
    mutable hx_scroll : f32            # editor scroll.y, stashed pre-render
    mutable hx_scroll_x : f32          # editor scroll.x, stashed pre-render
    mutable hx_content_w : f32         # full row width (px) for h-scroll clamp
    mutable hx_s0     : i64 [ -1 ]     # selection anchor (byte offset)
    mutable hx_s1     : i64 [ -1 ]     # selection end (byte offset)
    mutable hx_drag   : bool
    mutable hx_hexx   : f32            # hex column x (stashed for hit-tests)
    mutable hx_ascx   : f32            # ascii column x
    mutable hx_cw     : f32
    mutable hx_lh     : f32
    func hx_open []
        if [ hx_fh || !src ] return
        ps : '{src}'
        hx_fh = fopen[ ps.chars, "rb" ]
        if [ !hx_fh ] return
        fseek[ hx_fh, 0, 2 ]
        hx_size = ftell[ hx_fh ]
        fseek[ hx_fh, 0, 0 ]
        hx_woff = -1
    func hx_rows [] -> i64
        hx_open[]
        if [ hx_size <= 0 ] return 0
        return (hx_size + 15) / 16
    # slide the 16KB window so [off, off+need) is resident
    func hx_window [ off: i64, need: i32 ] -> bool
        if [ !hx_fh ] return false
        if [ !hx_win ] hx_win = new u8 [ 16384 ]
        if [ hx_woff >= 0 && off >= hx_woff && (off + i64[ need ]) <= (hx_woff + i64[ hx_wlen ]) ] return true
        fseek[ hx_fh, off, 0 ]
        rd : i64 [ fread[ hx_win, 1, 16384, hx_fh ] ]
        hx_woff = off
        hx_wlen = i32[ rd ]
        return hx_wlen >= need
    func hx_put [ b: ref u8, i: i32, v: i64, nd: i32 ] -> i32
        j : i32 [ i ]
        for [ k: i32 nd - 1, k >= 0, k -= 1 ]
            d : i32 [ i32[ ((v >> (k * 4)) & 15) ] ]
            b[ j ] = u8[ (d < 10) ? (48 + d) : (87 + d) ]
            j += 1
        return j
    func hx_byte_at [ mx: f32, my: f32 ] -> i64
        if [ hx_lh <= 0.0 || hx_cw <= 0.0 || hx_size <= 0 ] return -1
        row : i64 [ i64[ (my - vy) / hx_lh ] ]
        if [ row < 0 ] return -1
        col : i32 [ -1 ]
        if [ mx >= hx_hexx && mx < hx_ascx - hx_cw ]
            ch : i32 [ i32[ (mx - hx_hexx) / hx_cw ] ]
            if [ ch >= 25 ] ch -= 1
            col = ch / 3
        el [ mx >= hx_ascx && mx < hx_ascx + hx_cw * 16.0 ]
            col = i32[ (mx - hx_ascx) / hx_cw ]
        if [ col < 0 ] return -1
        if [ col > 15 ] col = 15
        bt : i64 [ row * 16 + i64[ col ] ]
        if [ bt >= hx_size ] bt = hx_size - 1
        return bt

    func content_height [ cv: Canvas, bounds: rect ] -> f32
        return f32[ hx_rows[] ] * round[ cv.get_line_height[] ]

    func content_width [ cv: Canvas, bounds: rect ] -> f32
        return hx_content_w

    func set_scroll [ x: f32, y: f32 ]
        hx_scroll_x = x
        hx_scroll   = y

    func release []
        if [ hx_fh ]
            fclose[ hx_fh ]
            hx_fh = null
        hx_woff = -1
        loaded  = false

    func view_press [ ev: Event ] -> bool
        cy : f32 [ ev.mouse.pos.y - vy ]
        if [ ev.mouse.pos.x < vx || ev.mouse.pos.x >= vx + vw ] return false
        if [ cy < hx_scroll || cy >= hx_scroll + vh ] return false
        bt : i64 [ hx_byte_at[ ev.mouse.pos.x, ev.mouse.pos.y ] ]
        if [ bt < 0 ]
            hx_s0 = -1
            hx_s1 = -1
            return true
        hx_s0   = bt
        hx_s1   = bt
        hx_drag = true
        return true

    func view_move [ ev: Event ] -> bool
        if [ !hx_drag ] return false
        bt : i64 [ hx_byte_at[ ev.mouse.pos.x, ev.mouse.pos.y ] ]
        if [ bt >= 0 ] hx_s1 = bt
        return true

    func view_release [ ev: Event ]
        hx_drag = false

    func render [ cv: Canvas, bounds: rect ]
        hx_open[]
        if [ !hx_fh || hx_size <= 0 ] return
        cwm : cv.measure_text[ '0' ]
        cw  : f32 [ cwm.w ]
        lh  : f32 [ round[ cv.get_line_height[] ] ]
        if [ lh <= 0.0 || cw <= 0.0 ] return
        x_off : f32 [ bounds.x + 8.0 - hx_scroll_x ]
        x_hex : f32 [ x_off + cw * 10.0 ]
        x_asc : f32 [ x_hex + cw * 51.0 ]
        hx_content_w = cw * 67.0 + 16.0
        hx_hexx = x_hex
        hx_ascx = x_asc
        hx_cw   = cw
        hx_lh   = lh
        nvis  : i32 [ i32[ bounds.h / lh ] + 2 ]
        r0    : i64 [ i64[ hx_scroll / lh ] ]
        if [ r0 < 0 ] r0 = 0
        total : i64 [ (hx_size + 15) / 16 ]
        band  : i64 [ i64[ nvis ] * 16 ]
        if [ band > hx_size - r0 * 16 ] band = hx_size - r0 * 16
        if [ band <= 0 ] return
        if [ !hx_window[ r0 * 16, i32[ band ] ] ] return
        yb : f32 [ bounds.y - hx_scroll ]
        lo : i64 [ (hx_s0 < hx_s1) ? hx_s0 : hx_s1 ]
        hi : i64 [ (hx_s0 < hx_s1) ? hx_s1 : hx_s0 ]
        b  : local u8 [ 64 ]
        if [ hx_s0 >= 0 ]
            cv.stroke_width [ 0.0 ]
            cv.fill_color   [ rgba['#264f78'] ]
            for [ vr: i32 0, vr < nvis, vr += 1 ]
                row : i64 [ r0 + i64[ vr ] ]
                if [ row >= total ] break
                off : i64 [ row * 16 ]
                nb  : i32 [ ((hx_size - off) >= 16) ? 16 : i32[ hx_size - off ] ]
                if [ lo > off + i64[ nb ] - 1 || hi < off ] continue
                c0  : i32 [ (lo > off) ? i32[ lo - off ] : 0 ]
                c1  : i32 [ (hi < off + i64[ nb ] - 1) ? i32[ hi - off ] : nb - 1 ]
                y   : f32 [ yb + f32[ row ] * lh ]
                sc  : i32 [ c0 * 3 + ((c0 >= 8) ? 1 : 0) ]
                ec  : i32 [ c1 * 3 + 2 + ((c1 >= 8) ? 1 : 0) ]
                cv.rounded_rect [ x_hex + f32[ sc ] * cw - 2.0, y + 1.0,
                    f32[ ec - sc ] * cw + 4.0, lh - 2.0, 3.0, 3.0, 3.0, 3.0 ]
                cv.rounded_rect [ x_asc + f32[ c0 ] * cw - 1.0, y + 1.0,
                    f32[ c1 - c0 + 1 ] * cw + 2.0, lh - 2.0, 3.0, 3.0, 3.0, 3.0 ]
            cv.paint [ ]
        # pass 2: offset column
        cv.fill_color [ rgba['#808080'] ]
        for [ vr: i32 0, vr < nvis, vr += 1 ]
            row : i64 [ r0 + i64[ vr ] ]
            if [ row >= total ] break
            j : i32 [ hx_put[ @b[0], 0, row * 16, 8 ] ]
            b[ j ] = 0
            cv.draw_text [ string [ cast cstr [ @b[0] ] ],
                rect [ x: x_off, y: yb + f32[ row ] * lh, w: cw * 8.0, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
        cv.paint [ ]
        # pass 3: hex bytes
        cv.fill_color [ rgba['#d4d4d4'] ]
        for [ vr: i32 0, vr < nvis, vr += 1 ]
            row : i64 [ r0 + i64[ vr ] ]
            if [ row >= total ] break
            off : i64 [ row * 16 ]
            nb  : i32 [ ((hx_size - off) >= 16) ? 16 : i32[ hx_size - off ] ]
            bi  : i32 [ i32[ off - hx_woff ] ]
            j   : i32 [ 0 ]
            for [ k: i32 0, k < nb, k += 1 ]
                if [ k == 8 ]
                    b[ j ] = 32
                    j += 1
                j = hx_put[ @b[0], j, i64[ hx_win[ bi + k ] ], 2 ]
                b[ j ] = 32
                j += 1
            b[ j ] = 0
            cv.draw_text [ string [ cast cstr [ @b[0] ] ],
                rect [ x: x_hex, y: yb + f32[ row ] * lh, w: cw * 49.0, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
        cv.paint [ ]
        # pass 4: ascii column (unprintable → '.')
        cv.fill_color [ rgba['#b5cea8'] ]
        for [ vr: i32 0, vr < nvis, vr += 1 ]
            row : i64 [ r0 + i64[ vr ] ]
            if [ row >= total ] break
            off : i64 [ row * 16 ]
            nb  : i32 [ ((hx_size - off) >= 16) ? 16 : i32[ hx_size - off ] ]
            bi  : i32 [ i32[ off - hx_woff ] ]
            for [ k: i32 0, k < nb, k += 1 ]
                c : i32 [ i32[ hx_win[ bi + k ] ] ]
                b[ k ] = u8[ (c >= 32 && c < 127) ? c : 46 ]
            b[ nb ] = 0
            cv.draw_text [ string [ cast cstr [ @b[0] ] ],
                rect [ x: x_asc, y: yb + f32[ row ] * lh, w: cw * 16.0, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
        cv.paint [ ]

ResourceView ImageView
    mutable tex : Texture
    mutable iw  : f32
    mutable ih  : f32
    func extensions [] -> vec string
        return vec string [] [ '.png', '.exr' ]
    func thumbnail [ cv: Canvas ] -> Texture
        if [ !src ] return null
        im : Image [ '{src}' ]
        if [ im.width <= 0 || im.height <= 0 ] return null
        mx : i32 [ (im.width > im.height) ? im.width : im.height ]
        if [ mx > 256 ]
            sc : f32 [ 256.0 / f32[ mx ] ]
            tw : i32 [ i32[ f32[ im.width ] * sc ] ]
            th : i32 [ i32[ f32[ im.height ] * sc ] ]
            if [ tw < 1 ] tw = 1
            if [ th < 1 ] th = 1
            im = im.resize[ tw, th ]
        return Texture [ vk: cv.vk, w: cv.w, sampler: im, width: im.width, height: im.height, linear: true ]

    func render [ cv: Canvas, bounds: rect ]
        if [ !loaded ]
            loaded = true
            if [ src ]
                im : Image [ '{src}' ]
                iw = f32[ im.width ]
                ih = f32[ im.height ]
                if [ im.width > 0 && im.height > 0 ]
                    tex = Texture [ vk: cv.vk, w: cv.w, sampler: im, width: im.width, height: im.height, linear: true ]
        if [ !tex || iw <= 0.0 || ih <= 0.0 ] return
        sc : f32 [ minf[ bounds.w / iw, bounds.h / ih ] ]
        if [ sc > 1.0 ] sc = 1.0
        dw : f32 [ iw * sc ]
        dh : f32 [ ih * sc ]
        dx : f32 [ bounds.x + (bounds.w - dw) * 0.5 ]
        dy : f32 [ bounds.y + (bounds.h - dh) * 0.5 ]
        cv.draw_image[ tex, rect [ x: dx, y: dy, w: dw, h: dh ] ]

    func release []
        tex = null
        loaded = false

ResourceView AppView
    mutable slot       : i32 [ -1 ]  # our channel slot at silver-host
    mutable app_mod    : string      # module name (orbiter resolves its binary to attach)
    mutable module_args : string     # orbiter's tail args, forwarded to the module
    public  attached   : bool        # orbiter has attached lldb to this app's pid
    public  attaching  : bool        # lldb attach is running on a worker
    mutable tex0       : Texture     # the app's shared surface pair, imported
    mutable tex1       : Texture
    mutable gen        : i32         # generation of the imported surface
    mutable cmd        : string      # console command (streams the app's log)
    mutable dispatched : bool        # cmd handed to its console session (once per run)
    public  clean_build : bool       # '*' marker: silver-host runs --clean first
    public  viewer      : bool       # a file handler: hosted to view, never under the debugger
    mutable doc        : path
    mutable pend_w     : i32
    mutable pend_h     : i32
    mutable req_w      : i32
    mutable req_h      : i32
    mutable pend_us    : i64
    mutable started    : bool
    mutable ready      : bool
    mutable ended       : bool
    mutable paused     : bool        # peer frozen (SIGSTOP) — last frame shows
    mutable note       : string
    mutable aw         : i32
    mutable ah         : i32
    mutable have_frame : bool
    mutable fade_us    : i64
    mutable seen_us    : i64
    mutable fitx       : f32
    mutable fity       : f32
    mutable fitw       : f32
    mutable fith       : f32
    # the app locked its aspect: letterbox it. otherwise clip
    mutable locked     : bool
    # the gain the app started at; -1 until it answers, then adopted once
    mutable app_vol    : f32 [ -1.0 ]
    # what the running instance says it can show, asked once
    mutable instr_names : vec string
    mutable instr_ask   : bool
    # the instruments actually up, and the surface each one publishes
    mutable instr_live  : vec string
    mutable instr_side  : map i32     [string]
    mutable instr_logs  : map i32     [string]
    mutable instr_gen   : map i32     [string]
    mutable instr_pw    : map i32     [string]
    mutable instr_ms    : i64
    mutable instr_ak    : i64
    mutable itex0       : map Texture [string]
    mutable itex1       : map Texture [string]
    mutable dbg_nw     : i32
    mutable dbg_nh     : i32
    mutable dbg_aw     : i32
    mutable dbg_ah     : i32
    mutable pipx       : f32
    mutable pipy       : f32
    mutable pipw       : f32
    mutable piph       : f32

    func extensions [] -> vec string
        return vec string []

    func is_app_host [] -> bool
        return true

    func continuous [] -> bool
        return true

    func service [ cv: Canvas ]
        if [ !started ] start[]
        if [ slot < 0 ] return
        st : i32 [ host_app_state[ slot ] ]
        if [ st == 4 && !paused ]
            paused = true
            v8 : i32 [ host_app_verdict[ slot ] ]
            sg8 : i32 [ 0 - v8 ]
            note = 'frozen — signal {sg8}'
        if [ st == 3 && !ended ]
            ended   = true
            paused = false
            v9 : i32 [ host_app_verdict[ slot ] ]
            if [ v9 <= -1000 ]
                note = 'build failed'
            el [ v9 < 0 ]
                sig9 : i32 [ 0 - v9 ]
                note = 'crashed — signal {sig9}'
            el [ v9 > 1 ]
                ec9 : i32 [ v9 - 1 ]
                note = 'exited — code {ec9}'
            el
                note = 'app exited'
        if [ ended ] return
        g9 : i32 [ host_tex_gen[ slot, 0 ] ]
        if [ g9 != gen && g9 > 0 ]
            w9 : i32
            h9 : i32
            f9 : i32
            fd0 : i32 [ host_tex_pull[ slot, 0, 0, @w9, @h9, @f9 ] ]
            fd1 : i32 [ host_tex_pull[ slot, 0, 1, @w9, @h9, @f9 ] ]
            if [ fd0 < 0 || fd1 < 0 ]
                fq9 : fopen[ '/tmp/orbiter-resz.log', 'a' ]
                if [ fq9 ]
                    fprintf[ fq9, "PULL FAIL gen=%d->%d fd0=%d fd1=%d %dx%d slot=%d\n",
                        gen, g9, fd0, fd1, w9, h9, slot ]
                    fclose[ fq9 ]
            if [ fd0 >= 0 && fd1 >= 0 ]
                if [ tex0 ]
                    tex0.drop[]
                    tex1.drop[]
                tex0 = cv.vk.import_shared_tex[ fd0, w9, h9, f9, cv.w ]
                tex1 = cv.vk.import_shared_tex[ fd1, w9, h9, f9, cv.w ]
                tex0.hold[]
                tex1.hold[]
                aw  = w9
                ah  = h9
                gen = g9
                ready      = true
                have_frame = true
                if [ seen_us == 0 ] seen_us = epoch_micros[]
                dw9 : i32 [ i32[ vw ] - aw ]
                dh9 : i32 [ i32[ vh ] - ah ]
                if [ dw9 < 0 ] dw9 = 0 - dw9
                if [ dh9 < 0 ] dh9 = 0 - dh9
                if [ fade_us == 0 && dw9 <= 2 && dh9 <= 2 ] fade_us = epoch_micros[]

        # ask what it offers. KEEP asking until it answers — the app opens
        # its agent socket a moment after it is ready, and a one-shot ask
        # that lands in that gap leaves the bar with no instruments button
        if [ ready && !instr_ask && app_mod && app_mod.count > 0 ]
            ak9 : i64 [ epoch_millis[] ]
            if [ instr_ak == 0 || ak9 - instr_ak > 500 ]
                instr_ak = ak9
                vb8 : local i8 [ 512 ]
                if [ agent_sock_ask[ app_mod.chars, 'instruments\n', @vb8[0], 512 ] > 0 ]
                    vs8 : string [ @vb8[0] ]
                    vt8 : string vs8.trim[]
                    if [ vt8 && vt8.count > 0 ]
                        instr_names = vt8.split[ ' ' ]
                        instr_ask   = true
                        if [ agent_sock_ask[ app_mod.chars, 'aspect\n', @vb8[0], 512 ] > 0 ]
                            la8 : string [ @vb8[0] ]
                            locked = la8.trim[] == '1'
                        # the app's own gain seeds the slider, once
                        if [ agent_sock_ask[ app_mod.chars, 'volume\n', @vb8[0], 512 ] > 0 ]
                            lv8 : string [ @vb8[0] ]
                            app_vol = f32[ lv8.trim[].real_value[] ]
        instr_service[ cv ]
        if [ ready && fade_us == 0 && seen_us != 0 ]
            if [ epoch_micros[] - seen_us > 1500000 ] fade_us = epoch_micros[]
        nw : i32[ vw ]
        nh : i32[ vh ]
        if [ nw != dbg_nw || nh != dbg_nh || aw != dbg_aw || ah != dbg_ah ]
            dbg_nw = nw
            dbg_nh = nh
            dbg_aw = aw
            dbg_ah = ah
            fz9 : fopen[ '/tmp/orbiter-resz.log', 'a' ]
            if [ fz9 ]
                fprintf[ fz9, "RESZ view=%dx%d actual=%dx%d req=%dx%d pend=%dx%d ready=%d slot=%d gen=%d shared=%d\n",
                    nw, nh, aw, ah, req_w, req_h, pend_w, pend_h, (ready) ? 1 : 0, slot,
                    gen, host_tex_gen[ slot, 0 ] ]
                fclose[ fz9 ]
        if [ ready && nw > 0 && nh > 0 ]
            if [ nw != pend_w || nh != pend_h ]
                pend_w  = nw
                pend_h  = nh
                pend_us = epoch_micros[]
            el [ nw != aw || nh != ah ]
                # 150ms of a held size before the peer is told to resize
                if [ epoch_micros[] - pend_us > 150000 && (nw != req_w || nh != req_h) ]
                    req_w = nw
                    req_h = nh
                    fs9 : fopen[ '/tmp/orbiter-resz.log', 'a' ]
                    if [ fs9 ]
                        fprintf[ fs9, "RESZ send %dx%d slot=%d\n", nw, nh, slot ]
                        fclose[ fs9 ]
                    host_post2[ slot, 1, i32[ HM.resize ], nw, nh, 0 ]

    func front [] -> Texture
        fr : i32 [ host_tex_front[ slot, 0 ] ]
        if [ fr < 0 || !tex0 ] return null
        return (fr == 0) ? tex0 : tex1

    # 'name:side:log' from the app, straight into our live state. side is
    # -1 for the usual case: an instrument that is entries and no view
    func instr_apply [ s: string ]
        instr_live = vec string []
        if [ !instr_side ] instr_side = map i32 [string] []
        if [ !instr_logs ] instr_logs = map i32 [string] []
        if [ !s ] return
        t9 : string s.trim[]
        if [ t9.count == 0 ] return
        ps : t9.split[ ' ' ]
        for [ i: i32 0, i < ps.count, i += 1 ]
            f9 : ps[i].split[ ':' ]
            if [ f9.count < 3 ] continue
            nm : string f9[0]
            instr_live.push[ nm ]
            instr_side[ nm ] = i32[ f9[1].integer_value[] ]
            instr_logs[ nm ] = i32[ f9[2].integer_value[] ]

    # a missing key is not a zero: reading one dereferences null
    func instr_num [ m: map i32 [string], nm: string, dflt: i32 ] -> i32
        if [ !m || !nm ] return dflt
        if [ !m.contains[ nm ] ] return dflt
        return m[ nm ]

    func instr_is_logging [ nm: string ] -> bool
        return instr_num[ instr_logs, nm, 0 ] != 0

    # the ONLY toggle: logging for one instrument. the reply is state
    func instr_toggle [ nm: string, logging: bool ]
        if [ !app_mod || !nm || nm.count == 0 ] return
        cb : local i8 [ 512 ]
        if [ agent_sock_ask[ app_mod.chars, 'instr-log {nm}\n', @cb[0], 512 ] > 0 ]
            instr_apply[ string [ @cb[0] ] ]

    # pull each instrument's own surface. gen 0 means it has none
    func instr_service [ cv: Canvas ]
        # nothing toggles any more, so the state has to be asked for
        nw9 : i64 [ epoch_millis[] ]
        if [ app_mod && (instr_ms == 0 || nw9 - instr_ms > 1000) ]
            instr_ms = nw9
            sb : local i8 [ 1024 ]
            if [ agent_sock_ask[ app_mod.chars, 'instr\n', @sb[0], 1024 ] > 0 ]
                instr_apply[ string [ @sb[0] ] ]
        if [ !instr_live || instr_live.count == 0 ] return
        if [ !itex0 ]     itex0     = map Texture [string] []
        if [ !itex1 ]     itex1     = map Texture [string] []
        if [ !instr_gen ] instr_gen = map i32 [string] []
        for [ i: i32 0, i < instr_live.count, i += 1 ]
            nm : string instr_live[i]
            sd : i32 [ instr_num[ instr_side, nm, -1 ] ]
            if [ sd < 2 ] continue
            g9 : i32 [ host_tex_gen[ slot, sd ] ]
            if [ g9 == instr_num[ instr_gen, nm, -1 ] ] continue
            if [ g9 <= 0 ]
                instr_gen[ nm ] = 0
                continue
            w9 : i32
            h9 : i32
            f9 : i32
            fd0 : i32 [ host_tex_pull[ slot, sd, 0, @w9, @h9, @f9 ] ]
            fd1 : i32 [ host_tex_pull[ slot, sd, 1, @w9, @h9, @f9 ] ]
            if [ fd0 < 0 || fd1 < 0 ] continue
            e0 : itex0[ nm ]
            if [ e0 ]
                e0.drop[]
                itex1[ nm ].drop[]
            t0 : cv.vk.import_shared_tex[ fd0, w9, h9, f9, cv.w ]
            t1 : cv.vk.import_shared_tex[ fd1, w9, h9, f9, cv.w ]
            t0.hold[]
            t1.hold[]
            itex0[ nm ] = t0
            itex1[ nm ] = t1
            instr_gen[ nm ] = g9

    # the completed frame of one instrument, or null when it has no view
    func instr_front [ nm: string ] -> Texture
        if [ !instr_side || !itex0 || !nm ] return null
        sd : i32 [ instr_num[ instr_side, nm, -1 ] ]
        if [ sd < 2 ] return null
        fr : i32 [ host_tex_front[ slot, sd ] ]
        if [ fr < 0 || !itex0[ nm ] ] return null
        return (fr == 0) ? itex0[ nm ] : itex1[ nm ]

    # we say the width; the height is the app's own. only on a change —
    # this runs on the draw path
    func instr_width [ nm: string, iw: i32 ]
        if [ !app_mod || !nm || iw <= 0 ] return
        if [ !instr_pw ] instr_pw = map i32 [string] []
        if [ instr_num[ instr_pw, nm, -1 ] == iw ] return
        instr_pw[ nm ] = iw
        agent_sock_send[ app_mod.chars, 'instr-width {nm} {iw}\n' ]

    # the entries themselves, asked of the running instance
    func instr_entries [ nm: string ] -> vec string
        if [ !app_mod || !nm || nm.count == 0 ] return null
        rb : local i8 [ 8192 ]
        if [ agent_sock_ask[ app_mod.chars, 'instr-read {nm}\n', @rb[0], 8192 ] <= 0 ] return null
        rs : string [ @rb[0] ]
        rt : string rs.trim[]
        if [ rt.count == 0 ] return null
        return rt.split[ '\n' ]

    func draw_frame [ cv: Canvas, bounds: rect ]
        ft : front[]
        if [ ft && have_frame ]
            if [ locked ]
                ar : f32 [ f32[ aw ] / f32[ ah ] ]
                fw : f32 [ bounds.w ]
                fh : f32 [ fw / ar ]
                if [ fh > bounds.h ]
                    fh = bounds.h
                    fw = fh * ar
                fitx = bounds.x + (bounds.w - fw) * 0.5
                fity = bounds.y + (bounds.h - fh) * 0.5
                fitw = fw
                fith = fh
                pipw = 0.0
                piph = 0.0
                cv.draw_image[ ft, rect [ x: fitx, y: fity, w: fitw, h: fith ] ]
            el
                # native pixels cropped to the pane until the resize lands
                fitx = bounds.x
                fity = bounds.y
                fitw = f32[ aw ]
                fith = f32[ ah ]
                cw : f32 [ (bounds.w < fitw) ? bounds.w : fitw ]
                ch : f32 [ (bounds.h < fith) ? bounds.h : fith ]
                pipw = 0.0
                piph = 0.0
                cv.draw_image_crop[ ft, rect [ x: fitx, y: fity, w: cw, h: ch ],
                    0.0, 0.0, cw / fitw, ch / fith ]
        # no frame yet: say what it is doing instead of drawing nothing
        if [ ended || paused || !have_frame ]
            overlay[ cv, bounds ]

    func render [ cv: Canvas, bounds: rect ]
        service[ cv ]
        draw_frame[ cv, bounds ]

    func draw_pip [ cv: Canvas, bounds: rect ]
        ft : front[]
        if [ !ft || !have_frame ] return
        # the pip owns no fit rect. leaving a stale one from a previous
        # maximised run would let view_press claim presses over nothing
        fitw = 0.0
        fith = 0.0
        ar : f32 [ f32[ aw ] / f32[ ah ] ]
        pw : f32 [ bounds.w * 0.30 ]
        ph : f32 [ pw / ar ]
        pipx = bounds.x + bounds.w - pw - 16.0
        pipy = bounds.y + bounds.h - ph - 16.0
        pipw = pw
        piph = ph
        cv.draw_image_min[ ft, rect [ x: pipx, y: pipy, w: pipw, h: piph ] ]

    func hit_pip [ x: f32, y: f32 ] -> bool
        if [ pipw <= 0.0 ] return false
        return x >= pipx && y >= pipy && x <= pipx + pipw && y <= pipy + piph

    # what the shell should SAY about this app right now. null once it is
    # up and drawing — waiting blind is the thing this exists to stop
    func status_text [] -> string
        if [ ended ]     return (note && note.count > 0) ? note : 'exited'
        if [ paused ]    return (note && note.count > 0) ? note : 'paused'
        if [ attaching ] return 'attaching debugger to {app_mod}...'
        st7 : i32 [ (slot >= 0) ? host_app_state[ slot ] : 0 ]
        if [ st7 == 1 ]  return 'compiling {app_mod}...'
        if [ !ready ]    return 'starting {app_mod}...'
        return null

    func overlay [ cv: Canvas, bounds: rect ]
        st9 : i32 [ (slot >= 0) ? host_app_state[ slot ] : 0 ]
        msg : string [ (st9 == 1) ? 'compiling {app_mod}…' : 'starting {app_mod}…' ]
        if [ ended ]
            msg = '{note} — F5 or click to restart'
        el [ paused ]
            msg = (note && note.count > 0) ? '{note} — F5 to relaunch' : 'paused — F8 or click to resume'
        el [ attaching ]
            msg = 'attaching debugger to {app_mod}…'
        cv.font_size[ 16 ]
        cv.fill_color[ '#dddddd' ]
        cv.draw_text[ msg, rect [ x: bounds.x, y: bounds.y + 16.0, w: bounds.w, h: 24.0 ],
            vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
        cv.paint[]
        if [ !ended && !paused && app_mod ]
            lp9 : string '/tmp/{app_mod}.log'
            fp9 : fopen[ lp9.chars, 'rb' ]
            if [ fp9 ]
                fseek[ fp9, 0, SEEK_END ]
                sz9 : i32 [ i32[ ftell[ fp9 ] ] ]
                back : i32 [ (sz9 < 4000) ? sz9 : 4000 ]
                fseek[ fp9, sz9 - back, SEEK_SET ]
                b9 : local i8 [ 4096 ]
                n9 : i32 [ i32[ fread[ @b9[0], 1, back, fp9 ] ] ]
                fclose[ fp9 ]
                if [ n9 > 0 ]
                    b9[n9] = 0
                    txt9   : string [ @b9[0] ]
                    lines9 : txt9.split[ '\n' ]
                    lh9  : f32 [ 16.0 ]
                    maxn : i32 [ i32[ (bounds.h - 56.0) / lh9 ] ]
                    st0  : i32 [ (lines9.count > maxn) ? lines9.count - maxn : 0 ]
                    cv.font_size[ 12 ]
                    cv.fill_color[ '#8899aa' ]
                    y9 : f32 [ bounds.y + 44.0 ]
                    for [ i: i32 st0, i < lines9.count, i += 1 ]
                        ln9 : string lines9[ i ]
                        if [ ln9 && ln9.count > 0 ]
                            cv.draw_text[ ln9, rect [ x: bounds.x + 16.0, y: y9, w: bounds.w - 32.0, h: lh9 ],
                                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                        y9 += lh9
                    cv.paint[]

    func start []
        started = true
        fn  : src.filename[]
        di  : i32 [ fn.index_of[ '.' ] ]
        mod : (di > 0) ? fn.mid[ 0, di ] : fn
        # '!' asks the host to stop the app for the debugger; a viewer never does
        dbg9 : string [ (viewer) ? '' : '!' ]
        mark : string [ (clean_build) ? '{dbg9}*' : dbg9 ]
        # flags BEFORE the doc: Au_with_cstrs stops parsing at the first
        # positional, so a trailing flag would never reach the app's schema
        ma9 : string [ (module_args && module_args.count > 0) ? '{module_args} ' : '' ]
        req : string [ (doc) ? '{mark}{mod} {ma9}{doc}' : '{mark}{mod} {ma9}' ]
        app_mod = mod
        slot = host_app_request[ req.chars ]
        if [ slot < 0 ]
            ended = true
            note = 'no silver-host supervisor'
            return
        cmd = 'tail -n +1 -F /tmp/{mod}.log'

    func on_key [ ev: Event ]
        k9 : i32 [ i32[ ev.key.unicode ] ]
        if [ ev.key.state && k9 == 294 ]
            restart[ ev.key.shift ]
            return
        if [ ev.key.state && k9 == 297 ]
            pause_toggle[]
            return
        if [ ended || paused || slot < 0 ] return
        mods : i32 [ 0 ]
        if [ ev.key.shift ] mods = mods | 1
        if [ ev.key.ctrl ]  mods = mods | 2
        if [ ev.key.alt ]   mods = mods | 4
        if [ ev.key.meta ]  mods = mods | 8
        act : i32 [ (ev.key.state) ? 1 : 0 ]
        host_post2[ slot, 1, i32[ HM.key ], i32[ ev.key.unicode ], act, mods ]

    # where the app is on screen right now: maximised draws through the
    # fit rect, small through the pip. one of them is live, never both
    func view_rect [] -> rect
        if [ fitw > 0.0 ] return rect [ x: fitx, y: fity, w: fitw, h: fith ]
        return rect [ x: pipx, y: pipy, w: pipw, h: piph ]

    func view_press [ ev: Event ] -> bool
        if [ ended ]
            restart[ false ]
            return true
        if [ paused ]
            pause_toggle[]
            return true
        if [ !ready || slot < 0 ] return false
        r9 : view_rect[]
        if [ r9.w <= 0.0 ] return false
        px : f32 [ ev.mouse.pos.x - vsx ]
        py : f32 [ ev.mouse.pos.y - vsy ]
        bx : f32 [ (px - r9.x) / r9.w * f32[ aw ] ]
        by : f32 [ (py - r9.y) / r9.h * f32[ ah ] ]
        if [ bx < 0.0 || by < 0.0 || bx >= f32[ aw ] || by >= f32[ ah ] ] return false
        host_post2[ slot, 1, i32[ HM.press ], i32[ bx ], i32[ by ], ev.mouse.button ]
        return true

    # the button stays down until the real release, or the app can never
    # see a drag: it would get down+up before the mouse ever moved
    func view_release [ ev: Event ]
        if [ ended || !ready || slot < 0 ] return
        r9 : view_rect[]
        if [ r9.w <= 0.0 ] return
        px : f32 [ ev.mouse.pos.x - vsx ]
        py : f32 [ ev.mouse.pos.y - vsy ]
        bx : f32 [ (px - r9.x) / r9.w * f32[ aw ] ]
        by : f32 [ (py - r9.y) / r9.h * f32[ ah ] ]
        host_post2[ slot, 1, i32[ HM.release ], i32[ bx ], i32[ by ], ev.mouse.button ]

    func view_move [ ev: Event ] -> bool
        if [ ended || !ready || slot < 0 ] return false
        r9 : view_rect[]
        if [ r9.w <= 0.0 ] return false
        px : f32 [ ev.mouse.pos.x - vsx ]
        py : f32 [ ev.mouse.pos.y - vsy ]
        bx : f32 [ (px - r9.x) / r9.w * f32[ aw ] ]
        by : f32 [ (py - r9.y) / r9.h * f32[ ah ] ]
        if [ bx < 0.0 || by < 0.0 || bx >= f32[ aw ] || by >= f32[ ah ] ] return false
        host_post2[ slot, 1, i32[ HM.move ], i32[ bx ], i32[ by ], 0 ]
        return true

    func view_wheel [ ev: Event ] -> bool
        if [ ended || !ready || slot < 0 ] return false
        r9 : view_rect[]
        if [ r9.w <= 0.0 ] return false
        px : f32 [ ev.mouse.pos.x - vsx ]
        py : f32 [ ev.mouse.pos.y - vsy ]
        bx : f32 [ (px - r9.x) / r9.w * f32[ aw ] ]
        by : f32 [ (py - r9.y) / r9.h * f32[ ah ] ]
        if [ bx < 0.0 || by < 0.0 || bx >= f32[ aw ] || by >= f32[ ah ] ] return false
        mods : i32 [ 0 ]
        if [ ev.key.shift ] mods = mods | 1
        if [ ev.key.ctrl ]  mods = mods | 2
        if [ ev.key.alt ]   mods = mods | 4
        if [ ev.key.meta ]  mods = mods | 8
        # the app scrolls at the cursor, so place it before the notch
        host_post2[ slot, 1, i32[ HM.move ], i32[ bx ], i32[ by ], 0 ]
        host_post2[ slot, 1, i32[ HM.wheel ],
            i32[ ev.mouse.wheel_delta.x * 100.0 ],
            i32[ ev.mouse.wheel_delta.y * 100.0 ], mods ]
        return true

    func pause_toggle []
        if [ ended || slot < 0 ] return
        if [ paused ]
            host_app_resume[ slot ]
            paused = false
        el
            host_app_pause[ slot ]
            paused = true

    func is_paused [] -> bool
        return paused

    func restart [ clean: bool ]
        clean_build = clean
        cleanup[]
        started    = false
        ready      = false
        ended       = false
        paused     = false
        have_frame = false
        fade_us    = 0
        seen_us    = 0
        note       = ''

    intern func cleanup []
        if [ slot >= 0 ]
            if [ paused ] host_app_resume[ slot ]
            if [ slot > 0 ] host_post2[ slot, 1, i32[ HM.close ], 0, 0, 0 ]
            host_app_stop[ slot ]
            slot = 0 - 1
        if [ tex0 ]
            tex0.drop[]
            tex1.drop[]
            tex0 = null
            tex1 = null
        gen        = 0
        have_frame = false
        fade_us    = 0
        seen_us    = 0

    func release []
        cleanup[]

Layer EditorLayer
    mutable sel_color      : rgba
    mutable sel_border     : rgba
    mutable line_color     : rgba
    # the 1px rules that bound the selected band, top and bottom
    mutable line_edge      : rgba
    # the gutter tint carried across the selected row
    mutable line_gutter    : rgba
    mutable item_color     : rgba
    mutable hl_fill        : rgba
    mutable hl_grad        : rgba
    mutable hl_glow        : rgba
    mutable hl_text        : rgba

    func glow_row [ cv: Canvas, rx: f32, ry: f32, rw: f32, rh: f32 ]
        cv.save[ ]
        cv.rounded[ 6.0, 6.0, 6.0, 6.0 ]
        cv.stroke_width[ 0.0 ]
        cv.fill_color[ hl_fill ]
        if [ hl_grad ]
            cv.fill_grad[ hl_grad ]
            cv.fill_color_pos[ rx, ry ]
            cv.fill_grad_pos[ rx, ry + rh ]
        if [ hl_glow ] cv.inner_glow[ hl_glow, 14.0 ]
        cv.rect_to[ rx, ry, rw, rh ]
        cv.paint[ ]
        cv.restore[ ]

    func on_move [ ev: Event ]
        editor : Editor[ parent ]
        if [ !editor || !editor.dragging ] return
        lh    : f32 [ (editor.lh_cache > 0.0) ? editor.lh_cache : 22.0 ]
        cw    : f32 [ (editor.cw_cache > 0.0) ? editor.cw_cache : 8.0 ]
        rel_y : f32 [ ev.mouse.pos.y ]
        rel_x : f32 [ ev.mouse.pos.x ]
        raw   : i32 [ clamp[ rel_y / lh, 0, editor.line_count[] - 1 ] ]
        ln    : i32 [ editor.snap_row[ raw ] ]
        vx    : f32 [ round[ (rel_x - editor.row_indent[ ln ] + editor.scroll.x) / cw ] ]
        cl    : i32 [ editor.model_col[ editor.line_get[ ln ], i32[ vx ] ] ]
        editor.sel_line = ln
        editor.sel_col  = cl
        editor.pristine = false

    func code_hash [ editor: Editor, msl: i32, ln: string ] -> i64
        h : i64 [ 1469598103934665603 ]
        for [ i: i32 0, i < ln.count, i += 1 ]
            h = (h ^ i64[ ln[i] ]) * 1099511628211
        nrg : i32 [ editor.line_reg_count[ msl ] ]
        for [ ri: i32 0, ri < nrg, ri += 1 ]
            cr : ColorRegion editor.line_reg[ msl, ri ]
            h = (h ^ i64[ cr.col ]) * 1099511628211
            h = (h ^ i64[ cr.len ]) * 1099511628211
            h = (h ^ i64[ i32[ cr.color.r * 255.0 ] + i32[ cr.color.g * 255.0 ] * 256 + i32[ cr.color.b * 255.0 ] * 65536 ]) * 1099511628211
        return h

    func code_slot [ cv: Canvas, editor: Editor, msl: i32, ln: string, cmt_c: rgba, lh: f32, cw: f32, code_fs: i32 ] -> EdLineCache
        ll : i32 [ ln.count ]
        if [ ll == 0 ] return null
        if [ !editor.code_lines ] editor.code_lines = vec EdLineCache []
        h : i64 [ code_hash[ editor, msl, ln ] ]
        for [ slot: EdLineCache ] in editor.code_lines
            if [ slot.canvas && slot.hash == h ]
                slot.frame = editor.cl_frame
                return slot
        use : EdLineCache [ null ]
        for [ slot: EdLineCache ] in editor.code_lines
            if [ slot.frame != editor.cl_frame ]
                use = slot
                break
        if [ !use ]
            use = EdLineCache [ ]
            editor.code_lines.push[ use ]
        disp : editor.display_of[ ln ]
        cw_i : i32 [ i32[ ceil[ f32[ disp.count ] * cw + cw ] ] ]
        if [ cw_i < 1 ] cw_i = 1
        lh_i : i32 [ i32[ ceil[ lh ] ] + 1 ]
        if [ !use.canvas ]
            use.canvas = Canvas [ vk: cv.vk, w: cv.w, format: Pixel.rgba8, width: cw_i, height: lh_i, load_existing: true, quantize: true, tag: 'line' ]
            use.canvas.update[]
        el [ use.canvas.content_w != cw_i || use.canvas.content_h != lh_i ]
            use.canvas.resize[ cw_i, lh_i ]
        lc : use.canvas
        lc.reset[ vec4f [ 0.0, 0.0, 0.0, 0.0 ] ]
        if [ code_fs > 0 ] lc.font_size[ code_fs ]
        editor.text_lines_frame += 1
        editor.text_lines_total += 1
        rw  : f32 [ f32[ cw_i ] ]
        nrg : i32 [ (editor.finder_list || editor.show_nav || editor.show_hits) ? 0 : editor.line_reg_count[ msl ] ]
        if [ nrg == 0 ]
            tc : rgba['#fff']
            for [ k: i32 0, k < ll, k += 1 ]
                if [ ln[k] == 35 ]
                    tc = cmt_c
                    break
            lc.fill_color[ tc ]
            lc.draw_text[ disp, rect [ x: 0.0, y: 0.0, w: rw, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
        el
            col : i32 [ 0 ]
            for [ ri: i32 0, ri < nrg, ri += 1 ]
                cr : ColorRegion editor.line_reg[ msl, ri ]
                c0 : i32 [ cr.col ]
                if [ c0 < 0 ] c0 = 0
                if [ c0 > ll ] c0 = ll
                sl : i32 [ cr.len ]
                if [ c0 + sl > ll ] sl = ll - c0
                if [ c0 > col ]
                    gx : f32[ editor.display_of[ ln.mid[ 0, col ] ].count ] * cw
                    lc.fill_color[ rgba['#fff'] ]
                    lc.draw_text[ editor.display_of[ ln.mid[ col, c0 - col ] ],
                        rect [ x: gx, y: 0.0, w: rw, h: lh ],
                        vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
                    col = c0
                if [ sl > 0 ]
                    tx : f32[ editor.display_of[ ln.mid[ 0, c0 ] ].count ] * cw
                    lc.fill_color[ cr.color ]
                    lc.draw_text[ ln.mid[ c0, sl ],
                        rect [ x: tx, y: 0.0, w: rw, h: lh ],
                        vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
                    col = c0 + sl
            if [ col < ll ]
                gc : rgba['#fff']
                for [ k: i32 col, k < ll, k += 1 ]
                    if [ ln[k] == 35 ]
                        gc = cmt_c
                        break
                ex : f32 [ f32[ editor.display_of[ ln.mid[ 0, col ] ].count ] * cw ]
                lc.fill_color[ gc ]
                lc.draw_text[ editor.display_of[ ln.mid[ col, ll - col ] ],
                    rect [ x: ex, y: 0.0, w: rw, h: lh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
        lc.paint[ ]
        use.hash  = h
        use.frame = editor.cl_frame
        return use

    func band_hash [ editor: Editor, bs: i32, bands: i32, code_fs: i32 ] -> i64
        h : i64 [ i64[ bs ] * 1099511628211 + i64[ code_fs ] ]
        for [ k: i32 0, k < bands, k += 1 ]
            li : i32 [ bs + k ]
            if [ li >= editor.line_count[] ] break
            if [ editor.row_header[ li ] || editor.row_var[ li ] ]
                h = (h ^ 1) * 1099511628211
                continue
            ln : editor.draw_line[ li ]
            if [ ln.count == 0 ]
                h = (h ^ 2) * 1099511628211
                continue
            h = (h ^ code_hash[ editor, editor.row_src[ li ], ln ]) * 1099511628211
        return h

    func code_band [ cv: Canvas, editor: Editor, bs: i32, bands: i32, cmt_c: rgba, lh: f32, cw: f32, code_fs: i32 ] -> EdLineCache
        if [ !editor.code_lines ] editor.code_lines = vec EdLineCache []
        h    : i64 [ band_hash[ editor, bs, bands, code_fs ] ]
        maxw     : i32 [ 1 ]
        has_code : bool [ false ]
        for [ k: i32 0, k < bands, k += 1 ]
            li : i32 [ bs + k ]
            if [ li >= editor.line_count[] ] break
            if [ editor.row_header[ li ] || editor.row_var[ li ] ] continue
            ln : editor.draw_line[ li ]
            if [ ln.count == 0 ] continue
            has_code = true
            cwi : i32 [ i32[ ceil[ f32[ editor.display_of[ ln ].count ] * cw + cw ] ] ]
            if [ cwi > maxw ] maxw = cwi
        if [ !has_code ] return null
        if [ maxw > 16000 ] maxw = 16000
        lc_h : i32 [ i32[ ceil[ f32[ bands ] * lh ] ] + 1 ]
        # cache hit → reuse, just tick the frame
        for [ slot: EdLineCache ] in editor.code_lines
            if [ slot.canvas && slot.hash == h ]
                slot.frame = editor.cl_frame
                return slot
        use : EdLineCache [ null ]
        for [ slot: EdLineCache ] in editor.code_lines
            if [ slot.frame != editor.cl_frame ]
                use = slot
                break
        if [ !use ]
            use = EdLineCache [ ]
            editor.code_lines.push[ use ]
        if [ !use.canvas ]
            use.canvas = Canvas [ vk: cv.vk, w: cv.w, format: Pixel.rgba8, width: maxw, height: lc_h, load_existing: true, quantize: true, tag: 'band' ]
            use.canvas.update[]
        el [ use.canvas.content_w != maxw || use.canvas.content_h != lc_h ]
            use.canvas.resize[ maxw, lc_h ]
        lc : use.canvas
        lc.reset[ vec4f [ 0.0, 0.0, 0.0, 0.0 ] ]
        if [ code_fs > 0 ] lc.font_size[ code_fs ]
        rw : f32 [ f32[ maxw ] ]
        for [ k: i32 0, k < bands, k += 1 ]
            li : i32 [ bs + k ]
            if [ li >= editor.line_count[] ] break
            if [ editor.row_header[ li ] || editor.row_var[ li ] ] continue
            ln : editor.draw_line[ li ]
            ll : i32 [ ln.count ]
            if [ ll == 0 ] continue
            editor.text_lines_frame += 1
            editor.text_lines_total += 1
            yk   : f32 [ f32[ k ] * lh ]
            msl  : i32 [ editor.row_src[ li ] ]
            disp : editor.display_of[ ln ]
            nrg  : i32 [ (editor.finder_list || editor.show_nav || editor.show_hits) ? 0 : editor.line_reg_count[ msl ] ]
            if [ nrg == 0 ]
                tc : rgba['#fff']
                for [ kk: i32 0, kk < ll, kk += 1 ]
                    if [ ln[kk] == 35 ]
                        tc = cmt_c
                        break
                lc.fill_color[ tc ]
                lc.draw_text[ disp, rect [ x: 0.0, y: yk, w: rw, h: lh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
            el
                col : i32 [ 0 ]
                for [ ri: i32 0, ri < nrg, ri += 1 ]
                    cr : ColorRegion editor.line_reg[ msl, ri ]
                    c0 : i32 [ cr.col ]
                    if [ c0 < 0 ] c0 = 0
                    if [ c0 > ll ] c0 = ll
                    sl : i32 [ cr.len ]
                    if [ c0 + sl > ll ] sl = ll - c0
                    if [ c0 > col ]
                        gx : f32 [ f32[ editor.display_of[ ln.mid[ 0, col ] ].count ] * cw ]
                        lc.fill_color[ rgba['#fff'] ]
                        lc.draw_text[ editor.display_of[ ln.mid[ col, c0 - col ] ],
                            rect [ x: gx, y: yk, w: rw, h: lh ],
                            vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
                        col = c0
                    if [ sl > 0 ]
                        tx : f32 [ f32[ editor.display_of[ ln.mid[ 0, c0 ] ].count ] * cw ]
                        lc.fill_color[ cr.color ]
                        lc.draw_text[ ln.mid[ c0, sl ],
                            rect [ x: tx, y: yk, w: rw, h: lh ],
                            vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
                        col = c0 + sl
                if [ col < ll ]
                    gc : rgba['#fff']
                    for [ kk: i32 col, kk < ll, kk += 1 ]
                        if [ ln[kk] == 35 ]
                            gc = cmt_c
                            break
                    ex : f32 [ f32[ editor.display_of[ ln.mid[ 0, col ] ].count ] * cw ]
                    lc.fill_color[ gc ]
                    lc.draw_text[ editor.display_of[ ln.mid[ col, ll - col ] ],
                        rect [ x: ex, y: yk, w: rw, h: lh ],
                        vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
        lc.paint[ ]
        use.hash  = h
        use.frame = editor.cl_frame
        return use

    # left tool rail: vertical buttons, icon over title, 64px wide
    # the extension's handler module leads as the default action
    func draw_tools [ cv: Canvas, editor: Editor ]
        if [ !editor.nav_tools || editor.nav_tools.count == 0 ] return
        if [ !editor.ficons ] editor.ficons = FileIcons []
        # left inset matches the chips' top padding
        dxx  : f32 [ bounds.x + 4.0 ]
        bas9 : i32 [ editor.tool_base[] ]
        for [ ti: i32 0, ti < bas9 + editor.nav_tools.count, ti += 1 ]
            tnm : string (bas9 == 1 && ti == 0) ? editor.nav_default : editor.nav_tools[ ti - bas9 ]
            tyy : f32 [ bounds.y + 4.0 + f32[ ti ] * 68.0 ]
            # the view you are IN reads as a border, not a hover tint
            act9 : bool [ editor.view_name && editor.view_name.count > 0
                          && editor.view_name == tnm ]
            if [ act9 ]
                cv.fill_color  [ rgba['#6cb6ff33'] ]
                cv.stroke_color[ rgba['#8fd0ff'] ]
            el [ ti == editor.tool_hover ]
                cv.fill_color  [ rgba['#6cb6ff22'] ]
                cv.stroke_color[ rgba['#6cb6ffcc'] ]
            el
                cv.fill_color  [ rgba['#10142088'] ]
                cv.stroke_color[ rgba['#fff3'] ]
            cv.stroke_width[ (act9) ? 2.0 : 1.0 ]
            cv.rounded_rect[ dxx, tyy, 60.0, 64.0, 8.0, 8.0, 8.0, 8.0 ]
            cv.paint       [ ]
            cv.stroke_width[ 0.0 ]
            tico : SVGModel editor.ficons.named[ tnm, 36 ]
            if [ tico ]
                # selected = orangish white; resting = off purple white
                cv.svg_override[ (act9) ? rgba['#ffe6d2'] : ((ti == editor.tool_hover) ? rgba['#ffffff'] : rgba['#cfc6e8']) ]
                cv.draw_svg[ tico, dxx + 12.0, tyy + 6.0, 36.0, 36.0 ]
                cv.svg_override_off[]
            cv.font_size[ 11.0 ]
            cv.fill_color[ rgba['#c9c4dd'] ]
            # an owned label: binding the vec's string and then assigning
            # over it drops a reference this local never held, and the
            # vec's entry frees under it
            tlb : string [ (tnm == 'git') ? 'diff' : '{tnm}' ]
            cv.draw_text[ tlb, rect [ x: dxx, y: tyy + 44.0, w: 60.0, h: 16.0 ],
                vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]

    func draw [ cv: Canvas ]
        editor : Editor[ parent ]
        if [ !editor ] return
        sc : string [ (editor.src) ? '{editor.src}' : '' ]
        lc : string [ (editor.loaded_src) ? '{editor.loaded_src}' : '' ]
        dc : string [ (editor.diff_commit) ? editor.diff_commit : '' ]
        ld : string [ (editor.loaded_diff) ? editor.loaded_diff : '' ]
        if [ sc.compare[ lc ] != 0 || dc.compare[ ld ] != 0 ]
            editor.load_file[]
        if [ editor.diff_commit && editor.diff_dirty ]
            if [ epoch_millis[] - editor.diff_edit_ms > 400 ]
                editor.diff_rebuild[ true ]
            el
                editor.ux.will_animate = true
        if [ editor.run_view ]
            editor.run_view.service[ cv ]
            if [ editor.app_view && !editor.show_hits ]
                b2 : rect [ x: bounds.x, y: bounds.y, w: bounds.w, h: bounds.h ]
                bot : element (editor.elements) ? editor.elements['bottom'] : null
                if [ bot && bot.bounds && bot.bounds.h > 0.0 ]
                    lim : f32 [ bot.bounds.y - b2.y ]
                    if [ lim > 0.0 && lim < b2.h ] b2.h = lim
                editor.run_view.vx = b2.x
                editor.run_view.vy = b2.y
                editor.run_view.vw = b2.w
                editor.run_view.vh = b2.h
                editor.run_view.vsx = editor.scroll.x
                editor.run_view.vsy = editor.scroll.y
                if [ editor.run_view.fade_us != 0 ]
                    fal : f32 [ f32[ epoch_micros[] - editor.run_view.fade_us ] / 400000.0 ]
                    if [ fal >= 1.0 ]
                        parent.mask_glow  = vec4f [ 0.0, 0.0, 0.0, 0.0 ]
                        parent.mask_inset = vec4f [ 0.0, 0.0, 0.0, 0.0 ]
                        editor.run_view.draw_frame[ cv, b2 ]
                        return
        if [ editor.rview && !editor.show_hits ]
            if [ !editor.rview.view_text*[ editor.rview.view_sel ] ]
                hfs : i32 [ (editor.code_font_size > 0) ? editor.code_font_size : 15 ]
                cv.font_size[ hfs ]
                hlh2 : f32 [ round[ cv.get_line_height[] ] ]
                # a view that reports an extent scrolls in the pane
                vch : f32 [ editor.rview.content_height*[ cv, bounds ] ]
                if [ vch > 0.0 ]
                    editor.content_h    = vch
                    editor.scroll_speed = hlh2
                    hms : f32 [ editor.content_h - bounds.h ]
                    if [ hms < 0.0 ] hms = 0.0
                    hjd : f32 [ editor.scroll.y - editor.hx_last_y ]
                    if [ hjd > 0.5 || hjd < 0.0 - 0.5 ]
                        editor.scroll_target = editor.scroll.y
                    if [ editor.pending_wheel != 0.0 ]
                        editor.scroll_target = editor.scroll_target - editor.pending_wheel * hlh2 * 0.6
                        editor.pending_wheel = 0.0
                    if [ editor.scroll_target < 0.0 ] editor.scroll_target = 0.0
                    if [ editor.scroll_target > hms ] editor.scroll_target = hms
                    hdy : f32 [ editor.scroll_target - editor.scroll.y ]
                    if [ (hdy > 0.5) || (hdy < 0.0 - 0.5) ]
                        editor.scroll.y = filter_n[ editor.scroll.y, editor.scroll_target, 0.14, editor.ux.frame_factor ]
                        parent.needs_frame = true
                        if [ editor.ux ] editor.ux.will_animate = true
                    el
                        editor.scroll.y = editor.scroll_target
                    if [ editor.scroll.y < 0.0 ] editor.scroll.y = 0.0
                    if [ editor.scroll.y > hms ] editor.scroll.y = hms
                    editor.lh_cache  = hlh2
                    editor.hx_last_y = editor.scroll.y
                    hxmx : f32 [ editor.rview.content_width*[ cv, bounds ] - bounds.w ]
                    if [ hxmx < 0.0 ] hxmx = 0.0
                    if [ editor.scroll.x < 0.0 ] editor.scroll.x = 0.0
                    if [ editor.scroll.x > hxmx ] editor.scroll.x = hxmx
                    editor.rview.set_scroll*[ editor.scroll.x, editor.scroll.y ]
                    hxf : f32 [ (editor.scroll.y > 0.0) ? 0.0 : 0.0 ]
                    hxl : f32 [ (editor.scroll.x > 0.0) ? 0.0 : 0.0 ]
                    # right fade is a fixed short edge, not width-proportional
                    parent.mask_glow   = vec4f [ hxf, 48.0, hlh2, hxl ]
                    parent.mask_keep_l = 0.0
                    parent.mask_inset  = vec4f [ 0.0, 0.0, 0.0, 0.0 ]
                    
                editor.rview.vx = bounds.x
                editor.rview.vy = bounds.y
                editor.rview.vw = bounds.w
                editor.rview.vh = bounds.h
                editor.rview.vsx = editor.scroll.x
                editor.rview.vsy = editor.scroll.y
                editor.rview.render*[ cv, bounds ]
                return
        if [ !editor.lines ] return
        showing : bool [ editor.show_hits ]
        if [ showing && !editor.was_showing ]
            editor.sel_line = -1
        editor.was_showing = showing
        hits    : editor.hits
        code_fs : i32 [ (editor.code_font_size > 0) ? editor.code_font_size : 15 ]
        cv.font_size[ code_fs ]
        cw_tm   : cv.measure_text[ 'x' ]
        lh      : f32 [ round[ cv.get_line_height[] * ((label_height > 0.0) ? label_height : 1.0) ] ]
        ndigits : i32 [ 1 ]
        ncount  : i32 [ editor.line_count[] ]
        while [ ncount >= 10 ]
            ncount  = ncount / 10
            ndigits += 1
        if [ ndigits < 5 ] ndigits = 5
        gut_w   : f32 [ f32[ ndigits ] * cw_tm.w + 16.0 ]
        # browse nav shows no line numbers and no pin gutter: rows
        # start where the zone pills do (shift-click handles pinning)
        if [ showing && hits && editor.nav_list ] gut_w = 12.0
        editor.gutter_w = gut_w
        if [ editor.scroll.x < 0.0 ] editor.scroll.x = 0.0
        # left tool rail pushes the nav content right by 64px
        lin     : f32 [ (editor.nav_tools && editor.nav_tools.count > 0) ? 64.0 : 0.0 ]
        # the list never scrolls on x: its rows line up with the zone
        x0      : f32 [ bounds.x + lin + gut_w - ((showing) ? 0.0 : editor.scroll.x) ]
        # the list drops 10px so row 0 tops the rail's first button
        y0      : f32 [ bounds.y + ((showing) ? 10.0 : 0.0) ]
        dbg_el  : element (editor.elements) ? editor.elements['dbg'] : null
        din     : f32 [ 0.0 ]
        if [ dbg_el && dbg_el.bounds ]
            din = dbg_el.bounds.w
        pin_in  : f32 [ (editor.elements && editor.elements['pins']) ? 144.0 : 0.0 ]
        rin     : f32 [ maxf[ pin_in, din ] ]
        # the element itself never masks: fills and the gutter stay crisp.
        # the fade rides on the text canvas alone (blitted below).
        parent.mask_glow   = vec4f [ 0.0, 0.0, 0.0, 0.0 ]
        parent.mask_keep_l = 0.0
        parent.mask_inset  = vec4f [ 0.0, 0.0, 0.0, 0.0 ]
        fade_l : f32 [ 0.0 ]
        fade_t : f32 [ 0.0 ]
        fade_b : f32 [ 0.0 ]
        fade_r : f32 [ 0.0 ]
        if [ !editor.grid_mode ]
            fade_l = (editor.scroll.x > 0.0) ? bounds.w / 8.0 : 0.0
            fade_t = (editor.scroll.y > 0.0) ? lh : 0.0
            fade_b = lh
            fade_r = 48.0

        editor.lh_cache  = lh
        editor.cw_cache  = cw_tm.w
        editor.text_lines_frame = 0
        editor.cl_frame += 1
        if [ editor.cl_cw != cw_tm.w || editor.cl_lh != lh ]
            if [ editor.code_lines ]
                for [ slot: EdLineCache ] in editor.code_lines
                    slot.hash = -1
            editor.cl_cw = cw_tm.w
            editor.cl_lh = lh
        editor.rebuild_flat[]
        grid_cw    : f32 [ 140.0 ]            # cell slot width
        grid_ch    : f32 [ 178.0 ]            # cell slot height (square thumb + 2-line label)
        grid_cols  : i32 [ 1 ]
        grid_pins  : i32 [ 0 ]                # pinned-dock cell count
        grid_res   : i32 [ 0 ]               # result cell count
        if [ editor.grid_mode && editor.hits ]
            gavail : f32 [ bounds.w - lin - rin - 8.0 ]
            grid_cols = i32[ gavail / grid_cw ]
            if [ grid_cols < 1 ] grid_cols = 1
            for [ li: i32 0, li < editor.hits.count, li += 1 ]
                h : FindHit editor.hits[ li ]
                if [ !h || !h.is_header || !h.file || h.is_spacer ] continue
                if [ editor.row_cont[ li ] ] continue
                if [ li < editor.dock_rows ] grid_pins += 1
                el                            grid_res += 1
        grid_resoff : f32 [ 0.0 ]
        if [ editor.grid_mode ]
            pin_rows : i32 [ (grid_pins + grid_cols - 1) / grid_cols ]
            res_rows : i32 [ (grid_res  + grid_cols - 1) / grid_cols ]
            if [ grid_pins > 0 ] grid_resoff = f32[ pin_rows ] * grid_ch + lh
            editor.content_h = grid_resoff + f32[ res_rows ] * grid_ch
            editor.g_cols    = grid_cols
            editor.g_pins    = grid_pins
            editor.g_resoff  = grid_resoff
        el
            # four lines of trailing air: the last line sat flush on the
            # bottom edge. every row loop stops at line_count[], so these
            # rows draw nothing — no text, no gutter number
            editor.content_h = f32[ editor.line_count[] + 4 ] * lh
        editor.scroll_speed = (editor.grid_mode) ? grid_ch : lh

        vh : f32 [ bounds.h ]
        max_scroll : f32 [ editor.content_h - vh ]
        if [ max_scroll < 0.0 ] max_scroll = 0.0
        if [ editor.pending_wheel != 0.0 ]
            editor.scroll_target = editor.scroll_target - editor.pending_wheel * lh * 0.6
            editor.pending_wheel = 0.0
        if [ editor.scroll_target < 0.0 ] editor.scroll_target = 0.0
        if [ editor.scroll_target > max_scroll ] editor.scroll_target = max_scroll
        sdy : f32 [ editor.scroll_target - editor.scroll.y ]
        if [ (sdy > 0.5) || (sdy < 0.0 - 0.5) ]
            editor.scroll.y = filter_n[ editor.scroll.y, editor.scroll_target, 0.14, editor.ux.frame_factor ]
            parent.needs_frame = true
            if [ editor.ux ] editor.ux.will_animate = true
        el
            editor.scroll.y = editor.scroll_target
        if [ editor.scroll.y < 0.0 ] editor.scroll.y = 0.0
        if [ editor.scroll.y > max_scroll ] editor.scroll.y = max_scroll

        wtx : f32 [ cv.transform_tx[] ]
        wty : f32 [ cv.transform_ty[] ]
        cv.set_crop[ wtx + bounds.x, wty + bounds.y,
            wtx + bounds.x + bounds.w - rin, wty + bounds.y + vh ]

        if [ editor.grid_mode && editor.hits ]
            gm    : f32 [ 8.0 ]                 # margin inside each cell slot
            gth   : f32 [ grid_cw - gm * 2.0 ]  # square thumbnail size
            pin_i : i32 [ 0 ]
            res_i : i32 [ 0 ]
            if [ grid_pins > 0 ]
                pr : i32 [ (grid_pins + grid_cols - 1) / grid_cols ]
                sy : f32 [ y0 + f32[ pr ] * grid_ch + lh * 0.5 - editor.scroll.y ]
                if [ sy >= bounds.y && sy <= bounds.y + bounds.h ]
                    cv.fill_color  [ rgba['#ffffff30'] ]
                    cv.stroke_width[ 0.0 ]
                    cv.rect_to     [ bounds.x + lin + 8.0, round[ sy ], bounds.w - lin - rin - 16.0, 1.0 ]
                    cv.paint       [ ]
            for [ li: i32 0, li < editor.hits.count, li += 1 ]
                h : FindHit editor.hits[ li ]
                if [ !h || !h.is_header || !h.file || h.is_spacer ] continue
                if [ editor.row_cont[ li ] ] continue
                is_pin : bool [ li < editor.dock_rows ]
                gidx : i32 [ (is_pin) ? pin_i : res_i ]
                col  : i32 [ gidx % grid_cols ]
                grow : i32 [ gidx / grid_cols ]
                if [ is_pin ] pin_i += 1
                el            res_i += 1
                cx : f32 [ bounds.x + lin + 4.0 + f32[ col ] * grid_cw ]
                cy : f32 [ ((is_pin) ? (y0 + f32[ grow ] * grid_ch) : (y0 + grid_resoff + f32[ grow ] * grid_ch)) - editor.scroll.y ]
                if [ cy + grid_ch < bounds.y || cy > bounds.y + bounds.h ] continue
                if [ li == editor.sel_line || li == editor.hover_line ]
                    cv.fill_color  [ rgba['#6cb6ff22'] ]
                    cv.stroke_color[ rgba['#6cb6ffcc'] ]
                    cv.stroke_width[ 1.0 ]
                    cv.rounded_rect[ cx + gm * 0.5, cy + gm * 0.5, grid_cw - gm, grid_ch - gm, 8.0, 8.0, 8.0, 8.0 ]
                    cv.paint       [ ]
                    cv.stroke_width[ 0.0 ]
                ix : f32 [ cx + gm ]
                iy : f32 [ cy + gm ]
                tex : editor.thumb_for[ h.file, cv ]
                if [ tex ]
                    tw  : f32 [ f32[ tex.width ] ]
                    th  : f32 [ f32[ tex.height ] ]
                    csc : f32 [ (tw > 0.0 && th > 0.0) ? minf[ gth / tw, gth / th ] : 1.0 ]
                    dw  : f32 [ tw * csc ]
                    dh  : f32 [ th * csc ]
                    dx  : f32 [ ix + (gth - dw) * 0.5 ]
                    dy  : f32 [ iy + (gth - dh) * 0.5 ]
                    cv.draw_image[ tex, rect [ x: dx, y: dy, w: dw, h: dh ] ]
                el
                    if [ !editor.file_icon ]
                        ffp2 : path 'images/file.svg'
                        if [ ffp2.exists[] ] editor.file_icon = SVGModel [ ffp2 ]
                    if [ !editor.ficons ] editor.ficons = FileIcons []
                    if [ !editor.module_icon ]
                        cfp3 : path 'images/material/3d.svg'
                        if [ cfp3.exists[] ] editor.module_icon = SVGModel [ cfp3 ]
                    if [ !editor.folder_icon ]
                        dfp3 : path 'images/material/folder.svg'
                        if [ dfp3.exists[] ] editor.folder_icon = SVGModel [ dfp3 ]
                    ico : SVGModel [ (h.is_dir) ? ((h.is_module) ? editor.module_icon : editor.folder_icon) : editor.file_icon ]
                    if [ !h.is_dir ]
                        mico : SVGModel editor.ficons.icon[ h.file.filename[], i32[ gth * 0.5 ] ]
                        if [ mico ] ico = mico
                    if [ ico ]
                        hsz : f32 [ gth * 0.5 ]
                        # neutral tint (see list view) — icon shows authored colors
                        cv.fill_color[ rgba['#ffffff'] ]
                        cv.stroke_color[ rgba['#ffffff'] ]
                        cv.draw_svg[ ico, ix + gth * 0.25, iy + gth * 0.25, hsz, hsz ]
                ty : f32 [ cy + gm + gth + 2.0 ]
                cv.font_size[ code_fs ]
                cv.fill_color[ (h.is_dir) ? rgba['#6cb6ff'] : rgba['#fff'] ]
                cv.draw_text[ h.text, rect [ x: cx + gm, y: ty, w: grid_cw - gm * 2.0, h: 16.0 ],
                    vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.ellipsis, null ]
            draw_tools[ cv, editor ]
            cv.clear_crop[ ]
            return

        in_list : bool [ editor.finder_list || showing ]
        stop_vrow : i32 [ editor.vis_row[ editor.stop_line ] ]
        hl_line : i32 [ (in_list) ? editor.hover_line : stop_vrow ]
        if [ hl_line >= 0 && hl_line < editor.line_count[] && hl_fill && !editor.row_spacer[ hl_line ] ]
            gl : i32 [ hl_line ]
            gh : f32 [ lh - 2.0 ]
            if [ editor.row_header[ gl ] ]
                if [ editor.row_cont[ gl ] ] gl = gl - 1
                # single-line headers are one slot; double headers span two.
                gh = (editor.single_line) ? lh - 2.0 : lh * 2.0 - 2.0
            hy : f32 [ y0 + f32[ gl ] * lh - editor.scroll.y ]
            if [ hy + gh >= bounds.y && hy <= bounds.y + bounds.h ]
                # hover sits 4px left of the grid; right edge matches the zone
                glow_row[ cv, bounds.x + lin + 8.0, hy + 1.0, bounds.w - lin - rin - 32.0, gh ]

        cv.stroke_width[ 0.0 ]
        num_fs  : i32 [ i32[ f32[ code_fs ] * 0.7 ] - 1 ]
        cv.font_size[ num_fs ]
        for [ li: i32 0, li < editor.line_count[], li += 1 ]
            if [ editor.row_header[ li ] ] continue
            if [ editor.row_var[ li ] ] continue
            yg : f32 [ round[ y0 + f32[li] * lh - editor.scroll.y ] ]
            if [ yg + lh < bounds.y ] continue
            if [ yg > bounds.y + bounds.h ] break
            bsl  : i32  [ editor.row_src[ li ] ]
            rnum : i32  [ (showing && hits) ? hits[li].line : bsl + 1 ]
            if [ !showing && !editor.diff_commit ]
                bp : editor.breakpoints['{editor.src}:{bsl + 1}']
                if [ bp != null ]
                    cv.fill_color[ editor.bp_color[ bp ] ]
                    cv.rect_to[ bounds.x, yg, bounds.w - rin - 1.0, lh ]
                    cv.paint[ ]
            if [ editor.sel_line >= 0 && editor.sel_line < editor.line_count[] ]
                a_ln : i32 [ clamp[ editor.anchor_line, 0, editor.line_count[] - 1 ] ]
                s_ln : i32 [ editor.sel_line ]
                lo   : i32 [ (a_ln < s_ln) ? a_ln : s_ln ]
                hi   : i32 [ (a_ln < s_ln) ? s_ln : a_ln ]
                if [ li >= lo && li <= hi ]
                    cv.fill_color[ (line_color) ? line_color : rgba['#ffffff18'] ]
                    if [ showing ]
                        cv.rounded_rect[
							bounds.x + 1.0, yg + 1.0,
							bounds.w - rin - 3.0,
							lh - 2.0, 3.0, 3.0, 3.0, 3.0 ]
                    el
                        cv.rect_to[ bounds.x, yg, bounds.w - rin - 1.0, lh ]
                    cv.paint[ ]
                    # 1px rules just outside the band, top and bottom
                    if [ !showing && (li == lo || li == hi) ]
                        cv.save[ ]
                        cv.plain[ ]
                        cv.hard_edge[ ]
                        cv.stroke_width[ 0.0 ]
                        cv.fill_color[ (line_edge) ? line_edge : rgba['#ffffff22'] ]
                        bw9 : f32 [ bounds.w - rin - 1.0 ]
                        if [ li == lo ]
                            cv.rect_to[ bounds.x, yg - 1.0, bw9, 1.0 ]
                            cv.paint[ ]
                        if [ li == hi ]
                            cv.rect_to[ bounds.x, yg + lh, bw9, 1.0 ]
                            cv.paint[ ]
                        cv.restore[ ]
            cv.fill_color[ (line_gutter) ? line_gutter : rgba['#ffffff08'] ]
            cv.rect_to[ bounds.x + 2.0, yg + 1.0, gut_w - 4.0, lh - 2.0 ]
            cv.paint[ ]
            if [ !showing && stop_vrow == li ]
                mid : f32 [ yg + lh * 0.5 ]
                cv.save[ ]
                cv.rounded[ 6.0, 6.0, 6.0, 6.0 ]
                cv.fill_color[ rgba['#00000000'] ]
                cv.stroke_color[ rgba['#ff44'] ]
                cv.stroke_width[ 1.0 ]
                cv.rect_to[ bounds.x + 1.0, yg + 1.0, bounds.w - rin - 2.0, lh - 2.0 ]
                cv.paint[ ]
                cv.stroke_width[ 0.0 ]
                cv.rounded[ 0.0, 0.0, 0.0, 0.0 ]
                cv.fill_color[ rgba['#ffffff'] ]
                gtip : f32 [ bounds.x + gut_w + 12.0 ]
                cv.move_to[ gtip - 11.0, mid - 6.0 ]
                cv.line_to[ gtip - 6.0,  mid - 6.0 ]
                cv.line_to[ gtip,        mid ]
                cv.line_to[ gtip - 6.0,  mid + 6.0 ]
                cv.line_to[ gtip - 11.0, mid + 6.0 ]
                cv.close_path[ ]
                cv.paint[ ]
                if [ editor.stop_col >= 0 ]
                    cx : f32 [ x0 + f32[editor.stop_col] * cw_tm.w ]
                    cv.fill_color[ rgba['#ffcc33'] ]
                    cv.rect_to[ cx, yg + 1.0, 2.0, lh - 2.0 ]
                    cv.paint[ ]
                cv.restore[ ]
            # removed rows have no file line: blank gutter
            if [ rnum > 0 && !(showing && editor.hover_gutter && editor.hover_line == li) ]
                cv.fill_color[ rgba['#ffffff80'] ]
                cv.draw_text[ '{rnum}',
                    rect [ x: bounds.x, y: yg, w: gut_w - 6.0, h: lh ],
                    vec2f [ 1.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]

        # diff fills go down BEFORE the text, unmasked, as a real background.
        # the finder swaps `lines` for its results and leaves diff_kinds alone,
        # so those rows are NOT the file's rows — never tint them
        if [ editor.diff_kinds && !showing && !editor.finder_list ]
            # ONE rect per paint. batching rects into a single path misses the
            # rect fast path and rasterizes through the half-res SDF window,
            # which shifts rows off their y and bleeds red into green.
            # coalescing runs keeps the paint count to the visible run count.
            cv.stroke_width[ 0.0 ]
            nl8 : i32 [ editor.line_count[] ]
            nk8 : i32 [ editor.diff_kinds.count ]
            li  : i32 [ 0 ]
            while [ li < nl8 && li < nk8 ]
                dk8 : i32 [ editor.diff_kinds[li] ]
                if [ dk8 == 0 ]
                    li += 1
                    continue
                rs : i32 [ li ]
                while [ li < nl8 && li < nk8 && editor.diff_kinds[li] == dk8 ]
                    li += 1
                yt : f32 [ round[ y0 + f32[ rs ] * lh - editor.scroll.y ] ]
                yb : f32 [ round[ y0 + f32[ li ] * lh - editor.scroll.y ] ]
                if [ yb < bounds.y ] continue
                if [ yt > bounds.y + bounds.h ] break
                cv.fill_color[ (dk8 == 2) ? rgba['#23461f55'] : rgba['#58202055'] ]
                cv.rect_to[ bounds.x, yt, bounds.w - rin, yb - yt ]
                cv.paint[ ]

        # code text collects into its own pane-sized canvas so the edge fade
        # applies to glyphs alone — fills, gutter and selection stay crisp
        tcv : editor.text_target[ cv, bounds ]
        tox : f32 [ (tcv == cv) ? 0.0 : 0.0 - bounds.x ]
        toy : f32 [ (tcv == cv) ? 0.0 : 0.0 - bounds.y ]

        # restore the code font before drawing line content
        cv.font_size[ code_fs ]
        tcv.font_size[ code_fs ]
        if [ editor.scroll.x > 0.0 ]
            cv.set_crop[ wtx + bounds.x + gut_w, wty + bounds.y,
                wtx + bounds.x + bounds.w - rin, wty + bounds.y + vh ]
            if [ tcv != cv ]
                tcv.set_crop[ gut_w, 0.0, bounds.w - rin, vh ]
        if [ editor.band_rows != 1 ]
            br : i32 [ (editor.band_rows >= 2) ? editor.band_rows : 8 ]
            fr : i32 [ i32[ editor.scroll.y / lh ] ]
            lr : i32 [ i32[ (editor.scroll.y + bounds.h) / lh ] ]
            if [ fr < 0 ] fr = 0
            fb : i32 [ fr / br ]
            lb : i32 [ lr / br ]
            cmt_b : rgba['#7a8290']
            if [ editor.code_lines ]
                for [ b: i32 fb, b <= lb, b += 1 ]
                    bs : i32 [ b * br ]
                    if [ bs >= editor.line_count[] ] break
                    bh : i64 [ band_hash[ editor, bs, br, code_fs ] ]
                    for [ slot: EdLineCache ] in editor.code_lines
                        if [ slot.canvas && slot.hash == bh ]
                            slot.frame = editor.cl_frame
                            break
            for [ b: i32 fb, b <= lb, b += 1 ]
                bs : i32 [ b * br ]
                if [ bs >= editor.line_count[] ] break
                bnd : EdLineCache code_band[ cv, editor, bs, br, cmt_b, lh, cw_tm.w, code_fs ]
                if [ bnd && bnd.canvas ]
                    by : f32 [ y0 + f32[ bs ] * lh - editor.scroll.y ]
                    # native size: scaling to br*lh compresses the rows
                    # and selected-text overdraw no longer lines up
                    tcv.draw_canvas[ bnd.canvas, x0 + tox, round[ by ] + toy,
                        f32[ bnd.canvas.content_w ], f32[ bnd.canvas.content_h ] ]
            tcv.paint[ ]
        el [ editor.code_lines ]
            for [ rli: i32 0, rli < editor.line_count[], rli += 1 ]
                ry : f32 [ y0 + f32[rli] * lh - editor.scroll.y ]
                if [ ry + lh < bounds.y ] continue
                if [ ry > bounds.y + bounds.h ] break
                if [ editor.row_header[ rli ] ] continue
                if [ editor.row_var[ rli ] ] continue
                rln : editor.line_get[ rli ]
                if [ rln.count == 0 ] continue
                rhash : i64 [ code_hash[ editor, editor.row_src[ rli ], rln ] ]
                for [ slot: EdLineCache ] in editor.code_lines
                    if [ slot.canvas && slot.hash == rhash ]
                        slot.frame = editor.cl_frame
                        break
        # composite the glyph canvas back through the edge fade
        editor.text_blit[ cv, bounds, fade_t, fade_r, fade_b, fade_l ]
        for [ li: i32 0, li < editor.line_count[], li += 1 ]
            y : f32 [ round[ y0 + f32[li] * lh - editor.scroll.y ] ]
            # ctrl/cmd held: outline every token that resolves, so the
            # jump targets announce themselves. drawn HERE, in the blit,
            # never into the line canvas -- that is cached by text hash
            # and the outline would survive the key coming back up
            if [ editor.mod_down && !editor.show_hits && !editor.row_header[ li ] ]
                if [ y + lh >= bounds.y && y <= bounds.y + bounds.h ]
                    ln9  : editor.line_get[ li ]
                    msl9 : i32 [ editor.row_src[ li ] ]
                    nrg9 : i32 [ editor.line_reg_count[ msl9 ] ]
                    for [ ri9: i32 0, ri9 < nrg9, ri9 += 1 ]
                        cr9 : ColorRegion editor.line_reg[ msl9, ri9 ]
                        c09 : i32 [ cr9.col ]
                        sl9 : i32 [ cr9.len ]
                        if [ c09 < 0 || sl9 <= 0 ] continue
                        if [ c09 + sl9 > ln9.count ] continue
                        w9 : ln9.mid[ c09, sl9 ]
                        # the map already resolved this token. a module
                        # name is the one case it cannot -- that is a file
                        ok9 : bool [ cr9.dsrc && cr9.dline > 0 ]
                        if [ cr9.kind == 14 ] ok9 = editor.module_path[ w9 ] != null
                        if [ !ok9 ] continue
                        tx9 : f32 [ f32[ editor.display_of[ ln9.mid[ 0, c09 ] ].count ] * cw_tm.w ]
                        ww9 : f32 [ f32[ editor.display_of[ w9 ].count ] * cw_tm.w ]
                        cv.save[ ]
                        cv.rounded[ 3.0, 3.0, 3.0, 3.0 ]
                        cv.fill_color[ rgba['#3b6fe022'] ]
                        cv.stroke_width[ 1.0 ]
                        cv.stroke_color[ rgba['#8cf9'] ]
                        cv.rect_to[ x0 + tx9 - 1.0, y + 1.0, ww9 + 2.0, lh - 2.0 ]
                        cv.paint[ ]
                        cv.restore[ ]
            if [ editor.row_header[ li ] ]
                if [ editor.row_cont[ li ] ] continue
                if [ editor.row_spacer[ li ] ]
                    if [ y + lh < bounds.y || y > bounds.y + bounds.h ] continue
                    cv.save[ ]
                    cv.rounded[ 0.0, 0.0, 0.0, 0.0 ]
                    cv.fill_color[ rgba['#fff2'] ]
                    cv.rect_to[ bounds.x + lin + 12.0, round[ y + lh * 0.5 ], bounds.w - lin - rin - 36.0, 1.0 ]
                    cv.paint[ ]
                    cv.restore[ ]
                    continue
                single : bool [ editor.single_line ]
                rh : f32 [ (single) ? lh : lh * 2.0 ]
                if [ y + rh < bounds.y ] continue
                if [ y > bounds.y + bounds.h ] break
                fhh : FindHit (editor.hits && li < editor.hits.count) ? editor.hits[ li ] : null
                fnm : string (fhh) ? fhh.text : editor.line_get[ li ]
                fdr : string (fhh) ? fhh.dir : ''
                cv.save[ ]
                cv.rounded[ 12.0, 12.0, 12.0, 12.0 ]
                cv.fill_color[ (item_color) ? item_color : rgba['#2b3a5580'] ]
                cv.rect_to[ bounds.x + lin + 2.0, y + 2.0, bounds.w - lin - rin - 4.0, rh - 4.0 ]
                cv.paint[ ]
                cv.restore[ ]
                if [ fhh && fhh.is_newfile ]
                    cv.save[ ]
                    cv.rounded[ 8.0, 8.0, 8.0, 8.0 ]
                    cv.fill_color[ rgba['#0000'] ]
                    cv.stroke_width[ 1.0 ]
                    cv.stroke_color[ rgba['#fff3'] ]
                    cv.rect_to[ bounds.x + lin + 2.0, y + 2.0, bounds.w - lin - rin - 4.0, rh - 4.0 ]
                    cv.paint[ ]
                    cv.restore[ ]
                    cv.fill_color[ rgba['#9a94b0'] ]
                    cv.draw_text[ fnm,
                        rect [ x: x0 + 8.0, y: y, w: bounds.w - rin - 16.0, h: rh ],
                        vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                    continue
                fis_dir : bool [ fhh->is_dir ]
                if [ fis_dir && fnm->count > 0 ] fnm = '{fnm}/'
                if [ !editor.file_icon ]
                    ffp2 : path 'images/file.svg'
                    if [ ffp2.exists[] ] editor.file_icon = SVGModel [ ffp2 ]
                if [ !editor.module_icon ]
                    cfp2 : path 'images/material/3d.svg'
                    if [ cfp2.exists[] ] editor.module_icon = SVGModel [ cfp2 ]
                if [ !editor.folder_icon ]
                    dfp2 : path 'images/material/folder.svg'
                    if [ dfp2.exists[] ] editor.folder_icon = SVGModel [ dfp2 ]
                if [ !editor.ficons ] editor.ficons = FileIcons []
                imdl : SVGModel [ (fis_dir) ? ((fhh && fhh->is_module) ? editor.module_icon : editor.folder_icon) : editor.file_icon ]
                if [ !fis_dir ]
                    msz : i32 [ i32[ round[ lh * ((single) ? 0.7 : 1.0) ] ] ]
                    mim : SVGModel editor.ficons.icon[ fnm, msz ]
                    if [ mim ] imdl = mim
                isz : f32 [ round[ lh * ((single) ? 0.7 : 1.0) ] ]
                tx0  : f32 [ x0 + isz + 8.0 ]
                if [ imdl ]
                    iy  : f32 [ round[ y + (rh - isz) * 0.5 ] ]
                    cv.fill_color[ rgba['#ffffff'] ]
                    cv.stroke_color[ rgba['#ffffff'] ]
                    cv.draw_svg[ imdl, x0, iy, isz, isz ]
                if [ single ]
                    cv.font_size[ code_fs ]
                    cv.fill_color[ (fis_dir) ? rgba['#6cb6ff'] : rgba['#fff'] ]
                    cv.draw_text[ fnm, rect [ x: tx0, y: y, w: bounds.w - rin - tx0, h: rh ],
                        vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                    if [ fdr->count > 0 ]
                        fnw : f32 [ cv.measure_text[ fnm ].w ]
                        col : f32 [ bounds.x + bounds.w * 0.5 ]
                        end : f32 [ tx0 + fnw + cw_tm.w * 2.0 ]
                        dx  : f32 [ (end > col) ? end : col ]
                        cv.fill_color[ rgba['#ffffff66'] ]
                        cv.draw_text[ fdr, rect [ x: dx, y: y, w: bounds.x + bounds.w - rin - dx, h: rh ],
                            vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                el
                    hfs : i32 [ (editor.header_size > 0) ? editor.header_size : code_fs ]
                    cv.font_size[ hfs ]
                    nmh : f32 [ (fdr->count > 0) ? lh : rh ]
                    cv.fill_color[ (fis_dir) ? rgba['#6cb6ff'] : rgba['#fff'] ]
                    cv.draw_text[ fnm, rect [ x: tx0, y: y, w: bounds.w - rin - tx0, h: nmh ],
                        vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                    if [ fdr->count > 0 ]
                        dfs : i32 [ (editor.dir_size > 0) ? editor.dir_size : hfs ]
                        cv.font_size[ dfs ]
                        cv.fill_color[ rgba['#ffffff66'] ]
                        cv.draw_text[ fdr, rect [ x: tx0, y: y + lh, w: bounds.w - rin - tx0, h: lh ],
                            vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                cv.font_size[ code_fs ]
                hov : bool [ !editor.nav_list && editor.hover_gutter && (editor.hover_line == li || (!editor.single_line && editor.hover_line == li + 1)) ]
                if [ hov ]
                    ico : SVGModel [ null ]
                    if [ !editor.close_icon ]
                        editor.close_icon = SVGModel [ path 'images/close.svg' ]
                    ico = editor.close_icon
                    if [ ico ]
                        hisz : f32 [ round[ lh * 0.5 ] ]
                        hiox : f32 [ round[ bounds.x + (gut_w - hisz) * 0.5 ] ]
                        hioy : f32 [ round[ y + (rh - hisz) * 0.5 ] ]
                        cv.draw_svg[ ico, hiox, hioy, hisz, hisz ]
                        cv.paint[ ]
                continue
            if [ y + lh < bounds.y ] continue
            if [ y > bounds.y + bounds.h ] break
            ln    : editor.line_get[ li ]
            rvd   : variable editor.row_var[ li ]
            if [ rvd ]
                dpx : f32 [ x0 + editor.row_indent[ li ] ]
                vtg : string [ (editor.var_expandable[ rvd ]) ? ((rvd.expanded) ? '  [-]' : '  [+]') : '' ]
                cv.fill_color[ rgba['#6a9955cc'] ]
                cv.draw_text[ '{ln}{vtg}',
                    rect [ x: dpx, y: y, w: bounds.x + bounds.w - rin - dpx, h: lh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                continue
            if [ editor.band_rows == 1 ]
                cmt_c : rgba['#7a8290']
                msl   : i32 [ editor.row_src[ li ] ]
                slc   : code_slot[ cv, editor, msl, editor.draw_line[ li ], cmt_c, lh, cw_tm.w, code_fs ]
                if [ slc && slc.canvas ]
                    cv.draw_canvas[ slc.canvas, x0, round[ y ],
                        f32[ slc.canvas.content_w ], f32[ slc.canvas.content_h ] ]
        cv.paint[ ]

        if [ editor.nav_list && editor.dock_rows > 0 && editor.dock_rows < editor.line_count[] ]
            sy : f32 [ y0 + f32[ editor.dock_rows ] * lh - editor.scroll.y ]
            if [ editor.single_line ] sy = sy + lh * 0.5
            if [ sy >= bounds.y && sy <= bounds.y + bounds.h ]
                cv.fill_color[ rgba['#ffffff30'] ]
                cv.stroke_width[ 0.0 ]
                cv.rect_to[ bounds.x + lin + 12.0, round[ sy ], bounds.w - lin - rin - 36.0, 1.0 ]
                cv.paint[ ]

        if [ !showing && editor.debug_vars ]
            cv.font_size[ code_fs ]
            cv.fill_color[ rgba['#6a9955cc'] ]
            for [ li: i32 0, li < editor.line_count[], li += 1 ]
                if [ editor.row_header[ li ] ] continue
                if [ editor.row_var[ li ] ] continue   # virtual field rows drawn already
                bsl : i32 [ editor.row_src[ li ] ]
                if [ bsl < 0 ] continue
                bv   : variable editor.base_var_of[ bsl ]
                if [ !bv ] continue
                summ : editor.var_summary[ bv ]
                if [ !summ || summ.count == 0 ] continue
                ya : f32 [ round[ y0 + f32[li] * lh - editor.scroll.y ] ]
                if [ ya + lh < bounds.y ] continue
                if [ ya > bounds.y + bounds.h ] break
                # expandable objects get a [+]/[-] toggle after the summary
                tog : (editor.var_expandable[ bv ]) ? ((bv.expanded) ? '  [-]' : '  [+]') : ''
                ax   : f32 [ x0 + f32[ editor.ann_col[ li ] ] * cw_tm.w ]
                if [ editor.hover_ann == li ]
                    cv.save[ ]
                    cv.rounded[ 5.0, 5.0, 5.0, 5.0 ]
                    cv.stroke_width[ 0.0 ]
                    cv.fill_color[ rgba['#2f7a4a44'] ]
                    cv.inner_glow[ rgba['#5fd08abb'], 10.0 ]
                    cv.rect_to[ ax - cw_tm.w, ya + 2.0, bounds.x + bounds.w - rin - ax + 4.0, lh - 4.0 ]
                    cv.paint[ ]
                    cv.restore[ ]
                    cv.fill_color[ rgba['#6a9955cc'] ]
                cv.draw_text[ '# {summ}{tog}',
                    rect [ x: ax, y: ya, w: bounds.x + bounds.w - rin - ax, h: lh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
            cv.paint[ ]

        if [ editor.find_query && editor.find_query.count > 0 ]
            for [ li: i32 0, li < editor.line_count[], li += 1 ]
                if [ editor.row_header[ li ] ] continue
                y : f32 [ round[ y0 + f32[li] * lh - editor.scroll.y ] ]
                if [ y + lh < bounds.y ] continue
                if [ y > bounds.y + bounds.h ] break
                ln : editor.line_get[ li ]
                qn : i32 [ editor.find_query.count ]
                base : i32 [ 0 ]
                while [ base <= ln.count - qn ]
                    rem : string ln.mid[ base, ln.count - base ]
                    rel : i32 [ rem.index_of[ editor.find_query ] ]
                    if [ rel < 0 ] break
                    mpos : i32 [ base + rel ]
                    pre : f32 [ cv.measure_text[ editor.display_of[ ln.mid[ 0, mpos ] ] ].w ]
                    mw  : f32 [ cv.measure_text[ editor.display_of[ ln.mid[ mpos, qn ] ] ].w ]
                    mx  : f32 [ x0 + pre - 1.0 ]
                    if [ li == editor.sel_line && mpos == editor.sel_col ]
                        cv.fill_color   [ rgba['#ffcc66'] ]
                        cv.stroke_width [ 0.0 ]
                        cv.rounded_rect [ mx, y + 2.0, mw + 2.0, lh - 4.0, 3.0, 3.0, 3.0, 3.0 ]
                        cv.paint        [ ]
                        cv.fill_color   [ rgba['#101418'] ]
                        cv.draw_text    [ editor.display_of[ ln.mid[ mpos, qn ] ],
                            rect [ x: x0 + pre, y: y, w: mw + 2.0, h: lh ],
                            vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
                        cv.paint        [ ]
                    el
                        cv.fill_color   [ rgba['#0000'] ]
                        cv.stroke_color [ rgba['#6cb6ffaa'] ]
                        cv.stroke_width [ 1.0 ]
                        cv.rounded_rect [ mx, y + 2.0, mw + 2.0, lh - 4.0, 3.0, 3.0, 3.0, 3.0 ]
                        cv.paint        [ ]
                    base = mpos + qn
            cv.stroke_width[ 0.0 ]

        if [ !showing ]
            tok : editor.cursor_token[]
            if [ tok && tok.count > 0 ]
                tn : i32 [ tok.count ]
                for [ li: i32 0, li < editor.line_count[], li += 1 ]
                    if [ editor.row_header[ li ] ] continue
                    y : f32 [ round[ y0 + f32[li] * lh - editor.scroll.y ] ]
                    if [ y + lh < bounds.y ] continue
                    if [ y > bounds.y + bounds.h ] break
                    ln : editor.line_get[ li ]
                    base : i32 [ 0 ]
                    while [ base <= ln.count - tn ]
                        rem : string ln.mid[ base, ln.count - base ]
                        rel : i32 [ rem.index_of[ tok ] ]
                        if [ rel < 0 ] break
                        mpos : i32 [ base + rel ]
                        # whole-word only: neighbors must not be identifier chars
                        bok : bool [ mpos == 0 || !editor.word_char[ i32[ ln[mpos - 1] ] ] ]
                        aok : bool [ mpos + tn >= ln.count || !editor.word_char[ i32[ ln[mpos + tn] ] ] ]
                        if [ bok && aok ]
                            pre : f32 [ cv.measure_text[ editor.display_of[ ln.mid[ 0, mpos ] ] ].w ]
                            mw  : f32 [ cv.measure_text[ editor.display_of[ ln.mid[ mpos, tn ] ] ].w ]
                            mx  : f32 [ x0 + pre - 1.0 ]
                            cv.fill_color   [ rgba['#0000'] ]
                            cv.stroke_color [ rgba['#6cb6ffaa'] ]
                            cv.stroke_width [ 1.0 ]
                            cv.rounded_rect [ mx, y + 2.0, mw + 2.0, lh - 4.0, 3.0, 3.0, 3.0, 3.0 ]
                            cv.paint        [ ]
                        base = mpos + tn
            cv.stroke_width[ 0.0 ]

        if [ showing && hits && editor.hover_gutter && editor.hover_line >= 0 && !editor.row_header[ editor.hover_line ] ]
            hy : f32 [ y0 + f32[ editor.hover_line ] * lh - editor.scroll.y ]
            if [ hy + lh >= bounds.y && hy <= bounds.y + bounds.h ]
                if [ !editor.close_icon ]
                    editor.close_icon = SVGModel [ path 'images/close.svg' ]
                isz : f32 [ round[ lh * 0.5 ] ]
                iox : f32 [ round[ bounds.x + (gut_w - isz) * 0.5 ] ]
                ioy : f32 [ round[ hy + (lh - isz) * 0.5 ] ]
                cv.fill_color[ rgba['#ffffff'] ]
                cv.stroke_color[ rgba['#ffffff'] ]
                cv.draw_svg[ editor.close_icon, iox, ioy, isz, isz ]
                cv.paint[ ]

        if [ editor.sel_line >= editor.line_count[] ] editor.sel_line = -1
        if [ editor.sel_line >= 0 && editor.anchor_line >= editor.line_count[] ]
            editor.anchor_line = editor.line_count[] - 1
        if [ editor.sel_line >= 0 ]
            cv.save[ ]
            cv.stroke_width[ 0.0 ]
            al          : i32 [ editor.anchor_line ]
            ac          : i32 [ editor.anchor_col ]
            sl          : i32 [ editor.sel_line ]
            sc          : i32 [ editor.sel_col ]
            before      : bool [ al < sl || (al == sl && ac <= sc) ]
            start_line  : i32 [ (before) ? al : sl ]
            start_col   : i32 [ (before) ? ac : sc ]
            end_line    : i32 [ (before) ? sl : al ]
            end_col     : i32 [ (before) ? sc : ac ]
            cw          : f32 [ cw_tm.w ]
            has_sel : bool [ start_line != end_line || start_col != end_col ]

            scrolled : bool [ editor.scroll.y != editor.last_scroll_y ]
            editor.last_scroll_y = editor.scroll.y
            resized  : bool [ (bounds.w - rin) != editor.last_view_w ]
            editor.last_view_w = bounds.w - rin
            if [ editor.last_sel_line != sl || editor.last_sel_col != ac || editor.last_before != before ]
                editor.last_sel_line = sl
                editor.last_sel_col  = ac
                editor.last_before   = before
                editor.filter_rect = null
                editor.filter_next = false

            sel_col_val  : rgba [ (sel_color)  ? sel_color  : rgba['#425'] ]
            sel_brd_val  : rgba [ (sel_border) ? sel_border : rgba['#ede3'] ]

            if [ has_sel ]
                cv.save[ ]
                cv.rounded[ 4.0, 4.0, 4.0, 4.0 ]
                # selection reads as a glow, not a bordered box
                cv.inner_glow[ sel_brd_val, 14.0 ]
                pad : 2
                for [ li: i32 start_line, li <= end_line, li += 1 ]
                    y_row  : f32 [ round[ y0 + f32[li] * lh - editor.scroll.y ] ]
                    if [ y_row + lh < bounds.y || y_row > bounds.y + bounds.h ] continue
                    is_sl  : bool [ li == start_line ]
                    is_el  : bool [ li == end_line ]
                    lnv    : editor.line_get[ li ]
                    dnv    : editor.display_of[ lnv ]
                    col_x0 : f32 [ (is_sl) ? cv.measure_text[ dnv.mid[ 0, editor.vis_col[ lnv, start_col ] ] ].w : 0.0 ]
                    col_x1 : f32 [ (is_el) ? cv.measure_text[ dnv.mid[ 0, editor.vis_col[ lnv, end_col ] ] ].w : bounds.w - gut_w - rin ]
                    bx     : f32 [ x0 + editor.row_indent[ li ] ]
                    rx     : f32 [ bx + col_x0 ]
                    rw     : f32 [ col_x1 - col_x0 ]

                    rr : rect [ x:rx + pad, y:y_row + pad,
                        w:rw - pad * 2, h:lh - pad * 2 ]
                    if [ editor.last_sel_line == li ]
                        if [ scrolled || resized ]
                            editor.filter_rect = null
                        if [ editor.filter_rect ]
                            gx  : f32 [ rr.x ]
                            gy  : f32 [ rr.y ]
                            gw  : f32 [ rr.w ]
                            gh  : f32 [ rr.h ]
                            amt : f32 [ 0.25 ]
                            rt  : f32 [ editor.ux.frame_factor ]
                            rr.x = filter_n[ editor.filter_rect.x, gx, amt, rt ]
                            rr.y = filter_n[ editor.filter_rect.y, gy, amt, rt ]
                            rr.w = filter_n[ editor.filter_rect.w, gw, amt, rt ]
                            rr.h = filter_n[ editor.filter_rect.h, gh, amt, rt ]
                            tol : f32 [ 0.5 ]
                            if [ abs[ gx - rr.x ] < tol && abs[ gy - rr.y ] < tol && abs[ gw - rr.w ] < tol && abs[ gh - rr.h ] < tol ]
                                rr.x = gx
                                rr.y = gy
                                rr.w = gw
                                rr.h = gh
                            el
                                editor.ux.will_animate = true
                                editor.needs_frame     = true

                        editor.filter_rect = rr
                        editor.filter_next = true

                    cv.fill_color  [ sel_col_val ]
                    cv.stroke_width[ 0.0 ]
                    cv.rect_to     [ rr.x, rr.y - 0.5, rr.w, rr.h + 1 ]
                    cv.paint       [ ]
                cv.restore[ ]

                tx : f32 [ cv.transform_tx[] ]
                ty : f32 [ cv.transform_ty[] ]
                for [ li: i32 start_line, li <= end_line, li += 1 ]
                    y_row  : f32 [ round[ y0 + f32[li] * lh - editor.scroll.y ] ]
                    if [ y_row + lh < bounds.y || y_row > bounds.y + bounds.h ] continue
                    is_sl  : bool [ li == start_line ]
                    is_el  : bool [ li == end_line ]
                    lnv    : editor.line_get[ li ]
                    dnv    : editor.display_of[ lnv ]
                    col_x0 : f32 [ (is_sl) ? cv.measure_text[ dnv.mid[ 0, editor.vis_col[ lnv, start_col ] ] ].w : 0.0 ]
                    col_x1 : f32 [ (is_el) ? cv.measure_text[ dnv.mid[ 0, editor.vis_col[ lnv, end_col ] ] ].w : bounds.w - gut_w - rin ]
                    bx     : f32 [ x0 + editor.row_indent[ li ] ]
                    rx     : f32 [ bx + col_x0 ]
                    rw     : f32 [ col_x1 - col_x0 ]
                    use_filter : bool [ editor.last_sel_line == li && editor.filter_rect ]
                    crop_x : f32 [ (use_filter) ? editor.filter_rect.x : rx ]
                    crop_w : f32 [ (use_filter) ? editor.filter_rect.w : rw ]
                    sel_lx : f32 [ (crop_x > bounds.x + gut_w) ? crop_x : bounds.x + gut_w ]
                    cv.set_crop[ tx + sel_lx, ty + bounds.y,
                        tx + crop_x + crop_w, ty + bounds.y + bounds.h ]
                    cv.fill_color[ '#fff' ]
                    cv.draw_text[ editor.display_of[ lnv ],
                        rect [ x: bx, y: y_row, w: bounds.w - gut_w, h: lh ],
                        vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
                cv.paint[ ]
                cv.set_crop[ tx + bounds.x + gut_w, ty + bounds.y,
                    tx + bounds.x + bounds.w, ty + bounds.y + bounds.h ]

            # lists are not text editors: never draw a caret there
            if [ parent.focused && !in_list ]
                y_sel : f32 [ round[ y0 + f32[editor.sel_line] * lh - editor.scroll.y ] ]
                if [ y_sel + lh >= bounds.y && y_sel <= bounds.y + bounds.h ]
                    use_fr : bool [ has_sel && editor.filter_rect ]
                    cx : f32
                    cy : f32
                    if [ use_fr ]
                        cx = (before) ? editor.filter_rect.x + editor.filter_rect.w : editor.filter_rect.x
                        cy = editor.filter_rect.y
                    el
                        clnv : editor.line_get[ editor.sel_line ]
                        pre  : editor.display_of[ clnv.mid[ 0, editor.sel_col ] ]
                        cx   = x0 + editor.row_indent[ editor.sel_line ] + cv.measure_text[ pre ].w
                        cy   = y_sel
                    cv.fill_color[ '#fff' ]
                    cv.stroke_width[ 0.0 ]
                    cv.rect_to[ cx, cy + 2.0, 2.0, lh - 4.0 ]
                    cv.paint[]

            cv.restore[ ]

        if [ editor.run_view && !editor.app_view && !editor.show_hits ]
            editor.run_view.draw_pip[ cv, bounds ]

        draw_tools[ cv, editor ]
        cv.clear_crop[ ]

        # the scopes the view is inside stay drawn at the top, over the rows
        # they would otherwise scroll past. a click on one goes there
        pins : vec i32 editor.pinned_rows[]
        if [ pins.count > 0 && !showing ]
            cmt_p : rgba['#7a8290']
            cv.font_size[ code_fs ]
            for [ pi: i32 0, pi < pins.count, pi += 1 ]
                pr : i32 [ pins[ pi ] ]
                pn : i32 [ pr + 1 ]
                py : f32 [ round[ bounds.y + f32[ pi ] * lh ] ]
                cv.fill_color[ rgba['#16161cf0'] ]
                cv.stroke_width[ 0.0 ]
                cv.rect_to[ bounds.x, py, bounds.w, lh ]
                cv.paint[ ]
                cv.fill_color[ rgba['#ffffff80'] ]
                cv.draw_text[ '{pn}',
                    rect [ x: bounds.x, y: py, w: gut_w - 6.0, h: lh ],
                    vec2f [ 1.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
                slc : code_slot[ cv, editor, pr, editor.draw_line[ pr ], cmt_p, lh, cw_tm.w, code_fs ]
                if [ slc && slc.canvas ]
                    cv.draw_canvas[ slc.canvas, x0, py,
                        f32[ slc.canvas.content_w ], f32[ slc.canvas.content_h ] ]
            cv.fill_color[ rgba['#ffffff26'] ]
            cv.rect_to[ bounds.x, round[ bounds.y + f32[ pins.count ] * lh ], bounds.w, 1.0 ]
            cv.paint[ ]


Control Editor
    style : CSS {
        layers.content: EditorLayer
            area: l0 t2px r0 b2px
            label_height: 1.0
            line_color: #44225588
            line_edge: #fff2
            line_gutter: #ffffff08
            item_color: #2b3a5500
            sel_color: #425
            sel_border: #ede3
            hl_fill: #ff6a2e55
            hl_grad: #c0381844
            hl_glow: #ff8a3a99
            hl_text: #ffe6d2
        layers.scrollbar: ScrollLayer
            overlay: true
            area: 8px
            thumb_color: #fff4
            thumb_w: 6.0
            thumb_min_h: 32.0
            thumb_radius: 4.0
    }
    public  selected      : bool
    public  expanded      : bool
    public  show_hits     : bool
    public  hits          : vec FindHit
    public  finder_list   : bool
    public  single_line   : bool
    public  nav_list      : bool
    public  grid_mode     : bool
    mutable thumb_cache   : map Texture[string]
    mutable g_cols        : i32
    mutable g_pins        : i32
    mutable g_resoff      : f32
    public  dock_rows     : i32
    public  header_size   : i32
    public  dir_size      : i32
    public  find_query    : string
    public  show_nav      : bool
    public  editor_mode   : string
    public  src           : path
    # commit hash this view diffs against; read-only stacked diff
    public  diff_commit   : string
    mutable loaded_diff   : string
    # per-row diff kind: 0 context, 1 removed, 2 added
    mutable diff_kinds    : vec i32
    # display row -> real file line; -1 on removed rows (base only)
    mutable diff_src      : vec i32
    # glyphs render here, then blit through fade_mask; fills bypass both
    mutable text_canvas   : Canvas
    mutable fade_mask     : Canvas
    mutable fade_w        : i32 [ -1 ]
    mutable fade_h        : i32 [ -1 ]
    mutable fade_t        : f32 [ -1.0 ]
    mutable fade_b        : f32 [ -1.0 ]
    mutable fade_l        : f32 [ -1.0 ]
    # commit's file lines, cached for live re-diff while editing
    mutable diff_base     : vec string
    mutable diff_dirty    : bool
    mutable diff_edit_ms  : i64
    mutable loaded_src    : path
    mutable nav           : Navigate
    mutable pane_index    : i32 [ 0 ]
    mutable rview         : ResourceView
    # the user's chosen view for this file; '' = default (first cell)
    mutable view_name     : string
    # '<view>|<file>' currently mounted; the only staleness check
    mutable mounted       : string
    mutable nav_tools     : vec string
    mutable nav_default   : string
    mutable tool_hover    : i32 [ -1 ]
    mutable run_view      : AppView
    mutable app_view      : bool
    mutable session_view  : string
    mutable saved_scroll  : f32
    intern static view_registry : map Au_t[string]
    intern static view_by_name  : map Au_t[string]
    intern static export_registry : map string[string]
    # ext -> the FileType its owning module exported (ascii/binary/agnostic)
    intern static export_ftype    : map string[string]
    # ext -> the <owner>-<module> export stem, which names its lib
    intern static export_lib      : map string[string]
    intern static bin_view_cached : string
    mutable lines         : list string
    mutable close_icon    : SVGModel
    mutable pin_icon      : SVGModel
    mutable file_icon     : SVGModel
    mutable module_icon   : SVGModel
    mutable folder_icon   : SVGModel
    mutable ficons        : FileIcons
    mutable was_showing   : bool
    # ctrl/cmd is held: resolvable symbols outline as clickable targets
    mutable mod_down      : bool
    mutable hover_gutter  : bool
    # true while dragging the scrollbar thumb
    mutable scroll_dragging : bool
    mutable sel_line      : i32 [ -1 ]
    mutable sel_col       : i32 [ 0 ]
    mutable tab_w         : i32 [ 4 ]
    # currently expanded variables, outermost first
    mutable open_chain    : vec Au
    mutable fmt_mtime     : i64 [ 0 ]
    mutable disk_ms       : i64 [ 0 ]
    mutable scroll_target : f32 [ 0.0 ]
    mutable pending_wheel : f32 [ 0.0 ]
    mutable hx_last_y     : f32 [ 0.0 ]
    mutable text_lines_frame : i32 [ 0 ]
    mutable text_lines_total : i64 [ 0 ]
    mutable code_lines    : vec EdLineCache
    mutable cl_frame      : i32 [ 0 ]
    mutable cl_cw         : f32 [ 0.0 ]
    mutable cl_lh         : f32 [ 0.0 ]

    mutable cur_buf       : FileBuf
    mutable hist          : list EditAction
    mutable hist_i        : i32 [ 0 ]
    mutable cur_group     : EditAction
    mutable pend_sl0      : i32 [ 0 ]
    mutable pend_sc0      : i32 [ 0 ]
    mutable edit_kind     : i32 [ -1 ]
    mutable edit_cl       : i32 [ -1 ]
    mutable edit_cc       : i32 [ -1 ]
    mutable stop_line     : i32 [ -1 ]
    mutable stop_col      : i32 [ -1 ]
    public  debug_running : bool
    public  debugger      : dbg
    public  debug_vars    : vec Au
    mutable flat_rows     : vec VRow
    mutable flat_active   : bool
    mutable hover_ann     : i32 [ -1 ]
    mutable lh_cache      : f32 [ 0.0 ]
    mutable cw_cache      : f32 [ 0.0 ]
    mutable anchor_line   : i32 [ 0 ]
    mutable dragging      : bool
    mutable cursor_idx    : i32 [ -1 ]
    mutable last_sel_line : -1
    mutable last_sel_col  : -1
    mutable last_before   : false
    mutable filter_rect   : rect
    mutable filter_next   : false
    mutable last_scroll_y : f32
    mutable last_view_w   : f32
    mutable hover_line    : i32 [ -1 ]
    mutable gutter_w      : f32 [ 0.0 ]
    public  breakpoints   : map string[string]
    public  code_font_size : i32
    mutable dbg_open      : bool
    public  band_rows     : i32
    public  replacing     : bool
    # append LAST: member order sets AF bit indices
    mutable fade_r        : f32 [ -1.0 ]

    func bp_color [ cond: string ] -> rgba
        if [ cond && cond.count > 0 ] return rgba['#3b82f638']   # conditional
        return rgba['#e5394538']                                 # plain

    # does this line declare v — 'name' followed by ':'
    func line_declares [ ltext: string, bli: i32, v: variable ] -> bool
        if [ !v || !v.name || v.name.count == 0 ] return false
        nm  : string v.name
        pos : i32 [ ltext.index_of[ nm ] ]
        if [ pos < 0 ] return false
        if [ pos > 0 ]
            pc : i32 [ ltext[ pos - 1 ] ]
            if [ (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || (pc >= 48 && pc <= 57) || pc == 95 ] return false
        j : i32 [ pos + nm.count ]
        while [ j < ltext.count && (ltext[j] == 32 || ltext[j] == 9) ]
            j += 1
        if [ j >= ltext.count || ltext[j] != 58 ] return false
        if [ stop_line >= 0 && bli == stop_line && stop_col >= 0 && stop_col <= pos ] return false
        return true

    # the variable a line declares: a local or arg, else a member of self.
    # member lines carry their own value rather than making you expand 'a'
    func base_var_of [ bli: i32 ] -> variable
        if [ !debug_vars || bli < 0 || bli >= lines.count ] return null
        if [ stop_line >= 0 && bli > stop_line ] return null
        line : string lines.value_by_index[ bli ]
        if [ !line || line.count == 0 ] return null
        for [ k: i32 0, k < debug_vars.count, k += 1 ]
            v : variable debug_vars[k]
            if [ line_declares[ line, bli, v ] ] return v
        for [ k: i32 0, k < debug_vars.count, k += 1 ]
            sv : variable debug_vars[k]
            # count first: an empty string's chars are null, and compare
            # goes straight to strcmp
            if [ !sv || !sv.name || sv.name.count != 1 ] continue
            if [ sv.name[0] != 97 ] continue                  # 'a' — self
            if [ !sv.children ] continue
            for [ ci: i32 0, ci < sv.children.count, ci += 1 ]
                cv9 : variable sv.children[ci]
                if [ line_declares[ line, bli, cv9 ] ] return cv9
        return null

    # one expansion open at a time, unless it nests inside the open one.
    # the chain is outermost-first; esc collapses the innermost
    func expand_only [ v9: variable ]
        if [ !v9 ] return
        if [ !open_chain ] open_chain = vec Au []
        nested : bool [ false ]
        if [ open_chain.count > 0 ]
            lastv : variable open_chain[ open_chain.count - 1 ]
            if [ lastv && lastv.children ]
                for [ ci: i32 0, ci < lastv.children.count, ci += 1 ]
                    if [ lastv.children[ci] == v9 ] nested = true
        if [ !nested ]
            for [ i9: i32 0, i9 < open_chain.count, i9 += 1 ]
                ov : variable open_chain[i9]
                if [ ov ] ov.expanded = false
            open_chain = vec Au []
        v9.expanded = true
        open_chain.push[ v9 ]

    func collapse_last [] -> bool
        if [ !open_chain || open_chain.count == 0 ] return false
        lv : variable open_chain[ open_chain.count - 1 ]
        if [ lv ] lv.expanded = false
        open_chain.remove[ open_chain.count - 1 ]
        return true

    # collapse v and anything the chain opened under it
    func collapse_from [ v9: variable ]
        if [ !open_chain ] return
        for [ i9: i32 0, i9 < open_chain.count, i9 += 1 ]
            if [ open_chain[i9] == v9 ]
                while [ open_chain.count > i9 ]
                    ov : variable open_chain[ open_chain.count - 1 ]
                    if [ ov ] ov.expanded = false
                    open_chain.remove[ open_chain.count - 1 ]
                return
        v9.expanded = false

    # the line AS DRAWN: a debug annotation takes the comment's place, so
    # the comment is never rendered. hash, measure and draw must all use this
    func draw_line [ vr: i32 ] -> string
        s : string line_get[ vr ]
        if [ !debug_vars || !s || s.count == 0 ] return s
        if [ !base_var_of[ row_src[ vr ] ] ] return s
        return code_only[ s ]

    # cell column where a row's annotation starts: first tab stop past the
    # code, with any existing comment excluded
    func ann_col [ vr: i32 ] -> i32
        s : string display_of[ code_only[ line_get[ vr ] ] ]
        return (s.count / tab_w + 1) * tab_w

    func var_summary [ v: variable ] -> string
        if [ !v ] return ''
        nm : string v.name
        if [ v.children && v.children.count > 0 ]
            sum : string [ '' ]
            n   : i32 [ (v.children.count < 2) ? v.children.count : 2 ]
            for [ ci: i32 0, ci < n, ci += 1 ]
                c    : variable v.children[ci]
                part : '{c.name}: {c.value}'
                sum = (ci > 0) ? sum + ', ' + part : part
            if [ v.children.count > 2 ] sum = sum + ', ...'
            return nm + ' = (' + sum + ')'
        return '{nm} = {v.value}'

    # has fields → expandable.
    func var_expandable [ v: variable ] -> bool
        return v && v.children && v.children.count > 0

    func splice_var [ v: variable, depth: i32 ]
        if [ !v || !v.expanded || !v.children ] return
        for [ ci: i32 0, ci < v.children.count, ci += 1 ]
            c : variable v.children[ci]
            flat_rows.push[ VRow [ src: -1, var: c, depth: depth ] ]
            splice_var[ c, depth + 1 ]

    func rebuild_flat []
        flat_rows = vec VRow []
        flat_active = false
        if [ !debug_vars ] return
        base : i32 [ lines.count ]
        for [ bli: i32 0, bli < base, bli += 1 ]
            flat_rows.push[ VRow [ src: bli ] ]
            bv9 : variable base_var_of[ bli ]
            if [ bv9 ]
                splice_var[ bv9, 1 ]
        flat_active = flat_rows.count > base

    # flat-row accessors (identity when no tree is open).
    # a diff's rows are base+current merged: map back to the real file line.
    # finder rows are not the file's rows at all — identity there
    func row_src [ vr: i32 ] -> i32
        if [ diff_src && !show_hits && !finder_list && vr >= 0 && vr < diff_src.count ]
            return diff_src[ vr ]
        if [ !flat_active || !flat_rows || vr < 0 || vr >= flat_rows.count ] return vr
        r : VRow flat_rows[ vr ]
        return r.src

    func row_var [ vr: i32 ] -> variable
        if [ !flat_active || !flat_rows || vr < 0 || vr >= flat_rows.count ] return null
        r : VRow flat_rows[ vr ]
        return r.var

    func row_depth [ vr: i32 ] -> i32
        if [ !flat_active || !flat_rows || vr < 0 || vr >= flat_rows.count ] return 0
        r : VRow flat_rows[ vr ]
        return r.depth

    func row_indent [ vr: i32 ] -> f32
        if [ row_var[ vr ] ] return 12.0 + f32[ row_depth[ vr ] ] * 16.0
        return 0.0

    func vis_row [ bli: i32 ] -> i32
        if [ bli < 0 ] return bli
        if [ !flat_active || !flat_rows ] return bli
        for [ vr: i32 0, vr < flat_rows.count, vr += 1 ]
            r : VRow flat_rows[ vr ]
            if [ r.src == bli ] return vr
        return bli

    func line_count [] -> i32
        if [ show_hits && hits ] return hits.count
        if [ flat_active && flat_rows ] return flat_rows.count
        # a pane mid-transition can be asked before lines exist
        return (lines) ? lines.count : 0

    func row_header [ i: i32 ] -> bool
        if [ show_hits && hits && i >= 0 && i < hits.count ] return hits[i].is_header
        return false

    func row_cont [ i: i32 ] -> bool
        if [ show_hits && hits && i >= 0 && i < hits.count ]
            return hits[i].is_header && hits[i].text.count == 0 && !hits[i].is_spacer
        return false

    func row_spacer [ i: i32 ] -> bool
        if [ show_hits && hits && i >= 0 && i < hits.count ] return hits[i].is_spacer
        return false

    # default-action cell count: 1 when the extension has a handler
    func tool_base [] -> i32
        return (nav_default && nav_default.count > 0) ? 1 : 0

    # left tool rail: cell index under the mouse, -1 off
    func tool_hit [ mx: f32, my: f32 ] -> i32
        if [ !nav_tools || nav_tools.count == 0 ] return -1
        ele : (layers) ? cast EditorLayer [ layers['content'] ] : null
        if [ !ele || !ele.bounds ] return -1
        rx : f32 [ mx - ele.bounds.x ]
        ry : f32 [ my - ele.bounds.y ]
        if [ rx < 0.0 || rx > 64.0 ] return -1
        if [ ry < 4.0 ] return -1
        idx : i32 [ (ry - 4.0) / 68.0 ]
        if [ idx < 0 || idx >= tool_base[] + nav_tools.count ] return -1
        return idx

    func word_char [ c: i32 ] -> bool
        return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95

    func cursor_token [] -> string
        if [ sel_line < 0 || sel_line >= line_count[] ] return ''
        if [ row_header[ sel_line ] ] return ''
        ln : line_get[ sel_line ]
        n  : i32 [ ln.count ]
        if [ n == 0 ] return ''
        s  : i32 [ clamp[ sel_col, 0, n ] ]
        if [ s >= n || !word_char[ i32[ ln[s] ] ] ] s = s - 1
        if [ s < 0 || !word_char[ i32[ ln[s] ] ] ] return ''
        a : i32 [ s ]
        while [ a > 0 && word_char[ i32[ ln[a - 1] ] ] ] a -= 1
        b : i32 [ s ]
        while [ b < n - 1 && word_char[ i32[ ln[b + 1] ] ] ] b += 1
        return ln.mid[ a, b - a + 1 ]

    # the modifier is only known from events we actually receive, and a
    # key RELEASE may never reach us (focus, or consumed upstream). mouse
    # moves carry live modifier state and keep arriving, so the flag
    # corrects itself instead of sticking on
    func note_mod [ ev: Event ]
        md9 : bool [ ev.key.ctrl || ev.key.meta ]
        # GLFW reports mods as they stood BEFORE the event, so pressing
        # ctrl/cmd itself arrives with its own bit still clear. take the
        # keycode's own state for those, or the outline waits for the
        # next event that happens to carry the flag
        k9 : i32 [ ev.key.unicode ]
        if [ k9 == 341 || k9 == 345 || k9 == 343 || k9 == 347 ]
            md9 = ev.key.state != 0
        if [ md9 == mod_down ] return
        mod_down = md9
        pristine = false
        if [ ux ] ux.will_animate = true

    # the region under a column, or null. regions come straight from the
    # format map, so this carries the compiler's own classification AND
    # the declaration site it resolved to
    func region_at [ ml: i32, col: i32 ] -> ColorRegion
        n9 : i32 [ line_reg_count[ ml ] ]
        for [ ri: i32 0, ri < n9, ri += 1 ]
            cr : ColorRegion line_reg[ ml, ri ]
            if [ col >= cr.col && col < cr.col + cr.len ] return cr
        return null

    # a module's own source: a sibling of the file that imports it, or
    # its root module directory. nothing else knows where a module lives
    func module_path [ nm: string ] -> path
        if [ !nm || nm.count == 0 ] return null
        if [ src ]
            sib : path '{src.directory[]}/{nm}.ag'
            if [ sib.exists[] ] return sib
        sp : path.path_startup[]
        if [ sp ]
            fp : path '{sp}/{nm}/{nm}.ag'
            if [ fp.exists[] ] return fp
        return null


    func select_word []
        if [ sel_line < 0 || sel_line >= line_count[] ] return
        if [ row_header[ sel_line ] ] return
        ln : line_get[ sel_line ]
        n  : i32 [ ln.count ]
        if [ n == 0 ] return
        s  : i32 [ clamp[ sel_col, 0, n ] ]
        if [ s >= n || !word_char[ i32[ ln[s] ] ] ] s = s - 1
        if [ s < 0 || !word_char[ i32[ ln[s] ] ] ] return
        a : i32 [ s ]
        while [ a > 0 && word_char[ i32[ ln[a - 1] ] ] ] a -= 1
        b : i32 [ s ]
        while [ b < n - 1 && word_char[ i32[ ln[b + 1] ] ] ] b += 1
        anchor_line = sel_line
        anchor_col  = a
        sel_col     = b + 1

    func snap_row [ ln: i32 ] -> i32
        n : i32 [ line_count[] ]
        if [ n <= 0 ] return 0
        r : i32 [ clamp[ ln, 0, n - 1 ] ]
        if [ !row_header[ r ] ] return r
        for [ i: i32 r, i < n, i += 1 ]
            if [ !row_header[ i ] ] return i
        for [ i: i32 r, i >= 0, i -= 1 ]
            if [ !row_header[ i ] ] return i
        return r

    func prev_editable [ ln: i32 ] -> i32
        r : i32 [ ln ]
        while [ r >= 0 && row_header[ r ] ] r -= 1
        return r

    func next_editable [ ln: i32 ] -> i32
        r : i32 [ ln ]
        n : i32 [ line_count[] ]
        while [ r < n && row_header[ r ] ] r += 1
        return r

    # arrows drive the list highlight exactly as the mouse does
    # false when it ran off the end — the caller decides where focus goes
    func hover_step [ d: i32 ] -> bool
        n : i32 [ line_count[] ]
        r : i32 [ hover_line ]
        while [ true ]
            r += d
            if [ r < 0 || r >= n ] return false
            if [ row_spacer[ r ] ] continue
            if [ row_cont[ r ] ] continue
            break
        hover_line = r
        lh9 : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
        top : f32 [ f32[ r ] * lh9 ]
        vh9 : f32 [ (bounds) ? bounds.h : 600.0 ]
        if [ top < scroll_target ] scroll_target = top
        el [ top + lh9 > scroll_target + vh9 ] scroll_target = top + lh9 - vh9
        pristine = false
        if [ ux ] ux.will_animate = true

    func group_start [ ln: i32 ] -> i32
        r : i32 [ ln ]
        while [ r > 0 && !row_header[ r - 1 ] ] r -= 1
        return r

    func group_end [ ln: i32 ] -> i32
        r : i32 [ ln ]
        n : i32 [ line_count[] ]
        while [ r < n - 1 && !row_header[ r + 1 ] ] r += 1
        return r

    func remove_hit [ idx: i32 ]
        if [ !hits || idx < 0 || idx >= hits.count ] return
        if [ row_header[ idx ] ] return
        gs   : i32  [ group_start[ idx ] ]
        only : bool [ gs == group_end[ idx ] ]
        hits.remove[ idx ]
        if [ only && gs >= 2 ]
            hits.remove[ gs - 1 ]
            hits.remove[ gs - 2 ]

    func remove_group [ idx: i32 ]
        if [ !hits || idx < 0 || idx >= hits.count || !row_header[ idx ] ] return
        hs : i32 [ idx ]
        while [ hs > 0 && row_header[ hs - 1 ] ] hs -= 1   # first header slot
        n  : i32 [ line_count[] ]
        he : i32 [ hs ]
        while [ he < n && row_header[ he ] ] he += 1       # past the header slots
        while [ he < n && !row_header[ he ] ] he += 1      # past the match rows
        # remove back-to-front so lower indices don't shift under us
        for [ i: i32 he - 1, i >= hs, i -= 1 ]
            hits.remove[ i ]


    func vis_col [ s: string, c: i32 ] -> i32
        v : i32 [ 0 ]
        for [ i: i32 0, i < c && i < s.count, i += 1 ]
            if [ s[i] == 9 ] v = (v / tab_w + 1) * tab_w
            el               v += 1
        return v

    func model_col [ s: string, vx: i32 ] -> i32
        v : i32 [ 0 ]
        for [ i: i32 0, i < s.count, i += 1 ]
            adv : i32 [ (s[i] == 9) ? ((v / tab_w + 1) * tab_w - v) : 1 ]
            if [ vx < v + (adv + 1) / 2 ] return i
            v += adv
        return s.count

    # the code before a trailing '#' comment, with the gap trimmed. a debug
    # annotation replaces the comment on that line rather than colliding
    func code_only [ s: string ] -> string
        if [ !s ] return s
        for [ i: i32 0, i < s.count, i += 1 ]
            if [ s[i] == 35 ]
                e : i32 [ i ]
                while [ e > 0 && (s[e - 1] == 32 || s[e - 1] == 9) ]
                    e -= 1
                return s.mid[ 0, e ]
        return s

    func display_of [ s: string ] -> string
        ht : bool [ false ]
        for [ i: i32 0, i < s.count, i += 1 ]
            if [ s[i] == 9 ]
                ht = true
                break
        if [ !ht ] return s
        out : string [ '' ]
        v   : i32 [ 0 ]
        for [ i: i32 0, i < s.count, i += 1 ]
            if [ s[i] == 9 ]
                sp : i32 [ (v / tab_w + 1) * tab_w - v ]
                for [ k: i32 0, k < sp, k += 1 ]
                    out = out + ' '
                v += sp
            el
                out = out + s.mid[ i, 1 ]
                v += 1
        return out


    func fmt_theme [ kind: i32 ] -> rgba
        switch [ kind ]
            case 1                          # keyword
                return rgba['#569cd6']
            case 2, 14                      # type, namespace
                return rgba['#4ec9b0']
            case 4                          # function
                return rgba['#dcdcaa']
            case 5, 6                       # param, property
                return rgba['#9cdcfe']
            case 7                          # number
                return rgba['#b5cea8']
            case 8, 9                       # string, character
                return rgba['#ce9178']
            case 10                         # boolean
                return rgba['#569cd6']
            case 11                         # comment
                return rgba['#6a9955']
            case 13                         # punctuation
                return rgba['#808080']
            case 15                         # constant
                return rgba['#4fc1ff']
            case 16                         # usertoken
                return rgba['#c586c0']
            case 17                         # parent class (Parent Child) — yellow
                return rgba['#d7ba7d']
            case 18                         # class name being defined — bright gold-green
                return rgba['#dcdc8a']
            case 19                         # meta / generic type arg — orange-tan
                return rgba['#d1a36a']
            default                         # none / ident / op
                return rgba['#d4d4d4']

    # buffers live on orbiter: one mapping shared by every pane
    func buffers [] -> map FileBuf [string]
        orb : cast orbiter [ ux.app_object ]
        if [ !orb ] return null
        if [ !orb.file_cache ] orb.file_cache = map FileBuf [string] []
        return orb.file_cache

    func line_reg_count [ ml: i32 ] -> i32
        if [ !cur_buf || !cur_buf.line_regs ] return 0
        if [ ml < 0 || ml >= cur_buf.line_regs.count ] return 0
        regs : vec ColorRegion cur_buf.line_regs[ ml ]
        return (regs) ? regs.count : 0

    func line_reg [ ml: i32, k: i32 ] -> ColorRegion
        regs : vec ColorRegion cur_buf.line_regs[ ml ]
        cr   : ColorRegion regs[ k ]
        return cr

    func fmt_invalidate []
        if [ cur_buf ]
            cur_buf.line_regs = null

    # keep the edited line's colors aligned: shift columns past the
    # changed span, drop regions the change touched
    func edit_line_regs [ i: i32, before: string, after: string ]
        if [ !cur_buf || !cur_buf.line_regs ] return
        if [ i < 0 || i >= cur_buf.line_regs.count ] return
        regs : vec ColorRegion cur_buf.line_regs[ i ]
        if [ !regs || regs.count == 0 ] return
        p : i32 [ 0 ]
        while [ p < before.count && p < after.count && before[p] == after[p] ] p += 1
        s : i32 [ 0 ]
        while [ s < before.count - p && s < after.count - p && before[before.count - 1 - s] == after[after.count - 1 - s] ] s += 1
        d : i32 [ after.count - before.count ]
        e : i32 [ before.count - s ]
        kept : vec ColorRegion []
        for [ ri: i32 0, ri < regs.count, ri += 1 ]
            cr : ColorRegion regs[ ri ]
            if [ cr.col + cr.len <= p ]
                kept.push[ cr ]
            el [ cr.col >= e ]
                cr.col = cr.col + d
                kept.push[ cr ]
        cur_buf.line_regs[ i ] = kept

    public func load_format [ mapfile: string ]
        mp    : path  '{mapfile}'
        files : vec Au mp.read_format[]
        if [ !files ] return
        for [ fi: i32 0, fi < files.count, fi += 1 ]
            ff  : fmt_file files[fi]
            apply_format[ ff ]

    # a loaded buffer for this file; colouring never creates one, since
    # load_text treats an existing buffer as already read
    public func has_buffer [ p: path ] -> bool
        fcm : map FileBuf [string] buffers[]
        buf : FileBuf (fcm) ? fcm[ '{p.absolute[]}' ] : null
        return (buf && buf.lines) ? true : false

    # one file's map, from the .f or straight from its handler module
    public func apply_format [ ff: fmt_file ]
        if [ !ff || !ff.source ] return
        key : string '{ff.source}'
        fcm : map FileBuf [string] buffers[]
        buf : FileBuf fcm[ key ]
        if [ !buf ] return
        buf.line_regs  = vec Au []
        buf.line_scope = ff.scopes
        lns : vec Au ff.lines
        nl  : i32 [ lns.count ]
        for [ li: i32 0, li < nl, li += 1 ]
            ltk  : vec fmt_token lns[ li ]
            regs : vec ColorRegion []
            nt   : i32 [ ltk.count ]
            for [ ti: i32 0, ti < nt, ti += 1 ]
                tk : fmt_token ltk[ ti ]
                regs.push[ ColorRegion [ col: i32 tk.column, len: i32 tk.length, color: fmt_theme[ i32 tk.syntax ], kind: i32 tk.syntax, dsrc: tk.decl_source, dline: i32 tk.decl_line ] ]
            buf.line_regs.push[ regs ]

    # the definition the top line in view sits inside, by the map's scopes
    public func scope_at [] -> string
        if [ !cur_buf || !cur_buf.line_scope ] return null
        scopes : vec Au cur_buf.line_scope
        lh  : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
        top : i32 [ scroll.y / lh ]
        if [ top < 0 || top >= scopes.count ] return null
        entry : fmt_scope scopes[ top ]
        if [ !entry || !entry.name || entry.name.count == 0 ] return null
        return entry.name

    # the line a scope was declared on, by its qualified name
    public func scope_line [ name: string ] -> i32
        if [ !cur_buf || !cur_buf.line_scope || !name ] return -1
        scopes : vec Au cur_buf.line_scope
        for [ i: i32 0, i < scopes.count, i += 1 ]
            entry : fmt_scope scopes[ i ]
            if [ entry && entry.name && entry.name == name ] return i32 entry.line
        return -1

    # the declaration rows kept drawn at the top: the scopes the first
    # visible row is inside, each only once its own row has scrolled off
    public func pinned_rows [] -> vec i32
        rows : vec i32 []
        name : string scope_at[]
        if [ !name || name.count == 0 || show_hits || flat_active ] return rows
        lh  : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
        top : i32 [ scroll.y / lh ]
        dot : i32 [ name.index_of[ '.' ] ]
        if [ dot > 0 ]
            head : i32 [ scope_line[ name.mid[ 0, dot ] ] ]
            if [ head > 0 && head - 1 < top ] rows.push[ head - 1 ]
        inner : i32 [ scope_line[ name ] ]
        below : i32 [ top + i32[ rows.count ] ]
        if [ inner > 0 && inner - 1 < below ] rows.push[ inner - 1 ]
        return rows

    # put the caret on a 1-based line and bring it into view
    public func goto_line [ lno: i32 ]
        sl : i32 [ (lno > 0) ? lno - 1 : 0 ]
        sel_line    = sl
        anchor_line = sl
        lh  : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
        vh  : f32 [ (bounds) ? bounds.h : 600.0 ]
        top : f32 [ f32[ sl ] * lh ]
        if [ top < scroll.y || top + lh > scroll.y + vh ]
            scroll.y = top - vh * 0.4
            if [ scroll.y < 0.0 ] scroll.y = 0.0
            scroll_target = scroll.y
        pristine = false

    func line_get [ vr: i32 ] -> string
        if [ show_hits && hits ]
            if [ vr >= 0 && vr < hits.count ] return hits[vr].text
            return ''
        if [ flat_active && flat_rows && vr >= 0 && vr < flat_rows.count ]
            r : VRow flat_rows[ vr ]
            if [ r.src >= 0 ]
                fs : string lines.value_by_index[ r.src ]
                return (fs) ? fs : ''
            return '# {r.var.name} = {r.var.value}'
        if [ vr >= 0 && vr < lines.count ]
            s : string lines.value_by_index[ vr ]
            return (s) ? s : ''
        return ''

    func console_line_count [] -> i32
        return line_count[]

    func console_line [ vr: i32 ] -> string
        return line_get[ vr ]

    func line_set [ i: i32, val: string ]
        if [ show_hits && hits ]
            hits[i].text = val
            return
        old : string line_get[ i ]
        lines.remove[ i ]
        lines.insert_after[ val, i - 1 ]
        edit_line_regs[ i, old, val ]


    # raw line ops (no recording) — used by undo/redo replay.
    func raw_set    [ i: i32, val: string ]    line_set[ i, val ]
    func raw_insert [ i: i32, val: string ]
        lines.insert_after[ val, i - 1 ]
        if [ cur_buf && cur_buf.line_regs && i <= cur_buf.line_regs.count ]
            cur_buf.line_regs.insert[ vec ColorRegion [], i ]
        # a new line belongs to the scope the line above it is in
        if [ cur_buf && cur_buf.line_scope && i > 0 && i <= cur_buf.line_scope.count ]
            cur_buf.line_scope.insert[ cur_buf.line_scope[ i - 1 ], i ]
    func raw_remove [ i: i32 ]
        if [ cur_buf && cur_buf.line_regs ]
            cur_buf.line_regs.remove[ i ]
        if [ cur_buf && cur_buf.line_scope && i < cur_buf.line_scope.count ]
            cur_buf.line_scope.remove[ i ]
        lines.remove[ i ]

    func rec [ op: LineOp ]
        if [ show_hits || diff_commit ] return
        if [ !cur_group ]
            while [ hist && hist.count > hist_i ]
                hist.pop[]
            cur_group = EditAction []
            cur_group.ops = vec LineOp []
            cur_group.sl0 = pend_sl0
            cur_group.sc0 = pend_sc0
            hist.push[ cur_group ]
            hist_i = hist.count
        n : i32 [ cur_group.ops.count ]
        if [ op.kind == 0 && n > 0 ]
            last2 : LineOp cur_group.ops[ n - 1 ]
            if [ last2.kind == 0 && last2.at == op.at ]
                last2.after = op.after          # collapse same-line replaces
                touch_hist[]
                return
        cur_group.ops.push[ op ]
        touch_hist[]

    func ed_set [ i: i32, val: string ]
        old : line_get[ i ]
        line_set[ i, val ]
        if [ diff_commit ]
            # touching a commit-only row adopts it into our file
            if [ diff_kinds && i < diff_kinds.count && diff_kinds[i] == 1 ]
                diff_kinds[i] = 2
            diff_dirty   = true
            diff_edit_ms = epoch_millis[]
            return
        rec[ LineOp [ at: i, kind: 0, before: old, after: val ] ]

    func ed_insert [ i: i32, val: string ]     # val becomes line i (shifts the rest down)
        raw_insert[ i, val ]                    # inserts the line AND its empty region row
        if [ diff_commit ]
            kinds_insert[ i ]
            diff_dirty   = true
            diff_edit_ms = epoch_millis[]
            return
        rec[ LineOp [ at: i, kind: 1, after: val ] ]

    func ed_remove [ i: i32 ]
        old : line_get[ i ]
        raw_remove[ i ]                         # removes the line AND its region row
        if [ diff_commit ]
            kinds_remove[ i ]
            diff_dirty   = true
            diff_edit_ms = epoch_millis[]
            return
        rec[ LineOp [ at: i, kind: 2, before: old ] ]

    func swap_lines [ to: list string ]
        while [ lines.count > 0 ] lines.pop[]
        for [ s: string ] in to
            lines.push[ s ]
        # whole-buffer swap: per-line regions no longer correspond
        fmt_invalidate[]

    func apply_undo [ g: EditAction ]
        if [ g.full_before ]
            swap_lines[ g.full_before ]
            sel_line    = g.sl0
            sel_col     = g.sc0
            anchor_line = g.sl0
            anchor_col  = g.sc0
            return
        for [ k: i32 g.ops.count - 1, k >= 0, k -= 1 ]
            op : LineOp g.ops[ k ]
            if [ op.kind == 0 ]
                raw_set[ op.at, op.before ]
            el [ op.kind == 1 ]
                raw_remove[ op.at ]
            el
                raw_insert[ op.at, op.before ]
        sel_line    = g.sl0
        sel_col     = g.sc0
        anchor_line = g.sl0
        anchor_col  = g.sc0

    func apply_redo [ g: EditAction ]
        if [ g.full_after ]
            swap_lines[ g.full_after ]
            sel_line    = g.sl1
            sel_col     = g.sc1
            anchor_line = g.sl1
            anchor_col  = g.sc1
            return
        for [ k: i32 0, k < g.ops.count, k += 1 ]
            op : LineOp g.ops[ k ]
            if [ op.kind == 0 ]
                raw_set[ op.at, op.after ]
            el [ op.kind == 1 ]
                raw_insert[ op.at, op.after ]
            el
                raw_remove[ op.at ]
        sel_line    = g.sl1
        sel_col     = g.sc1
        anchor_line = g.sl1
        anchor_col  = g.sc1

    func swap_history [ buf: FileBuf ]
        if [ cur_buf == buf && buf.hist ] return    # already live → keep the live cursor
        if [ cur_buf && cur_buf != buf ]
            cur_buf.hist_i = hist_i
        if [ !buf.hist ]
            buf.hist   = list EditAction []
            buf.hist_i = 0
        hist      = buf.hist
        hist_i    = buf.hist_i
        cur_group = null
        edit_kind = -1
        edit_cl   = -1
        edit_cc   = -1
        cur_buf   = buf

    func touch_hist []
        if [ cur_buf ] cur_buf.hist_i = hist_i

    func begin_edit [ kind: i32 ]
        if [ show_hits ] return
        jumped : bool [ sel_line != edit_cl || sel_col != edit_cc ]
        if [ edit_kind != kind || jumped ]
            cur_group = null
            edit_kind = kind
        if [ !cur_group ]
            pend_sl0 = sel_line     # caret before the (upcoming) group's first op
            pend_sc0 = sel_col

    func end_edit []
        edit_cl = sel_line
        edit_cc = sel_col
        if [ cur_group ]
            cur_group.sl1 = sel_line
            cur_group.sc1 = sel_col

    func undo []
        if [ rview && rview.view_undo*[] ] return
        if [ show_hits || !hist ] return
        cur_group = null
        edit_kind = -1
        if [ hist_i <= 0 ] return
        hist_i -= 1
        apply_undo[ hist.value_by_index[ hist_i ] ]
        edit_cl = sel_line
        edit_cc = sel_col
        ensure_caret_visible[]
        touch_hist[]
        pristine = false

    func redo []
        if [ rview && rview.view_redo*[] ] return
        if [ show_hits || !hist ] return
        cur_group = null
        edit_kind = -1
        if [ hist_i >= hist.count ] return
        apply_redo[ hist.value_by_index[ hist_i ] ]
        hist_i += 1
        edit_cl = sel_line
        edit_cc = sel_col
        ensure_caret_visible[]
        touch_hist[]
        pristine = false

    func save_current []
        if [ rview && rview.view_text*[ rview.view_sel ] ]
            ok : i32 [ 0 ]
            bad : i32 [ 0 ]
            n : i32 [ line_count[] ]
            for [ li: i32 0, li < n, li += 1 ]
                ln : line_get[ li ]
                if [ !ln || ln.count == 0 ] continue
                if [ rview.commit_line*[ ln ] ] ok += 1
                el bad += 1
            puts 'assembly: {ok} lines applied, {bad} rejected'
            return
        if [ show_hits && hits ]
            if [ sel_line < 0 || sel_line >= hits.count ] return
            target : path [ hits[sel_line].file ]
            if [ !target ] return
            tkey    : '{target}'
            ftext : string [ target.load[ typeid[string], null ] ]
            if [ !ftext ] return
            parts : ftext.split["\n"]
            for [ i: i32 0, i < hits.count, i += 1 ]
                h : FindHit hits[i]
                if [ h.is_header ]
                    continue
                if [ '{h.file}' != tkey ]
                    continue
                idx : i32 [ h.line - 1 ]
                if [ idx >= 0 && idx < parts.count ] parts[idx] = h.text
            out : string [ '' ]
            for [ i: i32 0, i < parts.count, i += 1 ]
                if [ i > 0 ] out = out + '\n'
                out = out + parts[i]
            tp : path '{target}'
            tp.save[ out, null ]
            return
        if [ !src ] return
        out   : string [ '' ]
        wrote : i32 [ 0 ]
        for [ i: i32 0, i < lines.count, i += 1 ]
            # diff view: commit-only rows are not ours to save
            if [ diff_commit && diff_kinds && i < diff_kinds.count && diff_kinds[i] == 1 ] continue
            if [ wrote > 0 ] out = out + '\n'
            out = out + line_get[ i ]
            wrote += 1
        sp : path '{src}'
        sp.save[ out, null ]
        # a save changes the repo: refresh the git snapshot now
        orb2 : cast orbiter [ ux.app_object ]
        if [ orb2 ] orb2.git_summarize[]
        # stamp the cache or our own save reads as an external change
        fcm9 : map FileBuf [string] buffers[]
        buf9 : FileBuf fcm9[ '{src.absolute[]}' ]
        if [ buf9 ]
            buf9.mtime  = src.modified_time[]
            buf9.sync_i = hist_i

    func file_ext [ p: path ] -> string
        fn  : string p.filename[]
        n   : i32 [ fn.count ]
        dot : i32 [ -1 ]
        for [ i: i32 0, i < n, i += 1 ]
            if [ fn[i] == 46 ] dot = i        # '.'
        if [ dot < 0 ] return ''
        return fn.mid[ dot, n - dot ]

    # every ResourceView subclass registers itself: by extension for the
    # default chain, by name for the rail
    func ensure_view_registry []
        if [ view_registry ] return
        view_registry = map Au_t[string] []
        view_by_name  = map Au_t[string] []
        n    : i64 [ 0 ]
        subs : @Au_t [ Au.subclasses[ typeid[ ResourceView ], @n ] ]
        for [ i: i64 0, i < n, i += 1 ]
            t : subs[ i ]
            if [ t ]
                probe : ResourceView [ Au.new_object[ t, null, null, true, __FILE__, __LINE__, __SEQUENCE__ ] ]
                if [ probe ]
                    exts : probe.extensions*[]
                    for [ e: string ] in exts
                        view_registry[ e ] = t
                    vid : string probe.view_id*[]
                    if [ !vid || vid.count == 0 ] vid = '{t.ident}'
                    view_by_name[ vid ] = t

    # the type that renders a named view in-process, or null for a peer
    func view_type [ nm: string ] -> Au_t
        if [ !nm || nm.count == 0 ] return null
        ensure_view_registry[]
        return view_by_name[ nm ]

    func ensure_export_registry []
        if [ export_registry ] return
        export_registry = map string[string] []
        export_ftype    = map string[string] []
        export_lib      = map string[string] []
        root : path.path_startup[]
        if [ !root ] return
        d : path '{root}/install/export'
        entries : d.ls[ null, false ]
        if [ !entries ] return
        for [ e: path ] in entries
            ax : e.ext[]
            if [ ax && ax == 'agi' ]
                # the export is named <owner>-<module>; the host and the
                # build need the MODULE (silver-markdown.agi -> markdown)
                mod     : module_of_export[ root, e.stem[] ]
                ftext : string e.load[ typeid[string], null ]
                if [ ftext ]
                    ix : ftext.index_of[ 'extensions:' ]
                    if [ ix >= 0 ]
                        i  : i32 [ i32[ ix ] ]
                        n2 : i32 [ i32[ ftext.count ] ]
                        q0 : i32 [ 0 - 1 ]
                        while [ i < n2 ]
                            c : i32 [ (i32 ftext.chars[i]) & 255 ]
                            if [ c == 10 ] break
                            if [ c == 39 ]
                                if [ q0 < 0 ]
                                    q0 = i + 1
                                el
                                    ex3 : ftext.mid[ q0, i - q0 ]
                                    export_registry[ ex3 ] = mod
                                    export_lib[ ex3 ] = e.stem[]
                                    q0 = 0 - 1
                                    # optional ': FileType' the module declared
                                    j3 : i32 [ i + 1 ]
                                    while [ j3 < n2 ]
                                        c3 : i32 [ (i32 ftext.chars[j3]) & 255 ]
                                        if [ c3 == 32 || c3 == 58 ]
                                            j3 += 1
                                            continue
                                        break
                                    if [ j3 > i + 1 && j3 < n2 ]
                                        k3 : i32 [ j3 ]
                                        while [ k3 < n2 ]
                                            c4 : i32 [ (i32 ftext.chars[k3]) & 255 ]
                                            if [ c4 >= 97 && c4 <= 122 ]
                                                k3 += 1
                                                continue
                                            break
                                        if [ k3 > j3 ] export_ftype[ ex3 ] = ftext.mid[ j3, k3 - j3 ]
                            i += 1

    # <owner>-<module> export stem -> the module whose source dir exists
    # under root; owners may carry dashes, so segments drop from the left
    func module_of_export [ root: path, stem: string ] -> string
        nm : string [ stem ]
        while [ nm && nm.count > 0 ]
            src9 : path '{root}/{nm}/{nm}.ag'
            if [ src9.exists[] ] return nm
            dash : i32 [ nm.index_of[ '-' ] ]
            if [ dash < 0 ] break
            nm = nm.mid[ dash + 1, nm.count - dash - 1 ]
        return stem

    # exported handler module for a file's extension, or null
    func handler_module_for [ p: path ] -> string
        ext : file_ext[ p ]
        if [ ext.count == 0 ] return null
        ensure_export_registry[]
        return export_registry[ ext ]

    # the handler's lib stem (silver-markdown) for a file's extension, or null
    func handler_lib_for [ p: path ] -> string
        ext : file_ext[ p ]
        if [ ext.count == 0 ] return null
        ensure_export_registry[]
        return export_lib[ ext ]

    # a named view that can render bytes, asked of the views themselves
    func binary_view_name [] -> string
        if [ bin_view_cached && bin_view_cached.count > 0 ] return bin_view_cached
        ensure_view_registry[]
        for [ t: Au_t, nm: string ] in view_by_name
            if [ !nm || nm.count == 0 ] continue
            probe : ResourceView [ Au.new_object[ t, null, null, true, __FILE__, __LINE__, __SEQUENCE__ ] ]
            if [ !probe ] continue
            ft : probe.applies*[]
            if [ ft == FileType.binary || ft == FileType.agnostic ]
                bin_view_cached = nm
                return nm
        return 'text'

    # what to show with nothing launched. the owning module exported
    # whether its format is binary; never sniff, never key off the ext
    func fallback_view_for [ p: path ] -> string
        if [ !p ] return 'text'
        ensure_export_registry[]
        ext : file_ext[ p ]
        if [ ext.count == 0 ] return 'text'
        ft : string export_ftype[ ext ]
        if [ ft && ft == 'binary' ] return binary_view_name[]
        return 'text'

    # default action's name: peer handler module or hosted element
    func default_view_for [ p: path ] -> string
        hm : handler_module_for[ p ]
        if [ hm ] return hm
        ext : file_ext[ p ]
        if [ ext.count == 0 ] return null
        ensure_view_registry[]
        t : view_registry[ ext ]
        if [ t ] return '{t.ident}'
        return null

    # vw names the rail view the module should open with; '' = its default
    func launch_handler [ mod: string, p: path, vw: string ]
        root : path.path_startup[]
        if [ !root ] return
        puts 'launch_handler: {mod} for {p} view={vw}'
        nv : AppView [ ]
        nv.src = path '{root}/{mod}/{mod}.ag'
        nv.doc = p
        nv.viewer = true
        orb9 : cast orbiter [ ux.app_object ]
        if [ orb9 ]
            fa9 : string orb9.file_args[ p ]
            nv.module_args = (fa9 && fa9.count > 0) ? fa9 : orb9.module_args
        if [ vw && vw.count > 0 ]
            nv.module_args = (nv.module_args && nv.module_args.count > 0)
                ? '{nv.module_args} --view {vw}' : '--view {vw}'
        nv.start[]
        run_view  = nv
        app_view  = true
        animated  = true
        pristine  = false
        no_scroll = true
        focusable = true
        if [ ux ]
            ux.set_focus[ a ]
            ux.restyle = true

    func file_is_binary [ p: path ] -> bool
        ps : '{p}'
        fp : fopen[ ps.chars, "rb" ]
        if [ !fp ] return false
        b : local u8 [ 4096 ]
        n : i32 [ i32[ fread[ @b[0], 1, 4096, fp ] ] ]
        fclose[ fp ]
        if [ n <= 0 ] return false
        ctrl : i32 [ 0 ]
        for [ i: i32 0, i < n, i += 1 ]
            c : i32 [ i32[ b[i] ] ]
            if [ c == 0 ] return true
            if [ c >= 32 ] continue                  # printable + all high bytes
            if [ c == 9 || c == 10 || c == 13 ] continue
            if [ c == 12 || c == 27 ] continue       # form feed, escape
            ctrl += 1
        return ctrl * 100 > n * 10                   # >10% control bytes

    func resource_view_for [ p: path ] -> ResourceView
        ext : file_ext[ p ]
        if [ ext.count == 0 ] return null
        ensure_view_registry[]
        t : view_registry[ ext ]
        if [ !t ] return null
        return ResourceView [ Au.new_object[ t, null, null, true, __FILE__, __LINE__, __SEQUENCE__ ] ]

    func thumb_for [ p: path, cv: Canvas ] -> Texture
        if [ !p ] return null
        if [ !thumb_cache ] thumb_cache = map Texture[string] []
        key : '{p.absolute[]}'
        ex : thumb_cache[ key ]
        if [ ex ] return ex
        rv : ResourceView resource_view_for[ p ]
        if [ !rv ] return null
        rv.src = p
        tex : Texture rv.thumbnail*[ cv ]
        if [ !tex ] return null
        thumb_cache[ key ] = tex
        return tex

    # our own line diff: LCS over the middle after prefix/suffix trim.
    # kinds: 0 context, 1 removed (commit only), 2 added (our buffer)
    func diff_against [ base: vec string, cur: vec string, out_k: vec i32 ] -> list string
        out : list string []
        nb9 : i32 [ base.count ]
        nc9 : i32 [ cur.count ]
        p9  : i32 [ 0 ]
        while [ p9 < nb9 && p9 < nc9 && base[ p9 ] == cur[ p9 ] ]
            out.push[ base[ p9 ] ]
            out_k.push[ 0 ]
            p9 += 1
        s9 : i32 [ 0 ]
        while [ s9 < nb9 - p9 && s9 < nc9 - p9 && base[ nb9 - 1 - s9 ] == cur[ nc9 - 1 - s9 ] ]
            s9 += 1
        wa  : i32 [ nb9 - p9 - s9 ]
        wb  : i32 [ nc9 - p9 - s9 ]
        big : i64 [ i64[wa] * i64[wb] ]
        if [ big > 25000000 ]
            # window too large for the table: whole middle is a replace
            for [ i: i32 0, i < wa, i += 1 ]
                out.push[ base[ p9 + i ] ]
                out_k.push[ 1 ]
            for [ j: i32 0, j < wb, j += 1 ]
                out.push[ cur[ p9 + j ] ]
                out_k.push[ 2 ]
        el [ wa > 0 || wb > 0 ]
            st   : i32 [ wb + 1 ]
            n_dp : i32 [ (wa + 1) * st ]
            dp   : new i32 [ n_dp ]
            for [ i: i32 wa, i >= 0, i -= 1 ]
                for [ j: i32 wb, j >= 0, j -= 1 ]
                    v9 : i32 [ 0 ]
                    if [ i < wa && j < wb ]
                        if [ base[ p9 + i ] == cur[ p9 + j ] ]
                            v9 = dp[ (i + 1) * st + j + 1 ] + 1
                        el
                            d9 : i32 [ dp[ (i + 1) * st + j ] ]
                            r9 : i32 [ dp[ i * st + j + 1 ] ]
                            v9 = (d9 > r9) ? d9 : r9
                    dp[ i * st + j ] = v9
            i9 : i32 [ 0 ]
            j9 : i32 [ 0 ]
            while [ i9 < wa || j9 < wb ]
                if [ i9 < wa && j9 < wb && base[ p9 + i9 ] == cur[ p9 + j9 ] ]
                    out.push[ base[ p9 + i9 ] ]
                    out_k.push[ 0 ]
                    i9 += 1
                    j9 += 1
                el [ i9 < wa && (j9 >= wb || dp[ (i9 + 1) * st + j9 ] >= dp[ i9 * st + j9 + 1 ]) ]
                    out.push[ base[ p9 + i9 ] ]
                    out_k.push[ 1 ]
                    i9 += 1
                el
                    out.push[ cur[ p9 + j9 ] ]
                    out_k.push[ 2 ]
                    j9 += 1
        for [ t9: i32 0, t9 < s9, t9 += 1 ]
            out.push[ base[ nb9 - s9 + t9 ] ]
            out_k.push[ 0 ]
        return out

    # project the merged view back to the live buffer (rows the commit
    # doesn't own), then re-diff — edits merge before your eyes
    func diff_rebuild [ project: bool ]
        key9 : '{src.absolute[]}'
        fcm7 : map FileBuf [string] buffers[]
        fb9  : FileBuf fcm7[key9]
        if [ !fb9 ]
            fb9 = FileBuf []
            nl9 : list string []
            ft9 : string src.load[ typeid[string], null ]
            if [ ft9 ]
                pp9 : ft9.split["\n"]
                for [ i: i32 0, i < pp9.count, i += 1 ]
                    nl9.push[ pp9[i] ]
                if [ ft9.count > 0 && ft9[ ft9.count - 1 ] == 10 ]
                    nl9.push[ '' ]
            fb9.lines = nl9
            fb9.mtime = src.modified_time[]
            fcm7[key9] = fb9
        if [ project && diff_kinds && lines ]
            pj9 : list string []
            n7  : i32 [ lines.count ]
            for [ i: i32 0, i < n7, i += 1 ]
                k7 : i32 [ (i < diff_kinds.count) ? diff_kinds[i] : 0 ]
                if [ k7 != 1 ]
                    s7 : string lines.value_by_index[ i ]
                    pj9.push[ (s7) ? s7 : '' ]
            fb9.lines = pj9
            fb9.hist  = null
        cur9 : vec string []
        nb7  : i32 [ fb9.lines.count ]
        for [ i: i32 0, i < nb7, i += 1 ]
            cs8 : string fb9.lines.value_by_index[ i ]
            cur9.push[ (cs8) ? cs8 : '' ]
        dk9 : vec i32 []
        ml9 : list string diff_against[ diff_base, cur9, dk9 ]
        if [ ml9.count == 0 ]
            ml9.push[ '' ]
            dk9.push[ 0 ]
        lines      = ml9
        diff_kinds = dk9
        rebuild_diff_src[]
        diff_dirty = false
        if [ sel_line >= lines.count ] sel_line = lines.count - 1
        pristine = false

    # glyphs collect here so the edge fade never touches fills or the gutter
    func text_target [ cv: Canvas, b: rect ] -> Canvas
        tw : i32 [ i32[ ceil[ b.w ] ] ]
        th : i32 [ i32[ ceil[ b.h ] ] ]
        if [ tw <= 0 || th <= 0 ] return cv
        if [ !text_canvas ]
            text_canvas = Canvas [ vk: cv.vk, w: cv.w, format: Pixel.rgba8,
                width: tw, height: th, load_existing: true, quantize: true, tag: 'edtext' ]
            text_canvas.update[]
        el [ text_canvas.content_w != tw || text_canvas.content_h != th ]
            text_canvas.resize[ tw, th ]
        text_canvas.reset[ vec4f [ 0.0, 0.0, 0.0, 0.0 ] ]
        return text_canvas

    # white keeps, black hides: a straight ramp on whichever edges fade
    func text_blit [ cv: Canvas, b: rect, ft: f32, fr: f32, fb: f32, fl: f32 ]
        if [ !text_canvas ] return
        tw : i32 [ text_canvas.content_w ]
        th : i32 [ text_canvas.content_h ]
        if [ ft <= 0.0 && fr <= 0.0 && fb <= 0.0 && fl <= 0.0 ]
            cv.draw_canvas[ text_canvas, b.x, b.y, f32[ tw ], f32[ th ] ]
            return
        if [ !fade_mask ]
            fade_mask = Canvas [ vk: cv.vk, w: cv.w, format: Pixel.rgba8,
                width: tw, height: th, load_existing: true, quantize: true, tag: 'edfade' ]
            fade_mask.update[]
        el [ fade_mask.content_w != tw || fade_mask.content_h != th ]
            fade_mask.resize[ tw, th ]
        if [ fade_mask.content_w != fade_w || fade_mask.content_h != fade_h
             || ft != fade_t || fr != fade_r || fb != fade_b || fl != fade_l ]
            fade_w = fade_mask.content_w
            fade_h = fade_mask.content_h
            fade_t = ft
            fade_r = fr
            fade_b = fb
            fade_l = fl
            fade_mask.reset[ vec4f [ 0.0, 0.0, 0.0, 1.0 ] ]
            fade_mask.save[]
            fade_mask.glow_falloff[ 1.0 ]
            fade_mask.fill_color[ rgba['#fff'] ]
            fade_mask.inner_glow_sides[ rgba['#000'], ft, fr, fb, fl ]
            fade_mask.stroke_width[ 0.0 ]
            fade_mask.rect_to[ 0.0, 0.0, f32[ tw ], f32[ th ] ]
            fade_mask.paint[]
            fade_mask.restore[]
        cv.draw_canvas_masked[ text_canvas, fade_mask, b.x, b.y, f32[ tw ], f32[ th ] ]

    # removed rows exist only in the base, so they consume no file line
    func rebuild_diff_src []
        if [ !diff_kinds ]
            diff_src = null
            return
        n  : i32 [ diff_kinds.count ]
        ds : vec i32 []
        s  : i32 [ 0 ]
        for [ i: i32 0, i < n, i += 1 ]
            if [ diff_kinds[i] == 1 ]
                ds.push[ -1 ]
            el
                ds.push[ s ]
                s += 1
        diff_src = ds

    func kinds_insert [ at: i32 ]
        if [ !diff_kinds ] return
        diff_kinds.push[ 2 ]
        for [ i: i32 diff_kinds.count - 1, i > at, i -= 1 ]
            diff_kinds[i] = diff_kinds[ i - 1 ]
        diff_kinds[at] = 2
        rebuild_diff_src[]

    func kinds_remove [ at: i32 ]
        if [ !diff_kinds || at >= diff_kinds.count ] return
        for [ i: i32 at, i < diff_kinds.count - 1, i += 1 ]
            diff_kinds[i] = diff_kinds[ i + 1 ]
        diff_kinds.pop[]
        rebuild_diff_src[]

    # drop the in-pane view; the running app has its own lifetime
    func close_view []
        if [ rview ] rview.release*[]
        rview    = null
        animated = false

    # while an app runs, the run band belongs to IT — not to whatever file
    # the pane has navigated to (stepping into another module moves the pane)
    func band_src [] -> path
        if [ run_view && run_view.src ] return run_view.src
        return src

    # stop the app this pane launched
    func close_app []
        if [ run_view ]
            orb8 : cast orbiter [ ux.app_object ]
            if [ orb8 && run_view.app_mod ] orb8.stop_debug[ run_view.app_mod ]
            run_view.release*[]
        run_view = null
        app_view = false

    # which view this pane should show: the user's pick, else the default
    func resolve_view [] -> string
        if [ view_name && view_name.count > 0 ] return view_name
        d : string default_view_for[ src ]
        if [ d && d.count > 0 ] return d
        if [ file_is_binary[ src ] ] return 'b16'
        return 'text'

    # the only place a view is torn down or constructed
    func mount [ want: string ]
        sp9 : string [ (src) ? '{src}' : '' ]
        dc9 : string [ (diff_commit) ? diff_commit : '' ]
        key : string '{want}|{sp9}|{dc9}'
        if [ mounted && mounted.compare[ key ] == 0 ] return
        mounted = key
        close_view[]
        # a hosted handler (the markdown viewer) gives way to any other view
        if [ want.compare[ 'text' ] == 0 ]
            close_app[]
            load_text[]
            return
        t : Au_t view_type[ want ]
        if [ t ]
            close_app[]
            rview     = ResourceView [ Au.new_object[ t, null, null, true, __FILE__, __LINE__, __SEQUENCE__ ] ]
            rview.src = src
            animated  = rview.continuous*[]     # emulator panes redraw every frame
            lines     = list string []
            pristine      = false
            scroll.x      = 0.0
            scroll.y      = 0.0
            scroll_target = 0.0
            content_h     = 0.0
            saved_scroll  = 0.0
            return
        # a peer module owns this view: it runs as its own process
        lines = list string []
        lines.push[ '' ]
        orbv : cast orbiter [ ux.app_object ]
        # want is either a registered view name or the module's own name
        # (the default action). only a real view travels as --view
        ow9  : string [ (orbv) ? orbv.view_module[ want ] : null ]
        m9   : string [ (ow9 && ow9.count > 0) ? ow9 : want ]
        # one instance for any given viewer, always new: picking a view
        # closes whatever was running and launches with it
        if [ run_view ] close_app[]
        if [ m9 ] launch_handler[ m9, src, (ow9 && ow9.count > 0) ? want : '' ]

    # a disk change (agents editing) becomes ONE undo item: the buffer
    # swaps to disk content; cmd+Z restores what was here before
    func reload_from_disk []
        if [ !src || diff_commit || show_hits || flat_active || !hist ] return
        key : '{src.absolute[]}'
        fcm8 : map FileBuf [string] buffers[]
        buf : FileBuf fcm8[ key ]
        if [ !buf ] return
        mt : i64 [ src.modified_time[] ]
        if [ mt == buf.mtime ] return
        buf.mtime = mt
        ftext : string src.load[ typeid[string], null ]
        if [ !ftext ] return
        before9 : list string []
        for [ s: string ] in lines
            before9.push[ s ]
        after9 : list string []
        parts : ftext.split["\n"]
        for [ i: i32 0, i < parts.count, i += 1 ]
            after9.push[ parts[i] ]
        g : EditAction []
        g.full_before = before9
        g.full_after  = after9
        g.sl0 = sel_line
        g.sc0 = sel_col
        g.sl1 = clamp[ sel_line, 0, after9.count - 1 ]
        g.sc1 = sel_col
        # unsaved groups since the last sync replay on top afterwards
        sy9  : i32 [ (buf.sync_i >= 0) ? buf.sync_i : 0 ]
        rep9 : vec EditAction []
        if [ hist_i - sy9 <= 64 ]
            for [ k9: i32 sy9, k9 < hist_i, k9 += 1 ]
                gg9 : EditAction hist.value_by_index[ k9 ]
                if [ gg9 && !gg9.full_after && gg9.ops && gg9.ops.count > 0 ]
                    rep9.push[ gg9 ]
        while [ hist.count > hist_i ]
            hist.pop[]
        hist.push[ g ]
        hist_i = hist.count
        buf.sync_i = hist.count
        touch_hist[]
        cur_group = null
        edit_kind = -1
        swap_lines[ after9 ]
        if [ sel_line >= lines.count ]    sel_line    = lines.count - 1
        if [ anchor_line >= lines.count ] anchor_line = lines.count - 1
        # walk oldest-first; the first group that fails to anchor stops it
        t9 : vec i32 []
        for [ gg9: EditAction ] in rep9
            for [ op: LineOp ] in gg9.ops
                t9.push[ op.at ]
        lastl9 : i32 [ -1 ]
        lastc9 : i32 [ 0 ]
        for [ gg9: EditAction ] in rep9
            d9 : i32 [ replay_offset[ gg9, before9, t9 ] ]
            if [ d9 == -100000 ] break
            replay_group[ gg9, d9 ]
            lastl9 = gg9.sl1 + d9
            lastc9 = gg9.sc1
        if [ lastl9 >= 0 ]
            sel_line    = clamp[ lastl9, 0, lines.count - 1 ]
            sel_col     = lastc9
            anchor_line = sel_line
            anchor_col  = sel_col
        pristine = false
        if [ ux ] ux.will_animate = true

    func check_disk []
        now : i64 [ epoch_millis[] ]
        if [ now - disk_ms < 500 ] return
        disk_ms = now
        reload_from_disk[]

    func op_touched [ t9: vec i32, ln9: i32 ] -> bool
        for [ v9: i32 ] in t9
            if [ v9 == ln9 ] return true
        return false

    # every set/remove 'before' must match the buffer verbatim at d;
    # untouched neighbor lines must match too (wider fingerprint)
    func op_anchors [ g: EditAction, d: i32, old9: list string, t9: vec i32 ] -> bool
        n9    : i32 [ lines.count ]
        no9   : i32 [ old9.count ]
        seen9 : bool [ false ]
        for [ op: LineOp ] in g.ops
            if [ op.kind == 1 ]
                if [ op.at + d < 0 || op.at + d > n9 ] return false
                continue
            seen9 = true
            at9 : i32 [ op.at + d ]
            if [ at9 < 0 || at9 >= n9 ] return false
            ln9  : string lines.value_by_index[ at9 ]
            cmp9 : string [ (op.before) ? op.before : '' ]
            if [ !ln9 ] ln9 = ''
            if [ ln9.compare[ cmp9 ] != 0 ] return false
            up9 : i32 [ op.at - 1 ]
            au9 : i32 [ at9 - 1 ]
            if [ up9 >= 0 && up9 < no9 && !op_touched[ t9, up9 ] ]
                if [ au9 < 0 ] return false
                a9 : string lines.value_by_index[ au9 ]
                b9 : string old9.value_by_index[ up9 ]
                if [ !a9 ] a9 = ''
                if [ !b9 ] b9 = ''
                if [ a9.compare[ b9 ] != 0 ] return false
            dn9 : i32 [ op.at + 1 ]
            ad9 : i32 [ at9 + 1 ]
            if [ dn9 >= 0 && dn9 < no9 && !op_touched[ t9, dn9 ] ]
                if [ ad9 >= n9 ] return false
                c9 : string lines.value_by_index[ ad9 ]
                e9 : string old9.value_by_index[ dn9 ]
                if [ !c9 ] c9 = ''
                if [ !e9 ] e9 = ''
                if [ c9.compare[ e9 ] != 0 ] return false
        # insert-only groups carry no context: trust position 0 only
        if [ !seen9 && d != 0 ] return false
        return true

    # the offset must be UNIQUE in the window; two candidates means
    # the file is locally self-similar — the reload stands, undo has it
    func replay_offset [ g: EditAction, old9: list string, t9: vec i32 ] -> i32
        found9 : i32 [ -100000 ]
        nf9    : i32 [ 0 ]
        for [ d9: i32 0 - 64, d9 <= 64, d9 += 1 ]
            if [ op_anchors[ g, d9, old9, t9 ] ]
                nf9 += 1
                if [ nf9 > 1 ] return -100000
                found9 = d9
        return found9

    # re-record the group's ops at offset d as a fresh history item
    func replay_group [ g: EditAction, d: i32 ]
        cur_group = null
        edit_kind = -1
        pend_sl0  = g.sl0 + d
        pend_sc0  = g.sc0
        for [ op: LineOp ] in g.ops
            if [ op.kind == 0 ]
                ed_set[ op.at + d, op.after ]
            el [ op.kind == 1 ]
                ed_insert[ op.at + d, op.after ]
            el
                ed_remove[ op.at + d ]
        if [ cur_group ]
            cur_group.sl1 = g.sl1 + d
            cur_group.sc1 = g.sc1
        cur_group = null
        edit_kind  = -1

    func load_file []
        ns9 : string [ (src) ? '{src}' : '' ]
        ls9 : string [ (loaded_src) ? '{loaded_src}' : '' ]
        # a new file returns to the default view and drops the old file's app
        if [ ns9.compare[ ls9 ] != 0 ]
            view_name = ''
            close_app[]
            sel_line    = -1
            anchor_line = -1
            anchor_col  = 0
            dragging    = false
        loaded_src = src
        if [ !src ]
            mounted = null
            close_view[]
            close_app[]
            lines = list string []
            lines.push[ '' ]
            return
        mount[ resolve_view[] ]

    func load_text []
        pristine = false
        loaded_diff = diff_commit
        diff_kinds  = null
        diff_src    = null
        diff_base   = null
        diff_dirty  = false
        if [ diff_commit && diff_commit.count > 0 ]
            orb7 : cast orbiter [ ux.app_object ]
            gr7  : path [ (orb7) ? orb7.project_root[] : src.directory[] ]
            # base = this commit's file; ours = the LIVE buffer (unsaved edits count)
            rp9  : string '{src.absolute[]}'
            rt9  : string '{gr7}'
            rel9 : string [ (rp9.count > rt9.count) ? rp9.mid[ rt9.count + 1, rp9.count - rt9.count - 1 ] : rp9 ]
            diff_base = git_capture[ gr7, 'show {diff_commit}:{rel9}', true ]
            diff_rebuild[ false ]
            scroll.x      = 0.0
            scroll.y      = 0.0
            scroll_target = 0.0
            return
        key   : '{src.absolute[]}'
        mtime : i64    [ src.modified_time[] ]
        fcm6  : map FileBuf [string] buffers[]
        buf   : FileBuf fcm6[key]
        if [ buf && buf.mtime == mtime ]
            lines = buf.lines
            swap_history[ buf ]   # restore this file's own undo/redo (or seed it)
            n9 : i32 [ (lines) ? lines.count : 0 ]
            puts 'load_text: cached {key} lines={n9}'
            return
        ftext : string src.load[ typeid[string], null ]
        if [ !ftext ]
            puts 'load_text: no text for {key}'
            return
        puts 'load_text: read {key} bytes={ftext.count}'
        parts : ftext.split["\n"]
        new_lines : list string []
        for [ i: i32 0, i < parts.count, i += 1 ]
            new_lines.push[ parts[i] ]
        # split drops the piece after a trailing \n: that IS a line
        if [ ftext.count > 0 && ftext[ ftext.count - 1 ] == 10 ]
            new_lines.push[ '' ]
        if [ !buf ]
            buf = FileBuf []
            fcm6[key] = buf
        buf.lines = new_lines
        buf.mtime = mtime
        lines = new_lines
        buf.hist = null
        buf.sync_i = 0
        swap_history[ buf ]

    func toggle_app_run [ clean: bool ]
        if [ run_view ]
            orb9 : cast orbiter [ ux.app_object ]
            if [ orb9 && run_view.app_mod ]
                es9 : ConsoleSession (orb9.ed_sessions) ? orb9.ed_sessions[ 'ed:{run_view.app_mod}' ] : null
                if [ es9 ] es9.print_text[ '\r\nstopped\r\n' ]
            close_app[]
            pristine  = false
            no_scroll = false
            # stopping is a view choice: show the file, do not relaunch.
            # a binary format lands in a byte view, not in text
            view_name = fallback_view_for[ src ]
            load_file[]
            if [ ux ] ux.restyle = true
            return
        if [ !src ] return
        view_name = ''
        hm9 : handler_module_for[ src ]
        if [ hm9 ]
            launch_handler[ hm9, src, '' ]
            return
        puts 'toggle_app_run: starting {src}'
        nv : AppView [ ]
        nv.src   = src
        nv.clean_build = clean
        orb8 : cast orbiter [ ux.app_object ]
        if [ orb8 ]
            fa8 : string orb8.file_args[ src ]
            nv.module_args = (fa8 && fa8.count > 0) ? fa8 : orb8.module_args
        nv.start[]                     # serve socket + build the run command
        run_view = nv
        app_view = true
        animated = true
        pristine = false
        no_scroll = true
        if [ ux ] ux.restyle = true

    func attach_app_run [ mod: string ]
        if [ run_view ] return
        nv : AppView [ ]
