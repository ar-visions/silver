        app_view  = false
        animated  = true
        pristine  = false
        if [ ux ] ux.restyle = true

    func toggle_app_view []
        if [ !run_view ] return
        app_view = !app_view
        if [ !app_view ] load_file[]

    public func on_unload [ ]
        lines      = list string []
        code_lines = vec EdLineCache []
