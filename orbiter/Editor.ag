extend orbiter

import <signal.h>

class FileBuf
    public lines : list string
    public mtime : i64 [ 0 ] # test

    public hist       : list EditAction
    public hist_i     : i32 [ 0 ]
    # history index of the last buffer<->disk agreement (save/reload)
    public sync_i     : i32 [ 0 ]
    # one packed vec i32 per source line, parallel to lines: five per
    # token (col, len, kind, decl file index + 1, decl line)
    public line_regs  : vec Au
    # the declaring files the tokens name, by index
    public decl_files : vec string
    # nesting by indentation: the nearest line above each with a smaller
    # indent (-1 at top level), blank lines inheriting their
    # predecessor's. rebuilt on demand once the lines change
    public line_parent : vec i32
    # the last line inside each line's scope (itself when it opens none)
    public line_last   : vec i32
    public tree_dirty  : bool [ true ]

# a repository a host lists for a user
class RepoInfo
    public full : string        # owner/name
    public name : string
    public desc : string

# a checkout in flight: git's progress read off its own pipe, no
# console. phase: cloning, building, done, failed
class RepoClone
    public full  : string
    public name  : string
    public dir   : string
    public fh    : handle
    public fd    : i32 [ -1 ]
    public pct   : f32
    public phase : string
    public tail  : string

# where repositories live: how a user's are listed and how one is
# cloned. github for now; a second host is a second instance of this,
# not a path
class RepoHost
    public name  : string [ 'github' ]
    # a personal access token: 5000 requests an hour, private repos, who
    # we are
    public token : string
    public me    : string           # the token's login, once known
    func auth [] -> string
        return (token && token.count > 0) ? '-H "Authorization: Bearer {token}" ' : ''
    # our own listing goes through /user/repos (private ones included).
    # 100 a page is the host's most; page 2, 3.. continue the list
    func list_cmd [ user: string, page: i32 ] -> string
        own : bool [
            token && token.count > 0 && me && me.count > 0
            && me.compare[ user ] == 0 ]
        url : string (own) ? 'https://api.github.com/user/repos?per_page=100&sort=updated&affiliation=owner&page={page}' : 'https://api.github.com/users/{user}/repos?per_page=100&sort=updated&page={page}'
        return 'curl -s {auth[]}-H "Accept: application/vnd.github+json" "{url}"'
    # one repository by owner/name (any case): its canonical name and
    # description
    func repo_cmd [ full: string ] -> string
        return 'curl -s {auth[]}-H "Accept: application/vnd.github+json" "https://api.github.com/repos/{full}"'
    func user_cmd [] -> string
        return 'curl -s {auth[]}-H "Accept: application/vnd.github+json" "https://api.github.com/user"'
    # over ssh: the key is the credential we have, and it reaches
    # private repos
    func clone_url [ full: string ] -> string [ 'git@github.com:{full}.git' ]
    # who the key says we are: "Hi <login>! You've successfully
    # authenticated"
    func whoami_cmd [] -> string [ 'ssh -T git@github.com 2>&1' ]

# a file's words as 64 bit hashes, held in a bloom: a search asks this
# before it reads the file again, and a miss is certain (no false
# negative)
class TokBloom
    public mt   : i64
    public mask : i32       # bits - 1, a power of two
    public w    : vec u64

class FindHit
    public is_header : bool
    public text      : string
    public dir       : string
    public is_dir    : bool
    public is_spacer : bool
    public session   : string
    public file      : path
    public line      : i32
    # bordered trailing row: enters the title bar's create mode
    public is_newfile : bool
    # directory holds <stem>/<stem>.ag: a silver module
    public is_module  : bool
    public inst       : i32
    # a scene card: picking it loads the scene
    public scene      : string
    # the scene's exported picture
    public thumb      : path
    # owner/name of a remote repository row: picking it checks the repo
    # out
    public repo       : string
    # the repository is already checked out beside this one
    public checked    : bool
    # the trailing row of a listing: picking it fetches the next page
    public more       : bool
    # one of the user's pins, listed above the folder's own entries
    public pinned     : bool

    # a card row: an instance or a scene
    public func card [] -> bool
        if [ inst > 0 ] return true
        return scene && scene.count > 0

    # a message row: a header with text that points at nothing
    public func note [] -> bool
        if [ !is_header || is_spacer || is_newfile || more || is_dir ]
            return false
        if [ file || inst > 0 ] return false
        if [ (scene && scene.count > 0) || (repo && repo.count > 0) ]
            return false
        return text && text.count > 0

class VRow
    public src   : i32 [ -1 ]
    public var   : variable
    public depth : i32 [ 0 ]
    # a ghost row: a line git removed here, shown read-only with no
    # number
    public text  : string

class LineOp
    public at     : i32 [ 0 ]
    public kind   : i32 [ 0 ]
    public before : string
    public after  : string

class EditAction
    public ops : vec LineOp
    # set = whole-buffer swap (disk reload); ops are unused then
    public full_before : list string
    public full_after  : list string
    public sl0 : i32 [ 0 ]   # caret line/col before the group
    public sc0 : i32 [ 0 ]
    public sl1 : i32 [ 0 ]   # caret line/col after the group
    public sc1 : i32 [ 0 ]

class ColorRegion
    public col   : i32 [ 0 ]
    public len   : i32 [ 0 ]
    public color : rgba
    # the token's own kind, not just its colour: navigation needs to
    # tell a module name from an ordinary identifier
    public kind  : i32 [ 0 ]
    # where this token was declared, straight from the syntax map. a C
    # function is not a type, so no registry lookup can find it
    public dsrc  : string
    public dline : i32 [ 0 ]
    # where the name's type is declared, from the same map
    public tsrc  : string
    public tline : i32 [ 0 ]
    # the type's name: a loaded type lists its members from the runtime
    public tname : string

class EdLineCache
    mutable canvas : Canvas
    mutable hash   : i64 [ -1 ]
    mutable frame  : i32 [ -1 ]
    # the visible width this strip was drawn to cover. a pane narrower
    # than it reuses the strip untouched; only a pane that grows past it
    # redraws
    mutable cover  : i32 [ -1 ]

class ResourceView
    mutable src    : path
    mutable loaded : bool
    func extensions [] -> vec string
        return vec string []
    # rail name; '' = not user-selectable, keyed by class ident
    func view_id [] -> string
        return ''
    # which files this view can open
    func applies [] -> FileType
        return FileType.agnostic
    # a view built from elements composes here instead of painting
    func view_element [] -> element
        return null
    # views that scroll in the pane report their extent; 0 = no
    # scrolling
    func content_height [ cv: Canvas, bounds: rect ] -> f32
        return 0.0
    func content_width [ cv: Canvas, bounds: rect ] -> f32
        return 0.0
    # the editor owns the scroll value; the view is told where it landed
    func set_scroll [ x: f32, y: f32 ]
        return
    func render [ cv: Canvas, bounds: rect ]
        return
    # drop held resources when the pane switches away or closes.
    func release []
        loaded = false
    func is_app_host [] -> bool
        return false
    func restart [ clean: bool ]
        return
    func pause_toggle []
        return
    func is_paused [] -> bool
        return false
    func continuous [] -> bool
        return false
    func title_elements [] -> Elements
        return null
    func title_press [ tid: string, ev: Event ] -> bool
        return false
    mutable view_sel : i32
    func views [] -> vec string
        return null
    func view_unload [ which: i32 ]
        return
    func view_text [ which: i32 ] -> bool
        return false
    func view_lines [ which: i32 ] -> list string
        return null
    func commit_line [ text: string ] -> bool
        return false
    mutable vx : f32
    mutable vy : f32
    mutable vw : f32
    mutable vh : f32
    # the owner's scroll at draw time. find_target folds scroll INTO
    # ev.mouse.pos, so on_press gets CONTENT space -- right for text,
    # wrong for a hosted app, which never scrolls with the source. the
    # fit rect is viewport space, so the scroll comes back out first
    mutable vsx : f32
    mutable vsy : f32
    func view_press [ ev: Event ] -> bool
        return false
    func view_move [ ev: Event ] -> bool
        return false
    # the pane owns a mouse lock for the view: motion arrives as
    # ev.mouse.delta
    func view_lock_move [ ev: Event ]
        return
    func view_wheel [ ev: Event ] -> bool
        return false
    func view_release [ ev: Event ]
        return
    func view_undo [] -> bool
        return false
    func view_redo [] -> bool
        return false
    func context_request [] -> bool
        return false
    func context_feed [] -> string
        return null
    func on_key [ ev: Event ]
        return
    func thumbnail [ cv: Canvas ] -> Texture
        return null

ResourceView B16
    func view_id [] -> string
        return 'b16'
    func applies [] -> FileType
        return FileType.agnostic
    mutable hx_fh     : handle
    mutable hx_size   : i64
    # 16KB read window over the file; a member, never a pooled `new`
    mutable hx_win    : vec u8 [ 16384 ]
    # window's byte offset (-1 = empty)
    mutable hx_woff   : i64 [ -1 ]
    mutable hx_wlen   : i32
    # editor scroll.y, stashed pre-render
    mutable hx_scroll : f32
    # editor scroll.x, stashed pre-render
    mutable hx_scroll_x : f32
    # full row width (px) for h-scroll clamp
    mutable hx_content_w : f32
    mutable hx_s0     : i64 [ -1 ]     # selection anchor (byte offset)
    mutable hx_s1     : i64 [ -1 ]     # selection end (byte offset)
    mutable hx_drag   : bool
    # hex column x (stashed for hit-tests)
    mutable hx_hexx   : f32
    mutable hx_ascx   : f32            # ascii column x
    mutable hx_cw     : f32
    mutable hx_lh     : f32
    func hx_open []
        if [ hx_fh || !src ] return
        ps : '{src}'
        hx_fh = fopen[ ps.chars, "rb" ]
        if [ !hx_fh ] return
        fseek[ hx_fh, 0, 2 ]
        hx_size = ftell[ hx_fh ]
        fseek[ hx_fh, 0, 0 ]
        hx_woff = -1
    func hx_rows [] -> i64
        hx_open[]
        if [ hx_size <= 0 ] return 0
        return (hx_size + 15) / 16
    # slide the 16KB window so [off, off+need) is resident
    func hx_window [ off: i64, need: i32 ] -> bool
        if [ !hx_fh ] return false
        if [ hx_woff >= 0 && off >= hx_woff && (off + i64[ need ]) <= (hx_woff + i64[ hx_wlen ]) ]
            return true
        fseek[ hx_fh, off, 0 ]
        rd : i64 [ fread[ @hx_win[0], 1, 16384, hx_fh ] ]
        hx_woff = off
        hx_wlen = i32[ rd ]
        return hx_wlen >= need
    func hx_put [ b: ref u8, i: i32, v: i64, nd: i32 ] -> i32
        j : i32 [ i ]
        for [ k: i32 nd - 1, k >= 0, k -= 1 ]
            d : i32 [ ((v >> (k * 4)) & 15) ]
            b[ j ] = u8[ (d < 10) ? (48 + d) : (87 + d) ]
            j += 1
        return j
    func hx_byte_at [ mx: f32, my: f32 ] -> i64
        if [ hx_lh <= 0.0 || hx_cw <= 0.0 || hx_size <= 0 ] return -1
        row : i64 [ (my - vy) / hx_lh ]
        if [ row < 0 ] return -1
        col : i32 [ -1 ]
        if [ mx >= hx_hexx && mx < hx_ascx - hx_cw ]
            ch : i32 [ (mx - hx_hexx) / hx_cw ]
            if [ ch >= 25 ] ch -= 1
            col = ch / 3
        el [ mx >= hx_ascx && mx < hx_ascx + hx_cw * 16.0 ]
            col = i32[ (mx - hx_ascx) / hx_cw ]
        if [ col < 0 ] return -1
        if [ col > 15 ] col = 15
        bt : i64 [ row * 16 + i64[ col ] ]
        if [ bt >= hx_size ] bt = hx_size - 1
        return bt

    func content_height [ cv: Canvas, bounds: rect ] -> f32
        return f32[ hx_rows[] ] * round[ cv.get_line_height[] ]

    func content_width [ cv: Canvas, bounds: rect ] -> f32
        return hx_content_w

    func set_scroll [ x: f32, y: f32 ]
        hx_scroll_x = x
        hx_scroll   = y

    func release []
        if [ hx_fh ]
            fclose[ hx_fh ]
            hx_fh = null
        hx_woff = -1
        loaded  = false

    func view_press [ ev: Event ] -> bool
        cy : f32 [ ev.mouse.pos.y - vy ]
        if [ ev.mouse.pos.x < vx || ev.mouse.pos.x >= vx + vw ]
            return false
        if [ cy < hx_scroll || cy >= hx_scroll + vh ] return false
        bt : i64 [ hx_byte_at[ ev.mouse.pos.x, ev.mouse.pos.y ] ]
        if [ bt < 0 ]
            hx_s0 = -1
            hx_s1 = -1
            return true
        hx_s0   = bt
        hx_s1   = bt
        hx_drag = true
        return true

    func view_move [ ev: Event ] -> bool
        if [ !hx_drag ] return false
        bt : i64 [ hx_byte_at[ ev.mouse.pos.x, ev.mouse.pos.y ] ]
        if [ bt >= 0 ] hx_s1 = bt
        return true

    func view_release [ ev: Event ]
        hx_drag = false

    func render [ cv: Canvas, bounds: rect ]
        hx_open[]
        if [ !hx_fh || hx_size <= 0 ] return
        cwm : cv.measure_text[ '0' ]
        cw  : f32 [ cwm.w ]
        lh  : f32 [ round[ cv.get_line_height[] ] ]
        if [ lh <= 0.0 || cw <= 0.0 ] return
        x_off : f32 [ bounds.x + 8.0 - hx_scroll_x ]
        x_hex : f32 [ x_off + cw * 10.0 ]
        x_asc : f32 [ x_hex + cw * 51.0 ]
        hx_content_w = cw * 67.0 + 16.0
        hx_hexx = x_hex
        hx_ascx = x_asc
        hx_cw   = cw
        hx_lh   = lh
        nvis  : i32 [ i32[ bounds.h / lh ] + 2 ]
        r0    : i64 [ hx_scroll / lh ]
        if [ r0 < 0 ] r0 = 0
        total : i64 [ (hx_size + 15) / 16 ]
        band  : i64 [ i64[ nvis ] * 16 ]
        if [ band > hx_size - r0 * 16 ] band = hx_size - r0 * 16
        if [ band <= 0 ] return
        if [ !hx_window[ r0 * 16, i32[ band ] ] ] return
        yb : f32 [ bounds.y - hx_scroll ]
        lo : i64 [ (hx_s0 < hx_s1) ? hx_s0 : hx_s1 ]
        hi : i64 [ (hx_s0 < hx_s1) ? hx_s1 : hx_s0 ]
        b  : local u8 [ 64 ]
        if [ hx_s0 >= 0 ]
            cv.stroke_width [ 0.0 ]
            cv.fill_color   [ rgba['#264f78'] ]
            for [ vr: i32 0, vr < nvis, vr += 1 ]
                row : i64 [ r0 + i64[ vr ] ]
                if [ row >= total ] break
                off : i64 [ row * 16 ]
                nb  : i32 [
                    ((hx_size - off) >= 16) ? 16
                    : i32[ hx_size - off ] ]
                if [ lo > off + i64[ nb ] - 1 || hi < off ] continue
                c0  : i32 [ (lo > off) ? i32[ lo - off ] : 0 ]
                c1  : i32 [
                    (hi < off + i64[ nb ] - 1) ? i32[ hi - off ]
                    : nb - 1 ]
                y   : f32 [ yb + f32[ row ] * lh ]
                sc  : i32 [ c0 * 3 + ((c0 >= 8) ? 1 : 0) ]
                ec  : i32 [ c1 * 3 + 2 + ((c1 >= 8) ? 1 : 0) ]
                cv.rounded_rect [ x_hex + f32[ sc ] * cw - 2.0, y + 1.0,
                    f32[ ec - sc ] * cw + 4.0, lh - 2.0, 3.0, 3.0, 3.0,
                    3.0 ]
                cv.rounded_rect [ x_asc + f32[ c0 ] * cw - 1.0, y + 1.0,
                    f32[ c1 - c0 + 1 ] * cw + 2.0, lh - 2.0, 3.0, 3.0,
                    3.0, 3.0 ]
            cv.paint [ ]
        # pass 2: offset column
        cv.fill_color [ rgba['#808080'] ]
        for [ vr: i32 0, vr < nvis, vr += 1 ]
            row : i64 [ r0 + i64[ vr ] ]
            if [ row >= total ] break
            j : i32 [ hx_put[ @b[0], 0, row * 16, 8 ] ]
            b[ j ] = 0
            cv.draw_text [ string [ cast cstr [ @b[0] ] ],
                rect [ x: x_off, y: yb + f32[ row ] * lh, w: cw * 8.0,
                       h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible,
                null ]
        cv.paint [ ]
        # pass 3: hex bytes
        cv.fill_color [ rgba['#d4d4d4'] ]
        for [ vr: i32 0, vr < nvis, vr += 1 ]
            row : i64 [ r0 + i64[ vr ] ]
            if [ row >= total ] break
            off : i64 [ row * 16 ]
            nb  : i32 [
                ((hx_size - off) >= 16) ? 16 : i32[ hx_size - off ] ]
            bi  : i32 [ off - hx_woff ]
            j   : i32 [ 0 ]
            for [ k: i32 0, k < nb, k += 1 ]
                if [ k == 8 ]
                    b[ j ] = 32
                    j += 1
                j = hx_put[ @b[0], j, i64[ hx_win[ bi + k ] ], 2 ]
                b[ j ] = 32
                j += 1
            b[ j ] = 0
            cv.draw_text [ string [ cast cstr [ @b[0] ] ],
                rect [ x: x_hex, y: yb + f32[ row ] * lh, w: cw * 49.0,
                       h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible,
                null ]
        cv.paint [ ]
        # pass 4: ascii column (unprintable → '.')
        cv.fill_color [ rgba['#b5cea8'] ]
        for [ vr: i32 0, vr < nvis, vr += 1 ]
            row : i64 [ r0 + i64[ vr ] ]
            if [ row >= total ] break
            off : i64 [ row * 16 ]
            nb  : i32 [
                ((hx_size - off) >= 16) ? 16 : i32[ hx_size - off ] ]
            bi  : i32 [ off - hx_woff ]
            for [ k: i32 0, k < nb, k += 1 ]
                c : i32 [ hx_win[ bi + k ] ]
                b[ k ] = u8[ (c >= 32 && c < 127) ? c : 46 ]
            b[ nb ] = 0
            cv.draw_text [ string [ cast cstr [ @b[0] ] ],
                rect [ x: x_asc, y: yb + f32[ row ] * lh, w: cw * 16.0,
                       h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible,
                null ]
        cv.paint [ ]

ResourceView ImageView
    mutable tex : Texture
    mutable iw  : f32
    mutable ih  : f32
    func extensions [] -> vec string
        return vec string [] [ '.png', '.jpg', '.jpeg', '.exr' ]
    func thumbnail [ cv: Canvas ] -> Texture
        if [ !src ] return null
        im : Image [ '{src}' ]
        if [ im.width <= 0 || im.height <= 0 ] return null
        mx : i32 [ (im.width > im.height) ? im.width : im.height ]
        if [ mx > 256 ]
            sc : f32 [ 256.0 / f32[ mx ] ]
            tw : i32 [ f32[ im.width ] * sc ]
            th : i32 [ f32[ im.height ] * sc ]
            if [ tw < 1 ] tw = 1
            if [ th < 1 ] th = 1
            im = im.resize[ tw, th ]
        return Texture [ vk: cv.vk, w: cv.w, sampler: im,
                         width: im.width, height: im.height,
                         linear: true ]

    func render [ cv: Canvas, bounds: rect ]
        if [ !loaded ]
            loaded = true
            if [ src ]
                im : Image [ '{src}' ]
                iw = f32[ im.width ]
                ih = f32[ im.height ]
                if [ im.width > 0 && im.height > 0 ]
                    tex = Texture [ vk: cv.vk, w: cv.w, sampler: im,
                                    width: im.width, height: im.height,
                                    linear: true ]
        if [ !tex || iw <= 0.0 || ih <= 0.0 ] return
        sc : f32 [ minf[ bounds.w / iw, bounds.h / ih ] ]
        if [ sc > 1.0 ] sc = 1.0
        dw : f32 [ iw * sc ]
        dh : f32 [ ih * sc ]
        dx : f32 [ bounds.x + (bounds.w - dw) * 0.5 ]
        dy : f32 [ bounds.y + (bounds.h - dh) * 0.5 ]
        cv.draw_image[ tex, rect [ x: dx, y: dy, w: dw, h: dh ] ]

    func release []
        tex = null
        loaded = false

ResourceView AppView
    mutable slot       : i32 [ -1 ]  # our channel slot at silver-host
    # module name (orbiter resolves its binary to attach)
    mutable app_mod    : string
    mutable arg_text   : string      # its live argument, as last sent
    # the app's history, as it last said
    public  nav_back_on : bool
    public  nav_fwd_on  : bool
    # the app's own title, shown on the pane
    public  app_title   : string
    mutable title_buf   : vec u8     # its bytes as they arrive
    # orbiter's tail args, forwarded to the module
    mutable module_args : string
    # orbiter has attached lldb to this app's pid
    public  attached   : bool
    # lldb attach is running on a worker
    public  attaching  : bool
    mutable debugger   : dbg
    mutable pause_pending : bool
    mutable iid        : i32
    # made, not running: a click on its row starts it
    mutable held       : bool
    # shown small beside the source: the instance's own state
    mutable pip        : bool
    # 0 pip, 1 full (the pane), 2 its own window, 3 that window
    # full-screen
    public  display    : i32
    mutable props      : string
    # the app's shared surface pair, imported
    mutable tex0       : Texture
    mutable tex1       : Texture
    # generation of the imported surface
    mutable gen        : i32
    # console command (streams the app's log)
    mutable cmd        : string
    # cmd handed to its console session (once per run)
    mutable dispatched : bool
    public  clean_build : bool       # silver-host runs --clean first
    # the module builds -O0 -g for the debugger
    public  debug_build : bool
    # silver --coverage: the run writes coverage.lcov
    public  cov_build   : bool
    # a file handler: hosted to view, never under the debugger
    public  viewer      : bool
    mutable doc        : path
    mutable pend_w     : i32
    mutable pend_h     : i32
    mutable req_w      : i32
    mutable req_h      : i32
    mutable pend_us    : i64
    mutable started    : bool
    mutable asking     : bool        # its bare argument is being picked
    mutable ready      : bool
    # mouse lock asked by the app (HM.lock): 1 lock, 2 release; centre
    # in app px; carried fractions
    mutable lock_req   : i32
    mutable lock_cx    : i32
    mutable lock_cy    : i32
    mutable lock_ax    : f32
    mutable lock_ay    : f32
    mutable ended       : bool
    # peer frozen (SIGSTOP) — last frame shows
    mutable paused     : bool
    # parked in the debugger: never ask it anything
    mutable stopped    : bool
    mutable note       : string
    mutable aw         : i32
    mutable ah         : i32
    # the picture's shape as the app told it (HM.aspect); 0 = unknown
    mutable pic_w      : i32
    mutable pic_h      : i32
    # the frame the app showed as its window switched to orbiter: the
    # pip until the instance runs and its own frames arrive
    mutable still      : Texture
    # the app asked for its orbiter: this one comes forward
    mutable wants_ide  : bool
    # the app's exchange mic asked: 3 start, 0 stop, 2 cancel
    mutable dict_req   : i32 [ -1 ]
    # the display's pixels per point: the app's texture is in device
    # pixels, the pane and the app's own events are in points
    mutable ascale     : f32 [ 1.0 ]
    mutable have_frame : bool
    mutable fade_us    : i64
    mutable seen_us    : i64
    mutable fitx       : f32
    mutable fity       : f32
    mutable fitw       : f32
    mutable fith       : f32
    # the app locked its aspect: letterbox it. otherwise clip
    mutable locked     : bool
    # the gain the app started at; -1 until it answers, then adopted
    # once
    mutable app_vol    : f32 [ -1.0 ]
    # what the running instance says it can show, asked once
    mutable instr_names : vec string
    mutable instr_ask   : bool
    # the instruments actually up, and the surface each one publishes
    mutable instr_live  : vec string
    mutable instr_side  : map i32     [string]
    mutable instr_logs  : map i32     [string]
    mutable instr_gen   : map i32     [string]
    mutable instr_pw    : map i32     [string]
    mutable instr_ms    : i64
    mutable instr_ak    : i64
    # the last props re-ask: live values read back twice a second
    mutable props_ak    : i64
    # when the user last picked a display: the app's echo lags it
    mutable disp_ms     : i64
    # a display the app reported that orbiter has yet to follow
    mutable disp_pending : i32 [ -1 ]
    # this display's refresh, given by the pane that starts it
    mutable host_hz     : i32
    # DIAG: frame requests posted this second
    mutable pane_req    : i32
    # DIAG: front flips seen this second
    mutable pane_flip   : i32
    # DIAG: last front + 1 (0 = none yet)
    mutable pane_seen   : i32
    mutable pane_sec    : i64
    mutable itex0       : map Texture [string]
    mutable itex1       : map Texture [string]
    mutable dbg_nw     : i32
    mutable dbg_nh     : i32
    mutable dbg_aw     : i32
    mutable dbg_ah     : i32

    func extensions [] -> vec string
        return vec string []

    func is_app_host [] -> bool
        return true

    func continuous [] -> bool
        return true

    func service [ cv: Canvas ]
        if [ held ] return
        if [ !started ]
            if [ asking ] return
            wa9 : cast Window [ cv.w ]
            oa : cast orbiter [ (wa9) ? wa9.app_object : null ]
            if [ oa && oa.ask_default[ a ] ] return
            start[]
        if [ slot < 0 ] return
        for [ i: i32 0, i < 16, i += 1 ]
            t : i32 [ host_poll2[ slot, 0 ] ]
            if [ t == 0 ] break
            if [ t == i32[ HM.lock ] ]
                lock_req = (host_pa[] != 0) ? 1 : 2
                lock_cx  = host_pb[]
                lock_cy  = host_pc[]
            # the app's orbiter button: this orbiter is its orbiter
            el [ t == i32[ HM.shell ] && host_pa[] == 1 ]
                wants_ide = true
            # the app's exchange mic: orbiter transcribes it (it takes
            # the request from here), and types the take back
            el [ t == i32[ HM.dictate ] ]
                dict_req = host_pa[]
            # the app's picture shape: a pip is sized to it
            el [ t == i32[ HM.aspect ] ]
                pic_w = host_pa[]
                pic_h = host_pb[]
            # the app's history moved: the title's arrows follow
            el [ t == i32[ HM.nav_state ] ]
                nav_back_on = host_pa[] != 0
                nav_fwd_on  = host_pb[] != 0
                wn : cast Window [ cv.w ]
                if [ wn ] wn.restyle = true
            # the app's title, three bytes a message; a 0 byte ends it
            el [ t == i32[ HM.title ] ]
                if [ !title_buf ] title_buf = vec u8 []
                bs9 : local i32 [ 3 ]
                bs9[0] = host_pa[]
                bs9[1] = host_pb[]
                bs9[2] = host_pc[]
                for [ k9: i32 0, k9 < 3, k9 += 1 ]
                    if [ bs9[k9] != 0 ]
                        title_buf.push[ u8 bs9[k9] ]
                        continue
                    # string[ @vec[0] ] is a pointer cast: copy to a
                    # local
                    tb : local i8 [ 1024 ]
                    tn : i32 [
                        (title_buf.count < 1023)
                        ? i32[ title_buf.count ] : 1023 ]
                    for [ j9: i32 0, j9 < tn, j9 += 1 ]
                        tb[ j9 ] = i8[ title_buf[ j9 ] ]
                    tb[ tn ] = 0
                    app_title = string[ @tb[0] ]
                    title_buf = vec u8 []
                    wt9 : cast Window [ cv.w ]
                    if [ wt9 ] wt9.restyle = true
                    break
        st : i32 [ host_app_state[ slot ] ]
        if [ st == 4 && !paused ]
            paused = true
            v8 : i32 [ host_app_verdict[ slot ] ]
            sg : i32 [ 0 - v8 ]
            note = 'frozen — signal {sg}'
        if [ st == 3 && !ended ]
            ended   = true
            paused = false
            # its view rect goes with it: left set, a click on the
            # source in the same pane (where the app was drawn)
            # restarted the app
            fitw = 0.0
            fith = 0.0
            instr_clear[]
            v9 : i32 [ host_app_verdict[ slot ] ]
            if [ v9 <= -1000 ]
                note = 'build failed'
                # the first error in the app's own log names file and
                # line
                wv9 : cast Window [ cv.w ]
                ob : cast orbiter [ (wv9) ? wv9.app_object : null ]
                rt : path.path_startup[]
                if [ ob && app_mod ]
                    ob.app_build_error[ app_mod,
                                        '{rt}/install/tmp/{app_mod}.{slot}.log' ]
            el [ v9 < 0 ]
                sig : i32 [ 0 - v9 ]
                note = 'crashed — signal {sig}'
            el [ v9 > 1 ]
                ec : i32 [ v9 - 1 ]
                note = 'exited — code {ec}'
            el
                note = 'app exited'
        if [ ended ] return
        g9 : i32 [ host_tex_gen[ slot, 0 ] ]
        if [ g9 != gen && g9 > 0 ]
            w9 : i32
            h9 : i32
            f9 : i32
            fd0 : i32 [ host_tex_pull[ slot, 0, 0, @w9, @h9, @f9 ] ]
            fd1 : i32 [ host_tex_pull[ slot, 0, 1, @w9, @h9, @f9 ] ]
            if [ fd0 < 0 || fd1 < 0 ]
                fq : fopen[ '/tmp/orbiter-resz.log', 'a' ]
                if [ fq ]
                    fprintf[ fq,
                             "PULL FAIL gen=%d->%d fd0=%d fd1=%d %dx%d slot=%d\n",
                        gen, g9, fd0, fd1, w9, h9, slot ]
                    fclose[ fq ]
            if [ fd0 >= 0 && fd1 >= 0 ]
                if [ tex0 ]
                    tex0.drop[]
                    tex1.drop[]
                tex0 = cv.vk.import_shared_tex[ fd0, w9, h9, f9, cv.w ]
                tex1 = cv.vk.import_shared_tex[ fd1, w9, h9, f9, cv.w ]
                tex0.hold[]
                tex1.hold[]
                aw  = w9
                ah  = h9
                gen = g9
                ready      = true
                have_frame = true
                if [ seen_us == 0 ] seen_us = epoch_micros[]
                dw : i32 [ i32[ vw ] - i32[ awp[] ] ]
                dh9 : i32 [ i32[ vh ] - i32[ ahp[] ] ]
                if [ dw < 0 ] dw = 0 - dw
                if [ dh9 < 0 ] dh9 = 0 - dh9
                if [ fade_us == 0 && dw <= 2 && dh9 <= 2 ]
                    fade_us = epoch_micros[]

        # ask what it offers. KEEP asking until it answers — the app
        # opens its agent socket a moment after it is ready, and a
        # one-shot ask that lands in that gap leaves the bar with no
        # instruments button
        if [
            ready && !instr_ask && !stopped && !paused && app_mod
            && app_mod.count > 0 ]
            ak : i64 [ epoch_millis[] ]
            if [ instr_ak == 0 || ak - instr_ak > 500 ]
                instr_ak = ak
                vb : local i8 [ 512 ]
                if [
                    agent_sock_ask[ sock_name[].chars, 'instruments\n',
                                    @vb[0], 512 ] > 0 ]
                    vs8 : string [ @vb[0] ]
                    vt : string vs8.trim[]
                    if [ vt && vt.count > 0 ]
                        instr_names = vt.split[ ' ' ]
                        instr_ask   = true
                        if [
                            agent_sock_ask[ sock_name[].chars,
                                            'aspect\n', @vb[0],
                                            512 ] > 0 ]
                            la : string [ @vb[0] ]
                            locked = la.trim[] == '1'
                        # the app enumerates its own Launch/Live members
                        pb8 : local i8 [ 16384 ]
                        if [
                            agent_sock_ask_block[ sock_name[].chars,
                                                  'props\n', @pb8[0],
                                                  16384 ] > 0 ]
                            ps8 : string [ @pb8[0] ]
                            props = ps8.trim[]
                        # the app's own gain seeds the slider, once
                        if [
                            agent_sock_ask[ sock_name[].chars,
                                            'volume\n', @vb[0],
                                            512 ] > 0 ]
                            lv : string [ @vb[0] ]
                            app_vol = f32[ lv.trim[].real_value[] ]
        # a paned app draws one frame per frame we draw: this frame
        # shows the one it made for the last request, and the next
        # request goes out now, so it renders while we draw and present.
        # one frame of latency, and every frame shown once as long as it
        # answers within a frame
        if [
            started && slot >= 0 && display <= 1 && !held && !ended
            && !paused ]
            host_post2[ slot, 1, i32[ HM.frame ], 0, 0, 0 ]
            pane_req += 1
            fr : i32 [ host_tex_front[ slot, 0 ] + 1 ]
            if [ fr != pane_seen ]
                pane_seen  = fr
                pane_flip += 1
            ps9 : i64 [ epoch_millis[] / 1000 ]
            if [ ps9 != pane_sec ]
                pw9 : Window [ cv.w ]
                if [ pane_sec != 0 && pw9 && pw9.stats ]
                    log 'PANE slot={slot} req={pane_req} flips={pane_flip}'
                pane_sec  = ps9
                pane_req  = 0
                pane_flip = 0
        # the app's sound rides its slot's ring: into the recording, if
        # one is on
        if [ started && slot >= 0 && !held && !ended ]
            pa9 : Window [ cv.w ]
            if [ pa9 ] pa9.record_pull[ slot ]
        # the app's live props, re-read twice a second: a value the app
        # changed itself (esc leaving full-screen) shows here without a
        # round trip. gated on the process, not on a frame: a windowed
        # or still-loading instance answers its socket long before (or
        # without) drawing here
        if [
            started && slot >= 0 && !stopped && !paused && !ended
            && !held && app_mod && app_mod.count > 0 ]
            pk : i64 [ epoch_millis[] ]
            if [ props_ak == 0 || pk - props_ak > 500 ]
                props_ak = pk
                pb9 : local i8 [ 16384 ]
                if [
                    agent_sock_ask_block[ sock_name[].chars, 'props\n',
                                          @pb9[0], 16384 ] > 0 ]
                    ps9 : string [ @pb9[0] ]
                    pt9 : string ps9.trim[]
                    if [ pt9 && pt9.count > 0 ] props = pt9
                    # the app's display is the truth: a change it made
                    # (esc, its own code) is followed here, unless the
                    # user's pick is in flight
                    if [ props && pk - disp_ms > 1500 ]
                        ps8 : LaunchProps []
                        Au.parse_agi[ null, props.chars, ps8 ]
                        if [ ps8.props ]
                            for [ p8: Prop ] in ps8.props
                                if [ p8.ident != 'display' || !p8.stops || !p8.value ]
                                    continue
                                for [ i8: i32 0,
                                      i8 < p8.stops.count && i8 <= 3,
                                      i8 += 1 ]
                                    if [ p8.stops[ i8 ] == p8.value && i8 != display ]
                                        disp_pending = i8
        instr_service[ cv ]
        # the window's pixels per point (a cached canvas carries no
        # device scale in its transform, which read 1 here and drew the
        # app 2x)
        wn : Window [ cv.w ]
        if [ wn && wn.scale > 0.0 ] ascale = wn.scale
        if [ ready && fade_us == 0 && seen_us != 0 ]
            if [ epoch_micros[] - seen_us > 1500000 ]
                fade_us = epoch_micros[]
        nw : i32[ vw ]
        nh : i32[ vh ]
        if [
            nw != dbg_nw || nh != dbg_nh || aw != dbg_aw
            || ah != dbg_ah ]
            dbg_nw = nw
            dbg_nh = nh
            dbg_aw = aw
            dbg_ah = ah
            fz9 : fopen[ '/tmp/orbiter-resz.log', 'a' ]
            if [ fz9 ]
                fprintf[ fz9,
                         "RESZ view=%dx%d actual=%dx%d req=%dx%d pend=%dx%d ready=%d slot=%d gen=%d shared=%d\n",
                    nw, nh, aw, ah, req_w, req_h, pend_w, pend_h,
                    (ready) ? 1 : 0, slot,
                    gen, host_tex_gen[ slot, 0 ] ]
                fclose[ fz9 ]
        # embed (and a file viewer, which always fills its pane) gives
        # the app the editor's whole area: pip, window and screen never
        # resize
        if [ ready && nw > 0 && nh > 0 && (display == 1 || viewer) ]
            if [ nw != pend_w || nh != pend_h ]
                pend_w  = nw
                pend_h  = nh
                pend_us = epoch_micros[]
            el [ nw != i32[ awp[] ] || nh != i32[ ahp[] ] ]
                # 150ms of a held size before the peer is told to resize
                if [
                    epoch_micros[] - pend_us > 150000
                    && (nw != req_w || nh != req_h) ]
                    req_w = nw
                    req_h = nh
                    fs9 : fopen[ '/tmp/orbiter-resz.log', 'a' ]
                    if [ fs9 ]
                        fprintf[ fs9, "RESZ send %dx%d slot=%d\n", nw,
                                 nh, slot ]
                        fclose[ fs9 ]
                    host_post2[ slot, 1, i32[ HM.resize ], nw, nh, 0 ]

    # the app's size in points
    func awp [] -> f32
        return f32[ aw ] / ((ascale > 0.0) ? ascale : 1.0)
    func ahp [] -> f32
        return f32[ ah ] / ((ascale > 0.0) ? ascale : 1.0)

    func front [] -> Texture
        fr : i32 [ host_tex_front[ slot, 0 ] ]
        if [ fr < 0 || !tex0 ] return null
        return (fr == 0) ? tex0 : tex1

    # 'name:side:log' from the app, straight into our live state. side
    # is
    # -1 for the usual case: an instrument that is entries and no view
    func instr_apply [ s: string ]
        instr_live = vec string []
        if [ !instr_side ] instr_side = map i32 [string] []
        if [ !instr_logs ] instr_logs = map i32 [string] []
        if [ !s ] return
        t9 : string s.trim[]
        if [ t9.count == 0 ] return
        ps : t9.split[ ' ' ]
        for [ i: i32 0, i < ps.count, i += 1 ]
            f9 : ps[i].split[ ':' ]
            if [ f9.count < 3 ] continue
            nm : string f9[0]
            instr_live.push[ nm ]
            instr_side[ nm ] = i32[ f9[1].integer_value[] ]
            instr_logs[ nm ] = i32[ f9[2].integer_value[] ]

    # a missing key is not a zero: reading one dereferences null
    func instr_num [ m: map i32 [string], nm: string, dflt: i32 ] -> i32
        if [ !m || !nm ] return dflt
        if [ !m.contains[ nm ] ] return dflt
        return m[ nm ]

    func instr_is_logging [ nm: string ] -> bool
        return instr_num[ instr_logs, nm, 0 ] != 0

    # the ONLY toggle: logging for one instrument. the reply is state
    func instr_toggle [ nm: string, logging: bool ]
        if [ !app_mod || !nm || nm.count == 0 ] return
        cb : local i8 [ 512 ]
        if [
            agent_sock_ask[ sock_name[].chars, 'instr-log {nm}\n',
                            @cb[0], 512 ] > 0 ]
            instr_apply[ string [ @cb[0] ] ]

    # one instrument on at a time: nm turns on and every other turns
    # off; nm already on turns off, leaving none
    func instr_select [ nm: string ]
        if [ !instr_names ] return
        was : bool [ instr_is_logging[ nm ] ]
        for [ i: i32 0, i < instr_names.count, i += 1 ]
            on : string instr_names[ i ]
            if [ on.compare[ nm ] != 0 && instr_is_logging[ on ] ]
                instr_toggle[ on, false ]
        # the lit one again goes off: none is up then
        instr_toggle[ nm, !was ]

    # the process is gone: no instrument is up, and the next one asks
    # again
    func instr_clear []
        instr_names = null
        instr_ask   = false
        instr_live  = null
        instr_logs  = null
        instr_side  = null
        instr_gen   = null
        instr_pw    = null

    func instr_active [] -> string
        if [ !instr_names ] return null
        for [ i: i32 0, i < instr_names.count, i += 1 ]
            if [ instr_is_logging[ instr_names[ i ] ] ]
                return instr_names[ i ]
        return null

    # pull each instrument's own surface. gen 0 means it has none
    func instr_service [ cv: Canvas ]
        # a stopped or frozen app answers nothing: every ask would wait
        # its full timeout
        if [ stopped || paused ] return
        # nothing toggles any more, so the state has to be asked for
        nw : i64 [ epoch_millis[] ]
        if [ app_mod && (instr_ms == 0 || nw - instr_ms > 1000) ]
            instr_ms = nw
            sb : local i8 [ 1024 ]
            if [
                agent_sock_ask[ sock_name[].chars, 'instr\n', @sb[0],
                                1024 ] > 0 ]
                instr_apply[ string [ @sb[0] ] ]
        if [ !instr_live || instr_live.count == 0 ] return
        if [ !itex0 ]     itex0     = map Texture [string] []
        if [ !itex1 ]     itex1     = map Texture [string] []
        if [ !instr_gen ] instr_gen = map i32 [string] []
        for [ i: i32 0, i < instr_live.count, i += 1 ]
            nm : string instr_live[i]
            sd : i32 [ instr_num[ instr_side, nm, -1 ] ]
            if [ sd < 2 ] continue
            g9 : i32 [ host_tex_gen[ slot, sd ] ]
            if [ g9 == instr_num[ instr_gen, nm, -1 ] ] continue
            if [ g9 <= 0 ]
                instr_gen[ nm ] = 0
                continue
            w9 : i32
            h9 : i32
            f9 : i32
            fd0 : i32 [ host_tex_pull[ slot, sd, 0, @w9, @h9, @f9 ] ]
            fd1 : i32 [ host_tex_pull[ slot, sd, 1, @w9, @h9, @f9 ] ]
            if [ fd0 < 0 || fd1 < 0 ] continue
            e0 : itex0[ nm ]
            if [ e0 ]
                e0.drop[]
                itex1[ nm ].drop[]
            t0 : cv.vk.import_shared_tex[ fd0, w9, h9, f9, cv.w ]
            t1 : cv.vk.import_shared_tex[ fd1, w9, h9, f9, cv.w ]
            t0.hold[]
            t1.hold[]
            itex0[ nm ] = t0
            itex1[ nm ] = t1
            instr_gen[ nm ] = g9

    # the completed frame of one instrument, or null when it has no view
    func instr_front [ nm: string ] -> Texture
        if [ !instr_side || !itex0 || !nm ] return null
        sd : i32 [ instr_num[ instr_side, nm, -1 ] ]
        if [ sd < 2 ] return null
        fr : i32 [ host_tex_front[ slot, sd ] ]
        if [ fr < 0 || !itex0[ nm ] ] return null
        return (fr == 0) ? itex0[ nm ] : itex1[ nm ]

    # we say the width; the height is the app's own. only on a change —
    # this runs on the draw path
    func instr_width [ nm: string, iw: i32 ]
        if [ !app_mod || !nm || iw <= 0 ] return
        if [ !instr_pw ] instr_pw = map i32 [string] []
        if [ instr_num[ instr_pw, nm, -1 ] == iw ] return
        instr_pw[ nm ] = iw
        agent_sock_send[ sock_name[].chars, 'instr-width {nm} {iw}\n' ]

    # the entries themselves, asked of the running instance
    func instr_entries [ nm: string ] -> vec string
        if [ !app_mod || !nm || nm.count == 0 ] return null
        # a parked peer answers nothing: the ask would sit its whole
        # timeout, every frame
        if [ stopped || paused ] return null
        rb : local i8 [ 8192 ]
        if [ agent_sock_ask[ sock_name[].chars, 'instr-read {nm}\n', @rb[0], 8192 ] <= 0 ]
            return null
        rs : string [ @rb[0] ]
        rt : string rs.trim[]
        if [ rt.count == 0 ] return null
        return rt.split[ '\n' ]

    func draw_frame [ cv: Canvas, bounds: rect ]
        ft : front[]
        if [ ft && have_frame ]
            if [ locked ]
                ar : f32 [ f32[ aw ] / f32[ ah ] ]
                fw : f32 [ bounds.w ]
                fh : f32 [ fw / ar ]
                if [ fh > bounds.h ]
                    fh = bounds.h
                    fw = fh * ar
                fitx = bounds.x + (bounds.w - fw) * 0.5
                fity = bounds.y + (bounds.h - fh) * 0.5
                fitw = fw
                fith = fh
                cv.draw_image[ ft,
                               rect [ x: fitx, y: fity, w: fitw,
                                      h: fith ] ]
            el
                # the app at its own size (points, not device pixels),
                # cropped to the pane until the resize lands
                fitx = bounds.x
                fity = bounds.y
                fitw = awp[]
                fith = ahp[]
                cw : f32 [ (bounds.w < fitw) ? bounds.w : fitw ]
                ch : f32 [ (bounds.h < fith) ? bounds.h : fith ]
                cv.draw_image_crop[ ft,
                                    rect [ x: fitx, y: fity, w: cw,
                                           h: ch ],
                    0.0, 0.0, cw / fitw, ch / fith ]
        # no frame yet: say what it is doing instead of drawing nothing
        if [ ended || paused || !have_frame ]
            overlay[ cv, bounds ]

    func render [ cv: Canvas, bounds: rect ]
        service[ cv ]
        draw_frame[ cv, bounds ]

    # width over height of the picture: the app's word, else its frame
    func pic_aspect [] -> f32
        if [ pic_w > 0 && pic_h > 0 ] return f32[ pic_w ] / f32[ pic_h ]
        if [ aw > 0 && ah > 0 ] return f32[ aw ] / f32[ ah ]
        return 0.0

    # what the shell should SAY about this app right now. null once it
    # is up and drawing — waiting blind is the thing this exists to stop
    func status_text [] -> string
        if [ ended ]
            return (note && note.count > 0) ? note : 'exited'
        if [ paused ]
            return (note && note.count > 0) ? note : 'paused'
        if [ attaching ] return 'attaching debugger to {app_mod}...'
        st7 : i32 [ (slot >= 0) ? host_app_state[ slot ] : 0 ]
        if [ st7 == 1 ]  return 'compiling {app_mod}...'
        # its own window: no frame ever arrives here, so nothing is
        # awaited
        if [ display >= 2 ] return null
        if [ !ready ]    return 'starting {app_mod}...'
        return null

    # one word for the instance chip; empty once the app is up and
    # drawing
    func status_word [] -> string
        if [ held ]      return 'not running'
        if [ ended ]     return 'exited'
        if [ paused ]    return 'paused'
        if [ attaching ] return 'attaching'
        st8 : i32 [ (slot >= 0) ? host_app_state[ slot ] : 0 ]
        if [ st8 == 1 ]  return 'compiling'
        if [ display >= 2 ] return ''
        if [ !ready ]    return 'starting'
        return ''

    func overlay [ cv: Canvas, bounds: rect ]
        st9 : i32 [ (slot >= 0) ? host_app_state[ slot ] : 0 ]
        msg : string [
            (st9 == 1) ? 'compiling {app_mod}…'
            : 'starting {app_mod}…' ]
        if [ ended ]
            msg = '{note} — F5 or click to restart'
        el [ paused ]
            msg = (note && note.count > 0) ? '{note} — F5 to relaunch' : 'paused — F8 or click to resume'
        el [ attaching ]
            msg = 'attaching debugger to {app_mod}…'
        cv.font_size[ 16 ]
        cv.fill_color[ '#dddddd' ]
        cv.draw_text[ msg,
                      rect [ x: bounds.x, y: bounds.y + 16.0,
                             w: bounds.w, h: 24.0 ],
            vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible,
            null ]
        cv.paint[]
        if [ !ended && !paused && app_mod ]
            lp9 : string '/tmp/{app_mod}.log'
            fp9 : fopen[ lp9.chars, 'rb' ]
            if [ fp9 ]
                fseek[ fp9, 0, SEEK_END ]
                sz : i32 [ ftell[ fp9 ] ]
                back : i32 [ (sz < 4000) ? sz : 4000 ]
                fseek[ fp9, sz - back, SEEK_SET ]
                b9 : local i8 [ 4096 ]
                n9 : i32 [ fread[ @b9[0], 1, back, fp9 ] ]
                fclose[ fp9 ]
                if [ n9 > 0 ]
                    b9[n9] = 0
                    txt9   : string [ @b9[0] ]
                    lines9 : txt9.split[ '\n' ]
                    lh  : f32 [ 16.0 ]
                    maxn : i32 [ (bounds.h - 56.0) / lh ]
                    st0  : i32 [
                        (lines9.count > maxn) ? lines9.count - maxn
                        : 0 ]
                    cv.font_size[ 12 ]
                    cv.fill_color[ '#8899aa' ]
                    y9 : f32 [ bounds.y + 44.0 ]
                    for [ i: i32 st0, i < lines9.count, i += 1 ]
                        ln : string lines9[ i ]
                        if [ ln && ln.count > 0 ]
                            cv.draw_text[ ln,
                                          rect [ x: bounds.x + 16.0,
                                                 y: y9,
                                                 w: bounds.w - 32.0,
                                                 h: lh ],
                                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                                Overflow.clip, null ]
                        y9 += lh
                    cv.paint[]

    func module_name [] -> string
        fn : src.filename[]
        di : i32 [ fn.index_of[ '.' ] ]
        return (di > 0) ? fn.mid[ 0, di ] : fn

    func start []
        started = true
        mod : string module_name[]
        # the host's launch flags (silver-host HOST_APP_*): 1 stops the
        # app for the debugger, which a viewer never asks; 2 builds
        # clean; 4 builds -O0 -g bits 8-15: this display's refresh, the
        # pace of an app shown in the pane bit 16: a coverage build
        hz : i32 [ (host_hz > 0) ? host_hz : 60 ]
        fl : i32 [
            ((viewer) ? 0 : 1) | ((clean_build) ? 2 : 0) | ((debug_build) ? 4 : 0) |
            ((display & 3) << 3) | ((hz & 255) << 8) | ((cov_build) ? (1 << 16) : 0) ]
        # flags BEFORE the doc: Au_with_cstrs stops parsing at the first
        # positional, so a trailing flag would never reach the app's
        # schema
        ma9 : string [
            (module_args && module_args.count > 0) ? ' {module_args}'
            : '' ]
        # no size of ours: the app starts at its own, the shape it keeps
        req : string [ (doc) ? '{mod}{ma9} {doc}' : '{mod}{ma9}' ]
        # a fresh process knows nothing of the last one's resize
        req_w  = 0
        req_h  = 0
        pend_w = 0
        pend_h = 0
        app_mod = mod
        slot = host_app_request[ req.chars, fl ]
        log 'start: {req} -> slot {slot} (host bits {fl})'
        if [ slot < 0 ]
            ended = true
            note = 'no silver-host supervisor'
            return
        # orbiter plays its sound: a debugger's pause is silence
        host_audio_player_start[ slot ]
        root9 : path.path_startup[]
        cmd = 'tail -n +1 -F {root9}/install/tmp/{mod}.{slot}.log'

    # hosted apps open one socket per instance:
    # trinity-<mod>-<slot>.sock
    func sock_name [] -> string
        return (slot > 0) ? '{app_mod}-{slot}' : app_mod

    func console_id [] -> string
        return 'ed:{app_mod}'

    func on_key [ ev: Event ]
        k9 : i32 [ ev.key.unicode ]
        if [ ev.key.state && k9 == 294 ]
            restart[ ev.key.shift ]
            return
        if [ ev.key.state && k9 == 297 ]
            pause_toggle[]
            return
        if [ ended || paused || slot < 0 ] return
        mods : i32 [ 0 ]
        if [ ev.key.shift ] mods = mods | 1
        if [ ev.key.ctrl ]  mods = mods | 2
        if [ ev.key.alt ]   mods = mods | 4
        if [ ev.key.meta ]  mods = mods | 8
        act : i32 [ (ev.key.state) ? 1 : 0 ]
        host_post2[ slot, 1, i32[ HM.key ], i32[ ev.key.unicode ], act,
                    mods ]

    # where the app is on screen right now
    func view_rect [] -> rect
        return rect [ x: fitx, y: fity, w: fitw, h: fith ]

    func view_rect_at [ x: f32, y: f32 ] -> rect
        return rect [ x: fitx, y: fity, w: fitw, h: fith ]

    func view_press [ ev: Event ] -> bool
        if [ ended ]
            restart[ false ]
            return true
        if [ paused ]
            pause_toggle[]
            return true
        if [ !ready || slot < 0 ] return false
        px : f32 [ ev.mouse.pos.x - vsx ]
        py : f32 [ ev.mouse.pos.y - vsy ]
        r9 : view_rect_at[ px, py ]
        if [ r9.w <= 0.0 ] return false
        bx : f32 [ (px - r9.x) / r9.w * awp[] ]
        by : f32 [ (py - r9.y) / r9.h * ahp[] ]
        if [ bx < 0.0 || by < 0.0 || bx >= awp[] || by >= ahp[] ]
            return false
        host_post2[ slot, 1, i32[ HM.press ], i32[ bx ], i32[ by ],
                    ev.mouse.button ]
        return true

    # the button stays down until the real release, or the app can never
    # see a drag: it would get down+up before the mouse ever moved
    func view_release [ ev: Event ]
        if [ ended || !ready || slot < 0 ] return
        px : f32 [ ev.mouse.pos.x - vsx ]
        py : f32 [ ev.mouse.pos.y - vsy ]
        r9 : view_rect_at[ px, py ]
        if [ r9.w <= 0.0 ] return
        bx : f32 [ (px - r9.x) / r9.w * awp[] ]
        by : f32 [ (py - r9.y) / r9.h * ahp[] ]
        host_post2[ slot, 1, i32[ HM.release ], i32[ bx ], i32[ by ],
                    ev.mouse.button ]

    func view_move [ ev: Event ] -> bool
        if [ ended || !ready || slot < 0 ] return false
        px : f32 [ ev.mouse.pos.x - vsx ]
        py : f32 [ ev.mouse.pos.y - vsy ]
        r9 : view_rect_at[ px, py ]
        if [ r9.w <= 0.0 ] return false
        bx : f32 [ (px - r9.x) / r9.w * awp[] ]
        by : f32 [ (py - r9.y) / r9.h * ahp[] ]
        if [ bx < 0.0 || by < 0.0 || bx >= awp[] || by >= ahp[] ]
            return false
        host_post2[ slot, 1, i32[ HM.move ], i32[ bx ], i32[ by ], 0 ]
        return true

    # locked: the delta scales to app pixels and rides as a move from
    # the app's lock centre
    func view_lock_move [ ev: Event ]
        if [ ended || !ready || slot < 0 ] return
        r9 : view_rect[]
        if [ r9.w <= 0.0 ] return
        lock_ax += ev.mouse.delta.x * awp[] / r9.w
        lock_ay += ev.mouse.delta.y * ahp[] / r9.h
        dx : i32 [ lock_ax ]
        dy : i32 [ lock_ay ]
        if [ dx == 0 && dy == 0 ] return
        lock_ax -= f32[ dx ]
        lock_ay -= f32[ dy ]
        host_post2[ slot, 1, i32[ HM.move ], lock_cx + dx, lock_cy + dy,
                    0 ]

    func view_wheel [ ev: Event ] -> bool
        if [ ended || !ready || slot < 0 ] return false
        px : f32 [ ev.mouse.pos.x - vsx ]
        py : f32 [ ev.mouse.pos.y - vsy ]
        r9 : view_rect_at[ px, py ]
        if [ r9.w <= 0.0 ] return false
        bx : f32 [ (px - r9.x) / r9.w * awp[] ]
        by : f32 [ (py - r9.y) / r9.h * ahp[] ]
        if [ bx < 0.0 || by < 0.0 || bx >= awp[] || by >= ahp[] ]
            return false
        mods : i32 [ 0 ]
        if [ ev.key.shift ] mods = mods | 1
        if [ ev.key.ctrl ]  mods = mods | 2
        if [ ev.key.alt ]   mods = mods | 4
        if [ ev.key.meta ]  mods = mods | 8
        # the app scrolls at the cursor, so place it before the notch
        host_post2[ slot, 1, i32[ HM.move ], i32[ bx ], i32[ by ], 0 ]
        host_post2[ slot, 1, i32[ HM.wheel ],
            i32[ ev.mouse.wheel_delta.x * 100.0 ],
            i32[ ev.mouse.wheel_delta.y * 100.0 ], mods ]
        return true

    func pause_toggle []
        if [ ended || slot < 0 ] return
        if [ debugger && debugger.active ]
            if [ paused ] debugger.cont[]
            el            debugger.pause[]
            paused = !paused
            return
        if [ paused ]
            host_app_resume[ slot ]
            paused = false
        el
            host_app_pause[ slot ]
            paused = true

    func is_paused [] -> bool
        return paused

    func restart [ clean: bool ]
        clean_build = clean
        cleanup[]
        started    = false
        ready      = false
        ended       = false
        paused     = false
        have_frame = false
        fade_us    = 0
        seen_us    = 0
        note       = ''
        # the new process parks for the debugger like the first did:
        # release it again
        attached   = false
        attaching  = false
        debugger   = null

    intern func cleanup []
        instr_clear[]
        # a debugger-held app is let run so it closes itself (its sound
        # stops cleanly). never a SIGTERM there: the debugger stops on
        # it and the frozen app loops its sound. it ends it only if
        # still there
        dbg : bool [ debugger && debugger.active ]
        if [ dbg && !debugger.running ] debugger.cont[]
        if [ slot > 0 ] host_audio_player_stop[ slot ]
        if [ slot >= 0 ]
            if [ paused ] host_app_resume[ slot ]
            if [ slot > 0 ]
                host_post2[ slot, 1, i32[ HM.close ], 0, 0, 0 ]
            if [ dbg && slot > 0 ]
                pd9 : i32 [ host_app_pid[ slot ] ]
                for [ i9: i32 0,
                      i9 < 100 && pd9 > 0 && host_pid_alive[ pd9 ] != 0,
                      i9 += 1 ]
                    usleep[ 10000 ]
            el
                host_app_stop[ slot ]
            slot = 0 - 1
        if [ dbg ] debugger.stop[]
        if [ tex0 ]
            tex0.drop[]
            tex1.drop[]
            tex0 = null
            tex1 = null
        gen        = 0
        have_frame = false
        fade_us    = 0
        seen_us    = 0

    func release []
        cleanup[]

Layer EditorLayer
    mutable sel_color      : rgba
    mutable sel_border     : rgba
    mutable line_color     : rgba
    # the 1px rules that bound the selected band, top and bottom
    mutable line_edge      : rgba
    # the gutter tint carried across the selected row
    mutable line_gutter    : rgba
    mutable item_color     : rgba
    mutable hl_fill        : rgba
    mutable hl_grad        : rgba
    mutable hl_glow        : rgba
    mutable hl_text        : rgba

    func glow_row [ cv: Canvas, rx: f32, ry: f32, rw: f32, rh: f32 ]
        cv.save[ ]
        cv.rounded[ 6.0, 6.0, 6.0, 6.0 ]
        cv.stroke_width[ 0.0 ]
        cv.fill_color[ hl_fill ]
        if [ hl_grad ]
            cv.fill_grad[ hl_grad ]
            cv.fill_color_pos[ rx, ry ]
            cv.fill_grad_pos[ rx, ry + rh ]
        if [ hl_glow ]
            cv.box_shadow[ hl_glow, 0.0, 0.0, 7.0, 0.0, true ]
        cv.rect_to[ rx, ry, rw, rh ]
        cv.paint[ ]
        cv.restore[ ]

    func on_move [ ev: Event ]
        editor : Editor[ parent ]
        if [ !editor || !editor.dragging ] return
        lh    : f32 [ (editor.lh_cache > 0.0) ? editor.lh_cache : 22.0 ]
        cw    : f32 [ (editor.cw_cache > 0.0) ? editor.cw_cache : 8.0 ]
        rel_y : f32 [ ev.mouse.pos.y ]
        rel_x : f32 [ ev.mouse.pos.x ]
        raw   : i32 [ clamp[ rel_y / lh, 0, editor.line_count[] - 1 ] ]
        ln    : i32 [ editor.snap_row[ raw ] ]
        vx    : f32 [
            round[
                (rel_x - editor.row_indent[ ln ] + editor.scroll.x)
                / cw ] ]
        cl    : i32 [
            editor.model_col[ editor.line_get[ ln ], i32[ vx ] ] ]
        editor.sel_line = ln
        editor.sel_col  = cl
        editor.pristine = false

    func code_hash [ editor: Editor, msl: i32, ln: string ] -> i64
        h : i64 [ 1469598103934665603 ]
        for [ i: i32 0, i < ln.count, i += 1 ]
            h = (h ^ i64[ ln[i] ]) * 1099511628211
        nrg : i32 [ editor.line_reg_count[ msl ] ]
        for [ ri: i32 0, ri < nrg, ri += 1 ]
            cr : ColorRegion editor.line_reg[ msl, ri ]
            h = (h ^ i64[ cr.col ]) * 1099511628211
            h = (h ^ i64[ cr.len ]) * 1099511628211
            h = (h ^ i64[ i32[ cr.color.r * 255.0 ] + i32[ cr.color.g * 255.0 ] * 256 + i32[ cr.color.b * 255.0 ] * 65536 ]) * 1099511628211
        return h

    func code_slot [ cv: Canvas, editor: Editor, msl: i32, ln: string,
                     cmt_c: rgba, lh: f32, cw: f32,
                     code_fs: i32 ] -> EdLineCache
        ll : i32 [ ln.count ]
        if [ ll == 0 ] return null
        if [ !editor.code_lines ] editor.code_lines = vec EdLineCache []
        h : i64 [ code_hash[ editor, msl, ln ] ]
        for [ slot: EdLineCache ] in editor.code_lines
            if [ slot.canvas && slot.hash == h ]
                slot.frame = editor.cl_frame
                return slot
        use : EdLineCache [ null ]
        for [ slot: EdLineCache ] in editor.code_lines
            if [ slot.frame != editor.cl_frame ]
                use = slot
                break
        if [ !use ]
            use = EdLineCache [ ]
            editor.code_lines.push[ use ]
        disp : editor.display_of[ ln ]
        cw_i : i32 [ ceil[ f32[ disp.count ] * cw + cw ] ]
        if [ cw_i < 1 ] cw_i = 1
        lh_i : i32 [ i32[ ceil[ lh ] ] + 1 ]
        if [ !use.canvas ]
            use.canvas = Canvas [ vk: cv.vk, w: cv.w,
                                  format: Pixel.rgba8, width: cw_i,
                                  height: lh_i, load_existing: true,
                                  quantize: true, tag: 'line' ]
            use.canvas.update[]
        el [
            use.canvas.content_w != cw_i
            || use.canvas.content_h != lh_i ]
            use.canvas.resize[ cw_i, lh_i ]
        lc : use.canvas
        lc.reset[ vec4f [ 0.0, 0.0, 0.0, 0.0 ] ]
        if [ code_fs > 0 ] lc.font_size[ code_fs ]
        editor.text_lines_frame += 1
        editor.text_lines_total += 1
        rw  : f32 [ cw_i ]
        nrg : i32 [
            (editor.finder_list || editor.show_nav || editor.show_hits)
            ? 0 : editor.line_reg_count[ msl ] ]
        if [ nrg == 0 ]
            tc : rgba['#fff']
            for [ k: i32 0, k < ll, k += 1 ]
                if [ ln[k] == 35 ]
                    tc = cmt_c
                    break
            lc.fill_color[ tc ]
            lc.draw_text[ disp, rect [ x: 0.0, y: 0.0, w: rw, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible,
                null ]
        el
            col : i32 [ 0 ]
            for [ ri: i32 0, ri < nrg, ri += 1 ]
                cr : ColorRegion editor.line_reg[ msl, ri ]
                c0 : i32 [ cr.col ]
                if [ c0 < 0 ] c0 = 0
                if [ c0 > ll ] c0 = ll
                sl : i32 [ cr.len ]
                if [ c0 + sl > ll ] sl = ll - c0
                if [ c0 > col ]
                    gx : f32[
                        editor.display_of[
                            ln.mid[ 0, col ] ].count ] * cw
                    lc.fill_color[ rgba['#fff'] ]
                    lc.draw_text[
                        editor.display_of[ ln.mid[ col, c0 - col ] ],
                        rect [ x: gx, y: 0.0, w: rw, h: lh ],
                        vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                        Overflow.visible, null ]
                    col = c0
                if [ sl > 0 ]
                    tx : f32[
                        editor.display_of[
                            ln.mid[ 0, c0 ] ].count ] * cw
                    lc.fill_color[ cr.color ]
                    lc.draw_text[ ln.mid[ c0, sl ],
                        rect [ x: tx, y: 0.0, w: rw, h: lh ],
                        vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                        Overflow.visible, null ]
                    col = c0 + sl
            if [ col < ll ]
                gc : rgba['#fff']
                for [ k: i32 col, k < ll, k += 1 ]
                    if [ ln[k] == 35 ]
                        gc = cmt_c
                        break
                ex : f32 [
                    f32[ editor.display_of[ ln.mid[ 0, col ] ].count ]
                    * cw ]
                lc.fill_color[ gc ]
                lc.draw_text[
                    editor.display_of[ ln.mid[ col, ll - col ] ],
                    rect [ x: ex, y: 0.0, w: rw, h: lh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                    Overflow.visible, null ]
        lc.paint[ ]
        use.hash  = h
        use.frame = editor.cl_frame
        return use

    func band_hash [ editor: Editor, bs: i32, bands: i32, code_fs: i32,
                     hcol: i32 ] -> i64
        h : i64 [ i64[ bs ] * 1099511628211 + i64[ code_fs ] ]
        # the band holds the visible window only, so the column it
        # starts at is part of what it caches. the WIDTH is not: a strip
        # is drawn wider than the pane and reused until the pane
        # outgrows it
        h = (h ^ i64[ hcol ]) * 1099511628211
        for [ k: i32 0, k < bands, k += 1 ]
            li : i32 [ bs + k ]
            if [ li >= editor.line_count[] ] break
            if [ editor.row_header[ li ] || editor.row_var[ li ] ]
                h = (h ^ 1) * 1099511628211
                continue
            ln : editor.draw_line[ li ]
            if [ ln.count == 0 ]
                h = (h ^ 2) * 1099511628211
                continue
            h = (h ^ code_hash[ editor, editor.row_src[ li ], ln ]) * 1099511628211
        return h

    # the hovered rail's change, in a window left of the track at the
    # pointer: its title, then its code (a removal: its old lines) with
    # 4 lines of context above and below, fainter
    func peek_draw [ cv: Canvas, editor: Editor, right: f32, elh: f32,
                     ecw: f32, efs: i32 ]
        i : i32 [ editor.rail_hover1 - 1 ]
        if [ i < 0 || !editor.hunks || i * 3 + 2 >= editor.hunks.count ]
            return
        kind : i32 [ editor.hunks[ i * 3 + 2 ] ]
        rows : i32 [ editor.hunks[ i * 3 + 1 ] ]
        if [ kind == 3 ]
            rows = (editor.peek_old) ? i32[ editor.peek_old.count ] : 0
        if [ rows > 16 ] rows = 16
        if [ rows < 1 ] return
        # its own size: 80% of the editor's font, its own metrics
        code_fs : i32 [ max[ 9, i32[ round[ f32[ efs ] * 0.8 ] ] ] ]
        cv.font_size[ code_fs ]
        cw : f32 [ cv.measure_text[ 'x' ].w ]
        lh : f32 [ round[ elh * f32[ code_fs ] / f32[ efs ] ] ]
        r0 : i32 [ editor.hunk_view_row[ i ] ]
        n  : i32 [ editor.line_count[] ]
        # the context: up to 4 rows a side, inside the file
        above : i32 [ min[ 4, r0 ] ]
        after : i32 [ (kind == 3) ? r0 : r0 + rows ]
        below : i32 [ max[ 0, min[ 4, n - after ] ] ]
        all : i32 [ above + rows + below ]
        th : f32 [ 26.0 ]
        ww : f32 [ min[ bounds.w * 0.35, cw * 45.0 + 16.0 ] ]
        wh : f32 [ th + f32[ all ] * lh + 8.0 ]
        wx : f32 [ round[ right - ww ] ]
        wy : f32 [ round[ clamp[ bounds.y + editor.peek_y - wh * 0.5,
                   bounds.y + 4.0, bounds.y + bounds.h - wh - 4.0 ] ] ]
        iw : i32 [ i32[ ww - 16.0 ] ]
        cmt : rgba [ '#7a8290' ]
        cv.save[ ]
        cv.fill_color[ rgba [ '#0b0d14e6' ] ]
        cv.stroke_color[ rgba [ '#fff1' ] ]
        # 1.1: a whole pixel thins out round the corners
        cv.stroke_width[ 1.1 ]
        cv.stroke_offset[ -0.5 ]
        # a slight inner glow round the whole of it, and a drop shadow
        # under it (2px down, 14px blur)
        cv.box_shadow[ rgba [ '#c890ff55' ], 0.0, 0.0, 8.0, 0.0, true ]
        cv.shadow[ 1, rgba [ '#00000099' ], 0.0, 2.0, 14.0, 0.0, false ]
        cv.rounded[ 14.0, 14.0, 14.0, 14.0 ]
        cv.rounded_rect[ wx, wy, ww, wh, 14.0, 14.0, 14.0, 14.0 ]
        cv.paint[ ]
        cv.no_shadows[ ]
        cv.rounded[ 0.0, 0.0, 0.0, 0.0 ]
        cv.stroke_width[ 0.0 ]
        cv.stroke_offset[ 0.0 ]
        cv.font_size[ 13 ]
        cv.fill_color[ rgba [ '#c8c0e0' ] ]
        tr : rect [ x: wx + 10.0, y: wy, w: ww - 20.0, h: th ]
        cv.draw_text[ (editor.peek_title) ? editor.peek_title : '', tr,
            vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.ellipsis,
            null ]
        cv.fill_color[ rgba [ '#ffffff14' ] ]
        cv.rect_to[ wx + 1.0, wy + th, ww - 2.0, 1.0 ]
        cv.paint[ ]
        cy : f32 [ wy + th + 4.0 ]
        # the code stays inside the window: a strip runs a tenth wide
        ox : f32 [ cv.transform_tx[] ]
        oy : f32 [ cv.transform_ty[] ]
        cv.crop_within[ ox + wx + 8.0, oy + cy, ox + wx + ww - 8.0,
                        oy + wy + wh - 4.0 ]
        # the context: the same rows, fainter
        op : f32 [ cv.get_opacity[] ]
        if [ above > 0 ]
            ba : EdLineCache code_band[ cv, editor, r0 - above, above,
                cmt, lh, cw, code_fs, 0, iw ]
            cv.set_opacity[ op * 0.35 ]
            peek_band[ cv, ba, wx + 8.0, cy ]
            cv.set_opacity[ op ]
        my : f32 [ cy + f32[ above ] * lh ]
        if [ kind == 3 ]
            cv.font_size[ code_fs ]
            cv.fill_color[ rgba [ '#ff8a8a' ] ]
            for [ k: i32 0, k < rows, k += 1 ]
                lr : rect [ x: wx + 8.0, y: my + f32[ k ] * lh,
                            w: ww - 16.0, h: lh ]
                cv.draw_text[ editor.peek_old[ k ], lr,
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                    Overflow.ellipsis, null ]
        el
            mb : EdLineCache code_band[ cv, editor, r0, rows, cmt, lh,
                cw, code_fs, 0, iw ]
            peek_band[ cv, mb, wx + 8.0, my ]
        if [ below > 0 ]
            bb : EdLineCache code_band[ cv, editor, after, below, cmt,
                lh, cw, code_fs, 0, iw ]
            cv.set_opacity[ op * 0.35 ]
            peek_band[ cv, bb, wx + 8.0, my + f32[ rows ] * lh ]
            cv.set_opacity[ op ]
        cv.restore[ ]

    func peek_band [ cv: Canvas, band: EdLineCache, x: f32, y: f32 ]
        if [ !band || !band.canvas ] return
        cv.draw_canvas[ band.canvas, x, y, f32[ band.canvas.content_w ],
                        f32[ band.canvas.content_h ] ]

    func code_band [ cv: Canvas, editor: Editor, bs: i32, bands: i32,
                     cmt_c: rgba, lh: f32, cw: f32, code_fs: i32,
                     hcol: i32, vis_w: i32 ] -> EdLineCache
        if [ !editor.code_lines ] editor.code_lines = vec EdLineCache []
        h    : i64 [ band_hash[ editor, bs, bands, code_fs, hcol ] ]
        # drawn a tenth wider than the pane: a drag reveals into the
        # slack instead of rebuilding every strip on every pixel of
        # movement
        want : i32 [ ceil[ f32[ vis_w ] * 1.1 ] ]
        # text starts hcol columns to the left: shift+scroll pans it
        hoff     : f32 [ f32[ hcol ] * cw ]
        maxw     : i32 [ 1 ]
        has_code : bool [ false ]
        for [ k: i32 0, k < bands, k += 1 ]
            li : i32 [ bs + k ]
            if [ li >= editor.line_count[] ] break
            if [ editor.row_header[ li ] || editor.row_var[ li ] ]
                continue
            ln : editor.draw_line[ li ]
            if [ ln.count == 0 ] continue
            has_code = true
            cwi : i32 [
                ceil[
                    f32[ editor.display_of[ ln ].count ] * cw + cw
                    - hoff ] ]
            if [ cwi > maxw ] maxw = cwi
        if [ !has_code ] return null
        # never unbounded: what lies past the slack is reached by
        # horizontal scroll, which re-renders the band at its new column
        if [ maxw > want + i32[ cw ] ] maxw = want + i32[ cw ]
        lc_h : i32 [ i32[ ceil[ f32[ bands ] * lh ] ] + 1 ]
        # cache hit → reuse, just tick the frame. a strip already
        # covering this width serves any narrower pane; only growing
        # past it redraws
        for [ slot: EdLineCache ] in editor.code_lines
            if [ slot.canvas && slot.hash == h && slot.cover >= vis_w ]
                slot.frame = editor.cl_frame
                return slot
        use : EdLineCache [ null ]
        for [ slot: EdLineCache ] in editor.code_lines
            if [ slot.frame != editor.cl_frame ]
                use = slot
                break
        if [ !use ]
            use = EdLineCache [ ]
            editor.code_lines.push[ use ]
        if [ !use.canvas ]
            use.canvas = Canvas [ vk: cv.vk, w: cv.w,
                                  format: Pixel.rgba8, width: maxw,
                                  height: lc_h, load_existing: true,
                                  quantize: true, tag: 'band' ]
            use.canvas.update[]
        el [
            use.canvas.content_w != maxw
            || use.canvas.content_h != lc_h ]
            use.canvas.resize[ maxw, lc_h ]
        lc : use.canvas
        lc.reset[ vec4f [ 0.0, 0.0, 0.0, 0.0 ] ]
        if [ code_fs > 0 ] lc.font_size[ code_fs ]
        rw : f32 [ maxw ]
        for [ k: i32 0, k < bands, k += 1 ]
            li : i32 [ bs + k ]
            if [ li >= editor.line_count[] ] break
            if [ editor.row_header[ li ] || editor.row_var[ li ] ]
                continue
            ln : editor.draw_line[ li ]
            ll : i32 [ ln.count ]
            if [ ll == 0 ] continue
            editor.text_lines_frame += 1
            editor.text_lines_total += 1
            yk   : f32 [ f32[ k ] * lh ]
            msl  : i32 [ editor.row_src[ li ] ]
            disp : editor.display_of[ ln ]
            nrg  : i32 [
                (editor.finder_list || editor.show_nav || editor.show_hits) ? 0 : editor.line_reg_count[ msl ] ]
            if [ nrg == 0 ]
                tc : rgba['#fff']
                for [ kk: i32 0, kk < ll, kk += 1 ]
                    if [ ln[kk] == 35 ]
                        tc = cmt_c
                        break
                lc.fill_color[ tc ]
                lc.draw_text[ disp,
                              rect [ x: 0.0 - hoff, y: yk, w: rw,
                                     h: lh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                    Overflow.visible, null ]
            el
                col : i32 [ 0 ]
                for [ ri: i32 0, ri < nrg, ri += 1 ]
                    cr : ColorRegion editor.line_reg[ msl, ri ]
                    c0 : i32 [ cr.col ]
                    if [ c0 < 0 ] c0 = 0
                    if [ c0 > ll ] c0 = ll
                    sl : i32 [ cr.len ]
                    if [ c0 + sl > ll ] sl = ll - c0
                    if [ c0 > col ]
                        gx : f32 [
                            f32[
                                editor.display_of[
                                    ln.mid[ 0, col ] ].count ] * cw
                                    - hoff ]
                        lc.fill_color[ rgba['#fff'] ]
                        lc.draw_text[
                            editor.display_of[
                                ln.mid[ col, c0 - col ] ],
                            rect [ x: gx, y: yk, w: rw, h: lh ],
                            vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                            Overflow.visible, null ]
                        col = c0
                    if [ sl > 0 ]
                        tx : f32 [
                            f32[
                                editor.display_of[
                                    ln.mid[ 0, c0 ] ].count ] * cw
                                    - hoff ]
                        lc.fill_color[ cr.color ]
                        lc.draw_text[ ln.mid[ c0, sl ],
                            rect [ x: tx, y: yk, w: rw, h: lh ],
                            vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                            Overflow.visible, null ]
                        col = c0 + sl
                if [ col < ll ]
                    gc : rgba['#fff']
                    for [ kk: i32 col, kk < ll, kk += 1 ]
                        if [ ln[kk] == 35 ]
                            gc = cmt_c
                            break
                    ex : f32 [
                        f32[
                            editor.display_of[
                                ln.mid[ 0, col ] ].count ] * cw - hoff ]
                    lc.fill_color[ gc ]
                    lc.draw_text[
                        editor.display_of[ ln.mid[ col, ll - col ] ],
                        rect [ x: ex, y: yk, w: rw, h: lh ],
                        vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                        Overflow.visible, null ]
        lc.paint[ ]
        use.hash  = h
        use.cover = want
        use.frame = editor.cl_frame
        return use

    # ctrl/cmd held: outline every token on a row that resolves, so the
    # jump targets announce themselves. body rows and the pinned header
    # band both draw through here, each at its own y
    func outline_jumps [ cv: Canvas, editor: Editor, li: i32, x0: f32,
                         y: f32, lh: f32, cw: f32 ]
        ln  : editor.line_get[ li ]
        msl : i32 [ editor.row_src[ li ] ]
        nrg : i32 [ editor.line_reg_count[ msl ] ]
        for [ ri: i32 0, ri < nrg, ri += 1 ]
            cr : ColorRegion editor.line_reg[ msl, ri ]
            c09 : i32 [ cr.col ]
            sl9 : i32 [ cr.len ]
            if [ c09 < 0 || sl9 <= 0 ] continue
            if [ c09 + sl9 > ln.count ] continue
            w9 : ln.mid[ c09, sl9 ]
            # the map already resolved this token. a module
            # name is the one case it cannot -- that is a file
            ok9 : bool [ cr.dsrc && cr.dline > 0 ]
            if [ cr.kind == 14 ] ok9 = editor.module_path[ w9 ] != null
            if [ !ok9 ] continue
            tx9 : f32 [
                f32[ editor.display_of[ ln.mid[ 0, c09 ] ].count ]
                * cw ]
            ww : f32 [ f32[ editor.display_of[ w9 ].count ] * cw ]
            cv.save[ ]
            cv.rounded[ 3.0, 3.0, 3.0, 3.0 ]
            # faint at rest; the pointer's light brings the border and
            # an inner glow up
            cv.fill_color[ rgba['#3b6fe00b'] ]
            cv.stroke_width[ 1.0 ]
            cv.stroke_offset[ -0.5 ]
            cv.stroke_color[ rgba['#8cf3'] ]
            cv.box_shadow[ rgba['#8cf2'], 0.0, 0.0, 6.0, 0.0, true ]
            editor.ux.near_light_on[ cv, editor, 0.0, 0.0 ]
            cv.near_style[ 1.0, 3.0, rgba['#8cf'],
                           editor.ux.near_y_fade ]
            cv.rect_to[ x0 + tx9 - 1.0, y + 1.0, ww + 2.0, lh - 2.0 ]
            cv.paint[ ]
            cv.restore[ ]

    func draw [ cv: Canvas ]
        editor : Editor[ parent ]
        if [ !editor ] return
        sc : string [ (editor.src) ? '{editor.src}' : '' ]
        lc : string [ (editor.loaded_src) ? '{editor.loaded_src}' : '' ]
        dc : string [ (editor.diff_commit) ? editor.diff_commit : '' ]
        ld : string [ (editor.loaded_diff) ? editor.loaded_diff : '' ]
        if [ sc.compare[ lc ] != 0 || dc.compare[ ld ] != 0 ]
            editor.load_file[]
        if [ editor.diff_commit && editor.diff_dirty ]
            if [ epoch_millis[] - editor.diff_edit_ms > 400 ]
                editor.diff_rebuild[ true ]
            el
                editor.ux.will_animate = true
        # an app on its way to this pane (its module loading first)
        # keeps the pane blank too
        orbw : cast orbiter [ editor.ux.app_object ]
        coming : bool [
            orbw && orbw.pending_show > 0
            && orbw.pending_show_pane == editor.pane_index ]
        if [
            editor.app_view
            || (editor.run_view && editor.run_view.ended)
            || (!editor.run_view && !coming) ]
            editor.wait_app = false
        if [ editor.wait_app ] return
        if [ editor.run_view ]
            # an ended or held app has no live frame: the source shows
            if [
                editor.app_view && !editor.show_hits
                && !editor.stopped[] && !editor.run_view.ended
                && !editor.run_view.held ]
                b2 : rect [ x: bounds.x, y: bounds.y, w: bounds.w,
                            h: bounds.h ]
                bot : element (editor.elements) ? editor.elements['bottom'] : null
                if [ bot && bot.bounds && bot.bounds.h > 0.0 ]
                    lim : f32 [ bot.bounds.y - b2.y ]
                    if [ lim > 0.0 && lim < b2.h ] b2.h = lim
                editor.run_view.vx = b2.x
                editor.run_view.vy = b2.y
                editor.run_view.vw = b2.w
                editor.run_view.vh = b2.h
                editor.run_view.vsx = editor.scroll.x
                editor.run_view.vsy = editor.scroll.y
                if [ editor.run_view.fade_us != 0 ]
                    fal : f32 [
                        f32[ epoch_micros[] - editor.run_view.fade_us ]
                        / 400000.0 ]
                    if [ fal >= 1.0 ]
                        parent.mask_glow  = vec4f [ 0.0, 0.0, 0.0, 0.0 ]
                        parent.mask_inset = vec4f [ 0.0, 0.0, 0.0, 0.0 ]
                        editor.no_scroll = true
                        editor.run_view.draw_frame[ cv, b2 ]
                        return
                # the picture fades in over a blank pane, never the code
                return
        if [ editor.rview && !editor.show_hits ]
            if [ !editor.rview.view_text*[ editor.rview.view_sel ] ]
                hfs : i32 [
                    (editor.code_font_size > 0) ? editor.code_font_size
                    : 15 ]
                cv.font_size[ hfs ]
                hlh : f32 [ round[ cv.get_line_height[] ] ]
                # a view that reports an extent scrolls in the pane
                vch : f32 [ editor.rview.content_height*[ cv, bounds ] ]
                if [ vch > 0.0 ]
                    editor.content_h    = vch
                    editor.scroll_speed = hlh
                    hms : f32 [ editor.content_h - bounds.h ]
                    if [ hms < 0.0 ] hms = 0.0
                    hjd : f32 [ editor.scroll.y - editor.hx_last_y ]
                    if [ hjd > 0.5 || hjd < 0.0 - 0.5 ]
                        editor.scroll_target = editor.scroll.y
                    if [ editor.pending_wheel != 0.0 ]
                        editor.scroll_target = editor.scroll_target - editor.pending_wheel * hlh * 0.6
                        editor.pending_wheel = 0.0
                    if [ editor.scroll_target < 0.0 ]
                        editor.scroll_target = 0.0
                    if [ editor.scroll_target > hms ]
                        editor.scroll_target = hms
                    hdy : f32 [ editor.scroll_target - editor.scroll.y ]
                    if [ (hdy > 0.5) || (hdy < 0.0 - 0.5) ]
                        editor.scroll.y = filter_n[ editor.scroll.y,
                                                    editor.scroll_target,
                                                    0.14,
                                                    editor.ux.frame_factor ]
                        parent.needs_frame = true
                        if [ editor.ux ] editor.ux.will_animate = true
                    el
                        editor.scroll.y = editor.scroll_target
                    if [ editor.scroll.y < 0.0 ] editor.scroll.y = 0.0
                    if [ editor.scroll.y > hms ] editor.scroll.y = hms
                    editor.lh_cache  = hlh
                    editor.hx_last_y = editor.scroll.y
                    hxmx : f32 [
                        editor.rview.content_width*[ cv, bounds ]
                        - bounds.w ]
                    if [ hxmx < 0.0 ] hxmx = 0.0
                    if [ editor.scroll.x < 0.0 ] editor.scroll.x = 0.0
                    if [ editor.scroll.x > hxmx ] editor.scroll.x = hxmx
                    editor.rview.set_scroll*[ editor.scroll.x,
                                              editor.scroll.y ]
                    hxf : f32 [ (editor.scroll.y > 0.0) ? 0.0 : 0.0 ]
                    hxl : f32 [ (editor.scroll.x > 0.0) ? 0.0 : 0.0 ]
                    # right fade is a fixed short edge, not
                    # width-proportional
                    parent.mask_glow   = vec4f [ hxf, 48.0, hlh, hxl ]
                    parent.mask_keep_l = 0.0
                    parent.mask_inset  = vec4f [ 0.0, 0.0, 0.0, 0.0 ]
                    
                editor.rview.vx = bounds.x
                editor.rview.vy = bounds.y
                editor.rview.vw = bounds.w
                editor.rview.vh = bounds.h
                editor.rview.vsx = editor.scroll.x
                editor.rview.vsy = editor.scroll.y
                # the view paints in its own canvas state: a font it
                # sets
                # (the hex view's) must not become the next layout's em,
                # or every em-sized area (the title) shrinks to it
                cv.save[ ]
                editor.rview.render*[ cv, bounds ]
                cv.restore[ ]
                return
        if [ !editor.lines ] return
        showing : bool [ editor.show_hits ]
        if [ showing && !editor.was_showing ]
            editor.sel_line = -1
        editor.was_showing = showing
        hits    : editor.hits
        code_fs : i32 [
            (editor.code_font_size > 0) ? editor.code_font_size : 15 ]
        cv.font_size[ code_fs ]
        cw_tm   : cv.measure_text[ 'x' ]
        lh      : f32 [
            round[
                cv.get_line_height[]
                * ((label_height > 0.0) ? label_height : 1.0) ] ]
        # the pinned band at the top: nothing row-bound draws under it.
        # lh_cache first — pinned_rows measures with it, and a stale one
        # counted a different band here than the draw below, reserving a
        # strip for a band that never appeared
        # a new row height keeps the same rows in view: scroll is in px
        if [ editor.lh_cache > 0.0 && editor.lh_cache != lh ]
            editor.scroll.y      = editor.scroll.y * lh / editor.lh_cache
            editor.scroll_target = editor.scroll.y
            editor.scroll_goal   = editor.scroll.y
        editor.lh_cache = lh
        pins0   : vec i32 editor.pinned_rows[]
        pt0     : f32 [ (showing) ? 0.0 : f32[ pins0.count ] * lh ]
        et     : string editor.err_band_text[]
        eb     : f32 [ (et && !showing) ? lh : 0.0 ]
        ndigits : i32 [ 1 ]
        ncount  : i32 [ editor.line_count[] ]
        while [ ncount >= 10 ]
            ncount  = ncount / 10
            ndigits += 1
        if [ ndigits < 5 ] ndigits = 5
        gut_w   : f32 [ f32[ ndigits ] * cw_tm.w + 16.0 ]
        # the title's back and forward arrows sit above it: one width
        orbg : cast orbiter [ editor.ux.app_object ]
        ttg  : element (orbg) ? orbg.title_at[
            editor.pane_index ] : null
        hng  : element (ttg && ttg.elements) ? ttg.elements[
            'histnav' ] : null
        if [ hng && hng.bounds && hng.bounds.w > 0.0 ]
            gut_w = hng.bounds.w
        # browse nav shows no line numbers and no pin gutter: rows
        # start where the zone pills do
        if [ showing && hits && editor.nav_list ] gut_w = 12.0
        editor.gutter_w = gut_w
        if [ !showing ] editor.hunks_check[]
        if [ editor.scroll.x < 0.0 ] editor.scroll.x = 0.0
        # left tool rail pushes the nav content right by 64px
        lin     : f32 [
            (editor.nav_tools && editor.nav_tools.count > 0) ? 64.0
            : 0.0 ]
        # the list never scrolls on x: its rows line up with the zone
        x0      : f32 [
            bounds.x + lin + gut_w
            - ((showing) ? 0.0 : editor.scroll.x) ]
        # the list drops 10px so row 0 tops the rail's first button
        y0      : f32 [ bounds.y + ((showing) ? 10.0 : 0.0) ]
        dbg_el  : element (editor.elements) ? editor.elements['dbg'] : null
        din     : f32 [ 0.0 ]
        if [ dbg_el && dbg_el.bounds ]
            din = dbg_el.bounds.w
        rin     : f32 [ din ]
        # the element itself never masks: fills and the gutter stay
        # crisp. the fade rides on the text canvas alone (blitted
        # below).
        parent.mask_glow   = vec4f [ 0.0, 0.0, 0.0, 0.0 ]
        parent.mask_keep_l = 0.0
        parent.mask_inset  = vec4f [ 0.0, 0.0, 0.0, 0.0 ]
        fade_l : f32 [ 0.0 ]
        fade_t : f32 [ 0.0 ]
        fade_b : f32 [ 0.0 ]
        fade_r : f32 [ 0.0 ]
        if [ !editor.grid_mode ]
            fade_l = (editor.scroll.x > 0.0) ? bounds.w / 8.0 : 0.0
            fade_t = (editor.scroll.y > 0.0) ? lh : 0.0
            fade_b = lh
            fade_r = 48.0

        editor.cw_cache  = cw_tm.w
        editor.text_lines_frame = 0
        editor.cl_frame += 1
        if [ editor.cl_cw != cw_tm.w || editor.cl_lh != lh ]
            if [ editor.code_lines ]
                for [ slot: EdLineCache ] in editor.code_lines
                    slot.hash = -1
            editor.cl_cw = cw_tm.w
            editor.cl_lh = lh
        editor.rebuild_flat[]
        grid_cw    : f32 [ 140.0 ]            # cell slot width
        # cell slot height (square thumb + 2-line label)
        grid_ch    : f32 [ 178.0 ]
        grid_cols  : i32 [ 1 ]
        grid_pins  : i32 [ 0 ]                # pinned-dock cell count
        grid_res   : i32 [ 0 ]               # result cell count
        if [ editor.grid_mode && editor.hits ]
            gavail : f32 [ bounds.w - lin - rin - 8.0 ]
            grid_cols = i32[ gavail / grid_cw ]
            if [ grid_cols < 1 ] grid_cols = 1
            for [ li: i32 0, li < editor.hits.count, li += 1 ]
                h : FindHit editor.hits[ li ]
                if [ !h || !h.is_header || !h.file || h.is_spacer ]
                    continue
                if [ editor.row_cont[ li ] ] continue
                if [ li < editor.dock_rows ] grid_pins += 1
                el                            grid_res += 1
        grid_resoff : f32 [ 0.0 ]
        if [ editor.grid_mode ]
            pin_rows : i32 [ (grid_pins + grid_cols - 1) / grid_cols ]
            res_rows : i32 [ (grid_res  + grid_cols - 1) / grid_cols ]
            if [ grid_pins > 0 ]
                grid_resoff = f32[ pin_rows ] * grid_ch + lh
            editor.content_h = grid_resoff + f32[ res_rows ] * grid_ch
            editor.g_cols    = grid_cols
            editor.g_pins    = grid_pins
            editor.g_resoff  = grid_resoff
        el
            # four lines of trailing air: the last line sat flush on the
            # bottom edge. every row loop stops at line_count[], so
            # these rows draw nothing — no text, no gutter number
            editor.content_h = f32[ editor.line_count[] + 4 ] * lh + eb
        editor.scroll_speed = (editor.grid_mode) ? grid_ch : lh
        # the source is what this pane shows: it scrolls, with its bar.
        # an instance being selected (held, or shown in the pip) turned
        # this off and left the source frozen with no scrollbar
        editor.no_scroll = false

        vh : f32 [ bounds.h ]
        max_scroll : f32 [ editor.content_h - vh ]
        if [ max_scroll < 0.0 ] max_scroll = 0.0
        if [ editor.pending_wheel != 0.0 ]
            editor.scroll_target = editor.scroll_target - editor.pending_wheel * lh * 0.6
            editor.pending_wheel = 0.0
        if [ editor.scroll_target < 0.0 ] editor.scroll_target = 0.0
        if [ editor.scroll_target > max_scroll ]
            editor.scroll_target = max_scroll
        sdy : f32 [ editor.scroll_target - editor.scroll.y ]
        if [ (sdy > 0.5) || (sdy < 0.0 - 0.5) ]
            editor.scroll.y = filter_n[ editor.scroll.y,
                                        editor.scroll_target, 0.14,
                                        editor.ux.frame_factor ]
            parent.needs_frame = true
            if [ editor.ux ] editor.ux.will_animate = true
        el
            editor.scroll.y = editor.scroll_target
        if [ editor.scroll.y < 0.0 ] editor.scroll.y = 0.0
        if [ editor.scroll.y > max_scroll ] editor.scroll.y = max_scroll

        wtx : f32 [ cv.transform_tx[] ]
        wty : f32 [ cv.transform_ty[] ]
        cv.set_crop[ wtx + bounds.x, wty + bounds.y,
            wtx + bounds.x + bounds.w - rin, wty + bounds.y + vh ]

        if [ editor.grid_mode && editor.hits ]
            # margin inside each cell slot
            gm    : f32 [ 8.0 ]
            gth   : f32 [ grid_cw - gm * 2.0 ]  # square thumbnail size
            pin_i : i32 [ 0 ]
            res_i : i32 [ 0 ]
            if [ grid_pins > 0 ]
                pr : i32 [ (grid_pins + grid_cols - 1) / grid_cols ]
                sy : f32 [
                    y0 + f32[ pr ] * grid_ch + lh * 0.5
                    - editor.scroll.y ]
                if [ sy >= bounds.y && sy <= bounds.y + bounds.h ]
                    cv.fill_color  [ rgba['#ffffff30'] ]
                    cv.stroke_width[ 0.0 ]
                    cv.rect_to     [ bounds.x + lin + 8.0, round[ sy ],
                                     bounds.w - lin - rin - 16.0, 1.0 ]
                    cv.paint       [ ]
            for [ li: i32 0, li < editor.hits.count, li += 1 ]
                h : FindHit editor.hits[ li ]
                if [ !h || !h.is_header || !h.file || h.is_spacer ]
                    continue
                if [ editor.row_cont[ li ] ] continue
                is_pin : bool [ li < editor.dock_rows ]
                gidx : i32 [ (is_pin) ? pin_i : res_i ]
                col  : i32 [ gidx % grid_cols ]
                grow : i32 [ gidx / grid_cols ]
                if [ is_pin ] pin_i += 1
                el            res_i += 1
                cx : f32 [ bounds.x + lin + 4.0 + f32[ col ] * grid_cw ]
                cy : f32 [
                    ((is_pin) ? (y0 + f32[ grow ] * grid_ch) : (y0 + grid_resoff + f32[ grow ] * grid_ch)) - editor.scroll.y ]
                if [ cy + grid_ch < bounds.y || cy > bounds.y + bounds.h ]
                    continue
                if [ li == editor.sel_line || li == editor.hover_line ]
                    cv.fill_color  [ rgba['#6cb6ff22'] ]
                    cv.stroke_color[ rgba['#6cb6ffcc'] ]
                    cv.stroke_width[ 1.0 ]
                    cv.stroke_offset[ -0.5 ]
                    cv.rounded_rect[ cx + gm * 0.5, cy + gm * 0.5,
                                     grid_cw - gm, grid_ch - gm, 8.0,
                                     8.0, 8.0, 8.0 ]
                    cv.paint       [ ]
                    cv.stroke_width[ 0.0 ]
                    cv.stroke_offset[ 0.0 ]
                ix : f32 [ cx + gm ]
                iy : f32 [ cy + gm ]
                tex : editor.thumb_for[ h.file, cv ]
                if [ tex ]
                    tw  : f32 [ tex.width ]
                    th  : f32 [ tex.height ]
                    csc : f32 [
                        (tw > 0.0 && th > 0.0)
                        ? minf[ gth / tw, gth / th ] : 1.0 ]
                    dw  : f32 [ tw * csc ]
                    dh  : f32 [ th * csc ]
                    dx  : f32 [ ix + (gth - dw) * 0.5 ]
                    dy  : f32 [ iy + (gth - dh) * 0.5 ]
                    cv.draw_image[ tex,
                                   rect [ x: dx, y: dy, w: dw, h: dh ] ]
                el
                    if [ !editor.file_icon ]
                        ffp : path 'images/file.svg'
                        if [ ffp.exists[] ]
                            editor.file_icon = SVGModel [ ffp ]
                    if [ !editor.ficons ] editor.ficons = FileIcons []
                    if [ !editor.module_icon ]
                        cfp3 : path 'images/material/3d.svg'
                        if [ cfp3.exists[] ]
                            editor.module_icon = SVGModel [ cfp3 ]
                    if [ !editor.folder_icon ]
                        dfp3 : path 'images/material/folder.svg'
                        if [ dfp3.exists[] ]
                            editor.folder_icon = SVGModel [ dfp3 ]
                    ico : SVGModel [
                        (h.is_dir)
                        ? ((h.is_module) ? editor.module_icon : editor.folder_icon) : editor.file_icon ]
                    if [ !h.is_dir ]
                        mico : SVGModel editor.ficons.icon[
                            h.file.filename[], i32[ gth * 0.5 ] ]
                        if [ mico ] ico = mico
                    if [ ico ]
                        hsz : f32 [ gth * 0.5 ]
                        # neutral tint (see list view) — icon shows
                        # authored colors
                        cv.fill_color[ rgba['#ffffff'] ]
                        cv.stroke_color[ rgba['#ffffff'] ]
                        cv.draw_svg[ ico, ix + gth * 0.25,
                                     iy + gth * 0.25, hsz, hsz ]
                ty : f32 [ cy + gm + gth + 2.0 ]
                cv.font_size[ code_fs ]
                cv.fill_color[
                    (h.is_dir) ? rgba['#6cb6ff'] : rgba['#fff'] ]
                cv.draw_text[ h.text,
                              rect [ x: cx + gm, y: ty,
                                     w: grid_cw - gm * 2.0, h: 16.0 ],
                    vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ],
                    Overflow.ellipsis, null ]
