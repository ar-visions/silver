                        lh - 2.0 ]
            cv.paint[ ]
            # coverage: a gutter dot (git owns the fill); missed tints
            ch9 : i64 [
                (!showing && editor.cov_hits && bsl >= 0 && bsl < editor.cov_hits.count) ? editor.cov_hits[ bsl ] : -1 ]
            if [ ch9 >= 0 ]
                if [ ch9 == 0 ]
                    cv.fill_color[ rgba['#f8514914'] ]
                    cv.rect_to[ bounds.x + gut_w, yg,
                                bounds.w - rin - gut_w - 1.0, lh ]
                    cv.paint[ ]
                cv.fill_color[
                    (ch9 > 0) ? rgba['#56d364'] : rgba['#f85149'] ]
                cv.arc[ bounds.x + 9.0, yg + lh * 0.5, 3.0, 0.0,
                        6.2832 ]
                cv.paint[ ]
            # the git state of the row, as the gutter's own colour:
            # added green, changed blue, a removed run as a red edge
            # above. a label only: nothing here hovers or takes a press
            if [
                !showing && !editor.diff_kinds
                && editor.hunks && rnum > 0 ]
                hk : i32 [ editor.hunk_at[ rnum - 1 ] ]
                if [ hk >= 0 ]
                    kd9 : i32 [ editor.hunks[ hk * 3 + 2 ] ]
                    # three colours, one shade each: added green,
                    # changed blue, removed red (the rails and ghost
                    # rows use the same) the removal edge brightens
                    # under the pointer on either row it straddles: a
                    # press there shows the removed lines
