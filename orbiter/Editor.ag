            cv.font_size[ num_fs ]
            # the body numbers are still queued in the text pass: submit
            # them now, or they land after these fills and show through
            cv.flush_text[ ]
            if [ tcv != cv ]
                tcv.set_crop[ gut_w, 0.0, bounds.w - rin, pt ]
            for [ pi: i32 0, pi < pins.count, pi += 1 ]
                pr : i32 [ pins[ pi ] ]
                pn : i32 [ editor.row_src[ pr ] + 1 ]
                py : f32 [ round[ bounds.y + f32[ pi ] * lh ] ]
