                cv.restore[ ]
                cv.fill_color[ rgba['#ffffff80'] ]
                cv.draw_text[ '{pn}',
                    rect [ x: bounds.x, y: py, w: gut_w - 6.0, h: lh ],
                    vec2f [ 1.0, 0.5 ], vec2f [ 0.0, 0.0 ],
