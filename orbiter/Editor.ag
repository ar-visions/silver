        tcv : editor.text_target[ cv, bounds ]
        tox : f32 [ (tcv == cv) ? 0.0 : 0.0 - bounds.x ]
        toy : f32 [ (tcv == cv) ? 0.0 : 0.0 - bounds.y ]

