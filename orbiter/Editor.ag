                rect [ x: bounds.x + lin + gut_w, y: ey,
                       w: bounds.w - lin - gut_w - rin - 8.0, h: lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                Overflow.ellipsis, null ]
            cv.flush_text[ ]
            cv.restore[ ]

# left tool rail: vertical buttons, icon over title, 64px wide
# the extension's handler module leads as the default action
element ToolRail : Toolbar
    animated    : true
    user_events : false
    public top  : f32
    func owner [] -> Editor
        # a real type check: a plain cast hands back the commit view as
        # an
        # Editor, and its nav_tools slot is garbage — the nav-list crash
        if [ parent && parent inherits Editor ] return Editor[ parent ]
        return null
    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        cv : Canvas w.screen
        editor : Editor owner[]
        if [ !editor || !editor.nav_tools || editor.nav_tools.count == 0 ]
            return
        if [ !editor.ficons ] editor.ficons = FileIcons []
        cb  : CommitView[ parent ]
        hov : i32 [ (cb) ? cb.chip_hov : editor.tool_hover ]
        # left inset matches the chips' top padding
        dxx  : f32 [ 4.0 ]
        bas : i32 [ editor.tool_base[] ]
        for [ ti: i32 0, ti < bas + editor.nav_tools.count, ti += 1 ]
            tnm : string (bas == 1 && ti == 0) ? editor.nav_default : editor.nav_tools[ ti - bas ]
            tyy : f32 [ top + editor.tool_y[ ti, bounds.h ] ]
            # the view you are IN reads as a border, not a hover tint
            act9 : bool [ editor.view_name && editor.view_name.count > 0
                          && editor.view_name == tnm ]
            if [ act9 ]
                cv.fill_color  [ rgba['#6cb6ff33'] ]
                cv.stroke_color[ rgba['#8fd0ff'] ]
            el [ ti == hov ]
                cv.fill_color  [ rgba['#6cb6ff22'] ]
                cv.stroke_color[ rgba['#6cb6ffcc'] ]
            el
                cv.fill_color  [ rgba['#10142088'] ]
                cv.stroke_color[ rgba['#fff3'] ]
            cv.stroke_width[ (act9) ? 2.0 : 1.0 ]
            cv.rounded_rect[ dxx, tyy, 60.0, 64.0, 8.0, 8.0, 8.0, 8.0 ]
            cv.paint       [ ]
            cv.stroke_width[ 0.0 ]
            # a console view has its own mark (gear for a shell, chat
            # for an agent) the rail's own window: a browsed-over editor
            # may be detached (no ux)
            orbt : cast orbiter [ ux.app_object ]
            inm  : string tnm
            if [ orbt ]
                cico : string orbt.console_icon[ tnm ]
                if [ cico ] inm = cico
            tico : SVGModel editor.ficons.named[ inm, 36 ]
            if [ tico ]
                # selected = orangish white; resting = off purple white
                cv.svg_override[
                    (act9) ? rgba['#ffe6d2']
                    : ((ti == hov) ? rgba['#ffffff'] : rgba['#cfc6e8']) ]
                cv.draw_svg[ tico, dxx + 12.0, tyy + 6.0, 36.0, 36.0 ]
                cv.svg_override_off[]
            cv.font_size[ 11.0 ]
            cv.fill_color[ rgba['#c9c4dd'] ]
            # an owned label: binding the vec's string and then
            # assigning over it drops a reference this local never held,
            # and the vec's entry frees under it
            tlb : string [ (tnm == 'git') ? 'diff' : '{tnm}' ]
            cv.draw_text[ tlb,
                          rect [ x: dxx, y: tyy + 44.0, w: 60.0,
                                 h: 16.0 ],
                vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip,
                null ]

Control Editor
    style : CSS {
        layers.content: EditorLayer
            area: l0 t1px r0 b0
            label_height: 1.0
            line_color: #44225588
            line_edge: #fff2
            line_gutter: #ffffff08
            item_color: #2b3a5500
            sel_color: #425
            sel_border: #ede3
            hl_fill: #ff6a2e55
            hl_grad: #c0381844
            hl_glow: #ff8a3a99
            hl_text: #ffe6d2
        layers.scrollbar: ScrollLayer
            overlay: true
            area: 8px
            thumb_color: #fff4
            thumb_w: 6.0
            thumb_min_h: 32.0
            thumb_radius: 4.0
    }
    public  selected      : bool
    public  expanded      : bool
    public  show_hits     : bool
    public  hits          : vec FindHit
    public  finder_list   : bool
    public  single_line   : bool
    public  nav_list      : bool
    public  grid_mode     : bool
