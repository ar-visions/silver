    func grid_hit_index [ mx: f32, my: f32, bw: f32 ] -> i32
        if [ !hits ] return -1
        gcw  : f32 [ 140.0 ]
        gch  : f32 [ 178.0 ]
        lin9 : f32 [ (nav_tools && nav_tools.count > 0) ? 64.0 : 0.0 ]
        cols : i32 [ (g_cols > 0) ? g_cols : 1 ]
        ccol : i32 [ (mx - lin9 - 4.0) / gcw ]
        if [ my < 0.0 || mx < lin9 || ccol < 0 || ccol >= cols ] return -1
        pin_rows : i32 [ (g_pins + cols - 1) / cols ]
        pin_end  : f32 [ f32[ pin_rows ] * gch ]
        want_pin : bool [ false ]
        grow     : i32  [ 0 ]
        if [ g_pins > 0 && my < pin_end ]
            want_pin = true
            grow = i32[ my / gch ]
        el [ my >= g_resoff ]
            want_pin = false
            grow = i32[ (my - g_resoff) / gch ]
        el
            return -1
        target : i32 [ grow * cols + ccol ]
        gi : i32 [ 0 ]
        for [ li: i32 0, li < hits.count, li += 1 ]
            h : FindHit hits[ li ]
            if [ !h || !h.is_header || !h.file || h.is_spacer ] continue
            if [ row_cont[ li ] ] continue
            is_pin : bool [ li < dock_rows ]
            if [ is_pin != want_pin ] continue
            if [ gi == target ] return li
            gi += 1
        return -1

    # true means the click was CONSUMED (a definition jump); the caller
    # must not then place a caret or arm a drag in the file we just left
    func place_cursor [ ev: Event ] -> bool
        ele   : (layers) ? cast EditorLayer [ layers['content'] ] : null
        if [ !ele ] return false
        # nothing to place the cursor on (e.g. all results removed)
        if [ line_count[] <= 0 ]
            sel_line = -1
            return false
        lh    : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
        cw    : f32 [ (cw_cache > 0.0) ? cw_cache : 8.0 ]
        rel_y : f32 [ ev.mouse.pos.y - ele.bounds.y - ((show_hits) ? 10.0 : 0.0) ]
        if [ rel_y < 0.0 ] return false
        # a pinned scope row: go to the declaration it stands in for
        pins : vec i32 pinned_rows[]
        if [ pins.count > 0 && rel_y < f32[ pins.count ] * lh ]
            pi : i32 [ rel_y / lh ]
            pr : i32 [ pins[ pi ] ]
            goto_line[ pr + 1 ]
            return true
        if [ grid_mode && show_hits && hits ]
            gli : i32 [ grid_hit_index[ ev.mouse.pos.x - ele.bounds.x, rel_y, ele.bounds.w ] ]
            if [ gli >= 0 ]
                sel_line    = gli
                anchor_line = gli
            return false
        rel_x : f32 [ ev.mouse.pos.x - ele.bounds.x - gutter_w ]
        raw   : i32 [ clamp [ rel_y / lh, 0, line_count[] - 1 ] ]
        ln    : i32 [ snap_row[ raw ] ]
        if [ show_hits && tool_hit[ ev.mouse.pos.x, ev.mouse.pos.y ] >= 0 ] return false
        if [ show_hits && (dragging || ev.key.shift) ]
            ln = clamp[ ln, group_start[ anchor_line ], group_end[ anchor_line ] ]
        # event pos is CONTENT space: scroll.x is already inside it
        vx    : f32 [ round[ (rel_x - row_indent[ ln ]) / cw ] ]
        cl    : i32 [ model_col[ line_get[ ln ], i32[ vx ] ] ]
        if [ nav && src && !dragging ]
            jd : i32 [ sel_line - ln ]
            if [ jd < 0 ] jd = 0 - jd
            if [ jd >= nav.significance_lines ]
                nav.record[ pane_index, '{src.absolute[]}', sel_line, sel_col, scroll.y ]
        sel_line = ln
        sel_col  = cl

        # cmd/ctrl click -> the definition, straight off the type record.
        # Au_t carries source/src_line now, so nothing here reads text.
        # only types LOADED in this process resolve: orbiter's own
        # sources and its imports, not an unrelated module's
        if [ ev.key.ctrl || ev.key.meta ]
            w9  : cursor_token[]
            ob9 : cast orbiter [ ux.app_object ]
            if [ ob9 && w9 && w9.count > 0 ]
                cr8 : region_at[ row_src[ ln ], cl ]
                # a module name navigates to the module itself -- that is
                # a FILE, the one thing the map cannot resolve for us
                if [ cr8 && cr8.kind == 14 ]
                    mp9 : module_path[ w9 ]
                    if [ mp9 ]
                        if [ nav && src ]
                            nav.record[ pane_index, '{src.absolute[]}', ln, cl, scroll.y ]
                        ob9.open_at_line[ mp9, pane_index, 1 ]
                        ev.no_default = true
                        return true
                # everything else the compiler already resolved: a type,
                # a silver function, or a C function out of a header
                if [ cr8 && cr8.dsrc && cr8.dline > 0 ]
                    # drop a nav point BEFORE leaving, or there is no
                    # way back from wherever the definition lives
                    if [ nav && src ]
                        nav.record[ pane_index, '{src.absolute[]}', ln, cl, scroll.y ]
                    ob9.open_at_line[ path '{cr8.dsrc}', pane_index, cr8.dline ]
                    ev.no_default = true
                    return true
            # a modifier click in here is OURS whether or not it resolved.
            # falling through hands it to the style inspector, and cmd
            # does not mean 'inspect this element' inside the editor
            ev.no_default = true
            return true
        return false

    # rail press: default is the first cell; the user navigates from there
    func press_tool [ idx: i32 ]
        orb : cast orbiter [ ux.app_object ]
        bas : i32 [ tool_base[] ]
        nm  : string [ (bas == 1 && idx == 0) ? '' : nav_tools[ idx - bas ] ]
        view_name = nm
        load_file[]
        if [ orb ] orb.exit_find_mode[]
        if [ ux ] ux.restyle = true

    func on_press [ ev: Event ]
        # the rail is first in line: nothing else may eat its press
        rail9 : i32 [ tool_hit[ ev.mouse.pos.x, ev.mouse.pos.y ] ]
        puts 'EDPRESS rv={(run_view) ? 1 : 0} av={(app_view) ? 1 : 0} rail={rail9} hits={(show_hits) ? 1 : 0}'
        if [ rail9 >= 0 ]
            press_tool[ rail9 ]
            ev.no_default = true
            return
        if [ run_view ]
            if [ app_view ]
                # the pip toggle is a button on the app bar, not a chip
                # in the corner: every press here belongs to the app
                if [ run_view.view_press*[ ev ] ]
                    if [ ux ] ux.set_focus[ a ]
                    ev.no_default = true
                    return
            el
                # SIDE-PANEL mode draws through draw_frame, so its fit
                # rect is live and the app is fully visible -- but this
                # branch only ever tested the pip, so every click on a
                # side-hosted app went nowhere. view_press bounds-checks
                # itself against fitw, so the pip case still falls past
                # double click on the small view maximises it; single
                # clicks and drags belong to the app itself
                if [ ev.mouse.double_click ]
                    if [ run_view.hit_pip[ ev.mouse.pos.x - run_view.vsx, ev.mouse.pos.y - run_view.vsy ] ]
                        toggle_app_view[]
                        ev.no_default = true
                        return
                if [ run_view.view_press*[ ev ] ]
                    if [ ux ] ux.set_focus[ a ]
                    ev.no_default = true
                    return
                if [ run_view.hit_pip[ ev.mouse.pos.x - run_view.vsx, ev.mouse.pos.y - run_view.vsy ] ]
                    toggle_app_view[]
                    if [ ux ] ux.set_focus[ a ]
                    ev.no_default = true
                    return
        sbe : (layers) ? cast EditorLayer [ layers['content'] ] : null
        sbl : ScrollLayer (layers) ? cast ScrollLayer [ layers['scrollbar'] ] : null
        sbg : f32 [ (sbl && sbl.thumb_w > 0.0) ? sbl.thumb_w * 2.0 + 8.0 : 16.0 ]
        if [ rview && sbe && sbl && sbl.scroll_max > 0.0 ]
            sbx : f32 [ ev.mouse.pos.x - sbe.bounds.x ]
            if [ sbx > sbe.bounds.w - sbg ]
                smy : f32 [ ev.mouse.pos.y - sbe.bounds.y - scroll.y ]
                sbl.grab_at[ smy ]
                ssy : f32 [ sbl.drag_to[ smy ] ]
                if [ ssy >= 0.0 ]
                    scroll.y        = ssy
                    scroll_target   = ssy
                    scroll_dragging = true
                    sbl.active      = true
                    pristine        = false
                    ux.will_animate = true
                ev.no_default = true
                return
        if [ rview && !rview.view_text*[ rview.view_sel ] ]
            if [ rview.view_press*[ ev ] ]
                ev.no_default = true
                return
        if [ debugger ]
            if [ ev.target.id == 'dbg_continue' ]
                if [ debugger.running ] debugger.pause[]
                el                      debugger.cont[]
                ev.no_default = true
                return
            if [ ev.target.id == 'dbg_step_over' ]
                debugger.step_over[]
                ev.no_default = true
                return
            if [ ev.target.id == 'dbg_step_into' ]
                debugger.step_into[]
                ev.no_default = true
                return
            if [ ev.target.id == 'dbg_step_out' ]
                debugger.step_out[]
                ev.no_default = true
                return
            # StepButtons renames itself to the pressed segment
            if [ ev.target.id == 'step_next' ]
                debugger.step_over[]
                ev.no_default = true
                return
            if [ ev.target.id == 'step_in' ]
                debugger.step_into[]
                ev.no_default = true
                return
            if [ ev.target.id == 'step_out' ]
                debugger.step_out[]
                ev.no_default = true
                return
        if [ ev.target != a ]
            return
        is_dbl : bool [ ev.mouse.double_click ]
        ele   : (layers) ? cast EditorLayer [ layers['content'] ] : null
        rel_x : f32 [ (ele) ? ev.mouse.pos.x - ele.bounds.x : 0.0 ]
        dbg_el : element (elements) ? elements['dbg'] : null
        if [ ele && dbg_el && dbg_el.bounds && rel_x > ele.bounds.w - dbg_el.bounds.w ]
            return
        if [ debug_vars ]
            lhp : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
            cwp : f32 [ (cw_cache > 0.0) ? cw_cache : 8.0 ]
            ry  : f32 [ ev.mouse.pos.y - ele.bounds.y ]
            if [ ry >= 0.0 ]
                cln : i32      [ clamp[ ry / lhp, 0, line_count[] - 1 ] ]
                rv  : variable row_var[ cln ]
                if [ rv ]
                    if [ var_expandable[ rv ] ]
                        if [ rv.expanded ] collapse_from[ rv ]
                        el                 expand_only[ rv ]
                        pristine = false
                        ux.will_animate = true
                        return
                el
                    bv : variable base_var_of[ row_src[ cln ] ]
                    if [ bv ]
                        if [ var_expandable[ bv ] ]
                            axp : f32 [ gutter_w + f32[ ann_col[ cln ] ] * cwp ]
                            if [ rel_x > axp ]
                                if [ bv.expanded ] collapse_from[ bv ]
                                el                 expand_only[ bv ]
                                pristine = false
                                ux.will_animate = true
                                return
        sb : ScrollLayer (layers) ? cast ScrollLayer [ layers['scrollbar'] ] : null
        grab : f32 [ (sb && sb.thumb_w > 0.0) ? sb.thumb_w * 2.0 + 8.0 : 16.0 ]
        if [ ele && sb && sb.scroll_max > 0.0 && rel_x > ele.bounds.w - grab ]
            my : f32 [ ev.mouse.pos.y - ele.bounds.y - scroll.y ]
            sb.grab_at[ my ]
            sy : f32 [ sb.drag_to[ my ] ]
            if [ sy >= 0.0 ]
                scroll.y        = sy
                scroll_target   = sy
                scroll_dragging = true
                sb.active       = true
                pristine        = false
                ux.will_animate = true
            return
        if [ ele && elements && elements['pins'] && rel_x > ele.bounds.w - 144.0 ]
            return
        if [ ele && rel_x < gutter_w ]
            lh    : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
            rel_y : f32 [ ev.mouse.pos.y - ele.bounds.y - ((show_hits) ? 10.0 : 0.0) ]
            if [ rel_y < 0.0 ] return
            vrl   : i32 [ clamp [ rel_y / lh, 0, line_count[] - 1 ] ]
            if [ row_header[ vrl ] ]
                # nav rows pin by shift-click, never by gutter press
                if [ nav_list ] return
                if [ show_hits && hits ]
                    remove_group[ vrl ]
