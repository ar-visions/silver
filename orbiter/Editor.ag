    public  dir_size      : i32
    public  find_query    : string
    public  show_nav      : bool
    public  editor_mode   : string
    public  src           : path
    # commit hash this view diffs against; read-only stacked diff
    public  diff_commit   : string
    mutable loaded_diff   : string
    # the file's git hunks against HEAD, as (first row, rows, kind)
    # triples: kind 1 added, 2 changed, 3 removed (rows 0; the mark sits
    # above the row). hunk_sig says what they were computed for;
    # rail_hover1 = index + 1 of the rail beside the scrollbar under the
    # pointer. git_on: the git view (picking a reference) is open;
    # the comparison with HEAD (tints, rails, ghost rows) is always on
    public  git_on        : bool
    mutable hunks         : vec i32
    mutable hunk_sig      : string
    mutable rail_hover1   : i32
    # the hovered rail's preview: the pointer's y in the view, its
    # title (where it starts, and the old line's blame), and a removed
    # run's old lines
    mutable peek_y        : f32
    mutable peek_title    : string
    mutable peek_old      : vec string
    # each hunk's old side (first old line 1-based, old rows), the
    # checkout and path the hunks were taken from: a removed run's text
    # comes from
    # HEAD's file by these
    mutable hunk_old      : vec i32
    mutable hunk_root     : path
    mutable hunk_rel      : string
    mutable hunk_ref      : string
    # a removed run shown in place as ghost rows: the hunk, the file row
    # the rows sit before, and their text
    mutable ghost_hunk    : i32 [ -1 ]
    mutable ghost_at      : i32
    mutable ghost_lines   : vec string
    # per-row diff kind: 0 context, 1 removed, 2 added
    mutable diff_kinds    : vec i32
    # display row -> real file line; -1 on removed rows (base only)
    mutable diff_src      : vec i32
    # glyphs render here, then blit with an edge ramp; fills bypass it
    mutable text_canvas   : Canvas
    mutable reg_scratch   : ColorRegion   # line_reg's one return slot
    # ctrl/cmd+k in a row without moving: the lines collect in one clip
    intern kill_chain    : bool
    intern kill_row      : i32
    intern kill_text     : string
    # commit's file lines, cached for live re-diff while editing
    mutable diff_base     : vec string
    mutable diff_dirty    : bool
    mutable diff_edit_ms  : i64
    mutable loaded_src    : path
    mutable nav           : Navigate
    mutable pane_index    : i32 [ 0 ]
    mutable rview         : ResourceView
    # the user's chosen view for this file; '' = default (first cell)
    mutable view_name     : string
    mutable view_hist     : vec string
    mutable view_ix       : i32 [ -1 ]
    # '<view>|<file>' currently mounted; the only staleness check
    mutable mounted       : string
    mutable nav_tools     : vec string
    mutable nav_default   : string
    mutable tool_hover    : i32 [ -1 ]
    # the view picker under the title's chip: open, and the cell under
    # the mouse
    mutable view_thumbs   : map Canvas[string]
    # the selected instance: shown and debugged
    mutable run_view      : AppView
    mutable app_view      : bool
    # the dock asked for the app: blank, no code, until it shows
    mutable wait_app      : bool
    mutable session_view  : string
    mutable saved_scroll  : f32
    intern static view_registry : map Au_t[string]
    intern static view_by_name  : map Au_t[string]
    intern static export_registry : map string[string]
    # ext -> the FileType its owning module exported
    # (ascii/binary/agnostic)
    intern static export_ftype    : map string[string]
    # ext -> the <owner>-<module> export stem, which names its lib
    intern static export_lib      : map string[string]
    # scheme (https) -> the module that exported it
    intern static export_protocol : map string[string]
    intern static bin_view_cached : string
    mutable lines         : list string
    mutable close_icon    : SVGModel
    mutable pin_icon      : SVGModel
    mutable file_icon     : SVGModel
    mutable module_icon   : SVGModel
    mutable folder_icon   : SVGModel
    mutable ficons        : FileIcons
    mutable was_showing   : bool
    # ctrl/cmd is held: resolvable symbols outline as clickable targets
    mutable mod_down      : bool
    mutable shift_down    : bool
    mutable hover_gutter  : bool
    # the gutter pointer within a removal edge's band (a quarter line
    # above and below the edge): it lights, and a press there reveals
    # the run
    mutable hover_edge    : bool
    # true while dragging the scrollbar thumb
    mutable scroll_dragging : bool
    mutable sel_line      : i32 [ -1 ]
    mutable sel_col       : i32 [ 0 ]
    mutable tab_w         : i32 [ 4 ]
    # currently expanded variables, outermost first
    mutable open_chain    : vec Au
    # the file line whose [+] opened the tree; one line, not every line
    # naming the variable
    mutable open_src      : i32 [ -1 ]
    mutable fmt_mtime     : i64 [ 0 ]
    # the last coverage run's hits per file line, -1 where none
    mutable cov_hits      : vec i64
    mutable cov_stamp     : i64 [ -1 ]
    mutable cov_src       : string
    mutable disk_ms       : i64 [ 0 ]
    mutable scroll_target : f32 [ 0.0 ]
    mutable pending_wheel : f32 [ 0.0 ]
    mutable hx_last_y     : f32 [ 0.0 ]
    mutable text_lines_frame : i32 [ 0 ]
    mutable text_lines_total : i64 [ 0 ]
    mutable code_lines    : vec EdLineCache
    mutable cl_frame      : i32 [ 0 ]
    mutable cl_cw         : f32 [ 0.0 ]
    mutable cl_lh         : f32 [ 0.0 ]

    mutable cur_buf       : FileBuf
    mutable hist          : list EditAction
    mutable hist_i        : i32 [ 0 ]
    mutable cur_group     : EditAction
    mutable pend_sl0      : i32 [ 0 ]
    mutable pend_sc0      : i32 [ 0 ]
    mutable edit_kind     : i32 [ -1 ]
    mutable edit_cl       : i32 [ -1 ]
    mutable edit_cc       : i32 [ -1 ]
    mutable stop_line     : i32 [ -1 ]
    # where the stopped line sits on screen, px from the top
    mutable stop_y        : f32 [ -1.0 ]
    mutable stop_col      : i32 [ -1 ]
    # a debugger stop line waiting for its file to load
    mutable stop_pending  : i32
    # a navigation's 1-based line waiting for its file to load
    mutable goto_pending  : i32
    # the user's own presses and keys here, counted
    mutable caret_touch   : i64
    # a navigation opened this file: its arrival is a nav point
    mutable arrive_pending : bool
    mutable stop_pending_col : i32
    public  debug_running : bool
    public  debugger      : dbg
    public  debug_vars    : vec Au
    mutable flat_rows     : vec VRow
    mutable flat_active   : bool
    # rows are the indent-0 lines alone
    mutable outline       : bool
    mutable outline_from_y    : f32
    mutable outline_from_line : i32
    mutable outline_from_col  : i32
    mutable flat_vars     : vec Au
    mutable flat_lines    : i32 [ -1 ]
    mutable flat_open     : i32 [ -1 ]
    mutable flat_ghost    : i32 [ -1 ]
    mutable hover_ann     : i32 [ -1 ]
    mutable lh_cache      : f32 [ 0.0 ]
    mutable cw_cache      : f32 [ 0.0 ]
    mutable anchor_line   : i32 [ 0 ]
    mutable dragging      : bool
    mutable cursor_idx    : i32 [ -1 ]
    mutable last_sel_line : -1
    mutable last_sel_col  : -1
    mutable last_before   : false
    mutable filter_rect   : rect
    mutable filter_next   : false
    mutable last_scroll_y : f32
    mutable last_scroll_x : f32
    mutable last_view_w   : f32
    mutable hover_line    : i32 [ -1 ]
    mutable gutter_w      : f32 [ 0.0 ]
    public  breakpoints   : map string[string]
    public  code_font_size : i32
    mutable dbg_open      : bool
    public  band_rows     : i32
    public  replacing     : bool
    # append LAST: member order sets AF bit indices
    # pinned band row under the mouse, -1 outside it
    mutable hover_pin     : i32 [ -1 ]
    mutable hover_err     : bool

    func bp_color [ cond: string ] -> rgba
        # conditional
        if [ cond && cond.count > 0 ] return rgba['#3b82f638']
        return rgba['#e5394538']                                 # plain

    # does this line declare v — 'name' followed by ':'
    func line_declares [ ltext: string, bli: i32, v: variable ] -> bool
        if [ !v || !v.name || v.name.count == 0 ] return false
        nm  : string v.name
        pos : i32 [ ltext.index_of[ nm ] ]
        if [ pos < 0 ] return false
        if [ pos > 0 ]
            pc : i32 [ ltext[ pos - 1 ] ]
            if [ (pc >= 97 && pc <= 122) || (pc >= 65 && pc <= 90) || (pc >= 48 && pc <= 57) || pc == 95 ]
                return false
        j : i32 [ pos + nm.count ]
        while [ j < ltext.count && (ltext[j] == 32 || ltext[j] == 9) ]
            j += 1
        if [ j >= ltext.count || ltext[j] != 58 ] return false
        if [ stop_line >= 0 && bli == stop_line && stop_col >= 0 && stop_col <= pos ]
            return false
        return true

    # the variable a line declares: a local or arg, else a member of
    # self. member lines carry their own value rather than making you
    # expand 'a'
    func base_var_of [ bli: i32 ] -> variable
        if [ !debug_vars || bli < 0 || bli >= lines.count ] return null
        if [ stop_line >= 0 && bli > stop_line ] return null
        line : string lines.value_by_index[ bli ]
        if [ !line || line.count == 0 ] return null
        for [ k: i32 0, k < debug_vars.count, k += 1 ]
            v : variable debug_vars[k]
            if [ line_declares[ line, bli, v ] ] return v
        for [ k: i32 0, k < debug_vars.count, k += 1 ]
            sv : variable debug_vars[k]
            # count first: an empty string's chars are null, and compare
            # goes straight to strcmp
            if [ !sv || !sv.name || sv.name.count != 1 ] continue
            # 'a' — self
            if [ sv.name[0] != 97 ] continue
            if [ !sv.children ] continue
            for [ ci: i32 0, ci < sv.children.count, ci += 1 ]
                cv9 : variable sv.children[ci]
                if [ line_declares[ line, bli, cv9 ] ] return cv9
        return null

    # the name a source line declares: a function's after `func`, a
    # type's after its base at the top level (`NodeList Callstack`). ''
    # otherwise
    func decl_name [ bli: i32 ] -> string
        if [ bli < 0 || bli >= lines.count ] return ''
        text : string lines.value_by_index[ bli ]
        if [ !text || text.count == 0 ] return ''
        top  : bool [ text[0] != 32 && text[0] != 9 ]
        ws   : vec string []
        for [ w: string ] in text.split[ ' ' ]
            if [ w && w.count > 0 ] ws.push[ w ]
        i : i32 [ 0 ]
        while [
            i < ws.count
            && (ws[i] == 'public' || ws[i] == 'intern' || ws[i] == 'mutable' ||
            ws[i] == 'static' || ws[i] == 'expect' || ws[i] == 'export'
            || ws[i] == 'abstract' ||
                ws[i] == 'manual' || ws[i] == 'context') ]
            i += 1
        if [ i >= ws.count ] return ''
        if [ ws[i] == 'func' || ws[i] == 'lambda' ]
            if [ i + 1 >= ws.count ] return ''
            fn : string ws[ i + 1 ]
            b  : i32 [ fn.index_of[ '[' ] ]
            return (b > 0) ? fn.mid[ 0, b ] : fn
        if [ ws[i] == 'construct' || ws[i] == 'cast' ] return ws[i]
        if [
            top && i == 0 && ws.count >= 2 && ws[0] != 'import'
            && ws[0] != 'extend' && ws[0] != 'app' ]
            return ws[1]
        return ''

    # where a row sits: its enclosing type and function, outermost first
    func scope_of [ vr: i32 ] -> string
        line_tree[]
        if [ !cur_buf || !cur_buf.line_parent ] return ''
        tree : vec i32 cur_buf.line_parent
        sr   : i32 [ row_src[ vr ] ]
        if [ sr < 0 || sr >= tree.count ] return ''
        names : vec string []
        for [ p: i32 [ sr ], p >= 0, p = i32[ tree[ p ] ] ]
            nm : string decl_name[ p ]
            if [ nm && nm.count > 0 ] names.push[ nm ]
        out : string ''
        for [ i: i32 names.count - 1, i >= 0, i -= 1 ]
            out = (out.count > 0) ? '{out}.{names[i]}' : names[i]
        return out

    # the tooltip in the status bar's lower left: where the caret sits,
    # and at a debugger stop the clicked name's type and value
    func tip_text [ stopped: bool ] -> string
        if [ hover_err && shift_down ] return 'shift-click to copy'
        if [ sel_line < 0 || show_hits || nav_list ] return ''
        sc  : string scope_of[ sel_line ]
        tok : string cursor_token[]
        v   : variable (stopped && tok.count > 0) ? var_named[
            tok ] : null
        what : string (v) ? ((v.type && v.type.count > 0) ? '{v.name}: {v.type} = {v.value}' : '{v.name} = {v.value}') : tok
        if [ sc.count > 0 && what.count > 0 ] return '{sc}  {what}'
        return (sc.count > 0) ? sc : what

    # the variable a clicked name stands for at the stop: a local or
    # arg, else a member of self
    func var_named [ nm: string ] -> variable
        if [ !debug_vars || !nm || nm.count == 0 ] return null
        for [ k: i32 0, k < debug_vars.count, k += 1 ]
            v : variable debug_vars[k]
            if [ v && v.name && v.name.count == nm.count && v.name == nm ]
                return v
        for [ k: i32 0, k < debug_vars.count, k += 1 ]
            sv : variable debug_vars[k]
            if [ !sv || !sv.name || sv.name.count != 1 || sv.name[0] != 97 ]
                continue
            # self's members are read from lldb only on demand: read
            # them now
            if [
                sv.has_kids
                && (!sv.children || sv.children.count == 0) ]
                d9 : dbg active_dbg[]
                if [ d9 ] sv.children = d9.read_children[ sv.path ]
            if [ !sv.children ] continue
            for [ ci: i32 0, ci < sv.children.count, ci += 1 ]
                cv9 : variable sv.children[ci]
                if [ cv9 && cv9.name && cv9.name.count == nm.count && cv9.name == nm ]
                    return cv9
        return null

    # one expansion open at a time, unless it nests inside the open one.
    # the chain is outermost-first; esc collapses the innermost
    func expand_only [ v9: variable ]
        if [ !v9 ] return
        # children are read from lldb only now, on the click
        if [ v9.has_kids && (!v9.children || v9.children.count == 0) ]
            d9 : dbg active_dbg[]
            if [ d9 ] v9.children = d9.read_children[ v9.path ]
        log 'expand {v9.path} kids={v9.has_kids} children={(v9.children) ? v9.children.count : 0}'
        if [ !open_chain ] open_chain = vec Au []
        # the chain stays open down to the ancestor that owns the
        # clicked row; only what hangs below that ancestor closes (a
        # sibling swaps in)
        keep : i32 [ -1 ]
        for [ i9: i32 0, i9 < open_chain.count, i9 += 1 ]
            ov : variable open_chain[i9]
            if [ !ov || !ov.children ] continue
            for [ ci: i32 0, ci < ov.children.count, ci += 1 ]
                if [ ov.children[ci] == v9 ] keep = i9
        for [ i9: i32 open_chain.count - 1, i9 > keep, i9 -= 1 ]
            ov : variable open_chain[i9]
            if [ ov ] ov.expanded = false
            open_chain.remove[ i9 ]
        v9.expanded = true
        open_chain.push[ v9 ]

    func collapse_last [] -> bool
        if [ !open_chain || open_chain.count == 0 ] return false
        lv : variable open_chain[ open_chain.count - 1 ]
        if [ lv ] lv.expanded = false
        open_chain.remove[ open_chain.count - 1 ]
        return true

    # collapse v and anything the chain opened under it
    func collapse_from [ v9: variable ]
        if [ !open_chain ] return
        for [ i9: i32 0, i9 < open_chain.count, i9 += 1 ]
            if [ open_chain[i9] == v9 ]
                while [ open_chain.count > i9 ]
                    ov : variable open_chain[ open_chain.count - 1 ]
                    if [ ov ] ov.expanded = false
                    open_chain.remove[ open_chain.count - 1 ]
                return
        v9.expanded = false

    # the line AS DRAWN: a debug annotation takes the comment's place,
    # so the comment is never rendered. hash, measure and draw must all
    # use this
    func draw_line [ vr: i32 ] -> string
        s : string line_get[ vr ]
        if [ !debug_vars || !s || s.count == 0 ] return s
        if [ !base_var_of[ row_src[ vr ] ] ] return s
        return code_only[ s ]

    # cell column where a row's annotation starts: first tab stop past
    # the code, with any existing comment excluded
    func ann_col [ vr: i32 ] -> i32
        s : string display_of[ code_only[ line_get[ vr ] ] ]
        return (s.count / tab_w + 1) * tab_w

    func var_summary [ v: variable ] -> string
        if [ !v ] return ''
        nm : string v.name
        if [ v.children && v.children.count > 0 ]
            sum : string [ '' ]
            n   : i32 [ (v.children.count < 2) ? v.children.count : 2 ]
            for [ ci: i32 0, ci < n, ci += 1 ]
                c    : variable v.children[ci]
                part : '{c.name}: {c.value}'
                sum = (ci > 0) ? sum + ', ' + part : part
            if [ v.children.count > 2 ] sum = sum + ', ...'
            return nm + ' = (' + sum + ')'
        return '{nm} = {v.value}'

    # has fields → expandable.
    func var_expandable [ v: variable ] -> bool
        return v && (v.has_kids || (v.children && v.children.count > 0))

    func splice_var [ v: variable, depth: i32 ]
        if [ !v || !v.expanded || !v.children ] return
        for [ ci: i32 0, ci < v.children.count, ci += 1 ]
            c : variable v.children[ci]
            flat_rows.push[ VRow [ src: -1, var: c, depth: depth ] ]
            splice_var[ c, depth + 1 ]

    # the walk matches every variable against every line: only when
    # something changed
    func rebuild_flat []
        if [ flat_rows && debug_vars == flat_vars && lines.count == flat_lines && open_src == flat_open && ghost_hunk == flat_ghost ]
            return
        flat_vars  = debug_vars
        flat_lines = lines.count
        flat_open  = open_src
        flat_ghost = ghost_hunk
        flat_rows = vec VRow []
        flat_active = false
        if [ !debug_vars && ghost_hunk < 0 && !outline ] return
        if [ outline ] line_tree[]
        base : i32 [ lines.count ]
        for [ bli: i32 0, bli <= base, bli += 1 ]
            # the ghost rows sit before the row their run was removed
            # above
            if [
                !outline && ghost_hunk >= 0 && ghost_lines
                && bli == ghost_at ]
                for [ gs: string ] in ghost_lines
                    flat_rows.push[ VRow [ src: -1, text: gs ] ]
            if [ bli == base ] break
            if [ outline && !outline_line[ bli ] ] continue
            flat_rows.push[ VRow [ src: bli ] ]
            if [ debug_vars ]
                bv9 : variable base_var_of[ bli ]
                if [ bv9 && bli == open_src ]
                    splice_var[ bv9, 1 ]
        flat_active = outline || flat_rows.count > base

    # a non-blank line with no parent: indentation alone, any language
    func outline_line [ i: i32 ] -> bool
        tree : vec i32 (cur_buf) ? cur_buf.line_parent : null
        if [ !tree || i < 0 || i >= tree.count || i >= lines.count ]
            return false
        if [ i32[ tree[ i ] ] >= 0 ] return false
        ln : string lines.value_by_index[ i ]
        for [ c: i32 0, ln && c < ln.count, c += 1 ]
            if [ ln[c] == 32 || ln[c] == 9 ] continue
            # a comment line is no row: it opens with '#' or '//'
            if [ ln[c] == 35 ] return false
            if [ ln[c] == 47 && c + 1 < ln.count && ln[c + 1] == 47 ]
                return false
            return true
        return false

    # outline on or off: view row vrl keeps its place on screen
    func outline_toggle [ vrl: i32 ]
        lh  : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
        osl : i32 [ row_src[ vrl ] ]
        ocl : i32 [ row_src[ sel_line ] ]
        # entering: where the view and caret were, for escape to return
        # to
        if [ !outline ]
            outline_from_y    = scroll.y
            outline_from_line = ocl
            outline_from_col  = sel_col
        outline    = !outline
        flat_lines = -1
        rebuild_flat[]
        scroll.y += f32[ vis_row[ osl ] - vrl ] * lh
        if [ scroll.y < 0.0 ] scroll.y = 0.0
        scroll_target = scroll.y
        scroll_goal   = scroll.y
        scroll_anim   = false
        # leaving puts the caret at the end of the pressed line
        sel_line = vis_row[ (outline && ocl >= 0) ? ocl : osl ]
        if [ !outline ] sel_col = line_get[ sel_line ].count
        anchor_line = sel_line
        anchor_col  = sel_col
        hover_line  = -1
        pristine    = false
        ux.will_animate = true

    # leave the outline for the scroll and caret it was entered from
    func outline_cancel []
        outline    = false
        flat_lines = -1
        rebuild_flat[]
        scroll.y      = outline_from_y
        scroll_target = scroll.y
        scroll_goal   = scroll.y
        scroll_anim   = false
        sel_line    = vis_row[
            (outline_from_line >= 0) ? outline_from_line : 0 ]
        sel_col     = outline_from_col
        anchor_line = sel_line
        anchor_col  = sel_col
        hover_line  = -1
        pristine    = false
        ux.will_animate = true

    # flat-row accessors (identity when no tree is open).
    # a diff's rows are base+current merged: map back to the real file
    # line. finder rows are not the file's rows at all — identity there
    func row_src [ vr: i32 ] -> i32
        if [
            diff_src && !show_hits && !finder_list && vr >= 0
            && vr < diff_src.count ]
            return diff_src[ vr ]
        if [ !flat_active || !flat_rows || vr < 0 || vr >= flat_rows.count ]
            return vr
        r : VRow flat_rows[ vr ]
        return r.src

    # the view row a variable's own row sits on, or -1 when it is not
    # shown
    func var_row [ v: variable ] -> i32
        if [ !flat_active || !flat_rows || !v ] return -1
        for [ vr: i32 0, vr < flat_rows.count, vr += 1 ]
            r : VRow flat_rows[ vr ]
            if [ r.var == v ] return vr
        return -1

    func row_var [ vr: i32 ] -> variable
        if [ !flat_active || !flat_rows || vr < 0 || vr >= flat_rows.count ]
            return null
        r : VRow flat_rows[ vr ]
        return r.var

    # the virtual rows are ghost rows alone (no debug variables): the
    # file stays editable around them, they are only information
    func ghost_only [] -> bool
        return flat_active && ghost_hunk >= 0 && !debug_vars && !outline

    # a view row's source row while ghost rows are open: a ghost row
    # maps to the file row it sits before; past the end maps past the
    # end
    func src_row [ vr: i32 ] -> i32
        if [ !ghost_only[] || !flat_rows ] return vr
        if [ vr >= 0 && vr < flat_rows.count ]
            r : VRow flat_rows[ vr ]
            return (r.src >= 0) ? r.src : ghost_at
        return (lines) ? lines.count : 0

    # a ghost row: a removed line shown in place, no file line behind it
    func row_ghost [ vr: i32 ] -> bool
        if [ !flat_active || !flat_rows || vr < 0 || vr >= flat_rows.count ]
            return false
        r : VRow flat_rows[ vr ]
        return r.src < 0 && !r.var

    func row_depth [ vr: i32 ] -> i32
        if [ !flat_active || !flat_rows || vr < 0 || vr >= flat_rows.count ]
            return 0
        r : VRow flat_rows[ vr ]
        return r.depth

    func row_indent [ vr: i32 ] -> f32
        if [ row_var[ vr ] ] return 12.0 + f32[ row_depth[ vr ] ] * 16.0
        return 0.0

    func vis_row [ bli: i32 ] -> i32
        if [ bli < 0 ] return bli
        if [ !flat_active || !flat_rows ] return bli
        # a line the outline hides reads as the header row above it
        best : i32 [ (outline) ? 0 : bli ]
        for [ vr: i32 0, vr < flat_rows.count, vr += 1 ]
            r : VRow flat_rows[ vr ]
            if [ r.src == bli ] return vr
            if [ outline && r.src >= 0 && r.src < bli ] best = vr
        return best

    func line_count [] -> i32
        if [ show_hits && hits ] return hits.count
        if [ flat_active && flat_rows ] return flat_rows.count
        # a pane mid-transition can be asked before lines exist
        return (lines) ? lines.count : 0

    func row_header [ i: i32 ] -> bool
        if [ show_hits && hits && i >= 0 && i < hits.count ]
            return hits[i].is_header
        return false

    func row_cont [ i: i32 ] -> bool
        if [ show_hits && hits && i >= 0 && i < hits.count ]
            return hits[i].is_header && hits[i].text.count == 0 &&
                !hits[i].is_spacer
        return false

    func row_spacer [ i: i32 ] -> bool
        if [ show_hits && hits && i >= 0 && i < hits.count ]
            return hits[i].is_spacer
        return false

    # default-action cell count: 1 when the extension has a handler
    func tool_base [] -> i32
        return (nav_default && nav_default.count > 0) ? 1 : 0

    # left tool rail: cell index under the mouse, -1 off
    # where rail chip ti sits in a rail h tall: a file's views stack
    # down from the top; the project's consoles are not file views and
    # stack up from the bottom, in their own group
    func tool_y [ ti: i32, h: f32 ] -> f32
        n    : i32 [
            tool_base[] + ((nav_tools) ? i32[ nav_tools.count ] : 0) ]
        # a detached editor (nav list open) has no window
        oa  : Au (ux) ? ux.app_object : null
        orbt : cast orbiter [ oa ]
        nc   : i32 [ 0 ]
        if [ orbt && nav_tools ]
            for [ k: i32 i32[ nav_tools.count ] - 1, k >= 0, k -= 1 ]
                nm : string nav_tools[ k ]
                if [ !orbt.console_of[ nm ] ] break
                nc += 1
        if [ ti >= n - nc ]
            from_end : i32 [ n - 1 - ti ]
            return h - 4.0 - 64.0 - f32[ from_end ] * 68.0
        return 4.0 + f32[ ti ] * 68.0

    func tool_hit [ mx: f32, my: f32 ] -> i32
        if [ !nav_tools || nav_tools.count == 0 ] return -1
        ele : (layers) ? cast EditorLayer [ layers['content'] ] : null
        if [ !ele || !ele.bounds ] return -1
        rx : f32 [ mx - ele.bounds.x ]
        ry : f32 [ my - ele.bounds.y ]
        if [ rx < 0.0 || rx > 64.0 ] return -1
        n : i32 [ tool_base[] + i32[ nav_tools.count ] ]
        for [ ti: i32 0, ti < n, ti += 1 ]
            y : f32 [ tool_y[ ti, ele.bounds.h ] ]
            if [ ry >= y && ry < y + 64.0 ] return ti
        return -1

    func word_char [ c: i32 ] -> bool
        return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) ||
            (c >= 97 && c <= 122) || c == 95

    # cmd/ctrl click: go to what the token at row ln, column cl resolves
    # to. the caret already sits there (cursor_token reads it). true
    # when it went
    func jump_to_def [ ln: i32, cl: i32 ] -> bool
        w9  : cursor_token[]
        ob : cast orbiter [ ux.app_object ]
        if [ !ob || !w9 || w9.count == 0 ] return false
        cr : region_at[ row_src[ ln ], cl ]
        # a module name navigates to the module itself -- that is
        # a FILE, the one thing the map cannot resolve for us
        if [ cr && cr.kind == 14 ]
            mp9 : module_path[ w9 ]
            if [ mp9 ]
                if [ nav && src ]
                    nav.record[ pane_index, '{src.absolute[]}', ln, cl,
                                scroll.y ]
                ob.open_at_line[ mp9, pane_index, 1 ]
                return true
        # everything else the compiler already resolved: a type,
        # a silver function, or a C function out of a header
        if [ cr && cr.dsrc && cr.dline > 0 ]
            # drop a nav point BEFORE leaving, or there is no
            # way back from wherever the definition lives
            if [ nav && src ]
                nav.record[ pane_index, '{src.absolute[]}', ln, cl,
                            scroll.y ]
            ob.open_at_line[ path '{cr.dsrc}', pane_index, cr.dline ]
            return true
        return false

    func cursor_token [] -> string
        if [ sel_line < 0 || sel_line >= line_count[] ] return ''
        if [ row_header[ sel_line ] ] return ''
        ln : line_get[ sel_line ]
        n  : i32 [ ln.count ]
        if [ n == 0 ] return ''
        s  : i32 [ clamp[ sel_col, 0, n ] ]
        if [ s >= n || !word_char[ i32[ ln[s] ] ] ] s = s - 1
        if [ s < 0 || !word_char[ i32[ ln[s] ] ] ] return ''
        a : i32 [ s ]
        while [ a > 0 && word_char[ i32[ ln[a - 1] ] ] ] a -= 1
        b : i32 [ s ]
        while [ b < n - 1 && word_char[ i32[ ln[b + 1] ] ] ] b += 1
        return ln.mid[ a, b - a + 1 ]

    # the modifier is only known from events we actually receive, and a
    # key RELEASE may never reach us (focus, or consumed upstream).
    # mouse moves carry live modifier state and keep arriving, so the
    # flag corrects itself instead of sticking on
    func note_mod [ ev: Event ]
        md9 : bool [ ev.key.ctrl || ev.key.meta ]
        # GLFW reports mods as they stood BEFORE the event, so pressing
        # ctrl/cmd itself arrives with its own bit still clear. take the
        # keycode's own state for those, or the outline waits for the
        # next event that happens to carry the flag
        k9 : i32 [ ev.key.unicode ]
        if [ k9 == 341 || k9 == 345 || k9 == 343 || k9 == 347 ]
            md9 = ev.key.state != 0
        # shift held: a gutter press takes the outline
        sd : bool [ ev.key.shift ]
        if [ k9 == 340 || k9 == 344 ] sd = ev.key.state != 0
        if [ md9 == mod_down && sd == shift_down ] return
        mod_down   = md9
        shift_down = sd
        pristine = false
        if [ ux ] ux.will_animate = true
        # the error band's tooltip turns with shift
        if [ ux && hover_err ] ux.restyle = true

    # the region under a column, or null. regions come straight from the
    # format map, so this carries the compiler's own classification AND
    # the declaration site it resolved to
    func region_at [ ml: i32, col: i32 ] -> ColorRegion
        n9 : i32 [ line_reg_count[ ml ] ]
        for [ ri: i32 0, ri < n9, ri += 1 ]
            cr : ColorRegion line_reg[ ml, ri ]
            if [ col >= cr.col && col < cr.col + cr.len ] return cr
        return null

    # a module's own source: a sibling of the file that imports it, or
    # its root module directory. nothing else knows where a module lives
    func module_path [ nm: string ] -> path
        if [ !nm || nm.count == 0 ] return null
        if [ src ]
            sib : path '{src.directory[]}/{nm}.ag'
            if [ sib.exists[] ] return sib
        sp : path.path_startup[]
        if [ sp ]
            fp : path '{sp}/{nm}/{nm}.ag'
            if [ fp.exists[] ] return fp
        return null


    func select_word []
        if [ sel_line < 0 || sel_line >= line_count[] ] return
        if [ row_header[ sel_line ] ] return
        ln : line_get[ sel_line ]
        n  : i32 [ ln.count ]
        if [ n == 0 ] return
        s  : i32 [ clamp[ sel_col, 0, n ] ]
        if [ s >= n || !word_char[ i32[ ln[s] ] ] ] s = s - 1
        if [ s < 0 || !word_char[ i32[ ln[s] ] ] ] return
        a : i32 [ s ]
        while [ a > 0 && word_char[ i32[ ln[a - 1] ] ] ] a -= 1
        b : i32 [ s ]
        while [ b < n - 1 && word_char[ i32[ ln[b + 1] ] ] ] b += 1
        anchor_line = sel_line
        anchor_col  = a
        sel_col     = b + 1

    func snap_row [ ln: i32 ] -> i32
        n : i32 [ line_count[] ]
        if [ n <= 0 ] return 0
        r : i32 [ clamp[ ln, 0, n - 1 ] ]
        if [ !row_header[ r ] ] return r
        for [ i: i32 r, i < n, i += 1 ]
            if [ !row_header[ i ] ] return i
        for [ i: i32 r, i >= 0, i -= 1 ]
            if [ !row_header[ i ] ] return i
        return r

    func prev_editable [ ln: i32 ] -> i32
        r : i32 [ ln ]
        while [ r >= 0 && row_header[ r ] ] r -= 1
        return r

    func next_editable [ ln: i32 ] -> i32
        r : i32 [ ln ]
        n : i32 [ line_count[] ]
        while [ r < n && row_header[ r ] ] r += 1
        return r

    # arrows drive the list highlight exactly as the mouse does
    # false when it ran off the end — the caller decides where focus
    # goes
    func hover_step [ d: i32 ] -> bool
        n : i32 [ line_count[] ]
        r : i32 [ hover_line ]
        while [ true ]
            r += d
            if [ r < 0 || r >= n ] return false
            if [ row_spacer[ r ] ] continue
            if [ row_cont[ r ] ] continue
            break
        hover_line = r
        lh : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
        top : f32 [ f32[ r ] * lh ]
        vh9 : f32 [ (bounds) ? bounds.h : 600.0 ]
        if [ top < scroll_target ] scroll_target = top
        el [ top + lh > scroll_target + vh9 ]
            scroll_target = top + lh - vh9
        pristine = false
        if [ ux ] ux.will_animate = true

    func group_start [ ln: i32 ] -> i32
        r : i32 [ ln ]
        while [ r > 0 && !row_header[ r - 1 ] ] r -= 1
        return r

    func group_end [ ln: i32 ] -> i32
        r : i32 [ ln ]
        n : i32 [ line_count[] ]
        while [ r < n - 1 && !row_header[ r + 1 ] ] r += 1
        return r

    func remove_hit [ idx: i32 ]
        if [ !hits || idx < 0 || idx >= hits.count ] return
        if [ row_header[ idx ] ] return
        gs   : i32  [ group_start[ idx ] ]
        only : bool [ gs == group_end[ idx ] ]
        hits.remove[ idx ]
        if [ only && gs >= 2 ]
            hits.remove[ gs - 1 ]
            hits.remove[ gs - 2 ]

    func remove_group [ idx: i32 ]
        if [ !hits || idx < 0 || idx >= hits.count || !row_header[ idx ] ]
            return
        hs : i32 [ idx ]
        # first header slot
        while [ hs > 0 && row_header[ hs - 1 ] ] hs -= 1
        n  : i32 [ line_count[] ]
        he : i32 [ hs ]
        # past the header slots
        while [ he < n && row_header[ he ] ] he += 1
        # past the match rows
        while [ he < n && !row_header[ he ] ] he += 1
        # remove back-to-front so lower indices don't shift under us
        for [ i: i32 he - 1, i >= hs, i -= 1 ]
            hits.remove[ i ]


    func vis_col [ s: string, c: i32 ] -> i32
        v : i32 [ 0 ]
        for [ i: i32 0, i < c && i < s.count, i += 1 ]
            if [ s[i] == 9 ] v = (v / tab_w + 1) * tab_w
            el               v += 1
        return v

    func model_col [ s: string, vx: i32 ] -> i32
        v : i32 [ 0 ]
        for [ i: i32 0, i < s.count, i += 1 ]
            adv : i32 [
                (s[i] == 9) ? ((v / tab_w + 1) * tab_w - v) : 1 ]
            if [ vx < v + (adv + 1) / 2 ] return i
            v += adv
        return s.count

    # the code before a trailing '#' comment, with the gap trimmed. a
    # debug annotation replaces the comment on that line rather than
    # colliding
    func code_only [ s: string ] -> string
        if [ !s ] return s
        for [ i: i32 0, i < s.count, i += 1 ]
            if [ s[i] == 35 ]
                e : i32 [ i ]
                while [ e > 0 && (s[e - 1] == 32 || s[e - 1] == 9) ]
                    e -= 1
                return s.mid[ 0, e ]
        return s

    func display_of [ s: string ] -> string
        ht : bool [ false ]
        for [ i: i32 0, i < s.count, i += 1 ]
            if [ s[i] == 9 ]
                ht = true
                break
        if [ !ht ] return s
        out : string [ '' ]
        v   : i32 [ 0 ]
        for [ i: i32 0, i < s.count, i += 1 ]
            if [ s[i] == 9 ]
                sp : i32 [ (v / tab_w + 1) * tab_w - v ]
                for [ k: i32 0, k < sp, k += 1 ]
                    out = out + ' '
                v += sp
            el
                out = out + s.mid[ i, 1 ]
                v += 1
        return out


    func fmt_theme [ kind: i32 ] -> rgba
        switch [ kind ]
            case 1                          # keyword
                return rgba['#569cd6']
            case 2, 14                      # type, namespace
                return rgba['#4ec9b0']
            case 4                          # function
                return rgba['#dcdcaa']
            case 5, 6                       # param, property
                return rgba['#9cdcfe']
            case 7                          # number
                return rgba['#b5cea8']
            case 8, 9                       # string, character
                return rgba['#ce9178']
            case 10                         # boolean
                return rgba['#569cd6']
            case 11                         # comment
                return rgba['#6a9955']
            case 13                         # punctuation
                return rgba['#808080']
            case 15                         # constant
                return rgba['#4fc1ff']
            case 16                         # usertoken
                return rgba['#c586c0']
            # parent class (Parent Child) — yellow
            case 17
                return rgba['#d7ba7d']
            # class name being defined — bright gold-green
            case 18
                return rgba['#dcdc8a']
            # meta / generic type arg — orange-tan
            case 19
                return rgba['#d1a36a']
            default                         # none / ident / op
                return rgba['#d4d4d4']

    # buffers live on orbiter: one mapping shared by every pane
    func buffers [] -> map FileBuf [string]
        orb : cast orbiter [ ux.app_object ]
        if [ !orb ] return null
        if [ !orb.file_cache ] orb.file_cache = map FileBuf [string] []
        return orb.file_cache

    func line_reg_count [ ml: i32 ] -> i32
        if [ !cur_buf || !cur_buf.line_regs ] return 0
        if [ ml < 0 || ml >= cur_buf.line_regs.count ] return 0
        regs : vec i32 cur_buf.line_regs[ ml ]
        return (regs) ? regs.count / 8 : 0

    # one scratch region, filled from the packed ints: read it before
    # the next call, never keep it
    func line_reg [ ml: i32, k: i32 ] -> ColorRegion
        regs : vec i32 cur_buf.line_regs[ ml ]
        if [ !reg_scratch ] reg_scratch = ColorRegion []
        cr : ColorRegion reg_scratch
        b  : i32 [ k * 8 ]
        cr.col   = i32[ regs[ b ] ]
        cr.len   = i32[ regs[ b + 1 ] ]
        cr.kind  = i32[ regs[ b + 2 ] ]
        di : i32 [ regs[ b + 3 ] ]
        cr.dsrc  = (di > 0 && cur_buf.decl_files && di <= cur_buf.decl_files.count) ? cur_buf.decl_files[ di - 1 ] : null
        cr.dline = i32[ regs[ b + 4 ] ]
        ti : i32 [ regs[ b + 5 ] ]
        cr.tsrc  = (ti > 0 && cur_buf.decl_files && ti <= cur_buf.decl_files.count) ? cur_buf.decl_files[ ti - 1 ] : null
        cr.tline = i32[ regs[ b + 6 ] ]
        ni : i32 [ regs[ b + 7 ] ]
        cr.tname = (ni > 0 && cur_buf.decl_files && ni <= cur_buf.decl_files.count) ? cur_buf.decl_files[ ni - 1 ] : null
        cr.color = fmt_theme[ cr.kind ]
        return cr

    func fmt_invalidate []
        if [ cur_buf ]
            cur_buf.line_regs = null

    # each token's colour stays with its text: one outside the edit
    # moves by the edit's length, one the edit touched is found again by
    # its text nearest its old column. no parser, no language rules
    func edit_line_regs [ i: i32, before: string, after: string ]
        if [ !cur_buf || !cur_buf.line_regs ] return
        if [ i < 0 || i >= cur_buf.line_regs.count ] return
        regs : vec i32 cur_buf.line_regs[ i ]
        if [ !regs || regs.count == 0 ] return
        p : i32 [ 0 ]
        while [ p < before.count && p < after.count && before[p] == after[p] ]
            p += 1
        s : i32 [ 0 ]
        while [ s < before.count - p && s < after.count - p && before[before.count - 1 - s] == after[after.count - 1 - s] ]
            s += 1
        d : i32 [ after.count - before.count ]
        e : i32 [ before.count - s ]
        kept : vec i32 []
        for [ ri: i32 0, ri < regs.count, ri += 8 ]
            c0 : i32 [ regs[ ri ] ]
            l0 : i32 [ regs[ ri + 1 ] ]
            if [ l0 < 0 || c0 < 0 || c0 + l0 > before.count ] continue
            nc : i32 [ -1 ]
            if [ c0 + l0 <= p ]
                nc = c0
            el [ c0 >= e ]
                nc = c0 + d
            el [ l0 > 0 ]
                nc = text_near[ after, before.mid[ c0, l0 ], c0, kept ]
            if [ nc < 0 ] continue
            # read as values: an element pushed as is copies its slot
            kd : i32 [ regs[ ri + 2 ] ]
            df : i32 [ regs[ ri + 3 ] ]
            dl : i32 [ regs[ ri + 4 ] ]
            tf : i32 [ regs[ ri + 5 ] ]
            tl : i32 [ regs[ ri + 6 ] ]
            tn : i32 [ regs[ ri + 7 ] ]
            kept.push[ nc ]
            kept.push[ l0 ]
            kept.push[ kd ]
            kept.push[ df ]
            kept.push[ dl ]
            kept.push[ tf ]
            kept.push[ tl ]
            kept.push[ tn ]
        cur_buf.line_regs[ i ] = regs_by_column[ kept ]

    # a copy of a line's tokens at or after column `from`
    func regs_from [ i: i32, from: i32 ] -> vec i32
        out : vec i32 []
        if [ !cur_buf || !cur_buf.line_regs || i < 0 || i >= cur_buf.line_regs.count ]
            return out
        regs : vec i32 cur_buf.line_regs[ i ]
        if [ !regs ] return out
        for [ ri: i32 0, ri < regs.count, ri += 8 ]
            c0 : i32 [ regs[ ri ] ]
            if [ c0 < from ] continue
            for [ f: i32 0, f < 8, f += 1 ]
                v : i32 [ regs[ ri + f ] ]
                out.push[ v ]
        return out

    # moved tokens land on line i, their columns shifted
    func regs_to [ i: i32, moved: vec i32, shift: i32 ]
        if [ !cur_buf || !cur_buf.line_regs || i < 0 || i >= cur_buf.line_regs.count ]
            return
        if [ moved.count == 0 ] return
        out : vec i32 []
        for [ ri: i32 0, ri < moved.count, ri += 8 ]
            c0 : i32 [ i32[ moved[ ri ] ] + shift ]
            out.push[ c0 ]
            for [ f: i32 1, f < 8, f += 1 ]
                v : i32 [ moved[ ri + f ] ]
                out.push[ v ]
        cur_buf.line_regs[ i ] = out

    # the column of `name` in `ln` nearest `near` that no kept token
    # covers
    func text_near [ ln: string, name: string, near: i32,
                     kept: vec i32 ] -> i32
        best : i32 [ -1 ]
        nl : i32 [ name.count ]
        for [ c: i32 0, c + nl <= ln.count, c += 1 ]
            if [ ln[ c ] != name[ 0 ] ] continue
            if [ ln.mid[ c, nl ] != name ] continue
            free : bool [ true ]
            for [ ki: i32 0, ki < kept.count, ki += 8 ]
                k0 : i32 [ kept[ ki ] ]
                k1 : i32 [ k0 + i32[ kept[ ki + 1 ] ] ]
                if [ c < k1 && c + nl > k0 ] free = false
            if [ !free ] continue
            dc : i32 [ (c > near) ? c - near : near - c ]
            db : i32 [ (best > near) ? best - near : near - best ]
            if [ best < 0 || dc < db ] best = c
        return best

    # regions in column order (the found ones can land out of order)
    func regs_by_column [ r: vec i32 ] -> vec i32
        n : i32 [ r.count / 8 ]
        out : vec i32 []
        used : vec i32 [ n ]
        for [ u: i32 0, u < n, u += 1 ] used.push[ 0 ]
        for [ t: i32 0, t < n, t += 1 ]
            pick : i32 [ -1 ]
            pc   : i32 [ 0 ]
            for [ q: i32 0, q < n, q += 1 ]
                uq : i32 [ used[ q ] ]
                if [ uq != 0 ] continue
                cq : i32 [ r[ q * 8 ] ]
                if [ pick < 0 || cq < pc ]
                    pick = q
                    pc   = cq
            used[ pick ] = 1
            for [ f: i32 0, f < 8, f += 1 ]
                vf : i32 [ r[ pick * 8 + f ] ]
                out.push[ vf ]
        return out

    public func load_format [ mapfile: string ]
        mp    : path  '{mapfile}'
        # only the files with a loaded buffer: the map covers far more
        fcm  : map FileBuf [string] buffers[]
        if [ !fcm ] return
        files : vec Au mp.read_format_of[ fcm ]
        if [ !files ] return
        for [ fi: i32 0, fi < files.count, fi += 1 ]
            ff  : fmt_file files[fi]
            apply_format[ ff ]

    # a loaded buffer for this file; colouring never creates one, since
    # load_text treats an existing buffer as already read
    public func has_buffer [ p: path ] -> bool
        fcm : map FileBuf [string] buffers[]
        buf : FileBuf (fcm) ? fcm[ '{p.absolute[]}' ] : null
        return (buf && buf.lines) ? true : false

    # a declaring file's 1-based index in the buffer's table, else 0
    func decl_file_ix [ buf: FileBuf, dix: map i32 [string],
                        ds: string ] -> i32
        if [ !ds ] return 0
        if [ dix.contains[ ds ] ] return dix[ ds ]
        buf.decl_files.push[ ds ]
        di : i32 [ buf.decl_files.count ]
        dix[ ds ] = di
        return di

    # one file's map, from the .f or straight from its handler module
    public func apply_format [ ff: fmt_file ]
        if [ !ff || !ff.source ] return
        key : string '{ff.source}'
        # a section older than its file describes text that is gone:
        # every span lands on the wrong columns. it never colours,
        # whichever map it came in
        sp9 : path [ ff.source.chars ]
        if [ ff.mtime > 0 && sp9.exists[] && ff.mtime < sp9.modified_time[] ]
            return
        fcm : map FileBuf [string] buffers[]
        buf : FileBuf fcm[ key ]
        if [ !buf ] return
        buf.line_regs  = vec Au []
        buf.decl_files = vec string []
        dix : map i32 [string] []
        lns : vec Au ff.lines
        nl  : i32 [ lns.count ]
        for [ li: i32 0, li < nl, li += 1 ]
            ltk  : vec fmt_token lns[ li ]
            nt   : i32 [ ltk.count ]
            n8   : i32 [ nt * 8 ]
            regs : vec i32 [ n8 ]
            for [ ti: i32 0, ti < nt, ti += 1 ]
                tk : fmt_token ltk[ ti ]
                di : i32 [ decl_file_ix[ buf, dix, tk.decl_source ] ]
                ty : i32 [ decl_file_ix[ buf, dix, tk.type_source ] ]
                tn : i32 [ decl_file_ix[ buf, dix, tk.type_name ] ]
                regs.push[ i32 tk.column ]
                regs.push[ i32 tk.length ]
                regs.push[ i32 tk.syntax ]
                regs.push[ di ]
                regs.push[ i32 tk.decl_line ]
                regs.push[ ty ]
                regs.push[ i32 tk.type_line ]
                regs.push[ tn ]
            buf.line_regs.push[ regs ]

    # nesting by indentation, for any file: each line's parent is the
    # nearest line above it with a smaller indent. a blank line inherits
    # its predecessor's, so it never ends a scope
    func line_tree []
        if [ !cur_buf || !lines ] return
        n : i32 [ lines.count ]
        if [ !cur_buf.tree_dirty && cur_buf.line_parent && cur_buf.line_parent.count == n ]
            return
        tree   : vec i32 []
        sline  : vec i32 []       # open lines, outermost first
        sind   : vec i32 []       # and their indents
        above  : i32 [ -1 ]
        i      : i32 [ -1 ]
        for [ ln: string ] in lines
            i += 1
            ind : i32 [ 0 ]
            while [ ln && ind < ln.count && (ln[ind] == 32 || ln[ind] == 9) ]
                ind += 1
            if [ !ln || ind >= ln.count ]
                tree.push[ above ]
                continue
            while [ sind.count > 0 ]
                tind : i32 [ sind[ sind.count - 1 ] ]
                if [ tind < ind ] break
                sind.pop[]
                sline.pop[]
            above = (sline.count > 0) ? i32[
                sline[ sline.count - 1 ] ] : -1
            tree.push[ above ]
            sline.push[ i ]
            sind.push[ ind ]
        # where each scope ends: a line's last reaches down to its
        # children's, so walking up from the bottom settles every parent
        ends : vec i32 []
        for [ i: i32 0, i < n, i += 1 ] ends.push[ i ]
        for [ i: i32 n - 1, i > 0, i -= 1 ]
            p : i32 [ tree[ i ] ]
            if [ p >= 0 && i32[ ends[ i ] ] > i32[ ends[ p ] ] ]
                ends[ p ] = ends[ i ]
        cur_buf.line_parent = tree
        cur_buf.line_last   = ends
        cur_buf.tree_dirty  = false

    # the header rows kept drawn at the top: the lines the first visible
    # row is nested under, outermost first, each only once it has
    # scrolled off. each level reads the row just under the band as it
    # stands the band is VIEW rows: the scope tree is file lines, mapped
    # both ways this file's compile error, drawn as a band along the
    # foot
    public func err_band_text [] -> string
        if [ !ux || !src ] return null
        o9 : cast orbiter [ ux.app_object ]
        return (o9) ? o9.err_text_for[ src ] : null

    public func err_band_line [] -> i32
        o9 : cast orbiter [ ux.app_object ]
        return (o9) ? o9.err_line_no[] : 0

    public func pinned_rows [] -> vec i32
        rows : vec i32 []
        # the outline is all headers already: no band over it
        if [ show_hits || !cur_buf || outline ] return rows
        line_tree[]
        tree : vec i32 cur_buf.line_parent
        if [ !tree ] return rows
        lh   : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
        ends : vec i32 cur_buf.line_last
        # a pixel of easing under a row boundary must not read as the
        # row above
        top  : i32 [ (scroll.y + 1.0) / lh ]
        for [ level: i32 0, level < 16, level += 1 ]
            row : i32 [ top + i32[ rows.count ] ]
            if [ row < 0 || row >= line_count[] ] break
            # an expanded variable row belongs to the line it hangs
            # under
            sr : i32 [ row_src[ row ] ]
            while [ sr < 0 && row > 0 ]
                row -= 1
                sr = row_src[ row ]
            if [ sr < 0 || sr >= tree.count ] break
            # the line's ancestors, innermost first
            chain : vec i32 []
            for [ p: i32 [ tree[ sr ] ], p >= 0, p = i32[ tree[ p ] ] ]
                chain.push[ p ]
            # a header of exactly this depth arriving at its slot
            # freezes there: it joins the band the moment the band
            # reaches it, so the band never grows over the first line of
            # its body
            if [
                level == chain.count && ends && sr < ends.count
                && i32[ ends[ sr ] ] > sr ]
                rows.push[ row ]
                continue
            if [ level >= chain.count ] break
            h : i32 [ vis_row[ chain[ chain.count - 1 - level ] ] ]
            # a header stays nested under the one above it in the band
            if [ rows.count > 0 && h <= i32[ rows[ rows.count - 1 ] ] ]
                break
            rows.push[ h ]
        return rows

    # arrive at a 1-based line as if the user clicked the end of it: the
    # caret there, no range, the line in view, the pane focused, a nav
    # point to return to
    public func land_on [ lno: i32 ]
        goto_line[ lno ]
        ln : string line_get[ sel_line ]
        sel_col      = (ln) ? ln.count : 0
        anchor_col   = sel_col
        saved_scroll = scroll.y
        pristine     = false
        if [ ux ] ux.set_focus[ a ]
        if [ nav && src ]
            nav.record[ pane_index, '{src.absolute[]}', sel_line,
                        sel_col, scroll.y ]

    # put the caret on a 1-based line and bring it into view
    public func goto_line [ lno: i32 ]
        sl : i32 [ vis_row[ (lno > 0) ? lno - 1 : 0 ] ]
        sel_line    = sl
        anchor_line = sl
        lh  : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
        vh  : f32 [ (bounds) ? bounds.h : 600.0 ]
        top : f32 [ f32[ sl ] * lh ]
        # the pinned band covers the top rows: a line under it is not in
        # view
        band : f32 [ f32[ pinned_rows[].count ] * lh ]
        foot : f32 [ (err_band_text[]) ? lh : 0.0 ]
        if [ top < scroll.y + band || top + lh > scroll.y + vh - foot ]
            scroll.y = top - vh * 0.4
            if [ scroll.y < 0.0 ] scroll.y = 0.0
            scroll_target = scroll.y
        pristine = false

    # a debugger stop: the arrow, the scroll, and a navigation entry for
    # it
    public func apply_stop [ lno: i32, col: i32 ]
        sl : i32 [ (lno > 0) ? lno - 1 : 0 ]
        lh  : f32 [ (lh_cache > 0.0) ? lh_cache : 22.0 ]
        vh  : f32 [ (bounds) ? bounds.h : 600.0 ]
        # the previous stop's place on screen: the new one lands there
        if [ stop_line >= 0 ]
            stop_y = f32[ vis_row[ stop_line ] ] * lh - scroll.y
        stop_line = sl
        stop_col  = col
        top : f32 [ f32[ vis_row[ sl ] ] * lh ]
        # the pinned band covers the top rows: a line under it is not in
        # view
        band : f32 [ f32[ pinned_rows[].count ] * lh ]
        foot : f32 [ (err_band_text[]) ? lh : 0.0 ]
        # off screen, or none before: the middle
        if [ stop_y < band || stop_y + lh > vh - foot ]
            stop_y = round[ (vh - lh) * 0.5 ]
        scroll.y = top - stop_y
        if [ scroll.y < 0.0 ] scroll.y = 0.0
        scroll_target = scroll.y
        if [ nav && src ]
            nav.record[ pane_index, '{src.absolute[]}', sl, col,
                        scroll.y ]
        pristine = false
        # the step buttons ride the stopped line
        if [ ux ] ux.restyle = true

    func line_get [ vr: i32 ] -> string
        if [ show_hits && hits ]
            if [ vr >= 0 && vr < hits.count ] return hits[vr].text
            return ''
        if [
            flat_active && flat_rows && vr >= 0
            && vr < flat_rows.count ]
            r : VRow flat_rows[ vr ]
            if [ r.src >= 0 ]
                fs : string lines.value_by_index[ r.src ]
                return (fs) ? fs : ''
            if [ !r.var ] return (r.text) ? r.text : ''
            return '# {r.var.name} = {r.var.value}'
        if [ vr >= 0 && vr < lines.count ]
            s : string lines.value_by_index[ vr ]
            return (s) ? s : ''
        return ''

    func console_line_count [] -> i32
        return line_count[]

    func console_line [ vr: i32 ] -> string
        return line_get[ vr ]

    func line_set [ i: i32, val: string ]
        if [ show_hits && hits ]
            hits[i].text = val
            return
        # i is a SOURCE row: the callers map a view row through src_row
        os : string lines.value_by_index[ i ]
        old : string [ (os) ? os : '' ]
        lines.remove[ i ]
        lines.insert_after[ val, i - 1 ]
        edit_line_regs[ i, old, val ]
        if [ cur_buf ] cur_buf.tree_dirty = true


    # raw line ops (no recording) — used by undo/redo replay. source
    # rows: open ghost rows slide with the file rows they sit before
    func raw_set    [ i: i32, val: string ]    line_set[ i, val ]
    func raw_insert [ i: i32, val: string ]
        lines.insert_after[ val, i - 1 ]
        if [
            cur_buf && cur_buf.line_regs
            && i <= cur_buf.line_regs.count ]
            cur_buf.line_regs.insert[ vec i32 [], i ]
        if [ cur_buf ] cur_buf.tree_dirty = true
        if [ ghost_hunk >= 0 && i < ghost_at ] ghost_at += 1
    func raw_remove [ i: i32 ]
        if [ cur_buf && cur_buf.line_regs ]
            cur_buf.line_regs.remove[ i ]
        if [ cur_buf ] cur_buf.tree_dirty = true
        lines.remove[ i ]
        if [ ghost_hunk >= 0 && i < ghost_at ] ghost_at -= 1

    func rec [ op: LineOp ]
        if [ show_hits || diff_commit ] return
        if [ !cur_group ]
            while [ hist && hist.count > hist_i ]
                hist.pop[]
            cur_group = EditAction []
            cur_group.ops = vec LineOp []
            cur_group.sl0 = pend_sl0
            cur_group.sc0 = pend_sc0
            hist.push[ cur_group ]
            hist_i = hist.count
        n : i32 [ cur_group.ops.count ]
        if [ op.kind == 0 && n > 0 ]
            last2 : LineOp cur_group.ops[ n - 1 ]
            if [ last2.kind == 0 && last2.at == op.at ]
                # collapse same-line replaces
                last2.after = op.after
                touch_hist[]
                return
        cur_group.ops.push[ op ]
        touch_hist[]

    func ed_set [ vi: i32, val: string ]
        # information only, never edited
        if [ row_ghost[ vi ] ] return
        i   : i32 [ src_row[ vi ] ]
        old : line_get[ vi ]
        line_set[ i, val ]
        if [ diff_commit ]
            # touching a commit-only row adopts it into our file
            if [
                diff_kinds && i < diff_kinds.count
                && diff_kinds[i] == 1 ]
                diff_kinds[i] = 2
            diff_dirty   = true
            diff_edit_ms = epoch_millis[]
            return
        rec[ LineOp [ at: i, kind: 0, before: old, after: val ] ]

    # val becomes line vi (shifts the rest down)
    func ed_insert [ vi: i32, val: string ]
        i  : i32 [ src_row[ vi ] ]
        gh : bool [ row_ghost[ vi ] ]
        # inserts the line AND its empty region row
        raw_insert[ i, val ]
        # a line inserted at the ghosts' own row goes above them
        if [ gh && ghost_hunk >= 0 && i == ghost_at ] ghost_at += 1
        if [ diff_commit ]
            kinds_insert[ i ]
            diff_dirty   = true
            diff_edit_ms = epoch_millis[]
            return
        rec[ LineOp [ at: i, kind: 1, after: val ] ]

    func ed_remove [ vi: i32 ]
        # information only, never edited
        if [ row_ghost[ vi ] ] return
        i   : i32 [ src_row[ vi ] ]
        old : line_get[ vi ]
        # removes the line AND its region row
        raw_remove[ i ]
        if [ diff_commit ]
            kinds_remove[ i ]
            diff_dirty   = true
            diff_edit_ms = epoch_millis[]
            return
        rec[ LineOp [ at: i, kind: 2, before: old ] ]

    func swap_lines [ to: list string ]
        while [ lines.count > 0 ] lines.pop[]
        for [ s: string ] in to
            lines.push[ s ]
        # whole-buffer swap: per-line regions no longer correspond
        fmt_invalidate[]
        if [ cur_buf ] cur_buf.tree_dirty = true

    func apply_undo [ g: EditAction ]
        if [ g.full_before ]
            swap_lines[ g.full_before ]
            sel_line    = g.sl0
            sel_col     = g.sc0
            anchor_line = g.sl0
            anchor_col  = g.sc0
            return
        for [ k: i32 g.ops.count - 1, k >= 0, k -= 1 ]
            op : LineOp g.ops[ k ]
            if [ op.kind == 0 ]
                raw_set[ op.at, op.before ]
            el [ op.kind == 1 ]
                raw_remove[ op.at ]
            el
                raw_insert[ op.at, op.before ]
        sel_line    = g.sl0
        sel_col     = g.sc0
        anchor_line = g.sl0
        anchor_col  = g.sc0

    func apply_redo [ g: EditAction ]
        if [ g.full_after ]
            swap_lines[ g.full_after ]
            sel_line    = g.sl1
            sel_col     = g.sc1
            anchor_line = g.sl1
            anchor_col  = g.sc1
            return
        for [ k: i32 0, k < g.ops.count, k += 1 ]
            op : LineOp g.ops[ k ]
            if [ op.kind == 0 ]
                raw_set[ op.at, op.after ]
            el [ op.kind == 1 ]
                raw_insert[ op.at, op.after ]
            el
                raw_remove[ op.at ]
        sel_line    = g.sl1
        sel_col     = g.sc1
        anchor_line = g.sl1
        anchor_col  = g.sc1

    func swap_history [ buf: FileBuf ]
        # already live → keep the live cursor
        if [ cur_buf == buf && buf.hist ] return
        if [ cur_buf && cur_buf != buf ]
            cur_buf.hist_i = hist_i
        if [ !buf.hist ]
            buf.hist   = list EditAction []
            buf.hist_i = 0
        hist      = buf.hist
        hist_i    = buf.hist_i
        cur_group = null
        edit_kind = -1
        edit_cl   = -1
        edit_cc   = -1
        cur_buf   = buf

    func touch_hist []
        if [ cur_buf ] cur_buf.hist_i = hist_i

    func cut_line []
        if [ show_hits || line_count[] <= 0 ] return
        row : i32 [ (sel_line < 0) ? 0 : sel_line ]
        if [ row_header[ row ] || row_ghost[ row ] ] return
        ln : string line_get[ row ]
        piece : string '{ln}\n'
        # the caret walks up: each cut line goes in front, in file order
        if [ kill_chain && kill_row == row && kill_text ]
            kill_text = '{piece}{kill_text}'
        el
            kill_text = piece
        begin_edit[ 3 ]
        if [ line_count[] > 1 ]
            ed_remove[ row ]
        el
            ed_set[ row, '' ]
        # the caret lands at the end of the line above the cut
        to : i32 [ (row > 0) ? row - 1 : 0 ]
        if [ to >= line_count[] ] to = line_count[] - 1
        tl : string line_get[ to ]
        sel_line    = to
        sel_col     = (row > 0 && tl) ? tl.count : 0
        anchor_line = sel_line
        anchor_col  = sel_col
        end_edit[]
        kill_chain = true
        kill_row   = sel_line
        if [ ux ]
            ux.set_clipboard[ kill_text ]
            ux.will_animate = true
        pristine = false

    func begin_edit [ kind: i32 ]
        if [ show_hits ] return
        jumped : bool [ sel_line != edit_cl || sel_col != edit_cc ]
        if [ edit_kind != kind || jumped ]
            cur_group = null
            edit_kind = kind
        if [ !cur_group ]
            # caret before the (upcoming) group's first op
            pend_sl0 = sel_line
            pend_sc0 = sel_col

    func end_edit []
        edit_cl = sel_line
        edit_cc = sel_col
        if [ cur_group ]
            cur_group.sl1 = sel_line
            cur_group.sc1 = sel_col

    func undo []
        if [ rview && rview.view_undo*[] ] return
        if [ show_hits || !hist ] return
        cur_group = null
        edit_kind = -1
        if [ hist_i <= 0 ] return
        hist_i -= 1
        apply_undo[ hist.value_by_index[ hist_i ] ]
        edit_cl = sel_line
        edit_cc = sel_col
        ensure_caret_visible[]
        touch_hist[]
        pristine = false

    func redo []
        if [ rview && rview.view_redo*[] ] return
        if [ show_hits || !hist ] return
        cur_group = null
        edit_kind = -1
        if [ hist_i >= hist.count ] return
        apply_redo[ hist.value_by_index[ hist_i ] ]
        hist_i += 1
        edit_cl = sel_line
        edit_cc = sel_col
        ensure_caret_visible[]
        touch_hist[]
        pristine = false

    func save_current []
        if [ rview && rview.view_text*[ rview.view_sel ] ]
            ok : i32 [ 0 ]
            bad : i32 [ 0 ]
            n : i32 [ line_count[] ]
            for [ li: i32 0, li < n, li += 1 ]
                ln : line_get[ li ]
                if [ !ln || ln.count == 0 ] continue
                if [ rview.commit_line*[ ln ] ] ok += 1
                el bad += 1
            log 'assembly: {ok} lines applied, {bad} rejected'
            return
        if [ show_hits && hits ]
            if [ sel_line < 0 || sel_line >= hits.count ] return
            target : path [ hits[sel_line].file ]
            if [ !target ] return
            tkey    : '{target}'
            ftext : string [ target.load[ typeid[string], null ] ]
            if [ !ftext ] return
            parts : ftext.split["\n"]
            for [ i: i32 0, i < hits.count, i += 1 ]
                h : FindHit hits[i]
                if [ h.is_header ]
                    continue
                if [ '{h.file}' != tkey ]
                    continue
                idx : i32 [ h.line - 1 ]
                if [ idx >= 0 && idx < parts.count ] parts[idx] = h.text
            out : string [ '' ]
            for [ i: i32 0, i < parts.count, i += 1 ]
                if [ i > 0 ] out = out + '\n'
                out = out + parts[i]
            tp : path '{target}'
            tp.save[ out, null ]
            return
        if [ !src ] return
        out   : string [ '' ]
        wrote : i32 [ 0 ]
        for [ i: i32 0, i < lines.count, i += 1 ]
            # diff view: commit-only rows are not ours to save
            if [ diff_commit && diff_kinds && i < diff_kinds.count && diff_kinds[i] == 1 ]
                continue
            if [ wrote > 0 ] out = out + '\n'
            out = out + line_get[ i ]
            wrote += 1
        sp : path '{src}'
        sp.save[ out, null ]
        # the changed-files scan runs on a project selection change
        # only, never on a save (it is a full git pass over every
        # selected repo) stamp the cache or our own save reads as an
        # external change
        fcm : map FileBuf [string] buffers[]
        buf9 : FileBuf fcm[ '{src.absolute[]}' ]
        if [ buf9 ]
            buf9.mtime  = src.modified_time[]
            buf9.sync_i = hist_i

    func file_ext [ p: path ] -> string
        fn  : string p.filename[]
        n   : i32 [ fn.count ]
        dot : i32 [ -1 ]
        for [ i: i32 0, i < n, i += 1 ]
            if [ fn[i] == 46 ] dot = i        # '.'
        if [ dot < 0 ] return ''
        return fn.mid[ dot, n - dot ]

    # every ResourceView subclass registers itself: by extension for the
    # default chain, by name for the rail
    func ensure_view_registry []
        if [ view_registry ] return
        view_registry = map Au_t[string] []
        view_by_name  = map Au_t[string] []
        n    : i64 [ 0 ]
        subs : @Au_t [ Au.subclasses[ typeid[ ResourceView ], @n ] ]
        for [ i: i64 0, i < n, i += 1 ]
            t : subs[ i ]
            if [ t ]
                probe : ResourceView [
                    Au.new_object[ t, null, null, true, __FILE__,
                                   __LINE__, __SEQUENCE__ ] ]
                if [ probe ]
                    exts : probe.extensions*[]
                    for [ e: string ] in exts
                        view_registry[ e ] = t
                    vid : string probe.view_id*[]
                    if [ !vid || vid.count == 0 ] vid = '{t.ident}'
                    view_by_name[ vid ] = t

    # the type that renders a named view in-process, or null for a peer
    func view_type [ nm: string ] -> Au_t
        if [ !nm || nm.count == 0 ] return null
        ensure_view_registry[]
        return view_by_name[ nm ]

    func ensure_export_registry []
        if [ export_registry ] return
        export_registry = map string[string] []
        export_ftype    = map string[string] []
        export_lib      = map string[string] []
        export_protocol = map string[string] []
        root : path.path_startup[]
        if [ !root ] return
        d : path '{root}/install/export'
        entries : d.ls[ null, false ]
        if [ !entries ] return
        for [ e: path ] in entries
            ax : e.ext[]
            if [ !ax || !(ax == 'agi') ] continue
            # the export is named <owner>-<module>; the host and the
            # build need the MODULE (silver-markdown.agi -> markdown)
            mod   : module_of_export[ root, e.stem[] ]
            ftext : string e.load[ typeid[string], null ]
            if [ !ftext ] continue
            for [ pr: string ] in export_names[ ftext, 'protocols:' ]
                export_protocol[ pr ] = mod
            ix : ftext.index_of[ 'extensions:' ]
            if [ ix < 0 ] continue
            # the line: 'ext' [: filetype], 'ext' ... to its end
            i  : i32 [ ix ]
            n2 : i32 [ ftext.count ]
            q0 : i32 [ 0 - 1 ]
            while [ i < n2 ]
                c : i32 [ (i32 ftext.chars[i]) & 255 ]
                if [ c == 10 ] break
                i += 1
                if [ c != 39 ] continue
                # an opening quote starts the name; a closing one ends
                # it
                if [ q0 < 0 ]
                    q0 = i
                    continue
                ex : ftext.mid[ q0, i - 1 - q0 ]
                export_registry[ ex ] = mod
                export_lib[ ex ] = e.stem[]
                q0 = 0 - 1
                ft : string export_ftype_at[ ftext, i, n2 ]
                if [ ft ] export_ftype[ ex ] = ft

    # the quoted names on an export's line (protocols: ['http'])
    func export_names [ ftext: string, key: string ] -> vec string
        names : vec string []
        ix : ftext.index_of[ key ]
        if [ ix < 0 ] return names
        i  : i32 [ ix ]
        n2 : i32 [ ftext.count ]
        q0 : i32 [ 0 - 1 ]
        while [ i < n2 ]
            c : i32 [ (i32 ftext.chars[i]) & 255 ]
            if [ c == 10 ] break
            i += 1
            if [ c != 39 ] continue
            if [ q0 < 0 ]
                q0 = i
                continue
            names.push[ ftext.mid[ q0, i - 1 - q0 ] ]
            q0 = 0 - 1
        return names

    # the optional ': filetype' a module declares after a quoted
    # extension, read from i (just past the closing quote); null when
    # there is none
    func export_ftype_at [ ftext: string, i: i32, n2: i32 ] -> string
        j3 : i32 [ i ]
        while [ j3 < n2 ]
            c3 : i32 [ (i32 ftext.chars[j3]) & 255 ]
            if [ c3 != 32 && c3 != 58 ] break
            j3 += 1
        if [ j3 == i || j3 >= n2 ] return null
        k3 : i32 [ j3 ]
        while [ k3 < n2 ]
            c4 : i32 [ (i32 ftext.chars[k3]) & 255 ]
            if [ c4 < 97 || c4 > 122 ] break
            k3 += 1
        if [ k3 == j3 ] return null
        return ftext.mid[ j3, k3 - j3 ]

    # <owner>-<module> export stem -> the module whose source dir exists
    # under root; owners may carry dashes, so segments drop from the
    # left
    func module_of_export [ root: path, stem: string ] -> string
        nm : string [ stem ]
        while [ nm && nm.count > 0 ]
            src9 : path '{root}/{nm}/{nm}.ag'
            if [ src9.exists[] ] return nm
            dash : i32 [ nm.index_of[ '-' ] ]
            if [ dash < 0 ] break
            nm = nm.mid[ dash + 1, nm.count - dash - 1 ]
        return stem

    # exported handler module that VIEWS a file's extension, or null.
    # only an app (a trinity element) can be hosted on a file; a lib
    # that only processes text (a syntax map) is not a view, so the file
    # stays in the code editor. silver's own rule tells them apart: an
    # app has its host binary beside the product
    func handler_module_for [ p: path ] -> string
        ext : file_ext[ p ]
        if [ ext.count == 0 ] return null
        ensure_export_registry[]
        hm : string export_registry[ ext ]
        if [ !hm ] return null
        root : path.path_startup[]
        host : path '{root}/install/build/{hm}'
        return (host.exists[]) ? hm : null

    # the handler's lib stem (silver-markdown) for a file's extension,
    # or null
    func handler_lib_for [ p: path ] -> string
        ext : file_ext[ p ]
        if [ ext.count == 0 ] return null
        ensure_export_registry[]
        lib : string export_lib[ ext ]
        if [ lib ] return lib
        # no export claims it: the code handler's plain lexer colours
        # any text file, when that handler is built
        orb : cast orbiter [ ux.app_object ]
        if [ !orb ] return null
        so   : path orb.module_lib[ 'silver-code' ]
        return (so.exists[]) ? 'silver-code' : null

    # a named view that can render bytes, asked of the views themselves
    func binary_view_name [] -> string
        if [ bin_view_cached && bin_view_cached.count > 0 ]
            return bin_view_cached
        ensure_view_registry[]
        for [ t: Au_t, nm: string ] in view_by_name
            if [ !nm || nm.count == 0 ] continue
            probe : ResourceView [
                Au.new_object[ t, null, null, true, __FILE__, __LINE__,
                               __SEQUENCE__ ] ]
            if [ !probe ] continue
            ft : probe.applies*[]
            if [ ft == FileType.binary || ft == FileType.agnostic ]
                bin_view_cached = nm
                return nm
        return 'editor'

    # what to show with nothing launched. the owning module exported
    # whether its format is binary; never sniff, never key off the ext
    func fallback_view_for [ p: path ] -> string
        if [ !p ] return 'editor'
        ensure_export_registry[]
        ext : file_ext[ p ]
        if [ ext.count == 0 ] return 'editor'
        ft : string export_ftype[ ext ]
        if [ ft && ft == 'binary' ] return binary_view_name[]
        return 'editor'

    # default action's name: peer handler module or hosted element
    func default_view_for [ p: path ] -> string
        hm : handler_module_for[ p ]
        if [ hm ] return hm
        ext : file_ext[ p ]
        if [ ext.count == 0 ] return null
        ensure_view_registry[]
        t : view_registry[ ext ]
        if [ t ] return '{t.ident}'
        return null

    # vw names the rail view the module should open with; '' = its
    # default
    func launch_handler [ mod: string, p: path, vw: string ]
        log 'launch_handler: {mod} for {p} view={vw}'
        args : string [ null ]
        orb : cast orbiter [ ux.app_object ]
        if [ orb ]
            fa : string orb.file_args[ p ]
            args = (fa && fa.count > 0) ? fa : orb.module_args
        # flags lead; the saved args may end in the app's default
        # (positional)
        if [ vw && vw.count > 0 ]
            args = (args && args.count > 0) ? '--view {vw} {args}' : '--view {vw}'
        host_module[ mod, p, args ]

    # an address whose scheme a module exports: it hosts the address
    public func open_url [ url: string ] -> bool
        ix : url.index_of[ '://' ]
        if [ ix <= 0 ] return false
        ensure_export_registry[]
        mod : string export_protocol[ url.mid[ 0, ix ] ]
        if [ !mod ] return false
        host_module[ mod, null, url ]
        return true

    # host a module's app in this pane, on a file or with args alone
    func host_module [ mod: string, p: path, args: string ]
        root : path.path_startup[]
        if [ !root ] return
        nv : AppView [ ]
        nv.src = path '{root}/{mod}/{mod}.ag'
        nv.doc = p
        nv.viewer = true
        nv.module_args = args
        nv.host_hz = (ux) ? ux.refresh_hz[] : 60
        nv.start[]
        orb : cast orbiter [ ux.app_object ]
        if [ orb ] orb.add_instance[ nv ]
        run_view  = nv
        app_view  = true
        pristine  = false
        no_scroll = true
        focusable = true
        if [ ux ]
            ux.set_focus[ a ]
            ux.restyle = true

    func file_is_binary [ p: path ] -> bool
        ps : '{p}'
        fp : fopen[ ps.chars, "rb" ]
        if [ !fp ] return false
        b : local u8 [ 4096 ]
        n : i32 [ fread[ @b[0], 1, 4096, fp ] ]
        fclose[ fp ]
        if [ n <= 0 ] return false
        ctrl : i32 [ 0 ]
        for [ i: i32 0, i < n, i += 1 ]
            c : i32 [ b[i] ]
            if [ c == 0 ] return true
            # printable + all high bytes
            if [ c >= 32 ] continue
            if [ c == 9 || c == 10 || c == 13 ] continue
            if [ c == 12 || c == 27 ] continue       # form feed, escape
            ctrl += 1
        # >10% control bytes
        return ctrl * 100 > n * 10

    func resource_view_for [ p: path ] -> ResourceView
        ext : file_ext[ p ]
        if [ ext.count == 0 ] return null
        ensure_view_registry[]
        t : view_registry[ ext ]
        if [ !t ] return null
        return ResourceView [
            Au.new_object[ t, null, null, true, __FILE__, __LINE__,
                           __SEQUENCE__ ] ]

    # a view's look at this file, rendered small for the picker: only a
    # view that paints itself (hex, image) has one; a composed view
    # (git, a console) and a peer module's view show their icon instead
    func view_thumb [ nm: string, cv: Canvas, tw: i32,
                      th: i32 ] -> Canvas
        if [ !src || !nm || nm.count == 0 || nm == 'editor' ]
            return null
        if [ !view_thumbs ] view_thumbs = map Canvas[string] []
        key : string '{nm}|{src.absolute[]}'
        ex  : Canvas view_thumbs[ key ]
        if [ ex ] return ex
        t : Au_t view_type[ nm ]
        if [ !t ] return null
        rv : ResourceView [
            Au.new_object[ t, null, null, true, __FILE__, __LINE__,
                           __SEQUENCE__ ] ]
        if [ !rv ] return null
        vel : element rv.view_element*[]
        if [ vel ] return null
        rv.src = src
        tc : Canvas [ vk: cv.vk, w: cv.w, format: Pixel.rgba8,
            width: tw, height: th, load_existing: true, quantize: true,
            tag: 'vthumb' ]
        tc.update[]
        tc.reset[ vec4f [ 0.0, 0.0, 0.0, 0.0 ] ]
        rv.render*[ tc,
                    rect [ x: 0.0, y: 0.0, w: f32[ tw ],
                           h: f32[ th ] ] ]
        rv.release*[]
        view_thumbs[ key ] = tc
        return tc

    func thumb_for [ p: path, cv: Canvas ] -> Texture
        if [ !p ] return null
