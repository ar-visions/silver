            # misses the rect fast path and rasterizes through the
            # half-res SDF window, which shifts rows off their y and
            # bleeds red into green. coalescing runs keeps the paint
            # count to the visible run count.
            cv.stroke_width[ 0.0 ]
            nl : i32 [ editor.line_count[] ]
            nk : i32 [ editor.diff_kinds.count ]
            li  : i32 [ 0 ]
            while [ li < nl && li < nk ]
                dk : i32 [ editor.diff_kinds[li] ]
                if [ dk == 0 ]
                    li += 1
                    continue
                rs : i32 [ li ]
                while [
                    li < nl && li < nk && editor.diff_kinds[li] == dk ]
                    li += 1
                yt : f32 [
                    round[ y0 + f32[ rs ] * lh - editor.scroll.y ] ]
                yb : f32 [
                    round[ y0 + f32[ li ] * lh - editor.scroll.y ] ]
