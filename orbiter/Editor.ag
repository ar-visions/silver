            return

        in_list : bool [
            editor.finder_list || showing || editor.outline ]
        stop_vrow : i32 [ editor.vis_row[ editor.stop_line ] ]
        hl_line : i32 [ (in_list) ? editor.hover_line : stop_vrow ]
        if [
            hl_line >= 0 && hl_line < editor.line_count[] && hl_fill
            && !editor.row_spacer[ hl_line ] ]
