                        && (editor.hover_line == li || editor.hover_line == li - 1) ]
                    cv.fill_color[
                        (kd9 == 1) ? rgba['#7fd18b66']
                        : ((kd9 == 2) ? rgba['#6cb6ff66'] : ((hvr) ? rgba['#ffb4b4'] : rgba['#ff6a6a'])) ]
                    if [ kd9 == 3 ]
                        cv.rect_to[ bounds.x + 2.0,
                                    yg - ((hvr) ? 1.5 : 1.0),
                                    gut_w - 4.0, (hvr) ? 3.0 : 2.0 ]
                    el
                        cv.rect_to[ bounds.x + 2.0, yg + 1.0,
                                    gut_w - 4.0, lh - 2.0 ]
                    cv.paint[ ]
            if [ !showing && stop_vrow == li ]
                mid : f32 [ yg + lh * 0.5 ]
                cv.save[ ]
                cv.rounded[ 6.0, 6.0, 6.0, 6.0 ]
                cv.fill_color[ rgba['#00000000'] ]
                cv.stroke_color[ rgba['#ff44'] ]
                cv.stroke_width[ 1.0 ]
                cv.stroke_offset[ -0.5 ]
                cv.rect_to[ bounds.x + 1.0, yg + 1.0,
                            bounds.w - rin - 2.0, lh - 2.0 ]
                cv.paint[ ]
                cv.stroke_width[ 0.0 ]
                cv.stroke_offset[ 0.0 ]
                cv.rounded[ 0.0, 0.0, 0.0, 0.0 ]
                cv.fill_color[ rgba['#ffffff'] ]
                gtip : f32 [ bounds.x + gut_w + 12.0 ]
                cv.move_to[ gtip - 11.0, mid - 6.0 ]
                cv.line_to[ gtip - 6.0,  mid - 6.0 ]
                cv.line_to[ gtip,        mid ]
                cv.line_to[ gtip - 6.0,  mid + 6.0 ]
                cv.line_to[ gtip - 11.0, mid + 6.0 ]
                cv.close_path[ ]
                cv.paint[ ]
                if [ editor.stop_col >= 0 ]
                    cx : f32 [ x0 + f32[editor.stop_col] * cw_tm.w ]
                    cv.fill_color[ rgba['#ffcc33'] ]
                    cv.rect_to[ cx, yg + 1.0, 2.0, lh - 2.0 ]
                    cv.paint[ ]
                cv.restore[ ]
            # removed rows have no file line: blank gutter
            if [
                rnum > 0
                && !(showing && editor.hover_gutter && editor.hover_line == li) ]
                cv.fill_color[ rgba['#ffffff80'] ]
                cv.draw_text[ '{rnum}',
                    rect [ x: bounds.x, y: yg, w: gut_w - 6.0, h: lh ],
                    vec2f [ 1.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                    Overflow.visible, null ]

        # diff fills go down BEFORE the text, unmasked, as a real
        # background. the finder swaps `lines` for its results and
        # leaves diff_kinds alone, so those rows are NOT the file's rows
        # — never tint them
        if [ editor.diff_kinds && !showing && !editor.finder_list ]
