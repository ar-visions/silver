                return
            if [ show_hits && hits ]
                remove_hit[ vrl ]
                pristine = false
                return
            if [ row_var[ vrl ] ] return
            if [ diff_commit ] return    # diff rows don't map to file lines
            ln    : i32 [ row_src[ vrl ] ]
            key   : '{src}:{ln + 1}'
            cur   : breakpoints[key]
            if [ cur ]
                breakpoints.rm[ key ]
            el
                breakpoints[key] = string[]
            pristine = false
            return
        if [ !ev.key.shift ]
            # a definition jump consumed the click: we are in another
            # file now, so no anchor and no drag from the one we left
            if [ place_cursor[ ev ] ] return
            anchor_line = sel_line
