# a window's app, owned by the window: which instance it shows and
# whether its code is in front are orbiter's, never an editor's; an
# editor is made only while the code is edited
extend orbiter

# the windows' lists, a place each window
func orbiter.win_size []
    n : i32 [ i32[ editor_slots.count ] ]
    if [ !win_iid ]  win_iid  = vec i32 []
    if [ !win_edit ] win_edit = vec bool []
    while [ win_iid.count < n ]  win_iid  += -1
    while [ win_edit.count < n ] win_edit += false

# the instance the window shows (null: none)
func orbiter.pane_av [ pi: i32 ] -> AppView
    if [ !win_iid || pi < 0 || pi >= win_iid.count ] return null
    if [ win_iid[ pi ] < 0 ] return null
    return instance_by[ win_iid[ pi ] ]

# its app in front (not its code): always, but in edit mode
func orbiter.pane_live [ pi: i32 ] -> bool
    av : AppView pane_av[ pi ]
    if [ !av ] return false
    if [ !av.edited && !av.ended ] return true
    return !win_edit || pi >= win_edit.count || !win_edit[ pi ]

# the window's app, its front kept
func orbiter.pane_set_av [ pi: i32, av: AppView ]
    if [ pi < 0 || !av ] return
    win_size[]
    if [ pi >= win_iid.count ] return
    win_iid[ pi ] = av.iid

# its app or its code in front
func orbiter.pane_front [ pi: i32, on: bool ]
    win_size[]
    if [ pi < 0 || pi >= win_edit.count ] return
    win_edit[ pi ] = !on

# the window shows this app, in front
func orbiter.pane_show_app [ pi: i32, av: AppView ]
    if [ pi < 0 || !av ] return
    win_size[]
    if [ pi >= win_iid.count ] return
    win_iid[ pi ]  = av.iid
    win_edit[ pi ] = false
    if [ ux ] ux.restyle = true

# its code in front: the app is in edit mode from now
func orbiter.pane_show_code [ pi: i32 ]
    av : AppView pane_av[ pi ]
    if [ !av ] return
    av.edited      = true
    win_edit[ pi ] = true
    if [ ux ] ux.restyle = true

# the window shows no app
func orbiter.pane_drop_app [ pi: i32 ]
    if [ !win_iid || pi < 0 || pi >= win_iid.count ] return
    win_iid[ pi ]  = -1
    win_edit[ pi ] = false
    if [ ux ] ux.restyle = true

# a closed window's place goes; later windows move down a place
func orbiter.win_drop [ pi: i32 ]
    if [ win_iid && pi < win_iid.count ] win_iid.remove[ pi ]
    if [ win_edit && pi < win_edit.count ] win_edit.remove[ pi ]

# the app in a window: its frames and its input, nothing else
element AppPane
    public pane : i32
    # the app's picture last shown: a new one repaints
    intern seen : i32 [ -1 ]
    # the app asked for the whole screen: shown on the monitor in a
    # window of its own, orbiter paused, until it lets go or that
    # window is closed (then off until it asks again)
    intern screen : ScreenOut
    intern screen_off : bool
    # the pointer's last place on the screen, in the app's points
    intern mx : i32
    intern my : i32

    func orb [] -> orbiter
        return cast orbiter [ (ux) ? ux.app_object : null ]

    func av [] -> AppView
        o : orb[]
        return (o) ? o.pane_av[ pane ] : null

    public func tick [ w: Window ]
        v : av[]
        if [ !v ] return
        if [ bounds && bounds.w > 0.0 ]
            v.vw = bounds.w
            v.vh = bounds.h
        v.service[ w.screen ]
        if [ v.lock_req != 0 ]
            if [ v.lock_req == 1 ] ux.mouse_lock[ a ]
            el ux.mouse_unlock[]
            v.lock_req = 0
        if [ !v.want_full ] screen_off = false
        if [ v.want_full && !screen_off && !screen && !v.ended ]
            screen = ScreenOut [ vk: w.vk, hidden: ux.hidden,
                title: v.app_mod ]
            if [ !screen.win ]
                screen = null
                screen_off = true
            el
                log 'orbiter: {v.app_mod} on the screen'
                w.pause_for = a
                return
        # its next picture wakes the next frame, drawn here or not
        if [ v.slot >= 0 ] host_watch[ v.slot ]
        # a new picture from the app: shown on this frame
        fr : i32 [ (v.slot >= 0) ? host_tex_front[ v.slot, 0 ] : -1 ]
        if [ fr != seen ]
            seen     = fr
            pristine = false

    # orbiter paused for this app on the screen: its frames shown
    # there, the screen window's keys and mouse to it
    public func on_frame [ w: Window ]
        if [ w.pause_for != a ] return
        v : av[]
        # Escape always takes it off the screen, whatever the app
        # does with keys: no app holds the whole screen against you
        if [ screen && screen_escape[] ] screen_off = true
        if [ v && v.want_full && !v.ended && screen && !screen.shut[]
             && !screen_off ]
            screen.keep_front[]
            # the app takes the screen's size
            v.vw = f32[ screen.width ]
            v.vh = f32[ screen.height ]
            v.service[ w.screen ]
            ft : Texture v.front[]
            if [ ft ]
                screen_input[ v, ft ]
                screen.show[ ft ]
                v.request_frame[ w.screen ]
            el
                screen.events.clear[]
            return
        if [ screen ]
            if [ screen.closed ] screen_off = true
            screen.close[]
            screen = null
            log 'orbiter: {(v) ? v.app_mod : ''} left the screen'
        w.pause_for = null
        w.restyle = true

    # an Escape pressed on the screen window
    func screen_escape [] -> bool
        for [ e: ScreenEvent ] in screen.events
            if [ e.kind == 1 && e.code == 256 && e.state == 1 ]
                return true
        return false

    # the screen window's events to the app, in its points: the
    # picture is fitted to the screen as show draws it
    func screen_input [ v: AppView, t: Texture ]
        if [ v.slot < 0 || t.width <= 0 || t.height <= 0 ] return
        tw : f64 [ t.width ]
        th : f64 [ t.height ]
        k : f64 [ min[ f64[ screen.width ] / tw,
                       f64[ screen.height ] / th ] ]
        ox : f64 [ (f64[ screen.width ] - tw * k) * 0.5 ]
        oy : f64 [ (f64[ screen.height ] - th * k) * 0.5 ]
        px : f64 [ f64[ v.awp[] ] / tw ]
        for [ e: ScreenEvent ] in screen.events
            x : i32 [ (e.x - ox) / k * px ]
            y : i32 [ (e.y - oy) / k * px ]
            if [ e.kind == 1 ]
                host_post2[ v.slot, 1, i32[ HM.key ], e.code, e.state,
                            0 ]
            el [ e.kind == 2 ]
                hm : i32 [ (e.state != 0) ? i32[ HM.press ]
                                          : i32[ HM.release ] ]
                host_post2[ v.slot, 1, hm, mx, my, e.code ]
            el [ e.kind == 3 ]
                mx = x
                my = y
                host_post2[ v.slot, 1, i32[ HM.move ], x, y, 0 ]
            el [ e.kind == 4 ]
                host_post2[ v.slot, 1, i32[ HM.wheel ],
                    i32[ e.dx * 100.0 ], i32[ e.dy * 100.0 ], 0 ]
        screen.events.clear[]

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        v : av[]
        if [ !v ] return
        b : rect [ x: 0.0, y: 0.0, w: bounds.w, h: bounds.h ]
        v.vx = 0.0
        v.vy = 0.0
        v.vw = b.w
        v.vh = b.h
        v.vsx = 0.0
        v.vsy = 0.0
        if [ !v.ended ]
            v.draw_frame[ w.screen, b ]
            return
        # ended: why, where its picture was
        cv : Canvas w.screen
        cv.font_size[ 16 ]
        cv.fill_color[ rgba[ '#ddddddcc' ] ]
        nt : string [ (v.note && v.note.count > 0) ? v.note : 'ended' ]
        cv.draw_text[ '{nt} — F5 or play to run again', b,
            vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.ellipsis,
            null, false ]
        cv.flush_text[ ]

    func on_press [ ev: Event ]
        v : av[]
        if [ v && v.view_press[ ev ] ]
            if [ ux ] ux.set_focus[ a ]
            ev.no_default = true

    func on_release [ ev: Event ]
        v : av[]
        if [ v ] v.view_release[ ev ]

    func on_move [ ev: Event ]
        v : av[]
        if [ !v ] return
        if [ ux.locked == a ]
            v.view_lock_move[ ev ]
            return
        v.view_move[ ev ]

    func on_wheel [ ev: Event ]
        v : av[]
        if [ v && v.view_wheel[ ev ] ] ev.no_default = true

    func on_drop [ ev: Event ]
        v : av[]
        if [ v && !v.held && !v.ended && v.on_drop_text[ ev.key.text ] ]
            ev.no_default = true

    func on_char [ ev: Event ]
        v : av[]
        if [ !v || v.held || v.ended ] return
        o : orb[]
        if [ o && o.nav_driven[] == v && o.nav_type_char[ ev ] ] return
        v.on_text[ ev ]

    func on_key [ ev: Event ]
        v : av[]
        if [ !v || v.held || v.ended ] return
        o : orb[]
        if [ o && o.nav_driven[] == v && o.nav_type_key[ ev ] ] return
        v.on_key[ ev ]

    public func types_plain [] -> bool
        v : av[]
        return v && !v.held && !v.ended && v.app_plain

    public func takes_words [] -> bool
        v : av[]
        if [ v && !v.held && !v.ended ] return v.app_words
        return false
