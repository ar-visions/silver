            fill_color: #220022aa
    }

# the log's filter: a pill at its top right, a field
element ConFind
    focusable : true
    style : CSS {
        layers.face:
            fill_color: #4d3dbccc
            radius: 999
            stroke_width: 1
            stroke_color: #806bffff
            label_color: #ffffff
            label_size: 15
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            editable: true
            label_align: 0.5 0.5
    }

    # the field edits, then the log follows its text
    func on_key [ ev: Event ]
        field_key[ a, ev ]
        o : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ o ] o.con_find_edit[ a ]
        ev.no_default = true

    func on_char [ ev: Event ]
        field_char[ a, ev ]
        o : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ o ] o.con_find_edit[ a ]
        ev.no_default = true

Console RunConsole
    style : CSS {
        # its ground is ConsoleGround, under it
        layers.cbase: Layer
            fill_color: #0000
        layers.content: TermLayer
            area: l0.24 t3px r0.24 b0.24
            label_height: 1.0
            label_size: 16
    }
    # a key typed over the log starts its filter: the pill's field
    # comes up focused and has the rest (its line at the foot takes
    # the app's input)
    public func on_char [ ev: Event ]
        o : cast orbiter [ ux.app_object ]
        if [ !o || !ev.key.text || ev.key.text.count == 0 ] return
        o.con_filter = '{(o.con_filter) ? o.con_filter : ''}{ev.key.text}'
        o.filter_focus = 'con_find'
        filtered[ o ]

    # escape drops the filter; a selection still copies (ctrl / cmd
    # + c)
    public func on_key [ ev: Event ]
        s : ConsoleSession session[]
        o : cast orbiter [ ux.app_object ]
        if [ !s || !o || !ev.key.state ] return
        k : i32 [ i32[ ev.key.unicode ] ]
        f : string [ (o.con_filter) ? o.con_filter : '' ]
        if [ k == 256 && f.count > 0 ]
            o.con_filter = ''
            filtered[ o ]
            ev.no_default = true
            return
        if [ !(ev.key.ctrl || ev.key.meta) ] return
        if [ k != 67 || s.sel_line < 0 ] return
        txt : string s.selection_text[]
        if [ txt.count > 0 && ux ] ux.set_clipboard[ txt ]

    # the lines shown follow the filter; its pill redraws
    func filtered [ o: orbiter ]
        pristine = false
        o.force_update[]

    func filter [] -> string
        o : cast orbiter [ (ux) ? ux.app_object : null ]
        return (o && o.con_filter && o.con_filter.count > 0)
            ? o.con_filter : null

    # lines carry their instance id as '<iid>: '; the pane's selected
    # instance reads blue, the module's other instances fade, untagged
    # lines stay plain
    func line_mark [ ln: string ] -> i32
        if [ !ln ] return 0
        n : i32 [ 0 ]
        i : i32 [ 0 ]
        while [ i < ln.count ]
            c : i32 [ (i32 ln.chars[ i ]) & 255 ]
            if [ c < 48 || c > 57 ] break
            n = n * 10 + (c - 48)
            i += 1
        if [ i == 0 || i >= ln.count || ((i32 ln.chars[ i ]) & 255) != 58 ]
            return 0
        orb : cast orbiter [ ux.app_object ]
        if [ !orb ] return 0
        # the one console is the selected editor's
        ed : Editor orb.pane_at[ orb.active_pane ]
        if [ !ed || !ed.run_view ] return 0
        return (ed.run_view.iid == n) ? 1 : 2


Group ToolsHeader
    style : CSS {
        area: l0 t0 r0 h1.3
        layers.hbar:
            fill_color: #2480
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            stroke_color: #fff1
        layers.hdiv:
            fill_color: #fff2
            area: l0 b0px r0 h1px
    }

# per-source-file state; arguments is the first field, more to come
class file_state
    public args        : string

struct vec2i
    x : i32
    y : i32

class pane_state
    public file      : path
    public selection : vec2i
    public scroll    : f32

# an instance as old sessions kept it; read, never restored
class inst_state
    public src   : path
    public args  : string
    public pip   : bool
    public display : i32
    public debug : bool
    public coverage : bool
    public pane  : i32 [ -1 ]     # the pane showing it, -1 when none

# one extension's files in the index (the first 200)
# a pane's menu as last read, for a window not selected: its
# strip names its menus without a click first
class PaneMenu
    public key   : string
    public items : vec TrayEntry
    public ms    : i64

func orbiter.pane_drop_file [ pi: i32 ]
    if [ pi < 0 || pi >= editor_slots.count ] return
    editor_slots[ pi ] = -1
    ed : Editor pane_at[ pi ]
    if [ ed ]
        ed.src        = null
        ed.loaded_src = null
    save_session[]

func orbiter.win_placed [ wn: u64 ] -> bool
    for [ i: i32 0, i < win_done.count, i += 1 ]
        if [ win_done[ i ] == wn ] return true
    return false

# the dialog over a pane's window, 0 when none
func orbiter.pane_sheet_of [ i: i32 ] -> u64
    if [ i < 0 || !pane_sheet || i >= pane_sheet.count ]
        return u64[ 0 ]
    return pane_sheet[ i ]

# the window a pane shows, 0 when none
func orbiter.pane_window [ i: i32 ] -> u64
    if [ i < 0 || !pane_win || i >= pane_win.count ] return u64[ 0 ]
    return pane_win[ i ]

# newest mtime in scope: newer than the scan = results stale
func orbiter.tree_mtime [ dir: path ] -> i64
    r : i64 [ 0 ]
    entries : dir.ls[ null, false ]
    if [ !entries ] return r
    for [ i: i32 0, i < entries.count, i += 1 ]
        e : path entries[i]
        if [ e.is_dir[] ]
            dn : string e.filename[]
            if [ dn == 'checkout' || dn == '.git' ] continue
            mt : tree_mtime[ e ]
            if [ mt > r ] r = mt
        el [ glob_pass[ e ] ]
            mt : e.modified_time[]
            if [ mt > r ] r = mt
    return r

func orbiter.pane_view [ i: i32 ] -> element
    spl : element panes_el[]
    if [ !spl || !spl.elements ] return null
    d : element spl.elements[ 'pane{i}' ]
    return (d) ? d : find_el[ spl, 'pane{i}' ]

# an element's place in the panes' split (a pane in a split of
# its own has bounds in that split)
func orbiter.split_rect [ e: element ] -> rect
    r : rect world_rect[ e ]
    spl : element panes_el[]
    if [ spl && spl.bounds && spl != e ]
        o : rect world_rect[ spl ]
        r.x -= o.x
        r.y -= o.y
    return r

# a pane's place in the panes' split: a free one's as drawn
func orbiter.pane_spot [ pi: i32 ] -> rect
    if [ pane_floats[ pi ] && pane_shown
         && pi * 4 + 3 < pane_shown.count ]
        return rect [ x: pane_shown[ pi * 4 ],
            y: pane_shown[ pi * 4 + 1 ],
            w: pane_shown[ pi * 4 + 2 ],
            h: pane_shown[ pi * 4 + 3 ] ]
    pv : element pane_view[ pi ]
    if [ !pv || !pv.bounds ] return rect []
    return split_rect[ pv ]

# docked under another (not along the bar): its own strip, as a
# free window's
func orbiter.pane_below [ pi: i32 ] -> bool
    if [ pi < 0 || pane_floats[ pi ] || pane_out[ pi ] ]
        return false
    pv : element pane_view[ pi ]
    if [ !pv || !pv.bounds ] return false
    return split_rect[ pv ].y > 1.0

# a pane added: not a file yet, it opens on the nav list, where
# the location gets picked (its title takes focus)
func orbiter.pane_add []
    if [ editor_slots.count < 4 ]
        editor_slots += -1
        pane_console += ''
        active_pane = editor_slots.count - 1
        pending_finder = active_pane
    save_session[]
    force_update[]

# a closed pane's window, sheet, history and selection go with it;
# the later panes' move down a place
func orbiter.pane_lists_drop [ pi: i32 ]
    if [ pane_win && pi < pane_win.count ] pane_win.remove[ pi ]
    if [ pane_spawn && pi < pane_spawn.count ] pane_spawn.remove[ pi ]
    if [ pane_sheet && pi < pane_sheet.count ]
        pane_sheet.remove[ pi ]
    if [ pending_sel && pi < pending_sel.count ]
        pending_sel.remove[ pi ]
    if [ nav_panes && pi < nav_panes.count ]
        nav_panes.remove[ pi ]
        nav_panes += Navigate []
    if [ !placed_pane ] return
    j : i32 [ placed_pane.count - 1 ]
    while [ j >= 0 ]
        pp : i32 placed_pane[ j ]
        if [ pp == pi ]
            placed_pane.remove[ j ]
            if [ placed_win && j < placed_win.count ]
                placed_win.remove[ j ]
        el [ pp > pi ]
            placed_pane[ j ] = pp - 1
        j -= 1

# a closed pane's free place goes; later panes move down a place
func orbiter.free_drop [ pi: i32 ]
    if [ pane_free && pane_free.count >= (pi + 1) * 4 ]
        for [ r: i32 0, r < 4, r += 1 ]
            pane_free.remove[ pi * 4 ]
    if [ pane_shown && pane_shown.count >= (pi + 1) * 4 ]
        for [ r: i32 0, r < 4, r += 1 ]
            pane_shown.remove[ pi * 4 ]
    if [ !free_order ] return
    fo : i32 [ free_at[ pi ] ]
    if [ fo >= 0 ] free_order.remove[ fo ]
    for [ j: i32 0, j < free_order.count, j += 1 ]
        if [ free_order[ j ] > pi ]
            free_order[ j ] = free_order[ j ] - 1

# the Editor of the pane an element lives in
func orbiter.pane_of [ e: element ] -> Editor
    for [ e_: element* e, e_, e_ = e_.parent ]
        if [ e_ inherits EditorView ]
            ev_ : EditorView e_
            return pane_at[ ev_.pane_index ]
        # the status bar, the side panel (the instance's properties)
        # and the console act for the selected editor
        if [ e_ inherits StatusBar || e_ inherits SidePanel
             || e_ inherits RunBand || e_ inherits MenuDrawer ]
            return pane_at[ active_pane ]
    return null

# the pane an element sits in, or -1
func orbiter.pane_index_of [ e: element ] -> i32
    for [ e_: element* e, e_, e_ = e_.parent ]
        if [ e_ inherits EditorView ]
            ev_ : EditorView e_
            return ev_.pane_index
    return -1

func orbiter.pane_at [ i: i32 ] -> Editor
    pv : element pane_view[ i ]
    if [ !pv || !pv.elements ] return null
    return editor_under[ pv.elements[ 'split' ] ]

# a pane is docked (in the split)
# the panes in the layout's order (left to right, top to bottom)
func orbiter.pane_order [] -> vec i32
    sq : vec i32 []
    tree[].leaves[ sq ]
    return sq

# the layout kept; pane_seq its panes in order
func orbiter.tree_set [ t: PaneNode ]
    # panes moved into other splits get new editors
    relay_keep[]
    t.tidy[]
    out : vec i32 []
    t.write[ out ]
    pane_tree = out
    sq : vec i32 []
    t.leaves[ sq ]
    pane_seq = sq

# a new order of the panes (null: in number order): the layout
# keeps its splits, its panes taken in this order; a pane new to
# it put before the one after it (else after the one before)
func orbiter.seq_set [ sq: vec i32 ]
    if [ !sq ]
        pane_seq  = null
        pane_tree = null
        return
    t : PaneNode tree[]
    have : vec i32 []
    t.leaves[ have ]
    for [ q: i32 ] in have
        if [ sq.index_of[ q ] < 0 ] t.drop_leaf[ q ]
    for [ j: i32 0, j < sq.count, j += 1 ]
        q : i32 sq[ j ]
        if [ have.index_of[ q ] >= 0 ] continue
        put : bool [ j + 1 < sq.count
            && t.put_beside[ q, sq[ j + 1 ], false ] ]
        if [ !put && j > 0 ]
            put = t.put_beside[ q, sq[ j - 1 ], true ]
        if [ !put ] t.kids.push[ PaneNode [ pane: q ] ]
    t.relabel[ sq, TreeAt [] ]
    tree_set[ t ]

# the panes left to right before the layout: pane_seq when it
# names each pane once, else by number
func orbiter.seq_flat [] -> vec i32
    n : i32 [ i32[ editor_slots.count ] ]
    ok : bool [ pane_seq && pane_seq.count == n ]
    if [ ok ]
        for [ q: i32 0, q < n, q += 1 ]
            if [ pane_seq.index_of[ q ] < 0 ] ok = false
    if [ ok ] return pane_seq
    sq : vec i32 []
    for [ q: i32 0, q < n, q += 1 ] sq.push[ q ]
    return sq

# a maximized window dragged sideways: the desktop (a pane of its
# own) split in beside it, the window on the side it went to;
# false when it is not the only docked pane
func orbiter.split_side [ pi: i32, right: bool ] -> bool
    if [ editor_slots.count >= 4 || pane_floats[ pi ]
         || pane_out[ pi ] ]
        return false
    for [ q: i32 0, q < editor_slots.count, q += 1 ]
        if [ q != pi && !pane_floats[ q ] && !pane_out[ q ] ]
            return false
    was : vec i32 pane_order[]
    editor_slots += -1
    pane_console += ''
    n : i32 [ i32[ editor_slots.count ] - 1 ]
    sq : vec i32 []
    # the desktop on the side the window left
    if [ right ] sq.push[ n ]
    for [ q: i32 ] in was
        sq.push[ q ]
    if [ !right ] sq.push[ n ]
    seq_set[ sq ]
    active_pane = pi
    save_session[]
    force_update[]
    if [ ux ] ux.restyle = true
    return true

# pi is a half of a drag's split showing something: docked, in
# view, beside another docked pane
func orbiter.split_half [ pi: i32 ] -> bool
    if [ !pane_seq || pane_floats[ pi ] || pane_out[ pi ]
         || pane_empty[ pi ] ]
        return false
    for [ q: i32 0, q < editor_slots.count, q += 1 ]
        if [ q != pi && !pane_floats[ q ] && !pane_out[ q ] ]
            return true
    return false

func orbiter.pane_showing [ av: AppView ] -> i32
    wv : u64 window_of[ av ]
    for [ q: i32 0, q < editor_slots.count, q += 1 ]
        edq : Editor pane_at[ q ]
        if [ (wv != 0 && pane_window[ q ] == wv)
             || (wv == 0 && edq && edq.run_view == av) ]
            return q
    return -1

# the free panes' keys, bottom to top, each with its ring; the
# desktop under them when nothing is docked
func orbiter.free_ids [] -> vec string
    ids : vec string []
    if [ !any_docked[] ] ids.push[ 'desk' ]
    for [ hi: i32 0, hi < editor_slots.count, hi += 1 ]
        if [ pane_out[ hi ] && !pane_floats[ hi ] ]
            ids.push[ 'pane{hi}' ]
    # every free one, in its stack order; one left out of the
    # order (a group's hidden member) under them all: else the
    # split would lay its pieces out as columns
    fo : vec i32 []
    for [ fi: i32 0, fi < editor_slots.count, fi += 1 ]
        if [ pane_floats[ fi ] && free_at[ fi ] < 0 ] fo.push[ fi ]
    if [ free_order ]
        for [ fi: i32 ] in free_order
            fo.push[ fi ]
    for [ fi: i32 ] in fo
        if [ !pane_floats[ fi ] ] continue
        ids.push[ 'shade{fi}' ]
        ids.push[ 'ground{fi}' ]
        ids.push[ 'pane{fi}' ]
        ids.push[ 'edge{fi}' ]
        for [ sd: i32 ] in grip_sides[]
            ids.push[ 'grip{fi}_{sd}' ]
    return ids

# where a pane is in free_order, or -1
func orbiter.free_at [ i: i32 ] -> i32
    if [ !free_order ] return -1
    for [ j: i32 0, j < free_order.count, j += 1 ]
        if [ free_order[ j ] == i ] return j
    return -1

# a phone has no free windows: every pane fills the screen
func orbiter.pane_floats [ i: i32 ] -> bool
    if [ mobile_on[] ] return false
    k : i32 [ i * 4 + 2 ]
    return i >= 0 && pane_free && k < pane_free.count
        && pane_free[ k ] > 0.0

# its place set; a docked pane pulled free keeps its size, two
# thirds of it when it filled the area
func orbiter.pull_free [ i: i32, pv: element ]
    if [ mobile_on[] || pane_floats[ i ] || !pv || !pv.bounds ]
        return
    # a half of a side-by-side split: a desktop takes its place,
    # the other half kept where it is; beside a desktop alone,
    # that desktop takes the whole width
    beside : bool [ false ]
    for [ q: i32 0, q < editor_slots.count, q += 1 ]
        if [ q != i && !pane_floats[ q ] && !pane_out[ q ]
             && !pane_empty[ q ] ]
            beside = true
    if [ beside && editor_slots.count < 4 ]
        was : vec i32 pane_order[]
        editor_slots += -1
        pane_console += ''
        n : i32 [ i32[ editor_slots.count ] - 1 ]
        sq : vec i32 []
        for [ q: i32 ] in was
            if [ q == i ] sq.push[ n ]
            sq.push[ q ]
        seq_set[ sq ]
    if [ !pane_free ] pane_free = vec f32 []
    if [ !free_order ] free_order = vec i32 []
    if [ !pane_shown ] pane_shown = vec f32 []
    while [ pane_free.count < (i + 1) * 4 ]
        pane_free.push[ 0.0 ]
    while [ pane_shown.count < (i + 1) * 4 ]
        pane_shown.push[ 0.0 ]
    # its place in the panes' split (in a split of its own too)
    pr : rect split_rect[ pv ]
    sp : element panes_el[]
    aw : f32 [ (sp && sp.bounds) ? sp.bounds.w : pr.w ]
    ah : f32 [ (sp && sp.bounds) ? sp.bounds.h : pr.h ]
    fw : f32 [ pr.w ]
    fh : f32 [ pr.h ]
    if [ fw >= aw * 0.8 ] fw = round[ fw * 0.66 ]
    if [ fh >= ah * 0.8 ] fh = round[ fh * 0.66 ]
    k : i32 [ i * 4 ]
    pane_free[ k ]     = pr.x + (pr.w - fw) * 0.5
    pane_free[ k + 1 ] = pr.y
    pane_free[ k + 2 ] = fw
    pane_free[ k + 3 ] = fh
    # an app's own shape: as wide as fits two thirds of the height
    fit_free[ i, false ]
    if [ pane_free[ k + 3 ] > round[ ah * 0.66 ] ]
        pane_free[ k + 3 ] = round[ ah * 0.66 ]
        fit_free[ i, true ]
        pane_free[ k ] = pr.x
            + (pr.w - pane_free[ k + 2 ]) * 0.5
    # it eases from where it sat docked
    pane_shown[ k ]     = pr.x
    pane_shown[ k + 1 ] = pr.y
    pane_shown[ k + 2 ] = pr.w
    pane_shown[ k + 3 ] = pr.h
    fo : i32 [ free_at[ i ] ]
    if [ fo >= 0 ] free_order.remove[ fo ]
    free_order.push[ i ]
    force_update[]

# a free window left with nothing (its app closed) closes; the
# last pane docks instead, the desktop
func orbiter.free_empty_close []
    desk_merge[]
    if [ !free_order ] return
    for [ i: i32 0, i < editor_slots.count, i += 1 ]
        if [ !pane_floats[ i ] || !pane_empty[ i ] ] continue
        if [ pane_out[ i ] ] continue
        if [ pane_browsing[ i ] || pending_finder == i ] continue
        # a minimized window coming back into it, or an app whose
        # file loads first (shown a frame later)
        if [ mini_wait >= 0 && i == mini_pane ] continue
        if [ pending_show > 0 && i == pending_show_pane ] continue
        # a dock press's new tab, its app about to start
        if [ (launch_wait || launch_tab == i) && i == active_pane ]
            continue
        if [ editor_slots.count == 1 ]
            dock_pane[ i ]
        el
            close_pane[ i ]
        force_update[]
        return

# projection: inline panes in order, then the agent console
func orbiter.pane_views [] -> Elements
    t : Elements []
    # the docked panes in view, laid out by the layout after
    docked : Elements []
    # the full navigator up: the free windows fade out of sight
    # (still running), back as it shuts; it fades in
    # the agents view up: they are put away as well
    agents : bool [ home_tab == 'agent' && home_seen[] ]
    away : bool [ nav_fade >= 1.0 || agents ]
    seen : f32 [ (agents) ? 0.0 : 1.0 - nav_fade ]
    for [ i: i32 ] in pane_order[]
        # free said every render: a docked pane said nothing and
        # kept a window's rounded mask
        # empty said here too: a pane re-keyed by a close took a
        # frame to say it itself, its dark ground over the desktop
        file_slot : i32 [
            (i < editor_slots.count) ? editor_slots[ i ] : -1 ]
        empty : bool [ !(i < pane_console.count
                         && pane_console[ i ].count > 0)
            && !(file_slot >= 0 && file_slot < open_files.count
                 && open_files[ file_slot ])
            && !pane_browsing[ i ] ]
        ev : EditorView [ pane_index: i, free: false,
            selected: (search_pane[] == 'pane{i}'), is_empty: empty ]
        # said every render, shown or not: a mounted pane keeps a
        # hide (or a faded look) it is not told again
        ev.hide    = pane_gone[ i ]
        ev.opacity = 1.0
        ev.topmost = false
        if [ pane_out[ i ] && !pane_floats[ i ] ]
            # docked, fading over the desktop at its place:
            # see-through and blurred as it goes
            fd : f32 fade_of[ i ]
            k : i32 [ i * 4 ]
            rx : f32 [ (pane_rect && k + 3 < pane_rect.count)
                ? pane_rect[ k ] : 0.0 ]
            ry : f32 [ (pane_rect && k + 3 < pane_rect.count)
                ? pane_rect[ k + 1 ] : 0.0 ]
            rw : f32 [ (pane_rect && k + 3 < pane_rect.count)
                ? pane_rect[ k + 2 ] : 0.0 ]
            rh : f32 [ (pane_rect && k + 3 < pane_rect.count)
                ? pane_rect[ k + 3 ] : 0.0 ]
            ev.topmost = true
            ev.opacity = (1.0 - fd) * (1.0 - fd)
            ev.blur_px = fd * (2.0 - fd) * 36.0
            ev.area = Region [ 'l{rx}px t{ry}px w{rw}px h{rh}px' ]
            t['pane{i}'] = ev
            continue
        # a window fades and blurs whole: it, its shadow, ground
        # and edge (none of it drawn once gone)
        fo : f32 fade_of[ i ]
        out : bool [ away || pane_gone[ i ] ]
        ev.blur_px = fo * (2.0 - fo) * 36.0
        if [ nav_fade < 1.0 && !pane_floats[ i ]
             && pane_browsing[ i ] ]
            ev.opacity = nav_fade
        if [ pane_floats[ i ] ]
            k : i32 [ i * 4 ]
            fx : f32 [ round[ pane_shown[ k ] ] ]
            fy : f32 [ round[ pane_shown[ k + 1 ] ] ]
            fw : f32 [ round[ pane_shown[ k + 2 ] ] ]
            fh : f32 [ round[ pane_shown[ k + 3 ] ] ]
            ev.topmost = true
            ev.free    = true
            ev.hide    = out
            ev.opacity = seen * (1.0 - fo) * (1.0 - fo)
            # fading or gone: presses pass it by
            ev.user_events = nav_fade <= 0.0 && !agents
                && !pane_out[ i ]
            ev.area = Region [
                'l{fx}px t{fy}px w{fw}px h{fh}px' ]
            # its shadow and outline, under it
            sh : f32 [ 24.0 ]
            sx : f32 [ fx - sh ]
            sy : f32 [ fy - sh ]
            sw : f32 [ fw + sh * 2.0 ]
            shh : f32 [ fh + sh * 2.0 ]
            t['shade{i}'] = WinShade [ topmost: true, hide: out,
                opacity: seen * (1.0 - fo) * (1.0 - fo),
                blur_px: fo * (2.0 - fo) * 36.0,
                area: Region [
                    'l{sx}px t{sy}px w{sw}px h{shh}px' ] ]
            # its piece of the screen's ground, as a docked pane
            # has under it
            t['ground{i}'] = WinGround [ topmost: true, hide: out,
                opacity: seen * (1.0 - fo) * (1.0 - fo),
                blur_px: fo * (2.0 - fo) * 36.0,
                area: Region [ 'l{fx}px t{fy}px w{fw}px h{fh}px' ] ]
            t['pane{i}'] = ev
            t['edge{i}'] = WinEdge [ topmost: true, hide: out,
                opacity: seen * (1.0 - fo) * (1.0 - fo),
                blur_px: fo * (2.0 - fo) * 36.0, selected: ev.selected,
                area: Region [ 'l{fx}px t{fy}px w{fw}px h{fh}px' ] ]
            if [ nav_fade <= 0.0 && !agents && !fixed_win[ i ]
                 && !pane_out[ i ] ]
                grips_of[ t, i, fx, fy, fw, fh ]
            continue
        docked['pane{i}'] = ev
    tree_els[ tree[], t, docked, 'split', false ]
    # nothing docked: the desktop (the apps) under the free windows
    if [ !any_docked[] ]
        t['desk'] = HomeView [ pane: -1,
            area: Region { l0 t0 r0 b0 } ]
    if [ agent_open ]
        t['pane{editor_slots.count}'] = EditorView [
            pane_index: editor_slots.count,
            selected: (search_pane[] == 'pane{editor_slots.count}') ]
    return t

# a pane of the layout's in view under n
func orbiter.tree_shows [ n: PaneNode, docked: Elements ] -> bool
    if [ n.pane >= 0 ]
        pe : element docked[ 'pane{n.pane}' ]
        return pe != null
    for [ k: PaneNode ] in n.kids
        if [ tree_shows[ k, docked ] ] return true
    return false

# the app a pane shows: its editor's, else its window's
func orbiter.pane_instance [ pi: i32 ] -> AppView
    ed : Editor pane_at[ pi ]
    if [ ed && ed.run_view ] return ed.run_view
    wv : u64 pane_window[ pi ]
    if [ wv != 0 && instances ]
        for [ v: AppView ] in instances
            if [ window_of[ v ] == wv ] return v
    return null

# put out of view by minimize
func orbiter.pane_hidden [ pi: i32 ] -> bool
    return pane_hid && pi >= 0 && pi < pane_hid.count && pane_hid[ pi ]

# out of the split: hidden, or fading out or in over the desktop
func orbiter.pane_out [ pi: i32 ] -> bool
    return pane_hidden[ pi ] || fade_of[ pi ] > 0.0

# hidden and faded wholly: not drawn
func orbiter.pane_gone [ pi: i32 ] -> bool
    return pane_hidden[ pi ] && fade_of[ pi ] >= 1.0

# a pane's group, -1 none
func orbiter.grp_of [ pi: i32 ] -> i32
    if [ !pane_grp || pi < 0 || pi >= pane_grp.count ] return -1
    return pane_grp[ pi ]

func orbiter.grp_set [ pi: i32, g: i32 ]
    if [ !pane_grp ] pane_grp = vec i32 []
    while [ pane_grp.count < editor_slots.count ] pane_grp.push[ -1 ]
    if [ pi >= 0 && pi < pane_grp.count ] pane_grp[ pi ] = g

# a group's panes, in pane order
func orbiter.grp_members [ g: i32 ] -> vec i32
    out : vec i32 []
    if [ g < 0 ] return out
    for [ q: i32 0, q < editor_slots.count, q += 1 ]
        if [ grp_of[ q ] == g ] out.push[ q ]
    return out

# a group's member shown in the place of the one shown now
func orbiter.grp_show [ b: i32 ]
    g : i32 grp_of[ b ]
    if [ g < 0 ] return
    for [ q: i32 ] in grp_members[ g ]
        if [ q != b && !pane_hidden[ q ] ]
            take_place[ b, q ]
            hide_now[ q ]
    show_now[ b ]
    raise_pane[ b ]
    if [ ux ] ux.restyle = true
    force_update[]

# mv's window put in onto's group (a new one when it has none),
# shown there in onto's place
func orbiter.grp_join [ mv: i32, onto: i32 ]
    if [ mv == onto || mv < 0 || onto < 0 ] return
    if [ grp_of[ mv ] >= 0 ] grp_leave[ mv, false ]
    g : i32 grp_of[ onto ]
    if [ g < 0 ]
        g = 0
        for [ q: i32 0, q < editor_slots.count, q += 1 ]
            if [ grp_of[ q ] >= g ] g = grp_of[ q ] + 1
        grp_set[ onto, g ]
    grp_set[ mv, g ]
    grp_show[ mv ]
    log 'groups: window {mv} joined window {onto} (group {g})'

# a member out of its group: another member takes its place; it
# stays where it is (free at the pointer when it was dragged out)
func orbiter.grp_leave [ gone: i32, free_at_pointer: bool ]
    g : i32 grp_of[ gone ]
    if [ g < 0 ] return
    rest : vec i32 []
    for [ q: i32 ] in grp_members[ g ]
        if [ q != gone ] rest.push[ q ]
    grp_set[ gone, -1 ]
    if [ rest.count > 0 && !pane_hidden[ gone ] ]
        nx : i32 rest[ 0 ]
        take_place[ nx, gone ]
        show_now[ nx ]
    if [ rest.count > 0 ]
        if [ free_at_pointer && ux ]
            # the left member free, under the pointer
            w0 : f32 [ (ux.root && ux.root.bounds)
                ? ux.root.bounds.w : 1280.0 ]
            h0 : f32 [ (ux.root && ux.root.bounds)
                ? ux.root.bounds.h : 800.0 ]
            fw : f32 [ round[ w0 * 0.42 ] ]
            fh : f32 [ round[ h0 * 0.62 ] ]
            m : vec2f ux.last_move
            pane_free[ gone * 4 ]     = m.x - fw * 0.5
            pane_free[ gone * 4 + 1 ] = m.y - 12.0
            pane_free[ gone * 4 + 2 ] = fw
            pane_free[ gone * 4 + 3 ] = fh
            for [ r: i32 0, r < 4, r += 1 ]
                pane_shown[ gone * 4 + r ] = pane_free[ gone * 4 + r ]
            if [ free_at[ gone ] < 0 ] free_order.push[ gone ]
    if [ rest.count == 1 ] grp_set[ rest[ 0 ], -1 ]
    show_now[ gone ]
    raise_pane[ gone ]
    if [ ux ] ux.restyle = true
    force_update[]

# the tab let go: on the panes' left, right or bottom edge, the
# whole layout split there with the window on that side; on the
# dock, minimized; over another window, the two grouped;
# elsewhere, out of its group, free there
func orbiter.tab_drop [ pi: i32 ]
    tab_drag = -1
    if [ !ux ] return
    k : i32 drop_kind[ ux.last_move, pi ]
    if [ (k >= 1 && k <= 3) || k == 7 ] dock_edge[ pi, k ]
    el [ k == 4 ] tab_dock[ pi ]
    el [ k == 5 ] grp_join[ pi, drop_win ]
    el [ k == 6 ] take_empty[ pi, drop_win ]
    el [ k == 8 ] dock_full[ pi ]
    el [ k == 0 && grp_of[ pi ] >= 0 ] grp_leave[ pi, true ]
    if [ ux ] ux.restyle = true

# a pane docked and in view under n
func orbiter.tree_docked [ n: PaneNode ] -> bool
    if [ n.pane >= 0 ]
        return !pane_floats[ n.pane ] && !pane_out[ n.pane ]
    for [ c: PaneNode ] in n.kids
        if [ tree_docked[ c ] ] return true
    return false

# each pane's app shown, caret and scroll, kept for its editor
# made anew by the layout (a pane moved into another split)
func orbiter.relay_keep []
    n : i32 [ i32[ editor_slots.count ] ]
    if [ !pending_app ]    pending_app    = vec i32 []
    if [ !relay_old ]      relay_old      = vec Editor []
    if [ !pending_sel ]    pending_sel    = vec vec2i []
    if [ !pending_scroll ] pending_scroll = vec f32 []
    while [ pending_app.count < n ]    pending_app    += -1
    while [ relay_old.count < n ]      relay_old      += null
    while [ pending_sel.count < n ]
        pending_sel += vec2i [ x: -1, y: 0 ]
    while [ pending_scroll.count < n ] pending_scroll += -1.0
    relay_at = epoch_millis[]
    # a pane with no editor yet keeps what it waits for
    for [ i: i32 0, i < n, i += 1 ]
        e_ : Editor pane_at[ i ]
        if [ !e_ ] continue
        shown : bool [ e_.app_view && e_.run_view
                       && !e_.run_view.ended ]
        pending_app[ i ]    = (shown) ? e_.run_view.iid : -1
        relay_old[ i ]      = e_
        pending_sel[ i ]    = vec2i [ x: e_.sel_line,
                                      y: e_.sel_col ]
        pending_scroll[ i ] = e_.scroll.y

# the app a pane showed before a layout change made its editor
# anew (null: none, or taken)
func orbiter.relay_take [ pi: i32 ] -> AppView
    if [ !pending_app || pi < 0 || pi >= pending_app.count ]
        return null
    iid : i32 [ pending_app[ pi ] ]
    if [ iid < 0 ] return null
    pending_app[ pi ] = -1
    av : AppView instance_by[ iid ]
    ed : Editor pane_at[ pi ]
    return (av && !av.ended && relay_fits[ ed, av ]) ? av : null

# a pane's editor made anew by a layout change (a renumber, a
# move): its kept app shown again (a hidden tab makes its editor
# when shown: no time limit)
func orbiter.relay_one [ i: i32, e: Editor ]
    if [ !e || !pending_app || i >= pending_app.count
         || pending_app[ i ] < 0 || e == relay_old[ i ] ] return
    ra : AppView instance_by[ pending_app[ i ] ]
    pending_app[ i ] = -1
    if [ ra && !ra.ended && relay_fits[ e, ra ] ]
        e.run_view = ra
        e.app_view = true
        e.pristine = false

# every pane's, before a frame is laid out: the bar never sees a
# moment of its source
func orbiter.relay_apply []
    for [ i: i32 0, i < editor_slots.count, i += 1 ]
        relay_one[ i, pane_at[ i ] ]

# a kept app goes to a pane's new editor only where it belongs: its
# source or document there (the kept list says which window; other
# editors hold their old apps for a frame as they are renumbered)
func orbiter.relay_fits [ ed: Editor, av: AppView ] -> bool
    if [ !ed || !av ] return false
    if [ !ed.src ] return true
    es : string '{ed.src.absolute[]}'
    if [ av.src && '{av.src.absolute[]}' == es ] return true
    return av.doc && '{av.doc.absolute[]}' == es

# a closed pane's kept entries out, after the later panes moved
# down a place (tree_set kept them by the old numbers)
func orbiter.relay_drop [ pi: i32 ]
    n : i32 [ i32[ editor_slots.count ] ]
    if [ pending_app && pi < pending_app.count
         && pending_app.count > n ]
        pending_app.remove[ pi ]
    if [ relay_old && pi < relay_old.count && relay_old.count > n ]
        relay_old.remove[ pi ]
    if [ pending_sel && pi < pending_sel.count
         && pending_sel.count > n ]
        pending_sel.remove[ pi ]
    if [ pending_scroll && pi < pending_scroll.count
         && pending_scroll.count > n ]
        pending_scroll.remove[ pi ]

# the window let go on the dock: out of view, its entry there
func orbiter.tab_dock [ pi: i32 ]
    if [ grp_of[ pi ] >= 0 ] grp_leave[ pi, false ]
    minimize[ pi ]

func orbiter.pane_hit [ q: i32, m: vec2f ] -> bool
    pv : element pane_view[ q ]
    if [ !pv || !pv.bounds ] return false
    r : rect world_rect[ pv ]
    return m.x >= r.x && m.x < r.x + r.w
        && m.y >= r.y && m.y < r.y + r.h

# a pane's name on a tab: its app, its window's program, its title
func orbiter.pane_label [ pi: i32 ] -> string
    nm : string tab_title[ pi ]
    if [ nm.count > 0 ] return nm
    pv : element pane_view[ pi ]
    if [ pv && pv inherits EditorView ]
        return (cast EditorView [ pv ]).title_text[]
    return 'window'

# a running app's or window's tab: its title, else its name
# ('' when neither runs in the pane)
func orbiter.tab_title [ pi: i32 ] -> string
    nm : string [ (pane_window[ pi ] == 0) ? app_name_of[ pi ]
        : window_program[ pi ] ]
    if [ nm.count == 0 ] return ''
    # an address app (aura): its name; the address is the field
    # after it, to edit
    ed : Editor pane_at[ pi ]
    rv : AppView (ed && ed.app_view) ? ed.run_view : null
    if [ rv && !rv.ended && pane_window[ pi ] == 0 && url_app[ rv ] ]
        return nm
    tt : string bar_title_of[ pi ]
    return (tt.count > 0) ? tt : nm

# the pane shows the navigator
func orbiter.pane_browsing [ pi: i32 ] -> bool
    return (nav_showing || find_showing)
        && search_pane[] == 'pane{pi}'

# a file's views (git, B16 ...) as buttons ending at xr, lit while
# shown; the x where they start (xr when none)
func orbiter.pane_views_el [ t: Elements, pi: i32, xr: f32 ] -> f32
    ed : Editor pane_at[ pi ]
    if [ !ed || ed.app_view ] return xr
    vs : vec string file_views[ ed ]
    if [ vs.count == 0 ] return xr
    cur : string ed.resolve_view[]
    vw : f32 [ 1.33 * unit_px[] ]
    bw : f32 [ vw * f32[ vs.count ] ]
    for [ i: i32 0, i < vs.count, i += 1 ]
        v : string vs[ i ]
        ci : string console_icon[ v ]
        ic : string [ (ci) ? ci : v ]
        lit : bool [ (v == 'git') ? ed.git_on : v == cur ]
        vx : f32 [ xr - bw + vw * f32[ i ] ]
        svg : path 'images/{ic}.svg'
        # a view with no icon file shows its name
        if [ svg.exists[] ]
            t['pview:{pi}:{v}'] = bar_icon[ ic, 0.5, lit, false,
                vx, vw ]
        el
            t['pview:{pi}:{v}'] = BarButton [ label: v,
                selected: lit, use_spacing: false,
                area: Region [ 'l{vx}px t0 w{vw}px b0' ] ]
    return xr - bw

# a window's left edge in the root's space: its place in the
# panes' area plus that area's own (the dock)
func orbiter.win_left [ pi: i32 ] -> f32
    # docked: pane_left is already the window's own x
    if [ !pane_floats[ pi ] ] return pane_left[ pi ]
    pv : element pane_view[ pi ]
    pe : element (pv) ? pv.parent : null
    off : f32 [ 0.0 ]
    for [ e: element* pe, e, e = e.parent ]
        if [ e.bounds ] off += e.bounds.x
    return win_x[ pi ] + off

# a free window's strip: the system bar it took with it (its
# menus, its title, its arrows and close), w px wide
func orbiter.strip_els [ pi: i32, w: f32 ] -> Elements
    t : Elements []
    if [ !ux ] return t
    uu : f32 ux_unit[ ux ]
    # end to end: the window's mask rounds the corner buttons
    x : f32 menu_group_els[ t, 0.0, uu, pi, 's{pi}_' ]
    rx : f32 pane_close_el[ t, pi, w ]
    vx : f32 nav_arrows_el[ t, pi, rx ]
    x = pane_outline_el[ t, pi, x, 's{pi}_' ]
    # the load mark left of the arrows, as on the bar; a navigator
    # (or a dialog up in it) picks its folder by its path's pieces
    navc : bool [ (pi == active_pane && nav_driven[] && !nav_app)
                  || pane_browsing[ pi ] ]
    lw : f32 [ 1.33 * unit_px[] ]
    if [ !navc && pane_app_on[ pi ] && pane_loads[ pi ]
         && vx - lw > x ]
        t['bar_load_{pi}'] = bar_icon[ 'eject', 0.5, false, false,
            vx - lw, lw ]
        vx -= lw
    pad : f32 [ 10.0 * uu ]
    # code in it: its file's path as pieces, as on the bar
    sed : Editor pane_at[ pi ]
    # a navigator in it (the selected one): its folder's pieces
    if [ navc && vx - x > pad ]
        x = crumbs_el[ t,
            (nav.nav_root) ? '{nav.nav_root.absolute[]}' : '',
            's{pi}_', -1, false, x + 8.0 * uu, vx - 8.0 * uu, uu ]
    el [ pane_code_file[ pi ].count > 0 && sed && vx - x > pad ]
        x = crumbs_el[ t, '{sed.src.absolute[]}', 's{pi}_', pi,
                       true, x, vx, uu ]
    # the selected window's address (a URL app): the bar's field
    # and the grab under it, a click edits it as on the bar
    el [ pi == active_pane && bar_url_on[] && vx > x ]
        if [ !bar_typing ]
            t['bar_grab'] = BarGrab [ pane: pi, url: true,
                area: Region [ 'l{x}px t0 w{vx - x}px b0' ] ]
        bar_title_el[ t, bar_title[], x, vx ]
    return t

# a pane on its Open page: no file, no app running in it
func orbiter.pane_empty [ pi: i32 ] -> bool
    # no pane (every window free): nothing in it
    if [ pi < 0 ] return true
    # a window's pane has no editor
    if [ pane_window[ pi ] != 0 ] return false
    # a terminal in it (an agent's, a console): not empty
    if [ pi < pane_console.count && pane_console[ pi ].count > 0 ]
        return false
    ed : Editor pane_at[ pi ]
    if [ !ed ] return true
    rv : AppView ed.run_view
    if [ rv && !rv.ended ] return false
    return !ed.src

# a pane's left edge in the window, from this frame's layout (the
# split's eased place), not the pointer's last walk
func orbiter.pane_left [ pi: i32 ] -> f32
    x : f32 [ 0.0 ]
    for [ e: element* pane_view[ pi ], e, e = e.parent ]
        if [ e.bounds ] x += e.bounds.x
        if [ e.parent ] x -= e.parent.scroll.x
    return x

func orbiter.pane_entry [ act: string ] -> bool
    # a separator has no action
    if [ !act ] return false
    return act == 'orb.shot'
        || act.starts_with[ 'orb.code:' ]
        || act.starts_with[ 'orb.inst:' ] || act == 'orb.inst_new'
        || act == 'orb.git' || act == 'orb.prule'
        || act == 'orb.paneroot' || act.starts_with[ 'orb.pview:' ]
        || act == 'orb.build' || act == 'orb.clean'
        || act == 'orb.con'

# the instance whose program's window pane pi shows (null: none)
func orbiter.win_app [ pi: i32 ] -> AppView
    wv : u64 pane_window[ pi ]
    if [ wv == 0 || !instances ] return null
    for [ av: AppView ] in instances
        if [ window_of[ av ] == wv ] return av
    return null

# a program window's app: the module that started it (steam), else
# the program
func orbiter.win_app_name [ av: AppView ] -> string
    d : path inst_reg[].app_dir[ av ]
    if [ av.origin && d ] return d.filename[]
    return app_name[ av ]

# the pane's controls under the app's own menu (its first): a
# pane added, this one closed, git, its views
func orbiter.pane_menu []
    # the desktop (the apps) is no pane: Widgets alone, no
    # instances, no split, no hide, no quit
    if [ active_pane >= 0 && pane_empty[ active_pane ] ] return
    if [ !menu_items ] menu_items = vec TrayEntry []
    keep : vec TrayEntry []
    for [ e: TrayEntry ] in menu_items
        if [ !pane_entry[ e.action ] ] keep.push[ e ]
    menu_items = keep
    f : i32 [ -1 ]
    for [ i: i32 0, i < menu_items.count, i += 1 ]
        if [ f < 0 && menu_items[ i ].depth == 0
             && !menu_items[ i ].rule ] f = i
    # a program's own window (steam's): its app, not the console it
    # runs in (that console's entries are not its)
    wa : AppView win_app[ active_pane ]
    # no app menu (a file in the editor): one named for it; a
    # program's window: for its app
    if [ f < 0 ]
        nm : string bar_title[]
        dt : i32 [ nm.rindex_of[ '.' ] ]
        if [ dt > 0 ] nm = nm.mid[ 0, dt ]
        if [ wa ] nm = win_app_name[ wa ]
        if [ nm.count == 0 ] nm = 'Pane'
        menu_items.push[ own_entry[ nm, 'orb.paneroot', 0 ] ]
        f = menu_items.count - 1
    # no instances here, and no new one: an instance made over
    # another hid it; apps start from the dock, desktop and play
    at : i32 [ f + 1 ]
    while [ at < menu_items.count && menu_items[ at ].depth > 0 ]
        at += 1
    # quit stays the last: ours go before it (and its rule)
    for [ q: i32 f + 1, q < at, q += 1 ]
        qe : TrayEntry menu_items[ q ]
        if [ qe.depth == 1 && !qe.rule
             && (qe.action == 'orb.quit' || qe.label == 'Quit') ]
            at = (q > f + 1 && menu_items[ q - 1 ].rule) ? q - 1 : q
            break
    add : vec TrayEntry []
    # the window's console up or down
    if [ !use_mobile && pane_inst[ active_pane ] && !wa ]
        ce : TrayEntry own_entry[ 'Console', 'orb.con', 1 ]
        ce.check = (con_up[ active_pane ]) ? 1 : 0
        add.push[ ce ]
    # a line before them, unless one is there already
    if [ add.count > 0
         || (at > f + 1 && !menu_items[ at - 1 ].rule) ]
        add.push[ TrayEntry [ rule: true, depth: 1, check: -1,
            action: 'orb.prule' ] ]
    ed : Editor pane_at[ active_pane ]
    # its app's picture to the clipboard
    if [ ed && ed.run_view ]
        add.push[ own_entry[ 'Screenshot', 'orb.shot', 1 ] ]
    # an app built from its source here: again, or clean (not one
    # the apps view installs: featured/ wraps others' software)
    am : path app_module[]
    fd : string '{path.path_startup[]}/featured/'
    # only while its code shows: the edit mode
    if [ am && !'{am}'.starts_with[ fd ] && ed && !ed.app_view ]
        add.push[ TrayEntry [ rule: true, depth: 1, check: -1,
            action: 'orb.prule' ] ]
        add.push[ own_entry[ 'Build', 'orb.build', 1 ] ]
        add.push[ own_entry[ 'Clean build', 'orb.clean', 1 ] ]
    for [ k: i32 add.count - 1, k >= 0, k -= 1 ]
        menu_items.insert[ add[ k ], at ]

# a view's button pressed: git toggles its reference, another view
# shows (again: the file as it is); the navigator gives way to it
func orbiter.pane_view_press [ ed: Editor, v: string ]
    if [ !ed ] return
    if [ v == 'git' ]
        own_pick[ own_entry[ '', 'orb.git', 1 ] ]
    el
        own_pick[ own_entry[ '', 'orb.pview:{v}', 1 ] ]
    exit_finder[]
    nav_showing  = false
    find_showing = false
    force_update[]

# the module a pane's app runs from ('' none): its group's key
# (its source shown counts: the tab is that app's)
# the pane's module updating: how far (build_frac), -2 if not
func orbiter.pane_build [ pi: i32 ] -> f32
    ed : Editor pane_at[ pi ]
    rv : AppView (ed) ? ed.run_view : null
    sp : path (rv && rv.src) ? rv.src : ((ed) ? ed.src : null)
    if [ !sp ] return -2.0
    return build_frac[ sp.directory[].filename[] ]

func orbiter.pane_app [ pi: i32 ] -> string
    ed : Editor pane_at[ pi ]
    rv : AppView (ed) ? ed.run_view : null
    if [ rv && rv.src && (!rv.ended || run_failed[ rv ]) ]
        return '{rv.src.directory[]}'
    if [ ed && ed.src ]
        k : '{ed.src.directory[]}'
        if [ app_runs[ k ].count > 0 ] return k
    return ''

func orbiter.free_runs [] -> vec AppView
    r : vec AppView []
    if [ !instances ] return r
    shown : vec string []
    for [ pi: i32 0, pi < editor_slots.count, pi += 1 ]
        shown.push[ pane_app[ pi ] ]
    for [ av: AppView ] in instances
        if [ !av.src || av.slot < 0 || av.held || av.ended ]
            continue
        k : '{av.src.directory[]}'
        seen : bool [ false ]
        for [ s_: string ] in shown
            if [ s_ == k ] seen = true
        if [ !seen ] r.push[ av ]
    return r

# the pane's app takes a resource live: it can load another
func orbiter.pane_loads [ pi: i32 ] -> bool
    ed : Editor pane_at[ pi ]
    rv : AppView (ed) ? ed.run_view : null
    return rv && live_arg_of[ rv ] != null && !url_app[ rv ]

# the file a pane shows as code, by its path from silver's folder
# (src/silver-host.c); '' when it shows an app or no file
func orbiter.pane_code_file [ pi: i32 ] -> string
    ed : Editor pane_at[ pi ]
    if [ !ed || !ed.src ] return ''
    # the app over it, live: no code shows (held, ended, or none
    # started, as after a cancelled file pick: its source does)
    rv : AppView ed.run_view
    if [ ed.app_view && rv && !rv.ended && !rv.held ] return ''
    fs : string '{ed.src.absolute[]}'
    if [ !startup_path ] startup_path = path.path_startup[]
    rt : string '{startup_path}/'
    if [ fs.starts_with[ rt ] ]
        return fs.mid[ rt.count, fs.count - rt.count ]
    return fs

func orbiter.pane_app_on [ pi: i32 ] -> bool
    ed : Editor pane_at[ pi ]
    rv : AppView (ed && ed.app_view) ? ed.run_view : null
    return rv && !rv.ended && !rv.held && window_of[ rv ] == 0

# the app a window runs (or ran): its editor's, else the one whose
# program's window it shows
func orbiter.pane_inst [ pi: i32 ] -> AppView
    ed : Editor pane_at[ pi ]
    if [ ed && ed.run_view ] return ed.run_view
    wid : u64 [ pane_window[ pi ] ]
    if [ wid == 0 ] return null
    for [ av: AppView ] in instances
        if [ av.wl_window == wid ] return av
    return null

# programs' windows' scale: the text size on the screen's own
# pixels (2 a point on a phone), so they draw sharp, never stretched
func orbiter.win_scale [] -> f64
    ds : f64 [ (win_ds > 0.0) ? f64[ win_ds ] : 1.0 ]
    return f64[ set_size ] / 22.0 * ds

# a strip cell's width: the dock's, in whole pixels
func orbiter.strip_cell [] -> f32
    return round[ dock_w[] ]

# the drawer belongs to a window's strip (a free or lower one):
# it opens inside that window
func orbiter.win_menu [] -> bool
    return (menu_kind == 'menu' || menu_kind == 'crumb')
        && drawer_pane >= 0 && drawer_pane < editor_slots.count
        && (pane_floats[ drawer_pane ] || pane_below[ drawer_pane ])

# a pane's left and top in the window; a free window's from where
# it is drawn this frame (its laid-out bounds are a frame behind:
# what follows it dragged would trail it)
func orbiter.win_x [ pi: i32 ] -> f32
    if [ pane_floats[ pi ] && pane_shown
         && pi * 4 + 1 < pane_shown.count ]
        return pane_shown[ pi * 4 ]
    return pane_left[ pi ]

func orbiter.win_y [ pi: i32 ] -> f32
    if [ pane_floats[ pi ] && pane_shown
         && pi * 4 + 1 < pane_shown.count ]
        top : f32 [ (system_on[]) ? bar_units[] * unit_px[] : 0.0 ]
        return pane_shown[ pi * 4 + 1 ] + top
    return pane_top[ pi ]

# a pane's top in the window
func orbiter.pane_top [ pi: i32 ] -> f32
    y : f32 [ 0.0 ]
    for [ e: element* pane_view[ pi ], e, e = e.parent ]
        if [ e.bounds ] y += e.bounds.y
        if [ e.parent ] y -= e.parent.scroll.y
    return y

# the panes' view crosses the swap in place: the slot is
# persisted at the load, before this fills it
func orbiter.panes_carry []
    if [ !swap_view ] return
    swap_view.clear[]
    for [ i: i32 0, i < editor_slots.count, i += 1 ]
        e_ : Editor pane_at[ i ]
        swap_view += (e_) ? f32[ e_.sel_line ] : -1.0
        swap_view += (e_) ? f32[ e_.sel_col ]  : 0.0
        swap_view += (e_) ? e_.scroll.y        : 0.0
    carry_sent = true

# per-file state, created on first touch
func orbiter.fstate [ p: path ] -> file_state
    if [ !p ] return null
    if [ !file_states ] file_states = map file_state [string] []
    k_ : string '{p}'
    fs : file_state file_states[ k_ ]
    if [ !fs ]
        fs = file_state []
        file_states[ k_ ] = fs
    return fs

# the frames the callstack lists: one with no known source only when
# asked
func orbiter.stack_frames [] -> vec Au
    all : vec Au debug_frames[]
    if [ stack_unknown ] return all
    known : vec Au []
    for [ fr: Frame ] in all
        if [ fr && fr.file && fr.line > 0 ] known.push[ fr ]
    # none known (a release build, a stop in system code): all
    return (known.count > 0) ? known : all

# a recorded take into the exchange, as Enter sends a line: into
# the last conversation, else a new one about the recorded file,
# with the agent and model last used; the exchange stays put away
func orbiter.take_send [ dt: string ]
    if [ !ux ] return
    refs : string ''
    fresh : bool [ !ux.sessions || ux.sessions.count == 0 ]
    if [ fresh ]
        ed : Editor pane_at[ active_pane ]
        src : path [ (listen_file) ? listen_file
            : ((ed && ed.src) ? ed.src : null) ]
        if [ !src ] return
        ln : i32 [ (ed) ? ed.sel_line + 1 : 0 ]
        ux.exchange_open[ src, ln, true ]
        refs = (ln > 0) ? 'File: {src}:{ln}' : 'File: {src}'
    el
        cur : i32 [ (ux.session_cur >= 0) ? ux.session_cur
            : i32[ ux.sessions.count ] - 1 ]
        ux.session_show[ cur ]
    if [ !ux.agent_pick || ux.agent_pick.count == 0 ]
        ux.agent_pick = agent_last
        ux.model_pick = model_last
    if [ listen_shot ]
        sl : string 'Screenshot: {listen_shot}'
        refs = (refs.count > 0) ? '{refs}\n{sl}' : sl
    msg : string (refs.count > 0) ? '{dt}\n\n{refs}' : dt
    if [ fresh ]
        ux.session_begin[ dt ]
        agent_new[]
    if [ !agent_post_as[ a, ux.agent_pick, ux.model_pick, msg,
                         'now' ] ]
        if [ fresh ] ux.session_unbegin[]
        log 'orbiter: the take could not be sent'
        return
    old : string ux.shot_text
    ux.shot_text  = (old && old.count > 0) ? '{old}\n{dt}' : dt
    ux.user_note[ dt ]
    on_agent[ 'status sent {dt}' ]
    ux.agent_view = true
    ux.agent_min  = true
    ux.restyle    = true

# the selected task: the active pane's running app, in view
func orbiter.active_app [] -> AppView
    ed : Editor pane_at[ active_pane ]
    rv : AppView (ed && ed.app_view) ? ed.run_view : null
    return (rv && !rv.ended && !rv.held) ? rv : null

# a task closed from its button: the process goes, its panes let
# it go, and it leaves the list
func orbiter.close_task [ av: AppView ]
    if [ !av ] return
    wv : u64 window_of[ av ]
    for [ pi: i32 0, pi < editor_slots.count, pi += 1 ]
        ed : Editor pane_at[ pi ]
        # a window holding it unshown lets it go, keeping what it
        # shows (a group's other tab never closes with it)
        if [ ed && ed.run_view == av && !ed.app_view ]
            ed.run_view = null
            ed.pristine = false
        el [ ed && ed.run_view == av ]
            # its file goes too; a desktop keeps a module's code
            code : bool [ !use_mobile && ed.src
                && ed.src.ext[] == 'ag' ]
            if [ code ]
                ed.run_view = null
                ed.app_view = false
            el
                go_home[ pi ]
        if [ wv != 0 && pane_win && pi < pane_win.count
             && pane_win[ pi ] == wv ]
            pane_win[ pi ] = u64[ 0 ]
    av.release[]
    av.debugger = null
    remove_instance[ av ]
    log 'task closed: {instance_name[ av ]}'
    if [ ux ] ux.restyle = true

# the window an instance's program opened, while it is open
func orbiter.window_of [ av: AppView ] -> u64
    if [ !av || av.wl_window == 0 ] return u64[ 0 ]
    if [ wlc_window_open[ av.wl_window ] == 0 ] return u64[ 0 ]
    return av.wl_window

func orbiter.show_instance [ iid: i32, pi: i32 ]
    av : AppView instance_by[ iid ]
    ed : Editor pane_at[ pi ]
    if [ !av || !ed ] return
    # an empty pane takes the instance's own source under it (the
    # app shows now and that load keeps it); a pane with a file
    # keeps it: the app is a state over it, the edit comes back
    # when the app is toggled out (its code is the Code toggle's)
    if [ av.src && !av.viewer ]
        if [ !ed.src ] open_in_pane[ av.src, pi ]
        ed.keep_app = av.display == 1
    ed.run_view  = av
    # one pane shows it: another showing it goes to its code
    for [ op: i32 0, op < editor_slots.count, op += 1 ]
        eo : Editor pane_at[ op ]
        if [ op != pi && eo && eo.run_view == av && eo.app_view ]
            eo.app_view = false
            eo.pristine = false
    # a program's window comes back into the pane with it; any
    # other instance takes the pane from a window
    wv : u64 window_of[ av ]
    if [ pane_win ]
        while [ pane_win.count <= pi ]
            pane_win.push[ u64[ 0 ] ]
        pane_win[ pi ] = wv
    if [ wv != 0 ] wlc_window_focus[ wv ]
    session_dirty = true
    # an instance in pip stays in pip when it is selected
    ed.app_view  = av.display == 1 || av.viewer
    ed.pristine  = false
    ed.no_scroll = true
    active_pane  = pi
    land_paused[ av ]
    if [ ux ] ux.restyle = true

func orbiter.active_debugger [] -> dbg
    if [ !debuggers ] return null
    d : dbg debuggers[ active_target ]
    return (d && d.active) ? d : null

# a module's app in a pane: its instance; new_tab, a new one
func orbiter.show_app [ ed: Editor, src: path, fresh: bool ]
    if [ !ed || !src ] return
    # the registry decides: the one running, else a new one
    av_ : AppView inst_reg[].want[ src, null, '', fresh ]
    if [ insts.made ]
        fa : string file_args[ src ]
        av_.module_args = (fa && fa.count > 0) ? fa : module_args
        inst_made[ av_ ]
    embed_app[ ed, av_ ]

# an instance shown in the pane, embedded and running
func orbiter.embed_app [ ed: Editor, av: AppView ]
    av.display = 1
    av.pip     = false
    av.held    = false
    tell_display[ av ]
    if [ av.ended && !av.failed[] ] av.restart[ false ]
    ed.wait_app = true
    show_instance[ av.iid, ed.pane_index ]

func orbiter.couple_app [ mod: string, shot: string ]
    if [ !mod || mod.count == 0 ] return
    r_   : path.path_startup[]
    src_ : path '{r_}/{mod}/{mod}.ag'
    if [ !src_.exists[] ]
        log 'couple: no source for {mod} at {src_}'
        return
    pi : i32 [ (active_pane >= 0) ? active_pane : 0 ]
    open_in_pane[ src_, pi ]
    home_mod = mod
    if [ shot && shot.count > 0 ]
        setenv[ 'SILVER_SWITCH_SHOT', shot, 1 ]
    pending_held     = pi
    pending_held_src = src_
    if [ ux ]
        ux.set_shown[ true ]
        ux.restyle = true

# the window's pane: the one whose app started it (its process is
# one of the window's ancestors), else the active pane
func orbiter.place_window [ wn: u64 ]
    host_mapped[ wn ]
    # already in a pane (it asks to come forward): that pane
    if [ pane_win ]
        for [ i: i32 0, i < pane_win.count, i += 1 ]
            if [ pane_win[ i ] == wn ]
                raise_pane[ i ]
                wlc_window_focus[ wn ]
                return
    # a dialog is a sheet over its window's pane, not the pane's
    over : u64 wlc_window_parent[ wn ]
    if [ over != 0 ]
        for [ i: i32 0, i < pane_win.count, i += 1 ]
            # over the pane's window, or over its sheet (a confirm
            # a dialog asks): that sheet comes back as it closes
            on_sheet : bool [ i < pane_sheet.count
                              && pane_sheet[ i ] == over ]
            if [ pane_win[ i ] != over && !on_sheet ] continue
            while [ pane_sheet.count <= i ]
                pane_sheet.push[ u64[ 0 ] ]
            if [ on_sheet ]
                if [ !sheet_back ] sheet_back = map i64 [string] []
                sheet_back[ '{wn}' ] = i64[ over ]
            pane_sheet[ i ] = wn
            wlc_window_focus[ wn ]
            log 'orbiter: window {wn} a sheet over {over}'
            return
    p : i32 wlc_window_pid[ wn ]
    pane : i32 [ -1 ]
    steps : i32 [ 0 ]
    while [ p > 1 && pane < 0 && steps < 64 ]
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            ed : Editor pane_at[ i ]
            rv : AppView (ed) ? ed.run_view : null
            if [ rv && rv.slot >= 0 && host_app_pid[ rv.slot ] == p ]
                pane = i
                # the instance knows its window: its card shows it
                rv.wl_window = wn
        p = parent_pid[ p ]
        steps += 1
    # a background program's (a tray app's): a floating pane
    bg : AppView background_of[ wn ]
    if [ pane < 0 && bg && editor_slots.count < 4 && !mobile_on[] ]
        bg.wl_window = wn
        mini_forget[ bg.iid ]
        pane = window_pane[]
        while [ pane_win.count <= pane ] pane_win.push[ u64[ 0 ] ]
        pane_win[ pane ] = wn
        if [ !pane_spawn ] pane_spawn = vec u64 []
        while [ pane_spawn.count <= pane ] pane_spawn.push[ u64[ 0 ] ]
        pane_spawn[ pane ] = wn
        placed_win.push[ wn ]
        placed_pane.push[ pane ]
        wlc_window_focus[ wn ]
        log 'orbiter: window {wn} of a background program, floating'
        return
    if [ pane < 0 ]
        pane = active_pane
        # a program that left its starter (VS Code detaches): the
        # pane's program still waiting for a window is its own
        fe : Editor pane_at[ pane ]
        fv : AppView (fe) ? fe.run_view : null
        if [ fv && fv.wl_window == 0 && program_of[ fv ].count > 0 ]
            fv.wl_window = wn
    if [ pane < 0 ] pane = 0
    # another window of the process its pane already shows (Steam's
    # friends list beside its main): a floating window of its own
    spawned : bool [ false ]
    if [ pane < pane_win.count && pane_win[ pane ] != 0
         && pane_win[ pane ] != wn
         && wlc_window_open[ pane_win[ pane ] ] != 0
         && wlc_window_pid[ pane_win[ pane ] ] == wlc_window_pid[ wn ]
         && editor_slots.count < 4 && !mobile_on[] ]
        pane    = window_pane[]
        spawned = true
    while [ pane_win.count <= pane ]
        pane_win.push[ u64[ 0 ] ]
    pane_win[ pane ] = wn
    if [ !pane_spawn ] pane_spawn = vec u64 []
    while [ pane_spawn.count <= pane ]
        pane_spawn.push[ u64[ 0 ] ]
    pane_spawn[ pane ] = (spawned) ? wn : u64[ 0 ]
    placed_win.push[ wn ]
    placed_pane.push[ pane ]
    wlc_window_focus[ wn ]
    nm : string[ wlc_window_title[ wn ] ]
    log 'orbiter: window {wn} ({nm}) in pane {pane}'

# a floating pane for a program's next window, in the middle of
# the area, each later one a step down and right
func orbiter.window_pane [] -> i32
    n : i32 [ (free_order) ? free_order.count : 0 ]
    pane_add[]
    pending_finder = -1
    pi : i32 [ editor_slots.count - 1 ]
    if [ !pane_free ] pane_free = vec f32 []
    if [ !pane_shown ] pane_shown = vec f32 []
    if [ !free_order ] free_order = vec i32 []
    while [ pane_free.count < (pi + 1) * 4 ] pane_free.push[ 0.0 ]
    while [ pane_shown.count < (pi + 1) * 4 ] pane_shown.push[ 0.0 ]
    aw : f32 [ (ux && ux.root && ux.root.bounds) ? ux.root.bounds.w
               : 1280.0 ]
    ah : f32 [ (ux && ux.root && ux.root.bounds) ? ux.root.bounds.h
               : 800.0 ]
    w : f32 [ round[ aw * 0.42 ] ]
    h : f32 [ round[ ah * 0.62 ] ]
    k : i32 [ pi * 4 ]
    pane_free[ k ]     = round[ (aw - w) * 0.5 ] + 36.0 * n
    pane_free[ k + 1 ] = round[ ah * 0.1 ] + 36.0 * n
    pane_free[ k + 2 ] = w
    pane_free[ k + 3 ] = h
    for [ r: i32 0, r < 4, r += 1 ]
        pane_shown[ k + r ] = pane_free[ k + r ]
    free_order.push[ pi ]
    force_update[]
    return pi

# the last window still open that was placed in pane pi before
# gone; its instance shows it again
func orbiter.window_under [ pi: i32, gone: u64 ] -> u64
    back : u64 [ 0 ]
    for [ i: i32 i32[ placed_win.count ] - 1, i >= 0, i -= 1 ]
        if [ placed_pane[ i ] != pi ] continue
        w : u64 placed_win[ i ]
        if [ w != gone && wlc_window_open[ w ] != 0 ]
            back = w
            break
    for [ av: AppView ] in instances
        if [ av.wl_window == gone ]
            av.wl_window = (back != 0) ? back : window_left[ av ]
    if [ back != 0 ] wlc_window_focus[ back ]
    return back

# a window still open that an instance's program made (Steam's main
# window, its sign-in gone); one shown in a pane first
func orbiter.window_left [ av: AppView ] -> u64
    if [ !av || av.slot < 0 ] return u64[ 0 ]
    first : u64 [ 0 ]
    n : i32 wlc_window_count[]
    for [ i: i32 0, i < n, i += 1 ]
        w : u64 wlc_window_at[ i ]
        if [ !made_by[ w, host_app_pid[ av.slot ] ] ] continue
        if [ pane_win ]
            for [ q: i32 0, q < pane_win.count, q += 1 ]
                if [ pane_win[ q ] == w ] return w
        if [ first == 0 ] first = w
    return first

# a process's parent, from /proc/<pid>/stat: after its ') '
func orbiter.parent_pid [ pid: i32 ] -> i32
    f : '/proc/{pid}/stat'
    fh : handle fopen[ f.chars, 'r' ]
    if [ !fh ] return 0
    b : local i8 [ 512 ]
    line : ''
    if [ fgets[ @b[0], 512, fh ] ] line = string [ @b[0] ]
    fclose[ fh ]
    at : i32 [ line.rindex_of[ ') ' ] ]
    if [ at < 0 ] return 0
    rest : line.mid[ at + 2, line.count - at - 2 ]
    words : vec string rest.split[ ' ' ]
    if [ words.count < 2 ] return 0
    return i32[ words[ 1 ].integer_value[] ]

func orbiter.views_of_agi [ e: path, asc: vec string, bin: vec string,
                    anyv: vec string ]
    ax : e.ext[]
    if [ !ax || !(ax == 'agi') ] return
    mod   : string e.stem[]
    ftext : string e.load[ typeid[string], null ]
    if [ !ftext ] return
    n2  : i32 [ ftext.count ]
    ls : i32 [ 0 ]
    for [ i: i32 0, i <= n2, i += 1 ]
        c : i32 [ (i < n2) ? ((i32 ftext.chars[i]) & 255) : 10 ]
        if [ c != 10 ] continue
        line : string ftext.mid[ ls, i - ls ]
        ls = i + 1
        if [ line.index_of[ 'views:' ] == 0 ]
            views_line[ line, mod, asc, bin, anyv ]

func orbiter.views_line [ vl: string, mod: string, asc: vec string,
                  bin: vec string, anyv: vec string ]
    ln : i32 [ vl.count ]
    j   : i32 [ 0 ]
    while [ j < ln ]
        cq : i32 [ (i32 vl.chars[j]) & 255 ]
        if [ cq != 39 ]
            j += 1
            continue
        k : i32 [ j + 1 ]
        while [ k < ln && ((i32 vl.chars[k]) & 255) != 39 ] k += 1
        nm : string vl.mid[ j + 1, k - j - 1 ]
        j = k + 1
        # optional ': member' up to the , or ] delimiter
        mem_ : string ''
        while [ j < ln ]
            cm : i32 [ (i32 vl.chars[j]) & 255 ]
            if [ cm == 44 || cm == 93 || cm == 39 ] break
            if [ (cm >= 97 && cm <= 122) || (cm >= 65 && cm <= 90) ]
                ks : i32 [ j ]
                j = alpha_end[ vl, j ]
                mem_ = vl.mid[ ks, j - ks ]
                continue
            j += 1
        if [ nm.count > 0 ]
            if [ mem_ == 'ascii' ]       asc.push[ nm ]
            el [ mem_ == 'binary' ]      bin.push[ nm ]
            el                           anyv.push[ nm ]
            view_mods[ nm ] = mod

# the views a pane's file can be shown in: its editor first, then
# the rail views its kind admits (the consoles among them); no file
# is dir context, so the consoles alone
func orbiter.views_for [ ed: Editor ] -> vec string
    ensure_views[]
    if [ !ed || !ed.src ] return vec string []
    if [ ed.file_is_binary[ ed.src ] ] return view_tools_bin
    # editing is no view: it is what shows while none is on
    out : vec string []
    for [ s: string ] in view_tools
        out.push[ s ]
    return out

# the panes' split: the layout's top, free windows over it
func orbiter.panes_el [] -> element
    mn  : element (elements) ? elements[ 'main' ] : null
    lf  : element (mn && mn.elements) ? mn.elements[ 'left' ] : null
    st  : element (lf && lf.elements) ? lf.elements[
        'stack' ] : null
    return (st && st.elements) ? st.elements[ 'panes' ] : null

# extent < 0 means the user dragged this pane shut
func orbiter.take_closed [ id: string ] -> bool
    e : element find_el[ a, id ]
    if [ !e || e.extent >= 0.0 ] return false
    e.extent = 0.0
    return true

func orbiter.close_pane [ pi: i32 ]
    if [ agent_open && pi == editor_slots.count ]
        agent_open = false
        ae : element find_el[ a, 'pane{pi}' ]
        if [ ae ]
            ae.extent       = 0.0
            ae.extent_shown = 0.0
        if [ active_pane >= editor_slots.count ]
            active_pane = editor_slots.count - 1
        save_session[]
        return
    if [ pi < 0 || pi >= editor_slots.count ] return
    # a half of a split, judged before a group's member leaves (its
    # leaving shows it beside the one taking its place)
    half : bool [ grp_of[ pi ] < 0 && split_half[ pi ] ]
    # a group's member: another takes its place first, and is the
    # window then active (a hidden tab never is)
    taker : i32 [ -1 ]
    g0 : i32 grp_of[ pi ]
    if [ g0 >= 0 ]
        mates : vec i32 grp_members[ g0 ]
        grp_leave[ pi, false ]
        for [ m: i32 ] in mates
            if [ m != pi && taker < 0 && !pane_hidden[ m ] ] taker = m
    pe : Editor pane_at[ pi ]
    if [ pe && pe.rview ]
        pe.rview.release*[]
        pe.rview = null
    # a view closes with its tab
    if [ pe ] pe.view_name = ''
    # the last tab closes to an empty one, the nav list shut; so
    # does a half of a split made by a drag (its desktop back,
    # the other half kept where it is)
    if [ editor_slots.count == 1 || half ]
        # its instances leave the panel with it; they keep running
        if [ pe && pe.run_view && pe.run_view.viewer ]
            pe.close_app[]
        if [ pe ]
            pe.run_view = null
            pe.app_view = false
        # a terminal shown here goes too; its session runs on
        if [ pi < pane_console.count ] pane_console[ pi ] = ''
        pane_drop_file[ pi ]
        # the text goes now, not on the pane's next load
        if [ pe ]
            pe.load_file[]
            pe.pristine = false
        active_pane = pi
        return
    free_drop[ pi ]
    pane_lists_drop[ pi ]
    if [ pane_hid && pi < pane_hid.count ] pane_hid.remove[ pi ]
    if [ pane_grp && pi < pane_grp.count ] pane_grp.remove[ pi ]
    # the layout keeps the rest, renumbered
    lt : PaneNode tree[]
    lt.drop_leaf[ pi ]
    lt.renumber[ pi ]
    tree_set[ lt ]
    editor_slots.remove[ pi ]
    relay_drop[ pi ]
    if [ pi < pane_console.count ] pane_console.remove[ pi ]
    # ids re-key by index next frame: extents follow their content
    for [ qj: i32 pi + 1, qj <= editor_slots.count, qj += 1 ]
        src_ : element find_el[ a, 'pane{qj}' ]
        dst_ : element find_el[ a, 'pane{qj - 1}' ]
        if [ src_ && dst_ ]
            dst_.extent       = src_.extent
            dst_.extent_shown = src_.extent_shown
    if [ taker >= 0 ]
        active_pane = (taker > pi) ? taker - 1 : taker
    el [ active_pane > pi ]
        active_pane -= 1
    if [ active_pane >= editor_slots.count ]
        active_pane = editor_slots.count - 1
    save_session[]

# the peer module that owns a view, or null when we host it
# ourselves
func orbiter.view_module [ nm: string ] -> string
    if [ !nm || nm.count == 0 ] return null
    ensure_views[]
    m_ : string (view_mods) ? view_mods[ nm ] : null
    if [ !m_ ] return null
    if [ m_ == 'orbiter' ] return null
    return m_

# a free window's edges and corners, a ring just outside it (its
# inside is its own): 1 right, 2 bottom, 4 left, 8 top
func orbiter.grips_of [ t: Elements, i: i32, x: f32, y: f32, w: f32,
                h: f32 ]
    m : f32 [ 8.0 ]
    for [ sd: i32 ] in grip_sides[]
        gx : f32 [ ((sd & 4) != 0) ? x - m
            : (((sd & 1) != 0) ? x + w : x) ]
        gy : f32 [ ((sd & 8) != 0) ? y - m
            : (((sd & 2) != 0) ? y + h : y) ]
        gw : f32 [ ((sd & 5) != 0) ? m : w ]
        gh : f32 [ ((sd & 10) != 0) ? m : h ]
        t['grip{i}_{sd}'] = FreeGrip [ pane: i, side: sd,
            topmost: true,
            area: Region [ 'l{gx}px t{gy}px w{gw}px h{gh}px' ] ]

# the edges, then the corners (over them)
func orbiter.grip_sides [] -> vec i32
    return vec i32 [] [ 1, 2, 4, 8, 3, 6, 9, 12 ]

# the layout, each pane in it once: a pane gone left out, a new
# one put at the top row's end
func orbiter.tree [] -> PaneNode
    n : i32 [ i32[ editor_slots.count ] ]
    t : PaneNode [ (pane_tree && pane_tree.count > 0)
        ? tree_read[ pane_tree, TreeAt [] ] : null ]
    if [ !t || t.pane >= 0 ] return tree_row[ seq_flat[] ]
    have : vec i32 []
    t.leaves[ have ]
    for [ q: i32 ] in have
        if [ q >= n ] t.drop_leaf[ q ]
    for [ q: i32 0, q < n, q += 1 ]
        if [ have.index_of[ q ] >= 0 ] continue
        if [ t.down ]
            t = PaneNode [ kids: vec PaneNode [] [ t ] ]
        t.kids.push[ PaneNode [ pane: q ] ]
    t.tidy[]
    return t

# a split, or the handle over one of its seams: a press there is
# the resize alone
func orbiter.seam_of [ t: element ] -> bool
    if [ !t ] return false
    if [ t inherits Splitter ] return true
    return t.parent && t.parent inherits Splitter && t.id
        && t.id.starts_with[ 'dv' ]

# the pane showing an instance (its window, or its app), -1 none
# a running viewer of the file p (or of its folder, a disc's)
# that no pane shows: a pane's new editor takes it, not a new one
func orbiter.viewer_unshown [ p: path ] -> AppView
    if [ !instances || !p ] return null
    ps : string '{p.absolute[]}'
    pd : string '{p.parent_dir[].absolute[]}'
    for [ av: AppView ] in instances
        if [ !av.viewer || av.ended || !av.doc ] continue
        ds : string '{av.doc.absolute[]}'
        if [ ds.compare[ ps ] != 0 && ds.compare[ pd ] != 0 ]
            continue
        if [ pane_showing[ av ] < 0 ] return av
    return null

# the screen as drawn so far this frame, copied once a frame
func orbiter.view_snap_take [ w: Window ] -> bool
    if [ snap_frame == frames_ever ] return view_snap != null
    snap_frame = frames_ever
    sc : Canvas w.screen
    if [ !sc || !sc.color ] return false
    tx : Texture sc.color
    if [ !view_snap ]
        view_snap = Texture [ vk: w.vk, w: w, width: tx.width,
            height: tx.height, vk_format: tx.vk_format ]
    el [ view_snap.width != tx.width
         || view_snap.height != tx.height ]
        view_snap.resize[ tx.width, tx.height ]
    sc.sync_fence[]
    w.vk.copy_image[ tx, view_snap ]
    return true

# a pane's view in small, cut from the screen as drawn (it is
# under the task bar) every 10th frame; a hidden pane, its last
func orbiter.view_thumb [ w: Window, pi: i32 ] -> Canvas
    if [ !view_thumbs ] view_thumbs = map Canvas [string] []
    k : string 'p{pi}'
    th : Canvas (view_thumbs.contains[ k ])
        ? view_thumbs[ k ] : null
    pv : element pane_view[ pi ]
    if [ !pv || !pv.bounds || pv.bounds.w < 1.0 || pane_out[ pi ] ]
        return th
    if [ th && frames_ever % 10 != 0 ] return th
    if [ !view_snap_take[ w ] ] return th
    # wider than its box: drawn there it only shrinks (averaged)
    tw : i32 [ 640 ]
    thh : i32 [ max[ 1, i32[ 640.0 * pv.bounds.h / pv.bounds.w ] ] ]
    if [ !th ]
        th = Canvas [ vk: w.vk, w: w, width: tw, height: thh ]
        th.update[]
        view_thumbs[ k ] = th
    th.resize[ tw, thh ]
    th.fresh_state[]
    th.clear_recorded[ vec4f [ 0.0, 0.0, 0.0, 1.0 ] ]
    sc : f32 [ (w.scale > 0.0) ? w.scale : 1.0 ]
    fw : f32 [ f32[ view_snap.width ] ]
    fh : f32 [ f32[ view_snap.height ] ]
    x0 : f32 [ pane_left[ pi ] * sc / fw ]
    y0 : f32 [ pane_top[ pi ] * sc / fh ]
    th.draw_image_crop[ view_snap,
        rect [ x: 0.0, y: 0.0, w: f32[ tw ], h: f32[ thh ] ],
        x0, y0, x0 + pv.bounds.w * sc / fw,
        y0 + pv.bounds.h * sc / fh ]
    return th

# the pane comes to the top of the free ones and is selected
func orbiter.raise_pane [ i: i32 ]
    if [ i != active_pane ]
        active_pane = i
        if [ ux ] ux.restyle = true
    if [ !pane_floats[ i ] ] return
    fo : i32 [ free_at[ i ] ]
    if [ fo >= 0 && fo == free_order.count - 1 ] return
    if [ fo >= 0 ] free_order.remove[ fo ]
    free_order.push[ i ]
    force_update[]

# an app holding its picture's shape: a free window takes that
# shape, no bars round it (docked, the pane letterboxes it). the
# height follows the width, or the width the height
func orbiter.fit_free [ i: i32, by_h: bool ]
    ed : Editor pane_at[ i ]
    pv : element pane_view[ i ]
    rv : AppView (ed && ed.app_view) ? ed.run_view : null
    if [ !rv || !rv.locked || rv.aw <= 0 || rv.ah <= 0 ] return
    # only while it shows live: paused, its code shows instead
    if [ rv.ended || rv.held || rv.paused || rv.stopped ] return
    if [ !ed.bounds || !pv || !pv.bounds ] return
    k : i32 [ i * 4 ]
    # its declared shape: a frame's size changes with its area
    ar : f32 rv.pic_aspect[]
    if [ ar <= 0.0 ] return
    # the window's own parts round the picture: its strip
    ew : f32 [ pv.bounds.w - ed.bounds.w ]
    eh : f32 [ pv.bounds.h - ed.bounds.h ]
    # app and console's box: one height, console or none
    text : element find_el[ pv, 'text' ]
    box : element (text) ? text.parent : null
    if [ box && box.bounds ]
        eh = pv.bounds.h - box.bounds.h
    # a frame's size wobbles the shape: a 1 px change is not one
    if [ by_h ]
        nw : f32 [ round[ (pane_free[ k + 3 ] - eh) * ar + ew ] ]
        if [ abs[ nw - pane_free[ k + 2 ] ] >= 2.0 ]
            pane_free[ k + 2 ] = nw
    el
        nh : f32 [ round[ (pane_free[ k + 2 ] - ew) / ar + eh ] ]
        if [ abs[ nh - pane_free[ k + 3 ] ] >= 2.0 ]
            pane_free[ k + 3 ] = nh
    # never past the panes' foot: shorter, the width by the shape
    sp : element pv.parent
    room : f32 [ (sp && sp.bounds)
        ? sp.bounds.h - pane_free[ k + 1 ] : 0.0 ]
    if [ room > eh && pane_free[ k + 3 ] > room ]
        pane_free[ k + 3 ] = round[ room ]
        pane_free[ k + 2 ] = round[ (room - eh) * ar + ew ]

# a window of a fixed size (Android's) in pane i
func orbiter.fixed_win [ i: i32 ] -> bool
    wn : u64 pane_window[ i ]
    return wn != 0 && wlc_window_fixed_w[ wn ] > 0

# a free pane round a fixed window takes the window's size, as
# it cannot be resized
func orbiter.fit_fixed [ i: i32 ]
    if [ !fixed_win[ i ] ] return
    wn : u64 pane_window[ i ]
    ed : Editor pane_at[ i ]
    pv : element pane_view[ i ]
    if [ !ed || !ed.bounds || !pv || !pv.bounds ] return
    k : i32 [ i * 4 ]
    pane_free[ k + 2 ] = f32[ wlc_window_fixed_w[ wn ] ]
        + pv.bounds.w - ed.bounds.w
    pane_free[ k + 3 ] = f32[ wlc_window_fixed_h[ wn ] ]
        + pv.bounds.h - ed.bounds.h

# sized by its edges: 1 the right, 2 the bottom, 4 the left, 8
# the top (the far edge stays)
func orbiter.size_free [ i: i32, side: i32, dx: f32, dy: f32 ]
    if [ !pane_floats[ i ] ] return
    k : i32 [ i * 4 ]
    if [ (side & 1) != 0 ]
        pane_free[ k + 2 ] = max[ pane_free[ k + 2 ] + dx, 160.0 ]
    if [ (side & 2) != 0 ]
        pane_free[ k + 3 ] = max[ pane_free[ k + 3 ] + dy, 100.0 ]
    if [ (side & 4) != 0 ]
        was : f32 [ pane_free[ k + 2 ] ]
        pane_free[ k + 2 ] = max[ was - dx, 160.0 ]
        pane_free[ k ] = pane_free[ k ] + was - pane_free[ k + 2 ]
    if [ (side & 8) != 0 ]
        was_h : f32 [ pane_free[ k + 3 ] ]
        pane_free[ k + 3 ] = max[ was_h - dy, 100.0 ]
        pane_free[ k + 1 ] = max[ pane_free[ k + 1 ] + was_h
            - pane_free[ k + 3 ], 0.0 ]
    right : f32 [ pane_free[ k ] + pane_free[ k + 2 ] ]
    bottom : f32 [ pane_free[ k + 1 ] + pane_free[ k + 3 ] ]
    fit_free[ i, side == 2 || side == 8 ]
    # a size the shape changed keeps the far edges
    if [ (side & 4) != 0 ]
        pane_free[ k ] = right - pane_free[ k + 2 ]
    if [ (side & 8) != 0 ]
        pane_free[ k + 1 ] = bottom - pane_free[ k + 3 ]
    # only its size: the next frame renders it, no restyle
    if [ ux ] ux.will_animate = true

# the layout's docked panes into t, a split down (else across)
# holding it: a split its way, or of one pane in view, put
# straight in; across it, a split of its own
func orbiter.tree_els [ n: PaneNode, t: Elements, docked: Elements,
                key: string, down: bool ]
    if [ n.pane >= 0 ]
        pe : element docked[ 'pane{n.pane}' ]
        if [ pe ] t['pane{n.pane}'] = pe
        return
    shown : vec i32 []
    for [ j: i32 0, j < n.kids.count, j += 1 ]
        if [ tree_shows[ n.kids[ j ], docked ] ] shown.push[ j ]
    if [ shown.count == 0 ] return
    if [ shown.count == 1 || n.down == down ]
        for [ j: i32 ] in shown
            tree_els[ n.kids[ j ], t, docked, '{key}_{j}', down ]
        return
    sub : Elements []
    # a group's member takes the group's size (a new element in the
    # split has none of its own)
    sz : vec f32 []
    for [ j: i32 ] in shown
        tree_els[ n.kids[ j ], sub, docked, '{key}_{j}', n.down ]
        g : i32 grp_of[ n.kids[ j ].pane ]
        sz.push[ (g >= 0 && grp_size && g < grp_size.count)
            ? grp_size[ g ] : 0.0 ]
    t[ key ] = Splitter [ area: Region { l0 t0 r0 b0 },
        vertical: n.down, inner: sub, deflt: 0.0, even: true,
        snap_close: true, near_seam: true, sizes: sz ]

# the pane goes, its app runs on; a free window's place is kept
# for its return
# out of view, its state kept: a free one's place, a docked one
# (maximized) as an empty place
# out of view, all kept (its editor, its app, its place): the
# task button shows it again as it was
func orbiter.minimize [ pi: i32 ]
    if [ pi < 0 || pi >= editor_slots.count ] return
    if [ !pane_hid ] pane_hid = vec bool []
    while [ pane_hid.count < editor_slots.count ] pane_hid.push[ false ]
    pane_hid[ pi ] = true
    # where it is, to fade out there over the desktop
    if [ !pane_rect ] pane_rect = vec f32 []
    while [ pane_rect.count < editor_slots.count * 4 ]
        pane_rect.push[ 0.0 ]
    pv : element find_el[ a, 'pane{pi}' ]
    if [ pv && pv.bounds ]
        mr : rect split_rect[ pv ]
        pane_rect[ pi * 4 ]     = mr.x
        pane_rect[ pi * 4 + 1 ] = mr.y
        pane_rect[ pi * 4 + 2 ] = mr.w
        pane_rect[ pi * 4 + 3 ] = mr.h
    if [ active_pane == pi ]
        for [ q: i32 0, q < editor_slots.count, q += 1 ]
            if [ !pane_hidden[ q ] ]
                active_pane = q
                break
    force_update[]

# a pane out of view at once (no fade): a group's other member
func orbiter.hide_now [ pi: i32 ]
    minimize[ pi ]
    if [ !pane_fade ] pane_fade = vec f32 []
    while [ pane_fade.count < editor_slots.count ]
        pane_fade.push[ 0.0 ]
    pane_fade[ pi ] = 1.0

func orbiter.show_now [ pi: i32 ]
    if [ pane_hid && pi < pane_hid.count ] pane_hid[ pi ] = false
    if [ pane_fade && pi < pane_fade.count ] pane_fade[ pi ] = 0.0

# nw in old's place: its free rectangle, or its place docked
func orbiter.take_place [ nw: i32, old: i32 ]
    n : i32 [ i32[ editor_slots.count ] ]
    if [ !pane_free ] pane_free = vec f32 []
    while [ pane_free.count < n * 4 ] pane_free.push[ 0.0 ]
    if [ !pane_shown ] pane_shown = vec f32 []
    while [ pane_shown.count < n * 4 ] pane_shown.push[ 0.0 ]
    if [ !free_order ] free_order = vec i32 []
    fb : i32 free_at[ nw ]
    if [ fb >= 0 ] free_order.remove[ fb ]
    if [ pane_floats[ old ] ]
        for [ r: i32 0, r < 4, r += 1 ]
            pane_free[ nw * 4 + r ]  = pane_free[ old * 4 + r ]
            pane_shown[ nw * 4 + r ] = pane_shown[ old * 4 + r ]
        fa : i32 free_at[ old ]
        if [ fa >= 0 ] free_order[ fa ] = nw
        el free_order.push[ nw ]
        return
    # docked: nw docked, where old is in the order, at its size
    pane_free[ nw * 4 + 2 ] = 0.0
    g : i32 grp_of[ old ]
    ov : element pane_view[ old ]
    if [ g >= 0 && ov && ov.extent > 0.0 ]
        if [ !grp_size ] grp_size = vec f32 []
        while [ grp_size.count <= g ] grp_size.push[ 0.0 ]
        grp_size[ g ] = ov.extent
    sq : vec i32 pane_order[]
    ia : i32 [ i32[ sq.index_of[ old ] ] ]
    ib : i32 [ i32[ sq.index_of[ nw ] ] ]
    if [ ia < 0 || ib < 0 ] return
    sw : vec i32 []
    for [ k: i32 0, k < sq.count, k += 1 ]
        sw.push[ (k == ia) ? nw : ((k == ib) ? old : sq[ k ]) ]
    seq_set[ sw ]

# another pane docked and in view, the desktop's too (a split
# needs two)
func orbiter.docked_beside [ pi: i32 ] -> bool
    for [ q: i32 0, q < editor_slots.count, q += 1 ]
        if [ q != pi && !pane_floats[ q ] && !pane_out[ q ] ]
            return true
    return false

# the window let go on an empty docked pane: docked, the two
# trade places; free, in its place, the empty one closed
func orbiter.take_empty [ pi: i32, hit: i32 ]
    t : PaneNode tree[]
    if [ !pane_floats[ pi ] && !pane_out[ pi ] ]
        if [ grp_of[ pi ] >= 0 ] grp_leave[ pi, false ]
        t.swap_leaf[ hit, 1000 ]
        t.swap_leaf[ pi, hit ]
        t.swap_leaf[ 1000, pi ]
        tree_set[ t ]
        dock_settle[ pi, 0 ]
        return
    dock_in[ pi ]
    t.drop_leaf[ pi ]
    t.swap_leaf[ hit, pi ]
    tree_set[ t ]
    close_pane[ hit ]
    dock_settle[ (hit < pi) ? pi - 1 : pi, 0 ]

# back in view as it was, and selected
func orbiter.unhide [ pi: i32 ]
    if [ !pane_hidden[ pi ] ] return
    # a group's member comes back in the group's place
    if [ grp_of[ pi ] >= 0 ]
        grp_show[ pi ]
        return
    pane_hid[ pi ] = false
    raise_pane[ pi ]
    force_update[]

func orbiter.minimized_iid [ iid: i32 ] -> bool
    if [ !mini_iids ] return false
    for [ k: i32 0, k < mini_iids.count, k += 1 ]
        if [ mini_iids[ k ] == iid ] return true
    return false

func orbiter.mini_forget [ iid: i32 ]
    if [ !mini_iids ] mini_iids = vec i32 []
    if [ !mini_rect ] mini_rect = vec f32 []
    for [ j: i32 0, j < mini_iids.count, j += 1 ]
        if [ mini_iids[ j ] == iid ]
            mini_iids.remove[ j ]
            for [ r: i32 0, r < 4, r += 1 ]
                mini_rect.remove[ j * 4 ]
            return

# a minimized window comes back as it was: free where it was, or
# docked (the emptied last pane, else a docked pane of its own);
# false when it was not one
func orbiter.mini_restore [ iid: i32 ] -> bool
    if [ !mini_iids ] return false
    j : i32 [ -1 ]
    for [ k: i32 0, k < mini_iids.count, k += 1 ]
        if [ mini_iids[ k ] == iid ] j = k
    if [ j < 0 ] return false
    x : f32 mini_rect[ j * 4 ]
    y : f32 mini_rect[ j * 4 + 1 ]
    w : f32 mini_rect[ j * 4 + 2 ]
    h : f32 mini_rect[ j * 4 + 3 ]
    mini_forget[ iid ]
    av : AppView instance_by[ iid ]
    if [ !av || av.ended || editor_slots.count >= 4 ] return false
    # shown in a pane since: it stays as it is
    for [ q: i32 0, q < editor_slots.count, q += 1 ]
        if [ pane_instance[ q ] == av ] return false
    # docked: the last pane, emptied when it went, takes it back
    lone : bool [ w <= 0.0 && editor_slots.count == 1
        && !pane_instance[ 0 ] && pane_window[ 0 ] == 0 ]
    if [ !lone ]
        pane_add[]
        pending_finder = -1
    pi : i32 [ editor_slots.count - 1 ]
    if [ !pane_free ] pane_free = vec f32 []
    if [ !pane_shown ] pane_shown = vec f32 []
    if [ !free_order ] free_order = vec i32 []
    while [ pane_free.count < (pi + 1) * 4 ] pane_free.push[ 0.0 ]
    while [ pane_shown.count < (pi + 1) * 4 ] pane_shown.push[ 0.0 ]
    k : i32 [ pi * 4 ]
    if [ w <= 0.0 ]
        for [ r: i32 0, r < 4, r += 1 ]
            pane_free[ k + r ] = 0.0
        mini_wait = iid
        mini_pane = pi
        force_update[]
        return true
    pane_free[ k ]      = x
    pane_free[ k + 1 ]  = y
    pane_free[ k + 2 ]  = w
    pane_free[ k + 3 ]  = h
    pane_shown[ k ]     = x
    pane_shown[ k + 1 ] = y
    pane_shown[ k + 2 ] = w
    pane_shown[ k + 3 ] = h
    free_order.push[ pi ]
    mini_wait = iid
    mini_pane = pi
    force_update[]
    return true

# the restored one into its pane: a program's window as it is; an
# app shown in the pane's editor, its file opened first if none
func orbiter.mini_show []
    av : AppView instance_by[ mini_wait ]
    pi : i32 [ mini_pane ]
    mini_wait = -1
    if [ !av || pi < 0 || pi >= editor_slots.count ] return
    active_pane = pi
    wv : u64 window_of[ av ]
    if [ wv != 0 ]
        if [ !pane_win ] pane_win = vec u64 []
        while [ pane_win.count <= pi ] pane_win.push[ u64[ 0 ] ]
        pane_win[ pi ] = wv
        wlc_window_focus[ wv ]
    el [ pane_at[ pi ] ]
        show_instance[ av.iid, pi ]
    el [ av.src ]
        open_in_pane[ av.src, pi ]
        pending_show      = av.iid
        pending_show_pane = pi
    session_dirty = true
    if [ ux ] ux.restyle = true

# a window out of view, its program running: a free one minimized
# (its place kept), a docked one off its pane
func orbiter.hide_window [ w: u64 ]
    if [ !pane_win ] return
    for [ q: i32 0, q < pane_win.count, q += 1 ]
        if [ pane_win[ q ] != w ] continue
        if [ pane_floats[ q ] ]
            minimize[ q ]
        el
            pane_win[ q ] = u64[ 0 ]
        if [ ux ] ux.restyle = true
        return

# a group's other members beside the shown one's name, each its
# own app name, in one order whichever is shown (those before it
# left of its name, the rest right): a press shows it, a drag
# takes it out
func orbiter.group_tabs [ t: Elements, pre: string, mp: i32, x0: f32,
                  uu: f32, before: bool ] -> f32
    x : f32 x0
    g : i32 grp_of[ mp ]
    if [ g < 0 ] return x
    for [ q: i32 ] in grp_members[ g ]
        if [ q == mp || (q < mp) != before ] continue
        gl : string pane_label[ q ]
        gw : f32 [ min[ (f32[ gl.count ] * 9.5 + 22.0) * uu,
                        360.0 * uu ] ]
        t['{pre}gtab_{q}'] = MenuTop [ label: gl, at: -3,
            pane: q, member: q, tab_on: true, other: true,
            area: Region [ 'l{x}px t0 w{gw}px b0' ] ]
        x += gw
    return x

# a close box let go over: its id says what it closes
func orbiter.close_box [ box: element ]
    id : string box.id
    if [ id.starts_with[ 'pmin_' ] ]
        mp : i32 [ id.mid[ 5, id.count - 5 ].integer_value[] ]
        if [ mp >= 0 && mp < editor_slots.count ] minimize[ mp ]
    el [ id.starts_with[ 'pclose_' ] ]
        cp : i32 [ id.mid[ 7, id.count - 7 ].integer_value[] ]
        # a dialog up in it (the navigator, an app's file pick)
        # closes first; the app keeps running
        pick_here : bool [ (nav_showing || find_showing)
            && picking[] && pick_editor
            && pick_editor.pane_index == cp ]
        if [ pane_browsing[ cp ] || pick_here ]
            exit_find_mode[]
        # its running instance ends with it, not hidden
        el [ cp >= 0 && cp < editor_slots.count ]
            # a window gives its pane back once it has closed
            owned : bool [ pane_window[ cp ] != 0 ]
            quit_app_in[ cp ]
            if [ !owned ] close_pane[ cp ]
    # a window's: the program is asked, as its own X would
    el [ id == 'win_close' ]
        pw : i32 [ active_pane ]
        for [ e: element* box, e, e = e.parent ]
            if [ e inherits EditorView ]
                wv : EditorView e
                pw = wv.pane_index
                break
        # a dialog up over it closes first
        sw : u64 pane_sheet_of[ pw ]
        if [ sw == 0 ] sw = pane_window[ pw ]
        if [ sw != 0 ] close_window[ sw ]
    el [ id == 'view_close' ]
        edc : Editor pane_of[ box ]
        if [ !edc ] edc = pane_at[ active_pane ]
        if [ edc ]
            if [ edc.view_name == 'git' ] edc.git_on = false
            set_pane_view[ edc, '' ]
            force_update[]
    el [ id == 'tab_close' ]
        edu : Editor pane_of[ box ]
        if [ edu ] close_pane[ edu.pane_index ]
    el [ id == 'panel_close' ]
        edx : Editor pane_of[ box ]
        if [ edx ] edx.diff_commit = null
        if [ edx && edx.run_view ]
            edx.toggle_app_run[ false ]
        el
            set_pane_view[ edx, '' ]
    el [ id == 'newfile_cancel' ]
        for [ e: element* box, e, e = e.parent ]
            if [ e inherits EditorView ]
                nv : EditorView e
                nv.newfile_exit[]
                break
    el [ id == 'finder_close' ]
        if [ nav_app ] nav_app_hide[]
        # a pane's navigator app steps aside (it keeps running)
        el [ nav_driven[] ]
            ed : Editor pane_at[ active_pane ]
            if [ ed ]
                ed.app_view = false
                ed.pristine = false
        el exit_find_mode[]
        force_update[]
    el [ id == 'sys_close' ]
        drawer_shut[]
    if [ ux ] ux.restyle = true

# the program whose window a pane shows
func orbiter.window_program [ pi: i32 ] -> string
    wid : u64 [ pane_window[ pi ] ]
    if [ wid == 0 ] return ''
    for [ av: AppView ] in instances
        if [ av.wl_window == wid ]
            pn : string program_of[ av ]
            if [ pn.count > 0 ] return pn
    # no instance known for it: the window's own app id
    ai : cstr wlc_window_app[ wid ]
    return (ai) ? string [ ai ] : ''

# the pane's close, always, ending at xr (the pane's right end);
# the x where it starts
func orbiter.pane_close_el [ t: Elements, pi: i32, xr: f32 ] -> f32
    # the load button's width
    cw : f32 [ 1.33 * unit_px[] ]
    # a phone: no close or minimize; its switcher ends an app
    if [ use_mobile ] return xr
    # square slots: the box's right gap equals its top gap; the
    # close at the end, minimize beside it (the app runs on)
    bh : f32 [ bar_units[] * unit_px[] ]
    t['pclose_{pi}'] = PaneBox [
        area: Region [ 'l{xr - bh}px t0 w{bh}px b0' ] ]
    t['pmin_{pi}'] = PaneBox [ mini: true,
        area: Region [ 'l{xr - 2.0 * bh}px t0 w{bh}px b0' ] ]
    xc : f32 [ 2.0 * bh ]
    # the app's panel: its toggle beside the close, lit open (the
    # app keeps it open until it is pressed again)
    ed : Editor pane_at[ pi ]
    av : AppView (ed && ed.app_view) ? ed.run_view : null
    if [ !av || av.ended || !av.has_panel ] return xr - xc
    t['ppanel_{pi}'] = bar_icon[ 'panel', 0.575, av.panel_on,
        false, xr - xc - cw, cw ]
    return xr - xc - cw

# the app's outline: its toggle at x, lit open (the title after
# it); the x after
func orbiter.pane_outline_el [ t: Elements, pi: i32, x: f32,
                       pre: string ] -> f32
    ed : Editor pane_at[ pi ]
    av : AppView (ed && ed.app_view) ? ed.run_view : null
    if [ !av || av.ended || !av.has_outline ] return x
    cw : f32 [ 1.33 * unit_px[] ]
    t['{pre}poutline_{pi}'] = bar_icon[ 'outline', 0.575,
        av.outline_on, false, x, cw ]
    return x + cw

# a window asked to close as its own X would; ended 3 s on if it
# has not gone (a second ask restarts nothing)
func orbiter.close_window [ wv: u64 ]
    wlc_window_close[ wv ]
    if [ !close_ids ]
        close_ids = vec u64 []
        close_at  = vec i64 []
    for [ i: i32 0, i < close_ids.count, i += 1 ]
        if [ close_ids[ i ] == wv ] return
    close_ids.push[ wv ]
    close_at.push[ epoch_millis[] ]

# each frame: a window gone is forgotten, one past its 3 s ended
func orbiter.close_check []
    if [ !close_ids || close_ids.count == 0 ] return
    now : i64 [ epoch_millis[] ]
    ids : vec u64 []
    ats : vec i64 []
    for [ i: i32 0, i < close_ids.count, i += 1 ]
        wv : u64 [ close_ids[ i ] ]
        if [ wlc_window_open[ wv ] == 0 ] continue
        if [ now - close_at[ i ] >= 3000 ]
            log 'orbiter: window {wv} did not close; ending it'
            wlc_window_kill[ wv ]
            continue
        ids.push[ wv ]
        ats.push[ close_at[ i ] ]
    close_ids = ids
    close_at  = ats

# the language service, each second: the open files it keeps, then
# what it hands back applied to the panes' editors (maps, a handler's
# colouring), a failed build's first error jumped to, and a file with
# no colouring yet given its section from another module's map
func orbiter.syntax_tick []
    if [ !syntax ]
        syntax = SyntaxService [ root: path.path_startup[] ]
    files   : vec path []
    handled : map string [ string ] []
    if [ open_files ]
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            slot : i32 [ editor_slots[ i ] ]
            if [ slot < 0 || slot >= open_files.count ] continue
            f : path open_files[ slot ]
            if [ !f ] continue
            if [ '{f}'.ends_with[ '.ag' ] ]
                files.push[ f ]
                continue
            # not silver: the extension's handler module colours it
            ed  : Editor pane_at[ i ]
            lib : string [ (ed) ? ed.handler_lib_for[ f ] : null ]
            if [ lib ] handled[ '{f}' ] = lib
    # the folders our own builds hold: the service leaves them be
    busy : vec string []
    for [ f: path ] in files
        if [ module_building[ f ] ] busy.push[ '{f.directory[]}' ]
    syntax.busy_dirs = busy
    syntax.want[ files, handled ]
    drew : bool [ false ]
    for [ sn: SyntaxNews ] in syntax.poll[]
        if [ sn.kind == 1 ]
            # a stale map only where a pane has no colouring yet
            for [ i: i32 0, i < editor_slots.count, i += 1 ]
                ed : Editor pane_at[ i ]
                if [ !ed || ed.fmt_mtime >= sn.mtime ] continue
                if [ !sn.fresh && ed.fmt_mtime != 0 ] continue
                ed.load_format[ sn.map ]
                ed.fmt_mtime = sn.mtime
                ed.pristine  = false
                drew = true
            if [ drew ] syntax.taken[ sn.name, sn.mtime ]
        el [ sn.kind == 2 ]
            # the buffer is shared by every pane: taken once it is open
            ed0 : Editor null
            for [ i: i32 0, i < editor_slots.count, i += 1 ]
                ed : Editor pane_at[ i ]
                if [ ed && !ed0 ] ed0 = ed
            if [ !ed0 || !ed0.has_buffer[ sn.file ] ]
                syntax.again[ sn.name ]
                continue
            ed0.apply_format[ sn.ff ]
            for [ i: i32 0, i < editor_slots.count, i += 1 ]
                ed : Editor pane_at[ i ]
                if [ ed ] ed.pristine = false
            drew = true
        el [ sn.kind == 3 ]
            # the editor goes to silver's first error in the build
            err_mod = sn.name
            jump_to_error[ sn.log ]
        el [ sn.kind == 4 ]
            # only the module that failed may clear its own error
            if [ err_mod && err_mod == sn.name ]
                err_file = null
                err_line = 0
                err_msg  = null
                err_mod  = null
        el [ sn.kind == 5 ]
            nav.git_dirty = true
    for [ i: i32 0, i < editor_slots.count, i += 1 ]
        ed : Editor pane_at[ i ]
        if [ !ed || !ed.src || !ed.cur_buf ] continue
        if [ ed.cur_buf.line_regs && ed.cur_buf.line_regs.count > 0 ]
            continue
        ff : fmt_file syntax.borrow[ ed.src ]
        if [ !ff ] continue
        ed.apply_format[ ff ]
        ed.pristine = false
        drew = true
    if [ drew && ux ] ux.will_animate = true

# every window and instance as the log's lines (a test reads them):
# STATE pane <n> ..., STATE inst <iid> ..., STATE end
func orbiter.state_dump []
    log 'STATE begin panes {editor_slots.count} active {active_pane}'
    for [ q: i32 0, q < editor_slots.count, q += 1 ]
        ed : Editor pane_at[ q ]
        rv : AppView (ed) ? ed.run_view : null
        sr : string [ (ed && ed.src) ? '{ed.src}' : '-' ]
        iv : i32 [ (rv) ? rv.iid : -1 ]
        av : bool [ ed && ed.app_view ]
        log 'STATE pane {q} ed {ed != null} src {sr} iid {iv} app {av} hidden {pane_hidden[ q ]} grp {grp_of[ q ]} float {pane_floats[ q ]} out {pane_out[ q ]} empty {pane_empty[ q ]}'
    if [ instances ]
        for [ v: AppView ] in instances
            ap : string inst_reg[].app_of[ v ]
            log 'STATE inst {v.iid} app {ap} slot {v.slot} ended {v.ended} held {v.held} bg {v.background} running {inst_reg[].running_one[ v ]} shown {pane_showing[ v ]}'
    log 'STATE end'
