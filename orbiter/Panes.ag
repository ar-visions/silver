extend orbiter

# the panes and windows: their views, titles, feet, strips, grips
# and grounds; the console band in a pane; their kept states

Layer BlurGround
    public round : f32
    # the foot's corners, if not square
    public foot  : f32
    public stage : BlurStage [ BlurStage.blur ]
    func draw [ cv: Canvas ]
        if [ !parent || !parent.ux ] return
        w : Window parent.ux
        cv.save[]
        cv.clip_rounded_rect[ bounds.x, bounds.y, bounds.w, bounds.h,
                              round, round, foot, foot ]
        w.draw_blur[ cv, parent, stage ]
        cv.restore[]

    # the moving backdrop: drawn each frame under its element's
    # cached picture, so the element itself is not animated
    public func live [] -> bool
        return true

# the desktop's agent title's ground: a free window's
BlurGround HeadBlur
    func draw [ cv: Canvas ]
        ah : cast AgentHead [ parent ]
        if [ !ah || !ah.desk ] return
        round = 8.0
        foot  = 8.0
        super.draw[ cv ]

# a window strip's ground: square when the window is docked
BlurGround StripBlur
    func draw [ cv: Canvas ]
        ws : cast WinStrip [ parent ]
        round = (ws && ws.docked) ? 0.0 : 8.0
        super.draw[ cv ]

# a code window's foot: a free one rounds its foot corners
BlurGround FootBlur
    func draw [ cv: Canvas ]
        pf : cast PaneFoot [ parent ]
        if [ !pf ] return
        foot = (pf.free) ? 8.0 : 0.0
        super.draw[ cv ]

# the navigator's bar at a free window's foot: its corners round
BlurGround TitleBlur
    func draw [ cv: Canvas ]
        et : cast EditorTitle [ parent ]
        if [ !et ] return
        foot = (et.free) ? 8.0 : 0.0
        super.draw[ cv ]

# a code window's: not a console's or a new tab's; a free one rounds.
# the navigator over any of them: the frost
BlurGround CodeBlur
    func draw [ cv: Canvas ]
        ev : cast EditorView [ parent ]
        if [ !ev ] return
        nav : bool [ ev.browse_active[] ]
        if [ !nav && (ev.is_console || ev.is_empty) ] return
        stage = (nav) ? BlurStage.frost : BlurStage.blur
        round = (ev.free) ? 8.0 : 0.0
        foot = round
        super.draw[ cv ]

# this is the EditorView
element EditorView
    selected   : bool
    public pane_index : i32
    public is_console : bool
    # an agent's session: its own tint fades into the blur
    public is_agent   : bool
    # a new tab, no file yet: no ground, the scene shows through
    public is_empty   : bool
    # pulled free: a window, its corners round (all it holds is
    # masked to them: its ground's clip)
    public free       : bool
    # not animated: its ground is a tint, laid over the moving scene
    # each frame as a cached picture (its blur is ground<n>'s)
    public blur : CodeBlur []

    style : CSS {
        area: l0 t0 r0 b0
        layers.bg:
            # the theme's editor ground (each scene maps #140a2acc), a
            # tint as the console's
            fill_color: #140a2acc
            radius: 0
            clip: false
        :is_console
            layers.bg:
                fill_color: #140a2a80
        :is_agent
            layers.bg:
                fill_color: #0000
        :is_empty
            layers.bg:
                fill_color: #0000
        :free
            layers.bg:
                radius: 8
                clip: true
    }


    func text_of [] -> Editor
        if [ !elements ] return null
        return editor_under[ elements[ 'split' ] ]

    # file-create mode: state and behavior live on THIS view alone
    mutable newfile      : bool
    mutable newfile_text : string
    mutable newfile_src  : path
    # the typed name creates a folder instead of a file
    mutable newfile_dir  : bool

    func newfile_enter [ p: path ]
        newfile      = true
        newfile_text = ''
        newfile_src  = p
        newfile_dir  = false

    func newdir_enter [ p: path ]
        newfile_enter[ p ]
        newfile_dir  = true

    func newfile_exit []
        newfile      = false
        newfile_text = ''

    func newfile_exists [] -> bool
        orb : cast orbiter [ ux.app_object ]
        if [ !orb || !orb.nav.nav_root ] return false
        if [ !newfile_text || newfile_text.count == 0 ] return false
        p_ : path '{orb.nav.nav_root}/{newfile_text}'
        return p_.exists[]

    func newfile_commit []
        orb : cast orbiter [ ux.app_object ]
        if [ !orb || !newfile_text || newfile_text.count == 0 ] return
        if [ newfile_exists[] ] return    # red name: no action
        p_ : path '{orb.nav.nav_root}/{newfile_text}'
        if [ newfile_dir ]
            p_.make_dir[]
            newfile_exit[]
            orb.nav.nav_root = p_
            orb.run_search[]
            return
        # a take's file: named here, the recording starts there
        if [ orb.pick_field == 'rec' ]
            newfile_exit[]
            orb.rec_deliver[ p_ ]
            return
        # a program's save: the name goes back to it, nothing made
        if [ orb.pick_field == 'portal' ]
            newfile_exit[]
            orb.portal_deliver[ p_ ]
            return
        e_ : string ''
        p_.save[ e_, null ]
        newfile_exit[]
        orb.exit_finder[]
        orb.open_file[ p_ ]


    func orb [] -> orbiter
        return cast orbiter [ ux.app_object ]

    # the console session this pane holds; '' when it holds a file
    func psess [] -> string
        o : orb[]
        if [ !o ] return ''
        if [ o.agent_open && pane_index == o.editor_slots.count ]
            return o.orbit_sid
        return (pane_index < o.pane_console.count) ? o.pane_console[pane_index] : ''

    func file [] -> path
        o : orb[]
        if [ !o ] return null
        s : i32 [
            (pane_index < o.editor_slots.count)
            ? o.editor_slots[pane_index] : -1 ]
        return (s >= 0 && s < o.open_files.count) ? o.open_files[s] : null

    func rview [] -> AppView
        e : Editor text_of[]
        return (e) ? e.run_view : null

    func app_running [] -> bool
        r : rview[]
        return (r && !r.ended) ? true : false

    func app_pip [] -> bool
        e : Editor text_of[]
        return (app_running[] && !e.app_view) ? true : false

    func searchable [] -> bool
        o : orb[]
        return (o) ? (o.search_pane[] == id) : false

    func findbar_on [] -> bool
        o : orb[]
        return (o) ? (o.findbar_open && o.findbar_pane == id) : false

    func menu_open [] -> bool
        o : orb[]
        if [ !o || !searchable[] ] return false
        return o.find_showing || o.nav_showing

    # .ag files and anything with a registered handler keep the run band
    func run_ok [] -> bool
        if [ psess[].count > 0 ] return false
        if [ app_running[] ] return true
        p : file[]
        if [ !p ] return false
        f : p.filename[]
        if [ f.count >= 3 && f.mid[ f.count - 3, 3 ].compare[ '.ag' ] == 0 ]
            return true
        e : Editor text_of[]
        return (e && e.handler_module_for[ p ]) ? true : false

    # a running app owns the band label; source navigation must not
    # re-bind it
    func band_mod [] -> string
        r : rview[]
        if [ r && r.app_mod ] return r.app_mod
        p : file[]
        if [ !p ] return 'app'
        m : p.filename[]
        d : i32 [ m.index_of[ '.' ] ]
        return (d > 0) ? m.mid[ 0, d ] : m


    # args belong to the DOC a handler opened, not the handler's own
    # source
    func args_src [] -> path
        r : rview[]
        if [ r && r.doc ] return r.doc
        e : Editor text_of[]
        return (e) ? e.band_src[] : file[]

    func title_text [] -> string
        if [ findbar_on[] ] return ''
        # a program's window: its own title
        o_ : orb[]
        wn : u64 [ (o_) ? o_.pane_window[ pane_index ] : u64[ 0 ] ]
        if [ wn != 0 ] return string[ wlc_window_title[ wn ] ]
        s : psess[]
        # an agent's terminal: its conversation's title
        if [ s.starts_with[ 'home:' ] && o_ ]
            return o_.home_title[ s.mid[ 5, s.count - 5 ] ]
        if [ s.count > 0 ]
            h : i32 [ s.index_of[ '#' ] ]
            return (h > 0) ? s.mid[ 0, h ] : s
        # a console view is not about the file: the title is its name
        # alone
        e : Editor text_of[]
        o : orb[]
        if [ e && o && e.view_name && o.console_of[ e.view_name ] ]
            return e.view_name
        # its app running in view: the app's own title, as its task
        # button reads
        rv : AppView (e && e.app_view) ? e.run_view : null
        if [ o && rv && !rv.ended && !rv.held ]
            return o.task_title[ rv ]
        # a module: its name; its argument is a button beside it
        m : path (e && o) ? o.module_src_of[ e ] : null
        if [ m ] return m.stem[]
        p : file[]
        # the first frame has no editor yet: the same module rule on
        # the file (<name>/<name>.ag), or it read knes.ag for a frame
        if [ p && p.ext[] == 'ag'
             && p.stem[] == p.parent_dir[].filename[] ]
            return p.stem[]
        return (p) ? p.filename[] : 'Open'

    # the pane's app failed, or its file does not compile
    func title_error [] -> string
        o : orb[]
        e : Editor text_of[]
        if [ !o || !e ] return ''
        # every error is the editor's band at the foot, line or not
        return ''

    func title_hint [] -> string
        e : Editor text_of[]
        o : orb[]
        # a program's folder pick: how to answer it
        if [ o && o.pick_field == 'portal' && o.pick_dir ]
            return 'Enter: open this folder'
        if [ !e || !e.view_name || e.view_name.count == 0 ] return ''
        if [ o && o.console_of[ e.view_name ] ] return ''
        return (e.view_name != 'editor') ? e.view_name : ''

    func title_els [] -> Elements
        o : orb[]
        w : Window ux
        e : Editor text_of[]
        tfoc : bool [
            (w && w.focus && w.focus.id == 'title' && w.focus.parent == a) ? true : false ]
        # the editor is never locked while debugging; the run band steps
        # a console view is not a resource view of the file: the
        # finder's close and the nav arrows keep their places over it
        isres : bool [
            e && e.rview
            && !(e.view_name && o.console_of[ e.view_name ]) ]
        t : Elements o.title_nav[ file[], null, false, w, false,
                                  e->dbg_open, menu_open[],
            isres, e->rview, findbar_on[], tfoc, pane_index ]
        if [ psess[].count > 0 ]
            t['ctx_copy'] = LabelButton [ label: 'context',
                                          manual_mode: true ]
            t['ctx_shot'] = LabelButton [ label: 'screen',
                                          manual_mode: true ]
        # a running app's views (its orbiter bar's chips) after the
        # name; its instances are in the bottom bar
        rv : AppView (e) ? e.run_view : null
        run_ : bool [ rv && !rv.ended && rv.app_mod && !tfoc && !newfile ]
        if [ run_ && w && w.screen && rv.app_views
             && rv.app_views.count > 0 ]
            cv_ : Canvas w.screen
            fu : f32 [
                (w.vk && w.vk.font_unit > 0)
                ? f32[ w.vk.font_unit ] / 22.0 : 1.0 ]
            cv_.font_size[ 17 ]
            nm : cv_.measure_text[ title_text[] ]
            ax_ : f32 [ 62.7 * fu + nm.w + 12.0 * fu ]
            te : element (elements) ? elements[ 'title' ] : null
            ts : TaskStrip (te && te.elements) ? te.elements[
                'tasks' ] : null
            cv_.font_size[ 15 ]
            vxs : vec f32 []
            vws : vec f32 []
            cx  : f32 [ ax_ ]
            for [ vn: string ] in rv.app_views
                vw_ : f32 [ min[ cv_.measure_text[ vn ].w + 40.6 * fu,
                                 8.0 * 22.0 * fu ] ]
                vxs.push[ cx ]
                vws.push[ vw_ ]
                cx += vw_ + 6.0 * fu
            # the strip ends before the companions and the search
            lim : f32 [ (te && te.bounds) ? te.bounds.w : 0.0 ]
            if [ te && te.elements ]
                for [ rk: string ] in vec string [] [ 'companions',
                                                      'tabnav' ]
                    re : element te.elements[ rk ]
                    if [ re && re.bounds && re.bounds.x > ax_
                         && re.bounds.x < lim ]
                        lim = re.bounds.x
            sw : f32 [ max[ lim - ax_ - 6.0 * fu, 0.0 ] ]
            span : f32 [ max[ cx - 6.0 * fu - ax_, 0.0 ] ]
            pad : f32 [ 3.0 * fu ]
            vis : f32 [ (ts && ts.bounds) ? ts.bounds.w - pad * 2.0
                : sw ]
            shift : f32 [ (ts) ? clamp[ ts.shift, 0.0,
                max[ span - vis, 0.0 ] ] : 0.0 ]
            if [ ts ] ts.shift = shift
            st : Elements []
            # h0.9 in the title's cells
            ch : f32 [ 0.9 * ((te && te.fc > 0.0) ? te.fc : 22.0 * fu) ]
            k : i32 [ 0 ]
            for [ vn: string ] in rv.app_views
                vx : f32 [ vxs[ k ] - ax_ - shift + pad ]
                vwd : f32 [ vws[ k ] ]
                st[ 'view_{k}' ] = ArgButton [ label: vn,
                    selected: e.app_view && rv.app_view_on == k,
                    inst: rv,
                    area: Region [ 'l{vx}px t{pad}px w{vwd}px h{ch}px' ] ]
                k += 1
            sa : string 'l{ax_ - pad}px t-{pad}px'
            sz : string 'w{sw + pad * 2.0}px h{ch + pad * 2.0}px'
            t['tasks'] = TaskStrip [ span: span, shift: shift,
                shown: rv.iid, room: sw, pad: pad,
                area: Region [ '{sa} {sz}' ],
                elements: st ]
        if [ newfile ]
            # create mode has its own cancel: never two close buttons
            t.rm[ 'histnav' ]
        # a phone shows no close (x) anywhere
        if [ newfile && !use_mobile ]
            t['newfile_cancel'] = PaneBox [
                area: Region [ 'r0+ t0 w1.66 b0' ] ]
        return t
 
    func text_els [] -> Elements
        o : orb[]
        e : Editor text_of[]
        t : Elements [ ]
        # a window a program opened here fills the pane, unless the
        # navigator is open in it (the window comes back as it shuts)
        wid : u64 o.pane_window[ pane_index ]
        if [ wid != 0 && !browse_active[] ]
            # a header it draws itself is cut off when its menu is in
            # the system bar; one with no menu there keeps it (its tabs)
            # 46 of the window's own units: its pixels are that times
            # the windows' scale (wlc_set_scale)
            ws : f32 [ (o.set_size > 0) ? f32[ o.win_scale[] ] : 1.0 ]
            mk : i32 wlc_window_menu_kind[ wid ]
            cut : i32 [ (wlc_window_csd[ wid ] != 0
                         && (mk == 1 || mk == 2))
                ? i32[ round[ 46.0 * ws ] ] : 0 ]
            t['text'] = WaylandView [ window: wid, crop_top: cut,
                sheet: o.pane_sheet_of[ pane_index ],
                area: Region { l0 t0 r0 b0 } ]
            return t
        s : psess[]
        if [ s.count > 0 ]
            con : Console [ session_id: s, sessions: o.ed_sessions,
                            feed: null,
                launch: o.agent_cmd[ s ], animated: true ]
            t['text'] = con
            # an agent's terminal: its avatar behind it, lower right
            if [ s.starts_with[ 'home:' ] ]
                con.cbase = Layer [ fill_color: rgba [ '#0000' ] ]
                con.area  = Region { l0 t0 r0 b0 }
                # its scrolled edges fade, as the pane's console's:
                # the mask needs its cached picture (not animated)
                con.scroll_fade = 72.0
                con.animated = false
                t['text'] = AgentBox [ agent: s.mid[ 5, s.count - 5 ],
                    term: con, free: free,
                    area: Region { l0 t0 r0 b0 } ]
        el
            edels : Elements []
            # a composed view fills the editor; its lines stay empty
            if [ e && e.rview ]
                vel : element e.rview.view_element*[]
                if [ vel ] edels['view'] = vel
            # a resumed app fading in over the source
            fi_ : AppView (e) ? e.run_view : null
            # an app building or starting (until its first frame): the
            # build card, with its build's percent while it compiles
            bw_ : string [ (fi_) ? fi_.status_word[] : '' ]
            # only a real build: a built app's start shows nothing
            if [ e && e.app_view && fi_ && fi_.display == 1
                 && (bw_ == 'compiling' || bw_ == 'starting')
                 && fi_.compiled[] ]
                edels['build_card'] = BuildCard [ inst: fi_,
                    area: Region { l0 t0 r0 b0 } ]
            # picture in picture: the app in a corner over the source
            if [ e && fi_ && !e.app_view && fi_.display == 0
                 && !fi_.ended && !fi_.held && !fi_.viewer ]
                edels['pip:{pane_index}'] = PipView [ inst: fi_,
                    area: Region [ pip_at[ fi_ ] ] ]
            if [ fi_ && fi_.fade_in_ms > 0 ]
                edels['resume_fade'] = ResumeFade [ inst: fi_,
                    area: Region { l0 t0 r0 b0 } ]
            edels['rail'] = ToolRail [ no_scroll: true,
                                       area: Region [
                                           'l0 t1px w1.94 b0' ] ]
            dbgr : dbg o.active_debugger[]
            edx : Editor [
                src: file[]
                hide: browse_active[]
                breakpoints: o.breakpoints,
                code_font_size: o.code_font_size,
                nav: o.nav_panes[ pane_index ], pane_index: pane_index,
                debug_running: (dbgr) ? true : false, debugger: dbgr,
                debug_vars: o.debug_vars,
                expanded: findbar_on[], replacing: findbar_on[],
                show_hits: false,
                single_line: false,
                header_size: o.browse_header_size,
                dir_size: o.browse_dir_size,
                nav_list: false, dock_rows: o.nav.nav_dock_rows,
                grid_mode: false,
                hits: o.nav.find_hits,
                find_query: (searchable[]
                    && (findbar_on[] || o.title_finding[]))
                ? o.findbar_text : '',
                elements: edels ]
            # the editor and the run band share the column left of the
            # instance panel: the console spans the editor only, never
            # under the panel. the column is mounted always (a wrapper
            # that comes and goes re-parents the editor)
            cols : Elements []
            cols['text'] = edx
            t['text'] = Splitter [ area: Region { l0 t0 r0 b0 },
                                   vertical: true,
                inner: cols, deflt: 180.0, min_size: 44.0 ]
        return t

    # the error chip belongs to the file it names: only show it
    # while that file is the one in view
    func err_showing [] -> bool
        o : orb[]
        if [ !o.err_file || o.err_line <= 0 ] return false
        e : Editor text_of[]
        if [ !e || !e.src ] return false
        es : string e.src.absolute[]
        ef : string o.err_file.absolute[]
        return es.compare[ ef ] == 0

    # ONE middle slot: the error of the app WE ARE RUNNING, or what it
    # is doing while we wait. an error wins the slot
    func band_status [] -> string
        o : orb[]
        if [ err_showing[] ]
            return (o.err_msg && o.err_msg.count > 0)
                ? '{o.err_line}: {o.err_msg}'
                : '{o.err_file.filename[]}:{o.err_line}'
        r : rview[]
        if [ !r ] return ''
        s : r.status_text[]
        return (s) ? s : ''

    # the console alone: its filter box is the one control. pip, pause,
    # the steps and volume all live in the instance panel
    func band_els [] -> Elements
        o : orb[]
        e : Editor text_of[]
        t : Elements []
        cf : Elements []
        cf['console_filter'] = element [
            area: Region { r0.24 t0.12 w6 h0.97 },
            label: band_mod[], focusable: true, no_scroll: true ]
        # the log's filter, at its top right while it holds one
        fl : string [ (o.con_filter) ? o.con_filter : '' ]
        if [ fl.count > 0 ]
            fw : f32 [ (f32[ fl.count ] * 8.0 + 30.0) * ux_unit[ ux ] ]
            cf['con_find'] = ConFind [ edit: fl,
                area: Region [ 'r0.24 t0.12 w{fw}px h0.97' ] ]
        inner : Elements [ ]
        # its toolbar across the top, the window strip's height: the
        # debugger's console, clear, and the selected app or all
        tb : f32 [ round[ title_px[] * 0.7 ] ]
        t['ctools'] = ConsoleBar [ elements: o.console_tool_els[],
            area: Region [ 'l0 t0 r0 h{tb}px' ] ]
        sid : string o.console_sid[ pane_index ]
        # its input, a line across its foot, edge to edge: the app's
        # standard input, or the debugger's (lldb's) in its console;
        # the log ends above it. nothing to take a line (no running
        # app, no debugger): no line
        takes : bool o.console_takes[ pane_index ]
        lh : f32 [ (takes) ? 1.06 * o.unit_px[] : 0.0 ]
        if [ takes ]
            t['con_line'] = ConsoleLine [
                area: Region [ 'l0 t100%-{lh}px r0 b0' ] ]
        inner['console'] = RunConsole [ session_id: sid,
            scroll_fade: 72.0,
            sessions: o.ed_sessions,
            feed: (o.con_dbg) ? o.dbg_feed[] : null,
            run_line: (e && e.run_view) ? e.run_view.cmd : null,
            elements: cf ]
        # its call stack, the split's right pane: the frames the
        # debugger stops in, a click goes to one
        if [ o.con_stack_on ]
            inner['con_stackcol'] = ConStack [
                frames: o.stack_frames[] ]
        sk : f32 [ round[ 16.0 * o.unit_px[] ] ]
        t['ground'] = ConsoleGround [
            area: Region [ 'l0 t{tb}px r0 b{lh}px' ] ]
        t['split'] = Splitter [
            area: Region [ 'l0 t{tb}px r0 b{lh}px' ],
            inner: inner, deflt: 0.0, share: 0.375,
            line_color: rgba [ '#fff1' ], min_size: 120.0,
            sizes: vec f32 [] [ 0.0, sk ] ]
        return t

    # the foot's buttons, each its own: run or stop, pause or
    # continue, the steps, the build's mode, the console
    func foot_els [ e: Editor, fh: f32, rnd: f32 ] -> Elements
        o : orb[]
        t : Elements []
        av : AppView (e) ? e.run_view : null
        # a stop elsewhere (another pane's run, a program): its steps
        if [ !o.stopped_at[ av ] ]
            sv : AppView o.stopped_view[]
            if [ sv ] av = sv
        ids : vec string []
        ics : vec string []
        tps : vec string []
        # the first: play starts it under the debugger; stop ends it
        # while it runs. the second: pause, continue from a stop
        acts : vec string o.debug_acts[ av ]
        off : i32 [ 0 ]
        # a program run as release: no pause, no steps, only run, stop
        prog : bool [ e && o.run_of[ e.src ].count > 0
            && ((av && !av.ended) ? !av.prog_debug : o.run_release) ]
        if [ acts.count > 0 ]
            ids.push[ 'tdbg:{av.iid}:stop' ]
            ics.push[ 'stop' ]
            tps.push[ 'stop' ]
        el
            ids.push[ 'pfoot_dbg:{pane_index}' ]
            ics.push[ 'play' ]
            tps.push[
                (o.run_release) ? 'run' : 'run with the debugger' ]
        if [ acts.index_of[ 'continue' ] >= 0 ]
            ids.push[ 'tdbg:{av.iid}:continue' ]
            ics.push[ 'continue' ]
            tps.push[ 'continue' ]
        el
            if [ prog || acts.index_of[ 'pause' ] < 0 ]
                off |= 1 << ids.count
            ids.push[ (av) ? 'tdbg:{av.iid}:pause' : 'pfoot_off:pause' ]
            ics.push[ 'pause' ]
            tps.push[ 'pause' ]
        # the steps always; dim while it is not stopped
        for [ ac: string ] in vec string [] [ 'step_next', 'step_in',
                'step_out' ]
            if [ prog || acts.index_of[ ac ] < 0 ]
                off |= 1 << ids.count
            ids.push[ (av) ? 'tdbg:{av.iid}:{ac}' : 'pfoot_off:{ac}' ]
            ics.push[ ac ]
            tps.push[ (ac == 'step_next') ? 'step over'
                : ((ac == 'step_in') ? 'step into' : 'step out') ]
        bw : f32 [ fh * 1.224 ]
        for [ i: i32 0, i < ids.count, i += 1 ]
            # the step icons are drawn 15% smaller
            fit : f32 [ 0.51 ]
            if [ ics[ i ].starts_with[ 'step_' ] ] fit = 0.4335
            b : BarButton o.bar_icon[ ics[ i ], fit, false,
                (off & (1 << i)) != 0, bw * f32[ i ], bw ]
            b.tip = tps[ i ]
            t[ ids[ i ] ] = b
        # right of them: play runs a debug build, else a release one
        dx : f32 [ bw * f32[ ids.count ] ]
        t['pfoot_mode'] = BarButton [ label: 'debug',
            tip: 'build with debug information',
            selected: !o.run_release, use_spacing: false,
            area: Region [ 'l{dx}px t0 w{fh * 2.2}px b0' ] ]
        t['pfoot_verbose'] = BarButton [ label: 'verbose',
            tip: 'show the whole build in the console',
            selected: o.run_verbose, use_spacing: false,
            area: Region [ 'l{dx + fh * 2.2}px t0 w{fh * 2.8}px b0' ] ]
        # the console's toggle at the right end
        t['pfoot_con:{pane_index}'] = BarButton [ icon: 'console',
            tip: 'console', icon_fit: 0.66,
            selected: o.con_up[ pane_index ], use_spacing: false,
            area: Region [ 'r0 t0 w{fh * 1.2}px b0' ] ]
        # the app run from here: in the pane, or a picture in a corner
        rv : AppView (e) ? e.run_view : null
        rw : f32 [ fh * 1.2 ]
        if [ rv && !rv.ended && !rv.held ]
            t['pfoot_pip:{pane_index}'] = BarButton [ icon: 'pip',
                tip: 'picture in picture', icon_fit: 0.6,
                selected: rv.display == 0, use_spacing: false,
                area: Region [ 'r{fh * 1.2}px t0 w{fh * 1.2}px b0' ] ]
            rw = fh * 2.4
        # between them: the tip of the button the pointer is on
        t['foot_tip'] = TipLine [ area: Region [
            'l{dx + fh * 5.0}px t0 r{rw}px b0' ] ]
        return t

    func pane_els [] -> Elements
        o : orb[]
        t : Elements [ ]
        # the editor and the instruments column are the two sides of ONE
        # split. it is mounted ALWAYS, even with the column hidden — a
        # wrapper that comes and goes re-parents the editor, and a new
        # editor loses run_view and unmounts the whole band
        # 100px floor, and 0 snaps it off the way any other pane does
        t['text'] = Splitter [ area: Region { l0 t0 r0 b0 },
            inner: text_els[], deflt: 280.0, min_size: 100.0,
            snap_close: true ]
        # its console, under it in the same split, while it is up
        if [ o.con_up[ pane_index ] && !use_mobile ]
            t['band'] = RunBand [ elements: band_els[] ]
        return t

    # reconciliation runs on the frame hook, never in render
    public func tick [ w: Window ]
        settle[]

    func settle []
        o : orb[]
        # a debugger made since the switch takes it too
        o.asm_sync[]
        # every app module has an implied default instance, held until
        # it is started: the panel always has the app to run, and only
        # the added ones (shift on the instance tab) carry a number
        ed0 : Editor text_of[]
        if [ ed0 && ed0.src && psess[].count == 0 ]
            dir0 : string ed0.src.parent_dir[].filename[]
            if [ ed0.src.stem[] == dir0 && ed0.src.ext[] == 'ag' ]
                bin : path '{install_root[]}/build/{dir0}'
                li0  : vec AppView o.instances_of[ ed0.src ]
                if [
                    bin.exists[] && li0.count == 0
                    && !ed0.handler_module_for[ ed0.src ] ]
                    ed0.start_instance[ false ]
        is_con : bool [ psess[].count > 0 ]
        if [ is_console != is_con ]
            is_console = is_con
            pristine   = false
        is_ag : bool [ is_con && psess[].starts_with[ 'home:' ] ]
        if [ is_agent != is_ag ]
            is_agent = is_ag
            pristine = false
            if [ ux ] ux.restyle = true
        # browsing keeps the ground: only a bare new tab is clear
        emp : bool [ !is_con && !file[] && !browse_active[] ]
        if [ is_empty != emp ]
            is_empty = emp
            pristine = false
            if [ ux ] ux.restyle = true
        if [ o.find_showing ]
            log 'FIND show: pane={id} searchable={(searchable[]) ? 1 : 0} sp={o.search_pane[]} hits={o.nav.find_hits->count}'
        e : Editor text_of[]
        if [ e && e.rview ]
            cfeed : e.rview.context_feed*[]
            if [ cfeed ] o.feed_agent[ cfeed ]
        # create mode self-heals when the pane's file changes under it
        p : file[]
        if [ newfile && newfile_src && p && '{newfile_src}' != '{p}' ]
            newfile_exit[]
        # the nav surface must track the split's text region; when the
        # splitter moves it out from under us, a restyle re-fits it
        cbv : element (elements) ? elements['commit'] : null
        spl : element (elements) ? elements['split'] : null
        if [ cbv && spl && spl.elements && spl.bounds ]
            tx_ : element spl.elements['text']
            ed_ : element (tx_ && tx_.elements) ? tx_.elements['text'] : null
            if [ ed_ && ed_.bounds && tx_.bounds && cbv.bounds ]
                # the view bar takes its width off the right (render)
                vb : element elements['viewbar']
                vw : f32 [ (vb && vb.bounds) ? vb.bounds.w : 0.0 ]
                dx : f32 [ cbv.bounds.x
                    - (spl.bounds.x + tx_.bounds.x + ed_.bounds.x) ]
                dy : f32 [ cbv.bounds.y
                    - (spl.bounds.y + tx_.bounds.y + ed_.bounds.y) ]
                dw : f32 [ cbv.bounds.w - (ed_.bounds.w - vw) ]
                dh : f32 [ cbv.bounds.h - ed_.bounds.h ]
                same : bool [ dx * dx < 0.25 && dy * dy < 0.25
                    && dw * dw < 0.25 && dh * dh < 0.25 ]
                if [ !same ]
                    if [ ux ] ux.restyle = true

    # the pane's views as a column at the nav list's right: git, then
    # the registered views, each the finder close's size, edge to edge
    # row: a button's height in px; each overlaps the last by 1px,
    # so two borders never sit side by side
    func view_bar [ row: f32 ] -> Elements
        o : orb[]
        ed : Editor text_of[]
        bar : Elements []
        # first a pane added, this one closed; then the views
        bar['pane_add'] = ViewTab [
            buttons: vec string [] [ 'pane_add' ],
            icon_ids: vec string [] [ 'plus' ], manual: true,
            rest_glow: rgba [ '#ccf2' ], rest_px: 8.0,
            seg_radius: 0.0, use_spacing: false,
            area: Region [ 'l0 t0 r0 h{row}px' ] ]
        bar['pane_close'] = ViewTab [
            buttons: vec string [] [ 'pane_close' ],
            icon_ids: vec string [] [ 'minus' ], manual: true,
            rest_glow: rgba [ '#ccf2' ], rest_px: 8.0,
            seg_radius: 0.0, use_spacing: false,
            area: Region [ 'l0 t{row - 1.0}px r0 h{row}px' ] ]
        if [ o && ed && ed.src ]
            cur : string ed.resolve_view[]
            y : f32 [ row * 2.0 - 2.0 ]
            if [ o.nav.checkout_root[ ed.src.directory[] ] ]
                bar['git'] = ViewTab [ buttons: vec string [] [ 'git' ],
                    icon_ids: vec string [] [ 'git' ], manual: true,
                    sel_mask: (ed.git_on) ? 1 : 0,
                    rest_glow: rgba [ '#ccf2' ], rest_px: 8.0,
                    seg_radius: 0.0, use_spacing: false,
                    area: Region [ 'l0 t{y}px r0 h{row}px' ] ]
                y += row - 1.0
            for [ v: string ] in o.views_for[ ed ]
                if [ v == 'git' ] continue
                ci : string o.console_icon[ v ]
                bar['view_{v}'] = ViewTab [
                    buttons: vec string [] [ 'view_{v}' ],
                    icon_ids: vec string [] [ (ci) ? ci : v ],
                    manual: true, sel_mask: (v == cur) ? 1 : 0,
                    rest_glow: rgba [ '#ccf2' ], rest_px: 8.0,
                    seg_radius: 0.0, use_spacing: false,
                    area: Region [ 'l0 t{y}px r0 h{row}px' ] ]
                y += row - 1.0
        return bar

    # the pane's title bar height, px: 1.3 units; the one place it is
    # said
    func title_px [] -> f32
        fu : f32 [ (fc > 0.0) ? fc : 22.0 ]
        return round[ 1.3 * fu ]

    # the nav/commit surface replaces the editor for browse AND find
    func browse_active [] -> bool
        o : orb[]
        if [ !o || !searchable[] ] return false
        return o.nav_showing || o.find_showing

    public func render [] -> Elements
        if [ !orb[] ] return null
        t : Elements [ ]
        # every file has its icon at the left: the name moves past it
        to_ : Editor text_of[]
        # a module's run button is at the right: its name stays left
        sw_ : bool [ to_ && to_.src
            && (orb[].system_on[] || !orb[].module_src_of[ to_ ]) ]
        # a window shown: its close sits at the left, its title is ours
        wn_ : bool [ orb[].pane_window[ pane_index ] != 0 ]
        # an app or a window in view: no title bar, the system bar is
        # its title; the editor and the navigator keep theirs (one
        # asked for, as the bar's title press does, comes back)
        rv_ : AppView (to_ && to_.app_view) ? to_.run_view : null
        # the empty pane ('Open') too: it is the apps view alone
        rn_ : bool [ to_ && to_.run_view && !to_.run_view.ended ]
        # the empty pane: no file, app, window or terminal in it
        open_ : bool [ !file[] && !rn_ && !wn_ && psess[].count == 0 ]
        inapp : bool [ orb[].system_on[]
            && ((rv_ && !rv_.ended && !rv_.held) || wn_ || open_
                || psess[].count > 0)
            && !browse_active[] && orb[].pending_finder != pane_index ]
        # the editor's bar is for finding: up only while ctrl+f finds
        # (or a new file is named)
        fnd_ : bool [ orb[].title_find_on
            && pane_index == orb[].active_pane ]
        # the source shows: never live in view (a failed build too)
        src_ : bool [ to_ && to_.src && (!to_.app_view || !rv_
            || rv_.ended || rv_.held || orb[].stopped_at[ rv_ ]) ]
        if [ orb[].system_on[] && src_
             && !fnd_ && !newfile && !browse_active[]
             && orb[].pending_finder != pane_index ]
            inapp = true
        # a running app's URL being typed: the bar comes up for it
        url_ : bool [ orb[].url_entry_on
            && pane_index == orb[].active_pane ]
        if [ url_ ] inapp = false
        # every offset under the title is its height: none when hidden
        th_ : f32 [ (inapp) ? 0.0 : title_px[] ]
        # a free window's strip across its top, and a docked one's
        # under another; along the bar, its title is the bar's. the
        # desktop (the empty pane) has none
        dk_ : bool [ !orb[].pane_floats[ pane_index ] ]
        fr_ : bool [ !open_
            && (!dk_ || orb[].pane_below[ pane_index ]) ]
        sp_ : f32 [ (fr_) ? round[ title_px[] * 0.7 ] : 0.0 ]
        if [ fr_ ]
            strip_w : f32 [ (bounds) ? bounds.w : 0.0 ]
            t['strip'] = WinStrip [ pane: pane_index, docked: dk_,
                current: pane_index == orb[].active_pane,
                elements: orb[].strip_els[ pane_index, strip_w ],
                area: Region [ 'l0 t0 r0 h{sp_}px' ] ]
        # with the system bar the pane's bar is at its foot: find, the
        # navigator, a URL
        bot_ : bool orb[].system_on[]
        cont_ : string [ (bot_) ? 'l0 t{sp_}px r0 b{th_}px'
            : 'l0 t{th_ + sp_}px r0 b0' ]
        # the code's own bar at its foot: the console, the debugger;
        # it stays while the app run from it is in the pane
        live_ : bool [ to_ && to_.src && rv_ && !rv_.ended
            && !rv_.held && rv_.edited && to_.owns_src[ rv_, to_.src ] ]
        # a file opened in its app (a rom from the shelf) is used,
        # not edited: no debug bar
        vw_ : bool [ to_ && to_.run_view && to_.run_view.viewer ]
        # the bar is a silver source's (or a program module's file):
        # a picture or any other file has nothing to run
        code_ : bool [ to_ && to_.src && (to_.src.ext[] == 'ag'
            || orb[].run_of[ to_.src ].count > 0) ]
        if [ ((src_ && code_) || live_) && !vw_ && th_ == 0.0
             && !browse_active[] && !use_mobile ]
            fh_ : f32 round[ title_px[] * 0.7 ]
            cont_ = 'l0 t{sp_}px r0 b{fh_}px'
            t['foot'] = PaneFoot [ free: fr_,
                elements: foot_els[ to_, fh_,
                    (fr_) ? 8.0 : 0.0 ],
                area: Region [ 'l0 b{fh_}px r0 h{fh_}px' ] ]
        bar_ : string [ (bot_) ? 'l0 b{th_}px r0 h{th_}px'
            : 'l0 t{sp_}px r0 h{th_}px' ]
        if [ !inapp ]
            t['title'] = EditorTitle [
                area: Region [ bar_ ]
                free: fr_ && bot_
                # with the system bar its icon (find, find in files) leads
                switched: sw_ || wn_ || bot_
                wide: bot_ && fnd_
                selected: !file[]
                current: pane_index == orb[].active_pane
                focusable: true
                spacing_x: 0.2
                spacing_y: 0.2
                edit: (newfile) ? newfile_text
                    : ((url_) ? orb[].bar_text
                    : ((orb[].title_finding[]
                        && pane_index == orb[].active_pane)
                    ? orb[].findbar_text : orb[].nav.find_text))
                label: (newfile)
                ? ((newfile_dir) ? 'name new folder' : 'name new file')
                # with the system bar the bar is for finding: blank
                : ((url_ || bot_) ? ''
                    : title_text[])
                conflict: newfile && newfile_exists[]
                no_scroll: true
                hint: title_hint[]
                elements: title_els[] ]
        # only an error, centred in the title, as wide as its words
        # the band floor grows by the open launch panel: it is a
        # toolbar, never clipped
        # the empty pane: the apps, glass over the clear space
        # nothing in it: no file, and no app running in it
        ap_ : Editor text_of[]
        runs_ : bool [ ap_ && ap_.run_view && !ap_.run_view.ended ]
        # nor a terminal (an agent's, a console)
        home_ : bool [ !file[] && !runs_ && !browse_active[] && !wn_
             && psess[].count == 0 ]
        # under the home the empty editor draws nothing (its gutter)
        t['split'] = Splitter [ area: Region [ cont_ ],
                                vertical: true, hide: home_,
            inner: pane_els[], deflt: 180.0,
            # the console never less than its bar, its line and three
            # rows of its log
            min_size: round[ (1.06 * 2.0 + 3.0) * orb[].unit_px[] ],
            snap_close: true ]
        if [ home_ ]
            # typing filters them: the box mounts at the foot, the
            # cards scroll above it
            af_ : string [ (pane_index == orb[].active_pane)
                ? orb[].apps_filter : '' ]
            up_ : f32 orb[].unit_px[]
            ga_ : string [ cont_ ]
            if [ af_.count > 0 ]
                ga_ = 'l0 t{sp_}px r0 b{th_ + 2.2 * up_}px'
                sd_ : f32 [ 0.7 * up_ ]
                bt_ : f32 [ th_ + 1.8 * up_ ]
                bh_ : f32 [ 1.2 * up_ ]
                t['apps_filter'] = MenuFilter [ edit: af_,
                    area: Region [
                        'l{sd_}px b{bt_}px r{sd_}px h{bh_}px' ] ]
            t['home'] = HomeView [ pane: pane_index,
                area: Region [ ga_ ] ]
        if [ browse_active[] ]
            fu : f32 [ (fc > 0.0) ? fc : 22.0 ]
            bar : Elements (bot_) ? Elements [] : view_bar[ th_ ]
            # the bar is the finder close's width: 1.66 font units
            bw : f32 [ (bar.count > 0) ? 1.66 * fu : 0.0 ]
            # the surface is a peer of the editor pane: it takes the
            # split's live text region, never the whole view
            spl : element (elements) ? elements['split'] : null
            tx8  : element (spl && spl.elements) ? spl.elements['text'] : null
            # tx8 is the editor|panel split: the surface takes the
            # EDITOR's slot inside it, never the instance panel beside
            # it
            ed  : element (tx8 && tx8.elements) ? tx8.elements['text'] : null
            if [
                ed && ed.bounds && tx8 && tx8.bounds && spl.bounds
                && ed.bounds.h > 0.0 ]
                # bounds are parent-relative: compose split + inner
                # split + editor
                cx8 : f32 [ spl.bounds.x + tx8.bounds.x + ed.bounds.x ]
                cy8 : f32 [ spl.bounds.y + tx8.bounds.y + ed.bounds.y ]
                ch8 : f32 [ ed.bounds.h ]
                # never under the bottom bar
                if [ bot_ && bounds && cy8 + ch8 > bounds.h - th_ ]
                    ch8 = bounds.h - th_ - cy8
                # from the pane's right edge: a split drag moves the
                # pane this frame, and a width from last frame's bounds
                # left a gap at the right until the next one
                rin : f32 [ spl.bounds.w - tx8.bounds.x - ed.bounds.x
                            - ed.bounds.w ]
                if [ rin < 0.0 ] rin = 0.0
                t['commit'] = CommitView [ nav: orb[].nav,
                    focusable: true, scroll_fade: 24.0,
                    area: Region [
                        'l{cx8}px t{cy8}px r{rin + bw}px h{ch8}px' ] ]
                if [ bar.count > 0 ]
                    # 1px onto the lines above and below it
                    by : f32 [ cy8 - 1.0 ]
                    bh : f32 [ ch8 + 2.0 ]
                    t['viewbar'] = ViewBar [ no_scroll: true,
                        on_edge: orb[].inst_hidden,
                        elements: bar, area: Region [
                        'r{rin}px t{by}px w{bw}px h{bh}px' ] ]
            el
                t['commit'] = CommitView [ nav: orb[].nav,
                    focusable: true, scroll_fade: 24.0,
                    area: Region [ (bot_) ? 'l0 t0 r{bw}px b{th_}px'
                        : 'l0 t{th_}px r{bw}px b0' ] ]
                if [ bar.count > 0 ]
                    t['viewbar'] = ViewBar [ no_scroll: true,
                        on_edge: orb[].inst_hidden,
                        elements: bar,
                        area: Region [
                            (bot_) ? 'r0 t-1px w{bw}px b{th_ - 1.0}px'
                            : 'r0 t{th_ - 1.0}px w{bw}px b-1px' ] ]
        return t

# a resumed app's frame over the source, coming up over 300 ms
element ResumeFade
    animated : true
    public inst : AppView
    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds || !inst ]
            return
        # a picture only: never the starting / paused words
        if [ inst.fade_in_ms <= 0 || !inst.have_frame ] return
        t : f32 [ f32[ epoch_millis[] - inst.fade_in_ms ] / 300.0 ]
        cv : Canvas w.screen
        cv.save[]
        cv.set_opacity[ min[ max[ t, 0.0 ], 1.0 ] ]
        inst.draw_frame[ cv, rect [ x: 0.0, y: 0.0, w: bounds.w,
                                    h: bounds.h ] ]
        cv.restore[]
        ux.will_animate = true

# the picture in picture's box as now shown: r is its right edge
# (with a width), b its top's distance from the bottom
func pip_at [ av: AppView ] -> string
    ar : f32 [ (av.aw > 0 && av.ah > 0)
        ? f32[ av.aw ] / f32[ av.ah ] : 1.6 ]
    h : f32 [ round[ av.pip_sw / ar ] ]
    w : f32 [ round[ av.pip_sw ] ]
    at : string 'r{round[ av.pip_sr ]}px b{h + round[ av.pip_sb ]}px'
    return '{at} w{w}px h{h}px'

# the app run from the editor, small over its source: a drag moves
# it, its edges and corners size it (its shape kept), never off the
# view; it eases to where it is put. a press alone brings the app
# back to the whole pane
element PipView
    animated : true
    public inst : AppView
    mutable grab : vec2f
    mutable from_r : f32
    mutable from_b : f32
    mutable from_w : f32
    # the edges held: 1 left, 2 top, 4 right, 8 bottom; 0 moves it
    mutable side : i32
    mutable dragging : bool
    mutable moved : bool

    func aspect [] -> f32
        if [ inst.aw > 0 && inst.ah > 0 ]
            return f32[ inst.aw ] / f32[ inst.ah ]
        return 1.6

    # the box asked, kept inside the view (pb: the parent's)
    func keep_in [ pb: rect ]
        ar : f32 aspect[]
        top : f32 [ min[ pb.w, pb.h * ar ] ]
        if [ inst.pip_w <= 0.0 ]
            inst.pip_w = min[ pb.w * 0.3, pb.h * 0.45 * ar ]
        inst.pip_w = clamp[ inst.pip_w, min[ 120.0, top ], top ]
        h : f32 [ inst.pip_w / ar ]
        inst.pip_r = clamp[ inst.pip_r, 0.0,
                            max[ pb.w - inst.pip_w, 0.0 ] ]
        inst.pip_b = clamp[ inst.pip_b, 0.0, max[ pb.h - h, 0.0 ] ]

    # each frame: the shown box eases to the asked one
    func on_state [ m: i32 ]
        if [ inst && parent && parent.bounds ]
            keep_in[ parent.bounds ]
            if [ inst.pip_sw <= 0.0 ]
                inst.pip_sr = inst.pip_r
                inst.pip_sb = inst.pip_b
                inst.pip_sw = inst.pip_w
            el
                ff : f32 [ ux.frame_factor ]
                inst.pip_sr = filter_n[ inst.pip_sr, inst.pip_r, 0.3,
                                         ff ]
                inst.pip_sb = filter_n[ inst.pip_sb, inst.pip_b, 0.3,
                                         ff ]
                inst.pip_sw = filter_n[ inst.pip_sw, inst.pip_w, 0.3,
                                         ff ]
            area = Region [ pip_at[ inst ] ]
            pristine = false
        super.on_state[ m ]

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds || !inst ]
            return
        cv : Canvas w.screen
        inst.draw_fitted[ cv, rect [ x: 0.0, y: 0.0, w: bounds.w,
                                     h: bounds.h ] ]
        cv.fill_color[ rgba [ '#0000' ] ]
        cv.stroke_color[ rgba [ '#ffffff30' ] ]
        cv.stroke_width[ 1.0 ]
        cv.stroke_offset[ -0.5 ]
        cv.rounded_rect[ 0.0, 0.0, bounds.w, bounds.h, 0.0, 0.0, 0.0,
                         0.0 ]
        cv.paint[]
        cv.stroke_width[ 0.0 ]
        cv.stroke_offset[ 0.0 ]
        ux.will_animate = true

    # the edges within 8 px of a point in the box
    func edges_at [ p: vec2f ] -> i32
        if [ !bounds ] return 0
        g : f32 [ 8.0 ]
        s : i32 [ 0 ]
        if [ p.x < g ] s |= 1
        if [ p.y < g ] s |= 2
        if [ p.x > bounds.w - g ] s |= 4
        if [ p.y > bounds.h - g ] s |= 8
        return s

    func cursor_for [ s: i32 ]
        kind : i32 [ 0 ]
        if [ s == 1 || s == 4 ] kind = 1
        if [ s == 2 || s == 8 ] kind = 2
        if [ s == 3 || s == 12 ] kind = 5
        if [ s == 6 || s == 9 ] kind = 6
        ux.seam_cursor[ kind ]

    func on_press [ ev: Event ]
        ev.no_default = true
        ev.stop[]
        if [ !inst ] return
        # the window's pointer: the box moves under its own
        grab = vec2f [ f32[ ux.mouse.x ], f32[ ux.mouse.y ] ]
        from_r = inst.pip_r
        from_b = inst.pip_b
        from_w = inst.pip_w
        side = edges_at[ ev.mouse.pos ]
        dragging = true
        moved = false
        set_capture[]

    func on_move [ ev: Event ]
        if [ !dragging ]
            cursor_for[ edges_at[ ev.mouse.pos ] ]
            return
        if [ !inst || !parent || !parent.bounds ] return
        dx : f32 [ f32[ ux.mouse.x ] - grab.x ]
        dy : f32 [ f32[ ux.mouse.y ] - grab.y ]
        if [ !moved && abs[ dx ] + abs[ dy ] < 4.0 ] return
        moved = true
        pb : rect parent.bounds
        ar : f32 aspect[]
        h0 : f32 [ from_w / ar ]
        if [ side == 0 ]
            inst.pip_r = from_r - dx
            inst.pip_b = from_b - dy
        el
            # the box in the view's terms; the far edges stay
            l0 : f32 [ pb.w - from_r - from_w ]
            t0 : f32 [ pb.h - from_b - h0 ]
            nw : f32 [ 0.0 ]
            if [ (side & 4) != 0 ] nw = from_w + dx
            if [ (side & 1) != 0 ] nw = from_w - dx
            if [ (side & 8) != 0 ] nw = max[ nw, (h0 + dy) * ar ]
            if [ (side & 2) != 0 ] nw = max[ nw, (h0 - dy) * ar ]
            top : f32 [ min[ pb.w, pb.h * ar ] ]
            nw = clamp[ nw, min[ 120.0, top ], top ]
            nh : f32 [ nw / ar ]
            l : f32 [ ((side & 1) != 0) ? l0 + from_w - nw : l0 ]
            t : f32 [ ((side & 2) != 0) ? t0 + h0 - nh : t0 ]
            inst.pip_w = nw
            inst.pip_r = pb.w - l - nw
            inst.pip_b = pb.h - t - nh
        keep_in[ pb ]
        ux.will_animate = true

    func on_release [ ev: Event ]
        ev.no_default = true
        ev.stop[]
        dragging = false
        ux.release_capture[ a ]
        ux.seam_cursor[ 0 ]
        if [ moved ] return
        o : orbiter [ ux.app_object ]
        if [ !o || !inst ] return
        for [ q: i32 0, q < o.editor_slots.count, q += 1 ]
            eq : Editor o.pane_at[ q ]
            if [ eq && eq.run_view == inst ]
                o.set_display[ eq, inst, 1 ]
        ux.restyle = true

# the build card's avatar: in its build look while the card is up
OrbiterAvatar BuildAvatar
    func on_state [ m: i32 ]
        swap_on = true
        work_on = true
        super.on_state[ m ]

    # it draws straight onto the screen: the card's fade, by hand
    func draw [ w: Window ]
        op : f32 [ (parent) ? parent.opacity : 1.0 ]
        if [ op <= 0.0 ] return
        w.screen.save[]
        w.screen.set_opacity[ w.screen.get_opacity[] * op ]
        super.draw[ w ]
        w.screen.restore[]

# an app on its way into the pane (compiling, then starting): the
# avatar building it, the app's icon and name, and how far it is
element BuildCard
    animated : true
    public inst : AppView
    mutable icon : AppIcon
    mutable born_ms : i64

    # none for its first 200 ms, then in over 400 ms
    func on_state [ m: i32 ]
        if [ born_ms == 0 ] born_ms = epoch_millis[]
        dt : f32 [ f32[ epoch_millis[] - born_ms ] - 200.0 ]
        opacity = clamp[ dt / 400.0, 0.0, 1.0 ]
        super.on_state[ m ]

    func render [] -> Elements
        t : Elements []
        if [ !bounds ] return t
        side : f32 [ round[ min[ bounds.w * 0.5, bounds.h * 0.45 ] ] ]
        half : f32 [ round[ side * 0.5 ] ]
        top  : f32 [ round[ bounds.h * 0.08 ] ]
        t['avatar'] = BuildAvatar [ area: Region [
            'l50%-{half}px t{top}px w{side}px h{side}px' ] ]
        return t

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds || !inst ]
            return
        cv : Canvas w.screen
        side : f32 [ round[ min[ bounds.w * 0.5, bounds.h * 0.45 ] ] ]
        top  : f32 [ round[ bounds.h * 0.08 ] + side ]
        dir  : path (inst.src) ? inst.src.directory[] : null
        if [ dir && (!icon || '{icon.file}' != '{dir}') ]
            orb : orbiter [ ux.app_object ]
            nm : string orb.install_name_of[ dir.filename[] ]
            ag : path '{install_root[]}/export/{nm}.agi'
            icon = AppIcon [ file: dir, module: true, agi: ag ]
        isz : f32 [ 64.0 ]
        nm  : string [ (inst.app_mod) ? inst.app_mod : '' ]
        # save and restore keep no font: it goes back by hand
        was : CanvasFont cv.font
        cv.save[]
        cv.set_font[ shared_font[ cv,
            'fonts/BarlowCondensed-Regular.ttf', 34 ] ]
        nw : f32 [ cv.measure_text[ nm ].w ]
        x  : f32 [ round[ (bounds.w - isz - 16.0 - nw) * 0.5 ] ]
        if [ icon ] icon.paint[ cv, x, top, isz ]
        cv.fill_color[ rgba [ '#f0f0f4' ] ]
        cv.draw_text[ nm, rect [ x: x + isz + 16.0, y: top, w: nw + 4.0,
            h: isz ], vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
            Overflow.visible, null, true ]
        cv.paint[]
        cv.set_font[ shared_font[ cv,
            'fonts/BarlowCondensed-Regular.ttf', 20 ] ]
        st : string inst.status_word[]
        py : f32 [ top + isz + 10.0 ]
        if [ st == 'compiling' ]
            # a pill round the words
            pw : f32 [ round[ cv.measure_text[ st ].w + 56.0 ] ]
            ph : f32 [ 30.0 ]
            px : f32 [ round[ (bounds.w - pw) * 0.5 ] ]
            pr : f32 [ ph * 0.5 ]
            cv.fill_color[ rgba [ '#0000' ] ]
            cv.stroke_color[ rgba [ '#806bff' ] ]
            cv.stroke_width[ 1.0 ]
            cv.stroke_offset[ -0.5 ]
            cv.rounded_rect[ px, py, pw, ph, pr, pr, pr, pr ]
            cv.paint[]
            cv.stroke_width[ 0.0 ]
            cv.stroke_offset[ 0.0 ]
        cv.fill_color[ rgba [ '#e8e0ff' ] ]
        cv.draw_text[ st, rect [ x: 0.0, y: py, w: bounds.w, h: 30.0 ],
            vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible,
            null, true ]
        cv.paint[]
        cv.restore[]
        cv.set_font[ was ]

# the find line's replace buttons: flat, edge to edge
LabelButton FindSwitch
    style : CSS {
        layers.body:
            fill_color: #0000
            radius: 0
            stroke_width: 1
            stroke_color: #fff1
            stroke_offset: -0.5
        :hovered
            layers.body:
                fill_color: #ffffff10
        :selected
            layers.body:
                fill_color: #4d3dbcaa
                stroke_color: #806bff
    }

# the find line's replace text: Enter and Esc go to orbiter first
element RepText
    func on_key [ ev: Event ]
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ orb ] orb.on_key[ ev ]
    style : CSS {
        layers.body:
            fill_color: #0000
            stroke_width: 1
            stroke_color: #fff1
            stroke_offset: -0.5
        layers.face:
            label_color: #fff6
            label_size: 17
            editable: true
            label_align: 0.0 0.5
            label_offset: 8.0 0.0
        :focused
            layers.face:
                label_color: #ffff
        :has_value
            layers.face:
                label_color: #ffff
    }

element EditorTitle
    selected : bool
    # the active pane's title: the selection colour, as the dock's
    public current  : bool
    # newfile mode: typed name collides with an existing file
    public conflict : bool
    # painted after the name, never part of the editable label
    public hint     : string
    # the toggle sits at the left: the name moves past it
    public switched : bool
    # its find icon as wide as the orbiter button: the text after it
    public wide     : bool
    # at a free window's foot: its corners round, as the window's
    public free     : bool

    # typing here is the navigator's search: the field edits, then
    # orbiter reads its text
    func on_char [ ev: Event ]
        field_char[ a, ev ]
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ orb ] orb.on_char[ ev ]
        ev.no_default = true

    func on_key [ ev: Event ]
        field_key[ a, ev ]
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ orb ] orb.on_key[ ev ]
        ev.no_default = true
    public blur : TitleBlur []
    style : CSS {
        area: l0 t0 r0 h1.3
        # named first: the ground draws under the bar and its text
        layers.blur:
            fill_color: #0000
        layers.tbar:
            # a faint tint; the active pane's is the selection
            fill_color: #0004
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            stroke_color: #fff1
            near_border: true
            near_inset: 1.0
            near_inset_color: #c890ffaa
        layers.tface:
            label_color: #fff
            label_size: 17
            editable: true
            label_align: 0.0 0.5
            label_offset: 22.0 0.0
        # its own colour (a third of the selection's alpha), so a
        # theme can map it apart
        :current
            layers.tbar:
                fill_color: #66225539
        # past the run button (1.35 units, 44.6 px at rest) by 8 px;
        # the bar's first menu name starts at the same x
        :switched
            layers.tface:
                label_offset: 52.6 0.0
        # the find icon the orbiter button's width (2.39 units) + 8 px
        :wide
            layers.tface:
                label_offset: 86.9 0.0
        :conflict
            layers.tface:
                label_color: #e05e5e
        # its buttons cut to the round too (the find icon, the views)
        :free
            layers.tbar:
                radius: 0 0 8 8
                clip: true
        layers.tdiv:
            fill_color: #fff2
            area: l0 b0 r0 h1px
    }

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        if [ !label || label.count == 0 ] return
        cv  : Canvas [ w.screen ]
        # the gaps ride the font unit, as the name's size does
        fu  : f32 [
            (w.vk && w.vk.font_unit > 0) ? f32[ w.vk.font_unit ] / 22.0
            : 1.0 ]
        # the view we are in, trailing the name. painted, so the label
        # stays the editable field and this can never be selected
        cv.font_size[ 17 ]
        name_m : cv.measure_text[ label ]
        # the name starts at the label's offset
        off_   : f32 [ (wide) ? 97.0 : ((switched) ? 62.7 : 22.0) ]
        trail  : f32 [ (off_ + 16.0) * fu + name_m.w ]
        if [ hint && hint.count > 0 ]
            cv.font_size[ 13 ]
            cv.fill_color[ '#ffffff66' ]
            cv.stroke_width[ 0.0 ]
            cv.draw_text[ hint,
                rect [ x: trail, y: 0.0, w: bounds.w, h: bounds.h ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip,
                null, true ]
            cv.paint[]


# the console's toolbar: a dark ground, a line at its foot
# a code window's foot: its console and debugger buttons
element PaneFoot
    # a free window's: its foot corners round, as the window's
