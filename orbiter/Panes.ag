# the console's input line: Enter sends it (the app's standard
# input, or lldb's); edge to edge at the console's foot, a line over
element ConsoleLine
    focusable : true
    style : CSS {
        layers.body:
            fill_color: #0000
        layers.top:
            fill_color: #fff2
            area: l0 t0 r0 h1px
        layers.face:
            label_color: #fff
            label_size: 15
            editable: true
            label_align: 0.0 0.5
            label_offset: 8.0 0.0
        :focused
            layers.top:
                fill_color: #806bff
    }

    public func on_key [ ev: Event ]
        if [ !ev.key.state || ev.key.unicode != 257 ] return
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        # sent before the field empties: the line is the field's text
        if [ orb && edit ]
            orb.console_input[ edit, orb.pane_index_of[ a ] ]
        edit     = ''
        pristine = false
        ev.no_default = true

# a free window's ground, under it: its piece of the screen's own
# paint (the blurred scene), as a docked pane has under it; the
# window then draws as it does docked, its own tint once
element WinGround
    animated : true
    ghost    : true

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        cv : Canvas w.screen
        sw : f32 [ f32[ w.width ] ]
        sh : f32 [ f32[ w.height ] ]
        if [ sw <= 0.0 || sh <= 0.0 ] return
        cv.save[]
        # the window's corners
        cv.clip_rounded_rect[ 0.0, 0.0, bounds.w, bounds.h, 8.0, 8.0,
                              8.0, 8.0 ]
        if [ w.frost_eff[] == 3 || !w.backdrop ]
            cv.fill_color[ w.solid_color ]
            cv.rect_to[ 0.0, 0.0, bounds.w, bounds.h ]
            cv.paint[]
        el
            # as the screen's own paint: the blur chain is there only
            # with a backdrop
            bl : Render w.blur_src[]
            tx : f32 cv.transform_tx[]
            ty : f32 cv.transform_ty[]
            cv.draw_image_crop[ (bl) ? bl.color : w.backdrop.color,
                rect [ x: 0.0, y: 0.0, w: bounds.w, h: bounds.h ],
                tx / sw, ty / sh, (tx + bounds.w) / sw,
                (ty + bounds.h) / sh ]
        cv.restore[]

# a free window's shadow: under it, 24 px out each way
element WinShade
    ghost : true
    style : CSS {
        layers.shade:
            area: l24px t24px r24px b24px
            fill_color: #0000
            radius: 8
            box_shadow: 0 8px 20px #000a
    }

# a free window's edge: an inner glow over it, no line (nothing in
# nature is a border)
element WinEdge
    ghost : true
    public square   : bool
    selected : bool
    style : CSS {
        layers.edge:
            fill_color: #0000
            stroke_width: 0
            # a third of it while another window is the selected one
            box_shadow: inset 0 0 8px #ffffff11 curve 2
            radius: 8
        :selected
            layers.edge:
                box_shadow: inset 0 0 8px #ffffff22 curve 2
        :square
            layers.edge:
                radius: 0
    }

# a free window's strip across its top: the system bar it took
# with it (its menus, title, arrows, close). a drag on it moves the
# window; let go at the top edge, or a double click, it docks
element WinStrip
    public pane    : i32
    # the selected window's: the selection colour, as the title's
    public current : bool
    # a docked window's (under another): square, as the split is
    public docked  : bool
    intern held    : bool
    intern pulled  : bool
    intern went    : f32
    # the drag so far, x and y
    intern sx      : f32
    intern sy      : f32

    public blur : StripBlur [ round: 8.0 ]
    style : CSS {
        area: l0 t0 r0 h0.91
        # a faint tint; the selected one's the selection, as a
        # docked title's
        layers.tbar:
            fill_color: #0004
            radius: 8 8 0 0
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            stroke_color: #fff1
            near_border: true
            near_inset: 1.0
            near_inset_color: #c890ffaa
        layers.tface:
            label_color: #fff
            label_size: 13
            label_align: 0.5 0.5
        :current
            layers.tbar:
                fill_color: #66225539
        :docked
            layers.tbar:
                radius: 0
        layers.tdiv:
            fill_color: #fff2
            area: l0 b0 r0 h1px
    }

    func orb [] -> orbiter
        return cast orbiter [ (ux) ? ux.app_object : null ]

    func on_press [ ev: Event ]
        o : orb[]
        # a press on its menus or buttons is theirs
        if [ !o || ev.origin != a ] return
        ev.no_default     = true
        ev.no_propagation = true
        if [ ev.mouse.double_click ]
            o.dock_pane[ pane ]
            return
        o.raise_pane[ pane ]
        held   = true
        pulled = false
        went   = 0.0
        sx     = 0.0
        sy     = 0.0
        ux.set_capture[ a ]

    func on_move [ ev: Event ]
        o : orb[]
        if [ !held || !o ] return
        dx : f32 [ ev.mouse.delta.x ]
        dy : f32 [ ev.mouse.delta.y ]
        went += max[ dx, -dx ] + max[ dy, -dy ]
        if [ !pulled ]
            sx += dx
            sy += dy
            if [ went < 6.0 ] return
            pulled = true
            dx = sx
            dy = sy
            o.pull_free[ pane, a.parent ]
        o.move_free[ pane, dx, dy ]

    func on_release [ ev: Event ]
        if [ held ] ux.release_capture[ a ]
        o : orb[]
        if [ pulled && o ] o.drop_free[ pane ]
        held   = false
        pulled = false

# the system bar's free space: the docked window's title. pulled
# down, the window comes free under the pointer; a click is the
# title's
element BarGrab
    public pane : i32
    # under the address: a click (no drag) edits it
    public url  : bool
    intern held : bool
    intern went : f32
    # the drag so far, x and y
    intern sx   : f32
    intern sy   : f32
    intern pulled : bool
    # dragged sideways: the desktop split in beside it
    intern split  : bool

    func orb [] -> orbiter
        return cast orbiter [ (ux) ? ux.app_object : null ]

    func on_press [ ev: Event ]
        o : orb[]
        if [ o ] o.grab_pane = pane
        held   = true
        pulled = false
        split  = false
        went   = 0.0
        sx     = 0.0
        sy     = 0.0
        ux.set_capture[ a ]
        ev.no_default     = true
        ev.no_propagation = true

    func on_move [ ev: Event ]
        o : orb[]
        if [ !held || !o ] return
        dx : f32 [ ev.mouse.delta.x ]
        dy : f32 [ ev.mouse.delta.y ]
        went += max[ dx, -dx ] + max[ dy, -dy ]
        if [ split ] return
        if [ !pulled ]
            sx += dx
            sy += dy
            if [ went < 6.0 ] return
            # sideways past 40 px: the desktop beside the window, which
            # takes the side it went to (else it comes free)
            if [ max[ sx, -sx ] > max[ sy, -sy ] ]
                if [ max[ sx, -sx ] < 40.0 ] return
                if [ o.split_side[ pane, sx > 0.0 ]
                     || o.swap_side[ pane, sx > 0.0 ] ]
                    split = true
                    return
            pulled = true
            dx = sx
            dy = sy
            o.pull_free[ pane, o.pane_view[ pane ] ]
        o.move_free[ pane, dx, dy ]

    func on_release [ ev: Event ]
        if [ held ] ux.release_capture[ a ]
        o : orb[]
        # a click on its blank space: the window selected, nothing
        # opened
        if [ held && !pulled && !split && o ]
            o.raise_pane[ pane ]
            if [ url ] o.bar_type_start[]
            if [ ux ] ux.restyle = true
        el [ pulled && o ]
            o.drop_free[ pane ]
        if [ o ] o.grab_pane = -1
        held   = false
        pulled = false

# a free window's edge, just outside it: 1 right, 2 bottom, 4
# left, 8 top; a corner is two together: a drag sizes it
element FreeGrip
    public pane : i32
    public side : i32
    intern held : bool

    func orb [] -> orbiter
        return cast orbiter [ (ux) ? ux.app_object : null ]

    func on_press [ ev: Event ]
        o : orb[]
        if [ !o ] return
        o.raise_pane[ pane ]
        held = true
        ux.set_capture[ a ]
        ev.no_default     = true
        ev.no_propagation = true

    func on_move [ ev: Event ]
        o : orb[]
        # the corner takes both ways
        kind : i32 [ (side == 2 || side == 8) ? 2 : 1 ]
        if [ side == 3 || side == 12 ] kind = 5
        if [ side == 6 || side == 9 ] kind = 6
        if [ ux ] ux.seam_cursor[ kind ]
        if [ !held || !o ] return
        o.size_free[ pane, side, ev.mouse.delta.x, ev.mouse.delta.y ]

    func on_release [ ev: Event ]
        if [ held ] ux.release_capture[ a ]
        held = false

    func on_leave [ ev: Event ]
        if [ !held && ux ] ux.seam_cursor[ 0 ]

# a window's tab being dragged: its name under the pointer
element TabGhost
    animated    : true
    user_events : false

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        o : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ !o || o.tab_drag < 0 ] return
        cv : Canvas w.screen
        un : f32 ux_unit[ ux ]
        nm : string o.pane_label[ o.tab_drag ]
        fp : i32 [ i32[ round[ 18.0 * un ] ] ]
        tw : f32 [ (f32[ nm.count ] * 9.5 + 22.0) * un ]
        th : f32 [ round[ 30.0 * un ] ]
        m : vec2f w.last_move
        # where it would land
        hr : rect o.drop_hint[ m, o.tab_drag ]
        if [ hr.w > 0.0 ]
            cv.save[]
            cv.fill_color[ rgba [ '#806bff2e' ] ]
            cv.stroke_color[ rgba [ '#806bff' ] ]
            cv.stroke_width[ 2.0 ]
            cv.rounded_rect[ hr.x + 4.0, hr.y + 4.0, hr.w - 8.0,
                             hr.h - 8.0, 8.0, 8.0, 8.0, 8.0 ]
            cv.paint[]
            cv.restore[]
        cv.save[]
        cv.fill_color[ rgba [ '#4d3dbccc' ] ]
        cv.stroke_color[ rgba [ '#806bff' ] ]
        cv.stroke_width[ 1.0 ]
        cv.rounded_rect[ m.x - tw * 0.5, m.y - th * 0.5, tw, th,
                         6.0, 6.0, 6.0, 6.0 ]
        cv.paint[]
        cv.set_font[ shared_font[ cv,
            'fonts/BarlowCondensed-Bold.ttf', fp ] ]
        cv.font_size[ f32[ fp ] ]
        cv.fill_color[ rgba [ '#ffffff' ] ]
        cv.draw_text[ nm, rect [ x: m.x - tw * 0.5, y: m.y - th * 0.5,
            w: tw, h: th ], vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ],
            Overflow.ellipsis, null, true ]
        cv.set_font[ null ]
        cv.restore[]

# a console from the project's agi (shell, claude), as a view the rail
# lists like any other: the pane composes the Console for that session
ResourceView ConsoleView
    public session  : string
    public sessions : map ConsoleSession[string]
    public launch   : string
    # not a file's view: the process is given the folder in view
    public folder   : path
