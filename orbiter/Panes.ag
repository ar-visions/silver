            fill_color: #0000
        layers.tbar:
            fill_color: #0004
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            stroke_color: #fff1
            # square again once docked: a state's value stays unless
            # the base names its own
            radius: 0 0 0 0
        layers.line:
            fill_color: #fff2
            area: l0 t0 r0 h1px
        :free
            layers.tbar:
                radius: 0 0 8 8
    }

element ConsoleBar
