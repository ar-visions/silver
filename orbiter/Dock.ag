extend orbiter

# the dock: its buttons, pins and tasks

# the dock: left side, 2.25x the status bar's height
Group Dock
    style : CSS {
        area: l0 t0 w2.39 b0
        layers.dock:
            # the title bar's purple; the old base marks the selected
            fill_color: #1d0f3f, 400ms cubic outward
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            stroke_color: #fff1
            near_border: true
            near_inset: 1.0
            near_inset_color: #c890ffaa
        layers.ddiv:
            fill_color: #ffffff11
            area: r0 t0 w1px b0
    }

# a dock icon: no ground, the pointer's near border and glow
TButtons DockButton
    style : CSS {
        layers.edge:
            fill_color: #0000
            box_shadow: inset 0 0 13px #c890ff04
            stroke_width: 1
            stroke_color: #fff1
            near_border: true
            near_inset: 2.0
            near_inset_color: #c890ffaa
        layers.lite:
            fill_color: #fff2
            area: l0 b2px r0 h1px
        layers.foot:
            fill_color: #00000099
            area: l0 b1px r0 h1px
    }

# orbiter's own dock button: the status bar's height, no dark foot.
# no colour of its own: the dock's shows through; a state tints its
# segment fill (rest_fill), set where its icon is picked
DockButton DockHome
    style : CSS {
        layers.edge:
            fill_color: #0000
            box_shadow: inset 0 0 13px #8af0
            near_inset: 2.0
            near_reach: 0.5
            near_inset_color: #c890ffff
        layers.foot:
            fill_color: #0000
        layers.top:
            fill_color: #fff2
            area: l0 t0 r0 h1px
    }

# orbiter's button in the system bar: the tray buttons' fill and near
# light; no top line (that was the dock's foot) and no dock line
DockHome BarHome
    style : CSS {
        layers.edge:
            fill_color: #0000
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            # 1/255: unseen at rest, yet the near light lights it
            stroke_color: #ffffff01
            near_border: true
            near_reach: 0.5
            near_inset: 4.0
            near_inset_color: #c890ffff
        layers.lite:
            fill_color: #0000
        layers.foot:
            fill_color: #0000
        layers.top:
            fill_color: #0000
    }

# the dock's history arrows: a light line at their bottom; the
# dark one is DockLine, the row under them
TButtons DockNav
    style : CSS {
        layers.lite:
            fill_color: #fff2
            area: l0 b1px r0 h1px
    }

# the dock's pins: they scroll by the wheel alone (no thumb)
element DockPins
    scrollbar : ScrollLayer [ overlay: true, thumb_w: 0.0,
                              thumb_color: '#0000' ]
    # the pins' height (content_h is the element's own, kept by it)
    public rows_h : f32
    mutable shown_y : f32
    public func tick [ w: Window ]
        content_h = rows_h
        # the rows follow the scroll as it eases: the dock forms again
        if [ scroll.y != shown_y ]
            shown_y = scroll.y
            w.restyle = true
            w.will_animate = true
    public func on_wheel [ ev: Event ]
        content_h = rows_h
        super.on_wheel[ ev ]

# the dark line under the dock's arrows
element DockLine
    style : CSS {
        layers.line:
            fill_color: #0000
    }

# a pin in the dock: its app icon, else the nav list's icon
element DockIcon
    no_cache : true
    public  file   : path
    public  module : bool
    # a program's own icon file, instead of its module's
    public  icon_file : path
    # its running instances: a dot each under the icon
    public  count  : i32
    # a program on PATH: a click runs it, or shows it
    public  program : bool
    # the name under the icon ('' its file's)
    public  name    : string
    # the icon alone, centred: no name, no dots (a title's)
    public  plain   : bool
    # the module's export, where its icon name is
    public  agi    : path
    # remade when a reused pin points at another folder
    mutable icon   : AppIcon
    # its place in the column: neighbours share one border
    first  : bool
    last   : bool
    style : CSS {
        # the next icon's top is the line between two; the arrows'
        # light line is the first one's top
        layers.edge:
            fill_color: #0000
            box_shadow: inset 0 0 13px #c890ff04
            stroke_width: 1 1 0 1
            stroke_color: #ffffff09
            near_border: true
            near_reach: 0.5
            near_inset: 4.0
            near_inset_color: #c890ffff
        layers.lite:
            fill_color: #0000
            area: l0 b2px r0 h1px
        layers.foot:
            fill_color: #0000
            area: l0 b1px r0 h1px
        :first
            layers.edge:
                stroke_width: 0 1 0 1
        :last
            layers.edge:
                stroke_width: 1 1 1 1
            layers.lite:
                fill_color: #fff2
        :selected
            layers.edge:
                # the dock's old base, flipped with the purple
                fill_color: #625a
                stroke_color: #fff3
                # its own inner glow, lit or not
                box_shadow: inset 0 0 13px #c890ff88
    }
    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        if [ !bounds || !file ] return
        cv : Canvas w.screen
        if [ !icon || '{icon.file}' != '{file}'
             || '{icon.icon_file}' != '{icon_file}' ]
            icon = AppIcon [ file: file, module: module, agi: agi,
                icon_file: icon_file ]
        orb : cast orbiter [ w.app_object ]
        named : bool [ orb && orb.set_dock_names == 'on' ]
        if [ plain || !named ]
            # no name: the icon larger, centred
            pk : f32 [ (plain) ? 0.55 : 0.66 ]
            psz : f32 [ round[ min[ bounds.w, bounds.h ] * pk ] ]
            icon.paint[ cv, round[ (bounds.w - psz) * 0.5 ],
                        round[ (bounds.h - psz) * 0.5 ], psz ]
            if [ !plain ] dots[ cv ]
            return
        # the icon high, its name under it, the dots at its left
        isz : f32 [ round[ bounds.w * 0.5 ] ]
        ix  : f32 [ round[ (bounds.w - isz) * 0.5 ] ]
        iy  : f32 [ round[ bounds.h * 0.13 ] ]
        icon.paint[ cv, ix, iy, isz ]
        nm : string (name && name.count > 0) ? name : file.filename[]
        # 14 px at rest, with the font scale
        un : f32 ux_unit[ w ]
        fpx : i32 [ i32[ round[ 14.0 * un ] ] ]
        cv.set_font[ shared_font[ cv,
            'fonts/BarlowCondensed-Regular.ttf', fpx ] ]
        cv.font_size[ fpx ]
        cv.fill_color[ rgba [ '#ffffffcc' ] ]
        cv.draw_text[ nm, rect [ x: 4.0, y: iy + isz + 1.0,
                                 w: bounds.w - 8.0, h: 16.0 * un ],
            vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.ellipsis,
            null, true ]
        cv.paint[]
        cv.set_font[ null ]
        dots[ cv ]

    # a dot an instance at the button's left edge
    func dots [ cv: Canvas ]
        if [ count > 0 ]
            gh : f32 [ f32[ count * 8 - 4 ] + 4.0 ]
            # centred on the whole button's height
            gy : f32 [ round[ (bounds.h - gh) * 0.5 ] ]
            cv.fill_color[ rgba [ '#ffffffcc' ] ]
            for [ d_: i32 0, d_ < count, d_ += 1 ]
                cv.arc[ 4.0, gy + 4.0 + f32[ d_ * 8 ], 2.0, 0.0, 6.2832 ]
                cv.paint[ ]

# the title's icon: a module's app icon, else the file's type icon
DockIcon TitleIcon
    plain : true
    style : CSS {
        layers.edge:
            fill_color: #0000
            stroke_width: 0
            box_shadow: none
            near_border: false
            near_inset: 0.0
        layers.lite:
            fill_color: #0000
        layers.foot:
            fill_color: #0000
    }

# back into the split, maximized
func orbiter.dock_pane [ i: i32 ]
    if [ !pane_floats[ i ] ] return
    pane_free[ i * 4 + 2 ] = 0.0
    fo : i32 [ free_at[ i ] ]
    if [ fo >= 0 ] free_order.remove[ fo ]
    # beside a docked window: it takes the desktop half's place
    # (else the right end); alone it is maximized, the desktop
    # panes closed, no memory of a split
    kept : bool [ false ]
    desk : i32 [ -1 ]
    for [ q: i32 0, q < editor_slots.count, q += 1 ]
        if [ q == i || pane_floats[ q ] || pane_out[ q ] ] continue
        if [ pane_empty[ q ] ]
            if [ desk < 0 ] desk = q
        el
            kept = true
    pi : i32 [ i ]
    if [ kept ]
        sq : vec i32 []
        for [ q: i32 ] in pane_order[]
            if [ q == pi ] continue
            if [ q == desk ] sq.push[ pi ]
            sq.push[ q ]
        if [ desk < 0 ] sq.push[ pi ]
        seq_set[ sq ]
        if [ desk >= 0 ]
            close_pane[ desk ]
            if [ desk < pi ] pi -= 1
    el
        for [ q: i32 i32[ editor_slots.count ] - 1, q >= 0, q -= 1 ]
            if [ q == pi || pane_floats[ q ] || !pane_empty[ q ] ]
                continue
            close_pane[ q ]
            if [ q < pi ] pi -= 1
        seq_set[ null ]
    active_pane = pi
    force_update[]

# the dock never hides: an app in view is chosen, raised
func orbiter.dock_choose [ pi: i32 ]
    active_pane = pi
    raise_pane[ pi ]

# the window docked on a side of the whole layout (1 left, 2
# right, 3 bottom, 7 top): out of its group, docked if free; a
# desktop made beside it when it is alone
func orbiter.dock_edge [ pi: i32, side: i32 ]
    dock_in[ pi ]
    if [ !docked_beside[ pi ] && editor_slots.count < 4 ]
        editor_slots += -1
        pane_console += ''
    down : bool [ side == 3 || side == 7 ]
    t : PaneNode tree[]
    t.drop_leaf[ pi ]
    t.tidy[]
    if [ t.down != down ]
        t = PaneNode [ down: down, kids: vec PaneNode [] [ t ] ]
    lf : PaneNode [ pane: pi ]
    if [ side == 1 || side == 7 ] t.kids.insert[ lf, 0 ]
    el t.kids.push[ lf ]
    tree_set[ t ]
    dock_settle[ pi, side ]

# out of its group, docked if free, in view
func orbiter.dock_in [ pi: i32 ]
    if [ grp_of[ pi ] >= 0 ] grp_leave[ pi, false ]
    if [ pane_floats[ pi ] ]
        pane_free[ pi * 4 + 2 ] = 0.0
        fo : i32 [ free_at[ pi ] ]
        if [ fo >= 0 ] free_order.remove[ fo ]
    show_now[ pi ]

# pi chosen, the layout kept
func orbiter.dock_settle [ dp: i32, side: i32 ]
    active_pane = dp
    raise_pane[ dp ]
    log 'layout: window {dp} docked on side {side}'
    save_session[]
    force_update[]

# the window let go on the bar: the whole area. empty panes close;
# the other docked windows join its group, behind it
func orbiter.dock_full [ pi: i32 ]
    dock_in[ pi ]
    dp : i32 [ pi ]
    for [ q: i32 i32[ editor_slots.count ] - 1, q >= 0, q -= 1 ]
        if [ q == dp || pane_floats[ q ] || pane_out[ q ]
             || !pane_empty[ q ] ]
            continue
        close_pane[ q ]
        if [ q < dp ] dp -= 1
    for [ q: i32 0, q < editor_slots.count, q += 1 ]
        if [ q == dp || pane_floats[ q ] || pane_out[ q ] ]
            continue
        grp_join[ q, dp ]
    grp_show[ dp ]
    dock_settle[ dp, 8 ]

# apps are toggles: one in view goes out of it (still running),
# the pane back where it was; a window's pane has no editor
# mounted until the next frame
func orbiter.dock_run_click [ iid: i32 ]
    if [ mini_restore[ iid ] ] return
    avd : AppView instance_by[ iid ]
    # an app of several: the next after the one in view, else the
    # one shown somewhere, else its first (its window, or a tab)
    gr : vec AppView inst_reg[].of_app[ avd ]
    if [ gr.count > 1 ]
        cur : AppView null
        for [ g: AppView ] in gr
            q : i32 pane_showing[ g ]
            if [ q < 0 || pane_hidden[ q ] || !in_view[ g, q ] ] continue
            if [ q == active_pane || !cur ] cur = g
        cq : i32 [ (cur) ? pane_showing[ cur ] : -1 ]
        nx : AppView [ (cur && cq == active_pane)
            ? inst_reg[].step[ avd, cur ] : ((cur) ? cur : gr[ 0 ]) ]
        show_own[ nx.iid ]
        return
    # asking for its argument: its pick, put aside or back
    if [ avd && avd.asking && avd.slot < 0 ]
        if [ pick_launch == avd ] pick_hide[]
        el pick_show[ avd ]
        if [ ux ] ux.restyle = true
        return
    wvd : u64 window_of[ avd ]
    # in the background with no window (steam in its tray): its tray
    # item asked to show it, as a click on its tray icon does
    if [ avd && avd.background && wvd == 0 && !shown_in_pane[ avd ] ]
        tray_raise[ avd ]
        return
    # in a pane: the chip hides it, or shows it again as it was
    # (its state kept, the app running all the while; its code is
    # the window's own toggle, pcode)
    if [ avd ]
        for [ q: i32 0, q < editor_slots.count, q += 1 ]
            edq : Editor pane_at[ q ]
            if [ (wvd != 0 && pane_window[ q ] == wvd)
                 || (wvd == 0 && edq && edq.run_view == avd) ]
                if [ pane_hidden[ q ] ] unhide[ q ]
                # stepped aside for the pane's edit: over it again
                el [ wvd == 0 && !edq.app_view ]
                    embed_app[ edq, avd ]
                    active_pane = q
                el dock_choose[ q ]
                if [ ux ] ux.restyle = true
                return
    # back in view means embedded (a file's viewer says PIP)
    if [ avd && avd.display == 0 ]
        avd.display = 1
        avd.pip     = false
        tell_display[ avd ]
    show_instance[ iid, active_pane ]
    if [ ux ] ux.restyle = true

# a pinned program: its running instance, else a new one
func orbiter.dock_program_click [ p: path ]
    ps : string '{p}'
    if [ instances ]
        for [ av: AppView ] in instances
            if [ av.slot < 0 || av.ended || av.held ] continue
            if [ pin_key_of[ av ] == ps ]
                dock_run_click[ av.iid ]
                return
    run_program[ p, active_pane ]

# a pin the dock shows: there, and not a plain folder (those are
# the navigator's pinned)
func orbiter.dock_pin [ ps: string ] -> bool
    pp : path ps
    return pp.exists[] && !plain_folder[ pp ]

# a dock pin's click: a program shows or runs; a module or file
# opens its source (shift: a module's new instance)
func orbiter.dock_icon_click [ di: DockIcon ]
    if [ di.program ]
        dock_program_click[ di.file ]
        return
    md_ : path (di.module) ? path '{di.file}/{di.file.filename[]}.ag' : di.file
    # the menu's New instance: none of the reuse below
    fr : bool [ dock_fresh && di.module ]
    # its app running in another's instance (steam's startup line in
    # a console): that one, shown or brought up
    if [ di.module && !fr && !shift_down ]
        ap : vec AppView inst_reg[].live_app[ di.file ]
        if [ ap.count > 0 && inst_reg[].live_of[ md_ ].count == 0 ]
            dock_run_click[ ap[ 0 ].iid ]
            return
    # its instances where they are (a group's hidden member too):
    # each press the next one, brought into view in its place
    if [ !shift_down && di.module && !fr && app_step[ md_ ] ] return
    # a pane holding the module (its code, its app over it): the
    # pin hides or shows that pane whole
    if [ !shift_down && di.module && !fr ]
        for [ q: i32 0, q < editor_slots.count, q += 1 ]
            eq : Editor pane_at[ q ]
            if [ !eq || !eq.src ] continue
            if [ '{eq.src.directory[]}' != '{di.file}' ] continue
            # another app's instance there (steam's in a console):
            # not this pin's pane
            rq : AppView eq.run_view
            if [ rq && !rq.ended
                 && inst_reg[].app_of[ rq ] != inst_key[ di.file ] ]
                continue
            if [ pane_hidden[ q ] ] unhide[ q ]
            el dock_choose[ q ]
            if [ ux ] ux.restyle = true
            return
    # the pane already running it, else an empty one; else the
    # active pane shows it over what it holds (no split)
    if [ !shift_down && di.module ]
        tp : i32 [ (fr) ? -1 : launch_pane[ md_ ] ]
        # the selected window shows another running app: a new tab
        # beside it in its group, never over it (it would run on
        # unseen); the launch once its editor is there
        if [ tp < 0 && launch_tab < 0 && pane_app_on[ active_pane ]
             && editor_slots.count < 4 ]
            editor_slots += -1
            pane_console += ''
            nt : i32 [ i32[ editor_slots.count ] - 1 ]
            grp_join[ nt, active_pane ]
            active_pane = nt
            launch_tab  = nt
            launch_wait = di
            force_update[]
            return
        if [ tp >= 0 ]
            active_pane = tp
            set_active[ tp ]
    edd : Editor pane_at[ active_pane ]
    # a click runs the module: its first instance, else a new one;
    # each click again the next of its instances; with one in view
    # it steps out. shift: its source in the editor
    if [ shift_down || !di.module || !edd ]
        dock_fresh = false
        open_in_pane[ md_, active_pane ]
        return
    if [ fr ]
        dock_fresh = false
        show_app[ edd, md_, true ]
        return
    # every live one, hosted or not, started or starting: the
    # registry's list; a new one only when it has none
    runs : vec AppView []
    for [ v_: AppView ] in inst_reg[].live_of[ md_ ]
        if [ inst_reg[].serving[ v_ ] ] continue
        # one asking for its argument: its pick, aside or back
        if [ v_.asking && v_.slot < 0 ]
            dock_run_click[ v_.iid ]
            return
        runs.push[ v_ ]
    at : i32 [ -1 ]
    if [ edd.app_view && edd.run_view ]
        for [ i: i32 0, i < runs.count, i += 1 ]
            if [ runs[ i ] == edd.run_view ] at = i
    if [ at >= 0 && runs.count == 1 ]
        return
    el [ at >= 0 ]
        embed_app[ edd, runs[ (at + 1) % runs.count ] ]
    el [ runs.count > 0 ]
        embed_app[ edd, runs[ 0 ] ]
    el
        show_app[ edd, md_, false ]

# the drag's frame: over the dock its icon eases to the
# pointer and the pins below its slot ease down to open a gap
func orbiter.dock_drag_frame []
    if [ !ux ] return
    ff : f32 [ ux.frame_factor ]
    live : bool [ false ]
    np : i32 pins_shown[]
    pe : element find_el[ a, 'pins' ]
    was : i32 [ drag_slot ]
    # a pin dragged within the dock: the others close up round it
    pd : bool [ drag_pin && drag_pin.count > 0 ]
    if [ pd ] np -= 1
    if [ pd && pe ]
        dx : f32 [ f32[ ux.mouse.x ] - drag_x0 ]
        dy : f32 [ f32[ ux.mouse.y ] - drag_y0 ]
        if [ !drag_moved && dx * dx + dy * dy > 36.0 ]
            drag_moved = true
            # in the rows' own place: the scroll added back
            drag_at    = drag_y0 - pe.win_pos.y + pe.scroll.y
                - dock_w[] * 0.5
            live       = true
        if [ drag_moved ]
            top  : f32 [ f32[ np ] * dock_w[] + 1.0 ]
            goal : f32 [ min[ max[ f32[ ux.mouse.y ] - pe.win_pos.y
                + pe.scroll.y - dock_w[] * 0.5, 1.0 ], top ] ]
            if [ drag_at - goal > 0.25 || goal - drag_at > 0.25 ]
                drag_at = filter_n[ drag_at, goal, 0.3, ff ]
                live = true
            sp : i32 [ i32[ (drag_at + dock_w[] * 0.5 - 1.0) / dock_w[] ] ]
            drag_slot = min[ max[ sp, 0 ], np ]
    if [ drag_iid >= 0 && pe ]
        mx : f32 [ ux.mouse.x ]
        my : f32 [ ux.mouse.y ]
        dx : f32 [ mx - drag_x0 ]
        dy : f32 [ my - drag_y0 ]
        if [ !drag_moved && dx * dx + dy * dy > 36.0 ]
            drag_moved = true
        drag_slot = -1
        if [ drag_moved && mx < dock_w[] * 1.5 ]
            goal : f32 [ my - pe.win_pos.y - dock_w[] * 0.5 ]
            # it comes in where the pointer is, then follows
            if [ was < 0 ] drag_at = goal
            drag_at = filter_n[ drag_at, goal, 0.3, ff ]
            mid : f32 [ drag_at + dock_w[] * 0.5 ]
            sl : i32 [ i32[ (mid - 1.0) / dock_w[] ] ]
            drag_slot = min[ max[ sl, 0 ], np ]
            live = true
    if [ drag_slot != was ] live = true
    if [ !pin_off || pin_off.count != np ]
        pin_off = vec f32 []
        for [ i: i32 0, i < np, i += 1 ]
            pin_off.push[ 0.0 ]
    for [ i: i32 0, i < np, i += 1 ]
        gap : bool [ drag_slot >= 0 && i >= drag_slot ]
        want : f32 [ (gap) ? dock_w[] : 0.0 ]
        cur : f32 [ pin_off[ i ] ]
        if [ cur - want > 0.25 || want - cur > 0.25 ]
            pin_off[ i ] = filter_n[ cur, want, 0.3, ff ]
            live = true
        el
            pin_off[ i ] = want
    if [ live ] force_update[]

# the dock's width, px: 2.39 units, as its area says
func orbiter.dock_w [] -> f32
    return 2.39 * unit_px[]

func orbiter.dock_els [] -> Elements
    dw : f32 dock_w[]
    t : Elements []
    edp : Editor pane_at[ active_pane ]
    fd_ : bool [
        search_pane[] == 'pane{active_pane}'
        && (nav_showing || picking[]) ]
    ndm : i32 [ 0 ]
    # the finder walks its folders; a hosted app has its own word
    if [ fd_ ]
        if [ !nav.nav_can[ -1 ] ] ndm |= 1
        if [ !nav.nav_can[ 1 ] ]  ndm |= 2
    el [ edp && edp.app_view && edp.run_view ]
        if [ !edp.run_view.nav_back_on ] ndm |= 1
        if [ !edp.run_view.nav_fwd_on ]  ndm |= 2
    el [ edp && edp.view_key[].count > 0 ]
        if [ !edp.view_can[ -1 ] ] ndm |= 1
        if [ !edp.view_can[ 1 ] ]  ndm |= 2
    el
        if [ !edp || !edp.nav || !edp.nav.can_back[] ]    ndm |= 1
        if [ !edp || !edp.nav || !edp.nav.can_forward[] ] ndm |= 2
    nb_ : vec string (fd_) ? vec string [] [ 'finder_back', 'finder_fwd' ]
        : vec string [] [ 'nav_back', 'nav_fwd' ]
    # with the system bar the arrows are its first buttons
    sys_ : bool system_on[]
    if [ !sys_ ]
        t['histnav'] = DockNav [ buttons: nb_,
            icon_ids: vec string [] [ 'left', 'right' ],
            manual: true, rest_hover: true,
            rest_fill: rgba [ '#ffffff08' ], disable_mask: ndm,
            icon_scale: 0.30, rest_glow: rgba [ '#ccf2' ],
            rest_px: 8.0, seg_radius: 0.0, use_spacing: false,
            seg_reach: 0.5, area: Region { l0 t0 r0 h1.3 } ]
    # the pins start under the arrows, in the arrows' unit
    pins_ : Elements []
    pins_['navline'] = DockLine [ area: Region { l0 t0 r0 h1px } ]
    y_ : f32 [ 1.0 ]
    # the last pin that is there takes the bottom border
    np : i32 [ 0 ]
    if [ pins ]
        for [ ps0: string ] in pins
            if [ dock_pin[ ps0 ] ] np += 1
    if [ drag_moved && drag_pin ] np -= 1
    k_ : i32 [ 0 ]
    held_ : DockIcon [ null ]
    if [ pins ]
        for [ ps_: string ] in pins
            pp : path ps_
            if [ !dock_pin[ ps_ ] ] continue
            mm : path '{pp}/{pp.filename[]}.ag'
            ism : bool [ pp.is_dir[] && mm.exists[] ]
            prg : bool [ !pp.is_dir[]
                         && access[ ps_.chars, X_OK ] == 0 ]
            ag_ : path (ism) ? path '{install_root[]}/export/{install_name_of[ pp.filename[] ]}.agi' : null
            # its instances, a file opened in it (a rom) among them
            n_ : i32 [ 0 ]
            if [ ism ]
                n_ = i32[ inst_reg[].live_app[ pp ].count ]
            ic_ : path null
            if [ prg && instances ]
                for [ v_: AppView ] in instances
                    if [ v_.slot < 0 || v_.ended || v_.held ]
                        continue
                    if [ pin_key_of[ v_ ] == ps_ ] n_ += 1
            if [ prg ] ic_ = program_icon_named[ '', pp.filename[] ]
            # the pin being dragged: out of the column, over it
            if [ drag_moved && drag_pin && drag_pin == ps_ ]
                held_ = DockIcon [ file: pp, module: ism, agi: ag_,
                    count: n_, program: prg, icon_file: ic_,
                    selected: true, area: Region [
                    'l0 t{drag_at}px w{dw}px h{dw}px' ] ]
                continue
            sh_ : f32 [ (pin_off && k_ < pin_off.count)
                ? pin_off[ k_ ] : 0.0 ]
            pins_[ 'dock_{ps_}' ] = DockIcon [ file: pp,
                module: ism, agi: ag_, count: n_,
                program: prg, icon_file: ic_, selected: false,
                first: k_ == 0,
                last: k_ == np - 1,
                area: Region [
                    'l0 t{y_ + sh_}px w{dw}px h{dw}px' ] ]
            k_ += 1
            y_ += dock_w[]
    if [ held_ ] pins_[ 'dock_{drag_pin}' ] = held_
    # the running apps no pin holds, under the pins: lit while
    # shown; a click hides or shows it, a drag up pins it
    # one entry an app, its instances its dots and its menu's rows
    for [ rv_: AppView ] in inst_reg[].firsts[]
        rk_ : string pin_key_of[ rv_ ]
        if [ rk_.count > 0 && nav.is_pinned[ path rk_ ] ] continue
        if [ drag_iid == rv_.iid && drag_slot >= 0 ] continue
        rf_ : path inst_reg[].app_dir[ rv_ ]
        if [ !rf_ ] continue
        # its module pinned: the pin is its entry
        if [ nav.is_pinned[ rf_ ] ] continue
        ra_ : path '{install_root[]}/export/{install_name_of[ rf_.filename[] ]}.agi'
        gr_ : vec AppView inst_reg[].of_app[ rv_ ]
        sh_ : bool [ false ]
        for [ gv_: AppView ] in gr_
            if [ pane_showing[ gv_ ] >= 0
                 || (gv_.asking && pick_launch == gv_) ] sh_ = true
        pins_[ 'run_{rv_.iid}' ] = DockIcon [ file: rf_,
            module: true, agi: ra_, count: i32[ gr_.count ],
            # a program's icon while its window is up; else its
            # module's own (a console's)
            # a program's icon while its window is up (none started
            # it); else the app's module's own (steam's, a console's)
            icon_file: (window_of[ rv_ ] != 0 && !rv_.origin)
                ? program_icon[ rv_ ] : null,
            name: (gr_.count > 1 || rv_.origin) ? rf_.filename[]
                : app_name[ rv_ ],
            selected: sh_, first: k_ == 0,
            area: Region [ 'l0 t{y_}px w{dw}px h{dw}px' ] ]
        k_ += 1
        y_ += dock_w[]
    # a pane showing a file: a code window of its own. an app's
    # own source is the app's entry; any other file keeps its entry
    # while an app shows over it (lit only with the edit in view)
    for [ q: i32 0, q < editor_slots.count, q += 1 ]
        edc : Editor pane_at[ q ]
        if [ !edc || !edc.src ] continue
        rv : AppView edc.run_view
        on : bool [ rv && !rv.ended && !rv.held ]
        if [ on && edc.owns_src[ rv, edc.src ] ] continue
        # a file an app opens (a rom): that app's entry alone,
        # running or not
        if [ on && rv.viewer ] continue
        hm_ : string edc.handler_module_for[ edc.src ]
        if [ hm_ && hm_.count > 0 ] continue
        fc : path edc.src.directory[]
        # a pinned module's own file: its pin is its entry
        if [ nav.is_pinned[ fc ] ] continue
        pins_[ 'pane_{q}' ] = DockIcon [ file: fc, module: true,
            name: edc.src.filename[],
            agi: path '{install_root[]}/export/{install_name_of[ fc.filename[] ]}.agi',
            selected: q == active_pane && !pane_hidden[ q ]
                && !(on && edc.app_view) && !pane_browsing[ q ],
            first: k_ == 0,
            area: Region [ 'l0 t{y_}px w{dw}px h{dw}px' ] ]
        k_ += 1
        y_ += dock_w[]
    # a bar chip dragged over the dock: its icon at the slot
    dav : AppView (drag_slot >= 0) ? instance_by[ drag_iid ] : null
    if [ dav ]
        dfo : path (dav.src) ? dav.src.directory[] : null
        pins_[ 'drag_ghost' ] = DockIcon [ file: dfo, module: true,
            icon_file: program_icon[ dav ], selected: true,
            area: Region [ 'l0 t{drag_at}px w{dw}px h{dw}px' ] ]
    # down to the one button at the foot (the gear, or orbiter's)
    pt_ : string [ (sys_) ? 't0' : 't1.3' ]
    # more pins than room: the wheel scrolls them, faded at the
    # ends, no thumb
    # the pins are placed by their areas, so they move by the
    # scroll together, inside one row the scroll offsets
    rh_ : f32 [ y_ + dock_w[] ]
    pe_ : element find_el[ a, 'pins' ]
    sc_ : f32 [ (pe_) ? pe_.scroll.y : 0.0 ]
    rows_ : Elements []
    rows_['pin_rows'] = element [ no_scroll: true, elements: pins_,
        area: Region [ 'l0 t{0.0 - sc_}px r0 h{rh_}px' ] ]
    # with the system bar the pins run to the foot (orbiter's
    # button is the bottom bar's)
    pb_ : string [ (sys_) ? 'b0' : 'b1.06' ]
    t['pins'] = DockPins [ area: Region [ 'l0 {pt_} r0 {pb_}' ],
                           rows_h: rh_, scroll_fade: 24.0,
                           elements: rows_ ]
    # orbiter's button at the foot, under the scrolled pins; with
    # the system bar it is the bottom bar's
    if [ !sys_ ]
        t['dock_orbiter'] = home_button[
            Region [ 'l0 b1.06 w2.39 h1.06' ], false ]
    return t

func orbiter.dock_tabs [ grp: vec path, prefix: string, active: path,
                 win: Window ] -> Elements
    els : Elements []
    for [ i: i32 0, i < grp.count, i += 1 ]
        p   : path   grp[i]
        tid : string '{prefix}{i}'
        els[tid] = Option [ label: p.filename[],
                            selected: active && p == active ]
    return els

# a home card's dock button (arranging): its module pinned at the
# dock's end, or let go; the navigator's list is the same one
func orbiter.pin_dock [ ae: AppEntry ]
    if [ !ae || !ae.module || !ae.file ] return
    key : '{ae.file}'
    if [ !pins ] pins = vec string []
    was : bool [ false ]
    for [ i: i32 0, i < pins.count, i += 1 ]
        if [ pins[ i ] == key ]
            pins.remove[ i ]
            was = true
            break
    if [ !was ] pins.push[ key ]
    nav.pins = pins
    save_session[]
    pin_off = null
    force_update[]

# a bar chip's name: the window's or the app's own title, else
# its argument, else the instance's name
func orbiter.task_title [ av: AppView ] -> string
    wv : u64 window_of[ av ]
    if [ wv != 0 ]
        wt : string[ wlc_window_title[ wv ] ]
        if [ wt.count > 0 ] return wt
    if [ av.app_title && av.app_title.count > 0 ] return av.app_title
    da : string default_arg_of[ av.module_args ]
    if [ da.count > 0 && program_of[ av ].count == 0 ]
        dp : path [ da ]
        return dp.stem[]
    return instance_name[ av ]

# what a running app pins as: a program's path, else its module
func orbiter.pin_key_of [ av: AppView ] -> string
    pn : string program_of[ av ]
    if [ pn.count > 0 ]
        words : vec string av.module_args.split[ ' ' ]
        word : string words[ words.count - 1 ]
        if [ word.starts_with[ '/' ] ] return word
        pl : map string [string] nav.program_list[]
        return (pl.contains[ pn ]) ? pl[ pn ] : ''
    fo : path (av.src) ? av.src.directory[] : null
    return (fo) ? '{fo}' : ''

# the pins that show (their paths are there)
func orbiter.pins_shown [] -> i32
    n : i32 [ 0 ]
    if [ pins ]
        for [ ps: string ] in pins
            if [ dock_pin[ ps ] ] n += 1
    return n

# a pin let go: a click where it was, else it takes the slot
# among the other shown pins and eases there from the drop
func orbiter.pin_release []
    # a copy: clearing drag_pin lets go of its text
    key : '{drag_pin}'
    drag_pin = null
    moved : bool drag_moved
    drag_moved = false
    if [ !moved ]
        pe : element find_el[ a, 'pin_rows' ]
        di : DockIcon (pe && pe.elements)
            ? cast DockIcon [ pe.elements[ 'dock_{key}' ] ] : null
        if [ di ] dock_icon_click[ di ]
        force_update[]
        return
    at : i32 [ drag_slot ]
    drag_slot = -1
    # let go out of the dock: no longer pinned
    if [ f32[ ux.mouse.x ] > dock_w[] * 1.5 && pins ]
        for [ i: i32 0, i < pins.count, i += 1 ]
            if [ pins[ i ] == key ]
                pins.remove[ i ]
                break
        save_session[]
        pin_off = null
        force_update[]
        return
    if [ at >= 0 && pins ]
        for [ i: i32 0, i < pins.count, i += 1 ]
            if [ pins[ i ] == key ]
                pins.remove[ i ]
                break
        pin_insert[ key, at ]
    force_update[]

# a drop takes slot at among the shown pins; the new pin
# starts where it was let go and eases into its place
func orbiter.pin_insert [ key: string, at: i32 ]
    if [ !pins ] pins = vec string []
    ix : i32 [ pins.count ]
    n  : i32 [ 0 ]
    for [ i: i32 0, i < pins.count, i += 1 ]
        if [ !dock_pin[ pins[ i ] ] ] continue
        if [ n == at ]
            ix = i
            break
        n += 1
    pins.insert[ key, ix ]
    save_session[]
    np : i32 pins_shown[]
    pin_off = vec f32 []
    for [ i: i32 0, i < np, i += 1 ]
        pin_off.push[ 0.0 ]
    if [ at < np ]
        pin_off[ at ] = drag_at - (1.0 + f32[ at ] * dock_w[])

# a system menu cell chosen: its view (the lit one again puts it
# away), power, restart, a ready reload; false: not a cell
# the instances running, as the task bar and the switcher show
# them: none held, ended, or in its tray with no window
func orbiter.running_apps [] -> vec AppView
    return inst_reg[].running[]

# a dock icon's menu: its running instances, New instance, Quit
func orbiter.dock_pop_items [] -> vec PopItem
    out : vec PopItem []
    if [ !dock_pop ] return out
    pinned : bool [ dock_pop.id && dock_pop.id.starts_with[ 'dock_' ] ]
    if [ !dock_pop.module || !dock_pop.file || dock_pop.program ]
        if [ pinned ]
            out.push[ PopItem [ icon: 'minus', label: 'Remove from Dock',
                                act: 'unpin' ] ]
        el [ dock_pop.file && !dock_pop.program ]
            out.push[ PopItem [ icon: 'plus', label: 'Add to Dock',
                                act: 'pin' ] ]
        return out
    fo : path dock_pop.file
    md : path '{fo}/{fo.filename[]}.ag'
    ed : Editor pane_at[ active_pane ]
    lv : vec AppView inst_reg[].live_app[ fo ]
    apps : i32 [ 0 ]
    for [ v: AppView ] in lv
        apps += 1
        it : PopItem [ icon: 'app', label: task_title[ v ],
                       act: 'show {v.iid}' ]
        it.on = ed && ed.app_view && ed.run_view == v
        out.push[ it ]
    out.push[ PopItem [ icon: 'add_instance', label: 'New instance',
                        act: 'new' ] ]
    if [ pinned ]
        out.push[ PopItem [ icon: 'minus', label: 'Remove from Dock',
                            act: 'unpin' ] ]
    el
        out.push[ PopItem [ icon: 'plus', label: 'Add to Dock',
                            act: 'pin' ] ]
    if [ apps > 0 ]
        out.push[ PopItem [ icon: 'power', label: 'Quit',
                            act: 'quit', danger: true ] ]
    return out

# an instance from the dock's menu: its own window brought up; with
# none, a new tab beside the selected window (never over its app)
func orbiter.show_own [ iid: i32 ]
    av : AppView instance_by[ iid ]
    q : i32 [ (av) ? pane_showing[ av ] : -1 ]
    # in the background with no window: its tray item shows it
    if [ av && av.background && window_of[ av ] == 0 && q < 0 ]
        tray_raise[ av ]
        return
    if [ q >= 0 && in_view[ av, q ] ]
        if [ grp_of[ q ] >= 0 ] grp_show[ q ]
        el [ pane_hidden[ q ] ] unhide[ q ]
        el raise_pane[ q ]
        active_pane = q
        set_active[ q ]
        if [ ux ] ux.restyle = true
        return
    if [ pane_app_on[ active_pane ] && editor_slots.count < 4 ]
        editor_slots += -1
        pane_console += ''
        nt : i32 [ i32[ editor_slots.count ] - 1 ]
        grp_join[ nt, active_pane ]
        active_pane = nt
        show_wait   = iid
        force_update[]
        return
    pick_instance[ iid, active_pane ]

# a pane holds av (shown or not)
func orbiter.shown_in_pane [ av: AppView ] -> bool
    return pane_showing[ av ] >= 0

# a running app with no window: its tray item (by its module's
# name: steam's is .../NotificationItem/steam) asked to show it
func orbiter.tray_raise [ av: AppView ]
    d : path inst_reg[].app_dir[ av ]
    if [ !d ] return
    nm : string d.filename[]
    tr : Tray tray_shared[]
    if [ !tr || !tr.items ] return
    for [ ti: TrayItem ] in tr.items
        if [ (ti.path && ti.path.ends_with[ '/{nm}' ])
             || (ti.icon_name && ti.icon_name == nm)
             || (ti.title && ti.title == nm) ]
            tr.activate[ ti ]
            return
    log 'orbiter: {nm} runs with no window and no tray item'

# pane q shows av: its program's window there, or the app in view
# (not its code)
func orbiter.in_view [ av: AppView, q: i32 ] -> bool
    if [ window_of[ av ] != 0 ] return pane_window[ q ] == window_of[ av ]
    eq : Editor pane_at[ q ]
    return eq && eq.run_view == av && eq.app_view

# a row of it pressed: done on the next frame
func orbiter.dock_pop_pick [ act: string :: o: orbiter ] -> none
    o.dock_act = '{act}'
    o.force_update[]

# the pressed row's action, the menu put away
func orbiter.dock_pop_do []
    act : string dock_act
    dock_act = null
    # dock_pop holds the icon until its action is done
    di : DockIcon dock_pop
    force_update[]
    if [ !di || !act ]
        dock_pop = null
        return
    if [ act.starts_with[ 'show ' ] ]
        show_own[ i32[ act.mid[ 5, act.count - 5 ].integer_value[] ] ]
    el [ act == 'new' ]
        dock_fresh = true
        dock_icon_click[ di ]
    el [ act == 'unpin' ]
        # a copy: the pin's own text goes with the list's entry
        key : '{di.id.mid[ 5, di.id.count - 5 ]}'
        if [ pins ]
            for [ i: i32 0, i < pins.count, i += 1 ]
                if [ pins[ i ] == key ]
                    pins.remove[ i ]
                    break
        nav.pins = pins
        save_session[]
        pin_off = null
    el [ act == 'pin' ]
        # a running program pins as itself, a module by its folder
        key : '{di.file}'
        for [ rv: AppView ] in running_apps[]
            if [ di.id == 'run_{rv.iid}' && pin_key_of[ rv ].count > 0 ]
                key = '{pin_key_of[ rv ]}'
        if [ !pins ] pins = vec string []
        if [ pins.index_of[ key ] < 0 ] pins.push[ key ]
        nav.pins = pins
        save_session[]
    el [ act == 'quit' ]
        # its apps; a service it runs (a server) keeps running
        for [ v: AppView ] in inst_reg[].live_app[ di.file ]
            close_task[ v ]
    dock_pop = null

# an escape in it
func orbiter.dock_pop_quit [ :: o: orbiter ] -> none
    o.dock_pop = null
    o.force_update[]
