extend orbiter
import <stdio.h>

# keep_ws keeps leading whitespace and blank lines (diff bodies)
func git_capture [ root: path, args: string, keep_ws: bool ] -> vec string
    out : vec string []
    cmd : string 'git -C {root} {args} 2>/dev/null'
    fh  : handle popen[ cmd.chars, "r" ]
    if [ !fh ] return out
    b : local i8 [ 1024 ]
    while [ fgets[ @b[0], 1024, fh ] ]
        ln0 : string[ @b[0] ]
        if [ keep_ws ]
            n9 : i32 [ ln0.count ]
            while [ n9 > 0 ]
                lc : i32 [ ln0.chars[ n9 - 1 ] ]
                if [ lc != 10 && lc != 13 ] break
                n9 -= 1
            out.push[ ln0.mid[ 0, n9 ] ]
        el
            ln : ln0.trim[]
            if [ ln.count > 0 ] out.push[ ln ]
    pclose[ fh ]
    return out

# the string value of one pretty-printed json line ("key": "value",); '' for null
func json_line_value [ ln: string ] -> string
    ci : i32 [ ln.index_of[ ':' ] ]
    if [ ci < 0 ] return ''
    raw9 : string ln.mid[ ci + 1, ln.count - ci - 1 ]
    rest : string raw9.trim[]
    if [ rest.count < 2 || rest.chars[ 0 ] != 34 ] return ''
    q1 : i32 [ rest.rindex_of[ '"' ] ]
    if [ q1 <= 0 ] return ''
    return rest.mid[ 1, q1 - 1 ]

# the login the host greets our key with; '' when it does not know us
func repo_whoami [ host: RepoHost ] -> string
    cmd : string host.whoami_cmd[]
    fh  : handle popen[ cmd.chars, "r" ]
    if [ !fh ] return ''
    b : local i8 [ 1024 ]
    who : string ''
    while [ fgets[ @b[0], 1024, fh ] ]
        ln0 : string[ @b[0] ]
        hi : i32 [ ln0.index_of[ 'Hi ' ] ]
        ex : i32 [ ln0.index_of[ '!' ] ]
        if [ hi >= 0 && ex > hi + 3 ] who = ln0.mid[ hi + 3, ex - hi - 3 ]
    pclose[ fh ]
    return who

# the token's login from the host; '' without a token or on any failure
func repo_token_login [ host: RepoHost ] -> string
    if [ !host.token || host.token.count == 0 ] return ''
    cmd : string host.user_cmd[]
    fh  : handle popen[ cmd.chars, "r" ]
    if [ !fh ] return ''
    b : local i8 [ 4096 ]
    who : string ''
    while [ fgets[ @b[0], 4096, fh ] ]
        ln0 : string[ @b[0] ]
        ln  : string ln0.trim[]
        if [ ln.starts_with[ '"login":' ] && who.count == 0 ] who = json_line_value[ ln ]
    pclose[ fh ]
    return who

# a listing reply (pretty json, one field per line) as repositories
func repo_parse [ text: string ] -> vec RepoInfo
    items : vec RepoInfo []
    if [ !text ] return items
    lines : text.split[ '\n' ]
    cur : RepoInfo null
    for [ ln0: string ] in lines
        ln : string ln0.trim[]
        if [ ln.starts_with[ '"full_name":' ] ]
            cur = RepoInfo []
            cur.full = json_line_value[ ln ]
            sl : i32 [ cur.full.rindex_of[ '/' ] ]
            cur.name = (sl >= 0) ? cur.full.mid[ sl + 1, cur.full.count - sl - 1 ] : cur.full
            cur.desc = ''
            items.push[ cur ]
        el [ cur && ln.starts_with[ '"description":' ] ]
            cur.desc = json_line_value[ ln ]
    return items

# the on-disk listing: first line the fetch time (ms), pages fetched and
# whether more remain, then full<tab>desc
func repo_cache_write [ p: path, items: vec RepoInfo, page: i32, more: bool ]
    ps : string '{p}'
    fh : handle fopen[ ps.chars, "w" ]
    if [ !fh ] return
    now9 : i64 [ Au.epoch_millis[] ]
    fprintf[ fh, "%lld %d %d\n", now9, page, (more) ? 1 : 0 ]
    for [ it: RepoInfo ] in items
        fprintf[ fh, "%s\t%s\n", it.full.chars, it.desc.chars ]
    fclose[ fh ]

func repo_cache_read [ p: path, at: @i64, page: @i32, more: @i32 ] -> vec RepoInfo
    items : vec RepoInfo []
    ps : string '{p}'
    fh : handle fopen[ ps.chars, "r" ]
    if [ !fh ] return null
    b : local i8 [ 4096 ]
    first : bool [ true ]
    oldfmt : bool [ false ]
    while [ fgets[ @b[0], 4096, fh ] ]
        ln0 : string[ @b[0] ]
        ln  : string ln0.trim[]
        if [ first ]
            first = false
            hp : vec string ln.split[ ' ' ]
            at[0]   = (hp.count > 0) ? i64[ hp[0].integer_value[] ] : 0
            page[0] = (hp.count > 1) ? i32[ hp[1].integer_value[] ] : 1
            more[0] = (hp.count > 2) ? i32[ hp[2].integer_value[] ] : 0
            oldfmt  = hp.count < 3
            continue
        tb : i32 [ ln.index_of[ '\t' ] ]
        it : RepoInfo []
        it.full = (tb >= 0) ? ln.mid[ 0, tb ] : ln
        it.desc = (tb >= 0) ? ln.mid[ tb + 1, ln.count - tb - 1 ] : ''
        sl : i32 [ it.full.rindex_of[ '/' ] ]
        it.name = (sl >= 0) ? it.full.mid[ sl + 1, it.full.count - sl - 1 ] : it.full
        items.push[ it ]
    fclose[ fh ]
    # a cache written before paging: a full page means there may be more
    if [ oldfmt && items.count >= 100 ] more[0] = 1
    return items

class GitRow
    public is_branch : bool
    public current   : bool
    public hash      : string
    public text      : string
    public when      : string

Layer GitLayer
    public label_size   : f32
    public row_spacing  : f32
    public sel_color    : string
    public sel_grad     : string
    public sel_glow     : string
    public sel_text     : string
    public branch_color : string
    public text_color   : string
    public hash_color   : string
    public tag_color    : string

    func draw [ cv: Canvas ]
        gl : GitList[ parent ]
        if [ !gl ] return
        if [ !gl.rows ] gl.refresh[]
        cv.font_size[ i32[label_size] ]
        lh : f32 [ cv.get_line_height[] * ((row_spacing > 0.0) ? row_spacing : 1.0) ]
        n  : i32 [ gl.row_count[] ]
        gl.row_height   = lh
        gl.content_y    = bounds.y
        gl.content_h    = f32[n] * lh
        gl.view_h       = bounds.h
        gl.scroll_speed = lh
        x0  : f32 [ bounds.x ]
        y0  : f32 [ bounds.y ]
        wtx : f32 [ cv.transform_tx[] ]
        wty : f32 [ cv.transform_ty[] ]
        cv.set_crop[ wtx + bounds.x, wty + bounds.y, wtx + bounds.x + bounds.w, wty + bounds.y + bounds.h ]
        cv.stroke_width[ 0.0 ]
        hash_w : f32 [ 96.0 ]
        tag_w  : f32 [ bounds.w * 0.30 ]
        for [ i: i32 0, i < n, i += 1 ]
            y : f32 [ y0 + f32[i] * lh - gl.scroll.y ]
            if [ y + lh < bounds.y ] continue
            if [ y > bounds.y + bounds.h ] break
            r : GitRow gl.rows[i]
            hi : i32 [ (gl.hovered && gl.hover >= 0) ? gl.hover : gl.sel ]
            if [ i == hi ]
                cv.save[]
                cv.rounded[ 6.0, 6.0, 6.0, 6.0 ]
                cv.stroke_width[ 0.0 ]
                cv.fill_color[ (sel_color) ? sel_color : '#ff6a2e55' ]
                if [ sel_grad ]
                    cv.fill_grad[ sel_grad ]
                    cv.fill_color_pos[ x0 + 1.0, y + 1.0 ]
                    cv.fill_grad_pos[ x0 + 1.0, y + lh - 1.0 ]
                if [ sel_glow ] cv.box_shadow[ sel_glow, 0.0, 0.0, 14.0, 0.0, true ]
                cv.rect_to[ x0 + 1.0, y + 1.0, bounds.w - 2.0, lh - 2.0 ]
                cv.paint[]
                cv.restore[]
            hot : bool [ i == hi && sel_text ]
            if [ r.is_branch ]
                cv.fill_color[ (hot) ? sel_text : ((branch_color) ? branch_color : '#6fb3ff') ]
                cv.draw_text[ r.text,
                    rect [ x: x0 + 12.0, y: y, w: bounds.w * 0.62, h: lh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.ellipsis, null ]
                cv.fill_color[ (tag_color) ? tag_color : '#77708a' ]
                cv.draw_text[ 'branch',
                    rect [ x: x0 + bounds.w - tag_w - 12.0, y: y, w: tag_w, h: lh ],
                    vec2f [ 1.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
            el
                cv.fill_color[ (hash_color) ? hash_color : '#8f86a8' ]
                cv.draw_text[ r.hash,
                    rect [ x: x0 + 12.0, y: y, w: hash_w, h: lh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                cv.fill_color[ (hot) ? sel_text : ((text_color) ? text_color : '#d8d4e8') ]
                cv.draw_text[ r.text,
                    rect [ x: x0 + 12.0 + hash_w, y: y, w: bounds.w - hash_w - tag_w - 36.0, h: lh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.ellipsis, null ]
                cv.fill_color[ (tag_color) ? tag_color : '#77708a' ]
                cv.draw_text[ r.when,
                    rect [ x: x0 + bounds.w - tag_w - 12.0, y: y, w: tag_w, h: lh ],
                    vec2f [ 1.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
        cv.clear_crop[]

NodeList GitList
    style : CSS {
        area: l0 t0 r0 b0
        layers.content: GitLayer
            area: l8px t6px r8px b6px
            label_size: 16
            row_spacing: 1.35
            branch_color: #6fb3ff
            text_color: #d8d4e8
            hash_color: #8f86a8
            tag_color: #77708a
            sel_color: #ff6a2e55
            sel_grad: #c0381844
            sel_glow: #ff8a3a99
            sel_text: #ffe6d2
    }
    public  root  : path
    # commits are scoped to this file's changes
    public  file  : path
    mutable rows  : vec GitRow
    mutable hover : i32 [ -1 ]

    func on_move [ ev: Event ]
        if [ row_height <= 0.0 ] return
        rel_y : f32 [ ev.mouse.pos.y - content_y ]
        h9 : i32 [ (rel_y >= 0.0) ? i32[ rel_y / row_height ] : -1 ]
        if [ h9 >= row_count[] ] h9 = -1
        if [ h9 != hover ]
            hover = h9
            pristine = false
            ux.will_animate = true

    func row_count [] -> i32
        if [ !rows ] return 0
        return rows.count

    func row_label [ i: i32 ] -> string
        if [ !rows || i < 0 || i >= rows.count ] return ''
        r : GitRow rows[i]
        if [ r.is_branch ] return r.text
        return '{r.hash} {r.text}'

    func refresh []
        rows = vec GitRow []
        bl : git_capture[ root, 'branch', false ]
        for [ b: string ] in bl
            cur : bool [ b.chars[0] == '*' ]
            nm  : string [ (cur) ? b.mid[ 2, b.count - 2 ].trim[] : b ]
            rows.push[ GitRow [ is_branch: true, current: cur, text: nm ] ]
        fs9 : string [ (file) ? '-- {file.absolute[]}' : '' ]
        cl : git_capture[ root, 'log --format=%h%x09%s%x09%cr {fs9}', false ]
        for [ c: string ] in cl
            f : c.split[ '\t' ]
            if [ f.count < 2 ] continue
            rows.push[ GitRow [
                hash: f[0], text: f[1], when: (f.count > 2) ? f[2] : '' ] ]
        # the row of the repository's current reference is the selection
        orb9 : orbiter [ ux.app_object ]
        ref9 : string [ (orb9) ? orb9.git_ref_of[ orb9.repo_root[] ] : 'HEAD' ]
        for [ i: i32 0, i < rows.count, i += 1 ]
            r9 : GitRow rows[i]
            if [ (r9.is_branch && r9.text == ref9) || (!r9.is_branch && r9.hash == ref9) ]
                sel = i
                break
        # nothing is selected until a reference is picked
        pristine = false

    func activate [ idx: i32 ]
        if [ !rows || idx < 0 || idx >= rows.count ] return
        r : GitRow rows[idx]
        # a branch or a commit: either becomes the repository's reference
        # (the tabs and every pane's marks read against it), and the pane
        # returns to its file. nothing is checked out here
        orb : orbiter [ ux.app_object ]
        if [ orb ]
            orb.set_git_ref[ orb.repo_root[], (r.is_branch) ? r.text : r.hash ]
            sel = idx
            ed : Editor orb.pane_of[ a ]
            if [ ed ]
                ed.view_name = ''
                ed.load_file[]
            ux.restyle = true

    # escape cancels the diff view: the pane returns to its file, the tab off
    func on_key [ ev: Event ]
        if [ ev.key.state && i32[ ev.key.unicode ] == 256 ]
            orb : orbiter [ ux.app_object ]
            ed  : Editor [ (orb) ? orb.pane_of[ a ] : null ]
            if [ orb && ed ]
                ed.git_on = false
                orb.set_pane_view[ ed, '' ]
                ux.restyle = true
            ev.no_default = true
            return
        super.on_key[ ev ]

    func init []
        if [ !root ]
            orb : orbiter [ ux.app_object ]
            if [ orb ] root = orb.project_root[]

    func render [] -> Elements
        return null

# the branch list + commit log, mounted as the pane's view
ResourceView GitView
    func view_id [] -> string
        return 'git'
    func applies [] -> FileType
        return FileType.ascii
    func view_element [] -> element
        return GitList [ file: src ]

# the nav surface: rail chips, changed-file tabs, totals, the
# message form, and the browse list — ONE element, ONE scroll
Layer CommitLayer
    func draw [ cv: Canvas ]
        cb : CommitView [ parent ]
        if [ !cb ] return
        orb : cast orbiter [ cb.ux.app_object ]
        if [ !orb ] return
        ev9 : EditorView cb.view[]
        ed  : Editor [ (ev9) ? ev9.text_of[] : null ]
        # no ground of its own: the editor is hidden while we show,
        # so the pane's background is already ours
        cv.stroke_width[ 0.0 ]
        wtx : f32 [ cv.transform_tx[] ]
        wty : f32 [ cv.transform_ty[] ]
        # the navigation column, fixed, right of the rail: users and projects
        sw9 : f32 [ cb.side_w ]
        sx9 : f32 [ bounds.x + 6.0 ]
        cv.set_crop[ wtx + sx9, wty + bounds.y, wtx + sx9 + sw9, wty + bounds.y + bounds.h ]
        cb.side_keys = vec string []
        cb.side_ys   = vec f32 []
        cv.font_size[ 13 ]
        # clamp the column's own scroll to what it holds
        smax9 : f32 [ cb.side_h - bounds.h ]
        if [ smax9 < 0.0 ] smax9 = 0.0
        if [ cb.side_scroll > smax9 ] cb.side_scroll = smax9
        if [ cb.side_scroll < 0.0 ] cb.side_scroll = 0.0
        sy9 : f32 [ bounds.y + 10.0 - cb.side_scroll ]
        srh : f32 [ 24.0 ]
        for [ sec9: i32 0, sec9 < 2, sec9 += 1 ]
            names9 : vec string orb.repo_users
            if [ sec9 == 0 ]
                # you first, always there and never removable: the login the
                # key answers to, then everyone added
                me9 : string orb.self_user_of[]
                users9 : vec string []
                if [ me9 && me9.count > 0 ] users9.push[ me9 ]
                if [ orb.repo_users ]
                    for [ u9: string ] in orb.repo_users
                        if [ me9 && me9.count > 0 && u9.compare[ me9 ] == 0 ] continue
                        users9.push[ u9 ]
                names9 = users9
            el
                names9 = orb.side_projects_of[]
            cv.fill_color[ rgba['#ffffff55'] ]
            cv.draw_text[ (sec9 == 0) ? 'users' : 'projects',
                rect [ x: sx9 + 4.0, y: sy9, w: sw9 - 12.0, h: srh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
            if [ sec9 == 0 ]
                # the + that adds a user: gray, lit under the pointer
                cb.plus_y = sy9 - bounds.y
                cv.fill_color[ (cb.hov_plus) ? rgba['#8fd0ff'] : rgba['#ffffff55'] ]
                cv.draw_text[ '+',
                    rect [ x: sx9 + sw9 - 30.0, y: sy9, w: 20.0, h: srh ],
                    vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
            sy9 += srh
            if [ sec9 == 0 && cb.add_user ]
                # the row being typed: a box with the name so far and a caret
                cv.save[ ]
                cv.rounded[ 6.0, 6.0, 6.0, 6.0 ]
                cv.fill_color[ rgba['#ffffff10'] ]
                cv.stroke_width[ 1.0 ]
                cv.stroke_color[ rgba['#8fd0ff88'] ]
                cv.rect_to[ sx9, sy9 + 1.0, sw9 - 8.0, srh - 2.0 ]
                cv.paint[ ]
                cv.restore[ ]
                at9 : string (cb.add_text) ? cb.add_text : ''
                cv.fill_color[ rgba['#ffffff'] ]
                cv.draw_text[ at9,
                    rect [ x: sx9 + 8.0, y: sy9, w: sw9 - 20.0, h: srh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                atw9 : f32 [ cv.measure_text[ at9 ].w ]
                cv.stroke_width[ 0.0 ]
                cv.rect_to[ sx9 + 8.0 + atw9 + 1.0, sy9 + 5.0, 1.5, srh - 10.0 ]
                cv.paint[ ]
                cb.side_keys.push[ 'e:' ]
                oye9 : f32 [ sy9 - bounds.y ]
                cb.side_ys.push[ oye9 ]
                sy9 += srh
            # a selected user narrows the projects to that user's checkouts
            # (yours are the plain names); none selected shows them all
            su9 : string (sec9 == 1) ? orb.side_user : null
            me8 : string (sec9 == 1) ? orb.self_user_of[] : null
            if [ names9 ]
                for [ nm9: string ] in names9
                    if [ su9 && su9.count > 0 ]
                        own9 : bool [ nm9.index_of[ '/' ] < 0 ]
                        if [ me8 && me8.count > 0 && su9.compare[ me8 ] == 0 ]
                            if [ !own9 ] continue
                        el
                            if [ !nm9.starts_with[ '{su9}/' ] ] continue
                    key9 : string (sec9 == 0) ? 'u:{nm9}' : 'p:{nm9}'
                    on9 : bool [ false ]
                    if [ sec9 == 0 ]
                        on9 = orb.side_user && orb.side_user.compare[ nm9 ] == 0
                    el
                        # lit when the navigator is in this checkout (or below it):
                        # by path, so user/name keys match like plain names
                        nrs : string (orb.nav_root) ? '{orb.nav_root}' : ''
                        rd9 : path orb.repo_dir[ nm9 ]
                        rds : string '{rd9}'
                        rdp : string '{rd9}/'
                        on9 = (!orb.find_text || orb.find_text.count == 0) && (nrs.compare[ rds ] == 0 || nrs.starts_with[ rdp ])
                    hov9 : bool [ cb.hov_side == cb.side_keys.count ]
                    if [ on9 || hov9 ]
                        cv.save[ ]
                        cv.rounded[ 6.0, 6.0, 6.0, 6.0 ]
                        cv.fill_color[ (on9) ? rgba['#6cb6ff22'] : rgba['#ffffff10'] ]
                        cv.stroke_width[ 0.0 ]
                        cv.rect_to[ sx9, sy9 + 1.0, sw9 - 8.0, srh - 2.0 ]
                        cv.paint[ ]
                        cv.restore[ ]
                    dk9 : bool [ sec9 == 1 && orb.repo_docked[ nm9 ] ]
                    # another user's checkout reads user:repository (the disk
                    # path stays user/repository)
                    # ...unless that user is the one selected: then the list is
                    # already theirs and the name alone fits
                    lbl9 : string nm9
                    sl9 : i32 [ nm9.index_of[ '/' ] ]
                    if [ sec9 == 1 && sl9 > 0 ]
                        own8 : string nm9.mid[ 0, sl9 ]
                        if [ su9 && su9.count > 0 && su9.compare[ own8 ] == 0 ]
                            lbl9 = nm9.mid[ sl9 + 1, nm9.count - sl9 - 1 ]
                        el
                            lbl9 = own8 + ':' + nm9.mid[ sl9 + 1, nm9.count - sl9 - 1 ]
                    cv.fill_color[ (on9) ? rgba['#ffffff'] : ((dk9) ? rgba['#9fd0ff'] : rgba['#c8c2d8']) ]
                    cv.draw_text[ lbl9,
                        rect [ x: sx9 + 8.0, y: sy9, w: sw9 - 36.0, h: srh ],
                        vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.ellipsis, null ]
                    # shift held: a - next to every added user (never you) removes it
                    if [ sec9 == 0 && orb.shift_down && cb.side_keys.count > 0 ]
                        cv.fill_color[ (hov9) ? rgba['#ff8a8a'] : rgba['#ffffff55'] ]
                        cv.draw_text[ '-',
                            rect [ x: sx9 + sw9 - 30.0, y: sy9, w: 20.0, h: srh ],
                            vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                    # the dock toggle at the row's right: lit when the checkout
                    # is in the search set
                    if [ sec9 == 1 ]
                        cv.save[ ]
                        cv.rounded[ 4.0, 4.0, 4.0, 4.0 ]
                        cv.fill_color[ (dk9) ? rgba['#6cb6ff'] : rgba['#0000'] ]
                        cv.stroke_width[ 1.0 ]
                        cv.stroke_color[ (dk9) ? rgba['#6cb6ff'] : rgba['#ffffff33'] ]
                        cv.rect_to[ sx9 + sw9 - 24.0, sy9 + 8.0, 8.0, 8.0 ]
                        cv.paint[ ]
                        cv.restore[ ]
                    oy9 : f32 [ sy9 - bounds.y ]
                    cb.side_keys.push[ key9 ]
                    cb.side_ys.push[ oy9 ]
                    sy9 += srh
            sy9 += 10.0
        cb.side_h = sy9 + cb.side_scroll - bounds.y
        # a hairline between the column and the content
        cv.fill_color[ rgba['#ffffff14'] ]
        cv.stroke_width[ 0.0 ]
        cv.rect_to[ sx9 + sw9 - 1.0, bounds.y + 8.0, 1.0, bounds.h - 16.0 ]
        cv.paint[ ]
        # content right of the column; everything below rides one scroll
        x0  : f32 [ bounds.x + 14.0 + sw9 ]
        cw9 : f32 [ bounds.w - 14.0 - sw9 ]
        cv.set_crop[ wtx + x0, wty + bounds.y, wtx + bounds.x + bounds.w, wty + bounds.y + bounds.h ]
        # picking a path for a launch field: files only, no git tabs or summary
        picking : bool [ orb.picking[] ]
        files : vec string (orb.git_snap && !picking) ? orb.git_snap.files : null
        nfl : i32 [ (files) ? files.count : 0 ]
        cap : i32 [ orb.commit_cap[ cw9 ] ]
        trs : i32 [ (nfl > 0) ? orb.commit_tab_rows[ cw9, cb.reveal_all ] : 0 ]
        open9 : bool [ cb.commit_open && trs > 0 ]
        band9 : i32 [ (trs > 0) ? trs + 1 + ((open9) ? 4 : 0) : 0 ]
        lh  : f32 [ 36.0 ]
        fs  : i32 [ 14 ]
        cv.font_size[ fs ]
        mtm : cv.measure_text[ 'x' ]
        cb.cap_st  = cap
        cb.cw_st   = mtm.w
        cb.band_st = band9
        # content tops at +4 so the first tab row meets the chips
        yb : f32 [ bounds.y + 4.0 - cb.scroll.y ]
        # tabs: 144px pills on a 150 stride
        rep9 : string [ (orb.git_snap) ? orb.git_snap.repo : '' ]
        shown : i32 [ trs * cap ]
        if [ shown > nfl ] shown = nfl
        for [ i: i32 0, i < shown, i += 1 ]
            rp : string files[i]
            fx : i32 [ rp.rindex_of[ '/' ] ]
            nm : string [ (fx >= 0) ? rp.mid[ fx + 1, rp.count - fx - 1 ] : rp ]
            rw9 : i32 [ i / cap ]
            cl9 : i32 [ i % cap ]
            tx : f32 [ x0 + f32[ cl9 ] * 150.0 ]
            ty : f32 [ yb + f32[ rw9 ] * lh ]
