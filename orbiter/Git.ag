                            gx1 : f32 [ (ei9 == en9 - 1) ? cxx9 + ecw9 : cxx9 + ecw9 + gp9 * 3.0 ]
                            cv.clip_rounded_rect[ cxx9, ry + 4.0, ecw9, 22.0, el9, er9, er9, el9 ]
                            cv.fill_color[ rgba['#0000'] ]
                            cv.box_shadow[ rgba['#8fd0ff'], 0.0, 0.0, gp9, 0.0, true ]
                            cv.rounded_rect[ gx0, ry + 4.0, gx1 - gx0, 22.0, el9, er9, er9, el9 ]
                            cv.paint[ ]
                            cv.no_shadows[]
                        cv.rounded[ 0.0, 0.0, 0.0, 0.0 ]
                        cv.restore[ ]
                        cv.fill_color[ (ehv9) ? rgba['#ffffff'] : rgba['#b9b2cc'] ]
                        cv.draw_text[ exl9[ ei9 ],
                            rect [ x: cxx9, y: ry, w: ecw9, h: 30.0 ],
                            vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                    cv.save[ ]
                    cv.fill_color[ rgba['#0000'] ]
                    cv.set_stroke_size[ 0.5 ]
                    cv.stroke_sides[ 0.5, 0.5, 0.5, 0.5 ]
                    cv.stroke_color[ rgba['#ffffff33'] ]
                    cv.rounded_rect[ ex9, ry + 4.0, ecw9 * f32[ en9 ], 22.0, erd9, erd9, erd9, erd9 ]
                    cv.paint[ ]
                    cv.set_stroke_size[ 0.0 ]
                    cv.stroke_sides[ 0.0, 0.0, 0.0, 0.0 ]
                    cv.restore[ ]
                    cv.font_size[ 16 ]
                if [ rcl9 ]
                    # the clone's bar in the description column: a 2px white
                    # outline and an offset white fill inside it, then the phase
                    bx9 : f32 [ bounds.x + bounds.w * 0.5 ]
                    bw9 : f32 [ 160.0 ]
                    cv.save[ ]
                    cv.fill_color[ rgba['#0000'] ]
                    cv.stroke_width[ 2.0 ]
                    cv.stroke_color[ rgba['#ffffff'] ]
                    cv.rect_to[ bx9, ry + 9.0, bw9, 12.0 ]
                    cv.paint[ ]
                    cv.stroke_width[ 0.0 ]
                    cv.fill_color[ rgba['#ffffff'] ]
                    fw9 : f32 [ (bw9 - 8.0) * ((rcl9.pct > 1.0) ? 1.0 : rcl9.pct) ]
                    if [ fw9 > 0.0 ]
                        cv.rect_to[ bx9 + 4.0, ry + 13.0, fw9, 4.0 ]
                        cv.paint[ ]
                    cv.restore[ ]
                    pc9 : i32 [ i32[ rcl9.pct * 100.0 ] ]
                    lbl9 : string (rcl9.phase.compare[ 'cloning' ] == 0) ? 'cloning {pc9}%' : rcl9.phase
                    cv.fill_color[ (rcl9.phase.compare[ 'failed' ] == 0) ? rgba['#ff6a6a'] : rgba['#ffffffaa'] ]
                    cv.draw_text[ lbl9,
                        rect [ x: bx9 + bw9 + 12.0, y: ry, w: bounds.x + bounds.w - 24.0 - bx9 - bw9 - 12.0, h: 30.0 ],
                        vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                el [ h.dir && h.dir.count > 0 ]
                    fnw : f32 [ cv.measure_text[ nm ].w ]
                    col : f32 [ bounds.x + bounds.w * 0.5 ]
                    end : f32 [ tx0 + fnw + ltm.w * 2.0 ]
                    dx  : f32 [ (end > col) ? end : col ]
                    hc9 : rgba [ (h.repo && h.repo.count > 0 && !h.checked) ? rgba['#ffffff2e'] : rgba['#ffffff66'] ]
                    re9 : f32 [ bounds.x + bounds.w - 24.0 - drs9 ]
                    # shift over this row's hint: the path up to the end of the
                    # segment under the pointer is blue, and a press goes there
                    cut9 : i32 [ 0 ]
                    mx9  : f32 [ bounds.x + cb.hov_mx ]
                    if [ !h.repo && cb.ux && cb.ux.shift && nls - 1 == cb.hov_list && mx9 >= dx && mx9 < re9 && h.dir.count > 1 ]
                        cut9 = h.dir.count
                        for [ ci: i32 1, ci <= h.dir.count, ci += 1 ]
                            if [ dx + cv.measure_text[ h.dir.mid[ 0, ci ] ].w >= mx9 ]
                                cut9 = ci
                                break
                        while [ cut9 < h.dir.count && h.dir.chars[ cut9 ] != 47 ]
                            cut9 += 1
                        cb.hint_cut = h.dir.mid[ 0, cut9 ]
                        cb.hint_row = nls - 1
                    pw9 : f32 [ 0.0 ]
                    rest9 : string h.dir
                    if [ cut9 > 0 ]
                        pre9 : string h.dir.mid[ 0, cut9 ]
                        pw9   = cv.measure_text[ pre9 ].w
                        rest9 = h.dir.mid[ cut9, h.dir.count - cut9 ]
                        cv.fill_color[ rgba['#6cb6ff'] ]
                        cv.draw_text[ pre9,
                            rect [ x: dx, y: ry, w: re9 - dx, h: 30.0 ],
                            vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                    cv.fill_color[ hc9 ]
                    # the hint fades out over its last 48px at the right edge, as
                    # code does at a pane's edge (the ramp's far color must keep a
                    # trace of alpha: none at all turns the ramp off)
                    gx9 : f32 [ cv.transform_tx[] ]
                    cv.text_grad       [ rgba [ r: 1.0, g: 1.0, b: 1.0, a: 0.004 ] ]
                    cv.text_color_pos  [ gx9 + re9 - 48.0, 0.0 ]
                    cv.text_grad_pos   [ gx9 + re9, 0.0 ]
                    cv.text_grad_mirror[ false ]
                    cv.draw_text[ rest9,
                        rect [ x: dx + pw9, y: ry, w: re9 - dx - pw9, h: 30.0 ],
                        vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                    cv.paint[]
                    cv.text_grad[ rgba [ r: 0.0, g: 0.0, b: 0.0, a: 0.0 ] ]
        cb.list_st = nls
        # 16px of air after the last row (the create buttons)
        cb.content_h = f32[ band9 ] * lh + (ry9 - ly) + 16.0 + ((band9 > 0) ? 8.0 : 0.0)
        cv.clear_crop[ ]

element CommitView
    mutable hov_row : i32 [ -1 ]
    mutable hov_tab : i32 [ -1 ]
    # 0 = reveal-all, 1 = make commit / cancel, 2 = commit
    mutable hov_ctl : i32 [ -1 ]
    # hovered browse-list display row
    mutable hov_list : i32 [ -1 ]
    mutable chip_hov : i32 [ -1 ]
    # module row: hovered extension chip (.ag/.cc/.rs/.c), -1 = none.
    # ext_x0 is where the chips start, relative to bounds.x (draw sets it)
    mutable hov_ext  : i32 [ -1 ]
    mutable ext_x0   : f32 [ 0.0 ]
    # dir -> space-joined extensions that exist; a stat per frame is not free
    mutable ext_c    : map string [string]
    # THIS view's commit form: no tab ever sees another's state
    mutable commit_open : bool
    mutable commit_text : vec string
    mutable reveal_all  : bool
    # caret line/col inside the message box
    mutable cl      : i32 [ 0 ]
    mutable cc      : i32 [ 0 ]
    # bold face for tabs whose buffer holds unsaved edits
    mutable bold_font : CanvasFont
    # metrics stamped by the draw so hits match pixels exactly
    mutable band_st : i32 [ 0 ]
    mutable list_st : i32 [ 0 ]
    mutable cap_st  : i32 [ 1 ]
    mutable cw_st   : f32 [ 8.0 ]
    mutable lx0 : f32 [ 0.0 ]
    mutable lx1 : f32 [ 0.0 ]
    mutable rx0 : f32 [ 0.0 ]
    mutable rx1 : f32 [ 0.0 ]
    mutable gx0 : f32 [ 0.0 ]
    mutable gx1 : f32 [ 0.0 ]
    mutable nfx0 : f32 [ 0.0 ]
    mutable nfx1 : f32 [ 0.0 ]
    mutable ndx0 : f32 [ 0.0 ]
    mutable ndx1 : f32 [ 0.0 ]
    # the navigation column between the rail and the list: its rows as
    # drawn (u:<user>, p:<project>) with their tops, for the hit test
    mutable side_w    : f32 [ 168.0 ]
    mutable side_keys : vec string
    # the nav list's row under the pointer: a purply pink wash and edge
    public  nav_hover_fill : rgba [ '#d25cc826' ]
    public  nav_hover_edge : rgba [ '#e07ad899' ]
    intern  hov_mx    : f32       # the pointer's x in the layer, for the path hint
    # shift over a row's path hint: the folder up to the segment under the
    # pointer (drawn blue); a press goes there
    intern  hint_cut  : string
    intern  hint_row  : i32 [ -1 ]
    intern  del_path  : path      # the entry whose delete is held down
    intern  del_dir   : bool
    mutable side_ys   : vec f32
    mutable hov_side  : i32 [ -1 ]
    # the + on the users header opens an editing row: enter adds, esc drops
    mutable hov_plus  : bool
    mutable add_user  : bool
    mutable add_text  : string
    mutable plus_y    : f32 [ 0.0 ]
    # the column scrolls on its own: its offset and its full height as drawn
    mutable side_scroll : f32 [ 0.0 ]
    mutable side_h      : f32 [ 0.0 ]
    # what the status bar's tip shows for the row under the pointer: a
    # column row's or a repository row's full name
    mutable side_tip    : string

    style : CSS {
        area: l0 t0 r0 b0
        layers.content: CommitLayer
            area: l0 t0 r0 b0
        layers.scrollbar: ScrollLayer
            overlay: true
            area: 8px
            thumb_color: #fff4
            thumb_w: 6.0
            thumb_min_h: 32.0
            thumb_radius: 4.0
    }
    mutable sb_drag : bool

    # a module dir holds <stem>/<stem>.ag and friends. return the ones that
    # actually exist so the row can offer them as one-click chips. cached by
    # dir: this is asked for every visible module row, every frame
    # a plain file or folder row: shift gives it a delete at its right end
    func deletable [ h: FindHit ] -> bool
        # a listing's entries are header rows; their continuation and spacer
        # rows carry no name
        if [ !h || !h.file || h.is_spacer || h.is_newfile || h.more || h.card[] || h.line > 0 ] return false
        if [ !h.text || h.text.count == 0 ] return false
        # the way up is not an entry of this folder
        if [ h.text.compare[ '..' ] == 0 || h.text.compare[ '.' ] == 0 ] return false
        return !(h.repo && h.repo.count > 0)

    # the row whose delete is under the pointer (shift held), or null: the
    # press starts the hold on it, the release deletes only over it
    func delete_hit [ ev: Event ] -> FindHit
        ly : lay[]
        if [ !ly ] return null
        return shift_hit[ ev, ly.bounds.w - 88.0, ly.bounds.w - 24.0 ]

    # the row whose pin mark (the slot before its icon) is under the pointer
    func pin_hit [ ev: Event ] -> FindHit
        return shift_hit[ ev, 22.0 + side_w, 52.0 + side_w ]

    # shift held, the pointer between x0 and x1 on an entry row: that entry
    func shift_hit [ ev: Event, x0: f32, x1: f32 ] -> FindHit
        ly : lay[]
        o  : orb9[]
        if [ !ly || !o || !ux || !ux.shift || !o.find_hits ] return null
        rx : f32 [ ev.mouse.pos.x - ly.bounds.x ]
        ry : f32 [ ev.mouse.pos.y - ly.bounds.y ]
        if [ rx < x0 || rx >= x1 ] return null
        trs : i32 [ (o.picking[]) ? 0 : o.commit_tab_rows[ ly.bounds.w - 14.0 - side_w, reveal_all ] ]
        r : i32 [ row_at[ ry, rx, trs ] ]
        if [ r < band_st ] return null
        hi : i32 [ list_hit[ r - band_st ] ]
        if [ hi < 0 || hi >= o.find_hits.count ] return null
        h : FindHit o.find_hits[ hi ]
        return (deletable[ h ]) ? h : null

    func ext_list [ h: FindHit ] -> vec string
        none9 : vec string [ ]
        if [ !h || !h.is_module || !h.file || h.text.count == 0 ] return none9
        if [ !ext_c ] ext_c = map string [string] [ ]
        k9 : '{h.file}'
        if [ !ext_c.contains[ k9 ] ]
            s9 : string ''
            ob9 : orbiter orb9[]
            if [ ob9 ]
                for [ x9: string ] in ob9.module_exts[ h.file, h.text ]
                    s9 = (s9.count > 0) ? '{s9} {x9}' : '{x9}'
            ext_c[ k9 ] = s9
        v9 : ext_c[ k9 ]
        if [ !v9 || v9.count == 0 ] return none9
        return v9.split[ ' ' ]

    func lay [] -> CommitLayer
        return (layers) ? cast CommitLayer [ layers['content'] ] : null

    # frame hook: ALL state settles here — the layer draw only projects
    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        if [ scroll_speed <= 0.0 ] scroll_speed = 36.0
        o : orb9[]
        # the form cannot stay open with nothing to commit
        if [ commit_open ]
            n9 : i32 [ (o && o.git_snap && o.git_snap.files) ? o.git_snap.files.count : 0 ]
            if [ n9 == 0 ] commit_open = false
        # scroll clamps to the content the last projection measured
        if [ content_h > 0.0 && bounds ]
            mx9 : f32 [ content_h - bounds.h ]
            if [ mx9 < 0.0 ] mx9 = 0.0
            if [ scroll.y > mx9 ]
                scroll.y    = mx9
                scroll_goal = mx9

    func orb9 [] -> orbiter
        return cast orbiter [ ux.app_object ]

    # scene themes retint drawn colors, same as styled ones
    func theme_rgba [ s: string ] -> rgba
        if [ ux && ux.st ] return ux.st.theme_color[ s ]
        return rgba [ s ]

    func commit_toggle []
        commit_open = !commit_open
        if [ commit_open ]
            commit_text = vec string [] [ '', '', '' ]
            cl = 0
            cc = 0
        pristine = false
        ux.will_animate = true

    func commit_send []
        o : orb9[]
        if [ !o || !commit_text ] return
        msg : string ''
        for [ i: i32 0, i < commit_text.count, i += 1 ]
            l9 : string commit_text[i]
            if [ !l9 || l9.trim[].count == 0 ] continue
            msg = (msg.count > 0) ? msg + '\n' + l9 : l9
        if [ msg.count == 0 ] return
        o.do_commit[ msg, !o.shift_down ]
        commit_open = false
        commit_text = null
        pristine = false

    func render [] -> Elements
        return Elements [ 'rail' : ToolRail [ top: 3.0, no_scroll: true, area: Region [ 'l0 t0 w64px b0' ] ] ]

    func view [] -> EditorView
        for [ e9: element* a, e9, e9 = e9.parent ]
            if [ e9 inherits EditorView ] return e9
        return null

    # the display row under y (band rows then list rows), -1 outside.
    # event y already includes the element's own scroll offset
    func row_at [ ry: f32, rx: f32, trs: i32 ] -> i32
        band9 : i32 [ band_st ]
        # move_event already delivers scroll-adjusted local coords (find_target
        # sets local + scroll), so do NOT add scroll again — that double-counts
        ry9 : f32 [ ry - 4.0 ]
        if [ ry9 < 0.0 ] return -1
        if [ ry9 < f32[ band9 ] * 36.0 ] return i32[ ry9 / 36.0 ]
        ly9 : f32 [ ry9 - f32[ band9 ] * 36.0 - ((band9 > 0) ? 8.0 : 0.0) ]
        if [ ly9 < 0.0 ] return -1
        # rows are 30px; instance cards flow several to a line: walk the list
        # the way draw lays it out, and pick a card by x within its line
        o : orb9[]
        if [ !o || !o.find_hits ] return -1
        cw9  : f32 [ 152.0 ]
        per9 : i32 [ i32[ (bounds.w - 100.0 - side_w) / cw9 ] ]
        if [ per9 < 1 ] per9 = 1
        y8 : f32 [ 0.0 ]
        ly8 : f32 [ 0.0 ]
        ci : i32 [ 0 ]
        dr : i32 [ 0 ]
        for [ hi: i32 0, hi < o.find_hits.count, hi += 1 ]
            h : FindHit o.find_hits[hi]
            if [ !h ] continue
            if [ h.is_header && !h.is_spacer && !h.is_newfile && h.text.count == 0 ] continue
            if [ h.card[] ]
                if [ !(ci > 0 && ci < per9) ]
                    ci  = 0
                    ly8 = y8
                    y8 += 148.0
                # cards start where draw puts them: past the column and the 8px inset
                cx : f32 [ 22.0 + side_w + f32[ ci ] * cw9 ]
                ci += 1
                if [ ly9 >= ly8 && ly9 < ly8 + 148.0 && rx >= cx - 4.0 && rx < cx + cw9 - 12.0 ] return band9 + dr
            el
                ci = 0
                if [ ly9 < y8 ] return -1
                if [ ly9 < y8 + 30.0 ] return band9 + dr
                y8 += 30.0
            dr += 1
        return -1

    # lines that actually exist in the box: text, plus the line the
    # caret has opened. an empty box is exactly one line
    func box_lines [] -> i32
        n9 : i32 [ 1 ]
        if [ commit_text ]
            for [ i: i32 0, i < commit_text.count && i < 3, i += 1 ]
                ml : string commit_text[i]
                if [ ml && ml.count > 0 ] n9 = i + 1
        if [ cl + 1 > n9 ] n9 = cl + 1
        if [ n9 > 3 ] n9 = 3
        return n9

    # the FindHit index for a list display row, -1 when none
    func list_hit [ dr: i32 ] -> i32
        o : orb9[]
        if [ !o || !o.find_hits || dr < 0 ] return -1
        n9 : i32 [ 0 ]
        for [ hi: i32 0, hi < o.find_hits.count, hi += 1 ]
            h : FindHit o.find_hits[hi]
            if [ !h ] continue
            if [ h.is_header && !h.is_spacer && !h.is_newfile && h.text.count == 0 ] continue
            if [ n9 == dr ] return hi
            n9 += 1
        return -1

    func on_leave [ ev: Event ]
        if [ hov_row != -1 || hov_tab != -1 || hov_ctl != -1 || hov_list != -1 || chip_hov != -1 ]
            hov_row  = -1
            hov_tab  = -1
            hov_ctl  = -1
            hov_list = -1
            hov_ext  = -1
            chip_hov = -1
            pristine = false

    func on_move [ ev: Event ]
        ly : lay[]
        o  : orb9[]
        if [ !ly || !o ] return
        rx : f32 [ ev.mouse.pos.x - ly.bounds.x ]
        ry : f32 [ ev.mouse.pos.y - ly.bounds.y ]
        # shift held: the path hint follows the pointer along its segments
        if [ ux && ux.shift && rx != hov_mx ] pristine = false
        hov_mx = rx
        if [ sb_drag ]
            sbl : ScrollLayer (layers) ? cast ScrollLayer [ layers['scrollbar'] ] : null
            if [ sbl ]
                sy : f32 [ sbl.drag_to[ ry - scroll.y ] ]
                if [ sy >= 0.0 ]
                    scroll.y    = sy
                    scroll_goal = sy
                    pristine    = false
                    ux.will_animate = true
            return
        nrow : i32 [ -1 ]
        ntab : i32 [ -1 ]
        nctl : i32 [ -1 ]
        nlst : i32 [ -1 ]
        nchp : i32 [ -1 ]
        next9 : i32 [ -1 ]
        nsid : i32 [ (rx < 6.0 + side_w) ? side_row_at[ ry - scroll.y ] : -1 ]
        ryp9 : f32 [ ry - scroll.y ]
        nplus : bool [ rx >= 6.0 + side_w - 30.0 && rx < 6.0 + side_w - 10.0 && ryp9 >= plus_y && ryp9 < plus_y + 24.0 ]
        if [ nplus != hov_plus ]
            hov_plus = nplus
            pristine = false
            ux.will_animate = true
        if [ nsid >= 0 ]
            nsid = nsid
        el [ rx < 68.0 ]
            # chips are fixed: undo the scroll the event carries. placed
            # by tool_y, as drawn: consoles sit at the bottom
            ryf : f32 [ ry - scroll.y ]
            ev9 : EditorView view[]
            ed9 : Editor [ (ev9) ? ev9.text_of[] : null ]
            if [ ed9 && ed9.nav_tools ]
                nt9 : i32 [ ed9.tool_base[] + i32[ ed9.nav_tools.count ] ]
                for [ ti: i32 0, ti < nt9, ti += 1 ]
                    ty9 : f32 [ 3.0 + ed9.tool_y[ ti, ly.bounds.h ] ]
                    if [ ryf >= ty9 && ryf < ty9 + 64.0 ] nchp = ti
        el [ rx < 14.0 + side_w ]
            nsid = -1
        el
            # picking: files only, no git tabs (as draw lays it out)
            trs : i32 [ (o.picking[]) ? 0 : o.commit_tab_rows[ ly.bounds.w - 14.0 - side_w, reveal_all ] ]
            r : i32 [ row_at[ ry, rx, trs ] ]
            cx0 : f32 [ 14.0 + side_w ]
            if [ r >= 0 && r < trs ]
                cx : i32 [ i32[ (rx - cx0) / 150.0 ] ]
                if [ rx >= cx0 && cx >= 0 && cx < cap_st && (rx - cx0) - f32[ cx ] * 150.0 <= 144.0 ]
                    nrow = r
                    ntab = cx
            el [ trs > 0 && r == trs ]
                if [ rx >= lx0 && rx <= lx1 ] nctl = 0
                el [ rx >= rx0 && rx <= rx1 ] nctl = 1
            el [ commit_open && band_st > 0 && r == trs + 4 ]
                if [ rx >= gx0 && rx <= gx1 ] nctl = 2
            el [ r >= band_st && r - band_st < list_st ]
                hi9 : i32 [ list_hit[ r - band_st ] ]
                hf9 : FindHit [ (hi9 >= 0) ? o.find_hits[hi9] : null ]
                if [ hf9 && hf9.is_newfile ]
                    # 3 = new file, 4 = new folder
                    if [ rx >= nfx0 && rx <= nfx1 ] nctl = 3
                    el [ rx >= ndx0 && rx <= ndx1 ] nctl = 4
                el
                    nlst = r - band_st
                    # module row: which extension chip is under the cursor
                    exm9 : ext_list[ hf9 ]
                    if [ exm9.count > 0 && rx >= ext_x0 ]
                        ci9  : i32 [ i32[ (rx - ext_x0) / 34.0 ] ]
                        if [ ci9 >= 0 && ci9 < exm9.count ]
                            next9 = ci9
        # the tip: the full name of the column row or repository row hovered
        tip9 : string ''
        if [ nsid >= 0 && side_keys && nsid < side_keys.count ]
            tk9 : string side_keys[ nsid ]
            tv9 : string tk9.mid[ 2, tk9.count - 2 ]
            ts9 : i32 [ tv9.index_of[ '/' ] ]
            tip9 = (ts9 > 0) ? tv9.mid[ 0, ts9 ] + ':' + tv9.mid[ ts9 + 1, tv9.count - ts9 - 1 ] : tv9
        el [ nlst >= 0 && o.find_hits ]
            th9 : i32 [ list_hit[ nlst ] ]
            if [ th9 >= 0 && th9 < o.find_hits.count ]
                hh9 : FindHit o.find_hits[ th9 ]
                if [ hh9 && hh9.repo && hh9.repo.count > 0 ]
                    rs9 : i32 [ hh9.repo.index_of[ '/' ] ]
                    tip9 = (rs9 > 0) ? hh9.repo.mid[ 0, rs9 ] + ':' + hh9.repo.mid[ rs9 + 1, hh9.repo.count - rs9 - 1 ] : hh9.repo
        if [ !side_tip || side_tip.compare[ tip9 ] != 0 ] side_tip = tip9
        if [ nrow != hov_row || ntab != hov_tab || nctl != hov_ctl || nlst != hov_list || nchp != chip_hov || next9 != hov_ext || nsid != hov_side ]
            hov_row  = nrow
            hov_tab  = ntab
            hov_ctl  = nctl
            hov_list = nlst
            chip_hov = nchp
            hov_ext  = next9
            hov_side = nsid
            pristine = false
            ux.will_animate = true

    # the wheel over the column scrolls the column, nothing else
    func on_wheel [ ev: Event ]
        ly : lay[]
        if [ ly ]
            rx : f32 [ ev.mouse.pos.x - ly.bounds.x ]
            if [ rx < 6.0 + side_w ]
                side_scroll += f32[ ev.mouse.wheel_delta.y ] * 26.0 * -1.0
                smax9 : f32 [ side_h - ly.bounds.h ]
                if [ smax9 < 0.0 ] smax9 = 0.0
                if [ side_scroll > smax9 ] side_scroll = smax9
                if [ side_scroll < 0.0 ] side_scroll = 0.0
                pristine = false
                ux.will_animate = true
                return
        super.on_wheel[ ev ]

    # the navigation column row under a fixed (unscrolled) y, -1 outside
    func side_row_at [ ryf: f32 ] -> i32
        if [ !side_ys ] return -1
        for [ i: i32 0, i < side_ys.count, i += 1 ]
            if [ ryf >= side_ys[i] && ryf < side_ys[i] + 24.0 ] return i
        return -1

    func on_release [ ev: Event ]
        # a held delete: released over it once full, the entry goes; anywhere
        # else, or early, it is a cancel
        if [ del_path ]
            o9 : orb9[]
            h9 : FindHit delete_hit[ ev ]
            if [ o9 && h9 ]
                hs9 : string '{h9.file}'
                ds9 : string '{del_path}'
                if [ hs9.compare[ ds9 ] == 0 && o9.delete_fill[ del_path ] >= 1.0 ]
                    o9.path_delete[ del_path, del_dir ]
            if [ o9 ] o9.delete_hold[ null ]
            del_path = null
            animated = false
            pristine = false
        sb_drag = false
        sbl : ScrollLayer (layers) ? cast ScrollLayer [ layers['scrollbar'] ] : null
        if [ sbl ]
            sbl.active = false
            ux.will_animate = true

    func on_press [ ev: Event ]
        ly : lay[]
        o  : orb9[]
        if [ !ly || !o ] return
        ev9 : EditorView view[]
        ed  : Editor [ (ev9) ? ev9.text_of[] : null ]
        rx : f32 [ ev.mouse.pos.x - ly.bounds.x ]
        ry : f32 [ ev.mouse.pos.y - ly.bounds.y ]
        ev.no_default = true
        # the standard scrollbar: same grab/drag as every element
        sbl : ScrollLayer (layers) ? cast ScrollLayer [ layers['scrollbar'] ] : null
        grab : f32 [ (sbl && sbl.thumb_w > 0.0) ? sbl.thumb_w * 2.0 + 8.0 : 16.0 ]
        if [ sbl && sbl.scroll_max > 0.0 && rx > ly.bounds.w - grab ]
            my : f32 [ ry - scroll.y ]
            sbl.grab_at[ my ]
            sy : f32 [ sbl.drag_to[ my ] ]
            if [ sy >= 0.0 ]
                scroll.y    = sy
                scroll_goal = sy
                sb_drag     = true
                sbl.active  = true
                pristine    = false
                ux.will_animate = true
            return
        # the navigation column first, at the far left, fixed
        if [ rx < 6.0 + side_w ]
            ryp9 : f32 [ ry - scroll.y ]
            if [ rx >= 6.0 + side_w - 30.0 && ryp9 >= plus_y && ryp9 < plus_y + 24.0 ]
                add_user = true
                add_text = ''
                if [ ux ] ux.set_focus[ a ]
                pristine = false
                return
            si9 : i32 [ side_row_at[ ry - scroll.y ] ]
            if [ si9 >= 0 && side_keys && si9 < side_keys.count ]
                key9 : string side_keys[ si9 ]
                val9 : string key9.mid[ 2, key9.count - 2 ]
                if [ key9.starts_with[ 'e:' ] ]
                    if [ ux ] ux.set_focus[ a ]
                el [ key9.starts_with[ 'u:' ] && o.shift_down && si9 > 0 && rx >= 6.0 + side_w - 32.0 ]
                    o.repo_forget[ val9 ]
                el [ key9.starts_with[ 'u:' ] ] o.side_pick_user[ val9 ]
                el [ rx >= 6.0 + side_w - 32.0 ] o.repo_dock_toggle[ val9 ]
                el                              o.side_pick_project[ val9 ]
                pristine = false
                return
        # rail chips next, fixed at left: undo the carried scroll
        if [ rx < 68.0 ]
            ryf : f32 [ ry - scroll.y ]
            if [ ed && ed.nav_tools ]
                # placed by tool_y, as drawn and hovered: consoles at the bottom
                nt9 : i32 [ ed.tool_base[] + i32[ ed.nav_tools.count ] ]
                for [ ci: i32 0, ci < nt9, ci += 1 ]
                    ty9 : f32 [ 3.0 + ed.tool_y[ ci, ly.bounds.h ] ]
                    if [ ryf >= ty9 && ryf < ty9 + 64.0 ]
                        ed.press_tool[ ci ]
                        break
            return
        # picking: files only, no git tabs (as draw lays it out)
        if [ rx < 14.0 + side_w ] return
        trs : i32 [ (o.picking[]) ? 0 : o.commit_tab_rows[ ly.bounds.w - 14.0 - side_w, reveal_all ] ]
        r : i32 [ row_at[ ry, rx, trs ] ]
        cx0 : f32 [ 14.0 + side_w ]
        if [ r >= 0 && r < trs && o.git_snap && o.git_snap.files ]
            cx : i32 [ i32[ (rx - cx0) / 150.0 ] ]
            if [ rx >= cx0 && cx >= 0 && cx < cap_st && (rx - cx0) - f32[ cx ] * 150.0 <= 144.0 ]
                idx : i32 [ r * cap_st + cx ]
                if [ idx < o.git_snap.files.count ]
                    fp9 : string o.git_snap.files[idx]
                    o.open_in_pane[ path '{fp9}', (ev9) ? ev9.pane_index : o.active_pane ]
                    o.exit_finder[]
            return
        if [ trs > 0 && r == trs ]
            if [ rx >= lx0 && rx <= lx1 ]
                reveal_all = !reveal_all
                pristine = false
                if [ ux ] ux.will_animate = true
            el [ rx >= rx0 && rx <= rx1 ]
                commit_toggle[]
            return
        if [ commit_open && band_st > 0 && r > trs && r <= trs + 3 ]
            # only lines that exist take the caret; below-last snaps up
            bl9 : i32 [ box_lines[] ]
            nl9 : i32 [ r - trs - 1 ]
            if [ nl9 >= bl9 ]
                cl = bl9 - 1
                el9 : string [ (commit_text && cl < commit_text.count) ? commit_text[cl] : null ]
                cc = (el9) ? el9.count : 0
            el
                cl = nl9
                if [ commit_text && cl < commit_text.count ]
                    ml : string commit_text[cl]
                    mc : i32 [ i32[ (rx - cx0 - 8.0) / cw_st ] ]
                    cc = clamp[ mc, 0, (ml) ? ml.count : 0 ]
            if [ ux ] ux.set_focus[ a ]
            pristine = false
            return
        if [ commit_open && band_st > 0 && r == trs + 4 ]
            if [ rx >= gx0 && rx <= gx1 ] commit_send[]
            return
        # the browse list below the band
        if [ r >= band_st ]
            hi : i32 [ list_hit[ r - band_st ] ]
            if [ hi < 0 ] return
            h : FindHit o.find_hits[hi]
            pane : i32 [ (ev9) ? ev9.pane_index : o.active_pane ]
            # shift: the entry's delete at the row's right end. the press
            # starts the hold; the release decides
            ph9 : FindHit pin_hit[ ev ]
            if [ ph9 ]
                o.pin_toggle[ ph9.file ]
                pristine = false
                return
            dh9 : FindHit delete_hit[ ev ]
            # shift over a path hint: to the folder drawn blue, as a folder
            # row's press goes to its folder
            if [ ux && ux.shift && hint_cut && hint_cut.count > 0 && hint_row == r - band_st ]
                scroll.y    = 0.0
                scroll_goal = 0.0
                scroll_anim = false
                hov_list    = -1
                o.nav_go[ path hint_cut ]
                pristine = false
                return
            if [ dh9 ]
                del_path = dh9.file
                del_dir  = dh9.is_dir
                o.delete_hold[ dh9.file ]
                # the fill runs on the clock: this view repaints itself
                # every frame until the release
                animated = true
                pristine = false
                return
            if [ h.is_newfile ]
                if [ ev9 && rx >= nfx0 && rx <= nfx1 ]
                    ev9.newfile_enter[ (ed) ? ed.src : null ]
                    o.pending_finder = pane
                    if [ ux ] ux.restyle = true
                el [ ev9 && rx >= ndx0 && rx <= ndx1 ]
                    ev9.newdir_enter[ (ed) ? ed.src : null ]
                    o.pending_finder = pane
                    if [ ux ] ux.restyle = true
                return
            # an extension chip opens that source directly — the whole point
            # is not having to walk into the module folder to reach its .ag
            exp9 : ext_list[ h ]
            if [ exp9.count > 0 && rx >= ext_x0 ]
                cp9  : i32 [ i32[ (rx - ext_x0) / 34.0 ] ]
                if [ cp9 >= 0 && cp9 < exp9.count ]
                    o.open_in_pane[ path '{h.file}/{h.text}.{exp9[ cp9 ]}', pane ]
                    o.exit_finder[]
                    return
            if [ h.inst > 0 ]
                o.show_instance[ h.inst, pane ]
                o.exit_finder[]
                return
            if [ h.card[] ]
                o.scene_choose[ h.scene ]
                return
            # the listing's last row: the next page
            if [ h.more ]
                o.repo_more_fetch[]
                pristine = false
                return
            # a repository row: a checkout opens in this pane; a missing one
            # starts cloning and stays in the list, its progress on the row
            if [ h.repo && h.repo.count > 0 ]
                o.repo_checkout[ h.repo, pane ]
                pristine = false
                return
            if [ h.is_dir && h.file ]
                o.nav_root = h.file
                scroll.y    = 0.0
                scroll_goal = 0.0
                scroll_anim = false
                hov_list = -1
                o.run_search[]
                te : element o.title_at[ pane ]
                if [ te ] te.set_focus[]
                pristine = false
                return
            # find-result line: jump straight to it
            if [ !h.is_header && h.line > 0 && h.file ]
                o.open_at_line[ h.file, pane, h.line ]
                o.exit_finder[]
                return
            if [ h.file ]
                o.open_in_pane[ h.file, pane ]
                o.exit_finder[]

    func on_char [ ev: Event ]
        if [ add_user ]
            ch9 : string [ ev.key.text ]
            if [ ch9.count == 0 || (ch9[0] >= 0 && ch9[0] < 32) ] return
            add_text = ((add_text) ? add_text : '') + ch9
            pristine = false
            return
        if [ !commit_open || !commit_text ] return
        ch : string [ ev.key.text ]
        if [ ch.count == 0 || (ch[0] >= 0 && ch[0] < 32) ] return
        if [ cl < 0 || cl >= commit_text.count ] return
        ml : string commit_text[cl]
        if [ !ml ] ml = ''
        cc = clamp[ cc, 0, ml.count ]
        commit_text[cl] = ml.mid[ 0, cc ] + ch + ml.mid[ cc, ml.count - cc ]
        cc += 1
        pristine = false

    func on_key [ ev: Event ]
        if [ !ev.key.state ] return
        if [ add_user ]
            ka : i32 [ i32 ev.key.unicode ]
            if [ ka == 256 ]           # esc: the row goes
                add_user = false
                add_text = ''
            el [ ka == 257 ]           # enter: the user is added and listed
                nm9 : string (add_text) ? add_text.trim[] : ''
                add_user = false
                add_text = ''
                if [ nm9.count > 0 ]
                    o9 : orb9[]
                    if [ o9 ]
                        o9.repo_remember[ nm9 ]
                        o9.side_pick_user[ nm9 ]
            el [ ka == 259 ]           # backspace
                if [ add_text && add_text.count > 0 ] add_text = add_text.mid[ 0, add_text.count - 1 ]
            pristine = false
            return
        if [ !commit_open || !commit_text ] return
        k : i32 [ i32 ev.key.unicode ]
        ml : string [ (cl >= 0 && cl < commit_text.count) ? commit_text[cl] : null ]
        if [ !ml ] ml = ''
        if [ k == 259 ]    # Key.Backspace
            if [ cc > 0 && cc <= ml.count ]
                commit_text[cl] = ml.mid[ 0, cc - 1 ] + ml.mid[ cc, ml.count - cc ]
                cc -= 1
            el [ cl > 0 ]
                cl -= 1
                pl : string commit_text[cl]
                cc = (pl) ? pl.count : 0
        el [ k == 257 ]    # Key.Enter — next message line
            if [ cl < 2 ]
                cl += 1
                nl : string commit_text[cl]
                cc = clamp[ cc, 0, (nl) ? nl.count : 0 ]
        el [ k == 256 ]    # Key.Escape — collapse the form
            commit_toggle[]
            return
        el [ k == 263 ]    # Key.Left
            if [ cc > 0 ] cc -= 1
        el [ k == 262 ]    # Key.Right
            if [ cc < ml.count ] cc += 1
        el [ k == 265 ]    # Key.Up
            if [ cl > 0 ] cl -= 1
            ul : string commit_text[cl]
            cc = clamp[ cc, 0, (ul) ? ul.count : 0 ]
        el [ k == 264 ]    # Key.Down — only onto lines that exist
            if [ cl < box_lines[] - 1 ] cl += 1
            dl : string commit_text[cl]
            cc = clamp[ cc, 0, (dl) ? dl.count : 0 ]
        el
            return
        ev.no_default = true
        pristine = false
