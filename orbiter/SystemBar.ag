extend orbiter

# the system bar: orbiter as the OS, across the top, black; the
# clock in its middle, the tray at its right
Group SystemBar
    # painted onto the screen: a resized cache flashed red
    no_cache : true
    # its menus from orbiter, read as it renders (after the panes)
    public func render [] -> Elements
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        return (orb) ? orb.system_els[] : null
    style : CSS {
        layers.sys:
            fill_color: #000a
            # a very slight inner glow by the pointer's nearness
            # 1/255 alpha: unseen at rest; a zero shadow is skipped
            box_shadow: inset 0 0 13px #88aaff01
            stroke_width: 1
            stroke_color: #0000
            near_border: true
            near_inset: 0.6
            near_inset_color: #c890ffff
        # a faint line along its foot
        layers.foot:
            fill_color: #fff2
            area: l0 b1px r0 h1px
    }

# a take running: a yellow line along the bar's whole foot, over
# every menu on it
element RecBar
    no_cache    : true
    user_events : false
    style : CSS {
        layers.line:
            fill_color: #ffd400ff
    }

# the system menu's dock: the navigator's dock column in a colour
# of its own (the system's)
Group SysDock
    style : CSS {
        layers.dock:
            fill_color: #0d2a3a
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            stroke_color: #fff1
            near_border: true
            near_inset: 1.0
            near_inset_color: #8fd0ffaa
        layers.ddiv:
            fill_color: #ffffff11
            area: r0 t0 w1px b0
    }

# a cell of the system menu's dock, shaped as the navigator's: its
# icon high, its name under it; lit while its view shows, yellow for
# a second action (restart)
element DockRow
    no_cache : true
    public icon_id : string
    public label   : string
    public second  : bool
    # its place in the column: neighbours share one border
    public first   : bool
    public last    : bool
    mutable svg    : SVGModel
    mutable svg_id : string
    style : CSS {
        layers.edge:
            fill_color: #0000
            box_shadow: inset 0 0 13px #8fd0ff04
            stroke_width: 1 1 0 1
            stroke_color: #ffffff09
            near_border: true
            near_reach: 0.5
            near_inset: 4.0
            near_inset_color: #8fd0ffff
        :first
            layers.edge:
                stroke_width: 0 1 0 1
        :last
            layers.edge:
                stroke_width: 1 1 1 1
        :selected
            layers.edge:
                fill_color: #2a5a7a99
                stroke_color: #fff3
                box_shadow: inset 0 0 13px #8fd0ff88
        :second
            layers.edge:
                box_shadow: inset 0 0 13px #ffd84a66
                near_inset_color: #ffd84aff
    }

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        cv : Canvas w.screen
        if [ !svg || svg_id != icon_id ]
            svg_id = icon_id
            ip : path 'images/material/{icon_id}.svg'
            if [ !ip.exists[] ] ip = path 'images/{icon_id}.svg'
            svg = (ip.exists[]) ? SVGModel [ ip ] : null
        # the icon high, its name under it, as the navigator's dock
        isz : f32 [ round[ bounds.w * 0.4 ] ]
        ix  : f32 [ round[ (bounds.w - isz) * 0.5 ] ]
        iy  : f32 [ round[ bounds.h * 0.18 ] ]
        if [ svg ]
            cv.fill_color[ (second) ? rgba [ '#ffd84a' ]
                : rgba [ '#ffffff' ] ]
            cv.draw_svg[ svg, ix, iy, isz, isz ]
        un : f32 ux_unit[ w ]
        fpx : i32 [ i32[ round[ 14.0 * un ] ] ]
        cv.set_font[ shared_font[ cv,
            'fonts/BarlowCondensed-Regular.ttf', fpx ] ]
        cv.font_size[ fpx ]
        cv.fill_color[ rgba [ '#ffffffcc' ] ]
        cv.draw_text[ label,
            rect [ x: 4.0, y: iy + isz + 4.0 * un,
                   w: bounds.w - 8.0, h: 16.0 * un ],
            vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.ellipsis,
            null ]
        cv.set_font[ null ]

# the clock's words, in the bar's middle
element SystemClock
    no_cache : true
    style : CSS {
        layers.face:
            label_color: #e8e8ee
            label_size: 17
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.5 0.5
    }

# booted into orbiter-os: init put orbiter.init= on the boot line
func on_the_os [] -> bool
    fh : handle fopen[ '/proc/cmdline', 'r' ]
    if [ !fh ] return false
    b : local i8 [ 4096 ]
    cmd : ''
    if [ fgets[ @b[0], 4096, fh ] ] cmd = string [ @b[0] ]
    fclose[ fh ]
    return cmd.index_of[ 'orbiter.init=' ] >= 0

# the time as the bar shows it: Thu 15 Oct  10:42
func clock_text [] -> string
    now : i64 [ time[ null ] ]
    tm : struct tm
    localtime_r[ @now, @tm ]
    b : local i8 [ 64 ]
    fmt : '%a %e %b  %H:%M'
    strftime[ @b[0], 64, fmt.chars, @tm ]
    return string [ @b[0] ]

# the date and time at the bar's right, left of the menu button: the
# power button's look; a press opens the system menu
Button BarClock
    style : CSS {
        layers.body:
            fill_color: #0000
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            # 1/255: unseen at rest, yet the near light lights it
            stroke_color: #ffffff01
            near_border: true
            near_reach: 0.5
            near_inset: 4.0
            near_inset_color: #c890ffff
        layers.face:
            label_color: #e8e8ee
            label_size: 17
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.5 0.5
        :hovered
            layers.body:
                fill_color: #ffffff18
        :selected
            layers.body:
                fill_color: #4d3dbcaa
    }

# a top menu of the active window's menu bar, at the bar's left
Button MenuTop
    style : CSS {
        layers.body:
            fill_color: #0000
            # the tray's look: the pointer's light on the edge and fill
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            # 1/255: unseen at rest, yet the near light lights it
            stroke_color: #ffffff01
            near_border: true
            near_reach: 0.5
            near_inset: 4.0
            near_inset_color: #c890ffff
        layers.face:
            label_color: #e8e8ee
            label_size: 18
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.5 0.5
        :hovered
            layers.body:
                fill_color: #ffffff18
        # the app's name, the first
        :tab_on
            layers.face:
                label_font: 'fonts/BarlowCondensed-Bold.ttf'
        :close_part
            layers.face:
                label_size: 20
        :selected
            layers.body:
                fill_color: #4d3dbcaa
    }
    public at : i32
    # a pane not active: its menu name (a press selects the pane)
    public pane : i32 [ -1 ]
    # the pane's tab: the selected pane's app name and its close
    public tab_on : bool
    # the tab's close part (a press closes its pane)
    public close_part : bool
    # its app updating: how far, 0..1 (-1 not yet known); -2 not
    public progress : f32 [ -2.0 ]
    build : TabProgress []

    # a menu open: moving onto this name opens its menu
    public func on_move [ ev: Event ]
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ orb ] orb.menu_hover[ a ]

# an app updating: a line along its tab's foot, filled so far
Layer TabProgress
    func draw [ cv: Canvas ]
        mt : cast MenuTop [ parent ]
        if [ !mt || mt.progress <= -2.0 ] return
        h : f32 [ 2.0 ]
        y : f32 [ bounds.y + bounds.h - h ]
        cv.fill_color[ rgba[ '#ffffff22' ] ]
        cv.rect_to[ bounds.x, y, bounds.w, h ]
        cv.paint[]
        if [ mt.progress > 0.0 ]
            cv.fill_color[ rgba[ '#806bffff' ] ]
            cv.rect_to[ bounds.x, y, bounds.w * mt.progress, h ]
            cv.paint[]

# a folder of the navigator's path in the bar: a press lists its
# folders; the last, the folder shown, is white
Button BarCrumb
    # a path's drawer open: moving onto this piece opens its own
    public func on_move [ ev: Event ]
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ orb ] orb.crumb_hover[ a ]
    # its folder (or file), its pane (-1 the navigator's), and whether
    # it is a pane's file (its drawers list files too)
    public dir  : string
    public pane : i32 [ -1 ]
    public code : bool
    style : CSS {
        layers.body:
            fill_color: #0000
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            stroke_color: #ffffff01
            near_border: true
            near_reach: 0.5
            near_inset: 4.0
            near_inset_color: #c890ffff
        layers.face:
            label_color: #b8b4c8
            label_size: 17
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.5 0.5
        :hovered
            layers.body:
                fill_color: #ffffff18
        :last
            layers.face:
                label_color: #ffffff
        # its drawer open: lit as an open menu's name
        :selected
            layers.body:
                fill_color: #4d3dbcaa
    }
    public last : bool

# the folded front of the path: …
element CrumbSep
    user_events : false
    style : CSS {
        layers.face:
            label_color: #6c6880
            label_size: 17
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.5 0.5
    }

# the active pane's title, after the app's name: an action, not a
# menu. a press changes what the app shows: a URL is typed here, a
# file opens the navigator
Button BarTitle
    style : CSS {
        layers.body:
            fill_color: #0000
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            stroke_color: #ffffff01
            near_border: true
            near_reach: 0.5
            near_inset: 4.0
            near_inset_color: #c890ffff
        layers.face:
            label_color: #e8e8ee
            label_size: 17
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.0 0.5
            # the typed URL starts where the site name does
            label_offset: 10 0
            editable: true
        :hovered
            layers.body:
                fill_color: #ffffff18
        :typing
            layers.body:
                stroke_color: #806bffff
                fill_color: #4d3dbc55
    }
    # a field only while a URL is typed in it
    read_only : true
    # a URL being typed: its edge lit, the field's caret in it
    public typing : bool
    # not typing: the site's name and its domain, drawn over it by
    # the bar (a button never caches, so it cannot mask); their
    # widths as drawn (BarMeasure), read by the bar's layout
    public site   : string
    public domain : string
    mutable site_w   : f32
    mutable domain_w : f32
    measure : BarMeasure []

    # the field edits, then orbiter reads it (Enter, Esc)
    func on_key [ ev: Event ]
        field_key[ a, ev ]
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ orb ] orb.on_key[ ev ]
        ev.no_default = true

    func on_char [ ev: Event ]
        field_char[ a, ev ]
        ev.no_default = true

# measures the site's and domain's words in their fonts; a change
# lays the title out again
Layer BarMeasure
    func draw [ cv: Canvas ]
        bt : cast BarTitle [ parent ]
        if [ !bt ] return
        uri : 'fonts/BarlowCondensed-Regular.ttf'
        # the sizes the labels draw at (with the text size)
        cv.set_font[ shared_font[ cv, uri, label_px[ cv, 17.0 ] ] ]
        cv.font_size[ 17 ]
        sw : f32 [ (bt.site) ? cv.measure_text[ bt.site ].w : 0.0 ]
        cv.set_font[ shared_font[ cv, uri, label_px[ cv, 16.0 ] ] ]
        cv.font_size[ 16 ]
        dw : f32 [ (bt.domain) ? cv.measure_text[ bt.domain ].w : 0.0 ]
        if [ sw != bt.site_w || dw != bt.domain_w ]
            bt.site_w   = sw
            bt.domain_w = dw
            if [ bt.ux ] bt.ux.restyle = true

# the site's name in the bar's title; a press is the title's
element BarText
    ghost : true
    style : CSS {
        layers.face:
            label_color: #e8e8ee
            label_size: 17
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.0 0.5
            # cut, not ellipsized: the mask fades its end
            label_overflow: clip
    }

# the site's domain at the title's right: yellow over https, else
# grey
element BarDomain
    ghost : true
    public secure : bool
    style : CSS {
        layers.face:
            label_color: #ffffff70
            label_size: 16
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 1.0 0.5
    :secure
        layers.face:
            label_color: #ffd24aff
    }

# the side panel's list of one top menu's entries
element MenuPanel
    public items  : vec TrayEntry
    public top    : i32
    # what is typed: only the entries holding it show
    public filter : string
    # the entry the arrow keys chose (-1 none)
    public lit    : i32 [ -1 ]
    # the filter the rows last showed: a new one starts them at
    # their top, at once
    mutable seen_filter : string

    public func render [] -> Elements
        t : Elements []
        if [ !items || top < 0 || top >= items.count ]
            t[ 'none' ] = TrayNote [ label: 'No menu',
                area: Region { l0.7 t0.6 r0.7 h1 } ]
            return t
        # no heading: the menu's name is lit in the bar
        # the entries flow under the heading and scroll, a chip
        # between separators
        fl : bool [ filter && filter.count > 0 ]
        fq : string [ (filter) ? filter : '' ]
        rw : element [ (elements && elements.contains[ 'rows' ])
            ? elements[ 'rows' ] : null ]
        if [ !seen_filter || seen_filter != fq ]
            seen_filter = fq
            if [ rw ]
                rw.scroll.y    = 0.0
                rw.scroll_goal = 0.0
                rw.scroll_anim = false
        mb : MenuBuild [ lit: lit ]
        mb.view[ (elements && elements.contains[ 'rows' ])
            ? elements[ 'rows' ] : null ]
        for [ i: i32 top + 1, i < items.count, i += 1 ]
            e : TrayEntry items[ i ]
            if [ e.depth <= 0 ] break
            # a submenu's name: its entries follow, one deeper
            deeper : bool [ i + 1 < items.count
                && items[ i + 1 ].depth > e.depth ]
            # filtering: the matching entries alone, names left out
            if [ fl && (deeper || !entry_matches[ e, filter ]) ]
                continue
            if [ e.rule ]
                mb.rule[]
                continue
            dp : i32 [ (fl) ? 0 : e.depth - 1 ]
            if [ deeper ]
                mb.note[ 'entry_{i}', e.label, dp ]
            el
                mb.row[ 'entry_{i}', e, i, dp ]
        mb.finish[]
        mb.keep_lit[ rw ]
        rows : Elements mb.out
        t[ 'rows' ] = PanelRows [ elements: rows,
            area: Region [ (fl) ? 'l0 t0.3 r0 b2.2' : 'l0 t0.3 r0 b0' ] ]
        if [ fl ]
            t[ 'filter' ] = MenuFilter [ edit: filter,
                area: Region { l0.7 b1.8 r0.7 h1.2 } ]
        return t

    public func on_click [ ev: Event ]
        e : cast element [ ev.origin ]
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ !e || !orb ] return
        # an entry's second part: its own action
        if [ e inherits TraySide ]
            sd : cast TraySide [ e ]
            orb.menu_pick_side[ sd.entry ]
            return
        if [ !(e inherits TrayRow) ] return
        row : cast TrayRow [ e ]
        orb.menu_pick[ row.entry ]

# the drawer's ground: what is under it, blurred (the screen as drawn
# so far, copied and blurred once a frame), with the panel's tint
Layer DrawerGround
    func draw [ cv: Canvas ]
        if [ !parent ] return
        dr : cast MenuDrawer [ parent ]
        w : Window parent.ux
        if [ !dr || !w || !w.root || !w.root.bounds ] return
        orb : cast orbiter [ w.app_object ]
        b : ReduceBlur (orb) ? orb.drawer_blur[ w,
            dr.background_lens ] : null
        # its place in the window: the screen's origin is behind it
        ox : f32 [ 0.0 ]
        oy : f32 [ 0.0 ]
        for [ e: element* parent, e, e = e.parent ]
            if [ e.bounds ]
                ox += e.bounds.x
                oy += e.bounds.y
        cv.save[]
        cv.clip_rect[ bounds.x, bounds.y, bounds.w, bounds.h, 0.0, 0.0 ]
        if [ b ]
            cv.draw_image[ b.color[], rect [ x: -ox, y: -oy,
                w: w.root.bounds.w, h: w.root.bounds.h ] ]
        cv.fill_color[ '#140a2a99' ]
        cv.rect_to[ bounds.x, bounds.y, bounds.w, bounds.h ]
        cv.paint[]
        # a faint line down each side (painted here: style layers on
        # a drawer subclass went missing once its base was styled)
        cv.fill_color[ '#ffffff11' ]
        cv.rect_to[ bounds.x, bounds.y, 1.0, bounds.h ]
        cv.paint[]
        cv.rect_to[ bounds.x + bounds.w - 1.0, bounds.y, 1.0, bounds.h ]
        cv.paint[]
        cv.restore[]

# orbiter's one popover: a menu (the window's, a tray icon's) slides
# out of the window's left edge over the app, which keeps its width
# down to the window's foot
element MenuDrawer
    animated : true
    # it takes the keys while open: typing filters its menu
    focusable : true
    public open : bool
    # the blur under it live, every frame (the default); off: taken
    # once as it opens, and again on a new window size
    public background_lens : bool [ true ]
    ground : DrawerGround []
    style : CSS {
        area: l-10.91 t0 w10.91 b1.06, 240ms cubic outward
        opacity: 0.0, 240ms cubic outward
    :open
        area: l0 t0 w10.91 b1.06, 260ms cubic inward
        opacity: 1.0, 260ms cubic inward
    }

# a free window's menu: its area is the menu's room in the window
# (orbiter's drawer_area), so it reaches the window's foot
MenuDrawer WinDrawer
    style : CSS {
        area: l-100%+0 t0 r100%+0 b0, 240ms cubic outward
        opacity: 0.0, 240ms cubic outward
    :open
        area: l0%+0 t0 r0%+0 b0, 260ms cubic inward
        opacity: 1.0, 260ms cubic inward
    }

# what a free window's menu slides in: it shows only inside the
# window, its foot's left corner round as the window's
element WinMenuArea
    animated : true
    style : CSS {
        layers.mask:
            fill_color: #0000
            radius: 0 0 0 8
            clip: true
    }

# the exchange's ground: the menus' slideout, the window's width
# less the dock; the
# exchange (trinity's) sits over it in the same place
MenuDrawer ExchangeDrawer
    # edges, never a w: a percent width is a flow share
    style : CSS {
        area: l-100%+0 t0.91 r100%+0 b1.06, 240ms cubic outward
        opacity: 0.0, 240ms cubic outward
    :open
        area: l0%+0 t0.91 r0%+0 b1.06, 260ms cubic inward
        opacity: 1.0, 260ms cubic inward
    }

# the system menu, the desktop's (orbiter's): out of the left under
# the bar, over the app; the view buttons and power on top, the
# sound, Wi-Fi, the tray's apps
MenuDrawer SystemDrawer
    style : CSS {
        area: l-15 t0.91 w15 b1.06, 240ms cubic outward
        opacity: 0.0, 240ms cubic outward
    :open
        area: l0 t0.91 w15 b1.06, 260ms cubic inward
        opacity: 1.0, 260ms cubic inward
    }
