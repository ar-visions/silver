extend orbiter

# the system bar: orbiter as the OS, across the top, black; the
# clock in its middle, the tray at its right
Group SystemBar
    # painted onto the screen: a resized cache flashed red
    no_cache : true
    public blur : BlurGround []
    # its menus from orbiter, read as it renders (after the panes)
    public func render [] -> Elements
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        return (orb) ? orb.system_els[] : null
    style : CSS {
        layers.sys:
            fill_color: #0004
            # a very slight inner glow by the pointer's nearness
            # 1/255 alpha: unseen at rest; a zero shadow is skipped
            box_shadow: inset 0 0 13px #88aaff01
            stroke_width: 1
            stroke_color: #0000
            near_border: true
            near_inset: 0.6
            near_inset_color: #c890ffff
        # a faint line along its foot
        layers.foot:
            fill_color: #fff2
            area: l0 b1px r0 h1px
    }

# a take running: a yellow line along the bar's whole foot, over
# every menu on it
element RecBar
    no_cache    : true
    user_events : false
    style : CSS {
        layers.line:
            fill_color: #ffd400ff
    }

# an update coming in: a red line along the orbiter icon's foot,
# as long as the share received
element UpdBar
    no_cache    : true
    user_events : false
    style : CSS {
        layers.line:
            fill_color: #ff3040ff
    }

# a cell of the system menu's dock, shaped as the navigator's: its
# icon high, its name under it; lit while its view shows, yellow for
# a second action (restart)
element DockRow
    no_cache : true
    public icon_id : string
    label   : string
    public second  : bool
    # its place in the column: neighbours share one border
    first   : bool
    last    : bool
    mutable svg    : SVGModel
    mutable svg_id : string
    style : CSS {
        layers.edge:
            fill_color: #0000
            box_shadow: inset 0 0 13px #806bff04
            stroke_width: 1 1 0 1
            stroke_color: #ffffff09
            near_border: true
            near_reach: 0.5
            near_inset: 4.0
            near_inset_color: #c890ffff
        :first
            layers.edge:
                stroke_width: 0 1 0 1
        :last
            layers.edge:
                stroke_width: 1 1 1 1
        :selected
            layers.edge:
                fill_color: #4d3dbc99
                stroke_color: #fff3
                box_shadow: inset 0 0 13px #806bff88
        :second
            layers.edge:
                box_shadow: inset 0 0 13px #ffd84a66
                near_inset_color: #ffd84aff
    }

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        cv : Canvas w.screen
        if [ !svg || svg_id != icon_id ]
            svg_id = icon_id
            ip : path 'images/material/{icon_id}.svg'
            if [ !ip.exists[] ] ip = path 'images/{icon_id}.svg'
            svg = (ip.exists[]) ? SVGModel [ ip ] : null
        # the icon high, its name under it, as the navigator's dock
        isz : f32 [ round[ bounds.w * 0.4 ] ]
        ix  : f32 [ round[ (bounds.w - isz) * 0.5 ] ]
        iy  : f32 [ round[ bounds.h * 0.18 ] ]
        if [ svg ]
            cv.fill_color[ (second) ? rgba [ '#ffd84a' ]
                : rgba [ '#ffffff' ] ]
            cv.draw_svg[ svg, ix, iy, isz, isz ]
        un : f32 ux_unit[ w ]
        fpx : i32 [ i32[ round[ 14.0 * un ] ] ]
        cv.set_font[ shared_font[ cv,
            'fonts/BarlowCondensed-Regular.ttf', fpx ] ]
        cv.font_size[ fpx ]
        cv.fill_color[ rgba [ '#ffffffcc' ] ]
        cv.draw_text[ label,
            rect [ x: 4.0, y: iy + isz + 4.0 * un,
                   w: bounds.w - 8.0, h: 16.0 * un ],
            vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.ellipsis,
            null, true ]
        cv.set_font[ null ]

# the clock's words, in the bar's middle
element SystemClock
    no_cache : true
    style : CSS {
        layers.face:
            label_color: #e8e8ee
            label_size: 17
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.5 0.5
    }

# the system bar's height in units; a phone's 15% more (its camera
# sits in the screen's top edge)
func bar_units [] -> f32
    return (mobile_on[]) ? 1.05 : 0.91

# booted into orbiter-os: init put orbiter.init= on the boot line
func on_the_os [] -> bool
    fh : handle fopen[ '/proc/cmdline', 'r' ]
    if [ !fh ] return false
    b : local i8 [ 4096 ]
    cmd : ''
    if [ fgets[ @b[0], 4096, fh ] ] cmd = string [ @b[0] ]
    fclose[ fh ]
    return cmd.index_of[ 'orbiter.init=' ] >= 0

# the time as the bar shows it: Thu 15 Oct  10:42
func clock_text [] -> string
    now : i64 [ time[ null ] ]
    tm : struct tm
    localtime_r[ @now, @tm ]
    b : local i8 [ 64 ]
    fmt : '%a %e %b  %H:%M'
    strftime[ @b[0], 64, fmt.chars, @tm ]
    return string [ @b[0] ]

# the date and time at the bar's right, left of the menu button: the
# power button's look; a press opens the system menu
Button BarClock
    style : CSS {
        layers.body:
            fill_color: #0000
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            # 1/255: unseen at rest, yet the near light lights it
            stroke_color: #ffffff01
            near_border: true
            near_reach: 0.5
            near_inset: 4.0
            near_inset_color: #c890ffff
        layers.face:
            label_color: #e8e8ee
            label_size: 17
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.5 0.5
        :hovered
            layers.body:
                fill_color: #ffffff18
        :selected
            layers.body:
                fill_color: #4d3dbcaa
    }

# the time painted on the desktop, its lower right
Button DeskClock
    style : CSS {
        layers.body:
            fill_color: #0000
        layers.face:
            label_color: #e8e8ee
            label_size: 22
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 1.0 1.0
    }

# the mobile network at the bar's right end: four rising bars, lit
# by the signal, and the carrier's name; a press opens the phone
Button BarSignal
    style : CSS {
        layers.body:
            fill_color: #0000
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            stroke_color: #ffffff01
            near_border: true
            near_reach: 0.5
            near_inset: 4.0
            near_inset_color: #c890ffff
        layers.face:
            # drawn by draw (cut to its room), not by the face
            label_color: #0000
            label_size: 17
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 1.0 0.5
            label_offset: -10.0 0.0
        :hovered
            layers.body:
                fill_color: #ffffff18
    }
    public bars : i32
    # no service: the bars dim and crossed
    public off  : bool

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        cv : Canvas [ w.screen ]
        h : f32 [ round[ bounds.h * 0.5 ] ]
        bw : f32 [ max[ 2.0, round[ h * 0.22 ] ] ]
        x : f32 [ 10.0 ]
        y : f32 [ round[ (bounds.h + h) * 0.5 ] ]
        cv.stroke_width[ 0.0 ]
        for [ i: i32 0, i < 4, i += 1 ]
            bh : f32 [ round[ h * (i + 1) / 4.0 ] ]
            lit : bool [ !off && i < bars ]
            cv.fill_color[ rgba [ (lit) ? '#e8e8ee' : '#ffffff33' ] ]
            cv.rect_to[ x, y - bh, bw, bh ]
            cv.paint[]
            x += bw + max[ 1.0, round[ bw * 0.5 ] ]
        # the width it wants: the bars, a gap, the name, the edge's
        fp : i32 [ i32[ round[ 17.0 * ux_unit[ w ] ] ] ]
        cv.set_font[ shared_font[ cv,
            'fonts/BarlowCondensed-Regular.ttf', fp ] ]
        cv.font_size[ f32[ fp ] ]
        # the name's room: 1.265 x what was measured (10%, then 15%
        # more), the word Orbiter's at most (a longer name is cut)
        tw : f32 [ 1.265 * (4.0 + min[ cv.measure_text[ label ].w,
                                       cv.measure_text[ 'Orbiter' ].w ]) ]
        want : f32 [ round[ x + 8.0 + tw + 10.0 ] ]
        cv.fill_color[ rgba [ '#e8e8ee' ] ]
        cv.draw_text[ label, rect [ x: x + 8.0, y: 0.0, w: tw + 2.0,
            h: bounds.h ], vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
            Overflow.ellipsis, null, true ]
        cv.set_font[ null ]
        o : cast orbiter [ w.app_object ]
        if [ o && abs[ o.sig_w - want ] > 0.5 ]
            o.sig_w   = want
            w.restyle = true

# the battery left of the bar's right end: its shell filled by the
# charge (red under 15%), a bolt while power comes in, the percent
Button BarBattery
    style : CSS {
        layers.body:
            fill_color: #0000
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            stroke_color: #ffffff01
            near_border: true
            near_reach: 0.5
            near_inset: 4.0
            near_inset_color: #c890ffff
        layers.face:
            label_color: #0000
        :hovered
            layers.body:
                fill_color: #ffffff18
    }
    public level : f32
    public power : bool

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        cv : Canvas [ w.screen ]
        u : f32 ux_unit[ w ]
        bh : f32 [ round[ bounds.h * 0.36 ] ]
        bw : f32 [ round[ bh * 1.9 ] ]
        t : f32 [ max[ 1.0, round[ 1.5 * u ] ] ]
        x : f32 [ round[ 8.0 * u ] ]
        y : f32 [ round[ (bounds.h - bh) * 0.5 ] ]
        cv.stroke_width[ 0.0 ]
        # the shell's four sides and the nub on its right
        cv.fill_color[ rgba [ '#e8e8eecc' ] ]
        cv.rect_to[ x, y, bw, t ]
        cv.paint[]
        cv.rect_to[ x, y + bh - t, bw, t ]
        cv.paint[]
        cv.rect_to[ x, y, t, bh ]
        cv.paint[]
        cv.rect_to[ x + bw - t, y, t, bh ]
        cv.paint[]
        cv.rect_to[ x + bw, y + round[ bh * 0.3 ], round[ t * 1.5 ],
                    bh - 2.0 * round[ bh * 0.3 ] ]
        cv.paint[]
        # the charge, inside a gap of one side's width
        lv : f32 [ clamp[ level, 0.0, 1.0 ] ]
        iw : f32 [ bw - 4.0 * t ]
        col : string [ (lv < 0.15) ? '#ff5a5a' : '#6fdc8c' ]
        cv.fill_color[ rgba [ col ] ]
        cv.rect_to[ x + 2.0 * t, y + 2.0 * t, max[ t, iw * lv ],
                    bh - 4.0 * t ]
        cv.paint[]
        # power coming in: a bolt across the shell
        if [ power ]
            cv.fill_color[ rgba [ '#ffffff' ] ]
            px : vec f32 [] [ 0.58, 0.22, 0.47, 0.40, 0.78, 0.53, 0.64 ]
            py : vec f32 [] [ -0.1, 0.58, 0.58, 1.1, 0.42, 0.42, -0.1 ]
            for [ i: i32 0, i < 7, i += 1 ]
                bx : f32 [ x + bw * px[ i ] ]
                by : f32 [ y + bh * py[ i ] ]
                if [ i == 0 ] cv.move_to[ bx, by ]
                el cv.line_to[ bx, by ]
            cv.close_path[]
            cv.paint[]
        fp : i32 [ i32[ round[ 17.0 * u ] ] ]
        cv.set_font[ shared_font[ cv,
            'fonts/BarlowCondensed-Regular.ttf', fp ] ]
        cv.font_size[ f32[ fp ] ]
        pc : i32 [ i32[ round[ lv * 100.0 ] ] ]
        tx : f32 [ x + bw + round[ t * 1.5 ] + round[ 5.0 * u ] ]
        cv.fill_color[ rgba [ '#e8e8ee' ] ]
        cv.draw_text[ '{pc}%', rect [ x: tx, y: 0.0,
            w: bounds.w - tx, h: bounds.h ], vec2f [ 0.0, 0.5 ],
            vec2f [ 0.0, 0.0 ], Overflow.ellipsis, null, true ]
        cv.set_font[ null ]

# every button on the bar: a name, or an icon in its place
Button BarButton
    style : CSS {
        layers.body:
            fill_color: #0000
            # the tray's look: the pointer's light on the edge and fill
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            # 1/255: unseen at rest, yet the near light lights it
            stroke_color: #ffffff01
            near_border: true
            near_reach: 0.5
            near_inset: 4.0
            near_inset_color: #c890ffff
        layers.face:
            label_color: #e8e8ee
            label_size: 17
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.5 0.5
        :hovered
            layers.body:
                fill_color: #ffffff18
        :selected
            layers.body:
                fill_color: #4d3dbcaa
        :disable
            layers.body:
                fill_color: #0000
            layers.iconl:
                opacity: 0.35
    }
    # what it does: its bar's TipLine shows it while it is hovered
    public tip : string

# a bar's free space: the tip of the bar's button the pointer is on,
# in place (no floating box over the work)
element TipLine
    style : CSS {
        layers.face:
            label_color: #e4e4eab0
            label_size: 15
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.0 0.5
            label_offset: 10.0 0.0
    }

    public func tick [ w: Window ]
        t : string [ '' ]
        for [ e: element* w.hovered, e && e != parent, e = e.parent ]
            if [ e.parent == parent && e inherits BarButton ]
                bb : BarButton e
                if [ bb.tip ] t = bb.tip
        cur : string (label) ? label : ''
        if [ cur == t ] return
        label    = t
        pristine = false
        w.restyle = true

# a top menu of the active window's menu bar, at the bar's left
BarButton MenuTop
    style : CSS {
        layers.face:
            label_size: 18
        # the app's name, the first
        :tab_on
            layers.face:
                label_font: 'fonts/BarlowCondensed-Bold.ttf'
        :close_part
            layers.face:
                label_size: 20
        :other
            layers.face:
                label_color: #ffffff80
    }
    public at : i32
    # a pane not active: its menu name (a press selects the pane)
    public pane : i32 [ -1 ]
    # the pane's tab: the selected pane's app name and its close
    public tab_on : bool
    # the tab's close part (a press closes its pane)
    public close_part : bool
    # its app updating: how far, 0..1 (-1 not yet known); -2 not
    public progress : f32 [ -2.0 ]
    # a group's other member: a press shows it (-1 not one)
    public member : i32 [ -1 ]
    # that member's name, dim beside the one shown
    public other : bool
    public build : TabProgress []
    # the app's tab pressed: past 8 px it is carried off the bar
    intern held  : bool
    intern went  : f32
    intern drags : bool

    func on_press [ ev: Event ]
        held  = tab_on && pane >= 0 && ev.mouse.button == 0
        went  = 0.0
        drags = false
        if [ held ] ux.set_capture[ a ]

    # a menu open: moving onto this name opens its menu
    public func on_move [ ev: Event ]
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ held && orb ]
            dx : f32 [ ev.mouse.delta.x ]
            dy : f32 [ ev.mouse.delta.y ]
            went += max[ dx, -dx ] + max[ dy, -dy ]
            if [ !drags && went > 8.0 ]
                drags = true
                orb.drawer_shut[]
                orb.tab_drag = pane
                ux.restyle = true
            if [ drags ] ux.will_animate = true
            return
        if [ orb && member < 0 ] orb.menu_hover[ a ]

    func on_release [ ev: Event ]
        if [ !held ] return
        held = false
        ux.release_capture[ a ]
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ drags && orb ] orb.tab_drop[ pane ]
        el [ orb && member >= 0 ] orb.grp_show[ member ]
        drags = false

# an app updating: a line along its tab's foot, filled so far
Layer TabProgress
    func draw [ cv: Canvas ]
        mt : cast MenuTop [ parent ]
        if [ !mt || mt.progress <= -2.0 ] return
        h : f32 [ 2.0 ]
        y : f32 [ bounds.y + bounds.h - h ]
        cv.fill_color[ rgba[ '#ffffff22' ] ]
        cv.rect_to[ bounds.x, y, bounds.w, h ]
        cv.paint[]
        if [ mt.progress > 0.0 ]
            cv.fill_color[ rgba[ '#806bffff' ] ]
            cv.rect_to[ bounds.x, y, bounds.w * mt.progress, h ]
            cv.paint[]

# a folder of the navigator's path in the bar: a press lists its
# folders; the last, the folder shown, is white
BarButton BarCrumb
    # a path's drawer open: moving onto this piece opens its own
    public func on_move [ ev: Event ]
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ orb ] orb.crumb_hover[ a ]
    # its folder (or file), its pane (-1 the navigator's), and whether
    # it is a pane's file (its drawers list files too)
    public dir  : string
    public pane : i32 [ -1 ]
    public code : bool
    style : CSS {
        layers.face:
            label_color: #b8b4c8
        :last
            layers.face:
                label_color: #ffffff
    }
    last : bool

# the folded front of the path: …
element CrumbSep
    user_events : false
    style : CSS {
        layers.face:
            label_color: #6c6880
            label_size: 17
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.5 0.5
    }

# the active pane's title, after the app's name: an action, not a
# menu. a press changes what the app shows: a URL is typed here, a
# file opens the navigator
BarButton BarTitle
    style : CSS {
        layers.face:
            label_align: 0.0 0.5
            # the typed URL starts where the site name does
            label_offset: 10 0
            editable: true
        :typing
            layers.body:
                stroke_color: #806bffff
                fill_color: #4d3dbc55
    }
    # a field only while a URL is typed in it
    read_only : true
    # a URL being typed: its edge lit, the field's caret in it
    public typing : bool
    # not typing: the site's name and its domain, drawn over it by
    # the bar (a button never caches, so it cannot mask); their
    # widths as drawn (BarMeasure), read by the bar's layout
    public site   : string
    public domain : string
    mutable site_w   : f32
    mutable domain_w : f32
    public measure : BarMeasure []

    # the field edits, then orbiter reads it (Enter, Esc)
    func on_key [ ev: Event ]
        field_key[ a, ev ]
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ orb ] orb.on_key[ ev ]
        ev.no_default = true

    func on_char [ ev: Event ]
        field_char[ a, ev ]
        ev.no_default = true

# measures the site's and domain's words in their fonts; a change
# lays the title out again
Layer BarMeasure
    func draw [ cv: Canvas ]
        bt : cast BarTitle [ parent ]
        if [ !bt ] return
        uri : 'fonts/BarlowCondensed-Regular.ttf'
        # the sizes the labels draw at (with the text size)
        cv.set_font[ shared_font[ cv, uri, label_px[ cv, 17.0 ] ] ]
        cv.font_size[ 17 ]
        sw : f32 [ (bt.site) ? cv.measure_text[ bt.site ].w : 0.0 ]
        cv.set_font[ shared_font[ cv, uri, label_px[ cv, 16.0 ] ] ]
        cv.font_size[ 16 ]
        dw : f32 [ (bt.domain) ? cv.measure_text[ bt.domain ].w : 0.0 ]
        if [ sw != bt.site_w || dw != bt.domain_w ]
            bt.site_w   = sw
            bt.domain_w = dw
            if [ bt.ux ] bt.ux.restyle = true

# the site's name in the bar's title; a press is the title's
element BarText
    ghost : true
    style : CSS {
        layers.face:
            label_color: #e8e8ee
            label_size: 17
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.0 0.5
            # cut, not ellipsized: the mask fades its end
            label_overflow: clip
    }

# the site's domain at the title's right: yellow over https, else
# grey
element BarDomain
    ghost : true
    public secure : bool
    style : CSS {
        layers.face:
            label_color: #ffffff70
            label_size: 16
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 1.0 0.5
    :secure
        layers.face:
            label_color: #ffd24aff
    }

# the side panel's list of one top menu's entries
element MenuPanel
    public items  : vec TrayEntry
    public top    : i32
    # what is typed: only the entries holding it show
    public filter : string
    # the entry the arrow keys chose (-1 none)
    public lit    : i32 [ -1 ]
    # the filter the rows last showed: a new one starts them at
    # their top, at once
    mutable seen_filter : string

    public func render [] -> Elements
        t : Elements []
        if [ !items || top < 0 || top >= items.count ]
            t[ 'none' ] = TrayNote [ label: 'No menu',
                area: Region { l0.7 t0.6 r0.7 h1 } ]
            return t
        # no heading: the menu's name is lit in the bar
        # the entries flow under the heading and scroll, a chip
        # between separators
        fl : bool [ filter && filter.count > 0 ]
        fq : string [ (filter) ? filter : '' ]
        rw : element [ (elements && elements.contains[ 'rows' ])
            ? elements[ 'rows' ] : null ]
        if [ !seen_filter || seen_filter != fq ]
            seen_filter = fq
            if [ rw ]
                rw.scroll.y    = 0.0
                rw.scroll_goal = 0.0
                rw.scroll_anim = false
        mb : MenuBuild [ lit: lit ]
        mb.view[ (elements && elements.contains[ 'rows' ])
            ? elements[ 'rows' ] : null ]
        for [ i: i32 top + 1, i < items.count, i += 1 ]
            e : TrayEntry items[ i ]
            if [ e.depth <= 0 ] break
            # a submenu's name: its entries follow, one deeper
            deeper : bool [ i + 1 < items.count
                && items[ i + 1 ].depth > e.depth ]
            # filtering: the matching entries alone, names left out
            if [ fl && (deeper || !entry_matches[ e, filter ]) ]
                continue
            if [ e.rule ]
                mb.rule[]
                continue
            dp : i32 [ (fl) ? 0 : e.depth - 1 ]
            if [ deeper ]
                mb.note[ 'entry_{i}', e.label, dp ]
            el
                mb.row[ 'entry_{i}', e, i, dp ]
        mb.finish[]
        mb.keep_lit[ rw ]
        rows : Elements mb.out
        t[ 'rows' ] = PanelRows [ elements: rows,
            area: Region [ (fl) ? 'l0 t0.3 r0 b2.2' : 'l0 t0.3 r0 b0' ] ]
        if [ fl ]
            t[ 'filter' ] = MenuFilter [ edit: filter,
                area: Region { l0.7 b1.8 r0.7 h1.2 } ]
        return t

    public func on_click [ ev: Event ]
        e : cast element [ ev.origin ]
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ !e || !orb ] return
        # an entry's second part: its own action
        if [ e inherits TraySide ]
            sd : cast TraySide [ e ]
            orb.menu_pick_side[ sd.entry ]
            return
        if [ !(e inherits TrayRow) ] return
        row : cast TrayRow [ e ]
        orb.menu_pick[ row.entry ]

# the drawer's ground: what is under it, blurred (the screen as drawn
# so far, copied and blurred once a frame), with the panel's tint
Layer DrawerGround
    func draw [ cv: Canvas ]
        if [ !parent ] return
        dr : cast MenuDrawer [ parent ]
        w : Window parent.ux
        if [ !dr || !w || !w.root || !w.root.bounds ] return
        orb : cast orbiter [ w.app_object ]
        # over the main menu: its background as it is, never taken
        # again (the screen now holds the menu)
        b : ReduceBlur (orb && !(dr inherits SystemDrawer))
            ? orb.drawer_blur[ w,
            dr.background_lens && !orb.sys_under ] : null
        # its place in the window: the screen's origin is behind it
        ox : f32 [ 0.0 ]
        oy : f32 [ 0.0 ]
        for [ e: element* parent, e, e = e.parent ]
            if [ e.bounds ]
                ox += e.bounds.x
                oy += e.bounds.y
        cv.save[]
        cv.clip_rect[ bounds.x, bounds.y, bounds.w, bounds.h, 0.0, 0.0 ]
        # the main menu: the ground chosen (the scene, as the screen
        # paints it under the ui), not a blur of what is under it
        if [ dr inherits SystemDrawer ]
            gi : Texture w.ground_image[]
            if [ gi ]
                cv.draw_image[ gi, rect [ x: -ox, y: -oy,
                    w: w.root.bounds.w, h: w.root.bounds.h ] ]
            el
                cv.fill_color[ w.solid_color ]
                cv.rect_to[ bounds.x, bounds.y, bounds.w, bounds.h ]
                cv.paint[]
            # the config mode: the scene's blur, darkened round the open
            # drawer (its cabinet lit)
            cv.fill_color[ rgba [ '#000000aa' ] ]
            # only while the cards show (a view hides their drawer)
            gr : cast AppsGrid [ (orb && orb.sys_view.count == 0)
                ? orb.find_el[ orb, 'sys_apps' ] : null ]
            cn : vec2f [ (gr) ? gr.cab_now[] : vec2f [ 0.0, 0.0 ] ]
            ch : f32 [ cn.y ]
            if [ ch > 0.0 ]
                ct : f32 [ cn.x - oy ]
                cv.rect_to[ bounds.x, bounds.y, bounds.w,
                            max[ ct - bounds.y, 0.0 ] ]
                cv.paint[]
                cb : f32 [ ct + ch ]
                cv.rect_to[ bounds.x, cb, bounds.w,
                            max[ bounds.y + bounds.h - cb, 0.0 ] ]
            el
                cv.rect_to[ bounds.x, bounds.y, bounds.w, bounds.h ]
            cv.paint[]
        el
            if [ b ]
                cv.draw_image[ b.color[], rect [ x: -ox, y: -oy,
                    w: w.root.bounds.w, h: w.root.bounds.h ] ]
            cv.fill_color[ '#140a2a99' ]
            cv.rect_to[ bounds.x, bounds.y, bounds.w, bounds.h ]
            cv.paint[]
        # a faint line down each side (painted here: style layers on
        # a drawer subclass went missing once its base was styled)
        cv.fill_color[ '#ffffff11' ]
        cv.rect_to[ bounds.x, bounds.y, 1.0, bounds.h ]
        cv.paint[]
        cv.rect_to[ bounds.x + bounds.w - 1.0, bounds.y, 1.0, bounds.h ]
        cv.paint[]
        cv.restore[]

# orbiter's one popover: a menu (the window's, a tray icon's) slides
# out of the window's left edge over the app, which keeps its width
# down to the window's foot
element MenuDrawer
    animated : true
    # it takes the keys while open: typing filters its menu
    focusable : true
    public open : bool
    # the blur under it live, every frame (the default); off: taken
    # once as it opens, and again on a new window size
    public background_lens : bool [ true ]
    public ground : DrawerGround []

    # a move in the menu is the menu's: no default action (the task
    # bar does not come up under it)
    func on_move [ ev: Event ]
        ev.no_default = true

    style : CSS {
        # to the foot: the task bar draws over it
        area: l0 t0 w10.91 b0
        opacity: 0.0, 240ms cubic outward
    :open
        opacity: 1.0, 260ms cubic inward
    # a phone has no bottom bar: the drawers reach the foot
    # a phone's drawers are its whole width
    :use_mobile
        area: l0%+0 t0 r0%+0 b0
    }

# a free window's menu: its area is the menu's room in the window
# (orbiter's drawer_area), so it reaches the window's foot
MenuDrawer WinDrawer
    style : CSS {
        area: l0%+0 t0 r0%+0 b0
        opacity: 0.0, 240ms cubic outward
    :open
        opacity: 1.0, 260ms cubic inward
    }

# what a free window's menu slides in: it shows only inside the
# window, its foot's left corner round as the window's
element WinMenuArea
    animated : true
    style : CSS {
        layers.mask:
            fill_color: #0000
            radius: 0 0 0 8
            clip: true
    }

# the drawer's rows and the page slid over them, clipped to the
# drawer: the page coming in from the right shows nothing outside
element MenuSlide
    animated : true
    style : CSS {
        layers.mask:
            fill_color: #0000
            clip: true
    }

# the app menu's page over its rows: a back row at its top (the
# page's name), its content under it
element MenuPage
    animated : true
    # the key of the property panel in it
    public panel : string [ 'menu_props' ]
    # a card's info menu: its rows act, none goes back
    public info  : bool
    # a folder's page of fields: its go row sends them
    public form  : bool

    # the panel's rows edge to edge: a line over them (its own last
    # rule is the line under them)
    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds
             || !elements || !elements.contains[ panel ] ]
            return
        lp : LaunchPanel elements[ panel ]
        if [ !lp.bounds || lp.rows_h <= 0.0 ] return
        cv : Canvas w.screen
        cv.stroke_width[ 0.0 ]
        cv.fill_color[ rgba [ '#ffffff1a' ] ]
        cv.rect_to[ lp.bounds.x, lp.bounds.y - 1.0, lp.bounds.w, 1.0 ]
        cv.paint[]

    public func on_click [ ev: Event ]
        e : cast element [ ev.origin ]
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ !e || !orb || !(e inherits TrayRow) ] return
        row : cast TrayRow [ e ]
        if [ info ] orb.app_info_pick[ row.entry ]
        el [ form && row.id == 'pgo' ]
            orb.fold_page_go[]
        el orb.menu_page_back[]

# a field on a menu's page, in the menus' look
TextInput PageField
    style : CSS {
        layers.body:
            fill_color: #ffffff0a
            radius: 8
            stroke_width: 1
            stroke_color: #ffffff18
            near_border: true
            near_inset: 2.0
            near_inset_color: #c890ffaa
        layers.face:
            label_color: #ffffff60
            label_size: 18
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            editable: true
            label_align: 0.0 0.5
            label_offset: 12.0 0.0
        :focused
            layers.body:
                fill_color: #4d3dbc33
                stroke_color: #806bff
            layers.face:
                label_color: #ffffff
        :has_value
            layers.face:
                label_color: #ffffff
    }

PageField PageSecret
    style : CSS {
        layers.face:
            secret: true
    }

# words on a menu's page, wrapped: a note, or what was wrong (red)
element PageNote
    label : string
    public wrong : bool

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        cv : Canvas w.screen
        fr : string 'fonts/BarlowCondensed-Regular.ttf'
        cv.set_font[ shared_font[ cv, fr, label_px[ cv, 16.0 ] ] ]
        cv.fill_color[ rgba [ (wrong) ? '#ff8a8a' : '#ffffff80' ] ]
        cv.draw_text[ label, rect [ x: 0.0, y: 0.0, w: bounds.w,
                                    h: bounds.h ],
                      vec2f [ 0.0, 0.0 ], vec2f [ 0.0, 0.0 ],
                      Overflow.wrap, null, false ]

# an option on a menu's page: its name and a switch, a press flips
# it; it is kept on the element while the page shows
element PageCheck
    label : string
    intern on    : bool
    style : CSS {
        layers.body:
            fill_color: #0000
            radius: 8
            near_border: true
        :hovered
            layers.body:
                fill_color: #ffffff10
    }

    func on_press [ ev: Event ]
        on = !on
        pristine = false
        ev.no_default = true

    # its value given (the page's own, as it opens)
    public func set_on [ v: bool ]
        on = v
        pristine = false

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        cv : Canvas w.screen
        un : f32 ux_unit[ w ]
        bh : f32 bounds.h
        fr : string 'fonts/BarlowCondensed-Regular.ttf'
        cv.set_font[ shared_font[ cv, fr, label_px[ cv, 18.0 ] ] ]
        cv.fill_color[ rgba [ '#e4e4ea' ] ]
        cv.draw_text[ label, rect [ x: round[ 12.0 * un ], y: 0.0,
                                    w: bounds.w, h: bh ],
                      vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                      Overflow.visible, null, false ]
        sw : f32 [ round[ 40.0 * un ] ]
        sh : f32 [ round[ 22.0 * un ] ]
        sx : f32 [ bounds.w - sw - round[ 8.0 * un ] ]
        sy : f32 [ (bh - sh) * 0.5 ]
        r : f32 [ sh * 0.5 ]
        cv.stroke_width[ 0.0 ]
        cv.fill_color[ rgba [ (on) ? '#806bff' : '#ffffff20' ] ]
        cv.rounded_rect[ sx, sy, sw, sh, r, r, r, r ]
        cv.paint[]
        kx : f32 [ (on) ? sx + sw - sh + 3.0 : sx + 3.0 ]
        kr : f32 [ r - 3.0 ]
        cv.fill_color[ rgba [ '#f4f2ff' ] ]
        cv.rounded_rect[ kx, sy + 3.0, sh - 6.0, sh - 6.0,
                         kr, kr, kr, kr ]
        cv.paint[]

# the exchange's ground: the menus' slideout, the window's width
# less the dock; the
# exchange (trinity's) sits over it in the same place
MenuDrawer ExchangeDrawer
    # edges, never a w: a percent width is a flow share
    style : CSS {
        area: l0%+0 t0.91 r0%+0 b1.06
        opacity: 0.0, 240ms cubic outward
    :open
        opacity: 1.0, 260ms cubic inward
    :use_mobile
        area: l0%+0 t1.05 r0%+0 b0
    }

# the system menu, the desktop's (orbiter's): fades in under the
# bar, the whole screen; the view buttons and power on top, the
# sound, Wi-Fi, the tray's apps
MenuDrawer SystemDrawer
    # its holder starts under the bar (orbiter sys_area)
    style : CSS {
        area: l0%+0 t0 r0%+0 b0
        opacity: 0.0, 240ms cubic outward
    :open
        opacity: 1.0, 260ms cubic inward
    }

# a phone's system menu cells in one row along its foot: a drag or
# the wheel scrolls them sideways, eased; a tap picks the cell
element SysStrip
    # px scrolled, and where it eases to
    intern shift : f32
    intern goal  : f32
    intern took  : bool
    # the pointer's x at a press, -1 none; the scroll then
    intern grab  : f32 [ -1.0 ]
    intern from  : f32
    intern moved : bool
    # the press's place along the strip (x across, y down)
    intern tap_x : f32
    public blur : BlurGround []
    style : CSS {
        layers.dock:
            fill_color: #0004
            box_shadow: inset 0 0 13px #86f2
            stroke_width: 1
            stroke_color: #fff1
        # its edge toward the menu: the right down a desktop's
        # column, the top across a phone's foot
        layers.ddiv:
            fill_color: #ffffff11
            area: r0 t0 w1px b0
        :use_mobile
            layers.ddiv:
                area: l0 t0 r0 h1px
    }

    func orb [] -> orbiter
        return cast orbiter [ (ux) ? ux.app_object : null ]

    func most [] -> f32
        o : orbiter orb[]
        if [ !o || !bounds ] return 0.0
        m : f32 [ f32[ o.sys_strip_ids[].count ] * o.strip_cell[]
            - ((use_mobile) ? bounds.w : bounds.h) ]
        return (m > 0.0) ? m : 0.0

    public func render [] -> Elements
        o : orbiter orb[]
        return (o) ? o.sys_strip_els[ shift ] : null

    public func tick [ w: Window ]
        # its scroll is orbiter's (it crosses a reload): taken at the
        # start, kept after
        o : orbiter orb[]
        if [ o && !took ]
            took  = true
            shift = o.strip_shift
            goal  = shift
        goal = clamp[ goal, 0.0, most[] ]
        if [ o ] o.strip_shift = goal
        if [ shift != goal ]
            shift = filter_n[ shift, goal, 0.14, ux.frame_factor ]
            if [ abs[ goal - shift ] < 0.5 ] shift = goal
            ux.restyle      = true
            ux.will_animate = true
        # its ends fade where more cells lie: sides across, top and
        # foot down
        st : f32 [ (shift > 0.5) ? 24.0 : 0.0 ]
        en : f32 [ (most[] - shift > 0.5) ? 24.0 : 0.0 ]
        mg : vec4f [ (use_mobile) ? vec4f [ 0.0, en, 0.0, st ]
            : vec4f [ st, 0.0, en, 0.0 ] ]
        if [ mask_glow.x != mg.x || mask_glow.y != mg.y
             || mask_glow.z != mg.z || mask_glow.w != mg.w ]
            mask_glow = mg
            pristine  = false

    public func on_wheel [ ev: Event ]
        ev.no_propagation = true
        goal -= f32[ ev.mouse.wheel_delta.y ] * 40.0
        ux.will_animate = true

    public func on_press [ ev: Event ]
        ev.no_default     = true
        ev.no_propagation = true
        grab  = f32[ (use_mobile) ? ux.mouse.x : ux.mouse.y ]
        tap_x = (use_mobile) ? ev.mouse.pos.x : ev.mouse.pos.y
        from  = goal
        moved = false
        ux.set_capture[ a ]

    public func on_move [ ev: Event ]
        if [ grab < 0.0 ] return
        d : f32 [ f32[ (use_mobile) ? ux.mouse.x : ux.mouse.y ] - grab ]
        if [ abs[ d ] > 8.0 ] moved = true
        if [ !moved ] return
        # the cells follow the finger
        goal  = clamp[ from - d, 0.0, most[] ]
        shift = goal
        ux.restyle = true

    public func on_release [ ev: Event ]
        ux.release_capture[ a ]
        drag : bool [ moved ]
        held : bool [ grab >= 0.0 ]
        grab = -1.0
        o : orbiter orb[]
        if [ !held ] return
        # the strip's press: nothing under it hears its release
        ev.no_default     = true
        ev.no_propagation = true
        if [ drag || !o ] return
        ids : vec string o.sys_strip_ids[]
        i : i32 [ i32[ (tap_x + shift) / o.strip_cell[] ] ]
        if [ i >= 0 && i < ids.count ] o.sys_pick[ ids[ i ] ]
