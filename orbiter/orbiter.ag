    # a hosted app's build failed: its log's first error is the band's
    # the error goes to its line; returns the log's first message
    public func app_build_error [ mod: string, logpath: string ]
                                  -> string
        err_mod = mod
        jump_to_error[ logpath ]
        return build_log_line[ logpath ]

    # a build log's error: silver's own (its coloured line), else
    # the first line past 'compiling', colour taken out
    func build_log_line [ logpath: string ] -> string
        lp : path '{logpath}'
        if [ !lp.exists[] ] return ''
        content : string lp.load[ typeid[string], null ]
        if [ !content ] return ''
        fallback : ''
        for [ row: string ] in content.split[ '\n' ]
            coloured : bool [ row.count > 0 && row.mid[ 0, 1 ] == '\x1b' ]
            plain : ''
            i : i32 [ 0 ]
            while [ i < row.count ]
                # an ESC [ ... m run: skip to its m
                if [ row.mid[ i, 1 ] == '\x1b' ]
                    while [ i < row.count && row.mid[ i, 1 ] != 'm' ]
                        i += 1
                    i += 1
                    continue
                plain = '{plain}{row.mid[ i, 1 ]}'
                i += 1
            tl : string plain.trim[]
            if [ tl.count == 0 || tl.ends_with[ 'compiling...' ] ]
                continue
            if [ coloured ] return tl
            if [ fallback.count == 0 ] fallback = tl
        return fallback

    func jump_to_error [ logpath: string ]
        lp : path '{logpath}'
        if [ !lp.exists[] ] return
        content : string lp.load[ typeid[string], null ]
        if [ !content || content.count == 0 ] return
        ai : i32 [ content.index_of[ '.ag:' ] ]
        if [ ai < 0 ] return
        ps : i32 [ ai ]
        while [ ps > 0 ]
            c : i32 [ (i32 content.chars[ ps - 1 ]) & 255 ]
            if [ c == 32 || c == 10 || c == 13 || c == 27 || c == 40 || c == 41 || c == 91 ]
                break
            ps -= 1
        fp : string content.mid[ ps, ai + 3 - ps ]
        # line digits after '.ag:'
        li : i32 [ ai + 4 ]
        ls : ''
        while [ li < content.count ]
            c : i32 [ (i32 content.chars[ li ]) & 255 ]
            if [ c < 48 || c > 57 ] break
            ls = '{ls}{content.mid[ li, 1 ]}'
            li += 1
        if [ ls.count == 0 ] return
        ln : i32 [ atoi[ ls.chars ] ]
        # the sentence follows the compiler's (src:line) parens on the
        # same row; older logs put it on the row underneath — take
        # whichever is non-empty
        me : i32 [ li ]
        while [ me < content.count ]
            if [ ((i32 content.chars[ me ]) & 255) == 10 ] break
            me += 1
        ms : i32 [ li ]
        while [ ms < me && ((i32 content.chars[ ms ]) & 255) != 41 ]
            ms += 1
        msg : ''
        if [ ms < me ] msg = content.mid[ ms + 1, me - ms - 1 ].trim[]
        if [ msg.count == 0 ]
            ms = me + 1
            # the log carries ansi colour: skip any ESC [ ... m runs
            # first
            while [ ms < content.count && ((i32 content.chars[ ms ]) & 255) == 27 ]
                while [ ms < content.count && ((i32 content.chars[ ms ]) & 255) != 109 ]
                    ms += 1
                ms += 1
            mend : i32 [ ms ]
            while [ mend < content.count ]
                c3 : i32 [ (i32 content.chars[ mend ]) & 255 ]
                if [ c3 == 10 || c3 == 13 ] break
                mend += 1
            if [ ms < mend ] msg = content.mid[ ms, mend - ms ].trim[]
        err_file = path '{fp}'
        err_file.hold[]
        err_line = ln
        err_msg  = msg
        err_msg.hold[]
        open_at_line[ err_file, active_pane, ln ]

    # is the current error from a module we are RUNNING in a pane?
    # the top tab is for code ORBITER ITSELF reloads. anything else --
    # a file merely open in a pane -- belongs to that app's run band
    func err_is_own [] -> bool
        if [ !err_mod ] return false
        ot  : typeid[ a ]
        own : string [ ot.ident ]
        return err_mod == own

    # the compile error for a file: its message, else null
    public func err_text_for [ p: path ] -> string
        if [ !p || !err_file || err_line <= 0 ] return null
        if [ err_file.absolute[].compare[ p.absolute[] ] != 0 ]
            return null
        return (err_msg && err_msg.count > 0) ? err_msg : 'error'

    public func err_line_no [] -> i32
        return err_line

    public func goto_error []
        if [ !err_file || err_line <= 0 ] return
        open_at_line[ err_file, active_pane, err_line ]

    func open_at_line [ p: path, pi: i32, to_line: i32 ]
        if [ pick_deliver[ p ] ] return
        findbar_open = false
        find_showing = false
        # where we leave from is a point too, or back has nowhere to go
        fr : Editor pane_at[ pi ]
        if [ fr && fr.nav && fr.src ]
            fr.nav.record[ pi, '{fr.src.absolute[]}',
                           (fr.sel_line < 0) ? 0 : fr.sel_line,
                           fr.sel_col, fr.scroll.y ]
        open_in_pane[ p, pi ]
        ed : Editor pane_at[ pi ]
        if [ !ed ] return
        # the ARRIVAL is its own nav point (land_on records it). a file
        # not yet in would have its load reset the caret: that landing
        # waits for the load
        same : bool [
            ed.loaded_src
            && '{ed.loaded_src.absolute[]}' == '{p.absolute[]}' ]
        if [ same ] ed.land_on[ to_line ]
        el          ed.goto_pending = to_line

    func force_update []
        win : ux
        if [ win ]
            win.restyle      = true
            win.will_animate = true

    # show a named view in a pane; '' returns it to the default
    func set_pane_view [ ed: Editor, nm: string ]
        if [ !ed ] return
        ed.view_note[ nm ]
        # one view at a time: another view ends git's diff
        if [ nm && nm.count > 0 && nm != 'git' ] ed.git_on = false
        ed.view_name = nm
        ed.load_file[]
        exit_find_mode[]

    # the navigator into a folder: any search text goes and the folder's
    # entries show (shift + a path hint's press)
    public func nav_go [ p: path ]
        if [ !p ] return
        nav_root   = p
        find_text  = ''
        finder_off = false
        te : element find_el[ a, 'title' ]
        if [ te ]
            te.edit = ''
            te.pristine = false
            if [ ux ] ux.set_focus[ te ]
        run_search[]

    # the peer module that owns a view, or null when we host it
    # ourselves
    func view_module [ nm: string ] -> string
        if [ !nm || nm.count == 0 ] return null
        ensure_views[]
        m9 : string (view_mods) ? view_mods[ nm ] : null
        if [ !m9 ] return null
        if [ m9 == 'orbiter' ] return null
        return m9

    func exit_find_mode []
        # closed with no pick: the program's dialog is cancelled
        if [ pick_field == 'portal' && portal_ask ]
            portal_shared[].finish[ portal_ask, '' ]
            portal_ask = null
            nav_req = false
        # closed with no pick: the instance waits, held
        if [ pick_launch ]
            pick_launch.asking = false
            pick_launch.held   = true
            pick_launch.note   = 'no file chosen'
            pick_launch = null
        # any pick ends with the close, not only a launch's
        pick_field = null
        pick_dir   = false
        pick_exts  = null
        pick_cache = null
        sp9 : string search_pane[]
        findbar_open = false
        find_showing = false
        find_text    = ''
        finder_off   = true
        win : ux
        if [ win && win.focus ]
            win.focus.edit = ''
            win.release_focus[ win.focus ]
        # rebuild with the finder off — apply_pane is what puts each
        # pane's file back and drops the nav tools row
        run_search[]
        # esc lands focus on the editor the search was working in
        pi : i32 [
            (sp9 && sp9.count > 4)
            ? sp9.mid[ 4, sp9.count - 4 ].real_value[] : 0 ]
        ed : Editor pane_at[ pi ]
        if [ win && ed ] win.set_focus[ ed ]
        force_update[]

    # the fields own their text (editable layers): read it back before a
    # search, or a shadow copy that drifted is what gets searched
    func findbar_sync []
        te : element title_at[ active_pane ]
        if [ !te || !te.elements ] return
        fe : element te.elements['find']
        if [ fe && fe.edit ] findbar_text = fe.edit
        pe : element te.elements['pattern']
        if [ pe ] pattern_text = (pe.edit) ? pe.edit.trim[] : ''
        re : element te.elements['replace']
        if [ re ] replace_text = (re.edit) ? re.edit : ''

    func open_find []
        finder_off   = false
        findbar_open = true
        # the field is built later this frame; ask the window to focus
        # it by id and let animate[] resolve it before the next draw
        if [ ux ] ux.focus_id = 'find'
        findbar_pane = 'pane{active_pane}'
        ed : Editor pane_at[ active_pane ]
        if [ ed ]
            sel : ed.selected_text[]
            if [ sel && sel.count > 0 ]
                nl : i32 [ sel.index_of[ '\n' ] ]
                findbar_text = (nl >= 0) ? sel.mid[ 0, nl ] : sel
        te : element title_at[ active_pane ]
        if [ !te ] return
        fe : element te.elements['find']
        if [ fe ]
            fe.edit       = findbar_text
            fe.sel_col    = findbar_text->count
            fe.anchor_col = fe.sel_col
            fe.set_focus[]
        force_update[]

    func focus_finder []
        finder_off    = false
        nav_req       = true
        title_find_on = false
        te : element title_at[ active_pane ]
        # an app's pane has no title bar: it comes back, then focuses
        # (a find typed there before is not the navigator's)
        if [ te ]
            te.edit = find_text
            te.set_focus[]
        el pending_finder = active_pane
        force_update[]

    func exit_finder []
        nav_req      = false
        find_text    = ''
        find_results = list string []
        win : ux
        if [ !win ] return
        if [ win.focus && win.focus.id == 'title' ]
            win.focus.edit = ''
            win.release_focus[ win.focus ]

    func set_active [ idx: i32 ]
        active_idx = idx

    func sync_tabs []
        win : ux
        tb  : element win.root.elements['toolbar']
        if [ !tb ] return
        nav : element tb.elements['source_nav']
        if [ !nav ] return
        for [ i: i32 0, i < target_names.count, i += 1 ]
            name : string target_names[i]
            op   : Option nav.elements[name]
            if [ op ]
                op.selected = active_target == name &&
                    active_panel != 'config'
        sys : Option nav.elements['system']
        if [ sys ]
            sys.selected = active_target == 'system' &&
                active_panel != 'config'
        cfg : Option nav.elements['config']
        if [ cfg ] cfg.selected = active_panel == 'config'
        win.restyle = true

    func sync_active []
        win : ux
        if [ win ] win.restyle = true

    public func pad[ n:i32 ] -> string
        str : local char[256]
        sprintf[str, "%04i", n]
        return str

    public func on_inspect [ hits: vec StyleHit ]
        if [ !hits || hits.count == 0 ] return
        h : StyleHit hits[ 0 ]
        if [ h.file ] open_at_line[ h.file, active_pane, h.line ]

    # activate a hits row: click and Return share this
    func hit_activate [ ed: Editor, row: i32, dbl: bool ] -> bool
        if [ !ed || row < 0 || row >= find_hits.count ] return false
        h : FindHit find_hits[ row ]
        if [ !h || h.is_spacer ] return true
        if [ h.inst > 0 ]
            pick_instance[ h.inst, ed.pane_index ]
            exit_find_mode[]
            return true
        if [ h.card[] ]
            scene_choose[ h.scene ]
            return true
        if [ h.session && h.session.count > 0 ]
            cpi : i32 [ ed.pane_index ]
            while [ pane_console.count <= cpi ]
                pane_console += ''
            console_seq += 1
            sid : string '{h.session}#{console_seq}'
            pane_console[cpi] = sid
            active_pane = cpi
            if [ !ed_sessions ]
                ed_sessions = map ConsoleSession [string] [ ]
            ns : ConsoleSession []
            ns.name = sid
            ns.launch_cmd = agent_cmd[ sid ]
            ed_sessions[sid] = ns
            ns.start[]
            exit_find_mode[]
            return true
        if [ h.is_newfile ]
            for [ e9: element* ed, e9, e9 = e9.parent ]
                if [ e9 inherits EditorView ]
                    ev9 : EditorView e9
                    ev9.newfile_enter[ ed.src ]
                    # label swap drops focus; re-take it after restyle
                    pending_finder = ed.pane_index
                    break
            return true
        if [ h.more ]
            repo_more_fetch[]
            return true
        if [ h.repo && h.repo.count > 0 ]
            # a clone starts and stays in view; a checkout is selected
            # and browsed
            repo_checkout[ h.repo, ed.pane_index ]
            return true
        if [ h.is_dir && h.file ]
            # a folder pick: double-click takes this one; a click still
            # walks into it
            if [ dbl && pick_dir && pick_field && pick_field.count > 0 && pick_deliver[ h.file ] ]
                return true
            nav_root  = h.file
            ed.sel_line      = -1
            ed.anchor_line   = -1
            ed.hover_line    = -1
            ed.scroll.y      = 0.0
            ed.scroll_target = 0.0
            run_search[]
            te : element title_at[ ed.pane_index ]
            if [ te ] te.set_focus[]
            return true
        if [ !h.is_header && h.line > 0 && h.file ]
            if [ dbl ] open_at_line[ h.file, ed.pane_index, h.line ]
            return true
        if [ h.file && pick_deliver[ h.file ] ] return true
        if [ h.file && is_program[ h.file ] ]
            run_program[ h.file, ed.pane_index ]
            exit_finder[]
            return true
        if [ h.file ]
            # browse file link / result filename header → open the file
            open_in_pane[ h.file, ed.pane_index ]
            exit_finder[]
            return true
        return false

    func on_press [ ev: Event ]
        if [ stats ]
            log 'PRESS target={(ev.target && ev.target.id) ? ev.target.id : "(noid)"} pick={(pick_field) ? pick_field : ""} nav={nav_showing} find={find_showing} finder_off={finder_off}'
        if [ !ev.target ] return
        log 'on_press: target={ev.target.id}'
        # a press outside the drawer (and its openers) shuts it
        # a press away from the exchange's slideout puts it away (its
        # button toggles it itself)
        if [ ux && ux.shot_ask && !ux.agent_min && ux.exchange_region
             && ux.exchange_region.count > 0
             && ev.target.id != 'agent_note' ]
            inx : bool [ false ]
            for [ e: element* ev.target, e, e = e.parent ]
                if [ e.id == 'exchange' || e inherits ExchangeDrawer ]
                    inx = true
            if [ !inx ]
                ux.agent_min = true
                ux.restyle   = true
        if [ drawer_open && menu_kind != 'exchange'
             && !(ev.target inherits MenuTop)
             && !(ev.target inherits TrayMark) ]
            inside : false
            for [ e: element* ev.target, e, e = e.parent ]
                if [ e inherits MenuDrawer ] inside = true
            if [ !inside ] drawer_shut[]
        # a press in a free window brings it up and selects it
        fpi : i32 pane_index_of[ ev.target ]
        if [ pane_floats[ fpi ] ] raise_pane[ fpi ]
        # a press on another pane's title only selects that pane: no
        # focus, so no nav list; a press once it is selected opens it
        if [ ev.target.id == 'title' ]
            edt : Editor pane_of[ ev.target ]
            # the editor's bar is for finding alone: a press starts it
            if [ system_on[] && edt && edt.src && !edt.app_view
                 && !nav_req && !title_find_on ]
                active_pane = edt.pane_index
                title_find_toggle[]
                ev.no_default     = true
                ev.no_propagation = true
                return
            # a pane showing a running app: the finder on the folder
            # of the app's resource, the pick goes to the app (its
            # orbiter bar's dialog, hosted)
            hv : AppView (edt && edt.app_view) ? edt.run_view : null
            # a program's window: the navigator, never its console's
            # argument pick
            if [ hv && window_of[ hv ] != 0 ] hv = null
            if [ hv && !hv.ended && edt.pane_index == active_pane ]
                hm : string band_mod_of[ edt ]
                cur : string (hv.arg_text) ? hv.arg_text : ''
                pick_default[ edt, null, hm, cur ]
                ev.no_default     = true
                ev.no_propagation = true
                return
            # a window's pane has no editor: its view has the number
            tpi : i32 pane_index_of[ ev.target ]
            if [ tpi >= 0 && tpi < editor_slots.count
                 && tpi != active_pane ]
                active_pane   = tpi
                ev.no_default = true
                if [ ux ] ux.restyle = true
                return
        # one of the app's views: the pane shows the app in that view;
        # the lit one again, the app's source
        if [ ev.target.id.starts_with[ 'view_' ]
             && ev.target inherits ArgButton ]
            pv : Editor pane_of[ ev.target ]
            av : AppView (pv) ? pv.run_view : null
            if [ pv && av && !av.ended && av.slot >= 0 ]
                vi : i32 [ ev.target.id.mid[ 5,
                    ev.target.id.count - 5 ] ]
                lit : bool [ pv.app_view && av.app_view_on == vi ]
                if [ !pv.app_view ] embed_app[ pv, av ]
                host_post2[ av.slot, 1, i32[ HM.view ], (lit) ? -1 : vi,
                            0, 0 ]
            ev.no_default     = true
            ev.no_propagation = true
            return
        # another instance's chip: a press shows it in this pane; with
        # shift its file is picked anew too; cmd: another
        if [
            ev.target inherits ArgButton && ev.target.id != 'arg_edit'
            && ev.target.id.starts_with[ 'arg_' ] ]
            oc : ArgButton ev.target
            po : Editor pane_of[ ev.target ]
            if [ ev.key.ctrl || ev.key.meta ]
                arg_new[ po ]
            el [ po && oc.inst ]
                embed_app[ po, oc.inst ]
                session_dirty = true
                # a file argument picks anew; a typed one is not
                # browsed (its chip edits once shown)
                bm : string band_mod_of[ po ]
                dq : Prop default_prop[ bm ]
                fl : bool [ dq && (dq.type == 'resource'
                    || dq.type == 'path') ]
                if [ ev.key.shift && fl ]
                    da : string default_arg_of[ oc.inst.module_args ]
                    pick_default[ po, null, bm, da ]
            if [ ux ] ux.restyle = true
            ev.no_default     = true
            ev.no_propagation = true
            return
        # a resource argument: a press selects it; shift picks its file
        # anew; cmd starts another instance on a new pick
        if [
            ev.target.id == 'arg_edit' && ev.target inherits ArgButton ]
            ab : ArgButton ev.target
            if [ ev.key.ctrl || ev.key.meta ]
                arg_new[ pane_of[ ev.target ] ]
                ev.no_default     = true
                ev.no_propagation = true
                return
            # shift: a file picks anew; a typed argument is edited
            if [ ev.key.shift && ab.resource ]
                ps : Editor pane_of[ ev.target ]
                if [ ps ]
                    bm : string band_mod_of[ ps ]
                    pick_default[ ps, null, bm, ab.value ]
                ev.no_default     = true
                ev.no_propagation = true
                return
            # a press selects it: the pane shows the app; selected, it
            # goes back to the source while the app runs on
            if [ !ev.key.shift ]
                pe : Editor pane_of[ ev.target ]
                rv : AppView (pe) ? pe.run_view : null
                if [ pe && rv && !pe.app_view ]
                    embed_app[ pe, rv ]
                el [ pe && rv ]
                    pe.app_view  = false
                    # the source shows again: the wheel scrolls it
                    pe.no_scroll = false
                    pe.load_file[]
                    session_dirty = true
                if [ ux ] ux.restyle = true
                ev.no_default     = true
                ev.no_propagation = true
                return
            # a new edit starts empty; esc leaves the value as it was
            if [ !ux || ux.focus != ab ]
                ab.edit       = ''
                ab.sel_col    = 0
                ab.anchor_col = 0
                ab.label      = ''
            ab.focusable = true
            if [ ux ] ux.set_focus[ ab ]
        # working in a pane makes it active: keys act where you are
        epv : Editor pane_of[ ev.target ]
        if [
            epv && epv.pane_index >= 0
            && epv.pane_index < editor_slots.count ]
            active_pane = epv.pane_index
        for [ e: element* ev.target, e, e = e.parent ]
            if [ e inherits Console ]
                co  : Console e
                cid : string co.id
                if [
                    ev.target.id == 'console_filter' && cid
                    && cid.count > 4
                    && cid.mid[ 0, 4 ].compare[ 'pane' ] == 0 ]
                    ppi : i32 [
                        cid.mid[ 4, cid.count - 4 ].real_value[] ]
                    if [
                        ppi < editor_slots.count
                        && ppi < pane_console.count ]
                        pane_console[ppi] = ''
                        active_pane    = ppi
                        pending_finder = ppi
                        ev.no_default  = true
                        force_update[]
                        return
            if [ e inherits Editor ]
                ed : Editor e
                # hits are clickable only while the list is actually
                # shown
                if [
                    ev.target == e && (nav_showing || find_showing)
                    && ed.sel_line >= 0
                    && ed.sel_line < find_hits.count ]
                    dbl : bool [
                        ev.mouse.double_click
                        && last_hit_row == ed.sel_line ]
                    last_hit_row = ed.sel_line
                    if [ hit_activate[ ed, ed.sel_line, dbl ] ]
                        ev.no_default = true
                        if [ ev.target ] ev.target.ux.restyle = true
                    return
        # avatar pane titlebar toggle: hide/show the 3D avatar view
        if [ ev.target.id == 'avatar_hide' ]
            show_avatar = !show_avatar
            if [ ev.target ] ev.target.ux.restyle = true
            force_update[]
            return
        if [ ev.target.id == 'mute' ]
            app_muted = !app_muted
            if [ ev.target ] ev.target.ux.restyle = true
            ev.no_default = true
            return
        # the bottom bar's sound: mute the mode's own, or pick the mode
        if [ ev.target.id == 'vol_mute' ]
            mav : AppView active_app[]
            if [ mav ] mav.vol_mute = !mav.vol_mute
            el
                master_mute = !master_mute
                host_master_set[ master_vol, (master_mute) ? 1 : 0 ]
            if [ ux ] ux.restyle = true
            ev.no_default = true
            return
        if [ ev.target.id == 'reload_ready' ]
            request_swap[]
            ev.no_default = true
            return
        if [
            ev.target.id == 'error' || ev.target.id == 'our_app_error' ]
            goto_error[]
            ev.no_default = true
            return
        if [ ev.target.id == 'play' ]
            dl : dbg (debuggers) ? debuggers[ active_target ] : null
            if [ dl && dl.active ]
                dl.stop[]
                clear_stop_lines[]
            el
                pn : Project (projects) ? projects[
                    active_target ] : null
                if [ pn ]
                    run_node[ active_target ]
                el
                    # no build node — debug the built binary by name
                    # alone
                    start_debug[ active_target ]
            ev.no_default = true
            return
        # the instance panel's group renames itself to the pressed
        # segment
        if [
            ev.target.id == 'continue' || ev.target.id == 'step_next'
            || ev.target.id == 'pause' ||
             ev.target.id == 'step_in'  || ev.target.id == 'step_out' ]
            # the status bar is in no pane: the active one
            eds : Editor pane_of[ ev.target ]
            if [ !eds ] eds = pane_at[ active_pane ]
            rvp : AppView (eds) ? eds.run_view : null
            msp : path (eds) ? module_src_of[ eds ] : null
            ds : dbg stopped_debugger[]
            # a title's steps: its pane's instance's debugger
            if [ rvp && stopped_at[ rvp ] ] ds = rvp.debugger
            if [ ev.target.id == 'pause' && msp
                    && !(rvp && !rvp.ended && !rvp.held) ]
                show_app[ eds, msp, false ]
            el [ ev.target.id != 'pause' && ds ]
                if [ ev.target.id == 'continue' ]
                    ds.cont[]
                    # running again: the next pause pauses
                    if [ rvp ] rvp.paused = false
                el [ ev.target.id == 'step_next' ] ds.step_over[]
                el [ ev.target.id == 'step_in' ]   ds.step_into[]
                el                                  ds.step_out[]
            el [ eds && eds.run_view ]
                instance_action[ eds, eds.run_view, ev.target.id ]
            if [ ev.target ] ev.target.ux.restyle = true
            ev.no_default = true
            return
        # a program's folder pick answered with the folder shown
        if [ ev.target.id == 'portal_open' ]
            if [ nav_root ] portal_deliver[ nav_root ]
            ev.no_default = true
            return
        # a window's close: the program is asked, as its own X would
        if [ ev.target.id == 'win_close' ]
            pw : i32 [ active_pane ]
            for [ e: element* ev.target, e, e = e.parent ]
                if [ e inherits EditorView ]
                    ev9 : EditorView e
                    pw = ev9.pane_index
                    break
            # a dialog up over it closes first
            wv : u64 pane_sheet_of[ pw ]
            if [ wv == 0 ] wv = pane_window[ pw ]
            if [ wv != 0 ] wlc_window_close[ wv ]
            ev.no_default = true
            return
        # the title's run: shift or cmd adds an instance, else a running
