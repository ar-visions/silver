            drag_pin   = ev.target.id.mid[ 5, ev.target.id.count - 5 ]
            drag_x0    = f32[ ux.mouse.x ]
            drag_y0    = f32[ ux.mouse.y ]
            drag_moved = false
            drag_slot  = -1
            ev.no_default = true
            return
        # pip shrinks the app into the editor; its instruments stay open
