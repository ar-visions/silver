        if [ ev.target.id && ev.target.id.starts_with[ 'xchip_' ] ]
            nm : ev.target.id.mid[ 6, ev.target.id.count - 6 ]
            set_open = (set_open == nm) ? '' : nm
            if [ ux ] ux.restyle = true
            ev.no_default = true
            return
        if [ ev.target.id && ev.target.id.starts_with[ 'xopt_' ]
             && set_open.count > 0 ]
            pre : 'xopt_{set_open}_'
            if [ ev.target.id.starts_with[ pre ] ]
                k : i32 [ i32[ ev.target.id.mid[ pre.count,
                    ev.target.id.count - pre.count ].integer_value[] ] ]
                for [ p8: Prop ] in panel_settings[ sys_view ]
                    if [ p8.ident == set_open && p8.stops
                         && k >= 0 && k < p8.stops.count ]
                        setting_set[ p8.ident, p8.stops[ k ] ]
                set_open = ''
            if [ ux ] ux.restyle = true
            ev.no_default = true
            return
        # a scene setting's chip: its choices under it; again, away
        if [ ev.target.id && ev.target.id.starts_with[ 'schip_' ] ]
            nm : ev.target.id.mid[ 6, ev.target.id.count - 6 ]
            scene_open = (scene_open == nm) ? '' : nm
            if [ ux ] ux.restyle = true
            ev.no_default = true
            return
        # a choice: the scene takes it
        if [ ev.target.id && ev.target.id.starts_with[ 'sopt_' ]
             && scene_open.count > 0 ]
            pre : 'sopt_{scene_open}_'
            if [ ev.target.id.starts_with[ pre ] ]
                k : i32 [ i32[ ev.target.id.mid[ pre.count,
                    ev.target.id.count - pre.count ].integer_value[] ] ]
                ps8 : LaunchProps []
                sp8 : string scene_spec[]
                if [ sp8.count > 0 ] Au.parse_agi[ null, sp8.chars, ps8 ]
                if [ ps8.props ]
                    for [ p8: Prop ] in ps8.props
                        if [ p8.ident == scene_open && p8.stops
                             && k >= 0 && k < p8.stops.count ]
                            scene_prop_set[ p8.ident, p8.stops[ k ] ]
            if [ ux ] ux.restyle = true
            ev.no_default = true
            return
        # the system menu's view buttons: the view under its tiles;
