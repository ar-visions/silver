            return
        if [ ev.target.id == 'side_toggle' ]
            inst_hidden = !inst_hidden
            if [ ux ] ux.restyle = true
            ev.no_default = true
            return
        # the console's toolbar
        if [ ev.target.id == 'con_dbg' || ev.target.id == 'con_app'
