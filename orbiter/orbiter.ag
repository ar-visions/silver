# the editor under a pane's split. 'text' is the editor/instruments
# split, and the editor keeps key 'text' inside it
# the editor down the 'text' chain: pane split, the editor|panel split,
# the editor|band column, the editor
# silver's install, wherever orbiter was started: silver-host runs
# it in <install>/share/<app>; else the start folder's install
# made once: the install does not move while orbiter runs
install_at : path

func install_root [] -> path
    if [ install_at ] return install_at
    i : path path.path_install[]
    install_at = (i) ? i : path '{path.path_startup[]}/install'
    return install_at

func scene_exports_stamp [ entries: vec path ] -> i64
    stamp : i64 [ 1469598103934665603 ]
    if [ !entries ] return stamp
    for [ entry: path ] in entries
        ext : entry.ext[]
        if [ !ext || ext != 'agi' ] continue
        name : string entry.filename[]
        stamp = stamp * 1099511 + i64[ name.hash[] ]
        stamp = stamp * 1099511 + entry.modified_time[]
    return stamp

func editor_under [ spl: element ] -> Editor 
    te : element [ spl ]
    for [ d: i32 0, d < 4, d += 1 ]
        if [ !te || !te.elements ] return null
        te = te.elements[ 'text' ]
        if [ te && te inherits Editor ] return Editor te
    return null
 
# an element's ground: the backdrop's blur, as the app cards
element orbiter : trinity # implements compiler
    width   : i32    [ 1888 ]
    height  : i32    [ 888 ] 
    public background : string [ 'Background' ]
    # the committed backdrop scene and each pane's file + caret
    intern [ StatePersist ] scene       : string
    intern [ StatePersist ] pane_states : vec pane_state
    intern [ StatePersist ] inst_states : vec inst_state
    # instances changed: the frame saves
