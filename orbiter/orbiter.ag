        if [ !root ] return
        if [ !git_refs ] git_refs = map string [string] []
        git_refs[
            '{root.absolute[]}' ] = (rf && rf.count > 0) ? rf : 'HEAD'
        git_dirty = true
        git_summarize[]
        force_update[]

    # the browsed folder's home repo — arbitrary per location
    func repo_root [] -> path
        base : path [ (nav_root) ? nav_root : project_root[] ]
        rl : git_capture[ base, 'rev-parse --show-toplevel', false ]
        if [ rl.count == 0 ] return null
        return path rl[0]

    # fixed 144px tabs on a 150px stride, 12px insets
    func commit_cap [ w: f32 ] -> i32
        su : f32 ux_unit[ ux ]
        c : i32 [ (w - 24.0 * su) / (150.0 * su) ]
        return (c < 1) ? 1 : c

    # reveal belongs to the asking view: never app state
    func commit_tab_rows [ w: f32, reveal: bool ] -> i32
        if [ !git_snap || !git_snap.files || git_snap.files.count == 0 ]
            return 0
        c : i32 [ commit_cap[ w ] ]
        r : i32 [ (git_snap.files.count + c - 1) / c ]
        if [ !reveal && r > 3 ] r = 3
        return r

    # stage everything, commit and push; the message comes from the
    # view. push = false (shift) keeps it local
    func do_commit [ cmsg: string, push: bool ]
        r9 : path repo_root[]
        if [ !r9 || !cmsg || cmsg.count == 0 ] return
        # the message rides a shell line: escape for double quotes
        esc : string ''
        for [ i: i32 0, i < cmsg.count, i += 1 ]
            c9 : i32 [ cmsg.chars[ i ] ]
            if [ c9 == 34 || c9 == 92 || c9 == 36 || c9 == 96 ]
                esc = esc + '\\'
            esc = esc + cmsg.mid[ i, 1 ]
        git_capture[ r9, 'add -A', false ]
        git_capture[ r9, 'commit -m "{esc}"', false ]
        if [ push ] git_capture[ r9, 'push', false ]
        git_summarize[]
        if [ ux ] ux.restyle = true

    # the files that differ from a reference in the browsed repo, paths
