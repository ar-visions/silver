# the editor under a pane's split. 'text' is the editor/instruments
# split, and the editor keeps key 'text' inside it
func editor_under [ spl: element ] -> Editor
    if [ !spl || !spl.elements ] return null
    te : element spl.elements[ 'text' ]
    if [ !te ] return null
    if [ te inherits Editor ] return Editor te
    if [ !te.elements ] return null
    ve : element te.elements[ 'text' ]
    if [ !ve || !(ve inherits Editor) ] return null
    return Editor ve

# This is the EditorView
element EditorView
    public selected   : bool
    public pane_index : i32
    public is_console : bool

    style : CSS {
        area: l0 t0 r0 b0
        layers.bg:
            fill_color: #140a2acc
        :is_console
            layers.bg:
                fill_color: #140a2a80
    }

    func text_of [] -> Editor
        if [ !elements ] return null
        return editor_under[ elements[ 'split' ] ]

    # file-create mode: state and behavior live on THIS view alone
    mutable newfile      : bool
    mutable newfile_text : string
    mutable newfile_src  : path
    # the typed name creates a folder instead of a file
    mutable newfile_dir  : bool

    func newfile_enter [ p: path ]
        newfile      = true
        newfile_text = ''
        newfile_src  = p
        newfile_dir  = false

    func newdir_enter [ p: path ]
        newfile_enter[ p ]
        newfile_dir  = true

    func newfile_exit []
        newfile      = false
        newfile_text = ''

    func newfile_exists [] -> bool
        orb : cast orbiter [ ux.app_object ]
        if [ !orb || !orb.nav_root ] return false
        if [ !newfile_text || newfile_text.count == 0 ] return false
        p9 : path '{orb.nav_root}/{newfile_text}'
        return p9.exists[]

    func newfile_commit []
        orb : cast orbiter [ ux.app_object ]
        if [ !orb || !newfile_text || newfile_text.count == 0 ] return
        if [ newfile_exists[] ] return    # red name: no action
        p9 : path '{orb.nav_root}/{newfile_text}'
        if [ newfile_dir ]
            p9.make_dir[]
            newfile_exit[]
            orb.nav_root = p9
            orb.run_search[]
            return
        e9 : string ''
        p9.save[ e9, null ]
        newfile_exit[]
        orb.exit_finder[]
        orb.open_file[ p9 ]


    func orb [] -> orbiter
        return cast orbiter [ ux.app_object ]

    # the console session this pane holds; '' when it holds a file
    func psess [] -> string
        o : orb[]
        if [ !o ] return ''
        if [ o.agent_open && pane_index == o.editor_slots.count ] return o.orbit_sid
        return (pane_index < o.pane_console.count) ? o.pane_console[pane_index] : ''

    func file [] -> path
        o : orb[]
        if [ !o ] return null
        s : i32 [ (pane_index < o.editor_slots.count) ? o.editor_slots[pane_index] : -1 ]
        return (s >= 0 && s < o.open_files.count) ? o.open_files[s] : null

    func rview [] -> AppView
        e : Editor text_of[]
        return (e) ? e.run_view : null

    func app_running [] -> bool
        r : rview[]
        return (r && !r.ended) ? true : false

    func app_pip [] -> bool
        e : Editor text_of[]
        return (app_running[] && !e.app_view) ? true : false

    func searchable [] -> bool
        o : orb[]
        return (o) ? (o.search_pane[] == id) : false

    func findbar_on [] -> bool
        o : orb[]
        return (o) ? (o.findbar_open && o.findbar_pane == id) : false

    func menu_open [] -> bool
        o : orb[]
        if [ !o || !searchable[] ] return false
        return o.find_showing || o.nav_showing

    # .ag files and anything with a registered handler keep the run band
    func run_ok [] -> bool
        if [ psess[].count > 0 ] return false
        if [ app_running[] ] return true
        p : file[]
        if [ !p ] return false
        f : p.filename[]
        if [ f.count >= 3 && f.mid[ f.count - 3, 3 ].compare[ '.ag' ] == 0 ] return true
        e : Editor text_of[]
        return (e && e.handler_module_for[ p ]) ? true : false

    # a running app owns the band label; source navigation must not re-bind it
    func band_mod [] -> string
        r : rview[]
        if [ r && r.app_mod ] return r.app_mod
        p : file[]
        if [ !p ] return 'app'
        m : p.filename[]
        d : i32 [ m.index_of[ '.' ] ]
        return (d > 0) ? m.mid[ 0, d ] : m

    # args belong to the DOC a handler opened, not the handler's own source
    func args_src [] -> path
        r : rview[]
        if [ r && r.doc ] return r.doc
        e : Editor text_of[]
        return (e) ? e.band_src[] : file[]

    func title_text [] -> string
        if [ findbar_on[] ] return ''
        s : psess[]
        if [ s.count > 0 ]
            h : i32 [ s.index_of[ '#' ] ]
            return (h > 0) ? s.mid[ 0, h ] : s
        p : file[]
        return (p) ? p.filename[] : 'Open'

    func title_hint [] -> string
        e : Editor text_of[]
        if [ !e || !e.view_name || e.view_name.count == 0 ] return ''
        return (e.view_name != 'text') ? e.view_name : ''

    func title_els [] -> Elements
        o : orb[]
        w : Window ux
        e : Editor text_of[]
        tfoc : bool [ (w && w.focus && w.focus.id == 'title' && w.focus.parent == a) ? true : false ]
        # the editor is never locked while debugging; the run band steps
        t : Elements o.title_nav[ file[], null, false, w, false, e->dbg_open, menu_open[],
            (e && e.rview) ? true : false, e->rview, findbar_on[], tfoc, pane_index ]
        if [ psess[].count > 0 ]
            t['ctx_copy'] = LabelButton [ label: 'context', manual_mode: true ]
            t['ctx_shot'] = LabelButton [ label: 'screen',  manual_mode: true ]
        # inserted last so right-flow puts it left of the title's controls
        if [ e && e.run_view && !e.run_view.ended ]
            t['gotosrc'] = BandSource [ label: 'active', manual_mode: true ]
        if [ newfile ]
            # create mode has its own cancel: never two close buttons
            t.rm[ 'histnav' ]
            t['newfile_cancel'] = LButton [ icon: 'close', manual_mode: true ]
        return t

    func text_els [] -> Elements
        o : orb[]
        e : Editor text_of[]
        t : Elements [ ]
        s : psess[]
        if [ s.count > 0 ]
            t['text'] = Console [ session_id: s, sessions: o.ed_sessions, feed: null,
                launch: o.agent_cmd[ s ], animated: true ]
        el
            edels : Elements []
            # a composed view fills the editor; its lines stay empty
            if [ e && e.rview ]
                vel : element e.rview.view_element*[]
                if [ vel ] edels['view'] = vel
            dbgr : dbg o.active_debugger[]
            t['text'] = Editor [
                src: file[]
                hide: browse_active[]
                breakpoints: o.breakpoints, code_font_size: o.code_font_size,
                nav: o.nav_panes[ pane_index ], pane_index: pane_index,
                debug_running: (dbgr) ? true : false, debugger: dbgr, debug_vars: o.debug_vars,
                expanded: findbar_on[], replacing: findbar_on[],
                show_hits: false,
                single_line: false,
                header_size: o.browse_header_size, dir_size: o.browse_dir_size,
                nav_list: false, dock_rows: o.nav_dock_rows,
                grid_mode: false,
                hits: o.find_hits,
                find_query: (searchable[] && findbar_on[]) ? o.findbar_text : '',
                elements: edels ]
        # NOT keyed 'instruments' — that is the TButton's id, and on_press
        # dispatches on id, so the column would close on every click
        if [ o.show_instr_col ] t['instr_col'] = InstrumentColumn [ ]
        return t

    # the error chip belongs to the file it names: only show it
    # while that file is the one in view
    func err_showing [] -> bool
        o : orb[]
        if [ !o.err_file || o.err_line <= 0 ] return false
        e : Editor text_of[]
        if [ !e || !e.src ] return false
        es : string e.src.absolute[]
        ef : string o.err_file.absolute[]
        return es.compare[ ef ] == 0

    # ONE middle slot: the error of the app WE ARE RUNNING, or what it is
    # doing while we wait. an error wins the slot
    func band_status [] -> string
        o : orb[]
        if [ err_showing[] ]
            return (o.err_msg && o.err_msg.count > 0)
                ? '{o.err_line}: {o.err_msg}'
                : '{o.err_file.filename[]}:{o.err_line}'
        r : rview[]
        if [ !r ] return ''
        s : r.status_text[]
        return (s) ? s : ''

    # ONE button for the whole instruments column. the stack inside it
    # picks which instrument, never this bar
    func instr_buttons [] -> TButtons
        o : orb[]
        r : rview[]
        ibtn : vec string [] [ 'callstack' ]
        iico : vec string [] [ 'callstack' ]
        smask : i32 [ 0 ]
        if [ o.show_instruments ] smask = smask | 1
        if [ r && r.instr_names && r.instr_names.count > 0 ]
            if [ o.show_instr_col ] smask = smask | (1 << ibtn.count)
            ibtn.push[ 'instruments' ]
            iico.push[ 'chart' ]
        if [ app_running[] ]
            if [ app_pip[] ] smask = smask | (1 << ibtn.count)
            ibtn.push[ 'pip' ]
            iico.push[ 'pip' ]
        iw : f32 [ 1.2 * f32[ ibtn.count ] ]
        return TButtons [ buttons: ibtn, icon_ids: iico,
            manual: true, sel_mask: smask,
            rest_glow: rgba [ '#ccf2' ], rest_px: 16.0,
            area: Region [ 'r0+ t0 w{iw} h0.9' ] ]

    func tool_els [] -> Elements
        o : orb[]
        e : Editor text_of[]
        t : Elements []
        if [ !app_running[] ]
            t['run'] = RunButton [ icon: 'play', manual_mode: true ]
        el
            # STOP takes play's own slot, so turning the app off never
            # moves the mouse. pause is its own button, to the right
            t['stop']  = RunButton [ icon: 'stop', manual_mode: true ]
            t['pause'] = RunButton [ icon: (e.run_view.is_paused*[]) ? 'play' : 'pause',
                selected: e.run_view.is_paused*[], manual_mode: true ]
            t['steps'] = StepButtons [ buttons: [ 'step_next', 'step_in', 'step_out' ], manual: true ]
        # caret at the end: a fresh instance would otherwise insert at 0
        a9 : string o.file_args[ args_src[] ]
        t['args'] = ArgsField [ label: 'arguments',
            edit: a9, sel_col: a9.count, anchor_col: a9.count, focusable: true ]
        if [ band_status[].count > 0 ]
            t['our_app_error'] = AppError [ label: band_status[], manual_mode: true,
                info: !err_showing[] ]
        t['instruments'] = instr_buttons[]
        # no value: prop on the slider — it is re-applied every rebuild
        # and would stamp over the drag. mute follows it in the flow
        if [ app_running[] ]
            t['volume'] = VolumeSlider [ area: Region { r0+ t0.15 w4 h0.6 } ]
            t['mute']   = SoundButton [ icon: (o.app_muted) ? 'mute' : 'volume', icon_scale: 2.4,
                area: Region { r0+ t0 w1.4 h0.9 }, manual_mode: true ]
        return t

    func band_els [] -> Elements
        o : orb[]
        e : Editor text_of[]
        t : Elements []
        t['tools'] = ToolsHeader [ spacing_x: 0.2, spacing_y: 0.2, topmost: true,
            elements: tool_els[] ]
        cf : Elements []
        cf['console_filter'] = element [ area: Region { r8px t4px w6 h32px },
            label: band_mod[], focusable: true, no_scroll: true ]
        inner : Elements [ ]
        inner['console'] = RunConsole [ session_id: 'ed:{band_mod[]}',
            sessions: o.ed_sessions, feed: null,
            run_line: (e && e.run_view) ? e.run_view.cmd : null,
            animated: true, elements: cf ]
        # the callstack is orbiter's own, and the ONLY thing that joins the
        # console here. instruments live in their column
        if [ o.show_instruments ] inner['callstack'] = Callstack [ frames: o.debug_frames[] ]
        # console alone fills; console + callstack is an even split
        t['split'] = Splitter [ area: Region { l0 t1.3 r0 b0 }, inner: inner, deflt: 0.0 ]
        return t

    func pane_els [] -> Elements
        t : Elements [ ]
        # the editor and the instruments column are the two sides of ONE
        # split. it is mounted ALWAYS, even with the column hidden — a
        # wrapper that comes and goes re-parents the editor, and a new
        # editor loses run_view and unmounts the whole band
        # 100px floor, and 0 snaps it off the way any other pane does
        t['text'] = Splitter [ area: Region { l0 t0 r0 b0 },
            inner: text_els[], deflt: 150.0, min_size: 100.0, snap_close: true ]
        # the run band + console, INSIDE this tab. pip keeps the band: the
        # app shrinks into the editor and its instruments stay open
        if [ run_ok[] ] t['band'] = RunBand [ elements: band_els[] ]
        return t

    # reconciliation runs on the frame hook, never in render
    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        settle[]

    func settle []
        o : orb[]
        is_con : bool [ psess[].count > 0 ]
        if [ is_console != is_con ]
            is_console = is_con
            pristine   = false
        if [ o.find_showing ]
            puts 'FIND show: pane={id} searchable={(searchable[]) ? 1 : 0} sp={o.search_pane[]} hits={o.find_hits->count}'
        e : Editor text_of[]
        if [ e && e.rview ]
            cfeed : e.rview.context_feed*[]
            if [ cfeed ] o.feed_agent[ cfeed ]
        # create mode self-heals when the pane's file changes under it
        p : file[]
        if [ newfile && newfile_src && p && '{newfile_src}' != '{p}' ] newfile_exit[]
        # the nav surface must track the split's text region; when the
        # splitter moves it out from under us, a restyle re-fits it
        cbv : element (elements) ? elements['commit'] : null
        spl : element (elements) ? elements['split'] : null
        if [ cbv && spl && spl.elements && spl.bounds ]
            tx9 : element spl.elements['text']
            if [ tx9 && tx9.bounds && cbv.bounds ]
                same : bool [ cbv.bounds.x == spl.bounds.x + tx9.bounds.x && cbv.bounds.y == spl.bounds.y + tx9.bounds.y && cbv.bounds.w == tx9.bounds.w && cbv.bounds.h == tx9.bounds.h ]
                if [ !same ]
                    if [ ux ] ux.restyle = true

    # the nav/commit surface replaces the editor for browse AND find
    func browse_active [] -> bool
        o : orb[]
        if [ !o || !searchable[] ] return false
        return o.nav_showing || o.find_showing

    public func render [] -> Elements
        if [ !orb[] ] return null
        t : Elements [ ]
        t['title'] = EditorTitle [
            area: Region { l0 t0 r0 h1.3 }
            selected: !file[]
            focusable: true
            spacing_x: 0.2
            spacing_y: 0.2
            edit: (newfile) ? newfile_text : orb[].find_text
            label: (newfile) ? ((newfile_dir) ? 'name new folder' : 'name new file') : title_text[]
            conflict: newfile && newfile_exists[]
            no_scroll: true
            hint: title_hint[]
            elements: title_els[] ]
        t['split'] = Splitter [ area: Region { l0 t1.3 r0 b0 }, vertical: true,
            inner: pane_els[], deflt: 180.0,
            min_size: 44.0 ]
        if [ browse_active[] ]
            # the surface is a peer of the editor pane: it takes the
            # split's live text region, never the whole view
            spl9 : element (elements) ? elements['split'] : null
            tx8  : element (spl9 && spl9.elements) ? spl9.elements['text'] : null
            if [ tx8 && tx8.bounds && spl9.bounds && tx8.bounds.h > 0.0 ]
                # bounds are parent-relative: compose split + pane
                cx8 : f32 [ spl9.bounds.x + tx8.bounds.x ]
                cy8 : f32 [ spl9.bounds.y + tx8.bounds.y ]
                cw8 : f32 [ tx8.bounds.w ]
                ch8 : f32 [ tx8.bounds.h ]
                t['commit'] = CommitView [ focusable: true, scroll_fade: 24.0,
                    area: Region [ 'l{cx8}px t{cy8}px w{cw8}px h{ch8}px' ] ]
            el
                t['commit'] = CommitView [ focusable: true, scroll_fade: 24.0, area: Region { l0 t1.3 r0 b0 } ]
        return t

element EditorTitle
    public selected : bool
    # newfile mode: typed name collides with an existing file
    public conflict : bool
    # painted after the name, never part of the editable label
    public hint     : string
    mutable ficons  : FileIcons
    style : CSS {
        area: l0 t0 r0 h1.3
        layers.tbar:
            fill_color: #2480
            inner_glow: #8af2 26
            stroke_width: 0.5
            stroke_color: #fff2
        layers.tface:
            label_color: #fff
            label_size: 19
            editable: true
            label_align: 0.0 0.5
            label_offset: 98.0 0.0
        :conflict
            layers.tface:
                label_color: #e05e5e
        layers.tdiv:
            fill_color: #fff2
            area: l0 b0 r0 h1px
    }

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        if [ !label || label.count == 0 ] return
        if [ !ficons ] ficons = FileIcons []
        cv  : Canvas [ w.screen ]
        mdl : SVGModel ficons.icon[ label, 20 ]
        if [ mdl ]
            isz : f32 [ 20.0 ]
            cv.fill_color[ '#ffffff' ]
            cv.stroke_color[ '#ffffff' ]
            cv.draw_svg[ mdl, 70.0, (bounds.h - isz) * 0.5, isz, isz ]
        # the view we are in, trailing the name. painted, so the label
        # stays the editable field and this can never be selected
        if [ hint && hint.count > 0 ]
            cv.font_size[ 19 ]
            m9 : cv.measure_text[ label ]
            cv.font_size[ 13 ]
            cv.fill_color[ '#ffffff66' ]
            cv.stroke_width[ 0.0 ]
            cv.draw_text[ hint,
                rect [ x: 98.0 + m9.w + 16.0, y: 0.0, w: bounds.w, h: bounds.h ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
            cv.paint[]


Option NavButton
    style : CSS {
        layers.body:
            fill_color: #614
            radius: 8
            inner_glow: #ccf2 16
        :hovered
            layers.body:
                fill_color: #826
                inner_glow: #fcc6 20
        :pressed
            layers.body:
                fill_color: #438
                inner_glow: #ccf8 22
        :selected
            layers.body:
                fill_color: #c8641e
                inner_glow: #ffae5ea2 18
    }

Avatar OrbiterAvatar
    render_scale : f32 [ 4.0 ]

    style : CSS {
        area: r-14 b22 w12 h19, 700ms cubic outward
        opacity: 0.0, 700ms cubic outward
    :summoned
        area: r-1 b22 w12 h19, 700ms cubic inward
        opacity: 1.0, 700ms cubic inward
    }


    public src_file : path
    eye_pos     : vec3f [ 0.0, 4.2, 0.0 ]
    target_pos  : vec3f [ 0.0, -0.3, 0.0 ]
    up_vec      : vec3f [ 0.0, 0.0, -1.0 ]
    fov         : f32   [ 24.0 ]
    env_yaw     : f32   [ 0 ]
    env_pitch   : f32   [ 0 ]
    blend_rings : f32   [ 0.2 ]
    blend_haze  : f32   [ 1.0 ]
    blend_bands : f32   [ 0.2 ]
    rest_tilt   : f32   [ 0.0 ]
    # filter_n approach per frame; the tilt eases in slowly
    ease_amount : f32   [ 0.14 ]
    busy_amount : f32   [ 0.10 ]
    # tilt away while the agent is working
    busy_tilt   : f32   [ 34.0 ]
    # the halo glow hover used to show — it answers to busy now
    rest_pulse  : f32   [ 0.4 ]
    busy_pulse  : f32   [ 2.0 ]
    rest_ph     : f32   [ 1.2 ]
    busy_ph     : f32   [ 2.4 ]
    rest_halo   : f32   [ 0.4 ]
    busy_halo   : f32   [ 0.8 ]
    rest_spin   : f32   [ 0.25 ]
    busy_spin   : f32   [ 2.66 ]
    # how fast the RATE itself approaches; low = a long spin-up
    spin_amount : f32   [ 0.04 ]
    mutable spin_rate  : f32 [ 0.25 ]
    mutable spin_phase : f32
    intern  spin_dbg   : bool
    # the wheel's in-plane clocking, held in every state
    clock_deg   : f32   [ 30.0 ]
    mutable tilt_cur : f32
    intern  st_logged : bool
    # how fast the rim crosses between dark and blue
    listen_amount : f32 [ 0.20 ]
    mutable listen_cur : f32
    # summon slide: 0 = below the corner, 1 = at rest
    summon_amount : f32 [ 0.14 ]
    mutable summon_t : f32

    # clicking the avatar dismisses it — same as the toggle off
    func on_click [ ev: Event ]
        if [ drag_moved ] return
        orb : orbiter [ ux.app_object ]
        if [ orb ]
            #orb.show_orbiter = false
            if [ orb.listening[] ] orb.toggle_listen[ null ]
        ev.no_propagation = true

    # called each frame with the live State bitmask
    func on_state [ m: i32 ]
        orb  : orbiter [ ux.app_object ]
        if [ !st_logged ]
            st_logged = true
            puts 'ONSTATE reached m={m} orb={bool[orb]} busy={orb->busy}'
        want : f32 [ rest_tilt ]
        amt  : f32 [ ease_amount ]
        if [ orb->busy ]
            want = busy_tilt
            amt  = busy_amount
        tilt_cur = filter_n[ tilt_cur, want, amt, ux->frame_factor ]
        lv : bool [ false ]
        if [ orb ] lv = orb.listening[]
        lw : f32 [ (lv) ? 1.0 : 0.0 ]
        listen_cur = filter_n[ listen_cur, lw, listen_amount, ux->frame_factor ]
        if [ body ] body.listen = listen_cur
        # the rim halo swells on the same clock as the tilt
        if [ aura ]
            gp : f32 [ (orb->busy) ? busy_pulse : rest_pulse ]
            gv : f32 [ (orb->busy) ? busy_ph    : rest_ph ]
            gh : f32 [ (orb->busy) ? busy_halo  : rest_halo ]
            aura.pulse_width  = filter_n[ aura.pulse_width,  gp, amt, ux->frame_factor ]
            aura.pulse_height = filter_n[ aura.pulse_height, gv, amt, ux->frame_factor ]
            aura.halo_height  = filter_n[ aura.halo_height,  gh, amt, ux->frame_factor ]
            gs : f32 [ (orb->busy) ? busy_spin : rest_spin ]
            spin_rate  = filter_n[ spin_rate, gs, spin_amount, ux->frame_factor ]
            spin_phase = spin_phase + spin_rate * (ux->frame_factor / 60.0)
            if [ spin_phase > 6.2831853 ] spin_phase = spin_phase - 6.2831853
            aura.spin  = spin_phase
            if [ orb->busy != spin_dbg ]
                spin_dbg = orb->busy
                puts 'SPIN busy={orb->busy} rate={spin_rate} goal={gs} ff={ux->frame_factor}'
        if [ !rotate ]
            rotate = vec Rotation []
            rotate.push[ Rotation [ '0 1 0 30deg' ] ]
            rotate.push[ Rotation [ '1 0 0 0deg' ] ]
        rotate[0] = Rotation [ '0 1 0 {clock_deg}deg' ]
        rotate[1] = Rotation [ '1 0 0 {tilt_cur}deg' ]
        pristine = false

    body : PBR [
        model_id: 'orbiter32',
        groups: ['outside','flower','separator'],
        env_id: 'forest', pulse_width: 4.0, gamma: 1.88 ]

    core : Core [
        model_id: 'orbiter32',
        groups: ['core'],
        texture: 'textures/core.png', mip_levels: 8, pulse_width: 4.0 ]

    plasma : Plasma  [
        model_id: 'orbiter32',
        groups: ['top_ring','flower'],
        pulse_width: 1.0 ]

    aura : Aura [
        model_id: 'uv-quad2',
        pulse_width: 0.4, pulse_height: 1.2, halo_height: 0.4,
        beam_fade: 2.2, beam_cone: 0.35, flame: 0.0 ]



