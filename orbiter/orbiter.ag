        if [ !p ] return
        ps9 : string '{p}'
        if [ !pins ] pins = vec string []
        for [ i: i32 0, i < pins.count, i += 1 ]
            if [ pins[i].compare[ ps9 ] == 0 ]
                pins.remove[ i ]
                save_session[]
                run_search[]
