# the dock's pins: they scroll by the wheel alone (no thumb)
element DockPins
    scrollbar : ScrollLayer [ overlay: true, thumb_w: 0.0,
                              thumb_color: '#0000' ]
    # the pins' height (content_h is the element's own, kept by it)
    public rows_h : f32
    mutable shown_y : f32
    public func tick [ w: Window ]
        content_h = rows_h
        # the rows follow the scroll as it eases: the dock forms again
        if [ scroll.y != shown_y ]
            shown_y = scroll.y
            w.restyle = true
            w.will_animate = true
    public func on_wheel [ ev: Event ]
        content_h = rows_h
        super.on_wheel[ ev ]

# the dark line under the dock's arrows
element DockLine
    style : CSS {
        layers.line:
            fill_color: #0000
    }

# a module's icon: icon.png, its export's icon, else a cube
# a card in the apps view: one of our app modules, or a featured one
# (featured/<name>/<name>.ag)
class AppEntry
    public name    : string
    # its module's folder
    public file    : path
    public module  : bool
    public agi     : path
    # its section: a SoftwareGroup's name
    public group   : string
    # a module that builds a program: the program it installs
    public built   : path

class AppIcon
    public  file   : path
    public  module : bool
    # a program's own icon file (its .desktop's), drawn instead
    public  icon_file : path
    # the module's export, where its icon name is
    public  agi    : path
    mutable tex    : Texture
    mutable svg    : SVGModel
    mutable loaded : bool
    # the png, colour scaled by alpha; tex is it shrunk to tex_side px
    mutable src    : Image
    mutable tex_side : i32

    # each drawn pixel the mean of the source pixels it covers
    func shrink [ ps: i32 ] -> Image
        sw : i32 [ src.width ]
        sh : i32 [ src.height ]
        # the picture's shape kept inside the ps square
        dw : i32 [ (sw >= sh) ? ps : max[ 1, ps * sw / sh ] ]
        dh : i32 [ (sh >= sw) ? ps : max[ 1, ps * sh / sw ] ]
        out : Image [ width: dw, height: dh, format: Pixel.rgba8,
                      channels: 4 ]
        sp9 : @u8 src.vdata[]
        dp9 : @u8 out.vdata[]
        fx : f32 [ f32[ sw ] / f32[ dw ] ]
        fy : f32 [ f32[ sh ] / f32[ dh ] ]
        for [ dy: i32 0, dy < dh, dy += 1 ]
            y0 : f32 [ f32[ dy ] * fy ]
            y1 : f32 [ y0 + fy ]
            for [ dx: i32 0, dx < dw, dx += 1 ]
                x0 : f32 [ f32[ dx ] * fx ]
                x1 : f32 [ x0 + fx ]
                acc : local f32 [ 4 ] [ 0.0, 0.0, 0.0, 0.0 ]
                wt  : f32 [ 0.0 ]
                for [ sy: i32 i32[ y0 ], f32[ sy ] < y1 && sy < sh, sy += 1 ]
                    wy : f32 [
                        min[ f32[ sy + 1 ], y1 ]
                        - max[ f32[ sy ], y0 ] ]
                    for [ sx: i32 i32[ x0 ], f32[ sx ] < x1 && sx < sw, sx += 1 ]
                        w9 : f32 [
                            wy
                            * (min[ f32[ sx + 1 ], x1 ] - max[ f32[ sx ], x0 ]) ]
                        o9 : i64 [
                            (i64[ sy ] * i64[ sw ] + i64[ sx ]) * 4 ]
                        for [ c: i32 0, c < 4, c += 1 ]
                            acc[ c ] += f32[ sp9[ o9 + c ] ] * w9
                        wt += w9
                d9 : i64 [ (i64[ dy ] * i64[ dw ] + i64[ dx ]) * 4 ]
                for [ c: i32 0, c < 4, c += 1 ]
                    dp9[ d9 + c ] = u8[
                        min[ acc[ c ] / wt + 0.5, 255.0 ] ]
        return out

    # the name on the export's icon line: icon: ['tune']
    func export_icon [] -> string
        if [ !agi || !agi.exists[] ] return null
        tx : string agi.load[ typeid[string], null ]
        if [ !tx ] return null
        ix : tx.index_of[ 'icon: [' ]
        if [ ix < 0 ] return null
        i  : i32 [ ix ]
        n  : i32 [ tx.count ]
        q0 : i32 [ 0 - 1 ]
        while [ i < n ]
            c : i32 [ (i32 tx.chars[i]) & 255 ]
            if [ c == 10 ] break
            i += 1
            if [ c != 39 ] continue
            if [ q0 < 0 ]
                q0 = i
                continue
            return tx.mid[ q0, i - 1 - q0 ]
        return null

    func paint [ cv: Canvas, x: f32, y: f32, side: f32 ]
        if [ !loaded ]
            loaded = true
            png : path '{file}/images/icon.png'
            if [ icon_file && icon_file.ext[] == 'svg' ]
                svg = SVGModel [ icon_file ]
                png = path '/nonexistent'
            el [ icon_file ]
                png = icon_file
            if [ png.exists[] ]
                im : Image [ '{png}' ]
                # the canvas adds colour unscaled: scale it by alpha
                if [
                    im.width > 0 && im.height > 0
                    && im.format == Pixel.rgba8 ]
                    px9 : @u8 im.vdata[]
                    n9  : i64 [ i64[ im.width ] * i64[ im.height ] * 4 ]
                    for [ k: i64 0, k < n9, k += 4 ]
                        al : u32 [ px9[ k + 3 ] ]
                        px9[ k ]     = u8[
                            (u32[ px9[ k ] ] * al + 127) / 255 ]
                        px9[ k + 1 ] = u8[
                            (u32[ px9[ k + 1 ] ] * al + 127) / 255 ]
                        px9[ k + 2 ] = u8[
                            (u32[ px9[ k + 2 ] ] * al + 127) / 255 ]
                    src = im
            nm : string export_icon[]
            if [ !src && nm ]
                mp : path 'images/material/{nm}.svg'
                if [ !mp.exists[] ] mp = path 'images/{nm}.svg'
                if [ mp.exists[] ] svg = SVGModel [ mp ]
            if [ !src && !svg ]
                sp : path (module) ? path 'images/material/3d.svg'
                    : path 'images/material/folder.svg'
                if [ sp.exists[] ] svg = SVGModel [ sp ]
            # a file: its type's icon, as the nav list draws it
            if [ !src && !svg && !module && !file.is_dir[] ]
                fi : FileIcons []
                svg = fi.icon[ file.filename[], 64 ]
        # drawn one texel a pixel: made at the size it is drawn
        ps9 : i32 [ round[ side ] ]
        if [ src && ps9 > 0 && (!tex || tex_side != ps9) ]
            sm : Image shrink[ ps9 ]
            tex = Texture [ vk: cv.vk, w: cv.w, sampler: sm,
                width: sm.width, height: sm.height, linear: true ]
            tex_side = ps9
        if [ tex ]
            tw : f32 [ tex.width ]
            th : f32 [ tex.height ]
            cv.draw_image[ tex,
                           rect [ x: round[ x + (side - tw) * 0.5 ],
                y: round[ y + (side - th) * 0.5 ], w: tw, h: th ] ]
        el [ svg ]
            cv.fill_color[ rgba [ '#fff' ] ]
            cv.draw_svg[ svg, x, y, side, side ]

# a pin in the dock: its app icon, else the nav list's icon
element DockIcon
    no_cache : true
    public  file   : path
    public  module : bool
    # a program's own icon file, instead of its module's
    public  icon_file : path
    # its running instances: a dot each under the icon
    public  count  : i32
    # a program on PATH: a click runs it, or shows it
    public  program : bool
    # the name under the icon ('' its file's)
    public  name    : string
    # the icon alone, centred: no name, no dots (a title's)
    public  plain   : bool
    # the module's export, where its icon name is
    public  agi    : path
    # remade when a reused pin points at another folder
    mutable icon   : AppIcon
    # its place in the column: neighbours share one border
    public  first  : bool
    public  last   : bool
    style : CSS {
        # the next icon's top is the line between two; the arrows'
        # light line is the first one's top
        layers.edge:
            fill_color: #0000
            box_shadow: inset 0 0 13px #c890ff04
            stroke_width: 1 1 0 1
            stroke_color: #ffffff09
            near_border: true
            near_reach: 0.5
            near_inset: 4.0
            near_inset_color: #c890ffff
        layers.lite:
            fill_color: #0000
            area: l0 b2px r0 h1px
        layers.foot:
            fill_color: #0000
            area: l0 b1px r0 h1px
        :first
            layers.edge:
                stroke_width: 0 1 0 1
        :last
            layers.edge:
                stroke_width: 1 1 1 1
            layers.lite:
                fill_color: #fff2
        :selected
            layers.edge:
                # the dock's old base, flipped with the purple
                fill_color: #625a
                stroke_color: #fff3
                # its own inner glow, lit or not
                box_shadow: inset 0 0 13px #c890ff88
    }
    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        if [ !bounds || !file ] return
        cv : Canvas w.screen
        if [ !icon || '{icon.file}' != '{file}'
             || '{icon.icon_file}' != '{icon_file}' ]
            icon = AppIcon [ file: file, module: module, agi: agi,
                icon_file: icon_file ]
        if [ plain ]
            psz : f32 [ round[ min[ bounds.w, bounds.h ] * 0.55 ] ]
            icon.paint[ cv, round[ (bounds.w - psz) * 0.5 ],
                        round[ (bounds.h - psz) * 0.5 ], psz ]
            return
        # the icon high, its name under it, the dots at its left
        isz : f32 [ round[ bounds.w * 0.5 ] ]
        ix  : f32 [ round[ (bounds.w - isz) * 0.5 ] ]
        iy  : f32 [ round[ bounds.h * 0.13 ] ]
        icon.paint[ cv, ix, iy, isz ]
        nm : string (name && name.count > 0) ? name : file.filename[]
        # 14 px at rest, with the font scale
        un : f32 ux_unit[ w ]
        fpx : i32 [ i32[ round[ 14.0 * un ] ] ]
        cv.set_font[ shared_font[ cv,
            'fonts/BarlowCondensed-Regular.ttf', fpx ] ]
        cv.font_size[ fpx ]
        cv.fill_color[ rgba [ '#ffffffcc' ] ]
        cv.draw_text[ nm, rect [ x: 4.0, y: iy + isz + 1.0,
                                 w: bounds.w - 8.0, h: 16.0 * un ],
            vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.ellipsis,
            null ]
        cv.paint[]
        cv.set_font[ null ]
        if [ count > 0 ]
            # the dots' group, a column left of the icon: 2px round
            # them, a near-lit border
            gh : f32 [ f32[ count * 8 - 4 ] + 4.0 ]
            gx9 : f32 [ round[ ix * 0.5 ] - 4.0 ]
            # centred on the whole button's height
            gy : f32 [ round[ (bounds.h - gh) * 0.5 ] ]
            cv.save[ ]
            w.near_light_on[ cv, a, 0.0, 0.0 ]
            cv.fill_color[ rgba [ '#00000066' ] ]
            cv.stroke_color[ rgba [ '#fff3' ] ]
            cv.stroke_width[ 1.0 ]
            cv.stroke_offset[ 0.5 ]
            cv.rounded_rect[ gx9, gy, 8.0, gh, 4.0, 4.0, 4.0, 4.0 ]
            cv.paint[ ]
            cv.restore[ ]
            cv.fill_color[ rgba [ '#ffffffcc' ] ]
            for [ d9: i32 0, d9 < count, d9 += 1 ]
                cv.arc[ gx9 + 4.0, gy + 4.0 + f32[ d9 * 8 ], 2.0, 0.0,
                        6.2832 ]
                cv.paint[ ]

# a running instance in the bottom bar: its icon, its name and a
# light (amber starting or paused, red failed); lit while shown
element TaskChip
    no_cache : true
    public inst  : i32
    public file  : path
    public agi   : path
    public icon_file : path
    public label : string
    # 0 up, 1 busy (starting, compiling, paused), 2 failed, 3 an
    # agent waiting for the user
    public light : i32
    # stopped (a debugger stop or a pause): its icon is the pause mark
    public paused : bool
    # a window of an app whose icon leads its group: its title alone
    public no_icon : bool
    # its close shows: ctrl/cmd held (every button), or shift over it
    public close_all   : bool
    public close_hover : bool
    mutable close_svg  : SVGModel
    mutable icon : AppIcon
    mutable pause_svg : SVGModel
    # the bar's lettering, as the menus'
    mutable font9 : CanvasFont
    style : CSS {
        layers.edge:
            fill_color: #0000
            stroke_width: 0 1 0 0
            stroke_color: #ffffff09
            # the power button's: a faint glow the pointer brings up
            box_shadow: inset 0 0 13px #8af2
            near_border: true
            near_reach: 0.5
            near_inset: 4.0
            near_inset_color: #c890ffff
        :selected
            layers.edge:
                fill_color: #625a
                box_shadow: inset 0 0 13px #c890ff88
                near_inset: 3.0
    }
    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        cv : Canvas w.screen
        if [ !icon || '{icon.file}' != '{file}'
             || '{icon.icon_file}' != '{icon_file}' ]
            icon = AppIcon [ file: file, module: true, agi: agi,
                icon_file: icon_file ]
        side : f32 [ round[ bounds.h * 0.6 ] ]
        pad  : f32 [ round[ (bounds.h - side) * 0.5 ] ]
        if [ paused ]
            if [ !pause_svg ] pause_svg = SVGModel [ 'images/pause.svg' ]
            ps : f32 [ round[ side * 0.7 ] ]
            po : f32 [ round[ pad + (side - ps) * 0.5 ] ]
            cv.draw_svg[ pause_svg, po, po, ps, ps ]
        el [ !no_icon ]
            icon.paint[ cv, pad, pad, side ]
        tx : f32 [ (no_icon && !paused) ? 12.0 : pad * 2.0 + side ]
        # 17 px at rest, with the font scale
        fpx : i32 [ i32[ round[ 17.0 * ux_unit[ w ] ] ] ]
        if [ !font9 || font9.size_px != fpx ]
            font9 = CanvasFont [ ft_lib: cv.ft_lib,
                uri: 'fonts/BarlowCondensed-Regular.ttf', size_px: fpx ]
        cv.set_font[ font9 ]
        cv.font_size[ fpx ]
        cv.fill_color[ rgba [ '#ffffffcc' ] ]
        cv.draw_text[ label,
            rect [ x: tx, y: 0.0, w: max[ bounds.w - tx - 14.0, 0.0 ],
                   h: bounds.h ],
            vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.ellipsis,
            null ]
        cv.set_font[ null ]
        # its state (starting or paused, failed, an agent waiting for
        # the user): a 3px bar at the foot
        if [ light > 0 ]
            cv.save[ ]
            lc : string [ (light == 2) ? '#ff5a6aff'
                : ((light == 3) ? '#806bffff' : '#ffb84aff') ]
            cv.fill_color[ rgba [ lc ] ]
            cv.stroke_width[ 0.0 ]
            cv.rect_to[ 0.0, bounds.h - 3.0, bounds.w, 3.0 ]
            cv.paint[ ]
            cv.restore[ ]
        # the close: our ringed x at the right end (close.svg)
        if [ close_shown[] ]
            xb : rect close_box[]
            if [ !close_svg ] close_svg = SVGModel [ 'images/close.svg' ]
            # white, never the state bar's colour
            cv.fill_color[ rgba [ '#ffffffcc' ] ]
            cv.draw_svg[ close_svg, xb.x, xb.y, xb.w, xb.h ]

    func close_shown [] -> bool
        return close_all || (close_hover && hovered)

    # the close's square at the right end, in the button
    func close_box [] -> rect
        sz : f32 [ round[ bounds.h * 0.4 ] ]
        return rect [ x: bounds.w - sz - 6.0,
                      y: round[ (bounds.h - sz) * 0.5 ], w: sz, h: sz ]

    # a point in the window over its close
    func on_close [ wx: f32, wy: f32 ] -> bool
        if [ !close_shown[] || !bounds ] return false
        xb : rect close_box[]
        lx : f32 [ wx - win_pos.x ]
        ly : f32 [ wy - win_pos.y ]
        return lx >= xb.x && lx < xb.x + xb.w && ly >= xb.y
            && ly < xb.y + xb.h

