            return
        if [ ev.target.id.starts_with[ 'ahome_h_' ] ]
            nm : string ev.target.id.mid[ 8, ev.target.id.count - 8 ]
            home_open = (home_open == nm) ? '' : nm
            if [ ux ] ux.restyle = true
            ev.no_default = true
            return
        if [ ev.target.id.starts_with[ 'ahome_add_' ] ]
            picks : vec string home_choices[]
