            if [ edg ]
                edg.git_on = !edg.git_on
                if [ edg.git_on ] set_pane_view[ edg, 'git' ]
                el [ edg.view_name == 'git' ] set_pane_view[ edg, '' ]
                edg.ghost_hunk = -1
                edg.pristine   = false
            if [ ev.target ] ev.target.ux.restyle = true
            return


        if [ ev.target.id == 'newfile_cancel' ]
            for [ e9: element* ev.target, e9, e9 = e9.parent ]
                if [ e9 inherits EditorView ]
                    ev9 : EditorView e9
                    ev9.newfile_exit[]
                    break
            ev.no_default = true
            if [ ev.target ] ev.target.ux.restyle = true
