        return repo_host

    func repo_cache_path [ user: string ] -> path
        sd : path path.path_storage[ 'orbiter' ]
        return path '{sd}/repos-{user}.txt'

    # a user's repositories: what memory has, else the hour-old disk
    # copy, else a fetch on its own pipe (the list fills in when it
    # lands; the header says loading, or that the host refused)
    func repo_list [ user: string ] -> vec RepoInfo
        if [ repo_items && repo_user && repo_user.compare[ user ] == 0 && (!repo_fetch_user || repo_fetch_user.compare[ user ] != 0) ]
            return repo_items
        if [ !repo_user || repo_user.compare[ user ] != 0 ]
            repo_user  = user
            repo_items = null
            repo_note  = ''
            # the cache serves while it is under an hour old; older, it
            # is not used (a fresh fetch runs), kept aside only for a
            # refused refresh
            cp : path repo_cache_path[ user ]
            at : local i64 [ 1 ] [ 0 ]
            pg : local i32 [ 1 ] [ 1 ]
            mr : local i32 [ 1 ] [ 0 ]
            repo_stale = null
            repo_page  = 0
            repo_more  = false
            if [ cp.exists[] ]
                cached : vec RepoInfo repo_cache_read[ cp, @at[0],
                                                       @pg[0], @mr[0] ]
                if [ cached && epoch_millis[] - at[0] < 3600000 ]
                    repo_items = cached
                    repo_page  = pg[0]
                    repo_more  = mr[0] != 0
                    return repo_items
                repo_stale = cached
            repo_fetch_start[ user, 1 ]
        if [ !repo_items ] repo_items = vec RepoInfo []
        return repo_items

    # the repository owner/name names, from memory when looked up
