        if [ ev.target.id == 'sv_scenes' || ev.target.id == 'sv_instances'
             || ev.target.id == 'sv_wifi' || ev.target.id == 'sv_mouse'
             || ev.target.id == 'sv_keyboard'
             || ev.target.id == 'sv_display'
             || ev.target.id == 'sv_sound' ]
            vw : ev.target.id.mid[ 3, ev.target.id.count - 3 ]
            sys_view = (sys_view == vw) ? '' : vw
            if [ ux ] ux.restyle = true
