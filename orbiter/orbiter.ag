                rest : string ''
                for [ i: i32 0, i < rc.tail.count, i += 1 ]
                    c : i32 [ rc.tail.chars[ i ] ]
                    if [ c == 13 || c == 10 ]
                        if [ seg.count > 0 ] repo_progress[ rc, seg ]
                        seg = ''
                    el
                        seg = seg + rc.tail.mid[ i, 1 ]
                rc.tail = seg
