            el
                set_pane_view[ edx, '' ]
            ev.no_default = true
            if [ ev.target ] ev.target.ux.restyle = true
            return
        
        if [ ev.target.id == 'back' ]
            exit_finder[]
            ev.no_default = true
            if [ ev.target ] ev.target.ux.restyle = true
            return
        
        
        # an enum's segmented buttons: the press already set
