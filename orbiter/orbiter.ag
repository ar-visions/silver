    # the module whose build lists this one's library, else ''
    func linked_by [ n: string, lists: vec string, users: vec string ]
            -> string
        want : string '/libsilver-{n}.so'
        own : string 'silver-{n}'
        for [ i: i32 0, i < lists.count, i += 1 ]
            st : string users[ i ]
            if [ st == own || lists[ i ].index_of[ want ] < 0 ] continue
            return (st.index_of[ 'silver-' ] == 0)
                ? st.mid[ 7, st.count - 7 ] : st
        return ''

