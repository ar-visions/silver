    func module_has_breakpoints [ mdir: string ] -> bool
        if [ !breakpoints || !mdir || mdir.count == 0 ] return false
        for [ cond: string, key: string ] in breakpoints
            idx : i32 [ key.rindex_of[ ':' ] ]
            if [ idx <= 0 ] continue
            bsrc : string key.mid[ 0, idx ]
            if [ !bsrc || bsrc.count == 0 ] continue
            bpp : path [ bsrc.chars ]
            bd  : bpp.parent_dir[]
            if [ bd && '{bd}' == mdir ] return true
        return false

    func dbg_on_stdout [ buf: iobuffer ] -> Au
        return null
    func dbg_on_stderr [ buf: iobuffer ] -> Au
        return null
    func dbg_on_break [ cur: cursor ] -> Au
        if [ !cur ] return null
        log 'dbg break {cur.source}:{cur.line} t={Au.epoch_millis[]}'
        # the cursor's members die with the poll thread's pool: copy
        # them out
        pending_src  = '{cur.source}'
        pending_line = i32[ cur.line ]
        pending_col  = i32[ cur.column ]
        pending_stop = true
        # the frame applies it: wake the window now, not at the next
        # mouse move
        if [ ux ] ux.will_animate = true
        return null

    func apply_break [ src_name: string, ln: i32, col: i32 ]
        src : path [
            (src_name && src_name.count > 0) ? path [ src_name.chars ]
            : null ]
        # a stop in system code (glibc etc.) has no openable source
        if [ src && !src.exists[] ] src = null
        if [ src ]
            open_in_pane[ src, 0 ]
            ed : Editor pane_at[ 0 ]
            if [ ed ]
                # the file is in already: land now; otherwise land once
                # it loads
                same : bool [
                    ed.loaded_src
                    && '{ed.loaded_src.absolute[]}' == '{src.absolute[]}' ]
                if [ same ]
                    ed.apply_stop[ ln, col ]
                el
                    ed.stop_pending     = ln
                    ed.stop_pending_col = col
        dv : active_debugger[]
        # args and locals are disjoint in lldb; the func line needs the
        # args. locals go FIRST: base_var_at takes the first name that
        # matches, and
        # 'a' (self) is an argument that would otherwise shadow every
        # line
        if [ dv ]
            lc : dv.read_locals[]
            ag : dv.read_arguments[]
            all : vec Au []
            if [ lc ]
                for [ v9: variable ] in lc
                    all.push[ v9 ]
            if [ ag ]
                for [ v9: variable ] in ag
                    all.push[ v9 ]
            debug_vars = all
            refresh_frames[]
        win : ux
        win.will_animate = true

    func clear_stop_lines []
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            ed : Editor pane_at[ i ]
            if [ ed ]
                # its place on screen: the next stop lands there
                if [ ed.stop_line >= 0 && ed.lh_cache > 0.0 ]
                    ed.stop_y = f32[
                        ed.vis_row[
                            ed.stop_line ] ] * ed.lh_cache - ed.scroll.y
                ed.stop_line  = -1
                ed.stop_col   = -1
                ed.pristine   = false
        if [ ux ] ux.restyle = true
        # no live frame anymore → drop the inspected variables.
        debug_vars  = null
        frame_cache = null
    func dbg_on_exit [ e: exited ] -> Au
