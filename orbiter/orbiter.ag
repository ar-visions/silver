        iconl.image_scale = 0.8

# staged live-reload: small button centred in the status bar
Option ReloadButton
    no_cache : true
    # the label after the body: a hover fill never covers it; the
    # hover is mostly an orange glow
    style : CSS {
        area: l50%-1.45 t0.12 w2.91 h0.67
        layers.body:
            fill_color: #0000
            radius: 4
            box_shadow: none
        layers.face:
            label_color: #fff
            label_size: 14
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.5 0.5
            label_offset: 0.0 -1.0
        :hovered
            layers.body:
                fill_color: #c8641e22
                box_shadow: inset 0 0 8px #ffae5ecc
        :pressed
            layers.body:
                fill_color: #c8641e55
                box_shadow: inset 0 0 8px #ffae5ecc
    }

# center of the status bar: hides everything above it but the scene
# find bar switch: search the docked remote checkouts too
Option RemoteToggle
    no_cache : true
    style : CSS {
        area: r0+ t0 w78px h0.9
        layers.body:
            fill_color: #0000
            radius: 8
            stroke_width: 1
            stroke_color: #fff1
            near_border: true
            near_inset: 2.0
            near_inset_color: #c890ffaa
        layers.face:
            label_color: #fff6
            label_size: 16
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.5 0.5
        :selected
            layers.body:
                fill_color: #8c4a6440
                stroke_color: #fff4
            layers.face:
                label_color: #ffff
        :hovered
            layers.body:
                near_inset: 4.0
    }

# non-clickable chip in the same spot: what the reload is doing right
# now the editor's tooltip: the class and function the caret sits in,
# and at a debugger stop the clicked name's type and value, so it reads
# here instead of scrolling up to its # annotation. a plain label from
# the bar's left edge, after the agent's word when that shows; it gives
# the spot up while a reload chip is showing
element DebugValue
    no_cache : true
    style : CSS {
        # the bar's height, between the steps and the tasks
        # 0.5 units in from the bar's left
        area: l0.5 t0 w5.5 b0
        layers.body:
            fill_color: #0000
            radius: 0
            box_shadow: none
        layers.face:
            label_color: #cfe6ff
            label_size: 14
            label_font: 'fonts/BarlowCondensed-Regular.ttf'
            label_align: 0.0 0.5
            label_offset: 0.0 -1.0
    }

# the agent's word in the bar: the debug value's place, with the shine
element AgentNote
    no_cache : true
    # the avatar's status: a bordered button at the bar's left whose
    # ground is the state (:agent while it works, :needs when it waits
    # on you,
    # :done when it finished); a click brings the exchange back
    public agent : bool
    public needs : bool
    public done  : bool
    style : CSS {
        area: l8px t8px w300px h18px
        layers.body:
            fill_color: #ffffff10, 400ms cubic outward
            radius: 6
            stroke_width: 1
            stroke_color: #fff2
            box_shadow: none
        layers.shine: ShineLayer
            shine_color: #cfe6ff
            shine_size: 14
            area: l0.24 t0 r0.24 b0
    :agent
        layers.body:
            fill_color: #1e5a6ecc, 400ms cubic inward
    :needs
        layers.body:
            fill_color: #7a4a14cc, 400ms cubic inward
    :done
        layers.body:
            fill_color: #1e6e3ecc, 400ms cubic inward
    }

