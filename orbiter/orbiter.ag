# a dock icon: no ground, the pointer's near border and glow
TButtons DockButton
    style : CSS {
        layers.edge:
            fill_color: #0000
            box_shadow: inset 0 0 13px #c890ff04
            stroke_width: 1
            stroke_color: #fff1
            near_border: true
            near_inset: 2.0
            near_inset_color: #c890ffaa
        layers.lite:
            fill_color: #fff2
            area: l0 b2px r0 h1px
        layers.foot:
            fill_color: #00000099
            area: l0 b1px r0 h1px
    }

