            # the lit tab folds the panel; another switches to it; any
            # opens a folded one
            inst_hidden = side_tab == tb && !inst_hidden

            side_tab    = tb
            if [ ux ] ux.restyle = true
            ev.no_default = true
            return
        # a setting's chip in a system menu panel: its choices under
