# the home: the apps, or the agent view (the bottom bar's button)
element HomeView
    style : CSS {
        area: l0 t0 r0 b0
    }
    public pane : i32

    func render [] -> Elements
        t : Elements []
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ !orb ] return t
        if [ orb.home_tab == 'agent' ]
            t['agent_home'] = AgentHome [
                area: Region { l0 t0 r0 b0 } ]
        el
            t['apps'] = AppsGrid [ pane: pane, scroll_fade: 24.0,
                area: Region { l0 t0 r0 b0 } ]
        return t

# the agent view: the avatar at the left; at the right the agents
# and their models to pick from, or the one picked, its terminal
element AgentHome
    # the platform paints every frame: the list must come after it
    animated : true
    style : CSS {
        area: l0 t0 r0 b0
    }

    func render [] -> Elements
        t : Elements []
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ !orb || !bounds ] return t
        un : f32 ux_unit[ ux ]
        # the platform behind; the list at the right, beside it
        lx : f32 [ round[ bounds.w * 0.42 ] ]
        t['plat'] = orb.platform_of[ lx ]
        rh : f32 [ round[ 30.0 * un ] ]
        ed : f32 [ round[ 24.0 * un ] ]
        top : f32 [ round[ 12.0 * un ] ]
        y : f32 [ top ]
        if [ orb.home_why && orb.home_why.count > 0 ]
            t['ahome_why'] = HomeError [ label: orb.home_why,
                area: Region [ 'l{lx}px t{y}px r{ed}px h{rh}px' ] ]
            y += rh + round[ 8.0 * un ]
        picks : vec string orb.home_choices[]
        if [ picks.count == 0 ]
            t['ahome_none'] = HomeLabel [
                label: 'No agent installed: install one from the apps',
                area: Region [ 'l{lx}px t{y}px r{ed}px h{rh}px' ] ]
            return t
        hh : f32 [ round[ 38.0 * un ] ]
        gap : f32 [ round[ 6.0 * un ] ]
        pad : f32 [ round[ 5.0 * un ] ]
        # the one row to add from: every agent at each of its models
        ids : vec string []
        lb  : vec string []
        for [ k: i32 0, k < picks.count, k += 1 ]
            an : string orb.home_pick_agent[ picks[ k ] ]
            md : string orb.home_pick_model[ picks[ k ] ]
            # a model named after its agent: the agent said once
            if [ md.starts_with[ '{an}-' ] ]
                md = md.mid[ an.count + 1, md.count - an.count - 1 ]
            ids.push[ 'ahome_add_{k}' ]
            lb.push[ (md.count > 0) ? '{an} {md}' : an ]
        t['ahome_add'] = AgentHead [
            area: Region [ 'l{lx}px t{y}px r{ed}px h{hh}px' ] ]
        t['ahome_add_l'] = HomeLabel [ label: '+  add',
            area: Region [
                'l{lx + round[ 14.0 * un ]}px t{y}px w{round[ 80.0 * un ]}px h{hh}px' ] ]
        t['ahome_adds'] = TButtons [ buttons: ids, labels: lb,
            icons: false, manual: true, label_px: 15.0,
            label_font: 'fonts/BarlowCondensed-Regular.ttf',
            seg_radius: 6.0 * un, selected: -1,
            area: Region [
                'l{lx + round[ 64.0 * un ]}px t{y + pad}px r{ed + pad}px h{hh - pad * 2.0}px' ] ]
        y += hh + gap * 2.0
        # the instances, a title each, the open one's console under
        names : vec string orb.home_names[]
        ch : f32 [ bounds.h - y - ed
                   - f32[ names.count ] * (hh + gap) - gap ]
        for [ an: string ] in names
            cs : ConsoleSession orb.home_session[ an ]
            open : bool [ orb.home_open == an && cs != null ]
            t['ahome_h_{an}'] = AgentHead [ selected: open,
                area: Region [ 'l{lx}px t{y}px r{ed}px h{hh}px' ] ]
            mark : string [ (open) ? '▾' : '▸' ]
            md : string orb.home_model_of[ an ]
            nl : string [ (md.count > 0) ? '{mark}  {an}  {md}'
                                         : '{mark}  {an}' ]
            t['ahome_l_{an}'] = HomeLabel [ label: nl,
                area: Region [
                    'l{lx + round[ 14.0 * un ]}px t{y}px w{round[ 200.0 * un ]}px h{hh}px' ] ]
            if [ cs ]
                # waiting, else what it says it does, else running
                dg : string orb.home_doing_of[ an ]
                st : string [ (orb.home_waiting[ an ]) ? 'waiting'
                              : (dg == 'build') ? 'building'
                              : (dg == 'research') ? 'researching'
                              : (dg.count > 0) ? dg : 'running' ]
                if [ dg.count > 0 && orb.home_words.contains[ an ] ]
                    hw : string orb.home_words[ an ]
                    if [ hw.count > 0 ] st = '{st}: {hw}'
                t['ahome_s_{an}'] = HomeState [ label: st,
                    selected: orb.home_waiting[ an ],
                    area: Region [
                        'l{lx + round[ 220.0 * un ]}px t{y}px w{round[ 330.0 * un ]}px h{hh}px' ] ]
            ew : f32 [ round[ 60.0 * un ] ]
            t['ahome_e_{an}'] = TButtons [
                buttons: vec string [] [ 'ahome_end_{an}' ],
                labels: vec string [] [ 'end' ],
                icons: false, manual: true, label_px: 16.0,
                label_font: 'fonts/BarlowCondensed-Regular.ttf',
                seg_radius: 6.0 * un, selected: -1,
                area: Region [
                    'r{ed + pad}px t{y + pad}px w{ew}px h{hh - pad * 2.0}px' ] ]
            # open, its console joins its title: no gap between
            y += hh
            if [ open && ch > rh ]
                one : map ConsoleSession [ string ] []
                one[ an ] = cs
                # its top edge on the title's bottom one: one line
                t['ahome_b_{an}'] = AgentBody [
                    area: Region [
                        'l{lx}px t{y - 1.0}px r{ed}px h{ch + gap + 1.0}px' ] ]
                t['ahome_t_{an}'] = Console [ focusable: true,
                    sessions: one, session_id: an, cwd: cs.cwd,
                    cbase: Layer [ fill_color: rgba [ '#0000' ] ],
                    area: Region [
                        'l{lx}px t{y}px r{ed}px h{ch + gap}px' ] ]
                y += ch + gap
            y += gap
        return t

# the avatar for the exchange under the screenshot prompt
AppAvatar AgentAvatar
    # shift-click steps the avatar through its states (face on, tilted,
    # working, done with the flame): a look at each without an agent
    public func on_press [ ev: Event ]
        if [ !ev.key.shift ] return
        # shift+meta: the exchange fade alone, no agent, no swap
        if [ ev.key.meta && ux ]
            ux.swap_fade = !ux.swap_fade
            ux.restyle   = true
            log 'swap_fade {ux.swap_fade}'
            ev.no_default = true
            return
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ orb ] orb.avatar_debug[]
        ev.no_default = true
    # 2x at the top center, revealed by an alpha fade (no move: a moving
    # target resizes and fuzzes); settled only tilts it. render_scale is
    # in device pixels for the pbr pass: 4 is a 4x supersample on every
    # display, drawn down 4:1 by the reduction pass
    render_scale : f32 [ 4.0 ]
    # a square element: the camera frames the hex at the element's
    # vertical center, so a tall one would put it mid-screen
    # centered in the window's top 70% until the first send; settled, it
    # moves to the upper left and shrinks, leaving the right to the
    # agent
    style : CSS {
        area: l50%-195px t40%-195px w390px h390px, 900ms cubic in_out
        # out at once: the blur behind drops the same frame (Esc), and a
        # fade would leave the avatar alone over the plain screen
        opacity: 0.0
    :shown
        opacity: 1.0, 600ms cubic inward
    :settled
        # the same coordinate form as the start (a percent with a px
        # offset): a transition mixes the two, and a percent mixed with a
        # plain pixel value snaps
        area: l0%+30px t25%+110px w408px h408px, 900ms cubic in_out
    :fading
        opacity: 0.0, 3000ms cubic outward
    }

# a console from the project's agi (shell, claude), as a view the rail
# lists like any other: the pane composes the Console for that session
ResourceView ConsoleView
    public session  : string
    public sessions : map ConsoleSession[string]
    public launch   : string
    # not a file's view: the process is given the folder in view
    public folder   : path
    func applies [] -> FileType
        return FileType.agnostic
    func continuous [] -> bool
        return true
    func view_element [] -> element
        return Console [ session_id: session, sessions: sessions,
                         feed: null,
            launch: launch, cwd: '{folder}', animated: true ]


