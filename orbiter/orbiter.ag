                menu_sync[]
            menu_open_at[ mt.at, menu_top == mt.at ]
            ev.no_default = true
            return
        if [ ev.target inherits TrayMark ]
            mk : cast TrayMark [ ev.target ]
            tr : Tray tray_shared[]
            ti : TrayItem tr.find[ mk.service ]
