        inst_seq += 1
        av.iid = inst_seq
        instances.push[ av ]
        # a folded side panel stays folded: only the user opens it
        session_dirty = true

    # a task closed from its button: the process goes, its panes let
    # it go, and it leaves the list
    func close_task [ av: AppView ]
