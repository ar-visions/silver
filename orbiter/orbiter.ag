        return m

    # the program a console instance runs: its args' last word's name
    func program_of [ av: AppView ] -> string
        if [ av.app_mod != 'console' || !av.module_args ] return ''
        words : vec string av.module_args.split[ ' ' ]
        if [ words.count == 0 ] return ''
        prog : string words[ words.count - 1 ]
        at : i32 [ prog.rindex_of[ '/' ] ]
        if [ at < 0 ] return prog
        return prog.mid[ at + 1, prog.count - at - 1 ]

    # a program's icon file, as a desktop finds it: its .desktop (by
    # the window's app id, else the program's name) names it, the icon
    # theme holds it (scalable svg, else the largest png), else pixmaps
    mutable prog_icons : map string [string]

    func program_icon [ av: AppView ] -> path
        pn : string program_of[ av ]
        if [ pn.count == 0 ] return null
        wv : u64 window_of[ av ]
        aid : string [ (wv != 0) ? string[ wlc_window_app[ wv ] ] : '' ]
        return program_icon_named[ aid, pn ]

    # a .desktop file's first line with this key, its value
    func desktop_line [ df: path, key: string ] -> string
        tx : string df.load[ typeid[string], null ]
        if [ !tx ] return ''
        for [ ln: string ] in tx.split[ '\n' ]
            if [ ln.starts_with[ key ] ]
                return ln.mid[ key.count, ln.count - key.count ].trim[]
        return ''

    # by a window's app id ('' when none) and the program's name
    func program_icon_named [ aid: string, pn: string ] -> path
        key : '{aid}|{pn}'
        if [ !prog_icons ] prog_icons = map string [string] []
        if [ prog_icons.contains[ key ] ]
            got : string prog_icons[ key ]
            return (got.count > 0) ? path [ got ] : null
        name : string [ pn ]
        hc : cstr [ getenv[ "HOME" ] ]
        home : string [ (hc == null) ? '' : string[ hc ] ]
        dirs : vec string [] [ '{home}/.local/share/applications',
                               '/usr/share/applications' ]
        hit : bool [ false ]
        for [ n: string ] in vec string [] [ aid, pn ]
            if [ n.count == 0 || hit ] continue
            for [ d: string ] in dirs
                df : path '{d}/{n}.desktop'
                if [ !df.exists[] ] continue
                ic : string desktop_line[ df, 'Icon=' ]
                if [ ic.count > 0 ] name = ic
                hit = true
                break
        # else the .desktop whose Exec= runs this program
        if [ !hit ]
            for [ d: string ] in dirs
                if [ hit ] break
                dp : path [ d ]
                if [ !dp.exists[] ] continue
                for [ df: path ] in dp.ls[ null, false ]
                    if [ df.ext[] != 'desktop' ] continue
                    ex : string desktop_line[ df, 'Exec=' ]
                    cmd : string ex.split[ ' ' ][ 0 ]
                    sl : i32 [ cmd.rindex_of[ '/' ] ]
                    if [ sl >= 0 ] cmd = cmd.mid[ sl + 1, cmd.count - sl - 1 ]
                    if [ cmd != pn ] continue
                    ic : string desktop_line[ df, 'Icon=' ]
                    if [ ic.count > 0 ] name = ic
                    hit = true
                    break
        found : string [ '' ]
        if [ name.starts_with[ '/' ] && (path [ name ]).exists[] ]
            found = name
        el
            ic : '/usr/share/icons/hicolor'
            px : '/usr/share/pixmaps/{name}'
            tries : vec string [] [ '{ic}/scalable/apps/{name}.svg' ]
            for [ sz: string ] in vec string [] [ '512', '256', '128',
                    '96', '64', '48' ]
                tries.push[ '{ic}/{sz}x{sz}/apps/{name}.png' ]
            tries.push[ '{px}.svg' ]
            tries.push[ '{px}.png' ]
            for [ t: string ] in tries
                if [ (path [ t ]).exists[] ]
                    found = t
                    break
        # the app id is in the key: a window's later id looks again
        prog_icons[ key ] = found
        return (found.count > 0) ? path [ found ] : null

    # the window an instance's program opened, while it is open
    func window_of [ av: AppView ] -> u64
        if [ !av || av.wl_window == 0 ] return u64[ 0 ]
        if [ wlc_window_open[ av.wl_window ] == 0 ] return u64[ 0 ]
        return av.wl_window

    func instance_label [ av: AppView ] -> string
        sw : string av.status_word[]
        return (sw.count > 0) ? '{instance_name[ av ]}  {sw}' : instance_name[ av ]

    # a picked instance comes into view, embedded (a chip's click)
    func pick_instance [ iid: i32, pi: i32 ]
        av : AppView instance_by[ iid ]
        if [ av && av.display == 0 ]
            av.display = 1
            av.pip     = false
            tell_display[ av ]
        show_instance[ iid, pi ]

    func show_instance [ iid: i32, pi: i32 ]
        av : AppView instance_by[ iid ]
        ed : Editor pane_at[ pi ]
        if [ !av || !ed ] return
        # the instance's own source comes into the pane first; the show
        # waits a frame for the load, which would otherwise clear the
        # app view again
        if [ av.src && !av.viewer ]
            bs9 : path ed.src
            if [ !bs9 || '{bs9.absolute[]}' != '{av.src.absolute[]}' ]
                open_in_pane[ av.src, pi ]
                pending_show      = iid
                pending_show_pane = pi
                return
        ed.run_view  = av
        # one pane shows it: another showing it goes to its code
        for [ op: i32 0, op < editor_slots.count, op += 1 ]
            eo : Editor pane_at[ op ]
            if [ op != pi && eo && eo.run_view == av && eo.app_view ]
                eo.app_view = false
                eo.pristine = false
        # a program's window comes back into the pane with it; any
        # other instance takes the pane from a window
        wv : u64 window_of[ av ]
        if [ pane_win ]
            while [ pane_win.count <= pi ]
                pane_win.push[ u64[ 0 ] ]
            pane_win[ pi ] = wv
        if [ wv != 0 ] wlc_window_focus[ wv ]
        session_dirty = true
        # an instance in pip stays in pip when it is selected
        ed.app_view  = av.display == 1
        ed.pristine  = false
        ed.no_scroll = true
        active_pane  = pi
        land_paused[ av ]
        if [ ux ] ux.restyle = true

    # the instance row's icon starts or stops it; the step group pauses,
    # continues and steps
    # the instance's display: every change is live in the process (its
    # frames come to the pane, or its own window shows); nothing
    # relaunches a running app holds its own display: it is told every
    # change
    func tell_display [ av: AppView ]
        if [ !av || !av.started || av.ended || av.display < 0 || av.display > 3 ]
            return
        dn : vec string [] [ 'PIP', 'Embed', 'Window', 'Screen' ]
        av.disp_ms = epoch_millis[]
        agent_sock_send[ av.sock_name[].chars,
                         'set display {dn[ av.display ]}\n' ]

    func set_display [ ed: Editor, av: AppView, d: i32 ]
        old : i32 [ av.display ]
        if [ old == d ] return
        av.display = d
        av.pip     = d == 0
        av.disp_ms = epoch_millis[]
        session_dirty = true
        if [ ed && ed.run_view == av ]
            want : bool [ d == 1 ]
            if [ ed.app_view != want ] ed.toggle_app_view[]
            av.pip = d == 0
        tell_display[ av ]

    func instance_action [ ed: Editor, av: AppView, act: string ]
        if [ !av ] return
        if [ act.compare[ 'play' ] == 0 ]
            if [ av.held ]
                # first start: the file's args as they stand right now
                if [ !(av.module_args && av.module_args.count > 0) ]
                    fs : file_state args_state_of[ ed ]
                    if [ fs && fs.args && fs.args.count > 0 ]
                        av.module_args = fs.args
                av.held = false
                # a restored instance keeps its display: the pane shows
                # it one way, never both
                if [ ed ] ed.app_view = av.display == 1
                # the nav list closes: the pane shows the app, not the
                # list over it
                if [ nav_showing || find_showing ]
                    exit_finder[]
                    nav_showing  = false
                    find_showing = false
                    if [ ux ] ux.will_animate = true
                return
            if [ av.ended ] av.restart[ false ]
            return
        if [ act.compare[ 'stop' ] == 0 ]
            # the process goes; the instance stays, not running, with
            # its args
            av.release[]
            av.debugger = null
            av.attached = false
            av.started  = false
            av.ended    = false
            av.paused   = false
            av.held     = true
            av.note     = ''
            # a pane on the content it was playing (a rom, a disc)
            # goes to the module's source: the app, not the file
            if [ ed && av.src && ed.src
                 && '{ed.src.absolute[]}' != '{av.src.absolute[]}' ]
                open_in_pane[ av.src, ed.pane_index ]
            return
        if [ act.compare[ 'pause' ] == 0 ]
            if [ av.held || av.ended ] return
            app_pause_toggle[ av ]
            # paused: back to the source; a resume fades the app in
            # (the editor's resume_watch)
            if [ av.paused && ed && ed.app_view ] ed.toggle_app_view[]
            return
        d : dbg av.debugger
        if [ !d || !d.active ] return
        active_target = dbg_key[ av ]
        if [ act.compare[ 'continue' ] == 0 ]       d.cont[]
        el [ act.compare[ 'step_next' ] == 0 ] d.step_over[]
        el [ act.compare[ 'step_in' ] == 0 ]   d.step_into[]
        el [ act.compare[ 'step_out' ] == 0 ]  d.step_out[]

    func land_paused [ av: AppView ]
        if [ !av || !av.paused || !av.debugger || av.debugger.running ]
            return
        active_target = dbg_key[ av ]
        for [ pi: i32 0, pi < editor_slots.count, pi += 1 ]
            ed : Editor pane_at[ pi ]
            if [ ed && ed.run_view == av && ed.app_view ]
                ed.toggle_app_view[]
        for [ df: frame ] in av.debugger.read_frames[]
            sp : string '{df.source}'
            if [ df.line > 0 && sp.ends_with[ '.ag' ] ]
                apply_break[ sp, i32[ df.line ], 0 ]
                return

    # its debugger sits at a stop: it can step
    func stopped_at [ av: AppView ] -> bool
        dg : dbg (av) ? av.debugger : null
        return dg && dg.active && !dg.running

    # the debugger sitting at a stop, whichever target is active
    func stopped_debugger [] -> dbg
        if [ !debuggers ] return null
        for [ d9: dbg, k9: string ] in debuggers
            if [ d9 && d9.active && !d9.running ] return d9
        return null

    func active_debugger [] -> dbg
        if [ !debuggers ] return null
        d : dbg debuggers[ active_target ]
        return (d && d.active) ? d : null

    # THE source files a silver module may carry, and the only ones. the
    # .ag is what makes the directory a module, so it leads. the title's
    # companion row and the nav list's module chips both ask here
    public func module_exts [ dir: path, stem: string ] -> vec string
        out : vec string []
        if [ !dir || !stem || stem.count == 0 ] return out
        for [ x9: string ]
            in vec string [] [ 'ag', 'c', 'cc', 'mm', 'rs' ]
            p9 : path '{dir}/{stem}.{x9}'
            if [ p9.exists[] ] out.push[ x9 ]
        return out

    # a file's companions sit BESIDE it, never in a subfolder: same
    # folder, same stem, one of the source extensions
    func companion_exts [ p: path ] -> vec string
        if [ !p ] return vec string []
        # an address (a hosted page) has no source beside it
        s9 : string '{p}'
        if [ s9.index_of[ '://' ] >= 0 ] return vec string []
        return module_exts[ p.parent_dir[], p.stem[] ]

    # the companion of p carrying this extension, or null
    func companion_path [ p: path, ex: string ] -> path
        if [ !p || !ex ] return null
        c9 : path '{p.parent_dir[]}/{p.stem[]}.{ex}'
        return (c9.exists[]) ? c9 : null

    # the pane's module: its app's source, else <m>/<m>.ag
    func module_src_of [ ed: Editor ] -> path
        if [ !ed ] return null
        if [ ed.app_view && ed.run_view && ed.run_view.src ]
            return ed.run_view.src
        if [ !ed.src || ed.src.ext[] != 'ag' ] return null
        if [ ed.src.stem[] != ed.src.parent_dir[].filename[] ]
            return null
        return ed.src

    # a module's app in a pane: its instance; new_tab, a new one
    func show_app [ ed: Editor, src: path, fresh: bool ]
        if [ !ed || !src ] return
        av9 : AppView [ null ]
        if [ !fresh ]
            for [ v9: AppView ] in instances_of[ src ]
                if [ !v9.viewer ] av9 = v9
        if [ !av9 ]
            av9 = AppView [ ]
            av9.src = src
            fa : string file_args[ src ]
            av9.module_args = (fa && fa.count > 0) ? fa : module_args
            add_instance[ av9 ]
        embed_app[ ed, av9 ]

    # an instance shown in the pane, embedded and running
    func embed_app [ ed: Editor, av: AppView ]
        av.display = 1
        av.pip     = false
        av.held    = false
        tell_display[ av ]
        if [ av.ended && !av.failed[] ] av.restart[ false ]
        ed.wait_app = true
        show_instance[ av.iid, ed.pane_index ]

    func title_nav [ p: path, grp: vec path, has_diff: bool, win: Window,
                     dbg_locked: bool, dbg_open: bool, menu_open: bool,
                     is_resource: bool, rv: ResourceView, fb_on: bool,
                     tfoc: bool, pane_ix: i32 ] -> Elements
        hasfile  : bool [ p && p.exists[] ]
        els : Elements []
        browse_open : bool [ menu_open && nav_showing ]
        # nav_showing and pick_field are the SHELL's state, not this
        # pane's: unqualified they made every pane's title claim the
        # finder and show its close chip at once. only the pane that
        # owns the search does
        mine : bool [ search_pane[] == 'pane{pane_ix}' ]
        engaged : bool [ browse_open || fb_on || tfoc ||
                         (mine && (nav_showing || picking[])) ]
        # no close chip — Escape closes the finder
        edp : Editor pane_at[ pane_ix ]
        # the chip closes a view the user PICKED. the file's own natural
        # view (text, or a byte view for a binary format) closes to
        # nothing, and a console is not a closable state: the nav arrows
        # stay
        hx  : bool [ edp && edp.view_name && edp.view_name.count > 0
            && edp.view_name != edp.fallback_view_for[ edp.src ]
                      && !console_of[ edp.view_name ] ]
        dc  : bool [
            edp && edp.diff_commit && edp.diff_commit.count > 0 ]
        # the arrows' box: 1.8 font units square to the bar
        gw : f32 [
            1.8
            * ((win && win.vk && win.vk.font_unit > 0) ? f32[ win.vk.font_unit ] : 22.0) ]
        # a picked view is closed by its own lit button, not this
        if [ dc ]
            # the dialog's own close, furthest right: the arrows keep
            # the left
            els['panel_close'] = BarClose [ icon: 'close',
                                            manual_mode: true,
                area: Region [ 'r0+ t0 w1.66 b0' ] ]
        # a module: its run button; any other file: its type's icon
        # it stays in navigation: the app can start at any time
        mi : path module_src_of[ edp ]
        # a pane showing a program's window: its close, in the run
        # button's place (the top right is a dialog's)
        wid : u64 pane_window[ pane_ix ]
        # finding in the file (ctrl+f): a magnify where the file's
        # icon or play was
        fi9 : bool [ title_find_on && pane_ix == active_pane
            && system_on[] ]
        # the navigator (find in files): a folder, a magnify cut in it
        nv9 : bool [ engaged && system_on[] && !fi9 ]
        if [ fi9 || nv9 ]
            els['modicon'] = BarIcon [
                buttons: vec string [] [ 'find_icon' ],
                icon_ids: vec string [] [
                    (nv9) ? 'find_in_files' : 'magnify' ],
                icon_scale: (nv9) ? 0.5 : 0.42,
                manual: true, seg_radius: 0.0, use_spacing: false,
                rest_fill: rgba [ '#0000' ],
                area: Region [ 'l-1px+ t0 w1.35 b0' ] ]
        el [ wid != 0 ]
            els['modicon'] = alt_tab[ pane_ix, 'modicon', 'win_close',
                'close', 'win_close', 'close', false, false, false,
                Region [ 'l-1px+ t0 w1.35 b0' ] ]
        # a module's run button sits at the right, by find
        el [ !mi && edp && edp.src ]
            # a module's folder wears its module's icon
            tm9 : path '{edp.src}/{edp.src.filename[]}.ag'
            tmod : bool [ edp.src.is_dir[] && tm9.exists[] ]
            els['modicon'] = TitleIcon [ file: edp.src, module: tmod,
                plain: true, area: Region [ 'l0+ t0 w1.35 b0' ] ]
        # a program's folder pick: the folder shown is the one chosen
        if [ nv9 && pick_field == 'portal' && pick_dir ]
            els['portal_open'] = LabelButton [ label: 'Open',
                manual_mode: true, area: Region [ 'r0+ t0 w4 b0' ] ]

        # a right button: the top bar's button width (its own units),
        # plus the 1 px each overlaps its neighbour, so edges line up
        bu : f32 [ (win && win.vk && win.vk.font_unit > 0)
            ? f32[ win.vk.font_unit ] : 22.0 ]
        bwd : f32 [ 1.66 * bu + 1.0 ]
        closable : bool [
            pane_ix < editor_slots.count && hasfile && !engaged ]
        # the title's right group, the same in the editor and the
        # running app: find, play / stop, pause (while it runs), close
        # (a picked view back to its file, else the tab); built right
        # to left, each left of the last
        # with the system bar there is no close: the bar's title and
        # the navigator change what a pane holds
        sysb : bool system_on[]
        if [ !engaged && (hx || closable) && !sysb ]
            els['tabclose'] = BarTab [
                buttons: vec string [] [
                    (hx) ? 'view_close' : 'pane_close' ],
                icon_ids: vec string [] [ 'close' ], manual: true,
                rest_glow: rgba [ '#ccf2' ], rest_px: 8.0,
                seg_radius: 0.0, use_spacing: false,
                area: Region [ 'r-1px+ t0 w{bwd}px b0' ] ]
        # pause while the app runs; stopped, its steps, one group: an
        # app run for debugging only (its launch's debug, or a
        # debugger on it)
        rvd : AppView (edp && mi) ? edp.run_view : null
        dg8 : dbg (rvd) ? rvd.debugger : null
        dbo : bool [ rvd && (rvd.debug_build || (dg8 && dg8.active)) ]
        # not over the nav list, the finder or the find bar
        if [ rvd && dbo && !rvd.ended && !rvd.held && rvd.started
             && !engaged && !(mine && find_showing) ]
            stp : bool stopped_at[ rvd ]
            dbs : vec string (stp) ? vec string [] [ 'continue',
                'step_next', 'step_in', 'step_out' ]
                : vec string [] [ 'pause' ]
            els['debug'] = AltTab [ buttons: dbs, icon_ids: dbs,
                manual: true, seg_radius: 0.0, use_spacing: false,
                rest_fill: rgba [ '#0000' ], seg_reach: 0.5,
                icon_scale: 0.4125, area: Region [
                    'r-1px+ t0 w{bwd * f32[ dbs.count ]}px b0' ] ]
        # a module: play; stop while it runs; shift: another
        if [ mi && wid == 0 && !engaged && !fi9 ]
            rvt : AppView (edp) ? edp.run_view : null
            lvt : bool [ rvt && !rvt.ended && !rvt.held ]
            # stop is a debugging control: a plain run shows none
            if [ !lvt || dbo ]
                # with the system bar: at the left, as a file's icon
                pr9 : string [ (sysb) ? 'l-1px+ t0 w1.35 b0'
                    : 'r-1px+ t0 w{bwd}px b0' ]
                els['modicon'] = alt_tab[ pane_ix, 'modicon', 'app_run',
                    (lvt) ? 'stop' : 'play', 'app_run', 'add_instance',
                    true, false, false, Region [ pr9 ] ]
        # find, leftmost of the group: lit while the bar is open; with
        # the system bar, find in files is the navigator's; the empty
        # pane ('Open') has nothing to find
        if [ p && (!engaged || fb_on) && !sysb ]
            els['tabnav'] = alt_tab[ pane_ix, 'tabnav', 'magnify',
                'magnify', 'magnify', 'magnify', false, false,
                fb_on, Region [ 'r-1px+ t0 w{bwd}px b0' ] ]
        # the pane's one status, left of find: its app compiling (errors
        # go here too)
        iw : string [ null ]
        rvs : AppView (edp) ? edp.run_view : null
        if [ rvs && rvs.started && !rvs.ended
             && rvs.status_word[] == 'compiling' ]
            iw = 'compiling {instance_name[ rvs ]}'
        if [ iw && !engaged ]
            sww : f32 [ max[ bwd * 3.0,
                f32[ iw.count ] * 9.0 * (bu / 22.0) + bwd ] ]
            els['status'] = StatusLabel [ word: iw, info: true,
                area: Region [ 'r-1px+ t0 w{sww}px b0' ] ]
        # a silver module's companions: <name>.ag and whatever sits
        # beside it under the same name, one strip at the title's right
        # (left of find); ids cmp_<ext>, the open one lit
        # no file switch with the system bar, for now
        if [ hasfile && !engaged && !system_on[] ]
            cx9  : string p.ext[]
            cel : vec string companion_exts[ p ]
            # one format alone has nothing to switch to
            if [ cel.count > 1 ]
                fu   : f32 [
                    (win && win.vk && win.vk.font_unit > 0)
                    ? f32[ win.vk.font_unit ] / 22.0 : 1.0 ]
                # one round pill each, the system menu's look a little
                # smaller; laid from the right, so the last first
                for [ ci: i32 cel.count - 1, ci >= 0, ci -= 1 ]
                    ex : string cel[ ci ]
                    els['cmp_{ex}'] = RoundTab [
                        buttons: vec string [] [ 'cmp_{ex}' ],
                        labels: vec string [] [ ex ], icons: false,
                        manual: true, label_px: 15.0 * fu,
                        seg_radius: 999.0,
                        rest_fill: rgba [ '#ffffff10' ],
                        use_spacing: false,
                        sel_mask: (ex == cx9) ? 1 : 0,
                        area: Region { r0.15+ t0.15 w1.6 h1.0 } ]

        if [ rv ]
            vel : Elements rv.title_elements*[]
            if [ vel ]
                for [ ve: element, vk: string ] in vel
                    els[vk] = ve

        # the finder's close, furthest right (inserted first into the
        # right flow); find/replace has none: its search button toggles
        # it off
        # finding in the file: no navigator controls
        # with the system bar the navigator's foot has no close (Esc,
        # or the globe again)
        if [ engaged && !is_resource && !fb_on && !title_finds[]
             && !system_on[] ]
            ncls : vec string [] [ 'finder_close' ]
            nclo : vec string [] [ 'close' ]
            els['finder_x'] = TButtons [ buttons: ncls, icon_ids: nclo,
                                         manual: true,
                disable_mask: 0,
                icon_scale: 0.55, rest_glow: rgba [ '#ccf2' ],
                rest_px: 8.0,
                seg_radius: 0.0, use_spacing: false,
                area: Region [ 'r0+ t0 w{bwd}px b0' ] ]
        if [ fb_on ]
            # right-flow: first inserted lands furthest right
            els['remotes'] = RemoteToggle [ label: 'remotes',
                                            manual_mode: true,
                                            selected: search_remotes ]
            els['replace'] = ReplaceField [ label: 'replace',
                                            edit: replace_text,
                                            focusable: true ]
            els['pattern'] = PatternField [
                label: 'files (i.e *.ag)',
                edit: pattern_text,
                focusable: true ]
            els['find'] = FindField [ label: 'Find', edit: findbar_text,
                                      focusable: true ]
        el [ engaged && !is_resource && !picking[] && !title_finds[] ]
            els['remotes'] = RemoteToggle [ label: 'remotes',
                                            manual_mode: true,
                                            selected: search_remotes ]
        # the coupled app, pinned left of the tabs: lit on its own
        # source
        if [ home_mod && home_mod.count > 0 && !engaged ]
            hs : path home_src[]
            on9 : bool [ p && hs && '{p}' == '{hs}' ]
            hw : f32 [ 24.0 + f32[ home_mod.count ] * 8.0 ]
            els['home_mod'] = CompanionButton [ label: home_mod,
                                                manual_mode: true,
                selected: on9,
                area: Region [ 'r0+ t0.065 w{i32[ hw ]}px h0.81' ] ]
        return els

    func couple_app [ mod: string, shot: string ]
        if [ !mod || mod.count == 0 ] return
        r9   : path.path_startup[]
        src9 : path '{r9}/{mod}/{mod}.ag'
        if [ !src9.exists[] ]
            log 'couple: no source for {mod} at {src9}'
            return
        pi : i32 [ (active_pane >= 0) ? active_pane : 0 ]
        open_in_pane[ src9, pi ]
        home_mod = mod
        if [ shot && shot.count > 0 ]
            setenv[ 'SILVER_SWITCH_SHOT', shot, 1 ]
        pending_held     = pi
        pending_held_src = src9
        if [ ux ]
            ux.set_shown[ true ]
            ux.restyle = true

    func home_src [] -> path
        if [ !home_mod || home_mod.count == 0 ] return null
        r9 : path.path_startup[]
        return path '{r9}/{home_mod}/{home_mod}.ag'


    # a title button and its second action, yellow when shown: shift
    # shows it on the one under the pointer; with on_cmd, cmd shows it
    # on every such button; off, it is never shown
    func alt_tab [ pane_ix: i32, key: string, id: string, icon: string,
                   alt_id: string, alt_icon: string, on_cmd: bool,
                   off: bool, lit: bool, area: Region ] -> AltTab
        pv : element pane_view[ pane_ix ]
        te : element (pv && pv.elements) ? pv.elements[ 'title' ] : null
        cur : element (te && te.elements) ? te.elements[ key ] : null
        hov : bool [ shift_down && !off && cur && cur.hovered ]
        cmd : bool [ on_cmd && cmd_down && !off ]
        use : bool [ hov || cmd ]
        return AltTab [ buttons: vec string [] [ (use) ? alt_id : id ],
            icon_ids: vec string [] [ (use) ? alt_icon : icon ],
            manual: true, seg_radius: 0.0, use_spacing: false,
            rest_fill: rgba [ '#0000' ], second: use, seg_reach: 0.5,
            sel_mask: (lit && !use) ? 1 : 0, area: area ]

    func dock_tabs [ grp: vec path, prefix: string, active: path,
                     win: Window ] -> Elements
        els : Elements []
        for [ i: i32 0, i < grp.count, i += 1 ]
            p   : path   grp[i]
            tid : string '{prefix}{i}'
            els[tid] = Option [ label: p.filename[],
                                selected: active && p == active ]
        return els

    func start_index []
        if [ index_building ]
            index_cancel = true
            index_dirty  = true
            return
        file_index   = list string []
        index_dirty  = false
        dirs : vec path []
        for [ d: path ] in search_dirs
            if [ d ] dirs.push[ d ]
        if [ dirs.count == 0 ] return
        index_cancel   = false
        index_building = true
        work : vec Au []
        work.push[ dirs ]
        index_task     = async [ target: a,
                                 work_fn: lambda index_work[ a ],
                                 work: work ]

    # a git repo indexes by ls-files: everything gitignored stays out
    func index_repo [ rp: path, cap: i32 ] -> bool
        ls : git_capture[ rp,
                          'ls-files --cached --others --exclude-standard', false ]
        index_lock.lock[]
        for [ i: i32 0, i < ls.count, i += 1 ]
            if [ index_cancel || file_index.count >= cap ] break
            file_index.push[ path '{rp}/{ls[i]}' ]
        over : bool [ file_index.count >= cap ]
        index_lock.unlock[]
        return over

    # the binaries a checkout carries: images, fonts, audio, video,
    # archives, objects, models, roms. never read, never indexed
    func tok_binary [ p: path ] -> bool
        e : string p.ext[]
        if [ !e || e.count == 0 ] return false
        for [ b: string ] in tok_skip
            if [ e.compare[ b ] == 0 ] return true
        return false

    # the word index's limit: past it a search reads the file
    func tok_most [] -> i64
        return 48 * 1024 * 1024

    # a bloom's own objects and its key, beside its bits
    func tok_each [] -> i64
        return 640

    # every indexed text file hashed up front: a search — or the remotes
    # toggle — then reads no file at all. binaries and huge files are
    # left out; the worker stops as soon as the index is cancelled
    func tok_warm []
        if [ !file_index ] return
        if [ !tok_cache ] tok_cache = map TokBloom [string] [ ]
        todo : vec string []
        index_lock.lock[]
        for [ fs: string ] in file_index
            todo.push[ fs ]
        index_lock.unlock[]
        # the pool drains per file: a file's text never outlives its
        # pass
        hold[ todo ]
        for [ fs: string ] in todo
            Au.auto_free[]
            if [ index_cancel || tok_bytes >= tok_most[] ] break
            fp : path fs
            if [ !fp || !fp.exists[] ] continue
            if [ tok_binary[ fp ] ] continue
            mt : fp.modified_time[]
            tok_lock.lock[]
            tb : TokBloom tok_cache[ fs ]
            tok_lock.unlock[]
            if [ tb && tb.mt == mt ] continue
            c : string [ fp.load[ typeid[string], null ] ]
            # 300k of text is a big source file: past that the search
            # reads it, rather than the index carrying it
            if [ !c || c.count == 0 || c.count > 307200 ] continue
            # a nul byte in the head: binary that the extension missed
            nb : bool [ false ]
            lim : i32 [ (c.count < 1024) ? c.count : 1024 ]
            for [ i9: i32 0, i9 < lim, i9 += 1 ]
                if [ c[ i9 ] == 0 ] nb = true
            if [ nb ] continue
            tok_pass[ fs, mt, c, 0 ]
        drop[ todo ]

    func index_work [ dirs: vec path :: o: orbiter ] -> none
        stack : vec path []
        repos : vec path []
        later : vec path []
        # auto_free drains this thread's pool per directory: hold them
        hold[ stack ]
        hold[ repos ]
        hold[ later ]
        cap : i32 [ (o.max_search > 0) ? o.max_search : 400000 ]
        for [ r: path ] in dirs
            g0 : path '{r}/.git'
            if [ g0.exists[] ]
                o.index_repo[ r, cap ]
            el
                stack.push[ r ]
            # the checkouts beside the sources (the imports' clones):
            # git ignores them, so they are listed here, after
            # everything of ours; a search reaches them only with
            # [remotes] lit
            ck : path '{r}/checkout'
            ckl : ck.ls[ null, false ]
            if [ ckl ]
                for [ j: i32 0, j < ckl.count, j += 1 ]
                    ce : path ckl[j]
                    if [ !ce.is_dir[] || ce.is_symlink[] ] continue
                    cg : path '{ce}/.git'
                    if [ cg.exists[] ] repos.push[ ce ]
                    el                  later.push[ ce ]
        while [ !o.index_cancel ]
            if [ stack.count == 0 ]
                # main tree exhausted → deferred repositories, by
                # ls-files, then the checkouts that are plain folders
                if [ repos.count == 0 ]
                    if [ later.count == 0 ] break
                    for [ lp: path ] in later
                        stack.push[ lp ]
                    later.clear[]
                    continue
                for [ rp: path ] in repos
                    if [ !o.index_cancel ] o.index_repo[ rp, cap ]
                repos.clear[]
                continue
            n : i32 [ stack.count - 1 ]
            d : path hold[ stack[n] ]
            stack.remove[ n ]
            entries : d.ls[ null, false ]
            drop[ d ]
            if [ entries ]
                found : vec path []
                for [ i: i32 0, i < entries.count, i += 1 ]
                    e : path entries[i]
                    if [ e.is_dir[] ]
                        dn : string e.filename[]
                        if [ dn == 'checkout' || dn == '.git' ]
                            continue
                        gp : path '{e}/.git'
                        if [ gp.exists[] ]
                            # a repository inside the checkouts is one
                            # of them
                            es : string '{e}'
                            if [
                                o.search_external
                                || es.index_of[ '/checkout/' ] >= 0 ]
                                repos.push[ e ]
                        el
                            stack.push[ e ]
                    el
                        found.push[ e ]
                if [ found.count > 0 ]
                    o.index_lock.lock[]
                    for [ f: path ] in found
                        o.file_index.push[ f ]
                    over : bool [ o.file_index.count >= cap ]
                    o.index_lock.unlock[]
                    if [ over ] break
            # this thread's pool: the walk's temporaries, per directory
            Au.auto_free[]
        drop[ stack ]
        drop[ repos ]
        drop[ later ]
        o.tok_warm[]
        Au.auto_free[]
        o.index_lock.lock[]
        o.index_building = false
        o.index_lock.unlock[]

    func start_watching []
        for [ d: path ] in search_dirs
            iw : watch [ res: d, callback: lambda on_index_change[ a ] ]
            iw.start[]
            index_watches += iw
        # the startup directory is part of the changed-files aggregate
        # even when the finder searches docked checkouts only: watch it
        # too
        pr9 : path project_root[]
        seen9 : bool [ false ]
        for [ d: path ] in search_dirs
            if [ '{d}' == '{pr9}' ] seen9 = true
        if [ !seen9 ]
            gw : watch [ res: pr9,
                         callback: lambda on_index_change[ a ] ]
            gw.start[]
            index_watches += gw

    # what the finder searches: every docked checkout, else this
    # project. fills search_dirs in place (the paths must be held by the
    # member, and this is the shape that holds them)
    func root_search []
        r0 : path project_root[]
        rs0 : string '{r0}'
        if [ r0 ] search_dirs += r0
        if [ docked_repos ]
            for [ nm: string ] in docked_repos
                if [ !repo_local[ nm ] ] continue
                r : path repo_dir[ nm ]
                if [ !r ] continue
                rs9 : string '{r}'
                if [ rs9.compare[ rs0 ] == 0 ] continue
                search_dirs += r

    # the roots the finder would search now, as strings, to tell a
    # change
    func root_names [] -> string
        out : string ''
        n9 : i32 [ 0 ]
        if [ docked_repos ]
            for [ nm: string ] in docked_repos
                if [ !repo_local[ nm ] ] continue
                r : path repo_dir[ nm ]
                out = '{out}|{r}'
                n9 += 1
        if [ n9 == 0 ]
            r0 : path project_root[]
            out = '|{r0}'
        return out

    func repo_docked [ name: string ] -> bool
        if [ !docked_repos ] return false
        for [ nm: string ] in docked_repos
            if [ nm.compare[ name ] == 0 ] return true
        return false

    # dock or undock a checkout: the search re-roots over the set
    func repo_dock_toggle [ name: string ]
        if [ !docked_repos ] docked_repos = vec string []
        found : bool false
        for [ i: i32 0, i < docked_repos.count, i += 1 ]
            if [ docked_repos[i].compare[ name ] == 0 ]
                docked_repos.remove[ i ]
                found = true
                break
        if [ !found ] docked_repos.push[ name ]
        save_session[]
        reroot_index[]
        # the changed-files aggregate follows the selection now: scan at
        # once, or on the first frame the running scan leaves free (the
        # frame loop takes a dirty mark with no wait when git_last is 0)
        git_dirty = true
        git_last  = 0
        git_summarize[]
        if [ ux ] ux.restyle = true

    func reroot_index []
        # already rooted there → nothing to do
        want : string root_names[]
        have : string ''
        if [ search_dirs ]
            for [ i: i32 0, i < search_dirs.count, i += 1 ]
                have = '{have}|{search_dirs[i]}'
        if [ want.compare[ have ] == 0 ] return
        # the old watches stay in the list, paused: dropping a watch
        # object corrupts the heap (its callback and resource go with it
        # while the runner may still hold them), so the few leaked are
        # the safe choice
        if [ index_watches ]
            for [ iw: watch ] in index_watches
                iw.pause[]
        if [ !index_watches ] index_watches = vec watch []
        search_dirs   = vec path []
        root_search[]
        start_index[]
        start_watching[]
        if [ find_text && find_text.count > 0 ] index_research = true

    func on_index_change [ changed: Au :: o: orbiter ] -> none
        o.index_dirty = true
        # the changed-files scan reruns on a real change, not on a timer
        o.git_dirty   = true

    public func on_unload [ ]
        # a take still transcribing runs speech's code on its thread:
        # this unload (a quit or a reload) would unmap it under the
        # thread
        dictation_wait[ 60000 ]
        save_session[]
        if [ debuggers ]
            # a reload keeps a hosted app's session: the host holds it
            # parked across the swap and the reloaded orbiter adopts it,
            # a stop and all
            reloading : bool [ getenv[ 'SILVER_RELOAD_SAVE' ] != null ]
            for [ d: dbg, name: string ] in debuggers
                if [ !d || !d.active ] continue
                ks : i32 [ -1 ]
                if [ reloading && instances ]
                    for [ av9: AppView ] in instances
                        if [ av9.debugger == d && av9.slot > 0 ]
                            ks = av9.slot
                if [ ks > 0 ]
                    d.park[]
                    d.hold[]
                    host_keep[ 'dbg{ks}', d ]
                el d.stop[]
            debuggers = null
        if [ index_watches ]
            for [ iw: watch ] in index_watches
                iw.pause[ ]
                # the callback's context is this instance: a paused
                # watch kept it alive, and the whole tree with it
                iw.callback = null
        if [ build_watch ]
            build_watch.pause[ ]
            build_watch.callback = null
        index_cancel = true
        # the worker owns file_index until it exits — join before
        # freeing
        while [ index_building ]
            usleep[ 1000 ]
        index_task   = null
        # the summarize runs this module's code on its own thread, and
        # the attach jobs on the pool: a swap under them unmaps the code
        # mid-run
        if [ git_live ]
            pthread_join[ git_tid, null ]
            git_live = false
        attach_tasks = null
        # a quit leaves the lists to the process's end; a reload frees
        if [ getenv[ 'SILVER_RELOAD_SAVE' ] != null ]
            index_lock.lock[]
            file_index   = list string []
            index_lock.unlock[]
            find_results = list string []
            ed_sessions  = map ConsoleSession [string] [ ]
        super.on_unload[ ]

    # the programs the search lists: orbiter-os's PATH, read once
    func program_list [] -> map string [string]
        if [ !system_on[] ]
            if [ !programs ] programs = map string [string] []
            return programs
        pc : cstr [ getenv[ "PATH" ] ]
        all : string [ (pc == null) ? '' : string[ pc ] ]
        at : i64 [ 0 ]
        for [ dir: string ] in all.split[ ':' ]
            if [ dir.count == 0 ] continue
            dp : path [ dir ]
            if [ dp.exists[] ] at += dp.modified_time[]
        if [ programs && at == programs_at ] return programs
        programs_at = at
        programs = map string [string] []
        for [ dir: string ] in all.split[ ':' ]
            if [ dir.count == 0 ] continue
            d : path [ dir ]
            entries : d.ls[ null, false ]
            if [ !entries ] continue
            for [ e: path ] in entries
                nm : string e.filename[]
                if [ programs.contains[ nm ] || e.is_dir[] ] continue
                full : '{e}'
                if [ access[ full.chars, X_OK ] == 0 ]
                    programs[ nm ] = full
        return programs

    # the programs' fontconfig: the system's, our fonts folder, and
    # Barlow Condensed for the interface families (monospace kept)
    func write_fonts_conf [] -> string
        rt : path.path_startup[]
        out : '{rt}/install/tmp/orbiter-fonts.conf'
        fd : path 'fonts'
        fa : string '{fd.absolute[]}'
        fam : vec string [] [ 'sans-serif', 'sans', 'Ubuntu',
            'Ubuntu Sans', 'Cantarell', 'DejaVu Sans', 'Noto Sans',
            'system-ui' ]
        tx : '<?xml version="1.0"?>\n'
        tx = '{tx}<!DOCTYPE fontconfig SYSTEM "urn:fontconfig:fonts.dtd">\n'
        tx = '{tx}<fontconfig>\n'
        tx = '{tx}  <include ignore_missing="yes">/etc/fonts/fonts.conf</include>\n'
        tx = '{tx}  <dir>{fa}</dir>\n'
        for [ f9: string ] in fam
            tx = '{tx}  <match target="pattern">\n'
            tx = '{tx}    <test name="family"><string>{f9}</string></test>\n'
            tx = '{tx}    <edit name="family" mode="assign" binding="strong"><string>Barlow Condensed</string></edit>\n'
            tx = '{tx}  </match>\n'
        tx = '{tx}</fontconfig>\n'
        fh : handle fopen[ out.chars, 'w' ]
        if [ !fh ] return ''
        fputs[ tx.chars, fh ]
        fclose[ fh ]
        return out

    # os-mode: orbiter's Wayland display, started once; each new
    # window goes to a pane; true when a pane's window changed
    func wl_tick [] -> bool
        if [ !wl_tried ]
            wl_tried = true
            wl_sock  = ''
            pane_win = vec u64 []
            placed_win  = vec u64 []
            placed_pane = vec i32 []
            pane_sheet  = vec u64 []
            if [ wlc_create[ 1280, 800 ] == 0 ]
                log 'orbiter: the Wayland display did not start'
                return false
            wl_sock = string[ wlc_socket[] ]
            # trinity apps orbiter hosts stay off it: only the
            # console's programs are given it
            unsetenv[ 'WAYLAND_DISPLAY' ]
            wl_fonts = write_fonts_conf[]
            log 'orbiter: Wayland display {wl_sock}'
        if [ wl_sock.count == 0 ] return false
        wlc_pump[]
        changed : false
        n : i32 wlc_window_count[]
        for [ i: i32 0, i < n, i += 1 ]
            wn : u64 wlc_window_at[ i ]
            if [ wn > win_seen ]
                win_seen = wn
                place_window[ wn ]
                changed = true
        # a closed window gives its pane back: to the window it covered
        # (an about box over its app), else to nothing
        for [ i: i32 0, i < pane_win.count, i += 1 ]
            pw : u64 pane_win[ i ]
            if [ pw != 0 && wlc_window_open[ pw ] == 0 ]
                pane_win[ i ] = window_under[ i, pw ]
                changed = true
        for [ i: i32 0, i < pane_sheet.count, i += 1 ]
            ps : u64 pane_sheet[ i ]
            if [ ps != 0 && wlc_window_open[ ps ] == 0 ]
                # the dialog it covered, still open, is the sheet again
                key : string '{ps}'
                back : u64 [ 0 ]
                if [ sheet_back && sheet_back.contains[ key ] ]
                    back = u64[ sheet_back[ key ] ]
                    sheet_back.rm[ key ]
                if [ back != 0 && wlc_window_open[ back ] == 0 ]
                    back = 0
                pane_sheet[ i ] = back
                if [ back != 0 ]
                    wlc_window_focus[ back ]
                el [ pane_window[ i ] != 0 ]
                    wlc_window_focus[ pane_window[ i ] ]
                changed = true
        if [ menu_sync[] ] changed = true
        return changed

    # the active pane's window menu, read again when the window changes
    # (and each second while it has none: GTK names it after mapping)
    func menu_sync [] -> bool
        wn : u64 pane_window[ active_pane ]
        if [ wn == 0 ] return own_menu_sync[]
        menu_own = null
        now : i64 [ epoch_millis[] ]
        empty : bool [ !menu_items || menu_items.count == 0 ]
        # the window gave none yet (it builds its menu after mapping):
        # asked again each second; the pane's own entries do not count
        stale : bool [ menu_got == 0 && wn != 0
                       && now - menu_ms > 1000 ]
        if [ wn == menu_win && !stale ] return false
        had : bool [ !empty ]
        menu_win = wn
        menu_ms  = now
        menu_top = -1
        menu_items = menu_read[ wn ]
        menu_got = i32[ menu_items.count ]
        return had || menu_items.count > 0

    # the pane's app without a window menu (a trinity app): one menu
    # named for it, of ours; read again when the app or its view moves
    func own_menu_sync [] -> bool
        ed : Editor pane_at[ active_pane ]
        av : AppView (ed) ? ed.run_view : null
        pc : string [ (active_pane < pane_console.count)
                      ? pane_console[ active_pane ] : '' ]
        key : string [ (av) ? '{av.iid}:{ed.app_view}:{pc}'
                       : ((pc.count > 0) ? pc : '') ]
        if [ menu_win == 0 && menu_own && menu_own == key ] return false
        had : bool [ menu_items && menu_items.count > 0 ]
        menu_win = 0
        menu_own = key
        menu_top = -1
        menu_items = vec TrayEntry []
        if [ pc.starts_with[ 'home:' ] ]
            menu_items = agent_menu[ pc.mid[ 5, pc.count - 5 ] ]
        el [ av ]
            menu_items = own_menu[ av, ed.app_view ]
        return had || menu_items.count > 0

    func own_entry [ label: string, act: string, depth: i32 ]
                     -> TrayEntry
        return TrayEntry [ label: label, action: act, depth: depth,
            enabled: true, check: -1 ]

    func own_menu [ av: AppView, shown: bool ] -> vec TrayEntry
        m : vec TrayEntry []
        m.push[ own_entry[ app_name[ av ], '', 0 ] ]
        # an agent app: the agents view's instances, each the same
        # terminal shown here
        if [ av.agent && home_order && home_order.count > 0 ]
            ed : Editor pane_at[ active_pane ]
            pc : string [ (ed && ed.pane_index < pane_console.count)
                          ? pane_console[ ed.pane_index ] : '' ]
            for [ nm: string ] in home_order
                if [ !home_session[ nm ] ] continue
                md : string home_model_of[ nm ]
                ie : TrayEntry own_entry[
                    (md.count > 0) ? '{nm}  {md}' : nm,
                    'orb.agent:{nm}', 1 ]
                ie.check = (pc == 'home:{nm}') ? 1 : 0
                m.push[ ie ]
            m.push[ TrayEntry [ rule: true, depth: 1, check: -1 ] ]
        # only a resource default takes content
        dp : Prop default_prop[ av.module_name[] ]
        if [ dp && dp.access == 'default' && dp.type == 'resource' ]
            m.push[ own_entry[ 'Load content…', 'orb.load', 1 ] ]
        # the app's properties (its own answer, else its module's
        # export): one group of rows, each value at its right
        lp : LaunchProps []
        am : string av.app_mod
        sp : string [ (av.props && av.props.count > 0) ? av.props
            : module_spec[ (am && am.count > 0) ? am : av.src.stem[] ] ]
        if [ sp && sp.count > 0 ] Au.parse_agi[ null, sp.chars, lp ]
        prop_rows[ m, av, lp ]
        # the app's own views (its orbiter bar's chips)
        if [ av.app_views && av.app_views.count > 0 ]
            m.push[ TrayEntry [ rule: true, depth: 1, check: -1 ] ]
            for [ vi: i32 0, vi < av.app_views.count, vi += 1 ]
                ve : TrayEntry own_entry[ menu_words[ av.app_views[ vi ] ],
                    'orb.aview:{vi}', 1 ]
                ve.check = (shown && av.app_view_on == vi) ? 1 : 0
                m.push[ ve ]
        # the app's own Actions to call
        mine : vec TrayEntry []
        if [ lp.props ]
            for [ q: Prop ] in lp.props
                if [ q.type == 'func' ]
                    mine.push[ own_entry[ menu_words[ q.ident ],
                        'orb.call:{q.ident}', 1 ] ]
        if [ mine.count > 0 ]
            m.push[ TrayEntry [ rule: true, depth: 1, check: -1 ] ]
            for [ e: TrayEntry ] in mine
                m.push[ e ]
        m.push[ TrayEntry [ rule: true, depth: 1, check: -1 ] ]
        # not running: it starts; running: it quits
        live : bool [ !av.ended && !av.held && av.slot >= 0 ]
        m.push[ (live) ? own_entry[ 'Quit', 'orb.quit', 1 ]
            : own_entry[ 'Run', 'orb.run', 1 ] ]
        return m

    # the properties as menu rows between rules: the build switches
    # and the pid (orbiter's), then each prop, its value at the right
    # (a Live switch checks)
    func prop_rows [ m: vec TrayEntry, av: AppView, lp: LaunchProps ]
        m.push[ TrayEntry [ rule: true, depth: 1, check: -1 ] ]
        db : TrayEntry own_entry[ 'debug', 'orb.pdebug', 1 ]
        db.check = (av.debug_build) ? 1 : 0
        m.push[ db ]
        cv : TrayEntry own_entry[ 'coverage', 'orb.pcov', 1 ]
        cv.check = (av.cov_build) ? 1 : 0
        cv.side = 'clear'
        cv.side_action = 'orb.pcovclear'
        m.push[ cv ]
        up : bool [ av.slot >= 0 && !av.ended && !av.held ]
        pd : i32 [ (up) ? host_app_pid[ av.slot ] : 0 ]
        pe : TrayEntry own_entry[ 'pid', 'orb.pnone', 1 ]
        pe.keys = (pd > 0) ? '{pd}' : '-'
        m.push[ pe ]
        if [ lp.props ]
            for [ q: Prop ] in lp.props
                if [ q.type == 'func' ] continue
                re : TrayEntry own_entry[ q.ident, 'orb.pnone', 1 ]
                vt : string [ (q.value) ? q.value : '' ]
                if [ q.type == 'bool' ]
                    re.check = (vt == 'true') ? 1 : 0
                    if [ prop_live[ q ] ]
                        re.action = 'orb.set:{q.ident}'
                el [ q.type == 'path' || q.type == 'resource' ]
                    named : path [ vt ]
                    re.keys = (vt.count > 0) ? named.filename[] : '-'
                el
                    re.keys = vt
                m.push[ re ]
        m.push[ TrayEntry [ rule: true, depth: 1, check: -1 ] ]

    # a member's name as a menu says it: save_state -> Save state
    func menu_words [ id: string ] -> string
        out : string ''
        for [ i: i32 0, i < id.count, i += 1 ]
            c : i32 [ id.chars[ i ] ]
            if [ c == 95 ] out = out + ' '
            el [ i == 0 && c >= 97 && c <= 122 ]
                out = out + id.mid[ 0, 1 ].ucase[]
            el out = out + id.mid[ i, 1 ]
        return out

    func prop_live [ q: Prop ] -> bool
        if [ !q.meta ] return false
        for [ mm: string ] in q.meta
            if [ mm == 'Live' ] return true
        return false

    # one of our own entries chosen
    func own_pick [ e: TrayEntry ]
        ed : Editor pane_at[ active_pane ]
        # its module built again (clean: from nothing), in its console
        if [ e.action == 'orb.build' || e.action == 'orb.clean' ]
            md : path app_module[]
            if [ md ]
                install_start[ AppEntry [ name: md.filename[], file: md,
                    module: true ], e.action == 'orb.clean' ]
            return
        # an agents view instance: its terminal in this pane
        if [ e.action.starts_with[ 'orb.agent:' ] ]
            home_in_pane[ e.action.mid[ 10, e.action.count - 10 ],
                          active_pane ]
            return
        # a new instance of the agent, shown here
        if [ e.action.starts_with[ 'orb.agent_new:' ] ]
            nn : string home_new[ e.action.mid[ 14,
                                              e.action.count - 14 ] ]
            if [ nn.count > 0 ] home_in_pane[ nn, active_pane ]
            return
        # the file's menu: the pane itself
        if [ e.action == 'orb.pane_add' ]
            pane_add[]
            return
        if [ e.action == 'orb.pane_close' ]
            if [ ed ] close_pane[ ed.pane_index ]
            return
        if [ e.action == 'orb.git' && ed ]
            ed.git_on = !ed.git_on
            if [ ed.git_on ] set_pane_view[ ed, 'git' ]
            el [ ed.view_name == 'git' ] set_pane_view[ ed, '' ]
            ed.ghost_hunk = -1
            ed.pristine   = false
            force_update[]
            return
        # the switch: the pane's code, or one of its app's instances
        # an instance's Code: its source in the pane, the instance
        # its own (its debug session), not its window
        if [ e.action.starts_with[ 'orb.code:' ] && ed ]
            cav : AppView instance_by[ i32[ e.action.mid[ 9,
                e.action.count - 9 ] ] ]
            if [ cav ]
                show_instance[ cav.iid, active_pane ]
                # a viewer's pane holds no file: its own source opens,
                # the module it came from, its document, else its own
                own : path [ (cav.origin) ? cav.origin
                    : ((cav.viewer && cav.doc) ? cav.doc : cav.src) ]
                if [ cav.viewer && !ed.src && own && own.exists[] ]
                    open_in_pane[ own, active_pane ]
                pending_code = pending_show > 0
                ed.app_view = false
                ed.pristine = false
            force_update[]
            return
        # a new instance: held, then played here as Run does
        if [ e.action == 'orb.inst_new' && ed ]
            ed.start_instance[ false ]
            pending_run = ed.pane_index
            force_update[]
            return
        # the instance's own row: it comes into view, embedded, as a
        # task button's click brings it
        if [ e.action.starts_with[ 'orb.inst:' ] ]
            pick_instance[ i32[ e.action.mid[ 9,
                e.action.count - 9 ] ], active_pane ]
            force_update[]
            return
        if [ e.action.starts_with[ 'orb.pview:' ] && ed ]
            vn : string e.action.mid[ 10, e.action.count - 10 ]
            set_pane_view[ ed, (vn == ed.resolve_view[]) ? '' : vn ]
            force_update[]
            return
        # in the pane, as at startup: an app never run has no instance
        if [ e.action == 'orb.run' ]
            if [ ed ] pending_run = ed.pane_index
            return
        av : AppView (ed) ? ed.run_view : null
        if [ !av ] return
        # one of the app's own views; the lit one again: its source
        if [ e.action.starts_with[ 'orb.aview:' ] ]
            vi : i32 [ e.action.mid[ 10, e.action.count - 10 ] ]
            lit : bool [ ed.app_view && av.app_view_on == vi ]
            if [ !ed.app_view ] embed_app[ ed, av ]
            if [ av.slot >= 0 && !av.ended ]
                host_post2[ av.slot, 1, i32[ HM.view ],
                            (lit) ? -1 : vi, 0, 0 ]
            return
        if [ e.action == 'orb.view' ]
            if [ ed.app_view ] ed.app_view = false
            el embed_app[ ed, av ]
        el [ e.action == 'orb.shot' ]
            copy_shot[ av ]
        el [ e.action == 'orb.load' ]
            # the finder on the resource's folder; the pick goes to the
            # running app, as a press on its title
            cur : string (av.arg_text) ? av.arg_text : ''
            pick_default[ ed, null, band_mod_of[ ed ], cur ]
        el [ e.action == 'orb.quit' ]
            close_task[ av ]
        el [ e.action.starts_with[ 'orb.call:' ] ]
            nm : string e.action.mid[ 9, e.action.count - 9 ]
            agent_sock_send[ av.sock_name[].chars, 'call {nm}\n' ]
        el [ e.action == 'orb.pdebug' ]
            av.debug_build = !av.debug_build
            session_dirty = true
        el [ e.action == 'orb.pcov' ]
            av.cov_build = !av.cov_build
            session_dirty = true
        el [ e.action == 'orb.pcovclear' ]
            cc : string '{cov_file[]}'
            remove[ cc.chars ]
            cov_poll[]
        el [ e.action.starts_with[ 'orb.set:' ] ]
            nm : string e.action.mid[ 8, e.action.count - 8 ]
            to : string [ (e.check == 1) ? 'false' : 'true' ]
            agent_sock_send[ av.sock_name[].chars, 'set {nm} {to}\n' ]
            # the next props answer shows it; until then, ours
            av.props_ak = 0

    # the app's own frame (its texture, not orbiter's screen), to a
    # png beside our cache and onto the clipboard
    func copy_shot [ av: AppView ]
        if [ !ux || !av ] return
        tx : Texture av.front[]
        if [ !tx ]
            log 'screenshot: {instance_name[ av ]} has no frame yet'
            return
        im : Image [ tx ]
        if [ !im ] return
        dir : path '{path.path_cache[ 'orbiter' ]}/shots'
        dir.make_dir[]
        p : path '{dir}/{instance_name[ av ]}-{epoch_millis[]}.png'
        im.png[ p ]
        ok : bool ux.copy_picture[ p ]
        log 'screenshot: {p} on the clipboard {ok}'

    # the active pane's app's module folder: a hosted app's own, a
    # program's under featured/ or at silver's root; null for none
    func app_module [] -> path
        root : string '{path.path_startup[]}'
        pn : string window_program[ active_pane ]
        if [ pn.count > 0 ]
            fm : path '{root}/featured/{pn}/{pn}.ag'
            if [ fm.exists[] ] return fm.directory[]
            rm : path '{root}/{pn}/{pn}.ag'
            if [ rm.exists[] ] return rm.directory[]
            return null
        ed : Editor pane_at[ active_pane ]
        av : AppView (ed) ? ed.run_view : null
        return (av && av.src) ? av.src.directory[] : null

    func menu_read [ wn: u64 ] -> vec TrayEntry
        if [ wn == 0 ] return vec TrayEntry []
        k : i32 wlc_window_menu_kind[ wn ]
        if [ k == 0 ] return sock_menu[ wn ]
        return app_menu[].read[ k, string[ wlc_window_menu_bus[ wn ] ],
            string[ wlc_window_menu_path[ wn ] ],
            string[ wlc_window_menu_app[ wn ] ],
            string[ wlc_window_menu_win[ wn ] ] ]

    # the exchange's slideout: from the dock's edge under the system
    # bar, to the window's right edge
    func exchange_box [] -> string
        tp : string [ (system_on[]) ? 't0.91' : 't0' ]
        return 'l0 {tp} r0 b0'

    # the drawer opens on a menu; the same one again shuts it
    # the bar's menu at: read fresh (enabled entries, check marks; no
    # window, our own menu for the app) with the pane's controls under
    # it; the same one again shuts it
    # the desktop's menu (orbiter, the welcome app): the system menu
    # (views, power, sound, Wi-Fi, the tray)
    func desk_menu_open []
        drawer_toggle[ 'system', drawer_open && menu_kind == 'system' ]

    func menu_open_at [ at: i32, same: bool ]
        menu_top = at
        if [ menu_win != 0 ]
            menu_items = menu_read[ menu_win ]
            menu_got = i32[ menu_items.count ]
        el
            menu_own = null
            own_menu_sync[]
            menu_top = at
        pane_menu[]
        drawer_toggle[ 'menu', same ]

    # a menu open: the pointer onto another name opens that one
    func menu_hover [ mt: MenuTop ]
        if [ !drawer_open || menu_kind != 'menu' ] return
        if [ mt.pane != active_pane || mt.close_part
             || mt.at == menu_top ] return
        menu_open_at[ mt.at, false ]

    func drawer_toggle [ kind: string, same: bool ]
        # another menu: the exchange's slideout is put away (kept)
        if [ ux && ux.shot_ask && !ux.agent_min
             && ux.exchange_region && ux.exchange_region.count > 0 ]
            ux.agent_min = true
            ux.restyle   = true
        if [ drawer_open && menu_kind == kind && same ]
            drawer_shut[]
            return
        drawer_open  = true
        menu_kind    = kind
        drawer_fresh = false
        menu_filter  = ''
        drawer_focus = true
        if [ ux ] ux.restyle = true

    func drawer_shut []
        if [ !drawer_open ] return
        drawer_open    = false
        menu_filter  = ''
        menu_shut_ms = epoch_millis[]
        if [ ux ] ux.restyle = true

    # the screen as drawn so far, blurred: once as the drawer opens,
    # again only for a new window size
    func drawer_blur [ w: Window, live: bool ] -> ReduceBlur
        sc : Canvas w.screen
        if [ !sc || !sc.color ] return null
        tx : Texture sc.color
        if [ !drawer_snap ]
            drawer_snap = Texture [ vk: w.vk, w: w, width: tx.width,
                height: tx.height, vk_format: tx.vk_format ]
            drawer_rb = ReduceBlur []
            drawer_rb.build[ vk_context[ w.vk ], w, drawer_snap, 1.0, 2 ]
            drawer_fresh = false
        el [ drawer_snap.width != tx.width
             || drawer_snap.height != tx.height ]
            drawer_snap.resize[ tx.width, tx.height ]
            drawer_rb.resize[ drawer_snap ]
            drawer_fresh = false
        if [ drawer_fresh && !live ] return drawer_rb
        drawer_fresh = true
        sc.sync_fence[]
        w.vk.copy_image[ tx, drawer_snap ]
        drawer_rb.run[]
        return drawer_rb

    # mounted while open, and while it slides away
    func drawer_on [] -> bool
        return drawer_open || epoch_millis[] - menu_shut_ms < 400

    func drawer_els [] -> Elements
        t : Elements []
        if [ menu_kind == 'tray' ]
            t['tray_panel'] = TrayPanel [ filter: menu_filter,
                area: Region { l0 t0 r0 b0 } ]
        el
            t['menu_panel'] = MenuPanel [ items: menu_items,
                top: menu_top, filter: menu_filter,
                area: Region { l0 t0 r0 b0 } ]
        return t

    # Enter in the drawer: the first entry the filter shows runs
    func drawer_enter []
        if [ menu_kind == 'system' ] return
        if [ menu_kind == 'tray' ]
            tr : Tray tray_shared[]
            it : TrayItem tr.shown_item[]
            if [ !it ] return
            for [ e: TrayEntry ] in it.entries
                if [ e.enabled && !e.rule
                     && entry_matches[ e, menu_filter ] ]
                    tr.pick[ it, e ]
                    drawer_shut[]
                    return
            return
        if [ !menu_items ] return
        for [ i: i32 menu_top + 1, i < menu_items.count, i += 1 ]
            e : TrayEntry menu_items[ i ]
            if [ e.depth <= 0 ] break
            deeper : bool [ i + 1 < menu_items.count
                && menu_items[ i + 1 ].depth > e.depth ]
            if [ !deeper && e.enabled && !e.rule
                 && entry_matches[ e, menu_filter ] ]
                menu_pick[ i ]
                return
        return t

    # an entry chosen in the drawer: it runs; the drawer shuts
    # an entry's second part (an instance's Code): its own action
    # a program that serves its menu itself (VS Code, patched): on
    # trinity-menu-<pid>, a line an item: depth, flags, keys, label
    func sock_menu [ wn: u64 ] -> vec TrayEntry
        out : vec TrayEntry []
        pid : i32 wlc_window_pid[ wn ]
        if [ pid <= 0 ] return out
        nm : string 'menu-{pid}'
        buf : local i8 [ 65536 ]
        if [ agent_sock_ask_block[ nm.chars, 'menu\n', @buf[0],
                                   65536 ] <= 0 ] return out
        tx : string [ @buf[0] ]
        at : i32 [ 0 ]
        for [ ln: string ] in tx.split[ '\n' ]
            ws : vec string ln.split[ '\t' ]
            if [ ws.count < 4 ] continue
            fl : string ws[ 1 ]
            ck : i32 [ (fl.index_of[ 'C' ] >= 0) ? 1
                : ((fl.index_of[ 'c' ] >= 0) ? 0 : -1) ]
            rl : bool [ fl.index_of[ 'r' ] >= 0 ]
            out.push[ TrayEntry [ label: (rl) ? '' : ws[ 3 ],
                depth: i32[ ws[ 0 ].integer_value[] ], rule: rl,
                enabled: fl.index_of[ 'd' ] < 0, check: ck,
                action: 'sock.{pid}.{at}', target: '',
                keys: (ws[ 2 ] != '-') ? ws[ 2 ] : '' ] ]
            at += 1
        return out

    func menu_pick_side [ i: i32 ]
        if [ !menu_items || i < 0 || i >= menu_items.count ] return
        pe : TrayEntry menu_items[ i ]
        if [ !pe.side_action ] return
        own_pick[ own_entry[ pe.side, pe.side_action, pe.depth ] ]
        # coverage's clear: a property row, the menu stays open
        if [ pe.side_action == 'orb.pcovclear' ]
            if [ ux ] ux.restyle = true
            return
        drawer_shut[]
        menu_own = null
        if [ ux ] ux.restyle = true

    func menu_pick [ i: i32 ]
        if [ !menu_items || i < 0 || i >= menu_items.count ] return
        pe : TrayEntry menu_items[ i ]
        # a menu the program serves itself: the click goes back to it
        if [ pe.action && pe.action.starts_with[ 'sock.' ] ]
            ws : vec string pe.action.split[ '.' ]
            if [ ws.count == 3 ]
                nm : string 'menu-{ws[ 1 ]}'
                cl : string 'click {ws[ 2 ]}\n'
                agent_sock_send[ nm.chars, cl.chars ]
            drawer_shut[]
            menu_ms  = 0
            menu_win = 0
            if [ ux ] ux.restyle = true
            return
        # a property row: set, the menu stays open
        pa : string [ (pe.action) ? pe.action : '' ]
        if [ pa == 'orb.pnone' || pa == 'orb.pdebug' || pa == 'orb.pcov'
             || pa.starts_with[ 'orb.set:' ] ]
            if [ pa != 'orb.pnone' ]
                own_pick[ pe ]
                if [ pe.check >= 0 ] pe.check = 1 - pe.check
            if [ ux ] ux.restyle = true
            return
        if [ pe.action && pe.action.starts_with[ 'orb.' ] ]
            own_pick[ pe ]
            drawer_shut[]
            menu_own = null
            if [ ux ] ux.restyle = true
            return
        wn : u64 menu_win
        k : i32 wlc_window_menu_kind[ wn ]
        app_menu[].click[ k, string[ wlc_window_menu_bus[ wn ] ],
            string[ wlc_window_menu_path[ wn ] ],
            string[ wlc_window_menu_app[ wn ] ],
            string[ wlc_window_menu_win[ wn ] ], menu_items[ i ] ]
        drawer_shut[]
        # its state may change (a check mark): read it again next time
        menu_ms = 0
        menu_win = 0
        if [ ux ] ux.restyle = true

    # the window's pane: the one whose app started it (its process is
    # one of the window's ancestors), else the active pane
    func place_window [ wn: u64 ]
        # a dialog is a sheet over its window's pane, not the pane's
        over : u64 wlc_window_parent[ wn ]
        if [ over != 0 ]
            for [ i: i32 0, i < pane_win.count, i += 1 ]
                # over the pane's window, or over its sheet (a confirm
                # a dialog asks): that sheet comes back as it closes
                on_sheet : bool [ i < pane_sheet.count
                                  && pane_sheet[ i ] == over ]
                if [ pane_win[ i ] != over && !on_sheet ] continue
                while [ pane_sheet.count <= i ]
                    pane_sheet.push[ u64[ 0 ] ]
                if [ on_sheet ]
                    if [ !sheet_back ] sheet_back = map i64 [string] []
                    sheet_back[ '{wn}' ] = i64[ over ]
                pane_sheet[ i ] = wn
                wlc_window_focus[ wn ]
                log 'orbiter: window {wn} a sheet over {over}'
                return
        p : i32 wlc_window_pid[ wn ]
        pane : i32 [ -1 ]
        steps : i32 [ 0 ]
        while [ p > 1 && pane < 0 && steps < 64 ]
            for [ i: i32 0, i < editor_slots.count, i += 1 ]
                ed : Editor pane_at[ i ]
                rv : AppView (ed) ? ed.run_view : null
                if [ rv && rv.slot >= 0 && host_app_pid[ rv.slot ] == p ]
                    pane = i
                    # the instance knows its window: its card shows it
                    rv.wl_window = wn
            p = parent_pid[ p ]
            steps += 1
        if [ pane < 0 ]
            pane = active_pane
            # a program that left its starter (VS Code detaches): the
            # pane's program still waiting for a window is its own
            fe : Editor pane_at[ pane ]
            fv : AppView (fe) ? fe.run_view : null
            if [ fv && fv.wl_window == 0 && program_of[ fv ].count > 0 ]
                fv.wl_window = wn
        if [ pane < 0 ] pane = 0
        while [ pane_win.count <= pane ]
            pane_win.push[ u64[ 0 ] ]
        pane_win[ pane ] = wn
        placed_win.push[ wn ]
        placed_pane.push[ pane ]
        wlc_window_focus[ wn ]
        nm : string[ wlc_window_title[ wn ] ]
        log 'orbiter: window {wn} ({nm}) in pane {pane}'

    # the last window still open that was placed in pane pi before
    # gone; its instance shows it again
    func window_under [ pi: i32, gone: u64 ] -> u64
        back : u64 [ 0 ]
        for [ i: i32 i32[ placed_win.count ] - 1, i >= 0, i -= 1 ]
            if [ placed_pane[ i ] != pi ] continue
            w : u64 placed_win[ i ]
            if [ w != gone && wlc_window_open[ w ] != 0 ]
                back = w
                break
        for [ av: AppView ] in instances
            if [ av.wl_window == gone ] av.wl_window = back
        if [ back != 0 ] wlc_window_focus[ back ]
        return back

    # the dialog over a pane's window, 0 when none
    func pane_sheet_of [ i: i32 ] -> u64
        if [ i < 0 || !pane_sheet || i >= pane_sheet.count ]
            return u64[ 0 ]
        return pane_sheet[ i ]

    # the window a pane shows, 0 when none
    func pane_window [ i: i32 ] -> u64
        if [ i < 0 || !pane_win || i >= pane_win.count ] return u64[ 0 ]
        return pane_win[ i ]

    # a process's parent, from /proc/<pid>/stat: after its ') '
    func parent_pid [ pid: i32 ] -> i32
        f : '/proc/{pid}/stat'
        fh : handle fopen[ f.chars, 'r' ]
        if [ !fh ] return 0
        b : local i8 [ 512 ]
        line : ''
        if [ fgets[ @b[0], 512, fh ] ] line = string [ @b[0] ]
        fclose[ fh ]
        at : i32 [ line.rindex_of[ ') ' ] ]
        if [ at < 0 ] return 0
        rest : line.mid[ at + 2, line.count - at - 2 ]
        words : vec string rest.split[ ' ' ]
        if [ words.count < 2 ] return 0
        return i32[ words[ 1 ].integer_value[] ]

    # a program in the console module in that pane; a window it
    # opens takes the pane
    func run_program [ p: path, pane: i32 ]
        ed : Editor pane_at[ pane ]
        if [ !ed ] return
        sock : (wl_sock) ? wl_sock : ''
        # its own fonts: orbiter's lettering is never put on a program
        ed.open_program[ '{p}', sock, '', portal_shared[].address ]

    # a program's row in the list: run, never edited
    func is_program [ p: path ] -> bool
        # the list as the search read it: no folder checks per row
        if [ !p || !programs ] return false
        ps : string '{p}'
        nm : string p.filename[]
        return programs.contains[ nm ] && programs[ nm ] == ps

    func index_search [ query: string ] -> list string
        out : list string []
        if [ index_dirty && !index_building ]
            start_index[]
        # a search during the build re-runs once the index lands
        if [ index_building ] index_research = true
        tiers   : i32 [ 32 ]
        matches : vec string []
        dists   : vec i32 []
        if [ query && query.count > 0 ]
            ql : i32 [ query.count ]
            rp : string (search_remotes) ? '' : '{project_root[]}'
            # the checkouts sit under the root but are not ours:
            # [remotes] only
            ck : string (search_remotes) ? '' : '{project_root[]}/checkout/'
            index_lock.lock[]
            for [ s: string ] in file_index
                if [ rp.count > 0 && s.index_of[ rp ] != 0 ] continue
                if [ ck.count > 0 && s.index_of[ ck ] == 0 ] continue
                ridx : i32 [ s.rindex_of[ query ] ]
                # the file's name only, never its folders
                if [ ridx <= s.rindex_of[ '/' ] ] continue
                if [ ridx >= 0 ]
                    d : i32 [ s.count - (ridx + ql) ]
                    # a name that starts with the query ranks first
                    if [ ridx > 0 && s.chars[ ridx - 1 ] == '/' ] d -= 1
                    if [ d < 0 ] d = 0
                    if [ d > tiers ] d = tiers
                    matches.push[ s ]
                    dists.push[ d ]
            index_lock.unlock[]
            # the system's programs on PATH are not listed: our apps are
            # built from silver (they also slowed every search)
            # every match is ranked; only the best 500 are listed
            for [ d: i32 0, d <= tiers && out.count < 500, d += 1 ]
                for [ i: i32 0, i < matches.count, i += 1 ]
                    if [ dists[i] == d && out.count < 500 ]
                        out.push[ matches[i] ]
        return out

    # a file pattern IS the switch: set means search all files
    func find_in_file [] -> bool
        return !pattern_text || pattern_text.count == 0

    func run_find_in_files []
        find_hits = vec FindHit []
        q : string findbar_text
        find_last_query = q
        find_last_scope = '{(pattern_text) ? pattern_text : ''}|{(search_remotes) ? 1 : 0}'
        if [ !q || q.count == 0 ]
            find_showing = false
            return
        a_slot : i32 [
            (active_pane >= 0 && active_pane < editor_slots.count)
            ? editor_slots[active_pane] : -1 ]
        p : path (a_slot >= 0 && a_slot < open_files.count) ? open_files[a_slot] : null
        scan_current : bool [ find_in_file[] && p ]
        if [ scan_current ]
            log 'FIND bail: in-file mode, p={p}'
            find_showing = false
            return
        root : path project_root[]
        find_scanned = 0
        find_seen    = 0
        find_scan_mt = 0
        find_q_run   = q
        # one word (letters, digits, underscore) searches through the
        # index; anything else reads the files as before
        if [ !tok_cache ] tok_cache = map TokBloom [string] [ ]
        find_q_word = q.count > 1
        for [ i9: i32 0, i9 < q.count, i9 += 1 ]
            if [ !tok_is_word[ i32[ q[ i9 ] ] ] ] find_q_word = false
        find_q_hash = (find_q_word) ? tok_hash[ q, 0, q.count ] : u64[
            0 ]
        find_dirs    = vec path []
        find_files   = vec path []
        find_dirs.push[ root ]
        if [ search_remotes && docked_repos ]
            for [ nm: string ] in docked_repos
                if [ !repo_local[ nm ] ] continue
                rd9 : path repo_dir[ nm ]
                if [ !rd9 ] continue
                rs9 : string '{rd9}'
                ro : string '{root}'
                if [ rs9.compare[ ro ] != 0 ] find_dirs.push[ rd9 ]
        # the indexer already holds every tracked file: take the list
        # from it and skip the directory walk entirely
        find_listed  = false
        if [ file_index && file_index.count > 0 && !index_building ]
            rp : string '{root}'
            ck : string '{root}/checkout/'
            index_lock.lock[]
            for [ fs9: string ] in file_index
                if [ !search_remotes && fs9.index_of[ rp ] != 0 ]
                    continue
                if [ !search_remotes && fs9.index_of[ ck ] == 0 ]
                    continue
                fp9 : path fs9
                find_seen += 1
                if [ glob_pass[ fp9 ] ] find_files.push[ fp9 ]
            index_lock.unlock[]
            # an index that does not cover this root answers nothing:
            # the walk still owns that case
            if [ find_seen > 0 ]
                find_dirs   = vec path []
                find_listed = true
        find_dpos    = 0
        find_pos     = 0
        find_ticks   = 0
        find_t0      = Au.epoch_millis[]
        # the first row counts while the scan runs, then names the
        # outcome
        find_head    = FindHit [ is_header: true, text: 'searching...',
                                 dir: 'within {root}', file: null ]
        find_hits.push[ find_head ]
        find_busy    = true
        find_showing = true
        if [ ux ]
            ux.will_animate = true
            ux.restyle = true
        return

    # is there a real match row, or only the header rows
    func find_has_hits [] -> bool
        if [ !find_hits ] return false
        for [ i: i32 0, i < find_hits.count, i += 1 ]
            h : FindHit find_hits[i]
            if [ h && !h.is_header ] return true
        return false

    # one slice of the scan, six milliseconds of it, then back to the
    # frame
    func find_step []
        if [ !find_busy ] return
        # the nav listing builds into these same rows: if it took them,
        # this scan has nothing left to fill
        if [
            !find_hits || find_hits.count == 0
            || find_hits[0] != find_head ]
            find_busy = false
            find_head = null
            return
        t0 : i64 [ epoch_micros[] ]
        while [ find_busy && epoch_micros[] - t0 < 6000 ]
            if [ find_dpos < find_dirs.count ]
                d : path find_dirs[ find_dpos ]
                find_dpos += 1
                entries : d.ls[ null, false ]
                if [ !entries ] continue
                for [ i: i32 0, i < entries.count, i += 1 ]
                    e : path entries[i]
                    if [ e.is_dir[] ]
                        dn : string e.filename[]
                        if [ dn == '.git' ] continue
                        # checkout holds other repos: walked only with
                        # remotes lit
                        if [ dn == 'checkout' && !search_remotes ]
                            continue
                        find_dirs.push[ e ]
                    el
                        find_seen += 1
                        if [ glob_pass[ e ] ] find_files.push[ e ]
                continue
            if [ find_pos < find_files.count ]
                f : path find_files[ find_pos ]
                find_pos += 1
                find_scanned += 1
                mt : f.modified_time[]
                if [ mt > find_scan_mt ] find_scan_mt = mt
                # a one word query goes through the index: the file's
                # bloom answers without reading it, and a miss is final
                if [ find_q_word ]
                    key9 : string '{f}'
                    tok_lock.lock[]
                    tb  : TokBloom tok_cache[ key9 ]
                    tok_lock.unlock[]
                    if [ tb && tb.mt == mt ]
                        if [ !tok_bits[ tb, find_q_hash ] ] continue
                    el
                        if [ !f.exists[] ] continue
                        c9 : string [ f.load[ typeid[string], null ] ]
                        if [ !c9 ] continue
                        if [ !tok_pass[ key9, mt, c9, find_q_hash ] ]
                            continue
                scan_file_hits[ f, find_q_run ]
                continue
            find_done[]
        if [ find_busy && find_head ]
            find_head.text = 'searching {find_scanned} files... {find_hits.count - 1} lines'
        if [ ux ]
            ux.will_animate = true
            # the rows only appear on a restyle: every few frames, not
            # each
            find_ticks += 1
            if [ !find_busy || find_ticks % 6 == 0 ] ux.restyle = true

    func find_done []
        find_busy  = false
        root : path project_root[]
        log 'FIND walk: root={root} listed={(find_listed) ? 1 : 0} seen={find_seen} scanned={find_scanned} hits={find_hits.count - 1} ms={Au.epoch_millis[] - find_t0} idx={tok_bytes} sp={search_pane[]} fbpane={findbar_pane}'
        find_dirs  = vec path []
        find_files = vec path []
        if [ find_hits.count <= 1 ]
            if [ find_head ]
                if [ find_scanned == 0 && find_seen > 0 ]
                    find_head.text = 'no file matches {pattern_text}'
                    find_head.dir  = 'of {find_seen} files within {root}'
                el
                    find_head.text = 'No results in {find_scanned} files'
                    find_head.dir  = 'within {root}'
            find_hits.push[
                FindHit [ is_header: true, text: '', file: null ] ]
        el
            # the counter row goes: the results stand on their own
            nv9 : vec FindHit []
            for [ i: i32 1, i < find_hits.count, i += 1 ]
                nv9.push[ find_hits[i] ]
            find_hits = nv9
        find_head = null
        find_showing = true
        sp : string search_pane[]
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            e : Editor pane_at[ i ]
            if [ e && sp == 'pane{i}' ]
                e.sel_line    = -1
                e.anchor_line = -1


    func str_replace_all [ s: string, find: string,
                           rep: string ] -> string                                     
        fn : i32 [
            find->count ]                                                                                
        if [ fn == 0 ]
            return s
        out : string [
            '' ]                                                                                     
        i   : i32 [
            0 ]                                                                                         
        n   : i32 [
            s->count ]                                                                                  
        while [
            i < n ]                                                                                         
            rem : string s.mid[ i, n - i ]                                                                      
            rel : i32 [
                rem.index_of[
                    find ] ]                                                                  
            if [
                rel < 0 ]                                                                                      
                out = out + rem                                                                                 
                break                                                                                           
            out = out + rem.mid[ 0,
                                 rel ] + rep                                                                 
            i   = i + rel + fn                                                                                  
        return out                                                                                              
                                                                                                                #
    # replace applies what is on screen — it never rescans
    func run_replace []                                                                                         
        q : string findbar_text                                                                                 
        if [ !q || q.count == 0 ]
            return
        r : string [
            (replace_text) ? replace_text
            : '' ]                                                       
        if [
            find_in_file[] ]                                                                                   
            replace_in_pane[ q,
                             r ]                                                                             
            return                                                                                              
        replace_in_hits[ q,
                         r ]                                                                                 
                                                                                                                #
    func replace_in_pane [ q: string,
                           r: string ]                                                               
        sp : string search_pane[]                                                                               
        ed : Editor null                                                                                        
        for [ i: i32 0, i < editor_slots.count,
              i += 1 ]                                                        
            e : Editor pane_at[
                i ]                                                                             
            if [ e && sp == 'pane{i}' ]
                ed = e
        if [ !ed ]
            ed = pane_at[ active_pane ]
        if [ !ed ]
            return
        n   : i32 [
            ed.line_count[] ]                                                                           
        cnt : i32 [
            0 ]                                                                                         
        for [ li: i32 0, li < n,
              li += 1 ]                                                                      
            ln : string ed.line_get[ li ]                                                                       
            if [ !ln || ln.index_of[ q ] < 0 ]
                continue
            ed.ed_set[ li,
                       str_replace_all[ ln, q,
                                        r ] ]                                                        
            cnt += 1                                                                                            
        log 'REPLACE in-file: {cnt} lines'                                                                     
        ed.pristine = false                                                                                     
        if [ ux ]
            ux.will_animate = true
                                                                                                                #
    # walks the surviving hits only: struck-out rows never come back
    func replace_in_hits [ q: string, r: string ]
        if [ !find_hits || find_hits.count == 0 ] return
        seen  : vec string []
        files : i32 [ 0 ]
        cnt   : i32 [ 0 ]
        skip  : i32 [ 0 ]
        for [ i: i32 0, i < find_hits.count, i += 1 ]
            h : FindHit find_hits[i]
            if [ !h || h.is_header || !h.file ] continue
            key : string '{h.file}'
            dup : bool [ false ]
            for [ s: string ] in seen
                if [ s == key ] dup = true
            if [ dup ] continue
            seen.push[ key ]
            ftext : string [ h.file.load[ typeid[string], null ] ]
            if [ !ftext ] continue
            parts : ftext.split["\n"]
            hitn  : i32 [ 0 ]
            for [ j: i32 i, j < find_hits.count, j += 1 ]
                g : FindHit find_hits[j]
                if [ !g || g.is_header || !g.file ] continue
                gk  : string '{g.file}'
                if [ gk != key ] continue
                idx : i32 [
                    g.line
                    - 1 ]                                                                        
                if [
                    idx < 0
                    || idx >= parts.count ]                                                            
                    skip += 1                                                                                   
                    continue                                                                                    
                # the scanned line must still be the file's line
                if [
                    parts[idx] != g.text ]                                                                     
                    skip += 1                                                                                   
                    continue                                                                                    
                nl : str_replace_all[ parts[idx], q, r ]
                parts[idx] = nl
                g.text     = nl
                hitn += 1                                                                                       
            if [ hitn == 0 ]
                continue
            out : string [
                '' ]                                                                                 
            for [ j: i32 0, j < parts.count,
                  j += 1 ]                                                           
                if [ j > 0 ]
                    out = out + '\n'
                out = out + parts[j]                                                                            
            fp : path '{key}'                                                                                   
            fp.save[ out, null ]
            # our own writes are not staleness — keep curation intact
            mt9 : fp.modified_time[]
            if [ mt9 > find_scan_mt ]
                find_scan_mt = mt9
            files += 1                                                                                          
            cnt   += hitn                                                                                       
        log 'REPLACE: {cnt} lines in {files} files, {skip} stale skipped'                                      
        if [ ux ] ux.will_animate = true 

    func next_match []
        sp : string search_pane[]
        ed : Editor null
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            e : Editor pane_at[ i ]
            if [ e && sp == 'pane{i}' ] ed = e
        if [ !ed ] ed = pane_at[ 0 ]
        if [ !ed || !find_hits || find_hits.count == 0 ] return
        q  : string findbar_text
        qn : i32 [ q->count ]
        if [ qn == 0 ] return
        n  : i32 [ find_hits.count ]
        cl : i32 [ ed.sel_line ]
        cc : i32 [ ed.sel_col ]
        if [ cl >= 0 && cl < n && !find_hits[ cl ].is_header ]
            ln : string find_hits[ cl ].text
            st : i32 [ cc + 1 ]
            if [ st < 0 ] st = 0
            if [ st <= ln.count - qn ]
                rem : string ln.mid[ st, ln.count - st ]
                rel : i32 [ rem.index_of[ q ] ]
                if [ rel >= 0 ]
                    reveal_match[ ed, cl, st + rel ]
                    return
        r : i32 [ cl ]
        for [ step: i32 0, step < n, step += 1 ]
            r = r + 1
            if [ r >= n ] r = 0
            h : FindHit find_hits[ r ]
            if [ h && !h.is_header ]
                ln  : string h.text
                rel : i32 [ ln.index_of[ q ] ]
                if [ rel >= 0 ]
                    reveal_match[ ed, r, rel ]
                    return

    func find_file_next []
        sp : string search_pane[]
        ed : Editor null
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            e : Editor pane_at[ i ]
            if [ e && sp == 'pane{i}' ] ed = e
        if [ !ed ] ed = pane_at[ active_pane ]
        if [ !ed ] return
        q : string findbar_text
        qn : i32 [ q->count ]
        if [ qn == 0 ] return
        n : i32 [ ed.line_count[] ]
        if [ n <= 0 ] return
        sr : i32 [ (ed.sel_line >= 0) ? ed.sel_line : 0 ]
        sc : i32 [ (ed.sel_col  >= 0) ? ed.sel_col  : -1 ]
        for [ step: i32 0, step <= n, step += 1 ]
            row   : i32 [ (sr + step) % n ]
            ln    : string ed.line_get[ row ]
            start : i32 [ (step == 0) ? (sc + 1) : 0 ]
            if [ start < 0 ] start = 0
            if [ start <= ln.count - qn ]
                rem : string ln.mid[ start, ln.count - start ]
                rel : i32 [ rem.index_of[ q ] ]
                if [ rel >= 0 ]
                    reveal_match[ ed, row, start + rel ]
                    return

    func reveal_match [ ed: Editor, row: i32, col: i32 ]
        ed.sel_line    = row
        ed.sel_col     = col
        ed.anchor_line = row
        ed.anchor_col  = col
        lh : f32 [ (ed.lh_cache > 0.0) ? ed.lh_cache : 22.0 ]
        vh : f32 [ (ed.bounds) ? ed.bounds.h : 600.0 ]
        top : f32 [ f32[ row ] * lh ]
        if [ top < ed.scroll.y || top + lh > ed.scroll.y + vh ]
            ed.scroll.y = top - vh * 0.4
            if [ ed.scroll.y < 0.0 ] ed.scroll.y = 0.0
            ed.scroll_target = ed.scroll.y
        if [ row >= 0 && row < ed.line_count[] ]
            ln  : string ed.line_get[ row ]
            cw  : f32 [ (ed.cw_cache > 0.0) ? ed.cw_cache : 8.0 ]
            qn  : i32 [ findbar_text->count ]
            mex : f32 [ f32[ ed.vis_col[ ln, col + qn ] ] * cw ]
            vw  : f32 [
                ((ed.bounds) ? ed.bounds.w : 800.0) - ed.gutter_w ]
            pad : f32 [ cw * 4.0 ]
            if [ mex + pad > vw ]
                ed.scroll.x = mex + pad - vw
            el
                ed.scroll.x = 0.0
            if [ ed.scroll.x < 0.0 ] ed.scroll.x = 0.0
        ed.pristine = false
        win : ux
        if [ win ] win.will_animate = true

    func glob_at [ pat: string, pi0: i32, str: string,
                   si0: i32 ] -> bool
        pi : i32 [ pi0 ]
        si : i32 [ si0 ]
        pn : i32 [ pat.count ]
        sn : i32 [ str.count ]
        while [ pi < pn ]
            pc : i32 [ pat[ pi ] ]
            if [ pc == 42 ]                              # '*'
                # '**' — cross '/'
                if [ pi + 1 < pn && pat[ pi + 1 ] == 42 ]
                    np : i32 [ pi + 2 ]
                    if [ np < pn && pat[ np ] == 47 ] np = np + 1
                    for [ k: i32 si, k <= sn, k += 1 ]
                        if [ glob_at[ pat, np, str, k ] ] return true
                    return false
                # single '*' — stop at '/'
                el
                    np : i32 [ pi + 1 ]
                    for [ k: i32 si, k <= sn, k += 1 ]
                        if [ glob_at[ pat, np, str, k ] ] return true
                        if [ k < sn && str[ k ] == 47 ] return false
                    return false
            el [ pc == 63 ]                             # '?'
                if [ si >= sn || str[ si ] == 47 ] return false
                pi = pi + 1
                si = si + 1
            el
                if [ si >= sn || str[ si ] != pc ] return false
                pi = pi + 1
                si = si + 1
        return si >= sn

    func glob_match [ pat: string, str: string ] -> bool
        return glob_at[ pat, 0, str, 0 ]

    func glob_pass [ e: path ] -> bool
        if [ !pattern_text || pattern_text.count == 0 ] return true
        if [ pattern_text.index_of[ '/' ] < 0 ]
            return glob_match[ pattern_text, e.filename[] ]
        es : string '{e}'
        sp : string '{startup_path}'
        if [ sp.count > 0 && es.index_of[ sp ] == 0 ]
            es = es.mid[ sp.count, es.count - sp.count ]
            if [ es.count > 0 && es[0] == '/' ]
                es = es.mid[ 1, es.count - 1 ]
        return glob_match[ pattern_text, es ]

    # resource pick: collect files whose extension the module exports,
    # from the real tree (ignoring gitignore) into pick_cache; heavy
    # build/vendor trees are skipped so the scan is fast
    func walk_resource [ dir: path ]
        entries : dir.ls[ null, false ]
        if [ !entries ] return
        for [ i: i32 0, i < entries.count, i += 1 ]
            e : path entries[i]
            if [ e.is_dir[] ]
                dn : string e.filename[]
                if [ dn == '.git' || dn == 'checkout' || dn == 'build' ]
                    continue
                if [ dn == 'platform' || dn == 'install' || dn == 'packages' ]
                    continue
                if [ dn.count > 0 && dn.chars[0] == 46 ] continue
                walk_resource[ e ]
            el
                fx : string '.{e.ext[]}'
                for [ px: string ] in pick_exts
                    if [ px == fx ]
                        pick_cache.push[ e ]
                        break

    # newest mtime in scope: newer than the scan = results stale
    func tree_mtime [ dir: path ] -> i64
        r : i64 [ 0 ]
        entries : dir.ls[ null, false ]
        if [ !entries ] return r
        for [ i: i32 0, i < entries.count, i += 1 ]
            e : path entries[i]
            if [ e.is_dir[] ]
                dn : string e.filename[]
                if [ dn == 'checkout' || dn == '.git' ] continue
                mt : tree_mtime[ e ]
                if [ mt > r ] r = mt
            el [ glob_pass[ e ] ]
                mt : e.modified_time[]
                if [ mt > r ] r = mt
        return r

    # a word char: the run that makes one token
    func tok_is_word [ c: i32 ] -> bool
        if [ c >= 97 && c <= 122 ] return true
        if [ c >= 65 && c <= 90 ]  return true
        if [ c >= 48 && c <= 57 ]  return true
        return c == 95

    # FNV-1a over the word, eight bytes at a time: the bytes pack into a
    # u64 and one multiply folds the whole group in
    func tok_hash [ s: string, i0: i32, i1: i32 ] -> u64
        h : u64 [ 14695981039346656037 ]
        i : i32 [ i0 ]
        while [ i < i1 ]
            g : u64 [ 0 ]
            n : i32 [ 0 ]
            while [ n < 8 && i < i1 ]
                g = (g << 8) | u64[ u8[ s[ i ] ] ]
                n += 1
                i += 1
            h = (h ^ g) * 1099511628211
        return h

    func tok_bits [ tb: TokBloom, hv: u64 ] -> bool
        b1 : i32 [ (hv >> 3) & u64[ tb.mask ] ]
        b2 : i32 [ (hv >> 33) & u64[ tb.mask ] ]
        w1 : u64 [ tb.w[ b1 >> 6 ] ]
        if [ (w1 & (u64[1] << u64[ b1 & 63 ])) == 0 ] return false
        w2 : u64 [ tb.w[ b2 >> 6 ] ]
        return (w2 & (u64[1] << u64[ b2 & 63 ])) != 0

    func tok_mark [ tb: TokBloom, hv: u64 ]
        b1 : i32 [ (hv >> 3) & u64[ tb.mask ] ]
        b2 : i32 [ (hv >> 33) & u64[ tb.mask ] ]
        tb.w[ b1 >> 6 ] = tb.w[ b1 >> 6 ] | (u64[1] << u64[ b1 & 63 ])
        tb.w[ b2 >> 6 ] = tb.w[ b2 >> 6 ] | (u64[1] << u64[ b2 & 63 ])

    # one pass over the bytes: every word hashed, the query compared as
    # a number, and the file's bloom built for the next search. the
    # class test is inline here: a call per byte costs more than the
    # hashing does
    func tok_pass [ key: string, mt: i64, content: string,
                    q: u64 ] -> bool
        n    : i32 [ content.count ]
        want : i32 [ 512 ]
        est  : i32 [ n / 5 * 12 ]
        while [ want < est && want < 65536 ] want = want * 2
        tb : TokBloom [ ]
        tb.mt   = mt
        tb.mask = want - 1
        tb.w    = vec u64 []
        for [ i: i32 0, i < want / 64, i += 1 ] tb.w.push[ 0 ]
        b   : ref u8 [ cast ref u8 [ content.chars ] ]
        hit : bool [ false ]
        i   : i32 [ 0 ]
        while [ i < n ]
            c : i32 [ b[ i ] ]
            w : bool [
                (c >= 97 && c <= 122) || (c >= 65 && c <= 90)
                || (c >= 48 && c <= 57) || c == 95 ]
            if [ !w ]
                i += 1
                continue
            # the word, folded eight bytes at a time as it is read
            h : u64 [ 14695981039346656037 ]
            g : u64 [ 0 ]
            k : i32 [ 0 ]
            while [ w ]
                g = (g << 8) | u64[ c ]
                k += 1
                if [ k == 8 ]
                    h = (h ^ g) * 1099511628211
                    g = 0
                    k = 0
                i += 1
                if [ i >= n ] break
                c = i32[ b[ i ] ]
                w = (c >= 97 && c <= 122) || (c >= 65 && c <= 90) ||
                    (c >= 48 && c <= 57) || c == 95
            if [ k > 0 ] h = (h ^ g) * 1099511628211
            hv : u64 [ h ]
            if [ hv == q ] hit = true
            tok_mark[ tb, hv ]
        # 48 MB of index is plenty for a source tree; past that, files
        # are read on every search as before
        tok_lock.lock[]
        if [ n <= 307200 && tok_bytes < tok_most[] ]
            tok_cache[ key ] = tb
            tok_bytes += i64[ want / 8 ] + tok_each[]
        tok_lock.unlock[]
        return hit

    func scan_file_hits [ p: path, q: string ]
        if [ !p || !p.exists[] ] return
        content : string [ p.load[ typeid[string], null ] ]
        if [ !content ] return
        parts : content.split["\n"]
        header_added : bool [ false ]
        for [ i: i32 0, i < parts.count, i += 1 ]
            ln : string parts[i]
            if [ ln.index_of[ q ] >= 0 ]
                if [ !header_added ]
                    if [ find_hits.count > 1 ]
                        find_hits.push[
                            FindHit [ is_header: true, is_spacer: true,
                                      text: '' ] ]
                    fn  : string p.filename[]
                    drs : string '{p.directory[]}'
                    sp  : string '{startup_path}'
                    if [ sp.count > 0 && drs.index_of[ sp ] == 0 ]
                        drs = drs.mid[ sp.count, drs.count - sp.count ]
                        if [ drs.count > 0 && drs[0] == '/' ]
                            drs = drs.mid[ 1, drs.count - 1 ]
                    find_hits.push[
                        FindHit [ is_header: true, text: fn, dir: drs,
                                  file: p ] ]
                    find_hits.push[
                        FindHit [ is_header: true, text: '', file: p ] ]
                    header_added = true
                find_hits.push[
                    FindHit [ is_header: false, text: ln, file: p,
                              line: i + 1 ] ]

    func search_pane [] -> string
        win : ux
        if [ !nav_showing && !find_showing ] nav_pane = null
        if [ win && win.focus && win.focus.id == 'title' ]
            for [ e: element* win.focus, e, e = e.parent ]
                if [ e inherits EditorView ]
                    nav_pane = e.id
                    return e.id
        # a focused nav surface owns the search — NEVER pane0 fallback,
        # which flashed the surface onto the other pane for a frame
        if [ win && win.focus && win.focus inherits CommitView ]
            for [ e: element* win.focus, e, e = e.parent ]
                if [ e inherits EditorView ]
                    nav_pane = e.id
                    return e.id
        # a menu took the focus: the navigator stays where it was
        if [ nav_pane ] return nav_pane
        # an open findbar owns the search — results land in ITS pane
        if [ findbar_open && findbar_pane && findbar_pane.count > 0 ]
            return findbar_pane
        return 'pane{active_pane}'

    # modules register rail views in install/export/*.agi:
    # views: ['name': ascii|binary|agnostic] — FileType applicability
    func ensure_views []
        if [ view_tools ] return
        view_tools     = vec string []
        view_tools_bin = vec string []
        view_mods      = map string [string] []
        asc9a : vec string []
        bin9a : vec string []
        any9a : vec string []
        root : path.path_startup[]
        if [ root ]
            d : path '{root}/install/export'
            entries : d.ls[ null, false ]
            if [ entries ]
                for [ e: path ] in entries
                    views_of_agi[ e, asc9a, bin9a, any9a ]
        for [ s: string ] in asc9a
            view_tools.push[ s ]
        for [ s: string ] in bin9a
            view_tools_bin.push[ s ]
        for [ s: string ] in any9a
            view_tools.push[ s ]
            view_tools_bin.push[ s ]

    func views_of_agi [ e: path, asc: vec string, bin: vec string,
                        anyv: vec string ]
        ax : e.ext[]
        if [ !ax || !(ax == 'agi') ] return
        mod   : string e.stem[]
        ftext : string e.load[ typeid[string], null ]
        if [ !ftext ] return
        n2  : i32 [ ftext.count ]
        ls : i32 [ 0 ]
        for [ i: i32 0, i <= n2, i += 1 ]
            c : i32 [ (i < n2) ? ((i32 ftext.chars[i]) & 255) : 10 ]
            if [ c != 10 ] continue
            line : string ftext.mid[ ls, i - ls ]
            ls = i + 1
            if [ line.index_of[ 'views:' ] == 0 ]
                views_line[ line, mod, asc, bin, anyv ]

    func views_line [ vl: string, mod: string, asc: vec string,
                      bin: vec string, anyv: vec string ]
        ln : i32 [ vl.count ]
        j   : i32 [ 0 ]
        while [ j < ln ]
            cq : i32 [ (i32 vl.chars[j]) & 255 ]
            if [ cq != 39 ]
                j += 1
                continue
            k : i32 [ j + 1 ]
            while [ k < ln && ((i32 vl.chars[k]) & 255) != 39 ] k += 1
            nm : string vl.mid[ j + 1, k - j - 1 ]
            j = k + 1
            # optional ': member' up to the , or ] delimiter
            mem9 : string ''
            while [ j < ln ]
                cm : i32 [ (i32 vl.chars[j]) & 255 ]
                if [ cm == 44 || cm == 93 || cm == 39 ] break
                if [ (cm >= 97 && cm <= 122) || (cm >= 65 && cm <= 90) ]
                    ks : i32 [ j ]
                    j = alpha_end[ vl, j ]
                    mem9 = vl.mid[ ks, j - ks ]
                    continue
                j += 1
            if [ nm.count > 0 ]
                if [ mem9 == 'ascii' ]       asc.push[ nm ]
                el [ mem9 == 'binary' ]      bin.push[ nm ]
                el                           anyv.push[ nm ]
                view_mods[ nm ] = mod

    func alpha_end [ vl: string, j: i32 ] -> i32
        ln : i32 [ vl.count ]
        k  : i32 [ j ]
        while [ k < ln ]
            c : i32 [ (i32 vl.chars[k]) & 255 ]
            if [ !((c >= 97 && c <= 122) || (c >= 65 && c <= 90)) ]
                break
            k += 1
        return k

    # the views a pane's file can be shown in: its editor first, then
    # the rail views its kind admits (the consoles among them); no file
    # is dir context, so the consoles alone
    func views_for [ ed: Editor ] -> vec string
        ensure_views[]
        if [ !ed || !ed.src ] return vec string []
        if [ ed.file_is_binary[ ed.src ] ] return view_tools_bin
        # editing is no view: it is what shows while none is on
        out : vec string []
        for [ s: string ] in view_tools
            out.push[ s ]
        return out

    func apply_pane [ ed: Editor, is_search: bool, slot: i32 ]
        if [ !ed ] return
        # browse AND find live in CommitView: the pane is never
        # displaced
        was_search : bool [ ed.finder_list ]
        ed.finder_list = false
        # code views only fit ascii files; binaries get b16 alone
        ed.nav_tools   = null
        ed.nav_default = null
        # the file's alternate views (hex, git, the consoles) are not
        # put on the rail for now: the rail renders every one of them
        # over the nav list the frame it opens; they will be surfaced
        # another way. nav_default alone names the file's own view and
        # draws nothing
        if [ is_search && ed.src ]
            ed.nav_default = ed.default_view_for[ ed.src ]
        if [ slot >= 0 && slot < open_files.count ]
            # reload ONLY on real change: a blanket load_file remounts
            # every pane's view and flashes the ones not involved
            np : path open_files[slot]
            same : bool [ ed.src && '{ed.src}' == '{np}' ]
            if [ was_search || !same ]
                ed.src = np
                ed.load_file[]
                if [ was_search ]
                    ed.scroll.y      = ed.saved_scroll
                    ed.scroll_target = ed.saved_scroll
                ed.pristine = false
        el
            if [ ed.lines && ed.lines.count > 0 ]
                ed.lines = list string []
                ed.pristine = false

    func pane_view [ i: i32 ] -> element
        mn  : element (elements) ? elements[ 'main' ] : null
        lf  : element (mn && mn.elements) ? mn.elements[ 'left' ] : null
        st  : element (lf && lf.elements) ? lf.elements[
            'stack' ] : null
        spl : element (st && st.elements) ? st.elements[
            'panes' ] : null
        if [ !spl || !spl.elements ] return null
        return spl.elements[ 'pane{i}' ]

    func title_at [ i: i32 ] -> element
        pv : element pane_view[ i ]
        if [ !pv || !pv.elements ] return null
        return pv.elements[ 'title' ]

    # scene classes modules register in install/export/*.agi
    func ensure_scenes []
        if [ scene_names ] return
        scene_names = vec string []
        scene_mods  = map string [string] []
        # first entry is always 'none' -- with no scenes exported the
        # selector drew an empty label, which reads as a broken widget
        scene_names.push[ string 'none' ]
        root : path.path_startup[]
        if [ !root ] return
        d : path '{root}/install/export'
        entries : d.ls[ null, false ]
        if [ !entries ] return
        for [ e: path ] in entries
            ax : e.ext[]
            if [ !ax || !(ax == 'agi') ] continue
            ftext : string e.load[ typeid[string], null ]
            if [ !ftext ] continue
            n2  : i32 [ ftext.count ]
            ls9 : i32 [ 0 ]
            for [ i: i32 0, i <= n2, i += 1 ]
                c : i32 [ (i < n2) ? ((i32 ftext.chars[i]) & 255) : 10 ]
                if [ c != 10 ] continue
                line : string ftext.mid[ ls9, i - ls9 ]
                ls9 = i + 1
                if [ !(line.index_of[ 'scenes:' ] == 0) ] continue
                ln : i32 [ line.count ]
                j   : i32 [ 0 ]
                while [ j < ln ]
                    cq : i32 [ (i32 line.chars[j]) & 255 ]
                    if [ cq != 39 ]
                        j += 1
                        continue
                    k : i32 [ j + 1 ]
                    while [ k < ln && ((i32 line.chars[k]) & 255) != 39 ]
                        k += 1
                    nm : string line.mid[ j + 1, k - j - 1 ]
                    j = k + 1
                    if [ nm.count > 0 ]
                        scene_names.push[ nm ]
                        scene_mods[ nm ] = e.stem[]

    # backdrop scenes the bottom bar steps through
    func scene_list [] -> vec string
        ensure_scenes[]
        return scene_names

    # the chosen scene, 'none' included
    func scene_name [] -> string
        if [ scene_load && scene_load.count > 0 ] return scene_load
        return 'none'

    # owner-module: the compiler's name for a module's export and lib
    public func install_name_of [ m: string ] -> string
        if [ !install_names ] install_names = map string [string] []
        if [ install_names.contains[ m ] ] return install_names[ m ]
        if [ !startup_path ] startup_path = path.path_startup[]
        root : path '{startup_path}/{m}'
        if [ projects ]
            for [ p: Project, name: string ] in projects
                if [ name.compare[ m ] == 0 && p.root ] root = p.root
        url : string ''
        if [ root.exists[] ]
            rl : git_capture[ root, 'remote get-url origin', false ]
            if [ rl.count > 0 ] url = rl[0].trim[]
        if [ url.ends_with[ '.git' ] ] url = url.mid[ 0, url.count - 4 ]
        # https://host/owner/project, or git@host:owner/project
        sl : i32 [ -1 ]
        for [ i: i32 0, i < url.count, i += 1 ]
            if [ url.chars[i] == 47 ] sl = i
        nm : string m
        if [ sl > 0 ]
            proj : string url.mid[ sl + 1, url.count - sl - 1 ]
            os  : i32 [ -1 ]
            for [ i: i32 0, i < sl, i += 1 ]
                if [ url.chars[i] == 47 || url.chars[i] == 58 ] os = i
            own : string url.mid[ os + 1, sl - os - 1 ]
            # silver's own modules are named silver, as the compiler
            # does
            if [ own.compare[ 'ar-visions' ] == 0 && proj.compare[ 'silver' ] == 0 ]
                own = 'silver'
            if [ own.count > 0 ] nm = '{own}-{m}'
        install_names[ m ] = nm
        return nm

    # a module builds to one file per configuration (release, and -dbg).
    # we load these INTO THIS PROCESS, so the configuration must be
    # ours: a module of the other one drags its own trinity, devices and
    # spectra in beside the ones already loaded -- two vulkan stacks,
    # duplicate objc classes, and the GPU out of memory before the
    # second frame. the other configuration only serves when ours was
    # never built
    public func module_lib [ ln: string ] -> path
        if [ !startup_path ] startup_path = path.path_startup[]
        tag : string [ (debug) ? '-dbg' : '' ]
        mn : string '{ln}{tag}'
        own : path '{startup_path}/install/build/{path.path_library[ mn.chars ]}'
        if [ own.exists[] ] return own
        an9 : string [ (debug) ? '{ln}' : '{ln}-dbg' ]
        alt : path '{startup_path}/install/build/{path.path_library[ an9.chars ]}'
        return (alt.exists[]) ? alt : own

    # scenes compile separately; load the lib only if it is available
    func scene_module_ensure [ nm: string ]
        ensure_scenes[]
        mod : string (scene_mods) ? scene_mods[ nm ] : null
        if [ !mod || mod.count == 0 ] return
        if [ !startup_path ] startup_path = path.path_startup[]
        lib : path module_lib[ mod ]
        if [ !lib.exists[] ] return
        # module init registers its types
        h : dlopen[ lib.chars, 258 ]
        if [ !h ]
            log 'scenes: dlopen failed for {lib}'
            return
        if [ Au.find_type[ nm.chars, null ] ] return
        # an app's library has no load-time init (its main runs it):
        # its silver_<module>_initializer, past any owner- prefix
        for [ i: i32 -1, i < mod.count, i += 1 ]
            # 45 is '-': the name after each, or the whole stem
            if [ i >= 0 && mod.chars[ i ] != 45 ] continue
            name : mod.mid[ i + 1, mod.count - i - 1 ]
            sym : 'silver_{name}_initializer'
            init : hook [ cast hook [ dlsym[ h, sym.chars ] ] ]
            if [ init ]
                init[ null ]
                return

    # built once per scene: new_object is pool-managed, so hold it
    func scene_element [] -> element
        nm : scene_loaded[]
        if [ !nm || nm.count == 0 ] return null
        if [ scene_el && scene_el_nm && scene_el_nm.compare[ nm ] == 0 ]
            return scene_el
        if [ !scene_kept ]
            scene_kept = map element [ string ] []
            scene_rts  = map Render [ string ] []
        # unmount does not call on_unload: the outgoing target comes
        # off the window, kept with its scene
        if [ scene_el && scene_el.id && ux && ux.element_targets ]
            if [ ux.element_targets.contains[ scene_el.id ] ]
                scene_rts[ scene_el_nm ] = ux.element_targets[ scene_el.id ]
            ux.element_targets.rm[ scene_el.id ]
        # only the agent view's Milky Way and the chosen scene stay
        gone : vec string []
        for [ ke: element, kn: string ] in scene_kept
            if [ kn.compare[ 'MilkyWay' ] != 0 && kn.compare[ nm ] != 0
                 && (!scene_load || kn.compare[ scene_load ] != 0) ]
                gone.push[ kn ]
        for [ kn: string ] in gone
            scene_kept.rm[ kn ]
            if [ scene_rts.contains[ kn ] ] scene_rts.rm[ kn ]
        e : element
        if [ scene_kept.contains[ nm ] ]
            # kept: its picture back on the window, nothing rebuilt
            e = scene_kept[ nm ]
            if [ e.id && ux && scene_rts.contains[ nm ] ]
                ux.element_targets[ e.id ] = scene_rts[ nm ]
            scene_el    = e
            scene_el_nm = string [ nm ]
        el
            st : Au.find_type[ nm.chars, null ]
            if [ !st ]
                scene_module_ensure[ nm ]
                st = Au.find_type[ nm.chars, null ]
            if [ !st ]
                log 'scene: no class for {nm}'
                return null
            e = element [ Au.new_object[ st, null, null, true,
                __FILE__, __LINE__, __SEQUENCE__ ] ]
            if [ !e ] return null
            e.area = Region [ 'l0 t0 r0 b0' ]
            # the stores own the scene and its name
            scene_el    = e
            scene_el_nm = string [ nm ]
            scene_kept[ nm ] = e
            scene_props_restore[ e, nm ]
            log 'scene: built {nm}'
        # the scene retints the ui; null theme restores the authored
        # values
        if [ ux && ux.st ]
            ux.st.set_theme[ e.theme*[] ]
            # the solid stage fills the scene's OWN backdrop color, so
            # the flat background is the mounted scene's color, not a
            # fixed hex
            bgc : e.bg_color*[]
            if [ bgc && bgc.a > 0.0 ] ux.solid_color = bgc
            ux.apply_solid[]
            ux.restyle = true
        return e

    # the agent view's galaxy behind the platform, unless the chosen
    # scene is it already
    func galaxy_element [] -> element
        nm : scene_loaded[]
        want : bool [ home_tab == 'agent' && home_seen[]
                      && (!nm || nm.compare[ 'MilkyWay' ] != 0) ]
        if [ !want ]
            # off the window: its picture kept for the next visit
            if [ galaxy_el && galaxy_el.id && ux && ux.element_targets
                 && ux.element_targets.contains[ galaxy_el.id ] ]
                galaxy_rt = ux.element_targets[ galaxy_el.id ]
                ux.element_targets.rm[ galaxy_el.id ]
            return null
        if [ !galaxy_el ]
            st : Au.find_type[ 'MilkyWay', null ]
            if [ !st ]
                scene_module_ensure[ 'MilkyWay' ]
                st = Au.find_type[ 'MilkyWay', null ]
            if [ !st ] return null
            galaxy_el = element [ Au.new_object[ st, null, null, true,
                __FILE__, __LINE__, __SEQUENCE__ ] ]
            if [ !galaxy_el ] return null
            galaxy_el.area = Region [ 'l0 t0 r0 b0' ]
            log 'scene: built MilkyWay for the agent view'
        if [ galaxy_rt && galaxy_el.id && ux ]
            ux.element_targets[ galaxy_el.id ] = galaxy_rt
            galaxy_rt = null
        return galaxy_el

    # the agent view: the chosen scene drawn for the mirrors alone,
    # the galaxy the backdrop
    func mirror_source [ w: Window ]
        if [ !w.element_targets ] return
        gal : bool [ galaxy_el && galaxy_el.id
                     && w.element_targets.contains[ galaxy_el.id ] ]
        srt : Render [ null ]
        if [ scene_el && scene_el.id
             && w.element_targets.contains[ scene_el.id ] ]
            srt = w.element_targets[ scene_el.id ]
        if [ srt ] srt.skip = gal
        w.mirror_src = (gal) ? srt : null

    # the mounted scene; the label click sets it from the browsed one
    func scene_loaded [] -> string
        if [ !show_scene ] return ''
        # 'none' is a real selection, not a scene: nothing mounts for it
        if [
            scene_load && scene_load.count > 0
            && scene_load.compare[ 'none' ] != 0 ]
            return scene_load
        return ''

    # a nav pick in progress: a launch field's path
    public func picking [] -> bool
        return pick_field && pick_field.count > 0

    # a scene card's picture, from the scenes export
    public func scene_tex [ h: FindHit ] -> Texture
        if [ !h.thumb || !ux ] return null
        if [ !scene_texs ] scene_texs = map Texture [string] []
        k9 : string '{h.thumb}'
        if [ scene_texs.contains[ k9 ] ] return scene_texs[ k9 ]
        if [ !h.thumb.exists[] ] return null
        im : Image [ uri: h.thumb ]
        if [ !im || im.width <= 0 || im.height <= 0 ] return null
        tx : Texture [ vk: ux.vk, w: ux, sampler: im, linear: true ]
        scene_texs[ k9 ] = tx
        return tx

    # a scene card picked in the side panel: load it
    public func scene_choose [ nm: string ]
        scene_load = nm
        scene_load.hold[]
        save_session[]
        if [ ux ] ux.restyle = true

    # the scene cards, with the export's pictures
    public func scene_cards [] -> vec FindHit
        res : vec FindHit []
        if [ !startup_path ] startup_path = path.path_startup[]
        sl : scene_list[]
        for [ nm: string ] in sl
            mod : string (scene_mods && scene_mods.contains[ nm ]) ? scene_mods[ nm ] : null
            th : path (mod && mod.count > 0) ? path '{startup_path}/install/share/{install_name_of[ mod ]}/thumbs/{nm}.png' : null
            res.push[
                FindHit [ is_header: true, text: nm.lcase[], dir: '',
                          scene: nm, thumb: th ] ]
        return res

    # the live scene's props as agi: the panel under the cards
    public func scene_spec [] -> string
        e : element scene_el
        if [ !e ] return ''
        all : LaunchProps [ module: 'scenes' ]
        props_of[ typeid[ e ], e, all ]
        # the scene's own; the element base's (trinity) are not its
        ps : LaunchProps [ module: 'scenes' ]
        ps.props = vec Prop []
        for [ p: Prop ] in all.props
            if [ p.module && p.module == 'scenes' ] ps.props.push[ p ]
        return Au.string_agi[ ps ]

    # one prop by name onto the live scene
    func scene_prop_apply [ e: element, nm: string, v: string ]
        member : find_member[ typeid[ e ], nm.chars,
                              AU_MEMBER_VAR, 0, true ]
        if [ !member ] return
        # a saved enum name the enum no longer has is left alone
        # AU_TRAIT_ENUM
        if [ member.src && (member.src.traits & (1 << 5)) != 0 ]
            found : bool [ false ]
            for [ k: i32 0, k < member.src.members.count, k += 1 ]
                ev : Au_t member.src.members.origin[k]
                if [ !ev || ev.member_type != AU_MEMBER_ENUMV ]
                    continue
                if [ v == ev.ident ] found = true
            if [ !found ] return
        val : Au.convert[ member.src, v ]
        if [ val ] e.set_property[ nm, val ]

    # the panel's change: set on the scene, kept for the scene
    # a live property's change goes to the running instance
    func push_live [ lp: LaunchPanel, mod: string, only: element ]
        if [ !mod || mod.count == 0 ] return
        p : lp.live_prop[ only ]
        if [ !p ] return
        v : string lp.value_of[ p ]
        if [ !v ] return
        if [ lp.scene ]
            scene_prop_set[ p.ident, v ]
        el
            agent_sock_send[ mod.chars, 'set {p.ident} {v}\n' ]

    public func scene_prop_set [ nm: string, v: string ]
        if [ !scene_el || !scene_el_nm || !nm || !v ] return
        scene_prop_apply[ scene_el, nm, v ]
        if [ !scene_props ] scene_props = map string [string] []
        scene_props[ scene_el_nm ] = scene_spec[]
        save_session[]
        if [ ux ] ux.restyle = true

    # the props the user chose for this scene last time
    func scene_props_restore [ e: element, nm: string ]
        if [ !scene_props || !scene_props.contains[ nm ] ] return
        sp : string scene_props[ nm ]
        if [ !sp || sp.count == 0 ] return
        ps : LaunchProps []
        Au.parse_agi[ null, sp.chars, ps ]
        if [ !ps.props ] return
        for [ p: Prop ] in ps.props
            if [ p.ident && p.value ]
                scene_prop_apply[ e, p.ident, p.value ]

    # depth-first id lookup; the tree nests once sides land
    func find_el [ e: element, id: string ] -> element
        if [ !e || !e.elements || !id ] return null
        d : element e.elements[ id ]
        if [ d ] return d
        for [ ce: element, ck: string ] in e.elements
            r : element find_el[ ce, id ]
            if [ r ] return r
        return null

    # extent < 0 means the user dragged this pane shut
    func take_closed [ id: string ] -> bool
        e : element find_el[ a, id ]
        if [ !e || e.extent >= 0.0 ] return false
        e.extent = 0.0
        return true

    # a pane added: not a file yet, it opens on the nav list, where
    # the location gets picked (its title takes focus)
    func pane_add []
        if [ editor_slots.count < 4 ]
            editor_slots += -1
            pane_console += ''
            active_pane = editor_slots.count - 1
            pending_finder = active_pane
        save_session[]
        force_update[]

    func close_pane [ pi: i32 ]
        if [ agent_open && pi == editor_slots.count ]
            agent_open = false
            ae : element find_el[ a, 'pane{pi}' ]
            if [ ae ]
                ae.extent       = 0.0
                ae.extent_shown = 0.0
            if [ active_pane >= editor_slots.count ]
                active_pane = editor_slots.count - 1
            save_session[]
            return
        if [ pi < 0 || pi >= editor_slots.count ] return
        pe : Editor pane_at[ pi ]
        if [ pe && pe.rview ]
            pe.rview.release*[]
            pe.rview = null
        # a view closes with its tab
        if [ pe ] pe.view_name = ''
        # the last tab closes to an empty one, the nav list shut
        if [ editor_slots.count == 1 ]
            # its instances leave the panel with it; they keep running
            if [ pe && pe.run_view && pe.run_view.viewer ]
                pe.close_app[]
            if [ pe ]
                pe.run_view = null
                pe.app_view = false
            pane_drop_file[ pi ]
            # the text goes now, not on the pane's next load
            if [ pe ]
                pe.load_file[]
                pe.pristine = false
            active_pane = pi
            return
        free_drop[ pi ]
        pane_lists_drop[ pi ]
        editor_slots.remove[ pi ]
        if [ pi < pane_console.count ] pane_console.remove[ pi ]
        # ids re-key by index next frame: extents follow their content
        for [ qj: i32 pi + 1, qj <= editor_slots.count, qj += 1 ]
            src9 : element find_el[ a, 'pane{qj}' ]
            dst9 : element find_el[ a, 'pane{qj - 1}' ]
            if [ src9 && dst9 ]
                dst9.extent       = src9.extent
                dst9.extent_shown = src9.extent_shown
        if [ active_pane >= editor_slots.count ]
            active_pane = editor_slots.count - 1
        save_session[]

    # a closed pane's window, sheet, history and selection go with it;
    # the later panes' move down a place
    func pane_lists_drop [ pi: i32 ]
        if [ pane_win && pi < pane_win.count ] pane_win.remove[ pi ]
        if [ pane_sheet && pi < pane_sheet.count ]
            pane_sheet.remove[ pi ]
        if [ pending_sel && pi < pending_sel.count ]
            pending_sel.remove[ pi ]
        if [ nav_panes && pi < nav_panes.count ]
            nav_panes.remove[ pi ]
            nav_panes += Navigate []
        if [ !placed_pane ] return
        j : i32 [ placed_pane.count - 1 ]
        while [ j >= 0 ]
            pp : i32 placed_pane[ j ]
            if [ pp == pi ]
                placed_pane.remove[ j ]
                if [ placed_win && j < placed_win.count ]
                    placed_win.remove[ j ]
            el [ pp > pi ]
                placed_pane[ j ] = pp - 1
            j -= 1

    # a closed pane's free place goes; later panes move down a place
    func free_drop [ pi: i32 ]
        if [ pane_free && pane_free.count >= (pi + 1) * 4 ]
            for [ r: i32 0, r < 4, r += 1 ]
                pane_free.remove[ pi * 4 ]
        if [ pane_shown && pane_shown.count >= (pi + 1) * 4 ]
            for [ r: i32 0, r < 4, r += 1 ]
                pane_shown.remove[ pi * 4 ]
        if [ !free_order ] return
        fo : i32 [ free_at[ pi ] ]
        if [ fo >= 0 ] free_order.remove[ fo ]
        for [ j: i32 0, j < free_order.count, j += 1 ]
            if [ free_order[ j ] > pi ]
                free_order[ j ] = free_order[ j ] - 1

    # the Editor of the pane an element lives in
    func pane_of [ e: element ] -> Editor
        for [ e9: element* e, e9, e9 = e9.parent ]
            if [ e9 inherits EditorView ]
                ev9 : EditorView e9
                return pane_at[ ev9.pane_index ]
            # the status bar, the side panel (the instance's properties)
            # and the console act for the selected editor
            if [ e9 inherits StatusBar || e9 inherits SidePanel || e9 inherits RunBand ]
                return pane_at[ active_pane ]
        return null

    # the pane an element sits in, or -1
    func pane_index_of [ e: element ] -> i32
        for [ e9: element* e, e9, e9 = e9.parent ]
            if [ e9 inherits EditorView ]
                ev9 : EditorView e9
                return ev9.pane_index
        return -1

    func pane_at [ i: i32 ] -> Editor
        pv : element pane_view[ i ]
        if [ !pv || !pv.elements ] return null
        return editor_under[ pv.elements[ 'split' ] ]

    func push_file_hit [ p: path, show_dir: bool ]
        fn  : string p.filename[]
        drs : string ''
        if [ show_dir ]
            drs = '{p.directory[]}'
        find_hits.push[
            FindHit [ is_header: true, text: fn, dir: drs, file: p ] ]
        if [ !browse_single ]
            find_hits.push[
                FindHit [ is_header: true, text: '', file: p ] ]

    func project_root [] -> path
        if [ !startup_path ] startup_path = path.path_startup[]
        return path '{startup_path}'

    # the rail draws every frame: this only reads the finished snapshot
    func file_changes [ p: path ] -> FileChg
        if [ !p || !git_snap || !git_snap.chg ] return null
        return git_snap.chg[ '{p.absolute[]}' ]

    # thread body: every git call lives here, never on the view.
    # the changed files are one aggregate over every checkout marked [o]
    # in the projects list, plus the directory orbiter ran in when that
    # is a repo; with neither, the repo of the pane's root as before.
    # files are absolute paths (they span repos)
    func git_entry [] -> none
        base : path [ (nav_root) ? nav_root : project_root[] ]
        # git_stage's store owns it; the pool drains after that store
        sn : GitSnap []
        sn.base = git_sel_key[]
        tops : vec string []
        if [ docked_repos ]
            for [ nm: string ] in docked_repos
                if [ !repo_local[ nm ] ] continue
                rd9 : path repo_dir[ nm ]
                tl9 : git_capture[ rd9, 'rev-parse --show-toplevel',
                                   false ]
                if [ tl9.count > 0 && !vec_has[ tops, tl9[0] ] ]
                    tops.push[ tl9[0] ]
        st9 : path project_root[]
        ts9 : git_capture[ st9, 'rev-parse --show-toplevel', false ]
        if [ ts9.count > 0 && !vec_has[ tops, ts9[0] ] ]
            tops.push[ ts9[0] ]
        if [ tops.count == 0 ]
            rl : git_capture[ base, 'rev-parse --show-toplevel', false ]
            if [ rl.count > 0 ] tops.push[ rl[0] ]
        if [ tops.count > 0 ]
            sn.repo  = tops[0]
            sn.files = vec string []
            sn.chg   = map FileChg [string] []
            ins : i32 [ 0 ]
            del : i32 [ 0 ]
            for [ top: string ] in tops
                rp : path '{top}'
                ref9 : string git_ref_of[ rp ]
                ch : repo_changed[ rp, ref9 ]
                # closest to the repo root first: fewest separators
                srt : vec string []
                for [ i: i32 0, i < ch.count, i += 1 ]
                    d9  : i32 [ path_depth[ ch[i] ] ]
                    at9 : i32 [ srt.count ]
                    for [ j: i32 0, j < srt.count, j += 1 ]
                        dj : i32 [ path_depth[ srt[j] ] ]
                        if [
                            d9 < dj
                            || (d9 == dj && ch[i].compare[ srt[j] ] < 0) ]
                            at9 = j
                            break
                    srt.insert[ ch[i], at9 ]
                for [ f9: string ] in srt
                    sn.files.push[ '{top}/{f9}' ]
                ss : git_capture[ rp, 'diff --shortstat {ref9}', false ]
                if [ ss.count > 0 ]
                    pr9 : ss[0].split[ ',' ]
                    for [ i: i32 0, i < pr9.count, i += 1 ]
                        p9 : string pr9[i].trim[]
                        if [ p9.index_of[ 'insertion' ] >= 0 ]
                            ins += i32[ p9.real_value[] ]
                        el [ p9.index_of[ 'deletion' ] >= 0 ]
                            del += i32[ p9.real_value[] ]
                if [ open_files ]
                    for [ i: i32 0, i < open_files.count, i += 1 ]
                        p : path open_files[i]
                        if [ !p ] continue
                        k : string '{p.absolute[]}'
                        if [ !k.starts_with[ '{top}/' ] ] continue
                        ns : git_capture[ rp,
                                          'diff --numstat {ref9} -- {k}',
                                          false ]
                        if [ ns.count == 0 ] continue
                        f9 : ns[0].split[ '\t' ]
                        if [ f9.count < 2 ] continue
                        sn.chg[ k ] = FileChg [
                            adds: i32[ f9[0].real_value[] ],
                            dels: i32[ f9[1].real_value[] ] ]
            sn.adds = ins
            sn.dels = del
        git_stage = sn
        git_fresh = true
        git_busy  = false
