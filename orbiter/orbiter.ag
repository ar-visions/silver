# the editor under a pane's split. 'text' is the editor/instruments
# split, and the editor keeps key 'text' inside it
# the editor down the 'text' chain: pane split, the editor|panel split,
# the editor|band column, the editor
func editor_under [ spl: element ] -> Editor 
    te : element [ spl ]
    for [ d: i32 0, d < 4, d += 1 ]
        if [ !te || !te.elements ] return null
        te = te.elements[ 'text' ]
        if [ te && te inherits Editor ] return Editor te
    return null
 
# This is the EditorView
element EditorView
    public selected   : bool
    public pane_index : i32
    public is_console : bool
    # a new tab, no file yet: no ground, the scene shows through
    public is_empty   : bool
    # pulled free: a window, its corners round (all it holds is
    # masked to them: its ground's clip)
    public free       : bool

    style : CSS {
        area: l0 t0 r0 b0
        layers.bg:
            fill_color: #140a2acc
            radius: 0
            clip: false
        :is_console
            layers.bg:
                fill_color: #140a2a80
        :is_empty
            layers.bg:
                fill_color: #0000
        :free
            layers.bg:
                radius: 8
                clip: true
    }


    func text_of [] -> Editor
        if [ !elements ] return null
        return editor_under[ elements[ 'split' ] ]

    # file-create mode: state and behavior live on THIS view alone
    mutable newfile      : bool
    mutable newfile_text : string
    mutable newfile_src  : path
    # the typed name creates a folder instead of a file
    mutable newfile_dir  : bool

    func newfile_enter [ p: path ]
        newfile      = true
        newfile_text = ''
        newfile_src  = p
        newfile_dir  = false

    func newdir_enter [ p: path ]
        newfile_enter[ p ]
        newfile_dir  = true

    func newfile_exit []
        newfile      = false
        newfile_text = ''

    func newfile_exists [] -> bool
        orb : cast orbiter [ ux.app_object ]
        if [ !orb || !orb.nav_root ] return false
        if [ !newfile_text || newfile_text.count == 0 ] return false
        p9 : path '{orb.nav_root}/{newfile_text}'
        return p9.exists[]

    func newfile_commit []
        orb : cast orbiter [ ux.app_object ]
        if [ !orb || !newfile_text || newfile_text.count == 0 ] return
        if [ newfile_exists[] ] return    # red name: no action
        p9 : path '{orb.nav_root}/{newfile_text}'
        if [ newfile_dir ]
            p9.make_dir[]
            newfile_exit[]
            orb.nav_root = p9
            orb.run_search[]
            return
        # a program's save: the name goes back to it, nothing made
        if [ orb.pick_field == 'portal' ]
            newfile_exit[]
            orb.portal_deliver[ p9 ]
            return
        e9 : string ''
        p9.save[ e9, null ]
        newfile_exit[]
        orb.exit_finder[]
        orb.open_file[ p9 ]


    func orb [] -> orbiter
        return cast orbiter [ ux.app_object ]

    # the console session this pane holds; '' when it holds a file
    func psess [] -> string
        o : orb[]
        if [ !o ] return ''
        if [ o.agent_open && pane_index == o.editor_slots.count ]
            return o.orbit_sid
        return (pane_index < o.pane_console.count) ? o.pane_console[pane_index] : ''

    func file [] -> path
        o : orb[]
        if [ !o ] return null
        s : i32 [
            (pane_index < o.editor_slots.count)
            ? o.editor_slots[pane_index] : -1 ]
        return (s >= 0 && s < o.open_files.count) ? o.open_files[s] : null

    func rview [] -> AppView
        e : Editor text_of[]
        return (e) ? e.run_view : null

    func app_running [] -> bool
        r : rview[]
        return (r && !r.ended) ? true : false

    func app_pip [] -> bool
        e : Editor text_of[]
        return (app_running[] && !e.app_view) ? true : false

    func searchable [] -> bool
        o : orb[]
        return (o) ? (o.search_pane[] == id) : false

    func findbar_on [] -> bool
        o : orb[]
        return (o) ? (o.findbar_open && o.findbar_pane == id) : false

    func menu_open [] -> bool
        o : orb[]
        if [ !o || !searchable[] ] return false
        return o.find_showing || o.nav_showing

    # .ag files and anything with a registered handler keep the run band
    func run_ok [] -> bool
        if [ psess[].count > 0 ] return false
        if [ app_running[] ] return true
        p : file[]
        if [ !p ] return false
        f : p.filename[]
        if [ f.count >= 3 && f.mid[ f.count - 3, 3 ].compare[ '.ag' ] == 0 ]
            return true
        e : Editor text_of[]
        return (e && e.handler_module_for[ p ]) ? true : false

    # a running app owns the band label; source navigation must not
    # re-bind it
    func band_mod [] -> string
        r : rview[]
        if [ r && r.app_mod ] return r.app_mod
        p : file[]
        if [ !p ] return 'app'
        m : p.filename[]
        d : i32 [ m.index_of[ '.' ] ]
        return (d > 0) ? m.mid[ 0, d ] : m


    # args belong to the DOC a handler opened, not the handler's own
    # source
    func args_src [] -> path
        r : rview[]
        if [ r && r.doc ] return r.doc
        e : Editor text_of[]
        return (e) ? e.band_src[] : file[]

    func title_text [] -> string
        if [ findbar_on[] ] return ''
        # a program's window: its own title
        o9 : orb[]
        wn : u64 [ (o9) ? o9.pane_window[ pane_index ] : u64[ 0 ] ]
        if [ wn != 0 ] return string[ wlc_window_title[ wn ] ]
        s : psess[]
        if [ s.count > 0 ]
            h : i32 [ s.index_of[ '#' ] ]
            return (h > 0) ? s.mid[ 0, h ] : s
        # a console view is not about the file: the title is its name
        # alone
        e : Editor text_of[]
        o : orb[]
        if [ e && o && e.view_name && o.console_of[ e.view_name ] ]
            return e.view_name
        # its app running in view: the app's own title, as its task
        # button reads
        rv : AppView (e && e.app_view) ? e.run_view : null
        if [ o && rv && !rv.ended && !rv.held ]
            return o.task_title[ rv ]
        # a module: its name; its argument is a button beside it
        m : path (e && o) ? o.module_src_of[ e ] : null
        if [ m ] return m.stem[]
        p : file[]
        # the first frame has no editor yet: the same module rule on
        # the file (<name>/<name>.ag), or it read knes.ag for a frame
        if [ p && p.ext[] == 'ag'
             && p.stem[] == p.parent_dir[].filename[] ]
            return p.stem[]
        return (p) ? p.filename[] : 'Open'

    # the pane's app failed, or its file does not compile
    func title_error [] -> string
        o : orb[]
        e : Editor text_of[]
        if [ !o || !e ] return ''
        # every error is the editor's band at the foot, line or not
        return ''

    func title_hint [] -> string
        e : Editor text_of[]
        o : orb[]
        # a program's folder pick: how to answer it
        if [ o && o.pick_field == 'portal' && o.pick_dir ]
            return 'Enter: open this folder'
        if [ !e || !e.view_name || e.view_name.count == 0 ] return ''
        if [ o && o.console_of[ e.view_name ] ] return ''
        return (e.view_name != 'editor') ? e.view_name : ''

    func title_els [] -> Elements
        o : orb[]
        w : Window ux
        e : Editor text_of[]
        tfoc : bool [
            (w && w.focus && w.focus.id == 'title' && w.focus.parent == a) ? true : false ]
        # the editor is never locked while debugging; the run band steps
        # a console view is not a resource view of the file: the
        # finder's close and the nav arrows keep their places over it
        isres : bool [
            e && e.rview
            && !(e.view_name && o.console_of[ e.view_name ]) ]
        t : Elements o.title_nav[ file[], null, false, w, false,
                                  e->dbg_open, menu_open[],
            isres, e->rview, findbar_on[], tfoc, pane_index ]
        if [ psess[].count > 0 ]
            t['ctx_copy'] = LabelButton [ label: 'context',
                                          manual_mode: true ]
            t['ctx_shot'] = LabelButton [ label: 'screen',
                                          manual_mode: true ]
        # a running app's views (its orbiter bar's chips) after the
        # name; its instances are in the bottom bar
        rv : AppView (e) ? e.run_view : null
        run9 : bool [ rv && !rv.ended && rv.app_mod && !tfoc && !newfile ]
        if [ run9 && w && w.screen && rv.app_views
             && rv.app_views.count > 0 ]
            cv9 : Canvas w.screen
            fu : f32 [
                (w.vk && w.vk.font_unit > 0)
                ? f32[ w.vk.font_unit ] / 22.0 : 1.0 ]
            cv9.font_size[ 17 ]
            nm : cv9.measure_text[ title_text[] ]
            ax9 : f32 [ 62.7 * fu + nm.w + 12.0 * fu ]
            te : element (elements) ? elements[ 'title' ] : null
            ts : TaskStrip (te && te.elements) ? te.elements[
                'tasks' ] : null
            cv9.font_size[ 15 ]
            vxs : vec f32 []
            vws : vec f32 []
            cx  : f32 [ ax9 ]
            for [ vn: string ] in rv.app_views
                vw9 : f32 [ min[ cv9.measure_text[ vn ].w + 40.6 * fu,
                                 8.0 * 22.0 * fu ] ]
                vxs.push[ cx ]
                vws.push[ vw9 ]
                cx += vw9 + 6.0 * fu
            # the strip ends before the companions and the search
            lim : f32 [ (te && te.bounds) ? te.bounds.w : 0.0 ]
            if [ te && te.elements ]
                for [ rk: string ] in vec string [] [ 'companions',
                                                      'tabnav' ]
                    re : element te.elements[ rk ]
                    if [ re && re.bounds && re.bounds.x > ax9
                         && re.bounds.x < lim ]
                        lim = re.bounds.x
            sw : f32 [ max[ lim - ax9 - 6.0 * fu, 0.0 ] ]
            span : f32 [ max[ cx - 6.0 * fu - ax9, 0.0 ] ]
            pad : f32 [ 3.0 * fu ]
            vis : f32 [ (ts && ts.bounds) ? ts.bounds.w - pad * 2.0
                : sw ]
            shift : f32 [ (ts) ? clamp[ ts.shift, 0.0,
                max[ span - vis, 0.0 ] ] : 0.0 ]
            if [ ts ] ts.shift = shift
            st : Elements []
            # h0.9 in the title's cells
            ch : f32 [ 0.9 * ((te && te.fc > 0.0) ? te.fc : 22.0 * fu) ]
            k : i32 [ 0 ]
            for [ vn: string ] in rv.app_views
                vx : f32 [ vxs[ k ] - ax9 - shift + pad ]
                vwd : f32 [ vws[ k ] ]
                st[ 'view_{k}' ] = ArgButton [ label: vn,
                    selected: e.app_view && rv.app_view_on == k,
                    inst: rv,
                    area: Region [ 'l{vx}px t{pad}px w{vwd}px h{ch}px' ] ]
                k += 1
            sa : string 'l{ax9 - pad}px t-{pad}px'
            sz : string 'w{sw + pad * 2.0}px h{ch + pad * 2.0}px'
            t['tasks'] = TaskStrip [ span: span, shift: shift,
                shown: rv.iid, room: sw, pad: pad,
                area: Region [ '{sa} {sz}' ],
                elements: st ]
        if [ newfile ]
            # create mode has its own cancel: never two close buttons
            t.rm[ 'histnav' ]
            t['newfile_cancel'] = BarClose [ icon: 'close',
                                             manual_mode: true,
                area: Region [ 'r0+ t0 w1.66 b0' ] ]
        return t
 
    func text_els [] -> Elements
        o : orb[]
        e : Editor text_of[]
        t : Elements [ ]
        # a window a program opened here fills the pane, unless the
        # navigator is open in it (the window comes back as it shuts)
        wid : u64 o.pane_window[ pane_index ]
        if [ wid != 0 && !browse_active[] ]
            # a header it draws itself is cut off when its menu is in
            # the system bar; one with no menu there keeps it (its tabs)
            cut : i32 [ (wlc_window_csd[ wid ] != 0
                         && wlc_window_menu_kind[ wid ] != 0) ? 46 : 0 ]
            t['text'] = WaylandView [ window: wid, crop_top: cut,
                sheet: o.pane_sheet_of[ pane_index ],
                area: Region { l0 t0 r0 b0 } ]
            return t
        s : psess[]
        if [ s.count > 0 ]
            t['text'] = Console [ session_id: s, sessions: o.ed_sessions,
                                  feed: null,
                launch: o.agent_cmd[ s ], animated: true ]
        el
            edels : Elements []
            # a composed view fills the editor; its lines stay empty
            if [ e && e.rview ]
                vel : element e.rview.view_element*[]
                if [ vel ] edels['view'] = vel
            # a resumed app fading in over the source
            fi9 : AppView (e) ? e.run_view : null
            # an app really building (its build's events show progress):
            # the build card; a check that found it up to date, and its
            # start, show none
            bw9 : string [ (fi9) ? fi9.status_word[] : '' ]
            built_pct : f32 [ (fi9 && fi9.app_mod)
                ? o.build_frac[ fi9.app_mod ] : -2.0 ]
            if [ e && e.app_view && fi9 && fi9.display == 1
                 && bw9 == 'compiling' && built_pct >= 0.0 ]
                edels['build_card'] = BuildCard [ inst: fi9,
                    area: Region { l0 t0 r0 b0 } ]
            if [ fi9 && fi9.fade_in_ms > 0 ]
                edels['resume_fade'] = ResumeFade [ inst: fi9,
                    area: Region { l0 t0 r0 b0 } ]
            edels['rail'] = ToolRail [ no_scroll: true,
                                       area: Region [
                                           'l0 t1px w1.94 b0' ] ]
            dbgr : dbg o.active_debugger[]
            edx : Editor [
                src: file[]
                hide: browse_active[]
                breakpoints: o.breakpoints,
                code_font_size: o.code_font_size,
                nav: o.nav_panes[ pane_index ], pane_index: pane_index,
                debug_running: (dbgr) ? true : false, debugger: dbgr,
                debug_vars: o.debug_vars,
                expanded: findbar_on[], replacing: findbar_on[],
                show_hits: false,
                single_line: false,
                header_size: o.browse_header_size,
                dir_size: o.browse_dir_size,
                nav_list: false, dock_rows: o.nav_dock_rows,
                grid_mode: false,
                hits: o.find_hits,
                find_query: (searchable[]
                    && (findbar_on[] || o.title_finds[]))
                ? o.findbar_text : '',
                elements: edels ]
            # the editor and the run band share the column left of the
            # instance panel: the console spans the editor only, never
            # under the panel. the column is mounted always (a wrapper
            # that comes and goes re-parents the editor)
            cols : Elements []
            cols['text'] = edx
            t['text'] = Splitter [ area: Region { l0 t0 r0 b0 },
                                   vertical: true,
                inner: cols, deflt: 180.0, min_size: 44.0 ]
        return t

    # the error chip belongs to the file it names: only show it
    # while that file is the one in view
    func err_showing [] -> bool
        o : orb[]
        if [ !o.err_file || o.err_line <= 0 ] return false
        e : Editor text_of[]
        if [ !e || !e.src ] return false
        es : string e.src.absolute[]
        ef : string o.err_file.absolute[]
        return es.compare[ ef ] == 0

    # ONE middle slot: the error of the app WE ARE RUNNING, or what it
    # is doing while we wait. an error wins the slot
    func band_status [] -> string
        o : orb[]
        if [ err_showing[] ]
            return (o.err_msg && o.err_msg.count > 0)
                ? '{o.err_line}: {o.err_msg}'
                : '{o.err_file.filename[]}:{o.err_line}'
        r : rview[]
        if [ !r ] return ''
        s : r.status_text[]
        return (s) ? s : ''

    # the console alone: its filter box is the one control. pip, pause,
    # the steps and volume all live in the instance panel
    func band_els [] -> Elements
        o : orb[]
        e : Editor text_of[]
        t : Elements []
        cf : Elements []
        cf['console_filter'] = element [
            area: Region { r0.24 t0.12 w6 h0.97 },
            label: band_mod[], focusable: true, no_scroll: true ]
        # the log's filter, at its top right while it holds one
        fl : string [ (o.con_filter) ? o.con_filter : '' ]
        if [ fl.count > 0 ]
            fw : f32 [ (f32[ fl.count ] * 8.0 + 30.0) * ux_unit[ ux ] ]
            cf['con_find'] = ConFind [ label: fl,
                area: Region [ 'r0.24 t0.12 w{fw}px h0.97' ] ]
        inner : Elements [ ]
        # its toolbar across the top, the task bar's height: the
        # debugger's console, clear, and the selected app or all
        tb : f32 [ 1.06 * o.unit_px[] ]
        t['ctools'] = ConsoleBar [ elements: o.console_tool_els[],
            area: Region [ 'l0 t0 r0 h{tb}px' ] ]
        sid : string o.console_sid[]
        # its input, a line across its foot, edge to edge: the app's
        # standard input, or the debugger's (lldb's) in its console;
        # the log ends above it
        lh : f32 [ tb ]
        t['con_line'] = ConsoleLine [
            area: Region [ 'l0 t100%-{lh}px r0 b0' ] ]
        inner['console'] = RunConsole [ session_id: sid,
            scroll_fade: 72.0,
            sessions: o.ed_sessions,
            feed: (o.con_dbg) ? o.dbg_feed[] : null,
            run_line: (e && e.run_view) ? e.run_view.cmd : null,
            elements: cf ]
        # the console stands alone; the callstack is an instrument in
        # the panel
        t['ground'] = ConsoleGround [
            area: Region [ 'l0 t{tb}px r0 b{lh}px' ] ]
        t['split'] = Splitter [
            area: Region [ 'l0 t{tb}px r0 b{lh}px' ],
                                inner: inner, deflt: 0.0, share: 0.375 ]
        return t

    func pane_els [] -> Elements
        o : orb[]
        t : Elements [ ]
        # the editor and the instruments column are the two sides of ONE
        # split. it is mounted ALWAYS, even with the column hidden — a
        # wrapper that comes and goes re-parents the editor, and a new
        # editor loses run_view and unmounts the whole band
        # 100px floor, and 0 snaps it off the way any other pane does
        t['text'] = Splitter [ area: Region { l0 t0 r0 b0 },
            inner: text_els[], deflt: 280.0, min_size: 100.0,
            snap_close: true ]
        # the run band + console, INSIDE this tab. pip keeps the band:
        # the app shrinks into the editor and its instruments stay open
        return t

    # reconciliation runs on the frame hook, never in render
    public func tick [ w: Window ]
        settle[]

    func settle []
        o : orb[]
        # every app module has an implied default instance, held until
        # it is started: the panel always has the app to run, and only
        # the added ones (shift on the instance tab) carry a number
        ed0 : Editor text_of[]
        if [ ed0 && ed0.src && psess[].count == 0 ]
            dir0 : string ed0.src.parent_dir[].filename[]
            if [ ed0.src.stem[] == dir0 && ed0.src.ext[] == 'ag' ]
                bin : path '{o.startup_path}/install/build/{dir0}'
                li0  : vec AppView o.instances_of[ ed0.src ]
                if [
                    bin.exists[] && li0.count == 0
                    && !ed0.handler_module_for[ ed0.src ] ]
                    ed0.start_instance[ false ]
        is_con : bool [ psess[].count > 0 ]
        if [ is_console != is_con ]
            is_console = is_con
            pristine   = false
        # browsing keeps the ground: only a bare new tab is clear
        emp : bool [ !is_con && !file[] && !browse_active[] ]
        if [ is_empty != emp ]
            is_empty = emp
            pristine = false
            if [ ux ] ux.restyle = true
        if [ o.find_showing ]
            log 'FIND show: pane={id} searchable={(searchable[]) ? 1 : 0} sp={o.search_pane[]} hits={o.find_hits->count}'
        e : Editor text_of[]
        if [ e && e.rview ]
            cfeed : e.rview.context_feed*[]
            if [ cfeed ] o.feed_agent[ cfeed ]
        # create mode self-heals when the pane's file changes under it
        p : file[]
        if [ newfile && newfile_src && p && '{newfile_src}' != '{p}' ]
            newfile_exit[]
        # the nav surface must track the split's text region; when the
        # splitter moves it out from under us, a restyle re-fits it
        cbv : element (elements) ? elements['commit'] : null
        spl : element (elements) ? elements['split'] : null
        if [ cbv && spl && spl.elements && spl.bounds ]
            tx9 : element spl.elements['text']
            ed9 : element (tx9 && tx9.elements) ? tx9.elements['text'] : null
            if [ ed9 && ed9.bounds && tx9.bounds && cbv.bounds ]
                # the view bar takes its width off the right (render)
                vb : element elements['viewbar']
                vw : f32 [ (vb && vb.bounds) ? vb.bounds.w : 0.0 ]
                dx : f32 [ cbv.bounds.x
                    - (spl.bounds.x + tx9.bounds.x + ed9.bounds.x) ]
                dy : f32 [ cbv.bounds.y
                    - (spl.bounds.y + tx9.bounds.y + ed9.bounds.y) ]
                dw : f32 [ cbv.bounds.w - (ed9.bounds.w - vw) ]
                dh : f32 [ cbv.bounds.h - ed9.bounds.h ]
                same : bool [ dx * dx < 0.25 && dy * dy < 0.25
                    && dw * dw < 0.25 && dh * dh < 0.25 ]
                if [ !same ]
                    if [ ux ] ux.restyle = true

    # the pane's views as a column at the nav list's right: git, then
    # the registered views, each the finder close's size, edge to edge
    # row: a button's height in px; each overlaps the last by 1px,
    # so two borders never sit side by side
    func view_bar [ row: f32 ] -> Elements
        o : orb[]
        ed : Editor text_of[]
        bar : Elements []
        # first a pane added, this one closed; then the views
        bar['pane_add'] = ViewTab [
            buttons: vec string [] [ 'pane_add' ],
            icon_ids: vec string [] [ 'plus' ], manual: true,
            rest_glow: rgba [ '#ccf2' ], rest_px: 8.0,
            seg_radius: 0.0, use_spacing: false,
            area: Region [ 'l0 t0 r0 h{row}px' ] ]
        bar['pane_close'] = ViewTab [
            buttons: vec string [] [ 'pane_close' ],
            icon_ids: vec string [] [ 'minus' ], manual: true,
            rest_glow: rgba [ '#ccf2' ], rest_px: 8.0,
            seg_radius: 0.0, use_spacing: false,
            area: Region [ 'l0 t{row - 1.0}px r0 h{row}px' ] ]
        if [ o && ed && ed.src ]
            cur : string ed.resolve_view[]
            y : f32 [ row * 2.0 - 2.0 ]
            if [ o.checkout_root[ ed.src.directory[] ] ]
                bar['git'] = ViewTab [ buttons: vec string [] [ 'git' ],
                    icon_ids: vec string [] [ 'git' ], manual: true,
                    sel_mask: (ed.git_on) ? 1 : 0,
                    rest_glow: rgba [ '#ccf2' ], rest_px: 8.0,
                    seg_radius: 0.0, use_spacing: false,
                    area: Region [ 'l0 t{y}px r0 h{row}px' ] ]
                y += row - 1.0
            for [ v: string ] in o.views_for[ ed ]
                if [ v == 'git' ] continue
                ci : string o.console_icon[ v ]
                bar['view_{v}'] = ViewTab [
                    buttons: vec string [] [ 'view_{v}' ],
                    icon_ids: vec string [] [ (ci) ? ci : v ],
                    manual: true, sel_mask: (v == cur) ? 1 : 0,
                    rest_glow: rgba [ '#ccf2' ], rest_px: 8.0,
                    seg_radius: 0.0, use_spacing: false,
                    area: Region [ 'l0 t{y}px r0 h{row}px' ] ]
                y += row - 1.0
        return bar

    # the pane's title bar height, px: 1.3 units; the one place it is
    # said
    func title_px [] -> f32
        fu : f32 [ (fc > 0.0) ? fc : 22.0 ]
        return round[ 1.3 * fu ]

    # the nav/commit surface replaces the editor for browse AND find
    func browse_active [] -> bool
        o : orb[]
        if [ !o || !searchable[] ] return false
        return o.nav_showing || o.find_showing

    public func render [] -> Elements
        if [ !orb[] ] return null
        t : Elements [ ]
        # every file has its icon at the left: the name moves past it
        to9 : Editor text_of[]
        # a module's run button is at the right: its name stays left
        sw9 : bool [ to9 && to9.src
            && (orb[].system_on[] || !orb[].module_src_of[ to9 ]) ]
        # a window shown: its close sits at the left, its title is ours
        wn9 : bool [ orb[].pane_window[ pane_index ] != 0 ]
        # an app or a window in view: no title bar, the system bar is
        # its title; the editor and the navigator keep theirs (one
        # asked for, as the bar's title press does, comes back)
        rv9 : AppView (to9 && to9.app_view) ? to9.run_view : null
        # the empty pane ('Open') too: it is the apps view alone
        rn9 : bool [ to9 && to9.run_view && !to9.run_view.ended ]
        # the empty pane: no file, app, window or terminal in it
        open9 : bool [ !file[] && !rn9 && !wn9 && psess[].count == 0 ]
        inapp : bool [ orb[].system_on[]
            && ((rv9 && !rv9.ended && !rv9.held) || wn9 || open9
                || psess[].count > 0)
            && !browse_active[] && orb[].pending_finder != pane_index ]
        # the editor's bar is for finding: up only while ctrl+f finds
        # (or a new file is named)
        fnd9 : bool [ orb[].title_find_on
            && pane_index == orb[].active_pane ]
        # the source shows: never live in view (a failed build too)
        src9 : bool [ to9 && to9.src && (!to9.app_view || !rv9
            || rv9.ended || rv9.held) ]
        if [ orb[].system_on[] && src9
             && !fnd9 && !newfile && !browse_active[]
             && orb[].pending_finder != pane_index ]
            inapp = true
        # a running app's URL being typed: the bar comes up for it
        url9 : bool [ orb[].url_entry_on
            && pane_index == orb[].active_pane ]
        if [ url9 ] inapp = false
        # every offset under the title is its height: none when hidden
        th9 : f32 [ (inapp) ? 0.0 : title_px[] ]
        # a free window's strip across its top; docked, its title is
        # the system bar's. the desktop (the empty pane) has none
        fr9 : bool [ !open9 && orb[].pane_floats[ pane_index ] ]
        sp9 : f32 [ (fr9) ? round[ title_px[] * 0.7 ] : 0.0 ]
        if [ fr9 ]
            strip_w : f32 [ (bounds) ? bounds.w : 0.0 ]
            t['strip'] = WinStrip [ pane: pane_index,
                current: pane_index == orb[].active_pane,
                elements: orb[].strip_els[ pane_index, strip_w ],
                area: Region [ 'l0 t0 r0 h{sp9}px' ] ]
        # with the system bar the pane's bar is at its foot: find, the
        # navigator, a URL
        bot9 : bool orb[].system_on[]
        cont9 : string [ (bot9) ? 'l0 t{sp9}px r0 b{th9}px'
            : 'l0 t{th9 + sp9}px r0 b0' ]
        # the navigator's dock runs down its left: its bar after it
        # a free window's navigator is a dialog: no dock
        dlg9 : bool orb[].pane_floats[ pane_index ]
        bl9 : f32 [ (bot9 && browse_active[] && !dlg9)
            ? orb[].dock_w[] : 0.0 ]
        bar9 : string [ (bot9) ? 'l{bl9}px b{th9}px r0 h{th9}px'
            : 'l0 t{sp9}px r0 h{th9}px' ]
        if [ !inapp ]
            t['title'] = EditorTitle [
                area: Region [ bar9 ]
                # with the system bar its icon (find, find in files) leads
                switched: sw9 || wn9 || bot9
                selected: !file[]
                current: pane_index == orb[].active_pane
                focusable: true
                spacing_x: 0.2
                spacing_y: 0.2
                edit: (newfile) ? newfile_text
                    : ((url9) ? orb[].bar_text
                    : ((orb[].title_finds[]
                        && pane_index == orb[].active_pane)
                    ? orb[].findbar_text : orb[].find_text))
                label: (newfile)
                ? ((newfile_dir) ? 'name new folder' : 'name new file')
                # with the system bar the bar is for finding: blank
                : ((url9 || bot9) ? ''
                    : title_text[])
                conflict: newfile && newfile_exists[]
                no_scroll: true
                hint: title_hint[]
                elements: title_els[] ]
        # only an error, centred in the title, as wide as its words
        # the band floor grows by the open launch panel: it is a
        # toolbar, never clipped
        t['split'] = Splitter [ area: Region [ cont9 ],
                                vertical: true,
            inner: pane_els[], deflt: 180.0,
            min_size: 44.0 ]
        # the empty pane: the apps, glass over the clear space
        # nothing in it: no file, and no app running in it
        ap9 : Editor text_of[]
        runs9 : bool [ ap9 && ap9.run_view && !ap9.run_view.ended ]
        # nor a terminal (an agent's, a console)
        if [ !file[] && !runs9 && !browse_active[] && !wn9
             && psess[].count == 0 ]
            # typing filters them: the box mounts at the foot, the
            # cards scroll above it
            af9 : string [ (pane_index == orb[].active_pane)
                ? orb[].apps_filter : '' ]
            up9 : f32 orb[].unit_px[]
            ga9 : string [ cont9 ]
            if [ af9.count > 0 ]
                ga9 = 'l0 t{sp9}px r0 b{th9 + 2.2 * up9}px'
                sd9 : f32 [ 0.7 * up9 ]
                bt9 : f32 [ th9 + 1.8 * up9 ]
                bh9 : f32 [ 1.2 * up9 ]
                t['apps_filter'] = MenuFilter [ label: af9,
                    area: Region [
                        'l{sd9}px b{bt9}px r{sd9}px h{bh9}px' ] ]
            t['home'] = HomeView [ pane: pane_index,
                area: Region [ ga9 ] ]
        if [ browse_active[] ]
            fu : f32 [ (fc > 0.0) ? fc : 22.0 ]
            bar : Elements (bot9) ? Elements [] : view_bar[ th9 ]
            # the bar is the finder close's width: 1.66 font units
            bw : f32 [ (bar.count > 0) ? 1.66 * fu : 0.0 ]
            # the surface is a peer of the editor pane: it takes the
            # split's live text region, never the whole view
            spl : element (elements) ? elements['split'] : null
            tx8  : element (spl && spl.elements) ? spl.elements['text'] : null
            # tx8 is the editor|panel split: the surface takes the
            # EDITOR's slot inside it, never the instance panel beside
            # it
            ed  : element (tx8 && tx8.elements) ? tx8.elements['text'] : null
            if [
                ed && ed.bounds && tx8 && tx8.bounds && spl.bounds
                && ed.bounds.h > 0.0 ]
                # bounds are parent-relative: compose split + inner
                # split + editor
                cx8 : f32 [ spl.bounds.x + tx8.bounds.x + ed.bounds.x ]
                # the dock, the full navigator's own with the system bar
                # (a free window's is a dialog, without it)
                if [ bot9 && !orb[].pane_floats[ pane_index ] ]
                    dk8 : f32 orb[].dock_w[]
                    t['dock'] = Dock [ elements: orb[].dock_els[],
                        area: Region [ 'l{cx8}px t0 w{dk8}px b0' ] ]
                    cx8 += dk8
                cy8 : f32 [ spl.bounds.y + tx8.bounds.y + ed.bounds.y ]
                ch8 : f32 [ ed.bounds.h ]
                # never under the bottom bar
                if [ bot9 && bounds && cy8 + ch8 > bounds.h - th9 ]
                    ch8 = bounds.h - th9 - cy8
                # from the pane's right edge: a split drag moves the
                # pane this frame, and a width from last frame's bounds
                # left a gap at the right until the next one
                rin : f32 [ spl.bounds.w - tx8.bounds.x - ed.bounds.x
                            - ed.bounds.w ]
                if [ rin < 0.0 ] rin = 0.0
                t['commit'] = CommitView [ focusable: true,
                                           scroll_fade: 24.0,
                    area: Region [
                        'l{cx8}px t{cy8}px r{rin + bw}px h{ch8}px' ] ]
                if [ bar.count > 0 ]
                    # 1px onto the lines above and below it
                    by : f32 [ cy8 - 1.0 ]
                    bh : f32 [ ch8 + 2.0 ]
                    t['viewbar'] = ViewBar [ no_scroll: true,
                        on_edge: orb[].inst_hidden,
                        elements: bar, area: Region [
                        'r{rin}px t{by}px w{bw}px h{bh}px' ] ]
            el
                t['commit'] = CommitView [ focusable: true,
                                           scroll_fade: 24.0,
                    area: Region [ (bot9) ? 'l0 t0 r{bw}px b{th9}px'
                        : 'l0 t{th9}px r{bw}px b0' ] ]
                if [ bar.count > 0 ]
                    t['viewbar'] = ViewBar [ no_scroll: true,
                        on_edge: orb[].inst_hidden,
                        elements: bar,
                        area: Region [
                            (bot9) ? 'r0 t-1px w{bw}px b{th9 - 1.0}px'
                            : 'r0 t{th9 - 1.0}px w{bw}px b-1px' ] ]
        return t

# a resumed app's frame over the source, coming up over 300 ms
element ResumeFade
    animated : true
    public inst : AppView
    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds || !inst ]
            return
        # a picture only: never the starting / paused words
        if [ inst.fade_in_ms <= 0 || !inst.have_frame ] return
        t : f32 [ f32[ epoch_millis[] - inst.fade_in_ms ] / 300.0 ]
        cv : Canvas w.screen
        cv.save[]
        cv.set_opacity[ min[ max[ t, 0.0 ], 1.0 ] ]
        inst.draw_frame[ cv, rect [ x: 0.0, y: 0.0, w: bounds.w,
                                    h: bounds.h ] ]
        cv.restore[]
        ux.will_animate = true

# the build card's avatar: in its build look while the card is up
OrbiterAvatar BuildAvatar
    func on_state [ m: i32 ]
        swap_on = true
        work_on = true
        super.on_state[ m ]

# an app on its way into the pane (compiling, then starting): the
# avatar building it, the app's icon and name, and how far it is
element BuildCard
    animated : true
    public inst : AppView
    mutable icon : AppIcon

    func render [] -> Elements
        t : Elements []
        if [ !bounds ] return t
        side : f32 [ round[ min[ bounds.w * 0.5, bounds.h * 0.45 ] ] ]
        half : f32 [ round[ side * 0.5 ] ]
        top  : f32 [ round[ bounds.h * 0.08 ] ]
        t['avatar'] = BuildAvatar [ area: Region [
            'l50%-{half}px t{top}px w{side}px h{side}px' ] ]
        return t

    # how far its build is, 0..1; -1 when not compiling or not known
    func build_part [] -> f32
        orb : orbiter [ ux.app_object ]
        if [ inst.status_word[] != 'compiling' || !orb || !inst.src ]
            return -1.0
        fr : f32 orb.build_frac[ inst.src.directory[].filename[] ]
        return (fr < 0.0) ? -1.0 : min[ fr, 1.0 ]

    # 'compiling 45%', 'starting', from the instance and its build
    func status [] -> string
        word : string inst.status_word[]
        fr : f32 build_part[]
        if [ fr < 0.0 ] return word
        return '{word} {i32[ fr * 100.0 ]}%'

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds || !inst ]
            return
        cv : Canvas w.screen
        side : f32 [ round[ min[ bounds.w * 0.5, bounds.h * 0.45 ] ] ]
        top  : f32 [ round[ bounds.h * 0.08 ] + side ]
        dir  : path (inst.src) ? inst.src.directory[] : null
        if [ dir && (!icon || '{icon.file}' != '{dir}') ]
            orb : orbiter [ ux.app_object ]
            nm : string orb.install_name_of[ dir.filename[] ]
            ag : path '{path.path_startup[]}/install/export/{nm}.agi'
            icon = AppIcon [ file: dir, module: true, agi: ag ]
        isz : f32 [ 64.0 ]
        nm  : string [ (inst.app_mod) ? inst.app_mod : '' ]
        # save and restore keep no font: it goes back by hand
        was : CanvasFont cv.font
        cv.save[]
        cv.set_font[ shared_font[ cv,
            'fonts/BarlowCondensed-Regular.ttf', 34 ] ]
        nw : f32 [ cv.measure_text[ nm ].w ]
        x  : f32 [ round[ (bounds.w - isz - 16.0 - nw) * 0.5 ] ]
        if [ icon ] icon.paint[ cv, x, top, isz ]
        cv.fill_color[ rgba [ '#f0f0f4' ] ]
        cv.draw_text[ nm, rect [ x: x + isz + 16.0, y: top, w: nw + 4.0,
            h: isz ], vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
            Overflow.visible, null ]
        cv.paint[]
        cv.set_font[ shared_font[ cv,
            'fonts/BarlowCondensed-Regular.ttf', 20 ] ]
        st : string status[]
        fr : f32 build_part[]
        py : f32 [ top + isz + 10.0 ]
        if [ inst.status_word[] == 'compiling' ]
            # a pill round the words, filling from the left as it builds
            pw : f32 [ round[ cv.measure_text[ st ].w + 56.0 ] ]
            ph : f32 [ 30.0 ]
            px : f32 [ round[ (bounds.w - pw) * 0.5 ] ]
            pr : f32 [ ph * 0.5 ]
            cv.save[]
            cv.clip_rect[ px, py, round[ pw * max[ fr, 0.0 ] ], ph,
                          0.0, 0.0 ]
            cv.fill_color[ rgba [ '#4d3dbcaa' ] ]
            cv.rounded_rect[ px, py, pw, ph, pr, pr, pr, pr ]
            cv.paint[]
            cv.restore[]
            cv.fill_color[ rgba [ '#0000' ] ]
            cv.stroke_color[ rgba [ '#806bff' ] ]
            cv.stroke_width[ 1.0 ]
            cv.stroke_offset[ -0.5 ]
            cv.rounded_rect[ px, py, pw, ph, pr, pr, pr, pr ]
            cv.paint[]
            cv.stroke_width[ 0.0 ]
            cv.stroke_offset[ 0.0 ]
        cv.fill_color[ rgba [ '#e8e0ff' ] ]
        cv.draw_text[ st, rect [ x: 0.0, y: py, w: bounds.w, h: 30.0 ],
            vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible,
            null ]
        cv.paint[]
        cv.restore[]
        cv.set_font[ was ]

element EditorTitle
    public selected : bool
    # the active pane's title: the selection colour, as the dock's
    public current  : bool
    # newfile mode: typed name collides with an existing file
    public conflict : bool
    # painted after the name, never part of the editable label
    public hint     : string
    # the toggle sits at the left: the name moves past it
    public switched : bool

    # typing here is the navigator's search: orbiter sees each key,
    # then the field edits (trinity gives a focused field its keys)
    func on_char [ ev: Event ]
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ orb ] orb.on_char[ ev ]

    func on_key [ ev: Event ]
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        if [ orb ] orb.on_key[ ev ]
    style : CSS {
        area: l0 t0 r0 h1.3
        layers.tbar:
            # the status bar's dark; the active pane's is the selection
            fill_color: #000c
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            stroke_color: #fff1
            near_border: true
            near_inset: 1.0
            near_inset_color: #c890ffaa
        layers.tface:
            label_color: #fff
            label_size: 17
            editable: true
            label_align: 0.0 0.5
            label_offset: 22.0 0.0
        # its own colour (a third of the selection's alpha), so a
        # theme can map it apart
        :current
            layers.tbar:
                fill_color: #66225539
        # past the run button (1.35 units, 44.6 px at rest) by 8 px;
        # the bar's first menu name starts at the same x
        :switched
            layers.tface:
                label_offset: 52.6 0.0
        :conflict
            layers.tface:
                label_color: #e05e5e
        layers.tdiv:
            fill_color: #fff2
            area: l0 b0 r0 h1px
    }

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        if [ !label || label.count == 0 ] return
        cv  : Canvas [ w.screen ]
        # the gaps ride the font unit, as the name's size does
        fu  : f32 [
            (w.vk && w.vk.font_unit > 0) ? f32[ w.vk.font_unit ] / 22.0
            : 1.0 ]
        # the view we are in, trailing the name. painted, so the label
        # stays the editable field and this can never be selected
        cv.font_size[ 17 ]
        name_m : cv.measure_text[ label ]
        # the name starts at the label's offset
        off9   : f32 [ (switched) ? 62.7 : 22.0 ]
        trail  : f32 [ (off9 + 16.0) * fu + name_m.w ]
        if [ hint && hint.count > 0 ]
            cv.font_size[ 13 ]
            cv.fill_color[ '#ffffff66' ]
            cv.stroke_width[ 0.0 ]
            cv.draw_text[ hint,
                rect [ x: trail, y: 0.0, w: bounds.w, h: bounds.h ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip,
                null ]
            cv.paint[]


# the console's toolbar: a dark ground, a line at its foot
element ConsoleBar
    style : CSS {
        layers.ground:
            fill_color: #0008
            area: l0 t0 r0 b0
        layers.line:
            fill_color: #fff2
            area: l0 b0 r0 h1px
    }

# the console's input line: Enter sends it (the app's standard
# input, or lldb's); edge to edge at the console's foot, a line over
element ConsoleLine
    focusable : true
    style : CSS {
        layers.body:
            fill_color: #0003
        layers.top:
            fill_color: #fff2
            area: l0 t0 r0 h1px
        layers.face:
            label_color: #fff
            label_size: 15
            editable: true
            label_align: 0.0 0.5
            label_offset: 8.0 0.0
        :focused
            layers.top:
                fill_color: #806bff
    }

    public func on_key [ ev: Event ]
        if [ !ev.key.state || ev.key.unicode != 257 ] return
        orb : cast orbiter [ (ux) ? ux.app_object : null ]
        # sent before the field empties: the line is the field's text
        if [ orb && edit ] orb.console_input[ edit ]
        edit     = ''
        pristine = false
        ev.no_default = true

# a free window's ground, under it: its piece of the screen's own
# paint (the blurred scene), as a docked pane has under it; the
# window then draws as it does docked, its own tint once
element WinGround
    animated : true
    ghost    : true
    # under a square view (the navigator): square
    public square : bool

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        cv : Canvas w.screen
        sw : f32 [ f32[ w.width ] ]
        sh : f32 [ f32[ w.height ] ]
        if [ sw <= 0.0 || sh <= 0.0 ] return
        cv.save[]
        # the window's corners
        rr : f32 [ (square) ? 0.0 : 8.0 ]
        cv.clip_rounded_rect[ 0.0, 0.0, bounds.w, bounds.h, rr, rr, rr,
                              rr ]
        if [ w.frost_eff[] == 3 || !w.backdrop ]
            cv.fill_color[ w.solid_color ]
            cv.rect_to[ 0.0, 0.0, bounds.w, bounds.h ]
            cv.paint[]
        el
            # as the screen's own paint: the blur chain is there only
            # with a backdrop
            bl : Render w.blur_src[]
            tx : f32 cv.transform_tx[]
            ty : f32 cv.transform_ty[]
            cv.draw_image_crop[ (bl) ? bl.color : w.backdrop.color,
                rect [ x: 0.0, y: 0.0, w: bounds.w, h: bounds.h ],
                tx / sw, ty / sh, (tx + bounds.w) / sw,
                (ty + bounds.h) / sh ]
        cv.restore[]

# a free window's shadow: under it, 24 px out each way
element WinShade
    ghost : true
    # under a square view (the navigator): square
    public square : bool
    style : CSS {
        layers.shade:
            area: l24px t24px r24px b24px
            fill_color: #0000
            radius: 8
            box_shadow: 0 8px 20px #000a
        :square
            layers.shade:
                radius: 0
    }

# a free window's outline: over its own edge, so the mask's soft
# corner pixels take the line, not the dark under them
element WinEdge
    ghost : true
    public square : bool
    style : CSS {
        layers.edge:
            fill_color: #0000
            stroke_width: 1
            stroke_color: #ffffff26
            radius: 8
        :square
            layers.edge:
                radius: 0
    }

# a free window's strip across its top: the system bar it took
# with it (its menus, title, arrows, close). a drag on it moves the
# window; let go at the top edge, or a double click, it docks
element WinStrip
    public pane    : i32
    # the selected window's: the selection colour, as the title's
    public current : bool
    intern held    : bool
    intern pulled  : bool
    intern went    : f32
    # the drag so far, x and y
    intern sx      : f32
    intern sy      : f32

    style : CSS {
        area: l0 t0 r0 h0.91
        # another window's: lighter; the selected one's black, as
        # the system bar it took with it
        layers.tbar:
            fill_color: #00000066
            radius: 8 8 0 0
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            stroke_color: #fff1
            near_border: true
            near_inset: 1.0
            near_inset_color: #c890ffaa
        layers.tface:
            label_color: #fff
            label_size: 13
            label_align: 0.5 0.5
        :current
            layers.tbar:
                fill_color: #000
        layers.tdiv:
            fill_color: #fff2
            area: l0 b0 r0 h1px
    }

    func orb [] -> orbiter
        return cast orbiter [ (ux) ? ux.app_object : null ]

    func on_press [ ev: Event ]
        o : orb[]
        # a press on its menus or buttons is theirs
        if [ !o || ev.origin != a ] return
        ev.no_default     = true
        ev.no_propagation = true
        if [ ev.mouse.double_click ]
            o.dock_pane[ pane ]
            return
        o.raise_pane[ pane ]
        held   = true
        pulled = false
        went   = 0.0
        sx     = 0.0
        sy     = 0.0
        ux.set_capture[ a ]

    func on_move [ ev: Event ]
        o : orb[]
        if [ !held || !o ] return
        dx : f32 [ ev.mouse.delta.x ]
        dy : f32 [ ev.mouse.delta.y ]
        went += max[ dx, -dx ] + max[ dy, -dy ]
        if [ !pulled ]
            sx += dx
            sy += dy
            if [ went < 6.0 ] return
            pulled = true
            dx = sx
            dy = sy
            o.pull_free[ pane, a.parent ]
        o.move_free[ pane, dx, dy ]

    func on_release [ ev: Event ]
        if [ held ] ux.release_capture[ a ]
        o : orb[]
        if [ pulled && o ] o.drop_free[ pane ]
        held   = false
        pulled = false

# the system bar's free space: the docked window's title. pulled
# down, the window comes free under the pointer; a click is the
# title's
element BarGrab
    public pane : i32
    intern held : bool
    intern went : f32
    # the drag so far, x and y
    intern sx   : f32
    intern sy   : f32
    intern pulled : bool

    func orb [] -> orbiter
        return cast orbiter [ (ux) ? ux.app_object : null ]

    func on_press [ ev: Event ]
        o : orb[]
        if [ o ] o.grab_pane = pane
        held   = true
        pulled = false
        went   = 0.0
        sx     = 0.0
        sy     = 0.0
        ux.set_capture[ a ]
        ev.no_default     = true
        ev.no_propagation = true

    func on_move [ ev: Event ]
        o : orb[]
        if [ !held || !o ] return
        dx : f32 [ ev.mouse.delta.x ]
        dy : f32 [ ev.mouse.delta.y ]
        went += max[ dx, -dx ] + max[ dy, -dy ]
        if [ !pulled ]
            sx += dx
            sy += dy
            if [ went < 6.0 ] return
            pulled = true
            dx = sx
            dy = sy
            o.pull_free[ pane, o.pane_view[ pane ] ]
        o.move_free[ pane, dx, dy ]

    func on_release [ ev: Event ]
        if [ held ] ux.release_capture[ a ]
        o : orb[]
        if [ held && !pulled && o && o.pane_loads[ pane ] ]
            o.bar_title_press[]
        el [ pulled && o ]
            o.drop_free[ pane ]
        if [ o ] o.grab_pane = -1
        held   = false
        pulled = false

# a free window's edge, just outside it: 1 right, 2 bottom, 4
# left, 8 top; a corner is two together: a drag sizes it
element FreeGrip
    public pane : i32
    public side : i32
    intern held : bool

    func orb [] -> orbiter
        return cast orbiter [ (ux) ? ux.app_object : null ]

    func on_press [ ev: Event ]
        o : orb[]
        if [ !o ] return
        o.raise_pane[ pane ]
        held = true
        ux.set_capture[ a ]
        ev.no_default     = true
        ev.no_propagation = true

    func on_move [ ev: Event ]
        o : orb[]
        # the corner takes both ways
        kind : i32 [ (side == 2 || side == 8) ? 2 : 1 ]
        if [ side == 3 || side == 12 ] kind = 5
        if [ side == 6 || side == 9 ] kind = 6
        if [ ux ] ux.seam_cursor[ kind ]
        if [ !held || !o ] return
        o.size_free[ pane, side, ev.mouse.delta.x, ev.mouse.delta.y ]

    func on_release [ ev: Event ]
        if [ held ] ux.release_capture[ a ]
        held = false

    func on_leave [ ev: Event ]
        if [ !held && ux ] ux.seam_cursor[ 0 ]

# orbiter's avatars: the app's state fed to the look each frame
OrbiterAvatar AppAvatar
    func on_state [ m: i32 ]
        orb : orbiter [ ux.app_object ]
        if [ orb ]
            work_on   = orb.busy
            edits_in  = orb.agent_changed
            work_done = orb.agent_done
            # done: no beam while a reload waits; it faces the user
            swap_on   = orb.swap_live && !orb.agent_done
            mic_on    = orb.listening[]
        super.on_state[ m ]

    # clicking the avatar dismisses it — same as the toggle off
    func on_click [ ev: Event ]
        if [ drag_moved ] return
        orb : orbiter [ ux.app_object ]
        if [ orb ]
            #orb.show_orbiter = false
            if [ orb.listening[] ] orb.toggle_listen[ null ]
        ev.no_propagation = true

