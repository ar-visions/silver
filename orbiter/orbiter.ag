    func side_lit [ key: string ] -> bool
        if [ find_text && find_text.count > 0 ] return false
        if [ side_off && side_off.compare[ key ] == 0 ] return false
        nrs : string (nav_root) ? '{nav_root}' : ''
        dir : path repo_dir[ key ]
        rds : string '{dir}'
        rdp : string '{dir}/'
        return nrs.compare[ rds ] == 0 || nrs.starts_with[ rdp ]

    # the finder stays up (the title keeps focus) so the column is still
