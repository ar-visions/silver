                sync_tabs[]
                return
        
        if [ ev.target.id == 'view_close' ]
            edc : Editor pane_of[ ev.target ]
            if [ !edc ] edc = pane_at[ active_pane ]
            if [ edc ]
                if [ edc.view_name == 'git' ] edc.git_on = false
