# on the status bar: a faint border the pointer's light brings up
StatusTab StatusButton
    outline : rgba [ '#0000' ]
    style : CSS {
        layers.edge:
            stroke_color: #ffffff08
    }

# the bottom bar's volume: the slider inside a 1 px outline (room
# for a spectrum behind the track later)
# the system menu's volume: a round thumb (4/5 of the height, a
# round button's look) on a thin pill track half its height; inside
# the track, set in from its edge, only the sound now: solid white
# from the left toward the thumb. pad_l / pad_r set the track so the
# thumb sits inside the pill at both ends
VolumeSlider BarVolume
    animated : true
    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        cv : Canvas w.screen
        h : f32 [ bounds.h ]
        kd : f32 [ round[ h * 0.8 ] ]
        kr : f32 [ kd * 0.5 ]
        th : f32 [ round[ kd * 0.5 ] ]
        ty : f32 [ round[ (h - th) * 0.5 ] ]
        tr : f32 [ th * 0.5 ]
        cv.save[ ]
        # the track's border: the round buttons' edge, lit by the
        # pointer as theirs
        cv.save[ ]
        w.near_light_reach[ cv, a, 0.0, 0.0, 0.5 ]
        cv.near_style[ 1.0, 2.0, rgba [ '#c890ffff' ], w.near_y_fade ]
        cv.rounded[ tr, tr, tr, tr ]
        cv.fill_color[ rgba [ '#ffffff08' ] ]
        cv.stroke_width[ 1.0 ]
        cv.stroke_offset[ -0.5 ]
        cv.stroke_color[ rgba [ '#ffffff1c' ] ]
        cv.rect_to[ 0.0, ty, bounds.w, th ]
        cv.paint[ ]
        cv.restore[ ]
        # the track VolumeSlider's hit math uses (its inset is 7 px)
        tx : f32 [ 7.0 + pad_l ]
        tw : f32 [ bounds.w - 14.0 - pad_l - pad_r ]
        kx : f32 [ tx + tw * clamp[ value, 0.0, 1.0 ] ]
        # the sound now: its loudest band, white, inside the track
        ins : f32 [ 4.0 ]
        lh : f32 [ th - ins * 2.0 ]
        orb9 : cast orbiter [ w.app_object ]
        bs : vec f32 (orb9) ? orb9.vol_bands : null
        lv : f32 [ 0.0 ]
        if [ bs ]
            for [ i: i32 0, i < bs.count, i += 1 ]
                if [ bs[ i ] > lv ] lv = bs[ i ]
        cw : f32 [ kx - ins ]
        lw : f32 [ round[ cw * clamp[ lv, 0.0, 1.0 ] ] ]
        if [ lh > 0.5 && lw > 1.0 ]
            if [ lw < lh ] lw = lh
            cv.stroke_width[ 0.0 ]
            cv.rounded[ lh * 0.5, lh * 0.5, lh * 0.5, lh * 0.5 ]
            cv.fill_color[ rgba [ '#ffffffdd' ] ]
            cv.rect_to[ ins, ty + ins, lw, lh ]
            cv.paint[ ]
        # the thumb: a round button: an opaque ground (the track's line
        # stays under it), the faint fill, the inner glow, the edge the
        # pointer lights
        ky : f32 [ round[ (h - kd) * 0.5 ] ]
        cv.rounded[ kr, kr, kr, kr ]
        cv.stroke_width[ 0.0 ]
        cv.fill_color[ rgba [ '#211a33' ] ]
        cv.rect_to[ kx - kr, ky, kd, kd ]
        cv.paint[ ]
        cv.save[ ]
        w.near_light_reach[ cv, a, 0.0, 0.0, 0.5 ]
        cv.near_style[ 1.0, 4.0, rgba [ '#c890ffff' ], w.near_y_fade ]
        cv.box_shadow[ rgba [ '#8af2' ], 0.0, 0.0, 13.0, 0.0, true ]
        cv.rounded[ kr, kr, kr, kr ]
        cv.fill_color[ rgba [ (hovered) ? '#ffffff1c' : '#ffffff10' ] ]
        cv.stroke_width[ 1.0 ]
        cv.stroke_offset[ -0.5 ]
        cv.stroke_color[ rgba [ '#ffffff10' ] ]
        cv.rect_to[ kx - kr, ky, kd, kd ]
        cv.paint[ ]
        cv.no_shadows[ ]
        cv.restore[ ]
        cv.restore[ ]

# a group whose buttons each take the light, a disabled one none
StatusButton StatusSegs
    seg_near  : rgba [ '#ffffff08' ]
