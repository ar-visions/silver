    # room round the chips: the clip keeps their borders whole
    public pad   : f32
    style : CSS {
        layers.body:
            overflow: clip
    }

    func on_wheel [ ev: Event ]
        mx : f32 [ max[ span - bounds.w + pad * 2.0, 0.0 ] ]
        d  : f32 [ f32[ ev.mouse.wheel_delta.y
            + ev.mouse.wheel_delta.x ] * 26.0 ]
        shift = clamp[ shift - d, 0.0, mx ]
        ev.no_propagation = true
        if [ ux ] ux.restyle = true

