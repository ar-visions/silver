    # the next page of the listing being shown
    func repo_more_fetch []
        if [ !repo_user || repo_user.count == 0 || repo_fetch_fd > 0 ]
            return
        repo_fetch_start[ repo_user, repo_page + 1 ]
        run_search[]

    func repo_fetch_start [ user: string, page: i32 ]
        if [ repo_fetch_fd > 0 && repo_fetch_user && repo_fetch_user.compare[ user ] == 0 ]
            return
        if [ repo_fetch_fd > 0 ]
            pclose[ repo_fetch_fh ]
            repo_fetch_fh = null
            repo_fetch_fd = -1
        host : RepoHost repo_host_of[]
        if [
            host.token && host.token.count > 0
            && (!host.me || host.me.count == 0) ]
            host.me = repo_token_login[ host ]
            if [
                host.me.count > 0
                && (!self_user || self_user.compare[ host.me ] != 0) ]
                self_user = host.me
                save_session[]
        cmd : string host.list_cmd[ user, page ]
        repo_fetch_page = page
        repo_fetch_fh_cmd : command [ cmd ]
        repo_fetch_fh = repo_fetch_fh_cmd.stream[]
        if [ !repo_fetch_fh ]
            repo_note = 'no curl'
            return
        repo_fetch_fd   = fileno[ repo_fetch_fh ]
        fcntl[ repo_fetch_fd, F_SETFL, O_NONBLOCK ]
        repo_fetch_user = user
        repo_fetch_buf  = ''
        repo_note = (page > 1) ? 'loading more' : 'loading'
        if [ ux ] ux.will_animate = true

    # the listing pipe: read what is there; at its end parse, cache,
    # show
    func repo_fetch_pump [ w: Window ]
        if [ repo_fetch_fd <= 0 ] return
        w.will_animate = true
        buf : local i8 [ 8193 ]
        n9 : i32 [ read[ repo_fetch_fd, @buf[0], 8192 ] ]
        if [ n9 > 0 ]
            buf[ n9 ] = 0
            got : string[ @buf[0] ]
            repo_fetch_buf = repo_fetch_buf + got
            return
        if [ n9 != 0 ] return
        pclose[ repo_fetch_fh ]
        repo_fetch_fh = null
        repo_fetch_fd = -1
        user : string repo_fetch_user
        repo_fetch_user = ''
        if [ repo_fetch_buf.index_of[ 'rate limit' ] >= 0 ]
            repo_note = (repo_stale) ? 'github rate limit (add a token); showing an older list' : 'github rate limit (add a token)'
            if [ repo_stale && repo_user && repo_user.compare[ user ] == 0 ]
                repo_items = repo_stale
        el [ repo_fetch_buf.index_of[ 'Bad credentials' ] >= 0 ]
            repo_note = 'github rejected the token'
        el
            items : vec RepoInfo repo_parse[ repo_fetch_buf ]
            if [
                items.count > 0 || repo_fetch_buf.index_of[ '[' ] >= 0 ]
                if [ repo_user && repo_user.compare[ user ] == 0 ]
                    # page 1 replaces the list; a later page extends it
                    if [ repo_fetch_page <= 1 || !repo_items ]
                        repo_items = items
                    el
                        for [ it: RepoInfo ] in items
                            repo_items.push[ it ]
                    repo_page = repo_fetch_page
                    repo_more = items.count >= 100
                    repo_note = ''
                    cp : path repo_cache_path[ user ]
                    repo_cache_write[ cp, repo_items, repo_page,
                                      repo_more ]
            el
                repo_note = 'no answer from github'
        repo_fetch_buf = ''
        if [ find_text && find_text.count > 0 ] run_search[]
        cv9 : element find_el[ a, 'commit' ]
        if [ cv9 ] cv9.pristine = false

    # an added user leaves the column (shift shows the - that does it);
    # the login the key answers to is never in this list, so it never
    # leaves
    func repo_forget [ user: string ]
        if [ !repo_users ] return
        for [ i: i32 0, i < repo_users.count, i += 1 ]
            if [ repo_users[i].compare[ user ] == 0 ]
                repo_users.remove[ i ]
                save_session[]
                return

    public func is_pinned [ p: path ] -> bool
        if [ !p || !pins ] return false
        ps9 : string '{p}'
        for [ s9: string ] in pins
            if [ s9.compare[ ps9 ] == 0 ] return true
        return false

    # shift's + pins an entry (last in the list), its − unpins it
