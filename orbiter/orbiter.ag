    public func on_canvas [ cv: Canvas ]
    	i2 : int [ 1 ]
        super.on_canvas[ cv ]
        # disk watch runs here: layer draws skip pristine editors
        for [ i_: i32 0, i_ < editor_slots.count, i_ += 1 ]
            e_ : Editor pane_at[ i_ ]
            if [ !e_ ] continue
            e_.check_disk[]
            if [ pending_sel && i_ < pending_sel.count ]
                ps_ : vec2i pending_sel[i_]
                if [ ps_.x >= 0 && e_.lines && e_.lines.count > 1 ]
                    l_ : i32 [ clamp[ ps_.x, 0, e_.lines.count - 1 ] ]
                    e_.sel_line    = l_
                    e_.sel_col     = ps_.y
                    e_.anchor_line = l_
                    e_.anchor_col  = ps_.y
                    # the saved scroll as it was; a session without one
                    # brings the caret into view instead
                    if [
                        pending_scroll && i_ < pending_scroll.count
                        && pending_scroll[i_] >= 0.0 ]
                        e_.scroll.y      = pending_scroll[i_]
                        e_.scroll_goal = e_.scroll.y
                        e_.pristine      = false
                    el e_.ensure_caret_visible[]
                    pending_sel[i_] = vec2i [ x: -1, y: -1 ]

# its xdg-open (xdg-open.c) into install/bin, made again when the
# source is newer: a program orbiter starts opens addresses in aura
export func orbiter_xdg_open []
    inst : string '{path.path_install[]}'
    srcs : path '{inst}/build/silver-orbiter.source'
    if [ !srcs.exists[] ] return
    txt : string [ srcs.load[ typeid[string], null ] ]
    if [ !txt ] return
    lines : txt.split[ '\n' ]
    first : path [ lines[ 0 ] ]
    src : path '{first.parent_dir[]}/xdg-open.c'
    bin : path '{inst}/bin/xdg-open'
    if [ !src.exists[] ] return
    if [ bin.exists[] && bin.modified_time[] >= src.modified_time[] ]
        return
    cc : command { {inst}/bin/clang -Os -o {bin} {src} }
    if [ cc.exec[ false ] != 0 ] log 'orbiter: xdg-open did not build'

# the app's icon: the avatar at 512, made once (delete it to remake)
export func orbiter_icon []
    inst : path.path_install[]
    if [ !inst ] return
    # the module folder: the first source the install lists for it
    srcs : path '{inst}/build/silver-orbiter.source'
    if [ !srcs.exists[] ] return
    txt  : string [ srcs.load[ typeid[string], null ] ]
    if [ !txt ] return
    lines : txt.split[ '\n' ]
    first : path [ lines[ 0 ] ]
    out   : path '{first.parent_dir[]}/images/icon.png'
    force : getenv[ 'SILVER_EXPORT_FORCE' ]
    if [ force || !out.exists[] ]
        vk_ : vk_context []
        vk_.hold[]
        w_ : Window [ vk: vk_, format: Pixel.rgba8, backbuffer: true,
            width: 512, height: 512 ]
        w_.hold[]
        if [ !w_.element_targets ]
            w_.element_targets = map Render [string] []
        # the screen canvas a running window makes in its update
        w_.screen = Canvas [ w: w_, vk: vk_, format: Pixel.rgba8,
                             load_existing: true,
            width: 512, height: 512 ]
        w_.screen.resize[ 512, 512 ]
        w_.screen.update[]
        # mounted as the window mounts an element: context first, then
        # initialize (the member defaults), then bind and hold members
        av : OrbiterAvatar [ id: 'icon' ]
        av.hold[]
        av.ux = w_
        av.vk = w_.vk
        av.initialize[]
        bind_members[ av ]
        av.hold_members[]
        av.bounds = rect [ x: 0.0, y: 0.0, w: 512.0, h: 512.0 ]
        # the app's resting yaw (on_state sets it there): flat top and
        # bottom
        av.rotate = vec Rotation []
        av.rotate.push[ Rotation [ '0 1 0 30deg' ] ]
        av.rotate.push[ Rotation [ '1 0 0 0deg' ] ]
        im : av.icon_image[ w_, 512 ]
        im.png[ out ]
        log 'orbiter: icon written {out}'
    el
        log 'orbiter: icon current'

expect func t_scene_exports_refresh [] -> bool
    root : path '/tmp/orbiter-scenes-{getpid[]}'
    root.make_dir[]
    first : path '{root}/first.agi'
    note : path '{root}/note.txt'
    second : path '{root}/second.agi'
    first.save[ "scenes: ['First']\n", null ]
    before : i64 scene_exports_stamp[ root.ls[ null, false ] ]
    note.save[ 'ignored\n', null ]
    with_note : i64 scene_exports_stamp[
        root.ls[ null, false ] ]
    second.save[ "scenes: ['Second']\n", null ]
    after : i64 scene_exports_stamp[ root.ls[ null, false ] ]
    first.remove[]
    note.remove[]
    second.remove[]
    root.remove_dir[]
    return before == with_note && before != after

