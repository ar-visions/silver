    # and the chosen one), with their pictures while off the window
    intern scene_kept    : map element [ string ]
    intern scene_rts     : map Render [ string ]
    # the agent view's background, our galaxy, built once and kept
    # (its picture while off the window); the chosen scene then
    # shows in the floor's mirrors only
    intern galaxy_el     : element
    # the agents whose avatars have risen out of the glass: a
    # platform made again shows them up, not rising again
    public home_risen    : vec string
    # the platform, made once: its avatars, their turns and the
    # camera go on across visits to the agents view
    intern plat_kept     : element

    # the agents view's platform, kept; its free width set again
    public func platform_of [ fw: f32 ] -> element
        if [ !plat_kept ]
            plat_kept = PlatformView [ frame_w: fw,
                                       area: Region { l0 t0 r0 b0 } ]
        pv : PlatformView plat_kept
        pv.frame_w = fw
        return plat_kept
    intern galaxy_rt     : Render
    # each scene's props as the user set them, by scene name (agi)
    public [ StatePersist ] scene_props   : map string [string]
    intern frost_dbg8    : i32 [ -9 ]

    func init [] 
        # tick carries the per-frame work (session pump, run dispatch,
        # pane close-outs); a paint happens only when something marks it
        # dirty
        breakpoints    = map string[string] []

        target_names   = vec string []
        target_roots   = vec path []
        target_srcs    = vec path []
        # what it starts opens addresses in aura: its xdg-open finds
        # orbiter's socket here (trinity names it so)
        rt : cstr getenv[ 'XDG_RUNTIME_DIR' ]
        run_dir : string [ (rt) ? string [ rt ] : '/tmp' ]
        sock : string '{run_dir}/trinity-orbiter.sock'
        setenv[ 'ORBITER_SOCKET', sock.chars, 1 ]
        load_settings[]
        # a source change is staged, never swapped on its own: the swap
        # goes when the agent reports done with the exchange up
        au_live_set_defer[ 1 ]
        # the exchange avatar exists from load
        # live reload test: this comment came through the exchange
        # parallel swap test: the next instance loads beside this one
        # carry test: the exchange and avatar cross the swap as they
        # were carry test 2: the avatar keeps its settled place, the
        # fade is 3 s
        agent_av = AgentAvatar [ topmost: true, animate_always: true ]
        file_cache     = map FileBuf [string] []
        open_files     = vec path []
        active_idx     = -1
        # one editor pane to start, empty (the 'Open' finder)
        editor_slots   = vec i32 [] [-1]
        pane_console   = vec string [] ['']
        active_pane    = 0
        nav_panes      = vec Navigate []
        for [ i: i32 0, i < 8, i += 1 ]
            nav_panes += Navigate []
        active_panel   = 'files'
        active_target  = 'silver'
        restore_session[]
        adopt_live_slots[]
        nav_root       = project_root[]
        # warm the git snapshot now: the view reads it, never fetches
        git_summarize[]
        # first token is ours to open; everything after belongs to the
        # module
        if [ module_args && module_args.count > 0 ]
            sp9 : i32 [ module_args.index_of[ ' ' ] ]
            if [ sp9 > 0 ]
                resource    = module_args.mid[ 0, sp9 ]
                module_args = module_args.mid[ sp9 + 1,
                                               module_args.count - sp9
                                               - 1 ]
            el
                resource    = module_args
                module_args = ''
        dbg_start : bool [ false ]
        if [ resource && resource.count > 0 ]
            rp : path '{startup_path}/{resource}'
            if [ resource.chars[0] == 47 ] rp = path '{resource}'
            if [ rp.exists[] ]
                if [ rp.is_dir[] ]
                    nav_root = rp
                    # a module dir opens its main source: orbiter asnes
                    # -> asnes/asnes.ag
                    mp8 : path '{rp}/{rp.stem[]}.ag'
                    if [ mp8.exists[] ]
                        mi : i32 [ file_slot[ mp8 ] ]
                        if [ editor_slots.count == 0 ]
                            editor_slots += -1
                        editor_slots[0] = mi
                        active_pane = 0
                        active_idx  = mi
                        # the tail after the module is that run's args,
                        # over any saved
                        if [ module_args && module_args.count > 0 ]
                            fs7 : file_state fstate[ mp8 ]
                            if [ fs7 ] fs7.args = module_args
                        # an app switched to us (its host set this): its
                        # source opens with a held instance of it,
                        # stopped until started
                        if [ getenv[ 'SILVER_START_HELD' ] ]
                            pending_held = 0
                            # this window came from that app: pin it in
                            # the title
                            home_mod = rp.stem[]
                        el
                            pending_run = 0
                el
                    ri : i32 [ file_slot[ rp ] ]
                    if [ editor_slots.count == 0 ] editor_slots += -1
                    editor_slots[0] = ri
                    active_pane = 0
                    active_idx  = ri 
                    # the arg we were handed at startup is this file's
                    # arg
                    fs8 : file_state fstate[ rp ]
                    if [ fs8 ] fs8.args = '{rp}'
            el
                bp : path '{startup_path}/install/build/{resource}'
                if [ bp.exists[] ]
                    # open the module's SOURCE and host it in the pane.
                    # exec'ing the binary here gave it its own window
                    # instead of a texture
                    sp8 : path '{startup_path}/{resource}/{resource}.ag'
                    op8 : path [ (sp8.exists[]) ? sp8 : bp ]
                    bi : i32 [ file_slot[ op8 ] ]
                    if [ editor_slots.count == 0 ] editor_slots += -1
                    editor_slots[0] = bi
                    active_pane   = 0
                    active_idx    = bi
                    active_target = resource
                    # the tail after the module is that run's args, over
                    # any saved
                    if [ module_args && module_args.count > 0 ]
                        fs9 : file_state fstate[ op8 ]
                        if [ fs9 ] fs9.args = module_args
                    if [ sp8.exists[] ]
                        pending_run = 0
                    el
                        dbg_start = true
                el
                    log 'orbiter: no such resource {resource}'
        orbit_sid = agent_sid[]
        orbit_sid.hold[]
        if [ !ed_sessions ]
            ed_sessions = map ConsoleSession [string] [ ]
        filter_text    = ''
        find_text      = ''
        findbar_open   = false
        findbar_text   = ''
        replace_text   = ''
        pattern_text   = ''
        find_showing   = false
        find_hits      = vec FindHit []
        search_dirs    = vec path []
        root_search[]
        file_index     = list string []
        find_results   = list string []
        index_dirty    = false
        index_watches  = vec watch []
        index_lock     = mutex [ ]
        tok_lock       = mutex [ ]
        tok_skip       = vec string [] [
            'png', 'jpg', 'jpeg', 'gif', 'bmp', 'ico', 'webp', 'tga',
            'exr',
            'hdr', 'ktx', 'dds', 'psd', 'ttf', 'otf', 'woff', 'woff2',
            'wav', 'mp3', 'ogg', 'flac', 'aiff', 'mp4', 'mov', 'avi',
            'mkv',
            'zip', 'gz', 'bz2', 'xz', 'tar', '7z', 'rar', 'pdf',
            'o', 'a', 'so', 'dylib', 'dll', 'lib', 'exe', 'obj', 'pyc',
            'bin', 'dat', 'db', 'sqlite', 'pack', 'idx', 'spv', 'bc',
            'safetensors', 'pt', 'onnx', 'npy', 'npz', 'jar', 'class',
            'icns', 'dmg', 'img', 'iso', 'nes', 'sfc', 'gba', 'rom',
            'n64' ]
        start_watching[]
        # kick off the index build on its worker thread
        start_index[]
        compile_log    = list string []
        ensure_user_config[] 
        if [ dbg_start ] start_debug[ resource ]

    func ensure_user_config []
        home : string [ getenv[ 'HOME' ] ]
        if [ !home || home.count == 0 ] return
        xdg  : string [ getenv[ 'XDG_CONFIG_HOME' ] ]
        base : string (xdg && xdg.count > 0) ? xdg : '{home}/.config'
        dir  : path '{base}/orbiter'
        dir.make_dir[]
        cfg  : path '{base}/orbiter/orbiter.config'
 
    func agi_path [] -> path
        if [ !startup_path ] startup_path = path.path_startup[]
        p : path '{startup_path}/orbiter.agi'
        if [ p.exists[] ] return p
        d : path startup_path
        for [ i: i32 0, i < 6, i += 1 ]
            d = d.parent_dir[]
            if [ !d ] return p
            p2 : path '{d}/orbiter.agi'
            if [ p2.exists[] ]
                startup_path = d
                return p2
        return p

    func resolve_local [ p: path ] -> path
        if [ !startup_path ] startup_path = path.path_startup[]
        if [ !p ] return path '{startup_path}'
        s : string '{p}'
        if [ s.count == 0 || s == '.' ] return path '{startup_path}'
        if [ s[0] == '/' ] return p
        return path '{startup_path}/{s}'

    func cache_dir [] -> path
        return path.path_storage[ 'orbiter' ]

    # per-file state, created on first touch
    func fstate [ p: path ] -> file_state
        if [ !p ] return null
        if [ !file_states ] file_states = map file_state [string] []
        k9 : string '{p}'
        fs : file_state file_states[ k9 ]
        if [ !fs ]
            fs = file_state []
            file_states[ k9 ] = fs
        return fs

    func file_args [ p: path ] -> string
        if [ !p || !file_states ] return ''
        fs : file_state file_states[ '{p}' ]
        return (fs && fs.args) ? fs.args : ''

    func save_session []
        # setup has no session of its own to keep
        if [ install ] return
        panes : vec pane_state []
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            slot : i32 [ editor_slots[i] ]
            if [
                slot >= 0 && slot < open_files.count
                && open_files[slot] ]
                e9 : Editor pane_at[ i ]
                sel9 : vec2i [ x: (e9) ? e9.sel_line : 0,
                    y: (e9) ? e9.sel_col : 0 ]
                rv9 : AppView (e9) ? e9.run_view : null
                panes.push[ pane_state [
                    file: open_files[slot], selection: sel9,
                    scroll: (e9) ? e9.scroll.y : 0.0,
                    app: e9 && e9.app_view && rv9 && !rv9.ended
                        && !rv9.held && rv9.slot >= 0 ] ]
        pane_states = panes
        # instances do not persist: a session starts with none
        inst_states = vec inst_state []
        scene       = scene_loaded[]
        save-persistent[ a ]

    func restore_session []
        load-persistent[ a ]
        if [ pane_states && pane_states.count > 0 ]
            editor_slots = vec i32 []
            pending_sel = vec vec2i []
            pending_scroll = vec f32 []
            for [ i: i32 0, i < pane_states.count, i += 1 ]
                ps9 : pane_state pane_states[i]
                if [ ps9 && ps9.file ]
                    # its app was showing: it runs there again
                    if [ ps9.app && pending_run < 0 ]
                        pending_run = editor_slots.count
                    editor_slots += file_slot[ ps9.file ]
                    pending_sel += ps9.selection
                    pending_scroll += ps9.scroll
            if [ editor_slots.count == 0 ] editor_slots += -1
            active_pane = 0
        # nothing saved yet: the first known file. a saved empty
        # list is the empty pane (the last file was closed)
        el [ !pane_states && open_files.count > 0
             && editor_slots.count > 0 ]
            editor_slots[0] = 0
        if [ breakpoints ] last_bp_count = breakpoints.count
        # an explicit --scene_load beats whatever the last session left
        # behind
        if [
            scene && scene.count > 0
            && (!scene_load || scene_load.count == 0) ]
            scene_load = scene
            scene_load.hold[]

    func load_settings []
        sp  : agi_path[]
        log 'load_settings: startup_path={startup_path} -> agi={sp}'
        txt : string [ sp.load[ typeid[string], null ] ]
        if [ !txt || txt.count == 0 ]
            log 'load_settings: no/empty file at {sp}'
            return
        settings_mtime = sp.modified_time[]
        if [ projects ] projects.clear[]
        Au.parse_agi[ null, txt.chars, a ]
        if [ projects ]
            for [ p: Project, name: string ] in projects
                p.root = resolve_local[ p.root ]
                if [ p.cwd ] p.cwd = resolve_local[ p.cwd ]
        sync_targets[]
        if [ projects ]
            log 'loaded {projects.count} projects:'
            for [ p: Project, name: string ] in projects
                log '  {name}: root={p.root}'
                if [ p.deps ]
                    for [ d: token ] in p.deps
                        log '    dep: {d.chars}'
        el
            log 'loaded 0 projects (projects is null)'

    func sync_targets []
        target_names = vec string []
        target_roots = vec path []
        target_srcs  = vec path []
        if [ !projects ]
            return
        for [ p: Project, name: string ] in projects
            target_names += name
            target_roots += p.root
            target_srcs  += p.root

    func check_stale []
        for [ i: i32 0, i < target_names.count, i += 1 ]
            name    : string target_names[i]
            src     : path   target_srcs[i]
            product : path  '{startup_path}/install/build/{name}'
            if [ !product.exists[] ]
                compile_log.push[ 'stale (no product): {name}' ]
                compile[ name ]
                continue
            product_mtime : i64 [ product.modified_time[] ]
            src_mtime     : i64 [ 0 ]
            src.latest_modified[ @src_mtime ]
            if [ src_mtime > product_mtime ]
                compile_log.push[ 'stale (source newer): {name}' ]
                compile[ name ]

    func compile_fn [ w: Au ] 
        m: string w  
        i: silver [ component: true, module: m ]  

    func compile [ mod: string ]
        active_target = 'system'
        compile_log.push[ 'compiling {mod}...' ]
        i: silver [ component: true, verbose:true, module: mod ]
        au_space_clear[]
        compile_log.push[ 'done: {mod}' ]

    func fmt_stop [ key: string ]
        if [ !fmt_watch ] return
        fw : FmtWatch fmt_watch[ key ]
        if [ !fw ] return
        if [ fw.fd >= 0 ] close[ fw.fd ]
        fmt_watch.rm[ key ]

    func fmt_stop_all []
        if [ !fmt_watch ] return
        for [ fw: FmtWatch, name: string ] in fmt_watch
            if [ fw.fd >= 0 ] close[ fw.fd ]
        fmt_watch = map FmtWatch [string] []

    # the module holding f is building now (its instance starting, a
    # live reload): a second build would race it on the same files
    func module_building [ f: path ] -> bool
        if [ !f ] return false
        dir : string '{f.directory[]}'
        if [ build_frac[ f.directory[].filename[] ] > -2.0 ] return true
        if [ !instances ] return false
        for [ av: AppView ] in instances
            if [ av.ended || !av.src ] continue
            if [ '{av.src.directory[]}' != dir ] continue
            if [ av.status_word[] == 'compiling' ] return true
        return false

    func fmt_spawn [ fw: FmtWatch ]
        if [ !fw ] return
        if [ !startup_path ] startup_path = path.path_startup[]
        if [ fw.fd >= 0 ]
            close[ fw.fd ]
            fw.fd = -1
        cmd : 'cd {startup_path} && unset IMPORT && exec ./install/bin/silver --build {fw.file} > /tmp/orbiter-fmt-{fw.proj}.log 2>&1'
        fd  : i32 [ -1 ]
        pid : i32 [ forkpty[ @fd, null, null, null ] ]
        if [ pid == 0 ]
            dashc : string '-c'
            execl[ '/bin/bash', 'bash', dashc.chars, cmd.chars, null ]
            _exit[ 1 ]
        el [ pid > 0 ]
            fw.pid = pid
            fw.fd  = fd
            fcntl[ fd, F_SETFL, O_NONBLOCK ]

    func fmt_main [ f: path ] -> path
        dir  : path f.parent_dir[]
        modn : string dir.filename[]
        m    : path '{dir}/{modn}.ag'
        if [ m.exists[] ] return m
        return f

    func fmt_start [ f: path ]
        if [ !f ] return
        if [ !startup_path ] startup_path = path.path_startup[]
        if [ !fmt_watch ] fmt_watch = map FmtWatch [string] []
        k : string '{f}'
        if [ fmt_watch[ k ] ] return
        fn   : string f.filename[]
        stem : string fn
        di   : i32 [ fn.rindex_of[ '.' ] ]
        if [ di > 0 ] stem = fn.mid[ 0, di ]
        fw : FmtWatch [ proj: stem, file: f,
                        map: '{startup_path}/install/syntax/{stem}.f',
                        start_us: epoch_micros[] ]
        fmt_watch[ k ] = fw

    # the handler module's lib exports `syntax`; it colours in-process
    func fmt_start_fn [ f: path, lib: string ]
        if [ !startup_path ] startup_path = path.path_startup[]
        # buffers key on the absolute path; the map's source must match
        fw : FmtWatch [ proj: lib, file: f.absolute[], map: '',
                        start_us: epoch_micros[], kicked: true,
                        announced: true ]
        fmt_watch[ '{f}' ] = fw
        so : path module_lib[ lib ]
        if [ !so.exists[] ] return
        # local: only dlsym on this handle needs its symbols
        h : dlopen[ so.chars, RTLD_NOW ]
        if [ !h ]
            log 'syntax: dlopen failed for {so}'
            return
        sym : string 'syntax'
        fw.fn = cast hook [ dlsym[ h, sym.chars ] ]
        if [ !fw.fn ] log 'syntax: {lib} exports no syntax function'
        el log 'syntax: {lib} colours {fw.file}'

    # re-ask the handler whenever the file on disk changes
    func fmt_poll_fn [ fw: FmtWatch ]
        if [ !fw.file ] return
        sm : i64 [ fw.file.modified_time[] ]
        if [ fw.mtime > 0 && sm <= fw.mtime ] return
        # the buffer is shared by every pane: ask once it is loaded
        ed0 : Editor null
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            ed : Editor pane_at[ i ]
            if [ ed && !ed0 ] ed0 = ed
        if [ !ed0 || !ed0.has_buffer[ fw.file ] ] return
        fn : hook fw.fn
        ff : fmt_file fn[ fw.file ]
        if [ !ff ] return
        fw.mtime = sm
        lns : vec Au ff.lines
        log 'syntax: {fw.proj} mapped {lns.count} lines for {ff.source}'
        ed0.apply_format[ ff ]
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            ed : Editor pane_at[ i ]
            if [ ed ] ed.pristine = false
        win : ux
        if [ win ] win.will_animate = true

    # an open file with no colouring takes its section from whichever
    # map holds one: a module built as another's dependency writes its
    # files into that root's map, never its own, and a pane only applies
    # a map when the map changes. tried once per file version; the
    # newest section wins, and one older than the file is refused where
    # every section is applied (apply_format)
    func fmt_borrow []
        if [ !startup_path ] startup_path = path.path_startup[]
        if [ !fmt_borrowed ] fmt_borrowed = map string [string] []
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            ed : Editor pane_at[ i ]
            if [ !ed || !ed.src || !ed.cur_buf ] continue
            if [ ed.cur_buf.line_regs && ed.cur_buf.line_regs.count > 0 ]
                continue
            fa : string '{ed.src.absolute[]}'
            if [ !fa.ends_with[ '.ag' ] ] continue
            sm : string '{ed.src.modified_time[]}'
            if [ fmt_borrowed.contains[ fa ] && fmt_borrowed[ fa ] == sm ]
                continue
            fmt_borrowed[ fa ] = sm
            sd : path '{startup_path}/install/syntax'
            entries : sd.ls[ null, false ]
            if [ !entries ] continue
            best : fmt_file null
            # this one file's section is all a map is read for
            want : map string [string] []
            want[ fa ] = fa
            for [ j: i32 0, j < entries.count, j += 1 ]
                e : path entries[j]
                if [ e.ext[] != 'f' ] continue
                files : vec Au e.read_format_of[ want ]
                if [ !files ] continue
                for [ fi: i32 0, fi < files.count, fi += 1 ]
                    ff : fmt_file files[fi]
                    if [ !ff || !ff.source || '{ff.source}' != fa ]
                        continue
                    if [ !best || ff.mtime > best.mtime ] best = ff
            if [ !best ] continue
            log 'syntax: {fa} coloured from another module map'
            ed.apply_format[ best ]
            ed.pristine = false
            win : ux
            if [ win ] win.will_animate = true

    func fmt_sync []
        if [ !fmt_watch ] fmt_watch = map FmtWatch [string] []
        if [ !open_files ] return
        live : vec string []
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            slot : i32 [ editor_slots[i] ]
            if [ slot < 0 || slot >= open_files.count ] continue
            f : path open_files[slot]
            if [ !f ] continue
            fn : string f.filename[]
            if [ fn.count < 3 ] continue
            if [ fn.mid[ fn.count - 3, 3 ].compare[ '.ag' ] != 0 ]
                # not silver: the extension's handler module colours it
                ed  : Editor pane_at[ i ]
                lib : string (ed) ? ed.handler_lib_for[ f ] : null
                if [ !lib ] continue
                k2 : string '{f}'
                if [ live.index_of[ k2 ] < 0 ] live += k2
                if [ !fmt_watch[ k2 ] ] fmt_start_fn[ f, lib ]
                continue
            main : path fmt_main[ f ]
            k : string '{main}'
            if [ live.index_of[ k ] < 0 ] live += k
            if [ !fmt_watch[ k ] ] fmt_start[ main ]
        stale : vec string []
        if [ fmt_watch.count > 0 ]
            for [ fw: FmtWatch, k2: string ] in fmt_watch
                if [ live.index_of[ k2 ] < 0 ] stale += k2
        for [ i: i32 0, i < stale.count, i += 1 ]
            fmt_stop[ stale[i] ]

    func cov_file [] -> path
        return path '{path.path_startup[]}/install/tmp/coverage.lcov'

    # the map follows the file: a run replaces it, clear removes it
    func cov_poll []
        cp : path cov_file[]
        mt9 : i64 [ (cp.exists[]) ? cp.modified_time[] : 0 ]
        if [ mt9 != cov_mtime ]
            cov_mtime = mt9
            cov_text  = null
            if [ mt9 > 0 ]
                cov_text = cp.load[ typeid[string], null ]
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            ed : Editor pane_at[ i ]
            if [ !ed ] continue
            es : string [ (ed.src) ? '{ed.src}' : '' ]
            if [
                ed.cov_stamp != cov_mtime || !ed.cov_src
                || ed.cov_src != es ]
                cov_apply[ ed, es ]

    # this file's DA lines from the map, by 0-based line
    func cov_apply [ ed: Editor, src: string ]
        ed.cov_stamp = cov_mtime
        ed.cov_src   = src
        ed.cov_hits  = null
        if [ ed.ux ] ed.ux.restyle = true
        if [ !cov_text || src.count == 0 ] return
        at9 : i32 [ cov_text.index_of[ 'SF:{src}\n' ] ]
        if [ at9 < 0 ] return
        rest : string cov_text.mid[ at9, cov_text.count - at9 ]
        en : i32 [ rest.index_of[ 'end_of_record' ] ]
        if [ en > 0 ] rest = rest.mid[ 0, en ]
        rows9 : rest.split[ '\n' ]
        hits9 : vec i64 []
        for [ r: i32 0, r < rows9.count, r += 1 ]
            ln : string rows9[ r ]
            if [ !ln.starts_with[ 'DA:' ] ] continue
            c9 : i32 [ ln.index_of[ ',' ] ]
            if [ c9 < 4 ] continue
            l9 : i32 [ ln.mid[ 3, c9 - 3 ].integer_value[] ]
            h9 : i64 [
                ln.mid[ c9 + 1, ln.count - c9 - 1 ].integer_value[] ]
            if [ l9 < 1 ] continue
            while [ hits9.count < l9 ]
                hits9.push[ -1 ]
            hits9[ l9 - 1 ] = h9
        ed.cov_hits = hits9

    func fmt_poll []
        if [ !fmt_watch ] return
        for [ fw: FmtWatch, name: string ] in fmt_watch
            if [ fw.fn ]
                fmt_poll_fn[ fw ]
                continue
            if [ fw.kicked && fw.pid == 0 && fw.file
                 && !module_building[ fw.file ] ]
                sm : i64 [ fw.file.modified_time[] ]
                if [ fw.src_mtime > 0 && sm > fw.src_mtime ]
                    fw.src_mtime = sm
                    git_dirty = true
                    fmt_spawn[ fw ]
                el [ fw.src_mtime == 0 ]
                    fw.src_mtime = sm
        for [ fw: FmtWatch, name: string ] in fmt_watch
            if [ !fw.announced ]
                log 'syntax: {name} language service starting...'
                fw.announced = true
            if [ fw.fd >= 0 ]
                dbuf : local i8 [256]
                for [ j: i32 0, j < 64, j += 1 ]
                    nr : i32 [ read[ fw.fd, @dbuf[0], 256 ] ]
                    if [ nr <= 0 ] break
            if [ fw.pid > 0 ]
                st : i32 [ 0 ]
                r  : i32 [ waitpid[ fw.pid, @st, WNOHANG ] ]
                if [ r == fw.pid ]
                    code : i32 [ (st >> 8) & 0xFF ]
                    sig  : i32 [ st & 0x7F ]
                    if [ sig != 0 ]
                        log 'syntax: {name} CRASHED (signal {sig}) — see /tmp/orbiter-fmt-{fw.proj}.log'
                    el [ code != 0 ]
                        log 'syntax: {name} build FAILED (code {code}) — see /tmp/orbiter-fmt-{fw.proj}.log'
                        # jump the editor to silver's first emitted
                        # error location
                        err_mod = name
                        jump_to_error[
                            '/tmp/orbiter-fmt-{fw.proj}.log' ]
                    el
                        log 'syntax: {name} language service finished'
                        # only the module that failed may clear its own
                        # error
                        if [ err_mod && err_mod == name ]
                            err_file = null
                            err_line = 0
                            err_msg  = null
                            err_mod  = null
                    fw.pid = 0
            if [ fw.map && fw.map.count > 0 ]
                mp : path fw.map
                if [ mp.exists[] ]
                    m : mp.modified_time[]
                    # a map older than its source describes text that is
                    # already gone: its line/col ranges land on the
                    # wrong spans. leave the last good colouring until
                    # the service catches up -- but a pane with no
                    # colouring yet takes the stale map now rather than
                    # nothing for the minutes the service needs
                    fresh : bool [ true ]
                    if [ fw.file ]
                        sm2 : i64 [ fw.file.modified_time[] ]
                        fresh = m >= sm2
                    applied : bool [ false ]
                    for [ i: i32 0, i < editor_slots.count, i += 1 ]
                        ed : Editor pane_at[ i ]
                        if [
                            ed && (fresh || ed.fmt_mtime == 0)
                            && ed.fmt_mtime < m ]
                            ed.load_format[ fw.map ]
                            ed.fmt_mtime = m
                            ed.pristine = false
                            applied = true
                    if [ applied ]
                        win : ux
                        if [ win ] win.will_animate = true
                        if [ m > fw.mtime ]
                            fw.mtime = m
            if [ !fw.kicked && epoch_micros[] - fw.start_us >= 1000000
                 && !module_building[ fw.file ] ]
                fmt_spawn[ fw ]
                fw.kicked = true

    # the callstack is read from lldb once per stop; every render reads
    # the cache
    func debug_frames [] -> vec Au
        return (frame_cache) ? frame_cache : vec Au []

    # the frames the callstack lists: one with no known source only when
    # asked
    func stack_frames [] -> vec Au
        all : vec Au debug_frames[]
        if [ stack_unknown ] return all
        known : vec Au []
        for [ fr: Frame ] in all
            if [ fr && fr.file && fr.line > 0 ] known.push[ fr ]
        return known

    func refresh_frames []
        fr : vec Au []
        dv : dbg active_debugger[]
        if [ dv ]
            dfr : dv.read_frames[]
            if [ dfr ]
                for [ df: frame ] in dfr
                    fr.push[
                        Frame [ func_name: df.func_name, file: df.source,
                                line: i32[ df.line ] ] ]
        frame_cache = fr

    func agent_cmd [ sid: string ] -> string
        base : string sid
        hx : i32 [ (sid) ? sid.index_of[ '#' ] : -1 ]
        if [ hx > 0 ] base = sid.mid[ 0, hx ]
        ci : ConsoleInstance (consoles && base) ? consoles[base] : null
        cmd_str : string ''
        if [ ci && ci.run ]
            for [ c: token ] in ci.run
                cmd_str = (cmd_str.count > 0) ? cmd_str + ' ' + c.chars : c.chars
        return cmd_str

    # a console the project's agi declares: a view name of ours
    func console_of [ nm: string ] -> bool
        if [ !consoles || !nm || nm.count == 0 ] return false
        ci : ConsoleInstance consoles[ nm ]
        return (ci) ? true : false

    # a console is dir context, not a file's: picking one in a pane lets
    # go of the pane's file, and with it every view of that file
    func pane_drop_file [ pi: i32 ]
        if [ pi < 0 || pi >= editor_slots.count ] return
        editor_slots[ pi ] = -1
        ed : Editor pane_at[ pi ]
        if [ ed ]
            ed.src        = null
            ed.loaded_src = null
        save_session[]

    # the rail's mark for a console view: a shell wears the gear (the
    # material console svg does not draw), an agent the chat mark;
    # null for a name that is not a console
    func console_icon [ nm: string ] -> string
        if [ !console_of[ nm ] ] return null
        ci : ConsoleInstance consoles[ nm ]
        return (ci && ci.kind == 'shell') ? 'gear' : 'chatgpt'

    # the agent console named in orbiter.agi; shell is not one
    func agent_sid [] -> string
        if [ consoles ]
            for [ ci: ConsoleInstance, cname: string ] in consoles
                if [ ci.kind != 'shell' ] return cname
        return 'claude'

    func last_editor_pane [] -> i32
        return editor_slots.count - 1

    # the agent pane is derived: after all inline panes, when open
    func agent_pane [] -> i32
        return (agent_open) ? editor_slots.count : -1

    func ensure_console [ sid: string ] -> ConsoleSession
        if [ !sid || sid.count == 0 ] return null
        if [ !ed_sessions ]
            ed_sessions = map ConsoleSession [string] [ ]
        s : ConsoleSession ed_sessions[sid]
        if [ s ] return s
        s = ConsoleSession []
        s.name       = sid
        s.launch_cmd = agent_cmd[ sid ]
        ed_sessions[sid] = s
        s.start[]
        return s

    # a cached element repaints only when it is itself marked: every
    # console in the tree, since a session's bytes just moved
    func dirty_consoles [ e: element ]
        if [ !e ] return
        if [ e inherits Console ] e.pristine = false
        if [ e.elements ]
            for [ ce: element, ck: string ] in e.elements
                dirty_consoles[ ce ]

    func feed_agent [ text: string ] -> none
        if [ !consoles ] return
        s : ConsoleSession ensure_console[ agent_sid[] ]
        if [ !s ] return
        s.send_esc[ '[200~' ]
        s.write_input[ text ]
        s.send_esc[ '[201~' ]

    # a line from the agent through our socket: 'status <state> <text>'
    public func on_agent [ s: string ]
        # an app's orbiter button while this orbiter is open: 'coupled
        # <mod>
        # [picture]'. the app ends; its source, a held instance of it
        # and its last picture come here, and this window comes forward
        if [ s && s.count > 8 && s.mid[ 0, 8 ] == 'coupled ' ]
            rest9 : string s.mid[ 8, s.count - 8 ].trim[]
            sp9   : i32 [ rest9.index_of[ ' ' ] ]
            mod9  : string [ (sp9 > 0) ? rest9.mid[ 0, sp9 ] : rest9 ]
            shot : string [
                (sp9 > 0)
                ? rest9.mid[ sp9 + 1, rest9.count - sp9 - 1 ].trim[]
                : '' ]
            couple_app[ mod9, shot ]
            return
        # the system's xdg-open: 'open <url>' hosts it in the pane
        if [ s && s.count > 5 && s.mid[ 0, 5 ] == 'open ' ]
            url : string s.mid[ 5, s.count - 5 ].trim[]
            pane : Editor pane_at[ active_pane ]
            if [ pane && pane.open_url[ url ] ]
                exit_finder[]
                if [ ux ] ux.restyle = true
            el
                log 'orbiter: no module opens {url}'
            return
        # an agent on the platform: 'home <agent> <state> <words>'
        if [ s && s.count > 5 && s.mid[ 0, 5 ] == 'home ' ]
            hw : vec string s.mid[ 5, s.count - 5 ].trim[].split[ ' ' ]
            if [ hw.count >= 2 ]
                if [ !home_doing ]
                    home_doing = map string [ string ] []
                    home_words = map string [ string ] []
                words : string ''
                for [ k: i32 2, k < hw.count, k += 1 ]
                    words = (words.count > 0) ? '{words} {hw[ k ]}'
                                              : hw[ k ]
                home_doing[ hw[ 0 ] ] = hw[ 1 ]
                home_words[ hw[ 0 ] ] = words
                if [ ux ] ux.restyle = true
            return
        if [ !s || s.count < 7 || s.mid[ 0, 7 ] != 'status ' ] return
        # only an exchange orbiter opened (a capture sent, up or
        # minimized) takes the agent's statuses: the session's other
        # work, the user's terminal chat with it, is not orbiter's to
        # show
        if [ !ux || !ux.shot_ask ] return
        rest : string s.mid[ 7, s.count - 7 ]
        sp   : i32 [ rest.index_of[ ' ' ] ]
        # done is final: nothing the agent sends after it (a
        # notification that it waits, a late line) reopens the exchange
        # or the button; only the user's next line ('sent') starts it
        # again
        st9 : string [ (sp > 0) ? rest.mid[ 0, sp ] : rest ]
        if [ sp > 0 && st9 == 'description' ]
            ux.agent_description[
                rest.mid[ sp + 1, rest.count - sp - 1 ] ]
            return
        # the undo turns the avatar; the note follows on the rewind's
        # answer
        if [ st9 == 'rewind' && agent_av ] agent_av.undo[]
        if [ agent_done && st9 != 'sent' && st9 != 'rewind' ]
            if [ sp > 0 && st9 == 'note' ]
                agent_note = rest.mid[ sp + 1, rest.count - sp - 1 ]
                ux.agent_note[ st9, agent_note ]
                ux.restyle = true
            el [ sp > 0 && st9 == 'diff' ]
                ux.agent_diff[ rest.mid[ sp + 1, rest.count - sp - 1 ] ]
            return
        # a diff line goes to the panel, never to the bar or the notes
        if [ sp > 0 && rest.mid[ 0, sp ] == 'diff' ]
            ux.agent_diff[ rest.mid[ sp + 1, rest.count - sp - 1 ] ]
            agent_changed = true
            return
        agent_state = (sp > 0) ? rest.mid[ 0, sp ] : rest
        agent_note  = (sp > 0) ? rest.mid[ sp + 1,
                                           rest.count - sp - 1 ] : ''
        # 'sent' is the user's own line: not the agent's word, and not
        # done
        if [ ux ]
            if [ agent_state != 'sent' ]
                ux.agent_note[ agent_state, agent_note ]
            ux.agent_busy = agent_state == 'busy'
        agent_done = agent_state == 'done'
        if [ agent_state == 'idle' || agent_state == 'sent' ]
            agent_note    = ''
            agent_changed = false
        # a send: its agent and model are the next exchange's too
        if [ agent_state == 'sent' && ux && ux.agent_pick ]
            agent_last = ux.agent_pick
            model_last = ux.model_pick
            save_session[]
        if [ ux ] ux.restyle = true

    # the swap is asked of the host: the exchange goes on alpha before
    # the switch takes it, from the flame or the status button alike
    public func request_swap [] -> none
        swap_asked = true
        # the next instance reads the session in its init, before this
        # one unloads: what is saved now is what it restores
        save_session[]
        au_live_request_apply[]

    # the exchange's debug button: each press steps the avatar to its
    # next state, 0 face on at rest, 1 tilted, 2 working (spin, first
    # halo), 3 edits in (second halo), 4 done with the core flame; the
    # exchange stays up through it
    mutable av_dbg_step : i32
    public func avatar_debug [] -> none 
        if [ !ux ] return
        av_dbg_step = (av_dbg_step + 1) % 5
        log 'avatar debug: state {av_dbg_step}'
        agent_done    = false
        agent_changed = av_dbg_step >= 3
        ux.agent_busy = false
        agent_state   = 'idle'
        agent_note    = ''
        if [ av_dbg_step == 0 ]
            ux.agent_view = false
            if [ agent_av ] agent_av.settled = false
        el [ av_dbg_step == 1 ]
            ux.agent_view = true
        el [ av_dbg_step == 2 ]
            ux.agent_view = true
            agent_state   = 'busy'
            agent_note    = 'working'
            ux.agent_busy = true
        el [ av_dbg_step == 3 ]
            ux.agent_view = true
            agent_state   = 'busy'
            agent_note    = 'editing'
            ux.agent_busy = true
        el
            ux.agent_view = true
            agent_state   = 'done'
            agent_note    = 'done'
            agent_done    = true
        ux.restyle = true

    # the avatar for the exchange: ONE instance, made at load, mounted
    # for the app's life and invisible between exchanges; it is never
    # freed. it is settled only while the exchange is a conversation
    mutable agent_av      : AgentAvatar
    public func agent_avatar [] -> element
        if [ !agent_av ]
            agent_av = AgentAvatar [ topmost: true,
                                     animate_always: true ]
        if [ ux && !ux.agent_view ] agent_av.settled = false
        # in the slideout: small, at its top
        return agent_av

    # orbiter transcribes: its own exchange's mic needs no host
    public func dictates [] -> bool
        return true

    # a dictate request for an exchange field: 3 start, 0 stop (the take
    # is typed into that field), 2 cancel. slot 0 is this window, >0 a
    # hosted app
    public func dictate_to [ slot: i32, s: i32 ]
        log 'orbiter dictate_to slot={slot} s={s}'
        if [ s == 3 ]
            if [ orbit_cap_on ] return
            rc : dictation_start[]
            if [ rc == 0 ]
                orbit_cap_on = true
                dict_slot    = slot
                if [ slot > 0 ]
                    host_post2[ slot, 1, i32[ HM.live ], 1, 0, 0 ]
                el [ ux ]
                    ux.dict_live = true
                    ux.restyle   = true
        el [ s == 2 ]
            if [ dict_slot != slot ] return
            dictation_cancel[]
            orbit_cap_on   = false
            orbit_flushing = false
            dict_slot      = -1
        el
            if [ !orbit_cap_on || dict_slot != slot ] return
            dictation_stop[]
            orbit_cap_on   = false
            orbit_flushing = true
        if [ s != 3 ]
            if [ slot > 0 ]
                host_post2[ slot, 1, i32[ HM.live ], 0, 0, 0 ]
            el [ ux ]
                ux.dict_live = false
                ux.restyle   = true

    public func on_host [ mt: i32, wp: i32, lp: i32, xp: i32 ]
        if [ mt != 1 ] return
        s : i32 [ wp ]
        # this window's exchange mic
        if [ s == 3 || ((s == 0 || s == 2) && dict_slot == 0) ]
            dictate_to[ 0, s ]
            return
        if [ s == orbit_dstate ] return
        log 'orbiter on_host dictate: {orbit_dstate} -> {s}'
        orbit_dstate = s
        if [ s == 1 ]
            rc : dictation_start[]
            if [ rc == 0 ]
                orbit_cap_on = true
                dict_slot    = -1
                host_live_set[ 1 ]
        el [ s == 2 ]
            dictation_cancel[]
            orbit_cap_on   = false
            orbit_flushing = false
            host_live_set[ 0 ]
        el
            if [ orbit_cap_on ]
                dictation_stop[]
                orbit_cap_on   = false
                orbit_flushing = true
            host_live_set[ 0 ]

    public func toggle_listen [ src: path ]
        if [ orbit_cap_on ]
            dictation_stop[]
            orbit_cap_on   = false
            orbit_flushing = true
        el
            rc : dictation_start[]
            if [ rc == 0 ]
                orbit_cap_on = true
                listen_file  = src
        log 'orbiter: mic {orbit_cap_on} file {listen_file}'

    public func listening [] -> bool
        return orbit_cap_on

    # DIAG: SILVER_DICT_FILE drives one take from that wav: the mic goes
    # on once the window is up, and off when the feed runs out
    intern dtest_n : i32
    func dict_test_step []
        if [ !getenv[ 'SILVER_DICT_FILE' ] ] return
        dtest_n += 1
        if [ dtest_n == 90 ]
            log 'DICTTEST mic on'
            dictate_to[ 0, 3 ]
        el [
            dtest_n > 90 && orbit_cap_on && dictation_feed_left[] == 0
            && dictation_gpu_ready[] ]
            log 'DICTTEST mic off'
            dictate_to[ 0, 0 ]

    func mic_frame []
        # the exchange open: the dictation model loads now, so the mic
        # starts at once
        if [ ux && ux.shot_ask ] dictation_preload[]
        # a recording dictates the whole take: no button
        rt : i64 [ record_time[] ]
        if [
            rt >= 0 && !orbit_cap_on && !orbit_flushing
            && !dictation_streaming[] ]
            dictation_preload[]
            dictation_stream_start[]
        if [ dictation_streaming[] ]
            for [ ps9: i32 0, ps9 < 64, ps9 += 1 ]
                if [ !dictation_poll[] ] break
            st9 : string dictation_stream_take[]
            if [ st9 && st9.count > 0 ]
                at9 : i64 [
                    dictation_stream_at[] + rt - Au.epoch_micros[] ]
                if [ at9 < 0 ] at9 = 0
                ed : Editor pane_at[ active_pane ]
                mf : string [ (ed && ed.src) ? '{ed.src}' : null ]
                log 'orbiter: recording mark at {at9} us "{st9}"'
                record_mark[ at9, dictation_stream_dur[], st9, mf ]
            return
        dict_test_step[]
        # every block that came in since the last frame (orbiter's
        # frames slow at rest, and one poll takes one block)
        if [ orbit_cap_on ]
            if [ mark_at < 0 ] mark_at = record_time[]
            for [ pk: i32 0, pk < 64, pk += 1 ]
                if [ !dictation_poll[] ] break
        if [ !orbit_flushing ] return
        if [ mark_end < 0 ] mark_end = record_time[]
        if [ !dictation_flush[] ] return
        orbit_flushing = false
        dt : dictation_take[]
        ds : i32 [ dict_slot ]
        dict_slot = -1
        # the take goes on the recording at the span it was spoken
        if [ dt && dt.count > 0 && mark_at >= 0 ]
            ed : Editor pane_at[ active_pane ]
            mf : string [
                (listen_file) ? '{listen_file}' : (ed && ed.src)
                ? '{ed.src}' : null ]
            record_mark[ mark_at, mark_end - mark_at, dt, mf ]
        mark_at  = -1
        mark_end = -1
        if [ !dt || dt.count == 0 ] return
        # an exchange's mic: the words are typed into its field, to
        # review and send with enter
        if [ ds > 0 ]
            log 'orbiter: take into the exchange field of slot {ds} "{dt}"'
            for [ i: i32 0, i < i32[ dt.count ], i += 1 ]
                host_post2[ ds, 1, i32[ HM.text ], (i32 dt.chars[ i ]) & 255, 0, 0 ]
            return
        if [ ds == 0 ]
            log 'orbiter: take into the exchange field "{dt}"'
            if [ ux ]
                # a fresh event: the window's own ev faulted in clear[]
                # from here
                tev : Event [ ]
                tev.key.text = dt
                ux.text_event[ tev ]
            return
        log 'orbiter: submitting take "{dt}"'
        take_send[ dt ]
        listen_file = null
        listen_shot = null

    # a recorded take into the exchange, as Enter sends a line: into
    # the last conversation, else a new one about the recorded file,
    # with the agent and model last used; the exchange stays put away
    func take_send [ dt: string ]
        if [ !ux ] return
        refs : string ''
        fresh : bool [ !ux.sessions || ux.sessions.count == 0 ]
        if [ fresh ]
            ed : Editor pane_at[ active_pane ]
            src : path [ (listen_file) ? listen_file
                : ((ed && ed.src) ? ed.src : null) ]
            if [ !src ] return
            ln : i32 [ (ed) ? ed.sel_line + 1 : 0 ]
            ux.exchange_open[ src, ln, true ]
            refs = (ln > 0) ? 'File: {src}:{ln}' : 'File: {src}'
        el
            cur : i32 [ (ux.session_cur >= 0) ? ux.session_cur
                : i32[ ux.sessions.count ] - 1 ]
            ux.session_show[ cur ]
        if [ !ux.agent_pick || ux.agent_pick.count == 0 ]
            ux.agent_pick = agent_last
            ux.model_pick = model_last
        if [ listen_shot ]
            sl : string 'Screenshot: {listen_shot}'
            refs = (refs.count > 0) ? '{refs}\n{sl}' : sl
        msg : string (refs.count > 0) ? '{dt}\n\n{refs}' : dt
        if [ fresh ]
            ux.session_begin[ dt ]
            agent_new[]
        if [ !agent_post_as[ a, ux.agent_pick, ux.model_pick, msg,
                             'now' ] ]
            if [ fresh ] ux.session_unbegin[]
            log 'orbiter: the take could not be sent'
            return
        old : string ux.shot_text
        ux.shot_text  = (old && old.count > 0) ? '{old}\n{dt}' : dt
        ux.user_note[ dt ]
        on_agent[ 'status sent {dt}' ]
        ux.agent_view = true
        ux.agent_min  = true
        ux.restyle    = true

    func request_context [] -> none
        done : bool [ false ]
        ed : Editor pane_at[ active_pane ]
        if [ ed && ed.rview ] done = ed.rview.context_request*[]
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            if [ ! done ]
                ed2 : Editor pane_at[ i ]
                if [ ed2 && ed2.rview ]
                    done = ed2.rview.context_request*[]

    func snap_window [ w: Window ] -> string
        if [ !w || !w.screen ] return null
        tex : Texture w.screen.color
        if [ !tex ] return null
        sz : i32 [ tex.width * tex.height * 4 ]
        b : Buffer [ vk: tex.vk, size: sz,
            u_dst: true, m_host_visible: true, m_host_coherent: true ]
        b.transfer[ tex ]
        shot : Image [ width: tex.width, height: tex.height,
                       format: Pixel.rgba8 ]
        memcpy[ shot.vdata[], b.mmap[], sz ]
        b.unmap[]
        shot_n += 1
        # in the silver folder's tmp/: the agent can open it there
        sd : path '{path.path_startup[]}/tmp'
        sd.make_dir[]
        fn : string '{sd}/orbiter_shot_{getpid[]}_{shot_n}.png'
        shot.png[ path fn ]
        return fn

    func run_node [ name: string ] -> none
        if [ !projects ] return
        p : Project projects[name]
        if [ !p ] return
        if [ p.deps ]
            for [ d: token ] in p.deps
                run_node[ d.chars ]
        if [ !p.build || p.build.count == 0 ] return
        cmd_str : string ''
        for [ c: token ] in p.build
            cmd_str = (cmd_str.count > 0) ? cmd_str + ' ' + c.chars : c.chars
        cmd : string 'cd "{p.root}" && {cmd_str}'
        s : ConsoleSession ensure_console[ name ]
        if [ !s ] return
        s.pending = cmd
        has_run : bool [ p.run && p.run.count > 0 ]
        if [ has_run ]
            start_debug[ name ]

    func start_debug [ name: string ] -> none
        p : Project (projects) ? projects[name] : null
        loc : path (p) ? p.product : null
        if [ !loc && p && p.run && p.run.count > 0 ]
            rb : string p.run[0].chars
            ps : string '{startup_path}/install/build/{rb}'
            loc = path [ ps.chars ]
        if [ !loc ]
            ps2 : string '{startup_path}/install/build/{name}'
            l2  : path [ ps2.chars ]
            if [ l2.exists[] ] loc = l2
        if [ !loc ]
            log 'start_debug {name}: no binary to launch'
            return
        ensure_console[ name ]
        log 'start_debug {name}: launching {loc}'
        if [ !debuggers ] debuggers = map dbg [string] []
        d : dbg [ location: loc, target: a, auto_start: false ]
        debuggers[name] = d
        sdir : '{startup_path}/{name}'
        sync_breakpoints[ d, sdir ]
        d.start[]

    # attach before the child's PR_SET_PTRACER fails under yama
    func proc_stopped [ pid: i32 ] -> bool
        return host_pid_stopped[ pid ] != 0

    # lldb attach loads the whole binary's symbols — seconds of work
    # that used to run inside update_all and hold the first paint. it
    # goes to a worker; only the debuggers publish stays on the main
    # thread
    func attach_appview [ av: AppView, pid: i32 ]
        if [ av.attached ] return
        av.attached  = true
        av.attaching = true
        av.note      = 'attaching debugger'
        w8 : vec Au []
        w8.push[ av ]
        if [ !attach_tasks ] attach_tasks = vec async []
        attach_tasks.push[
            async [ target: a, work_fn: lambda attach_work[ a ],
                    work: w8 ] ]

    func attach_work [ arg: object :: o: orbiter ]
        av : AppView [ arg ]
        if [ !av ] return
        pid : i32 [ host_app_pid[ av.slot ] ]
        mod : string av.app_mod
        if [ !mod || mod.count == 0 || pid <= 0 ]
            av.attaching = false
            av.note      = ''
            return
        loc : path
        ps  : string '{o.startup_path}/install/build/{mod}'
        l   : path [ ps.chars ]
        if [ l.exists[] ] loc = l
        if [ !loc ]
            ps2 : string '{o.startup_path}/platform/native/build/{mod}'
            l2  : path [ ps2.chars ]
            if [ l2.exists[] ] loc = l2
        if [ !loc ]
            log 'attach_appview: no binary for {mod}'
            av.attaching = false
            av.note      = ''
            return
        d : dbg [ location: loc, target: o, auto_start: false ]
        d.attach[ pid ]
        if [ !d.active ]
            kill[ pid, SIGCONT ]
            log 'attach_appview: attach failed — {mod} pid={pid} continued undebugged'
            av.attaching = false
            av.note      = ''
            return
        adir : string [ '' ]
        if [ av.src ]
            ap : av.src.parent_dir[]
            if [ ap ] adir = '{ap}'
        o.sync_breakpoints[ d, adir ]
        if [ !av.pause_pending ]
            d.cont[]
            # clear the pre-init SIGSTOP group-stop; cont alone won't
            kill[ pid, SIGCONT ]
        log 'attach_appview: attached {mod} pid={pid}'
        o.attach_mod     = mod
        o.attach_av      = av
        o.attach_pending = d

    # the worker never touches debuggers/active_target — the map is read
    # by the paint thread, so the finished debugger lands here instead
    # the app bar's slider is the truth; push it only when it moves
    func sync_volume []
        vol_spectrum[]
        vs9 : VolumeSlider find_volume[]
        av9 : AppView active_app[]
        # the machine's level: read now and then (others change it)
        now9 : i64 [ epoch_millis[] ]
        if [ now9 - master_read_ms > 1000 ]
            master_read_ms = now9
            mvf : f32 [ 0.0 ]
            mmu : i32 [ 0 ]
            if [ host_master_get[ @mvf, @mmu ] != 0 ]
                if [ mvf != master_vol || (mmu != 0) != master_mute ]
                    master_vol  = mvf
                    master_mute = mmu != 0
                    if [ !av9 && ux ] ux.restyle = true
        if [ vs9 && vs9.changed ]
            vs9.changed = false
            if [ av9 ] av9.vol = vs9.value
            el
                master_vol = vs9.value
                host_master_set[ master_vol, (master_mute) ? 1 : 0 ]
        if [ !instances ] return
        # each app at its own level; the machine's is the final stage
        for [ v: AppView ] in instances
            if [ v.slot < 0 || v.ended || v.held || !v.app_mod ] continue
            # its own volume starts as the app answered it
            if [ v.vol < 0.0 && v.app_vol >= 0.0 ] v.vol = v.app_vol
            # never ours to change until something here is set
            if [ v.vol < 0.0 && !v.vol_mute ] continue
            out9 : f32 [ (v.vol_mute) ? 0.0
                : ((v.vol >= 0.0) ? v.vol : 1.0) ]
            if [ out9 == v.vol_sent ] continue
            v.vol_sent = out9
            agent_sock_send[ v.sock_name[].chars, 'volume {out9}\n' ]

    # 20 bands of what plays now, from the players' last 1024 samples:
    # a windowed DFT at log-spaced bins (2..400: ~86 Hz to 17 kHz at
    # 44.1 kHz), in dB over 60 dB; up at once, down slowly
    func vol_spectrum []
        n : i32 [ 1024 ]
        nb : i32 [ 20 ]
        if [ !vol_scope ]
            vol_scope = vec f32 [ n ]
            for [ i: i32 0, i < n, i += 1 ]
                vol_scope.push[ 0.0 ]
        if [ !vol_bands ]
            vol_bands = vec f32 [ nb ]
            for [ i: i32 0, i < nb, i += 1 ]
                vol_bands.push[ 0.0 ]
        wave : vec f32 [ n ]
        for [ i: i32 0, i < n, i += 1 ]
            wave.push[ 0.0 ]
        heard : bool [ false ]
        av0 : AppView active_app[]
        if [ instances ]
            for [ v: AppView ] in instances
                if [ v.slot <= 0 || v.ended || v.held ] continue
                if [ av0 && v != av0 ] continue
                got : i32 [ host_audio_scope[ v.slot, @vol_scope[ 0 ],
                                             n ] ]
                if [ got < n ] continue
                heard = true
                for [ i: i32 0, i < n, i += 1 ]
                    sv : f32 [ vol_scope[ i ] ]
                    wave[ i ] += sv
        for [ b: i32 0, b < nb, b += 1 ]
            lv : f32 [ 0.0 ]
            if [ heard ]
                k : f32 [ 2.0 * pow[ 200.0, f32[ b ] / f32[ nb - 1 ] ] ]
                re : f32 [ 0.0 ]
                im : f32 [ 0.0 ]
                for [ i: i32 0, i < n, i += 1 ]
                    hw : f32 [ 0.5 - 0.5 * cos[ 6.2832 * f32[ i ]
                        / f32[ n ] ] ]
                    ph : f32 [ 6.2832 * k * f32[ i ] / f32[ n ] ]
                    smp : f32 [ wave[ i ] ]
                    x : f32 [ smp * hw ]
                    re += x * cos[ ph ]
                    im -= x * sin[ ph ]
                mg : f32 [ sqrt[ re * re + im * im ] * 4.0 / f32[ n ] ]
                # dB: 20 log10 = 8.6859 ln
                db : f32 [ 8.6859 * log[ mg + 0.000001 ] ]
                lv = clamp[ (db + 60.0) / 60.0, 0.0, 1.0 ]
            was : f32 [ vol_bands[ b ] ]
            vol_bands[ b ] = (lv > was) ? lv : was * 0.88

    # the selected task: the active pane's running app, in view
    func active_app [] -> AppView
        ed : Editor pane_at[ active_pane ]
        rv : AppView (ed && ed.app_view) ? ed.run_view : null
        return (rv && !rv.ended && !rv.held) ? rv : null

    # the slider sits under EditorView > split > band > tools, not on
    # Editor
    func find_volume [] -> VolumeSlider
        ve9 : element find_el[ a, 'sys_vol' ]
        if [ !ve9 ] return null
        return VolumeSlider [ ve9 ]

    # an instance's debugger is keyed by the instance, not its module:
    # two instances of one module each keep their own
    func dbg_key [ av: AppView ] -> string
        return '{av.app_mod}#{av.iid}'

    func attach_publish []
        if [ !attach_pending ] return
        if [ !debuggers ] debuggers = map dbg [string] []
        dk : string (attach_av) ? dbg_key[ attach_av ] : attach_mod
        debuggers[ dk ] = attach_pending
        active_target  = dk
        if [ attach_av ]
            attach_av.attaching = false
            attach_av.note      = ''
            attach_av.debugger  = attach_pending
            if [ attach_av.pause_pending ]
                attach_av.pause_pending = false
                if [ attach_av.paused ] land_paused[ attach_av ]
                el attach_pending.cont[]
        attach_pending = null
        attach_av      = null

    # mdir = the debugged module's own source directory. a breakpoint
    # from another module resolves to an unrelated address here and
    # parks the process forever (a hosted app then never pumps, resizes
    # or paints)
    func sync_breakpoints [ d: dbg, mdir: string ]
        if [ !breakpoints || !d ] return
        for [ cond: string, key: string ] in breakpoints
            idx : i32 [ key.rindex_of[ ':' ] ]
            if [ idx <= 0 ] continue
            bsrc : string key.mid[ 0, idx ]
            blin : i32 [
                key.mid[ idx + 1, key.count - idx - 1 ].real_value[] ]
            if [ blin <= 0 ] continue
            # an empty source (':1' in a stale state file) binds
            # anywhere
            if [ !bsrc || bsrc.count == 0 ] continue
            if [ mdir && mdir.count > 0 ]
                bpath : path [ bsrc.chars ]
                bd    : bpath.parent_dir[]
                if [ !bd ] continue
                if [ '{bd}' != mdir ] continue
            if [ !d.bps ] d.bps = vec breakpoint []
            bp : d.set_breakpoint[ path [ bsrc ], u32[ blin ], 0 ]
            if [ bp ] d.bps.push[ bp ]

    # a gutter toggle reaches every live debugger: drop its set, bind
    # the map again
    func breakpoints_changed []
        if [ !debuggers ] return
        for [ d: dbg, name: string ] in debuggers
            log 'breakpoints_changed {name} active={(d && d.active) ? 1 : 0}'
            if [ !d || !d.active ] continue
            if [ d.bps ]
                for [ bp: breakpoint ] in d.bps
                    d.remove_breakpoint[ bp ]
            d.bps = vec breakpoint []
            sync_breakpoints[ d, '{startup_path}/{name}' ]

    # attaching lldb parks the app in ptrace-stop: one frame, no input,
    # no resize. only debug a module the user actually set a breakpoint
