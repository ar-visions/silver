        if [ ev.target.id.starts_with[ 'ahome_end_' ] ]
            home_end[ ev.target.id.mid[ 10, ev.target.id.count - 10 ] ]
            if [ ux ] ux.restyle = true
            ev.no_default = true
            return
        # an avatar on the platform: its instance, as its title
        if [ ev.target.id.starts_with[ 'pav_' ] ]
            nm : string ev.target.id.mid[ 4, ev.target.id.count - 4 ]
            if [ home_session[ nm ] ] home_open = nm
