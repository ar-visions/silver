    # 'my computer': home, then the drives mounted where a user's are
    # (/, /home, /media, /run/media, /mnt); never snaps or loops
    func side_drives [] -> vec string
        out : vec string []
        hm : string getenv[ 'HOME' ]
        if [ hm && hm.count > 0 ] out.push[ hm ]
        mt : path '/proc/mounts'
        txt : string mt.load[ typeid[string], null ]
        if [ !txt ] return out
        for [ row: string ] in txt.split[ '\n' ]
            ws : vec string row.split[ ' ' ]
            if [ ws.count < 2 ] continue
            dv : string ws[ 0 ]
            mp : string ws[ 1 ]
            if [ !dv.starts_with[ '/dev/' ] || dv.starts_with[ '/dev/loop' ] ]
                continue
            ok : bool [ mp == '/' || mp == '/home'
                || mp.starts_with[ '/media/' ]
                || mp.starts_with[ '/run/media/' ]
                || mp.starts_with[ '/mnt/' ] ]
            if [ !ok ] continue
            seen : bool [ false ]
            for [ o9: string ] in out
                if [ o9 == mp ] seen = true
            if [ !seen ] out.push[ mp ]
        return out

    # the pinned folders the column lists (the dock has the rest)
    func side_pinned [] -> vec string
        out : vec string []
        if [ pins ]
            for [ ps: string ] in pins
                pp : path ps
                if [ pp.exists[] && plain_folder[ pp ] ] out.push[ ps ]
        return out

    # the source root every checkout lives under: beside the one orbiter
    # was launched in, never a setting shared between launches. ours sit
    # flat there (<src>/<name>); other users' under <src>/<user>/<name>
    func src_root_of [] -> path
        pr9 : path project_root[]
        return pr9.directory[]

    # the login our key answers to, asked once and kept with the session
    func self_user_of [] -> string
        if [ self_user && self_user.count > 0 ] return self_user
        if [ self_asked ] return ''
        self_asked = true
        host : RepoHost repo_host_of[]
        who : string repo_token_login[ host ]
        if [ who.count == 0 ] who = repo_whoami[ host ]
        if [ who.count > 0 ]
            self_user = who
            save_session[]
        return self_user 

    # a repository's key in the column and on disk: our own by name, any
    # other user's as user/name (a path, so it works everywhere)
    func repo_key [ full: string ] -> string
        sl : i32 [ full.rindex_of[ '/' ] ]
        if [ sl < 0 ] return full
        owner : string full.mid[ 0, sl ]
        name  : string full.mid[ sl + 1, full.count - sl - 1 ]
        me : string self_user_of[]
        if [ me && me.count > 0 && owner.compare[ me ] == 0 ]
            return name
        return full

