                                        cur.sel_line, cur.sel_col,
                                        cur.scroll.y ]
        bind_pane[ p, pi ]
        # the arrival is a point too, or back overwrites the departure
        ed : Editor pane_at[ pi ]
        if [ ed && ed.nav ]
            same : bool [
                ed.loaded_src
                && '{ed.loaded_src.absolute[]}' == '{p.absolute[]}' ]
            if [ same ]
                ed.nav.record[ pi, '{p.absolute[]}',
                               (ed.sel_line < 0) ? 0 : ed.sel_line,
                               ed.sel_col, ed.scroll.y ]
            el
