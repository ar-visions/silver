            if [ ux ] ux.restyle = true
            ev.no_default = true
            return
        # a tray app's tile: as a left click on its icon
        if [ ev.target.id && ev.target.id.starts_with[ 'tray_tile_' ] ]
            tix : i32 [ i32[ ev.target.id.mid[ 10,
