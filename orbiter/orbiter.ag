    # the app menu's page slid over its rows ('' none, 'props'), and
    # the slide eased 0 (the rows) to 1 (the page)
    mutable menu_page      : string
    mutable menu_slide     : f32
    # the main menu kept open under a menu opened over it
    mutable sys_under      : bool
    mutable menu_shut_ms   : i64
    mutable tray_picks     : i32
    # typed into the open drawer: its menu shows what holds it; the
    # drawer takes the focus once it is mounted
    mutable menu_filter    : string
    # typed on the apps screen: the apps whose names hold it
    mutable apps_filter    : string [ '' ]
    # a desktop (an empty pane's, or the one under the free windows)
    # was pressed last: it takes the typing, whatever else is selected
    intern desk_typing     : bool
    # a phone: when a press low on the screen that nothing took went
    # down (0 none); held there half a second, the pane goes home
    # the power button: when it went down (0 up), its last press
    # (two quick ones: the screen off), the switcher up, the screen
    # dark
    mutable power_down_us  : i64
    mutable power_last_us  : i64
    mutable switcher       : bool
    # a phone's agent title swiped right: its end shows ('' none)
    mutable end_shown      : string [ '' ]
    # a menu was up when the current press began
    mutable press_menu     : bool
    # the last press on_press saw, the last seen by the frame, and
    # the drawer's state the frame before
    mutable press_seen     : i64
    mutable click_seen     : i64
    mutable menu_was       : bool
    # an address to open once its new pane is there
    mutable open_soon      : string
    mutable screen_dark    : bool
    # the keyboard by the bar's button: 1 shown, -1 put away, 0 as
    # the focus wants; and the focus's want last frame
    mutable keys_force     : i32
    mutable keys_wanted    : bool
    # where the phone's dialogs stand: the system menu's bottom row's
    # scroll, the switcher's, the power slide opened
    mutable strip_shift    : f32
    mutable switch_shift   : f32
    # the switcher's chosen card (its log shows), -1 none: the
    # system's log
    mutable switch_sel     : i32 [ -1 ]
    # the switcher's chosen build ('' none): its build screen shows
    mutable switch_build   : string [ '' ]
    # builds put away from the switcher: their events' time then
    # (a new run of one shows again)
    intern build_gone      : map i64 [ string ]
    # the switcher's console shown (its toggle by the power slide)
    mutable switch_con     : bool
    # an update coming in (orbiter-note.sh): its share, -1 none,
    # and when it was last said
    mutable upd_frac       : f32 [ -1.0 ]
    mutable upd_us         : i64
    mutable slide_open     : bool
    # the bar's title being typed (a URL), what is typed, and whether
    # the first key replaces it whole
    mutable bar_typing     : bool
    # the navigator asked for (the bar's title, a pick): the pane's
    # title then lists, else in the editor it finds in the file
    mutable nav_req        : bool
    # ctrl+f: the pane's title finds in its file (off by default; Esc
    # or ctrl+f again ends it)
    mutable title_find_on  : bool
    # ctrl+f's replace row, over the find line
    mutable replace_on     : bool
    # a running app's URL typed in the pane's bar (the bar's title
    # press, for a typed argument)
    public  url_entry_on   : bool
    # where a find typed in the title began: each key searches from
    # there again
    mutable find_from_line : i32
    mutable find_from_col  : i32
    mutable bar_text       : string
    mutable drawer_focus   : bool
    # a store's dialog in the drawer, and its store
    intern login_el : element
    intern login_ae : AppEntry
    # the open folder's menus (export menus), and whose
    intern fold_src  : MenuSource
    intern fold_name : string
    # its entry whose page of fields slid over the menu (target:
    # the fields' names by |, a * before a password's)
    intern fold_page : TrayEntry
    intern fold_ms   : i64
    # what its module said was wrong with the page's go
    intern fold_problem : string
    # the page's fields wait for their values
    intern fold_seed : bool
    # a filter field to focus once it is up ('filter', 'apps_filter')
    mutable filter_focus   : string [ '' ]
    # the drawer's entry the arrow keys chose (-1 none)
    mutable menu_lit       : i32 [ -1 ]
    # an Alt tap: the bar's name lit for the keys ('' none), and Alt
    # down with nothing else yet
    mutable bar_hl         : string [ '' ]
    mutable alt_tap        : bool
    # a pane whose app the dock toggled out: its editor lets the app
    # go and steps back once it is mounted again (-1: none)
    mutable toggled_out    : i32 [ -1 ]
    # a bar chip dragged onto the dock to pin it (-1: none)
    mutable drag_iid       : i32 [ -1 ]
    # the press, in the window
    mutable drag_x0        : f32
    mutable drag_y0        : f32
    mutable drag_moved     : bool
    # its icon's top in the pins, eased toward the pointer
    mutable drag_at        : f32
    # the pin slot the drop would take (-1: none)
    mutable drag_slot      : i32 [ -1 ]
    # each pin's eased shift: a gap opens at the slot
    mutable pin_off        : vec f32
    # a dock pin pressed: its key; a move past 6 px drags it to
    # another place in the pins, else it is a click at the release
    mutable drag_pin       : string
    # the drawer's ground: one copy of the screen and one blur chain
    # for the window, kept (a chain built again per drawer crashed)
    mutable drawer_snap    : Texture
    mutable drawer_rb      : ReduceBlur
    # the blur is taken once as the drawer opens (and again on a new
    # window size), not every frame
    mutable drawer_fresh   : bool
    public browse_single : bool
    public grid_mode     : bool
    public browse_header_size : i32 [ 18 ]
    public browse_dir_size : i32 [ 16 ]
    public [ StatePersist ] breakpoints   : map string[string]
    public code_font_size : i32 [ 19 ]
    # append LAST: member order sets AF bit indices
    public show_instr_col : bool
    # launch panel over the console
    public show_launch    : bool
    mutable shift_down    : bool
    mutable cmd_down      : bool
    # recording from a shift-click on orbiter's button: a click on it
    # again sends the take, Esc throws it away
    mutable mic_by_press  : bool
    # the instance panel's sections fold on their headers
    # one open at a time: properties to begin with
    mutable props_open    : bool [ true ]
    mutable stack_open    : bool
    # the callstack lists frames with no known source too
    mutable stack_unknown : bool
    mutable instr_open    : bool
    mutable rec_open      : bool
    # the record tab's take: whose (-1 orbiter itself, else an
    # instance's iid; -2 none), the file, its start, the second shown
    mutable rec_iid       : i32 [ -2 ]
    mutable rec_path      : string
    mutable rec_from      : i64
    mutable rec_sec       : i64
    # what the tab records next: orbiter (0) or the selected app (1)
    mutable rec_pick      : i32
    # the next instance made starts in debug mode (the menu's Debug)
    mutable inst_debug_next : bool
    # what the display panel records next: -1 orbiter, else an iid
    mutable rec_want      : i32 [ -1 ]
    # the folder the last take was saved in: the next one starts there
    mutable rec_dir       : path
    # an app over everything, started by its chord (screenshots):
    # its instance, its module, the word it is handed once it
    # answers, the screen captured under it, the capture's due time
    # (epoch ms, 0 none: the drawers go first)
    mutable over_view     : AppView
    mutable over_mod      : string
    mutable over_ask      : string
    mutable over_tex      : Texture
    mutable over_at       : i64
    mutable over_on       : bool
    # the capture as a picture: a shot is cut from it
    mutable over_img      : Image
    # a take asked through the system api: who ('<mod>-<slot>'),
    # its file (under that app's home, and here), its part of the
    # screen, when it starts (once the overlay is off the screen)
    mutable sys_rec_by    : string
    mutable sys_rec_rel   : string
    mutable sys_rec_file  : string
    mutable sys_rec_rect  : string
    mutable sys_rec_at    : i64
    # a file card carried off the desktop (a drawer's), and its icon
    mutable file_drag      : path
    mutable file_drag_icon : AppIcon
    # an app card carried off the desktop (a quick drag)
    mutable card_drag      : AppEntry
    # a carried card let go: what opens in its new window once the
    # window's editor is up (launch_tab its pane)
    intern carry_ae        : AppEntry
    intern carry_file      : path
    # the apps whose contained files show all (else one row)
    mutable shots_all     : vec string
    # the grid's cards a row, as last laid out
    mutable grid_row      : i32
    # minimized free windows: each one's instance and x y w h px
    mutable mini_iids     : vec i32
    # panes put out of view by their task button: kept whole (editor,
    # app, place), only not drawn; across a reload too
    persist pane_hid : vec bool
    # the window a launch hid under each one (-1 none)
    intern pane_under : vec i32
    # each pane's fade: 0 shown, 1 gone (eased to its hide); and its
    # place while it fades over the desktop (x y w h)
    persist pane_fade : vec f32
    persist pane_rect : vec f32
    # each pane's group (-1 none): the members share one place, one
    # shown; across a reload too
    persist pane_grp : vec i32
    # each group's size in its split (px; 0 a share): its members
    # take it in turn, so a tab chosen never sizes the frame again
    persist grp_size : vec f32
    # each window's app (an instance id, -1 none) and whether its code
    # is in front (edit mode): the window's, never an editor's
    # each module's default prop, read once its spec text
    intern dflt_spec : map string [ string ]
    intern dflt_prop : map Prop [ string ]
    # each dock pin's facts off the disk, read again every 2 s
    intern pin_kind    : map string [ string ]
    intern pin_kind_ms : i64
    # 'pane0', 'pane1' ...: made once, not on every lookup
    intern pane_keys   : vec string
    persist win_iid  : vec i32
    persist win_edit : vec bool
    # a window's tab carried off its bar (-1 none)
    mutable tab_drag  : i32 [ -1 ]
    # a group member's tab pressed (shown as it lands): orbiter holds
    # the press, past 8 px it is that tab's drag (-1 none)
    intern tab_held   : i32 [ -1 ]
    intern tab_x0     : f32
    intern tab_y0     : f32
    # the window a carried tab is over (drop_kind's 5), -1 none
    intern drop_win   : i32 [ -1 ]
    # the screen as drawn this frame, and each pane's view in small
    # cut from it (a hidden pane keeps its last)
    intern view_snap   : Texture
    intern snap_frame  : i64 [ -1 ]
    intern view_thumbs : map Canvas [string]
    # the docked panes' order left to right, by pane number (none:
    # in number order)
    persist pane_seq : vec i32
    # the docked layout as splits of splits (Layout.ag PaneNode's
    # saved form); none: a row in pane_seq's order
    persist pane_tree : vec i32
    mutable mini_rect     : vec f32
    # a restored one waits for its new pane's editor
    mutable mini_wait     : i32 [ -1 ]
    # a dock press waiting on the tab it made in a group (its pane's
    # editor comes a frame later)
    intern launch_wait    : DockIcon
    # a dock icon's right-press menu: its icon, where it was pressed
    # the orbiter menu's drawer: its app
    intern cfg_ae         : AppEntry
    # the drawer's height (px), and the app whose menus it holds
    intern cfg_h          : f32
    intern cfg_menu_of    : string
    intern cfg_panel_of   : string
    intern cfg_panel_src  : element
    intern dock_pop       : DockIcon
    intern dock_pop_x     : f32
    intern dock_pop_y     : f32
    # its drawer's items as listed (a row's 'drawer n'), and the words
    # typed to find among them
    intern dock_drawer    : vec AppEntry
    intern dock_find      : string
    # the menu's New instance: the dock press makes one, not reuses
    intern dock_fresh     : bool
    # its row pressed, done on the next frame (never inside the press)
    intern dock_act       : string
    # a desktop card's own menu (an agent's session or model): the
    # card, where it was pressed, the row pressed
    intern card_pop       : AppEntry
    intern card_pop_x     : f32
    intern card_pop_y     : f32
    intern card_act       : string
    # the press that opened it: it does not shut it
    intern card_pop_new   : bool
    # the sessions' titles as last shown: a change shows them anew
    intern titles_seen    : string
    # the desktop's pane it was pressed in (-1: under free windows)
    intern card_pop_pane  : i32
    # it has a drawer (Show), in this grid
    public card_pop_drawer : bool
    public card_pop_grid   : element
    # an error band's words, looked for in its console as it fills
    intern reveal_key     : string
    intern reveal_pane    : i32
    intern reveal_us      : i64
    intern reveal_at_us   : i64
    # that tab, while its launch runs (never a second one made)
    intern launch_tab     : i32 [ -1 ]
    mutable mini_pane     : i32 [ -1 ]
    # module whose build set err_file; only it may clear
    intern err_mod       : string
    # the nav lists the scene cards
    # the side panel's tab: 'instances' or 'scenes'
    intern side_tab      : string [ 'instances' ]
    # the system menu's lower part: scenes, instances, wifi, '' none
    intern sys_view      : string [ '' ]
    # the bar's mobile network: the width its draw asked for
    public sig_w         : f32
    # the scene setting whose choices are open under its chip
    intern scene_open    : string [ '' ]
    # chip_grid's height, as it last laid them out
    intern chips_h       : f32
    # the system menu's settings panels: the chip open
    intern set_open      : string [ '' ]
    # applied once the window is up
    intern set_applied   : bool
    # the user's settings, kept with the session: the wheel's speed
    # (ours and programs' windows alike), the pointer's easing, the
    # keys' repeat and layout, the text size
    intern [ StatePersist ] set_scroll   : f32 [ 1.0 ]
    intern [ StatePersist ] set_easing   : string [ 'medium' ]
    intern [ StatePersist ] set_delay    : i32 [ 600 ]
    intern [ StatePersist ] set_rate     : i32 [ 25 ]
    # the agent platform's floor reflects the scene (costly)
    intern [ StatePersist ] set_mirrors  : string [ 'off' ]
    # the dock's names under its icons; off: the icons larger
    intern [ StatePersist ] set_dock_names : string [ 'off' ]
    intern [ StatePersist ] set_layout   : string [ 'us' ]
    # the time zone ('Asia/Tokyo'); '' the system's own
    intern [ StatePersist ] set_zone     : string
    intern [ StatePersist ] set_size     : i32 [ rest_unit[] ]
    # the families chosen ('' the bundled ones): code and consoles,
    # the bars and menus
    intern [ StatePersist ] set_mono     : string
    intern [ StatePersist ] set_tool     : string
    # the fonts last applied
    intern fonts_on      : string
    # a key's tick on the phone's motor: off, light, medium, strong
    intern [ StatePersist ] set_haptic   : string [ 'light' ]
    # the on-screen keyboard: auto (a phone's), on, off
    intern [ StatePersist ] set_keys     : string [ 'auto' ]
    # the system menu's panel width, px; 0 not yet laid out
    mutable panel_w : f32
    # the screen's light, 0..1 (-1: as the system set it)
    intern [ StatePersist ] set_light    : f32 [ -1.0 ]
    # the screen goes dark untouched this long; dark this long, the
    # whole phone sleeps (words a choice reads: '1 min', 'never')
    intern [ StatePersist ] set_screen_off : string [ '1 min' ]
    intern [ StatePersist ] set_sleep      : string [ 'after 15 s' ]
    # when the screen went dark, came on, last woke from sleep; how
    # often it slept; the light dimmed before going dark
    mutable dark_us  : i64
    mutable lit_us   : i64
    mutable awake_us : i64
    mutable slept_n  : i32
    mutable dimmed   : bool
    # the pointer's last place: a mouse moved is the user there too
    mutable pointer_was : vec2f
    # the screen's pixels a point, as the windows' scale last took it
    mutable win_ds : f32
    # the battery and the screen's light (machine)
    intern batt       : Battery [ ]
    intern light      : Light [ ]
    # a new screen mode waits on keep: the mode before it, and when it
    # goes back by itself
    intern mode_was      : i32 [ -1 ]
    intern mode_until    : i64
    # the apps view's cards (made once)
    intern app_list      : vec AppEntry
    # featured installs this session, by name: progress 0..1 (-1 not
    # known yet) and word, read from their logs at 2 Hz
    intern inst_names    : vec string
    intern inst_pct      : vec f32
    intern inst_word     : vec string
    # silver's other builds (install/tmp/builds/<module>.events): the
    # apps updating now and how far, 0..1 (-1 not yet known)
    intern build_names   : vec string
    intern build_pct     : vec f32
    intern build_ms      : i64
    # each file's time when last read, and what it said
    intern build_seen    : map i64 [string]
    intern build_was     : map f32 [string]
    # the builds folder's watch, and its word that something changed
    intern build_watch   : watch
    intern build_due     : bool
    # each module's import count, read from its source once
    intern import_counts : map i32 [string]
    intern build_pid     : map i64 [string]
    intern inst_ms       : i64
    # cards whose host line was pressed, until its window maps: the
    # entry's name, the line's last word (the app), the press's ms
    intern host_names    : vec string
    intern host_words    : vec string
    intern host_ms       : vec i64
    intern host_poll_ms  : i64
    # services cards wait on: each its name, its ready line (export
    # ready), its start line (export host_startup), when it was last
    # started (ms, 0 never), its state (-1 unknown, 0 down, 1 up)
    # and whether a check of it runs
    intern svc_names     : vec string
    intern svc_ready     : vec string
    intern svc_start     : vec string
    intern svc_ms        : vec i64
    intern svc_state     : vec i32
    intern svc_busy      : vec bool
    intern svc_poll_ms   : i64
    # the system bar's height, and whether this is orbiter-os
    intern system_h      : f32 [ 30.0 ]
    intern system_known  : bool
    intern system_os     : bool
    # the incoming call last shown (the phone opens once a call)
    intern ring_seen     : string
    intern clock_was     : string
    intern scene_names   : vec string
    # which exported module carries each scene class
    intern scene_mods    : map string [string]
    intern scene_stamp   : i64
    intern scene_check   : i64
    intern scene_revision : i64
    # lldb attach runs on a worker; it hands the finished dbg back here
    # and the main thread publishes it into debuggers on the next frame
    # kept in a list: reassigning one async drops it, and drop joins the
    # thread
    intern attach_tasks    : vec async
    intern attach_pending  : dbg
    intern attach_mod      : string
    intern attach_av       : AppView
    mutable instances      : vec AppView
    # each store folder's time as last seen, and when it was looked at
    mutable store_seen     : map string [string]
    mutable store_check_ms : i64
    # counts each new gathering of the app cards (the grid redraws)
    mutable apps_gen       : i32
    # the apps it runs: one registry decides every instance
    public insts : Instances
    # the next launch is a new instance, even beside a running one
    public inst_fresh : bool
    intern  all_cmd        : string
    public scene_load    : string
    # --stats: per-second frame stats on the terminal
    public stats         : bool
    # --show_fps: the frame rate alone, each second on the console
    public show_fps      : bool
    # --benchmark: every frame drawn, no wait on the refresh
    public benchmark     : bool
    intern scene_el      : element
    # the platform's avatars held in a state to check: 0 as they
    # are, 1 the halo (thinking), 2 edits coming in, 3 the beam
    public avatar_mode   : i32
    intern scene_el_nm   : string
    # the scene last found missing: said once, tried again each frame
    intern scene_miss    : string
    # built scenes kept between switches (the agent view's Milky Way
    # and the chosen one), with their pictures while off the window
    intern scene_kept    : map element [ string ]
    intern scene_rts     : map Render [ string ]
    # the agent view's background, our galaxy, built once and kept
    # (its picture while off the window); the chosen scene then
    # shows in the floor's mirrors only
    intern galaxy_el     : element
    # the agents whose avatars have risen out of the glass: a
    # platform made again shows them up, not rising again
    public home_risen    : vec string
    # the platform, made once: its avatars, their turns and the
    # camera go on across visits to the agents view
    intern plat_kept     : element

    public func platform_of [ fw: f32 ] -> element
    intern galaxy_rt     : Render
    # each scene's props as the user set them, by scene name (agi)
    public [ StatePersist ] scene_props   : map string [string]
    intern frost_dbg8    : i32 [ -9 ]

