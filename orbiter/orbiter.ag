        if [ n9 != 0 ] return
        pclose[ one_fh ]
        one_fh = null
        one_fd = -1
        key : string one_full.lcase[]
        items : vec RepoInfo repo_parse[ one_buf ]
        hit : RepoInfo (items.count > 0) ? items[0] : RepoInfo [
            full: '', name: '', desc: '' ]
