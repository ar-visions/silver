        Au.auto_free[]

    func git_summarize []
        if [ git_busy ] return
        git_busy  = true
        git_dirty = false
        git_last  = Au.epoch_millis[]
        pthread_create[ @git_tid, null, @git_entry, a ]
        git_live  = true

    func path_depth [ s: string ] -> i32
        n9 : i32 [ 0 ]
        for [ i: i32 0, i < s.count, i += 1 ]
            if [ s.chars[i] == 47 ] n9 += 1
        return n9

    func git_ref_of [ root: path ] -> string
        if [ !root || !git_refs ] return 'HEAD'
        r : string git_refs[ '{root.absolute[]}' ]
        return (r && r.count > 0) ? r : 'HEAD'

    # a new reference: the tabs and every pane's marks re-read against
