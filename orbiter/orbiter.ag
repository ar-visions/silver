        v9 : i32 [ 0 ]
        m9 : i32 [ 1 ]
        for [ i: i32 pi - 1, i >= 0, i -= 1 ]
            c : i32 [ seg.chars[ i ] ]
            if [ c < 48 || c > 57 ] break
            v9 += (c - 48) * m9
            m9 *= 10
        f9 : f32 [ f32[ v9 ] / 100.0 ]
        if [ seg.index_of[ 'Receiving' ] >= 0 ]
            rc.pct = 0.1 + f9 * 0.8
        el [ seg.index_of[ 'Resolving' ] >= 0 ]
            rc.pct = 0.9 + f9 * 0.1
        el                                            rc.pct = f9 * 0.1

