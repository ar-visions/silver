            trt : Tray tray_shared[]
            if [ tix >= 0 && tix < trt.items.count ]
                tit : TrayItem trt.items[ tix ]
                if [ !tit.menu_only ]
                    trt.activate[ tit ]
                    drawer_shut[]
                el
                    trt.chosen = tit.service
                    tit.dirty  = true
                    drawer_toggle[ 'tray', false ]
            if [ ux ] ux.restyle = true
            ev.no_default = true
            return
        if [ ev.target.id == 'bar_url' ]
            if [ !bar_typing ]
                ed9 : Editor pane_at[ active_pane ]
                rv9 : AppView (ed9) ? ed9.run_view : null
                bar_text = (rv9 && rv9.app_address) ? rv9.app_address
                    : ((rv9 && rv9.arg_text) ? rv9.arg_text
                    : ((rv9) ? default_arg_of[ rv9.module_args ] : ''))
                bar_typing = true
                bar_fresh  = true
            if [ ux ] ux.restyle = true
            ev.no_default = true
            return
        # another pane's title or load: that pane first
        if [ ev.target.id.starts_with[ 'bar_name' ]
             || ev.target.id.starts_with[ 'bar_load' ] ]
            # 'bar_name' is the active pane's, 'bar_name_1' pane 1's
            if [ ev.target.id.count > 9 ]
                pq : i32 [ ev.target.id.mid[ 9,
                    ev.target.id.count - 9 ].integer_value[] ]
                if [ pq >= 0 && pq < editor_slots.count ]
                    active_pane = pq
            if [ pane_loads[ active_pane ] ] bar_title_press[]
            ev.no_default = true
            return
        if [ ev.target.id == 'bar_title' ]
            # the full navigator lives in the docked view; a free
            # window's is a dialog of its own
            bp : i32 bar_pane[]
            # the globe again: the navigator closes (a pick with it)
            if [ (nav_showing || picking[]) && bp == active_pane ]
                nav_hist = null
                exit_finder[]
                exit_find_mode[]
                nav_showing  = false
            # every window free: a new docked view opens on it
            el [ bp < 0 ]
                pane_add[]
            # its own view in front of whatever the docked pane shows
            # (that keeps running, back as it shuts)
            el
                active_pane = bp
                focus_finder[]
            ev.no_default = true
            return
        # an app's outline toggle (the bar's, or a window's strip's)
        oi : i32 [ ev.target.id.index_of[ 'poutline_' ] ]
        if [ oi >= 0 ]
            op : i32 [ ev.target.id.mid[ oi + 9,
                ev.target.id.count - oi - 9 ].integer_value[] ]
            oe : Editor pane_at[ op ]
            oav : AppView (oe) ? oe.run_view : null
            if [ oav && oav.slot >= 0 ]
                host_post2[ oav.slot, 1, i32[ HM.panel ], 1, 0, 0 ]
            ev.no_default = true
            return
        # an app's panel toggle: the app opens or closes its panel
        if [ ev.target.id.starts_with[ 'ppanel_' ] ]
            pp : i32 [ ev.target.id.mid[ 7,
                ev.target.id.count - 7 ].integer_value[] ]
            pe : Editor pane_at[ pp ]
            pav : AppView (pe) ? pe.run_view : null
            if [ pav && pav.slot >= 0 ]
                host_post2[ pav.slot, 1, i32[ HM.panel ], 0, 0, 0 ]
            ev.no_default = true
            return
        # a tab's close: that pane closes
        if [ ev.target.id.starts_with[ 'pclose_' ] ]
            cp : i32 [ ev.target.id.mid[ 7,
                ev.target.id.count - 7 ].integer_value[] ]
            # its running instance ends with it, not hidden
            if [ cp >= 0 && cp < editor_slots.count ]
                # a window gives its pane back once it has closed
                owned : bool [ pane_window[ cp ] != 0 ]
                quit_app_in[ cp ]
                if [ !owned ] close_pane[ cp ]
            if [ ux ] ux.restyle = true
            ev.no_default = true
            return
        # another pane's group in the bar: that pane becomes active
        if [ ev.target.id.starts_with[ 'pmenu_' ]
             || ev.target.id.starts_with[ 'ptitle_' ] ]
            u9 : i32 [ ev.target.id.index_of[ '_' ] ]
            pp : i32 [ ev.target.id.mid[ u9 + 1,
                ev.target.id.count - u9 - 1 ].integer_value[] ]
            if [ pp >= 0 && pp < editor_slots.count ]
                active_pane = pp
            # one press does its job too: the globe opens the
            # navigator, the name opens that pane's menu
            if [ ev.target.id.starts_with[ 'ptitle_' ] ]
                focus_finder[]
            el
                menu_sync[]
                pane_menu[]
                menu_top = -1
                if [ menu_items ]
                    for [ i: i32 0, i < menu_items.count, i += 1 ]
                        e9 : TrayEntry menu_items[ i ]
                        if [ menu_top < 0 && e9.depth == 0 && !e9.rule ]
                            menu_top = i
                if [ menu_top >= 0 ] drawer_toggle[ 'menu', false ]
            if [ ux ] ux.restyle = true
            ev.no_default = true
            return
        # a press anywhere else ends typing in the bar's title
        if [ bar_typing ]
            bar_typing = false
            if [ ux ] ux.restyle = true
        if [ ev.target inherits MenuTop ]
            mt : cast MenuTop [ ev.target ]
            # the desktop's own menu, whatever window is selected
            if [ mt.at == -2 ]
                desk_menu_open[]
                ev.no_default = true
                return
            # another window's menu: that window first, then its menu
            if [ mt.pane >= 0 && mt.pane != active_pane ]
