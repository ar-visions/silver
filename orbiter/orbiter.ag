        if [ ev.target.id == 'home_mod' ]
            edh : Editor pane_of[ ev.target ]
            pih : i32 [ (edh) ? edh.pane_index : active_pane ]
            hs : path home_src[]
            if [ edh && edh.src && hs && '{edh.src}' == '{hs}' ]
                au_live_switch[ home_mod.chars ]
            el [ hs ]
                open_in_pane[ hs, pih ]
