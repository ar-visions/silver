        if [ ev.target.id == 'app_run' ]
            edr : Editor pane_of[ ev.target ]
            if [ !edr ] edr = pane_at[ active_pane ]
            msr : path (edr) ? module_src_of[ edr ] : null
            rvr : AppView (edr) ? edr.run_view : null
            if [ msr && (ev.key.shift || ev.key.ctrl || ev.key.meta) ]
                show_app[ edr, msr, true ]
            el [ rvr && !rvr.ended && !rvr.held ]
                edr.toggle_app_run[ false ]
            el [ msr ]
                show_app[ edr, msr, false ]
            if [ ev.target ] ev.target.ux.restyle = true
            ev.no_default = true
            return
        if [ ev.target.id == 'agent_ask' ]
            eda : Editor pane_of[ ev.target ]
            log 'AGENTASK press pane={bool[eda]} src={(eda && eda.src) ? string[eda.src] : "none"} line={(eda) ? eda.sel_line : -1}'
            if [ eda && eda.src && ux ]
                ux.exchange_open[ eda.src, eda.sel_line + 1, true ]
            ev.no_default = true
            return
        # the title's toggle: the pane's app in Embed, else PIP
