# per-source-file state; arguments is the first field, more to come
class file_state
    public args        : string

struct vec2i
    x : i32
    y : i32

class pane_state
    public file      : path
    public selection : vec2i

class FileChg
    public adds : i32
    public dels : i32

# one threaded git fetch: the view only ever reads a finished snapshot
class GitSnap
    public base  : string
    public repo  : string
    public files : vec string
    public adds  : i32
    public dels  : i32
    public chg   : map FileChg [string]

class FmtWatch
    public proj  : string
    public file  : path
    public pid   : i32 [ 0 ]
    public fd    : i32 [ -1 ]
    public map   : string
    public mtime : i64 [ 0 ]
    public src_mtime : i64 [ 0 ]
    public announced : bool
    public kicked    : bool
    public start_us  : i64 [ 0 ]
    # set when the file's handler module colours it in-process
    public fn        : hook

element orbiter : trinity # implements compiler
    public width         : i32    [ 1888 ]
    public height        : i32    [ 888 ]
    public background    : string [ 'Background' ]
    # the committed backdrop scene and each pane's file + caret
    intern [ StatePersist ] scene       : string
    intern [ StatePersist ] pane_states : vec pane_state
    # false keeps the scenes module out of the process entirely
    public show_scene    : bool   [ true ]
    public live_reload   : bool   [ true ]
    public startup_path  : path
    # the whole argv tail: the thing we open, then the module's own args.
    # split in init — resource keeps the first token, module_args the rest
    default module_args  : string
    intern resource      : string
    # per-source-file state, keyed by path; persisted with the session
    public [ StatePersist ] file_states   : map file_state [string]
    public log           : string
    intern tee_started   : bool
    intern cap_fd        : i32 [ -1 ]
    intern log_fd        : i32 [ -1 ]
    intern avg_fps       : f32
    intern target_names  : vec string
    intern target_roots  : vec path
    intern target_srcs   : vec path
    public projects      : map Project [string]
    public consoles      : map ConsoleInstance [string]
    intern ed_sessions   : map ConsoleSession [string]
    intern shot_n        : i32
    intern orbit_app      : string
    # summoned shell bound its pane-0 AppView to the peer (once)
    intern orbit_bound    : bool
    # the agent tab's session id ('' = shell mode off)
    public orbit_sid      : string
    # the one agent session is working — drives the avatar tilt
    public busy           : bool
    intern busy_at        : i64
    intern cell_dumped    : bool
    intern orbit_ctx      : string
    intern orbit_ctx_sent : bool
    intern orbit_hello_at : i32
    # one-shot startup voice test fired
    intern orbit_voice_tested : bool
    # the crash verdict has been typed into the agent session
    intern orbit_reported : bool
    intern orbit_enter_at : i32
    intern orbit_spoken   : vec string
    # mic capture running / final transcription winding down
    intern orbit_cap_on   : bool
    intern orbit_flushing : bool
    # last dictate command (edge-detect) via on_host
    intern orbit_dstate   : i32 [ -1 ]
    # attached app's pid — once it dies this shell must exit
    intern orbit_app_pid  : i32 [ 0 ]
    intern orbit_oc       : string
    intern orbit_cc       : string
    intern debuggers     : map dbg [string]
    intern debug_vars         : vec Au
    intern last_bp_count      : i32 [ -1 ]
    intern settings_mtime    : i64
    intern settings_check_ms : i64
    public [ StatePersist ] open_files       : vec path
    public [ StatePersist ] docked           : vec path
    intern nav_dock_rows    : i32
    public editor_slots     : vec i32
    intern pane_console     : vec string
    # the ai/agent console is separate state; always projected last
    public agent_open       : bool
    intern console_seq      : i32
    intern pending_finder   : i32 [ -1 ]
    intern pending_run      : i32 [ -1 ]
    intern pending_findfocus : bool
    intern find_scanned : i32
    public active_pane      : i32
    public cycle            : bool
    intern cycle_frame      : i32
    intern cycle_count      : i32
    intern cycle_adding     : bool [ true ]
    intern nav_panes        : vec Navigate
    intern [ StatePersist ] console_w        : i32
    intern console_w_save   : i32
    intern [ StatePersist ] band_h           : i32
    intern band_h_save      : i32
    public show_instruments : bool
    # the variables panel — the other tab of the stack menu
    public show_variables   : bool
    # summon-only: never saved, never active at startup
    intern show_orbiter     : bool
    intern listen_file      : path
    public active_idx       : i32
    public config_side      : i32
    public active_panel  : string
    # commit hash the stacked diff view presents
    public [ StatePersist ] active_target : string
    intern fmt_watch  : map FmtWatch [string]
    # git snapshot: fetched by a thread, swapped in on the main thread.
    # refreshed on file save and otherwise every 60 seconds
    intern git_snap  : GitSnap
    intern git_stage : GitSnap
    intern git_busy  : bool
    intern git_fresh : bool
    intern git_last  : i64
    # the watcher saw a source change since the last fetch
    intern git_dirty : bool
    # ONE buffer mapping for every pane and view, keyed by absolute path
    public file_cache    : map FileBuf [string]
    public show_avatar   : bool [ true ]
    public avatar_expanded : bool
    public avatar_enabled  : bool
    public filter_text   : string
    public find_text     : string
    public findbar_open  : bool
    public findbar_pane  : string
    # restored carets, applied after each editor loads
    intern pending_sel   : vec vec2i
    # the status bar's center toggle: scene-only viewing
    public hide_ui       : bool
    public findbar_text  : string
    # the args field edited this frame; its edit is copied to the session
    mutable args_field   : element
    mutable args_editor  : Editor
    mutable args_sync    : bool
    intern find_last_query : string
    intern find_last_scope : string
    intern find_scan_mt  : i64
    public replace_text  : string
    public pattern_text  : string
    public find_showing  : bool
    public nav_showing   : bool
    # the user dismissed the finder: focus lands on the editor, which still
    # carries show_hits, so list_focused would revive the list forever
    intern finder_off    : bool
    # app bar volume, pushed to the running app when it moves
    public app_volume    : f32 [ 0.5 ]
    # mute holds the slider where it is and sends the app a zero
    public app_muted     : bool
    intern app_vol_sent  : f32 [ -1.0 ]
    public find_hits     : vec FindHit
    public search_dirs   : vec path
    public file_index    : list string
    public max_search    : i32 [ 400000 ]
    public search_external : bool [ true ]
    public find_results  : list string
    intern was_finder    : bool
    intern last_hit_row      : i32 [ -1 ]
    intern was_search_pane : string
    public index_dirty   : bool
    intern index_research : bool
    intern index_task    : async
    # guards file_index: search reads while the worker fills
    intern index_lock    : mutex
    # main thread raises this to stop a running worker early
    intern index_cancel  : bool
    intern index_building : bool
    intern index_watches : vec watch
    public compile_log   : list string
    intern err_file      : path
    intern err_line      : i32
    intern err_msg       : string
    public nav_root      : path
    # tool views mounted on the nav's left rail, from module exports
    mutable view_tools     : vec string
    mutable view_tools_bin : vec string
    mutable view_mods      : map string [string]
    public browse_single : bool
    public show_pins     : bool [ true ]
    public grid_mode     : bool
    public browse_header_size : i32 [ 18 ]
    public browse_dir_size : i32 [ 16 ]
    public [ StatePersist ] breakpoints   : map string[string]
    public code_font_size : i32 [ 19 ]
    # append LAST: member order sets AF bit indices
    public show_instr_col : bool
    # module whose build set err_file; only it may clear
    intern err_mod       : string
    # index into scene_list[]; the bottom bar steps it
    intern scene_ix      : i32
    intern scene_names   : vec string
    # which exported module carries each scene class
    intern scene_mods      : map string [string]
    # lldb attach runs on a worker; it hands the finished dbg back here
    # and the main thread publishes it into debuggers on the next frame
    # kept in a list: reassigning one async drops it, and drop joins the thread
    intern attach_tasks    : vec async
    intern attach_pending  : dbg
    intern attach_mod      : string
    intern attach_av       : AppView
    intern frame_no9       : i32
    public scene_load    : string
    intern scene_el      : element
    intern scene_el_nm   : string
    # index into speed_list[]; 0 is subtle, the default
    intern [ StatePersist ] speed_ix      : i32
    # index into orbit_list[]; high-orbit is the default
    intern [ StatePersist ] orbit_ix      : i32 [ 1 ]
    # index into angle_list[]; flat-on is the default
    intern [ StatePersist ] angle_ix      : i32 [ 1 ]
    # frost stage 0..2 (frost/blur/clear), pushed to ux.frost_mode
    intern [ StatePersist ] frost_ix      : i32
    intern frost_dbg9    : i32 [ -9 ]
    intern frost_dbg8    : i32 [ -9 ]

    func init []
        au_live_set_defer[ 1 ]
        # the syntax service rebuilds our own module — never self-reload
        au_live_set_reload[ 0 ]
        breakpoints    = map string[string] []

        target_names   = vec string []
        target_roots   = vec path []
        target_srcs    = vec path []
        load_settings[]
        file_cache     = map FileBuf [string] []
        open_files     = vec path []
        docked         = vec path []
        # a few default pins so the column has content to look at
        active_idx     = -1
        # one editor pane to start, empty (the 'Open' finder)
        editor_slots   = vec i32 [] [-1]
        pane_console   = vec string [] ['']
        active_pane    = 0
        nav_panes      = vec Navigate []
        for [ i: i32 0, i < 8, i += 1 ]
            nav_panes += Navigate []
        active_panel   = 'files'
        active_target  = 'silver'
        restore_session[]
        nav_root       = project_root[]
        # warm the git snapshot now: the view reads it, never fetches
        git_summarize[]
        # first token is ours to open; everything after belongs to the module
        if [ module_args && module_args.count > 0 ]
            sp9 : i32 [ i32[ module_args.index_of[ ' ' ] ] ]
            if [ sp9 > 0 ]
                resource    = module_args.mid[ 0, sp9 ]
                module_args = module_args.mid[ sp9 + 1, module_args.count - sp9 - 1 ]
            el
                resource    = module_args
                module_args = ''
        ae : getenv[ 'SILVER_ISOLATE_APP' ]
        if [ ae ]
            orbit_app = string [ ae ]
            orbit_app.hold[]
            ob : local i8 [ 3 ]
            ob[0] = 123
            ob[1] = 123
            ob[2] = 0
            orbit_oc = string [ @ob[0] ]
            orbit_oc.hold[]
            cb : local i8 [ 3 ]
            cb[0] = 125
            cb[1] = 125
            cb[2] = 0
            orbit_cc = string [ @cb[0] ]
            orbit_cc.hold[]
            if [ !resource || resource.count == 0 ] resource = orbit_app
        dbg_start : bool [ false ]
        if [ resource && resource.count > 0 ]
            rp : path '{startup_path}/{resource}'
            if [ resource.chars[0] == 47 ] rp = path '{resource}'
            if [ rp.exists[] ]
                if [ rp.is_dir[] ]
                    nav_root = rp
                el
                    ri : i32 [ file_slot[ rp ] ]
                    if [ editor_slots.count == 0 ] editor_slots += -1
                    editor_slots[0] = ri
                    active_pane = 0
                    active_idx  = ri
                    # the arg we were handed at startup is this file's arg
                    fs8 : file_state fstate[ rp ]
                    if [ fs8 ] fs8.args = '{rp}'
            el
                bp : path '{startup_path}/install/build/{resource}'
                if [ bp.exists[] ]
                    # open the module's SOURCE and host it in the pane. exec'ing
                    # the binary here gave it its own window instead of a texture
                    sp8 : path '{startup_path}/{resource}/{resource}.ag'
                    op8 : path [ (sp8.exists[]) ? sp8 : bp ]
                    bi : i32 [ file_slot[ op8 ] ]
                    if [ editor_slots.count == 0 ] editor_slots += -1
                    editor_slots[0] = bi
                    active_pane   = 0
                    active_idx    = bi
                    active_target = resource
                    if [ sp8.exists[] ]
                        pending_run = 0
                    el
                        dbg_start = true
                el
                    puts 'orbiter: no such resource {resource}'
        if [ orbit_app ]
            pending_run = -1
            active_pane = 0
        orbit_sid = agent_sid[]
        orbit_sid.hold[]
        if [ !ed_sessions ] ed_sessions = map ConsoleSession [string] [ ]
        if [ orbit_app && !ed_sessions[ orbit_sid ] ]
            agent_open = true
            ensure_console[ orbit_sid ]
        filter_text    = ''
        find_text      = ''
        findbar_open   = false
        findbar_text   = ''
        replace_text   = ''
        pattern_text   = ''
        find_showing   = false
        find_hits      = vec FindHit []
        search_dirs    = vec path []
        search_dirs   += project_root[]
        file_index     = list string []
        find_results   = list string []
        index_dirty    = false
        index_watches  = vec watch []
        index_lock     = mutex [ ]
        start_watching[]
        # kick off the index build on its worker thread
        start_index[]
        compile_log    = list string []
        ensure_user_config[]
        if [ dbg_start ] start_debug[ resource ]

    func ensure_user_config []
        home : string [ getenv[ 'HOME' ] ]
        if [ !home || home.count == 0 ] return
        xdg  : string [ getenv[ 'XDG_CONFIG_HOME' ] ]
        base : string (xdg && xdg.count > 0) ? xdg : '{home}/.config'
        dir  : path '{base}/orbiter'
        dir.make_dir[]
        cfg  : path '{base}/orbiter/orbiter.config'
 
    func agi_path [] -> path
        if [ !startup_path ] startup_path = path.path_startup[]
        p : path '{startup_path}/orbiter.agi'
        if [ p.exists[] ] return p
        d : path startup_path
        for [ i: i32 0, i < 6, i += 1 ]
            d = d.parent_dir[]
            if [ !d ] return p
            p2 : path '{d}/orbiter.agi'
            if [ p2.exists[] ]
                startup_path = d
                return p2
        return p

    func resolve_local [ p: path ] -> path
        if [ !startup_path ] startup_path = path.path_startup[]
        if [ !p ] return path '{startup_path}'
        s : string '{p}'
        if [ s.count == 0 || s == '.' ] return path '{startup_path}'
        if [ s[0] == '/' ] return p
        return path '{startup_path}/{s}'

    func cache_dir [] -> path
        return path.path_storage[ 'orbiter' ]

    # per-file state, created on first touch
    func fstate [ p: path ] -> file_state
        if [ !p ] return null
        if [ !file_states ] file_states = map file_state [string] []
        k9 : string '{p}'
        fs : file_state file_states[ k9 ]
        if [ !fs ]
            fs = file_state []
            file_states[ k9 ] = fs
        return fs

    func file_args [ p: path ] -> string
        if [ !p || !file_states ] return ''
        fs : file_state file_states[ '{p}' ]
        return (fs && fs.args) ? fs.args : ''

    func save_session []
        panes : vec pane_state []
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            slot : i32 [ editor_slots[i] ]
            if [ slot >= 0 && slot < open_files.count && open_files[slot] ]
                e9 : Editor pane_at[ i ]
                sel9 : vec2i [ x: (e9) ? e9.sel_line : 0,
                    y: (e9) ? e9.sel_col : 0 ]
                panes.push[ pane_state [
                    file: open_files[slot], selection: sel9 ] ]
        pane_states = panes
        scene       = scene_loaded[]
        save-persistent[]

    func restore_session []
        load-persistent[ a ]
        if [ pane_states && pane_states.count > 0 ]
            editor_slots = vec i32 []
            pending_sel = vec vec2i []
            for [ i: i32 0, i < pane_states.count, i += 1 ]
                ps9 : pane_state pane_states[i]
                if [ ps9 && ps9.file ]
                    editor_slots += file_slot[ ps9.file ]
                    pending_sel += ps9.selection
            if [ editor_slots.count == 0 ] editor_slots += -1
            active_pane = 0
        el [ open_files.count > 0 && editor_slots.count > 0 ]
            editor_slots[0] = 0
        if [ breakpoints ] last_bp_count = breakpoints.count
        # an explicit --scene_load beats whatever the last session left behind
        if [ scene && scene.count > 0 && (!scene_load || scene_load.count == 0) ]
            scene_load = scene
            scene_load.hold[]
            sl9 : scene_list[]
            for [ i: i32 0, i < sl9.count, i += 1 ]
                if [ sl9[i] == scene ] scene_ix = i
        # sessions saved when there were four stages can hold a 3, which
        # now wraps past clear and reads as frost
        frost_ix = frost_ix % 4

    func load_settings []
        sp  : agi_path[]
        puts 'load_settings: startup_path={startup_path} -> agi={sp}'
        txt : string [ sp.load[ typeid[string], null ] ]
        if [ !txt || txt.count == 0 ]
            puts 'load_settings: no/empty file at {sp}'
            return
        settings_mtime = sp.modified_time[]
        if [ projects ] projects.clear[]
        Au.parse_agi[ null, txt.chars, a ]
        if [ projects ]
            for [ p: Project, name: string ] in projects
                p.root = resolve_local[ p.root ]
                if [ p.cwd ] p.cwd = resolve_local[ p.cwd ]
        sync_targets[]
        if [ projects ]
            puts 'loaded {projects.count} projects:'
            for [ p: Project, name: string ] in projects
                puts '  {name}: root={p.root}'
                if [ p.deps ]
                    for [ d: token ] in p.deps
                        puts '    dep: {d.chars}'
        el
            puts 'loaded 0 projects (projects is null)'

    func sync_targets []
        target_names = vec string []
        target_roots = vec path []
        target_srcs  = vec path []
        if [ !projects ]
            return
        for [ p: Project, name: string ] in projects
            target_names += name
            target_roots += p.root
            target_srcs  += p.root

    func check_stale []
        for [ i: i32 0, i < target_names.count, i += 1 ]
            name    : string target_names[i]
            src     : path   target_srcs[i]
            product : path  '{startup_path}/install/build/{name}'
            if [ !product.exists[] ]
                compile_log.push[ 'stale (no product): {name}' ]
                compile[ name ]
                continue
            product_mtime : i64 [ product.modified_time[] ]
            src_mtime     : i64 [ 0 ]
            src.latest_modified[ @src_mtime ]
            if [ src_mtime > product_mtime ]
                compile_log.push[ 'stale (source newer): {name}' ]
                compile[ name ]

    func compile_fn [ w: Au ]
        m: string w  
        i: silver [ component: true, module: m ]  

    func compile [ mod: string ]
        active_target = 'system'
        compile_log.push[ 'compiling {mod}...' ]
        i: silver [ component: true, verbose:true, module: mod ]
        au_space_clear[]
        compile_log.push[ 'done: {mod}' ]

    func fmt_stop [ key: string ]
        if [ !fmt_watch ] return
        fw : FmtWatch fmt_watch[ key ]
        if [ !fw ] return
        if [ fw.fd >= 0 ] close[ fw.fd ]
        fmt_watch.rm[ key ]

    func fmt_stop_all []
        if [ !fmt_watch ] return
        for [ fw: FmtWatch, name: string ] in fmt_watch
            if [ fw.fd >= 0 ] close[ fw.fd ]
        fmt_watch = map FmtWatch [string] []

    func fmt_spawn [ fw: FmtWatch ]
        if [ !fw ] return
        if [ !startup_path ] startup_path = path.path_startup[]
        if [ fw.fd >= 0 ]
            close[ fw.fd ]
            fw.fd = -1
        cmd : 'cd {startup_path} && unset IMPORT && exec ./install/bin/silver --build {fw.file} > /tmp/orbiter-fmt-{fw.proj}.log 2>&1'
        fd  : i32 [ -1 ]
        pid : i32 [ forkpty[ @fd, null, null, null ] ]
        if [ pid == 0 ]
            dashc : string '-c'
            execl[ '/bin/bash', 'bash', dashc.chars, cmd.chars, null ]
            _exit[ 1 ]
        el [ pid > 0 ]
            fw.pid = pid
            fw.fd  = fd
            fcntl[ fd, F_SETFL, O_NONBLOCK ]

    func fmt_main [ f: path ] -> path
        dir  : path f.parent_dir[]
        modn : string dir.filename[]
        m    : path '{dir}/{modn}.ag'
        if [ m.exists[] ] return m
        return f

    func fmt_start [ f: path ]
        if [ !f ] return
        if [ !startup_path ] startup_path = path.path_startup[]
        if [ !fmt_watch ] fmt_watch = map FmtWatch [string] []
        k : string '{f}'
        if [ fmt_watch[ k ] ] return
        fn   : string f.filename[]
        stem : string fn
        di   : i32 [ fn.rindex_of[ '.' ] ]
        if [ di > 0 ] stem = fn.mid[ 0, di ]
        fw : FmtWatch [ proj: stem, file: f, map: '{startup_path}/install/syntax/{stem}.f', start_us: epoch_micros[] ]
        fmt_watch[ k ] = fw

    # the handler module's lib exports `syntax`; it colours in-process
    func fmt_start_fn [ f: path, lib: string ]
        if [ !startup_path ] startup_path = path.path_startup[]
        # buffers key on the absolute path; the map's source must match
        fw : FmtWatch [ proj: lib, file: f.absolute[], map: '', start_us: epoch_micros[], kicked: true, announced: true ]
        fmt_watch[ '{f}' ] = fw
        so : path '{startup_path}/install/build/lib{lib}.so'
        if [ !so.exists[] ] return
        # local: only dlsym on this handle needs its symbols
        h : dlopen[ so.chars, RTLD_NOW ]
        if [ !h ]
            puts 'syntax: dlopen failed for {so}'
            return
        sym : string 'syntax'
        fw.fn = cast hook [ dlsym[ h, sym.chars ] ]
        if [ !fw.fn ] puts 'syntax: {lib} exports no syntax function'
        el puts 'syntax: {lib} colours {fw.file}'

    # re-ask the handler whenever the file on disk changes
    func fmt_poll_fn [ fw: FmtWatch ]
        if [ !fw.file ] return
        sm : i64 [ fw.file.modified_time[] ]
        if [ fw.mtime > 0 && sm <= fw.mtime ] return
        # the buffer is shared by every pane: ask once it is loaded
        ed0 : Editor null
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            ed : Editor pane_at[ i ]
            if [ ed && !ed0 ] ed0 = ed
        if [ !ed0 || !ed0.has_buffer[ fw.file ] ] return
        fn : hook fw.fn
        ff : fmt_file fn[ fw.file ]
        if [ !ff ] return
        fw.mtime = sm
        lns9 : vec Au ff.lines
        puts 'syntax: {fw.proj} mapped {lns9.count} lines for {ff.source}'
        ed0.apply_format[ ff ]
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            ed : Editor pane_at[ i ]
            if [ ed ] ed.pristine = false
        win : ux
        if [ win ] win.will_animate = true

    func fmt_sync []
        if [ !fmt_watch ] fmt_watch = map FmtWatch [string] []
        if [ !open_files ] return
        live : vec string []
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            slot : i32 [ editor_slots[i] ]
            if [ slot < 0 || slot >= open_files.count ] continue
            f : path open_files[slot]
            if [ !f ] continue
            fn : string f.filename[]
            if [ fn.count < 3 ] continue
            if [ fn.mid[ fn.count - 3, 3 ].compare[ '.ag' ] != 0 ]
                # not silver: the extension's handler module colours it
                ed  : Editor pane_at[ i ]
                lib : string (ed) ? ed.handler_lib_for[ f ] : null
                if [ !lib ] continue
                k2 : string '{f}'
                if [ live.index_of[ k2 ] < 0 ] live += k2
                if [ !fmt_watch[ k2 ] ] fmt_start_fn[ f, lib ]
                continue
            main : path fmt_main[ f ]
            k : string '{main}'
            if [ live.index_of[ k ] < 0 ] live += k
            if [ !fmt_watch[ k ] ] fmt_start[ main ]
        stale : vec string []
        if [ fmt_watch.count > 0 ]
            for [ fw: FmtWatch, k2: string ] in fmt_watch
                if [ live.index_of[ k2 ] < 0 ] stale += k2
        for [ i: i32 0, i < stale.count, i += 1 ]
            fmt_stop[ stale[i] ]

    func fmt_poll []
        if [ !fmt_watch ] return
        for [ fw: FmtWatch, name: string ] in fmt_watch
            if [ fw.fn ]
                fmt_poll_fn[ fw ]
                continue
            if [ fw.kicked && fw.pid == 0 && fw.file ]
                sm : i64 [ fw.file.modified_time[] ]
                if [ fw.src_mtime > 0 && sm > fw.src_mtime ]
                    fw.src_mtime = sm
                    git_dirty = true
                    fmt_spawn[ fw ]
                el [ fw.src_mtime == 0 ]
                    fw.src_mtime = sm
        for [ fw: FmtWatch, name: string ] in fmt_watch
            if [ !fw.announced ]
                puts 'syntax: {name} language service starting...'
                fw.announced = true
            if [ fw.fd >= 0 ]
                dbuf : local i8 [256]
                for [ j: i32 0, j < 64, j += 1 ]
                    nr : i32 [ read[ fw.fd, @dbuf[0], 256 ] ]
                    if [ nr <= 0 ] break
            if [ fw.pid > 0 ]
                st : i32 [ 0 ]
                r  : i32 [ waitpid[ fw.pid, @st, WNOHANG ] ]
                if [ r == fw.pid ]
                    code : i32 [ (st >> 8) & 0xFF ]
                    sig  : i32 [ st & 0x7F ]
                    if [ sig != 0 ]
                        puts 'syntax: {name} CRASHED (signal {sig}) — see /tmp/orbiter-fmt-{fw.proj}.log'
                    el [ code != 0 ]
                        puts 'syntax: {name} build FAILED (code {code}) — see /tmp/orbiter-fmt-{fw.proj}.log'
                        # jump the editor to silver's first emitted error location
                        err_mod = name
                        jump_to_error[ '/tmp/orbiter-fmt-{fw.proj}.log' ]
                    el
                        puts 'syntax: {name} language service finished'
                        # only the module that failed may clear its own error
                        if [ err_mod && err_mod == name ]
                            err_file = null
                            err_line = 0
                            err_msg  = null
                            err_mod  = null
                    fw.pid = 0
            if [ fw.map && fw.map.count > 0 ]
                mp : path fw.map
                if [ mp.exists[] ]
                    m : mp.modified_time[]
                    # a map older than its source describes text that is
                    # already gone: its line/col ranges land on the wrong
                    # spans. leave the last good colouring until the
                    # service catches up
                    fresh : bool [ true ]
                    if [ fw.file ]
                        sm2 : i64 [ fw.file.modified_time[] ]
                        fresh = m >= sm2
                    applied : bool [ false ]
                    for [ i: i32 0, i < editor_slots.count, i += 1 ]
                        ed : Editor pane_at[ i ]
                        if [ fresh && ed && ed.fmt_mtime < m ]
                            ed.load_format[ fw.map ]
                            ed.fmt_mtime = m
                            ed.pristine = false
                            applied = true
                    if [ applied ]
                        win : ux
                        if [ win ] win.will_animate = true
                        if [ m > fw.mtime ]
                            fw.mtime = m
            if [ !fw.kicked && epoch_micros[] - fw.start_us >= 1000000 ]
                fmt_spawn[ fw ]
                fw.kicked = true

    func debug_frames [] -> vec Au
        fr : vec Au []
        dv : dbg active_debugger[]
        if [ !dv ] return fr
        dfr : dv.read_frames[]
        if [ !dfr ] return fr
        for [ df: frame ] in dfr
            fr.push[ Frame [ func_name: df.func_name, file: df.source, line: i32[ df.line ] ] ]
        return fr

    func agent_cmd [ sid: string ] -> string
        base : string sid
        hx : i32 [ (sid) ? sid.index_of[ '#' ] : -1 ]
        if [ hx > 0 ] base = sid.mid[ 0, hx ]
        ci : ConsoleInstance (consoles && base) ? consoles[base] : null
        cmd_str : string ''
        if [ ci && ci.run ]
            for [ c: token ] in ci.run
                cmd_str = (cmd_str.count > 0) ? cmd_str + ' ' + c.chars : c.chars
        return cmd_str

    # the agent console named in orbiter.agi; shell is not one
    func agent_sid [] -> string
        if [ consoles ]
            for [ ci: ConsoleInstance, cname: string ] in consoles
                if [ ci.kind != 'shell' ] return cname
        return 'claude'

    func last_editor_pane [] -> i32
        return editor_slots.count - 1

    # the agent pane is derived: after all inline panes, when open
    func agent_pane [] -> i32
        return (agent_open) ? editor_slots.count : -1

    func ensure_console [ sid: string ] -> ConsoleSession
        if [ !sid || sid.count == 0 ] return null
        if [ !ed_sessions ] ed_sessions = map ConsoleSession [string] [ ]
        s : ConsoleSession ed_sessions[sid]
        if [ s ] return s
        s = ConsoleSession []
        s.name       = sid
        s.launch_cmd = agent_cmd[ sid ]
        ed_sessions[sid] = s
        s.start[]
        return s

    func feed_agent [ text: string ] -> none
        if [ !consoles ] return
        s : ConsoleSession ensure_console[ agent_sid[] ]
        if [ !s ] return
        s.send_esc[ '[200~' ]
        s.write_input[ text ]
        s.send_esc[ '[201~' ]

    # the supervised-app agent session (shell mode only)
    func orbit_session [] -> ConsoleSession
        if [ !orbit_sid || orbit_sid.count == 0 ] return null
        if [ !ed_sessions ] return null
        return ed_sessions[orbit_sid]

    public func orbit_relaunch []
        k : string 'SILVER_ISOLATE_RESTART'
        v : string '1'
        setenv[ k.chars, v.chars, 1 ]

    public func orbit_close []
        host_post[ 1, i32[ HM.close ], 0, 0, 0 ]

    func orbit_send [ body: string ]
        s6 : ConsoleSession orbit_session[]
        if [ !s6 ]
            puts 'orbit_send: NO session'
            return
        m6 : string body
        if [ !orbit_ctx_sent && orbit_ctx && orbit_ctx.count > 0 ]
            orbit_ctx_sent = true
            m6 = ((body && body.count > 0) ? '{orbit_ctx} {body}' : orbit_ctx)
        if [ !m6 || m6.count == 0 ] return
        ss : string ''
        se : getenv[ 'SILVER_ISOLATE_SESSION' ]
        if [ se ] ss = string [ se ]
        shot : path '/tmp/silver-app-{ss}.png'
        tree : path '/tmp/silver-app-{ss}.agi'
        if [ shot.exists[] ] m6 = 'app screenshot: {shot}  {m6}'
        if [ tree.exists[] ] m6 = 'element tree: {tree}  {m6}'
        s6.write_input[ '{m6}\r' ]
        orbit_enter_at = 120

    public func on_host [ mt: i32, wp: i32, lp: i32, xp: i32 ]
        if [ mt != 1 ] return
        s : i32 [ wp ]
        if [ s == orbit_dstate ] return
        puts 'orbiter on_host dictate: {orbit_dstate} -> {s}'
        orbit_dstate = s
        if [ s == 1 ]
            rc : dictation_start[]
            if [ rc == 0 ]
                orbit_cap_on = true
                host_live_set[ 1 ]
        el [ s == 2 ]
            dictation_cancel[]
            orbit_cap_on   = false
            orbit_flushing = false
            host_live_set[ 0 ]
        el
            if [ orbit_cap_on ]
                dictation_stop[]
                orbit_cap_on   = false
                orbit_flushing = true
            host_live_set[ 0 ]

    public func toggle_listen [ src: path ]
        if [ orbit_cap_on ]
            dictation_stop[]
            orbit_cap_on   = false
            orbit_flushing = true
        el
            rc : dictation_start[]
            if [ rc == 0 ]
                orbit_cap_on = true
                listen_file  = src
        puts 'orbiter: mic {orbit_cap_on} file {listen_file}'

    public func listening [] -> bool
        return orbit_cap_on

    func mic_frame []
        if [ orbit_cap_on ] dictation_poll[]
        if [ !orbit_flushing ] return
        if [ !dictation_flush[] ] return
        orbit_flushing = false
        dt : dictation_take[]
        if [ !dt || dt.count == 0 ] return
        puts 'orbiter: submitting take "{dt}"'
        bd : string dt
        if [ listen_file ] bd = '{listen_file}  {dt}'
        listen_file = null
        if [ orbit_app ]
            orbit_send[ 'user {orbit_oc} {bd} {orbit_cc}' ]
            return
        sa : ConsoleSession ensure_console[ orbit_sid ]
        if [ sa ] sa.write_input[ '{bd}\r' ]

    func orbit_frame [ w: Window ]
        if [ attach ]
            if [ orbit_app_pid == 0 ]
                orbit_app_pid = -1
                pe : getenv[ 'SILVER_ISOLATE_APP_PID' ]
                if [ pe ]
                    ps : string [ pe ]
                    orbit_app_pid = i32[ ps.integer_value[] ]
            if [ orbit_app_pid > 0 && host_pid_alive[ orbit_app_pid ] == 0 ] exit[ 0 ]
        # render every frame so the WndProc pump keeps running
        w.will_animate = true
        if [ !orbit_voice_tested ]
            orbit_voice_tested = true
            rcv : i32 [ tts_init[ '' ] ]
            puts 'voice-test: tts_init rc {rcv}'
            if [ rcv == 0 ]
                vt9 : string 'orbiter voice is working'
                tts_say[ vt9.chars, 8, 1.0 ]
        if [ !orbit_ctx ]
            sv : getenv[ 'SILVER' ]
            sroot : string ((sv) ? string [ sv ] : string '{startup_path}')
            vox : string 'every single reply must end with one line of the exact form speak {orbit_oc} one short spoken sentence {orbit_cc} — that line is synthesized aloud to the user; never omit it. the user speaks by voice and their words arrive wrapped user {orbit_oc} like this {orbit_cc}.'
            prm : string 'the app {orbit_app} runs under orbiter. its source is {sroot}/{orbit_app}/{orbit_app}.ag. when it crashes the report is typed here — investigate and help fix it.'
            if [ attach ]
                prm = 'the user switched to orbiter from the running app {orbit_app}. its source is {sroot}/{orbit_app}/{orbit_app}.ag — assist with the app live; if it faults, the crash report is typed here.'
            orbit_ctx = '{prm} {vox}'
            orbit_ctx.hold[]
        if [ !orbit_ctx_sent ]
            if [ orbit_hello_at == 0 ] orbit_hello_at = 240
            orbit_hello_at -= 1
            if [ orbit_hello_at == 1 ] orbit_send[ '' ]
        # the deferred submit Enter (see orbit_send)
        if [ orbit_enter_at > 0 ]
            orbit_enter_at -= 1
            if [ orbit_enter_at == 0 ]
                s7 : ConsoleSession orbit_session[]
                if [ s7 ] s7.write_input[ '\r' ]
        s2 : ConsoleSession orbit_session[]
        if [ s2 ]
            if [ !orbit_spoken ]
                orbit_spoken = vec string []
                orbit_spoken.hold[]
            mk : string 'speak {orbit_oc}'
            nl : i32 [ s2.line_count[] ]
            lo : i32 [ (nl > 60) ? nl - 60 : 0 ]
            for [ li: i32 lo, li < nl, li += 1 ]
                ln2 : string s2.line_get[ li ]
                if [ !ln2 || ln2.count == 0 ] continue
                a2 : i32 [ ln2.index_of[ mk ] ]
                if [ a2 < 0 ] continue
                st2  : i32 [ a2 + i32[ mk.count ] ]
                rest : string ln2.mid[ st2, ln2.count - st2 ]
                b2 : i32 [ rest.index_of[ orbit_cc ] ]
                if [ b2 <= 0 ] continue
                ut : string rest.mid[ 0, b2 ]
                if [ !ut || ut.count == 0 ] continue
                # the prompt's own example echoes on screen — never say it
                if [ ut == ' one short spoken sentence ' ] continue
                dup : bool [ false ]
                for [ sp2: string ] in orbit_spoken
                    if [ sp2 == ut ]
                        dup = true
                        break
                if [ dup ] continue
                orbit_spoken.push[ ut ]
                rc2 : i32 [ tts_init[ '' ] ]
                puts 'speak-scan: voicing "{ut}" (tts_init rc {rc2})'
                if [ rc2 == 0 ]
                    tts_say[ ut.chars, 8, 1.0 ]
        st : getenv[ 'SILVER_ISOLATE_STATUS' ]
        if [ st && !orbit_reported ]
            orbit_reported = true
            orbit_send[ 'the app crashed: {st} — investigate.' ]
            if [ tts_init[ '' ] == 0 ]
                sp : string 'the app crashed with {st}.'
                tts_say[ sp.chars, 8, 1.0 ]
        el [ !st ]
            orbit_reported = false

    func request_context [] -> none
        done : bool [ false ]
        ed : Editor pane_at[ active_pane ]
        if [ ed && ed.rview ] done = ed.rview.context_request*[]
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            if [ ! done ]
                ed2 : Editor pane_at[ i ]
                if [ ed2 && ed2.rview ] done = ed2.rview.context_request*[]

    func snap_window [ w: Window ] -> string
        if [ !w || !w.screen ] return null
        tex : Texture w.screen.color
        if [ !tex ] return null
        sz : i32 [ tex.width * tex.height * 4 ]
        b : Buffer [ vk: tex.vk, size: sz,
            u_dst: true, m_host_visible: true, m_host_coherent: true ]
        b.transfer[ tex ]
        shot : Image [ width: tex.width, height: tex.height, format: Pixel.rgba8 ]
        memcpy[ shot.vdata[], b.mmap[], sz ]
        b.unmap[]
        shot_n += 1
        fn : string '/tmp/orbiter_shot_{getpid[]}_{shot_n}.png'
        shot.png[ path fn ]
        return fn

    func run_node [ name: string ] -> none
        if [ !projects ] return
        p : Project projects[name]
        if [ !p ] return
        if [ p.deps ]
            for [ d: token ] in p.deps
                run_node[ d.chars ]
        if [ !p.build || p.build.count == 0 ] return
        cmd_str : string ''
        for [ c: token ] in p.build
            cmd_str = (cmd_str.count > 0) ? cmd_str + ' ' + c.chars : c.chars
        cmd : string 'cd "{p.root}" && {cmd_str}'
        s : ConsoleSession ensure_console[ name ]
        if [ !s ] return
        s.pending = cmd
        has_run : bool [ p.run && p.run.count > 0 ]
        if [ has_run ]
            start_debug[ name ]

    func start_debug [ name: string ] -> none
        p : Project (projects) ? projects[name] : null
        loc : path (p) ? p.product : null
        if [ !loc && p && p.run && p.run.count > 0 ]
            rb : string p.run[0].chars
            ps : string '{startup_path}/install/build/{rb}'
            loc = path [ ps.chars ]
        if [ !loc ]
            ps2 : string '{startup_path}/install/build/{name}'
            l2  : path [ ps2.chars ]
            if [ l2.exists[] ] loc = l2
        if [ !loc ]
            puts 'start_debug {name}: no binary to launch'
            return
        ensure_console[ name ]
        puts 'start_debug {name}: launching {loc}'
        if [ !debuggers ] debuggers = map dbg [string] []
        d : dbg [ location: loc, target: a, auto_start: false ]
        debuggers[name] = d
        sdir9 : '{startup_path}/{name}'
        sync_breakpoints[ d, sdir9 ]
        d.start[]

    # attach before the child's PR_SET_PTRACER fails under yama
    func proc_stopped [ pid: i32 ] -> bool
        ps : string '/proc/{pid}/stat'
        fp : fopen[ ps.chars, 'rb' ]
        if [ !fp ] return false
        b : local i8 [ 512 ]
        n : i32 [ i32[ fread[ @b[0], 1, 511, fp ] ] ]
        fclose[ fp ]
        if [ n < 4 ] return false
        i : i32 [ n - 1 ]
        while [ i > 0 && b[i] != 41 ]
            i -= 1
        if [ i + 2 >= n ] return false
        return b[i + 2] == 84

    # lldb attach loads the whole binary's symbols — seconds of work that used
    # to run inside update_all and hold the first paint. it goes to a worker;
    # only the debuggers publish stays on the main thread
    func attach_appview [ av: AppView, pid: i32 ]
        if [ av.attached ] return
        av.attached  = true
        av.attaching = true
        av.note      = 'attaching debugger'
        w8 : vec Au []
        w8.push[ av ]
        if [ !attach_tasks ] attach_tasks = vec async []
        attach_tasks.push[ async [ target: a, work_fn: lambda attach_work[ a ], work: w8 ] ]

    func attach_work [ arg: object :: o: orbiter ]
        av : AppView [ arg ]
        if [ !av ] return
        pid : i32 [ host_app_pid[ av.slot ] ]
        mod : string av.app_mod
        if [ !mod || mod.count == 0 || pid <= 0 ]
            av.attaching = false
            av.note      = ''
            return
        loc : path
        ps  : string '{o.startup_path}/install/build/{mod}'
        l   : path [ ps.chars ]
        if [ l.exists[] ] loc = l
        if [ !loc ]
            ps2 : string '{o.startup_path}/platform/native/build/{mod}'
            l2  : path [ ps2.chars ]
            if [ l2.exists[] ] loc = l2
        if [ !loc ]
            puts 'attach_appview: no binary for {mod}'
            av.attaching = false
            av.note      = ''
            return
        d : dbg [ location: loc, target: o, auto_start: false ]
        d.attach[ pid ]
        if [ !d.active ]
            kill[ pid, SIGCONT ]
            puts 'attach_appview: attach failed — {mod} pid={pid} continued undebugged'
            av.attaching = false
            av.note      = ''
            return
        adir9 : string [ '' ]
        if [ av.src ]
            ap9 : av.src.parent_dir[]
            if [ ap9 ] adir9 = '{ap9}'
        o.sync_breakpoints[ d, adir9 ]
        d.cont[]
        # clear the pre-init SIGSTOP group-stop; cont alone won't
        kill[ pid, SIGCONT ]
        puts 'attach_appview: attached {mod} pid={pid}'
        o.attach_mod     = mod
        o.attach_av      = av
        o.attach_pending = d

    # the worker never touches debuggers/active_target — the map is read by
    # the paint thread, so the finished debugger lands here instead
    # the app bar's slider is the truth; push it only when it moves
    func sync_volume []
        vs9 : find_volume[]
        if [ !vs9 ] return
        # the app answered its own gain: the slider takes it, once
        for [ pa9: i32 0, pa9 < editor_slots.count, pa9 += 1 ]
            ea9 : Editor pane_at[ pa9 ]
            if [ !ea9 || !ea9.run_view ] continue
            if [ ea9.run_view.app_vol < 0.0 ] continue
            vs9.value    = ea9.run_view.app_vol
            app_volume   = vs9.value
            app_vol_sent = app_volume
            vs9.pristine = false
            ea9.run_view.app_vol = -1.0
            return
        app_volume = vs9.value
        out9 : f32 [ (app_muted) ? 0.0 : app_volume ]
        if [ out9 == app_vol_sent ] return
        app_vol_sent = out9
        for [ pi9: i32 0, pi9 < editor_slots.count, pi9 += 1 ]
            ed9 : Editor pane_at[ pi9 ]
            if [ !ed9 || !ed9.run_view ] continue
            if [ !ed9.run_view.app_mod ] continue
            agent_sock_send[ ed9.run_view.app_mod.chars, 'volume {out9}\n' ]

    # the slider sits under EditorView > split > band > tools, not on Editor
    func find_volume [] -> VolumeSlider
        ve9 : element find_el[ a, 'volume' ]
        if [ !ve9 ] return null
        return VolumeSlider [ ve9 ]

    func attach_publish []
        if [ !attach_pending ] return
        if [ !debuggers ] debuggers = map dbg [string] []
        debuggers[ attach_mod ] = attach_pending
        active_target  = attach_mod
        if [ attach_av ]
            attach_av.attaching = false
            attach_av.note      = ''
        attach_pending = null
        attach_av      = null

    # mdir = the debugged module's own source directory. a breakpoint from
    # another module resolves to an unrelated address here and parks the
    # process forever (a hosted app then never pumps, resizes or paints)
    func sync_breakpoints [ d: dbg, mdir: string ]
        if [ !breakpoints || !d ] return
        for [ cond: string, key: string ] in breakpoints
            idx : i32 [ key.rindex_of[ ':' ] ]
            if [ idx <= 0 ] continue
            bsrc : string key.mid[ 0, idx ]
            blin : i32 [ key.mid[ idx + 1, key.count - idx - 1 ].real_value[] ]
            if [ blin <= 0 ] continue
            # an empty source (':1' in a stale state file) binds anywhere
            if [ !bsrc || bsrc.count == 0 ] continue
            if [ mdir && mdir.count > 0 ]
                bpath9 : path [ bsrc.chars ]
                bd9    : bpath9.parent_dir[]
                if [ !bd9 ] continue
                if [ '{bd9}' != mdir ] continue
            if [ !d.bps ] d.bps = vec breakpoint []
            bp9 : d.set_breakpoint[ path [ bsrc ], u32[ blin ], 0 ]
            if [ bp9 ] d.bps.push[ bp9 ]

    # attaching lldb parks the app in ptrace-stop: one frame, no input, no
    # resize. only debug a module the user actually set a breakpoint in
    func module_has_breakpoints [ mdir: string ] -> bool
        if [ !breakpoints || !mdir || mdir.count == 0 ] return false
        for [ cond: string, key: string ] in breakpoints
            idx : i32 [ key.rindex_of[ ':' ] ]
            if [ idx <= 0 ] continue
            bsrc : string key.mid[ 0, idx ]
            if [ !bsrc || bsrc.count == 0 ] continue
            bpp8 : path [ bsrc.chars ]
            bd8  : bpp8.parent_dir[]
            if [ bd8 && '{bd8}' == mdir ] return true
        return false

    func dbg_on_stdout [ buf: iobuffer ] -> Au
        return null
    func dbg_on_stderr [ buf: iobuffer ] -> Au
        return null
    func dbg_on_break [ cur: cursor ] -> Au
        if [ !cur ] return null
        puts 'dbg break {cur.source}:{cur.line}'
        apply_break[ cur ]
        return null

    func apply_break [ cur: cursor ]
        if [ !cur ] return
        src : path cur.source
        ln  : i32  [ cur.line ]
        # a stop in system code (glibc etc.) has no openable source
        if [ src && !src.exists[] ] src = null
        if [ src ]
            open_in_pane[ src, 0 ]
            ed : Editor pane_at[ 0 ]
            if [ ed ]
                # stop_line drives the white ">" arrow / current-line glow.
                sl : i32 [ (ln > 0) ? ln - 1 : 0 ]
                ed.stop_line = sl
                ed.stop_col  = i32[ cur.column ]
                lh  : f32 [ (ed.lh_cache > 0.0) ? ed.lh_cache : 22.0 ]
                vh  : f32 [ (ed.bounds) ? ed.bounds.h : 600.0 ]
                top : f32 [ f32[sl] * lh ]
                if [ top < ed.scroll.y || top + lh > ed.scroll.y + vh ]
                    ed.scroll.y = top - vh * 0.4
                    if [ ed.scroll.y < 0.0 ] ed.scroll.y = 0.0
                    ed.scroll_target = ed.scroll.y
                ed.pristine  = false
        dv : active_debugger[]
        # args and locals are disjoint in lldb; the func line needs the args.
        # locals go FIRST: base_var_at takes the first name that matches, and
        # 'a' (self) is an argument that would otherwise shadow every line
        if [ dv ]
            lc9 : dv.read_locals[]
            ag9 : dv.read_arguments[]
            all9 : vec Au []
            if [ lc9 ]
                for [ v9: variable ] in lc9
                    all9.push[ v9 ]
            if [ ag9 ]
                for [ v9: variable ] in ag9
                    all9.push[ v9 ]
            debug_vars = all9
        win : ux
        win.will_animate = true

    func clear_stop_lines []
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            ed : Editor pane_at[ i ]
            if [ ed ]
                ed.stop_line  = -1
                ed.stop_col   = -1
                ed.pristine   = false
        # no live frame anymore → drop the inspected variables.
        debug_vars = null
    func dbg_on_exit [ e: exited ] -> Au
        clear_stop_lines[]
        es : ConsoleSession (ed_sessions) ? ed_sessions[ active_target ] : null
        de : dbg (debuggers) ? debuggers[ active_target ] : null
        if [ es ]
            if [ de ]
                es.feed_fd[ de.fifo_fd_out ]
                es.feed_fd[ de.fifo_fd_err ]
            code : e->code
            es.print_text[ '\r\n[process exited, code {code}]\r\n' ]
            win : ux
            if [ win ] win.will_animate = true
        return null
    func dbg_on_crash [ cur: cursor ] -> Au
        if [ cur ] puts 'dbg crash {cur.source}:{cur.line}'
        if [ cur ] apply_break[ cur ]
        return null

    func file_slot [ p: path ] -> i32
        for [ i: i32 0, i < open_files.count, i += 1 ]
            if [ open_files[i] == p ] return i
        open_files.push[ p ]
        return open_files.count - 1

    # is this file pinned in the (unified) dock?
    func is_docked [ p: path ] -> bool
        if [ !p || !docked ] return false
        for [ i: i32 0, i < docked.count, i += 1 ]
            if [ docked[i] == p ] return true
        return false

    func toggle_dock [ p: path ]
        if [ !p ] return
        if [ !docked ] docked = vec path []
        found : bool false
        for [ i: i32 0, i < docked.count, i += 1 ]
            if [ docked[i] == p ]
                docked.remove[ i ]
                found = true
                break
        if [ !found ] docked.push[ p ]
        save_session[]
        run_search[]

    public func on_overlay [ cv: Canvas ]
        # run args are per source file, kept in the session state: the
        # field's edit is the one source, copied after the layer edited it
        if [ args_sync ]
            args_sync = false
            fs9 : file_state (args_editor) ? fstate[ args_editor.band_src[] ] : null
            if [ fs9 && args_field ]
                fs9.args = (args_field.edit) ? args_field.edit : ''
                fs9.args.hold[]
                save_session[]
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            ed : Editor pane_at[ i ]
            if [ !ed || !ed.run_view || !ed.app_view ] continue
            av : AppView ed.run_view
            if [ !av.have_frame || av.fade_us == 0 ] continue
            fal : f32 [ f32[ epoch_micros[] - av.fade_us ] / 400000.0 ]
            if [ fal >= 1.0 ] continue
            if [ fal < 0.0 ] fal = 0.0
            wx : f32 [ av.vx ]
            wy : f32 [ av.vy ]
            for [ p: element* ed, p, p = p.parent ]
                if [ p.bounds ]
                    wx += p.bounds.x
                    wy += p.bounds.y
            cv.set_opacity[ fal ]
            av.draw_frame[ cv, rect [ x: wx, y: wy, w: av.vw, h: av.vh ] ]
            cv.set_opacity[ 1.0 ]

    func stop_debug [ mod: string ]
        if [ !mod || !debuggers ] return
        d : dbg debuggers[ mod ]
        if [ !d ] return
        d.stop[]
        clear_stop_lines[]

    func active_debugger [] -> dbg
        if [ !debuggers ] return null
        d : dbg debuggers[ active_target ]
        return (d && d.active) ? d : null

    func title_nav [ p: path, grp: vec path, has_diff: bool, win: Window, dbg_locked: bool, dbg_open: bool, menu_open: bool, is_resource: bool, rv: ResourceView, fb_on: bool, tfoc: bool, pane_ix: i32 ] -> Elements
        hasfile  : bool [ p && p.exists[] ]
        els : Elements []
        browse_open : bool [ menu_open && nav_showing ]
        engaged : bool [ browse_open || fb_on || tfoc ]
        # no close chip — Escape closes the finder
        edp9 : Editor pane_at[ pane_ix ]
        # the chip closes a view the user PICKED. the file's own natural
        # view (text, or a byte view for a binary format) closes to nothing
        hx9  : bool [ edp9 && edp9.view_name && edp9.view_name.count > 0
                      && edp9.view_name != edp9.fallback_view_for[ edp9.src ] ]
        dc9  : bool [ edp9 && edp9.diff_commit && edp9.diff_commit.count > 0 ]
        if [ dc9 || hx9 ]
            els['panel_close'] = LButton [ icon: 'close', manual_mode: true ]
        # the left slot closes the finder — Esc's clickable twin, sized
        # exactly like the history arrows so the title never shifts
        if [ engaged && !is_resource ]
            ncls : vec string [] [ 'finder_close' ]
            nclo : vec string [] [ 'close' ]
            els['histnav'] = TButtons [ buttons: ncls, icon_ids: nclo, manual: true,
                disable_mask: 0,
                icon_scale: 0.585, rest_glow: rgba [ '#ccf2' ], rest_px: 16.0,
                area: Region [ 'l0+ t0 w1.8 h0.9' ] ]
        # editing only: cmd+left / cmd+right as clickable history arrows
        if [ !engaged && !is_resource ]
            nnav : vec string [] [ 'nav_back', 'nav_fwd' ]
            nico : vec string [] [ 'left', 'right' ]
            ndm : i32 [ 0 ]
            if [ !edp9 || !edp9.nav || !edp9.nav.can_back[] ]    ndm |= 1
            if [ !edp9 || !edp9.nav || !edp9.nav.can_forward[] ] ndm |= 2
            els['histnav'] = TButtons [ buttons: nnav, icon_ids: nico, manual: true,
                disable_mask: ndm,
                icon_scale: 0.45, rest_glow: rgba [ '#ccf2' ], rest_px: 16.0,
                area: Region [ 'l0+ t0 w1.8 h0.9' ] ]

        psess9 : string (agent_open && pane_ix == editor_slots.count) ? orbit_sid :
            ((pane_ix < pane_console.count) ? pane_console[pane_ix] : '')
        con9   : bool [ psess9 && psess9.count > 0 ]
        tnav : vec string []
        tmask : i32 [ 0 ]
        # find is reachable at all times, not just inside the nav
        if [ !is_resource ]
            # magnify lights while the findbar is open
            if [ fb_on ] tmask = 1
            tnav.push[ 'magnify' ]
        if [ editor_slots.count > 1 ] tnav.push[ 'undock' ]
        if [ editor_slots.count < 4 && !con9 ] tnav.push[ 'dock' ]
        if [ agent_pane[] < 0 && pane_ix == last_editor_pane[] ] tnav.push[ 'gear' ]
        wn9 : f32 [ f32[ tnav.count ] * 1.15 ]
        if [ tnav.count > 0 ]
            els['tabnav'] = TButtons [ buttons: tnav, manual: true, sel_mask: tmask,
                rest_glow: rgba [ '#ccf2' ], rest_px: 16.0,
                area: Region [ 'r0+ t0 w{wn9} h0.9' ] ]

        if [ menu_open && nav_showing && docked && docked.count > 0 ]
            els['pins'] = RButton [ icon: (show_pins) ? 'side_on' : 'side_off', selected: show_pins, manual_mode: true ]

        if [ rv ]
            vel : Elements rv.title_elements*[]
            if [ vel ]
                for [ ve: element, vk: string ] in vel
                    els[vk] = ve

        if [ fb_on ]
            # right-flow: first inserted lands furthest right
            els['replace'] = ReplaceField [ label: 'replace', edit: replace_text, focusable: true ]
            els['pattern'] = PatternField [
                label: 'files (i.e *.ag)',
                edit: pattern_text,
                focusable: true ]
            els['find'] = FindField [ label: 'Find', edit: findbar_text, focusable: true ]
        return els


    func dock_tabs [ grp: vec path, prefix: string, active: path, win: Window ] -> Elements
        els : Elements []
        for [ i: i32 0, i < grp.count, i += 1 ]
            p   : path   grp[i]
            tid : string '{prefix}{i}'
            els[tid] = Option [ label: p.filename[], selected: active && p == active ]
        return els

    func start_index []
        if [ index_building ]
            index_cancel = true
            index_dirty  = true
            return
        file_index   = list string []
        index_dirty  = false
        dirs : vec path []
        for [ d: path ] in search_dirs
            if [ d ] dirs.push[ d ]
        if [ dirs.count == 0 ] return
        index_cancel   = false
        index_building = true
        work : vec Au []
        work.push[ dirs ]
        index_task     = async [ target: a, work_fn: lambda index_work[ a ], work: work ]

    # a git repo indexes by ls-files: everything gitignored stays out
    func index_repo [ rp: path, cap: i32 ] -> bool
        ls : git_capture[ rp, 'ls-files --cached --others --exclude-standard', false ]
        index_lock.lock[]
        for [ i: i32 0, i < ls.count, i += 1 ]
            if [ index_cancel || file_index.count >= cap ] break
            file_index.push[ path '{rp}/{ls[i]}' ]
        over : bool [ file_index.count >= cap ]
        index_lock.unlock[]
        return over

    func index_work [ dirs: vec path :: o: orbiter ] -> none
        stack : vec path []
        repos : vec path []
        cap : i32 [ (o.max_search > 0) ? o.max_search : 400000 ]
        for [ r: path ] in dirs
            g0 : path '{r}/.git'
            if [ g0.exists[] ]
                o.index_repo[ r, cap ]
            el
                stack.push[ r ]
        while [ !o.index_cancel ]
            if [ stack.count == 0 ]
                # main tree exhausted → deferred repositories, by ls-files
                if [ repos.count == 0 ] break
                for [ rp: path ] in repos
                    if [ !o.index_cancel ] o.index_repo[ rp, cap ]
                repos = vec path []
                continue
            n : i32 [ stack.count - 1 ]
            d : path hold[ stack[n] ]
            stack.remove[ n ]
            entries : d.ls[ null, false ]
            drop[ d ]
            if [ entries ]
                found : vec path []
                for [ i: i32 0, i < entries.count, i += 1 ]
                    e : path entries[i]
                    if [ e.is_dir[] ]
                        dn : string e.filename[]
                        if [ dn == 'checkout' || dn == '.git' ]
                            continue
                        gp : path '{e}/.git'
                        if [ gp.exists[] ]
                            if [ o.search_external ]
                                repos.push[ e ]
                        el
                            stack.push[ e ]
                    el
                        found.push[ e ]
                if [ found.count > 0 ]
                    o.index_lock.lock[]
                    for [ f: path ] in found
                        o.file_index.push[ f ]
                    over : bool [ o.file_index.count >= cap ]
                    o.index_lock.unlock[]
                    if [ over ] break
        o.index_lock.lock[]
        o.index_building = false
        o.index_lock.unlock[]

    func start_watching []
        for [ d: path ] in search_dirs
            iw : watch [ res: d, callback: lambda on_index_change[ a ] ]
            iw.start[]
            index_watches += iw

    func reroot_index []
        r : path project_root[]
        if [ !r ] return
        # already rooted there → nothing to do
        if [ search_dirs && search_dirs.count == 1 ]
            s0 : string '{search_dirs[0]}'
            rs : string '{r}'
            if [ s0.compare[ rs ] == 0 ] return
        if [ index_watches ]
            for [ iw: watch ] in index_watches
                iw.pause[]
        index_watches = vec watch []
        search_dirs   = vec path []
        search_dirs  += r
        start_index[]
        start_watching[]
        if [ find_text && find_text.count > 0 ] index_research = true

    func on_index_change [ changed: Au :: o: orbiter ] -> none
        o.index_dirty = true

    public func on_unload [ ]
        save_session[]
        if [ debuggers ]
            for [ d: dbg, name: string ] in debuggers
                if [ d && d.active ] d.stop[]
            debuggers = null
        if [ index_watches ]
            for [ iw: watch ] in index_watches
                iw.pause[ ]
        index_cancel = true
        # the worker owns file_index until it exits — join before freeing
        while [ index_building ]
            usleep[ 1000 ]
        index_task   = null
        index_lock.lock[]
        file_index   = list string []
        index_lock.unlock[]
        find_results = list string []
        ed_sessions  = map ConsoleSession [string] [ ]
        super.on_unload[ ]

    func index_search [ query: string ] -> list string
        out : list string []
        if [ index_dirty && !index_building ]
            start_index[]
        # a search during the build re-runs once the index lands
        if [ index_building ] index_research = true
        tiers   : i32 [ 32 ]
        matches : vec string []
        dists   : vec i32 []
        if [ query && query.count > 0 ]
            ql : i32 [ query.count ]
            index_lock.lock[]
            for [ s: string ] in file_index
                ridx : i32 [ s.rindex_of[ query ] ]
                if [ ridx >= 0 ]
                    d : i32 [ s.count - (ridx + ql) ]
                    if [ d > tiers ] d = tiers
                    matches.push[ s ]
                    dists.push[ d ]
                    if [ matches.count >= 500 ] break
            index_lock.unlock[]
            for [ d: i32 0, d <= tiers, d += 1 ]
                for [ i: i32 0, i < matches.count, i += 1 ]
                    if [ dists[i] == d ]
                        out.push[ matches[i] ]
        return out

    # a file pattern IS the switch: set means search all files
    func find_in_file [] -> bool
        return !pattern_text || pattern_text.count == 0

    func run_find_in_files []
        find_hits = vec FindHit []
        q : string findbar_text
        find_last_query = q
        find_last_scope = (pattern_text) ? pattern_text : ''
        if [ !q || q.count == 0 ]
            find_showing = false
            return
        a_slot : i32 [ (active_pane >= 0 && active_pane < editor_slots.count) ? editor_slots[active_pane] : -1 ]
        p : path (a_slot >= 0 && a_slot < open_files.count) ? open_files[a_slot] : null
        scan_current : bool [ find_in_file[] && p ]
        if [ scan_current ]
            puts 'FIND bail: in-file mode, p={p}'
            find_showing = false
            return
        root : path project_root[]
        find_scanned = 0
        find_scan_mt = 0
        walk_find[ root, q ]
        puts 'FIND walk: root={root} scanned={find_scanned} hits={find_hits.count} sp={search_pane[]} fbpane={findbar_pane}'
        if [ find_hits.count == 0 ]
            find_hits.push[ FindHit [ is_header: true, text: 'No results in {find_scanned} files', dir: 'within {root}', file: null ] ]
            find_hits.push[ FindHit [ is_header: true, text: '', file: null ] ]
        find_showing = true
        sp : string search_pane[]
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            e : Editor pane_at[ i ]
            if [ e && sp == 'pane{i}' ]
                e.sel_line    = -1
                e.anchor_line = -1


    func str_replace_all [ s: string, find: string, rep: string ] -> string                                     
        fn : i32 [ find->count ]                                                                                
        if [ fn == 0 ] return s                                                                                 
        out : string [ '' ]                                                                                     
        i   : i32 [ 0 ]                                                                                         
        n   : i32 [ s->count ]                                                                                  
        while [ i < n ]                                                                                         
            rem : string s.mid[ i, n - i ]                                                                      
            rel : i32 [ rem.index_of[ find ] ]                                                                  
            if [ rel < 0 ]                                                                                      
                out = out + rem                                                                                 
                break                                                                                           
            out = out + rem.mid[ 0, rel ] + rep                                                                 
            i   = i + rel + fn                                                                                  
        return out                                                                                              
                                                                                                                
    # replace applies what is on screen — it never rescans                                                      
    func run_replace []                                                                                         
        q : string findbar_text                                                                                 
        if [ !q || q.count == 0 ] return                                                                        
        r : string [ (replace_text) ? replace_text : '' ]                                                       
        if [ find_in_file[] ]                                                                                   
            replace_in_pane[ q, r ]                                                                             
            return                                                                                              
        replace_in_hits[ q, r ]                                                                                 
                                                                                                                
    func replace_in_pane [ q: string, r: string ]                                                               
        sp : string search_pane[]                                                                               
        ed : Editor null                                                                                        
        for [ i: i32 0, i < editor_slots.count, i += 1 ]                                                        
            e : Editor pane_at[ i ]                                                                             
            if [ e && sp == 'pane{i}' ] ed = e                                                                  
        if [ !ed ] ed = pane_at[ active_pane ]                                                                  
        if [ !ed ] return                                                                                       
        n   : i32 [ ed.line_count[] ]                                                                           
        cnt : i32 [ 0 ]                                                                                         
        for [ li: i32 0, li < n, li += 1 ]                                                                      
            ln : string ed.line_get[ li ]                                                                       
            if [ !ln || ln.index_of[ q ] < 0 ] continue                                                         
            ed.ed_set[ li, str_replace_all[ ln, q, r ] ]                                                        
            cnt += 1                                                                                            
        puts 'REPLACE in-file: {cnt} lines'                                                                     
        ed.pristine = false                                                                                     
        if [ ux ] ux.will_animate = true                                                                        
                                                                                                                
    # walks the surviving hits only: struck-out rows never come back
    func replace_in_hits [ q: string, r: string ]
        if [ !find_hits || find_hits.count == 0 ] return
        seen  : vec string []
        files : i32 [ 0 ]
        cnt   : i32 [ 0 ]
        skip  : i32 [ 0 ]
        for [ i: i32 0, i < find_hits.count, i += 1 ]
            h : FindHit find_hits[i]
            if [ !h || h.is_header || !h.file ] continue
            key : string '{h.file}'
            dup : bool [ false ]
            for [ s: string ] in seen
                if [ s == key ] dup = true
            if [ dup ] continue
            seen.push[ key ]
            ftext : string [ h.file.load[ typeid[string], null ] ]
            if [ !ftext ] continue
            parts : ftext.split["\n"]
            hitn  : i32 [ 0 ]
            for [ j: i32 i, j < find_hits.count, j += 1 ]
                g : FindHit find_hits[j]
                if [ !g || g.is_header || !g.file ] continue
                gk  : string '{g.file}'
                if [ gk != key ] continue
                idx : i32 [ g.line - 1 ]                                                                        
                if [ idx < 0 || idx >= parts.count ]                                                            
                    skip += 1                                                                                   
                    continue                                                                                    
                # the scanned line must still be the file's line                                                
                if [ parts[idx] != g.text ]                                                                     
                    skip += 1                                                                                   
                    continue                                                                                    
                nl : str_replace_all[ parts[idx], q, r ]
                parts[idx] = nl
                g.text     = nl
                hitn += 1                                                                                       
            if [ hitn == 0 ] continue                                                                           
            out : string [ '' ]                                                                                 
            for [ j: i32 0, j < parts.count, j += 1 ]                                                           
                if [ j > 0 ] out = out + '\n'                                                                   
                out = out + parts[j]                                                                            
            fp : path '{key}'                                                                                   
            fp.save[ out, null ]
            # our own writes are not staleness — keep curation intact
            mt9 : fp.modified_time[]
            if [ mt9 > find_scan_mt ] find_scan_mt = mt9                                                                                
            files += 1                                                                                          
            cnt   += hitn                                                                                       
        puts 'REPLACE: {cnt} lines in {files} files, {skip} stale skipped'                                      
        if [ ux ] ux.will_animate = true 

    func next_match []
        sp : string search_pane[]
        ed : Editor null
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            e : Editor pane_at[ i ]
            if [ e && sp == 'pane{i}' ] ed = e
        if [ !ed ] ed = pane_at[ 0 ]
        if [ !ed || !find_hits || find_hits.count == 0 ] return
        q  : string findbar_text
        qn : i32 [ q->count ]
        if [ qn == 0 ] return
        n  : i32 [ find_hits.count ]
        cl : i32 [ ed.sel_line ]
        cc : i32 [ ed.sel_col ]
        if [ cl >= 0 && cl < n && !find_hits[ cl ].is_header ]
            ln : string find_hits[ cl ].text
            st : i32 [ cc + 1 ]
            if [ st < 0 ] st = 0
            if [ st <= ln.count - qn ]
                rem : string ln.mid[ st, ln.count - st ]
                rel : i32 [ rem.index_of[ q ] ]
                if [ rel >= 0 ]
                    reveal_match[ ed, cl, st + rel ]
                    return
        r : i32 [ cl ]
        for [ step: i32 0, step < n, step += 1 ]
            r = r + 1
            if [ r >= n ] r = 0
            h : FindHit find_hits[ r ]
            if [ h && !h.is_header ]
                ln  : string h.text
                rel : i32 [ ln.index_of[ q ] ]
                if [ rel >= 0 ]
                    reveal_match[ ed, r, rel ]
                    return

    func find_file_next []
        sp : string search_pane[]
        ed : Editor null
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            e : Editor pane_at[ i ]
            if [ e && sp == 'pane{i}' ] ed = e
        if [ !ed ] ed = pane_at[ active_pane ]
        if [ !ed ] return
        q : string findbar_text
        qn : i32 [ q->count ]
        if [ qn == 0 ] return
        n : i32 [ ed.line_count[] ]
        if [ n <= 0 ] return
        sr : i32 [ (ed.sel_line >= 0) ? ed.sel_line : 0 ]
        sc : i32 [ (ed.sel_col  >= 0) ? ed.sel_col  : -1 ]
        for [ step: i32 0, step <= n, step += 1 ]
            row   : i32 [ (sr + step) % n ]
            ln    : string ed.line_get[ row ]
            start : i32 [ (step == 0) ? (sc + 1) : 0 ]
            if [ start < 0 ] start = 0
            if [ start <= ln.count - qn ]
                rem : string ln.mid[ start, ln.count - start ]
                rel : i32 [ rem.index_of[ q ] ]
                if [ rel >= 0 ]
                    reveal_match[ ed, row, start + rel ]
                    return

    func reveal_match [ ed: Editor, row: i32, col: i32 ]
        ed.sel_line    = row
        ed.sel_col     = col
        ed.anchor_line = row
        ed.anchor_col  = col
        lh : f32 [ (ed.lh_cache > 0.0) ? ed.lh_cache : 22.0 ]
        vh : f32 [ (ed.bounds) ? ed.bounds.h : 600.0 ]
        top : f32 [ f32[ row ] * lh ]
        if [ top < ed.scroll.y || top + lh > ed.scroll.y + vh ]
            ed.scroll.y = top - vh * 0.4
            if [ ed.scroll.y < 0.0 ] ed.scroll.y = 0.0
            ed.scroll_target = ed.scroll.y
        if [ row >= 0 && row < ed.line_count[] ]
            ln  : string ed.line_get[ row ]
            cw  : f32 [ (ed.cw_cache > 0.0) ? ed.cw_cache : 8.0 ]
            qn  : i32 [ findbar_text->count ]
            mex : f32 [ f32[ ed.vis_col[ ln, col + qn ] ] * cw ]
            vw  : f32 [ ((ed.bounds) ? ed.bounds.w : 800.0) - ed.gutter_w ]
            pad : f32 [ cw * 4.0 ]
            if [ mex + pad > vw ]
                ed.scroll.x = mex + pad - vw
            el
                ed.scroll.x = 0.0
            if [ ed.scroll.x < 0.0 ] ed.scroll.x = 0.0
        ed.pristine = false
        win : ux
        if [ win ] win.will_animate = true

    func glob_at [ pat: string, pi0: i32, str: string, si0: i32 ] -> bool
        pi : i32 [ pi0 ]
        si : i32 [ si0 ]
        pn : i32 [ pat.count ]
        sn : i32 [ str.count ]
        while [ pi < pn ]
            pc : i32 [ pat[ pi ] ]
            if [ pc == 42 ]                              # '*'
                if [ pi + 1 < pn && pat[ pi + 1 ] == 42 ]   # '**' — cross '/'
                    np : i32 [ pi + 2 ]
                    if [ np < pn && pat[ np ] == 47 ] np = np + 1
                    for [ k: i32 si, k <= sn, k += 1 ]
                        if [ glob_at[ pat, np, str, k ] ] return true
                    return false
                el                                          # single '*' — stop at '/'
                    np : i32 [ pi + 1 ]
                    for [ k: i32 si, k <= sn, k += 1 ]
                        if [ glob_at[ pat, np, str, k ] ] return true
                        if [ k < sn && str[ k ] == 47 ] return false
                    return false
            el [ pc == 63 ]                             # '?'
                if [ si >= sn || str[ si ] == 47 ] return false
                pi = pi + 1
                si = si + 1
            el
                if [ si >= sn || str[ si ] != pc ] return false
                pi = pi + 1
                si = si + 1
        return si >= sn

    func glob_match [ pat: string, str: string ] -> bool
        return glob_at[ pat, 0, str, 0 ]

    func glob_pass [ e: path ] -> bool
        if [ !pattern_text || pattern_text.count == 0 ] return true
        if [ pattern_text.index_of[ '/' ] < 0 ]
            return glob_match[ pattern_text, e.filename[] ]
        es : string '{e}'
        sp : string '{startup_path}'
        if [ sp.count > 0 && es.index_of[ sp ] == 0 ]
            es = es.mid[ sp.count, es.count - sp.count ]
            if [ es.count > 0 && es[0] == '/' ] es = es.mid[ 1, es.count - 1 ]
        return glob_match[ pattern_text, es ]

    func walk_find [ dir: path, q: string ]
        entries : dir.ls[ null, false ]
        if [ !entries ] return
        for [ i: i32 0, i < entries.count, i += 1 ]
            e : path entries[i]
            if [ e.is_dir[] ]
                dn : string e.filename[]
                if [ dn == 'checkout' || dn == '.git' ] continue
                walk_find[ e, q ]
            el [ glob_pass[ e ] ]
                find_scanned += 1
                mt : e.modified_time[]
                if [ mt > find_scan_mt ] find_scan_mt = mt
                scan_file_hits[ e, q ]

    # newest mtime in scope: newer than the scan = results stale
    func tree_mtime [ dir: path ] -> i64
        r : i64 [ 0 ]
        entries : dir.ls[ null, false ]
        if [ !entries ] return r
        for [ i: i32 0, i < entries.count, i += 1 ]
            e : path entries[i]
            if [ e.is_dir[] ]
                dn : string e.filename[]
                if [ dn == 'checkout' || dn == '.git' ] continue
                mt : tree_mtime[ e ]
                if [ mt > r ] r = mt
            el [ glob_pass[ e ] ]
                mt : e.modified_time[]
                if [ mt > r ] r = mt
        return r

    func scan_file_hits [ p: path, q: string ]
        if [ !p || !p.exists[] ] return
        content : string [ p.load[ typeid[string], null ] ]
        if [ !content ] return
        parts : content.split["\n"]
        header_added : bool [ false ]
        for [ i: i32 0, i < parts.count, i += 1 ]
            ln : string parts[i]
            if [ ln.index_of[ q ] >= 0 ]
                if [ !header_added ]
                    if [ find_hits.count > 0 ]
                        find_hits.push[ FindHit [ is_header: true, is_spacer: true, text: '' ] ]
                    fn  : string p.filename[]
                    drs : string '{p.directory[]}'
                    sp  : string '{startup_path}'
                    if [ sp.count > 0 && drs.index_of[ sp ] == 0 ]
                        drs = drs.mid[ sp.count, drs.count - sp.count ]
                        if [ drs.count > 0 && drs[0] == '/' ] drs = drs.mid[ 1, drs.count - 1 ]
                    find_hits.push[ FindHit [ is_header: true, text: fn, dir: drs, file: p ] ]
                    find_hits.push[ FindHit [ is_header: true, text: '', file: p ] ]
                    header_added = true
                find_hits.push[ FindHit [ is_header: false, text: ln, file: p, line: i + 1 ] ]

    func search_pane [] -> string
        win : ux
        if [ win && win.focus && win.focus.id == 'title' ]
            for [ e: element* win.focus, e, e = e.parent ]
                if [ e inherits EditorView ] return e.id
        # a focused nav surface owns the search — NEVER pane0 fallback,
        # which flashed the surface onto the other pane for a frame
        if [ win && win.focus && win.focus inherits CommitView ]
            for [ e: element* win.focus, e, e = e.parent ]
                if [ e inherits EditorView ] return e.id
        # an open findbar owns the search — results land in ITS pane
        if [ findbar_open && findbar_pane && findbar_pane.count > 0 ]
            return findbar_pane
        return 'pane{active_pane}'

    # modules register rail views in install/export/*.agi:
    # views: ['name': ascii|binary|agnostic] — FileType applicability
    func ensure_views []
        if [ view_tools ] return
        view_tools     = vec string []
        view_tools_bin = vec string []
        view_mods      = map string [string] []
        asc9a : vec string []
        bin9a : vec string []
        any9a : vec string []
        root : path.path_startup[]
        if [ root ]
            d : path '{root}/install/export'
            entries : d.ls[ null, false ]
            if [ entries ]
                for [ e: path ] in entries
                    ax : e.ext[]
                    if [ !ax || !(ax == 'agi') ] continue
                    mod   : string e.stem[]
                    ftext : string e.load[ typeid[string], null ]
                    if [ !ftext ] continue
                    n2  : i32 [ i32[ ftext.count ] ]
                    ls9 : i32 [ 0 ]
                    for [ i: i32 0, i <= n2, i += 1 ]
                        c : i32 [ (i < n2) ? ((i32 ftext.chars[i]) & 255) : 10 ]
                        if [ c != 10 ] continue
                        line : string ftext.mid[ ls9, i - ls9 ]
                        ls9 = i + 1
                        if [ !(line.index_of[ 'views:' ] == 0) ] continue
                        ln2 : i32 [ i32[ line.count ] ]
                        j   : i32 [ 0 ]
                        while [ j < ln2 ]
                            cq : i32 [ (i32 line.chars[j]) & 255 ]
                            if [ cq != 39 ]
                                j += 1
                                continue
                            k : i32 [ j + 1 ]
                            while [ k < ln2 && ((i32 line.chars[k]) & 255) != 39 ] k += 1
                            nm9 : string line.mid[ j + 1, k - j - 1 ]
                            j = k + 1
                            # optional ': member' up to the , or ] delimiter
                            mem9 : string ''
                            while [ j < ln2 ]
                                cm : i32 [ (i32 line.chars[j]) & 255 ]
                                if [ cm == 44 || cm == 93 || cm == 39 ] break
                                if [ (cm >= 97 && cm <= 122) || (cm >= 65 && cm <= 90) ]
                                    ks : i32 [ j ]
                                    while [ j < ln2 ]
                                        c2 : i32 [ (i32 line.chars[j]) & 255 ]
                                        if [ !((c2 >= 97 && c2 <= 122) || (c2 >= 65 && c2 <= 90)) ] break
                                        j += 1
                                    mem9 = line.mid[ ks, j - ks ]
                                    continue
                                j += 1
                            if [ nm9.count > 0 ]
                                if [ mem9 == 'ascii' ]       asc9a.push[ nm9 ]
                                el [ mem9 == 'binary' ]      bin9a.push[ nm9 ]
                                el                           any9a.push[ nm9 ]
                                view_mods[ nm9 ] = mod
        for [ s: string ] in asc9a
            view_tools.push[ s ]
        for [ s: string ] in bin9a
            view_tools_bin.push[ s ]
        for [ s: string ] in any9a
            view_tools.push[ s ]
            view_tools_bin.push[ s ]

    func apply_pane [ ed: Editor, is_search: bool, slot: i32 ]
        if [ !ed ] return
        # browse AND find live in CommitView: the pane is never displaced
        was_search : bool [ ed.finder_list ]
        ed.finder_list = false
        # code views only fit ascii files; binaries get b16 alone
        ed.nav_tools   = null
        ed.nav_default = null
        if [ is_search && ed.src ]
            bin9 : bool [ ed.file_is_binary[ ed.src ] ]
            ed.nav_default = ed.default_view_for[ ed.src ]
            ed.nav_tools   = (bin9) ? view_tools_bin : view_tools
            # an ascii file whose default is a handler (markdown) still
            # edits as text: the plain editor leads the rail after it
            if [ !bin9 && ed.handler_module_for[ ed.src ] ]
                t9 : vec string []
                t9.push[ 'text' ]
                for [ s: string ] in view_tools
                    t9.push[ s ]
                ed.nav_tools = t9
        if [ slot >= 0 && slot < open_files.count ]
            # reload ONLY on real change: a blanket load_file remounts
            # every pane's view and flashes the ones not involved
            np : path open_files[slot]
            same : bool [ ed.src && '{ed.src}' == '{np}' ]
            if [ was_search || !same ]
                ed.src = np
                ed.load_file[]
                if [ was_search ]
                    ed.scroll.y      = ed.saved_scroll
                    ed.scroll_target = ed.saved_scroll
                ed.pristine = false
        el
            if [ ed.lines && ed.lines.count > 0 ]
                ed.lines = list string []
                ed.pristine = false

    func pane_view [ i: i32 ] -> element
        spl : element (elements) ? elements[ 'panes' ] : null
        if [ !spl || !spl.elements ] return null
        return spl.elements[ 'pane{i}' ]

    func title_at [ i: i32 ] -> element
        pv : element pane_view[ i ]
        if [ !pv || !pv.elements ] return null
        return pv.elements[ 'title' ]

    # scene classes modules register in install/export/*.agi
    func ensure_scenes []
        if [ scene_names ] return
        scene_names = vec string []
        scene_mods  = map string [string] []
        # first entry is always 'none' -- with no scenes exported the
        # selector drew an empty label, which reads as a broken widget
        scene_names.push[ string 'none' ]
        root : path.path_startup[]
        if [ !root ] return
        d : path '{root}/install/export'
        entries : d.ls[ null, false ]
        if [ !entries ] return
        for [ e: path ] in entries
            ax : e.ext[]
            if [ !ax || !(ax == 'agi') ] continue
            ftext : string e.load[ typeid[string], null ]
            if [ !ftext ] continue
            n2  : i32 [ i32[ ftext.count ] ]
            ls9 : i32 [ 0 ]
            for [ i: i32 0, i <= n2, i += 1 ]
                c : i32 [ (i < n2) ? ((i32 ftext.chars[i]) & 255) : 10 ]
                if [ c != 10 ] continue
                line : string ftext.mid[ ls9, i - ls9 ]
                ls9 = i + 1
                if [ !(line.index_of[ 'scenes:' ] == 0) ] continue
                ln2 : i32 [ i32[ line.count ] ]
                j   : i32 [ 0 ]
                while [ j < ln2 ]
                    cq : i32 [ (i32 line.chars[j]) & 255 ]
                    if [ cq != 39 ]
                        j += 1
                        continue
                    k : i32 [ j + 1 ]
                    while [ k < ln2 && ((i32 line.chars[k]) & 255) != 39 ] k += 1
                    nm9 : string line.mid[ j + 1, k - j - 1 ]
                    j = k + 1
                    if [ nm9.count > 0 ]
                        scene_names.push[ nm9 ]
                        scene_mods[ nm9 ] = e.stem[]

    # backdrop scenes the bottom bar steps through
    func scene_list [] -> vec string
        ensure_scenes[]
        return scene_names

    func scene_name [] -> string
        sl : scene_list[]
        if [ sl.count == 0 ] return ''
        ix : i32 [ scene_ix % sl.count ]
        if [ ix < 0 ] ix = 0
        return sl[ ix ]

    # scenes compile separately; load the lib only if it is available
    func scene_module_ensure [ nm: string ]
        mod : string (scene_mods) ? scene_mods[ nm ] : null
        if [ !mod || mod.count == 0 ] return
        if [ !startup_path ] startup_path = path.path_startup[]
        lib : path '{startup_path}/install/build/lib{mod}.so'
        if [ !lib.exists[] ] return
        # module init registers its types
        h : dlopen[ lib.chars, 258 ]
        if [ !h ] puts 'scenes: dlopen failed for {lib}'

    # built once per scene: new_object is pool-managed, so hold it
    func scene_element [] -> element
        nm : scene_loaded[]
        if [ !nm || nm.count == 0 ] return null
        if [ scene_el && scene_el_nm && scene_el_nm.compare[ nm ] == 0 ] return scene_el
        st : Au.find_type[ nm.chars, null ]
        if [ !st ]
            scene_module_ensure[ nm ]
            st = Au.find_type[ nm.chars, null ]
        if [ !st ]
            puts 'scene: no class for {nm}'
            return null
        # unmount does not call on_unload: unregister the outgoing target
        if [ scene_el && scene_el.id && ux && ux.element_targets ]
            ux.element_targets.rm[ scene_el.id ]
        e : element [ Au.new_object[ st, null, null, true,
            __FILE__, __LINE__, __SEQUENCE__ ] ]
        if [ !e ] return null
        e.hold[]
        e.area = Region [ 'l0 t0 r0 b0' ]
        scene_el    = e
        scene_el_nm = string [ nm ]
        scene_el_nm.hold[]
        puts 'scene: built {nm}'
        # the scene retints the ui; null theme restores the authored values
        if [ ux && ux.st ]
            ux.st.set_theme[ e.theme*[] ]
            # the solid stage paints the theme's editor background
            ux.solid_color = ux.st.theme_color[ '#140a2acc' ]
            ux.restyle = true
        return e

    # the mounted scene; the label click sets it from the browsed one
    func scene_loaded [] -> string
        if [ !show_scene ] return ''
        # 'none' is a real selection, not a scene: nothing mounts for it
        if [ scene_load && scene_load.count > 0 && scene_load.compare[ 'none' ] != 0 ]
            return scene_load
        return ''

    func scene_step [ d: i32 ]
        sl : scene_list[]
        if [ sl.count == 0 ] return
        scene_ix = (scene_ix + d + sl.count) % sl.count

    # vantage; each scene maps it to its own distance
    func orbit_list [] -> vec string
        return vec string [] [ 'low-orbit', 'high-orbit', 'far-orbit', 'wide-orbit' ]

    func orbit_name [] -> string
        ol : orbit_list[]
        return ol[ orbit_ix % ol.count ]

    func orbit_step [ d: i32 ]
        ol : orbit_list[]
        orbit_ix = (orbit_ix + d + ol.count) % ol.count
        # the list's own length, never a literal: a fourth vantage that
        # wraps back to the first is a silently missing camera
        if [ ux ] ux.orbit_mode = orbit_ix % ol.count

    # camera angle; each scene maps it to pitch or to aim tilt
    func angle_list [] -> vec string
        return vec string [] [ 'angled', 'flat-on', 'steep' ]

    func angle_name [] -> string
        al : angle_list[]
        return al[ angle_ix % al.count ]

    # the list is ordered for the UI; this maps it to ViewAngle
    func angle_value [] -> i32
        ix : i32 [ angle_ix % 3 ]
        return (ix == 0) ? 1 : (ix == 1) ? 0 : 2

    func angle_step [ d: i32 ]
        al : angle_list[]
        angle_ix = (angle_ix + d + al.count) % al.count
        if [ ux ] ux.angle_mode = angle_value[]

    # backdrop speed: frame skipping and the time step together.
    # subtle is FIRST so the zero default lands on it
    func speed_list [] -> vec string
        return vec string [] [ 'subtle', 'slow', 'medium', 'fast', 'ludacrous' ]

    func speed_name [] -> string
        sl : speed_list[]
        return sl[ speed_ix % sl.count ]

    func speed_step [ d: i32 ]
        sl : speed_list[]
        speed_ix = (speed_ix + d + sl.count) % sl.count
        speed_apply[]

    # DRAWS PER SECOND, not a frame count. the panel can be 160hz, so
    # 1-in-4 is not a rate -- it is whatever the panel happens to run
    func speed_apply []
        if [ !ux ] return
        # the orbit_moving exemption lives in animate[] now, per frame.
        # returning early here left background_hz stuck at 0 whenever a
        # speed was picked mid-glide
        ix : i32 [ speed_ix % 5 ]
        switch [ ix ]
            case 1
                ux.background_hz = 16.0
                ux.time_scale    = 1.0 / 16.0
            case 2
                ux.background_hz = 30.0
                ux.time_scale    = 1.0 / 2.0
            case 3
                ux.background_hz = 60.0
                ux.time_scale    = 4.0
            case 4
                ux.background_hz = 60.0
                ux.time_scale    = 16.0
            default
                ux.background_hz = 4.0
                ux.time_scale    = 1.0 / 64.0

    # depth-first id lookup; the tree nests once sides land
    func find_el [ e: element, id: string ] -> element
        if [ !e || !e.elements || !id ] return null
        d : element e.elements[ id ]
        if [ d ] return d
        for [ ce: element, ck: string ] in e.elements
            r : element find_el[ ce, id ]
            if [ r ] return r
        return null

    # extent < 0 means the user dragged this pane shut
    func take_closed [ id: string ] -> bool
        e : element find_el[ a, id ]
        if [ !e || e.extent >= 0.0 ] return false
        e.extent = 0.0
        return true

    func close_pane [ pi: i32 ]
        if [ agent_open && pi == editor_slots.count ]
            agent_open = false
            ae9 : element find_el[ a, 'pane{pi}' ]
            if [ ae9 ]
                ae9.extent       = 0.0
                ae9.extent_shown = 0.0
            if [ active_pane >= editor_slots.count ] active_pane = editor_slots.count - 1
            save_session[]
            return
        if [ editor_slots.count <= 1 || pi < 0 || pi >= editor_slots.count ] return
        pe : Editor pane_at[ pi ]
        if [ pe && pe.run_view ] pe.toggle_app_run[ false ]
        if [ pe && pe.rview ]
            pe.rview.release*[]
            pe.rview = null
        editor_slots.remove[ pi ]
        if [ pi < pane_console.count ] pane_console.remove[ pi ]
        # ids re-key by index next frame: extents follow their content
        for [ qj: i32 pi + 1, qj <= editor_slots.count, qj += 1 ]
            src9 : element find_el[ a, 'pane{qj}' ]
            dst9 : element find_el[ a, 'pane{qj - 1}' ]
            if [ src9 && dst9 ]
                dst9.extent       = src9.extent
                dst9.extent_shown = src9.extent_shown
        if [ active_pane >= editor_slots.count ] active_pane = editor_slots.count - 1
        save_session[]

    # the Editor of the pane an element lives in
    func pane_of [ e: element ] -> Editor
        for [ e9: element* e, e9, e9 = e9.parent ]
            if [ e9 inherits EditorView ]
                ev9 : EditorView e9
                return pane_at[ ev9.pane_index ]
        return null

    func pane_at [ i: i32 ] -> Editor
        pv : element pane_view[ i ]
        if [ !pv || !pv.elements ] return null
        return editor_under[ pv.elements[ 'split' ] ]

    func push_file_hit [ p: path, show_dir: bool ]
        fn  : string p.filename[]
        drs : string ''
        if [ show_dir ]
            drs = '{p.directory[]}'
        find_hits.push[ FindHit [ is_header: true, text: fn, dir: drs, file: p ] ]
        if [ !browse_single ]
            find_hits.push[ FindHit [ is_header: true, text: '', file: p ] ]

    func project_root [] -> path
        if [ !startup_path ] startup_path = path.path_startup[]
        return path '{startup_path}'

    # the rail draws every frame: this only reads the finished snapshot
    func file_changes [ p: path ] -> FileChg
        if [ !p || !git_snap || !git_snap.chg ] return null
        return git_snap.chg[ '{p.absolute[]}' ]

    # thread body: every git call lives here, never on the view
    func git_entry [] -> none
        base : path [ (nav_root) ? nav_root : project_root[] ]
        sn : GitSnap []
        sn.hold[]
        sn.base = '{base}'
        rl : git_capture[ base, 'rev-parse --show-toplevel', false ]
        if [ rl.count > 0 ]
            sn.repo  = rl[0]
            rp : path '{sn.repo}'
            ch : repo_changed[ rp ]
            # closest to the repo root first: fewest separators
            srt : vec string []
            for [ i: i32 0, i < ch.count, i += 1 ]
                d9  : i32 [ path_depth[ ch[i] ] ]
                at9 : i32 [ srt.count ]
                for [ j: i32 0, j < srt.count, j += 1 ]
                    dj : i32 [ path_depth[ srt[j] ] ]
                    if [ d9 < dj || (d9 == dj && ch[i].compare[ srt[j] ] < 0) ]
                        at9 = j
                        break
                srt.insert[ ch[i], at9 ]
            sn.files = srt
            ins9 : i32 [ 0 ]
            del9 : i32 [ 0 ]
            ss9 : git_capture[ rp, 'diff --shortstat HEAD', false ]
            if [ ss9.count > 0 ]
                pr9 : ss9[0].split[ ',' ]
                for [ i: i32 0, i < pr9.count, i += 1 ]
                    p9 : string pr9[i].trim[]
                    if [ p9.index_of[ 'insertion' ] >= 0 ] ins9 = i32[ p9.real_value[] ]
                    el [ p9.index_of[ 'deletion' ] >= 0 ] del9 = i32[ p9.real_value[] ]
            sn.adds = ins9
            sn.dels = del9
            sn.chg = map FileChg [string] []
            if [ open_files ]
                for [ i: i32 0, i < open_files.count, i += 1 ]
                    p : path open_files[i]
                    if [ !p ] continue
                    k : string '{p.absolute[]}'
                    ns : git_capture[ rp, 'diff --numstat HEAD -- {k}', false ]
                    if [ ns.count == 0 ] continue
                    f9 : ns[0].split[ '\t' ]
                    if [ f9.count < 2 ] continue
                    sn.chg[ k ] = FileChg [ adds: i32[ f9[0].real_value[] ], dels: i32[ f9[1].real_value[] ] ]
        git_stage = sn
        git_fresh = true
        git_busy  = false

    func git_summarize []
        if [ git_busy ] return
        git_busy  = true
        git_dirty = false
        git_last  = Au.epoch_millis[]
        tid : local u64 [ 1 ]
        pthread_create[ tid, null, @git_entry, a ]

    func path_depth [ s: string ] -> i32
        n9 : i32 [ 0 ]
        for [ i: i32 0, i < s.count, i += 1 ]
            if [ s.chars[i] == 47 ] n9 += 1
        return n9

    # the browsed folder's home repo — arbitrary per location
    func repo_root [] -> path
        base : path [ (nav_root) ? nav_root : project_root[] ]
        rl : git_capture[ base, 'rev-parse --show-toplevel', false ]
        if [ rl.count == 0 ] return null
        return path rl[0]

    # fixed 144px tabs on a 150px stride, 12px insets
    func commit_cap [ w: f32 ] -> i32
        c : i32 [ i32[ (w - 24.0) / 150.0 ] ]
        return (c < 1) ? 1 : c

    # reveal belongs to the asking view: never app state
    func commit_tab_rows [ w: f32, reveal: bool ] -> i32
        if [ !git_snap || !git_snap.files || git_snap.files.count == 0 ] return 0
        c : i32 [ commit_cap[ w ] ]
        r : i32 [ (git_snap.files.count + c - 1) / c ]
        if [ !reveal && r > 3 ] r = 3
        return r

    # stage everything and commit; the message comes from the view
    func do_commit [ cmsg: string ]
        r9 : path repo_root[]
        if [ !r9 || !cmsg || cmsg.count == 0 ] return
        # the message rides a shell line: escape for double quotes
        esc : string ''
        for [ i: i32 0, i < cmsg.count, i += 1 ]
            c9 : i32 [ cmsg.chars[ i ] ]
            if [ c9 == 34 || c9 == 92 || c9 == 36 || c9 == 96 ] esc = esc + '\\'
            esc = esc + cmsg.mid[ i, 1 ]
        git_capture[ r9, 'add -A', false ]
        git_capture[ r9, 'commit -m "{esc}"', false ]
        git_summarize[]
        if [ ux ] ux.restyle = true

    # changed files in the browsed repo, paths relative to its root
    func repo_changed [ repo: path ] -> vec string
        out : vec string []
        st : git_capture[ repo, 'status --porcelain', false ]
        for [ i: i32 0, i < st.count, i += 1 ]
            ln9 : string st[i]
            sx  : i32 [ ln9.index_of[ ' ' ] ]
            if [ sx < 0 ] continue
            fp9 : string ln9.mid[ sx + 1, ln9.count - sx - 1 ].trim[]
            ax  : i32 [ fp9.index_of[ ' -> ' ] ]
            if [ ax >= 0 ] fp9 = fp9.mid[ ax + 4, fp9.count - ax - 4 ]
            # untracked directories list as 'dir/': keep the dir name
            if [ fp9.count > 0 && fp9.chars[ fp9.count - 1 ] == 47 ] fp9 = fp9.mid[ 0, fp9.count - 1 ]
            if [ fp9.count > 0 ] out += fp9
        return out

    func push_dir_hit [ p: path, label: string ]
        m9 : path '{p}/{p.filename[]}.ag'
        ism : bool [ m9.exists[] ]
        find_hits.push[ FindHit [ is_header: true, is_dir: true, is_module: ism, text: label, dir: '', file: p ] ]
        if [ !browse_single ]
            find_hits.push[ FindHit [ is_header: true, is_dir: true, is_module: ism, text: '', file: p ] ]

    # arrowing into the list moves focus off the title; the menu stays.
    # the commit form's focus keeps it open the same way
    func list_focused [] -> bool
        win : ux
        if [ !win || !win.focus ] return false
        if [ win.focus inherits CommitView ] return true
        if [ !(win.focus inherits Editor) ] return false
        ed9 : Editor win.focus
        return ed9.show_hits || ed9.finder_list

    func run_search []
        win : ux
        ensure_views[]
        sp     : string search_pane[]
        title_focus : bool [ (win && win.focus && win.focus.id == 'title') ? true : false ]
        if [ title_focus || (find_text && find_text.count > 0) ] finder_off = false
        active : bool [ !finder_off && (title_focus || (find_text && find_text.count > 0) || list_focused[]) ]
        if [ active ]
            combined : list string []
            find_hits = vec FindHit []
            nav_dock_rows = 0
            if [ find_text && find_text.count > 0 ]
                matches : list string [ index_search[ find_text ] ]
                for [ i: i32 0, i < matches.count, i += 1 ]
                    p : path '{matches.value_by_index[ i ]}'
                    push_file_hit[ p, true ]
                    combined.push[ '{p}' ]
                if [ matches.count == 0 ]
                    find_hits.push[ FindHit [ is_header: true, text: 'no results for {find_text}', dir: '', file: null ] ]
            el
                # the commit surface is its own element (CommitView); the
                # list only keeps the snapshot fresh for it
                nb : string [ (nav_root) ? '{nav_root}' : '{project_root[]}' ]
                if [ !git_busy && (!git_snap || git_snap.base.compare[ nb ] != 0) ] git_summarize[]
                # consoles are not files and do not belong in this list
                if [ docked && show_pins ]
                    d0 : i32 [ find_hits.count ]
                    for [ i: i32 0, i < docked.count, i += 1 ]
                        dp : path docked[i]
                        if [ dp ]
                            push_file_hit[ dp, true ]
                            combined.push[ '{dp}' ]
                    # an empty pin section owns no divider and no spacer
                    if [ find_hits.count > d0 ]
                        nav_dock_rows = find_hits.count
                        if [ browse_single ]
                            find_hits.push[ FindHit [ is_header: true, is_spacer: true, text: '' ] ]
                if [ !nav_root ] nav_root = target_roots[0]
                if [ nav_root ]
                    pr  : path   project_root[]
                    nrs : string '{nav_root}'
                    prs : string '{pr}'
                    if [ pr && nrs.compare[ prs ] != 0 ]
                        up : path nav_root.directory[]
                        if [ up ]
                            push_dir_hit[ up, '..' ]
                            combined.push[ '{up}' ]
                    entries : nav_root.ls[ null, false ]
                    if [ entries ]
                        for [ i: i32 0, i < entries.count, i += 1 ]
                            e : path entries[i]
                            if [ e.is_dir[] ]
                                dn : string e.filename[]
                                if [ dn == '.git' || dn == 'checkout' ] continue
                                push_dir_hit[ e, e.filename[] ]
                                combined.push[ '{e}' ]
                        for [ i: i32 0, i < entries.count, i += 1 ]
                            e : path entries[i]
                            if [ !e.is_dir[] ]
                                push_file_hit[ e, grid_mode ]
                                combined.push[ '{e}' ]
                    # bottom of the results: a break, then the create buttons
                    find_hits.push[ FindHit [ is_header: true, is_spacer: true, text: '' ] ]
                    find_hits.push[ FindHit [ is_header: true, is_newfile: true, text: 'new file' ] ]
            find_results = combined
        # empty results keep the view up: it says so instead of vanishing
        nav_showing = active
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            pid : 'pane{i}'
            ed  : Editor pane_at[ i ]
            apply_pane[ ed, active && (sp == pid), editor_slots[i] ]
            # the surface presents find_hits: new results must repaint it
            pv9 : element pane_view[ i ]
            cbe : element (pv9 && pv9.elements) ? pv9.elements['commit'] : null
            if [ cbe ]
                cbe.pristine = false
        if [ ux ] ux.will_animate = true

    func rekeep_listing []
        if [ !nav_showing ] return
        sp : string search_pane[]
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            if [ sp == 'pane{i}' ]
                te : element title_at[ i ]
                if [ te ] te.set_focus[]
        run_search[]

    # the EditorView above a title target, when its create mode is active
    func newfile_view [ t: element ] -> EditorView
        for [ e9: element* t, e9, e9 = e9.parent ]
            if [ e9 inherits EditorView ]
                ev9 : EditorView e9
                if [ ev9.newfile ] return ev9
                return null
        return null

    func open_file [ p: path ]
        open_in_pane[ p, active_pane ]

    # point a pane at a file and nothing else. no nav record: walking the
    # history has to land without pushing a point, since record truncates
    # the forward stack the walk is moving through
    public func bind_pane [ p: path, pi: i32 ]
        idx : i32 [ file_slot[ p ] ]
        if [ pi >= 0 && pi < editor_slots.count ]
            editor_slots[pi] = idx
            if [ pi < pane_console.count ] pane_console[pi] = ''
            active_pane = pi
        active_idx = idx
        exit_finder[]
        save_session[]

    func open_in_pane [ p: path, pi: i32 ]
        if [ pi >= 0 && pi < editor_slots.count && pi < nav_panes.count ]
            cur : Editor pane_at[ pi ]
            if [ cur && cur.src ]
                nav_panes[ pi ].record[ pi, '{cur.src.absolute[]}', cur.sel_line, cur.sel_col, cur.scroll.y ]
        bind_pane[ p, pi ]

    public func open_at [ fp: path, lno: i32, col: i32 ] -> bool
        open_in_pane[ fp, 0 ]
        ed : Editor pane_at[ 0 ]
        if [ ed ]
            sl : i32 [ (lno > 0) ? lno - 1 : 0 ]
            ed.sel_line = sl
            ed.sel_col  = col
            ed.anchor_line = sl
            ed.anchor_col  = col
            lh  : f32 [ (ed.lh_cache > 0.0) ? ed.lh_cache : 22.0 ]
            vh  : f32 [ (ed.bounds) ? ed.bounds.h : 600.0 ]
            top : f32 [ f32[ sl ] * lh ]
            if [ top < ed.scroll.y || top + lh > ed.scroll.y + vh ]
                ed.scroll.y = top - vh * 0.4
                if [ ed.scroll.y < 0.0 ] ed.scroll.y = 0.0
                ed.scroll_target = ed.scroll.y
            ed.pristine = false
        return true

    func jump_to_error [ logpath: string ]
        lp : path '{logpath}'
        if [ !lp.exists[] ] return
        content : string lp.load[ typeid[string], null ]
        if [ !content || content.count == 0 ] return
        ai : i32 [ content.index_of[ '.ag:' ] ]
        if [ ai < 0 ] return
        ps : i32 [ ai ]
        while [ ps > 0 ]
            c : i32 [ (i32 content.chars[ ps - 1 ]) & 255 ]
            if [ c == 32 || c == 10 || c == 13 || c == 27 || c == 40 || c == 41 || c == 91 ] break
            ps -= 1
        fp : string content.mid[ ps, ai + 3 - ps ]
        # line digits after '.ag:'
        li : i32 [ ai + 4 ]
        ls : ''
        while [ li < content.count ]
            c : i32 [ (i32 content.chars[ li ]) & 255 ]
            if [ c < 48 || c > 57 ] break
            ls = '{ls}{content.mid[ li, 1 ]}'
            li += 1
        if [ ls.count == 0 ] return
        ln : i32 [ atoi[ ls.chars ] ]
        # the sentence follows the compiler's (src:line) parens on the
        # same row; older logs put it on the row underneath — take
        # whichever is non-empty
        me : i32 [ li ]
        while [ me < content.count ]
            if [ ((i32 content.chars[ me ]) & 255) == 10 ] break
            me += 1
        ms : i32 [ li ]
        while [ ms < me && ((i32 content.chars[ ms ]) & 255) != 41 ] ms += 1
        msg : ''
        if [ ms < me ] msg = content.mid[ ms + 1, me - ms - 1 ].trim[]
        if [ msg.count == 0 ]
            ms = me + 1
            # the log carries ansi colour: skip any ESC [ ... m runs first
            while [ ms < content.count && ((i32 content.chars[ ms ]) & 255) == 27 ]
                while [ ms < content.count && ((i32 content.chars[ ms ]) & 255) != 109 ]
                    ms += 1
                ms += 1
            mend : i32 [ ms ]
            while [ mend < content.count ]
                c3 : i32 [ (i32 content.chars[ mend ]) & 255 ]
                if [ c3 == 10 || c3 == 13 ] break
                mend += 1
            if [ ms < mend ] msg = content.mid[ ms, mend - ms ].trim[]
        err_file = path '{fp}'
        err_file.hold[]
        err_line = ln
        err_msg  = msg
        err_msg.hold[]
        open_at_line[ err_file, active_pane, ln ]

    # is the current error from a module we are RUNNING in a pane?
    # the top tab is for code ORBITER ITSELF reloads. anything else --
    # a file merely open in a pane -- belongs to that app's run band
    func err_is_own [] -> bool
        if [ !err_mod ] return false
        ot  : typeid[ a ]
        own : string [ ot.ident ]
        return err_mod == own

    func goto_error []
        if [ !err_file || err_line <= 0 ] return
        open_at_line[ err_file, active_pane, err_line ]

    func open_at_line [ p: path, pi: i32, to_line: i32 ]
        findbar_open = false
        find_showing = false
        open_in_pane[ p, pi ]
        ed : Editor pane_at[ pi ]
        if [ !ed ] return
        sl : i32 [ (to_line > 0) ? to_line - 1 : 0 ]
        ed.sel_line    = sl
        ed.sel_col     = 0
        ed.anchor_line = sl
        ed.anchor_col  = 0
        lh : f32 [ (ed.lh_cache > 0.0) ? ed.lh_cache : 22.0 ]
        vh : f32 [ (ed.bounds) ? ed.bounds.h : 600.0 ]
        tp : f32 [ f32[ sl ] * lh ]
        if [ tp < ed.scroll.y || tp + lh > ed.scroll.y + vh ]
            ed.scroll.y      = tp - vh * 0.4
            if [ ed.scroll.y < 0.0 ] ed.scroll.y = 0.0
            ed.scroll_target = ed.scroll.y
        ed.saved_scroll = ed.scroll.y
        ed.pristine = false
        # the ARRIVAL is its own nav point: landing on a definition has
        # to be somewhere you can come back to, not just somewhere you left
        if [ ed.nav && ed.src ]
            ed.nav.record[ pi, '{ed.src.absolute[]}', ed.sel_line, ed.sel_col, ed.scroll.y ]

    func force_update []
        win : ux
        if [ win ]
            win.restyle      = true
            win.will_animate = true

    # show a named view in a pane; '' returns it to the default
    func set_pane_view [ ed: Editor, nm: string ]
        if [ !ed ] return
        ed.view_name = nm
        ed.load_file[]
        exit_find_mode[]

    # the peer module that owns a view, or null when we host it ourselves
    func view_module [ nm: string ] -> string
        if [ !nm || nm.count == 0 ] return null
        ensure_views[]
        m9 : string (view_mods) ? view_mods[ nm ] : null
        if [ !m9 ] return null
        if [ m9 == 'orbiter' ] return null
        return m9

    func exit_find_mode []
        sp9 : string search_pane[]
        findbar_open = false
        find_showing = false
        find_text    = ''
        finder_off   = true
        win : ux
        if [ win && win.focus ]
            win.focus.edit = ''
            win.release_focus[ win.focus ]
        # rebuild with the finder off — apply_pane is what puts each pane's
        # file back and drops the nav tools row
        run_search[]
        # esc lands focus on the editor the search was working in
        pi9 : i32 [ (sp9 && sp9.count > 4) ? sp9.mid[ 4, sp9.count - 4 ].real_value[] : 0 ]
        ed9 : Editor pane_at[ pi9 ]
        if [ win && ed9 ] win.set_focus[ ed9 ]
        force_update[]

    func open_find []
        finder_off   = false
        findbar_open = true
        # the field is built later this frame; ask the window to focus
        # it by id and let animate[] resolve it before the next draw
        if [ ux ] ux.focus_id = 'find'
        findbar_pane = 'pane{active_pane}'
        ed : Editor pane_at[ active_pane ]
        if [ ed ]
            sel : ed.selected_text[]
            if [ sel && sel.count > 0 ]
                nl : i32 [ sel.index_of[ '\n' ] ]
                findbar_text = (nl >= 0) ? sel.mid[ 0, nl ] : sel
        te : element title_at[ active_pane ]
        if [ !te ] return
        fe : element te.elements['find']
        if [ fe ]
            fe.edit       = findbar_text
            fe.sel_col    = findbar_text->count
            fe.anchor_col = fe.sel_col
            fe.set_focus[]
        force_update[]

    func focus_finder []
        finder_off = false
        te : element title_at[ active_pane ]
        if [ te ] te.set_focus[]
        force_update[]

    func exit_finder []
        find_text    = ''
        find_results = list string []
        win : ux
        if [ !win ] return
        if [ win.focus && win.focus.id == 'title' ]
            win.focus.edit = ''
            win.release_focus[ win.focus ]

    func set_active [ idx: i32 ]
        active_idx = idx

    func sync_tabs []
        win : ux
        tb  : element win.root.elements['toolbar']
        if [ !tb ] return
        nav : element tb.elements['source_nav']
        if [ !nav ] return
        for [ i: i32 0, i < target_names.count, i += 1 ]
            name : string target_names[i]
            op   : Option nav.elements[name]
            if [ op ] op.selected = active_target == name && active_panel != 'config'
        sys : Option nav.elements['system']
        if [ sys ] sys.selected = active_target == 'system' && active_panel != 'config'
        cfg : Option nav.elements['config']
        if [ cfg ] cfg.selected = active_panel == 'config'
        win.restyle = true

    func sync_active []
        win : ux
        if [ win ] win.restyle = true

    public func pad[ n:i32 ] -> string
        str : local char[256]
        sprintf[str, "%04i", n]
        return str

    public func on_inspect [ hits: vec StyleHit ]
        if [ !hits || hits.count == 0 ] return
        h : StyleHit hits[ 0 ]
        if [ h.file ] open_at_line[ h.file, active_pane, h.line ]

    # activate a hits row: click and Return share this
    func hit_activate [ ed: Editor, row: i32, dbl: bool ] -> bool
        if [ !ed || row < 0 || row >= find_hits.count ] return false
        h : FindHit find_hits[ row ]
        if [ !h || h.is_spacer ] return true
        if [ h.session && h.session.count > 0 ]
            cpi : i32 [ ed.pane_index ]
            while [ pane_console.count <= cpi ]
                pane_console += ''
            console_seq += 1
            sid : string '{h.session}#{console_seq}'
            pane_console[cpi] = sid
            active_pane = cpi
            if [ !ed_sessions ] ed_sessions = map ConsoleSession [string] [ ]
            ns : ConsoleSession []
            ns.name = sid
            ns.launch_cmd = agent_cmd[ sid ]
            ed_sessions[sid] = ns
            ns.start[]
            exit_find_mode[]
            return true
        if [ h.is_newfile ]
            for [ e9: element* ed, e9, e9 = e9.parent ]
                if [ e9 inherits EditorView ]
                    ev9 : EditorView e9
                    ev9.newfile_enter[ ed.src ]
                    # label swap drops focus; re-take it after restyle
                    pending_finder = ed.pane_index
                    break
            return true
        if [ h.is_dir && h.file ]
            nav_root  = h.file
            ed.sel_line      = -1
            ed.anchor_line   = -1
            ed.hover_line    = -1
            ed.scroll.y      = 0.0
            ed.scroll_target = 0.0
            run_search[]
            te : element title_at[ ed.pane_index ]
            if [ te ] te.set_focus[]
            return true
        if [ !h.is_header && h.line > 0 && h.file ]
            if [ dbl ] open_at_line[ h.file, ed.pane_index, h.line ]
            return true
        if [ h.file ]
            # browse file link / result filename header → open the file
            open_in_pane[ h.file, ed.pane_index ]
            exit_finder[]
            return true
        return false

    func on_press [ ev: Event ]
        if [ !ev.target ] return
        puts 'on_press: target={ev.target.id}'
        # working in a pane makes it active: keys act where you are
        epv : Editor pane_of[ ev.target ]
        if [ epv && epv.pane_index >= 0 && epv.pane_index < editor_slots.count ]
            active_pane = epv.pane_index
        for [ e: element* ev.target, e, e = e.parent ]
            if [ e inherits Console ]
                co  : Console e
                cid : string co.id
                if [ ev.target.id == 'console_filter' && cid && cid.count > 4 && cid.mid[ 0, 4 ].compare[ 'pane' ] == 0 ]
                    ppi : i32 [ cid.mid[ 4, cid.count - 4 ].real_value[] ]
                    if [ ppi < editor_slots.count && ppi < pane_console.count ]
                        pane_console[ppi] = ''
                        active_pane    = ppi
                        pending_finder = ppi
                        ev.no_default  = true
                        force_update[]
                        return
            if [ e inherits Editor ]
                ed : Editor e
                # hits are clickable only while the list is actually shown
                if [ ev.target == e && (nav_showing || find_showing) ]
                    # shift-click pins: merge the row into the top list
                    if [ ev.key.shift && ed.hover_line >= 0 && ed.hover_line < find_hits.count ]
                        hs : FindHit find_hits[ ed.hover_line ]
                        if [ hs && hs.is_header && hs.file && !hs.is_spacer ]
                            toggle_dock[ hs.file ]
                            ev.no_default = true
                            if [ ev.target ] ev.target.ux.restyle = true
                        return
                if [ ev.target == e && (nav_showing || find_showing) && ed.sel_line >= 0 && ed.sel_line < find_hits.count ]
                    dbl : bool [ ev.mouse.double_click && last_hit_row == ed.sel_line ]
                    last_hit_row = ed.sel_line
                    if [ hit_activate[ ed, ed.sel_line, dbl ] ]
                        ev.no_default = true
                        if [ ev.target ] ev.target.ux.restyle = true
                    return
        # avatar pane titlebar toggle: hide/show the 3D avatar view
        if [ ev.target.id == 'avatar_hide' ]
            show_avatar = !show_avatar
            if [ ev.target ] ev.target.ux.restyle = true
            force_update[]
            return
        if [ ev.target.id == 'mute' ]
            app_muted = !app_muted
            if [ ev.target ] ev.target.ux.restyle = true
            ev.no_default = true
            return
        if [ ev.target.id == 'reload_ready' ]
            au_live_request_apply[]
            ev.no_default = true
            return
        if [ ev.target.id == 'error' || ev.target.id == 'our_app_error' ]
            goto_error[]
            ev.no_default = true
            return
        if [ ev.target.id == 'play' ]
            dl : dbg (debuggers) ? debuggers[ active_target ] : null
            if [ dl && dl.active ]
                dl.stop[]
                clear_stop_lines[]
            el
                pn : Project (projects) ? projects[ active_target ] : null
                if [ pn ]
                    run_node[ active_target ]
                el
                    # no build node — debug the built binary by name alone
                    start_debug[ active_target ]
            ev.no_default = true
            return
        if [ ev.target.id == 'callstack' ]
            show_instruments = !show_instruments
            return
        if [ ev.target.id == 'instruments' ]
            show_instr_col = !show_instr_col
            if [ ev.target ] ev.target.ux.restyle = true
            ev.no_default = true
            return
        # pip shrinks the app into the editor; its instruments stay open
        if [ ev.target.id == 'pip' ]
            for [ e: element* ev.target, e, e = e.parent ]
                if [ e inherits EditorView ]
                    ev6 : EditorView e
                    ed6 : Editor pane_at[ ev6.pane_index ]
                    if [ ed6 ] ed6.toggle_app_view[]
                    break
            if [ ev.target ] ev.target.ux.restyle = true
            ev.no_default = true
            return
        if [ ev.target.id == 'scene_prev' ]
            scene_step[ -1 ]
            ev.no_default = true
            return
        if [ ev.target.id == 'scene_next' ]
            scene_step[ 1 ]
            ev.no_default = true
            return
        if [ ev.target.id == 'frost_name' ]
            frost_ix = (frost_ix + 1) % 4
            ux.frost_mode = frost_ix
            save_session[]
            ev.no_default = true
            return
        if [ ev.target.id == 'speed_name' ]
            speed_step[ 1 ]
            ev.no_default = true
            return
        if [ ev.target.id == 'orbit_name' ]
            orbit_step[ 1 ]
            ev.no_default = true
            return
        if [ ev.target.id == 'angle_name' ]
            angle_step[ 1 ]
            ev.no_default = true
            return
        # the arrows only browse; the label commits what you landed on
        if [ ev.target.id == 'scene_name' ]
            scene_load = scene_name[]
            scene_load.hold[]
            save_session[]
            ev.no_default = true
            return
        if [ ev.target.id == 'ui_hide' ]
            hide_ui = !hide_ui
            force_update[]
            if [ ev.target ] ev.target.ux.restyle = true
            ev.no_default = true
            return
        puts 'on_press: {ev.target.id}'
        for [ i: i32 0, i < open_files.count, i += 1 ]
            key : string 'tab_{i}'
            if [ ev.target.id == key ]
                rel_x    : f32 [ ev.mouse.pos.x - ev.target.bounds.x ]
                in_right : bool [ rel_x > ev.target.bounds.w - 14.0 ]
                active_panel = 'editor'
                if [ (ev.key.shift || in_right) && editor_slots.count > 1 ]
                    si : i32 [ (active_pane + 1 < editor_slots.count) ? active_pane + 1 : 0 ]
                    editor_slots[si] = i
                    active_pane = si
                el
                    editor_slots[active_pane] = i
                set_active[ i ]
                sync_tabs[]
                return
        
        if [ ev.target.id == 'git' ]
            edg : Editor pane_at[ active_pane ]
            if [ edg ] set_pane_view[ edg, (edg.view_name == 'git') ? '' : 'git' ]
            if [ ev.target ] ev.target.ux.restyle = true
            return


        if [ ev.target.id == 'newfile_cancel' ]
            for [ e9: element* ev.target, e9, e9 = e9.parent ]
                if [ e9 inherits EditorView ]
                    ev9 : EditorView e9
                    ev9.newfile_exit[]
                    break
            ev.no_default = true
            if [ ev.target ] ev.target.ux.restyle = true
            return

        # [x] left of the title: leave the chosen view and any diff.
        # a running app stops and lands on its source, never relaunches
        if [ ev.target.id == 'panel_close' ]
            edx : Editor pane_of[ ev.target ]
            if [ edx ] edx.diff_commit = null
            if [ edx && edx.run_view ]
                edx.toggle_app_run[ false ]
            el
                set_pane_view[ edx, '' ]
            ev.no_default = true
            if [ ev.target ] ev.target.ux.restyle = true
            return
        
        if [ ev.target.id == 'back' ]
            exit_finder[]
            ev.no_default = true
            if [ ev.target ] ev.target.ux.restyle = true
            return
        
        if [ ev.target.id == 'pins' ]
            show_pins = !show_pins
            rekeep_listing[]
            ev.no_default = true
            force_update[]
            return
        
        if [ ev.target.id == 'run' ]
            for [ e: element* ev.target, e, e = e.parent ]
                if [ e inherits EditorView ]
                    ev2 : EditorView e
                    ed : Editor pane_at[ ev2.pane_index ]
                    if [ ed ]
                        if [ ed.run_view ]
                            av2 : AppView ed.run_view
                            if [ av2.ended ]
                                # stopped peer: play brings the session back
                                av2.ended = false
                                av2.note = ''
                            el
                                av2.pause_toggle*[]
                        el
                            # shift+click = build-run --clean
                            ed.toggle_app_run[ ev.key.shift ]
                    break
            if [ ev.target ] ev.target.ux.restyle = true
            ev.no_default = true
            return
        # pause/resume ONLY: the play button no longer does double duty
        if [ ev.target.id == 'pause' ]
            for [ e: element* ev.target, e, e = e.parent ]
                if [ e inherits EditorView ]
                    ev3 : EditorView e
                    ed3 : Editor pane_at[ ev3.pane_index ]
                    if [ ed3 && ed3.run_view ]
                        av3 : AppView ed3.run_view
                        if [ av3.ended ]
                            av3.ended = false
                            av3.note = ''
                        el
                            av3.pause_toggle*[]
                        # paused -> back to the source, running -> the app.
                        # toggle_app_view owns the reload, so go through it
                        want : bool [ !av3.paused ]
                        if [ ed3.app_view != want ] ed3.toggle_app_view[]
                    break
            if [ ev.target ] ev.target.ux.restyle = true
            ev.no_default = true
            return
        if [ ev.target.id == 'stop' ]
            for [ e: element* ev.target, e, e = e.parent ]
                if [ e inherits EditorView ]
                    ev4 : EditorView e
                    ed4 : Editor pane_at[ ev4.pane_index ]
                    if [ ed4 && ed4.run_view ]
                        av4 : AppView ed4.run_view
                        if [ av4.slot == 0 ]
                            av4.ended = true
                            av4.note = 'stopped'
                        el
                            ed4.toggle_app_run[ false ]
                    break
            if [ ev.target ] ev.target.ux.restyle = true
            ev.no_default = true
            return

        # StepButtons renames itself to the pressed segment; it sits in the run
        # band header, so the press lands here and not on the Editor
        if [ ev.target.id == 'step_next' || ev.target.id == 'step_in' ||
             ev.target.id == 'step_out' ]
            d5 : dbg active_debugger[]
            if [ d5 ]
                if [ ev.target.id == 'step_next' ] d5.step_over[]
                el [ ev.target.id == 'step_in' ]   d5.step_into[]
                el                                 d5.step_out[]
            ev.no_default = true
            if [ ev.target ] ev.target.ux.restyle = true
            return

        # back to the source of the app this band is running
        if [ ev.target.id == 'gotosrc' ]
            for [ e: element* ev.target, e, e = e.parent ]
                if [ e inherits EditorView ]
                    ev6 : EditorView e
                    ed6 : Editor pane_at[ ev6.pane_index ]
                    if [ ed6 ]
                        bs6 : path ed6.band_src[]
                        if [ bs6 ] open_in_pane[ bs6, ev6.pane_index ]
                    break
            ev.no_default = true
            if [ ev.target ] ev.target.ux.restyle = true
            return

        if [ ev.target.id == 'title_close' ]
            exit_finder[]
            findbar_open = false
            ev.no_default = true
            if [ ev.target ] ev.target.ux.restyle = true
            force_update[]
            return

        if [ ev.target.id == 'finder_close' ]
            exit_find_mode[]
            ev.no_default = true
            if [ ev.target ] ev.target.ux.restyle = true
            force_update[]
            return

        if [ ev.target.id == 'nav_back' || ev.target.id == 'nav_fwd' ]
            edn : Editor pane_of[ ev.target ]
            if [ edn ] edn.nav_walk[ (ev.target.id == 'nav_back') ? -1 : 1 ]
            ev.no_default = true
            if [ ev.target ] ev.target.ux.restyle = true
            return

        if [ ev.target.id == 'magnify' ]
            findbar_open = !findbar_open
            if [ findbar_open ] pending_findfocus = true
            for [ e: element* ev.target, e, e = e.parent ]
                if [ e inherits EditorView ]
                    findbar_pane = e.id
                    break
            # closing the bar hides the results
            if [ !findbar_open ] find_showing = false
            if [ ev.target ] ev.target.ux.restyle = true
            return
        
        if [ ev.target.id == 'close_find' ]
            findbar_open = false
            find_showing = false
            if [ ev.target ] ev.target.ux.restyle = true
            ev.no_default = true
            force_update[]
            return
        
        if [ ev.target.id == 'replace' ]
            ev.target.sel_col    = ev.target.edit->count
            ev.target.anchor_col = ev.target.sel_col
            ev.target.set_focus[]
            force_update[]
            return

        if [ ev.target.id == 'dock' ]
            puts 'on_press: DOCK handler reached'
            if [ editor_slots.count < 4 ]
                editor_slots += -1
                pane_console += ''
                active_pane = editor_slots.count - 1
            save_session[]
            if [ ev.target ] ev.target.ux.restyle = true
            return
        if [ ev.target.id == 'gear' ]
            if [ !agent_open && editor_slots.count < 4 ]
                agent_open  = true
                active_pane = editor_slots.count
                ensure_console[ orbit_sid ]
            save_session[]
            if [ ev.target ] ev.target.ux.restyle = true
            ev.no_default = true
            return
        if [ ev.target.id == 'undock' ]
            puts 'on_press: UNDOCK handler reached'
            for [ e: element* ev.target, e, e = e.parent ]
                if [ e.id && e.id.count >= 5 && e.id.mid[ 0, 4 ] == 'pane' ]
                    pi : i32 [ e.id.mid[ 4, e.id.count - 4 ].real_value[] ]
                    close_pane[ pi ]
                    break
            if [ ev.target ] ev.target.ux.restyle = true
            return
        if [ ev.target.id == 'ctx_copy' ]
            request_context[]
            if [ ev.target ] ev.target.ux.restyle = true
            return
        if [ ev.target.id == 'ctx_shot' ]
            fn : string snap_window[ ev.target.ux ]
            if [ fn ] feed_agent[ fn + ' ' ]
            if [ ev.target ] ev.target.ux.restyle = true
            return
        tid : string ev.target.id
        if [ ev.target.id == 'config' ]
            rel_x    : f32 [ ev.mouse.pos.x - ev.target.bounds.x ]
            in_right : bool [ rel_x > ev.target.bounds.w - 14.0 ]
            if [ ev.key.shift || in_right ]
                config_side = (config_side == 1) ? 0 : 1
            el
                active_panel = 'config'
            sync_tabs[]
            return
        if [ ev.target inherits Option ]
            oid : string ev.target.id
            if [ oid == 'system' ]
                active_target = 'system'
                nav_root = path '{startup_path}'
                reroot_index[]
                rekeep_listing[]
                sync_active[]
                save_session[]
                ev.no_default = true
            el
                matched : bool false
                for [ i: i32 0, i < target_names.count, i += 1 ]
                    if [ target_names[i] == oid ]
                        active_target = oid
                        nav_root      = target_roots[i]
                        matched       = true
                if [ !matched ]
                    active_panel = oid
                if [ matched ]
                    reroot_index[]
                    rekeep_listing[]
                    sync_active[]
                    save_session[]
                    ev.no_default = true
            if [ ev.target ] ev.target.ux.restyle = true
            return

    # only the first dropped file opens — one tab, not one per file
    func on_drop [ ev: Event ]
        if [ !ev.paths || ev.paths.count == 0 ] return
        open_file[ ev.paths[ 0 ] ]

    func on_char [ ev: Event ]
        if [ !ev.target ] return
        if [ ev.target.id == 'filter' ]
            if [ ev.key.text && ev.key.text.count > 0 ]
                filter_text = filter_text + ev.key.text
                uxw : Window ev.target.ux
                if [ uxw ] uxw.will_animate = true
        # typing into the find/replace bar rows (each its own query)
        if [ ev.target.id == 'find' ]
            if [ ev.key.text && ev.key.text.count > 0 ]
                findbar_text = findbar_text + ev.key.text
                ev.target.pristine = false
                uxw : Window ev.target.ux
                if [ uxw ] uxw.will_animate = true
        if [ ev.target.id == 'replace' ]
            if [ ev.key.text && ev.key.text.count > 0 ]
                replace_text = replace_text + ev.key.text
                ev.target.pristine = false
                uxw : Window ev.target.ux
                if [ uxw ] uxw.will_animate = true
        if [ ev.target.id == 'pattern' ]
            if [ ev.key.text && ev.key.text.count > 0 ]
                pattern_text = pattern_text + ev.key.text
                ev.target.pristine = false
                uxw : Window ev.target.ux
                if [ uxw ] uxw.will_animate = true
        # run args are per source file, kept in the session state
        if [ ev.target.id == 'args' ]
            # the editable layer edits the text after this; the session
            # copies the field's edit next frame (args_sync)
            if [ ev.key.text && ev.key.text.count > 0 ]
                args_field  = ev.target
                args_editor = pane_of[ ev.target ]
                args_sync   = true
                ev.target.pristine = false
                uxw : Window ev.target.ux
                if [ uxw ] uxw.will_animate = true
        # typing into an editor's title (the finder/magnify control)
        if [ ev.target.id == 'title' ]
            if [ ev.key.text && ev.key.text.count > 0 ]
                nv9 : EditorView newfile_view[ ev.target ]
                if [ nv9 ]
                    nv9.newfile_text = nv9.newfile_text + ev.key.text
                    ev.target.pristine = false
                    if [ ev.target.ux ] ev.target.ux.restyle = true
                    return
                find_text = find_text + ev.key.text
                ev.target.pristine = false
                run_search[]

    func on_key [ ev: Event ]
        # global chords need no focus target
        if [ ev.key.state && (ev.key.ctrl || ev.key.meta) ]
            kc : i32 [ i32[ ev.key.unicode ] ]
            if [ kc == 70 ]    # 'F'
                open_find[]
                ev.no_default = true
                return
            if [ kc == 71 || kc == 79 ]    # 'G' / 'O' — focus the title
                focus_finder[]
                ev.no_default = true
                return
            if [ kc == 96 ]    # '`' — summon/dismiss the orbiter helper
                if [ ev.key.state == 1 ]    # key repeats must not re-toggle
                    show_orbiter = !show_orbiter
                    # summon starts the mic; dismiss stops and submits the take
                    if [ show_orbiter != listening[] ] toggle_listen[ null ]
                    if [ ux ] ux.restyle = true
                ev.no_default = true
                return
        # escape peels ONE layer per press, innermost first: the finder closes
        # before the chosen view is given up
        if [ ev.key.state && i32[ ev.key.unicode ] == 256 && (findbar_open || find_showing || nav_showing) ]
            exit_find_mode[]
            ev.no_default = true
            return
        # the pane the key came from wins; the active pane is the fallback
        eda : Editor pane_of[ ev.target ]
        if [ !eda ] eda = pane_at[ active_pane ]
        chosen : bool [ eda && ((eda.view_name && eda.view_name.count > 0)
                             || (eda.diff_commit && eda.diff_commit.count > 0)) ]
        if [ ev.key.state && i32[ ev.key.unicode ] == 256 && chosen ]
            eda.diff_commit = null
            set_pane_view[ eda, '' ]
            if [ ux ] ux.restyle = true
            ev.no_default = true
            return

        if [ !ev.target ] return
        # Return in the list opens the highlighted row
        if [ ev.key.state && i32[ ev.key.unicode ] == 257 && (nav_showing || find_showing) && ev.target inherits Editor ]
            edr : Editor ev.target
            if [ edr.hover_line >= 0 && hit_activate[ edr, edr.hover_line, true ] ]
                ev.no_default = true
                if [ ux ] ux.restyle = true
                return
        if [ ev.target.id == 'filter' ]
            if [ !ev.key.state ] return
            k : i32 [ i32 ev.key.unicode ]
            changed : false
            if [ k == 259 ]    # Key.Backspace
                if [ filter_text && filter_text.count > 0 ]
                    filter_text = filter_text.mid[ 0, filter_text.count - 1 ]
                    changed = true
            el [ k == 256 ]    # Key.Escape
                filter_text = ''
                changed = true
            if [ changed ]
                uxw : Window ev.target.ux
                if [ uxw ] uxw.will_animate = true

        if [ ev.target.id == 'args' ]
            # backspace, arrows and escape (clear) are the editable layer's;
            # the session copies the field's edit next frame (args_sync)
            if [ !ev.key.state ] return
            args_field  = ev.target
            args_editor = pane_of[ ev.target ]
            args_sync   = true
            ev.target.pristine = false
            if [ ev.target.ux ] ev.target.ux.will_animate = true
            return

        if [ ev.target.id == 'find' || ev.target.id == 'replace' || ev.target.id == 'pattern' ]
            if [ !ev.key.state ] return
            k : i32 [ i32 ev.key.unicode ]
            if [ (ev.key.ctrl || ev.key.meta) && (k == 67 || k == 86 || k == 88) ]    # C / V / X
                w9  : Window ev.target.ux
                cur : string [ (ev.target.id == 'find') ? findbar_text : ((ev.target.id == 'replace') ? replace_text : pattern_text) ]
                if [ k != 86 && w9 && cur && cur.count > 0 ] w9.set_clipboard[ cur ]
                if [ k == 88 ] cur = ''
                if [ k == 86 && w9 ]
                    clip : string w9.get_clipboard[]
                    if [ clip ]
                        nl9 : i32 [ clip.index_of[ '\n' ] ]
                        if [ nl9 >= 0 ] clip = clip.mid[ 0, nl9 ]
                        if [ clip.count > 0 ] cur = cur + clip
                if [ ev.target.id == 'find' ]         findbar_text = cur
                el [ ev.target.id == 'replace' ]      replace_text = cur
                el                                    pattern_text = cur
                ev.target.pristine = false
                if [ ev.target.ux ] ev.target.ux.will_animate = true
                ev.no_default = true
                return
            if [ k == 259 ]    # Key.Backspace
                if [ ev.target.id == 'find' ]
                    if [ findbar_text && findbar_text.count > 0 ]
                        findbar_text = findbar_text.mid[ 0, findbar_text.count - 1 ]
                el [ ev.target.id == 'replace' ]
                    if [ replace_text && replace_text.count > 0 ]
                        replace_text = replace_text.mid[ 0, replace_text.count - 1 ]
                el
                    if [ pattern_text && pattern_text.count > 0 ]
                        pattern_text = pattern_text.mid[ 0, pattern_text.count - 1 ]
            el [ k == 257 ]    # Key.Enter
                in_file : bool [ find_in_file[] ]
                puts 'FIND enter: tgt={ev.target.id} q="{findbar_text}" pat="{pattern_text}" in_file={(in_file) ? 1 : 0}'
                if [ ev.target.id == 'replace' ]
                    run_replace[]
                el [ in_file ]
                    find_last_query = findbar_text
                    find_last_scope = ''
                    find_file_next[]
                el
                    cur_scope  : string [ (pattern_text)    ? pattern_text    : '' ]
                    last_scope : string [ (find_last_scope) ? find_last_scope : '' ]
                    scope_same : bool [ cur_scope.compare[ last_scope ] == 0 ]
                    same : bool [ scope_same && find_showing && find_hits && find_hits.count > 0 && find_last_query && findbar_text && find_last_query.compare[ findbar_text ] == 0 ]
                    # files changed since the scan: the results lie — rescan
                    if [ same && tree_mtime[ project_root[] ] > find_scan_mt ] same = false
                    if [ same ]
                        next_match[]
                    el
                        run_find_in_files[]
                if [ ev.target.ux ] ev.target.ux.restyle = true
            el [ k == 256 ]    # Key.Escape
                # escape collapses the bar and hides the results
                findbar_open = false
                find_showing = false
                ev.target.ux.restyle = true
            ev.target.pristine = false
            uxw : Window ev.target.ux
            if [ uxw ] uxw.will_animate = true

        # finder title: backspace trims, enter opens the typed file
        if [ ev.target.id == 'title' ]
            if [ !ev.key.state ] return
            k : i32 [ i32 ev.key.unicode ]
            kv9 : EditorView newfile_view[ ev.target ]
            if [ (ev.key.ctrl || ev.key.meta) && (k == 67 || k == 86 || k == 88) ]    # C / V / X
                w9  : Window ev.target.ux
                cur : string [ (kv9) ? kv9.newfile_text : find_text ]
                if [ k != 86 && w9 && cur && cur.count > 0 ] w9.set_clipboard[ cur ]
                if [ k == 88 ] cur = ''
                if [ k == 86 && w9 ]
                    clip : string w9.get_clipboard[]
                    if [ clip ]
                        nl9 : i32 [ clip.index_of[ '\n' ] ]
                        if [ nl9 >= 0 ] clip = clip.mid[ 0, nl9 ]
                        if [ clip.count > 0 ] cur = cur + clip
                if [ kv9 ]
                    kv9.newfile_text = cur
                el
                    find_text = cur
                    if [ k != 67 ] run_search[]
                ev.target.pristine = false
                if [ ev.target.ux ] ev.target.ux.restyle = true
                ev.no_default = true
                return
            if [ kv9 ]
                if [ k == 259 && kv9.newfile_text && kv9.newfile_text.count > 0 ]    # Key.Backspace
                    kv9.newfile_text = kv9.newfile_text.mid[ 0, kv9.newfile_text.count - 1 ]
                el [ k == 257 ]    # Key.Enter — create unless the name exists
                    kv9.newfile_commit[]
                el [ k == 256 ]    # Key.Escape — no action
                    kv9.newfile_exit[]
                ev.target.pristine = false
                if [ ev.target.ux ] ev.target.ux.restyle = true
                ev.no_default = true
                return
            if [ k == 259 ]    # Key.Backspace
                if [ find_text && find_text.count > 0 ]
                    find_text = find_text.mid[ 0, find_text.count - 1 ]
                    ev.target.pristine = false
                    run_search[]
            el [ k == 257 ]    # Key.Enter
                handled : bool false
                if [ find_text && find_text.count > 1 && find_text[0] == ':' ]
                    num : string find_text.mid[ 1, find_text.count - 1 ]
                    if [ num.is_numeric[] ]
                        ed : Editor pane_at[ active_pane ]
                        if [ ed ]
                            if [ ed.nav && ed.src ]
                                ed.nav.record[ active_pane, '{ed.src.absolute[]}', ed.sel_line, ed.sel_col, ed.scroll.y ]
                            sl : i32 [ i32[ num.integer_value[] ] ]
                            sl = (sl > 0) ? sl - 1 : 0
                            ed.sel_line    = sl
                            ed.sel_col     = 0
                            ed.anchor_line = sl
                            ed.anchor_col  = 0
                            # reveal the line (centered-ish), pinning scroll_target
                            lh : f32 [ (ed.lh_cache > 0.0) ? ed.lh_cache : 22.0 ]
                            vh : f32 [ (ed.bounds) ? ed.bounds.h : 600.0 ]
                            tp : f32 [ f32[ sl ] * lh ]
                            if [ tp < ed.scroll.y || tp + lh > ed.scroll.y + vh ]
                                ed.scroll.y      = tp - vh * 0.4
                                if [ ed.scroll.y < 0.0 ] ed.scroll.y = 0.0
                                ed.scroll_target = ed.scroll.y
                            ed.saved_scroll = ed.scroll.y
                            ed.pristine = false
                        exit_finder[]
                        if [ ev.target.ux ] ev.target.ux.restyle = true
                        handled = true
                if [ !handled && find_results && find_results.count > 0 ]
                    first_s    : string find_results.value_by_index[ 0 ]
                    first_path : path [ first_s.chars ]
                    open_file[ first_path ]
            el [ k == 264 ]    # Key.Down — enter the nav list when it shows
                if [ nav_showing ]
                    sp8 : string search_pane[]
                    ed8 : Editor null
                    for [ i: i32 0, i < editor_slots.count, i += 1 ]
                        e8 : Editor pane_at[ i ]
                        if [ e8 && sp8 == 'pane{i}' ] ed8 = e8
                    if [ !ed8 ] ed8 = pane_at[ active_pane ]
                    if [ ed8 ]
                        ed8.hover_line = -1
                        ed8.hover_step[ 1 ]
                        ed8.set_focus[]
                        ed8.pristine = false
                    ev.no_default = true
            el [ k == 258 ]    # Key.Tab — toggle single-line / double-header density
                browse_single = !browse_single
                ev.target.pristine = false
                run_search[]
                if [ ev.target.ux ] ev.target.ux.restyle = true
            el [ k == 256 ]    # Key.Escape
                exit_finder[]
                ev.target.pristine = false
                if [ ev.target.ux ] ev.target.ux.restyle = true
    
    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        if [ orbit_cap_on ] dictation_gpu[ Canvas w.screen ]
        if [ orbit_app ] orbit_frame[ w ]
        mic_frame[]

        if [ cycle ]
            cycle_frame += 1
            if [ cycle_frame % 30 == 0 ]
                if [ cycle_adding ]
                    if [ editor_slots.count < 4 ]
                        editor_slots += -1
                        pane_console += ''
                        active_pane = editor_slots.count - 1
                        save_session[]
                    el
                        cycle_adding = false
                el
                    if [ editor_slots.count > 1 ]
                        close_pane[ editor_slots.count - 1 ]
                    el
                        cycle_adding = true
                        cycle_count += 1
                        puts 'CYCLE {cycle_count}'

        if [ au_mem_fraction[] > 0.20 ]
            puts 'orbiter: memory exceeded 20% of system RAM — quitting '
            exit[ 1 ]

        if [ index_research && !index_building ]
            index_research = false
            run_search[]

        bpc : i32 [ breakpoints->count ]
        if [ last_bp_count >= 0 && bpc != last_bp_count ]
            save_session[]
        last_bp_count = bpc
        if [ pending_finder >= 0 ]
            fte : element title_at[ pending_finder ]
            if [ fte ]
                fte.set_focus[]
                pending_finder = -1
        if [ pending_run >= 0 ]
            red : Editor pane_at[ pending_run ]
            if [ red ]
                if [ !red.run_view ] red.toggle_app_run[ false ]
                pending_run = -1
        if [ pending_findfocus ]
            if [ !findbar_open ]
                pending_findfocus = false
            el [ findbar_pane && findbar_pane.count > 4 ]
                fpi : i32 [ findbar_pane.mid[ 4, findbar_pane.count - 4 ].real_value[] ]
                fte2 : element title_at[ fpi ]
                if [ fte2 && fte2.elements ]
                    ffe : element fte2.elements['find']
                    if [ ffe ]
                        ffe.set_focus[]
                        pending_findfocus = false
        fin_now : bool   [ (w.focus && w.focus.id == 'title') || (find_text && find_text.count > 0) || list_focused[] ]
        sp_now  : string search_pane[]
        if [ fin_now != was_finder || sp_now != was_search_pane ]
            run_search[]
        was_finder      = fin_now
        was_search_pane = sp_now
        now_ms : i64 [ Au.epoch_millis[] ]
        # a finished git fetch swaps in on THIS thread, then repaints
        if [ git_fresh ]
            git_fresh = false
            git_snap  = git_stage
            git_stage = null
            run_search[]
            if [ ux ] ux.restyle = true
        if [ now_ms - settings_check_ms >= 1000 ]
            settings_check_ms = now_ms
            sp : agi_path[]
            mt : i64 [ sp.modified_time[] ]
            if [ mt != settings_mtime ]
                load_settings[]
            fmt_sync[]
            fmt_poll[]
            # refresh policy: saves kick now; the watcher's dirty mark
            # is picked up on the 60-second interval
            if [ git_dirty && now_ms - git_last >= 60000 ] git_summarize[]

        if [ orbit_app && attach && !orbit_bound ]
            edo : Editor pane_at[ 0 ]
            if [ edo ]
                edo.attach_app_run[ orbit_app ]
                orbit_bound = true

        # AVSOAK: auto summon/dismiss every 3s to reproduce the remount crash
        if [ getenv[ 'AVSOAK' ] ]
            sum9  : i64  [ Au.epoch_millis[] / 3000 ]
            want9 : bool [ (sum9 & 1) == 1 ]
            if [ want9 != show_orbiter ]
                show_orbiter = want9
                puts 'AVSOAK show={show_orbiter}'
                if [ ux ] ux.restyle = true
        attach_publish[]
        sync_volume[]
        for [ pi2: i32 0, pi2 < editor_slots.count, pi2 += 1 ]
            edp : Editor pane_at[ pi2 ]
            if [ !edp || !edp.run_view ] continue
            av : AppView edp.run_view
            if [ !av.attached && av.slot >= 0 ]
                apid : i32 [ host_app_pid[ av.slot ] ]
                if [ apid > 0 ]
                    if [ proc_stopped[ apid ] ]
                        adir8 : string [ '' ]
                        if [ av.src ]
                            ap8 : av.src.parent_dir[]
                            if [ ap8 ] adir8 = '{ap8}'
                        if [ module_has_breakpoints[ adir8 ] ]
                            attach_appview[ av, apid ]
                        el
                            # no breakpoints here: let it run, never trace it
                            kill[ apid, SIGCONT ]
                            av.attached = true
            if [ !edp.run_view.cmd ] continue
            if [ edp.run_view.dispatched ] continue
            edp.run_view.dispatched = true
            efn : string edp.src.filename[]
            edi : i32 [ efn.index_of[ '.' ] ]
            if [ edi > 0 ] efn = efn.mid[ 0, edi ]
            esid : string 'ed:{efn}'
            if [ !ed_sessions ] ed_sessions = map ConsoleSession [string] [ ]
            es : ConsoleSession ed_sessions[esid]
            if [ !es ]
                es = ConsoleSession []
                es.name = esid
                ed_sessions[esid] = es
            puts 'run: dispatch {esid}: {edp.run_view.cmd}'
            es.launch_cmd = ''
            es.restart[]
            es.pending = edp.run_view.cmd
        if [ ed_sessions ]
            for [ s: ConsoleSession, k: string ] in ed_sessions
                if [ s.pty_fd >= 0 ]
                    w.will_animate = true
                    s.read_output[]
        if [ ed_sessions ]
            ags : ConsoleSession ed_sessions[ orbit_sid ]
            if [ ags && ags.agent_busy[] ] busy_at = epoch_millis[]
            busy = (epoch_millis[] - busy_at) < 500
        if [ debuggers && ed_sessions ]
            for [ d: dbg, dn: string ] in debuggers
                if [ !d || !d.active ] continue
                ds : ConsoleSession ed_sessions[ dn ]
                if [ !ds ] continue
                w.will_animate = true
                ds.feed_fd[ d.fifo_fd_out ]
                ds.feed_fd[ d.fifo_fd_err ]

        if [ editor_slots.count == 0 ] editor_slots += -1
        pane_total : i32 [ editor_slots.count + ((agent_open) ? 1 : 0) ]
        for [ ci: i32 pane_total - 1, ci >= 1, ci -= 1 ]
            if [ take_closed[ 'pane{ci}' ] ] close_pane[ ci ]
        if [ !ed_sessions ] ed_sessions = map ConsoleSession [string] [ ]
        for [ pc: i32 0, pc < pane_console.count, pc += 1 ]
            if [ pane_console[pc] && pane_console[pc].count > 0 ]
                ensure_console[ pane_console[pc] ]
        if [ agent_open ] ensure_console[ orbit_sid ]
        ap9 : i32 [ agent_pane[] ]
        if [ ap9 > 0 ]
            ape9 : element find_el[ a, 'pane{ap9}' ]
            cw9  : f32 [ (ape9) ? ape9.extent : 0.0 ]
            if [ ape9 && cw9 <= 0.0 && console_w > 0 ]
                half9 : f32 [ ((bounds) ? bounds.w : 1200.0) * 0.5 ]
                use9  : f32 [ f32[ console_w ] ]
                ape9.extent = (use9 > half9) ? half9 : use9
            el [ cw9 > 0.0 && i32[ cw9 ] != console_w ]
                console_w      = i32[ cw9 ]
                console_w_save = 30
        if [ console_w_save > 0 ]
            console_w_save -= 1
            if [ console_w_save == 0 ] save_session[]
        for [ bi: i32 0, bi < editor_slots.count, bi += 1 ]
            pe9 : element find_el[ a, 'pane{bi}' ]
            if [ !pe9 ] continue
            be9 : element find_el[ pe9, 'band' ]
            if [ !be9 ] continue
            bh9 : f32 [ be9.extent ]
            if [ bh9 <= 0.0 && band_h > 0 ]
                half8 : f32 [ ((bounds) ? bounds.h : 900.0) * 0.5 ]
                use8  : f32 [ f32[ band_h ] ]
                be9.extent = (use8 > half8) ? half8 : use8
            el [ bh9 > 0.0 && i32[ bh9 ] != band_h ]
                band_h      = i32[ bh9 ]
                band_h_save = 30
        if [ band_h_save > 0 ]
            band_h_save -= 1
            if [ band_h_save == 0 ] save_session[]
        frame_no9 += 1
        if [ frame_no9 <= 30 ] puts 'frame {frame_no9} at {Au.epoch_millis[]}'
        if [ frost_dbg9 != frost_ix || (ux && frost_dbg8 != ux.frost_mode) ]
            puts 'FROST ix={frost_ix} mode={(ux) ? ux.frost_mode : -9} eff={(ux) ? ux.frost_eff[] : -9}'
            frost_dbg9 = frost_ix
            if [ ux ] frost_dbg8 = ux.frost_mode
            if [ ux && ux.st ] ux.solid_color = ux.st.theme_color[ '#140a2acc' ]
        if [ ux ] ux.frost_mode = frost_ix
        speed_apply[]
        if [ ux ] ux.orbit_mode = orbit_ix % orbit_list[].count
        if [ ux ] ux.angle_mode = angle_value[]

    # projection: inline panes in order, then the agent console
    func pane_views [] -> Elements
        t : Elements []
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            t['pane{i}'] = EditorView [ pane_index: i,
                selected: (search_pane[] == 'pane{i}') ]
        if [ agent_open ]
            t['pane{editor_slots.count}'] = EditorView [
                pane_index: editor_slots.count,
                selected: (search_pane[] == 'pane{editor_slots.count}') ]
        return t

    # right-flow: first inserted sits furthest right.
    # reload_busy/ready: staged reload button, or live compile status.
    # ui_hide sits dead center: scene-only toggle
    func status_els [] -> Elements
        return Elements [
            'scene_next'  : SceneArrow [ icon: 'right', manual_mode: true ],
            'scene_name'  : SceneName  [ label: scene_name[].lcase[] ],
            'scene_prev'  : SceneArrow [ icon: 'left', manual_mode: true ],
            'frost_name'  : SceneName  [ label: ux.frost_name[] ],
            'speed_name'  : SceneName  [ label: speed_name[] ],
            'orbit_name'  : SceneName  [ label: orbit_name[] ],
            'angle_name'  : SceneName  [ label: angle_name[] ],
            'reload_busy' : (au_live_get_pending[] == 2)
                ? ReloadStatus [ label: 'compiling...' ] : null,
            'reload_ready': (au_live_get_pending[] == 1)
                ? ReloadButton [ label: 'reload', manual_mode: true ] : null,
            'ui_hide'     : HideToggle [ label: '-', manual_mode: true ] ]

    # scene: built once per scene — a fresh element each frame churns its
    # Render; a per-scene key re-appends last and covers the ui.
    # panes: hide keeps them mounted at opacity 0 — no unmount churn.
    # avatar: ALWAYS mounted, window-anchored; :summoned slides it in.
    # error: ORBITER'S OWN state, one tab off the top edge — an error from
    # an app we happen to be running belongs to that app's run band
    public func render [] -> Elements
        return (!ux) ? null : Elements [
            'scene'  : scene_element[],
            'panes'  : Splitter [ area: Region { l0 t0 r0 b22px },
                inner: pane_views[], deflt: 0.0, even: true, snap_close: true,
                opacity: (hide_ui) ? 0.0 : 1.0 ],
            'status' : StatusBar [ elements: status_els[] ],
            'avatar' : OrbiterAvatar [ topmost: true, summoned: show_orbiter ],
            'error'  : (!hide_ui && err_file && err_line > 0 && err_is_own[])
                ? ErrorButton [ label: 'error {err_file.filename[]}:{err_line}',
                    topmost: true, manual_mode: true ] : null ]

    public func on_canvas [ cv: Canvas ]
        super.on_canvas[ cv ]
        cv.sync_fence[ ]
        # disk watch runs here: layer draws skip pristine editors
        for [ i9: i32 0, i9 < editor_slots.count, i9 += 1 ]
            e9 : Editor pane_at[ i9 ]
            if [ !e9 ] continue
            e9.check_disk[]
            if [ pending_sel && i9 < pending_sel.count ]
                ps9 : vec2i pending_sel[i9]
                if [ ps9.x >= 0 && e9.lines && e9.lines.count > 1 ]
                    l9 : i32 [ clamp[ ps9.x, 0, e9.lines.count - 1 ] ]
                    e9.sel_line    = l9
                    e9.sel_col     = ps9.y
                    e9.anchor_line = l9
                    e9.anchor_col  = ps9.y
                    e9.ensure_caret_visible[]
                    pending_sel[i9] = vec2i [ x: -1, y: -1 ]
