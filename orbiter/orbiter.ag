# window-wide strip; the pane splitter stops above it.
# the bar owns every gap in here, edges included, instead of each
# control carrying its own l8px/r0 offset
Group StatusBar
    style : CSS {
        area: l0 b1.06 r0 h1.06
        spacing_x: 1px
        spacing_y: 2px
        # 80% black; a faint border always, the pointer's light on it
        layers.sbar:
            fill_color: #000c, 400ms cubic outward
            box_shadow: inset 0 0 13px #8af2
            stroke_width: 1
            stroke_color: #fff1
            near_border: true
            near_inset: 1.0
            near_inset_color: #c890ffaa
    }

# the bottom bar: its task buttons flush on it, the bar's height
