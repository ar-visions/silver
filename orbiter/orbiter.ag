    func open_in_pane [ p: path, pi: i32 ]
        if [ pick_deliver[ p ] ] return
        # a file in the pane: its window steps back (the dock has it)
        if [ pane_win && pi >= 0 && pi < pane_win.count ]
            pane_win[ pi ] = u64[ 0 ]
        if [
            pi >= 0 && pi < editor_slots.count && pi < nav_panes.count ]
            cur : Editor pane_at[ pi ]
            if [ cur && cur.src ]
