    func file_slot [ p: path ] -> i32
        for [ i: i32 0, i < open_files.count, i += 1 ]
            if [ open_files[i] == p ] return i
        open_files.push[ p ]
        return open_files.count - 1

    public func on_overlay [ cv: Canvas ]
        # a slider swallows its press: poll its changed flag instead
        lp0 : element find_el[ a, 'launch_panel' ]
        if [ lp0 && lp0.elements ]
            for [ ce: element, ck: string ] in lp0.elements
                if [ ce inherits KeyField ]
                    kf : KeyField ce
                    if [ kf.changed ]
                        kf.changed = false
                        args_field  = ce
                        args_editor = pane_of[ ce ]
                        args_sync   = true
                    continue
                if [ ce inherits PadField ]
                    pf0 : PadField ce
                    if [ pf0.changed ]
                        pf0.changed = false
                        args_field  = ce
                        args_editor = pane_of[ ce ]
                        args_sync   = true
                    continue
                if [ ce inherits StepField ]
                    sf : StepField ce
                    if [ sf.changed ]
                        sf.changed = false
                        args_field  = ce
                        args_editor = pane_of[ ce ]
                        args_sync   = true
                    continue
                if [ !(ce inherits VolumeSlider) ] continue
                vs0 : VolumeSlider ce
                if [ vs0.changed ]
                    vs0.changed = false
                    args_field  = ce
                    args_editor = pane_of[ ce ]
                    args_sync   = true
        # run args are per source file, kept in the session state: the
        # field's edit is the one source, copied after the layer edited
        # it
        if [ args_sync ]
            args_sync = false
            fs9 : file_state args_state_of[ args_editor ]
            if [ fs9 && args_field ]
                if [
                    args_field.parent
                    && args_field.parent inherits LaunchPanel ]
                    lp9 : LaunchPanel args_field.parent
                    fs9.args = lp9.compose[]
                    # the instance keeps its own args; the file's config
                    # follows the last edit
                    if [ args_editor.run_view ]
                        args_editor.run_view.module_args = fs9.args
                    if [ args_editor.run_view && !args_editor.run_view.ended ]
                        push_live[ lp9, args_editor.run_view.sock_name[],
                                       args_field ]
                    if [ ux ] ux.restyle = true
                el fs9.args = (args_field.edit) ? args_field.edit : ''
                fs9.args.hold[]
                save_session[]
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            ed : Editor pane_at[ i ]
            if [ !ed || !ed.run_view || !ed.app_view ] continue
            av : AppView ed.run_view
            if [ !av.have_frame || av.fade_us == 0 ] continue
            fal : f32 [ f32[ epoch_micros[] - av.fade_us ] / 400000.0 ]
            if [ fal >= 1.0 ] continue
            if [ fal < 0.0 ] fal = 0.0
            wx : f32 [ av.vx ]
            wy : f32 [ av.vy ]
            for [ p: element* ed, p, p = p.parent ]
                if [ p.bounds ]
                    wx += p.bounds.x
                    wy += p.bounds.y
            cv.set_opacity[ fal ]
            av.draw_frame[ cv,
                           rect [ x: wx, y: wy, w: av.vw, h: av.vh ] ]
            cv.set_opacity[ 1.0 ]

    func stop_debug [ mod: string ]
