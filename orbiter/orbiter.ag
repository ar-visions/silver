# the nav list's view column: a shaded right edge, its buttons lit
Group ViewBar
    # at the window's edge (the side panel folded): no shading
    public on_edge : bool
    style : CSS {
        # a quarter-dark right edge, clear from three quarters across
        layers.vbar:
            fill_color: #00000040, 400ms cubic outward
            fill_color_pos: 1.0 0.0
            fill_gradient: linear
            fill_gradient_color: #0000
            fill_gradient_angle: 180.0
            fill_gradient_radius: 14.0
            # the bar itself takes no light: its buttons do
            stroke_width: 0
        :on_edge
            layers.vbar:
                fill_color: #0000
                fill_gradient: none
    }

