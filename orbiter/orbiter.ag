            return
        # clear: no map until the next coverage run writes one
        if [ ev.target.id == 'lp_coverage_clear' ]
            cc9 : string '{cov_file[]}'
            remove[ cc9.chars ]
            cov_poll[]
            if [ ev.target ] ev.target.ux.restyle = true
            ev.no_default = true
            return
        # a path's clear: its field goes empty, the args recompose
        if [ ev.target inherits LaunchClear ]
            fid : string ev.target.id.mid[ 0, ev.target.id.count - 6 ]
            fe : element find_el[ a, fid ]
            if [ fe && fe inherits LaunchPath ]
                lc : LaunchPath fe
                lc.path_value = ''
                lc.edit       = ''
                lc.label      = ''
                args_field  = fe
                args_editor = pane_of[ ev.target ]
                args_sync   = true
            if [ ev.target ] ev.target.ux.restyle = true
            ev.no_default     = true
            ev.no_propagation = true
            return
        # launch panel: a control change re-composes the run args next
        # frame
        if [ ev.target.id && ev.target.id.starts_with[ 'lp_' ] ]
            # a path: the nav list picks the file for it
            # an action: the running instance is asked to call it;
            # nothing to compose
            if [ ev.target inherits LaunchAction ]
                aed : Editor pane_of[ ev.target ]
                anm : string ev.target.id.mid[ 3, ev.target.id.count - 3 ]
                if [
                    aed && aed.run_view && !aed.run_view.ended
                    && !aed.run_view.held ]
                    agent_sock_send[ aed.run_view.sock_name[].chars,
                                     'call {anm}\n' ]
                ev.no_default     = true
                ev.no_propagation = true
                return
            if [ ev.target inherits LaunchPath ]
                lp8 : LaunchPath ev.target
                pick_field  = ev.target.id
                pick_dir    = lp8.is_dir
                pick_editor = pane_of[ ev.target ]
                # a resource: the module's exported extensions narrow
                # the list
                pick_exts  = vec string []
                pick_cache = null
                if [ lp8.is_resource && pick_editor ]
                    pick_editor.ensure_export_registry[]
                    bm8 : string band_mod_of[ pick_editor ]
                    if [ pick_editor.export_registry ]
                        for [ mod: string, ex: string ]
                            in pick_editor.export_registry
                            if [ mod == bm8 ] pick_exts.push[ ex ]
                cur9 : path (lp8.edit && lp8.edit.count > 0) ? path lp8.edit : null
                if [ cur9 && cur9.exists[] ]
                    nav_root = (cur9.is_dir[]) ? cur9 : cur9.parent_dir[]
                focus_finder[]
                run_search[]
                ev.no_default     = true
                ev.no_propagation = true
                return
            # a slider drives itself (drag) and reports via `changed`,
            # polled in on_overlay; do NOT consume its press or it can't
            # move. a key field arms itself the same way and reports
            # once a key lands
            if [
                ev.target inherits VolumeSlider
                || ev.target inherits KeyField ||
                ev.target inherits PadField
                || ev.target inherits StepField ] return
            # no_default below stops the click, so a chip toggles here
            if [ ev.target inherits Check ]
                ck : Check ev.target
                ck.selected = !ck.selected
            args_field  = ev.target
            args_editor = pane_of[ ev.target ]
            args_sync   = true
            ev.no_default = true
            return

        # back to the source of the app this band is running
        if [ ev.target.id == 'gotosrc' ]
            ed6 : Editor pane_of[ ev.target ]
            if [ ed6 ]
                bs6 : path ed6.band_src[]
                if [ bs6 ] open_in_pane[ bs6, ed6.pane_index ]
            ev.no_default = true
            if [ ev.target ] ev.target.ux.restyle = true
            return

        if [ ev.target.id == 'title_close' ]
            exit_finder[]
            findbar_open = false
            ev.no_default = true
            if [ ev.target ] ev.target.ux.restyle = true
            force_update[]
            return

        if [ ev.target.id == 'finder_close' ]
            exit_find_mode[]
            ev.no_default = true
            if [ ev.target ] ev.target.ux.restyle = true
            force_update[]
            return

        if [
            ev.target.id == 'finder_back'
            || ev.target.id == 'finder_fwd' ]
            nav_step[ (ev.target.id == 'finder_back') ? -1 : 1 ]
            ev.no_default = true
            if [ ev.target ] ev.target.ux.restyle = true
            return

        # a file's view in the bar (pview:<pane>:<view>)
        if [ ev.target.id && ev.target.id.starts_with[ 'pview:' ] ]
            pw : string ev.target.id.mid[ 6, ev.target.id.count - 6 ]
            cw : i32 [ pw.index_of[ ':' ] ]
            if [ cw > 0 ]
                pq : i32 [ pw.mid[ 0, cw ].integer_value[] ]
                if [ pq >= 0 && pq < editor_slots.count ]
                    active_pane = pq
                    pane_view_press[ pane_at[ pq ],
                        pw.mid[ cw + 1, pw.count - cw - 1 ] ]
            ev.no_default = true
            return
        # a pane's own arrows (nav_back:<pane>), else the active one's
        nid : string ev.target.id
        if [ nid && (nid.starts_with[ 'nav_back' ]
                     || nid.starts_with[ 'nav_fwd' ]) ]
            cn : i32 [ nid.index_of[ ':' ] ]
            npi : i32 [ (cn > 0) ? i32[ nid.mid[ cn + 1,
                nid.count - cn - 1 ] ] : active_pane ]
            edn : Editor pane_at[ npi ]
            if [ edn ]
                edn.nav_walk[ (nid.starts_with[ 'nav_back' ]) ? -1 : 1 ]
            ev.no_default = true
            if [ ev.target ] ev.target.ux.restyle = true
            return

        if [ ev.target.id == 'magnify' ]
            findbar_open = !findbar_open
            if [ findbar_open ] pending_findfocus = true
            for [ e: element* ev.target, e, e = e.parent ]
                if [ e inherits EditorView ]
                    findbar_pane = e.id
                    break
            # closing the bar hides the results
            if [ !findbar_open ] find_showing = false
            if [ ev.target ] ev.target.ux.restyle = true
            return
        
        if [ ev.target.id == 'close_find' ]
            findbar_open = false
            find_showing = false
            if [ ev.target ] ev.target.ux.restyle = true
            ev.no_default = true
            force_update[]
            return
        
        if [ ev.target.id == 'replace' ]
            ev.target.sel_col    = ev.target.edit->count
            ev.target.anchor_col = ev.target.sel_col
            ev.target.set_focus[]
            force_update[]
            return

        # the title's red x, the view bar's minus: this pane goes
        if [ ev.target.id == 'pane_close' ]
            edu : Editor pane_of[ ev.target ]
            if [ edu ] close_pane[ edu.pane_index ]
            if [ ev.target ] ev.target.ux.restyle = true
            return

        if [ ev.target.id == 'pane_add' ]
            pane_add[]
            if [ ev.target ] ev.target.ux.restyle = true
            return
        if [ ev.target.id.starts_with[ 'cmp_' ] ]
            tid9 : string ev.target.id
            ex  : string tid9.mid[ 4, tid9.count - 4 ]
            ed9  : Editor pane_of[ ev.target ]
            pi  : i32 [ (ed9) ? ed9.pane_index : active_pane ]
            f9   : path (ed9) ? ed9.src : null
            cp  : path companion_path[ f9, ex ]
            if [ cp ] open_in_pane[ cp, pi ]
            if [ ev.target ] ev.target.ux.restyle = true
            ev.no_default = true
            return
        # the instance panel's section tabs: the lit one is open, a
        # press on it folds it away. one row for all three, so this is
        # the only toggle
        if [
            ev.target.id == 'properties'
            || ev.target.id == 'instruments'
            || ev.target.id == 'callstack' ]
            wp : bool [ props_open ]
            wi : bool [ instr_open ]
            ws : bool [ stack_open ]
            props_open = (ev.target.id == 'properties') && !wp
            instr_open = (ev.target.id == 'instruments') && !wi
            stack_open = (ev.target.id == 'callstack') && !ws
            if [ ev.target ] ev.target.ux.restyle = true
            ev.no_default = true
            return
        # the callstack's one toggle: list frames with no known source,
        # or not
        if [ ev.target.id == 'show unknown source' ]
            stack_unknown = !stack_unknown
            if [ ev.target ] ev.target.ux.restyle = true
            ev.no_default = true
            return
        if [ ev.target.id == 'ctx_copy' ]
            request_context[]
            if [ ev.target ] ev.target.ux.restyle = true
            return
        if [ ev.target.id == 'ctx_shot' ]
            fn : string snap_window[ ev.target.ux ]
            if [ fn ] feed_agent[ fn + ' ' ]
            if [ ev.target ] ev.target.ux.restyle = true
            return
        tid : string ev.target.id
        if [ ev.target.id == 'config' ]
            rel_x    : f32 [ ev.mouse.pos.x - ev.target.bounds.x ]
            in_right : bool [ rel_x > ev.target.bounds.w - 14.0 ]
            if [ ev.key.shift || in_right ]
                config_side = (config_side == 1) ? 0 : 1
            el
                active_panel = 'config'
            sync_tabs[]
            return
        if [ ev.target inherits Option ]
            oid : string ev.target.id
            if [ oid == 'system' ]
                active_target = 'system'
                nav_root = path '{startup_path}'
                reroot_index[]
                rekeep_listing[]
                sync_active[]
                save_session[]
                ev.no_default = true
            el
                matched : bool false
                for [ i: i32 0, i < target_names.count, i += 1 ]
                    if [ target_names[i] == oid ]
                        active_target = oid
                        nav_root      = target_roots[i]
                        matched       = true
                if [ !matched ]
                    active_panel = oid
                if [ matched ]
                    reroot_index[]
                    rekeep_listing[]
                    sync_active[]
                    save_session[]
                    ev.no_default = true
            if [ ev.target ] ev.target.ux.restyle = true
            return

    # only the first dropped file opens — one tab, not one per file
    func on_drop [ ev: Event ]
        if [ !ev.paths || ev.paths.count == 0 ] return
        open_file[ ev.paths[ 0 ] ]

    func on_char [ ev: Event ]
        # the login takes every key until it is passed
        if [ login_wait[] ]
            if [ login_sel >= 0 && ev.key.text ]
                login_pass = '{login_pass}{ev.key.text}'
                login_note = ''
                if [ ux ] ux.restyle = true
            return
        # the bar's title being typed: the first key replaces it
        if [ bar_typing && ev.key.text && ev.key.text.count > 0 ]
            bar_text  = (bar_fresh) ? ev.key.text
                : '{bar_text}{ev.key.text}'
            bar_fresh = false
            if [ ux ] ux.restyle = true
            return
        # typing with the drawer open filters its menu
        if [ drawer_open && menu_kind != 'system' && ev.key.text
             && ev.key.text.count > 0 ]
            menu_filter = '{menu_filter}{ev.key.text}'
            if [ ux ] ux.restyle = true
            return
        # typing on the apps screen filters the apps
        if [ apps_typing[] && ev.key.text && ev.key.text.count > 0 ]
            apps_filter = '{apps_filter}{ev.key.text}'
            if [ ux ] ux.restyle = true
            return
        if [ !ev.target ] return
        if [ ev.target.id == 'filter' ]
            if [ ev.key.text && ev.key.text.count > 0 ]
                filter_text = filter_text + ev.key.text
                uxw : Window ev.target.ux
                if [ uxw ] uxw.will_animate = true
        # the find/replace/pattern rows: the editable layer owns the
        # text, and findbar_sync copies the field's edit before a search
        if [
            ev.target.id == 'find' || ev.target.id == 'replace'
            || ev.target.id == 'pattern' ]
            if [ ev.key.text && ev.key.text.count > 0 ]
                ev.target.pristine = false
                uxw : Window ev.target.ux
                if [ uxw ] uxw.will_animate = true
        # run args are per source file, kept in the session state
        if [ ev.target.id && ev.target.id.starts_with[ 'lp_' ] ]
            # the editable layer edits the text after this; the session
            # copies the field's edit next frame (args_sync)
            if [ ev.key.text && ev.key.text.count > 0 ]
                args_field  = ev.target
                args_editor = pane_of[ ev.target ]
                args_sync   = true
                ev.target.pristine = false
                uxw : Window ev.target.ux
                if [ uxw ] uxw.will_animate = true
        # a URL being typed: the field's own edit takes it
        if [ ev.target.id == 'title' && url_entry_on ] return
        # typing into an editor's title: it finds in the file
        if [ ev.target.id == 'title' && title_finds[]
             && ev.key.text && ev.key.text.count > 0 ]
            if [ !findbar_text || findbar_text.count == 0 ]
                ed9 : Editor pane_at[ active_pane ]
                find_from_line = (ed9 && ed9.sel_line >= 0)
                    ? ed9.sel_line : 0
                find_from_col  = (ed9 && ed9.sel_col >= 0)
                    ? ed9.sel_col : 0
                findbar_text = ''
            findbar_text = '{findbar_text}{ev.key.text}'
            find_live[]
            ev.target.pristine = false
            if [ ev.target.ux ] ev.target.ux.restyle = true
            return
        # typing into an editor's title (the finder/magnify control)
        if [ ev.target.id == 'title' ]
            if [ ev.key.text && ev.key.text.count > 0 ]
                nv9 : EditorView newfile_view[ ev.target ]
                if [ nv9 ]
                    nv9.newfile_text = nv9.newfile_text + ev.key.text
                    ev.target.pristine = false
                    if [ ev.target.ux ] ev.target.ux.restyle = true
                    return
                find_text = find_text + ev.key.text
                ev.target.pristine = false
                run_search[]

    func on_key [ ev: Event ]
        ks : i32 [ ev.key.unicode ]
        if [ login_wait[] ]
            if [ ev.key.state ] login_key[ ks ]
            ev.no_default = true
            return
        # a program's folder pick: Enter with nothing typed takes the
        # folder shown, wherever the focus is
        if [ ks == 257 && ev.key.state && pick_field == 'portal'
             && pick_dir && nav_root
             && (!find_text || find_text.count == 0) ]
            portal_deliver[ nav_root ]
            ev.no_default = true
            return
        # cmd / ctrl + 1 2 3: the platform's avatars held in one
        # state to check it (halo, edits, beam); the same again lets go
        if [ ev.key.state && ux && ux.cmd && ks >= 49 && ks <= 51 ]
            want : i32 [ ks - 48 ]
            avatar_mode = (avatar_mode == want) ? 0 : want
            ev.no_default = true
            return
        # cmd / ctrl + q: the selected pane's app quits (its window
        # is asked to close)
        if [ ks == 81 && ev.key.state && ux && ux.cmd ]
            if [ quit_pane_app[] ]
                ev.no_default = true
                return
        # the bar's title being typed: Enter takes it, Esc leaves it,
        # Backspace edits
        if [ bar_typing && ev.key.state ]
            if [ ks == 257 ]
                bar_title_apply[]
                return
            if [ ks == 256 ]
                bar_typing = false
                if [ ux ] ux.restyle = true
                return
            if [ ks == 259 ]
                bar_text  = (bar_fresh || bar_text.count == 0) ? ''
                    : bar_text.mid[ 0, bar_text.count - 1 ]
                bar_fresh = false
                if [ ux ] ux.restyle = true
                return
        # the open drawer's keys: Esc clears its filter, else shuts it;
        # Backspace edits the filter; Enter runs the first match
        if [ drawer_open && ev.key.state ]
            if [ ks == 256 ]
                if [ menu_filter.count > 0 ] menu_filter = ''
                el drawer_shut[]
                if [ ux ] ux.restyle = true
                return
            if [ ks == 259 && menu_filter.count > 0 ]
                menu_filter = menu_filter.mid[ 0, menu_filter.count - 1 ]
                if [ ux ] ux.restyle = true
                return
            if [ ks == 257 ]
                drawer_enter[]
                return
        # the apps screen's filter: Esc clears it, Backspace edits it,
        # Enter opens the first match
        if [ apps_typing[] && ev.key.state && apps_filter.count > 0 ]
            if [ ks == 256 ]
                apps_filter = ''
                if [ ux ] ux.restyle = true
                return
            if [ ks == 259 ]
                apps_filter = apps_filter.mid[ 0, apps_filter.count - 1 ]
                if [ ux ] ux.restyle = true
                return
            if [ ks == 257 ]
                ag : cast AppsGrid [ find_el[ a, 'apps' ] ]
                if [ ag && ag.shown && ag.shown.count > 0 ]
                    top : AppEntry ag.shown[ 0 ]
                    apps_filter = ''
                    apps_pick[ active_pane, top ]
                if [ ux ] ux.restyle = true
                return
        # Esc while recording from orbiter's button: the take is dropped
        if [ ks == 256 && ev.key.state && mic_by_press ]
            mic_by_press = false
            if [ orbit_cap_on ]
                dictation_cancel[]
                orbit_cap_on   = false
                orbit_flushing = false
            listen_file = null
            listen_shot = null
            if [ ux ] ux.restyle = true
            ev.no_default = true
            return
        # cmd/ctrl + left/right with the nav view up: its own back and
        # forward
        if [
            ev.key.state && (ev.key.ctrl || ev.key.meta) && nav_showing
            && (ks == 263 || ks == 262) ]
            nav_step[ (ks == 263) ? -1 : 1 ]
            ev.no_default = true
            return
        # global chords need no focus target
        if [ ev.key.state && (ev.key.ctrl || ev.key.meta) ]
            kc : i32 [ ev.key.unicode ]
            if [ kc == 70 ]    # 'F'
                # with the system bar: the title finds in the file, on
                # and off
                ef : Editor pane_at[ active_pane ]
                if [ system_on[] && ef && ef.src && !ef.app_view ]
                    title_find_toggle[]
                el
                    open_find[]
                ev.no_default = true
                return
            # 'D': the file in view goes on the dock (again: off); a
            # module's own source pins as its module
            if [ kc == 68 ]
                if [ ev.key.state == 1 ]
                    edk : Editor pane_at[ active_pane ]
                    mk : path (edk) ? module_src_of[ edk ] : null
                    pk : path (mk) ? mk.parent_dir[]
                        : ((edk) ? edk.src : null)
                    if [ pk && pk.exists[] ]
                        pin_toggle[ pk ]
                        if [ ux ] ux.restyle = true
                ev.no_default = true
                return
            if [ kc == 71 || kc == 79 ]    # 'G' / 'O' — focus the title
                focus_finder[]
                ev.no_default = true
                return
            if [ kc == 96 ]    # '`' — summon/dismiss the orbiter helper
                # key repeats must not re-toggle
                if [ ev.key.state == 1 ]
                    show_orbiter = !show_orbiter
                    # summon starts the mic; dismiss stops and submits
                    # the take
                    if [ show_orbiter != listening[] ]
                        toggle_listen[ null ]
                    if [ ux ] ux.restyle = true
                ev.no_default = true
                return
        # escape peels ONE layer per press, innermost first: the find
        # bar, then the finder, before the chosen view is given up
        if [ ev.key.state && i32[ ev.key.unicode ] == 256
             && title_find_on ]
            title_find_end[ title_at[ active_pane ] ]
            ev.no_default = true
            return
        if [
            ev.key.state && i32[ ev.key.unicode ] == 256
            && (findbar_open || find_showing || nav_showing) ]
            exit_find_mode[]
            ev.no_default = true
            return
        # the pane the key came from wins; the active pane is the
        # fallback
        eda : Editor pane_of[ ev.target ]
        if [ !eda ] eda = pane_at[ active_pane ]
        chosen : bool [
            eda && ((eda.view_name && eda.view_name.count > 0)
            || (eda.diff_commit && eda.diff_commit.count > 0)) ]
        if [ ev.key.state && i32[ ev.key.unicode ] == 256 && chosen ]
            eda.diff_commit = null
            # escape on the reference list cancels the diff view
            # outright
            if [ eda.view_name == 'git' ] eda.git_on = false
            set_pane_view[ eda, '' ]
            if [ ux ] ux.restyle = true
            ev.no_default = true
            return

        if [ !ev.target ] return
        # Return in the list opens the highlighted row
        if [
            ev.key.state && i32[ ev.key.unicode ] == 257
            && (nav_showing || find_showing)
            && ev.target inherits Editor ]
            edr : Editor ev.target
            if [
                edr.hover_line >= 0
                && hit_activate[ edr, edr.hover_line, true ] ]
                ev.no_default = true
                if [ ux ] ux.restyle = true
                return
        if [ ev.target.id == 'filter' ]
            if [ !ev.key.state ] return
            k : i32 [ i32 ev.key.unicode ]
            changed : false
            if [ k == 259 ]    # Key.Backspace
                if [ filter_text && filter_text.count > 0 ]
                    filter_text = filter_text.mid[ 0,
                                                   filter_text.count
                                                   - 1 ]
                    changed = true
            el [ k == 256 ]    # Key.Escape
                filter_text = ''
                changed = true
            if [ changed ]
                uxw : Window ev.target.ux
                if [ uxw ] uxw.will_animate = true

        if [ ev.target.id && ev.target.id.starts_with[ 'lp_' ] ]
            # backspace, arrows and escape (clear) are the editable
            # layer's; the session copies the field's edit next frame
            # (args_sync)
            if [ !ev.key.state ] return
            args_field  = ev.target
            args_editor = pane_of[ ev.target ]
            args_sync   = true
            ev.target.pristine = false
            if [ ev.target.ux ] ev.target.ux.will_animate = true
            return

        if [
            ev.target.id == 'find' || ev.target.id == 'replace'
            || ev.target.id == 'pattern' ]
            if [ !ev.key.state ] return
            k : i32 [ i32 ev.key.unicode ]
            # C / V / X
            if [
                (ev.key.ctrl || ev.key.meta)
                && (k == 67 || k == 86 || k == 88) ]
                w9  : Window ev.target.ux
                cur : string [ (ev.target.edit) ? ev.target.edit : '' ]
                if [ k != 86 && w9 && cur && cur.count > 0 ]
                    w9.set_clipboard[ cur ]
                if [ k == 88 ] cur = ''
                if [ k == 86 && w9 ]
                    clip : string w9.get_clipboard[]
                    if [ clip ]
                        nl : i32 [ clip.index_of[ '\n' ] ]
                        if [ nl >= 0 ] clip = clip.mid[ 0, nl ]
                        if [ clip.count > 0 ] cur = cur + clip
                ev.target.edit    = cur
                ev.target.sel_col = cur.count
                ev.target.anchor_col = cur.count
                findbar_sync[]
                ev.target.pristine = false
                if [ ev.target.ux ] ev.target.ux.will_animate = true
                ev.no_default = true
                return
            # Key.Backspace — the editable layer edits
            if [ k == 259 ]
                findbar_sync[]
            el [ k == 257 ]    # Key.Enter
                findbar_sync[]
                in_file : bool [ find_in_file[] ]
                log 'FIND enter: tgt={ev.target.id} q="{findbar_text}" pat="{pattern_text}" in_file={(in_file) ? 1 : 0}'
                if [ ev.target.id == 'replace' ]
                    run_replace[]
                el [ in_file ]
                    find_last_query = findbar_text
                    find_last_scope = ''
                    find_file_next[]
                el
                    cur_scope  : '{(pattern_text) ? pattern_text : ''}|{(search_remotes) ? 1 : 0}'
                    last_scope : string [
                        (find_last_scope) ? find_last_scope : '' ]
                    scope_same : bool [
                        cur_scope.compare[ last_scope ] == 0 ]
                    same : bool [
                        scope_same && find_showing && !find_busy
                        && find_has_hits[] && find_last_query
                        && findbar_text
                        && find_last_query.compare[ findbar_text ] == 0 ]
                    # files changed since the scan: the results lie —
                    # rescan
                    if [ same && tree_mtime[ project_root[] ] > find_scan_mt ]
                        same = false
                    if [ same ]
                        next_match[]
                    el
                        run_find_in_files[]
                if [ ev.target.ux ] ev.target.ux.restyle = true
            el [ k == 256 ]    # Key.Escape
                # escape collapses the bar and hides the results
                find_busy    = false
                findbar_open = false
                find_showing = false
                ev.target.ux.restyle = true
            ev.target.pristine = false
            uxw : Window ev.target.ux
            if [ uxw ] uxw.will_animate = true

        # the title's argument: enter sends it live, escape drops it
        if [ ev.target.id == 'arg_edit' && ev.key.state ]
            ka : i32 [ i32 ev.key.unicode ]
            if [ ka == 257 || ka == 256 ]
                ea : Editor pane_of[ ev.target ]
                ra : AppView (ea) ? ea.run_view : null
                pa9 : Prop (ra && ra.app_mod) ? live_default[
                    ra.app_mod ] : null
                if [ ka == 257 && pa9 && !ra.ended ]
                    ra.arg_text = (ev.target.edit) ? ev.target.edit : ''
                    agent_sock_send[ ra.sock_name[].chars,
                                     'set {pa9.ident} {ra.arg_text}\n' ]
                ev.target.edit = ''
                if [ ux ] ux.release_focus[ ev.target ]
                force_update[]
                ev.no_default = true
                return

        # finder title: backspace trims, enter opens the typed file
        # a URL typed in the pane's bar: the field edits; Enter takes it,
        # Esc leaves it
        if [ ev.target.id == 'title' && ev.key.state && url_entry_on ]
            ku : i32 [ i32 ev.key.unicode ]
            if [ ku == 257 ]
                bar_text = (ev.target.edit) ? ev.target.edit : ''
                url_entry_end[ ev.target ]
                bar_title_apply[]
                ev.no_default = true
            el [ ku == 256 ]
                url_entry_end[ ev.target ]
                ev.no_default = true
            return
        # the title finding in the file: Backspace edits, Enter the
        # next match, Esc ends it
        if [ ev.target.id == 'title' && ev.key.state && title_finds[]
             && !newfile_view[ ev.target ] ]
            kf : i32 [ i32 ev.key.unicode ]
            if [ kf == 259 ]
                if [ findbar_text && findbar_text.count > 0 ]
                    findbar_text = findbar_text.mid[ 0,
                        findbar_text.count - 1 ]
                find_live[]
            el [ kf == 257 ]
                find_file_next[]
            el [ kf == 256 ]
                title_find_end[ ev.target ]
            el
                return
            ev.target.pristine = false
            if [ ev.target.ux ] ev.target.ux.restyle = true
            ev.no_default = true
            return
        if [ ev.target.id == 'title' ]
            if [ !ev.key.state ] return
            k : i32 [ i32 ev.key.unicode ]
            kv : EditorView newfile_view[ ev.target ]
            # C / V / X
            if [
                (ev.key.ctrl || ev.key.meta)
                && (k == 67 || k == 86 || k == 88) ]
                w9  : Window ev.target.ux
                cur : string [ (kv) ? kv.newfile_text : find_text ]
                if [ k != 86 && w9 && cur && cur.count > 0 ]
                    w9.set_clipboard[ cur ]
                if [ k == 88 ] cur = ''
                if [ k == 86 && w9 ]
                    clip : string w9.get_clipboard[]
                    if [ clip ]
                        nl : i32 [ clip.index_of[ '\n' ] ]
                        if [ nl >= 0 ] clip = clip.mid[ 0, nl ]
                        if [ clip.count > 0 ] cur = cur + clip
                if [ kv ]
                    kv.newfile_text = cur
                el
                    find_text = cur
                    if [ k != 67 ] run_search[]
                ev.target.pristine = false
                if [ ev.target.ux ] ev.target.ux.restyle = true
                ev.no_default = true
                return
            if [ kv ]
                # Key.Backspace
                if [
                    k == 259 && kv.newfile_text
                    && kv.newfile_text.count > 0 ]
                    kv.newfile_text = kv.newfile_text.mid[ 0,
                                                           kv.newfile_text.count - 1 ]
                # Key.Enter — create unless the name exists
                el [ k == 257 ]
                    kv.newfile_commit[]
                el [ k == 256 ]    # Key.Escape — no action
                    kv.newfile_exit[]
                ev.target.pristine = false
                if [ ev.target.ux ] ev.target.ux.restyle = true
                ev.no_default = true
                return
            if [ k == 259 ]    # Key.Backspace
                if [ find_text && find_text.count > 0 ]
                    find_text = find_text.mid[ 0, find_text.count - 1 ]
                    ev.target.pristine = false
                    run_search[]
            el [ k == 257 ]    # Key.Enter
                handled : bool false
                # a scheme some module exports (https://) opens there
                edu : Editor pane_at[ active_pane ]
                if [ find_text && edu && edu.open_url[ find_text ] ]
                    exit_finder[]
                    if [ ev.target.ux ] ev.target.ux.restyle = true
                    handled = true
                if [
                    !handled && find_text && find_text.count > 1
                    && find_text[0] == ':' ]
                    num : string find_text.mid[ 1, find_text.count - 1 ]
                    if [ num.is_numeric[] ]
                        ed : Editor pane_at[ active_pane ]
                        if [ ed ]
                            if [ ed.nav && ed.src ]
                                ed.nav.record[ active_pane,
                                               '{ed.src.absolute[]}',
                                               ed.sel_line, ed.sel_col,
                                               ed.scroll.y ]
                            sl : i32 [ num.integer_value[] ]
                            sl = (sl > 0) ? sl - 1 : 0
                            ed.sel_line    = sl
                            ed.sel_col     = 0
                            ed.anchor_line = sl
                            ed.anchor_col  = 0
                            # reveal the line (centered-ish), pinning
                            # scroll_target
                            lh : f32 [
                                (ed.lh_cache > 0.0) ? ed.lh_cache
                                : 22.0 ]
                            vh : f32 [
                                (ed.bounds) ? ed.bounds.h : 600.0 ]
                            tp : f32 [ f32[ sl ] * lh ]
                            if [
                                tp < ed.scroll.y
                                || tp + lh > ed.scroll.y + vh ]
                                ed.scroll.y      = tp - vh * 0.4
                                if [ ed.scroll.y < 0.0 ]
                                    ed.scroll.y = 0.0
                                ed.scroll_target = ed.scroll.y
                            ed.saved_scroll = ed.scroll.y
                            ed.pristine = false
                        exit_finder[]
                        if [ ev.target.ux ] ev.target.ux.restyle = true
                        handled = true
                # owner:name: the repository itself, never a file that
                # happens to match. checked out, it is selected like its
                # column rows (user and project, its files showing, its
                # module open); missing, its clone starts and the
                # listing stays up with the row's progress
                if [ !handled ]
                    ru : string repo_user_of[ find_text ]
                    if [
                        ru && ru.count > 0
                        && find_text.count > ru.count + 1 ]
                        rn8 : string find_text.mid[ ru.count + 1, find_text.count - ru.count - 1 ]
                        ex : RepoInfo repo_one[ ru, rn8 ]
                        full8 : string (ex) ? ex.full : '{ru}/{rn8}'
                        key8  : string repo_key[ full8 ]
                        side_user = ru
                        if [ repo_local[ key8 ] ]
                            side_pick_project[ key8 ]
                        el
                            repo_checkout[ full8, active_pane ]
                            run_search[]
                        ev.target.pristine = false
                        handled = true
                if [
                    !handled && find_results && find_results.count > 0 ]
                    first_s    : string find_results.value_by_index[ 0 ]
                    first_path : path [ first_s.chars ]
                    # a program runs, as a click on its row does
                    if [ is_program[ first_path ] ]
                        run_program[ first_path, active_pane ]
                        exit_finder[]
                    el
                        open_file[ first_path ]
            # Key.Down — enter the nav list when it shows
            el [ k == 264 ]
                if [ nav_showing ]
                    sp8 : string search_pane[]
                    ed8 : Editor null
                    for [ i: i32 0, i < editor_slots.count, i += 1 ]
                        e8 : Editor pane_at[ i ]
                        if [ e8 && sp8 == 'pane{i}' ] ed8 = e8
                    if [ !ed8 ] ed8 = pane_at[ active_pane ]
                    if [ ed8 ]
                        ed8.hover_line = -1
                        ed8.hover_step[ 1 ]
                        ed8.set_focus[]
                        ed8.pristine = false
                    ev.no_default = true
            # Key.Tab — toggle single-line / double-header density
            el [ k == 258 ]
                browse_single = !browse_single
                ev.target.pristine = false
                run_search[]
                if [ ev.target.ux ] ev.target.ux.restyle = true
            el [ k == 256 ]    # Key.Escape
                exit_finder[]
                ev.target.pristine = false
                if [ ev.target.ux ] ev.target.ux.restyle = true
    
    # per-frame servicing (host slots, release gate, debugger attach,
    # consoles, sessions) is state work in tick: nothing here paints, so
    # a live instance never repaints the whole app; it only keeps frames
    # coming
    public func tick [ w: Window ]
        session_follow[]
        if [ instances && instances.count > 0 ] w.will_animate = true
        repo_pump[ w ]
        repo_fetch_pump[ w ]
        repo_one_pump[ w ]
        if [ orbit_cap_on ] dictation_gpu[ Canvas w.screen ]
        mic_frame[]
        if [ findbar_open ] findbar_sync[]
        find_step[]

        if [ cycle ]
            cycle_frame += 1
            if [ cycle_frame % 30 == 0 ]
                if [ cycle_adding ]
                    if [ editor_slots.count < 4 ]
                        editor_slots += -1
                        pane_console += ''
                        active_pane = editor_slots.count - 1
                        save_session[]
                    el
                        cycle_adding = false
                el
                    if [ editor_slots.count > 1 ]
                        close_pane[ editor_slots.count - 1 ]
                    el
                        cycle_adding = true
                        cycle_count += 1
                        log 'CYCLE {cycle_count}'

        if [ au_mem_fraction[] > 0.20 ]
            log 'orbiter: memory exceeded 20% of system RAM — quitting '
            exit[ 1 ]

        if [ index_research && !index_building ]
            index_research = false
            run_search[]

        bpc : i32 [ breakpoints->count ]
        if [ last_bp_count >= 0 && bpc != last_bp_count ]
            save_session[]
        last_bp_count = bpc
        if [ pending_finder >= 0 ]
            fte : element title_at[ pending_finder ]
            if [ fte ]
                fte.set_focus[]
                pending_finder = -1
        # an instance's orbiter button: select it here and bring this
        # window forward (the app never becomes a second orbiter)
        if [ instances ]
            for [ dv: AppView ] in instances
                if [ dv.dict_req < 0 ] continue
                dr : i32 [ dv.dict_req ]
                dv.dict_req = -1
                dictate_to[ dv.slot, dr ]
            for [ wv9: AppView ] in instances
                if [ !wv9.wants_ide ] continue
                wv9.wants_ide = false
                wp : i32 [ active_pane ]
                for [ pq: i32 0, pq < editor_slots.count, pq += 1 ]
                    eq : Editor pane_at[ pq ]
                    if [ eq && eq.run_view == wv9 ] wp = pq
                show_instance[ wv9.iid, wp ]
                if [ ux ] ux.set_shown[ true ]
        if [ pending_held >= 0 ] 
            hed : Editor pane_at[ pending_held ]
            if [
                hed && hed.src
                && (!pending_held_src || '{hed.src.absolute[]}' == '{pending_held_src.absolute[]}') ]
                # one held instance per coupled app: coming back to
                # orbiter again finds the one already there (the newest)
                hv : AppView [ null ]
                if [ instances ]
                    for [ iv: AppView ] in instances
                        if [ iv.held && iv.src && '{iv.src}' == '{hed.src}' ]
                            hv = iv
                if [ !hv ]
                    hed.start_instance[ false ]
                    hv = hed.run_view
                # the instance we came from is the pane's selection; the
                # source stays in the pane until it starts
                hed.run_view = hv
                hed.app_view = false
                home_av      = hv
                # its picture from before the switch fills the pip
                shot : cstr [ getenv[ 'SILVER_SWITCH_SHOT' ] ]
                if [ shot && hv && ux && ux.screen ]
                    im9 : Image [ '{shot}' ]
                    if [ im9.width > 0 && im9.height > 0 ]
                        hv.still = Texture [ vk: ux.screen.vk,
                                             w: ux.screen.w,
                                             sampler: im9,
                            width: im9.width, height: im9.height,
                            linear: true ]
                        hv.aw = im9.width
                        hv.ah = im9.height
                if [ ux ] ux.restyle = true
                pending_held     = -1
                pending_held_src = null
        if [ pending_run >= 0 ]
            red : Editor pane_at[ pending_run ]
            if [ red ]
                # one that ended (quit, failed) gives way to a new one
                if [ red.run_view && red.run_view.ended ]
                    red.run_view = null
                if [ !red.run_view ] red.toggle_app_run[ false ]
                # launched on this app: its held instance takes the pane
                # and runs
                rv : AppView red.run_view
                if [ rv ]
                    if [
                        rv.held && rv.src && red.src
                        && '{rv.src}' == '{red.src}' ]
                        li9 : vec AppView red.instances[]
                        for [ i9: i32 0, i9 < li9.count, i9 += 1 ]
                            if [ li9[ i9 ] == rv ]
                                red.select_instance[ i9 ]
                        set_display[ red, rv, 1 ]
                        instance_action[ red, rv, 'play' ]
                pending_run = -1
        if [ pending_findfocus ]
            if [ !findbar_open ]
                pending_findfocus = false
            el [ findbar_pane && findbar_pane.count > 4 ]
                fpi : i32 [
                    findbar_pane.mid[ 4,
                                      findbar_pane.count
                                      - 4 ].real_value[] ]
                fte2 : element title_at[ fpi ]
                if [ fte2 && fte2.elements ]
                    ffe : element fte2.elements['find']
                    if [ ffe ]
                        ffe.set_focus[]
                        pending_findfocus = false
        fin_now : bool   [
            (w.focus && w.focus.id == 'title')
            || (find_text && find_text.count > 0) || list_focused[] ]
        sp_now  : string search_pane[]
        if [ fin_now != was_finder || sp_now != was_search_pane ]
            # opened from a module: list its own folder
            ms8 : path (fin_now && !was_finder) ? module_src_of[ pane_at[ active_pane ] ] : null
            if [ ms8 ] nav_root = ms8.parent_dir[]
            run_search[]
        was_finder      = fin_now
        was_search_pane = sp_now
        now_ms : i64 [ Au.epoch_millis[] ]
        # a finished git fetch swaps in on THIS thread, then repaints
        if [ git_fresh ]
            git_fresh = false
            git_snap  = git_stage
            git_stage = null
            run_search[]
            if [ ux ] ux.restyle = true
        if [ now_ms - settings_check_ms >= 1000 ]
            settings_check_ms = now_ms
            sp : agi_path[]
            mt : i64 [ sp.modified_time[] ]
            if [ mt != settings_mtime ]
                load_settings[]
            fmt_sync[]
            fmt_poll[]
            fmt_borrow[]
            cov_poll[]
            # refresh policy: nothing on a timer. the watches (FSEvents
            # on macOS) mark the snapshot dirty on a real change, and
            # the scan reruns on its own thread, at most once a second,
            # so the nav list reads a finished snapshot the instant it
            # comes up and an idle app does no work; a selection change
            # rescans at once
            if [ git_dirty && !git_busy && now_ms - git_last >= 1000 ]
                git_summarize[]

        if [ instances ]
            for [ av8: AppView ] in instances
                if [ av8.props && av8.props.count > 0 && av8.app_mod ]
                    if [ !module_props ]
                        module_props = map string [string] []
                    module_props[ av8.app_mod ] = av8.props
                # the app changed its own display: the pane and panel
                # follow it
                if [ av8.disp_pending >= 0 ]
                    dp8 : i32 [ av8.disp_pending ]
                    av8.disp_pending = -1
                    ed8 : Editor null
                    for [ i: i32 0, i < editor_slots.count, i += 1 ]
                        e8 : Editor pane_at[ i ]
                        if [ e8 && e8.run_view == av8 ] ed8 = e8
                    set_display[ ed8, av8, dp8 ]
                # a held one waits for its row; an unstarted one starts
                # here even unshown
                if [ av8.held || av8.ended ] continue
                # the host parks a new app for the debugger; release it
                # shown or not
                if [ !av8.attached && av8.slot >= 0 ]
                    apid : i32 [ host_app_pid[ av8.slot ] ]
                    if [ apid > 0 && proc_stopped[ apid ] ]
                        adir : string [ '' ]
                        if [ av8.src ]
                            ap8 : av8.src.parent_dir[]
                            if [ ap8 ] adir = '{ap8}'
                        bp : bool [ module_has_breakpoints[ adir ] ]
                        log 'release: {av8.app_mod} slot {av8.slot} pid {apid} breakpoints {(bp) ? 1 : 0}'
                        if [ bp ]
                            attach_appview[ av8, apid ]
                        el
                            # no breakpoints here: let it run, never
                            # trace it
                            kill[ apid, SIGCONT ]
                            av8.attached = true
                # a hidden pane (the nav list over it) never ticks: its
                # instance is serviced here until it shows again
                shown8 : bool [ false ]
                for [ pi8: i32 0, pi8 < editor_slots.count, pi8 += 1 ]
                    e8 : Editor pane_at[ pi8 ]
                    # hide_ui hides every pane: their apps run on here
                    if [ e8 && e8.run_view == av8 && !e8.hide &&
                         !hide_ui ]
                        shown8 = true
                if [ !shown8 ]
                    av8.stopped = (av8.debugger && av8.debugger.active && !av8.debugger.running) ? true : false
                    # the pace of an app shown in the pane: this
                    # display's refresh
                    if [ av8.host_hz <= 0 ] av8.host_hz = w.refresh_hz[]
                    av8.service[ w.screen ]
        # a Full pane covers the ui: the backdrop scene and frost chain
        # skip
        cover9 : bool [ false ]
        for [ pc9: i32 0, pc9 < editor_slots.count, pc9 += 1 ]
            ec : Editor pane_at[ pc9 ]
            if [ ec && ec.app_view && ec.run_view && !ec.run_view.held && !ec.run_view.ended ]
                cover9 = true
        if [ ux ] ux.backdrop_bypass = cover9
        attach_publish[]
        if [ pending_show > 0 ]
            edp9 : Editor pane_at[ pending_show_pane ]
            avp : AppView instance_by[ pending_show ]
            if [ !avp || !avp.src ]
                pending_show = 0
            el [ edp9 ]
                # once the source has loaded: the load turns the app
                # view off
                ld : path edp9.loaded_src
                if [
                    ld
                    && '{ld.absolute[]}' == '{avp.src.absolute[]}' ]
                    pending_show = 0
                    show_instance[ avp.iid, pending_show_pane ]
                    if [ pending_code ]
                        pending_code = false
                        edp9.app_view = false
                        edp9.pristine = false
        if [ session_dirty ]
            session_dirty = false
            save_session[]
        sync_volume[]
        # the global log: every instance's log in one session, retailed
        # as the set changes
        gc9 : string console_cmd[ null ]
        if [
            gc9.count > 0 && (!all_cmd || all_cmd.compare[ gc9 ] != 0) ]
            all_cmd = gc9
            ga : ConsoleSession all_log[]
            # the tails run as the session's program: no shell, no
            # prompt; input is the console's line, never this
            ga.launch_cmd = gc9
            ga.restart[]
            # a log: no cursor, nothing is typed into it
            ga.cursor_visible = false
        # the global console never wraps, however it was made
        if [ ed_sessions ]
            gw : ConsoleSession ed_sessions[ 'ed:all' ]
            if [ gw ] gw.nowrap = true
        # the selected instance's own console, made once per slot
        epa : Editor pane_at[ active_pane ]
        rva : AppView (epa) ? epa.run_view : null
        isd : string inst_sid[ rva ]
        if [ isd ]
            if [ !ed_sessions ]
                ed_sessions = map ConsoleSession [string] [ ]
            if [ !ed_sessions.contains[ isd ] ]
                is9 : ConsoleSession []
                is9.name = isd
                is9.nowrap = true
                ed_sessions[ isd ] = is9
                lg : string '{startup_path}/install/tmp'
                lf : string '{lg}/{rva.app_mod}.{rva.slot}.log'
                # the tail is its program: no shell, no prompt
                is9.launch_cmd = 'tail -n +1 -F {lf}'
                is9.restart[]
                is9.cursor_visible = false
        for [ pi2: i32 0, pi2 < editor_slots.count, pi2 += 1 ]
            edp : Editor pane_at[ pi2 ]
            if [ !edp || !edp.run_view ] continue
            if [ !edp.run_view.cmd ] continue
            if [ edp.run_view.dispatched ] continue
            edp.run_view.dispatched = true
            esid : string edp.run_view.console_id[]
            if [ !ed_sessions ]
                ed_sessions = map ConsoleSession [string] [ ]
            es : ConsoleSession ed_sessions[esid]
            if [ !es ]
                es = ConsoleSession []
                es.name = esid
                es.nowrap = true
                ed_sessions[esid] = es
            cc : string console_cmd[ edp.run_view.app_mod ]
            if [ cc.count == 0 ] cc = edp.run_view.cmd
            log 'run: dispatch {esid}: {cc}'
            es.launch_cmd = ''
            es.restart[]
            es.pending = cc
        if [ ed_sessions ]
            for [ s: ConsoleSession, k: string ] in ed_sessions
                if [ s.pty_fd >= 0 ]
                    # the app wrote: the consoles showing it repaint,
                    # nothing else
                    if [ s.read_output[] ] dirty_consoles[ w.root ]
        if [ ed_sessions ]
            ags : ConsoleSession ed_sessions[ orbit_sid ]
            if [ ags && ags.agent_busy[] ] busy_at = epoch_millis[]
            busy = (epoch_millis[] - busy_at) < 500 ||
                agent_state == 'busy'
            # done with the exchange up: apply the staged reload; the
            # flame and the final spin last until the swap has landed
            # the flame lights first and burns on its own for a moment,
            # then the apply goes: a fresh product (an outside build)
            # swaps the instant it is asked, which left no frame for the
            # flame at all
            pend : i32 [ au_live_get_pending[] ]
            now  : i64 [ epoch_millis[] ]
            # the status bar's reload chips follow the host's state: a
            # tree composed while the host compiled still says so after
            # the switch
            if [ pend != pend_last ]
                pend_last  = pend
                ux.restyle = true
                # the side panel's reload button follows it too
                if [ ux.root ] ux.dirty_tree[ ux.root ]
            # done is read: the first hover tip erases the word
            if [
                agent_done && agent_note && agent_note.count > 0
                && hover_tip[ ux.hovered ].count > 0 ]
                agent_note = ''
                ux.restyle = true
            if [ !swap_carry ] swap_carry = ExchangeState [ ]
            if [ !swap_view  ] swap_view  = vec f32 []
            # the reloaded exchange stays open: the user closes it
            if [ carry_landed && ux.loaded[] ]
                carry_landed = false
            # the next instance is ready (pending 3): the state crosses,
            # then the go
            if [ pend == 3 && !swap_fading ]
                swap_fading = true
                if [ ux ] ux.exchange_carry[ swap_carry ]
                if [ agent_av ] agent_av.carry[ swap_carry ]
                panes_carry[]
                au_live_request_apply[]
            if [ pend != 3 ] swap_fading = false
            # the exchange holds until the avatar's second halo has
            # settled back to the first: the close and the apply wait on
            # it
            hs : bool [ !agent_av || agent_av.halo_cur < 0.02 ]
            if [
                agent_done && !swap_live && ux && ux.shot_ask
                && pend == 1 ]
                swap_live = true
                swap_hot  = false
                swap_at   = now
            if [ swap_live && !swap_hot && now - swap_at > 1400 && hs ]
                request_swap[]
                swap_hot    = true
                swap_hot_at = now
            # the swap replaces this instance (the flame ends with it).
            # a build that failed puts pending back to staged: stand
            # down, and never in the frames the host takes to start the
            # build
            el [
                swap_live && swap_hot && pend == 1
                && now - swap_hot_at > 1500 ]
                log 'swap stand-down: the build failed, the exchange comes back'
                swap_live  = false
                swap_hot   = false
                agent_done = false
                ux.swap_fade = false
                ux.restyle   = true
        if [ debuggers && ed_sessions ]
            for [ d: dbg, dn: string ] in debuggers
                if [ !d || !d.active ] continue
                ds : ConsoleSession ed_sessions[ dn ]
                if [ !ds ] continue
                ds.feed_fd[ d.fifo_fd_out ]
                ds.feed_fd[ d.fifo_fd_err ]

        if [ editor_slots.count == 0 ] editor_slots += -1
        pane_total : i32 [ editor_slots.count + ((agent_open) ? 1 : 0) ]
        for [ ci: i32 pane_total - 1, ci >= 1, ci -= 1 ]
            if [ take_closed[ 'pane{ci}' ] ] close_pane[ ci ]
        if [ !ed_sessions ]
            ed_sessions = map ConsoleSession [string] [ ]
        for [ pc: i32 0, pc < pane_console.count, pc += 1 ]
            if [ pane_console[pc] && pane_console[pc].count > 0 ]
                ensure_console[ pane_console[pc] ]
        if [ agent_open ] ensure_console[ orbit_sid ]
        ap9 : i32 [ agent_pane[] ]
        if [ ap9 > 0 ]
            ape : element find_el[ a, 'pane{ap9}' ]
            cw  : f32 [ (ape) ? ape.extent : 0.0 ]
            if [ ape && cw <= 0.0 && console_w > 0 ]
                half9 : f32 [ ((bounds) ? bounds.w : 1200.0) * 0.5 ]
                use9  : f32 [ console_w ]
                ape.extent = (use9 > half9) ? half9 : use9
            el [ cw > 0.0 && i32[ cw ] != console_w ]
                console_w      = i32[ cw ]
                console_w_save = 30
        if [ console_w_save > 0 ]
            console_w_save -= 1
            if [ console_w_save == 0 ] save_session[]
        for [ bi: i32 0, bi < editor_slots.count, bi += 1 ]
            pe : element find_el[ a, 'pane{bi}' ]
            if [ !pe ] continue
            be : element find_el[ pe, 'band' ]
            if [ !be ] continue
            bh : f32 [ be.extent ]
            if [ bh <= 0.0 && band_h > 0 ]
                half8 : f32 [ ((bounds) ? bounds.h : 900.0) * 0.5 ]
                use8  : f32 [ band_h ]
                be.extent = (use8 > half8) ? half8 : use8
            el [ bh > 0.0 && i32[ bh ] != band_h ]
                band_h      = i32[ bh ]
                band_h_save = 30
        if [ band_h_save > 0 ]
            band_h_save -= 1
            if [ band_h_save == 0 ] save_session[]
        if [ pending_stop ]
            pending_stop = false
            dbg_say[ 'stopped at {pending_src}:{pending_line}' ]
            t0 : i64 [ Au.epoch_millis[] ]
            apply_break[ pending_src, pending_line, pending_col ]
            log 'applied break t={t0} took={Au.epoch_millis[] - t0}ms'
        if [ pending_exit ]
            ex : exited pending_exit
            pending_exit = null
            dbg_say[ 'process exited, code {ex.code}' ]
            apply_exit[ ex ]
        # the stage is the scene's prop: its tick sets ux.frost_mode
        if [ ux && frost_dbg8 != ux.frost_mode ]
            log 'FROST mode={ux.frost_mode} eff={ux.frost_eff[]}'
            frost_dbg8 = ux.frost_mode
            if [ scene_el ]
                bgc : scene_el.bg_color*[]
                if [ bgc && bgc.a > 0.0 ] ux.solid_color = bgc
                ux.apply_solid[]
        if [ ux ]
            sl9 : string scene_loaded[]
            ux.expect_backdrop = sl9 && sl9.count > 0 && sl9.compare[
                'none' ] != 0
        if [ ux ] ux.stats = stats
        if [ ux ] ux.show_fps = show_fps
        if [ ux ] ux.prof_log = stats
        if [ ux && ux.vk ] ux.vk.stats_log = stats
        # push the flat color the instant the stage is set (retry until
        # the shader exists), so load shows the solid color, never the
        # gradient
        if [ ux && frost_pushed != ux.frost_mode && ux.apply_solid[] ]
            frost_pushed = ux.frost_mode

    # the panes, and the context panel of the selected one beside them
    func main_els [] -> Elements
        t : Elements []
        # the editors with the status bar under them; the side panel
        # beside both, down to the window's bottom
        left : Elements []
        # the editors over the one console, which is the selected
        # editor's module's; hide_ui hides them, the bar stays
        stack : Elements []
        stack['panes'] = Splitter [ area: Region { l0 t0 r0 b0 },
            inner: pane_views[], deflt: 0.0, even: true,
            snap_close: true, loose: free_ids[] ]
        pv : element pane_view[ active_pane ]
        if [ show_console && pv && pv inherits EditorView ]
            ev9 : EditorView pv
            stack['band'] = RunBand [ elements: ev9.band_els[] ]
        left['stack'] = Splitter [
            area: Region { l0 t0 r0 b1.06 },
                                   vertical: true, hide: hide_ui,
            inner: stack, deflt: 180.0, min_size: 44.0 ]
        left['status'] = TasksBar [ elements: status_els[] ]
        # the side panel's shade, cast over the editors' right edge
        if [ !hide_ui && !inst_hidden ]
            left['seam_shade'] = SeamShade [ ghost: true ]
        t['left'] = element [ elements: left ]
        # folded, it stays mounted at no width: it slides back open
        if [ !hide_ui ] t['side'] = SidePanel [ ]
        return t

    # a free window's edges and corners, a ring just outside it (its
    # inside is its own): 1 right, 2 bottom, 4 left, 8 top
    func grips_of [ t: Elements, i: i32, x: f32, y: f32, w: f32,
                    h: f32 ]
        m : f32 [ 8.0 ]
        for [ sd: i32 ] in grip_sides[]
            gx : f32 [ ((sd & 4) != 0) ? x - m
                : (((sd & 1) != 0) ? x + w : x) ]
            gy : f32 [ ((sd & 8) != 0) ? y - m
                : (((sd & 2) != 0) ? y + h : y) ]
            gw : f32 [ ((sd & 5) != 0) ? m : w ]
            gh : f32 [ ((sd & 10) != 0) ? m : h ]
            t['grip{i}_{sd}'] = FreeGrip [ pane: i, side: sd,
                topmost: true,
                area: Region [ 'l{gx}px t{gy}px w{gw}px h{gh}px' ] ]

    # the edges, then the corners (over them)
    func grip_sides [] -> vec i32
        return vec i32 [] [ 1, 2, 4, 8, 3, 6, 9, 12 ]

    # the full navigator is up: in a docked view
    func nav_full [] -> bool
        if [ !nav_showing && !find_showing ] return false
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            if [ !pane_floats[ i ] && pane_browsing[ i ] ] return true
        return false

    # a pane is docked (in the split)
    func any_docked [] -> bool
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            if [ !pane_floats[ i ] ] return true
        return false

    # the free panes' keys, bottom to top, each with its ring; the
    # desktop under them when nothing is docked
    func free_ids [] -> vec string
        ids : vec string []
        if [ !any_docked[] ] ids.push[ 'desk' ]
        if [ free_order ]
            for [ fi: i32 ] in free_order
                if [ !pane_floats[ fi ] ] continue
                ids.push[ 'shade{fi}' ]
                ids.push[ 'ground{fi}' ]
                ids.push[ 'pane{fi}' ]
                ids.push[ 'edge{fi}' ]
                for [ sd: i32 ] in grip_sides[]
                    ids.push[ 'grip{fi}_{sd}' ]
        return ids

    # where a pane is in free_order, or -1
    func free_at [ i: i32 ] -> i32
        if [ !free_order ] return -1
        for [ j: i32 0, j < free_order.count, j += 1 ]
            if [ free_order[ j ] == i ] return j
        return -1

    func pane_floats [ i: i32 ] -> bool
        k : i32 [ i * 4 + 2 ]
        return i >= 0 && pane_free && k < pane_free.count
            && pane_free[ k ] > 0.0

    # the pane comes to the top of the free ones and is selected
    func raise_pane [ i: i32 ]
        if [ i != active_pane ]
            active_pane = i
            if [ ux ] ux.restyle = true
        if [ !pane_floats[ i ] ] return
        fo : i32 [ free_at[ i ] ]
        if [ fo >= 0 && fo == free_order.count - 1 ] return
        if [ fo >= 0 ] free_order.remove[ fo ]
        free_order.push[ i ]
        force_update[]

    # its place set; a docked pane pulled free keeps its size, two
    # thirds of it when it filled the area
    func pull_free [ i: i32, pv: element ]
        if [ pane_floats[ i ] || !pv || !pv.bounds ] return
        if [ !pane_free ] pane_free = vec f32 []
        if [ !free_order ] free_order = vec i32 []
        if [ !pane_shown ] pane_shown = vec f32 []
        while [ pane_free.count < (i + 1) * 4 ]
            pane_free.push[ 0.0 ]
        while [ pane_shown.count < (i + 1) * 4 ]
            pane_shown.push[ 0.0 ]
        sp : element (pv.parent) ? pv.parent : null
        aw : f32 [ (sp && sp.bounds) ? sp.bounds.w : pv.bounds.w ]
        ah : f32 [ (sp && sp.bounds) ? sp.bounds.h : pv.bounds.h ]
        fw : f32 [ pv.bounds.w ]
        fh : f32 [ pv.bounds.h ]
        if [ fw >= aw * 0.8 ] fw = round[ fw * 0.66 ]
        if [ fh >= ah * 0.8 ] fh = round[ fh * 0.66 ]
        k : i32 [ i * 4 ]
        pane_free[ k ]     = pv.bounds.x + (pv.bounds.w - fw) * 0.5
        pane_free[ k + 1 ] = pv.bounds.y
        pane_free[ k + 2 ] = fw
        pane_free[ k + 3 ] = fh
        # an app's own shape: as wide as fits two thirds of the height
        fit_free[ i, false ]
        if [ pane_free[ k + 3 ] > round[ ah * 0.66 ] ]
            pane_free[ k + 3 ] = round[ ah * 0.66 ]
            fit_free[ i, true ]
            pane_free[ k ] = pv.bounds.x
                + (pv.bounds.w - pane_free[ k + 2 ]) * 0.5
        # it eases from where it sat docked
        pane_shown[ k ]     = pv.bounds.x
        pane_shown[ k + 1 ] = pv.bounds.y
        pane_shown[ k + 2 ] = pv.bounds.w
        pane_shown[ k + 3 ] = pv.bounds.h
        fo : i32 [ free_at[ i ] ]
        if [ fo >= 0 ] free_order.remove[ fo ]
        free_order.push[ i ]
        force_update[]

    # moved by the pointer; it stays under the bar's top edge
    func move_free [ i: i32, dx: f32, dy: f32 ]
        if [ !pane_floats[ i ] ] return
        k : i32 [ i * 4 ]
        pane_free[ k ]     = pane_free[ k ] + dx
        pane_free[ k + 1 ] = max[ pane_free[ k + 1 ] + dy, 0.0 ]
        # only its place: the next frame renders it, no restyle
        if [ ux ] ux.will_animate = true

    # an app holding its picture's shape: a free window takes that
    # shape, no bars round it (docked, the pane letterboxes it). the
    # height follows the width, or the width the height
    func fit_free [ i: i32, by_h: bool ]
        ed : Editor pane_at[ i ]
        pv : element pane_view[ i ]
        rv : AppView (ed && ed.app_view) ? ed.run_view : null
        if [ !rv || !rv.locked || rv.aw <= 0 || rv.ah <= 0 ] return
        # only while it shows live: paused, its code shows instead
        if [ rv.ended || rv.held || rv.paused || rv.stopped ] return
        if [ !ed.bounds || !pv || !pv.bounds ] return
        k : i32 [ i * 4 ]
        ar : f32 [ f32[ rv.aw ] / f32[ rv.ah ] ]
        # the window's own parts round the picture: its strip
        ew : f32 [ pv.bounds.w - ed.bounds.w ]
        eh : f32 [ pv.bounds.h - ed.bounds.h ]
        if [ by_h ]
            pane_free[ k + 2 ] = round[ (pane_free[ k + 3 ] - eh) * ar
                + ew ]
        el
            pane_free[ k + 3 ] = round[ (pane_free[ k + 2 ] - ew) / ar
                + eh ]

    # the full navigator's fade toward shown or gone, 150 ms whole
    func fade_nav [ w: Window ]
        now : i64 [ epoch_millis[] ]
        dt : f32 [ (fade_ms > 0) ? f32[ now - fade_ms ] : 0.0 ]
        fade_ms = now
        goal : f32 [ (nav_full[]) ? 1.0 : 0.0 ]
        if [ nav_fade == goal ] return
        # a frame after a still spell counts as one frame, not the wait
        step : f32 [ min[ dt, 34.0 ] / 150.0 ]
        if [ goal > nav_fade ]
            nav_fade = min[ nav_fade + step, goal ]
        el
            nav_fade = max[ nav_fade - step, goal ]
        w.will_animate = true
        force_update[]

    # a free window left with nothing (its app closed) closes; the
    # last pane docks instead, the desktop
    func free_empty_close []
        if [ !free_order ] return
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            if [ !pane_floats[ i ] || !pane_empty[ i ] ] continue
            if [ pane_browsing[ i ] || pending_finder == i ] continue
            if [ editor_slots.count == 1 ]
                dock_pane[ i ]
            el
                close_pane[ i ]
            force_update[]
            return

    # every free pane's drawn place a share of the way to its own,
    # each frame (filter_n): moves and sizes ease
    func ease_free [ w: Window ]
        fade_nav[ w ]
        if [ !free_order || !pane_shown ] return
        moved : bool [ false ]
        for [ i: i32 ] in free_order
            if [ !pane_floats[ i ] ] continue
            fit_free[ i, false ]
            for [ r: i32 0, r < 4, r += 1 ]
                k : i32 [ i * 4 + r ]
                cur : f32 [ pane_shown[ k ] ]
                goal : f32 [ pane_free[ k ] ]
                if [ cur == goal ] continue
                nv : f32 [ filter_n[ cur, goal, 0.3, w.frame_factor ] ]
                if [ nv - goal < 0.5 && goal - nv < 0.5 ] nv = goal
                pane_shown[ k ] = nv
                moved = true
        # the next frame renders the new place: no restyle (that
        # applies every element's style again, all redrawn)
        if [ moved ] w.will_animate = true

    # sized by its edges: 1 the right, 2 the bottom, 4 the left, 8
    # the top (the far edge stays)
    func size_free [ i: i32, side: i32, dx: f32, dy: f32 ]
        if [ !pane_floats[ i ] ] return
        k : i32 [ i * 4 ]
        if [ (side & 1) != 0 ]
            pane_free[ k + 2 ] = max[ pane_free[ k + 2 ] + dx, 160.0 ]
        if [ (side & 2) != 0 ]
            pane_free[ k + 3 ] = max[ pane_free[ k + 3 ] + dy, 100.0 ]
        if [ (side & 4) != 0 ]
            was : f32 [ pane_free[ k + 2 ] ]
            pane_free[ k + 2 ] = max[ was - dx, 160.0 ]
            pane_free[ k ] = pane_free[ k ] + was - pane_free[ k + 2 ]
        if [ (side & 8) != 0 ]
            was_h : f32 [ pane_free[ k + 3 ] ]
            pane_free[ k + 3 ] = max[ was_h - dy, 100.0 ]
            pane_free[ k + 1 ] = max[ pane_free[ k + 1 ] + was_h
                - pane_free[ k + 3 ], 0.0 ]
        right : f32 [ pane_free[ k ] + pane_free[ k + 2 ] ]
        bottom : f32 [ pane_free[ k + 1 ] + pane_free[ k + 3 ] ]
        fit_free[ i, side == 2 || side == 8 ]
        # a size the shape changed keeps the far edges
        if [ (side & 4) != 0 ]
            pane_free[ k ] = right - pane_free[ k + 2 ]
        if [ (side & 8) != 0 ]
            pane_free[ k + 1 ] = bottom - pane_free[ k + 3 ]
        # only its size: the next frame renders it, no restyle
        if [ ux ] ux.will_animate = true

    # back into the split, maximized
    func dock_pane [ i: i32 ]
        if [ !pane_floats[ i ] ] return
        pane_free[ i * 4 + 2 ] = 0.0
        fo : i32 [ free_at[ i ] ]
        if [ fo >= 0 ] free_order.remove[ fo ]
        force_update[]

    # let go at the top edge, it docks
    func drop_free [ i: i32 ]
        if [ pane_floats[ i ] && pane_free[ i * 4 + 1 ] <= 2.0 ]
            dock_pane[ i ]

    # projection: inline panes in order, then the agent console
    func pane_views [] -> Elements
        t : Elements []
        # the full navigator up: the free windows fade out of sight
        # (still running), back as it shuts; it fades in
        # the agents view up: they are put away as well
        agents : bool [ home_tab == 'agent' && home_seen[] ]
        away : bool [ nav_fade >= 1.0 || agents ]
        seen : f32 [ (agents) ? 0.0 : 1.0 - nav_fade ]
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            # free said every render: a docked pane said nothing and
            # kept a window's rounded mask
            ev : EditorView [ pane_index: i, free: false,
                selected: (search_pane[] == 'pane{i}') ]
            if [ nav_fade < 1.0 && !pane_floats[ i ]
                 && pane_browsing[ i ] ]
                ev.opacity = nav_fade
            if [ pane_floats[ i ] ]
                k : i32 [ i * 4 ]
                fx : f32 [ round[ pane_shown[ k ] ] ]
                fy : f32 [ round[ pane_shown[ k + 1 ] ] ]
                fw : f32 [ round[ pane_shown[ k + 2 ] ] ]
                fh : f32 [ round[ pane_shown[ k + 3 ] ] ]
                ev.topmost = true
                # the navigator in it is square: no window corners
                sq : bool pane_browsing[ i ]
                ev.free    = !sq
                ev.hide    = away
                ev.opacity = seen
                # fading or gone: presses pass it by
                ev.user_events = nav_fade <= 0.0 && !agents
                ev.area = Region [
                    'l{fx}px t{fy}px w{fw}px h{fh}px' ]
                # its shadow and outline, under it
                sh : f32 [ 24.0 ]
                sx : f32 [ fx - sh ]
                sy : f32 [ fy - sh ]
                sw : f32 [ fw + sh * 2.0 ]
                shh : f32 [ fh + sh * 2.0 ]
                t['shade{i}'] = WinShade [ topmost: true, hide: away,
                    opacity: seen, square: sq,
                    area: Region [
                        'l{sx}px t{sy}px w{sw}px h{shh}px' ] ]
                # its piece of the screen's ground, as a docked pane
                # has under it
                t['ground{i}'] = WinGround [ topmost: true, hide: away,
                    opacity: seen, square: sq,
                    area: Region [ 'l{fx}px t{fy}px w{fw}px h{fh}px' ] ]
                t['pane{i}'] = ev
                t['edge{i}'] = WinEdge [ topmost: true, hide: away,
                    opacity: seen, square: sq,
                    area: Region [ 'l{fx}px t{fy}px w{fw}px h{fh}px' ] ]
                if [ nav_fade <= 0.0 && !agents ]
                    grips_of[ t, i, fx, fy, fw, fh ]
                continue
            t['pane{i}'] = ev
        # nothing docked: the desktop (the apps) under the free windows
        if [ !any_docked[] ]
            t['desk'] = HomeView [ pane: -1,
                area: Region { l0 t0 r0 b0 } ]
        if [ agent_open ]
            t['pane{editor_slots.count}'] = EditorView [
                pane_index: editor_slots.count,
                selected: (search_pane[] == 'pane{editor_slots.count}') ]
        return t

    # right-flow: first inserted sits furthest right.
    # the tooltip's hover value: what the button under the pointer is. a
    # group of segments names the one hovered; any other button its
    # label, else its id
    func hover_tip [ e: element ] -> string
        if [ !e ] return ''
        # the finder's rows are not elements: the view names the one
        # hovered
        if [ e inherits CommitView ]
            cvw : CommitView e
            return (cvw.side_tip) ? cvw.side_tip : ''
        if [ e inherits TButtons ]
            tb : TButtons e
            return tb.hover_name[]
        if [ e inherits Button ]
            if [ e.label && e.label.count > 0 ] return e.label
            return (e.id) ? e.id : ''
        return ''
 
    # apps are toggles: one in view goes out of it (still running),
    # the pane back where it was; a window's pane has no editor
    # mounted until the next frame
    func dock_run_click [ iid: i32 ]
        avd : AppView instance_by[ iid ]
        edd : Editor pane_at[ active_pane ]
        wvd : u64 window_of[ avd ]
        shown : bool [ avd && ((wvd != 0
            && pane_window[ active_pane ] == wvd)
            || (wvd == 0 && edd && edd.run_view == avd
                && edd.app_view)) ]
        # an app in the pane: its Code (the menu's), as that does
        if [ shown && wvd == 0 ]
            edd.app_view = false
            edd.pristine = false
        el [ shown ]
            if [ pane_win && active_pane < pane_win.count ]
                pane_win[ active_pane ] = u64[ 0 ]
            toggled_out = active_pane
        el
            # back in view means embedded (a file's viewer says PIP)
            if [ avd && avd.display == 0 ]
                avd.display = 1
                avd.pip     = false
                tell_display[ avd ]
            show_instance[ iid, active_pane ]
        if [ ux ] ux.restyle = true

    # a pinned program: its running instance, else a new one
    func dock_program_click [ p: path ]
        ps : string '{p}'
        if [ instances ]
            for [ av: AppView ] in instances
                if [ av.slot < 0 || av.ended || av.held ] continue
                if [ pin_key_of[ av ] == ps ]
                    dock_run_click[ av.iid ]
                    return
        run_program[ p, active_pane ]

    # a bar chip's name: the window's or the app's own title, else
    # its argument, else the instance's name
    func task_title [ av: AppView ] -> string
        wv : u64 window_of[ av ]
        if [ wv != 0 ]
            wt : string[ wlc_window_title[ wv ] ]
            if [ wt.count > 0 ] return wt
        if [ av.app_title && av.app_title.count > 0 ] return av.app_title
        da : string default_arg_of[ av.module_args ]
        if [ da.count > 0 && program_of[ av ].count == 0 ]
            dp : path [ da ]
            return dp.stem[]
        return instance_name[ av ]

    # an instance that ended badly: build failed, crashed, an exit
    # code
    func run_failed [ av: AppView ] -> bool
        if [ !av || !av.ended || !av.note ] return false
        return av.note.count > 0 && av.note != 'app exited'

    # what a running app pins as: a program's path, else its module
    func pin_key_of [ av: AppView ] -> string
        pn : string program_of[ av ]
        if [ pn.count > 0 ]
            words : vec string av.module_args.split[ ' ' ]
            word : string words[ words.count - 1 ]
            if [ word.starts_with[ '/' ] ] return word
            pl : map string [string] program_list[]
            return (pl.contains[ pn ]) ? pl[ pn ] : ''
        fo : path (av.src) ? av.src.directory[] : null
        return (fo) ? '{fo}' : ''

    # the pins that show (their paths are there)
    func pins_shown [] -> i32
        n : i32 [ 0 ]
        if [ pins ]
            for [ ps: string ] in pins
                if [ dock_pin[ ps ] ] n += 1
        return n

    # a pin the dock shows: there, and not a plain folder (those are
    # the navigator's pinned)
    func dock_pin [ ps: string ] -> bool
        pp : path ps
        return pp.exists[] && !plain_folder[ pp ]

    # a folder that is not a module: a place, never an app
    func plain_folder [ p: path ] -> bool
        if [ !p.is_dir[] ] return false
        mm : path '{p}/{p.filename[]}.ag'
        return !mm.exists[]

    # a dock pin's click: a program shows or runs; a module or file
    # opens its source (shift: a module's new instance)
    func dock_icon_click [ di: DockIcon ]
        if [ di.program ]
            dock_program_click[ di.file ]
            return
        edd : Editor pane_at[ active_pane ]
        md9 : path (di.module) ? path '{di.file}/{di.file.filename[]}.ag' : di.file
        # a click runs the module: its first instance, else a new one;
        # each click again the next of its instances; with one in view
        # it steps out. shift: its source in the editor
        if [ shift_down || !di.module || !edd ]
            open_in_pane[ md9, active_pane ]
            return
        runs : vec AppView []
        for [ v9: AppView ] in instances_of[ md9 ]
            if [ !v9.viewer && v9.slot >= 0 ] runs.push[ v9 ]
        at : i32 [ -1 ]
        if [ edd.app_view && edd.run_view ]
            for [ i: i32 0, i < runs.count, i += 1 ]
                if [ runs[ i ] == edd.run_view ] at = i
        if [ at >= 0 && runs.count == 1 ]
            set_display[ edd, edd.run_view, 0 ]
        el [ at >= 0 ]
            embed_app[ edd, runs[ (at + 1) % runs.count ] ]
        el [ runs.count > 0 ]
            embed_app[ edd, runs[ 0 ] ]
        el
            show_app[ edd, md9, false ]

    # a pin let go: a click where it was, else it takes the slot
    # among the other shown pins and eases there from the drop
    func pin_release []
        # a copy: clearing drag_pin lets go of its text
        key : '{drag_pin}'
        drag_pin = null
        moved : bool drag_moved
        drag_moved = false
        if [ !moved ]
            pe : element find_el[ a, 'pin_rows' ]
            di : DockIcon (pe && pe.elements)
                ? cast DockIcon [ pe.elements[ 'dock_{key}' ] ] : null
            if [ di ] dock_icon_click[ di ]
            force_update[]
            return
        at : i32 [ drag_slot ]
        drag_slot = -1
        if [ at >= 0 && pins ]
            for [ i: i32 0, i < pins.count, i += 1 ]
                if [ pins[ i ] == key ]
                    pins.remove[ i ]
                    break
            pin_insert[ key, at ]
        force_update[]

    # a drop takes slot at among the shown pins; the new pin
    # starts where it was let go and eases into its place
    func pin_insert [ key: string, at: i32 ]
        if [ !pins ] pins = vec string []
        ix : i32 [ pins.count ]
        n  : i32 [ 0 ]
        for [ i: i32 0, i < pins.count, i += 1 ]
            if [ !dock_pin[ pins[ i ] ] ] continue
            if [ n == at ]
                ix = i
                break
            n += 1
        pins.insert[ key, ix ]
        save_session[]
        np : i32 pins_shown[]
        pin_off = vec f32 []
        for [ i: i32 0, i < np, i += 1 ]
            pin_off.push[ 0.0 ]
        if [ at < np ]
            pin_off[ at ] = drag_at - (1.0 + f32[ at ] * dock_w[])

    # the drag's frame: over the dock its icon eases to the
    # pointer and the pins below its slot ease down to open a gap
    func dock_drag_frame []
        if [ !ux ] return
        ff : f32 [ ux.frame_factor ]
        live : bool [ false ]
        np : i32 pins_shown[]
        pe : element find_el[ a, 'pins' ]
        was : i32 [ drag_slot ]
        # a pin dragged within the dock: the others close up round it
        pd : bool [ drag_pin && drag_pin.count > 0 ]
        if [ pd ] np -= 1
        if [ pd && pe ]
            dx : f32 [ f32[ ux.mouse.x ] - drag_x0 ]
            dy : f32 [ f32[ ux.mouse.y ] - drag_y0 ]
            if [ !drag_moved && dx * dx + dy * dy > 36.0 ]
                drag_moved = true
                # in the rows' own place: the scroll added back
                drag_at    = drag_y0 - pe.win_pos.y + pe.scroll.y
                    - dock_w[] * 0.5
                live       = true
            if [ drag_moved ]
                top  : f32 [ f32[ np ] * dock_w[] + 1.0 ]
                goal : f32 [ min[ max[ f32[ ux.mouse.y ] - pe.win_pos.y
                    + pe.scroll.y - dock_w[] * 0.5, 1.0 ], top ] ]
                if [ drag_at - goal > 0.25 || goal - drag_at > 0.25 ]
                    drag_at = filter_n[ drag_at, goal, 0.3, ff ]
                    live = true
                sp : i32 [ i32[ (drag_at + dock_w[] * 0.5 - 1.0) / dock_w[] ] ]
                drag_slot = min[ max[ sp, 0 ], np ]
        if [ drag_iid >= 0 && pe ]
            mx : f32 [ ux.mouse.x ]
            my : f32 [ ux.mouse.y ]
            dx : f32 [ mx - drag_x0 ]
            dy : f32 [ my - drag_y0 ]
            if [ !drag_moved && dx * dx + dy * dy > 36.0 ]
                drag_moved = true
            drag_slot = -1
            if [ drag_moved && mx < 118.75 ]
                goal : f32 [ my - pe.win_pos.y - dock_w[] * 0.5 ]
                # it comes in where the pointer is, then follows
                if [ was < 0 ] drag_at = goal
                drag_at = filter_n[ drag_at, goal, 0.3, ff ]
                mid : f32 [ drag_at + dock_w[] * 0.5 ]
                sl : i32 [ i32[ (mid - 1.0) / dock_w[] ] ]
                drag_slot = min[ max[ sl, 0 ], np ]
                live = true
        if [ drag_slot != was ] live = true
        if [ !pin_off || pin_off.count != np ]
            pin_off = vec f32 []
            for [ i: i32 0, i < np, i += 1 ]
                pin_off.push[ 0.0 ]
        for [ i: i32 0, i < np, i += 1 ]
            gap : bool [ drag_slot >= 0 && i >= drag_slot ]
            want : f32 [ (gap) ? dock_w[] : 0.0 ]
            cur : f32 [ pin_off[ i ] ]
            if [ cur - want > 0.25 || want - cur > 0.25 ]
                pin_off[ i ] = filter_n[ cur, want, 0.3, ff ]
                live = true
            el
                pin_off[ i ] = want
        if [ live ] force_update[]

    public func on_release [ ev: Event ]
        super.on_release[ ev ]
        if [ drag_pin && drag_pin.count > 0 ]
            pin_release[]
            return
        if [ drag_iid < 0 ] return
        iid : i32 [ drag_iid ]
        drag_iid = -1
        if [ !drag_moved ]
            dock_run_click[ iid ]
            return
        av : AppView instance_by[ iid ]
        key : string [ (av) ? pin_key_of[ av ] : '' ]
        if [ drag_slot >= 0 && key.count > 0 && !is_pinned[ path key ] ]
            pin_insert[ key, drag_slot ]
        drag_slot  = -1
        drag_moved = false
        force_update[]

    # the selected view's history arrows, the pins under them,
    # orbiter's button at the bottom
    # one unit in px: the layout's own em (the default font's line)
    func unit_px [] -> f32
        return (fc > 0.0) ? fc : 22.0 * ux_unit[ ux ]

    # the dock's width, px: 2.39 units, as its area says
    func dock_w [] -> f32
        return 2.39 * unit_px[]

    # a pane's globe: the dock's width, fixed
    func globe_w [ pi: i32 ] -> f32
        return dock_w[]

    func dock_els [] -> Elements
        dw : f32 dock_w[]
        t : Elements []
        edp : Editor pane_at[ active_pane ]
        fd9 : bool [
            search_pane[] == 'pane{active_pane}'
            && (nav_showing || picking[]) ]
        ndm : i32 [ 0 ]
        # the finder walks its folders; a hosted app has its own word
        if [ fd9 ]
            if [ !nav_can[ -1 ] ] ndm |= 1
            if [ !nav_can[ 1 ] ]  ndm |= 2
        el [ edp && edp.app_view && edp.run_view ]
            if [ !edp.run_view.nav_back_on ] ndm |= 1
            if [ !edp.run_view.nav_fwd_on ]  ndm |= 2
        el [ edp && edp.view_key[].count > 0 ]
            if [ !edp.view_can[ -1 ] ] ndm |= 1
            if [ !edp.view_can[ 1 ] ]  ndm |= 2
        el
            if [ !edp || !edp.nav || !edp.nav.can_back[] ]    ndm |= 1
            if [ !edp || !edp.nav || !edp.nav.can_forward[] ] ndm |= 2
        nb9 : vec string (fd9) ? vec string [] [ 'finder_back', 'finder_fwd' ]
            : vec string [] [ 'nav_back', 'nav_fwd' ]
        # with the system bar the arrows are its first buttons
        sys9 : bool system_on[]
        if [ !sys9 ]
            t['histnav'] = DockNav [ buttons: nb9,
                icon_ids: vec string [] [ 'left', 'right' ],
                manual: true, rest_hover: true,
                rest_fill: rgba [ '#ffffff08' ], disable_mask: ndm,
                icon_scale: 0.30, rest_glow: rgba [ '#ccf2' ],
                rest_px: 8.0, seg_radius: 0.0, use_spacing: false,
                seg_reach: 0.5, area: Region { l0 t0 r0 h1.3 } ]
        # the pins start under the arrows, in the arrows' unit
        pins9 : Elements []
        pins9['navline'] = DockLine [ area: Region { l0 t0 r0 h1px } ]
        y9 : f32 [ 1.0 ]
        # the last pin that is there takes the bottom border
        np : i32 [ 0 ]
        if [ pins ]
            for [ ps0: string ] in pins
                if [ dock_pin[ ps0 ] ] np += 1
        if [ drag_moved && drag_pin ] np -= 1
        k9 : i32 [ 0 ]
        held9 : DockIcon [ null ]
        if [ pins ]
            for [ ps9: string ] in pins
                pp : path ps9
                if [ !dock_pin[ ps9 ] ] continue
                mm : path '{pp}/{pp.filename[]}.ag'
                ism : bool [ pp.is_dir[] && mm.exists[] ]
                prg : bool [ !pp.is_dir[]
                             && access[ ps9.chars, X_OK ] == 0 ]
                ag9 : path (ism) ? path '{path.path_startup[]}/install/export/{install_name_of[ pp.filename[] ]}.agi' : null
                n9 : i32 [ 0 ]
                if [ ism ]
                    for [ v9: AppView ] in instances_of[ mm ]
                        if [ !v9.viewer && !v9.held && !v9.ended ]
                            n9 += 1
                ic9 : path null
                if [ prg && instances ]
                    for [ v9: AppView ] in instances
                        if [ v9.slot < 0 || v9.ended || v9.held ]
                            continue
                        if [ pin_key_of[ v9 ] == ps9 ] n9 += 1
                if [ prg ] ic9 = program_icon_named[ '', pp.filename[] ]
                # the pin being dragged: out of the column, over it
                if [ drag_moved && drag_pin && drag_pin == ps9 ]
                    held9 = DockIcon [ file: pp, module: ism, agi: ag9,
                        count: n9, program: prg, icon_file: ic9,
                        selected: true, area: Region [
                        'l0 t{drag_at}px w{dw}px h{dw}px' ] ]
                    continue
                sh9 : f32 [ (pin_off && k9 < pin_off.count)
                    ? pin_off[ k9 ] : 0.0 ]
                pins9[ 'dock_{ps9}' ] = DockIcon [ file: pp,
                    module: ism, agi: ag9, count: n9,
                    program: prg, icon_file: ic9, selected: false,
                    first: k9 == 0,
                    last: k9 == np - 1,
                    area: Region [
                        'l0 t{y9 + sh9}px w{dw}px h{dw}px' ] ]
                k9 += 1
                y9 += dock_w[]
        if [ held9 ] pins9[ 'dock_{drag_pin}' ] = held9
        # a bar chip dragged over the dock: its icon at the slot
        dav : AppView (drag_slot >= 0) ? instance_by[ drag_iid ] : null
        if [ dav ]
            dfo : path (dav.src) ? dav.src.directory[] : null
            pins9[ 'drag_ghost' ] = DockIcon [ file: dfo, module: true,
                icon_file: program_icon[ dav ], selected: true,
                area: Region [ 'l0 t{drag_at}px w{dw}px h{dw}px' ] ]
        # down to the one button at the foot (the gear, or orbiter's)
        pt9 : string [ (sys9) ? 't0' : 't1.3' ]
        # more pins than room: the wheel scrolls them, faded at the
        # ends, no thumb
        # the pins are placed by their areas, so they move by the
        # scroll together, inside one row the scroll offsets
        rh9 : f32 [ y9 + dock_w[] ]
        pe9 : element find_el[ a, 'pins' ]
        sc9 : f32 [ (pe9) ? pe9.scroll.y : 0.0 ]
        rows9 : Elements []
        rows9['pin_rows'] = element [ no_scroll: true, elements: pins9,
            area: Region [ 'l0 t{0.0 - sc9}px r0 h{rh9}px' ] ]
        # with the system bar the pins run to the foot (orbiter's
        # button is the bottom bar's)
        pb9 : string [ (sys9) ? 'b0' : 'b1.06' ]
        t['pins'] = DockPins [ area: Region [ 'l0 {pt9} r0 {pb9}' ],
                               rows_h: rh9, scroll_fade: 24.0,
                               elements: rows9 ]
        # orbiter's button at the foot, under the scrolled pins; with
        # the system bar it is the bottom bar's
        if [ !sys9 ]
            t['dock_orbiter'] = home_button[
                Region [ 'l0 b1.06 w2.39 h1.06' ], false ]
        return t

    # orbiter's own button: the dock's foot, or the system bar's first
    func home_button [ ar: Region, bar: bool ] -> element
        # cmd anywhere, shift over it, or recording: its core red;
        # the agent thinking: blue
        dh : element find_el[ a, 'dock_orbiter' ]
        if [ !dh ] dh = find_el[ a, 'sys_orbiter' ]
        rec : bool [ mic_by_press || ux.dict_on || cmd_down
            || (shift_down && dh && dh.hovered) ]
        thinking : bool [ agent_state == 'busy' ]
        # recording (or armed for it): a slight red over the dock's
        # colour, so the state reads at a glance; thinking: blue
        icon : string [ (rec) ? 'orbiter4_red'
            : ((thinking) ? 'orbiter4_blue' : 'orbiter4') ]
        # its slideout (the exchange) out: the menus' lit fill, as a
        # menu name's
        xup : bool [ ux && ux.shot_ask && !ux.agent_min ]
        tint : rgba [ (rec) ? '#ff3a3a33'
            : ((thinking) ? '#3a8aff40'
            : ((xup) ? '#4d3dbcaa' : '#0000')) ]
        if [ bar ]
            return BarHome [ buttons: vec string [] [ 'agent_note' ],
                icon_ids: vec string [] [ icon ], manual: true,
                rest_fill: tint, seg_radius: 0.0, use_spacing: false,
                icon_scale: 0.605, area: ar ]
        return DockHome [ buttons: vec string [] [ 'agent_note' ],
            icon_ids: vec string [] [ icon ], manual: true,
            rest_fill: tint, seg_radius: 0.0, use_spacing: false,
            icon_scale: 0.605, area: ar ]

    # the side panel's fold and the splitter agree: a drag past its
    # floor folds it, the toggle opens it at its last width
    func side_sync []
        mn : element find_el[ a, 'main' ]
        sp : element (mn && mn.elements) ? mn.elements[ 'side' ] : null
        if [ !sp ] return
        if [ sp.extent > 0.0 ] side_saved = sp.extent
        shut : bool [ sp.extent < 0.0 ]
        if [ shut != side_closed ]
            # the drag folded it (keeping the width it began at) or
            # opened it
            if [ shut && sp.extent < -1.0 ] side_saved = -sp.extent
            side_closed = shut
            inst_hidden = shut
            session_dirty = true
        el [ inst_hidden != shut ]
            sp.extent   = (inst_hidden)
                ? -((side_saved > 0.0) ? side_saved : 1.0) : side_saved
            side_closed = inst_hidden
            session_dirty = true
            mn.pristine = false
            if [ ux ] ux.will_animate = true

    # the system bar: as the OS, or asked for in a window
    func system_on [] -> bool
        if [ !system_known ]
            system_known = true
            system_os = on_the_os[]
        return system_os || force_system

    # the clock in the middle; the tray at the right: the Wi-Fi
    # mark, then power (restart with ctrl / cmd held, or shift
    # over it)
    func system_els [] -> Elements
        t : Elements []
        # the active window's menu bar: its top menus, after it
        # after the dock by the task bar's group gap (0.24 units)
        x0 : f32 [ 0.0 ]
        x : f32 [ x0 ]
        uu : f32 ux_unit[ ux ]
        # the selected window's menu alone, from the left, wherever
        # the window is (as macOS)
        pi : i32 bar_pane[]
        pv : element (pi >= 0) ? pane_view[ pi ] : null
        x = menu_group_els[ t, x0, uu, pi, '' ]
        # the right end, short of the bar's own: the window's close
        # and its arrows, or the navigator's views
        re : f32 [ (bounds) ? bounds.w - right_w[] : 0.0 ]
        if [ pv && pane_browsing[ pi ] ]
            pane_views_el[ t, pi, re ]
        el [ pv && bounds && !pane_empty[ pi ] ]
            # the close at the right end, the arrows left of it
            rx : f32 pane_close_el[ t, pi, re ]
            vx : f32 nav_arrows_el[ t, pi, rx ]
            # a URL app's address: up to the arrows; a press edits
            url : bool [ pi == active_pane && bar_url_on[] ]
            if [ url ]
                bar_title_el[ t, bar_title[], x, vx ]
            el [ pane_app_on[ pi ] ]
                x = pane_outline_el[ t, pi, x, '' ]
                bar_name_el[ t, bar_title_of[ pi ], x, vx, '', pi ]
            # the bar is its docked window's title: pulled down, the
            # window comes free
            if [ !url && vx > x ]
                t['bar_grab'] = BarGrab [ pane: pi,
                    area: Region [ 'l{x}px t0 w{vx - x}px b0' ] ]
        if [ grab_pane >= 0 && !t.contains[ 'bar_grab' ] ]
            gw : f32 [ max[ re - x, 8.0 ] ]
            t['bar_grab'] = BarGrab [ pane: grab_pane,
                area: Region [ 'l{x}px t0 w{gw}px b0' ] ]
        return t

    # the pane shows the navigator
    func pane_browsing [ pi: i32 ] -> bool
        return (nav_showing || find_showing)
            && search_pane[] == 'pane{pi}'

    # a file's views (git, B16 ...) as buttons ending at xr, lit while
    # shown; the x where they start (xr when none)
    func pane_views_el [ t: Elements, pi: i32, xr: f32 ] -> f32
        ed : Editor pane_at[ pi ]
        if [ !ed || ed.app_view ] return xr
        vs : vec string file_views[ ed ]
        if [ vs.count == 0 ] return xr
        ids : vec string []
        ics : vec string []
        cur : string ed.resolve_view[]
        lit : i32 [ 0 ]
        for [ i: i32 0, i < vs.count, i += 1 ]
            v : string vs[ i ]
            ids.push[ 'pview:{pi}:{v}' ]
            ci : string console_icon[ v ]
            ics.push[ (ci) ? ci : v ]
            if [ (v == 'git') ? ed.git_on : v == cur ] lit |= (1 << i)
        bw : f32 [ 1.33 * unit_px[] * f32[ vs.count ] ]
        t['sview_{pi}'] = AltTab [ buttons: ids, icon_ids: ics,
            icon_scale: 0.5, manual: true, seg_radius: 0.0,
            use_spacing: false, rest_fill: rgba [ '#0000' ],
            sel_mask: lit, seg_reach: 0.5,
            area: Region [ 'l{xr - bw}px t0 w{bw}px b0' ] ]
        return xr - bw

    # the system bar's right end: nothing (the bottom bar holds them)
    func right_w [] -> f32
        return 0.0

    # the active pane's menu at x: its top menus, its title after
    # the first (its app's name); the x where it ends
    # a pane's menu: the selected one's as it stands, another's as
    # last read (read again 2 s on)
    func menus_of [ pi: i32 ] -> vec TrayEntry
        if [ pi == active_pane ] return menu_items
        wn : u64 pane_window[ pi ]
        ed : Editor pane_at[ pi ]
        av : AppView (ed) ? ed.run_view : null
        key : string [ (wn != 0) ? 'w{wn}'
            : ((av) ? 'a{av.iid}:{ed.app_view}' : '') ]
        if [ key.count == 0 ] return null
        if [ !pane_menus ] pane_menus = map PaneMenu [string] [ ]
        now : i64 [ epoch_millis[] ]
        pm : PaneMenu pane_menus[ key ]
        if [ pm && now - pm.ms < 2000 ] return pm.items
        items : vec TrayEntry [ (wn != 0) ? menu_read[ wn ]
            : own_menu[ av, ed.app_view ] ]
        pane_menus[ key ] = PaneMenu [ key: key, items: items,
                                       ms: now ]
        return items

    # the pane the system bar is the title of: the selected one
    # docked, else the first docked one (-1: every window is free)
    func bar_pane [] -> i32
        if [ !pane_floats[ active_pane ] ] return active_pane
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            if [ !pane_floats[ i ] ] return i
        return -1

    # a free window's strip: the system bar it took with it (its
    # menus, its title, its arrows and close), w px wide
    func strip_els [ pi: i32, w: f32 ] -> Elements
        t : Elements []
        if [ !ux ] return t
        uu : f32 ux_unit[ ux ]
        # end to end: the window's mask rounds the corner buttons
        x : f32 menu_group_els[ t, 0.0, uu, pi, 's{pi}_' ]
        rx : f32 pane_close_el[ t, pi, w ]
        vx : f32 nav_arrows_el[ t, pi, rx ]
        x = pane_outline_el[ t, pi, x, 's{pi}_' ]
        # the load mark left of the arrows, as on the bar
        lw : f32 [ 1.33 * unit_px[] ]
        if [ pane_app_on[ pi ] && pane_loads[ pi ] && vx - lw > x ]
            t['bar_load_{pi}'] = AltTab [
                buttons: vec string [] [ 'bar_load_{pi}' ],
                icon_ids: vec string [] [ 'eject' ], icon_scale: 0.5,
                manual: true, seg_radius: 0.0, use_spacing: false,
                rest_fill: rgba [ '#0000' ],
                area: Region [ 'l{vx - lw}px t0 w{lw}px b0' ] ]
            vx -= lw
        pad : f32 [ 10.0 * uu ]
        if [ vx - x > pad * 2.0 ]
            t['s{pi}_title'] = BarText [ label: bar_title_of[ pi ],
                area: Region [
                    'l{x + pad}px t0 w{vx - x - pad * 2.0}px b0' ] ]
        return t

    # a pane's menus from x0, its ids led by pre ('' the bar's)
    func menu_group_els [ t: Elements, x0: f32, uu: f32, pi: i32,
                          pre: string ] -> f32
        # the bar's globe first (the full navigator); a window's strip
        # has none. its controls are in its menu
        gp : i32 [ (pi >= 0) ? pi : active_pane ]
        x : f32 [ x0 ]
        if [ pre.count == 0 ] x = globe_el[ t, 'bar_title', x0, gp ]
        # the desktop (the apps) is an app of its own: orbiter, the
        # welcome app, and its menu
        if [ pi < 0 || pane_empty[ pi ] ]
            if [ pre.count > 0 ] return x
            dw : f32 [ (7.0 * 9.5 + 22.0) * uu ]
            t['menu_desk'] = MenuTop [ label: 'orbiter', at: -2,
                tab_on: true,
                selected: drawer_open && menu_kind == 'system',
                area: Region [ 'l{x}px t0 w{dw}px b0' ] ]
            return x + dw
        if [ pi == active_pane ] pane_menu[]
        items : vec TrayEntry menus_of[ pi ]
        # a window's own menus (File ...) are all plain
        lead : bool [ pane_window[ pi ] == 0 ]
        # the first menu reads as its app: a window's program (gedit,
        # not File), else the app's own name (vscode, not File)
        named : string [ (lead) ? app_name_of[ pi ]
                                : window_program[ pi ] ]
        if [ items ]
            for [ i: i32 0, i < items.count, i += 1 ]
                e : TrayEntry items[ i ]
                if [ e.depth != 0 || e.rule || e.label.count == 0 ]
                    continue
                label : string [ (named.count > 0) ? named : e.label ]
                # the program's name takes the app tab's look, bold
                if [ named.count > 0 ] lead = true
                named = ''
                mw : f32 [ (f32[ label.count ] * 9.5 + 22.0) * uu ]
                lit : bool [ drawer_open && menu_kind == 'menu'
                             && menu_top == i && pi == active_pane ]
                # the app's name is the pane's tab, lit yellow: one
                # button (its code and instances are in its menu)
                t['{pre}menu_{i}'] = MenuTop [ label: label, at: i,
                    pane: pi, selected: lit, tab_on: lead,
                    progress: (lead) ? pane_build[ pi ] : -2.0,
                    area: Region [ 'l{x}px t0 w{mw}px b0' ] ]
                x += mw
                lead = false
        return x

    # a pane's running app by name: the module it came from (its apps
    # view card), else its own module
    func app_name_of [ pi: i32 ] -> string
        ed : Editor pane_at[ pi ]
        rv : AppView (ed) ? ed.run_view : null
        if [ !rv ] return ''
        if [ rv.origin ] return rv.origin.stem[]
        return (rv.app_mod) ? rv.app_mod : ''

    # the program whose window a pane shows
    func window_program [ pi: i32 ] -> string
        wid : u64 [ pane_window[ pi ] ]
        if [ wid == 0 ] return ''
        for [ av: AppView ] in instances
            if [ av.wl_window == wid ]
                pn : string program_of[ av ]
                if [ pn.count > 0 ] return pn
        # no instance known for it: the window's own app id
        ai : cstr wlc_window_app[ wid ]
        return (ai) ? string [ ai ] : ''

    # a pane on its Open page: no file, no app running in it
    func pane_empty [ pi: i32 ] -> bool
        # a window's pane has no editor
        if [ pane_window[ pi ] != 0 ] return false
        # a terminal in it (an agent's, a console): not empty
        if [ pi < pane_console.count && pane_console[ pi ].count > 0 ]
            return false
        ed : Editor pane_at[ pi ]
        if [ !ed ] return true
        rv : AppView ed.run_view
        if [ rv && !rv.ended ] return false
        return !ed.src

    # the pane's close, always, ending at xr (the pane's right end);
    # the x where it starts
    func pane_close_el [ t: Elements, pi: i32, xr: f32 ] -> f32
        # the load button's width
        cw : f32 [ 1.33 * unit_px[] ]
        t['pclose_{pi}'] = AltTab [
            buttons: vec string [] [ 'pclose_{pi}' ],
            icon_ids: vec string [] [ 'close' ], icon_scale: 0.6,
            manual: true, seg_radius: 0.0, use_spacing: false,
            rest_fill: rgba [ '#0000' ],
            area: Region [ 'l{xr - cw}px t0 w{cw}px b0' ] ]
        # the app's panel: its toggle beside the close, lit open (the
        # app keeps it open until it is pressed again)
        ed : Editor pane_at[ pi ]
        av : AppView (ed && ed.app_view) ? ed.run_view : null
        if [ !av || av.ended || !av.has_panel ] return xr - cw
        t['ppanel_{pi}'] = AltTab [
            buttons: vec string [] [ 'ppanel_{pi}' ],
            icon_ids: vec string [] [ 'panel' ], icon_scale: 0.575,
            manual: true, seg_radius: 0.0, use_spacing: false,
            rest_fill: rgba [ '#0000' ],
            sel_mask: (av.panel_on) ? 1 : 0,
            area: Region [ 'l{xr - cw * 2.0}px t0 w{cw}px b0' ] ]
        return xr - cw * 2.0

    # the app's outline: its toggle at x, lit open (the title after
    # it); the x after
    func pane_outline_el [ t: Elements, pi: i32, x: f32,
                           pre: string ] -> f32
        ed : Editor pane_at[ pi ]
        av : AppView (ed && ed.app_view) ? ed.run_view : null
        if [ !av || av.ended || !av.has_outline ] return x
        cw : f32 [ 1.33 * unit_px[] ]
        t['{pre}poutline_{pi}'] = AltTab [
            buttons: vec string [] [ '{pre}poutline_{pi}' ],
            icon_ids: vec string [] [ 'outline' ], icon_scale: 0.575,
            manual: true, seg_radius: 0.0, use_spacing: false,
            rest_fill: rgba [ '#0000' ],
            sel_mask: (av.outline_on) ? 1 : 0,
            area: Region [ 'l{x}px t0 w{cw}px b0' ] ]
        return x + cw

    # a pane's left edge in the window, from this frame's layout (the
    # split's eased place), not the pointer's last walk
    func pane_left [ pi: i32 ] -> f32
        x : f32 [ 0.0 ]
        for [ e: element* pane_view[ pi ], e, e = e.parent ]
            if [ e.bounds ] x += e.bounds.x
            if [ e.parent ] x -= e.parent.scroll.x
        return x

    # the navigator's globe at x (lit while it shows); the x after
    func globe_el [ t: Elements, id: string, x: f32, pi: i32 ]
            -> f32
        # as wide as the pane's editor gutter, so its menus line up
        # with the code
        gw : f32 globe_w[ pi ]
        t[ id ] = AltTab [ buttons: vec string [] [ id ],
            icon_ids: vec string [] [ 'navigator' ], icon_scale: 0.55,
            manual: true, seg_radius: 0.0, use_spacing: false,
            rest_fill: rgba [ '#0000' ],
            sel_mask: (nav_showing && id == 'bar_title') ? 1 : 0,
            area: Region [ 'l{x}px t0 w{gw}px b0' ] ]
        return x + gw

    func pane_entry [ act: string ] -> bool
        # a separator has no action
        if [ !act ] return false
        return act == 'orb.pane_add' || act == 'orb.pane_close'
            || act == 'orb.shot'
            || act.starts_with[ 'orb.code:' ]
            || act.starts_with[ 'orb.inst:' ] || act == 'orb.inst_new'
            || act == 'orb.git' || act == 'orb.prule'
            || act == 'orb.paneroot' || act.starts_with[ 'orb.pview:' ]
            || act == 'orb.build' || act == 'orb.clean'

    # the pane's controls under the app's own menu (its first): a
    # pane added, this one closed, git, its views
    func pane_menu []
        if [ !menu_items ] menu_items = vec TrayEntry []
        keep : vec TrayEntry []
        for [ e: TrayEntry ] in menu_items
            if [ !pane_entry[ e.action ] ] keep.push[ e ]
        menu_items = keep
        f : i32 [ -1 ]
        for [ i: i32 0, i < menu_items.count, i += 1 ]
            if [ f < 0 && menu_items[ i ].depth == 0
                 && !menu_items[ i ].rule ] f = i
        # no app menu (a file in the editor): one named for it
        if [ f < 0 ]
            nm : string bar_title[]
            dt : i32 [ nm.rindex_of[ '.' ] ]
            if [ dt > 0 ] nm = nm.mid[ 0, dt ]
            if [ nm.count == 0 ] nm = 'Pane'
            menu_items.push[ own_entry[ nm, 'orb.paneroot', 0 ] ]
            f = menu_items.count - 1
        # first in it: the switch, its code or one of its instances
        ed8 : Editor pane_at[ active_pane ]
        rs8 : vec AppView app_runs[ pane_app[ active_pane ] ]
        fr8 : vec AppView free_runs[]
        if [ ed8 && rs8.count + fr8.count > 0 ]
            sw8 : vec TrayEntry []
            # each instance: its window, and its Code (its source and
            # debug session) on the same row
            for [ av8: AppView ] in rs8
                # a failed build or an exit left no instance to show
                if [ av8.ended ] continue
                ie8 : TrayEntry own_entry[ task_title[ av8 ],
                    'orb.inst:{av8.iid}', 1 ]
                ie8.check = (ed8.app_view && ed8.run_view == av8) ? 1 : 0
                ie8.side = 'Code'
                ie8.side_action = 'orb.code:{av8.iid}'
                ie8.side_check = !ed8.app_view && ed8.run_view == av8
                sw8.push[ ie8 ]
            # the windows of apps no pane shows: a pick brings one in
            for [ av8: AppView ] in fr8
                fe8 : TrayEntry own_entry[ task_title[ av8 ],
                    'orb.inst:{av8.iid}', 1 ]
                fe8.side = 'Code'
                fe8.side_action = 'orb.code:{av8.iid}'
                sw8.push[ fe8 ]
            # another of the app, running in this pane
            if [ ed8.src ]
                sw8.push[ own_entry[ 'New instance', 'orb.inst_new',
                                     1 ] ]
            sw8.push[ TrayEntry [ rule: true, depth: 1, check: -1,
                action: 'orb.prule' ] ]
            for [ k8: i32 sw8.count - 1, k8 >= 0, k8 -= 1 ]
                menu_items.insert[ sw8[ k8 ], f + 1 ]
        at : i32 [ f + 1 ]
        while [ at < menu_items.count && menu_items[ at ].depth > 0 ]
            at += 1
        # Quit stays the last: ours go before it (and its rule)
        for [ q: i32 f + 1, q < at, q += 1 ]
            qe : TrayEntry menu_items[ q ]
            if [ qe.depth == 1 && !qe.rule
                 && (qe.action == 'orb.quit' || qe.label == 'Quit') ]
                at = (q > f + 1 && menu_items[ q - 1 ].rule) ? q - 1 : q
                break
        add : vec TrayEntry []
        # a line before them, unless one is there already
        if [ at > f + 1 && !menu_items[ at - 1 ].rule ]
            add.push[ TrayEntry [ rule: true, depth: 1, check: -1,
                action: 'orb.prule' ] ]
        ed : Editor pane_at[ active_pane ]
        # the pane: split it, its app's picture to the clipboard, close
        add.push[ own_entry[ 'Split', 'orb.pane_add', 1 ] ]
        if [ ed && ed.run_view ]
            add.push[ own_entry[ 'Screenshot', 'orb.shot', 1 ] ]
        add.push[ own_entry[ 'Hide', 'orb.pane_close', 1 ] ]
        # every app here is built from its source: again, or clean
        if [ app_module[] ]
            add.push[ TrayEntry [ rule: true, depth: 1, check: -1,
                action: 'orb.prule' ] ]
            add.push[ own_entry[ 'Build', 'orb.build', 1 ] ]
            add.push[ own_entry[ 'Clean build', 'orb.clean', 1 ] ]
        for [ k: i32 add.count - 1, k >= 0, k -= 1 ]
            menu_items.insert[ add[ k ], at ]

    # the views a pane's file offers (the navigator's right column):
    # its git reference when it is in a checkout, then the others
    func file_views [ ed: Editor ] -> vec string
        out : vec string []
        if [ !ed || !ed.src ] return out
        if [ checkout_root[ ed.src.directory[] ] ] out.push[ 'git' ]
        for [ v: string ] in views_for[ ed ]
            if [ v != 'git' ] out.push[ v ]
        return out

    # a view's button pressed: git toggles its reference, another view
    # shows (again: the file as it is); the navigator gives way to it
    func pane_view_press [ ed: Editor, v: string ]
        if [ !ed ] return
        if [ v == 'git' ]
            own_pick[ own_entry[ '', 'orb.git', 1 ] ]
        el
            own_pick[ own_entry[ '', 'orb.pview:{v}', 1 ] ]
        exit_finder[]
        nav_showing  = false
        find_showing = false
        force_update[]

    # the module a pane's app runs from ('' none): its group's key
    # (its source shown counts: the tab is that app's)
    # the pane's module updating: how far (build_frac), -2 if not
    func pane_build [ pi: i32 ] -> f32
        ed : Editor pane_at[ pi ]
        rv : AppView (ed) ? ed.run_view : null
        sp : path (rv && rv.src) ? rv.src : ((ed) ? ed.src : null)
        if [ !sp ] return -2.0
        return build_frac[ sp.directory[].filename[] ]

    func pane_app [ pi: i32 ] -> string
        ed : Editor pane_at[ pi ]
        rv : AppView (ed) ? ed.run_view : null
        if [ rv && rv.src && (!rv.ended || run_failed[ rv ]) ]
            return '{rv.src.directory[]}'
        if [ ed && ed.src ]
            k : '{ed.src.directory[]}'
            if [ app_runs[ k ].count > 0 ] return k
        return ''

    # the running instances of one app (its module's folder)
    func app_runs [ key: string ] -> vec AppView
        r : vec AppView []
        if [ !instances || key.count == 0 ] return r
        for [ av: AppView ] in instances
            if [ av.slot < 0 || av.held ] continue
            if [ av.ended && !run_failed[ av ] ] continue
            if [ !av.src || '{av.src.directory[]}' != key ] continue
            r.push[ av ]
        return r

    # the instances of the apps no pane shows (in the app menu)
    func free_runs [] -> vec AppView
        r : vec AppView []
        if [ !instances ] return r
        shown : vec string []
        for [ pi: i32 0, pi < editor_slots.count, pi += 1 ]
            shown.push[ pane_app[ pi ] ]
        for [ av: AppView ] in instances
            if [ !av.src || av.slot < 0 || av.held || av.ended ]
                continue
            k : '{av.src.directory[]}'
            seen : bool [ false ]
            for [ s9: string ] in shown
                if [ s9 == k ] seen = true
            if [ !seen ] r.push[ av ]
        return r

    # the title after the app's name; its width back
    func bar_title_el [ t: Elements, tt: string, x: f32, xr: f32 ]
        if [ xr <= x ] return
        ed : Editor pane_at[ active_pane ]
        rv : AppView (ed) ? ed.run_view : null
        dm : string domain_of[ (rv) ? rv.app_address : null ]
        t['bar_url'] = BarTitle [
            label: (bar_typing) ? '{bar_text}|' : '',
            typing: bar_typing, site: tt, domain: dm,
            area: Region [ 'l{x}px t0 w{xr - x}px b0' ] ]
        if [ bar_typing ] return
        # the name from the left, cut with a fade where the domain
        # needs the room; the domain at the right, yellow over https
        bt : cast BarTitle [ find_el[ a, 'bar_url' ] ]
        if [ !bt ] return
        uu : f32 ux_unit[ ux ]
        pad : f32 [ 10.0 * uu ]
        bw : f32 [ xr - x ]
        dw : f32 [ (dm.count > 0) ? bt.domain_w + 2.0 * pad : 0.0 ]
        tw : f32 [ bt.site_w ]
        sx : f32 [ pad ]
        room : f32 [ bw - dw - sx ]
        t['bar_site'] = BarText [ label: tt,
            mask_glow: vec4f [ 0.0, (tw > room) ? 24.0 : 0.0, 0.0, 0.0 ],
            area: Region [ 'l{x + sx}px t0 w{room}px b0' ] ]
        if [ dw > 0.0 ]
            t['bar_domain'] = BarDomain [ label: dm,
                secure: rv && rv.app_address
                    && rv.app_address.starts_with[ 'https://' ],
                area: Region [
                    'l{xr - dw + pad}px t0 w{dw - 2.0 * pad}px b0' ] ]

    # a running app's own title after its menus, cut with a fade;
    # a press browses for what it loads
    func bar_name_el [ t: Elements, tt: string, x: f32, xr: f32,
                       key: string, pi: i32 ]
        if [ xr <= x || tt.count == 0 ] return
        # the load mark at its right: browse for what it loads, for
        # an app whose argument is a resource it takes live
        lw : f32 [ 1.33 * unit_px[] ]
        xe : f32 [ xr ]
        if [ xr - lw > x && pane_loads[ pi ] ]
            t['bar_load{key}'] = AltTab [
                buttons: vec string [] [ 'bar_load{key}' ],
                icon_ids: vec string [] [ 'eject' ], icon_scale: 0.5,
                manual: true, seg_radius: 0.0, use_spacing: false,
                rest_fill: rgba [ '#0000' ],
                area: Region [ 'l{xr - lw}px t0 w{lw}px b0' ] ]
            xe = xr - lw
        t['bar_name{key}'] = BarTitle [ label: '', site: tt,
            area: Region [ 'l{x}px t0 w{xe - x}px b0' ] ]
        bt : cast BarTitle [ find_el[ a, 'bar_name{key}' ] ]
        pad : f32 [ 10.0 * ux_unit[ ux ] ]
        room : f32 [ xe - x - pad ]
        tw : f32 [ (bt) ? bt.site_w : 0.0 ]
        t['bar_site{key}'] = BarText [ label: tt,
            mask_glow: vec4f [ 0.0, (tw > room) ? 24.0 : 0.0, 0.0, 0.0 ],
            area: Region [ 'l{x + pad}px t0 w{room}px b0' ] ]

    # the active pane shows a running app (not a window's)
    func bar_app_on [] -> bool
        return pane_app_on[ active_pane ]

    # the pane's app takes a resource live: it can load another
    func pane_loads [ pi: i32 ] -> bool
        ed : Editor pane_at[ pi ]
        rv : AppView (ed) ? ed.run_view : null
        return rv && live_arg_of[ rv ] != null && !url_app[ rv ]

    func pane_app_on [ pi: i32 ] -> bool
        ed : Editor pane_at[ pi ]
        rv : AppView (ed && ed.app_view) ? ed.run_view : null
        return rv && !rv.ended && !rv.held && window_of[ rv ] == 0

    # a URL's host, without its www.
    func domain_of [ u: string ] -> string
        if [ !u ] return ''
        h : string u
        s9 : i32 [ h.index_of[ '://' ] ]
        if [ s9 >= 0 ] h = h.mid[ s9 + 3, h.count - s9 - 3 ]
        e9 : i32 [ h.index_of[ '/' ] ]
        if [ e9 >= 0 ] h = h.mid[ 0, e9 ]
        if [ h.starts_with[ 'www.' ] ] h = h.mid[ 4, h.count - 4 ]
        return h

    # the active pane runs an app whose live argument is typed (a URL)
    func bar_url_on [] -> bool
        ed : Editor pane_at[ active_pane ]
        rv : AppView (ed && ed.app_view) ? ed.run_view : null
        if [ !rv || rv.ended || window_of[ rv ] != 0 ] return false
        return url_app[ rv ]

    # its argument is an address: its module exports protocols
    func url_app [ rv: AppView ] -> bool
        dp : Prop live_arg_of[ rv ]
        if [ !dp || dp.type == 'resource' || dp.type == 'path' ]
            return false
        ed : Editor pane_at[ active_pane ]
        if [ !ed ] return false
        ed.ensure_export_registry[]
        for [ m: string, pr: string ] in ed.export_protocol
            if [ m == rv.app_mod ] return true
        return false

    # what the active pane holds, after the app's name: the app's URL
    # or file, else the file shown, else the pane's own title
    func bar_title [] -> string
        return bar_title_of[ active_pane ]

    func bar_title_of [ pi: i32 ] -> string
        # an agent's terminal: the instance and its model
        pc : string [ (pi >= 0 && pi < pane_console.count)
                      ? pane_console[ pi ] : '' ]
        if [ pc.starts_with[ 'home:' ] ]
            hn : string pc.mid[ 5, pc.count - 5 ]
            hm : string home_model_of[ hn ]
            return (hm.count > 0) ? '{hn}  {hm}' : hn
        ed : Editor pane_at[ pi ]
        rv : AppView (ed) ? ed.run_view : null
        if [ rv && !rv.ended && window_of[ rv ] == 0 ]
            # the app's own title (a site's name); its address once
            # pressed
            if [ rv.app_title && rv.app_title.count > 0 ]
                return rv.app_title
            if [ rv.app_address && rv.app_address.count > 0 ]
                return rv.app_address
            ar : string (rv.arg_text && rv.arg_text.count > 0)
                ? rv.arg_text : default_arg_of[ rv.module_args ]
            if [ ar.count > 0 ]
                if [ ar.index_of[ '://' ] > 0 ] return ar
                return (path [ ar ]).filename[]
        if [ ed && ed.src ] return ed.src.filename[]
        pv : element pane_view[ pi ]
        if [ !pv || !(pv inherits EditorView) ] return ''
        ev9 : EditorView pv
        tx : string ev9.title_text[]
        return (tx) ? tx : ''

    # back / forward unavailable: 1 back, 2 forward
    # a pane's back and forward ending at xr, only once its app has
    # somewhere to go (more than one point in its history); the x
    # where they start (xr when none)
    func nav_arrows_el [ t: Elements, pi: i32, xr: f32 ] -> f32
        dm : i32 nav_mask[ pi ]
        if [ dm == 3 ] return xr
        aw : f32 [ 2.39 * unit_px[] ]
        t['snav_{pi}'] = AltTab [
            buttons: vec string [] [ 'nav_back:{pi}', 'nav_fwd:{pi}' ],
            icon_ids: vec string [] [ 'left', 'right' ],
            icon_scale: 0.30, manual: true, seg_radius: 0.0,
            use_spacing: false, rest_fill: rgba [ '#0000' ],
            disable_mask: dm, seg_reach: 0.5,
            area: Region [ 'l{xr - aw}px t0 w{aw}px b0' ] ]
        return xr - aw

    func nav_mask [ pi: i32 ] -> i32
        edp : Editor pane_at[ pi ]
        ndm : i32 [ 0 ]
        if [ edp && edp.app_view && edp.run_view ]
            if [ !edp.run_view.nav_back_on ] ndm |= 1
            if [ !edp.run_view.nav_fwd_on ]  ndm |= 2
        el [ edp && edp.view_key[].count > 0 ]
            if [ !edp.view_can[ -1 ] ] ndm |= 1
            if [ !edp.view_can[ 1 ] ]  ndm |= 2
        el
            if [ !edp || !edp.nav || !edp.nav.can_back[] ]    ndm |= 1
            if [ !edp || !edp.nav || !edp.nav.can_forward[] ] ndm |= 2
        return ndm

    # a press on the bar's title: a typed argument (a URL) is edited
    # here; a file opens the navigator; a pane with no app, too
    func bar_title_press []
        ed : Editor pane_at[ active_pane ]
        rv : AppView (ed && ed.app_view) ? ed.run_view : null
        if [ rv && window_of[ rv ] != 0 ] rv = null
        if [ rv && !rv.ended ]
            if [ url_app[ rv ] ]
                bar_text = (rv.arg_text) ? rv.arg_text
                    : default_arg_of[ rv.module_args ]
                url_entry_on  = true
                title_find_on = false
                pending_finder = active_pane
                force_update[]
                return
            hm : string band_mod_of[ ed ]
            cur : string (rv.arg_text) ? rv.arg_text : ''
            pick_default[ ed, null, hm, cur ]
            return
        focus_finder[]

    # Enter on a typed title: the running app takes it live
    func bar_title_apply []
        bar_typing = false
        ed : Editor pane_at[ active_pane ]
        rv : AppView (ed) ? ed.run_view : null
        dp : Prop (rv) ? live_arg_of[ rv ] : null
        if [ rv && dp && !rv.ended && bar_text.count > 0 ]
            rv.arg_text = bar_text
            agent_sock_send[ rv.sock_name[].chars,
                             'set {dp.ident} {rv.arg_text}\n' ]
            session_dirty = true
        if [ ux ] ux.restyle = true

    # the pane's title finds in its file: the system bar's editor,
    # unless the navigator was asked for
    func title_finds [] -> bool
        if [ !title_find_on || nav_req || !system_on[] ] return false
        ed : Editor pane_at[ active_pane ]
        if [ !ed || !ed.src || ed.app_view ] return false
        win : ux
        return win && win.focus && win.focus.id == 'title'

    # ctrl+f: the title starts finding in the file, or stops
    func title_find_toggle []
        te : element title_at[ active_pane ]
        if [ title_find_on ]
            title_find_end[ te ]
            return
        title_find_on = true
        nav_req       = false
        findbar_text  = ''
        ed : Editor pane_at[ active_pane ]
        find_from_line = (ed && ed.sel_line >= 0) ? ed.sel_line : 0
        find_from_col  = (ed && ed.sel_col >= 0) ? ed.sel_col : 0
        # the bar comes up for it: focused once it is there
        if [ te ]
            te.edit = ''
            te.set_focus[]
        el pending_finder = active_pane
        force_update[]

    # the URL entry ends: the bar goes with its focus
    func url_entry_end [ te: element ]
        url_entry_on = false
        if [ te && te.ux ] te.ux.release_focus[ te ]
        force_update[]

    # the title stops finding: its text and focus go
    func title_find_end [ te: element ]
        title_find_on = false
        findbar_text  = ''
        # its matches unlit
        ed : Editor pane_at[ active_pane ]
        if [ ed ]
            ed.find_query = ''
            ed.pristine   = false
        if [ te ]
            te.edit = ''
            if [ te.ux ] te.ux.release_focus[ te ]
        force_update[]

    # the find typed in the title: the first match from where it
    # began, lit in the file
    func find_live []
        ed : Editor pane_at[ active_pane ]
        if [ !ed ] return
        if [ !findbar_text || findbar_text.count == 0 ]
            ed.sel_line = find_from_line
            ed.sel_col  = find_from_col
            return
        ed.sel_line = find_from_line
        ed.sel_col  = find_from_col - 1
        find_file_next[]

    # the gear shows clear: shift over it, or ctrl / cmd anywhere
    func console_clearing [] -> bool
        if [ !ux ] return false
        if [ ux.cmd ] return true
        dc : element find_el[ a, 'dock_console' ]
        return ux.shift && dc && dc.hovered

    # the session the console shows: the debugger's; else the selected
    # instance's (all, by the toolbar's Global), else all
    func console_sid [] -> string
        if [ con_dbg ]
            dbg_log[]
            return 'dbg:log'
        if [ !con_global ]
            ed : Editor pane_at[ active_pane ]
            isid : string inst_sid[ (ed) ? ed.run_view : null ]
            if [ isid && ed_sessions && ed_sessions.contains[ isid ] ]
                return isid
        all_log[]
        return 'ed:all'

    # every app's log: made here with no shell (the console would make
    # one, its prompt and all), its tails started once an app runs
    func all_log [] -> ConsoleSession
        if [ !ed_sessions ]
            ed_sessions = map ConsoleSession [string] [ ]
        ga : ConsoleSession ed_sessions[ 'ed:all' ]
        if [ !ga ]
            ga = ConsoleSession []
            ga.name   = 'ed:all'
            ga.nowrap = true
            ga.cursor_visible = false
            ed_sessions[ 'ed:all' ] = ga
        return ga

    # the debugger's console: its own log, no shell behind it; lines
    # are printed into it (its stops, exits, commands and answers)
    func dbg_log [] -> ConsoleSession
        if [ !ed_sessions ]
            ed_sessions = map ConsoleSession [string] [ ]
        dl : ConsoleSession ed_sessions[ 'dbg:log' ]
        if [ !dl ]
            dl = ConsoleSession []
            dl.name   = 'dbg:log'
            dl.nowrap = true
            ed_sessions[ 'dbg:log' ] = dl
        return dl

    # a line in the debugger's console (its feed: a session with no
    # shell draws the lines it is given)
    func dbg_say [ line: string ]
        dbg_log[]
        if [ !dbg_lines ] dbg_lines = list string []
        dbg_lines.push[ line ]
        if [ ux ] dirty_consoles[ ux.root ]

    # the debugger's console's lines, made once
    func dbg_feed [] -> list string
        if [ !dbg_lines ] dbg_lines = list string []
        return dbg_lines

    # a line typed at the console's foot: lldb's in the debugger's
    # console, else the selected app's standard input
    func console_input [ line: string ]
        if [ con_dbg ]
            dbg_run[ line ]
            return
        ed : Editor pane_at[ active_pane ]
        av : AppView (ed) ? ed.run_view : null
        if [ !av || av.ended || av.slot <= 0 || !av.app_mod ] return
        at : string '{startup_path}/install/tmp/{av.app_mod}.{av.slot}'
        ip : string '{at}.in'
        fd : i32 open[ ip.chars, O_WRONLY | O_NONBLOCK ]
        if [ fd < 0 ] return
        ln : string '{line}\n'
        write[ fd, ln.chars, ln.count ]
        close[ fd ]
        # it shows in the log, as typed
        lp : string '{at}.log'
        lf : i32 open[ lp.chars, O_WRONLY | O_APPEND ]
        if [ lf < 0 ] return
        echo : string '> {line}\n'
        write[ lf, echo.chars, echo.count ]
        close[ lf ]

    # a line typed in the debugger's console: lldb's own command
    func dbg_run [ line: string ]
        if [ !line || line.count == 0 ] return
        dbg_say[ '(lldb) {line}' ]
        d : dbg active_debugger[]
        if [ !d ]
            dbg_say[ 'no debugger: run the app with debug on' ]
            return
        out : string d.command[ line ]
        for [ ln: string ] in out.split[ '\n' ]
            if [ ln.count > 0 ] dbg_say[ ln ]

    # the console's toolbar: the debugger's console, clear, and the
    # selected app's log or every app's
    func console_tool_els [] -> Elements
        t : Elements []
        bw : f32 [ 1.33 * unit_px[] ]
        t['con_dbg'] = AltTab [ buttons: vec string [] [ 'con_dbg' ],
            icon_ids: vec string [] [ 'debug' ], icon_scale: 0.5,
            manual: true, seg_radius: 0.0, use_spacing: false,
            rest_fill: rgba [ '#0000' ], sel_mask: (con_dbg) ? 1 : 0,
            area: Region [ 'l0 t0 w{bw}px b1px' ] ]
        t['con_clear'] = AltTab [
            buttons: vec string [] [ 'con_clear' ],
            icon_ids: vec string [] [ 'delete_sweep' ], icon_scale: 0.6,
            manual: true, seg_radius: 0.0, use_spacing: false,
            rest_fill: rgba [ '#0000' ],
            area: Region [ 'l{bw}px t0 w{bw}px b1px' ] ]
        # the selected app's or every app's: beside the debugger's, a
        # log of the same level
        sw : f32 [ 2.6 * unit_px[] ]
        x : f32 [ bw * 2.0 ]
        t['con_scope'] = AltTab [
            buttons: vec string [] [ 'con_app', 'con_global' ],
            icon_ids: vec string [] [ '_text', '_text' ],
            labels: vec string [] [ 'App', 'Global' ],
            label_font: 'fonts/BarlowCondensed-Regular.ttf',
            manual: true, seg_radius: 0.0, use_spacing: false,
            rest_fill: rgba [ '#0000' ],
            sel_mask: (con_dbg) ? 0 : ((con_global) ? 2 : 1),
            area: Region [ 'l{x}px t0 w{sw * 2.0}px b1px' ] ]
        return t

    # our apps: every module whose export names its section
    # (export software ['games']), its folder in silver's own
    func app_entries [] -> vec AppEntry
        if [ app_list ] return app_list
        app_list = vec AppEntry []
        root : path path.path_startup[]
        ex : path '{root}/install/export'
        for [ f: path ] in ex.ls[ null, false ]
            if [ f.ext[] != 'agi' ] continue
            tx : string f.load[ typeid[ string ], null ]
            if [ !tx ] continue
            gr : string agi_word[ tx, 'software' ]
            if [ gr.count == 0 ] continue
            # its name: module:, which only a trinity app writes; else
            # the file's (<owner>-<name>.agi), owner parts dropped one
            # at a time till a module folder answers
            mn : string agi_word[ tx, 'module' ]
            md : path null
            mf : path null
            cands : vec string []
            if [ mn.count > 0 ] cands.push[ mn ]
            st : string f.stem[]
            while [ st.count > 0 ]
                cands.push[ st ]
                dh : i32 [ st.index_of[ '-' ] ]
                if [ dh < 0 ] break
                st = st.mid[ dh + 1, st.count - dh - 1 ]
            # ours at silver's root; the featured, featured/
            bases : vec string [] [ '{root}', '{root}/featured' ]
            for [ cn: string ] in cands
                if [ md ] break
                for [ base: string ] in bases
                    tf : path '{base}/{cn}/{cn}.ag'
                    if [ !md && tf.exists[] ]
                        md = path '{base}/{cn}'
                        mf = tf
                        mn = cn
            if [ !md ] continue
            ae : AppEntry [ name: mn, file: md, module: true, agi: f,
                group: gr ]
            # not a trinity app (no props): it builds a program, ours
            # once it is in install/bin
            if [ tx.index_of[ '\nprops:' ] < 0 ]
                ae.built = path '{root}/install/bin/{mn}'
            app_list.push[ ae ]
        # the featured: featured/software.agi's names, in its order,
        # each a module featured/<name>/<name>.ag that names its
        # section (export software ['everyday']), built or not
        for [ fn: string ] in featured_names[]
            d : path '{root}/featured/{fn}'
            fm : path '{d}/{fn}.ag'
            # no module yet: recommended, by name alone
            if [ !fm.exists[] ]
                app_list.push[ AppEntry [ name: fn, file: d,
                    module: false, group: 'recommended' ] ]
                continue
            seen : bool [ false ]
            for [ e9: AppEntry ] in app_list
                if [ e9.name == fn ] seen = true
            if [ seen ] continue
            src : string fm.load[ typeid[ string ], null ]
            fg : string source_word[ src, 'export software' ]
            if [ fg.count == 0 ] continue
            fe : AppEntry [ name: fn, file: d, module: true, group: fg ]
            fe.built = path '{root}/install/bin/{fn}'
            app_list.push[ fe ]
        return app_list

    # a line's first quoted word in source: "export software
    # ['games']" gives games; '' when the line is not there
    func source_word [ tx: string, key: string ] -> string
        at : i32 [ -1 ]
        k : '{key} '
        if [ tx.starts_with[ k ] ] at = 0
        el
            n9 : i32 [ tx.index_of[ '\n{k}' ] ]
            if [ n9 >= 0 ] at = n9 + 1
        if [ at < 0 ] return ''
        rest : tx.mid[ at + k.count, tx.count - at - k.count ]
        e9 : i32 [ rest.index_of[ '\n' ] ]
        v : string (e9 >= 0) ? rest.mid[ 0, e9 ] : rest
        q : i32 [ v.index_of[ "'" ] ]
        if [ q < 0 ] return ''
        r2 : v.mid[ q + 1, v.count - q - 1 ]
        q2 : i32 [ r2.index_of[ "'" ] ]
        return (q2 >= 0) ? r2.mid[ 0, q2 ] : r2

    # a top-level key's first word in agi text: 'module: knes' gives
    # knes, "software: ['games']" gives games; '' when absent
    func agi_word [ tx: string, key: string ] -> string
        at : i32 [ -1 ]
        k : '{key}: '
        if [ tx.starts_with[ k ] ] at = 0
        el
            n9 : i32 [ tx.index_of[ '\n{k}' ] ]
            if [ n9 >= 0 ] at = n9 + 1
        if [ at < 0 ] return ''
        rest : tx.mid[ at + k.count, tx.count - at - k.count ]
        e9 : i32 [ rest.index_of[ '\n' ] ]
        v : string ((e9 >= 0) ? rest.mid[ 0, e9 ] : rest).trim[]
        q : i32 [ v.index_of[ "'" ] ]
        if [ q >= 0 ]
            r2 : v.mid[ q + 1, v.count - q - 1 ]
            q2 : i32 [ r2.index_of[ "'" ] ]
            return (q2 >= 0) ? r2.mid[ 0, q2 ] : r2
        return v

    # featured/software.agi: its featured: [ ... ] names, in order
    func featured_names [] -> vec string
        res : vec string []
        sf : path '{path.path_startup[]}/featured/software.agi'
        if [ !sf.exists[] ] return res
        tx : string sf.load[ typeid[ string ], null ]
        at : i32 [ tx.index_of[ 'featured:' ] ]
        if [ at < 0 ] return res
        rest : tx.mid[ at, tx.count - at ]
        ob : i32 [ rest.index_of[ '[' ] ]
        cb : i32 [ rest.index_of[ ']' ] ]
        if [ ob < 0 || cb < ob ] return res
        inner : string rest.mid[ ob + 1, cb - ob - 1 ]
        for [ w: string ] in inner.split[ ',' ]
            n : string w.trim[]
            if [ n.starts_with[ "'" ] && n.count >= 2 ]
                n = n.mid[ 1, n.count - 2 ]
            if [ n.count > 0 ] res.push[ n ]
        return res

    # a card pressed in pane pi's apps view: ours opens there; a
    # recommendation runs if it is here (installing it: later)
    # the login stands before everything: on orbiter-os with an
    # account written, or asked for (--login); no account: none
    func login_wait [] -> bool
        if [ signed_in ] return false
        if [ !login && !on_the_os[] ] return false
        if [ !login_read ]
            login_read = true
            login_load[]
        if [ login_users.count == 0 ] signed_in = true
        return !signed_in

    # the accounts file's user and password lines (the wizard's)
    func login_load []
        login_users  = vec string []
        login_hashes = vec string []
        f : path [ accounts ]
        if [ !f.exists[] ] return
        tx : string f.load[ typeid[ string ], null ]
        if [ !tx ] return
        nm : string ''
        for [ ln: string ] in tx.split[ '\n' ]
            if [ ln.starts_with[ 'user:' ] ]
                nm = ln.mid[ 5, ln.count - 5 ].trim[]
            el [ ln.starts_with[ 'password:' ] && nm.count > 0 ]
                h : string ln.mid[ 9, ln.count - 9 ].trim[]
                if [ h.starts_with[ "'" ] && h.count >= 2 ]
                    h = h.mid[ 1, h.count - 2 ]
                login_users.push[ nm ]
                login_hashes.push[ h ]
                nm = ''

    # Enter checks the password against its hash; backspace and
    # escape edit it
    func login_key [ ks: i32 ]
        if [ ks == 259 && login_pass.count > 0 ]
            login_pass = login_pass.mid[ 0, login_pass.count - 1 ]
        el [ ks == 256 ]
            login_pass = ''
        el [ ks == 257 || ks == 335 ]
            if [ login_sel < 0 || login_sel >= login_users.count ]
                return
            h : string login_hashes[ login_sel ]
            got : cstr [ crypt[ login_pass.chars, h.chars ] ]
            if [ got && h.count > 0 && string [ got ] == h ]
                signed_in = true
                log 'login: {login_users[ login_sel ]}'
            el
                login_note = 'That password is not right'
            login_pass = ''
        if [ ux ] ux.restyle = true

    # the selected pane's app quits: true when there was one
    func quit_pane_app [] -> bool
        return quit_app_in[ active_pane ]

    # pane pi's app quits (its window asked to close)
    func quit_app_in [ pi: i32 ] -> bool
        wv : u64 pane_window[ pi ]
        if [ wv != 0 ]
            wlc_window_close[ wv ]
            return true
        ed : Editor pane_at[ pi ]
        av : AppView (ed) ? ed.run_view : null
        if [ !av || av.ended || av.held || av.slot < 0 ] return false
        close_task[ av ]
        if [ ux ] ux.restyle = true
        return true

    # each installed agent with each of its models, 'agent|model'
    # (one with no models listed: 'agent|')
    func home_choices [] -> vec string
        out : vec string []
        for [ an: string ] in agent_installed[]
            ms : vec string null
            if [ agents ]
                for [ g: Agent ] in agents
                    if [ g.name == an ] ms = g.models
            if [ ms && ms.count > 0 ]
                for [ m: string ] in ms
                    out.push[ '{an}|{m}' ]
            el
                out.push[ '{an}|' ]
        return out

    # the instances, in the order added: a copy, so a holder sees
    # the list change
    func home_names [] -> vec string
        if [ !home_open ] home_open = ''
        # a new run: the instances kept from the last, their
        # sessions going on (a reload holds them already)
        if [ !home_back ]
            home_back = true
            if [ !home_order && home_saved ]
                for [ e: string ] in vec string [ home_saved ]
                    f : vec string e.split[ '|' ]
                    if [ f.count >= 4 ]
                        home_launch[ f[ 0 ], f[ 1 ], f[ 2 ], f[ 3 ] ]
                home_open = ''
        if [ !home_order ] return vec string []
        return vec string [ home_order ]

    func home_pick_agent [ p: string ] -> string
        at : i32 [ p.index_of[ '|' ] ]
        return (at < 0) ? p : p.mid[ 0, at ]

    func home_pick_model [ p: string ] -> string
        at : i32 [ p.index_of[ '|' ] ]
        if [ at < 0 ] return ''
        return p.mid[ at + 1, p.count - at - 1 ]

    # an agent's session, else null
    func home_session [ nm: string ] -> ConsoleSession
        if [ !home_sess || !home_sess.contains[ nm ] ] return null
        return home_sess[ nm ]

    # the model an agent's session runs, '' none
    func home_model_of [ nm: string ] -> string
        if [ !home_ran || !home_ran.contains[ nm ] ] return ''
        return home_ran[ nm ]

    # the agent waits for the user, by its terminal's title
    func home_waiting [ nm: string ] -> bool
        cs : ConsoleSession home_session[ nm ]
        if [ !cs || !cs.title || !home_runs
             || !home_runs.contains[ nm ] ]
            return false
        run : AgentRun home_runs[ nm ]
        return run.waiting*[ cs.title ]

    # what the agent says it is doing while it works, '' none
    func home_doing_of [ nm: string ] -> string
        if [ home_waiting[ nm ] || !home_doing
             || !home_doing.contains[ nm ] ]
            return ''
        d : string home_doing[ nm ]
        return (d == 'done') ? '' : d

    # at work, the agent writes (its answer, an edit), by its run
    func home_writing [ nm: string ] -> bool
        cs : ConsoleSession home_session[ nm ]
        if [ !cs || !cs.title || !home_runs
             || !home_runs.contains[ nm ] ]
            return false
        run : AgentRun home_runs[ nm ]
        return run.writing*[ cs.title ]

    # an instance ends: its terminal, its place in the stack
    func home_end [ nm: string ]
        cs : ConsoleSession home_session[ nm ]
        if [ cs ]
            cs.end[]
            home_sess.rm[ nm ]
        if [ home_order ]
            k : i32 [ home_order.index_of[ nm ] ]
            if [ k >= 0 ] home_order.remove[ k ]
        if [ home_open == nm ] home_open = ''
        home_keep[]

    # a new instance of an agent at a model: its own terminal, in
    # our folder, added to the stack and open; named by its agent,
    # a number after it from the second on
    func home_start [ an: string, model: string ]
        if [ !home_order ] home_order = vec string []
        nm : string an
        n : i32 [ 2 ]
        while [ home_order.index_of[ nm ] >= 0 ]
            nm = '{an}-{n}'
            n += 1
        home_launch[ nm, an, model, '' ]

    # an instance's terminal, named nm, its session going on ('' a
    # new one)
    func home_launch [ nm: string, an: string, model: string,
                       session: string ]
        if [ !home_sess ] home_sess = map ConsoleSession [ string ] []
        if [ !home_runs ] home_runs = map AgentRun [ string ] []
        if [ !home_ran ]  home_ran  = map string [ string ] []
        if [ !home_order ] home_order = vec string []
        if [ !home_agent ] home_agent = map string [ string ] []
        if [ home_order.index_of[ nm ] >= 0 ] return
        root : string '{startup_path}'
        # past the instances held (a reload starts the count again)
        home_made = max[ home_made, i32[ home_order.count ] ] + 1
        sid : i32 [ 1000 + home_made ]
        line : agent_term_line_in[ sid, an, root, model, session ]
        if [ line.count == 0 ]
            home_why = agent_error[]
            return
        home_why = ''
        cs : ConsoleSession []
        cs.name       = 'home_{nm}'
        # its name, for what it tells orbiter
        cs.launch_cmd = 'env ORBITER_AGENT={nm} {line}'
        cs.cwd        = root
        cs.start[]
        home_sess[ nm ]  = cs
        home_ran[ nm ]   = model
        home_agent[ nm ] = an
        home_order.push[ nm ]
        # the run its line was made by: it knows its session
        run : AgentRun agent_term_run[ sid ]
        if [ run ] home_runs[ nm ] = run
        home_open = nm
        home_keep[]

    # an agent's first instance in the agents view ('' none)
    func home_first [ an: string ] -> string
        if [ !home_order ] return ''
        for [ nm: string ] in home_order
            ag : string [ (home_agent && home_agent.contains[ nm ])
                          ? home_agent[ nm ] : nm ]
            if [ ag == an && home_session[ nm ] ] return nm
        return ''

    # a new instance of an agent at its first model; its name
    func home_new [ an: string ] -> string
        md : string ''
        for [ c: string ] in home_choices[]
            if [ home_pick_agent[ c ] == an ]
                md = home_pick_model[ c ]
                break
        had : i32 [ (home_order) ? i32[ home_order.count ] : 0 ]
        home_start[ an, md ]
        if [ !home_order || home_order.count == had ] return ''
        return home_order.last[]

    # an instance's terminal in a pane: the same session the agents
    # view draws
    func home_in_pane [ nm: string, pi: i32 ]
        cs : ConsoleSession home_session[ nm ]
        if [ !cs || pi < 0 ] return
        ed : Editor pane_at[ pi ]
        while [ pane_console.count <= pi ]
            pane_console += ''
        sid : string 'home:{nm}'
        if [ !ed_sessions ]
            ed_sessions = map ConsoleSession [string] [ ]
        ed_sessions[ sid ] = cs
        pane_console[ pi ] = sid
        if [ ed ]
            ed.app_view = false
            ed.pristine = false
        force_update[]
        if [ ux ] ux.restyle = true

    # a pane showing an agent's terminal: its menu, every instance
    # of the agents view and a new one of its agent
    func agent_menu [ cur: string ] -> vec TrayEntry
        m : vec TrayEntry []
        an : string [ (home_agent && home_agent.contains[ cur ])
                      ? home_agent[ cur ] : cur ]
        m.push[ own_entry[ an, '', 0 ] ]
        if [ home_order ]
            for [ nm: string ] in home_order
                if [ !home_session[ nm ] ] continue
                md : string home_model_of[ nm ]
                ie : TrayEntry own_entry[
                    (md.count > 0) ? '{nm}  {md}' : nm,
                    'orb.agent:{nm}', 1 ]
                ie.check = (nm == cur) ? 1 : 0
                m.push[ ie ]
        m.push[ TrayEntry [ rule: true, depth: 1, check: -1 ] ]
        m.push[ own_entry[ 'New {an}', 'orb.agent_new:{an}', 1 ] ]
        return m

    # the instances, kept for the next run
    func home_keep []
        home_saved = vec string []
        if [ home_order ]
            for [ nm: string ] in home_order
                an : string [ (home_agent.contains[ nm ])
                              ? home_agent[ nm ] : nm ]
                md : string home_model_of[ nm ]
                se : string ''
                if [ home_runs && home_runs.contains[ nm ] ]
                    run : AgentRun home_runs[ nm ]
                    if [ run.resume ] se = run.resume
                home_saved.push[ '{nm}|{an}|{md}|{se}' ]
        save_session[]

    # the home is on screen: the desktop, or the active pane empty
    func home_seen [] -> bool
        return !any_docked[] || pane_empty[ active_pane ]

    # orbiter's button: the home on its agent view (a new docked view
    # for it when the active pane shows something); again, the apps
    func home_toggle []
        if [ home_tab == 'agent' && home_seen[] ]
            home_tab = 'home'
        el
            home_tab = 'agent'
            if [ !home_seen[] ]
                editor_slots += -1
                pane_console += ''
                active_pane = editor_slots.count - 1
                force_update[]
        if [ ux ] ux.restyle = true

    # the selected pane shows the apps and nothing takes the keys
    func apps_typing [] -> bool
        if [ drawer_open || nav_showing || find_showing || bar_typing ]
            return false
        if [ !pane_empty[ active_pane ] || home_tab != 'home' ]
            return false
        w : Window ux
        return !w || !w.focus || w.focus inherits AppsGrid

    func apps_pick [ pi: i32, ae: AppEntry ]
        if [ !ae ] return
        # the desktop behind free windows: the app opens maximized in a
        # docked view of its own, made now, the pick its next frame
        # (a new pane has no editor until it is drawn)
        if [ pi < 0 ]
            editor_slots += -1
            pane_console += ''
            active_pane = editor_slots.count - 1
            desk_pick   = ae
            force_update[]
            return
        active_pane = pi
        set_active[ pi ]
        # an agent's app: its first instance of the agents view here
        # (one made when it has none)
        if [ ae.module && ae.built && ae.built.exists[]
             && agent_installed[].index_of[ ae.name ] >= 0 ]
            nm : string home_first[ ae.name ]
            if [ nm.count == 0 ] nm = home_new[ ae.name ]
            if [ nm.count > 0 ] home_in_pane[ nm, pi ]
            if [ ux ] ux.restyle = true
            return
        if [ ae.module && ae.built && ae.built.exists[] ]
            run_program[ ae.built, pi ]
            edr : Editor pane_at[ pi ]
            mf : path '{ae.file}/{ae.name}.ag'
            if [ edr && edr.run_view && mf.exists[] ]
                edr.run_view.origin = mf
                # an agent shell's module: it tells when it waits
                for [ an: string ] in agent_installed[]
                    if [ an == ae.name ]
                        edr.run_view.agent = agent_make[ an ]
        el [ ae.module && ae.built ]
            # not built: install it (its module's imports, built)
            w9 : string install_word[ ae ]
            if [ !w9 || w9 == 'failed' || w9 == 'cancelled' ]
                install_start[ ae, false ]
        el [ ae.module ]
            di : DockIcon [ file: ae.file, module: true ]
            dock_icon_click[ di ]
        if [ ux ] ux.restyle = true

    # install a featured app: silver builds its module (every import
    # checked out, built, installed) in a console of its own,
    # install:<name>; its progress is silver's events (SILVER_EVENTS),
    # ended by the exit code
    func install_start [ ae: AppEntry, clean: bool ]
        root : string '{path.path_startup[]}'
        nm : string ae.name
        md : string '{ae.file}'
        lg : string '{root}/install/tmp/install-{nm}.log'
        # the transaction: silver's own events (SILVER_EVENTS), then
        # end <exit code> as it exits
        ev : string '{root}/install/tmp/install-{nm}.events'
        for [ old: string ] in vec string [] [ lg, ev ]
            unlink[ old.chars ]
        sv : string '{root}/install/bin/silver'
        # script gives silver a terminal (its own progress line shows)
        # and keeps a log of it all for the global console
        # verbose: every tool's own output (meson, ninja, make, the
        # compiler) streams as it runs, not only on failure
        cl : string [ (clean) ? ' --clean' : '' ]
        bd : string '\'{sv}\' --verbose{cl} --build \'{md}\''
        sh9 : string 'cd \'{root}\' && SILVER_EVENTS=\'{ev}\' script -qefc "{bd}" \'{lg}\'; echo end $? >> \'{ev}\''
        sid : string 'install:{nm}'
        if [ !ed_sessions ]
            ed_sessions = map ConsoleSession [string] [ ]
        cs : ConsoleSession ed_sessions[ sid ]
        if [ !cs ]
            cs = ConsoleSession []
            cs.name = sid
            cs.nowrap = true
            ed_sessions[ sid ] = cs
        cs.launch_cmd = ''
        cs.restart[]
        cs.pending = sh9
        if [ !inst_names ]
            inst_names = vec string []
            inst_pct   = vec f32 []
            inst_word  = vec string []
        at : i32 [ install_at[ nm ] ]
        if [ at < 0 ]
            inst_names.push[ nm ]
            inst_pct.push[ -1.0 ]
            inst_word.push[ 'starting' ]
        el
            inst_pct[ at ]  = -1.0
            inst_word[ at ] = 'starting'
        log 'install: {nm} in console {sid}, log {lg}'
        # its output in the system console, shown
        show_console = true
        if [ ux ] ux.restyle = true

    # stop an install: ctrl+C to its console reaches the whole build
    # (silver and its tools are the terminal's foreground job)
    func install_cancel [ ae: AppEntry ]
        if [ !ae || !ed_sessions ] return
        cs : ConsoleSession ed_sessions[ 'install:{ae.name}' ]
        if [ cs && cs.pty_fd >= 0 ]
            cc : local u8 [ 1 ] [ 3 ]
            write[ cs.pty_fd, @cc[ 0 ], 1 ]
        at : i32 [ install_at[ ae.name ] ]
        if [ at >= 0 ]
            inst_word[ at ] = 'cancelled'
            inst_pct[ at ]  = -1.0
        log 'install: {ae.name} cancelled'
        if [ ux ] ux.restyle = true

    func install_at [ nm: string ] -> i32
        if [ !inst_names ] return -1
        for [ i: i32 0, i < inst_names.count, i += 1 ]
            if [ inst_names[ i ] == nm ] return i
        return -1

    # an install's word ('starting', 'building', 'installed',
    # 'failed') and progress 0..1, or null / -1 while it has none
    func install_word [ ae: AppEntry ] -> string
        at : i32 [ (ae) ? install_at[ ae.name ] : -1 ]
        if [ at >= 0 && inst_word[ at ] != 'installed'
             && inst_word[ at ] != 'cancelled' ] return inst_word[ at ]
        # built some other way (a rebuild): updating
        if [ ae && build_frac[ ae.name ] > -2.0 ] return 'building'
        return (at >= 0) ? inst_word[ at ] : null

    func install_frac [ ae: AppEntry ] -> f32
        at : i32 [ (ae) ? install_at[ ae.name ] : -1 ]
        if [ ae && (at < 0 || inst_word[ at ] == 'installed') ]
            bf : f32 build_frac[ ae.name ]
            if [ bf > -2.0 ] return bf
        return (at >= 0) ? inst_pct[ at ] : -1.0

    # each install's transaction, read twice a second from silver's
    # events: module <name> <percent> (the whole build), step <import>
    # <phase> <percent>, and end <exit code>
    func install_poll []
        if [ !inst_names || inst_names.count == 0 ] return
        now : i64 [ epoch_millis[] ]
        if [ now - inst_ms < 500 ] return
        inst_ms = now
        root : string '{path.path_startup[]}'
        ch : bool [ false ]
        for [ i: i32 0, i < inst_names.count, i += 1 ]
            nm : string inst_names[ i ]
            if [ inst_word[ i ] == 'cancelled' ] continue
            evp : string '{root}/install/tmp/install-{nm}.events'
            tx : string log_tail[ evp, 65536 ]
            wd : string inst_word[ i ]
            pc : f32 [ inst_pct[ i ] ]
            # the module's imports, from its source: the steps are
            # each import's phases, in order
            tot : i32 [ import_count[ nm ] ]
            seen : vec string []
            cur : f32 [ 0.0 ]
            # silver's own module percent: what moves while the
            # imports it skips (already built) go by
            mp : f32 [ 0.0 ]
            for [ ln: string ] in tx.split[ '\n' ]
                ws : vec string ln.split[ ' ' ]
                if [ ws.count >= 4 && ws[ 0 ] == 'step' ]
                    known : bool [ false ]
                    for [ sn: string ] in seen
                        if [ sn == ws[ 1 ] ] known = true
                    if [ !known ] seen.push[ ws[ 1 ] ]
                    cur = phase_share[ ws[ 2 ],
                        f32[ ws[ 3 ].integer_value[] ] ]
                    wd = 'building'
                    if [ tot > 0 && seen.count > 0 ]
                        pc = max[ mp, min[ 1.0, (f32[ seen.count - 1 ]
                            + cur) / f32[ tot ] ] ]
                el [ ws.count >= 3 && ws[ 0 ] == 'module'
                     && ws[ 1 ] == nm ]
                    mp = f32[ ws[ 2 ].integer_value[] ] / 100.0
                    if [ mp > pc ] pc = mp
                    wd = 'building'
                el [ ws.count >= 2 && ws[ 0 ] == 'end' ]
                    rc : i64 ws[ 1 ].integer_value[]
                    wd = (rc == 0) ? 'installed' : 'failed'
                    if [ rc == 0 ] pc = 1.0
            if [ wd != inst_word[ i ] || pc != inst_pct[ i ] ]
                inst_word[ i ] = wd
                inst_pct[ i ]  = pc
                ch = true
        if [ ch && ux ] ux.restyle = true

    # every build silver runs writes its events: begin <pid>, its
    # module and import steps, end <code>. a build still going is an
    # app updating. a watch on their folder marks it; only a file
    # changed since its last read is read, at most twice a second
    func build_poll []
        dir : path '{path.path_startup[]}/install/tmp/builds'
        if [ !build_watch ]
            dir.make_dir[]
            build_seen = map i64 [string] []
            build_was  = map f32 [string] []
            build_due  = true
            build_watch = watch [ res: dir,
                                  callback: lambda on_builds[ a ] ]
            build_watch.start[]
        if [ !build_due ] return
        now : i64 [ epoch_millis[] ]
        if [ now - build_ms < 500 ] return
        build_ms  = now
        build_due = false
        nms : vec string []
        pcs : vec f32 []
        for [ f: path ] in dir.ls[ null, false ]
            fnm : string f.filename[]
            if [ !fnm.ends_with[ '.events' ] ] continue
            nm : string fnm.mid[ 0, fnm.count - 7 ]
            mt : i64 f.modified_time[]
            if [ !build_seen.contains[ fnm ] || build_seen[ fnm ] != mt ]
                build_seen[ fnm ] = mt
                build_was[ fnm ]  = build_state[ f, nm ]
            if [ build_was[ fnm ] > -2.0 ]
                nms.push[ nm ]
                pcs.push[ build_was[ fnm ] ]
        ch : bool [ !build_names || nms.count != build_names.count ]
        if [ !ch ]
            for [ i: i32 0, i < nms.count, i += 1 ]
                if [ nms[ i ] != build_names[ i ]
                     || pcs[ i ] != build_pct[ i ] ] ch = true
        if [ !ch ] return
        build_names = nms
        build_pct   = pcs
        if [ ux ] ux.restyle = true

    # the watch's word: a build's events changed
    func on_builds [ changed: Au :: o: orbiter ] -> none
        o.build_due = true

    # a build's events: how far it is, or -2 when it has ended (or
    # its process is gone: killed outright)
    func build_state [ f: path, nm: string ] -> f32
        tx : string f.load[ typeid[ string ], null ]
        if [ !tx || !tx.starts_with[ 'begin ' ] ] return -2.0
        if [ tx.index_of[ '\nend ' ] >= 0 ] return -2.0
        nl : i32 [ tx.index_of[ '\n' ] ]
        pid : i64 tx.mid[ 6, nl - 6 ].integer_value[]
        if [ pid <= 0 || kill[ i32[ pid ], 0 ] != 0 ] return -2.0
        return events_frac[ tx, nm ]

    # how far a build's events have come, 0..1, -1 not yet known:
    # its imports' steps in order, and silver's module percent
    func events_frac [ tx: string, nm: string ] -> f32
        tot : i32 [ import_count[ nm ] ]
        seen : vec string []
        cur : f32 [ 0.0 ]
        pc : f32 [ -1.0 ]
        mp : f32 [ 0.0 ]
        for [ ln: string ] in tx.split[ '\n' ]
            ws : vec string ln.split[ ' ' ]
            if [ ws.count >= 4 && ws[ 0 ] == 'step' ]
                known : bool [ false ]
                for [ sn: string ] in seen
                    if [ sn == ws[ 1 ] ] known = true
                if [ !known ] seen.push[ ws[ 1 ] ]
                cur = phase_share[ ws[ 2 ],
                    f32[ ws[ 3 ].integer_value[] ] ]
                if [ tot > 0 && seen.count > 0 ]
                    pc = max[ mp, min[ 1.0, (f32[ seen.count - 1 ]
                        + cur) / f32[ tot ] ] ]
            el [ ws.count >= 3 && ws[ 0 ] == 'module' && ws[ 1 ] == nm ]
                mp = f32[ ws[ 2 ].integer_value[] ] / 100.0
                if [ mp > pc ] pc = mp
        return pc

    # an app updating now: how far, 0..1 (-1 not yet known), or
    # -2 when it is not building
    func build_frac [ nm: string ] -> f32
        if [ !build_names || !nm ] return -2.0
        for [ i: i32 0, i < build_names.count, i += 1 ]
            if [ build_names[ i ] == nm ] return build_pct[ i ]
        return -2.0

    # how many imports a module names (featured or at silver's
    # root): its import ... from lines
    func import_count [ nm: string ] -> i32
        if [ !import_counts ] import_counts = map i32 [string] []
        if [ import_counts.contains[ nm ] ] return import_counts[ nm ]
        n : i32 import_count_of[ nm ]
        import_counts[ nm ] = n
        return n

    func import_count_of [ nm: string ] -> i32
        fm : path '{path.path_startup[]}/featured/{nm}/{nm}.ag'
        if [ !fm.exists[] ]
            fm = path '{path.path_startup[]}/{nm}/{nm}.ag'
        if [ !fm.exists[] ] return 0
        n : i32 [ 0 ]
        tx : string fm.load[ typeid[ string ], null ]
        for [ ln: string ] in tx.split[ '\n' ]
            if [ ln.starts_with[ 'import ' ]
                 && ln.index_of[ ' from ' ] > 0 ]
                n += 1
        return n

    # an import's place through its phases, 0..1: fetching to 0.2,
    # set up to 0.3, building to 0.9, installing to 1; pct -1 is
    # the phase's start
    func phase_share [ ph: string, pct: f32 ] -> f32
        a : f32 [ 0.9 ]
        b : f32 [ 1.0 ]
        if [ ph == 'clone' || ph == 'fetch' || ph == 'submodule'
             || ph == 'checkout' || ph == 'unpack' || ph == 'patch'
             || ph == 'overlay' ]
            a = 0.0
            b = 0.2
        el [ ph == 'configure' || ph == 'setup' || ph == 'prebuild' ]
            a = 0.2
            b = 0.3
        el [ ph == 'build' || ph == 'command' ]
            a = 0.3
            b = 0.9
        f : f32 [ (pct < 0.0) ? 0.0 : min[ pct, 100.0 ] / 100.0 ]
        return a + (b - a) * f

    # the last n bytes of a file, '' when there is none
    func log_tail [ fp: string, n: i32 ] -> string
        fh : handle fopen[ fp.chars, 'r' ]
        if [ !fh ] return ''
        fseek[ fh, 0, 2 ]
        sz : i64 [ ftell[ fh ] ]
        off : i64 [ (sz > i64[ n ]) ? sz - i64[ n ] : 0 ]
        fseek[ fh, off, 0 ]
        b : new u8 [ n + 1 ]
        got : i64 [ fread[ @b[ 0 ], 1, n, fh ] ]
        fclose[ fh ]
        b[ got ] = 0
        return string [ cast cstr [ @b[ 0 ] ] ]

    # a setting: its name, value now and choices
    func setting [ name: string, value: string, stops: vec string ]
            -> Prop
        return Prop [ ident: name, value: value, stops: stops ]

    # a number as a choice reads
    func num_text [ v: f32 ] -> string
        if [ v == f32[ i32[ v ] ] ] return '{i32[ v ]}'
        return '{v}'

    # a command's output, a line each
    func cmd_lines [ c: string ] -> vec string
        out : vec string []
        x : command [ c ]
        fh : x.stream[]
        if [ !fh ] return out
        buf : local i8 [ 1024 ]
        while [ fgets[ @buf[ 0 ], 1024, fh ] ]
            ln : string [ cast cstr [ @buf[ 0 ] ] ]
            out.push[ ln.trim[] ]
        pclose[ fh ]
        return out

    # the sound server's (PulseAudio, PipeWire) outputs or inputs as
    # 'name|description', monitors left out; with none (orbiter-os),
    # ALSA's cards as 'card N|name'
    func sound_devices [ inputs: bool ] -> vec string
        out : vec string []
        kind : string [ (inputs) ? 'sources' : 'sinks' ]
        nm : string ''
        for [ ln: string ] in cmd_lines[ 'pactl list {kind} 2>/dev/null' ]
            if [ ln.starts_with[ 'Name: ' ] ] nm = ln.mid[ 6, ln.count - 6 ]
            el [ ln.starts_with[ 'Description: ' ] && nm.count > 0 ]
                if [ !nm.ends_with[ '.monitor' ] ]
                    out.push[ '{nm}|{ln.mid[ 13, ln.count - 13 ]}' ]
                nm = ''
        if [ out.count > 0 ] return named_apart[ out ]
        # a /proc file's size reads 0: read through cat
        for [ t: string ] in cmd_lines[ 'cat /proc/asound/cards' ]
            br : i32 [ t.index_of[ ']: ' ] ]
            if [ br < 0 ] continue
            n : string t.mid[ 0, t.index_of[ ' ' ] ]
            out.push[ 'card {n}|{t.mid[ br + 3, t.count - br - 3 ]}' ]
        return named_apart[ out ]

    # two devices of one description: each takes its own name after
    # it, so a choice names one
    func named_apart [ devs: vec string ] -> vec string
        out : vec string []
        for [ d: string ] in devs
            bar : i32 [ d.index_of[ '|' ] ]
            ds : string d.mid[ bar + 1, d.count - bar - 1 ]
            twice : i32 [ 0 ]
            for [ o: string ] in devs
                if [ o.mid[ o.index_of[ '|' ] + 1,
                       o.count - o.index_of[ '|' ] - 1 ] == ds ]
                    twice += 1
            out.push[ (twice > 1)
                ? '{d.mid[ 0, bar ]}|{ds} ({d.mid[ 0, bar ]})' : d ]
        return out

    # the device in use: the server's default, else ours in .asoundrc
    func sound_default [ inputs: bool ] -> string
        what : string [ (inputs) ? 'source' : 'sink' ]
        ls : vec string cmd_lines[ 'pactl get-default-{what} 2>/dev/null' ]
        if [ ls.count > 0 && ls[ 0 ].count > 0 ] return ls[ 0 ]
        rc : path '{getenv[ 'HOME' ]}/.asoundrc'
        if [ !rc.exists[] ] return ''
        tx : string rc.load[ typeid[ string ], null ]
        key : string [ (inputs) ? 'capture.pcm' : 'playback.pcm' ]
        at : i32 [ tx.index_of[ key ] ]
        if [ at < 0 ] return ''
        rest : string tx.mid[ at, tx.count - at ]
        hw : i32 [ rest.index_of[ 'hw:' ] ]
        if [ hw < 0 ] return ''
        e : i32 [ hw + 3 ]
        while [ e < rest.count && i32[ rest.chars[ e ] ] >= 48
                && i32[ rest.chars[ e ] ] <= 57 ]
            e += 1
        return 'card {rest.mid[ hw + 3, e - hw - 3 ]}'

    # a device chosen: the server's default; with ALSA alone, the
    # default pcm's playback or capture side in .asoundrc
    func sound_choose [ inputs: bool, name: string ]
        if [ !name.starts_with[ 'card ' ] ]
            what : string [ (inputs) ? 'source' : 'sink' ]
            set : command { pactl set-default-{what} {name} }
            set.exec[ false ]
            return
        n : string name.mid[ 5, name.count - 5 ]
        po : string sound_default[ false ]
        pi : string sound_default[ true ]
        pn : string [ (inputs) ? ((po.count > 5) ? po.mid[ 5, po.count - 5 ] : n) : n ]
        cn : string [ (inputs) ? n : ((pi.count > 5) ? pi.mid[ 5, pi.count - 5 ] : n) ]
        rc : path '{getenv[ 'HOME' ]}/.asoundrc'
        rc.save[ 'pcm.!default {{\n  type asym\n  playback.pcm "plughw:{pn}"\n  capture.pcm "plughw:{cn}"\n}}\nctl.!default {{\n  type hw\n  card {pn}\n}}\n', null ]

    # a device's description, by its name
    func sound_label [ devs: vec string, name: string ] -> string
        for [ d: string ] in devs
            bar : i32 [ d.index_of[ '|' ] ]
            if [ d.mid[ 0, bar ] == name ]
                return d.mid[ bar + 1, d.count - bar - 1 ]
        return name

    # a system menu panel's settings, as chips
    func panel_settings [ tab: string ] -> vec Prop
        ps : vec Prop []
        if [ tab == 'mouse' ]
            ps.push[ setting[ 'scroll', '{num_text[ set_scroll ]}x',
                vec string [] [ '0.5x', '1x', '1.5x', '2x', '3x' ] ] ]
            ps.push[ setting[ 'easing', set_easing,
                vec string [] [ 'off', 'light', 'medium', 'heavy' ] ] ]
        el [ tab == 'keyboard' ]
            ps.push[ setting[ 'delay', '{set_delay} ms',
                vec string [] [ '200 ms', '300 ms', '400 ms', '600 ms',
                                '800 ms' ] ] ]
            ps.push[ setting[ 'rate', '{set_rate}/s',
                vec string [] [ '15/s', '25/s', '35/s', '50/s' ] ] ]
            ps.push[ setting[ 'layout', set_layout,
                vec string [] [ 'us', 'gb', 'de', 'fr', 'es', 'it',
                                'se', 'us dvorak' ] ] ]
        el [ tab == 'display' ]
            st : vec string []
            for [ fu: i32 18, fu <= 30, fu += 2 ]
                st.push[ '{i32[ round[ f32[ fu ] / 22.0 * 100.0 ] ]}%' ]
            ps.push[ setting[ 'text',
                '{i32[ round[ f32[ set_size ] / 22.0 * 100.0 ] ]}%', st ] ]
            # the screen's mode: only where the screen is ours
            if [ screen_owned[] ]
                ms : vec string screen_modes[]
                cm : i32 screen_mode[]
                ps.push[ setting[ 'resolution',
                    (cm >= 0 && cm < ms.count) ? ms[ cm ] : '', ms ] ]
            el
                ps.push[ setting[ 'resolution', 'set by your desktop',
                    vec string [] ] ]
            # a new mode waits on keep; untouched, it goes back
            if [ mode_until > 0 ]
                left : i64 [ (mode_until - epoch_millis[] + 999) / 1000 ]
                ps.push[ setting[ 'keep it', 'back in {left} s',
                    vec string [] [ 'keep', 'go back' ] ] ]
        el [ tab == 'sound' ]
            mv : f32 [ 0.0 ]
            mm : i32 [ 0 ]
            host_capture_get[ @mv, @mm ]
            levels : vec string [] [ '0%', '25%', '50%', '75%', '100%' ]
            ps.push[ setting[ 'output',
                '{i32[ round[ master_vol * 4.0 ] * 25.0 ]}%', levels ] ]
            ps.push[ setting[ 'microphone',
                '{i32[ round[ mv * 4.0 ] * 25.0 ]}%', levels ] ]
            ps.push[ setting[ 'mic', (mm != 0) ? 'muted' : 'on',
                vec string [] [ 'on', 'muted' ] ] ]
            # the devices: each by its description
            for [ inp: bool ] in vec bool [] [ false, true ]
                devs : vec string sound_devices[ inp ]
                labels : vec string []
                for [ d: string ] in devs
                    labels.push[ d.mid[ d.index_of[ '|' ] + 1,
                        d.count - d.index_of[ '|' ] - 1 ] ]
                ps.push[ setting[ (inp) ? 'input' : 'speakers',
                    sound_label[ devs, sound_default[ inp ] ], labels ] ]
        return ps

    # a choice taken: kept, and put to work
    func setting_set [ name: string, v: string ]
        n : f32 [ v.real_value[] ]
        if [ name == 'scroll' ]        set_scroll = n
        el [ name == 'easing' ]        set_easing = v
        el [ name == 'delay' ]         set_delay = i32[ n ]
        el [ name == 'rate' ]          set_rate = i32[ n ]
        el [ name == 'layout' ]        set_layout = v
        el [ name == 'text' ]
            set_size = i32[ round[ n / 100.0 * 22.0 ] ]
            if [ ux && ux.vk ] ux.vk.font_unit = set_size
            if [ ux && ux.root ] ux.dirty_tree[ ux.root ]
        el [ name == 'output' ]
            master_vol = n / 100.0
            host_master_set[ master_vol, (master_mute) ? 1 : 0 ]
        el [ name == 'speakers' || name == 'input' ]
            inp : bool [ name == 'input' ]
            for [ d: string ] in sound_devices[ inp ]
                bar : i32 [ d.index_of[ '|' ] ]
                if [ d.mid[ bar + 1, d.count - bar - 1 ] == v ]
                    sound_choose[ inp, d.mid[ 0, bar ] ]
                    break
        el [ name == 'resolution' ]
            ms : vec string screen_modes[]
            was : i32 screen_mode[]
            for [ i: i32 0, i < ms.count, i += 1 ]
                if [ ms[ i ] == v && i != was && screen_set_mode[ i ] ]
                    # the first change's mode is the one to go back to
                    if [ mode_until == 0 ] mode_was = was
                    mode_until = epoch_millis[] + 15000
        el [ name == 'keep it' ]
            if [ v == 'go back' && mode_was >= 0 ]
                screen_set_mode[ mode_was ]
            mode_until = 0
            mode_was = -1
        el [ name == 'microphone' || name == 'mic' ]
            mv : f32 [ 0.0 ]
            mm : i32 [ 0 ]
            host_capture_get[ @mv, @mm ]
            if [ name == 'mic' ] mm = (v == 'muted') ? 1 : 0
            el mv = n / 100.0
            host_capture_set[ mv, mm ]
        session_dirty = true
        apply_settings[ ux ]

    # the settings put to work: trinity's wheel, the pointer, the
    # keyboards (orbiter-os's own, and programs' windows), text size
    func apply_settings [ w: Window ]
        if [ w ]
            # one speed: trinity's steps and a window's clicks
            w.wheel_mul    = wheel_scale[] * set_scroll
            w.window_wheel = set_scroll
            if [ w.vk && set_size > 0 && w.vk.font_unit != set_size ]
                w.vk.font_unit = set_size
                w.restyle = true
                if [ w.root ] w.dirty_tree[ w.root ]
        # a share of the way to the mouse a refresh
        ea : f32 [ (set_easing == 'off') ? 1.0
            : ((set_easing == 'light') ? 0.5
            : ((set_easing == 'heavy') ? 0.15 : 0.3)) ]
        pointer_easing[ ea ]
        key_repeat[ set_delay, set_rate ]
        wlc_key_repeat[ set_rate, set_delay ]
        sp : i32 [ set_layout.index_of[ ' ' ] ]
        lay : string [ (sp > 0) ? set_layout.mid[ 0, sp ] : set_layout ]
        var : string [ (sp > 0) ? set_layout.mid[ sp + 1,
            set_layout.count - sp - 1 ] : '' ]
        wlc_key_layout[ lay.chars, var.chars ]
        # programs' windows take the text size as their scale
        wlc_set_scale[ f64[ set_size ] / 22.0 ]

    # a chip whose value or choices run long: a row of its own
    func chip_wide [ p: Prop ] -> bool
        if [ p.value && p.value.count > 16 ] return true
        if [ p.stops ]
            for [ sv: string ] in p.stops
                if [ sv.count > 16 ] return true
        return false

    # settings as chips, two a row ('name: value'); the open one's
    # choices as pills in a row under it. ids: <pre>chip_<name>,
    # <pre>opt_<name>_<k>; its height is left in chips_h
    func chip_grid [ props: vec Prop, open: string, pre: string ]
            -> Elements
        un : f32 unit_px[]
        ch : f32 [ round[ 1.1 * un ] ]
        gap : f32 [ round[ 0.3 * un ] ]
        pad : f32 [ round[ 0.3 * un ] ]
        chips : Elements []
        y : f32 [ pad ]
        n : i32 [ (props) ? props.count : 0 ]
        r : i32 [ 0 ]
        while [ r < n ]
            row : Elements []
            opened : Prop null
            # a chip with long words takes the row; two short ones share
            per : i32 [ (chip_wide[ props[ r ] ] || r + 1 >= n
                || chip_wide[ props[ r + 1 ] ]) ? 1 : 2 ]
            for [ c: i32 0, c < per, c += 1 ]
                p : Prop props[ r + c ]
                op : bool [ open == p.ident && p.stops
                    && p.stops.count > 0 ]
                if [ op ] opened = p
                ar : string [ (per == 1) ? 'l0 t0 r0 b0'
                    : ((c == 0) ? 'l0 t0 r50%+{gap * 0.5}px b0'
                    : 'l50%+{gap * 0.5}px t0 r0 b0') ]
                row[ '{pre}chip_{p.ident}' ] = PropChip [
                    name: p.ident, value: (p.value) ? p.value : '',
                    open: op, area: Region [ ar ] ]
            chips[ '{pre}row_{r}' ] = element [ elements: row,
                area: Region [ 'l{pad}px t{y}px r{pad}px h{ch}px' ] ]
            y += ch + gap
            # long choices: one under another, a row each
            if [ opened && chip_wide[ opened ] ]
                for [ k: i32 0, k < opened.stops.count, k += 1 ]
                    sv : string opened.stops[ k ]
                    chips[ '{pre}opt_{opened.ident}_{k}' ] = RoundTab [
                        buttons: vec string [] [
                            '{pre}opt_{opened.ident}_{k}' ],
                        icon_ids: vec string [] [ '_text' ],
                        labels: vec string [] [ sv ],
                        label_font: 'fonts/BarlowCondensed-Regular.ttf',
                        label_px: 0.5 * ch, manual: true,
                        seg_radius: ch * 0.5, use_spacing: false,
                        rest_fill: rgba [ '#0000' ],
                        sel_mask: (sv == opened.value) ? 1 : 0,
                        area: Region [
                            'l{pad}px t{y}px r{pad}px h{ch}px' ] ]
                    y += ch + gap
                opened = null
            if [ opened ]
                ns : i32 [ opened.stops.count ]
                opts : Elements []
                for [ k: i32 0, k < ns, k += 1 ]
                    sv : string opened.stops[ k ]
                    lp : f32 [ 100.0 * f32[ k ] / f32[ ns ] ]
                    rp : f32 [ 100.0 * f32[ ns - k - 1 ] / f32[ ns ] ]
                    gl : f32 [ (k > 0) ? gap * 0.25 : 0.0 ]
                    gr : f32 [ (k < ns - 1) ? gap * 0.25 : 0.0 ]
                    opts[ '{pre}opt_{opened.ident}_{k}' ] = RoundTab [
                        buttons: vec string [] [
                            '{pre}opt_{opened.ident}_{k}' ],
                        icon_ids: vec string [] [ '_text' ],
                        labels: vec string [] [ sv ],
                        label_font: 'fonts/BarlowCondensed-Regular.ttf',
                        label_px: 0.5 * ch, manual: true,
                        seg_radius: ch * 0.5, use_spacing: false,
                        rest_fill: rgba [ '#0000' ],
                        sel_mask: (sv == opened.value) ? 1 : 0,
                        area: Region [
                            'l{lp}%+{gl}px t0 r{rp}%+{gr}px b0' ] ]
                chips[ '{pre}opts_{r}' ] = element [ elements: opts,
                    area: Region [
                        'l{pad}px t{y}px r{pad}px h{ch}px' ] ]
                y += ch + gap
            r += per
        chips_h = y + pad - gap
        return chips

    # a side view's elements, in the side panel or the system menu:
    # the scene cards and props, the Wi-Fi list, the instance panel
    func side_view [ tab: string, body: string ] -> Elements
        t : Elements []
        if [ tab == 'scenes' ]
            # the cards, and under them the scene's settings as chips,
            # two a row; an open one's choices in a row under it
            sp : string scene_spec[]
            ps : LaunchProps []
            if [ sp.count > 0 ] Au.parse_agi[ null, sp.chars, ps ]
            chips : Elements chip_grid[ ps.props, scene_open, 's' ]
            ph : f32 [ chips_h ]
            grid : Elements []
            grid['scene_grid'] = SceneGrid [ scroll_fade: 24.0,
                area: Region [ 'l0 t0 r0 b{ph}px' ] ]
            grid['scene_props'] = element [ elements: chips,
                area: Region [ 'l0 b{ph}px r0 h{ph}px' ] ]
            t['scene_body'] = element [
                area: Region [ body ], elements: grid ]
        el [ tab == 'wifi' ]
            t['wifi_panel'] = WifiPanel [ area: Region [ body ] ]
        el [ tab == 'mouse' || tab == 'keyboard' || tab == 'display'
             || tab == 'sound' ]
            t['set_body'] = element [ area: Region [ body ],
                elements: chip_grid[ panel_settings[ tab ], set_open,
                                     'x' ] ]
        el
            t['instance_panel'] = InstancePanel [
                area: Region [ body ] ]
        return t

    # the system menu: a row of round buttons (the side panel's views,
    # reload when ready; power at the right), the sound, a Wi-Fi tile,
    # a tile per tray app
    func system_menu_els [] -> Elements
        t : Elements []
        un : f32 unit_px[]
        rd : f32 [ 0.75 * un ]
        open : bool [ !inst_hidden ]
        ready : bool [ au_live_get_pending[] == 1 ]
        x : f32 [ 0.6 ]
        if [ ready ]
            t['reload_ready'] = RoundTab [
                buttons: vec string [] [ 'reload_ready' ],
                icon_ids: vec string [] [ 'recycle' ], icon_scale: 0.5,
                manual: true, seg_radius: rd, use_spacing: false,
                rest_fill: rgba [ '#ffffff10' ],
                area: Region [ 'l{x} t0.6 w1.5 h1.5' ] ]
            x += 1.8
        t['sv_scenes'] = RoundTab [
            buttons: vec string [] [ 'sv_scenes' ],
            icon_ids: vec string [] [ 'saturn' ], icon_scale: 0.5,
            manual: true, seg_radius: rd, use_spacing: false,
            rest_fill: rgba [ '#ffffff10' ],
            sel_mask: (sys_view == 'scenes') ? 1 : 0,
            area: Region [ 'l{x} t0.6 w1.5 h1.5' ] ]
        x += 1.8
        # Wi-Fi: its mark; the network list under the tiles
        net : Wifi wifi_shared[]
        t['sv_wifi'] = RoundTab [ buttons: vec string [] [ 'sv_wifi' ],
            icon_ids: vec string [] [ net.mark[] ], icon_scale: 0.55,
            manual: true, seg_radius: rd, use_spacing: false,
            rest_fill: rgba [ '#ffffff10' ],
            sel_mask: (sys_view == 'wifi') ? 1 : 0,
            area: Region [ 'l{x} t0.6 w1.5 h1.5' ] ]
        # the second row: the settings panels
        sx : f32 [ 0.6 ]
        for [ pn: string ] in vec string [] [ 'mouse', 'keyboard',
                                             'display', 'sound' ]
            t['sv_{pn}'] = RoundTab [ buttons: vec string [] [ 'sv_{pn}' ],
                icon_ids: vec string [] [ (pn == 'sound')
                    ? 'volume_up' : pn ], icon_scale: 0.5,
                manual: true, seg_radius: rd, use_spacing: false,
                rest_fill: rgba [ '#ffffff10' ],
                sel_mask: (sys_view == pn) ? 1 : 0,
                area: Region [ 'l{sx} t2.4 w1.5 h1.5' ] ]
            sx += 1.8
        # power at the right; ctrl / cmd held (or shift over it):
        # restart
        cur : element find_el[ a, 'sys_power' ]
        again : bool [ cmd_down || (shift_down && cur && cur.hovered) ]
        t['sys_power'] = RoundTab [ buttons: vec string [] [
                (again) ? 'sys_restart' : 'sys_power' ],
            icon_ids: vec string [] [ (again) ? 'restart' : 'power' ],
            icon_scale: 0.5,
            manual: true, seg_radius: rd, use_spacing: false,
            rest_fill: rgba [ '#ffffff10' ], second: again,
            seg_reach: 0.5, area: Region { r0.6 t0.6 w1.5 h1.5 } ]
        # the sound: the selected task's app, else the machine
        av8 : AppView active_app[]
        lv8 : f32 [ (av8) ? ((av8.vol >= 0.0) ? av8.vol
            : 1.0) : master_vol ]
        mt8 : bool [ (av8) ? av8.vol_mute : master_mute ]
        # a drag not yet applied: the slider's own value, never last
        # frame's level over it
        vs8 : VolumeSlider find_volume[]
        if [ vs8 && vs8.changed ] lv8 = vs8.value
        t['vol_mute'] = RoundTab [
            buttons: vec string [] [ 'vol_mute' ],
            icon_ids: vec string [] [
                (mt8) ? 'volume_off' : 'volume_up' ],
            icon_scale: 0.55, manual: true, seg_radius: rd,
            use_spacing: false, rest_fill: rgba [ '#0000' ],
            sel_mask: (mt8) ? 1 : 0,
            area: Region { l0.6 t4.5 w1.06 h1.06 } ]
        # the track's ends at the thumb's middle, the thumb inside
        vp : f32 [ round[ 1.06 * un * 0.4 ] - 7.0 ]
        t['sys_vol'] = BarVolume [ value: lv8, pad_l: vp, pad_r: vp,
            area: Region { l1.9 t4.5 r0.6 h1.06 } ]
        # the tray's apps: the icon, its name; a press is its own
        # action, or its menu
        tr : Tray tray_shared[]
        y : f32 [ 6.1 ]
        for [ i: i32 0, i < tr.items.count, i += 1 ]
            ti : TrayItem tr.items[ i ]
            lit : bool [ drawer_open && menu_kind == 'tray'
                         && tr.chosen == ti.service ]
            t['tray_{i}'] = TrayMark [ service: ti.service, item: ti,
                selected: lit,
                area: Region [ 'l0.6 t{y} w1.5 h1.5' ] ]
            tn : string [ (ti.title.count > 0) ? ti.title : ti.service ]
            t['tray_tile_{i}'] = RoundTab [
                buttons: vec string [] [ 'tray_tile_{i}' ],
                icon_ids: vec string [] [ '_text' ],
                labels: vec string [] [ tn ],
                label_font: 'fonts/BarlowCondensed-Regular.ttf',
                label_px: 0.5 * un, manual: true, seg_radius: rd,
                use_spacing: false, rest_fill: rgba [ '#ffffff10' ],
                area: Region [ 'l2.3 t{y} r0.6 h1.5' ] ]
            y += 1.8
        # the view a top button chose, in the rest of the menu
        if [ sys_view.count > 0 ]
            sv : Elements side_view[ sys_view, 'l0.3 t{y} r0.3 b0.3' ]
            for [ ve: element, vk: string ] in sv
                t[ vk ] = ve
        return t

    # power off or restart: only orbiter-os itself, never the
    # computer a window is trying the bar on
    func power [ again: bool ]
        what : (again) ? 'restart' : 'power off'
        if [ !system_os ]
            log 'system bar: {what} (only on orbiter-os)'
            return
        log 'system bar: {what}'
        sync[]
        reboot[ (again) ? RB_AUTOBOOT : RB_POWER_OFF ]

    # the status bar: the four debug steps, one button each, at left
    func status_els [] -> Elements
        edv : Editor pane_at[ active_pane ]
        t : Elements []
        sys : bool system_on[]
        # first, at the left: the console, global to the window (in
        # the dock's corner with the system bar)
        if [ !sys ]
            t['console_tab'] = StatusTab [
                buttons: vec string [] [ 'console_tab' ],
                icon_ids: vec string [] [ 'gear' ], icon_scale: 0.5,
                manual: true, seg_radius: 0.0, use_spacing: false,
                rest_fill: rgba [ '#0000' ],
                sel_mask: (show_console) ? 1 : 0,
                area: Region { l0 t0 w1.66 b0 } ]
        # every running instance (the bar is for tasks alone); a
        # drag onto the dock pins it
        if [ sys ]
            t['sys_orbiter'] = home_button[
                Region [ 'l0 t0 w{dock_w[]}px b0' ], true ]
        x0 : f32 [ (sys) ? dock_w[] : 1.66 * 22.0 ]
        sb : element find_el[ a, 'status' ]
        # with the system bar its right end is the console, the menu
        # and the date
        rw : f32 [ (sys) ? ((system_os) ? 7.26 : 2.66) * unit_px[]
            : 40.0 ]
        room : f32 [ (sb && sb.bounds) ? sb.bounds.w - x0 - rw
            : 800.0 ]
        run9 : vec AppView []
        if [ instances ]
            for [ av: AppView ] in instances
                if [ av.slot < 0 || av.held ] continue
                # only a running instance: a failed one is its code
                if [ av.ended ] continue
                run9.push[ av ]
        # grouped by app (its module), groups in first-seen order
        kinds : vec string []
        for [ av: AppView ] in run9
            k : '{(av.src) ? av.src.directory[] : null}'
            seen : bool [ false ]
            for [ kn: string ] in kinds
                if [ kn == k ] seen = true
            if [ !seen ] kinds.push[ k ]
        runs : vec AppView []
        for [ kn: string ] in kinds
            for [ av: AppView ] in run9
                k : '{(av.src) ? av.src.directory[] : null}'
                if [ k == kn ] runs.push[ av ]
        # a small gap between groups
        # sizes in units (22 px at rest), so ctrl +/- scales them
        un : f32 unit_px[]
        # with the system bar the buttons sit flush, no gaps
        gap : f32 [ (sys) ? 0.0 : 0.24 * un ]
        gaps : f32 [ gap * f32[ max[ i32[ kinds.count ] - 1, 0 ] ] ]
        room = room - gap
        cw : f32 [ (runs.count > 0)
            ? min[ 4.36 * un, (room - gaps) / f32[ runs.count ] ]
            : 0.0 ]
        # from the bar's left, after a gap
        x : f32 [ x0 + gap ]
        was : string [ null ]
        for [ av: AppView ] in runs
            fo : path (av.src) ? av.src.directory[] : null
            kind : '{fo}'
            if [ was && kind != was ] x += gap
            was = kind
            ag : path (fo) ? path '{path.path_startup[]}/install/export/{install_name_of[ fo.filename[] ]}.agi' : null
            wv : u64 window_of[ av ]
            lit : bool [ (wv != 0 && pane_window[ active_pane ] == wv)
                || (wv == 0 && edv && edv.run_view == av
                    && edv.app_view) ]
            # a program whose window is up is not starting
            waits : bool [ wv == 0 && av.status_word[].count > 0 ]
            lt : i32 [ (run_failed[ av ]) ? 2 : ((waits) ? 1 : 0) ]
            # an agent shell waiting for the user
            if [ lt == 0 && av.agent && !av.ended
                 && av.agent.waiting*[ av.app_title ] ]
                lt = 3
            # stopped: a debugger's stop, else the host's pause
            dg9 : dbg av.debugger
            hal : bool [ !av.ended && ((dg9 && dg9.active)
                ? !dg9.running : av.paused) ]
            t[ 'task_{av.iid}' ] = TaskChip [ inst: av.iid, file: fo,
                close_all: cmd_down, close_hover: shift_down,
                agi: ag, icon_file: program_icon[ av ], paused: hal,
                label: task_title[ av ], light: lt, selected: lit,
                area: Region [ 'l{x}px t0 w{cw}px b0' ] ]
            x += cw
        if [ sys ] return sys_right[ t ]
        # the right, while the side panel is folded: its tab, which
        # opens it; open, the panel's own lit tab folds it
        if [ inst_hidden && !sys ]
            t['side_toggle'] = StatusButton [
                buttons: vec string [] [ 'side_toggle' ],
                icon_ids: vec string [] [
                    (side_tab == 'scenes') ? 'saturn' : 'menu' ],
                icon_scale: 0.5, manual: true, seg_radius: 0.0,
                use_spacing: false, rest_fill: rgba [ '#0000' ],
                area: Region { r0 t0 w1.66 b0 } ]
        return t

    # the bottom bar's right end: the console, then the date (the
    # system menu is the desktop's, orbiter's, in the top bar)
    # Rule #12: shift over the console, or ctrl / cmd, shows clear
    func sys_right [ t: Elements ] -> Elements
        # the clock only as the OS: a window has the desktop's
        cr : string [ (system_os) ? 'r4.6' : 'r0' ]
        if [ system_os ]
            t['sys_clock'] = BarClock [ label: clock_text[],
                area: Region { r0 t0 w4.6 b0 } ]
        t['dock_console'] = StatusTab [
            buttons: vec string [] [ 'console_tab' ],
            icon_ids: vec string [] [ 'bottom_panel' ], icon_scale: 0.6,
            manual: true, seg_radius: 0.0, use_spacing: false,
            rest_fill: rgba [ '#0000' ],
            sel_mask: (show_console) ? 1 : 0,
            area: Region [ '{cr} t0 w1.33 b0' ] ]
        return t

    # scene: built once per scene — a fresh element each frame churns
    # its
    # Render; a per-scene key re-appends last and covers the ui.
    # panes: hide keeps them mounted at opacity 0 — no unmount churn.
    # avatar: ALWAYS mounted, window-anchored; :summoned slides it in.
    # error: ORBITER'S OWN state, one tab off the top edge — an error
    # from an app we happen to be running belongs to that app's run band
    # the state the last instance left: it lands before the window
    # composes, so the first frame holds the exchange as it was
    public func on_frame [ w: Window ]
        mirror_source[ w ]
        if [ !set_applied ]
            set_applied = true
            apply_settings[ w ]
        # a new screen mode not kept in time goes back; the count down
        # redraws each second
        if [ mode_until > 0 ]
            if [ epoch_millis[] >= mode_until ]
                if [ mode_was >= 0 ] screen_set_mode[ mode_was ]
                mode_until = 0
                mode_was = -1
            w.restyle = true
        # ctrl +/- changes the text size: it is kept as the setting
        if [ w.vk && w.vk.font_unit > 0 && w.vk.font_unit != set_size ]
            set_size = w.vk.font_unit
            session_dirty = true
            wlc_set_scale[ f64[ set_size ] / 22.0 ]
        side_sync[]
        ease_free[ w ]
        free_empty_close[]
        if [ desk_pick && pane_at[ active_pane ] ]
            pick : AppEntry desk_pick
            desk_pick = null
            apps_pick[ active_pane, pick ]
        install_poll[]
        build_poll[]
        dock_drag_frame[]
        # the clock (bottom bar): a new minute redraws it
        now : clock_text[]
        if [ now != clock_was ]
            clock_was = now
            w.restyle = true
        # the system bar: a Wi-Fi change redraws it
        if [ system_on[] ]
            if [ wifi_shared[].poll[] ] w.restyle = true
            if [ tray_shared[].poll[] ] w.restyle = true
            # a window that lost the keyboard lets go of its keys: one
            # still held would repeat in it (the navigator covers it,
            # so the window itself is not drawn to notice)
            wkeys : bool [ w.focus && w.focus inherits WaylandView ]
            if [ wl_keyed && !wkeys ] wlc_keys_release[]
            wl_keyed = wkeys
            # a program's file dialog: the navigator in its place
            portal_shared[].poll[]
            if [ !picking[] ] portal_pick[]
            # the exchange is always the slideout's, however it opened
            # (the button, an agent's word, a capture)
            if [ w.exchange_region != exchange_box[] ]
                w.exchange_region = exchange_box[]
                w.restyle = true
            up9 : bool [ w.shot_ask && !w.agent_min ]
            if [ up9 && !(drawer_open && menu_kind == 'exchange') ]
                drawer_open  = true
                menu_kind    = 'exchange'
                drawer_fresh = false
                w.restyle    = true
            # the exchange closed or put away: its slideout goes too
            el [ !up9 && drawer_open && menu_kind == 'exchange' ]
                drawer_shut[]
            # the drawer: gone once slid away; a tray pick shuts it
            if [ !drawer_open && menu_shut_ms > 0
                 && epoch_millis[] - menu_shut_ms >= 400 ]
                menu_shut_ms = 0
                w.restyle = true
            if [ toggled_out >= 0 ]
                edo : Editor pane_at[ toggled_out ]
                if [ edo ]
                    toggled_out  = -1
                    edo.run_view = null
                    edo.app_view = false
                    edo.nav_walk[ -1 ]
                    w.restyle = true
            if [ drawer_focus ]
                de : element find_el[ a, (menu_kind == 'system')
                    ? 'sdrawer' : 'drawer' ]
                if [ de ]
                    drawer_focus = false
                    w.set_focus[ de ]
            tp : cast TrayPanel [ find_el[ a, 'tray_panel' ] ]
            if [ tp && tp.picks != tray_picks ]
                tray_picks = tp.picks
                if [ drawer_open && menu_kind == 'tray' ] drawer_shut[]
            # a window or its menu changed: a frame shows it now
            if [ wl_tick[] ] force_update[]
            # no display to pump: our own app menu all the same
            el [ wl_sock && wl_sock.count == 0 && own_menu_sync[] ]
                force_update[]
        # an exchange with no agent chosen opens on the last one used
        if [ w.shot_ask && (!w.agent_pick || w.agent_pick.count == 0)
             && agent_last && agent_last.count > 0 ]
            w.agent_pick = agent_last
            w.model_pick = model_last
        # shift from the window: the focus may take the key's release
        if [ w.shift != shift_down ]
            shift_down = w.shift
            w.restyle  = true
        if [ w.cmd != cmd_down ]
            cmd_down  = w.cmd
            w.restyle = true
        # the panes as the last instance had them, over the session file
        if [ swap_view && swap_view.count > 0 && !carry_sent ]
            n9 : i32 [ i32[ swap_view.count ] / 3 ]
            if [ !pending_sel    ] pending_sel    = vec vec2i []
            if [ !pending_scroll ] pending_scroll = vec f32 []
            for [ i: i32 0, i < n9, i += 1 ]
                sel9 : vec2i [ x: i32[ swap_view[ i * 3 ] ],
                               y: i32[ swap_view[ i * 3 + 1 ] ] ]
                sc9  : f32 [ swap_view[ i * 3 + 2 ] ]
                if [ i < pending_sel.count ] pending_sel[ i ] = sel9
                el pending_sel += sel9
                if [ i < pending_scroll.count ]
                    pending_scroll[ i ] = sc9
                el pending_scroll += sc9
            swap_view.clear[]
        if [ swap_carry && swap_carry.has && !carry_sent ]
            swap_carry.has = false
            w.exchange_restore[ swap_carry ]
            if [ agent_av ] agent_av.restore[ swap_carry ]
            carry_landed = true

    public func render [] -> Elements
        if [ ux && install ]
            return Elements [ 'scene': scene_element[],
                'wizard': InstallWizard [ dry_run: dry_run ] ]
        if [ ux && login_wait[] ]
            return Elements [ 'scene': scene_element[],
                'login': Login [], 'login_av': LoginAvatar [] ]
        # the system bar takes the top; everything else is under it
        top : f32 [ (system_on[]) ? 0.91 * unit_px[] : 0.0 ]
        return (!ux) ? null : Elements [
            'galaxy' : galaxy_element[],
            'scene'  : scene_element[],
            # with the system bar the dock is the navigator's, so
            # the panes take the whole width
            'main'   : Splitter [ area: (hide_ui || top > 0.0)
                ? Region [ 'l0 t{top}px r0 b0' ]
                : Region [ 'l2.39 t{top}px r0 b0' ],
                                  inner: main_els[],
                deflt: 360.0, min_size: 200.0, near_seam: true,
                snap_close: true, shut_locked: true, gap: 0.0 ],
            # after main: it forms its own menus in its render, once the
            # split has laid the panes out this frame (their edges)
            'system' : (top > 0.0) ? SystemBar [
                area: Region [ 'l0 t0 r0 h{top}px' ] ] : null,
            # the menu drawer, over the panes, out from under the dock
            # a key each: a mounted drawer keeps its class, so the menus'
            # and the exchange's (the menus' ground, all but the dock) are
            # never the same element
            # a pane's menu slides out of that pane's left edge
            'drawer_at' : (drawer_on[] && menu_kind != 'exchange'
                           && menu_kind != 'system' && !win_menu[])
                ? element [ animated: true,
                    # under the bar: over it, it took the bar's presses
                    area: Region [ drawer_area[ top ] ],
                    elements: Elements [ 'drawer' : MenuDrawer [
                        open: drawer_open,
                        elements: drawer_els[] ] ] ] : null,
            # a free window's menu: inside it, down to its foot, masked
            # to its round corner
            'wdrawer_at' : (drawer_on[] && win_menu[])
                ? WinMenuArea [ area: Region [ drawer_area[ top ] ],
                    elements: Elements [ 'drawer' : WinDrawer [
                        open: drawer_open,
                        elements: drawer_els[] ] ] ] : null,
            # the system menu, out of the bar's right end
            'sdrawer' : (drawer_on[] && menu_kind == 'system')
                ? SystemDrawer [ open: drawer_open,
                                 background_lens: false,
                                 elements: system_menu_els[] ] : null,
            'xdrawer' : (drawer_on[] && menu_kind == 'exchange')
                # its ground once, not live: the exchange blurs its own
                ? ExchangeDrawer [ open: drawer_open,
                                   background_lens: false ] : null,
            'dock'   : (top > 0.0) ? null
                : Dock [ elements: dock_els[], hide: hide_ui,
                area: Region [ 'l0 t{top}px w2.39 b0' ] ],
            'avatar' : CornerAvatar [ topmost: true,
                                      summoned: show_orbiter ],
            'error'  : (!hide_ui && err_file && err_line > 0 && err_is_own[])
            ? ErrorButton [ label: 'error {err_file.filename[]}:{err_line}',
                    topmost: true, manual_mode: true ] : null ]

    # where the menu drawer opens: the active pane's left edge for
    # its menu, the window's for a tray's
    func drawer_x [] -> f32
        if [ menu_kind != 'menu' ] return 0.0
        return pane_left[ active_pane ]

    # a free window's menu stays inside the window
    # the menu is a free window's: it opens inside that window
    func win_menu [] -> bool
        return menu_kind == 'menu' && pane_floats[ active_pane ]

    func drawer_area [ top: f32 ] -> string
        dy : f32 drawer_y[ top ]
        pv : element pane_view[ active_pane ]
        if [ !win_menu[] || !pv || !pv.bounds ]
            return 'l{drawer_x[]}px t{dy}px w10.91 b0'
        ph : f32 [ max[ pv.bounds.h - (dy - pane_top[ active_pane ]),
                        0.0 ] ]
        dw : f32 [ min[ 10.91 * unit_px[], pv.bounds.w ] ]
        return 'l{drawer_x[]}px t{dy}px w{dw}px h{ph}px'

    # a free window's menu opens under its strip, else under the bar
    func drawer_y [ top: f32 ] -> f32
        if [ !win_menu[] ] return top
        return pane_top[ active_pane ] + round[ 0.91 * unit_px[] ]

    # a pane's top in the window
    func pane_top [ pi: i32 ] -> f32
        y : f32 [ 0.0 ]
        for [ e: element* pane_view[ pi ], e, e = e.parent ]
            if [ e.bounds ] y += e.bounds.y
            if [ e.parent ] y -= e.parent.scroll.y
        return y

    public func on_canvas [ cv: Canvas ]
    	i2 : int [ 1 ]
        super.on_canvas[ cv ]
        cv.sync_fence[ ]
        # disk watch runs here: layer draws skip pristine editors
        for [ i9: i32 0, i9 < editor_slots.count, i9 += 1 ]
            e9 : Editor pane_at[ i9 ]
            if [ !e9 ] continue
            e9.check_disk[]
            if [ pending_sel && i9 < pending_sel.count ]
                ps9 : vec2i pending_sel[i9]
                if [ ps9.x >= 0 && e9.lines && e9.lines.count > 1 ]
                    l9 : i32 [ clamp[ ps9.x, 0, e9.lines.count - 1 ] ]
                    e9.sel_line    = l9
                    e9.sel_col     = ps9.y
                    e9.anchor_line = l9
                    e9.anchor_col  = ps9.y
                    # the saved scroll as it was; a session without one
                    # brings the caret into view instead
                    if [
                        pending_scroll && i9 < pending_scroll.count
                        && pending_scroll[i9] >= 0.0 ]
                        e9.scroll.y      = pending_scroll[i9]
                        e9.scroll_target = e9.scroll.y
                        e9.scroll_goal   = e9.scroll.y
                        e9.pristine      = false
                    el e9.ensure_caret_visible[]
                    pending_sel[i9] = vec2i [ x: -1, y: -1 ]

# its xdg-open (xdg-open.c) into install/bin, made again when the
# source is newer: a program orbiter starts opens addresses in aura
export func orbiter_xdg_open []
    inst : string '{path.path_install[]}'
    srcs : path '{inst}/build/silver-orbiter.source'
    if [ !srcs.exists[] ] return
    txt : string [ srcs.load[ typeid[string], null ] ]
    if [ !txt ] return
    lines : txt.split[ '\n' ]
    first : path [ lines[ 0 ] ]
    src : path '{first.parent_dir[]}/xdg-open.c'
    bin : path '{inst}/bin/xdg-open'
    if [ !src.exists[] ] return
    if [ bin.exists[] && bin.modified_time[] >= src.modified_time[] ]
        return
    cc : command { {inst}/bin/clang -Os -o {bin} {src} }
    if [ cc.exec[ false ] != 0 ] log 'orbiter: xdg-open did not build'

# the app's icon: the avatar at 512, made once (delete it to remake)
export func orbiter_icon []
    inst : path.path_install[]
    if [ !inst ] return
    # the module folder: the first source the install lists for it
    srcs : path '{inst}/build/silver-orbiter.source'
    if [ !srcs.exists[] ] return
    txt  : string [ srcs.load[ typeid[string], null ] ]
    if [ !txt ] return
    lines : txt.split[ '\n' ]
    first : path [ lines[ 0 ] ]
    out   : path '{first.parent_dir[]}/images/icon.png'
    force : getenv[ 'SILVER_EXPORT_FORCE' ]
    if [ force || !out.exists[] ]
        vk9 : vk_context []
        vk9.hold[]
        w9 : Window [ vk: vk9, format: Pixel.rgba8, backbuffer: true,
            width: 512, height: 512 ]
        w9.hold[]
        if [ !w9.element_targets ]
            w9.element_targets = map Render [string] []
        # the screen canvas a running window makes in its update
        w9.screen = Canvas [ w: w9, vk: vk9, format: Pixel.rgba8,
                             load_existing: true,
            width: 512, height: 512 ]
        w9.screen.resize[ 512, 512 ]
        w9.screen.update[]
        # mounted as the window mounts an element: context first, then
        # initialize (the member defaults), then bind and hold members
        av : OrbiterAvatar [ id: 'icon' ]
        av.hold[]
        av.ux = w9
        av.vk = w9.vk
        av.initialize[]
        bind_members[ av ]
        av.hold_members[]
        av.bounds = rect [ x: 0.0, y: 0.0, w: 512.0, h: 512.0 ]
        # the app's resting yaw (on_state sets it there): flat top and
        # bottom
        av.rotate = vec Rotation []
        av.rotate.push[ Rotation [ '0 1 0 30deg' ] ]
        av.rotate.push[ Rotation [ '1 0 0 0deg' ] ]
        im : av.icon_image[ w9, 512 ]
        im.png[ out ]
        log 'orbiter: icon written {out}'
    el
        log 'orbiter: icon current'
