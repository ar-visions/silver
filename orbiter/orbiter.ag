    # the checkouts under the source root, by key: ours flat (name),
    # other users' one level down (user/name). rescanned a few times a
    # minute
    func side_projects_of [] -> vec string
        now : i64 [ epoch_millis[] ]
        if [ side_projects && now - side_scan_ms < 5000 ]
            return side_projects
        side_scan_ms = now
        out : vec string []
        base : path src_root_of[]
        entries : base.ls[ null, false ]
        if [ entries ]
            for [ i: i32 0, i < entries.count, i += 1 ]
                e : path entries[i]
                if [ !e.is_dir[] ] continue
                ix9 : path '{e}/.git/index'
                if [ ix9.exists[] ]
                    fn9 : string e.filename[]
                    out.push[ fn9 ]
                    continue
                # a user folder: its checkouts, as user/name
                un : string e.filename[]
                if [ un.count > 0 && un.chars[0] == 46 ] continue
                subs : e.ls[ null, false ]
                if [ !subs ] continue
                for [ j: i32 0, j < subs.count, j += 1 ]
                    se : path subs[j]
                    if [ !se.is_dir[] ] continue
                    sx9 : path '{se}/.git/index'
                    if [ !sx9.exists[] ] continue
                    sn9 : string se.filename[]
                    key9 : string '{un}/{sn9}'
                    out.push[ key9 ]
        # by name: a directory listing comes in no order (selection into
        # a fresh list; the names are few)
        n9 : i32 [ out.count ]
        used : vec i32 []
        for [ i: i32 0, i < n9, i += 1 ] used.push[ 0 ]
        sorted : vec string []
        for [ k: i32 0, k < n9, k += 1 ]
            best : i32 [ -1 ]
            for [ i: i32 0, i < n9, i += 1 ]
                if [ used[i] != 0 ] continue
                if [ best < 0 ]
                    best = i
                el
                    a9 : string out[i]
                    b9 : string out[best]
                    if [ a9.compare[ b9 ] < 0 ] best = i
            used[best] = 1
            nm : string out[best]
            sorted.push[ nm ]
        side_projects = sorted
        return sorted

    # the navigation column's picks: a user lists its repositories in
