                if [ v.iid == iid ] return v
        return null

    func adopt_live_slots []
        root : path.path_startup[]
        if [ !root ] return
        for [ s: i32 1, s < host_app_count[], s += 1 ]
            if [ host_app_state[ s ] != 2 ] continue
            pid : i32 [ host_app_pid[ s ] ]
            if [ pid <= 0 || host_pid_alive[ pid ] == 0 ] continue
            # never ourselves: an app that switched to orbiter in its
            # own window still sits in its host's slot table, and
            # adopting that slot attached our debugger to our own
            # process, freezing it
            if [ pid == i32[ getpid[] ] ] continue
            nb : local i8 [ 1024 ]
            if [ host_app_name[ s, @nb[0], 1024 ] <= 0 ] continue
            req : string [ @nb[0] ]
            fl  : i32  [ host_app_flags[ s ] ]
            dbg9 : bool [ (fl & 1) != 0 ]
            parts : req.split[ ' ' ]
            if [ parts.count == 0 ] continue
            mod : string parts[ 0 ]
            if [ mod.count == 0 || mod.compare[ 'orbiter' ] == 0 ]
                continue
            nv : AppView [ ]
            nv.src      = path '{root}/{mod}/{mod}.ag'
            nv.app_mod  = mod
            nv.slot     = s
            nv.started  = true
            nv.attached = true
            nv.viewer   = !dbg9
            if [ req.count > mod.count ]
                nv.module_args = req.mid[ mod.count + 1,
                                          req.count - mod.count - 1 ]
            nv.cmd      = 'tail -n +1 -F {root}/install/tmp/{mod}.{s}.log'
            # a restored instance of this module still held: it IS this
            # one
            took : bool [ false ]
            if [ instances ]
                for [ hv: AppView ] in instances
                    if [ took || !hv.held || !hv.src ] continue
                    if [ '{hv.src}' != '{nv.src}' ] continue
                    hv.app_mod  = nv.app_mod
                    hv.slot     = nv.slot
                    hv.started  = true
                    hv.attached = true
                    hv.viewer   = nv.viewer
                    hv.cmd      = nv.cmd
                    hv.held     = false
                    if [ nv.module_args && nv.module_args.count > 0 ]
                        hv.module_args = nv.module_args
                    took = true
                    nv   = hv
            if [ !took ] add_instance[ nv ]
            # a debug launch: the orbiter before this reload left its
            # session parked with the host; adopt it, its stop comes
            # back with it. none kept: attach
            if [ dbg9 ]
                kd : cast dbg [ host_kept[ 'dbg{s}' ] ]
                if [ kd && kd.active ]
                    if [ !debuggers ] debuggers = map dbg [string] []
                    dk : string dbg_key[ nv ]
                    debuggers[ dk ] = kd
                    nv.debugger      = kd
                    active_target    = dk
                    kd.drop[]
                    kd.adopt[ a ]
                el
                    if [ kd ] kd.drop[]
                    nv.attached = false
                    attach_appview[ nv, pid ]

    # one console per module: every live instance's log, each line
    # tagged by its id. no module = the global log, every instance of
    # every module
    # an instance's own console: its log alone, named by its slot so a
    # restart follows the new log
    func inst_sid [ v: AppView ] -> string
        if [ !v || v.ended || v.slot <= 0 || !v.app_mod ] return null
        return 'ed:i{v.iid}s{v.slot}'

    func console_cmd [ mod: string ] -> string
        c : string ''
        n : i32 [ 0 ]
        # the global log: each featured install's import messages too
        if [ !mod && inst_names ]
            for [ nm: string ] in inst_names
                il : string '{startup_path}/install/tmp/install-{nm}.log'
                one : string 'tail -n +1 -F {il} | sed -u "s/^/import {nm}: /"'
                c = (n == 0) ? one : '{c} & {one}'
                n += 1
        if [ !instances ] return (n > 0) ? '{c} & wait' : c
        for [ v: AppView ] in instances
            if [ v.ended || v.slot <= 0 || !v.app_mod ] continue
            if [ mod && v.app_mod.compare[ mod ] != 0 ] continue
            one : string 'tail -n +1 -F {startup_path}/install/tmp/{v.app_mod}.{v.slot}.log | sed -u "s/^/{v.iid}: /"'
            c = (n == 0) ? one : '{c} & {one}'
            n += 1
        return (n > 0) ? '{c} & wait' : c

    # the args the panel reads and writes are ONE state: the view's args
    # source
    # (a handler's document when there is one), never the pane's file
    # alone
    func args_state_of [ ed: Editor ] -> file_state
        if [ !ed ] return null
        # an instance picked from the nav list keeps its own module's
        # config, whatever file the pane happens to show
        if [ ed.run_view && !ed.run_view.viewer && ed.run_view.src ]
            return fstate[ ed.run_view.src ]
        pv : element pane_view[ ed.pane_index ]
        if [ pv && pv inherits EditorView ]
            ev : EditorView pv
            return fstate[ ev.args_src[] ]
        return fstate[ ed.band_src[] ]

    # a module's props: what its last instance answered, else what its
    # build enumerated into its export (`props:` in install/export)
    # the module's bare argument, when the app takes it live
    # a launch line's default argument: what follows its flags
    # (--name value pairs), the default always last
    # another instance of the pane's app, on a new pick: the flags of
    # the one it shows, no file, so it asks for one before it starts
    func arg_new [ pn: Editor ]
        ms : path (pn) ? module_src_of[ pn ] : null
        if [ !pn || !ms ] return
        rn : AppView pn.run_view
        nv : AppView [ ]
        nv.src = ms
        nv.module_args = flags_of[
            (rn) ? rn.module_args : file_args[ ms ] ]
        add_instance[ nv ]
        embed_app[ pn, nv ]

    # the launch line's flags: everything before its bare argument
    func flags_of [ args: string ] -> string
        if [ !args ] return ''
        ws : vec string args.trim[].split[ ' ' ]
        out : string ''
        i  : i32 [ 0 ]
        while [ i < ws.count ]
            w9 : string ws[ i ]
            if [ w9.count > 2 && w9[ 0 ] == 45 && w9[ 1 ] == 45 ]
                nx : string (i + 1 < ws.count) ? ws[ i + 1 ] : ''
                out = (out.count > 0) ? '{out} {w9} {nx}' : '{w9} {nx}'
                i += 2
                continue
            if [ w9.count > 0 ] break
            i += 1
        return out

    func default_arg_of [ args: string ] -> string
        if [ !args ] return ''
        ws : vec string args.trim[].split[ ' ' ]
        i  : i32 [ 0 ]
        while [ i < ws.count ]
            w9 : string ws[ i ]
            if [ w9.count > 2 && w9[ 0 ] == 45 && w9[ 1 ] == 45 ]
                i += 2
                continue
            if [ w9.count > 0 ] break
            i += 1
        out : string ''
        for [ j: i32 i, j < ws.count, j += 1 ]
            out = (out.count > 0) ? '{out} {ws[ j ]}' : ws[ j ]
        return out

    # the module's bare argument: a resource or default member
