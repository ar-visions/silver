            fill_color: #0000
        layers.content: TermLayer
            area: l0.24 t3px r0.24 b0.24
            label_height: 1.0
            label_size: 16
    }
    # keys typed over the log filter it (its line at the foot takes
    # the app's input)
    public func on_char [ ev: Event ]
        o : cast orbiter [ ux.app_object ]
        if [ !o || !ev.key.text || ev.key.text.count == 0 ] return
        o.con_filter = '{(o.con_filter) ? o.con_filter : ''}{ev.key.text}'
        filtered[ o ]

    # backspace takes a letter, escape the filter; a selection still
    # copies (ctrl / cmd + c)
    public func on_key [ ev: Event ]
        s : ConsoleSession session[]
        o : cast orbiter [ ux.app_object ]
        if [ !s || !o || !ev.key.state ] return
        k : i32 [ i32[ ev.key.unicode ] ]
        f : string [ (o.con_filter) ? o.con_filter : '' ]
        if [ k == 259 && f.count > 0 ]
            # a whole code point: its continuation bytes go with it
            n : i32 [ f.count - 1 ]
            while [ n > 0 && ((i32 f.chars[ n ]) & 192) == 128 ]
                n -= 1
            o.con_filter = f.mid[ 0, n ]
            filtered[ o ]
            return
        if [ k == 256 && f.count > 0 ]
            o.con_filter = ''
            filtered[ o ]
            ev.no_default = true
            return
        if [ !(ev.key.ctrl || ev.key.meta) ] return
        if [ k != 67 || s.sel_line < 0 ] return
        txt : string s.selection_text[]
        if [ txt.count > 0 && ux ] ux.set_clipboard[ txt ]

    # the lines shown follow the filter; its pill redraws
    func filtered [ o: orbiter ]
        pristine = false
        o.force_update[]

    func filter [] -> string
        o : cast orbiter [ (ux) ? ux.app_object : null ]
        return (o && o.con_filter && o.con_filter.count > 0)
            ? o.con_filter : null

    # lines carry their instance id as '<iid>: '; the pane's selected
    # instance reads blue, the module's other instances fade, untagged
    # lines stay plain
    func line_mark [ ln: string ] -> i32
        if [ !ln ] return 0
        n : i32 [ 0 ]
        i : i32 [ 0 ]
        while [ i < ln.count ]
            c : i32 [ (i32 ln.chars[ i ]) & 255 ]
            if [ c < 48 || c > 57 ] break
            n = n * 10 + (c - 48)
            i += 1
        if [ i == 0 || i >= ln.count || ((i32 ln.chars[ i ]) & 255) != 58 ]
            return 0
        orb : cast orbiter [ ux.app_object ]
        if [ !orb ] return 0
        # the one console is the selected editor's
        ed : Editor orb.pane_at[ orb.active_pane ]
        if [ !ed || !ed.run_view ] return 0
        return (ed.run_view.iid == n) ? 1 : 2


