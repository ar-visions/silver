    # a nav list entry's delete (shift held) is pressed and held: it
    # fills red over delete_hold_ms, and a release over it once full
    # deletes the file, or the folder and all it holds. never the
    # project orbiter was launched in, nor what holds it
    public func delete_hold [ p: path ]
        delete_armed    = (p) ? '{p}' : null
        delete_armed_ms = epoch_millis[]

    # 0..1: how full the entry's held delete is (0 when it is not the
    # one held)
    public func delete_fill [ p: path ] -> f32
        if [ !p || !delete_armed ] return 0.0
        ds : string '{p}'
        if [ delete_armed.compare[ ds ] != 0 ] return 0.0
        return clamp[
            f32[ epoch_millis[] - delete_armed_ms ]
            / f32[ delete_hold_ms ], 0.0, 1.0 ]

    public func path_delete [ p: path, is_dir: bool ]
        if [ !p ] return
