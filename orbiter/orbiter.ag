    public map   : string
    public mtime : i64 [ 0 ]
    public src_mtime : i64 [ 0 ]
    public announced : bool
    public kicked    : bool
    public start_us  : i64 [ 0 ]
    # set when the file's handler module colours it in-process
    public fn        : hook


element orbiter : trinity # implements compiler
    public width   : i32    [ 1888 ]
    public height  : i32    [ 888 ] 
    public background : string [ 'Background' ]
    # the committed backdrop scene and each pane's file + caret
    intern [ StatePersist ] scene       : string
    intern [ StatePersist ] pane_states : vec pane_state
    intern [ StatePersist ] inst_states : vec inst_state
    # instances changed: the frame saves
    mutable session_dirty : bool
    # false keeps the scenes module out of the process entirely
    public show_scene  : bool   [ true ]
    # the setup: only the install wizard, over the scene
    public install     : bool
    # with install: the steps are listed, never run
    public dry_run     : bool
    # the login first: on orbiter-os, or asked for here
    public login       : bool
    # the accounts: the install's settings (user and password hash)
    public accounts    : string [ '/var/lib/orbiter/install.agi' ]
    mutable signed_in  : bool
    mutable login_read : bool
    mutable login_users  : vec string
    mutable login_hashes : vec string
    mutable login_sel  : i32 [ -1 ]
    mutable login_pass : string [ '' ]
    mutable login_note : string [ '' ]
    # the system bar as on orbiter-os, always (Kalen); false turns it
    # off in a window
    public force_system : bool  [ true ]
    public live_reload : bool   [ true ]
    public startup_path  : path
    # the home's view: 'home' (the apps) or 'agent' (orbiter's
    # button), and why an agent did not start
    public  home_tab   : string [ 'home' ]
    # the agents' instances outlive a reload (persist): their
    # terminals and runs, as they were. each one's session, its run
    # (to tell when it waits), the model it runs; the one open
    persist home_sess  : map ConsoleSession [ string ]
    persist home_runs  : map AgentRun [ string ]
    persist home_ran   : map string [ string ]
    persist home_open  : string
    # the instances, in the order added, and each one's agent
    persist home_order : vec string
    persist home_agent : map string [ string ]
    mutable home_made  : i32
    # the instances kept between runs until ended, each one
    # 'name|agent|model|session'; brought back once a run starts
    intern [ StatePersist ] home_saved : vec string
    mutable home_back  : bool
    # what each agent says it is doing (research, writing, build,
    # testing, done) and its few words
    persist home_doing : map string [ string ]
    persist home_words : map string [ string ]
    mutable home_why   : string [ '' ]
    # the agents this app's user runs, each with its models (trinity
    # Agent); the abstract's member is not in this type, so the agi
    # needs it here
    public agents        : vec Agent
    # the whole argv tail: the thing we open, then the module's own
    # args. split in init — resource keeps the first token, module_args
    # the rest
    default module_args  : string
    intern resource      : string
    # per-source-file state, keyed by path; persisted with the session
    public [ StatePersist ] file_states   : map file_state [string]
    public log           : string
    intern tee_started   : bool
    intern cap_fd        : i32 [ -1 ]
    intern log_fd        : i32 [ -1 ]
    intern avg_fps       : f32
    intern target_names  : vec string
    intern target_roots  : vec path
    intern target_srcs   : vec path
    public projects      : map Project [string]
    public consoles      : map ConsoleInstance [string]
    intern ed_sessions   : map ConsoleSession [string]
    intern shot_n        : i32
    # the agent tab's session id ('' = agent tab off)
    public orbit_sid      : string
    # the one agent session is working — drives the avatar tilt
    public busy           : bool
    intern busy_at        : i64
    # the shell run's state: busy / idle / done / needs / note
    mutable agent_state   : string
    mutable agent_note    : string
    # the agent said done: the staged reload goes if the exchange is up,
    # and the avatar's core flame burns through the swap
    mutable agent_done    : bool
    # the agent sent an edit this turn: the avatar's halo goes to its
    # second stage
    mutable agent_changed : bool
    mutable swap_live     : bool
    mutable swap_hot      : bool
    mutable swap_hot_at   : i64    # when the apply was asked
    # the next instance is ready: the go went
    mutable swap_fading   : bool
    mutable swap_asked    : bool   # this instance asked for the swap
    mutable session_sig      : i64
    mutable session_saved_at : i64

    # the session on disk follows the panes (file, caret, scroll):
    # a change is saved at most once a minute
    func session_follow []
        sig : i64 [ 0 ]
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            e9 : Editor pane_at[ i ]
            sig = sig * 131 + i64[ editor_slots[i] ]
            if [ !e9 ] continue
            sig = sig * 131 + i64[ e9.sel_line ]
            sig = sig * 131 + i64[ e9.sel_col ]
            sig = sig * 131 + i64[ e9.scroll.y ]
        if [ sig == session_sig ] return
        now : i64 [ epoch_millis[] ]
        if [ now - session_saved_at < 60000 ] return
        session_sig      = sig
        session_saved_at = now
        save_session[]
    mutable pend_last     : i32 [ -1 ]
    # the exchange and the avatar as they are at the swap: the next
    # instance recreates them on its first frame, then they fade out
    persist swap_carry    : ExchangeState
    persist swap_view     : vec f32   # per pane: line, col, scroll
    mutable carry_sent    : bool      # this instance filled the carry

    # the panes' view crosses the swap in place: the slot is
    # persisted at the load, before this fills it
    func panes_carry []
        if [ !swap_view ] return
        swap_view.clear[]
        for [ i: i32 0, i < editor_slots.count, i += 1 ]
            e9 : Editor pane_at[ i ]
            swap_view += (e9) ? f32[ e9.sel_line ] : -1.0
            swap_view += (e9) ? f32[ e9.sel_col ]  : 0.0
            swap_view += (e9) ? e9.scroll.y        : 0.0
        carry_sent = true
    mutable carry_landed  : bool
    # when the flame lit: the apply waits for it to burn
    mutable swap_at       : i64
    intern cell_dumped    : bool
    # last frost stage synced to shader
    intern frost_pushed  : i32 [ -1 ]
    # mic capture running / final transcription winding down
    intern orbit_cap_on   : bool
    intern orbit_flushing : bool
    # the take's start and end on the recording's clock (us), -1 = none
    intern mark_at        : i64 [ -1 ]
    intern mark_end       : i64 [ -1 ]
    # last dictate command (edge-detect) via on_host
    intern orbit_dstate   : i32 [ -1 ]
    # where the take goes: -1 the agent (the listen button), 0 this
    # window's exchange field, >0 that hosted slot's exchange field
    # (typed in)
    intern dict_slot      : i32 [ -1 ]
    intern debuggers     : map dbg [string]
    intern debug_vars         : vec Au
    intern frame_cache        : vec Au
    # the debugger reports on its poll thread; the frame applies these
    intern pending_stop       : bool
    intern pending_src        : string
    intern pending_line       : i32
    intern pending_col        : i32
    intern pending_exit       : exited
    intern last_bp_count      : i32 [ -1 ]
    intern settings_mtime    : i64
    intern settings_check_ms : i64
    public [ StatePersist ] open_files       : vec path
    intern nav_dock_rows    : i32
    public editor_slots     : vec i32
    intern pane_console     : vec string
    # the ai/agent console is separate state; always projected last
    public agent_open : bool
    intern console_seq      : i32
    public pending_finder   : i32 [ -1 ]
    # an instance picked from the nav list: shown once its source is in
    # the pane
    mutable pending_show      : i32
    mutable pending_show_pane : i32
    # the deferred show is for the instance's code, not its window
    mutable pending_code      : bool
    intern pending_run      : i32 [ -1 ]
    # a pane to add a held instance to, once it is up
    intern pending_held     : i32 [ -1 ]
    # ...once that pane shows this source (null: any)
    intern pending_held_src : path
    # the app this window switched from; pinned in every pane's title,
    # it leads back to its source, and from there back to the app itself
    intern home_mod         : string
    # its instance here: points at it, never owns it
    manual home_av          : AppView
    intern pending_findfocus : bool
    intern find_scanned : i32
    public active_pane      : i32
    public cycle            : bool
    intern cycle_frame      : i32
    intern cycle_count      : i32
    intern cycle_adding     : bool [ true ]
    intern nav_panes        : vec Navigate
    # a pane pulled free: x y w h px in the panes' area (w 0: docked)
    intern pane_free        : vec f32
    # the free panes, bottom to top
    intern free_order       : vec i32
    # the console's toolbar: the debugger's console up; every app's
    # log (Global) or the selected app's
    intern con_dbg          : bool
    intern con_global       : bool
    # the log's filter: typed while the log has focus, its lines
    # holding it are the ones shown
    intern con_filter       : string
    # the debugger's console's lines
    intern dbg_lines        : list string
    # the full navigator's fade, 0 gone to 1 shown (150 ms each way),
    # and the frame it last moved
    intern nav_fade         : f32
    intern fade_ms          : i64
    # where each free pane is drawn: eased to pane_free (filter_n)
