    # a running instance's bare argument, from its own props, when
    # it may be set while it runs
    func live_arg_of [ av: AppView ] -> Prop
        if [ !av.props || av.props.count == 0 ]
            return (av.app_mod) ? live_default[ av.app_mod ] : null
