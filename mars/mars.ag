# mars, and mars terraformed: a planet module over the scenes utilities
export 0.1.0
export scenes ['Mars', 'TerraMars']
export dependencies ['orbiter']
import vec
import img
import gltf
import trinity
import tls
import scenes

import <stdio.h>
import <stdlib.h>
import <unistd.h>
    +_DEFAULT_SOURCE
    +_XOPEN_SOURCE=500

# ======================================================================
# Terra: a GROUND STAGE on Mars, not a globe. mars-height carries the
# real geography and the clone patches add the resolution it does not
# have -- 8192 across the planet is 400m a texel, which is a smooth
# ramp at walking distance. its own enum: a binding added to an
# inherited shader lands on the parent's slot
# MOLA elevations are metres against the areoid; this turns them into
# sphere radii. everything downstream is in radii
func mars_radius [] -> f32
    return 3390000.0

# the Valles Marineris box, in our uv space. the valley runs roughly
# 255E to 335E just south of the equator; this is 240E..340E by
# 15N..25S, which holds it end to end with room to orbit along it.
# u = 0 is longitude 180, so 240E lands at 0.1667
func mars_vu0 [] -> f32
    return 0.166667
func mars_vu1 [] -> f32
    return 0.444444
func mars_vv0 [] -> f32
    return 0.416667
func mars_vv1 [] -> f32
    return 0.638889

# packing range for the baked height, in sphere radii. MOLA runs
# -8208m (Hellas floor) to +21229m (Olympus summit); this spans that
# with a little headroom either side
func mars_hmin [] -> f32
    return -0.0028
func mars_hmax [] -> f32
    return 0.0068

# the slope either baked component carries before it clamps. real
# martian slopes averaged over 463m stay well under 1.0, so 1.5 keeps
# far more precision than the 4.0 a synthetic field needed
func mars_smax [] -> f32
    return 1.5

# relief exaggeration. applied to height AND slope TOGETHER, in the
# bake, so the shading can never disagree with the silhouette. 1.0 is
# true scale -- and true scale is subtle: all of Mars is 0.87% of its
# own radius, so from orbit a real planet looks nearly smooth
func mars_exag [] -> f32
    return 1.0

# MOLA MEGDR, 128 pixels per degree: 16 tiles of 11520 x 5632, 16-bit
# signed big-endian metres. four latitude bands running down from +88,
# four longitudes running east from 0. assembled here into one
# 46080 x 22528 grid, north row first, longitude 0 at column 0
func mola_load [ M: @i16 ] -> bool
    # the export runs with cwd at the bundle, so a relative path finds
    # nothing. SILVER is the source root and is set for every build
    root : path.path_startup[]
    ev : symbol [ getenv[ 'SILVER' ] ]
    if [ ev ] root = path [ string [ ev ] ]
    if [ !root ]
        log 'mola: no SILVER root — cannot locate the tiles'
        return false
    log 'mola: reading tiles from {root}/checkout/mola'
    bands : vec string [] [ '88n', '44n', '00n', '44s' ]
    lons  : vec string [] [ '000', '090', '180', '270' ]
    tw : i32 [ 11520 ]
    th : i32 [ 5632 ]
    gw : i32 [ 46080 ]
    row : new u8 [ tw * 2 ]
    for [ b: i32 0, b < 4, b += 1 ]
        for [ l: i32 0, l < 4, l += 1 ]
            fn : string '{root}/checkout/mola/megt{bands[b]}{lons[l]}hb.img'
            fp : handle [ fopen[ fn.chars, 'rb' ] ]
            if [ !fp ]
                log 'mola: cannot open {fn}'
                return false
            for [ y: i32 0, y < th, y += 1 ]
                nr : i32 [ fread[ @row[0], 1, tw * 2, fp ] ]
                if [ nr < tw * 2 ]
                    log 'mola: short read in {fn} row {y}'
                    fclose[ fp ]
                    return false
                base : i32 [ (b * th + y) * gw + l * tw ]
                for [ x: i32 0, x < tw, x += 1 ]
                    # big-endian, and the sign has to be put back by
                    # hand: the high byte carries it
                    v : i32 [
                        i32[ row[ x * 2 ] ] * 256
                        + i32[ row[ x * 2 + 1 ] ] ]
                    if [ v > 32767 ] v = v - 65536
                    M[ base + x ] = i16[ v ]
            fclose[ fp ]
    log 'mola: loaded 16 tiles into 46080x22528'
    return true

# our uv space is not MOLA's: u = 0 sits at longitude 180, and v spans
# the full pole-to-pole 180 while MOLA stops at +/-88. so a column is
# a pure rotation by half the grid, and a row is an offset of 256 with
# the two-degree polar caps clamped to the nearest real data
func mola_at [ M: @i16, ux: i32, uy: i32 ] -> f32
    gw : i32 [ 46080 ]
    gh : i32 [ 22528 ]
    mx : i32 [ ux - 23040 ]
    if [ mx < 0 ] mx = mx + gw
    if [ mx >= gw ] mx = mx - gw
    my : i32 [ uy - 256 ]
    if [ my < 0 ] my = 0
    if [ my >= gh ] my = gh - 1
    return f32[ M[ my * gw + mx ] ]

# CPU twin of the shader's old height field. the guide steers the patch
# exactly as it did per-fragment, but now it runs ONCE at 8192x4096
# instead of three times per pixel per frame
func mars_build_height [ H: @f32, w: i32, h: i32 ]
    bim : Image [ uri: path '../{share_name}/textures/mars-height-8192x4096.png' ]
    bw : i32 [ bim.width ]
    bh : i32 [ bim.height ]
    B : new f32 [ bw * bh ]
    eu_lum[ bim, B ]

    names : vec string [] [ 'europa-caldera', 'europa-stardunes',
                            'europa-grain-granite' ]
    # the europa plates are the shared materials in scenes
    ns : i32 [ names.count ]
    sw : new i32 [ ns ]
    sh : new i32 [ ns ]
    so : new i32 [ ns ]
    imgs : vec Image []
    total : i32 [ 0 ]
    for [ i: i32 0, i < ns, i += 1 ]
        p9 : path '{scenes_share[]}/textures/{names[i]}.png'
        im : Image [ uri: p9 ]
        imgs.push[ im ]
        sw[i] = im.width
        sh[i] = im.height
        so[i] = total
        total += im.width * im.height
    SB : new f32 [ total ]
    for [ i: i32 0, i < ns, i += 1 ]
        si : Image imgs[i]
        eu_lum[ si, @SB[ so[i] ] ]
    g0 : @f32 [ @SB[ so[0] ] ]
    g1 : @f32 [ @SB[ so[1] ] ]
    g2 : @f32 [ @SB[ so[2] ] ]

    disp : f32 [ 0.0088 ]
    detl : f32 [ 0.00030 ]
    ee : f32 [ 1.0 / 8192.0 ]
    log 'mars: patching {ns} sources over {w}x{h}'
    for [ y: i32 0, y < h, y += 1 ]
        v : f32 [ (f32[ y ] + 0.5) / f32[ h ] ]
        for [ x: i32 0, x < w, x += 1 ]
            u : f32 [ (f32[ x ] + 0.5) / f32[ w ] ]
            # the guide, read with the same offset the shader uses to
            # line the height map up with the color map
            bu : f32 [ u - 0.0635 ]
            b : f32 [ eu_bilin[ B, bw, bh, bu, v ] ]
            gx : f32 [
                eu_bilin[ B, bw, bh, bu + ee, v ]
                - eu_bilin[ B, bw, bh, bu - ee, v ] ]
            gy : f32 [
                eu_bilin[ B, bw, bh, bu, v + ee ]
                - eu_bilin[ B, bw, bh, bu, v - ee ] ]
            rug : f32 [ sqrt[ gx * gx + gy * gy ] * 55.0 ]
            if [ rug > 1.0 ] rug = 1.0
            # detail follows the guide's own slope: torn ground gets the
            # roughness, the plains stay smooth. never zero, or the
            # flats turn to glass
            amp : f32 [ 0.22 + 0.78 * rug ]
            # meridian mirror-blend: the wrap lands mid-tile under these
            # rotations, so a half-turn clone covers the seam band
            sd : f32 [ (u < 1.0 - u) ? u : 1.0 - u ]
            sk : f32 [ eu_sstep[ 0.0, 0.06, sd ] ]
            ub : f32 [ u + 0.5 ]
            if [ ub > 1.0 ] ub = ub - 1.0
            sp : f32 [ 0.0 ]
            # four octaves, each source on its own angle and scale so no
            # two grains line up with each other or with the equirect
            for [ oi: i32 0, oi < 4, oi += 1 ]
                oc : f32 [
                    (oi == 0) ? 1.0
                    : ((oi == 1) ? 3.7 : ((oi == 2) ? 13.0 : 47.0)) ]
                wt : f32 [
                    (oi == 0) ? 1.0
                    : ((oi == 1) ? 0.46 : ((oi == 2) ? 0.21 : 0.09)) ]
                pa : f32 [
                    eu_pat[ g0, sw[0], sh[0], u, v, ub, sk, 0.70,
                            61.0 * oc,  61.0 * oc, 0.13, 0.41 ] ]
                pb : f32 [
                    eu_pat[ g1, sw[1], sh[1], u, v, ub, sk, 2.30,
                            97.0 * oc,  97.0 * oc, 0.61, 0.07 ] ]
                pc : f32 [
                    eu_pat[ g2, sw[2], sh[2], u, v, ub, sk, 4.10,
                            149.0 * oc, 149.0 * oc, 0.29, 0.83 ] ]
                # the noise decides which source owns each region; a
                # single lerp would leave the third as a constant wash
                w1 : f32 [
                    eu_gnoise[ u * 1.7 * oc, v * 1.7 * oc, 0.0 ] ]
                w3 : f32 [
                    eu_gnoise[ u * 0.9 * oc + 5.0, v * 0.9 * oc + 61.0,
                               13.0 ] ]
                w2 : f32 [
                    eu_gnoise[ u * 3.9 * oc + 19.0, v * 3.9 * oc + 7.0,
                               41.0 ] ]
                ab : f32 [ pa + (pb - pa) * eu_sstep[ 0.30, 0.70, w1 ] ]
                cc : f32 [ ab + (pc - ab) * eu_sstep[ 0.35, 0.75, w3 ] ]
                sp += (cc * (0.80 + 0.40 * w2) - 0.5) * wt
            H[ y * w + x ] = b * disp + sp * detl * amp

func mars_bake []
    w9 : i32 [ 8192 ]
    h9 : i32 [ 4096 ]
    n9 : i32 [ w9 * h9 ]
    H : new f32 [ n9 ]
    mars_build_height[ H, w9, h9 ]
    hmx : f32 [ mars_hmax[] ]
    # height packed 16-bit across R and A: 8 bits of 0.0104 radii is a
    # 40m stair, and the terminator finds every one of them
    pk : Image [ width: w9, height: h9, format: Pixel.rgba8,
                 linear: true, wrap_u: true ]
    pd : @u8 [ pk.vdata[] ]
    for [ i: i32 0, i < n9, i += 1 ]
        t : f32 [ H[ i ] / hmx ]
        if [ t < 0.0 ] t = 0.0
        if [ t > 1.0 ] t = 1.0
        hq : i32 [ t * 65535.0 ]
        b2 : i32 [ i * 4 ]
        pd[ b2 ]     = u8[ hq / 256 ]
        pd[ b2 + 1 ] = 0
        pd[ b2 + 2 ] = 0
        pd[ b2 + 3 ] = u8[ hq % 256 ]
    # normals as real surface SLOPE, not a fudge: dH over the world
    # distance between texels, so the shading matches the displacement
    smx : f32 [ mars_smax[] ]
    du : f32 [ 6.2831853 / f32[ w9 ] ]
    dv : f32 [ 3.1415927 / f32[ h9 ] ]
    nk : Image [ width: w9, height: h9, format: Pixel.rgba8,
                 linear: true, wrap_u: true ]
    nd : @u8 [ nk.vdata[] ]
    for [ y: i32 0, y < h9, y += 1 ]
        ym : i32 [ (y > 0) ? y - 1 : 0 ]
        yp : i32 [ (y < h9 - 1) ? y + 1 : h9 - 1 ]
        # meridians converge: a degree of longitude is cos(lat) as wide
        lat9 : f32 [ (0.5 - (f32[ y ] + 0.5) / f32[ h9 ]) * 3.1415927 ]
        cl : f32 [ cos[ lat9 ] ]
        if [ cl < 0.02 ] cl = 0.02
        for [ x: i32 0, x < w9, x += 1 ]
            xm : i32 [ (x > 0) ? x - 1 : w9 - 1 ]
            xp : i32 [ (x < w9 - 1) ? x + 1 : 0 ]
            su : f32 [
                (H[ y * w9 + xp ] - H[ y * w9 + xm ])
                / (2.0 * du * cl) ]
            sv : f32 [
                (H[ yp * w9 + x ] - H[ ym * w9 + x ]) / (2.0 * dv) ]
            su = su / smx
            sv = sv / smx
            if [ su < -1.0 ] su = -1.0
            if [ su >  1.0 ] su = 1.0
            if [ sv < -1.0 ] sv = -1.0
            if [ sv >  1.0 ] sv = 1.0
            b3 : i32 [ (y * w9 + x) * 4 ]
            nd[ b3 ]     = u8[ su * 127.0 + 128.0 ]
            nd[ b3 + 1 ] = u8[ sv * 127.0 + 128.0 ]
            nd[ b3 + 2 ] = 0
            nd[ b3 + 3 ] = 255
    bd : path '../{share_name}/baked'
    bd.make_dir[]
    pk.png[ path '../{share_name}/baked/mars-pk.png' ]
    nk.png[ path '../{share_name}/baked/mars-nk.png' ]
    log 'mars: baked maps written'

# the real thing: MOLA straight through, no invented detail. the
# displacement map stays at 8192 (the mesh is 3072 wide, so that is
# already generous) while the SLOPE goes out at MOLA's full 46080,
# split into four longitude tiles -- 46080 is past what any GPU will
# take as one image, and slope is where 463m actually shows
func mars_bake_mola [] -> bool
    gw : i32 [ 46080 ]
    gh : i32 [ 22528 ]
    ow : i32 [ 46080 ]
    oh : i32 [ 23040 ]
    M : new i16 [ gw * gh ]
    if [ !mola_load[ M ] ]
        log 'mars: MOLA tiles missing — run the download first'
        return false
    R : f32 [ mars_radius[] ]
    ex : f32 [ mars_exag[] ]
    hlo : f32 [ mars_hmin[] ]
    hhi : f32 [ mars_hmax[] ]
    hsp : f32 [ hhi - hlo ]

    # displacement map: box-averaged down from 46080, because point
    # sampling a 5.6x reduction aliases every ridge into sparkle
    dw : i32 [ 8192 ]
    dh : i32 [ 4096 ]
    # 46080/8192 is 5.625, NOT 5. integer division here walks the whole
    # map out of register -- the elevation range still looks right
    # because it still sweeps the planet, just to the wrong places
    fsx : f32 [ f32[ ow ] / f32[ dw ] ]
    fsy : f32 [ f32[ oh ] / f32[ dh ] ]
    pk : Image [ width: dw, height: dh, format: Pixel.rgba8,
                 linear: true, wrap_u: true ]
    pd : @u8 [ pk.vdata[] ]
    for [ y: i32 0, y < dh, y += 1 ]
        by0 : i32 [ f32[ y ] * fsy ]
        by1 : i32 [ f32[ y + 1 ] * fsy ]
        if [ by1 <= by0 ] by1 = by0 + 1
        for [ x: i32 0, x < dw, x += 1 ]
            bx0 : i32 [ f32[ x ] * fsx ]
            bx1 : i32 [ f32[ x + 1 ] * fsx ]
            if [ bx1 <= bx0 ] bx1 = bx0 + 1
            acc : f32 [ 0.0 ]
            nsm : i32 [ 0 ]
            for [ by: i32 by0, by < by1, by += 1 ]
                for [ bx: i32 bx0, bx < bx1, bx += 1 ]
                    acc += mola_at[ M, bx, by ]
                    nsm += 1
            mv : f32 [ acc / f32[ nsm ] ]
            hr : f32 [ mv / R * ex ]
            t : f32 [ (hr - hlo) / hsp ]
            if [ t < 0.0 ] t = 0.0
            if [ t > 1.0 ] t = 1.0
            hq : i32 [ t * 65535.0 ]
            b2 : i32 [ (y * dw + x) * 4 ]
            pd[ b2 ]     = u8[ hq / 256 ]
            pd[ b2 + 1 ] = 0
            pd[ b2 + 2 ] = 0
            pd[ b2 + 3 ] = u8[ hq % 256 ]
    bd : path '../{share_name}/baked'
    bd.make_dir[]
    pk.png[ path '../{share_name}/baked/mars-pk.png' ]
    log 'mars: displacement map written ({dw}x{dh})'

    # slope. one degree of latitude is a fixed distance; one of
    # longitude shrinks as cos(lat), so the east-west run has to carry
    # that or every pole turns into a spike
    smx : f32 [ mars_smax[] ]
    dstep : f32 [ 3.1415927 / 180.0 / 128.0 ]

    # global slope, at the displacement map's resolution: this is what
    # the rest of the planet is shaded with
    nk : Image [ width: dw, height: dh, format: Pixel.rgba8,
                 linear: true, wrap_u: true ]
    nd : @u8 [ nk.vdata[] ]
    gstep : f32 [ dstep * fsx ]
    isx : i32 [ fsx ]
    isy : i32 [ fsy ]
    for [ y: i32 0, y < dh, y += 1 ]
        lat9 : f32 [ (0.5 - (f32[ y ] + 0.5) / f32[ dh ]) * 3.1415927 ]
        cl : f32 [ cos[ lat9 ] ]
        if [ cl < 0.004 ] cl = 0.004
        for [ x: i32 0, x < dw, x += 1 ]
            cx : i32 [ (f32[ x ] + 0.5) * fsx ]
            cy : i32 [ (f32[ y ] + 0.5) * fsy ]
            hu : f32 [
                (mola_at[ M, cx + isx, cy ] - mola_at[ M, cx - isx, cy ]) / R * ex ]
            hv : f32 [
                (mola_at[ M, cx, cy + isy ] - mola_at[ M, cx, cy - isy ]) / R * ex ]
            pu : f32 [ hu / (2.0 * gstep * cl) / smx ]
            pv : f32 [ hv / (2.0 * gstep) / smx ]
            if [ pu < -1.0 ] pu = -1.0
            if [ pu >  1.0 ] pu = 1.0
            if [ pv < -1.0 ] pv = -1.0
            if [ pv >  1.0 ] pv = 1.0
            b3 : i32 [ (y * dw + x) * 4 ]
            nd[ b3 ]     = u8[ pu * 127.0 + 128.0 ]
            nd[ b3 + 1 ] = u8[ pv * 127.0 + 128.0 ]
            nd[ b3 + 2 ] = 0
            nd[ b3 + 3 ] = 255
    nk.png[ path '../{share_name}/baked/mars-nk.png' ]
    log 'mars: global slope written ({dw}x{dh})'

    # the valley, at MOLA's own 463m. only this box gets it: the whole
    # planet at full resolution is a gigapixel of slope nobody orbits
    # over. 240E..340E by 15N..25S covers Valles Marineris end to end
    vx : i32 [ mars_vu0[] * f32[ ow ] ]
    vy : i32 [ mars_vv0[] * f32[ oh ] ]
    vw : i32 [ (mars_vu1[] - mars_vu0[]) * f32[ ow ] ]
    vh : i32 [ (mars_vv1[] - mars_vv0[]) * f32[ oh ] ]
    vsu : Image [ width: vw, height: vh, format: Pixel.u8,
                  linear: true ]
    vsv : Image [ width: vw, height: vh, format: Pixel.u8,
                  linear: true ]
    vud : @u8 [ vsu.vdata[] ]
    vvd : @u8 [ vsv.vdata[] ]
    for [ y: i32 0, y < vh, y += 1 ]
        gy : i32 [ vy + y ]
        lat9 : f32 [ (0.5 - (f32[ gy ] + 0.5) / f32[ oh ]) * 3.1415927 ]
        cl : f32 [ cos[ lat9 ] ]
        if [ cl < 0.004 ] cl = 0.004
        for [ x: i32 0, x < vw, x += 1 ]
            gx : i32 [ vx + x ]
            hu : f32 [
                (mola_at[ M, gx + 1, gy ] - mola_at[ M, gx - 1, gy ])
                / R * ex ]
            hv : f32 [
                (mola_at[ M, gx, gy + 1 ] - mola_at[ M, gx, gy - 1 ])
                / R * ex ]
            pu : f32 [ hu / (2.0 * dstep * cl) / smx ]
            pv : f32 [ hv / (2.0 * dstep) / smx ]
            if [ pu < -1.0 ] pu = -1.0
            if [ pu >  1.0 ] pu = 1.0
            if [ pv < -1.0 ] pv = -1.0
            if [ pv >  1.0 ] pv = 1.0
            o : i32 [ y * vw + x ]
            vud[ o ] = u8[ pu * 127.0 + 128.0 ]
            vvd[ o ] = u8[ pv * 127.0 + 128.0 ]
    vsu.png[ path '../{share_name}/baked/mars-vsu.png' ]
    vsv.png[ path '../{share_name}/baked/mars-vsv.png' ]
    log 'mars: valles slope written ({vw}x{vh})'
    log 'mars: MOLA bake complete'
    return true

# how many times the rock material repeats across the equator, and how
# far it tilts the normal. 2048 tiles over 21300km of equator is a
# 10.4km tile, so its own 2048 texels land at 5m each -- against MOLA's
# 2600m, which is what makes the surface mush from 13km up
# how thick the air is. 0.04 was invisible: at ground distances of
# 0.05-0.3 sphere radii it gave about one percent opacity
# how high the dust shell stands, and the scale height it thins over.
# 0.020 radii is 68km of atmosphere; it fades to nothing over 7km
# the shell must stand far enough out that rays grazing ITS surface
# already carry no alpha -- roughly five scale heights. at the low
# rungs the eye sits inside it, which is fine: it is a closed sky
func mars_atm_h [] -> f32
    return 0.300
# the colour ramp is measured in THIS, not in a fixed radius, so the
# band keeps its proportions and simply reaches further as it grows.
# 0.0075 was gone within ~40km; 0.018 carries the air to ~100km
func mars_atm_fall [] -> f32
    return 0.018
func mars_atm_gain [] -> f32
    return 0.62

# the cloud deck, in sphere radii. the low rung flies at 0.050, so a
# deck topping out at 0.030 puts the craft just above it -- which is
# the vantage that shows a cloudscape rather than a ceiling
func mars_cld_lo [] -> f32
    return 0.0060
func mars_cld_hi [] -> f32
    return 0.0250
# how much sky is covered. 0.52 leaves real gaps to fly between
# MEASURED against the baked field, not assumed. coverage is the
# threshold 1-cov on a worley distribution whose mean is 0.478, so it
# is nothing like linear in area: 0.50 covers 42% of the volume, 0.40
# covers 16%, and 0.155 covers 0.02% -- which is why the sky emptied.
# 0.369 is a true quarter of what 0.50 gave
func mars_cld_cov [] -> f32
    return 0.460
# 3.4 draws a lobe out to roughly three times its width along the
# equator. 1.0 would be round, unsheared cloud
func mars_cld_wind [] -> f32
    return 3.4

func mars_haze [] -> f32
    return 0.85

# the BARE planet's air, which is nothing like the terraformed one:
# 0.85 was tuned for a wet Terra and buried the real mars in fog
func mars_bare_haze [] -> f32
    return 0.34

func mars_dtile [] -> f32
    return 2048.0
# the gate spans 0.10 to 2.00 on its own, so this stays at unity and
# the numbers in the shader mean what they say
func mars_damp [] -> f32
    return 1.0
# how far the rock material lifts the MESH, in sphere radii, before
# the edge map scales it. 0.00004 is 136m of relief where MOLA has none
func mars_dh [] -> f32
    return 0.00004

# relief multiplier applied at DRAW time, not in the bake -- the bake
# reads 2GB of MOLA tiles and this is a look control. it must scale
# hmax and smax TOGETHER: hmax sets how far the mesh lifts, smax how
# hard the slope map shades, and moving one without the other makes
# the shading disagree with the silhouette
func mars_relief [] -> f32
    return 3.0

# SEA LEVEL, in packed height units (the same 0..1 the height map
# stores). Valles floor reads 0.154, the plateau above it 0.384 and
# Olympus 0.942, so 0.22 at the poles rising to 0.32 at the equator
# floods the canyon system and the northern lowlands while leaving
# every plateau dry
func mars_sea_l0 [] -> f32
    return 0.22
# the equatorial bias: warm ground fills easier, so the sea stands
# higher there. this is the whole reason the valley is a sea and the
# polar basins are not
func mars_sea_bias [] -> f32
    return 0.10

# ONE tileable rock material for the whole planet: normal in RG,
# cavity in B, roughness in A. this is the slot a real terrain PBR
# normal map drops into -- point mars-dn at it and delete nothing else.
#
# EVERY source read uses an EVEN integer scale. eu_bilin addresses
# mirrored, whose period is 2, so an even scale is exactly periodic
# over one output tile and no seam can print at any tiling frequency.
# free rotation would break that, which is why there is none here
func mars_bake_detail [] -> bool
    # the three grey europa plates were chosen by MEASURED structure-
    # tensor coherence, because Mars has no grain direction and a source
    # that does prints its own across the whole planet. stardunes ran
    # 0.482 at -42 degrees -- that was the diagonal streaking -- and
    # granite 0.335 at 0, which banded it horizontally. these three are
    # the flattest we own: scratch 0.012, metal4 0.042, fracture 0.056.
    #
    # they are FINE GRAIN and nothing else, which is why a whole planet
    # of them read as one material. sand and the two stone plates carry
    # the structure they lack -- rubble, fracture and vein -- and they
    # own the provinces below. every plate is normalised to a common
    # mean and spread first, or the height steps where one hands over
    # 3 is the SELECTOR, never blended in
    common : path '{scenes_share[]}/textures'
    own : path '../{share_name}/textures'
    names : vec string [] [ '{common}/europa-scratch.png',
        '{common}/europa-metal4.png', '{common}/europa-fracture.png',
        '{common}/europa-caldera.png', '{own}/mars-veg-sand.png',
        '{own}/mars-stone.png', '{own}/mars-stone2.png' ]
    ns : i32 [ names.count ]
    sw : new i32 [ ns ]
    sh : new i32 [ ns ]
    so : new i32 [ ns ]
    imgs : vec Image []
    total : i32 [ 0 ]
    for [ i: i32 0, i < ns, i += 1 ]
        p9 : path names[ i ]
        im : Image [ uri: p9 ]
        if [ im.width == 0 ]
            log 'mars: detail source {names[i]} missing'
            return false
        imgs.push[ im ]
        sw[i] = im.width
        sh[i] = im.height
        so[i] = total
        total += im.width * im.height
    SB : new f32 [ total ]
    for [ i: i32 0, i < ns, i += 1 ]
        si : Image imgs[i]
        eu_lum[ si, @SB[ so[i] ] ]
    # COMMON mean and spread. a plate that sits brighter or flatter than
    # its neighbour would otherwise step the height at every province
    # boundary, which reads as a patchwork of shelves rather than rock
    for [ i: i32 0, i < ns, i += 1 ]
        pn : i32 [ sw[i] * sh[i] ]
        pp : @f32 [ @SB[ so[i] ] ]
        psum : f32 [ 0.0 ]
        for [ k: i32 0, k < pn, k += 1 ] psum += pp[ k ]
        pmu : f32 [ psum / f32[ pn ] ]
        pvar : f32 [ 0.0 ]
        for [ k: i32 0, k < pn, k += 1 ]
            pd : f32 [ pp[ k ] - pmu ]
            pvar += pd * pd
        psig : f32 [ sqrt[ pvar / f32[ pn ] ] ]
        if [ psig < 0.000001 ] psig = 0.000001
        for [ k: i32 0, k < pn, k += 1 ]
            pp[ k ] = (pp[ k ] - pmu) / psig * 0.18 + 0.5
        log 'mars: plate {names[i]} mean {pmu} sigma {psig}'
    g0 : @f32 [ @SB[ so[0] ] ]
    g1 : @f32 [ @SB[ so[1] ] ]
    g2 : @f32 [ @SB[ so[2] ] ]
    g3 : @f32 [ @SB[ so[3] ] ]
    g4 : @f32 [ @SB[ so[4] ] ]
    g5 : @f32 [ @SB[ so[5] ] ]
    g6 : @f32 [ @SB[ so[6] ] ]

    w9 : i32 [ 2048 ]
    h9 : i32 [ 2048 ]
    n9 : i32 [ w9 * h9 ]
    D : new f32 [ n9 ]
    log 'mars: patching rock detail over {w9}x{h9}'
    for [ y: i32 0, y < h9, y += 1 ]
        v : f32 [ f32[ y ] / f32[ h9 ] ]
        for [ x: i32 0, x < w9, x += 1 ]
            u : f32 [ f32[ x ] / f32[ w9 ] ]
            # THREE selector fields, each an even scale on its own axis
            # order, so the provinces they cut never line up with each
            # other or with the tile grid
            s1 : f32 [
                eu_bilin[ g3, sw[3], sh[3], u * 2.0 + 0.13,
                          v * 2.0 + 0.41 ] ]
            s2 : f32 [
                eu_bilin[ g3, sw[3], sh[3], v * 6.0 + 0.61,
                          u * 6.0 + 0.07 ] ]
            s3 : f32 [
                eu_bilin[ g3, sw[3], sh[3], u * 10.0 + 0.29,
                          v * 10.0 + 0.83 ] ]
            # SAND takes the largest share, the two stone plates the
            # next, the grey grain what is left. the plates are all
            # normalised to one spread, so a province change swaps the
            # STRUCTURE without moving the height
            f_st : f32 [ eu_sstep[ 0.44, 0.60, s1 ] ]
            f_rk : f32 [ eu_sstep[ 0.68, 0.84, s1 ] ]
            acc : f32 [ 0.0 ]
            for [ oi: i32 0, oi < 4, oi += 1 ]
                oc : f32 [
                    (oi == 0) ? 1.0
                    : ((oi == 1) ? 3.0 : ((oi == 2) ? 9.0 : 27.0)) ]
                wt : f32 [
                    (oi == 0) ? 1.0
                    : ((oi == 1) ? 0.52 : ((oi == 2) ? 0.27 : 0.13)) ]
                # regolith, blown into ripple
                p_sa : f32 [
                    eu_bilin[ g4, sw[4], sh[4], u * 4.0 * oc + 0.13,
                              v * 4.0 * oc + 0.41 ] ]
                # rough rubble, and veined rock that breaks in sheets
                p_s1 : f32 [
                    eu_bilin[ g5, sw[5], sh[5], v * 2.0 * oc + 0.61,
                              u * 2.0 * oc + 0.07 ] ]
                p_s2 : f32 [
                    eu_bilin[ g6, sw[6], sh[6], u * 6.0 * oc + 0.29,
                              v * 6.0 * oc + 0.83 ] ]
                # the grey plates: fine grain the stone has none of
                p_a  : f32 [
                    eu_bilin[ g0, sw[0], sh[0], v * 8.0 * oc + 0.37,
                              u * 8.0 * oc + 0.19 ] ]
                p_b  : f32 [
                    eu_bilin[ g1, sw[1], sh[1], u * 10.0 * oc + 0.71,
                              v * 10.0 * oc + 0.53 ] ]
                p_c  : f32 [
                    eu_bilin[ g2, sw[2], sh[2], v * 12.0 * oc + 0.11,
                              u * 12.0 * oc + 0.67 ] ]
                st : f32 [
                    p_s1 + (p_s2 - p_s1) * eu_sstep[ 0.34, 0.74, s2 ] ]
                rk : f32 [
                    p_a + (p_b - p_a) * eu_sstep[ 0.30, 0.70, s2 ] ]
                rk = rk + (p_c - rk) * eu_sstep[ 0.36, 0.78, s3 ]
                cc : f32 [ p_sa + (st - p_sa) * f_st ]
                cc = cc + (rk - cc) * f_rk
                acc += (cc - 0.5) * wt
            D[ y * w9 + x ] = acc

    # the blurred twin is the local datum: where the surface sits under
    # it the ground is a crevice, and how far it strays is the grain
    T : new f32 [ n9 ]
    tmp : new f32 [ n9 ]
    for [ i: i32 0, i < n9, i += 1 ] T[ i ] = D[ i ]
    eu_blur[ T, tmp, w9, h9, 3 ]

    # the field's own spread, so B spends its 8 bits on the range the
    # material occupies rather than on outliers
    dsum : f32 [ 0.0 ]
    for [ i: i32 0, i < n9, i += 1 ] dsum += D[ i ]
    dmean : f32 [ dsum / f32[ n9 ] ]
    dvar : f32 [ 0.0 ]
    for [ i: i32 0, i < n9, i += 1 ]
        dd9 : f32 [ D[ i ] - dmean ]
        dvar += dd9 * dd9
    dsig : f32 [ sqrt[ dvar / f32[ n9 ] ] ]
    if [ dsig < 0.000001 ] dsig = 0.000001
    log 'mars: detail height mean {dmean} sigma {dsig}'

    # scale the packed slope by the field's own gradient RMS, so the
    # 8 bits are spent on the range the material actually occupies
    acc2 : f32 [ 0.0 ]
    for [ y: i32 0, y < h9, y += 1 ]
        ym : i32 [ (y > 0) ? y - 1 : h9 - 1 ]
        yp : i32 [ (y < h9 - 1) ? y + 1 : 0 ]
        for [ x: i32 0, x < w9, x += 1 ]
            xm : i32 [ (x > 0) ? x - 1 : w9 - 1 ]
            xp : i32 [ (x < w9 - 1) ? x + 1 : 0 ]
            gx : f32 [ D[ y * w9 + xp ] - D[ y * w9 + xm ] ]
            gy : f32 [ D[ yp * w9 + x ] - D[ ym * w9 + x ] ]
            acc2 += gx * gx + gy * gy
    rms : f32 [ sqrt[ acc2 / f32[ n9 ] ] ]
    if [ rms < 0.000001 ] rms = 0.000001
    gsc : f32 [ 1.0 / (rms * 3.0) ]
    log 'mars: detail gradient rms {rms}'

    dn : Image [ width: w9, height: h9, format: Pixel.rgba8,
                 linear: true, wrap_u: true, wrap_v: true ]
    dd : @u8 [ dn.vdata[] ]
    for [ y: i32 0, y < h9, y += 1 ]
        ym : i32 [ (y > 0) ? y - 1 : h9 - 1 ]
        yp : i32 [ (y < h9 - 1) ? y + 1 : 0 ]
        for [ x: i32 0, x < w9, x += 1 ]
            xm : i32 [ (x > 0) ? x - 1 : w9 - 1 ]
            xp : i32 [ (x < w9 - 1) ? x + 1 : 0 ]
            gx : f32 [ (D[ y * w9 + xp ] - D[ y * w9 + xm ]) * gsc ]
            gy : f32 [ (D[ yp * w9 + x ] - D[ ym * w9 + x ]) * gsc ]
            if [ gx < -1.0 ] gx = -1.0
            if [ gx >  1.0 ] gx =  1.0
            if [ gy < -1.0 ] gy = -1.0
            if [ gy >  1.0 ] gy =  1.0
            o : i32 [ y * w9 + x ]
            # B is the detail HEIGHT, centred on 128 -- the mesh
            # displaces by it, and RG is exactly its own gradient, so
            # the shading can never disagree with the geometry
            hn : f32 [ (D[ o ] - dmean) / (dsig * 3.0) ]
            if [ hn < -1.0 ] hn = -1.0
            if [ hn >  1.0 ] hn =  1.0
            dv : f32 [ T[ o ] - D[ o ] ]
            rg : f32 [ ((dv < 0.0) ? 0.0 - dv : dv) * 9.0 ]
            if [ rg > 1.0 ] rg = 1.0
            b4 : i32 [ o * 4 ]
            dd[ b4 ]     = u8[ gx * 127.0 + 128.0 ]
            dd[ b4 + 1 ] = u8[ gy * 127.0 + 128.0 ]
            dd[ b4 + 2 ] = u8[ hn * 127.0 + 128.0 ]
            dd[ b4 + 3 ] = u8[ rg * 255.0 ]
    bd : path '../{share_name}/baked'
    bd.make_dir[]
    dn.png[ path '../{share_name}/baked/mars-dn.png' ]
    log 'mars: rock detail written ({w9}x{h9})'
    return true

# WHERE to augment. the colour map is useless as albedo -- it has
# shadows baked in -- but it is the finest EDGE source we own: crater
# rims, scarps and canyon walls at 8192 across, structure the height
# map lost. sobel it for edge magnitude, then build an INTEGRAL IMAGE
# so the mean edge energy over any box costs four lookups instead of
# a blur per scale. three scales come out of one pass.
#
# R = edge over 4 texels (10km), G = 16 (42km), B = 64 (166km),
# A = the raw sobel. the shader scales BOTH the geometry patch and the
# normal amplitude by these: busy ground gets high frequency, dead
# flat plains stay flat
func mars_bake_edge [] -> bool
    cim : Image [ uri: path '../{share_name}/textures/mars-color-8192x4096.png' ]
    if [ cim.width == 0 ]
        log 'mars: colour map missing — cannot build the edge map'
        return false
    w9 : i32 [ cim.width ]
    h9 : i32 [ cim.height ]
    n9 : i32 [ w9 * h9 ]
    log 'mars: sobel over {w9}x{h9}'
    L : new f32 [ n9 ]
    eu_lum[ cim, L ]

    S : new f32 [ n9 ]
    for [ y: i32 0, y < h9, y += 1 ]
        ym : i32 [ (y > 0) ? y - 1 : 0 ]
        yp : i32 [ (y < h9 - 1) ? y + 1 : h9 - 1 ]
        for [ x: i32 0, x < w9, x += 1 ]
            # longitude wraps; latitude clamps at the caps
            xm : i32 [ (x > 0) ? x - 1 : w9 - 1 ]
            xp : i32 [ (x < w9 - 1) ? x + 1 : 0 ]
            a1 : f32 [ L[ ym * w9 + xm ] ]
            a2 : f32 [ L[ ym * w9 + x  ] ]
            a3 : f32 [ L[ ym * w9 + xp ] ]
            b1 : f32 [ L[ y  * w9 + xm ] ]
            b3 : f32 [ L[ y  * w9 + xp ] ]
            c1 : f32 [ L[ yp * w9 + xm ] ]
            c2 : f32 [ L[ yp * w9 + x  ] ]
            c3 : f32 [ L[ yp * w9 + xp ] ]
            gx : f32 [ (a3 + 2.0 * b3 + c3) - (a1 + 2.0 * b1 + c1) ]
            gy : f32 [ (c1 + 2.0 * c2 + c3) - (a1 + 2.0 * a2 + a3) ]
            S[ y * w9 + x ] = sqrt[ gx * gx + gy * gy ]

    # the integral image, one row of padding on each leading edge so a
    # box query never has to special-case the border. f64: an f32
    # accumulator runs out of mantissa a third of the way down 33M
    # texels
    iw : i32 [ w9 + 1 ]
    I : new f64 [ iw * (h9 + 1) ]
    log 'mars: integral image {iw}x{h9 + 1}'
    for [ y: i32 0, y < h9, y += 1 ]
        rs : f64 [ 0.0 ]
        for [ x: i32 0, x < w9, x += 1 ]
            rs += f64[ S[ y * w9 + x ] ]
            I[ (y + 1) * iw + (x + 1) ] = I[ y * iw + (x + 1) ] + rs

    ek : Image [ width: w9, height: h9, format: Pixel.rgba8,
                 linear: true, wrap_u: true ]
    ed : @u8 [ ek.vdata[] ]
    r1 : i32 [ 4 ]
    r2 : i32 [ 16 ]
    r3 : i32 [ 64 ]
    # each scale normalised by its own spread, or the wide box -- which
    # averages far more texels -- comes out black next to the narrow one
    m1 : f64 [ 0.0 ]
    m2 : f64 [ 0.0 ]
    m3 : f64 [ 0.0 ]
    for [ y: i32 0, y < h9, y += 1 ]
        for [ x: i32 0, x < w9, x += 1 ]
            m1 += f64[ mars_box[ I, iw, w9, h9, x, y, r1 ] ]
            m2 += f64[ mars_box[ I, iw, w9, h9, x, y, r2 ] ]
            m3 += f64[ mars_box[ I, iw, w9, h9, x, y, r3 ] ]
    fn : f64 [ n9 ]
    a1m : f32 [ m1 / fn ]
    a2m : f32 [ m2 / fn ]
    a3m : f32 [ m3 / fn ]
    if [ a1m < 0.000001 ] a1m = 0.000001
    if [ a2m < 0.000001 ] a2m = 0.000001
    if [ a3m < 0.000001 ] a3m = 0.000001
    log 'mars: edge means {a1m} {a2m} {a3m}'
    smx : f32 [ 0.0 ]
    for [ i: i32 0, i < n9, i += 1 ]
        if [ S[i] > smx ] smx = S[i]
    if [ smx < 0.000001 ] smx = 0.000001
    for [ y: i32 0, y < h9, y += 1 ]
        for [ x: i32 0, x < w9, x += 1 ]
            e1 : f32 [
                mars_box[ I, iw, w9, h9, x, y, r1 ] / (a1m * 2.5) ]
            e2 : f32 [
                mars_box[ I, iw, w9, h9, x, y, r2 ] / (a2m * 2.5) ]
            e3 : f32 [
                mars_box[ I, iw, w9, h9, x, y, r3 ] / (a3m * 2.5) ]
            if [ e1 > 1.0 ] e1 = 1.0
            if [ e2 > 1.0 ] e2 = 1.0
            if [ e3 > 1.0 ] e3 = 1.0
            e4 : f32 [ S[ y * w9 + x ] / smx ]
            if [ e4 > 1.0 ] e4 = 1.0
            b4 : i32 [ (y * w9 + x) * 4 ]
            ed[ b4 ]     = u8[ e1 * 255.0 ]
            ed[ b4 + 1 ] = u8[ e2 * 255.0 ]
            ed[ b4 + 2 ] = u8[ e3 * 255.0 ]
            ed[ b4 + 3 ] = u8[ e4 * 255.0 ]
    bd : path '../{share_name}/baked'
    bd.make_dir[]
    ek.png[ path '../{share_name}/baked/mars-ek.png' ]
    log 'mars: edge map written ({w9}x{h9})'
    return true

# mean of the sobel field over a box, from the integral image: four
# lookups, whatever the radius
func mars_box [ I: @f64, iw: i32, w9: i32, h9: i32, x: i32, y: i32,
                r: i32 ] -> f32
    x0 : i32 [ x - r ]
    y0 : i32 [ y - r ]
    x1 : i32 [ x + r ]
    y1 : i32 [ y + r ]
    if [ x0 < 0 ] x0 = 0
    if [ y0 < 0 ] y0 = 0
    if [ x1 > w9 - 1 ] x1 = w9 - 1
    if [ y1 > h9 - 1 ] y1 = h9 - 1
    s9 : f64 [ I[ (y1 + 1) * iw + (x1 + 1) ]
             - I[ y0 * iw + (x1 + 1) ]
             - I[ (y1 + 1) * iw + x0 ]
             + I[ y0 * iw + x0 ] ]
    cnt : f32 [ (x1 - x0 + 1) * (y1 - y0 + 1) ]
    return f32[ s9 ] / cnt

func mars_edge_map []
    h1 : u64 [ @mars_bake_edge ]
    h2 : u64 [ @mars_box ]
    h3 : u64 [ @eu_lum ]
    stamp : string '{h1}-{h2}-{h3}'
    sp : path '../{share_name}/baked/mars-ek.hash'
    ekp : path '../{share_name}/baked/mars-ek.png'
    if [ sp.exists[] && ekp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            log 'mars: edge map current ({stamp})'
            return
    if [ mars_bake_edge[] ] sp.save[ stamp, null ]

# RIVERS. not painted noise -- real drainage. every texel in the
# Valles box sends its water to its lowest neighbour, and the cells are
# walked from the highest down so each one hands its whole upstream
# area on before its turn to give. that is what makes a river network
# dendritic instead of wormy: tributaries MERGE and get wider.
#
# R = water, G = sand bank, and only inside the canyon -- the plateau
# above the rim drains off the box and carries nothing
func mars_bake_river [] -> bool
    pk : Image [ uri: path '../{share_name}/baked/mars-pk.png' ]
    if [ pk.width == 0 ]
        log 'mars: no height map — cannot cut rivers'
        return false
    W9 : i32 [ pk.width ]
    H9 : i32 [ pk.height ]
    pd : @u8 [ pk.vdata[] ]
    ps : i32 [ pk.pixel_size ]
    x0 : i32 [ mars_vu0[] * f32[ W9 ] ]
    x1 : i32 [ mars_vu1[] * f32[ W9 ] ]
    y0 : i32 [ mars_vv0[] * f32[ H9 ] ]
    y1 : i32 [ mars_vv1[] * f32[ H9 ] ]
    bw : i32 [ x1 - x0 ]
    bh : i32 [ y1 - y0 ]
    nb : i32 [ bw * bh ]
    log 'mars: cutting rivers over {bw}x{bh}'
    T : new i32 [ nb ]
    for [ y: i32 0, y < bh, y += 1 ]
        for [ x: i32 0, x < bw, x += 1 ]
            b2 : i32 [ ((y + y0) * W9 + (x + x0)) * ps ]
            T[ y * bw + x ] = i32[ pd[ b2 ] ] * 256 + i32[
                pd[ b2 + 3 ] ]

    # counting sort by packed height, HIGHEST first. 65536 buckets is
    # one pass -- a comparison sort over two million cells is not
    cnt : new i32 [ 65536 ]
    for [ i: i32 0, i < nb, i += 1 ] cnt[ T[i] ] += 1
    fill : new i32 [ 65536 ]
    run : i32 [ 0 ]
    for [ v: i32 65535, v >= 0, v -= 1 ]
        fill[ v ] = run
        run += cnt[ v ]
    ord : new i32 [ nb ]
    for [ i: i32 0, i < nb, i += 1 ]
        ord[ fill[ T[i] ] ] = i
        fill[ T[i] ] += 1

    # every cell starts owning its own rainfall, then gives the lot to
    # its lowest neighbour on the way down
    acc : new f32 [ nb ]
    for [ i: i32 0, i < nb, i += 1 ] acc[ i ] = 1.0
    for [ k: i32 0, k < nb, k += 1 ]
        i : i32 [ ord[ k ] ]
        x : i32 [ i % bw ]
        y : i32 [ i / bw ]
        lo : i32 [ T[ i ] ]
        bi : i32 [ 0 - 1 ]
        for [ dy: i32 0 - 1, dy <= 1, dy += 1 ]
            ny : i32 [ y + dy ]
            if [ ny >= 0 && ny < bh ]
                for [ dx: i32 0 - 1, dx <= 1, dx += 1 ]
                    nx : i32 [ x + dx ]
                    if [ (dx != 0 || dy != 0) && nx >= 0 && nx < bw ]
                        j : i32 [ ny * bw + nx ]
                        if [ T[ j ] < lo ]
                            lo = T[ j ]
                            bi = j
        if [ bi >= 0 ] acc[ bi ] += acc[ i ]

    # a river's WIDTH goes as the log of its catchment, which is why a
    # linear threshold gives either a hairline or a flood
    # MEASURED, not assumed: the largest catchment in the box came out
    # at ~2500 cells, not the tens of thousands a drainage this size
    # would carry, because a real DEM is full of closed hollows and
    # flow dies in every one. so the scale is set from what the terrain
    # actually produced -- a 300 threshold left 487 water texels in the
    # whole canyon
    hi : i32 [ 0.30 * 65535.0 ]
    amx : f32 [ 1.0 ]
    for [ i: i32 0, i < nb, i += 1 ]
        if [ acc[ i ] > amx ] amx = acc[ i ]
    log 'mars: largest catchment {amx} cells'
    riv : new f32 [ nb ]
    thr : f32 [ 24.0 ]
    lt : f32 [ log[ thr ] ]
    ls : f32 [ log[ amx ] - lt ]
    if [ ls < 0.5 ] ls = 0.5
    for [ i: i32 0, i < nb, i += 1 ]
        r9 : f32 [ 0.0 ]
        # only inside the canyon: above the rim the water leaves the box
        if [ acc[ i ] > thr && T[ i ] < hi ]
            r9 = (log[ acc[ i ] ] - lt) / ls
            if [ r9 < 0.0 ] r9 = 0.0
            if [ r9 > 1.0 ] r9 = 1.0
        riv[ i ] = r9

    # banks: how close the sand reaches. spread the water outward a few
    # times, keeping the largest -- a cheap distance field
    bank : new f32 [ nb ]
    tmp : new f32 [ nb ]
    for [ i: i32 0, i < nb, i += 1 ] bank[ i ] = riv[ i ]
    for [ p9: i32 0, p9 < 7, p9 += 1 ]
        for [ y: i32 0, y < bh, y += 1 ]
            for [ x: i32 0, x < bw, x += 1 ]
                i : i32 [ y * bw + x ]
                m9 : f32 [ bank[ i ] ]
                xm : i32 [ (x > 0) ? x - 1 : 0 ]
                xp : i32 [ (x < bw - 1) ? x + 1 : bw - 1 ]
                ym : i32 [ (y > 0) ? y - 1 : 0 ]
                yp : i32 [ (y < bh - 1) ? y + 1 : bh - 1 ]
                if [ bank[ y * bw + xm ] > m9 ] m9 = bank[ y * bw + xm ]
                if [ bank[ y * bw + xp ] > m9 ] m9 = bank[ y * bw + xp ]
                if [ bank[ ym * bw + x ] > m9 ] m9 = bank[ ym * bw + x ]
                if [ bank[ yp * bw + x ] > m9 ] m9 = bank[ yp * bw + x ]
                tmp[ i ] = m9 * 0.86
        for [ i: i32 0, i < nb, i += 1 ]
            bank[ i ] = (riv[i] > tmp[i]) ? riv[i] : tmp[i]

    rv : Image [ width: W9, height: H9, format: Pixel.rgba8,
                 linear: true, wrap_u: true ]
    rd : @u8 [ rv.vdata[] ]
    n9 : i32 [ W9 * H9 ]
    for [ i: i32 0, i < n9, i += 1 ]
        b4 : i32 [ i * 4 ]
        rd[ b4 ] = 0
        rd[ b4 + 1 ] = 0
        rd[ b4 + 2 ] = 0
        rd[ b4 + 3 ] = 255
    nriv : i32 [ 0 ]
    for [ y: i32 0, y < bh, y += 1 ]
        for [ x: i32 0, x < bw, x += 1 ]
            i : i32 [ y * bw + x ]
            b4 : i32 [ ((y + y0) * W9 + (x + x0)) * 4 ]
            rd[ b4 ]     = u8[ riv[ i ] * 255.0 ]
            rd[ b4 + 1 ] = u8[ bank[ i ] * 255.0 ]
            if [ riv[ i ] > 0.05 ] nriv += 1
    bd : path '../{share_name}/baked'
    bd.make_dir[]
    rv.png[ path '../{share_name}/baked/mars-rv.png' ]
    log 'mars: rivers written, {nriv} water texels'
    return true

func mars_river_map []
    h1 : u64 [ @mars_bake_river ]
    h2 : u64 [ @mars_vu0 ]
    h3 : u64 [ @mars_vu1 ]
    h4 : u64 [ @mars_vv0 ]
    h5 : u64 [ @mars_vv1 ]
    stamp : string '{h1}-{h2}-{h3}-{h4}-{h5}'
    sp : path '../{share_name}/baked/mars-rv.hash'
    rvp : path '../{share_name}/baked/mars-rv.png'
    if [ sp.exists[] && rvp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            log 'mars: rivers current ({stamp})'
            return
    if [ mars_bake_river[] ] sp.save[ stamp, null ]

# CLOUD VOLUME. the shape of a real cloud comes from WORLEY noise
# inverted -- cellular distance fields give the billowing cauliflower
# lobes that value noise simply cannot make, however it is octaved.
# this bakes a 64^3 volume as an 8x8 slice atlas:
#   R = billow base (worley fbm, 4/8/16 cells)
#   G,B,A = single-octave worley at 8/16/32, for edge erosion
# every octave wraps its cell indices, so the volume tiles in all
# three axes and can be sampled endlessly across the sky
func cl_hash [ ix: i32, iy: i32, iz: i32, sd: i32 ] -> f32
    h : i32 [
        ix * 374761393 + iy * 668265263 + iz * 2147483647
        + sd * 1274126177 ]
    h = (h ^ (h >> 13)) * 1274126177
    h = h ^ (h >> 16)
    hu : i32 [ h & 8388607 ]
    return f32[ hu ] / 8388608.0

# nearest feature-point distance, cells wrapped so the field tiles
func cl_worley [ px: f32, py: f32, pz: f32, nc: i32, sd: i32 ] -> f32
    fx : f32 [ px * f32[ nc ] ]
    fy : f32 [ py * f32[ nc ] ]
    fz : f32 [ pz * f32[ nc ] ]
    ix : i32 [ floor[ fx ] ]
    iy : i32 [ floor[ fy ] ]
    iz : i32 [ floor[ fz ] ]
    best : f32 [ 9.0 ]
    for [ dz: i32 0 - 1, dz <= 1, dz += 1 ]
        for [ dy: i32 0 - 1, dy <= 1, dy += 1 ]
            for [ dx: i32 0 - 1, dx <= 1, dx += 1 ]
                cx : i32 [ (ix + dx) % nc ]
                cy : i32 [ (iy + dy) % nc ]
                cz : i32 [ (iz + dz) % nc ]
                if [ cx < 0 ] cx = cx + nc
                if [ cy < 0 ] cy = cy + nc
                if [ cz < 0 ] cz = cz + nc
                ox : f32 [ f32[ ix + dx ] + cl_hash[ cx, cy, cz, sd ] ]
                oy : f32 [
                    f32[ iy + dy ] + cl_hash[ cx, cy, cz, sd + 7 ] ]
                oz : f32 [
                    f32[ iz + dz ] + cl_hash[ cx, cy, cz, sd + 19 ] ]
                ddx : f32 [ ox - fx ]
                ddy : f32 [ oy - fy ]
                ddz : f32 [ oz - fz ]
                d2 : f32 [ ddx * ddx + ddy * ddy + ddz * ddz ]
                if [ d2 < best ] best = d2
    d : f32 [ sqrt[ best ] ]
    if [ d > 1.0 ] d = 1.0
    # INVERTED: near a feature point is dense, which is the lobe
    return 1.0 - d

func mars_bake_cloud [] -> bool
    n : i32 [ 64 ]
    gw : i32 [ n * 8 ]
    gh : i32 [ n * 8 ]
    log 'mars: baking {n}^3 cloud volume as {gw}x{gh} atlas'
    im : Image [ width: gw, height: gh, format: Pixel.rgba8,
                 linear: true, wrap_u: true, wrap_v: true ]
    dd : @u8 [ im.vdata[] ]
    inv : f32 [ 1.0 / f32[ n ] ]
    for [ z: i32 0, z < n, z += 1 ]
        sx : i32 [ (z % 8) * n ]
        sy : i32 [ (z / 8) * n ]
        pz : f32 [ (f32[ z ] + 0.5) * inv ]
        for [ y: i32 0, y < n, y += 1 ]
            py : f32 [ (f32[ y ] + 0.5) * inv ]
            for [ x: i32 0, x < n, x += 1 ]
                px : f32 [ (f32[ x ] + 0.5) * inv ]
                w4 : f32 [ cl_worley[ px, py, pz, 4,  11 ] ]
                w8 : f32 [ cl_worley[ px, py, pz, 8,  23 ] ]
                w16 : f32 [ cl_worley[ px, py, pz, 16, 37 ] ]
                w32 : f32 [ cl_worley[ px, py, pz, 32, 53 ] ]
                base : f32 [ w4 * 0.625 + w8 * 0.250 + w16 * 0.125 ]
                if [ base < 0.0 ] base = 0.0
                if [ base > 1.0 ] base = 1.0
                o : i32 [ ((sy + y) * gw + (sx + x)) * 4 ]
                dd[ o ]     = u8[ base * 255.0 ]
                dd[ o + 1 ] = u8[ w8  * 255.0 ]
                dd[ o + 2 ] = u8[ w16 * 255.0 ]
                dd[ o + 3 ] = u8[ w32 * 255.0 ]
    bd : path '../{share_name}/baked'
    bd.make_dir[]
    im.png[ path '../{share_name}/baked/mars-cld.png' ]
    log 'mars: cloud volume written'
    return true

func mars_cloud_map []
    h1 : u64 [ @mars_bake_cloud ]
    h2 : u64 [ @cl_worley ]
    h3 : u64 [ @cl_hash ]
    stamp : string '{h1}-{h2}-{h3}'
    sp : path '../{share_name}/baked/mars-cld.hash'
    cp : path '../{share_name}/baked/mars-cld.png'
    if [ sp.exists[] && cp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            log 'mars: cloud volume current ({stamp})'
            return
    if [ mars_bake_cloud[] ] sp.save[ stamp, null ]

export func mars_maps []
    # EVERY function the output depends on, not just the two big ones.
    # a stamp over the bake alone stayed identical when a constant
    # moved, so the build reported the maps current and shipped stale
    # ones -- which is how a misaligned map survived three rebuilds
    h1 : u64 [ @mola_load ]
    h2 : u64 [ @mola_at ]
    h3 : u64 [ @mars_bake_mola ]
    h4 : u64 [ @mars_radius ]
    h5 : u64 [ @mars_hmin ]
    h6 : u64 [ @mars_hmax ]
    h7 : u64 [ @mars_smax ]
    h8 : u64 [ @mars_exag ]
    h9 : u64 [ @mars_vu0 ]
    ha : u64 [ @mars_vu1 ]
    hb : u64 [ @mars_vv0 ]
    hc : u64 [ @mars_vv1 ]
    stamp : string '{h1}-{h2}-{h3}-{h4}-{h5}-{h6}-{h7}-{h8}-{h9}-{ha}-{hb}-{hc}'
    sp : path '../{share_name}/baked/mars.hash'
    pkp : path '../{share_name}/baked/mars-pk.png'
    nkp : path '../{share_name}/baked/mars-nk.png'
    if [ sp.exists[] && pkp.exists[] && nkp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            log 'mars: baked maps current ({stamp})'
            mars_detail_map[]
            mars_edge_map[]
            mars_river_map[]
            mars_cloud_map[]
            return
    # stamp ONLY on success: saving it after a failed bake caches the
    # failure forever, and the next build reports everything current
    if [ mars_bake_mola[] ] sp.save[ stamp, null ]
    mars_detail_map[]
    mars_edge_map[]
    mars_river_map[]
    mars_cloud_map[]

# the rock material shares NO input with the MOLA bake, so it carries
# its own stamp: touching one must not re-read 2GB of tiles for the
# other
func mars_detail_map []
    h1 : u64 [ @mars_bake_detail ]
    h2 : u64 [ @eu_bilin ]
    h3 : u64 [ @eu_blur ]
    h4 : u64 [ @eu_sstep ]
    h5 : u64 [ @eu_lum ]
    stamp : string '{h1}-{h2}-{h3}-{h4}-{h5}'
    sp : path '../{share_name}/baked/mars-dn.hash'
    dnp : path '../{share_name}/baked/mars-dn.png'
    if [ sp.exists[] && dnp.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            log 'mars: rock detail current ({stamp})'
            return
    if [ mars_bake_detail[] ] sp.save[ stamp, null ]

# no colour map: it has shadows baked into it and fights every light
enum TerraSurface
    height  : 0
    nrm     : 1
    detail  : 2
    edge    : 3
    color   : 4
    veg_a   : 5
    veg_b   : 6
    veg_c   : 7
    river   : 8

ModelViewProject TerraShader
    # unpack scale for the baked height, and the slope range the baked
    # normal encodes. both must match what mars_bake wrote
    mutable hmax     : f32
    mutable smax     : f32
    mutable sun_dir  : vec4f
    mutable cam_pos  : vec4f
    mutable haze     : f32
    # how many times the rock material repeats across the equator, and
    # how far it tilts the normal
    mutable dtile    : f32
    mutable damp     : f32
    # the craft in MODEL space, and the horizon arc in radians: the
    # carpet mesh is laid out relative to both
    mutable eye_m    : vec4f
    mutable hdist    : f32
    # how far the rock material displaces the mesh, in sphere radii
    mutable dh       : f32
    # sea level at the poles, and how much higher it stands at the
    # equator. both in packed height units
    mutable sea_l0   : f32
    mutable sea_bias : f32

    attrib height  : LayoutBinding [ type:typeid[ TerraSurface ],
                                     id:TerraSurface.height, count:1,
                                     format: typeid[ rgba8 ] ]
    attrib nrm     : LayoutBinding [ type:typeid[ TerraSurface ],
                                     id:TerraSurface.nrm,    count:1,
                                     format: typeid[ rgba8 ] ]
    attrib detail  : LayoutBinding [ type:typeid[ TerraSurface ],
                                     id:TerraSurface.detail, count:1,
                                     format: typeid[ rgba8 ] ]
    attrib edge    : LayoutBinding [ type:typeid[ TerraSurface ],
                                     id:TerraSurface.edge,   count:1,
                                     format: typeid[ rgba8 ] ]
    attrib color   : LayoutBinding [ type:typeid[ TerraSurface ],
                                     id:TerraSurface.color,  count:1,
                                     format: typeid[ rgba8 ] ]
    attrib veg_a   : LayoutBinding [ type:typeid[ TerraSurface ],
                                     id:TerraSurface.veg_a,  count:1,
                                     format: typeid[ rgba8 ] ]
    attrib veg_b   : LayoutBinding [ type:typeid[ TerraSurface ],
                                     id:TerraSurface.veg_b,  count:1,
                                     format: typeid[ rgba8 ] ]
    attrib veg_c   : LayoutBinding [ type:typeid[ TerraSurface ],
                                     id:TerraSurface.veg_c,  count:1,
                                     format: typeid[ rgba8 ] ]
    attrib river   : LayoutBinding [ type:typeid[ TerraSurface ],
                                     id:TerraSurface.river,  count:1,
                                     format: typeid[ rgba8 ] ]

    attrib a_pos        : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal     : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv         : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_normal     : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_uv         : VertexOutput  [ type:typeid[ vec2f ] ]
    attrib v_sp         : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_world_pos  : VertexOutput  [ type:typeid[ vec4f ] ]
    attrib v_h          : VertexOutput  [ type:typeid[ f32   ] ]

    attrib fragColor    : FragmentOutput[ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    # the bake, unpacked. 16 bits across R and A, scaled by hmax.
    # the hardware interpolates those two bytes INDEPENDENTLY, so
    # everywhere the low byte wraps 255->0 it ramps backwards across a
    # whole texel and the ground ripples like water. decode four
    # texels FIRST, then interpolate. the coarse mesh averaged this
    # away; a metre-scale mesh resolves every one of them
    func o_ground [ uv: vec2f ] -> GLSL float {
        vec2  ts = vec2(8192.0, 4096.0);
        vec2  pp = uv * ts - 0.5;
        vec2  fr = fract(pp);
        vec2  b0 = (floor(pp) + 0.5) / ts;
        vec2  e1 = 1.0 / ts;
        vec4  q00 = textureLod(height, b0, 0.0);
        vec4  q10 = textureLod(height, b0 + vec2(e1.x, 0.0), 0.0);
        vec4  q01 = textureLod(height, b0 + vec2(0.0, e1.y), 0.0);
        vec4  q11 = textureLod(height, b0 + e1, 0.0);
        float h00 = q00.r * 65280.0 + q00.a * 255.0;
        float h10 = q10.r * 65280.0 + q10.a * 255.0;
        float h01 = q01.r * 65280.0 + q01.a * 255.0;
        float h11 = q11.r * 65280.0 + q11.a * 255.0;
        float hh  = mix(mix(h00, h10, fr.x), mix(h01, h11, fr.x), fr.y);
        return hh / 65535.0 * ubo.hmax;
    }

    # PERLIN BRUSH. fed by the sphere position, never uv -- that is
    # continuous over the whole planet, with no meridian seam and no
    # pole where the cells collapse. e_gnoise belongs to the enceladus
    # shader and is not in scope here
    func o_hash [ p: vec3f ] -> GLSL float {
        return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453123);
    }

    func o_noise [ p: vec3f ] -> GLSL float {
        vec3 i = floor(p);
        vec3 f = fract(p);
        vec3 u = f * f * (3.0 - 2.0 * f);
        return mix(mix(mix(o_hash(i + vec3(0.0, 0.0, 0.0)), o_hash(i + vec3(1.0, 0.0, 0.0)), u.x),
                       mix(o_hash(i + vec3(0.0, 1.0, 0.0)), o_hash(i + vec3(1.0, 1.0, 0.0)), u.x), u.y),
                   mix(mix(o_hash(i + vec3(0.0, 0.0, 1.0)), o_hash(i + vec3(1.0, 0.0, 1.0)), u.x),
                       mix(o_hash(i + vec3(0.0, 1.0, 1.0)), o_hash(i + vec3(1.0, 1.0, 1.0)), u.x), u.y), u.z);
    }

    # four octaves, each shifted so the lattice never prints
    func o_fbm [ p: vec3f ] -> GLSL float {
        float s = 0.0;
        float a = 0.5;
        vec3  q = p;
        for (int i = 0; i < 4; i++) {{
            s += a * o_noise(q);
            q  = q * 2.03 + vec3(11.3, 7.7, 3.1);
            a  = a * 0.5;
        }}
        return s;
    }



    func vertex [] -> GLSL none {
        // the mesh arrives as a FLAT polar grid centred on the craft,
        // its radius a fraction of the horizon arc. wrap it onto the
        // sphere here, so altitude rescales it and nothing rebuilds
        float rn = length(a_pos.xz);
        vec2  pd = rn > 0.0 ? a_pos.xz / rn : vec2(1.0, 0.0);
        vec3  up_m = normalize(ubo.eye_m.xyz);
        vec3  ax9  = abs(up_m.y) > 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3  t_e  = normalize(cross(ax9, up_m));
        vec3  t_n  = cross(up_m, t_e);
        float s9   = rn * ubo.hdist;
        vec3  dir  = normalize(up_m * cos(s9) + (t_e * pd.x + t_n * pd.y) * sin(s9));

        // longitude measured FROM the craft, never absolute: that is
        // what keeps the +/-pi meridian from splitting a triangle.
        // u runs 0.5-based to match the height map's 0.0635 offset
        float lon0 = atan(ubo.eye_m.z, ubo.eye_m.x);
        float dl   = atan(dir.z, dir.x) - lon0;
        if (dl >  3.14159265) dl -= 6.28318531;
        if (dl < -3.14159265) dl += 6.28318531;
        vec2 uv = vec2(0.5 + (lon0 + dl) / 6.28318531,
                       0.5 - asin(clamp(dir.y, -1.0, 1.0)) / 3.14159265);

        v_uv     = uv;
        v_sp     = dir;
        mat3 nm  = transpose(inverse(mat3(ubo.model)));
        v_normal = normalize(nm * dir);
        float g  = o_ground(uv);
        v_h      = g;

        // patch geometry WHERE THE EDGES ARE. the integral image says
        // how much structure the colour map holds around this point;
        // busy ground earns high frequency, dead flat plains stay flat
        vec4  ee = textureLod(edge, uv, 0.0);
        float aug = clamp(ee.r * 0.55 + ee.g * 0.30 + ee.b * 0.15, 0.0, 1.0);
        // the same height-difference gate the shading uses, so the
        // geometry gets patched exactly where the ground moves and a
        // flat plain stays a flat plain
        vec2  vsl  = (textureLod(nrm, uv, 0.0).rg * 2.0 - 1.0) * ubo.smax;
        float vrug = clamp(length(vsl) / 0.12, 0.0, 1.0);
        float vclat = sqrt(max(1.0 - dir.y * dir.y, 0.0025));
        vec2  duv   = vec2(uv.x * vclat * 2.0, uv.y);
        float dsum = 0.0;
        float dw   = 0.0;
        float dfq  = ubo.dtile / 256.0;
        float dwt  = 1.0;
        for (int i = 0; i < 3; i++) {{
            float an = 0.61 * float(i);
            float ca = cos(an);
            float sa = sin(an);
            vec2  ru = mat2(ca, sa, -sa, ca) * duv * dfq + vec2(0.37, 0.71) * float(i);
            dsum += (textureLod(detail, ru, 0.0).b * 2.0 - 1.0) * dwt;
            dw   += dwt;
            dfq  *= 3.0;
            dwt  *= 0.78;
        }}
        vec3 disp = dir * (1.0 + g + dsum / dw * ubo.dh
                                   * (0.10 + 1.90 * vrug) * (0.55 + 0.45 * aug));
        vec4 wpos = ubo.model * vec4(disp, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment [] -> GLSL none {
        vec3 sp = normalize(v_sp);
        // the mesh normal is the ball's and would light this flat. the
        // bake carries the real surface slope at 8192 across, far finer
        // than any mesh we can afford to displace
        vec3 ax = abs(sp.y) > 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3 ea = normalize(cross(ax, sp));
        vec3 no = normalize(cross(sp, ea));
        vec2 sl = (texture(nrm, v_uv).rg * 2.0 - 1.0) * ubo.smax;
        // slope is rise over run along each axis: tilt the sphere normal
        // by it rather than treating the map as a tangent-space normal
        vec3 n = normalize(sp - ea * sl.x - no * sl.y);

        // MOLA is 2600m a texel, so from 13km up the ground is pure
        // bilinear mush. the rock material fills the whole span below
        // that -- SIX octaves from 1300m a texel down to 5m -- so
        // relief exists at every scale between the map and the eye.
        // SHADING ONLY: the silhouette stays MOLA's
        float dist = length(v_world_pos.xyz - ubo.cam_pos.xyz);
        // same aspect correction the vertex used, or the shading grain
        // walks off the geometry it is meant to describe
        float clat = sqrt(max(1.0 - sp.y * sp.y, 0.0025));
        vec2  duv  = vec2(v_uv.x * clat * 2.0, v_uv.y);
        vec2  dxy  = vec2(0.0);
        float cav  = 0.0;
        float rgh  = 0.0;
        float wsum = 0.0;
        // start at 1/256 of the tiling rate, which is where MOLA stops
        float fq = ubo.dtile / 256.0;
        float wt = 1.0;
        // NO per-pixel downslope rotation here. sl comes from an 8-BIT
        // map, so its direction quantises, and duv is already scaled by
        // ~2000 -- one 8-bit step of angle throws the sample eight
        // whole tiles sideways between neighbouring pixels. that is
        // what came out as hard rectangular blocks
        for (int i = 0; i < 6; i++) {{
            // each octave on its own angle and origin, or the ladder
            // stacks into one self-similar pattern instead of terrain
            float an = 0.61 * float(i);
            float ca = cos(an);
            float sa = sin(an);
            vec2  ru = mat2(ca, sa, -sa, ca) * duv * fq + vec2(0.37, 0.71) * float(i);
            vec4  dv = texture(detail, ru);
            dxy  += (dv.rg * 2.0 - 1.0) * wt;
            // B is the material's height: below its own mean is a
            // crevice, above it is a crest catching the light
            cav  += (dv.b * 2.0 - 1.0) * wt;
            rgh  += dv.a * wt;
            wsum += wt;
            // three per step spans 1300m to 5m in six reads. no
            // distance crossfade: the mip chain already retires an
            // octave the moment its texel drops under the pixel, and
            // fading them in bands is what left ONE octave live at a
            // time -- which is why it read as bare grain
            fq *= 3.0;
            wt *= 0.78;
        }}
        dxy /= wsum;
        cav /= wsum;
        rgh /= wsum;
        // amplitude rides REAL HEIGHT DIFFERENCE. sl is the surface's
        // own rise over run, so it IS the height change per metre --
        // where the ground actually moves, the material goes hard, and
        // a dead flat plain keeps almost nothing. 0.12 instead of 0.35
        // brings ordinary martian slopes into range: at 0.35 nearly
        // everything read as flat and the detail sat at its floor
        vec4  ee9 = texture(edge, v_uv);
        float aug = clamp(ee9.r * 0.55 + ee9.g * 0.30 + ee9.b * 0.15, 0.0, 1.0);
        // NORMALISED slope. sl is already multiplied by smax, and
        // smax carries the 3x relief look-control -- so every fixed
        // threshold below was silently 3x too sensitive the moment
        // relief moved. dividing it back out gives the raw map value
        // in 0..1, and these gates mean the same thing at any relief.
        // this is what emptied the valley: flat0 hit zero on the canyon
        // floor, which zeroed basin, which killed sand and water
        float slope0 = length(sl) / max(ubo.smax, 1e-6);
        float rug = clamp(slope0 / 0.08, 0.0, 1.0);
        // the planting needs its own texture BEFORE the normal is set.
        // a canyon floor is dead flat, so the slope gate drops the rock
        // material to its 0.10 floor exactly where the forest sits --
        // which is why the wooded ground came out smooth and lifeless
        float flat0 = 1.0 - clamp(slope0 / 0.20, 0.0, 1.0);
        // EVERYTHING keys off the sea now. raw elevation was the right
        // datum when there was no water; with an ocean, what governs
        // planting, treeline and snow is height ABOVE SEA LEVEL -- and
        // the sea itself tilts with latitude, so a fixed elevation band
        // no longer means the same climate at two different latitudes
        float tg9  = v_h / max(ubo.hmax, 1e-6);
        float sea9 = ubo.sea_l0 + ubo.sea_bias * cos(asin(clamp(sp.y, -1.0, 1.0)));
        float asl  = tg9 - sea9;
        float lowl  = 1.0 - smoothstep(0.0, 0.30, asl);
        float brush  = o_fbm(sp * 6.0);
        float b_fine = o_fbm(sp * 19.0 + vec3(19.0, 5.0, 31.0));
        float cover = clamp((0.45 + 0.55 * lowl) * flat0 * flat0
                            * (0.40 + 1.20 * brush) - 0.15, 0.0, 1.0);
        cover *= 1.0 - aug * 0.45;
        // WET LOWLANDS, as a CONTINUOUS field. the drainage network on
        // its own was a hairline -- 1% of the box, pixels of it at
        // this altitude. this is one big perlin over the whole basin
        // floor, about half of it wet, with the flow map only LEANING
        // it so the real channels sit wettest inside each patch.
        // sp * 1.5 is a very large patch: whole reaches of valley, not
        // a stipple
        vec4  rv9   = texture(river, v_uv);
        // VERY soft: sp * 0.62 makes one patch span a large part of
        // the whole canyon system, so the wet ground arrives as broad
        // washes instead of a stipple you have to look for
        float wperl = o_fbm(sp * 0.62 + vec3(41.0, 13.0, 7.0));
        // the whole canyon FLOOR is basin, not just its deepest reaches
        // -- and gated by FLATNESS, because sand does not lie on a
        // cliff and water certainly does not stand on one
        // reaches much further UP the valley -- 0.28 kept it pinned to
        // the deepest floor, so most of the canyon never qualified
        float basin = smoothstep(0.08, 0.44, lowl) * flat0 * flat0;
        // -0.75, not -0.30. the field used to average 0.85, which is
        // past the sand threshold everywhere -- so the floor was sand
        // wall to wall and there was no green left beside it for the
        // eye to read a transition against. this centres it so all
        // three bands get real ground
        float wetf  = clamp(basin * (wperl * 2.30 - 0.62), 0.0, 1.0);
        // the CHANNEL is water in its own right, not a nudge on the
        // perlin. the bake's accumulation tops out at 94/255, so as a
        // lean it could never cross the water threshold -- rescaled to
        // its real range it carves the drainage straight through the
        // sand, which is the reflective thread the flats were missing
        // the drainage BIASES the field, it does not punch water in on
        // its own. maxing it straight into wet drew 2600m-wide threads
        // with a hard smoothstep edge -- that was the aliasing, and it
        // left water with no sand around it. folded into wetf instead,
        // every pool is automatically rimmed by sand, because sand and
        // water are two thresholds on the SAME field
        float chan  = smoothstep(0.05, 0.30, rv9.r) * basin;
        wetf = clamp(wetf + chan * 0.40, 0.0, 1.0);
        // THREE bands on one field, in order, with real width each:
        // green below 0.28, sand from 0.28 to 0.56, water above 0.60.
        // sand used to start at 0.02 and finish by 0.30 -- saturated
        // before the water band even began, so it read as the floor's
        // base colour rather than as a shore
        // wide, soft ramps: a shore is a gradient, not a contour
        float sand  = smoothstep(0.16, 0.54, wetf);
        float wet   = smoothstep(0.56, 0.94, wetf);
        cover *= (1.0 - wet) * (1.0 - sand * 0.95);

        // SDF TO THE SHORE. (ground - sea) is a height difference, and
        // dividing it by the local slope turns it into a HORIZONTAL
        // distance -- so the beach keeps its width whether the shore
        // shelves gently or drops off a cliff. that is the whole point
        // of a distance field over a height threshold: a plain height
        // band would be kilometres wide on a flat and vanish on a wall
        float dsh  = asl * ubo.hmax / max(length(sl), 0.0020);
        // reaches about 2km inland and the same distance out
        float beach = 1.0 - smoothstep(0.0, 0.00060, abs(dsh));
        // 80% of the shoreline is beach; the other fifth runs to rock
        float bmask = smoothstep(0.34, 0.46, o_fbm(sp * 5.5 + vec3(61.0, 17.0, 5.0)));
        beach *= bmask;
        // THE SEABED IS SAND, all of it. `wet` is the terrain's own
        // perlin field, not the real sea -- the sea is the shell, so
        // the ground under it was never told it was submerged and kept
        // its rock. the water is transparent in the shallows, so that
        // rock was showing straight through
        float seabed = 1.0 - smoothstep(-0.00060, 0.00060, dsh);
        sand   = max(sand, max(beach, seabed));
        cover *= (1.0 - beach) * (1.0 - seabed);

        // GREEN ONLY NEAR WATER. growth needs the water it grows beside,
        // so cover falls away with distance from the shoreline -- and
        // dsh is already a horizontal distance in metres, so this is a
        // real reach inland rather than an elevation guess. a perlin
        // section then decides WHICH stretches of coast are green at
        // all; the rest of the planet is left as bare mars
        float reach = 1.0 - smoothstep(0.0, 0.0080, max(dsh, 0.0));
        float vsec  = smoothstep(0.28, 0.64, o_fbm(sp * 2.1 + vec3(13.0, 47.0, 29.0)));
        cover *= reach * vsec;
        // and NOTHING grows high up, whatever the shoreline says. a
        // steep coast keeps dsh small a long way up a cliff, so reach
        // alone would run grass right up the wall. asl is height above
        // sea: full growth under 1.4km, gone by 5.2km, bare mars above
        cover *= 1.0 - smoothstep(0.020, 0.075, asl);

        // SNOW -- the reverse of the lowlands. cold high ground holds
        // ice, and it caps the planting rather than replacing it. steep
        // faces shed it, same as sand cannot lie on a cliff
        float high9 = 1.0 - lowl;
        float snowf = clamp(smoothstep(0.42, 0.80, high9)
                          * (0.45 + 1.05 * o_fbm(sp * 2.6 + vec3(7.0, 29.0, 17.0)))
                          - 0.18, 0.0, 1.0) * flat0;
        // a TWENTYFOLD span: a tenth on dead flat ground, double where
        // the surface actually moves. the edge map only trims it, and
        // canopy carries relief of its own however flat the ground is
        // SMOOTH the wet ground. sand flat and standing water have no
        // scree and no rock grain -- leaving the material on them is
        // what made the canyon floor read as blown-out white rubble.
        // water goes fully flat so it can behave like glass
        float smooth9 = (1.0 - sand * 0.88) * (1.0 - wet) * (1.0 - snowf * 0.70);
        n = normalize(n + (ea * dxy.x + no * dxy.y)
                        * ubo.damp * (0.10 + 1.90 * rug + 1.30 * cover)
                        * (0.55 + 0.45 * aug) * smooth9);

        // NO carve here. the bank field is a dilated 8-bit map that
        // steps about 14% per texel, so any real gain turns every step
        // into a cliff -- at 26 it shattered the whole floor into
        // facets. a groove would have to come from a smooth distance
        // field, not from this one

        mat3 nmm = transpose(inverse(mat3(ubo.model)));
        vec3 nw = normalize(nmm * n);

        vec3 sun = normalize(ubo.sun_dir.xyz);
        float ndl = max(dot(nw, sun), 0.0);
        // TERRAFORMED. the mars map is the ground underneath -- its
        // baked shadows matter far less once vegetation covers it --
        // and the planting mixes on top
        vec3  c_rock = vec3(0.26, 0.16, 0.11);
        vec3  c_dust = vec3(0.64, 0.43, 0.28);
        float crest = clamp(cav * 0.5 + 0.5, 0.0, 1.0);
        float flat9 = 1.0 - clamp(slope0 / 0.20, 0.0, 1.0);
        vec3  marsc = texture(color, v_uv).rgb;
        float marsl = dot(marsc, vec3(0.333));
        vec3  bare  = marsc;
        bare = mix(bare, mix(c_rock, c_dust, flat9 * (0.35 + 0.65 * crest)), 0.45);
        bare *= 0.78 + 0.44 * crest;
        bare = mix(bare, vec3(dot(bare, vec3(0.35, 0.48, 0.17))), rgh * 0.25);

        // WHERE it grows -- lowl, brush, b_fine and cover were all
        // worked out above, because the normal needed cover before the
        // lighting ran. deep ground holds water and air, slope sheds
        // both, and the perlin brush wanders the boundary so it never
        // reads as a contour line

        // ELEVATION picks the planting, not distance. the canyon floor
        // is the deepest, warmest, densest air on the planet and it
        // takes the forest; the plateau above the rim gets grass. lowl
        // reads about 0.97 on the Valles floor against 0.43 up top,
        // so the band between them is where the treeline sits
        vec2  vuv = duv * ubo.dtile;
        float treeline = smoothstep(0.62, 0.90, lowl);

        // STOCHASTIC PATCHING. one tap at one rate repeats on a grid,
        // which is what you were looking at. three taps at scales that
        // share no common multiple, with the brush choosing which one
        // OWNS each patch, pushes the repeat period out past the
        // horizon. the brush drives the WEIGHTS, never the coordinate:
        // a scale that varies per pixel multiplies its own gradient by
        // uv -- about 3000 here -- and aliases, the same way the
        // downslope rotation did
        // FAR larger patches: 0.180 put 737 plates around the equator,
        // a 29km stamp that reads as uniform mush. these run 65 to 320,
        // so a plate covers 100-330km and its features are legible.
        // each tap also gets its OWN fixed rotation -- scale alone left
        // every copy square to the grid, which is the column look.
        // fixed, never per-pixel: a turning coordinate aliases
        mat2 r0 = mat2( 1.0000,  0.0000,  0.0000, 1.0000);
        mat2 r1 = mat2( 0.4258,  0.9048, -0.9048, 0.4258);
        mat2 r2 = mat2(-0.7859,  0.6184, -0.6184,-0.7859);
        float k1 = smoothstep(0.28, 0.72, brush);
        float k2 = smoothstep(0.34, 0.78, b_fine);
        vec3  gA = texture(veg_b, r0 * vuv * 0.0160 + vec2(0.13, 0.41)).rgb;
        vec3  gB = texture(veg_b, r1 * vuv * 0.0290 + vec2(0.61, 0.07)).rgb;
        vec3  gC = texture(veg_b, r2 * vuv * 0.0521 + vec2(0.29, 0.83)).rgb;
        vec3  v_gras = mix(mix(gA, gB, k1), gC, k2 * 0.65);
        vec3  cA = texture(veg_c, r1 * vuv * 0.0240 + vec2(0.37, 0.71)).rgb;
        vec3  cB = texture(veg_c, r2 * vuv * 0.0434 + vec2(0.07, 0.53)).rgb;
        vec3  cC = texture(veg_c, r0 * vuv * 0.0781 + vec2(0.83, 0.19)).rgb;
        vec3  v_tree = mix(mix(cA, cB, k2), cC, k1 * 0.60);
        // SAND gets the same three-tap treatment as the planting, and
        // three rotations on top. it measures 0.849 coherent at -57
        // degrees -- by far the most directional plate we own -- so
        // only its LEVEL is taken and the hue is carried in code. no
        // single tap can print its dune direction across the planet
        float sA = dot(texture(veg_a, r1 * vuv * 0.0090 + vec2(0.11, 0.37)).rgb, vec3(0.333));
        float sB = dot(texture(veg_a, r2 * vuv * 0.0163 + vec2(0.53, 0.19)).rgb, vec3(0.333));
        float sC = dot(texture(veg_a, r0 * vuv * 0.0294 + vec2(0.29, 0.71)).rgb, vec3(0.333));
        float slv = mix(mix(sA, sB, k2), sC, k1 * 0.60);
        // sand, not chalk. 0.82 x (0.60 + 0.70) reached 1.1 before the
        // 1.25 diffuse gain even touched it, which is why the floor
        // burned out to white
        // ONE perlin mask for all three, so the bare ground that breaks
        // through the snow is the same ground that breaks through the
        // planting and the sand. how much each KEEPS of the mars map
        // differs: sand 10, planting 50, snow 70
        float mmix = smoothstep(0.30, 0.74, o_fbm(sp * 3.3 + vec3(53.0, 11.0, 23.0)));
        vec3  c_sand = vec3(0.60, 0.53, 0.40) * (0.72 + 0.42 * slv);
        c_sand = mix(c_sand, marsc, mmix * 0.10);
        // the base under the planting: barely tinted, and carrying the
        // map's own colour. it was 0.42/0.50/0.30 -- green in its own
        // right, so even bare ground read as grass
        vec3  c_base = marsc * (0.85 + 0.55 * slv) * vec3(0.92, 1.00, 0.86);
        // sand base underneath, grass wherever cover takes hold, and
        // the forest only down in the valley. the brush wobbles the
        // treeline so it wanders instead of ringing the canyon at one
        // exact contour
        vec3  veg = c_base;
        veg = mix(veg, v_gras, smoothstep(0.12, 0.52, cover));
        veg = mix(veg, v_tree, treeline * smoothstep(0.20, 0.60, cover)
                             * (0.55 + 0.45 * b_fine));
        // the planting does not erase the planet. the mars map's own
        // light and dark provinces show THROUGH it -- multiplied in, so
        // bright terrain carries bright growth, plus a little of its
        // colour straight so the ground keeps its identity under green
        // MOSTLY the mars map. multiplying against its full COLOUR
        // carries every crater, streak and dark province through the
        // planting -- taking only its luminance flattened all that to
        // one featureless wash. the 2.05 lifts it back out of the
        // darkening a straight multiply costs
        veg *= marsc * 2.05 + 0.06;
        // MOSTLY mars, everywhere -- not only inside the perlin
        // patches. a floor of 55% bare ground with the patches taking
        // it to 90%, so the planting reads as a tint over martian
        // terrain rather than as a green surface of its own
        veg = mix(veg, marsc * (0.95 + 0.30 * slv), 0.55 + 0.35 * mmix);
        vec3  base = mix(bare, veg, cover);
        // grass gives way to sand, and the channel bed is sand as well
        // so the water reads as riverbed underneath and not as rock
        base = mix(base, c_sand * (0.86 + 0.28 * crest), max(sand, wet));
        // the SHORE is pale, washed sand -- brighter and less red than
        // the dry inland sand, or a beach is the same tan as the ground
        // behind it and reads as nothing at all. wet sand darkens right
        // at the waterline the way a tide line does
        vec3 c_shore = vec3(0.80, 0.74, 0.62) * (0.78 + 0.34 * slv);
        c_shore = mix(c_shore, marsc, mmix * 0.10);
        c_shore *= 1.0 - 0.34 * (1.0 - smoothstep(0.0, 0.00022, abs(dsh)));
        base = mix(base, c_shore, beach);
        // ice over the top. the sand plate's own grain stands in for
        // snow texture -- it is the only fine granular thing we own,
        // and taken as level only it carries no direction
        vec3 c_snow = vec3(0.84, 0.89, 0.97) * (0.80 + 0.32 * slv);
        // same rule as the planting: snow lying thin lets the ground's
        // own colour through, so the provinces stay legible under it
        c_snow *= 0.72 + 0.62 * marsl;
        // same perlin, so the rock that breaks through the snow is the
        // rock that breaks through the planting further down
        c_snow = mix(c_snow, marsc * 0.92, mmix * 0.70);
        base = mix(base, c_snow, snowf);

        // a grazing sun throws long shadow: the terminator on a slope is
        // hard, so keep the ambient low or the shadows turn to grey mud
        // gain under 1: the map is already a bright albedo, and pushing
        // it past full white flattens every ridge into paper
        vec3 lit = base * (0.16 + ndl * 1.25);

        // GRASS SHINE. living leaf is waxy and throws a broad sheen,
        // and its own texture says where -- flat lawn glares, deep
        // canopy swallows it
        vec3  gvd = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        vec3  ghv = normalize(sun + gvd);
        float gsp = pow(max(dot(nw, ghv), 0.0), 26.0);
        lit += vec3(0.62, 0.72, 0.44) * gsp * cover * (1.0 - sand) * 0.55
             * (0.35 + 0.65 * dot(veg, vec3(0.333)));

        // ICE SHEEN. glazed snow is a half-mirror: a tight highlight
        // plus a fresnel rim, so it flares as the ground turns away
        float isp  = pow(max(dot(nw, ghv), 0.0), 140.0);
        float ifr  = 0.04 + 0.96 * pow(1.0 - max(dot(nw, gvd), 0.0), 5.0);
        lit += (vec3(1.00, 1.00, 1.06) * isp * 0.85
             +  vec3(0.62, 0.72, 0.92) * ifr * 0.16) * snowf;

        // WATER. the channel is a surface of its own: the rock material
        // gets flattened out of the normal so it can reflect, the bed
        // shows through the shallows, and the sun leaves a hard
        // highlight because still water is very nearly a mirror
        if (wet > 0.001) {{
            // GLASS. the surface is the sphere's own normal, with only
            // a trace of the terrain left in it -- still water is flat
            // however rough its bed, and any grain here kills the
            // mirror. so the look is carried by reflection and fresnel,
            // not by a diffuse term
            vec3  wn   = normalize(mix(n, sp, 0.985));
            vec3  wnw  = normalize(nmm * wn);
            vec3  wvd  = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
            vec3  hv   = normalize(sun + wvd);
            float spec = pow(max(dot(wnw, hv), 0.0), 900.0);
            float wndl = max(dot(wnw, sun), 0.0);
            // schlick: looked at flat, water is nearly all reflection,
            // and a canyon floor seen from orbit is a very flat look
            float fres = 0.02 + 0.98 * pow(1.0 - max(dot(wnw, wvd), 0.0), 5.0);
            // purplish blue, deepening where the catchment is largest
            // shallows stay purplish blue; the deep runs RED. this is
            // iron-laden water over red rock, not an earth ocean
            vec3  shal = vec3(0.31, 0.30, 0.58);
            vec3  mid9 = vec3(0.30, 0.17, 0.36);
            vec3  deep = vec3(0.42, 0.11, 0.12);
            float dpt9 = smoothstep(0.15, 0.95, wetf);
            vec3  wcol = mix(shal, mid9, smoothstep(0.0, 0.55, dpt9));
            wcol = mix(wcol, deep, smoothstep(0.45, 1.0, dpt9));
            // the sky it mirrors, warmed toward the sun like the haze
            vec3  sky  = mix(vec3(0.30, 0.31, 0.52), vec3(1.05, 0.80, 0.58),
                             pow(max(dot(-wvd, sun), 0.0), 3.0));
            vec3  wlit = wcol * (0.14 + wndl * 0.55) * (1.0 - fres)
                       + sky * fres * 1.15
                       + vec3(1.00, 0.97, 1.05) * spec * 5.0;
            lit = mix(lit, wlit, wet);
        }}

        // ATMOSPHERE. mars air is loaded with suspended dust, and it
        // forward-scatters hard: looking away from the sun it is deep
        // iron red, across it a dusty orange, and straight into it a
        // yellow gold. one three-stop ramp on the scattering angle
        vec3 vd = normalize(v_world_pos.xyz - ubo.cam_pos.xyz);
        float fw = max(dot(vd, sun), 0.0);
        float fs = pow(fw, 6.0);
        // FOG BY DISTANCE, not by sun angle. yellow gold only close in,
        // through brown red across the middle, into purple at range --
        // one continuous ramp, so the ground and the shell above it
        // never paint two separate arcs
        float fd = clamp(dist / 0.55, 0.0, 1.0);
        // the far haze is the same warm white-gold as the sunlit cloud,
        // NOT purple. purple belongs above the horizon, in space --
        // down here it read as a bruise across the distance
        vec3 dust = mix(vec3(1.30, 0.98, 0.56), vec3(1.02, 0.72, 0.44),
                        smoothstep(0.0, 0.40, fd));
        dust = mix(dust, vec3(0.92, 0.74, 0.58), smoothstep(0.35, 1.0, fd));
        // looking into the sun still lifts it, but only in brightness
        dust *= 1.0 + 0.85 * fs;
        // FOG pools in the basins: the column of air above a canyon
        // floor is far deeper than over a plateau, and dust settles
        // into it. asl is height above sea, so this thickens downward
        float fogl = 1.0 - smoothstep(-0.02, 0.14, asl);
        float hz = 1.0 - exp(-dist * ubo.haze * (1.0 + fs * 4.0)
                                  * (0.55 + 1.60 * fogl));
        vec3 outc = mix(lit, dust, clamp(hz, 0.0, 1.0));

        // LIMB GLOW. at the horizon the line of sight grazes the entire
        // depth of the dust column, so the air lights up exactly where
        // the ground runs out. the crossfade IS the softness: geometry
        // fades DOWN by mu while the dust flares UP through the same
        // band. mu collapses to zero in the last fraction of a percent
        // of the projected radius, so the fade has to start at mid-band
        // or it spans no pixels at all
        vec3  vdir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        vec3  nsp  = normalize(nmm * sp);
        float mu   = clamp(dot(nsp, vdir), 0.0, 1.0);
        // MIX, never add. adding leaves the terrain underneath still
        // showing, so craters and ridges print their shapes through the
        // glow. mixing to full replaces them -- at the rim there is
        // nothing but air, which is what a deep atmosphere looks like
        float limb = smoothstep(0.30, 0.03, mu);
        // the near band is the same dust as the haze; the outermost
        // fade goes purple, the way a thick sky does at its top
        // terrain stays OPAQUE to its edge and simply DARKENS by mu.
        // the shell above flares up through the same band -- that
        // crossfade is the softness, and it is why the ground must not
        // try to paint its own rim colour here
        outc *= 0.30 + 0.70 * smoothstep(0.0, 0.12, mu);

        fragColor = vec4(outc, 1.0);
    }


# THE SKY SHELL. the rim glow on the ground can only light fragments
# that HAVE ground, so it stops dead at the silhouette. this is the
# same carpet mesh a third time, lifted to a shell above the surface,
# so there is geometry ABOVE the limb to carry the fade into space.
#
# its opacity comes from the ray's CLOSEST APPROACH to the planet --
# the classic optical-depth trick. a ray grazing the surface travels
# through the whole dust column and is opaque; one passing high above
# barely clips it. that is what fades the fuzz out to black, and it
# costs a dot product and an exp
enum TerraCloudSurface
    volume  : 0

ModelViewProject TerraSkyShader
    mutable sun_dir  : vec4f
    mutable cam_pos  : vec4f
    mutable eye_m    : vec4f
    mutable hdist    : f32
    mutable atm_h    : f32
    mutable atm_fall : f32
    mutable atm_gain : f32
    # the cloud deck: base and top radius, coverage, and wind phase
    mutable cld_lo   : f32
    mutable cld_hi   : f32
    mutable cld_cov  : f32
    mutable cld_time : f32
    # how hard the wind shears the deck along the equator
    mutable cld_wind : f32

    attrib volume  : LayoutBinding [ type:typeid[ TerraCloudSurface ],
                                     id:TerraCloudSurface.volume,
                                     count:1, format: typeid[ rgba8 ] ]

    attrib a_pos        : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal     : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv         : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_normal     : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_uv         : VertexOutput  [ type:typeid[ vec2f ] ]
    attrib v_sp         : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_world_pos  : VertexOutput  [ type:typeid[ vec4f ] ]
    attrib v_h          : VertexOutput  [ type:typeid[ f32   ] ]

    attrib fragColor    : FragmentOutput[ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    func vertex [] -> GLSL none {
        float rn = length(a_pos.xz);
        vec2  pd = rn > 0.0 ? a_pos.xz / rn : vec2(1.0, 0.0);
        vec3  up_m = normalize(ubo.eye_m.xyz);
        vec3  ax9  = abs(up_m.y) > 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3  t_e  = normalize(cross(ax9, up_m));
        vec3  t_n  = cross(up_m, t_e);
        // THE WHOLE SPHERE, not a cap. the carpet is a polar grid, so
        // mapping its radius across a half-turn wraps it into a closed
        // shell with NO mesh boundary anywhere. a cap ends somewhere,
        // and wherever it ended the alpha was still 0.06 -- that was
        // the hard line straight across the sky
        float s9   = (rn / 1.35) * 3.14159265;
        vec3  dir  = normalize(up_m * cos(s9) + (t_e * pd.x + t_n * pd.y) * sin(s9));
        v_uv     = a_uv;
        v_sp     = dir;
        v_normal = dir;
        v_h      = 0.0;
        vec4 wpos = ubo.model * vec4(dir * (1.0 + ubo.atm_h), 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func c_hash [ p: vec3f ] -> GLSL float {
        return fract(sin(dot(p, vec3(127.1, 311.7, 74.7))) * 43758.5453123);
    }

    func c_remap [ x: f32, a: f32, b: f32, c: f32, d: f32 ] -> GLSL float {
        return c + (clamp(x, a, b) - a) / max(b - a, 1e-5) * (d - c);
    }

    # henyey-greenstein: real droplets scatter FORWARD, which is the
    # silver lining you get looking toward the sun through a cloud edge
    func c_hg [ ct: f32, g: f32 ] -> GLSL float {
        float g2 = g * g;
        return (1.0 - g2) / (12.566371 * pow(1.0 + g2 - 2.0 * g * ct, 1.5));
    }

    # one z-slice of the baked 64^3 volume out of its 8x8 atlas. the
    # 63/64 inset stops bilinear bleeding a neighbouring slice in
    func c_slice [ uv: vec2f, z: f32 ] -> GLSL vec4f {
        float zi = mod(z, 64.0);
        vec2  t  = (uv * 63.0 + 0.5) / 512.0;
        return texture(volume, vec2(mod(zi, 8.0) * 0.125 + t.x,
                                    floor(zi / 8.0) * 0.125 + t.y));
    }

    # trilinear: bilinear is free inside a slice, the z lerp by hand
    func c_vol [ p: vec3f ] -> GLSL vec4f {
        vec3  q  = fract(p);
        float zf = q.z * 64.0 - 0.5;
        float z0 = floor(zf);
        return mix(c_slice(q.xy, z0), c_slice(q.xy, z0 + 1.0), zf - z0);
    }

    # DENSITY, built the way the volumetric-cloud papers do it: a
    # billow base cut by coverage, then ERODED at its edges by the
    # high-frequency octaves. the erosion makes wisps and torn
    # shoulders; without it every cloud is a smooth blob
    func c_dens [ p: vec3f ] -> GLSL float {
        float r = length(p);
        float h = (r - (1.0 + ubo.cld_lo)) / max(ubo.cld_hi - ubo.cld_lo, 1e-5);
        if (h < 0.0 || h > 1.0) return 0.0;
        // anvil profile: flat base, widest low, feathering at the top
        // FLAT base: cut on hard at the deck floor so the underside is
        // a plane, the way a real cloud base condenses at one altitude
        float prof = smoothstep(0.0, 0.035, h) * (1.0 - smoothstep(0.62, 1.0, h));
        // and FOUR TIMES the material at the base. a deck of even
        // density top to bottom is a slab -- real cloud carries its
        // mass low and thins upward, which is what gives a cloudscape
        // its weight and lets the crowns read as crowns
        // TEN to one, base to top. the base has to be the body of the
        // thing and the crown a remnant of it
        prof *= mix(1.0, 0.10, h);
        // WIND SHEAR. scaling the POLAR component makes the field vary
        // fast in latitude and slow in longitude, so every lobe is
        // drawn out east-west and the deck bands parallel to the
        // equator -- which is what a prevailing wind does to cloud.
        // it stretches the shapes rather than resizing them
        vec3  ps = vec3(p.x, p.y * ubo.cld_wind, p.z);
        // 1.2, not 3.0. the threshold only ever keeps the PEAK of each
        // worley lobe, so a 282km lobe was surviving as a core a
        // fraction that size -- spikes with no footprint. a 706km lobe
        // leaves a base worth the name even after the cut
        vec3  q = ps * 1.2 + vec3(ubo.cld_time, ubo.cld_time * 0.05, ubo.cld_time * 0.6);
        vec4  v = c_vol(q);
        // coverage cuts the RAW field; the profile attenuates AFTER.
        // cutting `v.r * prof` instead made the height profile push
        // samples across the threshold, so the deck's own taper became
        // a hard in/out surface in 3D -- that is what tore
        float base = c_remap(v.r, 1.0 - ubo.cld_cov, 1.0, 0.0, 1.0);
        if (base <= 0.001) return 0.0;
        float d = base * prof;
        if (d <= 0.001) return 0.0;
        // erosion strengthens with height, so bases stay solid and the
        // crowns tear into cauliflower
        vec4  hf = c_vol(q * 2.9 + vec3(19.3, 7.1, 11.7));
        // (q already carries the shear, so the erosion runs WITH the
        // bands rather than cutting across them)
        float ero = hf.g * 0.625 + hf.b * 0.250 + hf.a * 0.125;
        // barely eroded at the base, heavily at the crown: that is what
        // keeps bottoms flat and breaks the tops into scattered heads
        // nothing at all at the base -- erosion there is what was
        // trimming the footprint away as fast as coverage made it
        d = c_remap(d, ero * (0.02 + 0.80 * h), 1.0, 0.0, 1.0);
        return clamp(d, 0.0, 1.0);
    }

    func fragment [] -> GLSL none {
        // THE ENCELADUS METHOD. the model transform is a pure rotation,
        // so the planet centre is the world origin and the ray's
        // closest approach is one dot product. everything comes from
        // that radius: a ray grazing the surface crosses the whole dust
        // column, one passing high above barely clips it
        vec3  ro = ubo.cam_pos.xyz;
        vec3  rd = normalize(v_world_pos.xyz - ro);
        float tca = 0.0 - dot(ro, rd);
        float glow = 0.0;
        float hw = 0.0;
        float rch = 0.0;
        vec3  sunw = normalize(ubo.sun_dir.xyz);
        if (tca > 0.0) {{
            vec3  pca = ro + rd * tca;
            float rc  = length(pca);
            // in SCALE HEIGHTS, not a fixed radius: the colour ramp has
            // to travel with the alpha or extending the air just parks
            // a solid purple band out where it used to fade
            rch = clamp((rc - 1.0) / (ubo.atm_fall * 2.13), 0.0, 1.0);
            // outward, a long slow fade into space. the smoothstep is a
            // SMOOTH occlusion ramp -- a binary cut stamps the analytic
            // sphere's silhouette as a hard circle offset from the real
            // displaced terrain edge
            float od = exp(-max(rc - 1.0, 0.0) / ubo.atm_fall)
                     * smoothstep(0.976, 0.997, rc);
            // and smoothed again by penetration depth going inward
            float dip  = clamp((1.0 - rc) / 0.018, 0.0, 1.0);
            float hocc = mix(1.0, 0.35, dip);
            hw = clamp(dot(pca / max(rc, 1e-4), sunw) * 0.5 + 0.5, 0.0, 1.0);
            // the blaze where the graze kisses the surface: this is
            // what DISSOLVES the terrain edge, so no ridge or crater
            // prints its shape through the rim
            // asymmetric on purpose: wide going out into space, tight
            // going in, or the rim glow lies over the terrain as fog
            float nearg = exp(-(max(rc - 1.0, 0.0) / 0.012
                              + max(1.0 - rc, 0.0) / 0.0035));
            glow = od * hocc * (0.16 + 0.52 * hw) * (1.0 + 5.0 * nearg);
            // THIN THE FLOOR. holding full opacity right down onto the
            // limb is what gives it a thick base -- easing it off there
            // lifts the whole visible band up off the horizon
            glow *= 0.30 + 0.70 * smoothstep(0.0, 0.34, rch);
        }}
        float fw = max(dot(rd, sunw), 0.0);
        // the same air as the ground haze: gold into the sun, iron red
        // away from it -- and purple where it thins out to nothing
        // ONE colour, and the ALPHA does the fading. tinting toward
        // purple as it thinned just painted a solid purple band up
        // there -- the air has to thin to NOTHING, and that is a fade
        // to transparent, not a fade to another colour
        // THREE stops now. a transparent yellow sits on the horizon
        // itself, the warm white-gold you liked is lifted above it, and
        // purple takes over only as the whole thing dies into space
        vec3 col = mix(vec3(1.36, 1.06, 0.42), vec3(1.18, 0.86, 0.56),
                       smoothstep(0.0, 0.40, rch));
        col = mix(col, vec3(0.40, 0.20, 0.58), smoothstep(0.44, 1.0, rch));
        col *= 1.0 + 0.80 * pow(fw, 4.0);
        float atma = clamp(glow * ubo.atm_gain, 0.0, 0.58);

        // ---- VOLUMETRIC CLOUDS ----
        // the deck is a spherical shell. clip the ray to it, march, and
        // light each sample by marching a few steps toward the sun --
        // that self-shadowing is what gives a cloud its shape. flat
        // billboards cannot do it at any resolution
        float r0 = 1.0 + ubo.cld_lo;
        float r1 = 1.0 + ubo.cld_hi;
        float bq = dot(ro, rd);
        float c1 = dot(ro, ro) - r1 * r1;
        float c0 = dot(ro, ro) - r0 * r0;
        float cg = dot(ro, ro) - 1.0;
        float d1 = bq * bq - c1;
        vec3  cL = vec3(0.0);
        float Tr = 1.0;
        if (d1 > 0.0) {{
            float s1 = sqrt(d1);
            float tn = -bq - s1;
            float tf = -bq + s1;
            // inside the outer shell already: start at the eye
            if (tn < 0.0) tn = 0.0;
            // the inner sphere and the planet both cut the march short
            float d0 = bq * bq - c0;
            if (d0 > 0.0) {{
                float t0 = -bq - sqrt(d0);
                if (t0 > tn) tf = min(tf, t0);
            }}
            float dg = bq * bq - cg;
            if (dg > 0.0) {{
                float tg = -bq - sqrt(dg);
                if (tg > 0.0) tf = min(tf, tg);
            }}
            // a grazing ray crosses the deck for an enormous distance;
            // spreading a fixed step count over it makes dt huge and
            // the march prints as stair-stepped bands. cap the segment
            tf = min(tf, tn + 0.42);
            if (tf > tn) {{
                // FIXED STEP SIZE, not a fixed count. a count spread
                // over a grazing crossing gave 30km steps against 3km
                // features -- that is the speckle. a constant step
                // samples every ray at the same rate and simply runs
                // out of budget on the long ones, by which point they
                // are opaque anyway
                // EIGHT TIMES the tests. the step is three times finer
                // and the budget eight times longer -- affordable only
                // because empty air is skipped at triple stride below,
                // and most of the deck is empty
                // UNIFORM stride. the adaptive skip made neighbouring
                // pixels land on different sample positions and take
                // different step counts, so two pixels looking at one
                // cloud disagreed -- that is noise by construction
                float dt = (ubo.cld_hi - ubo.cld_lo) / 40.0;
                const int STEPS = 640;
                float jit = c_hash(vec3(gl_FragCoord.xy, 7.3));
                // MODEL space: the craft holds station while the planet
                // turns, so a field sampled in WORLD space sits still
                // relative to the camera -- the clouds were painted on
                // the lens. the planet's frame is what we fly through
                mat3 wm = transpose(mat3(ubo.model));
                vec3 sunm = wm * sunw;
                // forward scattering: strong lobe plus a wide one, the
                // usual two-term fit to real droplet phase
                float ct = dot(normalize(rd), sunw);
                float ph = max(c_hg(ct, 0.76), c_hg(ct, -0.22) * 0.55);
                // YELLOW where the sun strikes, through GREY in the
                // body, to PURPLE in shadow and along the base. the
                // ramp runs on how much light reached the sample, so
                // it is lighting doing it, not a height gradient
                vec3 c_lit = vec3(1.35, 1.12, 0.58);
                vec3 c_mid = vec3(0.62, 0.60, 0.63);
                vec3 c_shd = vec3(0.34, 0.22, 0.48);
                vec3 sunc = mix(c_lit, vec3(1.18, 0.72, 0.36),
                                smoothstep(0.35, 0.0, abs(sunw.y)));
                // ambient: purple sky above, dusty violet bounce below
                vec3 amb_t = vec3(0.40, 0.33, 0.55);
                vec3 amb_b = vec3(0.30, 0.20, 0.40);
                float tc = tn + jit * dt;
                for (int i = 0; i < STEPS; i++) {{
                    if (tc > tf) break;
                    vec3  p = wm * (ro + rd * tc);
                    tc += dt;
                    float d = c_dens(p);
                    // clear air costs one sample and three steps of
                    // ground: the fine rate is spent only inside cloud
                    if (d > 0.0004) {{
                        // light march toward the sun: this self-shadow
                        // is what gives a cloud an inside
                        float lstep = (ubo.cld_hi - ubo.cld_lo) * 0.22;
                        float ls = c_dens(p + sunm * lstep)
                                 + c_dens(p + sunm * lstep * 2.2)
                                 + c_dens(p + sunm * lstep * 4.0)
                                 + c_dens(p + sunm * lstep * 7.0) * 0.5;
                        float dep = ls * lstep;
                        // beer-powder: a cloud edge is BRIGHTER than
                        // its face, which single beer cannot express
                        float beer = exp(-dep * 52.0);
                        float powd = 1.0 - exp(-d * 9.0);
                        float hh = clamp((length(p) - (1.0 + ubo.cld_lo))
                                       / max(ubo.cld_hi - ubo.cld_lo, 1e-5), 0.0, 1.0);
                        vec3  amb = mix(amb_b, amb_t, hh);
                        // beer is how much sun survived to here: 1 at a
                        // sunlit face, 0 deep inside. that is the axis
                        // the yellow-grey-purple ramp belongs on
                        // crowns go WHITE, not yellow -- the yellow is
                        // the low sun on their flanks
                        vec3  crown = mix(sunc, vec3(1.42, 1.36, 1.22), hh * hh);
                        vec3  body = mix(c_shd, c_mid, smoothstep(0.02, 0.35, beer));
                        body = mix(body, crown, smoothstep(0.30, 0.85, beer));
                        // and the base sits in its own shadow: purple,
                        // deepening the lower in the deck it lies
                        body = mix(body, c_shd, (1.0 - hh) * (1.0 - hh) * 0.72);
                        vec3  sc  = body * (0.55 + powd * ph * 2.2) + amb * (0.30 + 0.55 * hh);
                        // DENSER: they were see-through at any depth
                        float aa  = 1.0 - exp(-d * dt * 210.0);
                        cL += Tr * aa * sc;
                        Tr *= 1.0 - aa;
                        if (Tr < 0.015) break;
                    }}
                }}
            }}
        }}
        float cloud_a = 1.0 - Tr;
        // clouds sit UNDER the limb glow: the air is above the deck
        // PREMULTIPLIED, and the model is set straight_alpha:false so
        // the pipeline blends with SRC=ONE. the march already produces
        // premultiplied values -- cL accumulates as Tr*a*colour -- so
        // dividing it back out only to have the blender multiply it in
        // again blows the colour up wherever alpha is near zero, which
        // is precisely a cloud's edge. that was the tearing
        vec3  outc = cL + col * atma * Tr;
        float outa = clamp(cloud_a + atma * Tr, 0.0, 1.0);
        fragColor = vec4(outc, outa);
    }


enum TerraWaterSurface
    height  : 0

# A REAL WATER SURFACE. the terraformed sea is a shell of its own at
# sea-level radius, riding the same carpet mesh as the ground, and the
# waterline is where that shell passes through the terrain -- not a
# threshold painted on rock. that is what gives a true shore, real
# depth, and an ocean that fills basins instead of following noise
ModelViewProject TerraWaterShader
    mutable hmax     : f32
    mutable sun_dir  : vec4f
    mutable cam_pos  : vec4f
    mutable haze     : f32
    mutable eye_m    : vec4f
    mutable hdist    : f32
    mutable sea_l0   : f32
    mutable sea_bias : f32

    attrib height  : LayoutBinding [ type:typeid[ TerraWaterSurface ],
                                     id:TerraWaterSurface.height,
                                     count:1, format: typeid[ rgba8 ] ]

    attrib a_pos        : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal     : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv         : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_normal     : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_uv         : VertexOutput  [ type:typeid[ vec2f ] ]
    attrib v_sp         : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_world_pos  : VertexOutput  [ type:typeid[ vec4f ] ]
    attrib v_h          : VertexOutput  [ type:typeid[ f32   ] ]

    attrib fragColor    : FragmentOutput[ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    # same four-tap decode the ground uses: the 16 bits live across R
    # and A, and bilinear on the low byte ramps backwards at every wrap
    func w_ground [ uv: vec2f ] -> GLSL float {
        vec2  ts = vec2(8192.0, 4096.0);
        vec2  pp = uv * ts - 0.5;
        vec2  fr = fract(pp);
        vec2  b0 = (floor(pp) + 0.5) / ts;
        vec2  e1 = 1.0 / ts;
        vec4  q00 = textureLod(height, b0, 0.0);
        vec4  q10 = textureLod(height, b0 + vec2(e1.x, 0.0), 0.0);
        vec4  q01 = textureLod(height, b0 + vec2(0.0, e1.y), 0.0);
        vec4  q11 = textureLod(height, b0 + e1, 0.0);
        float h00 = q00.r * 65280.0 + q00.a * 255.0;
        float h10 = q10.r * 65280.0 + q10.a * 255.0;
        float h01 = q01.r * 65280.0 + q01.a * 255.0;
        float h11 = q11.r * 65280.0 + q11.a * 255.0;
        return mix(mix(h00, h10, fr.x), mix(h01, h11, fr.x), fr.y) / 65535.0;
    }

    # sea level stands HIGHER at the equator: warm ground fills easier,
    # and that bias is the whole reason the valley is a sea while the
    # polar basins stay dry
    func w_sea [ dy: f32 ] -> GLSL float {
        return ubo.sea_l0 + ubo.sea_bias * cos(asin(clamp(dy, -1.0, 1.0)));
    }

    func vertex [] -> GLSL none {
        float rn = length(a_pos.xz);
        vec2  pd = rn > 0.0 ? a_pos.xz / rn : vec2(1.0, 0.0);
        vec3  up_m = normalize(ubo.eye_m.xyz);
        vec3  ax9  = abs(up_m.y) > 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3  t_e  = normalize(cross(ax9, up_m));
        vec3  t_n  = cross(up_m, t_e);
        float s9   = rn * ubo.hdist;
        vec3  dir  = normalize(up_m * cos(s9) + (t_e * pd.x + t_n * pd.y) * sin(s9));

        float lon0 = atan(ubo.eye_m.z, ubo.eye_m.x);
        float dl   = atan(dir.z, dir.x) - lon0;
        if (dl >  3.14159265) dl -= 6.28318531;
        if (dl < -3.14159265) dl += 6.28318531;
        vec2 uv = vec2(0.5 + (lon0 + dl) / 6.28318531,
                       0.5 - asin(clamp(dir.y, -1.0, 1.0)) / 3.14159265);

        v_uv     = uv;
        v_sp     = dir;
        mat3 nm  = transpose(inverse(mat3(ubo.model)));
        v_normal = normalize(nm * dir);
        // the shell sits at SEA level, flat as water is
        float sg = w_sea(dir.y) * ubo.hmax;
        v_h      = sg;
        vec4 wpos = ubo.model * vec4(dir * (1.0 + sg), 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment [] -> GLSL none {
        vec3  sp = normalize(v_sp);
        float tg = w_ground(v_uv);
        float sea = w_sea(sp.y);
        // ABOVE the waterline there is no sea here. cutting the shell
        // per pixel is what makes the shore follow the real contour
        // instead of a painted threshold
        float depth = sea - tg;
        // a MARGIN, not zero. at exactly the waterline the sea shell and
        // the ground are coplanar, and the depth test alternates between
        // them pixel by pixel -- that is the dashed contour. 0.0012 of
        // packed height is ~80m of water, thin enough to see nothing
        if (depth <= 0.0012) discard;

        mat3 nmm = transpose(inverse(mat3(ubo.model)));
        vec3 nw  = normalize(nmm * sp);
        vec3 sun = normalize(ubo.sun_dir.xyz);
        vec3 vdw = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        vec3 hv  = normalize(sun + vdw);

        // shallows purplish blue, the deep running RED -- iron water
        // over red rock, not an earth ocean
        float dn   = clamp(depth / 0.16, 0.0, 1.0);
        // cyan through the body, greener where it shallows out, and a
        // deep teal at the bottom rather than an ocean navy
        vec3  shal = vec3(0.34, 0.74, 0.60);
        vec3  mid9 = vec3(0.13, 0.56, 0.66);
        vec3  deep = vec3(0.03, 0.17, 0.30);
        vec3  wcol = mix(shal, mid9, smoothstep(0.00, 0.45, dn));
        wcol = mix(wcol, deep, smoothstep(0.40, 1.00, dn));
        // the bed used to be FAKED by brightening the water colour in
        // the shallows. it is real now: the shell blends, so the actual
        // terrain underneath shows through wherever the water is thin

        // FOAM where the sea runs out onto the shore -- the same
        // contour the terrain puts its beach on, read from the other side
        float foam = 1.0 - smoothstep(0.0, 0.0055, depth);
        wcol = mix(wcol, vec3(0.78, 0.74, 0.80), foam * foam * 0.70);

        float ndl  = max(dot(nw, sun), 0.0);
        float spec = pow(max(dot(nw, hv), 0.0), 700.0);
        float fres = 0.02 + 0.98 * pow(1.0 - max(dot(nw, vdw), 0.0), 5.0);
        vec3  sky  = mix(vec3(0.32, 0.31, 0.55), vec3(1.05, 0.80, 0.58),
                         pow(max(dot(-vdw, sun), 0.0), 3.0));
        vec3  lit  = wcol * (0.16 + ndl * 0.72) * (1.0 - fres * 0.75)
                   + sky * fres * 0.38
                   + vec3(1.00, 0.97, 1.05) * spec * 4.5;

        // the same air as the ground, and the sea lies at the very
        // bottom of it -- so it always carries the thick-layer factor
        float dist = length(v_world_pos.xyz - ubo.cam_pos.xyz);
        vec3  vdd = normalize(v_world_pos.xyz - ubo.cam_pos.xyz);
        float fw = max(dot(vdd, sun), 0.0);
        float fs = pow(fw, 6.0);
        float fd = clamp(dist / 0.55, 0.0, 1.0);
        // the far haze is the same warm white-gold as the sunlit cloud,
        // NOT purple. purple belongs above the horizon, in space --
        // down here it read as a bruise across the distance
        vec3 dust = mix(vec3(1.30, 0.98, 0.56), vec3(1.02, 0.72, 0.44),
                        smoothstep(0.0, 0.40, fd));
        dust = mix(dust, vec3(0.92, 0.74, 0.58), smoothstep(0.35, 1.0, fd));
        dust *= 1.0 + 0.85 * fs;
        float hz = 1.0 - exp(-dist * ubo.haze * (1.0 + fs * 4.0) * 2.05);
        vec3  outc = mix(lit, dust, clamp(hz, 0.0, 1.0));
        // the sea takes the same limb treatment, or the water edge
        // stays hard while the land beside it goes soft
        float mu = clamp(dot(nw, vdw), 0.0, 1.0);
        outc *= 0.30 + 0.70 * smoothstep(0.0, 0.12, mu);

        // TRANSPARENT AT THE EDGES. thin water hides nothing, so the
        // shore fades out over the bed instead of ending on a hard
        // colour boundary -- and it means the beach reads continuously
        // from dry sand, through wet sand, into water
        // FOUR TIMES the reach. this band is the shallows, and it has
        // to span real ground -- at 0.014 the bed only showed for the
        // last kilometre of depth, which is a rim, not a shallow
        float wa = smoothstep(0.0, 0.056, depth);
        fragColor = vec4(outc, clamp(wa, 0.0, 1.0));
    }


Backdrop TerraMars
    frost : true
    public func bg_color [ ] -> rgba
        return color
    frost_sharp : true
    intern olymp  : TerraShader
    intern owater : TerraWaterShader
    intern osky   : TerraSkyShader
    intern gsky   : GaiaShader
    intern models : vec Model
    intern target : Render
    intern built  : bool
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    intern e_cur  : f32
    intern dbg_n  : i32
    public color  : rgba [ r:0.004, g:0.003, b:0.004, a:1.0 ]

    func build_models[]
        built = true
        log 'TERRA build_models: start'
        o_gltf : build_carpet[]
        o_gltf.hold[]
        o_gltf.compute_worlds[]
        log 'TERRA build_models: sphere built'
        olymp = TerraShader [ vk: vk ]
        pkp : path '../{share_name}/baked/mars-pk.png'
        nkp : path '../{share_name}/baked/mars-nk.png'
        dnp : path '../{share_name}/baked/mars-dn.png'
        ekp : path '../{share_name}/baked/mars-ek.png'
        rvp : path '../{share_name}/baked/mars-rv.png'
        if [ !pkp.exists[] || !nkp.exists[] ]
            log 'mars: no baked maps — baking live (SILVER_EXPORT=1 bakes at build)'
            mars_bake_mola[]
        if [ !dnp.exists[] ]
            log 'mars: no rock detail — baking live'
            mars_bake_detail[]
        if [ !ekp.exists[] ]
            log 'mars: no edge map — baking live'
            mars_bake_edge[]
        if [ !rvp.exists[] ]
            log 'mars: no river map — baking live'
            mars_bake_river[]
        # data maps MUST be linear or the sampler re-linearizes them and
        # the whole surface drops below its real height
        o_samplers : map Image [string] [
            'height': Image [ uri: pkp, surface: TerraSurface.height,
                              linear: true, wrap_u: true ],
            'nrm':    Image [ uri: nkp, surface: TerraSurface.nrm,
                              linear: true, wrap_u: true ],
            'detail': Image [ uri: dnp, surface: TerraSurface.detail,
                              linear: true, wrap_u: true,
                              wrap_v: true ],
            'edge':   Image [ uri: ekp, surface: TerraSurface.edge,
                              linear: true, wrap_u: true ],
            'color':  Image [ uri: path '../{share_name}/textures/mars-color-8192x4096.jpg', surface: TerraSurface.color, linear: true, wrap_u: true ],
            'veg_a':  Image [ uri: path '../{share_name}/textures/mars-veg-sand.png',   surface: TerraSurface.veg_a, linear: true, wrap_u: true, wrap_v: true ],
            'veg_b':  Image [ uri: path '../{share_name}/textures/mars-veg-grass.png',  surface: TerraSurface.veg_b, linear: true, wrap_u: true, wrap_v: true ],
            'veg_c':  Image [ uri: path '../{share_name}/textures/mars-veg-forest.png', surface: TerraSurface.veg_c, linear: true, wrap_u: true, wrap_v: true ],
            'river':  Image [ uri: rvp, surface: TerraSurface.river,
                              linear: true, wrap_u: true ]
        ]
        log 'TERRA build_models: maps loaded'
        # the projection y-flip reverses triangle winding, so back-face
        # culling would cull the whole carpet
        o_model : Model [ vk: vk, w: ux, id: o_gltf, s: olymp,
                          samplers: o_samplers,
            straight_alpha: true, cull_none: true ]
        # the sea rides the SAME carpet, one shell higher. it needs only
        # the height map: everything else it works out per pixel
        owater = TerraWaterShader [ vk: vk ]
        w_samplers : map Image [string] [
            'height': Image [ uri: pkp,
                              surface: TerraWaterSurface.height,
                              linear: true, wrap_u: true ]
        ]
        w_model : Model [ vk: vk, w: ux, id: o_gltf, s: owater,
                          samplers: w_samplers,
            straight_alpha: true, cull_none: true ]
        # the sky shell needs no maps at all -- it works entirely from
        # the ray's geometry. drawn LAST so it lays over both surfaces
        osky = TerraSkyShader [ vk: vk ]
        cldp : path '../{share_name}/baked/mars-cld.png'
        if [ !cldp.exists[] ]
            log 'mars: no cloud volume — baking live'
            mars_bake_cloud[]
        # the volume tiles on all three axes, so both axes wrap
        s_samplers : map Image [string] [
            'volume': Image [ uri: cldp,
                              surface: TerraCloudSurface.volume,
                linear: true, wrap_u: true, wrap_v: true ]
        ]
        # PREMULTIPLIED: a volumetric march accumulates premultiplied
        # colour by construction, so the blender must not scale it again
        s_model : Model [ vk: vk, w: ux, id: o_gltf, s: osky,
                          samplers: s_samplers,
            straight_alpha: false, cull_none: true,
            depth_no_test: true ]
        # the galaxy behind everything, same plate the saturn scenes use
        gsky = GaiaShader [ vk: vk ]
        g_gltf : build_globe[]
        g_samplers : map Image [string] [
            'color': Image [ uri: path '{scenes_share[]}/textures/gaia.png', surface: GaiaSurface.color ]
        ]
        g_model : Model [ vk: vk, w: ux, id: g_gltf, s: gsky,
                          samplers: g_samplers,
            straight_alpha: true, cull_none: true ]
        # backdrop FIRST, then ground, sea, and the air over both
        models  = vec Model [] [ g_model, o_model, w_model, s_model ]
        log 'TERRA build_models: done, {models.count} model(s)'

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      (ux.frost_eff[] == 2) ? 2.0 : 1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.owner  = a
        ux.element_targets[ id ] = target

    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    func load_bg [ arg: object :: t: TerraMars ]
        t.build_models[]
        t.ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : vec Au []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: lambda load_bg[ a ],
                                work: w9 ]
        if [ !ready ] return
        # the done job held this element: let it go
        if [ load_task ] load_task = null
        create_target[]
        orbit[]

    func orbit[]
        aspect : f32 [
            (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ]
            : 1.7778 ]
        # ORBIT DISTANCE from the centre, not eye height. this was left
        # over from the ground-stage version and put the camera 0.0035
        # from the origin -- inside the planet, looking at its core,
        # with the whole surface backface-culled around it
        # ALTITUDE above the datum, not orbit distance: this is a craft
        # over the deck. 0.004 is 13km, 0.05 is 170km
        # the two lowest rungs are gone. 13km and 51km sat so far under
        # the deck that Valles ran off both edges; this starts where the
        # old ladder ENDED and climbs. 0.130 is the rung that holds the
        # whole 3280km trunk inside the horizon at once
        e_t : f32 [ (vantage == OrbitView.low)  ? 0.050 :
                    (vantage == OrbitView.high) ? 0.130 :
                    (vantage == OrbitView.far)  ? 0.340 : 0.800 ]
        if [ e_cur == 0.0 ] e_cur = e_t
        e_cur = filter_n[ e_cur, e_t, 0.06, ux.frame_factor ]

        # the spin has to come FIRST now: the craft's latitude is a
        # function of how far along the canyon it has flown
        # 184.39 sat at u=0.275 -- already 400km INSIDE the trunk, which
        # measures 0.2557..0.4099. 173 starts at u=0.245, just short of
        # the western end, so the canyon opens ahead instead of being
        # half behind us. the drift below stays anchored to 184.39, so
        # starting earlier simply begins it further north, on the axis
        spin_d : f32 [ 173.0 + ux.time * 900.0 ]

        # the craft rides over Valles Marineris' own latitude while the
        # planet turns under it -- that IS the flight, no path needed
        # MEASURED off mars-pk by weighted fit of the trunk's own axis:
        #   lat = -0.03489 * lon - 12.388
        # so Ius-Melas-Coprates runs 2.03 degrees SOUTH OF DUE EAST. a
        # constant latitude is a parallel, and a parallel cannot stay
        # in a canyon that trends -- it enters at one rim and leaves by
        # the other, which is the angle you were looking at. drifting
        # the craft south as it runs east puts the track ON the axis.
        # the 25.2 tilt means model latitude is not world latitude, so
        # the drift is stated in world terms: -0.0387 per degree of spin
        vlat : f32 [ radians[ -10.718 - 0.0387 * (spin_d - 184.39) ] ]
        cx : f32 [ 0.0 ]
        cy : f32 [ sin[ vlat ] ]
        cz : f32 [ cos[ vlat ] ]
        e_r : f32 [ 1.0 + e_cur ]
        _eye : vec3f [ cx * e_r, cy * e_r, cz * e_r ]

        # the ground flows past in the direction Y cross up, because the
        # model spins about Y. look that way, not at the planet centre
        # -- aiming at the centre is nadir by definition, which is the
        # straight-down view you were getting
        # Y x c is the direction the GROUND flows. the craft travels the
        # other way, so forward is the negative of it -- aiming along
        # the flow puts you on the stern watching the wake
        # the planet's spin axis in WORLD space is TILTED: mm applies
        # the 25.2 about Z and then spins about Y, so the axis the
        # ground actually turns on is Rz(25.2) * Y, not Y. taking Y
        # aimed the camera 25.6 degrees off the true travel direction,
        # which is what every "look further right" was chasing
        axr : f32 [ radians[ 25.2 ] ]
        wx : f32 [ 0.0 - sin[ axr ] ]
        wy : f32 [ cos[ axr ] ]
        wz : f32 [ 0.0 ]
        # ground flow is w x c; the craft travels the other way
        gx : f32 [ 0.0 - (wy * cz - wz * cy) ]
        gy : f32 [ 0.0 - (wz * cx - wx * cz) ]
        gz : f32 [ 0.0 - (wx * cy - wy * cx) ]
        gl : f32 [ sqrt[ gx * gx + gy * gy + gz * gz ] ]
        if [ gl > 0.0 ]
            gx = gx / gl
            gy = gy / gl
            gz = gz / gl

        # yaw 15 degrees to starboard, about the SCREEN up (-c, the same
        # inversion look_at gets), so right here means right on screen.
        # g is horizontal and c is radial, so their cross is already
        # unit
        # ZERO. g is the true travel direction now, so any yaw at all is
        # aim pointed away from where the craft is going
        yaw : f32 [ radians[ 0.0 ] ]
        yc : f32 [ cos[ yaw ] ]
        ys : f32 [ sin[ yaw ] ]
        # sign flipped: look_at is given -c as its up, which inverts the
        # screen, so cross(g, -c) came out as screen LEFT. every degree
        # of "right" yaw was pushing the canyon further right instead
        rx : f32 [ gy * cz - gz * cy ]
        ry : f32 [ gz * cx - gx * cz ]
        rz : f32 [ gx * cy - gy * cx ]
        gx2 : f32 [ gx * yc + rx * ys ]
        gy2 : f32 [ gy * yc + ry * ys ]
        gz2 : f32 [ gz * yc + rz * ys ]
        gx = gx2
        gy = gy2
        gz = gz2

        # the horizon sits BELOW local horizontal by the dip angle, and
        # from this low that is only a few degrees. six degrees past it
        # drops the limb into the upper third, like the reference
        dip : f32 [ acos[ 1.0 / e_r ] ]
        pit : f32 [ dip + radians[ 6.0 ] ]
        pc : f32 [ cos[ pit ] ]
        ps : f32 [ sin[ pit ] ]
        dx : f32 [ gx * pc - cx * ps ]
        dy : f32 [ gy * pc - cy * ps ]
        dz : f32 [ gz * pc - cz * ps ]
        _tgt : vec3f [ _eye.x + dx, _eye.y + dy, _eye.z + dz ]
        # THE up, not its negative. mat4f.perspective is GL handed
        # (m[1][1] is +ifov) and the viewport height is positive, so
        # vulkan renders it upside down; negating up rolled the camera
        # 180 to cancel that, which negates RIGHT as well and leaves the
        # whole image horizontally MIRRORED. that is why every yaw
        # correction went the wrong way. flip the projection's y
        # instead and keep the true up
        _up : vec3f [ cx, cy, cz ]
        # near must be tight: at 13km altitude a 0.002 near plane clips
        # the ground out from under the craft
        _proj : mat4f.perspective[ radians[ 55.0 ], aspect, 0.00005,
                                   24.0 ]
        _proj.m[5] = 0.0 - _proj.m[5]
        _view : mat4f.look_at[ _eye, _tgt, _up ]

        # 160 degrees puts Valles Marineris (290E) square in front at
        # t=0; the tilt is about Z, which leaves that facing alone.
        # ux.time counts kiloseconds, so 900 drifts east slowly enough
        # to read the canyon rather than smear past it
        q_spin : quatf [ vec4f [ 0.0, 1.0, 0.0, radians[ spin_d ] ] ]
        q_axis : quatf [ vec4f [ 0.0, 0.0, 1.0, radians[ 25.2 ] ] ]
        mm : mat4f.identity[]
        mm = mm.rotate[ q_axis ]
        mm = mm.rotate[ q_spin ]

        olymp.model = mm
        olymp.view  = _view
        olymp.proj  = _proj
        # must match what mars_bake packed, or the terrain reads at the
        # wrong height and the shading disagrees with the silhouette
        olymp.hmax     = mars_hmax[] * mars_relief[]
        olymp.smax     = mars_smax[] * mars_relief[]
        olymp.haze     = mars_haze[]
        olymp.dtile    = mars_dtile[]
        olymp.damp     = mars_damp[]
        olymp.dh       = mars_dh[]
        olymp.sea_l0   = mars_sea_l0[]
        olymp.sea_bias = mars_sea_bias[]
        # the carpet is laid out around the craft, so the shader needs
        # the eye in MODEL space -- the planet turns, the craft does not
        mi : mat4f [ mm.inverse[] ]
        # by hand, NOT mi.mul_v4: a C function returning a 16-byte
        # all-float struct comes back in two registers, and the call
        # reads one float from each -- x and z arrive, y and w never
        # get written. see the note in orbit's header
        emx : f32 [
            mi.m[0] * _eye.x + mi.m[4] * _eye.y + mi.m[8]  * _eye.z
            + mi.m[12] ]
        emy : f32 [
            mi.m[1] * _eye.x + mi.m[5] * _eye.y + mi.m[9]  * _eye.z
            + mi.m[13] ]
        emz : f32 [
            mi.m[2] * _eye.x + mi.m[6] * _eye.y + mi.m[10] * _eye.z
            + mi.m[14] ]
        em : vec4f [ emx, emy, emz, 1.0 ]
        olymp.eye_m = em
        # the arc from under the craft to the horizon: everything
        # visible lies inside it, which is why the cap is enough
        olymp.hdist = acos[ 1.0 / e_r ]
        olymp.cam_pos  = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        # the sun sits low, dead ahead, and stays there as the craft
        # flies: that is what backlights the dust and rakes every wall
        # 4 degrees put almost every facet in its own shadow -- the
        # relief was there and unreadable. 15 still rakes hard enough
        # to throw the canyon walls but actually lights the ground
        sel : f32 [ radians[ 15.0 ] ]
        sc : f32 [ cos[ sel ] ]
        ss : f32 [ sin[ sel ] ]
        olymp.sun_dir = vec4f [ gx * sc + cx * ss, gy * sc + cy * ss,
                                gz * sc + cz * ss, 0.0 ]

        # the sea shell shares the craft frame exactly, or its waterline
        # would sit on different ground than the terrain it cuts. set
        # LAST: it copies eye_m, hdist and sun_dir, all worked out above
        owater.model    = mm
        owater.view     = _view
        owater.proj     = _proj
        owater.hmax     = olymp.hmax
        owater.haze     = olymp.haze
        owater.cam_pos  = olymp.cam_pos
        owater.sun_dir  = olymp.sun_dir
        owater.eye_m    = olymp.eye_m
        owater.hdist    = olymp.hdist
        owater.sea_l0   = mars_sea_l0[]
        owater.sea_bias = mars_sea_bias[]

        osky.model    = mm
        osky.view     = _view
        osky.proj     = _proj
        osky.cam_pos  = olymp.cam_pos
        osky.sun_dir  = olymp.sun_dir
        osky.eye_m    = olymp.eye_m
        osky.hdist    = olymp.hdist
        osky.atm_h    = mars_atm_h[]
        osky.atm_fall = mars_atm_fall[]
        osky.atm_gain = mars_atm_gain[]
        osky.cld_lo   = mars_cld_lo[]
        osky.cld_hi   = mars_cld_hi[]
        osky.cld_cov  = mars_cld_cov[]
        osky.cld_wind = mars_cld_wind[]
        # ux.time counts kiloseconds, so this drifts the deck slowly
        osky.cld_time = ux.time * 3.0

        # the galaxy wraps the scene from a big inner sphere, tilted so
        # the band cuts the sky diagonally. scale 12, NOT the 30 the
        # saturn scenes use: this camera's far plane is 24, and a shell
        # past it is clipped away entirely
        gskq : quatf [ vec4f [ 1.0, 0.0, 0.0, radians[ 45.0 ] ] ]
        gskm : mat4f.identity[]
        gskm = gskm.rotate[ gskq ]
        gskm = gskm.scale[ vec3f [ 12.0, 12.0, 12.0 ] ]
        gsky.model = gskm
        gsky.view  = _view
        gsky.proj  = _proj
        gsky.gain  = 0.45
        gsky.time  = ux.time * 60000.0
        dbg_n += 1
        if [ dbg_n < 3 ]
            log 'TERRA mode={i32[ vantage ]} e_cur={e_cur} hmax={olymp.hmax} smax={olymp.smax}'
            log 'TERRA eye={_eye.x},{_eye.y},{_eye.z} eye_m={em.x},{em.y},{em.z},{em.w} hdist={olymp.hdist} e_r={e_r}'
# MARS, THE PLANET AS IT IS. same carpet mesh and same MOLA maps as
# Terra, but nothing is terraformed: no sea, no planting, no rivers,
# no snow and no cloud deck. only the map's own iron colour, the rock
# material over it, and the dust atmosphere above
enum MarsSurface
    height  : 0
    nrm     : 1
    detail  : 2
    edge    : 3
    color   : 4

ModelViewProject MarsShader
    # unpack scale for the baked height, and the slope range the baked
    # normal encodes. both must match what mars_bake wrote
    mutable hmax     : f32
    mutable smax     : f32
    mutable sun_dir  : vec4f
    mutable cam_pos  : vec4f
    mutable haze     : f32
    # how many times the rock material repeats across the equator, and
    # how far it tilts the normal
    mutable dtile    : f32
    mutable damp     : f32
    # the craft in MODEL space, and the horizon arc in radians: the
    # carpet mesh is laid out relative to both
    mutable eye_m    : vec4f
    mutable hdist    : f32
    # how far the rock material displaces the mesh, in sphere radii
    mutable dh       : f32

    attrib height  : LayoutBinding [ type:typeid[ MarsSurface ],
                                     id:MarsSurface.height, count:1,
                                     format: typeid[ rgba8 ] ]
    attrib nrm     : LayoutBinding [ type:typeid[ MarsSurface ],
                                     id:MarsSurface.nrm,    count:1,
                                     format: typeid[ rgba8 ] ]
    attrib detail  : LayoutBinding [ type:typeid[ MarsSurface ],
                                     id:MarsSurface.detail, count:1,
                                     format: typeid[ rgba8 ] ]
    attrib edge    : LayoutBinding [ type:typeid[ MarsSurface ],
                                     id:MarsSurface.edge,   count:1,
                                     format: typeid[ rgba8 ] ]
    attrib color   : LayoutBinding [ type:typeid[ MarsSurface ],
                                     id:MarsSurface.color,  count:1,
                                     format: typeid[ rgba8 ] ]

    attrib a_pos        : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal     : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv         : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_normal     : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_uv         : VertexOutput  [ type:typeid[ vec2f ] ]
    attrib v_sp         : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_world_pos  : VertexOutput  [ type:typeid[ vec4f ] ]
    attrib v_h          : VertexOutput  [ type:typeid[ f32   ] ]

    attrib fragColor    : FragmentOutput[ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    # the bake, unpacked. 16 bits across R and A, scaled by hmax.
    # the hardware interpolates those two bytes INDEPENDENTLY, so
    # everywhere the low byte wraps 255->0 it ramps backwards across a
    # whole texel and the ground ripples like water. decode four
    # texels FIRST, then interpolate
    func m_ground [ uv: vec2f ] -> GLSL float {
        vec2  ts = vec2(8192.0, 4096.0);
        vec2  pp = uv * ts - 0.5;
        vec2  fr = fract(pp);
        vec2  b0 = (floor(pp) + 0.5) / ts;
        vec2  e1 = 1.0 / ts;
        vec4  q00 = textureLod(height, b0, 0.0);
        vec4  q10 = textureLod(height, b0 + vec2(e1.x, 0.0), 0.0);
        vec4  q01 = textureLod(height, b0 + vec2(0.0, e1.y), 0.0);
        vec4  q11 = textureLod(height, b0 + e1, 0.0);
        float h00 = q00.r * 65280.0 + q00.a * 255.0;
        float h10 = q10.r * 65280.0 + q10.a * 255.0;
        float h01 = q01.r * 65280.0 + q01.a * 255.0;
        float h11 = q11.r * 65280.0 + q11.a * 255.0;
        float hh  = mix(mix(h00, h10, fr.x), mix(h01, h11, fr.x), fr.y);
        return hh / 65535.0 * ubo.hmax;
    }

    func vertex [] -> GLSL none {
        // the mesh arrives as a FLAT polar grid centred on the craft,
        // its radius a fraction of the horizon arc. wrap it onto the
        // sphere here, so altitude rescales it and nothing rebuilds
        float rn = length(a_pos.xz);
        vec2  pd = rn > 0.0 ? a_pos.xz / rn : vec2(1.0, 0.0);
        vec3  up_m = normalize(ubo.eye_m.xyz);
        vec3  ax9  = abs(up_m.y) > 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3  t_e  = normalize(cross(ax9, up_m));
        vec3  t_n  = cross(up_m, t_e);
        float s9   = rn * ubo.hdist;
        vec3  dir  = normalize(up_m * cos(s9) + (t_e * pd.x + t_n * pd.y) * sin(s9));

        // longitude measured FROM the craft, never absolute: that is
        // what keeps the +/-pi meridian from splitting a triangle
        float lon0 = atan(ubo.eye_m.z, ubo.eye_m.x);
        float dl   = atan(dir.z, dir.x) - lon0;
        if (dl >  3.14159265) dl -= 6.28318531;
        if (dl < -3.14159265) dl += 6.28318531;
        vec2 uv = vec2(0.5 + (lon0 + dl) / 6.28318531,
                       0.5 - asin(clamp(dir.y, -1.0, 1.0)) / 3.14159265);

        v_uv     = uv;
        v_sp     = dir;
        mat3 nm  = transpose(inverse(mat3(ubo.model)));
        v_normal = normalize(nm * dir);
        float g  = m_ground(uv);
        v_h      = g;

        // patch geometry WHERE THE EDGES ARE. the integral image says
        // how much structure the colour map holds around this point;
        // busy ground earns high frequency, dead flat plains stay flat
        vec4  ee = textureLod(edge, uv, 0.0);
        float aug = clamp(ee.r * 0.55 + ee.g * 0.30 + ee.b * 0.15, 0.0, 1.0);
        vec2  vsl  = (textureLod(nrm, uv, 0.0).rg * 2.0 - 1.0) * ubo.smax;
        float vrug = clamp(length(vsl) / 0.12, 0.0, 1.0);
        float vclat = sqrt(max(1.0 - dir.y * dir.y, 0.0025));
        vec2  duv   = vec2(uv.x * vclat * 2.0, uv.y);
        float dsum = 0.0;
        float dw   = 0.0;
        float dfq  = ubo.dtile / 256.0;
        float dwt  = 1.0;
        for (int i = 0; i < 3; i++) {{
            float an = 0.61 * float(i);
            float ca = cos(an);
            float sa = sin(an);
            vec2  ru = mat2(ca, sa, -sa, ca) * duv * dfq + vec2(0.37, 0.71) * float(i);
            dsum += (textureLod(detail, ru, 0.0).b * 2.0 - 1.0) * dwt;
            dw   += dwt;
            dfq  *= 3.0;
            dwt  *= 0.78;
        }}
        vec3 disp = dir * (1.0 + g + dsum / dw * ubo.dh
                                   * (0.10 + 1.90 * vrug) * (0.55 + 0.45 * aug));
        vec4 wpos = ubo.model * vec4(disp, 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment [] -> GLSL none {
        vec3 sp = normalize(v_sp);
        // the mesh normal is the ball's and would light this flat. the
        // bake carries the real surface slope at 8192 across, far finer
        // than any mesh we can afford to displace
        vec3 ax = abs(sp.y) > 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3 ea = normalize(cross(ax, sp));
        vec3 no = normalize(cross(sp, ea));
        vec2 sl = (texture(nrm, v_uv).rg * 2.0 - 1.0) * ubo.smax;
        vec3 n = normalize(sp - ea * sl.x - no * sl.y);

        // MOLA is 2600m a texel, so from 13km up the ground is pure
        // bilinear mush. the rock material fills the whole span below
        // that -- SIX octaves from 1300m a texel down to 5m.
        // SHADING ONLY: the silhouette stays MOLA's
        float dist = length(v_world_pos.xyz - ubo.cam_pos.xyz);
        float clat = sqrt(max(1.0 - sp.y * sp.y, 0.0025));
        vec2  duv  = vec2(v_uv.x * clat * 2.0, v_uv.y);
        vec2  dxy  = vec2(0.0);
        float cav  = 0.0;
        float rgh  = 0.0;
        float wsum = 0.0;
        float fq = ubo.dtile / 256.0;
        float wt = 1.0;
        for (int i = 0; i < 6; i++) {{
            // each octave on its own angle and origin, or the ladder
            // stacks into one self-similar pattern instead of terrain
            float an = 0.61 * float(i);
            float ca = cos(an);
            float sa = sin(an);
            vec2  ru = mat2(ca, sa, -sa, ca) * duv * fq + vec2(0.37, 0.71) * float(i);
            vec4  dv = texture(detail, ru);
            dxy  += (dv.rg * 2.0 - 1.0) * wt;
            // B is the material's height: below its own mean is a
            // crevice, above it is a crest catching the light
            cav  += (dv.b * 2.0 - 1.0) * wt;
            rgh  += dv.a * wt;
            wsum += wt;
            fq *= 3.0;
            wt *= 0.78;
        }}
        dxy /= wsum;
        cav /= wsum;
        rgh /= wsum;
        vec4  ee9 = texture(edge, v_uv);
        float aug = clamp(ee9.r * 0.55 + ee9.g * 0.30 + ee9.b * 0.15, 0.0, 1.0);
        // NORMALISED slope: sl already carries smax, and smax carries
        // the relief look-control, so divide it back out
        float slope0 = length(sl) / max(ubo.smax, 1e-6);
        float rug = clamp(slope0 / 0.08, 0.0, 1.0);
        n = normalize(n + (ea * dxy.x + no * dxy.y)
                        * ubo.damp * (0.10 + 1.90 * rug)
                        * (0.55 + 0.45 * aug));

        mat3 nmm = transpose(inverse(mat3(ubo.model)));
        vec3 nw = normalize(nmm * n);

        vec3 sun = normalize(ubo.sun_dir.xyz);
        float ndl = max(dot(nw, sun), 0.0);
        // BARE MARS. the colour map is the albedo; the rock material
        // only shades it -- crests catch the light, crevices hold dark.
        // RUST, not soil: 0.64/0.43/0.28 was a tan with as much green
        // in it as an earth desert, and that is what read as brown
        vec3  c_rock = vec3(0.30, 0.13, 0.085);
        vec3  c_dust = vec3(0.74, 0.34, 0.21);
        float crest = clamp(cav * 0.5 + 0.5, 0.0, 1.0);
        float flat9 = 1.0 - clamp(slope0 / 0.20, 0.0, 1.0);
        vec3  marsc = texture(color, v_uv).rgb;
        vec3  base  = marsc;
        base = mix(base, mix(c_rock, c_dust, flat9 * (0.35 + 0.65 * crest)), 0.45);
        base *= 0.78 + 0.44 * crest;
        // the map itself is a brown plate, and it carries over half the
        // result -- so tilt the whole thing to iron rather than leaving
        // the map to drag the new rock colours back toward soil
        base *= vec3(1.10, 0.87, 0.79);
        // and hold the colour: bleeding to grey by roughness was taking
        // the red back out exactly where the material is strongest
        base = mix(base, vec3(dot(base, vec3(0.35, 0.48, 0.17))), rgh * 0.12);

        // a grazing sun throws long shadow: the terminator on a slope is
        // hard, so keep the ambient low or the shadows turn to grey mud
        vec3 lit = base * (0.16 + ndl * 1.25);

        // ATMOSPHERE. mars air is loaded with suspended iron dust and
        // it forward-scatters hard, but it reddens rather than gilds:
        // salmon close in, dusty rose across the middle, and a cooler
        // red at range. one three-stop ramp on distance
        vec3 vd = normalize(v_world_pos.xyz - ubo.cam_pos.xyz);
        float fw = max(dot(vd, sun), 0.0);
        float fs = pow(fw, 6.0);
        float fd = clamp(dist / 0.55, 0.0, 1.0);
        vec3 dust = mix(vec3(1.26, 0.74, 0.60), vec3(1.02, 0.56, 0.48),
                        smoothstep(0.0, 0.40, fd));
        dust = mix(dust, vec3(0.88, 0.58, 0.56), smoothstep(0.35, 1.0, fd));
        dust *= 1.0 + 0.85 * fs;
        // HAZE POOLS IN THE BASINS: the column of air over a canyon
        // floor is far deeper than over a plateau, and dust settles
        // into it. elevation is the datum here, there being no sea
        float tg9  = v_h / max(ubo.hmax, 1e-6);
        float fogl = 1.0 - smoothstep(0.02, 0.40, tg9);
        float hz = 1.0 - exp(-dist * ubo.haze * (1.0 + fs * 4.0)
                                  * (0.55 + 1.60 * fogl));
        vec3 outc = mix(lit, dust, clamp(hz, 0.0, 1.0));

        // THE DUST POOL. suspended dust settles into the deepest ground
        // and sits there, so a canyon floor is full of it whatever the
        // range. the haze above is a DISTANCE term and clears to
        // nothing up close, which left the valley bare from overhead --
        // this is elevation only. the packed height reads 0.154 on the
        // Valles floor against 0.384 on the plateau, so a band of
        // 0.10..0.26 fills the trunk and the northern basins and stops
        // at the rim. same dust colour as the air, because it IS the air
        float pool = 1.0 - smoothstep(0.10, 0.26, tg9);
        outc = mix(outc, dust, pool * (0.30 + 0.45 * fd));

        // LIMB. terrain stays OPAQUE to its edge and simply DARKENS by
        // mu; the sky shell above flares up through the same band, and
        // that crossfade is the softness
        vec3  vdir = normalize(ubo.cam_pos.xyz - v_world_pos.xyz);
        vec3  nsp  = normalize(nmm * sp);
        float mu   = clamp(dot(nsp, vdir), 0.0, 1.0);
        outc *= 0.30 + 0.70 * smoothstep(0.0, 0.12, mu);

        fragColor = vec4(outc, 1.0);
    }


# THE SKY SHELL, dust only. the rim glow on the ground can only light
# fragments that HAVE ground, so it stops dead at the silhouette. this
# is the same carpet mesh a second time, lifted to a shell above the
# surface, so there is geometry ABOVE the limb to carry the fade into
# space. no cloud march here -- mars keeps its air and nothing else
ModelViewProject MarsSkyShader
    mutable sun_dir  : vec4f
    mutable cam_pos  : vec4f
    mutable eye_m    : vec4f
    mutable hdist    : f32
    mutable atm_h    : f32
    mutable atm_fall : f32
    mutable atm_gain : f32

    attrib a_pos        : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_normal     : VertexInput   [ type:typeid[ vec3f ] ]
    attrib a_uv         : VertexInput   [ type:typeid[ vec2f ] ]

    attrib v_normal     : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_uv         : VertexOutput  [ type:typeid[ vec2f ] ]
    attrib v_sp         : VertexOutput  [ type:typeid[ vec3f ] ]
    attrib v_world_pos  : VertexOutput  [ type:typeid[ vec4f ] ]

    attrib fragColor    : FragmentOutput[ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    func vertex [] -> GLSL none {
        float rn = length(a_pos.xz);
        vec2  pd = rn > 0.0 ? a_pos.xz / rn : vec2(1.0, 0.0);
        vec3  up_m = normalize(ubo.eye_m.xyz);
        vec3  ax9  = abs(up_m.y) > 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
        vec3  t_e  = normalize(cross(ax9, up_m));
        vec3  t_n  = cross(up_m, t_e);
        // THE WHOLE SPHERE, not a cap. the carpet is a polar grid, so
        // mapping its radius across a half-turn wraps it into a closed
        // shell with NO mesh boundary anywhere
        float s9   = (rn / 1.35) * 3.14159265;
        vec3  dir  = normalize(up_m * cos(s9) + (t_e * pd.x + t_n * pd.y) * sin(s9));
        v_uv     = a_uv;
        v_sp     = dir;
        v_normal = dir;
        vec4 wpos = ubo.model * vec4(dir * (1.0 + ubo.atm_h), 1.0);
        v_world_pos = wpos;
        gl_Position = ubo.proj * ubo.view * wpos;
    }

    func fragment [] -> GLSL none {
        // THE ENCELADUS METHOD. the model transform is a pure rotation,
        // so the planet centre is the world origin and the ray's
        // closest approach is one dot product. everything comes from
        // that radius: a ray grazing the surface crosses the whole dust
        // column, one passing high above barely clips it
        vec3  ro = ubo.cam_pos.xyz;
        vec3  rd = normalize(v_world_pos.xyz - ro);
        float tca = 0.0 - dot(ro, rd);
        float glow = 0.0;
        float hw = 0.0;
        float rch = 0.0;
        vec3  sunw = normalize(ubo.sun_dir.xyz);
        if (tca > 0.0) {{
            vec3  pca = ro + rd * tca;
            float rc  = length(pca);
            // in SCALE HEIGHTS, not a fixed radius: the colour ramp has
            // to travel with the alpha or extending the air just parks
            // a solid purple band out where it used to fade
            rch = clamp((rc - 1.0) / (ubo.atm_fall * 2.13), 0.0, 1.0);
            // outward, a long slow fade into space. the smoothstep is a
            // SMOOTH occlusion ramp -- a binary cut stamps the analytic
            // sphere's silhouette as a hard circle offset from the real
            // displaced terrain edge
            float od = exp(-max(rc - 1.0, 0.0) / ubo.atm_fall)
                     * smoothstep(0.976, 0.997, rc);
            float dip  = clamp((1.0 - rc) / 0.018, 0.0, 1.0);
            float hocc = mix(1.0, 0.35, dip);
            hw = clamp(dot(pca / max(rc, 1e-4), sunw) * 0.5 + 0.5, 0.0, 1.0);
            // the blaze where the graze kisses the surface: this is
            // what DISSOLVES the terrain edge, so no ridge or crater
            // prints its shape through the rim
            float nearg = exp(-(max(rc - 1.0, 0.0) / 0.012
                              + max(1.0 - rc, 0.0) / 0.0035));
            glow = od * hocc * (0.16 + 0.52 * hw) * (1.0 + 5.0 * nearg);
            // THIN THE FLOOR, or the band sits thick on the horizon
            glow *= 0.30 + 0.70 * smoothstep(0.0, 0.34, rch);
        }}
        float fw = max(dot(rd, sunw), 0.0);
        // PINK-RED, not Terra's gold. suspended iron dust reddens the
        // whole column: salmon on the horizon itself, dusty rose above
        // it, and a red-violet as the last of it dies into space
        vec3 col = mix(vec3(1.34, 0.66, 0.52), vec3(1.10, 0.54, 0.50),
                       smoothstep(0.0, 0.40, rch));
        col = mix(col, vec3(0.52, 0.20, 0.34), smoothstep(0.44, 1.0, rch));
        col *= 1.0 + 0.80 * pow(fw, 4.0);
        float atma = clamp(glow * ubo.atm_gain, 0.0, 0.58);
        // PREMULTIPLIED: the model is set straight_alpha:false, so the
        // pipeline blends with SRC=ONE
        fragColor = vec4(col * atma, atma);
    }


Backdrop Mars
    frost : true
    public func bg_color [ ] -> rgba
        return color
    frost_sharp : true
    intern surf   : MarsShader
    intern msky   : MarsSkyShader
    intern gsky   : GaiaShader
    intern models : vec Model
    intern target : Render
    intern built  : bool
    intern ready     : bool
    intern loading   : bool
    intern load_task : async
    intern e_cur  : f32
    public color  : rgba [ r:0.010, g:0.005, b:0.006, a:1.0 ]

    func build_models[]
        built = true
        o_gltf : build_carpet[]
        o_gltf.hold[]
        o_gltf.compute_worlds[]
        surf = MarsShader [ vk: vk ]
        pkp : path '../{share_name}/baked/mars-pk.png'
        nkp : path '../{share_name}/baked/mars-nk.png'
        dnp : path '../{share_name}/baked/mars-dn.png'
        ekp : path '../{share_name}/baked/mars-ek.png'
        if [ !pkp.exists[] || !nkp.exists[] ]
            log 'mars: no baked maps — baking live (SILVER_EXPORT=1 bakes at build)'
            mars_bake_mola[]
        if [ !dnp.exists[] ]
            log 'mars: no rock detail — baking live'
            mars_bake_detail[]
        if [ !ekp.exists[] ]
            log 'mars: no edge map — baking live'
            mars_bake_edge[]
        # data maps MUST be linear or the sampler re-linearizes them and
        # the whole surface drops below its real height
        o_samplers : map Image [string] [
            'height': Image [ uri: pkp, surface: MarsSurface.height,
                              linear: true, wrap_u: true ],
            'nrm':    Image [ uri: nkp, surface: MarsSurface.nrm,
                              linear: true, wrap_u: true ],
            'detail': Image [ uri: dnp, surface: MarsSurface.detail,
                              linear: true, wrap_u: true,
                              wrap_v: true ],
            'edge':   Image [ uri: ekp, surface: MarsSurface.edge,
                              linear: true, wrap_u: true ],
            'color':  Image [ uri: path '../{share_name}/textures/mars-color-8192x4096.jpg', surface: MarsSurface.color, linear: true, wrap_u: true ]
        ]
        # the projection y-flip reverses triangle winding, so back-face
        # culling would cull the whole carpet
        o_model : Model [ vk: vk, w: ux, id: o_gltf, s: surf,
                          samplers: o_samplers,
            straight_alpha: true, cull_none: true ]
        # the air shell needs no maps at all -- it works entirely from
        # the ray's geometry. drawn LAST so it lays over the surface
        msky = MarsSkyShader [ vk: vk ]
        s_model : Model [ vk: vk, w: ux, id: o_gltf, s: msky,
            straight_alpha: false, cull_none: true,
            depth_no_test: true ]
        # the galaxy behind everything, same plate the saturn scenes use
        gsky = GaiaShader [ vk: vk ]
        g_gltf : build_globe[]
        g_samplers : map Image [string] [
            'color': Image [ uri: path '{scenes_share[]}/textures/gaia.png', surface: GaiaSurface.color ]
        ]
        g_model : Model [ vk: vk, w: ux, id: g_gltf, s: gsky,
                          samplers: g_samplers,
            straight_alpha: true, cull_none: true ]
        # backdrop FIRST, then ground, and the air over it
        models  = vec Model [] [ g_model, o_model, s_model ]

    func create_target[]
        if [ target || !models || models.count == 0 ] return
        target = Render [
            vk:          vk,
            w:           ux,
            wscale:      (ux.frost_eff[] == 2) ? 2.0 : 1.0,
            use_depth:   true,
            clear_color: vec4f [ color.r, color.g, color.b, 1.0 ],
            models:      models ]
        target.owner  = a
        ux.element_targets[ id ] = target

    # unregister only; we keep our ref so the GPU graph outlives the
    # frame
    public func on_unload [ ]
        if [ ux && ux.element_targets ] ux.element_targets.rm[ id ]

    # iron oxide: the editor's purples go rust under a martian sky
    public func theme [ ] -> map string [string]
        return map string [string] [
            '#140a2acc':  '#4108',   # editor pane background
            '#140a2a80':  '#429a',   # console pane background
            '#14121c80':  '#44229980',   # instance panel background
            # unused (line_color moved to #44225588)
            '#4258':      '#8a5a4a58',
            '#ff6a2e55':  '#ff8a4a55',   # search highlight fill
            '#220022aa':  '#2a1a16aa',   # run console base fill
            '#22002280':  '#2a1a1680',   # commit tab fill, half alpha
            '#614':       '#54281a',     # TButtons / nav rest fill
            '#413':       '#3c1c10',     # TButtons hover fill
            '#826':       '#7c3c22',     # TButtons lit / nav selected
            '#625a':      '#408a',       # bottom status bar fill
            '#8af2':      '#fa62',       # status bar inner glow
            '#425':       '#52281e',     # editor selection color
            '#ede3':      '#fa83',       # editor selection border
            '#44225588':  '#5a3a2e33',   # editor line highlight
            '#ff3a6a22':  '#ff8a4a22',   # commit tab fill
            '#ff3a6a44':  '#ff8a4a44',   # commit tab hover fill
            '#3a1c8a40':  '#8a4a2940',   # selected title tint
            '#1d0f3f':    '#401b0d',       # title bar, dock ground (flat)
            '#ff5a8a80':  '#e0784280',   # commit tab border
            '#ff7aa480':  '#ffa06880'    # commit tab hover border
        ]

    func load_bg [ arg: object :: t: Mars ]
        t.build_models[]
        t.ready = true

    func draw [ w: Window ]
        animated = true
        if [ !built && !loading ]
            loading = true
            w9 : vec Au []
            w9.push[ a ]
            load_task = async [ target: a, work_fn: lambda load_bg[ a ],
                                work: w9 ]
        if [ !ready ] return
        # the done job held this element: let it go
        if [ load_task ] load_task = null
        create_target[]
        orbit[]

    func orbit[]
        aspect : f32 [
            (ux.height > 0) ? f32[ ux.width ] / f32[ ux.height ]
            : 1.7778 ]
        # ALTITUDE above the datum, not orbit distance: this is a craft
        # over the deck. 0.050 is 170km, 0.130 holds the whole Valles
        # trunk inside the horizon at once
        e_t : f32 [ (vantage == OrbitView.low)  ? 0.050 :
                    (vantage == OrbitView.high) ? 0.130 :
                    (vantage == OrbitView.far)  ? 0.340 : 0.800 ]
        if [ e_cur == 0.0 ] e_cur = e_t
        e_cur = filter_n[ e_cur, e_t, 0.06, ux.frame_factor ]

        # the spin comes FIRST: the craft's latitude is a function of
        # how far along the canyon it has flown
        spin_d : f32 [ 173.0 + ux.time * 900.0 ]

        # the craft rides over Valles Marineris' own latitude while the
        # planet turns under it -- that IS the flight, no path needed.
        # MEASURED off mars-pk: lat = -0.03489 * lon - 12.388, and the
        # 25.2 tilt means model latitude is not world latitude, so the
        # drift is stated in world terms: -0.0387 per degree of spin
        vlat : f32 [ radians[ -10.718 - 0.0387 * (spin_d - 184.39) ] ]
        cx : f32 [ 0.0 ]
        cy : f32 [ sin[ vlat ] ]
        cz : f32 [ cos[ vlat ] ]
        e_r : f32 [ 1.0 + e_cur ]
        _eye : vec3f [ cx * e_r, cy * e_r, cz * e_r ]

        # the planet's spin axis in WORLD space is TILTED: mm applies
        # the 25.2 about Z and then spins about Y, so the axis the
        # ground actually turns on is Rz(25.2) * Y, not Y
        axr : f32 [ radians[ 25.2 ] ]
        wx : f32 [ 0.0 - sin[ axr ] ]
        wy : f32 [ cos[ axr ] ]
        wz : f32 [ 0.0 ]
        # ground flow is w x c; the craft travels the other way
        gx : f32 [ 0.0 - (wy * cz - wz * cy) ]
        gy : f32 [ 0.0 - (wz * cx - wx * cz) ]
        gz : f32 [ 0.0 - (wx * cy - wy * cx) ]
        gl : f32 [ sqrt[ gx * gx + gy * gy + gz * gz ] ]
        if [ gl > 0.0 ]
            gx = gx / gl
            gy = gy / gl
            gz = gz / gl

        # the horizon sits BELOW local horizontal by the dip angle, and
        # from this low that is only a few degrees. six degrees past it
        # drops the limb into the upper third
        dip : f32 [ acos[ 1.0 / e_r ] ]
        pit : f32 [ dip + radians[ 6.0 ] ]
        pc : f32 [ cos[ pit ] ]
        ps : f32 [ sin[ pit ] ]
        dx : f32 [ gx * pc - cx * ps ]
        dy : f32 [ gy * pc - cy * ps ]
        dz : f32 [ gz * pc - cz * ps ]
        _tgt : vec3f [ _eye.x + dx, _eye.y + dy, _eye.z + dz ]
        # THE up, not its negative: negating it mirrors the image
        # horizontally. flip the projection's y instead
        _up : vec3f [ cx, cy, cz ]
        # near must be tight: at 13km altitude a 0.002 near plane clips
        # the ground out from under the craft
        _proj : mat4f.perspective[ radians[ 55.0 ], aspect, 0.00005,
                                   24.0 ]
        _proj.m[5] = 0.0 - _proj.m[5]
        _view : mat4f.look_at[ _eye, _tgt, _up ]

        q_spin : quatf [ vec4f [ 0.0, 1.0, 0.0, radians[ spin_d ] ] ]
        q_axis : quatf [ vec4f [ 0.0, 0.0, 1.0, radians[ 25.2 ] ] ]
        mm : mat4f.identity[]
        mm = mm.rotate[ q_axis ]
        mm = mm.rotate[ q_spin ]

        surf.model = mm
        surf.view  = _view
        surf.proj  = _proj
        # must match what mars_bake packed, or the terrain reads at the
        # wrong height and the shading disagrees with the silhouette
        surf.hmax     = mars_hmax[] * mars_relief[]
        surf.smax     = mars_smax[] * mars_relief[]
        surf.haze     = mars_bare_haze[]
        surf.dtile    = mars_dtile[]
        surf.damp     = mars_damp[]
        surf.dh       = mars_dh[]
        # the carpet is laid out around the craft, so the shader needs
        # the eye in MODEL space -- the planet turns, the craft does not
        mi : mat4f [ mm.inverse[] ]
        # by hand, NOT mi.mul_v4: a C function returning a 16-byte
        # all-float struct comes back in two registers, and the call
        # reads one float from each -- x and z arrive, y and w never
        # get written
        emx : f32 [
            mi.m[0] * _eye.x + mi.m[4] * _eye.y + mi.m[8]  * _eye.z
            + mi.m[12] ]
        emy : f32 [
            mi.m[1] * _eye.x + mi.m[5] * _eye.y + mi.m[9]  * _eye.z
            + mi.m[13] ]
        emz : f32 [
            mi.m[2] * _eye.x + mi.m[6] * _eye.y + mi.m[10] * _eye.z
            + mi.m[14] ]
        em : vec4f [ emx, emy, emz, 1.0 ]
        surf.eye_m = em
        # the arc from under the craft to the horizon: everything
        # visible lies inside it, which is why the cap is enough
        surf.hdist = acos[ 1.0 / e_r ]
        surf.cam_pos  = vec4f [ _eye.x, _eye.y, _eye.z, 1.0 ]
        # the sun sits low, dead ahead, and stays there as the craft
        # flies: that is what backlights the dust and rakes every wall
        sel : f32 [ radians[ 15.0 ] ]
        sc : f32 [ cos[ sel ] ]
        ss : f32 [ sin[ sel ] ]
        surf.sun_dir = vec4f [ gx * sc + cx * ss, gy * sc + cy * ss,
                               gz * sc + cz * ss, 0.0 ]

        msky.model    = mm
        msky.view     = _view
        msky.proj     = _proj
        msky.cam_pos  = surf.cam_pos
        msky.sun_dir  = surf.sun_dir
        msky.eye_m    = surf.eye_m
        msky.hdist    = surf.hdist
        msky.atm_h    = mars_atm_h[]
        msky.atm_fall = mars_atm_fall[]
        msky.atm_gain = mars_atm_gain[]

        # the galaxy wraps the scene from a big inner sphere, tilted so
        # the band cuts the sky diagonally. scale 12, NOT the 30 the
        # saturn scenes use: this camera's far plane is 24, and a shell
        # past it is clipped away entirely
        gskq : quatf [ vec4f [ 1.0, 0.0, 0.0, radians[ 45.0 ] ] ]
        gskm : mat4f.identity[]
        gskm = gskm.rotate[ gskq ]
        gskm = gskm.scale[ vec3f [ 12.0, 12.0, 12.0 ] ]
        gsky.model = gskm
        gsky.view  = _view
        gsky.proj  = _proj
        gsky.gain  = 0.45
        gsky.time  = ux.time * 60000.0

# the pictures for orbiter's scene picker; last, after the bakes
export func mars_thumbs []
    names : vec string [] [ 'Mars', 'TerraMars' ]
    dir   : path '../{share_name}/thumbs'
    scene_thumbs_for[ names, dir ]
