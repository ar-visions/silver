# the navigation dialog: orbiter's browse list for any trinity
# app (its orbiter bar's title opens it): a folder's entries with
# their icons, '..' first; typing in the bar filters; a pick goes
# to the app (element.nav_open), else a folder is gone into
extend trinity

class FindHit
    public is_header : bool
    public text      : string
    public dir       : string
    public is_dir    : bool
    public is_spacer : bool
    public session   : string
    public file      : path
    public line      : i32
    # bordered trailing row: enters the title bar's create mode
    public is_newfile : bool
    # directory holds <stem>/<stem>.ag: a silver module
    public is_module  : bool
    public inst       : i32
    # a scene card: picking it loads the scene
    public scene      : string
    # the scene's exported picture
    public thumb      : path
    # owner/name of a remote repository row: picking it checks the repo
    # out
    public repo       : string
    # the repository is already checked out beside this one
    public checked    : bool
    # the trailing row of a listing: picking it fetches the next page
    public more       : bool
    # one of the user's pins, listed above the folder's own entries
    public pinned     : bool
    # directory holds <stem>/<stem>.agi: a resource (a design) the
    # app opens; a yellow cube where a module's is blue
    public is_resource : bool

    # a card row: an instance or a scene
    public func card [] -> bool
        if [ inst > 0 ] return true
        return scene && scene.count > 0

    # a message row: a header with text that points at nothing
    public func note [] -> bool
        if [ !is_header || is_spacer || is_newfile || more || is_dir ]
            return false
        if [ file || inst > 0 ] return false
        if [ (scene && scene.count > 0) || (repo && repo.count > 0) ]
            return false
        return text && text.count > 0


# material icon theme: fileNames/fileExtensions → icon name = svg stem
class FileIcons
    intern static mi_loaded : bool
    intern static mi_exts   : map
    intern static mi_names  : map
    intern static mi_models : map SVGModel [string]

    func load []
        if [ mi_loaded ] return
        mi_loaded = true
        jp : path 'images/material/material-icons.json'
        if [ !jp.exists[] ] return
        mm : map jp.load[ typeid[ map ], null ]
        if [ !mm ] return
        fe : map mm[ 'fileExtensions' ]
        fn9 : map mm[ 'fileNames' ]
        # own copies: the parsed json is freed later, and a child map
        # went with it while the nav list was still drawing icons
        if [ fe ]
            mi_exts = map string [string] []
            for [ v9: string, k9: string ] in fe
                mi_exts[ k9 ] = v9
        if [ fn9 ]
            mi_names = map string [string] []
            for [ v8: string, k8: string ] in fn9
                mi_names[ k8 ] = v8
        mi_models = map SVGModel [string] []

    # one model per (icon, size): draw_svg caches a single raster per
    # model
    func icon [ fname: string, sz: i32 ] -> SVGModel
        if [ !mi_loaded ] load[]
        if [ !mi_exts ] return null
        nm : string
        if [ !fname ] return null
        if [ mi_names && mi_names.contains[ fname ] ]
            nm = mi_names[ fname ]
        if [ !nm ]
            n : i32 [ fname.count ]
            for [ i: i32 0, i < n, i += 1 ]
                if [ fname[i] == 46 && i + 1 < n ]
                    ex : string fname.mid[ i + 1, n - i - 1 ]
                    # typed search text carries any dot: an unknown key
                    # faults
                    if [ mi_exts.contains[ ex ] ]
                        nm = mi_exts[ ex ]
                        break
        if [ !nm ] nm = string [ 'file' ]
        return named[ nm, sz ]

    # direct icon by svg stem — tool rows name their icon
    func named [ nm: string, sz: i32 ] -> SVGModel
        if [ !mi_loaded ] load[]
        if [ !mi_models ] mi_models = map SVGModel [string] []
        key : '{nm}|{sz}'
        mdl : SVGModel mi_models[ key ]
        if [ !mdl ]
            # the editor view wears orbiter's own mark (the path-only
            # svg). a fresh local: assigning over nm drops the caller's
            # reference
            fn : string (nm == 'editor') ? 'orbiter4' : nm
            ip : path 'images/material/{fn}.svg'
            if [ !ip.exists[] ] ip = path 'images/{fn}.svg'
            if [ !ip.exists[] ] return null
            mdl = SVGModel [ ip ]
            mi_models[ key ] = mdl
        return mdl

# a folder's rows as orbiter lists them: '..', folders (silver
# modules leading them), then files; typed text keeps the names
# holding it
# a folder's entries in the list's order: by name, any case; files
# by their type (extension) first, then by name
func nav_sorted [ entries: vec path ] -> vec path
    out : vec path []
    if [ !entries ] return out
    keys : vec string []
    for [ e: path ] in entries
        nm : string e.filename[].lcase[]
        k  : string [ (e.is_dir[]) ? nm : '{e.ext[].lcase[]}\t{nm}' ]
        # insertion: the first key past it takes the place
        at : i32 [ i32[ keys.count ] ]
        for [ i: i32 0, i < i32[ keys.count ], i += 1 ]
            if [ k.compare[ keys[ i ] ] < 0 ]
                at = i
                break
        keys.insert[ k, at ]
        out.insert[ e, at ]
    return out

func nav_listing [ dir: path, filter: string ] -> vec FindHit
    out : vec FindHit []
    if [ !dir ] return out
    typed : string [ (filter) ? filter.lcase[] : '' ]
    up : path dir.directory[]
    if [ up && typed.count == 0 ]
        out.push[ nav_dir_hit[ up, '..' ] ]
    entries : nav_sorted[ dir.ls[ null, false ] ]
    if [ !entries ] return out
    for [ pass: i32 0, pass < 2, pass += 1 ]
        for [ e: path ] in entries
            if [ !e.is_dir[] ] continue
            dn : string e.filename[]
            if [ dn == '.git' || dn == 'checkout' ] continue
            if [ typed.count > 0 && dn.lcase[].index_of[ typed ] < 0 ]
                continue
            em : path '{e}/{dn}.ag'
            if [ em.exists[] != (pass == 0) ] continue
            out.push[ nav_dir_hit[ e, dn ] ]
    for [ e: path ] in entries
        if [ e.is_dir[] ] continue
        fn : string e.filename[]
        if [ typed.count > 0 && fn.lcase[].index_of[ typed ] < 0 ]
            continue
        out.push[ FindHit [ is_header: true, text: fn, dir: '',
                            file: e ] ]
    return out

# a folder's row: a silver module's folder wears the module mark,
# a resource's (<stem>.agi) the resource mark
func nav_dir_hit [ p: path, label: string ] -> FindHit
    m : path '{p}/{p.filename[]}.ag'
    r : path '{p}/{p.filename[]}.agi'
    src : bool [ m.exists[] ]
    return FindHit [ is_header: true, is_dir: true, is_module: src,
                     is_resource: !src && r.exists[], text: label,
                     dir: '', file: p ]

# a list row's hover: the wash and its edge, the pointer's near
# light bringing the edge and an inner glow up (orbiter's lists)
func nav_hover_paint [ cv: Canvas, e: element, x: f32, y: f32,
                       wd: f32, ht: f32, fill: rgba, edge: rgba,
                       oy: f32 ]
    cv.save[]
    cv.rounded[ 8.0, 8.0, 8.0, 8.0 ]
    cv.fill_color[ fill ]
    cv.stroke_width[ 1.0 ]
    cv.stroke_offset[ -0.5 ]
    # the edge at half alpha, every theme: the glow reads
    cv.stroke_color[ rgba [ r: edge.r, g: edge.g, b: edge.b,
                            a: edge.a * 0.5 ] ]
    cv.box_shadow[ rgba [ r: edge.r, g: edge.g, b: edge.b,
                          a: edge.a * 0.25 ], 0.0, 0.0, 6.0, 0.0,
                   true ]
    e.ux.near_light_on[ cv, e, 0.0, oy ]
    cv.near_style[ 1.3, 3.9, rgba [ r: edge.r, g: edge.g, b: edge.b,
                                    a: 1.0 ], e.ux.near_y_fade ]
    cv.rect_to[ x, y, wd, ht ]
    cv.paint[]
    cv.restore[]

# a list row's icon (21 px, at x + 38) and name after it; the
# name's left edge back
# u: the row's scale (1: a 30 px row)
func nav_icon_paint [ cv: Canvas, ico: SVGModel, x: f32,
                      ry: f32, u: f32 ] -> f32
    if [ !ico ] return x + 38.0 * u
    cv.fill_color[ rgba [ '#ffffff' ] ]
    cv.stroke_color[ rgba [ '#ffffff' ] ]
    sz : f32 [ round[ 21.0 * u ] ]
    cv.draw_svg[ ico, x + 38.0 * u, round[ ry + 4.5 * u ], sz, sz ]
    return x + 67.0 * u

# an app's or module's icon: its images/icon.png, else the icon its
# export names, else the module cube or folder
class AppIcon
    public  file   : path
    public  module : bool
    # a program's own icon file (its .desktop's), drawn instead
    public  icon_file : path
    # the module's export, where its icon name is
    public  agi    : path
    mutable tex    : Texture
    mutable svg    : SVGModel
    mutable loaded : bool
    # the png, colour scaled by alpha; tex is it shrunk to tex_side px
    mutable src    : Image
    mutable tex_side : i32

    # each drawn pixel the mean of the source pixels it covers
    func shrink [ ps: i32 ] -> Image
        sw : i32 [ src.width ]
        sh : i32 [ src.height ]
        # the picture's shape kept inside the ps square
        dw : i32 [ (sw >= sh) ? ps : max[ 1, ps * sw / sh ] ]
        dh : i32 [ (sh >= sw) ? ps : max[ 1, ps * sh / sw ] ]
        out : Image [ width: dw, height: dh, format: Pixel.rgba8,
                      channels: 4 ]
        sp9 : @u8 src.vdata[]
        dp9 : @u8 out.vdata[]
        fx : f32 [ f32[ sw ] / f32[ dw ] ]
        fy : f32 [ f32[ sh ] / f32[ dh ] ]
        for [ dy: i32 0, dy < dh, dy += 1 ]
            y0 : f32 [ f32[ dy ] * fy ]
            y1 : f32 [ y0 + fy ]
            for [ dx: i32 0, dx < dw, dx += 1 ]
                x0 : f32 [ f32[ dx ] * fx ]
                x1 : f32 [ x0 + fx ]
                acc : local f32 [ 4 ] [ 0.0, 0.0, 0.0, 0.0 ]
                wt  : f32 [ 0.0 ]
                for [ sy: i32 i32[ y0 ], f32[ sy ] < y1 && sy < sh, sy += 1 ]
                    wy : f32 [
                        min[ f32[ sy + 1 ], y1 ]
                        - max[ f32[ sy ], y0 ] ]
                    for [ sx: i32 i32[ x0 ], f32[ sx ] < x1 && sx < sw, sx += 1 ]
                        w9 : f32 [
                            wy
                            * (min[ f32[ sx + 1 ], x1 ] - max[ f32[ sx ], x0 ]) ]
                        o9 : i64 [
                            (i64[ sy ] * i64[ sw ] + i64[ sx ]) * 4 ]
                        for [ c: i32 0, c < 4, c += 1 ]
                            acc[ c ] += f32[ sp9[ o9 + c ] ] * w9
                        wt += w9
                d9 : i64 [ (i64[ dy ] * i64[ dw ] + i64[ dx ]) * 4 ]
                for [ c: i32 0, c < 4, c += 1 ]
                    dp9[ d9 + c ] = u8[
                        min[ acc[ c ] / wt + 0.5, 255.0 ] ]
        return out

    # the name on the export's icon line: icon: ['tune']
    func export_icon [] -> string
        if [ !agi || !agi.exists[] ] return null
        tx : string agi.load[ typeid[string], null ]
        if [ !tx ] return null
        ix : tx.index_of[ 'icon: [' ]
        if [ ix < 0 ] return null
        i  : i32 [ ix ]
        n  : i32 [ tx.count ]
        q0 : i32 [ 0 - 1 ]
        while [ i < n ]
            c : i32 [ (i32 tx.chars[i]) & 255 ]
            if [ c == 10 ] break
            i += 1
            if [ c != 39 ] continue
            if [ q0 < 0 ]
                q0 = i
                continue
            return tx.mid[ q0, i - 1 - q0 ]
        return null

    func paint [ cv: Canvas, x: f32, y: f32, side: f32 ]
        if [ !loaded ]
            loaded = true
            png : path '{file}/images/icon.png'
            if [ icon_file && icon_file.ext[] == 'svg' ]
                svg = SVGModel [ icon_file ]
                png = path '/nonexistent'
            el [ icon_file ]
                png = icon_file
            if [ png.exists[] ]
                im : Image [ '{png}' ]
                # the canvas adds colour unscaled: scale it by alpha
                if [
                    im.width > 0 && im.height > 0
                    && im.format == Pixel.rgba8 ]
                    px9 : @u8 im.vdata[]
                    n9  : i64 [ i64[ im.width ] * i64[ im.height ] * 4 ]
                    for [ k: i64 0, k < n9, k += 4 ]
                        al : u32 [ px9[ k + 3 ] ]
                        px9[ k ]     = u8[
                            (u32[ px9[ k ] ] * al + 127) / 255 ]
                        px9[ k + 1 ] = u8[
                            (u32[ px9[ k + 1 ] ] * al + 127) / 255 ]
                        px9[ k + 2 ] = u8[
                            (u32[ px9[ k + 2 ] ] * al + 127) / 255 ]
                    src = im
            nm : string export_icon[]
            if [ !src && nm ]
                mp : path 'images/material/{nm}.svg'
                if [ !mp.exists[] ] mp = path 'images/{nm}.svg'
                if [ mp.exists[] ] svg = SVGModel [ mp ]
            if [ !src && !svg ]
                sp : path (module) ? path 'images/material/3d.svg'
                    : path 'images/material/folder.svg'
                if [ sp.exists[] ] svg = SVGModel [ sp ]
            # a file: its type's icon, as the nav list draws it
            if [ !src && !svg && !module && !file.is_dir[] ]
                fi : FileIcons []
                svg = fi.icon[ file.filename[], 64 ]
        # drawn one texel a pixel: made at the size it is drawn
        ps9 : i32 [ round[ side ] ]
        if [ src && ps9 > 0 && (!tex || tex_side != ps9) ]
            sm : Image shrink[ ps9 ]
            tex = Texture [ vk: cv.vk, w: cv.w, sampler: sm,
                width: sm.width, height: sm.height, linear: true ]
            tex_side = ps9
        if [ tex ]
            tw : f32 [ tex.width ]
            th : f32 [ tex.height ]
            cv.draw_image[ tex,
                           rect [ x: round[ x + (side - tw) * 0.5 ],
                y: round[ y + (side - th) * 0.5 ], w: tw, h: th ] ]
        el [ svg ]
            cv.fill_color[ rgba [ '#fff' ] ]
            cv.draw_svg[ svg, x, y, side, side ]

# the dialog: under the orbiter bar over the app, a solid ground
# with its rows over it (NavRows); keys reach it from the Window
element NavigationView
    # the row under the pointer or chosen by the arrows
    public at   : i32
    # the rows as last listed, and what they were listed from
    intern rows   : vec FindHit
    intern listed : string

    # the rows of the folder in view, listed again when it or the
    # typed text changes
    func hits [] -> vec FindHit
        key : '{ux.nav_dir}|{ux.nav_filter}'
        if [ !rows || !listed || listed.compare[ key ] != 0 ]
            rows   = nav_listing[ ux.nav_dir, ux.nav_filter ]
            listed = key
            at     = 0
            nr : list_el[]
            if [ nr ]
                nr.scroll.y    = 0.0
                nr.scroll_goal = 0.0
        return rows

    func list_el [] -> NavRows
        if [ !elements || !elements.contains[ 'rows' ] ] return null
        return elements[ 'rows' ] inherits NavRows

    func render [] -> Elements
        out : Elements []
        # brought up: it takes the keys (arrows choose, enter goes)
        if [ ux && ux.focus != a ] ux.set_focus[ a ]
        hits[]
        out[ 'rows' ] = NavRows [ scroll_fade: 24.0,
                                  area: Region { l0 t0 r0 b0 } ]
        return out

    func pick [ h: FindHit ]
        if [ h && h.file ] ux.nav_pick[ h.file ]

    # the bar's keys: up and down choose, enter opens; the Window
    # keeps escape and the typed text
    public func on_key [ ev: Event ]
        if [ !ev.key.state ] return
        k : i32 [ ev.key.unicode ]
        list : hits[]
        if [ k == 264 && at < list.count - 1 ] at += 1
        if [ k == 265 && at > 0 ] at -= 1
        # saving: the typed name (or the row) is where to save
        if [ (k == 257 || k == 335) && ux.nav_saving ]
            h : FindHit [ (at >= 0 && at < list.count) ? list[ at ]
                                                       : null ]
            ux.nav_save_pick[ (h) ? h.file : null ]
            return
        if [ (k == 257 || k == 335) && at >= 0 && at < list.count ]
            pick[ list[ at ] ]
            return
        nr : list_el[]
        if [ nr ] nr.show_row[ at ]

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        cv : Canvas [ w.screen ]
        cv.save[]
        cv.stroke_width[ 0.0 ]
        cv.fill_color[ '#14141a' ]
        cv.rect_to[ 0.0, 0.0, bounds.w, bounds.h ]
        cv.paint[]
        cv.restore[]

# the dialog's rows as orbiter's browse list draws them: 30 px,
# the icon, the name, the hover's wash and edge under the
# pointer's light; scrolled by trinity, faded where scrolled out
element NavRows
    # the icons: a file, a folder, a module's folder, by type
    intern file_icon   : SVGModel
    intern folder_icon : SVGModel
    intern module_icon : SVGModel
    intern resource_icon : SVGModel
    intern ficons      : FileIcons
    # module folders' own icons, and the folders found without one
    intern mod_icons   : map AppIcon [string]
    intern mod_noicon  : vec string
    # the exports' file names, read once
    intern exports     : vec string
    public  nav_hover_fill : rgba [ '#d25cc826' ]
    public  nav_hover_edge : rgba [ '#e07ad899' ]
    # the row a press chose: its release there opens it
    intern  pressed : i32 [ -1 ]

    func row_h [] -> f32
        return 30.0

    # a module folder's own icon (images/icon.png, else its export's
    # icon: install/export/<owner>-<name>.agi); null: the cube
    func mod_icon [ dir: path ] -> AppIcon
        k : string '{dir}'
        if [ !mod_icons ] mod_icons = map AppIcon [string] []
        if [ !mod_noicon ] mod_noicon = vec string []
        if [ mod_icons.contains[ k ] ] return mod_icons[ k ]
        for [ m: string ] in mod_noicon
            if [ m == k ] return null
        ex : path '{path.path_install[]}/export'
        if [ !exports ]
            exports = vec string []
            if [ ex.exists[] ]
                for [ f: path ] in ex.ls[ null, false ]
                    exports.push[ f.filename[] ]
        tail : string '-{dir.filename[]}.agi'
        agi : path null
        for [ f: string ] in exports
            if [ f.ends_with[ tail ] ] agi = path '{ex}/{f}'
        ai : AppIcon [ file: dir, module: true, agi: agi ]
        png : path '{dir}/images/icon.png'
        if [ !png.exists[] && !ai.export_icon[] ]
            mod_noicon.push[ k ]
            return null
        mod_icons[ k ] = ai
        return ai

    # the dialog it is in: its rows and the chosen one
    func dialog [] -> NavigationView
        if [ !parent ] return null
        return parent inherits NavigationView

    func render [] -> Elements
        view : dialog[]
        if [ view ]
            content_h = f32[ view.hits[].count ] * row_h[] + 24.0
        return null

    # the row at y: the pointer comes with the scroll in it
    func row_of [ y: f32 ] -> i32
        return i32[ floor[ (y - 8.0) / row_h[] ] ]

    # a row brought into view
    func show_row [ i: i32 ]
        rh : row_h[]
        top : f32 [ 8.0 + f32[ i ] * rh ]
        if [ top - scroll_goal > bounds.h - rh - 8.0 ]
            scroll_goal = top - bounds.h + rh + 8.0
        if [ top < scroll_goal ] scroll_goal = top - 8.0
        if [ scroll_goal < 0.0 ] scroll_goal = 0.0
        scroll_anim = true
        pristine = false

    public func on_move [ ev: Event ]
        view : dialog[]
        if [ !view ] return
        i : i32 [ row_of[ ev.mouse.pos.y ] ]
        if [ i != view.at ]
            view.at = i
            pristine = false

    public func on_press [ ev: Event ]
        view : dialog[]
        if [ !view ] return
        i : i32 [ row_of[ ev.mouse.pos.y ] ]
        pressed = i
        view.at = i
        pristine = false
        ev.no_propagation = true

    public func on_release [ ev: Event ]
        view : dialog[]
        was : i32 [ pressed ]
        pressed = -1
        if [ !view ] return
        list : view.hits[]
        i : i32 [ row_of[ ev.mouse.pos.y ] ]
        if [ i == was && i >= 0 && i < list.count ]
            view.pick[ list[ i ] ]
        ev.no_propagation = true

    func icon_of [ h: FindHit ] -> SVGModel
        if [ !file_icon ]
            fp : path 'images/file.svg'
            if [ fp.exists[] ] file_icon = SVGModel [ fp ]
        if [ !module_icon ]
            mp : path 'images/material/3d.svg'
            if [ mp.exists[] ] module_icon = SVGModel [ mp ]
        if [ !folder_icon ]
            dp : path 'images/material/folder.svg'
            if [ dp.exists[] ] folder_icon = SVGModel [ dp ]
        if [ !resource_icon ]
            rp : path 'images/resource.svg'
            if [ rp.exists[] ] resource_icon = SVGModel [ rp ]
        if [ !ficons ] ficons = FileIcons []
        if [ h.is_dir && h.is_module ] return module_icon
        if [ h.is_dir && h.is_resource ] return resource_icon
        if [ h.is_dir ] return folder_icon
        if [ h.text && h.text.count > 0 ]
            mim : SVGModel ficons.icon[ h.text, 21 ]
            if [ mim ] return mim
        return file_icon

    public func draw [ w: Window ]
        view : dialog[]
        if [ w.draw_stage != CanvasType.screen || !view ] return
        cv : Canvas [ w.screen ]
        list : view.hits[]
        cv.save[]
        cv.translate[ 0.0, 0.0 - scroll.y ]
        rh : row_h[]
        x0 : f32 [ 12.0 ]
        right : f32 [ bounds.w - 24.0 ]
        for [ i: i32 0, i < list.count, i += 1 ]
            h : list[ i ]
            ry : f32 [ 8.0 + f32[ i ] * rh ]
            if [ ry + rh < scroll.y || ry > scroll.y + bounds.h ]
                continue
            if [ i == view.at ]
                nav_hover_paint[ cv, a, x0 + 32.0, ry + 1.0,
                    right - x0 - 32.0, rh - 2.0, nav_hover_fill,
                    nav_hover_edge, 0.0 - scroll.y ]
            # a module with an icon of its own shows it
            mi : AppIcon (h.is_dir && h.is_module && h.file)
                ? mod_icon[ h.file ] : null
            tx : f32 [ x0 + 67.0 ]
            if [ mi ]
                mi.paint[ cv, x0 + 38.0, round[ ry + 4.5 ], 21.0 ]
            el
                tx = nav_icon_paint[ cv, icon_of[ h ], x0, ry, 1.0 ]
            cv.font_size[ 16 ]
            cv.fill_color[ (h.is_dir) ? '#6cb6ff' : '#fff' ]
            cv.draw_text[ h.text, rect [ x: tx, y: ry,
                                         w: right - tx, h: rh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
                Overflow.ellipsis, null ]
        cv.restore[]
