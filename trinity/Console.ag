extend trinity


ifdef [ apple ]
    import <util.h>     # forkpty/openpty live in util.h on macOS
        -lutil
ifdef [ linux ]
    import <pty.h>      # glibc 2.34 on: forkpty is in libc
ifdef [ android ]
    import <pty.h>      # bionic carries forkpty in libc, no -lutil
ifdef [ windows ]
    import <posix.h>    # declares forkpty, which always fails here

struct TermCell
    ch   : i32 [ 32 ]
    fg   : i32 [ -1 ]
    bg   : i32 [ -1 ]
    attr : i32 [ 0 ]

# the shell's history kept at each command, and a blank line
# before its prompt when a command ran since the last one; first
# the end mark (OSC 133 D) with its exit code and command
PROMPT_GAP : string [ '__e=$?; history -a; '
    + '__h=$(HISTTIMEFORMAT= history 1); __c=; '
    + '[ "$__h" != "$__p" ] && __c=$(sed "s/^ *[0-9]* *//" <<<"$__h"); '
    + 'printf "\\033]133;D;%s;%s\\007" "$__e" "$__c"; '
    + '[ -n "$__p" ] && [ "$__h" != "$__p" ] && echo; __p=$__h' ]

# one command the shell ran: its line, exit code, output, time
class ConsoleRun
    public cmd  : string
    public code : i32
    public out  : string
    public secs : f64

class ConsoleSession
    mutable pty_fd     : i32 [ -1 ]
    mutable pid        : i32 [ 0  ]
    mutable name       : string
    mutable launch_cmd : string
    mutable cwd        : string
    mutable pending    : string
    mutable esc_state  : i32 [ 0  ]
    mutable esc_n0     : i32 [ 0  ]
    mutable esc_n1     : i32 [ 0  ]
    mutable esc_n2     : i32 [ 0  ]
    mutable esc_np     : i32 [ 0  ]
    mutable cur_save_x : i32 [ 0  ]
    mutable cur_save_y : i32 [ 0  ]
    mutable cx         : i32 [ 0  ]
    mutable cy         : i32 [ 0  ]
    mutable cols       : i32 [ 80 ]
    mutable rows       : i32 [ 24 ]
    mutable screen      : vec TermCell [ 2048 * 2048 ]
    mutable scrollback : list string
    mutable sb_cells   : vec TermCell
    mutable sb_off     : vec i32
    mutable sb_scratch : vec TermCell [ 2048 ]
    mutable scroll     : f32 [ 0.0 ]
    mutable wheel_accum : f32 [ 0.0 ]
    mutable first_line  : i32 [ -2147483647 ]
    mutable last_feed_count : i32 [ -1 ]
    mutable read_calls : i32 [ 0 ]
    mutable sel_line    : i32 [ -1 ]
    mutable sel_col     : i32 [ 0 ]
    mutable anchor_line : i32 [ 0 ]
    mutable anchor_col  : i32 [ 0 ]
    mutable dragging        : bool
    mutable scroll_dragging : bool
    mutable lh_cache    : f32
    mutable cw_cache    : f32
    mutable hover_link_line : i32 [ -1 ]
    mutable link_c0     : i32 [ 0 ]
    mutable link_c1     : i32 [ 0 ]
    mutable sb_lines    : vec TermLineCache
    mutable live_lines  : vec TermLineCache
    mutable cache_cw    : f32 [ -1.0 ]
    mutable cache_lh    : f32 [ -1.0 ]
    mutable frame_id    : i32 [ 0 ]
    mutable running     : bool
    mutable run_armed   : bool
    mutable user_scrolled : bool
    mutable max_scroll  : f32
    mutable last_resize_us : i64 [ 0 ]

    mutable alt_bak     : vec TermCell [ 2048 * 2048 ]
    mutable in_alt      : bool
    mutable scroll_top  : i32 [ 0  ]
    mutable scroll_bot  : i32 [ 23 ]
    mutable pen_fg      : i32 [ -1 ]
    mutable pen_bg      : i32 [ -1 ]
    mutable pen_attr    : i32 [ 0  ]
    mutable cursor_visible  : bool [ true ]
    mutable bracketed_paste : bool
    mutable app_cursor      : bool
    mutable alt_save_x  : i32 [ 0 ]
    mutable alt_save_y  : i32 [ 0 ]
    mutable utf_need    : i32 [ 0 ]
    mutable utf_cp      : i32 [ 0 ]
    mutable esc_priv    : i32 [ 0 ]
    mutable esc_pv      : vec i32
    mutable esc_pc      : i32 [ 0 ]
    mutable esc_pi      : i32 [ 0 ]
    # the program's title (OSC 0 or 2), as a terminal's tab shows it
    public  title       : string
    # the OSC's text while it arrives
    mutable osc         : vec u8
    # a log: lines never wrap; the view scrolls sideways
    public  nowrap      : bool
    mutable scroll_x    : f32
    mutable max_x       : f32
    # a nowrap view's lines, drawn here, then faded at its sides
    mutable view        : Canvas
    # where its scroll is going: the shown scroll eases there
    mutable scroll_goal : f32
    # the user typed into it (a key or text, not a paste of ours)
    public  typed       : bool
    # the view that sets its size (one session in two views): the
    # one typed into, else the last to claim it while it draws
    public  sizer       : object
    public  sizer_us    : i64
    # its text's own background colours over what is behind
    # (1 solid; the agent view's consoles see the platform)
    public  cell_alpha  : f32 [ 1.0 ]
    # the program asked for the mouse (1000 1002 1003), in the SGR
    # form (1006): the wheel goes to it, as a terminal's does
    mutable mouse_report : bool
    mutable mouse_sgr    : bool
    # the commands run here (shell marks), for an agent to read
    public  runs        : vec ConsoleRun
    # the running command: its first output line (-1 none)
    mutable run_from    : i32 [ -1 ]
    mutable run_us      : i64
    mutable run_cmd     : string
    # the log line of each command the shell ran (its start mark):
    # marks on the scrollbar's track; a program's own Enter makes none
    public  cmd_lines   : vec i32

    func init []
        scrollback  = list string []
        sb_cells    = vec TermCell []
        sb_off      = vec i32 []
        runs        = vec ConsoleRun []
        init_cells[ screen, rows * cols ]
        scroll_bot = rows - 1
        esc_pv     = vec i32 []
        for [ i: i32 0, i < 16, i += 1 ]
            esc_pv.push[ 0 ]

    func start []
        if [ pty_fd >= 0 ] return
        pid = forkpty[ @pty_fd, null, null, null ]
        if [ pid == 0 ]
            # the folder the process is given, when the view has one
            if [ cwd && cwd.count > 0 ] chdir[ cwd.chars ]
            setenv[ 'TERM', 'xterm-256color', 1 ]
            setenv[ 'COLORTERM', 'truecolor', 1 ]
            # each command kept at once, not only at a clean exit
            setenv[ 'PROMPT_COMMAND', 'history -a', 1 ]
            if [ launch_cmd && launch_cmd.count > 0 ]
                dashc : string '-c'
                ec    : string 'exec {launch_cmd}'
                execl[ '/bin/bash', 'bash', dashc.chars, ec.chars,
                       null ]
            el
                # the prompt is its working folder, as it changes
                setenv[ 'PS1', '\\w> ', 1 ]
                # a blank line after a command, and after its output
                # (only when one ran: an empty Enter adds none); the
                # output's start mark (OSC 133 C) first
                setenv[ 'PS0', '\\e]133;C\\a\n', 1 ]
                setenv[ 'PROMPT_COMMAND', PROMPT_GAP, 1 ]
                norc : string '--norc'
                execl[ '/bin/bash', 'bash', norc.chars, null ]
            _exit[ 1 ]
        el [ pid < 0 ]
            log 'ConsoleSession.start[{name}]: forkpty FAILED (pid={pid})'
        el
            fcntl[ pty_fd, F_SETFL, O_NONBLOCK ]

    # its program ends: hung up, its terminal closed
    func end []
        if [ pid > 0 ] kill[ pid, 1 ]
        if [ pty_fd >= 0 ] close[ pty_fd ]
        pty_fd = -1
        pid    = 0

    func restart []
        if [ pty_fd >= 0 ]
            close[ pty_fd ]
        pty_fd     = -1
        pid        = 0
        cx         = 0
        cy         = 0
        scroll     = 0.0
        esc_state  = 0
        clear_screen[]
        scrollback = list string []
        cmd_lines = null
        sb_cells   = vec TermCell []
        sb_off     = vec i32 []
        run_armed  = false
        run_from   = -1
        start[]

    func bl_cell [ i: i32 ]
        screen[i].ch   = 32
        screen[i].fg   = -1
        screen[i].bg   = pen_bg
        screen[i].attr = 0

    # copy cell src→dst (flat indices) within the active screen.
    func cp_cell [ dst: i32, src: i32 ]
        screen[dst].ch   = screen[src].ch
        screen[dst].fg   = screen[src].fg
        screen[dst].bg   = screen[src].bg
        screen[dst].attr = screen[src].attr

    func blit_cells [ dst: @TermCell, src: @TermCell, n: i32 ]
        for [ i: i32 0, i < n, i += 1 ]
            dst[i].ch   = src[i].ch
            dst[i].fg   = src[i].fg
            dst[i].bg   = src[i].bg
            dst[i].attr = src[i].attr

    func init_cells [ buf: @TermCell, n: i32 ]
        for [ i: i32 0, i < n, i += 1 ]
            buf[i].ch   = 32
            buf[i].fg   = -1
            buf[i].bg   = -1
            buf[i].attr = 0

    func clear_screen []
        for [ i: i32 0, i < rows * cols, i += 1 ]
            screen[i].ch   = 32
            screen[i].fg   = -1
            screen[i].bg   = pen_bg
            screen[i].attr = 0
        cx = 0
        cy = 0

    # resolve an xterm-256 palette index to packed 0xRRGGBB.
    func pal256 [ n: i32 ] -> i32
        if [ n < 16 ]
            base : vec i32 [] [ 0x000000, 0xcd0000, 0x00cd00, 0xcdcd00,
                               0x0000ee, 0xcd00cd, 0x00cdcd, 0xe5e5e5,
                               0x7f7f7f, 0xff0000, 0x00ff00, 0xffff00,
                               0x5c5cff, 0xff00ff, 0x00ffff, 0xffffff ]
            return base[ n ]
        if [ n < 232 ]
            i : i32 [ n - 16 ]
            r : i32 [ i / 36 ]
            g : i32 [ (i / 6) % 6 ]
            b : i32 [ i % 6 ]
            rv : i32 [ (r == 0) ? 0 : 55 + r * 40 ]
            gv : i32 [ (g == 0) ? 0 : 55 + g * 40 ]
            bv : i32 [ (b == 0) ? 0 : 55 + b * 40 ]
            return (rv << 16) | (gv << 8) | bv
        l : i32 [ (n - 232) * 10 + 8 ]
        return (l << 16) | (l << 8) | l

    func cells_text [ cells: @TermCell, off: i32, start_col: i32,
                      end_col: i32 ] -> string
        buf : local i8 [ (end_col - start_col) * 4 + 1 ]
        bi  : i32 [ 0 ]
        for [ c: i32 start_col, c < end_col, c += 1 ]
            cp : i32 [ cells[off + c].ch ]
            if [ cp < 32 ] cp = 32
            if [ cp < 128 ]
                buf[bi] = i8[ cp ]
                bi += 1
            el [ cp < 2048 ]
                buf[bi]   = i8[ 192 | (cp >> 6) ]
                buf[bi+1] = i8[ 128 | (cp & 63) ]
                bi += 2
            el [ cp < 65536 ]
                buf[bi]   = i8[ 224 | (cp >> 12) ]
                buf[bi+1] = i8[ 128 | ((cp >> 6) & 63) ]
                buf[bi+2] = i8[ 128 | (cp & 63) ]
                bi += 3
            el
                buf[bi]   = i8[ 240 | (cp >> 18) ]
                buf[bi+1] = i8[ 128 | ((cp >> 12) & 63) ]
                buf[bi+2] = i8[ 128 | ((cp >> 6) & 63) ]
                buf[bi+3] = i8[ 128 | (cp & 63) ]
                bi += 4
        buf[bi] = 0
        return string[ @buf[0] ]

    func cell_text [ r: i32, start_col: i32, end_col: i32 ] -> string
        return cells_text[ screen, r * cols, start_col, end_col ]

    func cell_fg   [ r: i32, c: i32 ] -> i32   return screen[r * cols + c].fg
    func cell_bg   [ r: i32, c: i32 ] -> i32   return screen[r * cols + c].bg
    func cell_attr [ r: i32, c: i32 ] -> i32   return screen[r * cols + c].attr

    func sb_line_off [ li: i32 ] -> i32   return sb_off[ li ]
    func sb_line_len [ li: i32 ] -> i32
        nx : i32 [
            (li + 1 < sb_off.count) ? sb_off[ li + 1 ]
            : sb_cells.count ]
        return nx - sb_off[ li ]

    func sb_line_buf [ li: i32 ] -> @TermCell
        off : i32 [ sb_off[ li ] ]
        len : i32 [ sb_line_len[ li ] ]
        for [ c: i32 0, c < len && c < 2048, c += 1 ]
            sb_scratch[c].ch   = sb_cells[ off + c ].ch
            sb_scratch[c].fg   = sb_cells[ off + c ].fg
            sb_scratch[c].bg   = sb_cells[ off + c ].bg
            sb_scratch[c].attr = sb_cells[ off + c ].attr
        return sb_scratch

    # a row's text to its last character, not its blank tail
    func row_to_string [ r: i32 ] -> string
        n : i32 [ cols ]
        while [ n > 0 && screen[ r * cols + n - 1 ].ch == 32 ]
            n -= 1
        return cell_text[ r, 0, n ]

    func row_drawable [ r: i32 ] -> i32
        base : i32 [ r * cols ]
        for [ c: i32 cols - 1, c >= 0, c -= 1 ]
            i : i32 [ base + c ]
            if [ !(screen[i].ch == 32 && screen[i].fg == -1
                   && screen[i].bg == -1 && screen[i].attr == 0) ]
                return c + 1
        return 0

    func last_row [] -> i32
        for [ r: i32 rows - 1, r >= 0, r -= 1 ]
            for [ c: i32 0, c < cols, c += 1 ]
                ch : i32 [ screen[r * cols + c].ch ]
                bg : i32 [ screen[r * cols + c].bg ]
                if [ (ch != 32 && ch != 0) || bg >= 0 ]
                    return r
        return 0

    # claude code's title while it works: a half circle (U+25D0 to
    # U+25D3) first; idle it is a star
    func agent_busy [] -> bool
        if [ !title || title.count < 3 ] return false
        b0 : i32 [ (i32 title.chars[ 0 ]) & 255 ]
        b1 : i32 [ (i32 title.chars[ 1 ]) & 255 ]
        b2 : i32 [ (i32 title.chars[ 2 ]) & 255 ]
        return b0 == 226 && b1 == 151 && b2 >= 144 && b2 <= 147

    func line_count [] -> i32
        return scrollback.count + rows

    func line_get [ i: i32 ] -> string
        sc : i32 [ scrollback.count ]
        if [ i < sc ] return scrollback.value_by_index[ i ]
        return row_to_string[ i - sc ]

    func at_prompt [] -> bool
        if [ cy < 0 || cy >= rows ] return false
        lbl : string (name && name.count > 0) ? name : 'sh'
        p   : string '{lbl}> '
        row : string row_to_string[ cy ]
        if [ row.index_of[ p ] != 0 ] return false
        return cx <= p.count

    func selection_text [] -> string
        if [ sel_line < 0 ] return ''
        before : bool [ anchor_line < sel_line
                        || (anchor_line == sel_line
                        && anchor_col <= sel_col) ]
        sl : i32 [ (before) ? anchor_line : sel_line ]
        sc : i32 [ (before) ? anchor_col  : sel_col ]
        end_line : i32 [ (before) ? sel_line : anchor_line ]
        ec : i32 [ (before) ? sel_col  : anchor_col ]
        out : string ''
        for [ li: i32 sl, li <= end_line, li += 1 ]
            row : string line_get[ li ]
            a : i32 [ clamp[ (li == sl) ? sc : 0,         0,
                             row.count ] ]
            b : i32 [ clamp[ (li == end_line) ? ec : row.count, 0,
                             row.count ] ]
            if [ b > a ] out = out + row.mid[ a, b - a ]
            if [ li < end_line ] out = out + '\n'
        return out

    func scroll_up []
        quiet : bool [ (epoch_micros[] - last_resize_us) > 200000 ]
        if [ !in_alt && scroll_top == 0 && scroll_bot == rows - 1
             && quiet ]
            scrollback.push[ row_to_string[ scroll_top ] ]
            sb_off.push[ sb_cells.count ]
            dl   : i32 [ row_drawable[ scroll_top ] ]
            srow : i32 [ scroll_top * cols ]
            for [ c: i32 0, c < dl, c += 1 ]
                sb_cells.push[ TermCell [ ch: screen[srow + c].ch,
                                          fg: screen[srow + c].fg,
                                          bg: screen[srow + c].bg,
                                          attr: screen[srow
                                                        + c].attr ] ]
        for [ r: i32 scroll_top, r < scroll_bot, r += 1 ]
            for [ c: i32 0, c < cols, c += 1 ]
                cp_cell[ r * cols + c, (r + 1) * cols + c ]
        for [ c: i32 0, c < cols, c += 1 ]
            bl_cell[ scroll_bot * cols + c ]

    # scroll the region down one line (RI at the top / IL).
    func scroll_down []
        for [ r: i32 scroll_bot, r > scroll_top, r -= 1 ]
            for [ c: i32 0, c < cols, c += 1 ]
                cp_cell[ r * cols + c, (r - 1) * cols + c ]
        for [ c: i32 0, c < cols, c += 1 ]
            bl_cell[ scroll_top * cols + c ]

    func insert_lines [ n: i32 ]
        if [ cy < scroll_top || cy > scroll_bot ] return
        for [ r: i32 scroll_bot, r >= cy + n, r -= 1 ]
            for [ c: i32 0, c < cols, c += 1 ]
                cp_cell[ r * cols + c, (r - n) * cols + c ]
        for [ r: i32 cy, r < cy + n && r <= scroll_bot, r += 1 ]
            for [ c: i32 0, c < cols, c += 1 ]
                bl_cell[ r * cols + c ]

    func delete_lines [ n: i32 ]
        if [ cy < scroll_top || cy > scroll_bot ] return
        for [ r: i32 cy, r <= scroll_bot - n, r += 1 ]
            for [ c: i32 0, c < cols, c += 1 ]
                cp_cell[ r * cols + c, (r + n) * cols + c ]
        for [ r: i32 scroll_bot - n + 1, r <= scroll_bot, r += 1 ]
            for [ c: i32 0, c < cols, c += 1 ]
                bl_cell[ r * cols + c ]

    func insert_chars [ n: i32 ]
        for [ c: i32 cols - 1, c >= cx + n, c -= 1 ]
            cp_cell[ cy * cols + c, cy * cols + (c - n) ]
        for [ c: i32 cx, c < cx + n && c < cols, c += 1 ]
            bl_cell[ cy * cols + c ]

    func delete_chars [ n: i32 ]
        for [ c: i32 cx, c < cols - n, c += 1 ]
            cp_cell[ cy * cols + c, cy * cols + (c + n) ]
        for [ c: i32 cols - n, c < cols, c += 1 ]
            bl_cell[ cy * cols + c ]

    func erase_chars [ n: i32 ]
        for [ c: i32 cx, c < cx + n && c < cols, c += 1 ]
            bl_cell[ cy * cols + c ]

    func put_char [ cp: i32 ]
        if [ cx >= cols ]
            cx = 0
            if [ cy == scroll_bot ]
                scroll_up[]
            el [ cy < rows - 1 ]
                cy += 1
        i : i32 [ cy * cols + cx ]
        screen[i].ch   = cp
        screen[i].fg   = pen_fg
        screen[i].bg   = pen_bg
        screen[i].attr = pen_attr
        cx += 1

    # the log emptied: screen, scrollback, scroll; the program runs on
    func clear_log []
        erase_display[ 3 ]
        clear_screen[]
        cx = 0
        cy = 0
        # its lines are gone: a running command's start with them
        run_from = -1
        scroll = 0.0
        scroll_x = 0.0
        user_scrolled = false
        if [ sb_lines ]
            for [ slc: TermLineCache ] in sb_lines
                slc.li = -1
        if [ live_lines ]
            for [ slc: TermLineCache ] in live_lines
                slc.hash = -1

    func erase_display [ m: i32 ]
        if [ m == 0 ]
            for [ i: i32 cx, i < cols, i += 1 ]
                bl_cell[ cy * cols + i ]
            for [ r: i32 cy + 1, r < rows, r += 1 ]
                for [ j: i32 0, j < cols, j += 1 ]
                    bl_cell[ r * cols + j ]
        el [ m == 1 ]
            for [ r: i32 0, r < cy, r += 1 ]
                for [ j: i32 0, j < cols, j += 1 ]
                    bl_cell[ r * cols + j ]
            for [ i: i32 0, i <= cx, i += 1 ]
                bl_cell[ cy * cols + i ]
        el [ m == 3 ]
            scrollback = list string []
            cmd_lines = null
            sb_cells   = vec TermCell []
            sb_off     = vec i32 []
        el
            for [ i: i32 0, i < rows * cols, i += 1 ]
                bl_cell[ i ]

    func erase_line [ m: i32 ]
        if [ m == 0 ]
            for [ i: i32 cx, i < cols, i += 1 ]
                bl_cell[ cy * cols + i ]
        el [ m == 1 ]
            for [ i: i32 0, i <= cx, i += 1 ]
                bl_cell[ cy * cols + i ]
        el
            for [ i: i32 0, i < cols, i += 1 ]
                bl_cell[ cy * cols + i ]

    func sgr []
        if [ esc_pc == 0 ]
            pen_fg   = -1
            pen_bg   = -1
            pen_attr = 0
            return
        i : i32 [ 0 ]
        while [ i < esc_pc ]
            v : i32 [ esc_pv[i] ]
            if [ v == 0 ]
                pen_fg   = -1
                pen_bg   = -1
                pen_attr = 0
            el [ v == 1 ]
                pen_attr = pen_attr | 1
            el [ v == 2 ]
                pen_attr = pen_attr | 8
            el [ v == 4 ]
                pen_attr = pen_attr | 2
            el [ v == 7 ]
                pen_attr = pen_attr | 4
            el [ v == 22 ]
                pen_attr = pen_attr & (~9)
            el [ v == 24 ]
                pen_attr = pen_attr & (~2)
            el [ v == 27 ]
                pen_attr = pen_attr & (~4)
            el [ v >= 30 && v <= 37 ]
                pen_fg = pal256[ v - 30 ]
            el [ v == 38 ]
                if [ i + 2 < esc_pc && esc_pv[i + 1] == 5 ]
                    pen_fg = pal256[ esc_pv[i + 2] ]
                    i += 2
                el [ i + 4 < esc_pc && esc_pv[i + 1] == 2 ]
                    pen_fg = (esc_pv[i + 2] << 16) | (esc_pv[i + 3] << 8) | esc_pv[i + 4]
                    i += 4
            el [ v == 39 ]
                pen_fg = -1
            el [ v >= 40 && v <= 47 ]
                pen_bg = pal256[ v - 40 ]
            el [ v == 48 ]
                if [ i + 2 < esc_pc && esc_pv[i + 1] == 5 ]
                    pen_bg = pal256[ esc_pv[i + 2] ]
                    i += 2
                el [ i + 4 < esc_pc && esc_pv[i + 1] == 2 ]
                    pen_bg = (esc_pv[i + 2] << 16) | (esc_pv[i + 3] << 8) | esc_pv[i + 4]
                    i += 4
            el [ v == 49 ]
                pen_bg = -1
            el [ v >= 90 && v <= 97 ]
                pen_fg = pal256[ v - 90 + 8 ]
            el [ v >= 100 && v <= 107 ]
                pen_bg = pal256[ v - 100 + 8 ]
            i += 1

    func enter_alt []
        if [ in_alt ] return
        alt_save_x = cx
        alt_save_y = cy
        # stash the normal grid; the TUI gets a cleared screen
        blit_cells[ alt_bak, screen, rows * cols ]
        in_alt     = true
        pen_fg     = -1
        pen_bg     = -1
        pen_attr   = 0
        scroll_top = 0
        scroll_bot = rows - 1
        clear_screen[]

    func leave_alt []
        if [ !in_alt ] return
        # restore the stashed normal grid
        blit_cells[ screen, alt_bak, rows * cols ]
        in_alt     = false
        cx         = alt_save_x
        cy         = alt_save_y
        scroll_top = 0
        scroll_bot = rows - 1

    func set_mode [ on: bool ]
        if [ esc_priv == 63 ]
            m : i32 [ (esc_pc > 0) ? esc_pv[0] : 0 ]
            if [ m == 1 ]
                app_cursor = on
            el [ m == 25 ]
                cursor_visible = on
            el [ m == 1049 || m == 47 || m == 1047 ]
                if [ on ]
                    enter_alt[]
                el
                    leave_alt[]
            el [ m == 2004 ]
                bracketed_paste = on
            el [ m == 1000 || m == 1002 || m == 1003 ]
                mouse_report = on
            el [ m == 1006 ]
                mouse_sgr = on

    # RIS — full reset to a clean main screen.
    func reset_all []
        if [ in_alt ] leave_alt[]
        pen_fg     = -1
        pen_bg     = -1
        pen_attr   = 0
        scroll_top = 0
        scroll_bot = rows - 1
        app_cursor = false
        mouse_report = false
        mouse_sgr    = false
        scrollback = list string []
        cmd_lines = null
        sb_cells   = vec TermCell []
        sb_off     = vec i32 []
        clear_screen[]

    # dispatch a completed CSI sequence by its final byte.
    func dispatch_csi [ c: i32 ]
        first_arg : i32 [ (esc_pc > 0) ? esc_pv[0] : 0 ]
        second_arg : i32 [ (esc_pc > 1) ? esc_pv[1] : 0 ]
        n  : i32 [ (first_arg > 0) ? first_arg : 1 ]
        if [ c == 65 ]
            cy = clamp[ cy - n, 0, rows - 1 ]
        el [ c == 66 ]
            cy = clamp[ cy + n, 0, rows - 1 ]
        el [ c == 67 ]
            cx = clamp[ cx + n, 0, cols - 1 ]
        el [ c == 68 ]
            cx = clamp[ cx - n, 0, cols - 1 ]
        el [ c == 69 ]
            cy = clamp[ cy + n, 0, rows - 1 ]
            cx = 0
        el [ c == 70 ]
            cy = clamp[ cy - n, 0, rows - 1 ]
            cx = 0
        el [ c == 71 || c == 96 ]
            cx = clamp[ first_arg - 1, 0, cols - 1 ]
        el [ c == 72 || c == 102 ]
            cy = clamp[ ((first_arg > 0) ? first_arg - 1 : 0), 0,
                        rows - 1 ]
            cx = clamp[ ((second_arg > 0) ? second_arg - 1 : 0), 0,
                        cols - 1 ]
        el [ c == 100 ]
            cy = clamp[ ((first_arg > 0) ? first_arg - 1 : 0), 0,
                        rows - 1 ]
        el [ c == 74 ]
            erase_display[ first_arg ]
        el [ c == 75 ]
            erase_line[ first_arg ]
        el [ c == 76 ]
            insert_lines[ n ]
        el [ c == 77 ]
            delete_lines[ n ]
        el [ c == 80 ]
            delete_chars[ n ]
        el [ c == 64 ]
            insert_chars[ n ]
        el [ c == 88 ]
            erase_chars[ n ]
        el [ c == 83 ]
            for [ k: i32 0, k < n, k += 1 ]
                scroll_up[]
        el [ c == 84 ]
            for [ k: i32 0, k < n, k += 1 ]
                scroll_down[]
        el [ c == 114 ]
            t : i32 [ (first_arg > 0) ? first_arg - 1 : 0 ]
            b : i32 [ (second_arg > 0) ? second_arg - 1 : rows - 1 ]
            if [ t < 0 ] t = 0
            if [ b > rows - 1 ] b = rows - 1
            if [ t < b ]
                scroll_top = t
                scroll_bot = b
                cx = 0
                cy = scroll_top
        el [ c == 109 ]
            sgr[]
        el [ c == 104 ]
            set_mode[ true ]
        el [ c == 108 ]
            set_mode[ false ]
        el [ c == 115 ]
            cur_save_x = cx
            cur_save_y = cy
        el [ c == 117 ]
            cx = cur_save_x
            cy = cur_save_y
        el [ c == 110 ]
            if [ first_arg == 6 ]
                send_esc[ '[{cy + 1};{cx + 1}R' ]
            el [ first_arg == 5 ]
                send_esc[ '[0n' ]
        el [ c == 99 ]
            send_esc[ '[?1;2c' ]

    # an OSC ended: 0 and 2 set the title (1 is the icon's name)
    func osc_end []
        n : i32 [ (osc) ? i32[ osc.count ] : 0 ]
        # 133;...: the shell's marks round each command
        if [ n > 4 && osc[ 0 ] == 49 && osc[ 1 ] == 51
             && osc[ 2 ] == 51 && osc[ 3 ] == 59 ]
            mb : local i8 [ 1025 ]
            for [ i: i32 4, i < n, i += 1 ]
                mb[ i - 4 ] = i8[ osc[ i ] ]
            mb[ n - 4 ] = 0
            shell_mark[ string[ @mb[0] ] ]
            return
        if [ n < 2 || osc[ 1 ] != 59 ] return
        k : i32 [ osc[ 0 ] ]
        if [ k != 48 && k != 50 ] return
        tb : local i8 [ 1025 ]
        for [ i: i32 2, i < n, i += 1 ]
            tb[ i - 2 ] = i8[ osc[ i ] ]
        tb[ n - 2 ] = 0
        title = string[ @tb[0] ]

    # the log's line under the cursor (scrollback, then screen)
    func line_here [] -> i32
        return i32[ scrollback.count ] + cy

    # C: the output begins (the command is the line above);
    # D;code;command: it ended
    func shell_mark [ m: string ]
        if [ m.starts_with[ 'C' ] ]
            run_from = line_here[]
            run_us   = epoch_micros[]
            if [ run_from > 0 ]
                if [ !cmd_lines ] cmd_lines = vec i32 []
                cmd_lines.push[ run_from - 1 ]
            above : string line_get[ run_from - 1 ]
            pa : i32 [ i32[ above.index_of[ '> ' ] ] ]
            run_cmd = (pa >= 0) ? above.mid[ pa + 2,
                above.count - pa - 2 ] : above
            return
        if [ !m.starts_with[ 'D' ] || run_from < 0 ] return
        rest : string m.mid[ 2, m.count - 2 ]
        sc : i32 [ i32[ rest.index_of[ ';' ] ] ]
        code : i32 [ (sc > 0) ? i32[ rest.mid[ 0, sc ].integer_value[] ]
            : 0 ]
        cmd : string [ (sc >= 0) ? rest.mid[ sc + 1,
            rest.count - sc - 1 ].trim[] : '' ]
        if [ cmd.count == 0 ] cmd = run_cmd
        to : i32 [ line_here[] + ((cx > 0) ? 1 : 0) ]
        secs : f64 [ f64[ epoch_micros[] - run_us ] / 1000000.0 ]
        if [ cmd && cmd.count > 0 ]
            runs.push[ ConsoleRun [ cmd: cmd, code: code,
                out: span_text[ run_from, to ], secs: secs ] ]
        run_from = -1

    # lines first up to last, the blank ones at either end left out
    func span_text [ first: i32, last: i32 ] -> string
        lo : i32 [ max[ first, 0 ] ]
        hi : i32 [ min[ last, line_count[] ] ]
        while [ lo < hi && line_get[ lo ].trim[].count == 0 ] lo += 1
        while [ hi > lo && line_get[ hi - 1 ].trim[].count == 0 ]
            hi -= 1
        out : string ''
        for [ i: i32 lo, i < hi, i += 1 ]
            out = (i == lo) ? line_get[ i ] : '{out}\n{line_get[ i ]}'
        return out

    # the last n commands with their output, the running one last;
    # a program's session (no shell marks): its last 200 lines
    public func transcript [ n: i32 ] -> string
        if [ runs.count == 0 && run_from < 0 ] return tail_lines[ 200 ]
        out : string ''
        from : i32 [ max[ i32[ runs.count ] - n, 0 ] ]
        for [ i: i32 from, i < i32[ runs.count ], i += 1 ]
            r : ConsoleRun runs[ i ]
            out = '{out}$ {r.cmd}\n{r.out}\n[exit {r.code}, {r.secs} s]\n\n'
        if [ run_from >= 0 ]
            secs : f64 [ f64[ epoch_micros[] - run_us ] / 1000000.0 ]
            live : string span_text[ run_from, line_here[] + 1 ]
            out = '{out}$ {run_cmd}\n{live}\n[running, {secs} s]\n'
        return out

    # the log's last n lines, as they show
    public func tail_lines [ n: i32 ] -> string
        hi : i32 [ line_here[] + 1 ]
        return span_text[ max[ hi - n, 0 ], hi ]

    func process_byte [ c: i32 ]
        # UTF-8 continuation bytes assemble the pending codepoint.
        if [ utf_need > 0 ]
            if [ c >= 128 && c < 192 ]
                utf_cp = (utf_cp << 6) | (c & 63)
                utf_need -= 1
                if [ utf_need == 0 ] put_char[ utf_cp ]
                return
            utf_need = 0

        if [ esc_state == 1 ]
            esc_state = 0
            if [ c == 91 ]
                esc_state = 2
                esc_priv  = 0
                esc_pc    = 1
                esc_pi    = 0
                esc_pv[0] = 0
            el [ c == 93 ]
                esc_state = 4
                osc = vec u8 []
            el [ c == 40 || c == 41 || c == 42 || c == 43 ]
                esc_state = 6
            el [ c == 99 ]
                reset_all[]
            el [ c == 55 ]
                cur_save_x = cx
                cur_save_y = cy
            el [ c == 56 ]
                cx = cur_save_x
                cy = cur_save_y
            el [ c == 77 ]
                if [ cy == scroll_top ]
                    scroll_down[]
                el [ cy > 0 ]
                    cy -= 1
            el [ c == 68 ]
                if [ cy == scroll_bot ]
                    scroll_up[]
                el [ cy < rows - 1 ]
                    cy += 1
            el [ c == 69 ]
                cx = 0
                if [ cy == scroll_bot ]
                    scroll_up[]
                el [ cy < rows - 1 ]
                    cy += 1
            return

        if [ esc_state == 2 ]
            if [ c >= 48 && c <= 57 ]
                esc_pv[esc_pi] = esc_pv[esc_pi] * 10 + (c - 48)
                return
            if [ c == 59 ]
                esc_pi += 1
                if [ esc_pi < 16 ]
                    esc_pv[esc_pi] = 0
                    esc_pc = esc_pi + 1
                el
                    esc_pi = 15
                return
            # private markers ? > ! < = : the kitty keyboard pop (CSI <
            # u) was falling through and printing its final byte
            if [ c == 63 || c == 62 || c == 33 || c == 60 || c == 61 ]
                esc_priv = c
                return
            if [ c == 32 || c == 34 || c == 36 || c == 39 || c == 58 ]
                return
            esc_state = 0
            dispatch_csi[ c ]
            return

        if [ esc_state == 4 ]
            if [ c == 7 ]
                esc_state = 0
                osc_end[]
            el [ c == 27 ]
                esc_state = 5
            el [ osc.count < 1024 ]
                osc.push[ u8[ c ] ]
            return
        if [ esc_state == 5 ]
            esc_state = (c == 92) ? 0 : 4
            if [ c == 92 ] osc_end[]
            return
        if [ esc_state == 6 ]
            esc_state = 0
            return

        if [ c == 27 ]
            esc_state = 1
        el [ c == 13 ]
            cx = 0
        el [ c == 10 ]
            if [ cy == scroll_bot ]
                scroll_up[]
            el [ cy < rows - 1 ]
                cy += 1
        el [ c == 8 ]
            if [ cx > 0 ] cx -= 1
        el [ c == 9 ]
            cx = (cx / 8 + 1) * 8
            if [ cx >= cols ] cx = cols - 1
        el [ c == 7 ]
            return
        el [ c >= 32 && c < 127 ]
            put_char[ c ]
        el [ c >= 240 ]
            utf_need = 3
            utf_cp   = c & 7
        el [ c >= 224 ]
            utf_need = 2
            utf_cp   = c & 15
        el [ c >= 192 ]
            utf_need = 1
            utf_cp   = c & 31

    func resize [ nr_in: i32, nc_in: i32 ]
        nr : i32 [ (nr_in < 1) ? 1 : nr_in ]
        nc : i32 [ (nc_in < 1) ? 1 : nc_in ]
        if [ nr > 2048 ] nr = 2048
        if [ nc > 2048 ] nc = 2048
        if [ nr == rows && nc == cols ] return
        last_resize_us = epoch_micros[]
        # fewer rows: the top ones go to the scrollback until the
        # cursor's row fits (a shrink never drops the newest lines)
        if [ nr < rows && !in_alt && cy > nr - 1 ]
            k : i32 [ cy - (nr - 1) ]
            scroll_top = 0
            scroll_bot = rows - 1
            for [ i: i32 0, i < k, i += 1 ]
                scroll_up[]
            cy -= k
        orows : i32 [ rows ]
        ocols : i32 [ cols ]
        cols = nc
        rows = nr
        if [ ocols != nc ]
            cc : i32 [ (ocols < nc) ? ocols : nc ]
            cr : i32 [ (orows < nr) ? orows : nr ]
            kept  : i32 [ cr * cc ]
            tmp : vec TermCell [ kept ]
            rb : i64 [ cc * sizeof[ TermCell ] ]
            for [ r: i32 0, r < cr, r += 1 ]
                memcpy[ @tmp[ r * cc ], @screen[ r * ocols ], rb ]
            init_cells[ screen, rows * cols ]
            for [ r: i32 0, r < cr, r += 1 ]
                memcpy[ @screen[ r * nc ], @tmp[ r * cc ], rb ]
        el [ nr > orows ]
            init_cells[ @screen[ orows * cols ], (nr - orows) * cols ]
        scroll_top = 0
        scroll_bot = rows - 1
        if [ cx >= cols ] cx = cols - 1
        if [ cy >= rows ] cy = rows - 1
        ws : local u16 [ 4 ]
        ws[0] = u16[ rows ]
        ws[1] = u16[ cols ]
        ws[2] = 0
        ws[3] = 0
        if [ pty_fd >= 0 ]
            ioctl[ pty_fd, TIOCSWINSZ, @ws[0] ]
        user_scrolled = false

    # true when the app wrote something: the view repaints on that
    func read_output [] -> bool
        if [ pty_fd < 0 ] return false
        read_calls += 1
        buf : local i8 [ 2 ]
        buf[1] = 0
        got : string ''
        for [ i: i32 0, i < 4096, i += 1 ]
            nr : i32 [ read[ pty_fd, @buf[0], 1 ] ]
            if [ nr <= 0 ] break
            got = got + string[ @buf[0] ]
            process_byte[ (i32 buf[0]) & 255 ]
        if [ run_armed && at_prompt[] ]
            running   = false
            run_armed = false
        if [ got.count > 0 && pending && pending.count > 0 ]
            write_input[ pending + '\r' ]
            pending = ''
            if [ running ] run_armed = true
        return got.count > 0

    func feed_fd [ fd: i32 ]
        if [ fd < 0 ] return
        buf : local i8 [ 2 ]
        buf[1] = 0
        for [ i: i32 0, i < 4096, i += 1 ]
            nr : i32 [ read[ fd, @buf[0], 1 ] ]
            if [ nr <= 0 ] break
            process_byte[ (i32 buf[0]) & 255 ]

    func print_text [ s: string ]
        if [ !s ] return
        for [ i: i32 0, i < s.count, i += 1 ]
            process_byte[ (i32 s.chars[i]) & 255 ]

    func write_input [ data: string ]
        if [ pty_fd < 0 ] return
        write[ pty_fd, data.chars, data.count ]

    func send_esc [ tail: string ]
        if [ pty_fd < 0 ] return
        n : i32 [ tail->count ]
        buf : local i8 [ n + 2 ]
        buf[0] = i8[ 27 ]
        for [ i: i32 0, i < n, i += 1 ]
            buf[i + 1] = tail.chars[i]
        write[ pty_fd, @buf[0], n + 1 ]


class TermLineCache
    mutable canvas : Canvas
    mutable li     : i32 [ -1 ]
    mutable hash   : i64 [ -1 ]
    mutable frame  : i32 [ -1 ]

Layer TermLayer
    func draw [ cv: Canvas ]
        con : cast Console [ parent ]
        if [ !con ] return
        s : ConsoleSession con.session[]
        if [ !s ] return
        # a line scrolled part way out is cut at the area's edge
        cv.save[]
        cv.clip_rect[ bounds.x, bounds.y, bounds.w, bounds.h, 0.0, 0.0 ]
        ch : f32 [ paint_term[ cv, con, s, bounds, con.filter*[],
                               con.feed, label_size, label_height ] ]
        cv.restore[]
        # the height whose furthest scroll is its own (the text area's,
        # whole lines): the thumb ends at its track's foot, and a drag
        # reaches as far as the wheel
        con.content_h = (s.max_scroll > 0.0)
            ? s.max_scroll + con.bounds.h : ch
        con.scroll.y  = s.scroll
        con.draw_marks[ cv, s ]

# its scroll's end: followed while the user has not scrolled away; the
# shown scroll eases to its goal (filter_n), a drag moves it at once
func follow_scroll [ con_el: object, s: ConsoleSession, max_s: f32,
                     vh: f32 ]
    con : cast Console [ con_el ]
    s.max_scroll = max_s
    if [ !s.scroll_dragging && !s.user_scrolled ]
        s.scroll_goal = max_s
        # new output follows at once: an eased follow bounces
        s.scroll = max_s
    s.scroll_goal = clamp[ s.scroll_goal, 0.0, max_s ]
    if [ s.scroll_dragging ] s.scroll = s.scroll_goal
    d : f32 [ s.scroll_goal - s.scroll ]
    if [ d > 0.5 || d < -0.5 ]
        s.scroll = filter_n[ s.scroll, s.scroll_goal, 0.3,
                             con.ux.frame_factor ]
        con.needs_frame = true
        con.ux.will_animate = true
    el
        s.scroll = s.scroll_goal
    s.scroll = clamp[ s.scroll, 0.0, max_s ]
    # back at the bottom: it follows again
    if [ s.scroll_goal >= max_s - 1.0 ]
        s.user_scrolled = false

func paint_term [ cv: Canvas, con_el: object, s: ConsoleSession,
                  bounds: rect, flt: string, feed: list string,
                  label_size: f32, label_height: f32 ] -> f32
        con : cast Console [ con_el ]
        if [ label_size > 0.0 ] cv.font_size[ i32[label_size] ]
        lh : f32 [
            round[
                cv.get_line_height[]
                * ((label_height > 0.0) ? label_height : 1.0) ] ]
        if [ lh < 1.0 ] lh = 1.0
        left : f32 [ bounds.x ]
        top : f32 [ bounds.y ]

        has_flt : bool [ flt && flt.count > 0 ]

        if [ s.pty_fd < 0 ]
            if [ !feed ] return 0.0
            n      : i32 [ feed.count ]
            max_s  : f32 [ maxf[ f32[n] * lh - bounds.h, 0.0 ] ]
            follow_scroll[ con, s, max_s, bounds.h ]
            dr     : i32 [ 0 ]
            for [ li: i32 0, li < n, li += 1 ]
                ln : string feed.value_by_index[ li ]
                if [ has_flt && ln.index_of[ flt ] < 0 ] continue
                y : f32 [
                    top + f32[dr] * lh - ((has_flt) ? 0.0 : s.scroll) ]
                dr += 1
                if [ y + lh < bounds.y ] continue
                if [ y > bounds.y + bounds.h ] break
                cv.fill_color[ (err_line[ ln ]) ? '#ff8a80' : '#ccc' ]
                cv.draw_text[ ln,
                    rect [ x: left, y: y, w: bounds.w, h: lh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0,
                            0.0 ], Overflow.visible, null, false ]
            cv.paint[]
            return f32[n] * lh

        cw       : f32 [ cv.measure_text[ 'x' ].w ]
        sc_count : i32 [ s.scrollback.count ]

        # one view sets the size: the one typed into, else the last
        # to claim it (taken once it has not drawn for half a second)
        now : i64 [ Au.epoch_micros[] ]
        typing : bool [ con && con.ux && con.ux.focus == con ]
        if [ typing || !s.sizer || now - s.sizer_us > 500000 ]
            s.sizer = con_el
        if [ cw > 0.0 && lh > 0.0 && s.sizer == con_el ]
            s.sizer_us = now
            dcols : i32 [ bounds.w / cw ]
            drows : i32 [ bounds.h / lh ]
            # a log keeps its lines whole: 2048 columns
            if [ s.nowrap && !s.in_alt ] dcols = 2048
            if [ dcols >= 2 && drows >= 2
                 && (dcols != s.cols || drows != s.rows) ]
                s.resize[ drows, dcols ]

        if [ has_flt ]
            dr : i32 [ 0 ]
            for [ li: i32 0, li < sc_count, li += 1 ]
                ln : string s.scrollback.value_by_index[ li ]
                if [ ln.index_of[ flt ] < 0 ] continue
                y : f32 [ top + f32[dr] * lh ]
                dr += 1
                if [ y + lh < bounds.y ] continue
                if [ y > bounds.y + bounds.h ] break
                mk : i32 [ con.line_mark*[ ln ] ]
                cv.fill_color[ (mk == 2) ? '#ffffff55'
                    : ((err_line[ ln ]) ? '#ff8a80' : '#fff') ]
                cv.draw_text[ ln,
                              rect [ x: left, y: y, w: bounds.w,
                                     h: lh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0,
                            0.0 ], Overflow.visible, null, false ]
            for [ r: i32 0, r < s.rows, r += 1 ]
                ln : string s.row_to_string[ r ]
                if [ ln.index_of[ flt ] < 0 ] continue
                y : f32 [ top + f32[dr] * lh ]
                dr += 1
                if [ y + lh < bounds.y ] continue
                if [ y > bounds.y + bounds.h ] break
                mk : i32 [ con.line_mark*[ ln ] ]
                cv.fill_color[ (mk == 2) ? '#ffffff55'
                    : ((err_line[ ln ]) ? '#ff8a80' : '#fff') ]
                cv.draw_text[ ln,
                              rect [ x: left, y: y, w: bounds.w,
                                     h: lh ],
                    vec2f [ 0.0, 0.5 ], vec2f [ 0.0,
                            0.0 ], Overflow.visible, null, false ]
            cv.paint[]
            return f32[dr] * lh

        # a log draws into its own view canvas at x - scroll_x; the
        # view goes down faded at the sides it can scroll toward
        wide : bool [ s.nowrap && !s.in_alt ]
        tc : Canvas cv
        vb : rect bounds
        if [ wide ]
            vb = rect [ x: 0.0, y: 0.0, w: bounds.w, h: bounds.h ]
            tc = view_of[ cv, s, bounds.w, bounds.h ]
            if [ label_size > 0.0 ] tc.font_size[ i32[ label_size ] ]
            wmax : i32 [ 0 ]
            for [ wi: i32 0, wi < sc_count, wi += 1 ]
                wmax = maxi[ wmax, s.sb_line_len[ wi ] ]
            for [ wr: i32 0, wr < s.rows, wr += 1 ]
                wmax = maxi[ wmax, s.row_drawable[ wr ] ]
            s.max_x = maxf[ f32[ wmax + 1 ] * cw - bounds.w, 0.0 ]
            if [ s.scroll_x > s.max_x ] s.scroll_x = s.max_x
            if [ s.scroll_x < 0.0 ] s.scroll_x = 0.0
        el
            s.scroll_x = 0.0
            s.max_x = 0.0
        left = vb.x - s.scroll_x
        top  = vb.y
        base     : i32 [ (s.in_alt) ? 0 : sc_count ]
        live     : i32 [ s.rows ]
        if [ !s.in_alt ]
            live = s.cy + 1
            for [ scan_row: i32 s.rows - 1, scan_row > s.cy, scan_row -= 1 ]
                if [ s.row_drawable[ scan_row ] > 0 ]
                    live = scan_row + 1
                    break
            # no cursor (a log): its empty row after the last line is
            # not a line; the last line sits on the foot
            if [ !s.cursor_visible ]
                while [ live > 0 && s.row_drawable[ live - 1 ] <= 0 ]
                    live -= 1
        total_h  : f32 [ f32[base + live] * lh ]
        # the last line sits on the foot: a resize moves the top's
        # part line, never the text under it
        max_s    : f32 [ maxf[ total_h - vb.h, 0.0 ] ]
        # a fading console: its top line whole, the gap at its foot
        if [ con.scroll_fade > 0.0 && lh > 0.0 && max_s > 0.0 ]
            max_s = ceil[ max_s / lh - 0.01 ] * lh

        follow_scroll[ con, s, max_s, vb.h ]

        s.first_line  = (lh > 0.0) ? i32[ round[ s.scroll / lh ] ] : 0

        s.lh_cache    = lh
        s.cw_cache    = cw

        wtx : f32 [ tc.transform_tx[] ]
        wty : f32 [ tc.transform_ty[] ]
        tc.set_crop[ wtx + vb.x, wty + vb.y,
                     wtx + vb.x + vb.w,
                     wty + vb.y + vb.h ]

        tc.draw_selection[ left, top, lh, cw, s.scroll, vb.y,
                           vb.w, vb.h,
            s.anchor_line, s.anchor_col, s.sel_line, s.sel_col,
            rgba['#264f78'] ]

        fs : i32 [ (label_size > 0.0) ? i32[label_size] : 0 ]
        s.frame_id   += 1
        if [ !s.sb_lines ]   s.sb_lines   = vec TermLineCache []
        if [ !s.live_lines ] s.live_lines = vec TermLineCache []
        if [ cw != s.cache_cw || lh != s.cache_lh ]
            for [ slc: TermLineCache ] in s.sb_lines
                slc.li = -1
            for [ slc: TermLineCache ] in s.live_lines
                slc.li   = -1
                slc.hash = -1
            s.cache_cw = cw
            s.cache_lh = lh

        pm : i32 [ 0 ]
        if [ !s.in_alt && sc_count > 0 ]
            last_li : i32 [ sc_count - 1 ]
            vlo : i32 [ clamp[ i32[ (s.scroll - lh) / lh ], 0,
                               last_li ] ]
            vhi : i32 [ clamp[ i32[ (s.scroll + vb.h) / lh ] + 1,
                               0, last_li ] ]
            for [ slc: TermLineCache ] in s.sb_lines
                if [ slc.li >= 0 && (slc.li < vlo || slc.li > vhi) ]
                    slc.li = -1
            # a wrapped line tags only its first row: the mark carries
            # to the rest
            for [ bi: i32 vlo - 1, bi >= 0 && bi > vlo - 200, bi -= 1 ]
                bm : i32 [
                    con.line_mark*[
                        s.scrollback.value_by_index[ bi ] ] ]
                if [ bm != 0 ]
                    pm = bm
                    break
            for [ li: i32 vlo, li <= vhi, li += 1 ]
                mk : i32 [
                    con.line_mark*[
                        s.scrollback.value_by_index[ li ] ] ]
                if [ mk == 0 ] mk = pm
                el pm = mk
                y : f32 [ top + f32[li] * lh - s.scroll ]
                if [ y + lh < vb.y ] continue
                if [ y > vb.y + vb.h ] break
                if [ wide ]
                    mark_line[ tc, mk, left, y, vb.w, lh ]
                    draw_seen[ tc, s, s.sb_line_buf[ li ],
                               s.sb_line_len[ li ], left, round[ y ],
                               lh, cw, s.scroll_x, vb.w,
                               line_fg[ s.scrollback.value_by_index[
                                   li ] ] ]
                    if [ mk == 2 ] tc.set_opacity[ 1.0 ]
                    continue
                slc : sb_slot[ tc, s, li, fs, lh, cw ]
                if [ slc && slc.canvas ]
                    mark_line[ tc, mk, left, y, vb.w, lh ]
                    tc.draw_canvas[ slc.canvas, left, round[ y ],
                                    f32[ slc.canvas.content_w ], lh ]
                    if [ mk == 2 ] tc.set_opacity[ 1.0 ]

        for [ r: i32 0, r < s.rows, r += 1 ]
            mk : i32 [ con.line_mark*[ s.row_to_string[ r ] ] ]
            if [ mk == 0 ] mk = pm
            el pm = mk
            y : f32 [ top + f32[base + r] * lh - s.scroll ]
            if [ y + lh < vb.y ] continue
            if [ y > vb.y + vb.h ] break
            if [ wide ]
                mark_line[ tc, mk, left, y, vb.w, lh ]
                draw_seen[ tc, s, @s.screen[ r * s.cols ],
                           s.row_drawable[ r ], left, round[ y ], lh,
                           cw, s.scroll_x, vb.w,
                           line_fg[ s.row_to_string[ r ] ] ]
                if [ mk == 2 ] tc.set_opacity[ 1.0 ]
                continue
            lvc : live_slot[ tc, s, r, fs, lh, cw ]
            if [ lvc && lvc.canvas ]
                mark_line[ tc, mk, left, y, vb.w, lh ]
                tc.draw_canvas[ lvc.canvas, left, round[ y ],
                                f32[ lvc.canvas.content_w ], lh ]
                if [ mk == 2 ] tc.set_opacity[ 1.0 ]

        if [ s.hover_link_line >= 0 ]
            uy : f32 [ top + f32[ s.hover_link_line ] * lh - s.scroll ]
            if [ uy + lh > vb.y && uy < vb.y + vb.h ]
                ux : f32 [ left + f32[ s.link_c0 ] * cw ]
                uw  : f32 [ f32[ s.link_c1 - s.link_c0 ] * cw ]
                tc.fill_color[ '#6cb6ff' ]
                tc.stroke_width[ 0.0 ]
                tc.rect_to[ ux, round[ uy + lh - 2.0 ], uw, 1.0 ]

        tc.paint[]
        if [ s.cursor_visible ]
            cur_px : f32 [ left + f32[s.cx] * cw ]
            cur_py : f32 [ top + f32[base + s.cy] * lh - s.scroll ]
            tc.fill_color [ '#ffffff99' ]
            tc.stroke_width[ 0.0 ]
            tc.rect_to     [ cur_px, cur_py, cw, lh ]
            tc.paint[]
        tc.clear_crop[]
        if [ wide ]
            fl : f32 [ (s.scroll_x > 0.5) ? 48.0 : 0.0 ]
            fr : f32 [ (s.scroll_x < s.max_x - 0.5) ? 48.0 : 0.0 ]
            cv.draw_canvas_ramp[ tc, bounds.x, bounds.y, bounds.w,
                                 bounds.h, 0.0, fr, 0.0, fl, 0.0, 0.0 ]
        return total_h

# a line's columns that show in a view scrolled sx px across vw
func draw_seen [ cv: Canvas, s: ConsoleSession, cells: @TermCell,
                 n: i32, left: f32, y: f32, lh: f32, cw: f32,
                 sx: f32, vw: f32, dfg: i32 ]
    if [ n <= 0 || cw <= 0.0 ] return
    c0 : i32 [ maxi[ i32[ sx / cw ] - 1, 0 ] ]
    c1 : i32 [ mini[ i32[ (sx + vw) / cw ] + 2, n ] ]
    if [ c1 <= c0 ] return
    draw_cells[ cv, s, cells, c0, c1 - c0, left + f32[ c0 ] * cw, y,
                lh, cw, dfg ]

# a nowrap session's view canvas, sized to the view and cleared
func view_of [ cv: Canvas, s: ConsoleSession, w: f32, h: f32 ]
        -> Canvas
    vw : i32 [ maxi[ i32[ ceil[ w ] ], 1 ] ]
    vh : i32 [ maxi[ i32[ ceil[ h ] ], 1 ] ]
    if [ !s.view ]
        s.view = Canvas [ vk: cv.vk, w: cv.w, format: Pixel.rgba8,
                          width: vw, height: vh, load_existing: true,
                          tag: 'cons' ]
        s.view.update[]
    el [ s.view.content_w != vw || s.view.content_h != vh ]
        s.view.resize[ vw, vh ]
    s.view.reset[ vec4f [ 0.0, 0.0, 0.0, 0.0 ] ]
    return s.view

# a line that says an error: its words (a compiler's, a build's,
# a failed run's) are read in any case
func err_line [ ln: string ] -> bool
    if [ !ln || ln.count == 0 ] return false
    l : string ln.lcase[]
    return l.index_of[ 'error:' ] >= 0 || l.index_of[ ' error ' ] >= 0
        || l.starts_with[ 'error' ] || l.index_of[ 'fatal' ] >= 0
        || l.index_of[ 'failed' ] >= 0

# a line's plain text colour: reddish for an error, else the
# console's grey (a cell's own colour wins over it)
func line_fg [ ln: string ] -> i32
    return (err_line[ ln ]) ? 0xff8a80 : 0xdddddd

# 2 = another instance's line: faded. the selected one's lines stay
# plain
func mark_line [ cv: Canvas, mk: i32, x: f32, y: f32, w: f32, lh: f32 ]
    if [ mk == 2 ] cv.set_opacity[ 0.35 ]

# block elements (U+2580..U+259F) as quadrant bits: UL=1 UR=2 LL=4 LR=8;
# -1 = not a quadrant glyph
func block_quads [ ch: i32 ] -> i32
    if [ ch == 0x2588 ] return 15
    if [ ch == 0x2580 ] return 3
    if [ ch == 0x2584 ] return 12
    if [ ch == 0x258C ] return 5
    if [ ch == 0x2590 ] return 10
    if [ ch == 0x2596 ] return 4
    if [ ch == 0x2597 ] return 8
    if [ ch == 0x2598 ] return 1
    if [ ch == 0x2599 ] return 13
    if [ ch == 0x259A ] return 9
    if [ ch == 0x259B ] return 7
    if [ ch == 0x259C ] return 11
    if [ ch == 0x259D ] return 2
    if [ ch == 0x259E ] return 6
    if [ ch == 0x259F ] return 14
    return -1

# the font has no block elements: a cell's blocks are painted as
# rectangles
func draw_block [ cv: Canvas, ch: i32, x: f32, y: f32, cw: f32,
                  lh: f32, packed: i32 ]
    if [ ch >= 0x2800 && ch <= 0x28FF ]
        draw_braille[ cv, ch, x, y, cw, lh, packed ]
        return
    cv.stroke_width[ 0.0 ]
    cv.fill_color[ col_of[ packed ] ]
    q : i32 [ block_quads[ ch ] ]
    if [ q >= 0 ]
        hw : f32 [ cw * 0.5 ]
        hh : f32 [ lh * 0.5 ]
        # one rect per paint: the path holds a single rect
        if [ q == 15 ]
            cv.rect_to[ x, y, cw, lh ]
            cv.paint[]
            return
        if [ (q & 1) != 0 ]
            cv.rect_to[ x, y, hw, hh ]
            cv.paint[]
        if [ (q & 2) != 0 ]
            cv.rect_to[ x + hw, y, cw - hw, hh ]
            cv.paint[]
        if [ (q & 4) != 0 ]
            cv.rect_to[ x, y + hh, hw, lh - hh ]
            cv.paint[]
        if [ (q & 8) != 0 ]
            cv.rect_to[ x + hw, y + hh, cw - hw, lh - hh ]
            cv.paint[]
        return
    if [ ch >= 0x2581 && ch <= 0x2587 ]
        # lower eighths: 1/8 .. 7/8 of the cell from the bottom
        eh : f32 [ lh * f32[ ch - 0x2580 ] / 8.0 ]
        cv.rect_to[ x, y + lh - eh, cw, eh ]
    el [ ch >= 0x2589 && ch <= 0x258F ]
        # left eighths: 7/8 .. 1/8 of the cell from the left
        ew : f32 [ cw * f32[ 0x2590 - ch ] / 8.0 ]
        cv.rect_to[ x, y, ew, lh ]
    el [ ch == 0x2594 ]
        cv.rect_to[ x, y, cw, lh / 8.0 ]
    el [ ch == 0x2595 ]
        cv.rect_to[ x + cw * 7.0 / 8.0, y, cw / 8.0, lh ]
    el [ ch >= 0x2591 && ch <= 0x2593 ]
        # shades: a full cell at a quarter, half, three quarters
        cv.fill_color[ rgba [ r: f32[(packed >> 16) & 255] / 255.0,
                              g: f32[(packed >> 8) & 255] / 255.0,
                              b: f32[packed & 255] / 255.0,
                              a: f32[ ch - 0x2590 ] * 0.25 ] ]
        cv.rect_to[ x, y, cw, lh ]
    cv.paint[]

# drawn as geometry, not by the font: block elements and braille
func is_block [ ch: i32 ] -> bool
    return (ch >= 0x2580 && ch <= 0x259F)
        || (ch >= 0x2800 && ch <= 0x28FF)

# braille: its eight dots, two across and four down the cell, each
# drawn when its bit is set (1 2 3 7 down the left, 4 5 6 8 the right)
func draw_braille [ cv: Canvas, ch: i32, x: f32, y: f32, cw: f32,
                    lh: f32, packed: i32 ]
    bits : i32 [ ch - 0x2800 ]
    if [ bits == 0 ] return
    cv.stroke_width[ 0.0 ]
    cv.fill_color[ col_of[ packed ] ]
    dx : f32 [ cw / 2.0 ]
    dy : f32 [ lh / 4.0 ]
    r : f32 [ min[ dx, dy ] * 0.32 ]
    cols : vec i32 [] [ 0, 0, 0, 1, 1, 1, 0, 1 ]
    rows : vec i32 [] [ 0, 1, 2, 0, 1, 2, 3, 3 ]
    for [ i: i32 0, i < 8, i += 1 ]
        if [ (bits & (1 << i)) == 0 ] continue
        cx : f32 [ x + dx * (f32[ cols[ i ] ] + 0.5) ]
        cy : f32 [ y + dy * (f32[ rows[ i ] ] + 0.5) ]
        cv.arc[ cx, cy, r, 0.0, 6.2832 ]
        cv.paint[]

func draw_cells [ cv: Canvas, s: ConsoleSession, cells: @TermCell,
                  off: i32, n: i32, left: f32, y: f32, lh: f32,
                  cw: f32, dfg: i32 ]
    if [ n <= 0 ] return
    c : i32 [ 0 ]
    while [ c < n ]
        fg : i32 [ cells[off + c].fg ]
        bg : i32 [ cells[off + c].bg ]
        at : i32 [ cells[off + c].attr ]
        run_end : i32 [ c + 1 ]
        while [ run_end < n && cells[off + run_end].fg == fg
                && cells[off + run_end].bg == bg
                && cells[off + run_end].attr == at ]
            run_end += 1
        inv : bool [ (at & 4) != 0 ]
        rfg : i32 [
            (inv) ? ((bg < 0) ? 0x000000 : bg)
            : ((fg < 0) ? dfg : fg) ]
        rbg : i32 [ (inv) ? ((fg < 0) ? dfg : fg) : bg ]
        rx : f32 [ left + f32[c] * cw ]
        rw : f32 [ f32[run_end - c] * cw ]
        if [ rbg >= 0 ]
            bc : rgba col_of[ rbg ]
            bc.a = s.cell_alpha
            cv.fill_color[ bc ]
            cv.stroke_width[ 0.0 ]
            cv.rect_to[ rx, y, rw, lh ]
            cv.paint[]
        blank : bool [ true ]
        for [ ci: i32 c, ci < run_end && blank, ci += 1 ]
            if [ cells[off + ci].ch != 32 ] blank = false
        if [ !blank ]
            cv.fill_color[ col_of[ rfg ] ]
            # text runs between block cells; each block cell is geometry
            seg : i32 [ c ]
            for [ ci: i32 c, ci <= run_end, ci += 1 ]
                code : i32 [ (ci < run_end) ? cells[off + ci].ch : 0 ]
                blk : bool [ ci < run_end && is_block[ code ] ]
                if [ ci == run_end || blk ]
                    if [ ci > seg ]
                        txt : string s.cells_text[ cells, off, seg, ci ]
                        cv.draw_text[ txt,
                                      rect [ x: left + f32[seg] * cw,
                                             y: y,
                                             w: f32[ci - seg] * cw + cw,
                                             h: lh ],
                            vec2f [ 0.0, 0.5 ], vec2f [ 0.0,
                                    0.0 ], Overflow.visible, null,
                                    false ]
                    if [ blk ]
                        draw_block[ cv, code, left + f32[ci] * cw, y,
                                    cw,
                                    lh, rfg ]
                    seg = ci + 1
        c = run_end

func draw_row [ cv: Canvas, s: ConsoleSession, r: i32, x: f32, y: f32,
                lh: f32, cw: f32 ]
    draw_cells[ cv, s, s.screen, r * s.cols, s.cols, x, y, lh, cw,
                line_fg[ s.row_to_string[ r ] ] ]

func sb_slot [ cv: Canvas, s: ConsoleSession, li: i32, fs: i32,
               lh: f32, cw: f32 ] -> TermLineCache
    if [ s.sb_line_len[ li ] <= 0 ] return null
    for [ slc: TermLineCache ] in s.sb_lines
        if [ slc.li == li ] return slc
    use : TermLineCache [ null ]
    for [ slc: TermLineCache ] in s.sb_lines
        if [ slc.li < 0 ]
            use = slc
            break
    if [ !use ]
        use = TermLineCache [ ]
        s.sb_lines.push[ use ]
    len  : i32 [ s.sb_line_len[ li ] ]
    cw_i : i32 [ ceil[ f32[len] * cw + cw ] ]
    if [ cw_i < 1 ] cw_i = 1
    lh_i : i32 [ i32[ ceil[ lh ] ] + 1 ]
    if [ !use.canvas ]
        use.canvas = Canvas [ vk: cv.vk, w: cv.w, format: Pixel.rgba8,
                              width: cw_i, height: lh_i,
                              load_existing: true, tag: 'cons' ]
        use.canvas.update[]
    el [ use.canvas.content_w != cw_i || use.canvas.content_h != lh_i ]
        use.canvas.resize[ cw_i, lh_i ]
    use.canvas.reset[ vec4f [ 0.0, 0.0, 0.0, 0.0 ] ]
    if [ fs > 0 ] use.canvas.font_size[ fs ]
    draw_cells[ use.canvas, s, s.sb_line_buf[ li ], 0, len, 0.0, 0.0,
                lh, cw, line_fg[ s.scrollback.value_by_index[ li ] ] ]
    use.canvas.paint[]
    use.li = li
    return use

func row_hash [ s: ConsoleSession, r: i32, n: i32 ] -> i64
    h    : i64 [ n ]
    base : i32 [ r * s.cols ]
    for [ c: i32 0, c < n, c += 1 ]
        idx : i32 [ base + c ]
        h = h * 131 + i64[ s.screen[ idx ].ch ]
        h = h * 131 + i64[ s.screen[ idx ].fg ]
        h = h * 131 + i64[ s.screen[ idx ].bg ]
        h = h * 131 + i64[ s.screen[ idx ].attr ]
    return h

func live_slot [ cv: Canvas, s: ConsoleSession, r: i32, fs: i32,
                 lh: f32, cw: f32 ] -> TermLineCache
    dl : i32 [ s.row_drawable[ r ] ]
    if [ dl <= 0 ] return null
    h : i64 [ row_hash[ s, r, dl ] ]
    for [ slot: TermLineCache ] in s.live_lines
        if [ slot.canvas && slot.hash == h ]
            slot.frame = s.frame_id
            return slot
    use : TermLineCache [ null ]
    for [ slot: TermLineCache ] in s.live_lines
        if [ slot.frame != s.frame_id ]
            use = slot
            break
    if [ !use ]
        use = TermLineCache [ ]
        s.live_lines.push[ use ]
    cw_i : i32 [ ceil[ f32[dl] * cw + cw ] ]
    if [ cw_i < 1 ] cw_i = 1
    lh_i : i32 [ i32[ ceil[ lh ] ] + 1 ]
    if [ !use.canvas ]
        use.canvas = Canvas [ vk: cv.vk, w: cv.w, format: Pixel.rgba8,
                              width: cw_i, height: lh_i,
                              load_existing: true, tag: 'cons' ]
        use.canvas.update[]
    el [ use.canvas.content_w != cw_i || use.canvas.content_h != lh_i ]
        use.canvas.resize[ cw_i, lh_i ]
    use.canvas.reset[ vec4f [ 0.0, 0.0, 0.0, 0.0 ] ]
    if [ fs > 0 ] use.canvas.font_size[ fs ]
    draw_cells[ use.canvas, s, s.screen, r * s.cols, dl, 0.0, 0.0, lh,
                cw, line_fg[ s.row_to_string[ r ] ] ]
    use.canvas.paint[]
    use.hash  = h
    use.frame = s.frame_id
    return use

# packed 0xRRGGBB → rgba (components 0..1).
func col_of [ v: i32 ] -> rgba
    return rgba [ r: f32[(v >> 16) & 255] / 255.0,
                  g: f32[(v >> 8) & 255] / 255.0,
                  b: f32[v & 255] / 255.0, a: 1.0 ]

func keymod [ ev: Event ] -> i32
    m : i32 [ 1 ]
    if [ ev.key.shift ] m += 1
    if [ ev.key.alt ]   m += 2
    if [ ev.key.ctrl ]  m += 4
    return m

func send_cursor [ s: ConsoleSession, ev: Event, letter: string ]
    m : i32 [ keymod[ ev ] ]
    if [ m > 1 ]
        s.send_esc[ '[1;{m}{letter}' ]
    el [ s.app_cursor ]
        s.send_esc[ 'O{letter}' ]
    el
        s.send_esc[ '[{letter}' ]

func send_tilde [ s: ConsoleSession, ev: Event, n: i32 ]
    m : i32 [ keymod[ ev ] ]
    if [ m > 1 ]
        s.send_esc[ '[{n};{m}~' ]
    el
        s.send_esc[ '[{n}~' ]

func send_fkey [ s: ConsoleSession, ev: Event, k: i32 ]
    m : i32 [ keymod[ ev ] ]
    if [ k <= 293 ]
        letter : string [
            (k == 290) ? 'P'
            : ((k == 291) ? 'Q' : ((k == 292) ? 'R' : 'S')) ]
        if [ m > 1 ]
            s.send_esc[ '[1;{m}{letter}' ]
        el
            s.send_esc[ 'O{letter}' ]
    el
        # F5=15 F6=17 F7=18 F8=19 F9=20 F10=21 F11=23 F12=24
        n : i32 [ 15 ]
        if [ k == 295 ]
            n = 17
        el [ k == 296 ]
            n = 18
        el [ k == 297 ]
            n = 19
        el [ k == 298 ]
            n = 20
        el [ k == 299 ]
            n = 21
        el [ k == 300 ]
            n = 23
        el [ k == 301 ]
            n = 24
        send_tilde[ s, ev, n ]

func term_key [ s: ConsoleSession, ev: Event, vh: f32 ] -> bool
    if [ !ev.key.state || !s ] return false
    k : i32 [ i32 ev.key.unicode ]
    if [ (k == 266 || k == 267) && !s.in_alt ]
        lh   : f32 [ (s.lh_cache > 0.0) ? s.lh_cache : 22.0 ]
        page : f32 [ ((vh > 0.0) ? vh : f32[s.rows] * lh) - lh ]
        s.user_scrolled = true
        s.scroll_goal = s.scroll_goal + ((k == 266) ? 0.0 - page : page)
        if [ s.scroll_goal < 0.0 ] s.scroll_goal = 0.0
        if [ s.scroll_goal > s.max_scroll ] s.scroll_goal = s.max_scroll
        return true
    if [ k == 257 ]                       # Enter
        s.typed = true
        s.write_input[ '\r' ]
    # Tab / Shift-Tab (back-tab = CSI Z)
    el [ k == 258 ]
        if [ ev.key.shift ]
            s.send_esc[ '[Z' ]
        el
            s.write_input[ '\t' ]
    el [ k == 256 ]                       # escape
        s.send_esc[ '' ]
    # Backspace (Ctrl → ^H, else DEL)
    el [ k == 259 ]
        s.write_input[ (ev.key.ctrl) ? '\x08' : '\x7f' ]
    el [ k == 265 ]                       # Up
        send_cursor[ s, ev, 'A' ]
    el [ k == 264 ]                       # Down
        send_cursor[ s, ev, 'B' ]
    el [ k == 262 ]                       # Right
        send_cursor[ s, ev, 'C' ]
    el [ k == 263 ]                       # Left
        send_cursor[ s, ev, 'D' ]
    el [ k == 268 ]                       # home
        send_cursor[ s, ev, 'H' ]
    el [ k == 269 ]                       # end
        send_cursor[ s, ev, 'F' ]
    el [ k == 260 ]                       # insert
        send_tilde[ s, ev, 2 ]
    el [ k == 261 ]                       # Delete
        send_tilde[ s, ev, 3 ]
    # PageUp (alt screen / modified)
    el [ k == 266 ]
        send_tilde[ s, ev, 5 ]
    el [ k == 267 ]                       # PageDown
        send_tilde[ s, ev, 6 ]
    el [ k >= 290 && k <= 301 ]           # F1..F12
        send_fkey[ s, ev, k ]
    el [ ev.key.ctrl && k >= 64 && k <= 95 ]
        b : i8 [ k - 64 ]
        write[ s.pty_fd, @b, 1 ]
    return false


element Console
    focusable  : true
    public cbase     : Layer [ fill_color: rgba [ '#202a' ] ]
    public content   : TermLayer [ area: Region { l8px t8px r8px b8px },
                            label_height: 1.0, label_size: 16 ]
    scrollbar : ScrollLayer [ overlay: true,
                              area: Region { l8px t8px r8px b8px },
                              thumb_color: '#fff4',
        thumb_w: 6.0, thumb_min_h: 32.0, thumb_radius: 4.0 ]
    public  session_id : string
    public  feed       : list string
    public  sessions   : map ConsoleSession[string]
    public  launch     : string
    public  cwd        : string
    public  run_line   : string
    mutable last_run   : string
    # the command mark under the pointer (its index + 1; 0 none)
    mutable mark_hover : i32
    # the program's title becomes the app's (a terminal's tab)
    public  titles     : bool
    mutable title_was  : string

    func session [] -> ConsoleSession
        sid : string (session_id && session_id.count > 0) ? session_id : 'default'
        s   : ConsoleSession sessions[sid]
        if [ !s ]
            s = ConsoleSession []
            s.name = sid
            if [ launch && launch.count > 0 ] s.launch_cmd = launch
            if [ cwd && cwd.count > 0 ]       s.cwd = cwd
            if [ sid != 'system' ]
                log 'session[]: creating + starting "{sid}" (launch="{launch}")'
                s.start[]
            sessions[sid] = s
            pristine = false
        return s

    # 0 = plain, 1 = the selected instance's line, 2 = another
    # instance's line
    func line_mark [ ln: string ] -> i32
        return 0

    func filter [] -> string
        if [ !elements ] return null
        t : element elements['console_filter']
        if [ !t ] return null
        return t.edit

    func init []
        if [ !sessions ] sessions = map ConsoleSession[string] []

    # its own shell's output; orbiter reads its sessions too
    public func tick [ w: Window ]
        if [ !sessions ] return
        s : ConsoleSession session[]
        if [ s.read_output[] ] pristine = false
        if [ titles && s.title && '{s.title}' != '{title_was}' ]
            title_was = '{s.title}'
            set_title[ title_was ]

    func launch_agent [ sid: string, cmd: string ]
        s : ConsoleSession sessions[sid]
        if [ s ]
            s.launch_cmd = cmd
            s.restart[]
        el
            s = ConsoleSession []
            s.name = sid
            s.launch_cmd = cmd
            sessions[sid] = s
            s.start[]

    func dispatch [ sid: string, ln: string ]
        s : ConsoleSession sessions[sid]
        if [ !s ]
            s = ConsoleSession []
            s.name = sid
            sessions[sid] = s
        s.launch_cmd = ''
        s.restart[]
        s.pending = ln

    func is_running [ sid: string ] -> bool
        s : ConsoleSession sessions[sid]
        return s->running

    func set_running [ sid: string, r: bool ]
        s : ConsoleSession sessions[sid]
        if [ s ] s.running = r

    func stop [ sid: string ]
        s : ConsoleSession sessions[sid]
        if [ !s ] return
        s.restart[]
        s.running = false

    func on_char [ ev: Event ]
        s : ConsoleSession session[]
        if [ ev.key.alt && ev.key.text && ev.key.text.count > 0 ]
            s.send_esc[ ev.key.text ]
        el
            s.write_input[ ev.key.text ]
        s.typed = true
        # what a press does after its handlers: mark and restyle
        pristine = false
        if [ ux ] ux.restyle = true

    func paste [ text: string ]
        s : ConsoleSession session[]
        if [ !s || !text || text.count == 0 ] return
        if [ s.bracketed_paste ]
            s.send_esc[ '[200~' ]
            s.write_input[ text ]
            s.send_esc[ '[201~' ]
        el
            s.write_input[ text ]

    # the clipboard into the shell: a picture goes to a png file
    # and its path is pasted (an agent reads it); else the text
    func paste_clip []
        if [ !ux ] return
        dir : path '{path.path_cache[ 'paste' ]}'
        dir.make_dir[]
        pic : path '{dir}/paste-{epoch_millis[]}.png'
        if [ ux.paste_picture[ pic ] ]
            paste[ '{pic}' ]
            return
        clip : string ux.get_clipboard[]
        if [ clip && clip.count > 0 ] paste[ clip ]

    # a dropped file path rides the same paste path
    func on_drop [ ev: Event ]
        if [ !ev.key.text || ev.key.text.count == 0 ] return
        paste[ shell_word[ ev.key.text ] ]
        ev.no_default = true

    # a dropped path as one shell word, then a space: a character
    # the shell reads (a space, a quote) takes a backslash
    func shell_word [ t: string ] -> string
        out : string ''
        for [ i: i32 0, i < t.count, i += 1 ]
            c : i32 [ (i32 t.chars[ i ]) & 255 ]
            ok : bool [ (c >= 48 && c <= 57) || (c >= 65 && c <= 90)
                || (c >= 97 && c <= 122) || c == 47 || c == 46
                || c == 45 || c == 95 || c == 43 || c == 58
                || c == 44 || c == 64 || c >= 128 ]
            ch : string t.mid[ i, 1 ]
            out = (ok) ? '{out}{ch}' : '{out}\\{ch}'
        return '{out} '

    func on_key [ ev: Event ]
        s : ConsoleSession session[]
        if [ !s ] return
        # ctrl + shift + v (cmd + v): paste, a picture as its file
        if [ ev.key.state && ((ev.key.ctrl && ev.key.shift)
             || ev.key.meta) && i32[ev.key.unicode] == 86 ]
            paste_clip[]
            return
        # ctrl + c copies a selection; with none (a click leaves an
        # empty one) it goes on to the program as its interrupt
        if [ ev.key.state && (ev.key.ctrl || ev.key.meta)
             && i32[ev.key.unicode] == 67 && s.sel_line >= 0 ]
            txt : string s.selection_text[]
            s.sel_line = -1
            pristine = false
            if [ txt.count > 0 ]
                if [ ux ] ux.set_clipboard[ txt ]
                return
        ele : Layer (layers) ? layers[ 'content' ] : null
        vh  : f32 [ (ele && ele.bounds) ? ele.bounds.h : 0.0 ]
        term_key[ s, ev, vh ]
        # a key the app answers (enter, backspace) echoes back through
        # the pty: repaint as a press would, whatever term_key made of
        # it
        pristine = false
        if [ ux ] ux.restyle = true

    func place_cursor [ ev: Event ]
        s : ConsoleSession session[]
        if [ !s ] return
        ele : Layer (layers) ? layers[ 'content' ] : null
        if [ !ele || !ele.bounds ] return
        if [ s.line_count[] <= 0 ]
            s.sel_line = -1
            return
        lh : f32 [ (s.lh_cache > 0.0) ? s.lh_cache : 22.0 ]
        cw : f32 [ (s.cw_cache > 0.0) ? s.cw_cache : 8.0 ]
        rel_y : f32 [ ev.mouse.pos.y - ele.bounds.y ]
        rel_x : f32 [ ev.mouse.pos.x - ele.bounds.x + s.scroll_x ]
        ln : i32 [ clamp[ rel_y / lh, 0, s.line_count[] - 1 ] ]
        cl : i32 [ clamp[ i32[ round[ rel_x / cw ] ], 0,
                          s.line_get[ ln ].count ] ]
        s.sel_line = ln
        s.sel_col  = cl

    func is_ws [ txt: string, i: i32 ] -> bool
        c : string txt.mid[ i, 1 ]
        return c == ' ' || c == '	'

    func detect_link [ ln: i32, col: i32 ] -> bool
        s : ConsoleSession session[]
        if [ !s ] return false
        txt : string s.line_get[ ln ]
        n : i32 [ txt.count ]
        if [ n <= 0 || col < 0 || col > n ] return false
        # non-space run [a, b) around the column
        a : i32 [ (col < n) ? col : n - 1 ]
        while [ a > 0 && !is_ws[ txt, a - 1 ] ]
            a -= 1
        b : i32 col
        while [ b < n && !is_ws[ txt, b ] ]
            b += 1
        if [ b <= a ] return false
        word  : string txt.mid[ a, b - a ]
        parts : word.split[ ':' ]
        if [ parts.count < 2 ] return false
        fp : string parts[ 0 ]
        if [ fp.count == 0 || !parts[ 1 ].is_numeric[] ] return false
        if [ fp.index_of[ '/' ] < 0 && fp.index_of[ '.' ] < 0 ]
            return false
        s.link_c0 = a
        s.link_c1 = b
        return true

    func open_link_at [ ln: i32, col: i32 ] -> bool
        s : ConsoleSession session[]
        if [ !s ] return false
        if [ !detect_link[ ln, col ] ] return false
        txt   : string s.line_get[ ln ]
        word  : string txt.mid[ s.link_c0, s.link_c1 - s.link_c0 ]
        parts : word.split[ ':' ]
        fp : string parts[ 0 ]
        lno : i32 [ parts[ 1 ].integer_value[] ]
        sc  : i32 [ (parts.count > 2
            && parts[ 2 ].is_numeric[]) ? i32[ parts[ 2 ].integer_value[] ] : 0 ]
        if [ !ux || !ux.app_object ] return false
        app : cast element [ ux.app_object ]
        if [ !app ] return false
        return app.open_at*[ path '{fp}', lno, sc ]

    # a command's mark on the scrollbar's track, as the editor's git
    # rails: its line's place in the whole log, at least 4px tall;
    # null when the track is not shown (the program's own screen, a
    # filter, all of it in view)
    func mark_box [ s: ConsoleSession, i: i32 ] -> rect
        sb : ScrollLayer (layers) ? cast ScrollLayer [
            layers['scrollbar'] ] : null
        cl : Layer (layers) ? layers[ 'content' ] : null
        if [ !sb || !sb.bounds || !cl || !cl.bounds || s.in_alt
             || content_h <= bounds.h || !s.cmd_lines ]
            return null
        flt : string filter[]
        if [ flt && flt.count > 0 ] return null
        lh : f32 [ (s.lh_cache > 0.0) ? s.lh_cache : 22.0 ]
        top : f32 [ cl.bounds.y + 8.0 ]
        vis : f32 [ sb.bounds.y + sb.bounds.h - top ]
        if [ vis < 32.0 ] return null
        ry : f32 [ top + f32[ s.cmd_lines[ i ] ] * lh / content_h
                   * vis ]
        rh : f32 [ max[ lh / content_h * vis, 4.0 ] ]
        w : f32 [ sb.thumb_w * 2.0 ]
        rx : f32 [ sb.bounds.x + sb.bounds.w - sb.thumb_w - w * 0.5 ]
        return rect [ x: rx, y: ry, w: w, h: rh ]

    # the marks: the thumb's rest width, half alpha, solid and the
    # track's width under the pointer, fading out as the thumb nears
    # (gone 8px from its edge, full 16px away); the thumb paints over
    func draw_marks [ cv: Canvas, s: ConsoleSession ]
        if [ !s.cmd_lines || !mark_box[ s, 0 ] ] return
        sb : ScrollLayer cast ScrollLayer [ layers['scrollbar'] ]
        cl : Layer layers[ 'content' ]
        thy : f32 [ cl.bounds.y + 8.0 + sb.thumb_y_px ]
        thb : f32 [ thy + sb.thumb_h_px ]
        cv.save[]
        cv.stroke_width[ 0.0 ]
        for [ i: i32 0, i < s.cmd_lines.count, i += 1 ]
            b : rect mark_box[ s, i ]
            d : f32 [ 0.0 ]
            if [ b.y + b.h <= thy ] d = thy - (b.y + b.h)
            el [ b.y >= thb ] d = b.y - thb
            fa : f32 [ clamp[ (d - 8.0) / 8.0, 0.0, 1.0 ] ]
            if [ fa <= 0.0 ] continue
            hv : bool [ mark_hover == i + 1 ]
            rw : f32 [ ((hv) ? b.w : sb.thumb_w) - 2.0 ]
            rr : f32 [ (hv) ? 0.0 : 4.0 ]
            cv.fill_color[ rgba[ r: 0.502, g: 0.42, b: 1.0,
                                 a: ((hv) ? 1.0 : 0.5) * fa ] ]
            cv.rounded_rect[ b.x + (b.w - rw) * 0.5, b.y, rw, b.h, rr,
                             rr, rr, rr ]
            cv.paint[]
        cv.restore[]

    # the command mark at a point (index + 1; 0 none), a few px of
    # slack about each; y in the element's view (its scroll taken off)
    func mark_at [ s: ConsoleSession, x: f32, y: f32 ] -> i32
        if [ !s.cmd_lines ] return 0
        for [ i: i32 0, i < s.cmd_lines.count, i += 1 ]
            b : rect mark_box[ s, i ]
            if [ !b ] return 0
            if [ x >= b.x - 4.0 && x <= b.x + b.w + 4.0
                 && y >= b.y - 3.0 && y <= b.y + b.h + 3.0 ]
                return i + 1
        return 0

    func on_press [ ev: Event ]
        s : ConsoleSession session[]
        if [ !s ] return
        set_focus[]
        # a command's mark: its line shown, a line of the one before
        # above it
        mk : i32 mark_at[ s, ev.mouse.pos.x,
                          ev.mouse.pos.y - scroll.y ]
        if [ mk > 0 && ev.mouse.button == 0 ]
            lh : f32 [ (s.lh_cache > 0.0) ? s.lh_cache : 22.0 ]
            s.user_scrolled = true
            set_scroll[ s, f32[ s.cmd_lines[ mk - 1 ] - 1 ] * lh ]
            return
        # the right button copies the selection; the middle pastes
        if [ ev.mouse.button == 1 ]
            txt : string s.selection_text[]
            if [ txt.count > 0 && ux ] ux.set_clipboard[ txt ]
            s.sel_line = -1
            pristine   = false
            return
        if [ ev.mouse.button == 2 ]
            paste_clip[]
            return
        ele : Layer (layers) ? layers[ 'content' ] : null
        if [ !ele || !ele.bounds ] return
        rel_x : f32 [ ev.mouse.pos.x - ele.bounds.x ]
        sb : ScrollLayer (layers) ? cast ScrollLayer [
            layers['scrollbar'] ] : null
        grab : f32 [ (sb
            && sb.thumb_w > 0.0) ? sb.thumb_w * 2.0 + 8.0 : 16.0 ]
        if [ sb && sb.scroll_max > 0.0 && rel_x > ele.bounds.w - grab ]
            my : f32 [ ev.mouse.pos.y - ele.bounds.y - scroll.y ]
            sb.grab_at[ my ]
            sy : f32 [ sb.drag_to[ my ] ]
            if [ sy >= 0.0 ]
                s.scroll_dragging = true
                sb.active         = true
                set_scroll[ s, sy ]
            return
        place_cursor[ ev ]
        if [ open_link_at[ s.sel_line, s.sel_col ] ]
            s.sel_line = -1
            pristine    = false
            ev.no_propagation = true
            ev.no_default     = true
            return
        if [ !ev.key.shift ]
            s.anchor_line = s.sel_line
            s.anchor_col  = s.sel_col
        s.dragging = true
        pristine = false

    func on_move [ ev: Event ]
        s : ConsoleSession session[]
        if [ !s ] return
        mk : i32 mark_at[ s, ev.mouse.pos.x,
                          ev.mouse.pos.y - scroll.y ]
        if [ mk != mark_hover ]
            mark_hover = mk
            pristine = false
        ele : Layer (layers) ? layers[ 'content' ] : null
        if [ s.scroll_dragging && ele && ele.bounds ]
            sb : ScrollLayer (layers) ? cast ScrollLayer [
                layers['scrollbar'] ] : null
            if [ sb ]
                sy : f32 [
                    sb.drag_to[
                        ev.mouse.pos.y - ele.bounds.y - scroll.y ] ]
                if [ sy >= 0.0 ] set_scroll[ s, sy ]
            return
        if [ s.dragging ]
            place_cursor[ ev ]
            pristine = false
            return
        if [ !ele || !ele.bounds || s.line_count[] <= 0 ] return
        lh : f32 [ (s.lh_cache > 0.0) ? s.lh_cache : 22.0 ]
        cw : f32 [ (s.cw_cache > 0.0) ? s.cw_cache : 8.0 ]
        rel_y : f32 [ ev.mouse.pos.y - ele.bounds.y ]
        rel_x : f32 [ ev.mouse.pos.x - ele.bounds.x + s.scroll_x ]
        hln : i32 [ clamp[ rel_y / lh, 0, s.line_count[] - 1 ] ]
        hcl : i32 [ clamp[ i32[ round[ rel_x / cw ] ], 0,
                           s.line_get[ hln ].count ] ]
        prev_line : i32 [ s.hover_link_line ]
        prev_c   : i32 [ s.link_c0 ]
        hit : bool [ detect_link[ hln, hcl ] ]
        new_line : i32 [ (hit) ? hln : -1 ]
        if [ new_line != prev_line || (hit && s.link_c0 != prev_c) ]
            s.hover_link_line = new_line
            pristine = false

    func on_release [ ev: Event ]
        s : ConsoleSession session[]
        if [ !s ] return
        s.dragging        = false
        s.scroll_dragging = false
        sb : ScrollLayer (layers) ? cast ScrollLayer [
            layers['scrollbar'] ] : null
        if [ sb ]
            sb.active = false
            ux.will_animate = true

    func on_leave [ ev: Event ]
        if [ mark_hover != 0 ]
            mark_hover = 0
            pristine = false
        s : ConsoleSession session[]
        if [ s && s.hover_link_line >= 0 ]
            s.hover_link_line = -1
            pristine = false

    func set_scroll [ s: ConsoleSession, target: f32 ]
        lh : f32 [ (s.lh_cache > 0.0) ? s.lh_cache : 22.0 ]
        ns : f32 [ target ]
        # whole lines counted up from the foot (its last line flush)
        if [ lh > 0.0 ]
            ns = s.max_scroll - round[ (s.max_scroll - ns) / lh ] * lh
        if [ ns < 0.0 ] ns = 0.0
        if [ ns > s.max_scroll ] ns = s.max_scroll
        s.scroll_goal = ns
        # a drag moves it at once; else it eases there as it draws
        if [ s.scroll_dragging ] s.scroll = ns
        scroll.y = s.scroll
        s.user_scrolled = ns < s.max_scroll - 1.0
        pristine = false
        ux.will_animate = true

    func scroll_by [ s: ConsoleSession, dy: f32 ]
        set_scroll[ s, s.scroll_goal + dy ]

    # the wheel as mouse buttons 64 (up) and 65 (down), one a notch
    # (a notch is 4 of the wheel's units), at the pointer's cell
    func wheel_report [ s: ConsoleSession, ev: Event, lh: f32 ]
        ele : Layer (layers) ? layers[ 'content' ] : null
        cw : f32 [ (s.cw_cache > 0.0) ? s.cw_cache : 8.0 ]
        col : i32 [ 1 ]
        row : i32 [ 1 ]
        if [ ele && ele.bounds ]
            col = clamp[ i32[ (ev.mouse.pos.x - ele.bounds.x) / cw ] + 1,
                         1, s.cols ]
            row = clamp[ i32[ (ev.mouse.pos.y - ele.bounds.y) / lh ] + 1,
                         1, s.rows ]
        s.wheel_accum = s.wheel_accum + ev.mouse.wheel_delta.y / 4.0
        while [ s.wheel_accum >= 1.0 || s.wheel_accum <= -1.0 ]
            up : bool [ s.wheel_accum > 0.0 ]
            s.wheel_accum = s.wheel_accum + ((up) ? -1.0 : 1.0)
            b : i32 [ (up) ? 64 : 65 ]
            if [ s.mouse_sgr ]
                s.send_esc[ '[<{b};{col};{row}M' ]
            el
                bs : local i8 [ 4 ]
                bs[0] = i8[ 32 + b ]
                bs[1] = i8[ min[ 32 + col, 255 ] ]
                bs[2] = i8[ min[ 32 + row, 255 ] ]
                bs[3] = 0
                ms : string [ @bs[0] ]
                s.send_esc[ '[M{ms}' ]

    func on_wheel [ ev: Event ]
        s : ConsoleSession session[]
        if [ !s ] return
        # its text scrolls: no default
        ev.no_default = true
        lh : f32 [ (s.lh_cache > 0.0) ? s.lh_cache : 22.0 ]
        # the program reads the mouse (claude's own scrolling view):
        # a wheel event at the pointer's cell for each notch
        if [ s.mouse_report ]
            wheel_report[ s, ev, lh ]
            return
        # sideways: shift + wheel, or the wheel's own x
        dx : f32 [ ev.mouse.wheel_delta.x ]
        if [ ev.key.shift || (ux && ux.shift) ]
            dx = dx + ev.mouse.wheel_delta.y
        if [ s.nowrap && dx != 0.0 ]
            cw : f32 [ (s.cw_cache > 0.0) ? s.cw_cache : 8.0 ]
            s.scroll_x = clamp[ s.scroll_x - dx * cw * 3.0, 0.0,
                                s.max_x ]
            pristine = false
            ux.will_animate = true
            return
        s.wheel_accum = s.wheel_accum - ev.mouse.wheel_delta.y * 3.0
        lines : i32 [ s.wheel_accum ]
        if [ lines != 0 ]
            s.wheel_accum = s.wheel_accum - f32[ lines ]
            scroll_by[ s, f32[ lines ] * lh ]


Layer CompileLayer
    func draw [ cv: Canvas ]
        con : cast CompileConsole [ parent ]
        if [ !con ] return
        if [ !con.log ] return
        if [ label_size > 0.0 ] cv.font_size[ i32[label_size] ]
        lh   : f32 [
            round[
                cv.get_line_height[]
                * ((label_height > 0.0) ? label_height : 1.0) ] ]
        left   : f32 [ bounds.x ]
        top   : f32 [ bounds.y ]
        n    : i32 [ con.log.count ]
        for [ i: i32 0, i < n, i += 1 ]
            y : f32 [ top + f32[i] * lh ]
            if [ y + lh < bounds.y ] continue
            if [ y > bounds.y + bounds.h ] break
            cv.fill_color[ '#ccc' ]
            cv.draw_text[ con.log.value_by_index[i],
                rect [ x:left, y:y, w:bounds.w, h:lh ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0,
                        0.0 ], Overflow.visible, null, false ]
        cv.paint[]


element CompileConsole
    public log : list string
    func init []
        log = list string []
# a title as a terminal program sets it: ESC ] k ; text BEL
func title_seq [ s: ConsoleSession, k: string, t: string ]
    s.process_byte[ 27 ]
    s.print_text[ ']{k};{t}' ]
    s.process_byte[ 7 ]

# claude code's titles as recorded: working half circles, idle star
expect func t_agent_busy_title [] -> bool
    s : ConsoleSession []
    title_seq[ s, '0', '✳ Claude Code' ]
    idle : bool [ !s.agent_busy[] ]
    title_seq[ s, '0', '◐ Slow counting' ]
    on1 : bool s.agent_busy[]
    title_seq[ s, '2', '◑ Slow counting' ]
    on2 : bool s.agent_busy[]
    title_seq[ s, '0', '✳ Slow counting' ]
    done : bool [ !s.agent_busy[] ]
    log 'agent title: idle {idle} on {on1} {on2} done {done}'
    return idle && on1 && on2 && done

# the console under e: e itself, else the first one inside it
func console_in [ e: element ] -> Console
    if [ !e ] return null
    if [ e inherits Console ] return cast Console [ e ]
    if [ !e.elements ] return null
    for [ c: element, id: string ] in e.elements
        f : Console console_in[ c ]
        if [ f ] return f
    return null
