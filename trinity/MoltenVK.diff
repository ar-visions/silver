+
+	MVKVideoSession* _session;
+	MVKSmallVector<SPSEntry, 1> _spsList;
+	MVKSmallVector<PPSEntry, 1> _ppsList;
+	uint32_t _maxSPSCount;
+	uint32_t _maxPPSCount;
+	uint32_t _updateSequenceCount = 0;
+};
