    -DVULKAN_HEADERS_INSTALL_DIR={install}

ifndef [ ios ]
  ifndef [ android ]
    import KhronosGroup:Vulkan-ValidationLayers/vulkan-sdk-1.4.341.0
      -DVULKAN_HEADERS_INSTALL_DIR={install}
      # windows installs the layer to bin, where VK_LAYER_PATH above cannot see
      # it. BINDIR is this project's only lever on that dir, and its only user,
      # so the dll, its pdb and the manifest land together -- which is what the
      # manifest's own relative library_path needs. unix installs by LIBDIR,
      # so the manifest must point into lib -- a bare filename means dlopen
      # search, which never looks there
      -DCMAKE_INSTALL_BINDIR=share/vulkan/explicit_layer.d
      { (linux) ?? >> sed -i 's|"library_path": "libVkLayer_khronos_validation.so"|"library_path": "../../../lib/libVkLayer_khronos_validation.so"|' {install}/share/vulkan/explicit_layer.d/VkLayer_khronos_validation.json }

