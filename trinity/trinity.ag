Control ShadeRow
    focusable : false
    area    : Region { l0 t0+ r0 h57px }
    divider : Layer [ fill_color: rgba [ '#fff1' ], area: Region { l16px b0 r16px h1px } ]
    open    : Layer [ states: State.selected ]

    func render [] -> Elements
        return null

# the line that goes with a crop: mounted by the window only while it
# asks (shot_ask), along the bottom. Enter sends the line and the crop's
# path to the agent working this tree, interrupting its turn (an empty
# line sends the crop alone); Esc drops both. the keys are taken here,
# before the editable layer and the app see them
# a line of text with a band of light sweeping it left to right: the
# text gradient mirrored about a center that moves with time, its hue
# drifting. t is seconds; the sweep takes 1.6 s and repeats
func shine_text [ cv: Canvas, text: string, b: rect, size: i32, base: rgba, t: f32 ]
    if [ !text || text.count == 0 ] return
    cv.font_size[ size ]
    m    : cv.measure_text[ text ]
    band : f32 [ 90.0 ]
    ph   : f32 [ t / 1.6 ]
    ph   = ph - floor[ ph ]
    ax   : f32 [ cv.transform_tx[] + b.x ]
    ay   : f32 [ cv.transform_ty[] + b.y + b.h * 0.5 ]
    cx   : f32 [ ax - band + ph * (m.w + 2.0 * band) ]
    hi   : rgba [ r: 1.0, g: 1.0, b: 1.0, a: 1.0 ]
    # the mirrored ramp: the fill color sits at the band's midpoint, the
    # gradient color at its ends and beyond (the clamp), so the shine is
    # the fill and the line's own color is the gradient
    cv.fill_color      [ hi ]
    cv.text_grad       [ base ]
    cv.text_color_pos  [ cx - band, ay ]
    cv.text_grad_pos   [ cx, ay ]
    cv.text_grad_mirror[ true ]
    cv.draw_text[ text, b, vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
    cv.paint[]
    cv.text_grad[ rgba [ r: 0.0, g: 0.0, b: 0.0, a: 0.0 ] ]

# a label drawn with the shine while it is fresh (3 s after it changed)
# or while the agent works; label_size and label_color as any face
Layer ShineLayer
    mutable seen  : string
    mutable since : i64
    public  shine_color : rgba
    public  shine_size  : f32

    func draw [ cv: Canvas ]
        if [ !parent ] return
        txt : string [ (parent.label) ? parent.label : '' ]
        if [ txt.count == 0 ] return
        now : i64 [ epoch_millis[] ]
        if [ !seen || seen != txt ]
            seen  = txt
            since = now
        w : Window parent.ux
        live : bool [ (now - since) < 3000 || (w && w.agent_state_busy[]) ]
        # its own color and size: a label_color would have the engine paint
        # the label too (centered), a second copy under the shine
        sz : i32 [ (shine_size > 0.0) ? i32[ shine_size ] : 14 ]
        bc : rgba [ (shine_color) ? shine_color : rgba [ '#cfe6ff' ] ]
        # fitted to the layer with an ellipsis (a crop on this path took
        # the process down with a long line); measured at the draw size
        cv.font_size[ sz ]
        if [ cv.measure_text[ txt ].w > bounds.w ]
            n9 : i32 [ txt.count ]
            while [ n9 > 1 && cv.measure_text[ txt.mid[ 0, n9 ] + '...' ].w > bounds.w ] n9 -= 1
            txt = txt.mid[ 0, n9 ] + '...'
        if [ live ]
            shine_text[ cv, txt, bounds, sz, bc, f32[ now % 100000 ] / 1000.0 ]
            parent.pristine = false
            if [ w ] w.will_animate = true
        el
            cv.font_size[ sz ]
            cv.fill_color[ bc ]
            cv.draw_text[ txt, bounds, vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
            cv.paint[]

# the blurred capture as the ground of the exchange: under the field,
# the notes and the avatar, over the app
Layer ShotGround
    func draw [ cv: Canvas ]
        if [ !parent ] return
        w : Window parent.ux
        if [ !w || !w.screenshot_blur ] return
        cv.draw_image[ w.screenshot_blur.color[],
            rect [ x: bounds.x, y: bounds.y, w: bounds.w, h: bounds.h ] ]
        cv.fill_color[ '#00000040' ]
        cv.rect_to[ bounds.x, bounds.y, bounds.w, bounds.h ]
        cv.paint[]

element ShotBackdrop
    area   : Region { l0 t0 r0 b0 }
    ground : ShotGround []

# entries in a rounded box: each word-wrapped to the box's width, a
# floating rule between them, the newest kept in view when they overflow.
# shine_last lights the final line (the agent's, while it works)
func wrap_note [ cv: Canvas, note: string, maxw: f32 ] -> vec string
    out   : vec string []
    words : note.split[ ' ' ]
    line  : string ''
    for [ wd: string ] in words
        try9 : string [ (line.count > 0) ? '{line} {wd}' : wd ]
        m : cv.measure_text[ try9 ]
        if [ m.w > maxw && line.count > 0 ]
            out.push[ line ]
            line = wd
        el
            line = try9
    if [ line.count > 0 ] out.push[ line ]
    return out

# an entry in either box: a line of text, or a diff with its label as the
# text (open shows the code under it); y0/y1 are laid out for the click
class ShotEntry
    public text : string
    public diff : vec string
    public description : vec string
    public open : bool
    public y0   : f32
    public y1   : f32
    public title_y1 : f32

    func add_description [ detail: string ]
        if [ !detail ] return
        if [ !description ] description = vec string []
        description.push[ detail ]

# tabs to spaces for the text draw (the font has no tab glyph): a diff's
# lines keep their tabs on the wire, the box shows them at 4
func expand_tabs [ s: string, w: i32 ] -> string
    if [ !s || s.index_of[ '\t' ] < 0 ] return s
    out : string ''
    col : i32 [ 0 ]
    for [ i: i32 0, i < s.count, i += 1 ]
        c : i32 [ s.chars[ i ] ]
        if [ c == 9 ]
            n : i32 [ w - (col % w) ]
            for [ k: i32 0, k < n, k += 1 ] out = out + ' '
            col += n
        el
            out = out + s.mid[ i, 1 ]
            col += 1
    return out

func draw_notes [ cv: Canvas, notes: vec ShotEntry, b: rect, color: rgba, shine_last: bool, t9: f32 ]
    if [ !notes || notes.count == 0 ] return
    pad  : f32 [ 12.0 ]
    lh   : f32 [ 18.0 ]
    dlh  : f32 [ 16.0 ]     # a diff line
    gap  : f32 [ 10.0 ]
    maxw : f32 [ b.w - pad * 2.0 ]
    cv.font_size[ 14 ]
    # first pass: the wrapped lines and the height they take
    wrapped : vec Au []
    descriptions : vec Au []
    total   : f32 [ 0.0 ]
    n : i32 [ 0 ]
    for [ en: ShotEntry ] in notes
        title : string [ (en.description || en.diff) ? ((en.open) ? 'v {en.text}' : '> {en.text}') : en.text ]
        ls : vec string wrap_note[ cv, expand_tabs[ title, 4 ], maxw ]
        wrapped.push[ ls ]
        ds : vec string []
        if [ en.description && en.open ]
            for [ detail: string ] in en.description
                rows : vec string wrap_note[ cv, expand_tabs[ detail, 4 ], maxw - 8.0 ]
                if [ rows.count == 0 ] ds.push[ '' ]
                for [ row: string ] in rows
                    ds.push[ row ]
        descriptions.push[ ds ]
        if [ n > 0 ] total += gap
        total += f32[ ls.count ] * lh
        if [ ds.count > 0 ] total += f32[ ds.count ] * lh + 4.0
        if [ en.diff && en.open ] total += f32[ en.diff.count ] * dlh + 4.0
        n += 1
    # newest stays in view: overflow scrolls the oldest out the top
    y : f32 [ b.y + pad ]
    if [ total > b.h - pad * 2.0 ] y = b.y + b.h - pad - total
    # the crop is in world pixels: the canvas translate goes on top of the
    # layer's local rect (as the label path does)
    cx0 : f32 [ cv.transform_tx[] + b.x ]
    cy0 : f32 [ cv.transform_ty[] + b.y ]
    cv.set_crop[ cx0 + 1.0, cy0 + 1.0, cx0 + b.w - 1.0, cy0 + b.h - 1.0 ]
    for [ e: i32 0, e < n, e += 1 ]
        en : ShotEntry notes[ e ]
        ls : vec string wrapped[ e ]
        if [ e > 0 ]
            # the rule floats between entries, inset from the sides
            cv.fill_color[ rgba [ '#ffffff22' ] ]
            cv.rect_to[ b.x + pad + 6.0, y + gap * 0.5 - 0.5, maxw - 12.0, 1.0 ]
            cv.paint[]
            y += gap
        en.y0 = y
        # a diff's label is its own color: it is a control, it opens.
        # the entries before the last are a touch dimmer, so the current
        # one stands out; under the shine the base is a little darker
        # still, for more contrast against the band
        last9 : bool [ e == n - 1 ]
        lc : rgba [ (en.diff || en.description) ? rgba [ '#f2d38a' ] : (last9) ? color : rgba [ r: color.r * 0.82, g: color.g * 0.82, b: color.b * 0.82, a: color.a * 0.8 ] ]
        sb : rgba [ r: color.r * 0.78, g: color.g * 0.78, b: color.b * 0.78, a: color.a ]
        cv.font_size[ 14 ]
        for [ k: i32 0, k < ls.count, k += 1 ]
            ln  : string ls[ k ]
            row : rect [ x: b.x + pad, y: y, w: maxw, h: lh ]
            if [ shine_last && last9 && k == ls.count - 1 && !en.diff ]
                shine_text[ cv, ln, row, 14, sb, t9 ]
            el
                cv.fill_color[ lc ]
                cv.draw_text[ ln, row, vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                cv.paint[]
            y += lh
        en.title_y1 = y
        ds : vec string descriptions[ e ]
        if [ ds.count > 0 ]
            y += 4.0
            cv.fill_color[ rgba [ '#ffffffbb' ] ]
            for [ detail: string ] in ds
                cv.draw_text[ detail, rect [ x: b.x + pad + 8.0, y: y, w: maxw - 8.0, h: lh ], vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                cv.paint[]
                y += lh
        if [ en.diff && en.open ]
            # the code: + green, - red, @@ blue, the rest dim; no wrap
            cv.font_size[ 12 ]
            y += 4.0
            for [ dl0: string ] in en.diff
                dl : string expand_tabs[ dl0, 4 ]
                c0 : i32 [ (dl.count > 0) ? dl.chars[ 0 ] : 32 ]
                dc : rgba [ (c0 == 43) ? rgba [ '#9be49b' ] : (c0 == 45) ? rgba [ '#ff9a9a' ] : (c0 == 64) ? rgba [ '#9ad8ff' ] : rgba [ '#ffffffaa' ] ]
                cv.fill_color[ dc ]
                cv.draw_text[ dl, rect [ x: b.x + pad + 8.0, y: y, w: maxw - 8.0, h: dlh ], vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
                cv.paint[]
                y += dlh
            cv.font_size[ 14 ]
        en.y1 = y
    cv.clear_crop[]

# the user's conversation control: it starts at the middle of the
# screen, the sent lines stack from its top, and its bottom line is the
# editable one (the field is placed under the entries as they grow); one
# rounded frame holds all of it
Layer ShotUserLayer
    mutable logged9 : i32
    func draw [ cv: Canvas ]
        if [ !parent ] return
        w : Window parent.ux
        if [ !w ] return
        pad : f32 [ 12.0 ]
        lh  : f32 [ 18.0 ]
        gap : f32 [ 10.0 ]
        row : f32 [ 40.0 ]     # the editable line
        cv.font_size[ 14 ]
        total : f32 [ 0.0 ]
        n : i32 [ 0 ]
        if [ w.user_notes ]
            for [ note: ShotEntry ] in w.user_notes
                ls : vec string wrap_note[ cv, note.text, bounds.w - pad * 2.0 ]
                if [ n > 0 ] total += gap
                total += f32[ ls.count ] * lh
                n += 1
        eh : f32 [ (n > 0) ? total + pad * 2.0 : 0.0 ]     # the entries' height
        # four rows at most: beyond that the oldest scroll out the top
        max_eh : f32 [ lh * 4.0 + gap * 3.0 + pad * 2.0 ]
        if [ eh > max_eh ] eh = max_eh
        if [ eh > bounds.h - row - pad ] eh = bounds.h - row - pad
        bh : f32 [ eh + row + pad ]
        # the frame hugs the bottom of the element and grows upward
        fy0 : f32 [ bounds.y + bounds.h - bh ]
        # DIAG: does this draw run, and where
        if [ logged9 < 6 ]
            logged9 += 1
            log 'SHOTUSER draw stage={i32[w.draw_stage]} pristine={parent.pristine} anim={parent.animated} cache={parent.cache_canvas != null} bounds={bounds.x},{bounds.y},{bounds.w},{bounds.h} frame_y={fy0} bh={bh} elem={parent.bounds.x},{parent.bounds.y},{parent.bounds.w},{parent.bounds.h}'
        # the frame is the element's own 'frame' layer (the engine's fill and
        # stroke path); it hugs the bottom row and grows upward with entries
        fl : Layer (parent.layers) ? parent.layers[ 'frame' ] : null
        if [ fl && (!fl.bounds || fl.bounds.h != bh) ]
            fl.area = Region [ 'l0 b{i32[bh]}px w{i32[bounds.w]}px h{i32[bh]}px' ]
            parent.pristine = false
        if [ n > 0 ]
            draw_notes[ cv, w.user_notes, rect [ x: bounds.x, y: fy0, w: bounds.w, h: eh ],
                rgba [ '#ffffffcc' ], false, 0.0 ]
            # the rule above the editable line
            cv.fill_color[ rgba [ '#ffffff22' ] ]
            cv.rect_to[ bounds.x + pad + 6.0, fy0 + eh - 0.5, bounds.w - pad * 2.0 - 12.0, 1.0 ]
            cv.paint[]
        # the field is the frame's bottom row: its place is fixed by its
        # own style (and it moves aside with the box), never set here

# bottom center until the first send, then at the bottom left (the
# placement is a Region: a CSS area with a % offset lands wrong)
element ShotUser
    # Region slots are l t r b: a 'bN' in the t slot puts the TOP N px from
    # the bottom, so the box's top sits 594px up and its 420px reach the
    # field's row (H-220 .. H-180) with 6px around it
    area  : Region { l50%-220px b594px w440px h420px }
    frame : Layer [ area: Region [ 'l0 b52px w440px h52px' ], fill_color: rgba [ '#0a0a12cc' ],
        stroke_width: 1.0, stroke_color: rgba [ '#ffffff66' ], radius: Radius [ '12' ] ]
    lines : ShotUserLayer []

# the agent's entries, right of the avatar: the current line shines
# while the agent works
Layer ShotNotesLayer
    mutable shine_dbg : i64
    func draw [ cv: Canvas ]
        if [ !parent ] return
        w : Window parent.ux
        if [ !w ] return
        # DIAG: is the shine drawn, and does the box repaint
        if [ w.agent_busy && (epoch_millis[] / 500) != shine_dbg ]
            shine_dbg = epoch_millis[] / 500
            tt9 : f32 [ f32[ epoch_millis[] % 100000 ] / 1000.0 ]
            ph9 : f32 [ tt9 / 1.6 ]
            log 'SHINE time={w.time} time_scale={w.time_scale} stage={i32[w.draw_stage]} busy={w.agent_busy} pristine={parent.pristine} needs_frame={parent.needs_frame} notes={(w.agent_notes) ? w.agent_notes.count : 0} ms={epoch_millis[]} t={tt9} ph={ph9 - floor[ ph9 ]}'
        draw_notes[ cv, w.agent_notes, bounds, rgba [ '#9ad8ff' ], w.agent_busy, f32[ epoch_millis[] % 100000 ] / 1000.0 ]
        # the shine moves: the box repaints every frame while the agent
        # works (pristine is set back after this draw; needs_frame holds it)
        if [ w.agent_busy && w.agent_notes && w.agent_notes.count > 0 ]
            parent.needs_frame = true
            w.will_animate     = true

element ShotNotes
    # a click on a diff's label opens or closes its code
    func on_press [ ev: Event ]
        w : Window ux
        if [ !w || !w.agent_notes ] return
        my : f32 [ ev.mouse.pos.y ]
        for [ en: ShotEntry ] in w.agent_notes
            if [ (en.diff || en.description) && my >= en.y0 && my < en.title_y1 ]
                en.open  = !en.open
                pristine = false
                w.will_animate = true
                return

    # the agent's box takes the right side, large; the avatar settles at
    # the upper left over the user's small box
    # its bottom is the user's box's bottom (H-174), and the same frame
    area  : Region { l500px t15%+24px r24px b-15%+174px }
    # animated: paints every frame, so the shine on the current line moves
    animated : true
    frame : Layer [ fill_color: rgba [ '#0a0a12cc' ], stroke_width: 1.0,
        stroke_color: rgba [ '#ffffff66' ], radius: Radius [ '12' ] ]
    notes : ShotNotesLayer []

# the agent picker over the prompt: names, one lit; :faded once the
# exchange is a conversation (the pick is made at the first send)
TButtons AgentPick
    public faded : bool
    # cached, unlike a TButtons strip: an uncached child paints into root's
    # cache and the cached backdrop is blitted over it afterward
    no_cache : false
    style : CSS {
        opacity: 1.0
    :faded
        opacity: 0.0, 400ms cubic outward
    }

TextInput ShotPrompt
    area : Region { l50%-212px b220px w424px h40px }
    # the box's frame is the only frame: the field's own body stays clear.
    # the field is the box's bottom row, and moves aside with it
    style : CSS {
        layers.body:
            fill_color: #0000
            stroke_width: 0.0
        layers.face:
            label_color: #ffffff66
            label_size: 16
            editable: true
            label_align: 0.0 0.5
            label_offset: 2.0 0.0
    :focused
        layers.body:
            fill_color: #0000
            stroke_width: 0.0
        layers.face:
            label_color: #ffffff66
    :has_value
        layers.face:
            label_color: #ffffff
    }

    func on_key [ ev: Event ]
        if [ !ev.key.state ] return
        k : i32 [ ev.key.unicode ]
        if [ k != 257 && k != 256 ] return
        w : Window ux
        if [ !w ] return
        if [ k == 257 && w.shot_ask ]
            text : string [ (edit) ? edit : '' ]
            if [ text.count == 0 && (!w.shot_text || w.shot_text.count == 0) && w.agent_view ] return
            # the lines accumulate: a user keeps elaborating, and every send
            # reposts the whole message with the crop
            first9 : bool [ !w.shot_text || w.shot_text.count == 0 ]
            all : string [ (!first9) ? ((text.count > 0) ? '{w.shot_text}\n{text}' : w.shot_text) : text ]
            ref9 : string [ (w.shot_file) ? ((w.shot_line > 0) ? 'File: {w.shot_ask}:{w.shot_line}' : 'File: {w.shot_ask}') : 'Screenshot: {w.shot_ask}' ]
            msg : string [ (all.count > 0) ? '{all}\n\n{ref9}' : ref9 ]
            # Every turn carries its own reply address.
            if [ w.agent_sock ]
                msg = '{msg}\n\nReply through this app as well, on the unix socket {w.agent_sock}, one wire line per text line: message titles as: app status note <line>, optional expandable descriptions as: app status description <line>, and each edit you apply as its own diff (the lines you removed and added, never a git diff of the tree, which holds the user\'s changes too): app status diff <line>'
            # the picker's choice is the agent, from the first send on
            if [ w.root && w.root.elements ]
                pk9 : element w.root.elements[ 'agent_pick' ]
                if [ pk9 && pk9 inherits TButtons ]
                    tb9 : TButtons pk9
                    nm9 : vec string agent_names[ w.app_object ]
                    if [ tb9.selected >= 0 && tb9.selected < nm9.count ] w.agent_pick = nm9[ tb9.selected ]
            if [ !w.app_object || !agent_post_as[ w.app_object, w.agent_pick, msg, 'now' ] ]
                w.user_note[ 'Send failed; press Enter to retry' ]
                pristine = false
                w.restyle = true
                ev.stop[]
                return
            w.shot_text = all
            fn9   : string w.shot_ask.filename[]
            shown : string [ (text.count > 0) ? text : fn9 ]
            w.user_note[ shown ]
            # a line from the user means the agent is not done: the app
            # drops its done state (and any reload it was about to apply)
            if [ w.app_object ] w.app_object.on_agent*[ 'status sent {shown}' ]
            w.agent_view = true
            edit       = ''
            sel_col    = 0
            anchor_col = 0
            pristine   = false
            w.restyle  = true
            ev.stop[]
            return
        # Esc: an exchange in progress is put away (the status item brings
        # it back); a prompt with nothing sent yet is dropped
        if [ w.agent_view ]
            w.agent_min = true
            w.restyle   = true
        el
            w.shot_close[]
        ev.stop[]

element UXGenerics
    focusable : false
    mutable show_console : bool
    mutable recording    : bool
    mutable dict_dbg     : bool
    manual target : element   # points at an element, never owns it
    mutable expanded : string

    func on_press [ ev: Event ]
        e : cast element [ ev.origin ]
        if [ !e ] return
        if [ e.id == 'tab' ]
            show_console = !show_console
            if [ ux ] ux.restyle = true
            ev.stop[]
        el [ e.id == 'dictate' ]
            if [ ev.key.shift ]
                if [ ux ] ux.ide_open[]
            el
                recording = !recording
                if [ ux ]
                    ux.dict_on = recording
                    if [ !recording ] ux.capture_context[]
                    # signal orbiter THROUGH the supervisor — reload-proof
                    host_dictate_set[ (recording) ? 1 : 0 ]
                    log 'app: host_dictate_set {(recording) ? 1 : 0}'
                if [ target ] target.on_dictate*[ recording ]
            if [ ux ] ux.restyle = true
            ev.stop[]
        el [ e.id == 'close' || e.id == 'uxgenerics' ]
            show_console = false
            if [ ux ] ux.restyle = true
            ev.stop[]
        el [ ColorPicker (e) && e.parent ]
            rid : string e.parent.id
            expanded = (expanded == rid) ? '' : rid
            if [ ux ] ux.restyle = true
            ev.stop[]

    func render [] -> Elements
        user_events = show_console   # closed = pass-through, shown = modal
        els : Elements [ ]
        if [ show_console ]
            els[ 'scrim' ] = UXShadeScrim [ user_events: false ]
            sheet_els : Elements [ ]
            sheet_els[ 'title' ] = UXShadeTitle [ label: 'Options' ]
            sheet_els[ 'close' ] = UXShadeClose [ label: 'X', focusable: true ]
            if [ target ]
                rows : Elements [ ]
                ty : Au_t typeid[ target ]
                for [ m: i32 0, m < ty.members.count, m += 1 ]
                    mem : Au_t ty.members.origin[m]
                    if [ mem.member_type != 4 ] continue           # AU_MEMBER_VAR
                    if [ !mem.src ] continue                       # need a type
                    if [ (mem.traits & (1 << 51)) != 0 ] continue  # skip mutable
                    is_bool : bool [ mem.src == typeid[ bool ] ]
                    is_enum : bool [ (mem.src.traits & (1 << 5)) != 0 ]  # AU_TRAIT_ENUM
                    is_rgba : bool [ mem.src == typeid[ rgba ] ]
                    is_num  : bool [ mem.src == typeid[ f32 ] ]
                    if [ !is_bool && !is_enum && !is_rgba && !is_num ] continue
                    nm : string mem.ident
                    isopen : bool [ is_rgba && nm == expanded ]
                    row_els : Elements [ ]
                    row_els[ 'name' ] = UXShadeName [ label: nm ]
                    row_els[ 'desc' ] = UXShadeDesc [ label: '' ]
                    if [ is_bool ]
                        pb : @bool [ target.member_ref[ mem ] ]
                        row_els[ 'ctl' ] = Check [ selected: pb[0], focusable: true ]
                    el [ is_enum ]
                        pe : @i32 [ target.member_ref[ mem ] ]
                        row_els[ 'ctl' ] = Tabs [ etype: mem.src, value: pe[0], bound: pe ]
                    el [ is_rgba ]
                        pr : @rgba [ target.member_ref[ mem ] ]
                        row_els[ 'ctl' ] = ColorPicker [ value: pr[0], target: target, mem: mem, selected: isopen, focusable: true ]
                    el [ is_num ]
                        pf : @f32 [ target.member_ref[ mem ] ]
                        row_els[ 'ctl' ] = Slider [ value: pf[0], target: target, mem: mem, minv: 0.0, maxv: 1.0, focusable: true ]
                    rows[ nm ] = ShadeRow [ selected: isopen, elements: row_els ]
                lh_est : f32 [ f32[ rows.count ] * 57.0 ]
                sheet_els[ 'list' ] = UXShadeList [ content_h: lh_est, focusable: true, elements: rows ]
            els[ 'sheet' ] = UXShadeSheet [ elements: sheet_els ]
        els[ 'tab' ]     = UXMenuLeft  [ icon: 'menu', icon_fit: 0.58, manual_mode: true, selected: show_console ]
        if [ recording && ux && !ux.dict_on ] recording = false
        dlv : bool [ (ux) ? ux.dict_live : false ]
        els[ 'dictate' ] = UXMenuRight [ icon: 'orbiter4', icon_fit: 0.7,
            manual_mode: true, selected: recording,
            wait_state: (recording && !dlv), live_state: (recording && dlv) ]
        return els


ModelViewProject UXBackground
    mutable low_color    : vec4f
    mutable high_color   : vec4f
    mutable dim_floor    : f32
    mutable _dpad0       : f32
    mutable _dpad1       : f32
    mutable _dpad2       : f32
    # a > 0: paint this and sample nothing (the solid stage)
    mutable solid_color  : vec4f

    attrib background     : LayoutBinding [ type:typeid[ UXSurface ], id:UXSurface.background,     count:1, format: typeid[ rgba8 ] ]
    attrib frost          : LayoutBinding [ type:typeid[ UXSurface ], id:UXSurface.frost,          count:1, format: typeid[ rgba8 ] ]
    attrib blur           : LayoutBinding [ type:typeid[ UXSurface ], id:UXSurface.blur,           count:1, format: typeid[ rgba8 ] ]
    attrib compose        : LayoutBinding [ type:typeid[ UXSurface ], id:UXSurface.compose,        count:1, format: typeid[ rgba8 ] ]
    attrib pos       : VertexInput    [ type:typeid[ vec3f ] ]
    attrib uv        : VertexInput    [ type:typeid[ vec2f ] ]
    attrib v_uv      : VertexOutput   [ type:typeid[ vec2f ] ]
    attrib fragColor : FragmentOutput [ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        eye:    vec3f [ 0.0, 0.0, 2.0 ]
        center: vec3f [ 0.0, 0.0, 0.0 ]
        up:     vec3f [ 0.0, 1.0, 0.0 ]
        view  = mat4f.look_at[ eye, center, up ]
        proj  = mat4f.ortho[ -1, 1, -1, 1, 0.1, 10.0 ]

    func rgb2hsv [ c: @vec3f ] -> GLSL vec3f {
        vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
        vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
        vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
        float d = q.x - min(q.w, q.y);
        float e = 1.0e-10;
        return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
    }

    func hsv2rgb [ c: @vec3f ] -> GLSL vec3f {
        vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
        vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
        return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
    }

    func vertex [] -> GLSL none {
        v_uv        = uv;
        gl_Position = vec4(pos.x, pos.y, 0.0, 1.0);
    }

    # 44
    func fragment [] -> GLSL none {
        if (ubo.solid_color.a > 0.0) {
            fragColor = vec4(ubo.solid_color.rgb, 1.0);
            return;
        }
        vec4  comp     = texture(compose,        v_uv);
        float luminance = 1.0 - ((comp.b - 0.5020) * 2.0);
        // a backdrop element may ask to keep more of its own light
        luminance = max(luminance, ubo.dim_floor);
        vec3  bgc = texture(background, v_uv).rgb;
        vec3  blc = texture(blur,       v_uv).rgb;
        vec3  frc = texture(frost,      v_uv).rgb;
        vec3  f;

        if (comp.r < 0.5020) {
            f = mix(bgc, blc, comp.r / 0.5020) * luminance;
        } else {
            f = mix(blc, frc, (comp.r - 0.5020) / (1.0 - 0.5020)) * luminance;
        }

        fragColor = vec4(f, 1.0);
    }


expect func test [ vk: vk_context ] -> bool
    w: Display [ vk: vk, format: Pixel.rgba8, backbuffer: true, width: 1024, height: 1024 ]
    c: Canvas [ vk: vk, w: w, width: 1024, height: 1024 ]
    c.update[]

    # outer blob
    c.path.clear[]
    c.path.move_to[ 200.0, 200.0 ]
    c.path.cubic_to[ 400.0, 100.0, 600.0, 300.0, 800.0, 200.0 ]
    c.path.cubic_to[ 900.0, 500.0, 700.0, 700.0, 500.0, 800.0 ]
    c.path.cubic_to[ 300.0, 900.0, 100.0, 600.0, 200.0, 200.0 ]
    c.path.close_path[]

    c.save[]
    c.fill_color[ '#3366AA' ]
    c.paint[]

    # inner cutout (opposite winding)
    c.path.clear[]
    c.path.move_to[ 450.0, 350.0 ]
    c.path.cubic_to[ 550.0, 300.0, 650.0, 400.0, 600.0, 500.0 ]
    c.path.cubic_to[ 550.0, 600.0, 400.0, 550.0, 450.0, 350.0 ]
    c.path.close_path[]
    c.fill_color[ '#0000' ]
    c.paint[]
    c.restore[]
    c.sync_fence[]

    # fetch Texture and verify
    img: Image[c.color]
    p: path 'canvas_test.png'
    img.png[ p ]
    log 'wrote canvas_test.png'

    # average color across Image
    pixels: img.width * img.height
    data: @u8 img.vdata[]
    r_sum: i64 [ 0 ]
    g_sum: i64 [ 0 ]
    b_sum: i64 [ 0 ]
    a_sum: i64 [ 0 ]
    for [ i: i32 0, i < pixels, i += 1 ]
        r_sum += data[i * 4 + 0]
        g_sum += data[i * 4 + 1]
        b_sum += data[i * 4 + 2]
        a_sum += data[i * 4 + 3]
    avg_r: r_sum / pixels
    avg_g: g_sum / pixels
    avg_b: b_sum / pixels
    avg_a: a_sum / pixels
    log 'average color: r={avg_r} g={avg_g} b={avg_b} a={avg_a}'

    return avg_a > 10 && (avg_r > 0 || avg_g > 0 || avg_b > 0)
