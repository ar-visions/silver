scalar sec : i64
    cast -> ns  [ a * 1000000000 ]
    cast -> ms  [ a * 1000 ]

scalar ms : i64
    cast -> sec [ a / 1000 ]
    cast -> ns  [ a * 1000000 ]

scalar ns : i64
    cast -> sec [ a / 1000000000 ]
    cast -> ms  [ a / 1000000 ]

enum HM
    none    : 0
    dictate : 1
    live    : 2
    press   : 3
    release : 4
    move    : 5
    key     : 6
    text    : 7
    # deltas ride as hundredths; position comes from the last move
    wheel   : 8
    resize  : 9
    close   : 10
    shell   : 11
    # app -> ide: a = on/off, b c = the lock centre in app pixels
    lock    : 12
    # ide -> app: draw one frame; a paned app renders in step with the host
    frame   : 13

