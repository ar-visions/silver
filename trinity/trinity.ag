# the launch/live property spec of any object, read from its type: the
# running app answers props with it, and a host enumerates a module by
# building a default instance of its app type and asking the same

func props_of [ target: Au, acc: string ] -> string
    out : string acc
    if [ !target ] return out
    for [ ty : typeid[ target ], ty && ty != typeid[ Au ], ty = ty.context ]
        for [ i: i32 0, i < ty.members.count, i += 1 ]
            mem : Au_t ty.members.origin[i]
            if [ !mem ] continue
            # an Action is a method: it has no value, the host calls it
            if [ mem.member_type == AU_MEMBER_FUNC ]
                fmt : Au_t mem.meta.m
                if [ !fmt || !Au.inherits[ fmt, typeid[ Action ] ] ] continue
                fnm : string [ mem.ident ]
                if [ out && out.count > 0 ]
                    fkey  : string ';{fnm}='
                    fhead : string '{fnm}='
                    if [ out.starts_with[ fhead ] || out.index_of[ fkey ] >= 0 ] continue
                fent : string '{fnm}=action==Action=live'
                out = (out && out.count > 0) ? '{out};{fent}' : fent
                continue
            if [ mem.member_type != AU_MEMBER_VAR ] continue
            mt : Au_t mem.meta.m
            if [ !mt || !Au.inherits[ mt, typeid[ Launch ] ] ] continue
            # an empty literal has no chars: nothing empty is ever interpolated here
            # the enum's stops first: they also say how to print the value
            en : string [ null ]
            if [ mem.src && mem.src.members.count > 0 ]
                for [ k: i32 0, k < mem.src.members.count, k += 1 ]
                    ev : Au_t mem.src.members.origin[k]
                    if [ !ev || ev.member_type != AU_MEMBER_ENUMV ] continue
                    pv : cast @i32 [ ev.value ]
                    iv : i32 [ pv[0] ]
                    evn : string [ ev.ident ]
                    en = (en) ? '{en},{evn}:{iv}' : '{evn}:{iv}'
            v  : target.member_object[ mem ]
            ent : string [ mem.ident ]
            # the app's own member of a name wins over the base's: the app is walked first
            if [ out && out.count > 0 ]
                key  : string ';{ent}='
                head : string '{ent}='
                if [ out.starts_with[ head ] || out.index_of[ key ] >= 0 ] continue
            ent = '{ent}='
            # a cstr must never be truth-tested: the compiler reads it as an object
            if [ mem.src ]
                tn : string [ mem.src.ident ]
                ent = '{ent}{tn}'
            ent = '{ent}='
            # a boxed primitive has no text of its own: print it by its type.
            # a null box IS zero: say 0 (or false), never nothing
            if [ !v && mem.src && (en || mem.src == typeid[ i32 ] || mem.src == typeid[ i64 ] ||
                 mem.src == typeid[ u32 ] || mem.src == typeid[ u64 ] || mem.src == typeid[ bool ]) ]
                ent = (mem.src == typeid[ bool ]) ? '{ent}false' : '{ent}0'
            el [ v && mem.src ]
                if [ en || mem.src == typeid[ i32 ] || mem.src == typeid[ i64 ] ||
                     mem.src == typeid[ u32 ] || mem.src == typeid[ u64 ] || mem.src == typeid[ bool ] ]
                    iv : i32 [ i32[ v ] ]
                    if [ mem.src == typeid[ bool ] ] ent = (iv != 0) ? '{ent}true' : '{ent}false'
                    el ent = '{ent}{iv}'
                el [ mem.src == typeid[ f32 ] || mem.src == typeid[ f64 ] ]
                    fv : f32 [ f32[ v ] ]
                    ent = '{ent}{fv}'
                el [ mem.src == typeid[ string ] || Au.inherits[ mem.src, typeid[ path ] ] ]
                    ent = '{ent}{v}'
            mb : Au_t mem.meta.member_b
            if [ mb && Au.inherits[ mb, typeid[ Range ] ] ]
                rg : Range [ Au.new_object[ mb, null, null, true, __FILE__, __LINE__, __SEQUENCE__ ] ]
                if [ rg ] ent = '{ent}=Range[{rg.min},{rg.max}]'
            el [ mb && Au.inherits[ mb, typeid[ KeyBind ] ] ] ent = '{ent}=Key'
            el [ mb && Au.inherits[ mb, typeid[ Stepper ] ] ]
                sp : Stepper [ Au.new_object[ mb, null, null, true, __FILE__, __LINE__, __SEQUENCE__ ] ]
                if [ sp ] ent = '{ent}=Stepper[{sp.min},{sp.max},{sp.step}]'
            el [ mb && Au.inherits[ mb, typeid[ Color ] ] ]     ent = '{ent}=Color'
            el [ mb && Au.inherits[ mb, typeid[ PadBind ] ] ]   ent = '{ent}=Pad'
            el [ mb && Au.inherits[ mb, typeid[ Directory ] ] ] ent = '{ent}=Dir'
            el [ mb && Au.inherits[ mb, typeid[ Multiline ] ] ] ent = '{ent}=Text'
            el [ en ] ent = '{ent}=Enum[{en}]'
            if [ Au.inherits[ mt, typeid[ Live ] ] ] ent = '{ent}=live'
            out = (out && out.count > 0) ? '{out};{ent}' : ent
    return out


abstract live_app media_app
    context w           : Display*
    context vk          : vk_context
    intern  arg         : object
    intern  destroyed   : bool
    intern  agent_on    : bool
    public  width       : i32
    public  height      : i32
    public  lock_aspect : bool
    # playback gain 0..1, driven by the shell's slider over the socket
    public [ Live, VolumeRange ] volume : f32 [ 1.0 ]
    public  live_reload : bool [ true ]
    public  text_mode   : bool [ false ]
    intern  paned       : bool         # a windowed app showing in orbiter's pane or pip
    intern  frame_req   : bool         # the host asked for a frame (HM.frame)
    intern  pane_reqs   : i32          # DIAG: requests answered this second
    intern  pane_tmo    : i32          # DIAG: frames drawn on the fallback timer
    intern  pane_sec    : i64
    public  screenshot  : path
    # --shot-frame N: which frame to capture (default 60)
    public  shot_frame  : i32 [ 60 ]
    intern  shot_frames : i32
    # --record <file or url>: encode the screen every frame; a url streams live
    public  record      : string
    public  record_fps  : i32 [ 60 ]
    # --record_mic: the microphone goes into the recording, mixed with the app's sound
    public  record_mic  : bool
    intern  recorder    : Recorder
    intern  aac         : Aac
    intern  afed        : i64                # audio frames handed to the encoder
    intern  apcm        : new i16 [ 2048 ]   # one aac block of stereo frames
    intern  aout        : new u8  [ 8192 ]
    intern  path_said   : bool
    intern  next_second : i64
    # a hosted frame's pace: 0 means 60. the frame sleeps out what is left of
    # the interval, not a flat pause on top of however long the frame took
    public  frame_hz    : i32
    intern  frame_due   : i64
    intern  frames      : i32
    # the last whole second's counters, answered to `stats` on the agent socket
    intern  stat_line   : string
    public  attach      : path
    # the shared surface pair + which one we fill next
    intern  share_tex0  : Texture
    intern  share_tex1  : Texture
    intern  share_back  : i32
    intern  share_fence : VkFence          # the copy in flight into share_back
    intern  share_cmd   : VkCommandBuffer
    # one shared surface per instrument, on side 2 + its slot. a toggled
    # off slot keeps its place, so a live instrument's side never moves
    intern  instr_slots : vec string
    intern  instr_cv    : map Canvas  [string]
    intern  instr_t0    : map Texture [string]
    intern  instr_t1    : map Texture [string]
    intern  instr_bk    : map i32     [string]
    # 1 = this instrument paints a view; 1 = it keeps writing to the log
    intern  instr_view  : map i32     [string]
    intern  instr_logs  : map i32     [string]
    # 1 = its descriptor is live for the shell to pull
    intern  instr_pub   : map i32     [string]
    # the WIDTH the shell gives this instrument. the height is ours
    intern  instr_w     : map i32     [string]
    # the entries as last logged: the same again is not written again
    intern  instr_last  : map string  [string]
    intern  instr_ms    : i64
    # test-pattern accounting: publish count and the last interval
    # the built-in memory instrument's samples, oldest first
    intern  mem_hist    : vec f32
    intern  app_pid : i32
    # env protocol, read once in init; every frame reads these
    intern  isolate_app   : bool
    intern  isolate_child : bool
    intern  headless      : bool
    intern  home_dir      : cstr
    # aspect captured at init — resize requests are clamped to it
    intern  aspect_w    : i32
    intern  aspect_h    : i32

    public func parse_app_pid [] -> i32
        pe : getenv[ 'SILVER_ISOLATE_APP_PID' ]
        if [ !pe ] return 0
        ps : string [ pe ]
        return i32[ ps.integer_value[] ]

    # the encoder pipe lives in Au, so a reload keeps writing the same take
    func record_pump []
        if [ !record || !w ] return
        wn  : Window [ w ]
        scv : Canvas [ wn.screen ]
        if [ !scv ] return
        tx  : Texture [ scv.color ]
        if [ !tx || !tx.vk_image ] return
        if [ !recorder ]
            # record is 'path' or 'path@qp'; split the quality (lower QP = better) off the path
            at    : num [ record.index_of[ '@' ] ]
            rpath : string [ (at >= 0) ? record.mid[ 0, at ] : record ]
            rqp   : i32 [ (at >= 0) ? i32[ record.mid[ at + 1, record.count - at - 1 ].integer_value[] ] : 10 ]
            fmt   : record_format[ rpath ]
            fd : i32 [ Au.live_record_get[] ]
            if [ !fd ]
                if [ record_mic ] wn.mic_start[]
                fd = record_spawn[ rpath, fmt ]
                Au.live_record_set[ fd, tx.width, tx.height ]
            recorder = Recorder [ vk: vk, w: w, fd: fd, fps: record_fps, qp: rqp, format: fmt,
                target: record_target[ rpath ], width: Au.live_record_width[], height: Au.live_record_height[] ]
            if [ fmt != 'h264' ]
                aac = Aac [ ]
                recorder.asc = aac.asc
                wn.rec = AudioRing [ ]
        recorder.capture[ tx ]
        if [ recorder.mux ]
            # this process's own sound (its AudioOut tees into its slot's ring)
            wn.record_pull[ host_slot[] ]
            record_audio_pump[ wn ]
            Au.live_record_mux_set[ recorder.mux.seq, recorder.mux.vtime, recorder.mux.atime ]

    # the ring drains in 1024-frame blocks. before the app has any sound source the
    # track is padded with silence to stay level with the video; once it has one,
    # only a stall longer than a second is padded
    func record_audio_pump [ wn: Window ]
        mux : Muxer [ recorder.mux ]
        for [ true ]
            if [ !wn.rec.take[ @apcm[ 0 ], 1024 ] ]
                behind : i64 [ mux.video_samples[] - afed ]
                source : bool [ wn.record_rate > 0 || wn.mic_on ]
                if [ behind < ((source) ? 48000 : 1024) ] break
                memset[ @apcm[ 0 ], 0, 4096 ]
            n : i32 [ aac.encode[ @apcm[ 0 ], @aout[ 0 ], 8192 ] ]
            afed += 1024
            if [ n > 0 ] mux.audio*[ @aout[ 0 ], i64[ n ] ]

    func record_close []
        if [ recorder ] recorder.close[]

    # .mp4 (also .m4v, .mov) is our own fragmented mp4: h.264 + aac; .ts is a
    # transport stream of the same; .h264 is the encoder's annex-b stream as-is.
    # youtube://<stream key>, or an https ingest url ending in file=, goes live over hls
    func record_format [ rpath: string ] -> string
        if [ rpath.ends_with[ '.mp4' ] || rpath.ends_with[ '.m4v' ] || rpath.ends_with[ '.mov' ] ] return 'mp4'
        if [ rpath.ends_with[ '.ts' ] ] return 'ts'
        if [ rpath.ends_with[ '.h264' ] || rpath.ends_with[ '.264' ] ] return 'h264'
        if [ rpath.starts_with[ 'youtube://' ] || rpath.starts_with[ 'https://' ] ] return 'hls'
        expect false, 'record: {rpath}: the target is .mp4 or .ts (h.264 + aac), .h264 (the raw stream), or youtube://<stream key>'
        return null

    func record_target [ rpath: string ] -> string
        if [ rpath.starts_with[ 'youtube://' ] ]
            return 'https://a.upload.youtube.com/http_upload_hls?cid={rpath.mid[ 10, rpath.count - 10 ]}&copy=0&file='
        return rpath

    func record_spawn [ rpath: string, fmt: string ] -> i32
        expect vk.encode_family >= 0, 'record: this gpu has no vulkan video encoder'
        if [ fmt == 'hls' ]
            log 'record: live to {record_target[ rpath ]} (h.264 + aac over hls)'
            return -1
        mode  : i32 [ 0x1A4 ]  # 0644
        flags : i32 [ O_WRONLY | O_CREAT | O_TRUNC ]
        fd    : i32 [ open[ rpath.chars, flags, mode ] ]
        expect fd >= 0, 'record: cannot open {rpath}: {strerror[ errno ]}'
        log 'record: {rpath} ({(fmt == "h264") ? "raw h.264" : "h.264 + aac"})'
        return fd

    func run [ ]
        au_live_set_reload[ (live_reload) ? 1 : 0 ]
        Au.auto_free[true]

    func ux_serialize [ e: element ] -> map object [string]
        em : map object [string] []
        if [ !e ] return em
        hdr : Au.header[ e ]
        em['type'] = string [ hdr.au.ident ]
        if [ e.bounds ]
            em['bounds'] = vec f32 [] [ e.bounds.x, e.bounds.y, e.bounds.w, e.bounds.h ]
        if [ e.label && e.label.count > 0 ]
            em['label'] = e.label
        if [ e.edit && e.edit.count > 0 ]
            em['edit'] = e.edit
        if [ e.focused   ] em['focused']   = 'true'
        if [ e.hovered   ] em['hovered']   = 'true'
        if [ e.hide      ] em['hide']      = 'true'
        if [ e.focusable ] em['focusable'] = 'true'
        if [ e.opacity < 1.0 ] em['opacity'] = '{e.opacity}'
        if [ e inherits ShotNotes && e.ux && e.ux.agent_notes ]
            em['entries'] = e.ux.agent_notes
        if [ e.elements ]
            inner : map object [string] []
            for [ ch: element, k: string ] in e.elements
                if [ ch ] inner[k] = ux_serialize[ ch ]
            if [ inner.count > 0 ] em['elements'] = inner
        return em

    # a hosted app has no display refresh to wait on: sleep until the next
    # frame is due. a frame more than an interval late starts the clock over
    # rather than racing to catch up
    func pace_frame []
        hz   : i32 [ (frame_hz > 0) ? frame_hz : 60 ]
        step : i64 [ 1000000 / i64[ hz ] ]
        now  : i64 [ epoch_micros[] ]
        if [ frame_due == 0 || now - frame_due > step ] frame_due = now
        frame_due += step
        if [ frame_due > now ] usleep[ u32[ frame_due - now ] ]

    func frame [ ] -> bool
        if [ !path_said ]
            path_said = true
            file : fopen[ '/tmp/hostapp-path.log', 'a' ]
            if [ file ]
                fprintf[ file, "app=%s attach=%d isolate=%d slot=%d\n",
                    path.path_share_name[], (attach) ? 1 : 0,
                    (isolate_app) ? 1 : 0, host_slot[] ]
                fclose[ file ]
        if [ w ]
            bwn : Window [ w ]
            # a paned app reads ring 1 in attach_pump: this drain would eat
            # its presses and releases (a lost release is a stuck key)
            if [ !attach && !paned ]
                for [ pk: i32 0, pk < 128, pk += 1 ]
                    ht : i32 [ host_poll[ 1 ] ]
                    if [ ht == 0 ] break
                    if [ ht == i32[ HM.live ] ]
                        bwn.dict_live = host_pa[] != 0
                        bwn.restyle   = true

        ifdef [ unix ]
            if [ attach && isolate_app ]
                render*[]
                record_pump[]
                share_publish[ 1 ]
                ide_pump[]
                agent_pump[]
                Au.auto_free[ false ]
                pace_frame[]
                if [ app_pid > 0 && host_pid_alive[ app_pid ] == 0 ] return false
                return !Au.quit_requested[]
            if [ attach ]
                render*[]
                record_pump[]
                if [ !w.kms ] share_publish[ 0 ]
                if [ !w.kms ] instr_publish[]
                alive : bool [ attach_pump[] ]
                # hosted apps return before the main loop's pump, so the
                # agent socket would never open for the ones we host
                agent_pump[]
                Au.auto_free[ false ]
                pace_frame[]
                return alive && !Au.quit_requested[]
        if [ text_mode ]
            render*[]
            Au.auto_free[false]
            usleep[ 16000 ]
            return !Au.quit_requested[]
        platform_poll[]
        pwn : Window [ w ]
        pwn.pad_pump[]
        ifdef [ unix ]
            agent_pump[]
        second : epoch_millis[] / 1000
        if [ next_second != second ]
            next_second = second
            stat_line = 'fps {frames} submits {vk.submit_calls} syncs {vk.sync_calls} sync_us {vk.sync_us} paints {vk.paint_calls} draws {vk.pipe_draws} draw_us {vk.draw_us} update_us {vk.update_us} sdf_miss {vk.sdf_miss} glyph_miss {vk.glyph_miss} geom_us {vk.geom_us} recreates {vk.swap_recreates} | targets {vk.ph_targets} compose {vk.ph_compose} list {vk.ph_list} screen {vk.ph_screen} swap {vk.ph_swap} | layout {vk.ph_layout} elems {vk.ph_elems} overlay {vk.ph_overlay} flush {vk.ph_flush}'
            if [ pwn.stats ] log '{stat_line}'
            if [ pwn.stats ] log 'paint_us:{pwn.paint_top[]}'
            vk.pipe_draws   = 0
            vk.resize_us    = 0
            vk.resize_calls = 0
            vk.swap_recreates = 0
            vk.ph_targets = 0
            vk.ph_compose = 0
            vk.ph_list    = 0
            vk.ph_screen  = 0
            vk.ph_swap    = 0
            vk.ph_layout  = 0
            vk.ph_elems   = 0
            vk.ph_overlay = 0
            vk.ph_flush   = 0
            frames = 0
            vk.submit_calls = 0
            vk.sync_calls   = 0
            vk.sync_us      = 0
            vk.update_us    = 0
            vk.draw_us      = 0
            vk.paint_calls  = 0
            vk.sdf_hit      = 0
            vk.sdf_miss     = 0
            vk.glyph_miss   = 0
            vk.sdf_rect     = 0
            vk.geom_us      = 0
            vk.render_allocs = 0
            vk.ring_frees    = 0
            vk.bindres_calls = 0
            vk.bindres_us    = 0
            vk.br_schema_us  = 0
        render*[]
        record_pump[]
        ifdef [ unix ]
            win : Window [ w ]
            # a windowed app set to PIP or Full lives on in orbiter's pane: its
            # frames go to its slot, its own window leaves the screen, and
            # orbiter's input and resizes reach it, all without a relaunch
            ao9 : element [ cast element [ win.app_object ] ]
            pane9 : bool [ ao9 && host_slot[] > 0 && i32[ ao9.display ] <= 1 ]
            if [ pane9 != paned ]
                paned = pane9
                win.set_shown[ !pane9 ]
            if [ pane9 ] attach_pump[]
            # the guest display has no ide consumer, and venus faults on the
            # dma-buf export the share path uses — never share on kms
            if [ !w.kms && (isolate_child || pane9) && !win.ide_active ] share_publish[ 0 ]
            if [ !w.kms ] instr_publish[]
            # no present paces a hidden window: the host does. one frame per
            # frame it draws, so the pane shows every frame once, in step;
            # its own refresh rate is the fallback when no request comes
            if [ pane9 ]
                frame_req = false
                hz9  : i32 [ (frame_hz > 0) ? frame_hz : 60 ]
                t09  : i64 [ epoch_micros[] ]
                lim9 : i64 [ 2000000 / i64[ hz9 ] ]
                while [ !frame_req && epoch_micros[] - t09 < lim9 ]
                    attach_pump[]
                    if [ !frame_req ] usleep[ 50 ]
                if [ frame_req ] pane_reqs += 1
                el                pane_tmo  += 1
                psec9 : i64 [ epoch_millis[] / 1000 ]
                if [ psec9 != pane_sec ]
                    if [ pane_sec != 0 && win.stats ] log 'PANED reqs={pane_reqs} timeouts={pane_tmo}'
                    pane_sec  = psec9
                    pane_reqs = 0
                    pane_tmo  = 0
            # a Full pane runs in step with this window: one frame per refresh,
            # so its requests go out at the display's rate, not the loop's
            if [ win.backdrop_bypass ]
                frame_hz = win.refresh_hz[]
                pace_frame[]
        if [ screenshot ]
            shot_frames += 1
            if [ shot_frames >= shot_frame ]
                # no render yet (hidden window, early frame): wait, not crash
                render : w.last_render[]
                if [ render && render.color ]
                    im : Image [ render.color ]
                    # ios cwd is the signed bundle, which is read-only: a
                    # relative shot has nowhere to land. put it in the app
                    # container, where devicectl can copy it back off
                    dest : path [ screenshot ]
                    ifdef [ ios ]
                        if [ home_dir ] dest = path '{home_dir}/Documents/{screenshot}'
                    im.png[ dest ]
                    log 'screenshot: {dest}'
                    record_close[]
                    exit[ 0 ]
        Au.auto_free[false]
        probe : path 'afprobe'
        header : Au.header[ probe ]
        if [ header.managed > 100000 ] log 'AFPOOL ix={header.managed} — pool NOT draining'
        alive : bool [ !platform_window_should_close[ w.glfw ] && !Au.quit_requested[] ]
        if [ !alive ] record_close[]
        return alive

    ifdef [ unix ]
        func share_publish [ side: i32 ]
            if [ headless ] return
            if [ w.kms ] return
            wn : Window [ w ]
            scv : Canvas [ wn.screen ]
            if [ !scv ] return
            tx : Texture [ scv.color ]
            if [ !tx || !tx.vk_image ] return
            #log 'WSIZE win={wn.width}x{wn.height} pend={wn.pending_w}x{wn.pending_h} scv={scv.width}x{scv.height} tex={tx.width}x{tx.height}'
            # a copy still in flight: the frame goes on; it flips once done
            if [ share_fence ]
                if [ !vk.copy_done[ share_fence, share_cmd ] ] return
                share_fence = null
                share_cmd   = null
                host_tex_flip[ host_slot[], side, share_back ]
                share_back = 1 - share_back
            if [ !share_tex0 || share_tex0.width != tx.width || share_tex0.height != tx.height ]
                share_tex0 = Texture [ vk: vk, w: wn, width: tx.width, height: tx.height,
                    vk_format: tx.vk_format, shareable: true ]
                share_tex1 = Texture [ vk: vk, w: wn, width: tx.width, height: tx.height,
                    vk_format: tx.vk_format, shareable: true ]
                share_back = 0
                # no exportable memory on this driver: nothing to share
                if [ share_tex0.shared_fd < 0 || share_tex1.shared_fd < 0 ] return
                host_tex_publish[ host_slot[], side, share_tex0.shared_fd, share_tex1.shared_fd,
                    tx.width, tx.height, i32[ tx.vk_format ] ]
            bt : (share_back == 0) ? share_tex0 : share_tex1
            # in step with the host: the frame it asked for is front before it
            # draws, so the copy waits here. otherwise it runs alongside
            if [ paned ]
                f9 : VkFence [ vk.copy_image_async[ tx, bt ] ]
                c9 : VkCommandBuffer [ vk.copy_cmd_last ]
                if [ f9 ]
                    vkWaitForFences[ vk.device, 1, @f9, VK_TRUE, UINT64_MAX ]
                    vk.copy_done[ f9, c9 ]
                host_tex_flip[ host_slot[], side, share_back ]
                share_back = 1 - share_back
            el
                share_fence = vk.copy_image_async[ tx, bt ]
                share_cmd   = vk.copy_cmd_last

        # every instrument this app offers, in a fixed order — its index
        # IS its surface side. nothing is toggled off, so a name never
        # moves and the shell can address a side without asking
        func instr_list [] -> vec string
            if [ instr_slots && instr_slots.count > 0 ] return instr_slots
            wn : Window [ w ]
            ao : element [ cast element [ wn.app_object ] ]
            ns : vec string []
            vl : (ao) ? ao.instruments*[] : null
            mem : bool [ false ]
            if [ vl ]
                for [ i: i32 0, i < vl.count, i += 1 ]
                    name : '{vl[i]}'
                    if [ name.compare[ 'memory' ] == 0 ] mem = true
                    ns.push[ name ]
            if [ !mem ] ns.push[ 'memory' ]
            while [ ns.count > 8 ] ns.remove[ ns.count - 1 ]
            instr_slots = ns
            return instr_slots

        # a missing key is not a zero: reading one dereferences null
        func instr_has [ m: map i32 [string], nm: string ] -> bool
            if [ !m || !nm ] return false
            if [ !m.contains[ nm ] ] return false
            return m[ nm ] != 0

        # every instrument as 'name:side:log'. side is -1 when it has no
        # view, which is the normal case — a view is only an option
        # every Launch/Live member of the app and of this base, in the
        # host's spec form: name=type=value[=Range[min,max]|=Enum[n:v,..]][=live]
        func props_spec [] -> string
            wn : Window [ w ]
            ao : element [ cast element [ wn.app_object ] ]
            out : string [ null ]
            if [ ao ] out = props_of[ ao, out ]
            out = props_of[ a, out ]
            return out

        func instr_state [] -> string
            rs : string [ '' ]
            sl : instr_list[]
            if [ !sl ] return rs
            for [ i: i32 0, i < sl.count, i += 1 ]
                nm : string sl[i]
                if [ !nm || nm.count == 0 ] continue
                sd : i32 [ (instr_has[ instr_view, nm ]) ? 2 + i : -1 ]
                lg : i32 [ (instr_has[ instr_logs, nm ]) ? 1 : 0 ]
                entry : '{nm}:{sd}:{lg}'
                rs = (rs.count == 0) ? entry : '{rs} {entry}'
            return rs

        # shift+click on the shell's button: keep writing this one to the
        # app log even while nobody is looking at its pane
        func instr_log_toggle [ nm: string ]
            if [ !nm || nm.count == 0 ] return
            if [ !instr_logs ] instr_logs = map i32 [string] []
            instr_logs[ nm ] = (instr_has[ instr_logs, nm ]) ? 0 : 1

        # the entries an instrument reads right now. the app answers for
        # its own; we answer for the memory one every app gets free
        func instr_read [ nm: string ] -> vec string
            wn : Window [ w ]
            ao : element [ cast element [ wn.app_object ] ]
            ls : (ao) ? ao.read_instrument*[ nm ] : null
            if [ ls ] return ls
            # nm is a PARAMETER: == against a literal is false here
            if [ nm.compare[ 'memory' ] == 0 ] return mem_lines[]
            return null

        func mem_lines [] -> vec string
            ls : vec string []
            if [ !mem_hist || mem_hist.count == 0 ] return ls
            last : f32 [ mem_hist[ mem_hist.count - 1 ] ]
            pk : f32 [ 0.0 ]
            lo : f32 [ last ]
            for [ i: i32 0, i < mem_hist.count, i += 1 ]
                if [ mem_hist[i] > pk ] pk = mem_hist[i]
                if [ mem_hist[i] < lo ] lo = mem_hist[i]
            dl : f32 [ last - mem_hist[0] ]
            rss  : i32 [ i32[ last ] / 1024 ]
            peak : i32 [ i32[ pk ] / 1024 ]
            low  : i32 [ i32[ lo ] / 1024 ]
            ls.push[ 'rss      {rss} MB  ({i32[ last ]} KB)' ]
            ls.push[ 'peak     {peak} MB' ]
            ls.push[ 'low      {low} MB' ]
            ls.push[ 'drift    {i32[ dl ]} KB over {mem_hist.count}' ]
            virt  : i64 [ au_mem_virt[] ]
            phys  : i64 [ au_mem_phys[] ]
            vmb   : i64 [ virt / 1048576 ]
            pmb   : i64 [ phys / 1048576 ]
            ls.push[ 'virt     {vmb} MB' ]
            ls.push[ 'phys     {pmb} MB' ]
            return ls

        # the free instrument every app gets: this process's resident set
        # as a share of physical ram, one sample per publish
        func paint_memory [ cv: Canvas, r: rect ]
            if [ !mem_hist || mem_hist.count == 0 ] return
            last : f32 [ mem_hist[ mem_hist.count - 1 ] ]
            pk : f32 [ 0.0 ]
            lo : f32 [ last ]
            for [ i: i32 0, i < mem_hist.count, i += 1 ]
                if [ mem_hist[i] > pk ] pk = mem_hist[i]
                if [ mem_hist[i] < lo ] lo = mem_hist[i]
            # scale to the BAND the samples occupy, not to zero — resident
            # size barely moves, so a zero-based graph is a flat line
            span : f32 [ pk - lo ]
            if [ span < 64.0 ] span = 64.0
            base : f32 [ lo - span * 0.25 ]
            top  : f32 [ pk + span * 0.25 ]
            rng  : f32 [ top - base ]
            gx : f32 [ r.x + 6.0 ]
            gy : f32 [ r.y + 30.0 ]
            gw : f32 [ r.w - 12.0 ]
            gh : f32 [ r.h - 38.0 ]
            cv.stroke_width[ 0.0 ]
            cv.fill_color[ rgba [ '#0d0b14' ] ]
            cv.rect_to[ gx, gy, gw, gh ]
            cv.paint[]
            # a bar is at least ONE pixel. gw/180 is under a pixel in a
            # narrow pane, and drawing bw-1.0 made it negative — that is
            # why the graph was two stray lines
            bw : f32 [ gw / 180.0 ]
            if [ bw < 1.0 ] bw = 1.0
            wp : f32 [ (bw > 2.0) ? bw - 1.0 : bw ]
            cv.fill_color[ rgba [ '#7fb2ff' ] ]
            py : f32 [ -1.0 ]
            for [ i: i32 0, i < mem_hist.count, i += 1 ]
                # newest at the RIGHT edge; anything older than the pane
                # is simply off the left
                bx : f32 [ gx + gw - f32[ mem_hist.count - i ] * bw ]
                if [ bx < gx ]
                    py = -1.0
                    continue
                bh : f32 [ gh * ((mem_hist[i] - base) / rng) ]
                if [ bh < 1.0 ] bh = 1.0
                yy : f32 [ gy + gh - bh ]
                # the LINE only, nothing filled — and joined to the last
                # sample, or a step leaves a gap between the two levels
                if [ py >= 0.0 && py != yy ]
                    y0 : f32 [ (py < yy) ? py : yy ]
                    y1 : f32 [ (py < yy) ? yy : py ]
                    cv.rect_to[ bx, y0, 1.5, y1 - y0 + 1.5 ]
                    cv.paint[]
                cv.rect_to[ bx, yy, wp, 1.5 ]
                cv.paint[]
                py = yy
            cv.font_size[ 11 ]
            cv.fill_color[ rgba [ '#cfd6e4' ] ]
            rss  : i32 [ i32[ last ] / 1024 ]
            peak : i32 [ i32[ pk ] / 1024 ]
            low  : i32 [ i32[ lo ] / 1024 ]
            cv.draw_text[ '{rss} MB  peak {peak}  low {low}',
                rect [ x: gx, y: r.y + 3.0, w: gw, h: 13.0 ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
            cv.paint[]
            virt : i64 [ au_mem_virt[] ]
            vmb  : i64 [ virt / 1048576 ]
            cv.fill_color[ rgba [ '#8a83a0' ] ]
            cv.draw_text[ 'virt {vmb}  n {mem_hist.count}',
                rect [ x: gx, y: r.y + 16.0, w: gw, h: 13.0 ],
                vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
            cv.paint[]

        # instruments are inspectors, not the game: they sample at 8hz, on
        # their OWN surfaces, so nothing here touches the app's frame
        func instr_publish []
            if [ headless ] return
            list : instr_list[]
            if [ !list || list.count == 0 ] return
            now : i64 [ epoch_millis[] ]
            if [ instr_ms != 0 && now - instr_ms < 125 ] return
            instr_ms = now
            if [ !mem_hist ] mem_hist = vec f32 []
            # KILOBYTES resident. the fraction-of-total-ram this used to
            # sample is ~0.001 here, which draws as a flat line
            bytes : i64 [ au_mem_rss[] ]
            kb    : i64 [ bytes / 1024 ]
            mem_hist.push[ f32[ kb ] ]
            while [ mem_hist.count > 180 ] mem_hist.remove[ 0 ]
            wn : Window [ w ]
            ao : element [ cast element [ wn.app_object ] ]
            if [ !instr_view ] instr_view = map i32 [string] []
            for [ i: i32 0, i < list.count, i += 1 ]
                # HOLD it: this is a borrow, and we call into app code
                # below. anything it allocates can reclaim the name, and
                # the next compare then reads freed memory
                nm : string list[i]
                if [ !nm || nm.count == 0 ] continue
                nm.hold[]
                # ONE instrument is on at a time: it logs AND publishes its
                # view. the others neither read nor paint
                if [ !instr_has[ instr_logs, nm ] ]
                    if [ instr_has[ instr_view, nm ] ]
                        instr_view[ nm ] = 0
                        if [ instr_pub ] instr_pub[ nm ] = 0
                        host_tex_clear[ host_slot[], 2 + i ]
                    nm.drop[]
                    continue
                # logging writes the entries to the app log, pane or no pane
                ls : instr_read[ nm ]
                if [ ls ]
                    jn : string [ '' ]
                    for [ k: i32 0, k < ls.count, k += 1 ]
                        jn = '{jn}{ls[k]}\n'
                    if [ !instr_last ] instr_last = map string [string] []
                    was : string (instr_last.contains[ nm ]) ? instr_last[ nm ] : null
                    if [ !was || was.compare[ jn ] != 0 ]
                        instr_last[ nm ] = jn
                        for [ k: i32 0, k < ls.count, k += 1 ]
                            log '[{nm}] {ls[k]}'
                if [ !instr_cv ] instr_cv = map Canvas [string] []
                # the shell says the width; the app says the height
                if [ !instr_w ] instr_w = map i32 [string] []
                iw : i32 [ (instr_w.contains[ nm ]) ? instr_w[ nm ] : 150 ]
                if [ iw < 16 ] iw = 16
                ih : i32 [ (ao) ? ao.instrument_height*[ nm, iw ] : 0 ]
                if [ ih <= 0 ] ih = (nm == 'memory') ? 120 : iw
                if [ ih < 16 ] ih = 16
                cvi : instr_cv[ nm ]
                if [ !cvi ]
                    cvi = Canvas [ w: wn, vk: vk, format: Pixel.rgba8,
                        width: iw, height: ih, load_existing: true ]
                    cvi.update[]
                    instr_cv[ nm ] = cvi
                el [ cvi.width != iw || cvi.height != ih ]
                    cvi.resize[ iw, ih ]
                area : rect [ x: 0.0, y: 0.0, w: f32[ iw ], h: f32[ ih ] ]
                cvi.reset[ vec4f [ 0.04, 0.03, 0.06, 1.0 ] ]
                drew : bool [ (ao) ? ao.paint_instrument*[ cvi, nm, area ] : false ]
                if [ !drew && nm == 'memory' ]
                    paint_memory[ cvi, area ]
                    drew = true
                # no view is the normal case: the entries stand alone, and
                # the shell must not be left pulling a surface we never fill
                if [ !drew ]
                    if [ instr_has[ instr_view, nm ] ]
                        instr_view[ nm ] = 0
                        if [ instr_pub ] instr_pub[ nm ] = 0
                        host_tex_clear[ host_slot[], 2 + i ]
                    nm.drop[]
                    continue
                instr_view[ nm ] = 1
                # the paints are BATCHED into the canvas ring and text is
                # a SECOND render that nothing fences. submit and wait for
                # both, or the copy takes whatever fraction had landed
                cvi.sync_all[]
                instr_share[ nm, 2 + i, cvi ]
                nm.drop[]

        func instr_share [ nm: string, side: i32, cvi: Canvas ]
            tx : Texture [ cvi.color ]
            if [ !tx || !tx.vk_image ] return
            if [ !instr_t0 ] instr_t0 = map Texture [string] []
            if [ !instr_t1 ] instr_t1 = map Texture [string] []
            if [ !instr_bk ] instr_bk = map i32 [string] []
            if [ !instr_pub ] instr_pub = map i32 [string] []
            t0 : instr_t0[ nm ]
            if [ !t0 || t0.width != tx.width || t0.height != tx.height ]
                wn : Window [ w ]
                t0 = Texture [ vk: vk, w: wn, width: tx.width, height: tx.height,
                    vk_format: tx.vk_format, shareable: true ]
                t1 : Texture [ vk: vk, w: wn, width: tx.width, height: tx.height,
                    vk_format: tx.vk_format, shareable: true ]
                instr_t0[ nm ] = t0
                instr_t1[ nm ] = t1
                instr_bk[ nm ] = 0
                instr_pub[ nm ] = 0
            # a cleared descriptor MUST be republished. the textures survive
            # a toggle, so size alone would never publish it again
            if [ !instr_has[ instr_pub, nm ] ]
                instr_pub[ nm ] = 1
                host_tex_publish[ host_slot[], side, instr_t0[ nm ].shared_fd,
                    instr_t1[ nm ].shared_fd, tx.width, tx.height, i32[ tx.vk_format ] ]
            bk : i32 [ (instr_bk.contains[ nm ]) ? instr_bk[ nm ] : 0 ]
            bt : Texture [ (bk == 0) ? instr_t0[ nm ] : instr_t1[ nm ] ]
            vk.copy_image[ tx, bt ]
            host_tex_flip[ host_slot[], side, bk ]
            instr_bk[ nm ] = 1 - bk

        func attach_pump [] -> bool
            wn : Window [ w ]
            for [ i: i32 0, i < 64, i += 1 ]
                t : i32 [ host_poll[ 1 ] ]
                if [ t == 0 ] break
                if [ t == i32[ HM.close ] ] return false
                if [ t == i32[ HM.live ] ]
                    wn.dict_live = host_pa[] != 0
                    wn.restyle   = true
                el [ t == i32[ HM.frame ] ]
                    frame_req = true
                el [ t == i32[ HM.key ] ]
                    wn.ev.clear[]
                    wn.ev.key.unicode = host_pa[]
                    wn.ev.key.state   = host_pb[]
                    mods : i32 [ host_pc[] ]
                    wn.ev.key.shift = (mods & 1) != 0
                    wn.ev.key.ctrl  = (mods & 2) != 0
                    wn.ev.key.alt   = (mods & 4) != 0
                    wn.ev.key.meta  = (mods & 8) != 0
                    wn.key_event[ wn.ev ]
                el [ t == i32[ HM.text ] ]
                    wn.ev.clear[]
                    tb : local i8 [ 2 ]
                    tb[0] = i8[ host_pa[] ]
                    tb[1] = 0
                    wn.ev.key.text = string[ @tb[0] ]
                    wn.text_event[ wn.ev ]
                el [ t == i32[ HM.press ] ]
                    wn.ev.clear[]
                    wn.mouse.x        = f64[ host_pa[] ]
                    wn.mouse.y        = f64[ host_pb[] ]
                    wn.ev.mouse.pos.x = f32[ host_pa[] ]
                    wn.ev.mouse.pos.y = f32[ host_pb[] ]
                    wn.ev.mouse.button = host_pc[]
                    wn.ev.mouse.state  = 1
                    wn.press_event[ wn.ev ]
                el [ t == i32[ HM.release ] ]
                    wn.ev.clear[]
                    wn.ev.mouse.pos.x = f32[ host_pa[] ]
                    wn.ev.mouse.pos.y = f32[ host_pb[] ]
                    wn.ev.mouse.button = host_pc[]
                    wn.ev.mouse.state  = 0
                    wn.release_event[ wn.ev ]
                el [ t == i32[ HM.move ] ]
                    wn.ev.clear[]
                    wn.mouse.x        = f64[ host_pa[] ]
                    wn.mouse.y        = f64[ host_pb[] ]
                    wn.ev.mouse.pos.x = f32[ host_pa[] ]
                    wn.ev.mouse.pos.y = f32[ host_pb[] ]
                    wn.move_event[ wn.ev ]
                el [ t == i32[ HM.wheel ] ]
                    wn.ev.clear[]
                    wn.ev.mouse.pos = [ wn.mouse.x, wn.mouse.y ]
                    wn.ev.mouse.wheel_delta = [ host_pa[] / 100.0, host_pb[] / 100.0 ]
                    mods : i32 [ host_pc[] ]
                    wn.ev.key.shift = (mods & 1) != 0
                    wn.ev.key.ctrl  = (mods & 2) != 0
                    wn.ev.key.alt   = (mods & 4) != 0
                    wn.ev.key.meta  = (mods & 8) != 0
                    wn.wheel_event[ wn.ev ]
                el [ t == i32[ HM.resize ] ]
                    rw : i32 [ host_pa[] ]
                    rh : i32 [ host_pb[] ]
                    # requests are advisory: a locked app answers at its aspect
                    if [ lock_aspect && aspect_w > 0 && aspect_h > 0 && rw > 0 && rh > 0 ]
                        wide : i32 [ rw ]
                        tall : i32 [ wide * aspect_h / aspect_w ]
                        if [ tall > rh ]
                            tall = rh
                            wide = tall * aspect_w / aspect_h
                        rw = wide
                        rh = tall
                    if [ rw > 0 && rh > 0 && (rw != wn.width || rh != wn.height) ]
                        vkQueueWaitIdle[ vk.queue ]
                        wn.resize[ rw, rh ]
                        width  = rw
                        height = rh
            return true

        func ide_pump []
            wn : Window [ w ]
            aa : cast element [ wn.app_object ]
            for [ i: i32 0, i < 64, i += 1 ]
                t : i32 [ host_poll[ 0 ] ]
                if [ t == 0 ] return
                if [ t == i32[ HM.dictate ] || t == i32[ HM.shell ] ]
                    if [ aa ] aa.on_host*[ t, host_pa[], host_pb[], host_pc[] ]
                el [ t == i32[ HM.press ] ]
                    wn.ev.clear[]
                    wn.ev.mouse.pos.x = f32[ host_pa[] ]
                    wn.ev.mouse.pos.y = f32[ host_pb[] ]
                    wn.ev.mouse.button = host_pc[]
                    wn.ev.mouse.state  = 1
                    wn.mouse.x = f64[ host_pa[] ]
                    wn.mouse.y = f64[ host_pb[] ]
                    wn.press_event[ wn.ev ]
                el [ t == i32[ HM.release ] ]
                    wn.ev.clear[]
                    wn.ev.mouse.pos.x = f32[ host_pa[] ]
                    wn.ev.mouse.pos.y = f32[ host_pb[] ]
                    wn.ev.mouse.button = host_pc[]
                    wn.ev.mouse.state  = 0
                    wn.release_event[ wn.ev ]
                el [ t == i32[ HM.move ] ]
                    wn.ev.clear[]
                    wn.ev.mouse.pos.x = f32[ host_pa[] ]
                    wn.ev.mouse.pos.y = f32[ host_pb[] ]
                    wn.mouse.x = f64[ host_pa[] ]
                    wn.mouse.y = f64[ host_pb[] ]
                    wn.move_event[ wn.ev ]
                el [ t == i32[ HM.key ] ]
                    wn.ev.clear[]
                    wn.ev.key.unicode = host_pa[]
                    wn.ev.key.state   = host_pb[]
                    mods : i32 [ host_pc[] ]
                    wn.ev.key.shift = (mods & 1) != 0
                    wn.ev.key.ctrl  = (mods & 2) != 0
                    wn.ev.key.alt   = (mods & 4) != 0
                    wn.ev.key.meta  = (mods & 8) != 0
                    wn.key_event[ wn.ev ]
                el [ t == i32[ HM.text ] ]
                    wn.ev.clear[]
                    tb : local i8 [ 2 ]
                    tb[0] = i8[ host_pa[] ]
                    tb[1] = 0
                    wn.ev.key.text = string[ @tb[0] ]
                    wn.text_event[ wn.ev ]
                el [ t == i32[ HM.resize ] ]
                    wide : i32 [ host_pa[] ]
                    tall : i32 [ host_pb[] ]
                    if [ wide > 0 && tall > 0 ]
                        wn.resize[ wide, tall ]

        # agent socket (debug builds): line commands become real Events
        func agent_find [ e: element, aid: string ] -> element
            if [ !e ] return null
            if [ e.id && e.id == aid ] return e
            if [ e.elements ]
                for [ ce: element, ck: string ] in e.elements
                    found : element agent_find[ ce, aid ]
                    if [ found ] return found
            return null

        # an element's rect in window space: its parents' origins summed,
        # each scrolling parent's offset taken back out
        func agent_world [ e: element ] -> rect
            r : rect [ x: 0.0, y: 0.0, w: (e.bounds) ? e.bounds.w : 0.0, h: (e.bounds) ? e.bounds.h : 0.0 ]
            for [ c: element* e, c, c = c.parent ]
                if [ c.bounds ]
                    r.x += c.bounds.x
                    r.y += c.bounds.y
                if [ c.parent && !c.no_scroll ]
                    r.x -= c.parent.scroll.x
                    r.y -= c.parent.scroll.y
            return r

        func agent_press [ wn: Window, mx: f32, my: f32, btn: i32, st: i32, md: i32 ]
            wn.ev.clear[]
            wn.mouse.x = f64[ mx ]
            wn.mouse.y = f64[ my ]
            wn.ev.mouse.pos.x  = mx
            wn.ev.mouse.pos.y  = my
            wn.ev.mouse.button = btn
            wn.ev.mouse.state  = st
            # same mod bits the key command uses: a modifier-click is a
            # real interaction and the socket could not express one
            wn.ev.key.shift = (md & 1) != 0
            wn.ev.key.ctrl  = (md & 2) != 0
            wn.ev.key.alt   = (md & 4) != 0
            wn.ev.key.meta  = (md & 8) != 0
            if [ st == 1 ] wn.press_event[ wn.ev ]
            el             wn.release_event[ wn.ev ]

        func agent_pump []
            agent_codex_poll[]
            wn : Window [ w ]
            aa :  cast element [ wn.app_object ]
            if [ !agent_on ]
                name : 'app'
                if [ aa ]
                    header : Au.header[ aa ]
                    name = string [ header.au.ident ]
                # hosted: one socket PER INSTANCE, or the newest instance of a
                # module would answer for every other one
                sl9 : i32 [ host_slot[] ]
                if [ sl9 > 0 ] name = '{name}-{sl9}'
                agent_on = agent_sock_open[ name ] != 0
                if [ !agent_on ] return
                # the path an agent is told to answer on
                rt9 : cstr [ getenv[ 'XDG_RUNTIME_DIR' ] ]
                wn.agent_sock = '{(rt9 && strlen[ rt9 ] > 0) ? string[ rt9 ] : '/tmp'}/trinity-{name}.sock'
            while [ true ]
                buf : local i8 [ 1024 ]
                got : i32 [ agent_sock_line[ @buf[0], 1024 ] ]
                if [ got <= 0 ] break
                line : string [ @buf[0] ]
                parts : line.split[ ' ' ]
                if [ parts.count == 0 ] continue
                cmd : string parts[0]
                ok : bool [ true ]
                if [ cmd == 'move' && parts.count >= 3 ]
                    wn.ev.clear[]
                    wn.mouse.x = parts[1].real_value[]
                    wn.mouse.y = parts[2].real_value[]
                    wn.ev.mouse.pos.x = f32[ parts[1].real_value[] ]
                    wn.ev.mouse.pos.y = f32[ parts[2].real_value[] ]
                    wn.move_event[ wn.ev ]
                el [ (cmd == 'press' || cmd == 'release' || cmd == 'click') && parts.count >= 3 ]
                    px : f32 [ f32[ parts[1].real_value[] ] ]
                    py : f32 [ f32[ parts[2].real_value[] ] ]
                    pb : i32 [ (parts.count >= 4) ? i32[ parts[3].integer_value[] ] : 0 ]
                    pm : i32 [ (parts.count >= 5) ? i32[ parts[4].integer_value[] ] : 0 ]
                    if [ cmd != 'release' ] agent_press[ wn, px, py, pb, 1, pm ]
                    if [ cmd != 'press' ]   agent_press[ wn, px, py, pb, 0, pm ]
                el [ cmd == 'tap' && parts.count >= 2 ]
                    te : element agent_find[ wn.root, parts[1] ]
                    if [ te ]
                        te.hovered = true
                        wn.ev.clear[]
                        wn.ev.mouse.button = 0
                        wn.ev.mouse.state  = 1
                        if [ te.bounds ]
                            wn.ev.mouse.pos.x = te.bounds.w * 0.5
                            wn.ev.mouse.pos.y = te.bounds.h * 0.5
                        wn.press_route[ te, wn.ev ]
                        wn.ev.clear[]
                        wn.ev.mouse.button = 0
                        wn.ev.mouse.state  = 0
                        if [ te.bounds ]
                            wn.ev.mouse.pos.x = te.bounds.w * 0.5
                            wn.ev.mouse.pos.y = te.bounds.h * 0.5
                        wn.release_route[ te, wn.ev ]
                    el
                        ok = false
                el [ (cmd == 'key' || cmd == 'keytap') && parts.count >= 2 ]
                    kc : i32 [ i32[ parts[1].integer_value[] ] ]
                    st : i32 [ (cmd == 'key' && parts.count >= 3) ? i32[ parts[2].integer_value[] ] : 1 ]
                    md : i32 [ 0 ]
                    if [ cmd == 'key' && parts.count >= 4 ]    md = i32[ parts[3].integer_value[] ]
                    if [ cmd == 'keytap' && parts.count >= 3 ] md = i32[ parts[2].integer_value[] ]
                    wn.ev.clear[]
                    wn.ev.key.unicode = kc
                    wn.ev.key.state   = st
                    wn.ev.key.shift = (md & 1) != 0
                    wn.ev.key.ctrl  = (md & 2) != 0
                    wn.ev.key.alt   = (md & 4) != 0
                    wn.ev.key.meta  = (md & 8) != 0
                    wn.key_event[ wn.ev ]
                    if [ cmd == 'keytap' ]
                        wn.ev.key.state = 0
                        wn.key_event[ wn.ev ]
                el [ (cmd == 'pad' || cmd == 'padtap') && parts.count >= 2 ]
                    btn : i32 [ i32[ parts[1].integer_value[] ] ]
                    st  : i32 [ (cmd == 'pad' && parts.count >= 3) ? i32[ parts[2].integer_value[] ] : 1 ]
                    wn.ev.clear[]
                    wn.ev.pad.pad    = 0
                    wn.ev.pad.button = btn
                    wn.ev.pad.state  = st
                    wn.pad_event[ wn.ev ]
                    if [ cmd == 'padtap' ]
                        wn.ev.pad.state = 0
                        wn.pad_event[ wn.ev ]
                el [ cmd == 'instruments' ]
                    list : (aa) ? aa.instruments*[] : null
                    reply : ''
                    mem : bool [ false ]
                    if [ list ]
                        for [ i: i32 0, i < list.count, i += 1 ]
                            if [ '{list[i]}' == 'memory' ] mem = true
                            reply = (i == 0) ? '{list[i]}' : '{reply} {list[i]}'
                    # every app gets the memory graph; listing the name
                    # overrides ours
                    if [ !mem ] reply = (reply.count == 0) ? 'memory' : '{reply} memory'
                    agent_sock_reply[ '{reply}\n' ]
                    continue
                # probe <member>: run its change block by hand — 1 ran, 0 none, -1 unimplemented
                el [ cmd == 'probe' && parts.count >= 2 ]
                    pr9 : i32 [ (aa) ? Au_call_changed[ aa, parts[1].chars ] : 0 ]
                    agent_sock_reply[ '{pr9}\n' ]
                    continue
                el [ cmd == 'props' ]
                    ps9 : string props_spec[]
                    agent_sock_reply[ (ps9 && ps9.count > 0) ? '{ps9}\n' : '\n' ]
                    continue
                # stats: the last second's frame and gpu counters
                el [ cmd == 'stats' ]
                    agent_sock_reply[ (stat_line && stat_line.count > 0) ? '{stat_line}\n' : '\n' ]
                    continue
                # call <name>: run an Action method of the app, no arguments
                el [ cmd == 'call' && parts.count >= 2 ]
                    fm9 : Au_t [ (aa) ? find_member[ typeid[ aa ], parts[1].chars,
                        AU_MEMBER_FUNC, 0, true ] : null ]
                    ok9 : bool [ false ]
                    if [ fm9 ]
                        am9 : Au_t fm9.meta.m
                        if [ am9 && Au.inherits[ am9, typeid[ Action ] ] ] ok9 = Au_call_named[ aa, parts[1].chars ] == 1
                    agent_sock_reply[ (ok9) ? 'ok\n' : 'unknown\n' ]
                    continue
                el [ cmd == 'set' && parts.count >= 3 ]
                    member : Au_t [ (aa) ? find_member[ typeid[ aa ], parts[1].chars,
                        AU_MEMBER_VAR, 0, true ] : null ]
                    isvol : bool [ parts[1].compare[ 'volume' ] == 0 ]
                    if [ member ]
                        val : Au.convert[ member.src, parts[2] ]
                        if [ val ] aa.set_property[ parts[1], val ]
                    if [ isvol ] volume = f32[ parts[2].real_value[] ]
                    agent_sock_reply[ (member || isvol) ? 'ok\n' : 'unknown\n' ]
                    continue
                # the shell's slider. an app with its own volume gets it too
                el [ cmd == 'volume' ]
                    member : Au_t [ (aa) ? find_member[ typeid[ aa ], 'volume',
                        AU_MEMBER_VAR, 0, true ] : null ]
                    if [ parts.count >= 2 ]
                        volume = f32[ parts[1].real_value[] ]
                        if [ member ]
                            val : Au.convert[ member.src, parts[1] ]
                            if [ val ] aa.set_property[ 'volume', val ]
                    # reply with what the APP holds when it owns one
                    level : f32 [ volume ]
                    if [ member ] level = f32[ aa.member_object[ member ] ]
                    agent_sock_reply[ '{level}\n' ]
                    continue
                # the shell letterboxes only an app that locked its aspect
                el [ cmd == 'aspect' ]
                    agent_sock_reply[ (lock_aspect) ? '1\n' : '0\n' ]
                    continue
                # the shell's WIDTH for one instrument, in pixels
                el [ cmd == 'instr-width' && parts.count >= 3 ]
                    if [ !instr_w ] instr_w = map i32 [string] []
                    instr_w[ parts[1] ] = i32[ parts[2].integer_value[] ]
                el [ cmd == 'instr-log' && parts.count >= 2 ]
                    instr_log_toggle[ parts[1] ]
                    agent_sock_reply[ '{instr_state[]}\n' ]
                    continue
                el [ cmd == 'instr' ]
                    agent_sock_reply[ '{instr_state[]}\n' ]
                    continue
                # the enumeration itself — one entry per line
                el [ cmd == 'instr-read' && parts.count >= 2 ]
                    lines : instr_read[ parts[1] ]
                    reply : ''
                    if [ lines ]
                        for [ i: i32 0, i < lines.count, i += 1 ]
                            reply = '{reply}{lines[i]}\n'
                    agent_sock_reply[ '{reply}\n' ]
                    continue
                el [ cmd == 'app' && line.count > 4 ]
                    
                    if [ aa ] aa.on_agent*[ line.mid[ 4, line.count - 4 ] ]
                    el ok = false
                el [ cmd == 'set' && parts.count >= 3 ]
                    member : Au_t [ (aa) ? find_member[ typeid[ aa ], parts[1].chars,
                        AU_MEMBER_VAR, 0, true ] : null ]
                    if [ member ]
                        # the member's own type does the conversion, so a
                        # bool prop takes a bool and an i32 takes an i32
                        val : Au.convert[ member.src, parts[2] ]
                        if [ val ] aa.set_property[ parts[1].chars, val ]
                        el ok = false
                    el ok = false
                el [ cmd == 'state-store' ]
                    if [ aa ] state_persist_store[ aa ]
                    el ok = false
                el [ cmd == 'state-load' ]
                    if [ aa ] state_persist_load[ aa ]
                    el ok = false
                el [ cmd == 'text' && line.count > 5 ]
                    wn.ev.clear[]
                    wn.ev.key.text = line.mid[ 5, line.count - 5 ]
                    wn.text_event[ wn.ev ]
                el [ cmd == 'resize' && parts.count >= 3 ]
                    # a real window resize, so the resize path can be driven and shot
                    if [ wn.glfw ] platform_window_set_size[ wn.glfw, i32[ parts[1].integer_value[] ], i32[ parts[2].integer_value[] ] ]
                el [ cmd == 'wheel' && parts.count >= 4 ]
                    wn.ev.clear[]
                    wn.ev.mouse.pos.x = f32[ parts[1].real_value[] ]
                    wn.ev.mouse.pos.y = f32[ parts[2].real_value[] ]
                    wn.ev.mouse.wheel_delta.y = f32[ parts[3].real_value[] ]
                    wn.wheel_event[ wn.ev ]
                el [ cmd == 'focus' && parts.count >= 2 ]
                    fe : element agent_find[ wn.root, parts[1] ]
                    if [ fe ] wn.set_focus[ fe ]
                    el ok = false
                # bounds <id>: x y w h in window space, or none
                el [ cmd == 'bounds' && parts.count >= 2 ]
                    be : element agent_find[ wn.root, parts[1] ]
                    if [ be && be.bounds ]
                        br : rect agent_world[ be ]
                        agent_sock_reply[ '{br.x} {br.y} {br.w} {br.h}\n' ]
                        continue
                    agent_sock_reply[ 'none\n' ]
                    continue
                el [ cmd == 'tree' ]
                    # agi: block keys are the element ids
                    if [ wn.root ]
                        tree : map object [string] []
                        tree['root'] = ux_serialize[ wn.root ]
                        agent_sock_reply[ Au.string_agi[ tree ] ]
                    el ok = false
                el [ cmd == 'shot' && parts.count >= 2 ]
                    render : wn.last_render[]
                    # first frames: the render target isn't filled yet
                    if [ render && render.color && render.color.vk_image && render.has_drawn ]
                        im : Image [ render.color ]
                        # shot <path> x y w h: that region alone, in window units
                        if [ parts.count >= 6 ]
                            sc8 : f32 [ (wn.scale > 0.0) ? wn.scale : 1.0 ]
                            im = im.crop[ i32[ parts[2].real_value[] * sc8 ], i32[ parts[3].real_value[] * sc8 ],
                                          i32[ parts[4].real_value[] * sc8 ], i32[ parts[5].real_value[] * sc8 ] ]
                        im.png[ path [ parts[1].chars ] ]
                    el ok = false
                el
                    ok = false
                agent_sock_reply[ (ok) ? 'ok\n' : 'err\n' ]
                wn.will_animate = true
                if [ wn.root ] wn.root.pristine = false
    func destroy [ ]
        if [ destroyed ] return
        destroyed = true
        if [ text_mode && w ]
            cwin : Window [ w ]
            cwin.console_input_close[]
        if [ w ]
            rwin : Window [ w ]
            if [ rwin.root ]
                rwin.root.unload_tree[]
                rwin.root.release_tree[]
            if [ rwin.app_object ]
                app : cast element [ rwin.app_object ]
                app.unload_tree[]
                app.release_tree[]
                app.elements = null
            # lingering elements borrow these targets; free the GPU graph now
            # and CLEAR the entries — the window outlives module reloads, and a
            # stale Render dropped by the next module's map set is a double-free
            if [ rwin.element_targets ]
                keys : vec string []
                for [ tv: Au, tk: string ] in rwin.element_targets
                    rt : cast Render [ tv ]
                    if [ rt ] rt.models = null
                    keys.push[ tk ]
                for [ key: string ] in keys
                    rwin.element_targets[ key ] = null
        if [ vk ]
            vk.font_cache = null
            vk.shader_cache = null
        if [ w ]
            w.drop[]

    func render [ ]
        return

    func init [ ]
        next_second = epoch_millis[] / 1000
        app_pid       = parse_app_pid[]
        isolate_app   = getenv[ 'SILVER_ISOLATE_APP' ] != null
        isolate_child = getenv[ 'SILVER_ISOLATE_CHILD' ] != null
        headless      = getenv[ 'SILVER_HEADLESS' ] != null
        home_dir      = getenv[ 'HOME' ]
        # TRIN_SHOT=<name>: capture without the arg parser, for a sandboxed
        # device where flags cannot reach the app
        if [ !screenshot ]
            env_shot : cstr [ getenv[ 'TRIN_SHOT' ] ]
            if [ env_shot ] screenshot = path '{env_shot}'
        if [ text_mode ]
            return
        if [ !Au.live_window_get[] ]
            init_res : platform_init[]
            expect init_res, "platform init"
        existing_vk : handle Au.live_vk_get[]
        if [ existing_vk ]
            vk = cast vk_context [ existing_vk ]
            dh : handle [ vk.dev_handle[] ]
            log 'media_app: reusing vk device {dh}'
            vk.font_cache = null
        el
            vk = vk_context[]
            Au.live_vk_set[ handle[vk] ]

    func dealloc [ ]
        destroy[]


class CursorPos
    public x : f32
    public y : f32
    public h : f32

# declared Layer/shader members become the instance's layers/shaders
func bind_members [ instance: element ]
    ltys : vec Au_t []
    for [ lty : typeid[ instance ], lty != typeid[ Au ], lty = lty.context ]
        ltys.push[ lty ]
    for [ lti: i32 ltys.count - 1, lti >= 0, lti -= 1 ]
        lty2 : Au_t ltys[lti]
        for [ lmi: i32 0, lmi < lty2.members.count, lmi += 1 ]
            lmem : Au_t lty2.members.origin[lmi]
            if [ lmem.member_type != AU_MEMBER_VAR ] continue
            if [ !lmem.src ] continue
            lv : Au instance.member_object[ lmem ]
            if [ !lv ] continue
            if [ Au.inherits[ lmem.src, typeid[ Layer ] ] ]
                lvl : cast Layer [ lv ]
                lvl.set_context_from[ instance ]
                lvl.initialize[]
                if [ !instance.layers ] instance.layers = map Layer[string] []
                instance.layers[ string[ lmem.ident ] ] = lvl
            el [ Au.inherits[ lmem.src, typeid[ shader ] ] ]
                shv : cast shader [ lv ]
                shv.set_context_from[ instance ]
                shv.initialize[]
                if [ !instance.shaders ] instance.shaders = map shader[string] []
                instance.shaders[ string[ lmem.ident ] ] = shv
    # the icon layer paints last: re-insert to move it to the end
    if [ instance.layers ]
        bic : Layer instance.layers[ 'iconl' ]
        if [ bic ]
            instance.layers.rm[ 'iconl' ]
            instance.layers[ string[ 'iconl' ] ] = bic

# the pipeline's reduce-then-blur, one unit: `source` (already at
# from_scale of the window) halved `steps` times, then the vertical and
# horizontal gaussian at that reduction, output full size. the frost chain
# builds three of these off its entry copy; the screenshot builds one off
# its capture and runs it once
class ReduceBlur
    public renders : vec Render     # the reduces in order, then the two blur passes
    public models  : vec Model      # one per render, the same order
    public scale   : f32            # the reduction the blur runs at (2, 4, 16)

    func build [ vc: vk_context, dsp: Display, source: Texture, from_scale: f32, steps: i32 ]
        renders = vec Render []
        models  = vec Model []
        prev : Texture source
        sc   : f32 [ from_scale ]
        for [ i: i32 0, i < steps, i += 1 ]
            sc = sc * 0.5
            m : Model  [ w: dsp, samplers: map Texture[string] [ 'color': prev ] ]
            r : Render [ vk: vc, w: dsp, wscale: sc, models: [m ] ]
            models.push[ m ]
            renders.push[ r ]
            prev = r.color
        scale = 1.0 / sc
        bv : BlurV [ vk: vc, name: 'blur-v', reduction_scale: scale ]
        bv.hold[]
        mv : Model  [ w: dsp, s: bv, samplers: map Texture[string] [ 'color': prev ] ]
        rv : Render [ vk: vc, w: dsp, wscale: 1.0, models: [mv ] ]
        models.push[ mv ]
        renders.push[ rv ]
        bl : Blur [ vk: vc, name: 'blur', reduction_scale: scale ]
        bl.hold[]
        mh : Model  [ w: dsp, s: bl, samplers: map Texture[string] [ 'color': rv.color ] ]
        rh : Render [ vk: vc, w: dsp, wscale: 1.0, models: [mh ] ]
        models.push[ mh ]
        renders.push[ rh ]

    # a reduce's output: the chain branches off these
    func stage [ i: i32 ] -> Texture
        r : Render renders[ i ]
        return r.color

    func last [] -> Render
        return renders[ renders.count - 1 ]

    func color [] -> Texture
        r : Render last[]
        return r.color

    # a resize replaced the colors: rebind every stage from CURRENT
    # textures, in order
    func rewire [ source: Texture ]
        prev : Texture source
        for [ i: i32 0, i < models.count, i += 1 ]
            m : Model models[ i ]
            m.samplers = map Texture[string] [ 'color': prev ]
            m.rebind_model[]
            r : Render renders[ i ]
            prev = r.color

    # the stages into a draw list, in order
    func append [ to: vec Render ]
        for [ r: Render ] in renders
            to.push[ r ]

    # run once, fenced: a one-shot source
    func run []
        for [ r: Render ] in renders
            r.update*[] r.draw*[] r.sync_fence[]

Display Window
    # weak: the window outlives a module reload, and live_destroy owns the app
    # instance. owning it here released one the host still held
    manual app_object           : element*
    # per joystick: 32 buttons, 16 axes x 2 signs, 4 hats x 4 directions
    mutable pad_state           : new u8 [ 16 * 96 ]
    mutable pad_said            : bool
    mutable ide_active          : bool
    mutable dict_on             : bool
    mutable dict_live           : bool
    mutable app_size_w          : i32
    mutable app_size_h          : i32
    mutable ide_size_w          : i32
    mutable ide_size_h          : i32
    mutable cursors             : vec CursorPos
    mutable cursor_hresize      : handle
    mutable cursor_vresize      : handle
    mutable cursor_kind         : i32

    public compose              : Canvas
    public glyph                : Canvas
    public screen               : Canvas

    # a backdrop element publishes its render target here; the blur/frost
    # chain builds off it the first frame it appears
    public backdrop              : Render
    # the flat background the solid stage paints instead of the scene
    public solid_color           : rgba [ '#101014' ]
    # every compositor pass. the DRAW list is derived from this: the full
    # chain only when an element actually declares frost, else r_view alone
    mutable chain                : vec Render
    # resize replaced attachments: the frost chain rebinds as if fresh
    mutable rebind_frost         : bool
    mutable m_reduce             : Model
    mutable r_reduce             : Render
    # the three reduce-then-blur units off the entry copy: blur at 1/4,
    # soft at 1/2, frost at 1/16
    mutable rb_blur              : ReduceBlur
    # which stage feeds the panels: 0 frost, 1 blur, 2 soft, 3 raw
    # -1 = follow the scene; the status bar sets it explicitly
    # 0 frost, 1 blur, 2 soft, 3 raw
    public  frost_mode           : i32 [ 0 ]
    # a pane covers the ui (Full app view): the backdrop scene and its
    # frost chain do not draw; the panels keep their last frost
    public  backdrop_bypass      : bool
    mutable frost_bound          : i32 [ -2 ]
    # half-size blur; the sharp frost path uses it for the mid stage
    mutable rb_soft              : ReduceBlur
    mutable rb_frost             : ReduceBlur
    mutable m_view               : Model
    mutable r_view               : Render

    manual test_element : element   # points at a tree element, does not own it
    mutable dbg_blit     : i32

    mutable is_setup             : bool
    mutable user_compose         : bool
    intern  tty_in               : i32 [ -1 ]


    intern root_styles          : map Style[string]
    intern last_frame_ms        : i64
    intern start_ms             : i64
    mutable frame_factor        : f32
    intern frame_seq            : i32
    public root                 : element
    # weak: these point AT tree elements, they do not own them. owning meant
    # Au_drop_members released the app instance on window teardown — a drop
    # against a reference that was never a hold
    # an app with sound sets record_rate when its output opens; record_audio then
    # resamples its frames to 48 kHz stereo into rec, which the recording's pump
    # drains as the aac track (rec exists only while a recording wants sound)
    public  record_rate         : i32
    mutable rec                 : AudioRing
    mutable rec_pos             : f64
    mutable rec_out             : new i16 [ 65536 ]       # one call's resampled frames
    # microphone for the recording: a capture thread fills mic; record_audio mixes
    # it into the app's sound, or the thread feeds rec itself while the app has none
    mutable mic_on              : bool
    mutable mic                 : AudioRing
    manual capture              : element
    manual focus                : element
    manual hovered              : element
    manual locked               : element      # mouse lock owner: cursor hidden at its centre, moves arrive as deltas
    manual action_pressed       : element
    manual context_pressed      : element
    mutable restyle             : bool
    mutable will_animate        : bool
    mutable draw_stage          : CanvasType
    mutable mouse               : vec2f
    mutable last_move           : vec2f
    mutable last_click_us       : i64
    mutable last_click_pos      : vec2f
    public  stdout_overlay      : bool [ false ]
    public  stdout_y            : f32 [ 10.0 ]  # overlay top offset, app-tunable
    mutable so_lines            : vec string
    mutable so_last             : i64
    mutable t_apply_args        : i64
    mutable t_apply_style       : i64
    mutable t_render            : i64
    mutable shift               : bool
    mutable alt                 : bool
    mutable time                : f64
    public st                   : Style

    # backdrop composite redraws per second. 0 = every frame
    public  background_hz       : f32
    # print the per-second frame stats (fps, fences, paints, draws) on the terminal
    public  stats               : bool
    # the costliest element this second (own paint, children excluded); zeroed on read
    func paint_max [ e: element, best: vec Au ]
        if [ !e ] return
        cur : element (best.count > 0) ? cast element [ best[0] ] : null
        if [ e.paint_us > 0 && (!cur || e.paint_us > cur.paint_us) ]
            if [ best.count > 0 ] best[0] = Au[ e ]
            el best.push[ Au[ e ] ]
        if [ e.elements ]
            for [ ee: element, id: string ] in e.elements
                paint_max[ ee, best ]

    public func paint_top [] -> string
        out : string ''
        for [ n9: i32 0, n9 < 8, n9 += 1 ]
            best : vec Au []
            paint_max[ root, best ]
            if [ best.count == 0 ] break
            be : element cast element [ best[0] ]
            out = '{out} {(be.id && be.id.count > 0) ? be.id : "(noid)"}={be.paint_us}'
            be.paint_us = 0
        return out
    # 0 low, 1 high, 2 far. each scene maps it to its own distance
    public  orbit_mode          : i32
    # 0 flat-on, 1 angled, 2 steep. mapped per scene like orbit_mode
    public  angle_mode          : i32
    # focus requested by element id, resolved in animate[]. an element
    # created this frame does not exist yet when the request is made,
    # and focus must never be applied from a render
    public  focus_id            : string
    # a scene sets this while its camera is still easing to the target;
    # frame skipping is suspended for the duration or the move stutters
    public  orbit_moving        : bool
    # multiplier on how fast `time` advances. 1.0 = wall clock
    public  time_scale          : f32 [ 1.0 ]
    # wall-clock anchor for `time`: re-set whenever time_scale changes
    intern  time_base           : f64
    intern  time_anchor_ms      : i64
    intern  time_scale_last     : f32
    mutable screenshot_active   : bool
    mutable screenshot_dragging : bool
    mutable screenshot_x0       : f32
    mutable screenshot_y0       : f32
    mutable screenshot_x1       : f32
    mutable screenshot_y1       : f32
    mutable screenshot_scale    : f32
    mutable screenshot_image    : Image
    mutable screenshot_texture  : Texture
    mutable screenshot_blur     : ReduceBlur   # the frame through the pipeline's blur, once
    public  screenshot_path     : path
    # a crop just taken, while the prompt for its line is up
    mutable shot_ask            : path
    # the exchange is up: the agent's lines and the app's avatar under the field
    mutable agent_view          : bool
    mutable agent_notes         : vec ShotEntry
    mutable agent_diff_cur      : bool   # the last wire line was a diff line: the next joins it
    mutable shot_file           : bool   # the exchange is about a file (shot_ask is its path), not a crop
    mutable shot_line           : i32    # the line in that file, 0 for none
    mutable agent_min           : bool     # Esc put the exchange away; the status item brings it back
    mutable shot_text           : string   # the lines so far: every send reposts the whole message
    mutable agent_sock          : string   # this app's socket path, quoted to the agent
    mutable agent_pick          : string   # the agent chosen at the prompt (an `agents` name)
    mutable user_notes          : vec ShotEntry   # the user's lines, their own list beside the agent's
    mutable agent_busy          : bool     # the agent said busy: the shine keeps moving

    public func agent_state_busy [] -> bool
        return agent_busy

    func screenshot_point [ p: vec2f ] -> vec2f
        x : f32 [ p.x ]
        y : f32 [ p.y ]
        if [ x < 0.0 ] x = 0.0
        if [ y < 0.0 ] y = 0.0
        if [ x > f32[ width ] ]  x = f32[ width ]
        if [ y > f32[ height ] ] y = f32[ height ]
        return vec2f [ x, y ]

    func screenshot_begin []
        lr : Render last_render[]
        if [ !lr || !lr.color ] return
        screenshot_image = Image [ lr.color ]
        # linear: the frame's bytes shown as they are. an sRGB-format
        # texture decodes on sample and the UNORM swap writes that raw,
        # which crushed the whole capture dark
        screenshot_texture = Texture [ vk: vk, w: a,
            sampler: screenshot_image, linear: true ]
        # the frame through the pipeline's reduce-then-blur (1/4, as the
        # chain's blur stage), once: what shows outside the crop
        ctx9 : vk_context[ a.vk ]
        rb9  : ReduceBlur []
        rb9.build[ ctx9, a, screenshot_texture, 1.0, 2 ]
        rb9.run[]
        screenshot_blur     = rb9
        screenshot_scale    = time_scale
        screenshot_x0       = 0.0
        screenshot_y0       = 0.0
        screenshot_x1       = f32[ width ]
        screenshot_y1       = f32[ height ]
        screenshot_dragging = false
        screenshot_active   = true
        time_scale          = 0.0
        will_animate        = true

    func screenshot_end []
        time_scale          = screenshot_scale
        screenshot_active   = false
        screenshot_dragging = false
        screenshot_texture  = null
        screenshot_image    = null
        will_animate        = true

    # one of the user's lines into their list
    func user_note [ text: string ]
        if [ !text || text.count == 0 ] return
        if [ !user_notes ] user_notes = vec ShotEntry []
        user_notes.push[ ShotEntry [ text: text ] ]
        while [ user_notes.count > 8 ] user_notes.remove[ 0 ]
        if [ root && root.elements ]
            ue : element root.elements[ 'unotes' ]
            if [ ue ] ue.pristine = false
        will_animate = true

    # a line from the agent into its list
    func agent_note [ state: string, text: string ]
        if [ !text || text.count == 0 ] return
        if [ !agent_notes ] agent_notes = vec ShotEntry []
        agent_notes.push[ ShotEntry [ text: text ] ]
        agent_diff_cur = false
        while [ agent_notes.count > 8 ] agent_notes.remove[ 0 ]
        if [ root && root.elements ]
            ne : element root.elements[ 'notes' ]
            if [ ne ] ne.pristine = false
        will_animate = true

    func agent_description [ text: string ]
        if [ !agent_notes || agent_notes.count == 0 ] return
        en : ShotEntry agent_notes[ agent_notes.count - 1 ]
        en.add_description[ text ]
        agent_diff_cur = false
        if [ root && root.elements ]
            ne : element root.elements[ 'notes' ]
            if [ ne ] ne.pristine = false
        will_animate = true

    # a line of a source diff the agent applied: consecutive diff lines are
    # one entry in its box, shown as a label (file, +added -removed) whose
    # code expands when clicked
    func agent_diff [ text: string ]
        if [ !text ] return
        if [ !agent_notes ] agent_notes = vec ShotEntry []
        en : ShotEntry [ (agent_diff_cur && agent_notes.count > 0) ? agent_notes[ agent_notes.count - 1 ] : null ]
        if [ !en || !en.diff ]
            en = ShotEntry [ text: text, diff: vec string [] ]
            agent_notes.push[ en ]
            while [ agent_notes.count > 8 ] agent_notes.remove[ 0 ]
        en.diff.push[ text ]
        agent_diff_cur = true
        # the label: the file from a 'diff --git a/x b/x' header (else the
        # first line), with the line counts
        first : string en.diff[ 0 ]
        name  : string [ first ]
        bat   : i32 [ first.index_of[ ' b/' ] ]
        if [ first.starts_with[ 'diff --git ' ] && bat > 0 ] name = first.mid[ bat + 3, first.count - bat - 3 ]
        adds : i32 [ 0 ]
        dels : i32 [ 0 ]
        for [ ln: string ] in en.diff
            if [ ln.count > 0 && ln.chars[ 0 ] == 43 && !ln.starts_with[ '+++' ] ] adds += 1
            if [ ln.count > 0 && ln.chars[ 0 ] == 45 && !ln.starts_with[ '---' ] ] dels += 1
        en.text = '{name}  +{adds} -{dels}'
        if [ root && root.elements ]
            ne : element root.elements[ 'notes' ]
            if [ ne ] ne.pristine = false
        will_animate = true

    # the exchange back up after an Esc
    public func agent_show []
        if [ !shot_ask ] return
        agent_min = false
        restyle   = true

    # the prompt and the exchange go, the blur with them
    # the exchange, about a crop (the capture's path) or a file at a line:
    # the frame behind is blurred as the capture is, the boxes and the
    # avatar come up, and the first send carries the reference
    public func exchange_open [ at: path, ln: i32, is_file: bool ]
        if [ !at ] return
        if [ !screenshot_blur ]
            lr : Render last_render[]
            if [ lr && lr.color ]
                # held in the same members the capture uses: a local image
                # and texture die at the return while the blur still reads
                # them (a heap fault at the next allocation)
                screenshot_image   = Image [ lr.color ]
                screenshot_texture = Texture [ vk: vk, w: a, sampler: screenshot_image, linear: true ]
                ctx9 : vk_context[ a.vk ]
                rb9  : ReduceBlur []
                rb9.build[ ctx9, a, screenshot_texture, 1.0, 2 ]
                rb9.run[]
                screenshot_blur = rb9
        shot_ask    = at
        shot_file   = is_file
        shot_line   = ln
        agent_view  = false
        agent_min   = false
        agent_notes = null
        user_notes  = null
        shot_text   = ''
        restyle     = true
        will_animate = true

    func shot_close []
        shot_ask        = null
        agent_view      = false
        agent_min       = false
        shot_text       = ''
        user_notes      = null
        agent_notes     = null
        screenshot_blur = null
        if [ focus ] release_focus[ focus ]
        restyle = true

    func screenshot_save []
        if [ !screenshot_image ] return
        lx : f32 [ min[ screenshot_x0, screenshot_x1 ] ]
        ly : f32 [ min[ screenshot_y0, screenshot_y1 ] ]
        hx : f32 [ max[ screenshot_x0, screenshot_x1 ] ]
        hy : f32 [ max[ screenshot_y0, screenshot_y1 ] ]
        sx : f32 [ screenshot_image.width ] / f32[ width ]
        sy : f32 [ screenshot_image.height ] / f32[ height ]
        x0 : i32 [ lx * sx ]
        y0 : i32 [ ly * sy ]
        x1 : i32 [ hx * sx + 0.999 ]
        y1 : i32 [ hy * sy + 0.999 ]
        if [ x1 <= x0 || y1 <= y0 ] return
        cropped : Image screenshot_image.crop[ x0, y0, x1 - x0, y1 - y0 ]
        stamp : i64 epoch_millis[]
        screenshot_path = path '/tmp/silver-crop-{stamp}.png'
        cropped.png[ screenshot_path ]
        log 'screenshot: {screenshot_path}'

    func screenshot_rect [ x: f32, y: f32, rw: f32, rh: f32 ]
        if [ rw < 0.5 || rh < 0.5 ] return
        screen.rect_to[ x, y, rw, rh ]
        screen.paint[]

    func screenshot_draw []
        if [ !screenshot_texture ] return
        ww : f32 [ f32[ width ] ]
        wh : f32 [ f32[ height ] ]
        lx : f32 [ min[ screenshot_x0, screenshot_x1 ] ]
        ly : f32 [ min[ screenshot_y0, screenshot_y1 ] ]
        hx : f32 [ max[ screenshot_x0, screenshot_x1 ] ]
        hy : f32 [ max[ screenshot_y0, screenshot_y1 ] ]
        # the blurred frame behind, the crop sharp from the original over it
        if [ screenshot_blur ]
            screen.draw_image[ screenshot_blur.color[],
                rect [ x: 0.0, y: 0.0, w: ww, h: wh ] ]
        el
            screen.draw_image[ screenshot_texture,
                rect [ x: 0.0, y: 0.0, w: ww, h: wh ] ]
        if [ hx > lx && hy > ly ]
            screen.draw_image_crop[ screenshot_texture,
                rect [ x: lx, y: ly, w: hx - lx, h: hy - ly ],
                lx / ww, ly / wh, hx / ww, hy / wh ]
        # outside the crop at half: 50% black over a linear frame is
        # exactly a 0.5 multiply
        screen.fill_color[ '#00000080' ]
        screenshot_rect[ 0.0, 0.0, ww, ly ]
        screenshot_rect[ 0.0, hy, ww, wh - hy ]
        screenshot_rect[ 0.0, ly, lx, hy - ly ]
        screenshot_rect[ hx, ly, ww - hx, hy - ly ]
        screen.fill_color[ '#ffffff80' ]
        screenshot_rect[ lx, ly, hx - lx, 2.0 ]
        screenshot_rect[ lx, hy - 2.0, hx - lx, 2.0 ]
        screenshot_rect[ lx, ly, 2.0, hy - ly ]
        screenshot_rect[ hx - 2.0, ly, 2.0, hy - ly ]
        screen.fill_color[ '#000000cc' ]
        screen.rounded_rect[ 16.0, 16.0, 390.0, 38.0,
            8.0, 8.0, 8.0, 8.0 ]
        screen.paint[]
        screen.font_size[ 14 ]
        screen.fill_color[ '#ffffff' ]
        screen.draw_text[ 'Drag to crop  Enter captures  Esc cancels',
            rect [ x: 28.0, y: 25.0, w: 366.0, h: 20.0 ],
            vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ],
            Overflow.visible, null ]


    func attempt_instance_write [ src: element, dst: element ]
        if [ !src || !dst ] return
        dt : Au_t typeid[ dst ]
        for [ m: i32 0, m < dt.members.count, m += 1 ]
            mem : Au_t dt.members.origin[m]
            if [ mem.member_type != AU_MEMBER_VAR || mem.access_type != 2 ] continue
            if [ strcmp[ mem.ident, "elements" ] == 0 ] continue
            if [ strcmp[ mem.ident, "parent" ] == 0 ] continue
            sm : Au_t find_member[ typeid[ src ], mem.ident, AU_MEMBER_VAR, 0, true ]
            if [ sm && sm.access_type == 2 && sm.src == mem.src ]
                dst.member_set[ mem, src.member_object[ sm ] ]

    public func apply_args [ inst: element, e: element ] -> bool
        if [ typeid[ inst ] != typeid[ e ] ] return false
        # the root app is its own render; state members may lack compare*
        if [ inst == e ] return false
        changed : false
        il        : string [ inst.label ]
        el_       : string [ e.label ]
        il_empty  : bool   [ !il  || il.count  == 0 ]
        el_empty  : bool   [ !el_ || el_.count == 0 ]
        label_changed : bool [ (il_empty != el_empty) || (!il_empty && !el_empty && il != el_) ]
        if [ label_changed ]
            inst.label      = e.label
            inst.edit       = ''
            release_focus[ inst ]
            changed = true
        for [ ty : typeid[ inst ], ty != typeid[ Au ], ty = ty.context ]
            for [ mi: i32 0, mi < ty.members.count, mi += 1 ]
                member : Au_t ty.members.origin[mi]
                if [ member.member_type != AU_MEMBER_VAR ] continue
                if [ strcmp[ member.ident, "elements" ] == 0 ] continue
                if [ strcmp[ member.ident, "label" ] == 0 ] continue
                if [ strcmp[ member.ident, "edit" ] == 0 ] continue
                # placement state is written by update_element, never rendered
                if [ strcmp[ member.ident, "first" ] == 0 || strcmp[ member.ident, "last" ] == 0 || strcmp[ member.ident, "middle" ] == 0 || strcmp[ member.ident, "odd" ] == 0 || strcmp[ member.ident, "even" ] == 0 ] continue
                if [ !e.AF_get_member[ member ] ] continue
                cur : inst.member_object[ member ]
                nv  : e.member_object[ member ]
                # a vector compares by element
                differs : bool [ false ]
                if [ (cur && cur inherits vector) || (nv && nv inherits vector) ]
                    vc : vector cur
                    vn : vector nv
                    differs = (vc != vn) && !(vc && vc.equals[ vn ])
                el
                    differs = (!cur) != (!nv) || ((cur && nv) && cur.compare*[ nv ] != 0)
                if [ differs ]
                    # a prop that holds rendered elements (a splitter's inner
                    # map) is structure, not paint: the children detect their
                    # own changes, so the fresh reference is taken quietly
                    structural : bool [ nv && nv inherits element ]
                    if [ !structural && nv && nv inherits map ]
                        mm9 : map nv
                        for [ v9: Au, k9: string ] in mm9
                            structural = v9 && v9 inherits element
                            break
                    if [ stats && !structural ] log 'ARG {(inst.id && inst.id.count > 0) ? inst.id : "(noid)"} {member.ident}'
                    inst.member_set[ member, nv ]
                    if [ !structural ] changed = true
                    if [ strcmp[ member.ident, "icon" ] == 0 ]
                        bb : Button [ inst inherits Button ]
                        if [ bb ] bb.sync_icon[]
        return changed

    
    public func transition_or_set [ inst:element, value_holder:Au, cur:Au, member:Au_t, best:StyleEntry ]
        # transition handling
        t            : best.trans
        ct           : StyleTransition
        should_trans : false
        mem          : string [ (best.bl && best.bl.key && best.bl.key.count) ? '{best.bl.key}.{member.ident}' : member.ident ]

        if [ t ]
            if [ !inst.transitions ]
                inst.transitions = StyleTransitions [ ]
            ct = inst.transitions[ mem ]
            if [ !ct ]
                ct = t.copy[]
                ct.reference = t
                should_trans = true
                inst.transitions[ mem ] = ct
            el [ ct.invalidate ]
                ct.invalidate = false
                should_trans = true
            el [ ct.dbg_val != best.value ]
                # state flip changed the target: re-arm from current
                should_trans = true
        el [ inst.transitions ]
            inst.transitions.rm[ mem ]

        if [ ct && should_trans ]
            if [ cur            ] cur.hold[]
            if [ best.instance  ] best.instance.hold[]
            if [ ct.from ] ct.from.drop[]
            if [ ct.to   ] ct.to.drop[]
            ct.from      = (cur) ? cur.hold[] : best.instance.hold[]
            ct.dbg_val   = best.value
            ct.to        = best.instance.hold[]
            ct.type      = typeid[ best.instance ]
            ct.start     = epoch_millis[]
            ct.member    = member
            ct.invalidate = false
            ct.container  = value_holder
            if [ cur            ] cur.drop[]
            if [ best.instance  ] best.instance.drop[]
            log 'TRANS arm {(inst.id) ? inst.id : "(noid)"} {mem} -> "{best.value}" hovered={(inst.hovered) ? 1 : 0}'
            # a transition armed here runs on frames: ask for the first
            # one, or it only advances when something else redraws. the
            # cached canvases above it must repaint for it to show
            inst.pristine = false
            for [ p: element* inst.parent, p, p = p.parent ] p.pristine = false
            will_animate  = true
            return

        float_count : i32 [ member.src.typesize / 4 ]
        dst_ptr     : @f32 [ value_holder.member_ref[ member ] ]
        is_f_color : bool [ strcmp[ member.ident, 'fill_color_pos' ] == 0 ]
        # float mixing writes the slot in place: value types only —
        # a class member slot is a pointer and would be smashed
        inlay_val : bool [ (member.src.traits & (1 << 11)) == 0 ]

        if [ best.binding && inlay_val ]
            src_m : Au.find_member[ typeid[ inst ], best.binding.chars, AU_MEMBER_VAR, 0, true ]
            if [ src_m ]
                src_ptr : @f32 [ inst.member_ref[ src_m ] ]
                # dirty only on a real change: an unconditional mark kept
                # every bound element repainting forever (dirty -> apply ->
                # dirty), the whole app tree every frame
                moved : bool [ false ]
                if [ best.filter > 0.0 ]
                    decay : pow[ best.filter, inst.ux.frame_factor ]
                    for [ i: i32 0, i < float_count, i += 1 ]
                        nv : f32 [ dst_ptr[i] + (src_ptr[i] - dst_ptr[i]) * (1.0 - decay) ]
                        if [ nv - dst_ptr[i] > 0.0001 || nv - dst_ptr[i] < -0.0001 ] moved = true
                        dst_ptr[i] = nv
                el
                    for [ i: i32 0, i < float_count, i += 1 ]
                        if [ dst_ptr[i] != src_ptr[i] ] moved = true
                        dst_ptr[i] = src_ptr[i]

                if [ moved ] inst.pristine = false
            return

        if [ best.filter > 0.0 && inlay_val ]
            target_ptr  : @f32 [ best.instance ]
            unset       : true
            for [ i: i32 0, i < float_count, i += 1 ]
                if [ dst_ptr[i] != 0.0 ] unset = false
            if [ unset ]
                for [ i: i32 0, i < float_count, i += 1 ]
                    dst_ptr[i] = target_ptr[i]
            el
                decay : f32 [ pow[ best.filter, inst.ux.frame_factor ] ]
                moving : false
                for [ i: i32 0, i < float_count, i += 1 ]
                    delta : f32 [ target_ptr[i] - dst_ptr[i] ]
                    if [ delta > 0.0001 || delta < -0.0001 ]
                        moving = true
                    if [ target_ptr[i] != 0.0 ]
                        dst_ptr[i] = dst_ptr[i] + delta * (1.0 - decay)
                    el
                        dst_ptr[i] = dst_ptr[i] * decay
                if [ moving ]
                    inst.pristine = false
            #inst.pristine = false
            return

        value_holder.member_set[ member, best.instance ]


    public func cache_style [ inst:element, style_avail: map StyleEntries[string], force_update:bool, home_object:Au ]
        if [ !style_avail ] return
        if [ inst.maps_populated && !force_update ]
            return
 
        inst.maps_populated = true
        for [ ty : typeid[ inst ], ty != typeid[ Au ], ty = ty.context ]
            for [ m: i32 0, m < ty.members.count, m += 1 ]
                member : Au_t ty.members.origin[m]
                if [ member.member_type != AU_MEMBER_VAR || strcmp[ member.ident, "elements" ] == 0 ]
                    continue
                prop    : string [ member.ident ]
                entries : style_avail [ prop ]
                for [ entry : StyleEntry ] reverse in entries
                    if [ !(entry.bl.property && entry.bl.key) ]
                        continue
                    entry.member_map = Au.find_member [ typeid[inst], entry.bl.property.chars, AU_MEMBER_VAR, 0, true ]
                    expect entry.member_map, 'member not found on {ty.ident}: {entry.bl.property}'
                    meta_type : Au_t [ entry.member_map.meta.a ]
                    v : Au inst.member_object[ entry.member_map ]
                    mtype : typeid[ v ]
                    mc : cast Layers [ inst.member_object[ entry.member_map ] ]
                    if [ mc && mc.hsize <= 0 ]
                        info : header [ mc ]
                        log 'bad mc: inst={inst.id} member={entry.member_map.ident} hsize={mc.hsize} key={entry.bl.key}'
                    if [ !mc || mc.hsize <= 0 ]
                        mc = map Layer[string][]
                        log 'mc object created for {inst.id}'
                        inst.member_set[ entry.member_map, mc ]
                    if [ !mc.contains[entry.bl.key] ]
                        inst_type : Au_t [ (entry.bl.type_name && entry.bl.type_name.count) ? Au.find_type[entry.bl.type_name.chars, null] : null ]
                        if [ !inst_type ]
                            has_state : bool [ false ]
                            for [ q: StyleQualifier ] in entry.bl.quals
                                if [ q.state ] has_state = true
                            if [ !has_state ] inst_type = meta_type
                        if [ inst_type ]
                            n : Au.new_object[inst_type, null, null, false, __FILE__, __LINE__, __SEQUENCE__]
                            ele : cast element [ home_object ]
                            home_type : typeid[ home_object ]
                            inst_type : typeid[ inst ]
                            n.set_context_from[ home_object ]
                            n.set_context_from[ inst ]
                            n.initialize[]
                            mc[entry.bl.key] = n
                            
                   
    # needs copies
    public func apply_style [ inst: element, style_avail: map StyleEntries[string], home_object:Au ]
        inst.pristine = false
        inst.maps_populated = false
        if [!inst.layers]
            inst.layers = map Layer[string] []
        if [ !style_avail ] return

        # first styling: class members already set by .ag code stay code-owned
        if [ !inst.code_styled ]
            inst.code_styled = vec string []
            for [ bty : typeid[ inst ], bty != typeid[ Au ], bty = bty.context ]
                for [ bm: i32 0, bm < bty.members.count, bm += 1 ]
                    bmem : Au_t bty.members.origin[bm]
                    if [ bmem.member_type != AU_MEMBER_VAR ] continue
                    if [ !bmem.src || !(bmem.src.traits & (1 << 11)) ] continue
                    if [ strcmp[ bmem.ident, "elements" ] == 0 || strcmp[ bmem.ident, "layers" ] == 0 ] continue
                    if [ strcmp[ bmem.ident, "style" ] == 0 ] continue
                    bv : Au inst.member_object[ bmem ]
                    if [ bv ] inst.code_styled.push[ string[ bmem.ident ] ]

        # create layers in the order they render
        cache_style[inst, style_avail, false, home_object]
        
        applied : map StyleEntry[string][]
        for [ ty : typeid[ inst ], ty != typeid[ Au ], ty = ty.context ]
            for [ m: i32 0, m < ty.members.count, m += 1 ]
                member : Au_t ty.members.origin[m]
                if [ member.member_type != AU_MEMBER_VAR || strcmp[ member.ident, "elements" ] == 0 ]
                    continue
                prop    : string [ member.ident ]
                entries : style_avail [ prop ]
                if [ !entries ]
                    continue
                #log 'apply_style:   {prop} entries={entries.count}'
                first : cast StyleEntry [ entries[0] ]

                if [ first.bl.property && first.bl.key ]
                    # find the layers member Au_t
                    for [ best : StyleEntry ] in entries
                        score : best.bl.score[ inst, true ]
                        if [ score == 0 ]
                            continue
                        f : (best.bl.key) ? '{best.member}.{best.bl.key}' : best.member
                        if [ applied[f] ]
                            continue
                        applied[f] = best

                        if [!best.member_map]
                            cache_style[inst, style_avail, true, home_object]

                        mc : cast Layers [ inst.member_object[ best.member_map ] ]
                        expect mc, "expected map container"
                        layer_inst  : mc.get[best.bl.key]
                        inst_type   : Au.__typeid[layer_inst]
                        layer_member : Au.find_member[ inst_type, best.member, AU_MEMBER_VAR, 0, true ]
                        if [ !layer_member ]
                            continue
                        expect layer_member, 'member not found on {inst_type.ident}: {best.member}'

                        if [ !best.instance ]
                            if [ (layer_member.src.traits & (1 << 11)) && !(best.value inherits vector) ]
                                # alloc is pool-managed: the entry must own it
                                best.instance = Au.new_object[ layer_member.src, null, null, false, __FILE__, __LINE__, __SEQUENCE__ ]
                                best.instance.hold[]
                                best.instance.set_context_from[ home_object ]
                                best.instance.call_construct[ st.themed[ best.value ] ]
                            el
                                # manual member: own the converted value
                                best.instance = Au.__convert[ layer_member.src, st.themed[ best.value ] ]
                                if [ best.instance ] best.instance.hold[]

                        cur : layer_inst.member_object[ layer_member ]
                        if [ !cur ]
                            cur = best.instance

                        transition_or_set[ inst, layer_inst, cur, layer_member, best ]

                el
                    if [ inst.code_styled.index_of[ prop ] >= 0 ]
                        continue
                    best : st.best_match[ inst, prop, entries ]
                    if [ !best ]
                        continue

                    # a UNIT resolves against this element, so it can never
                    # ride best.instance -- that is shared by every element
                    # the selector matches, and fc is per element. px is
                    # the odd one out: the scalars it lands on are all
                    # fc-denominated downstream, so divide it back out
                    # SCALARS ONLY. a Region member like 'area: 8px' owns
                    # the whole string and parses the unit itself
                    if [ best.unit && member.src == typeid[ f32 ] ]
                        sv : cast string [ best.value ]
                        nv : f32 [ f32 sv.real_value[] ]
                        # fc is ZERO here: style applies before layout_element
                        # ever sets it. 22.0 is the same base layout starts
                        # from, so px means px on the very first frame too --
                        # without it a 1px spacing read as one fc unit, 22px,
                        # and pushed the whole right-hand run off the bar
                        if [ best.unit == 'px' ]
                            fcv : f32 [ (inst.fc > 0.0) ? inst.fc : 22.0 ]
                            nv = nv / fcv
                        uv : Au.__convert[ member.src, nv ]
                        if [ uv ] inst.member_set[ member, uv ]
                        continue

                    if [ !best.instance ]
                        info      : header [ best.value ]
                        val_type  : Au_t [ info.au ]
                        meta_type : Au_t [ member.meta.a ]
                        vec_val : bool [ false ]
                        if [ best.value ] vec_val = best.value inherits collective
                        vec_mem : bool [ Au.inherits[ member.src, typeid[ vector ] ] ]
                        if [ vec_val && vec_mem ]
                            elem9    : Au_t [ member.meta.a ]
                            src_arr  : cast astrings [ best.value ]
                            dst9     : vec Au []
                            for [ s: string ] in src_arr
                                obj : Au.new_object[ elem9, null, null, false, __FILE__, __LINE__, __SEQUENCE__ ]
                                obj.set_context_from[ home_object ]
                                obj.call_construct[ st.themed[ s ] ]
                                dst9.push[ obj ]
                            best.instance = dst9
                            best.instance.hold[]
                        el [ member.src == typeid[ Au_t ] ]
                            str : cast string [ best.value ]
                            found_type : Au.find_type[ str.chars, null ]
                            if [ found_type ]
                                inst.member_set[ member, found_type ]
                            continue
                        el
                            if [ member.src.traits & (1 << 11) ]
                                # alloc is pool-managed: the entry must own it
                                best.instance = Au.new_object[ member.src, null, null, false, __FILE__, __LINE__, __SEQUENCE__ ]
                                best.instance.hold[]
                                best.instance.set_context_from[ home_object ]
                                best.instance.call_construct[ st.themed[ best.value ] ]
                            el
                                # manual member: own the converted value
                                best.instance = Au.__convert[ member.src, st.themed[ best.value ] ]
                                if [ best.instance ] best.instance.hold[]

                    cur : inst.member_object[ member ]
                    if [ !cur ]
                        cur = best.instance

                    transition_or_set[ inst, inst, cur, member, best ]

        # icon layer stays topmost over style-created layers
        if [ inst.layers ]
            bic3 : Layer inst.layers[ 'iconl' ]
            if [ bic3 ]
                bic3.hold[]
                inst.layers.rm[ 'iconl' ]
                inst.layers[ string[ 'iconl' ] ] = bic3
                bic3.drop[]


    public func animate []
        if [ !root ]
            return

        now          : i64 [ epoch_millis[] ]
        if [ !start_ms ]
            start_ms        = now
            last_frame_ms   = now
            time_anchor_ms  = now
            time_scale_last = time_scale
        raw : f32 [ (last_frame_ms > 0) ? f32[ now - last_frame_ms ] / 1000.0 : 0.016 ]
        frame_factor = (raw > 0.1) ? 1.0 : raw * 60.0
        # DERIVE from the wall clock, never accumulate per frame:
        # epoch_millis is whole milliseconds, so a per-frame delta
        # quantises to 0/1/2 ms and the motion visibly jerks. anchor it
        # instead, and re-anchor on a rate change so it cannot jump
        if [ time_scale != time_scale_last ]
            time_base       = time
            time_anchor_ms  = now
            time_scale_last = time_scale
        time = time_base
             + f64[ now - time_anchor_ms ] / 1000.0 / 1000.0 * f64[ time_scale ]
        #log 'frame_factor: raw={raw}s frame_factor={frame_factor}'
        last_frame_ms = now
        frame_seq += 1

        # the draw rate is chosen at RUNTIME, so it has to be pushed
        # every frame. update[] only runs on resize, so setting it
        # there latched whatever rate happened to be live at startup
        # and no speed change ever reached the renders again.
        # r_view is last and never throttled -- it is the screen
        if [ list && list.count > 1 ]
            # a camera easing between orbits draws every frame or the
            # move lands in visible steps instead of a glide
            rate : f32 [ (orbit_moving) ? 0.0 : background_hz ]
            for [ i: i32 0, i < list.count - 1, i += 1 ]
                render : Render list[i]
                render.draw_hz = rate
            # the backdrop itself paces the same: the chain only re-blurs a
            # backdrop that has redrawn
            if [ backdrop ] backdrop.draw_hz = rate

        # deferred focus: runs here, after input and before any draw.
        # NOT `focus_id && root` -- string && element is convertible, so
        # it casts the element to a string and cast_string walks the
        # tree's parent back-references until the stack is gone
        if [ focus_id ]
            if [ root ]
                found : focus_find[ root, focus_id ]
                if [ found ]
                    set_focus[ found ]
                    focus_id = null

        # background animates off the time just computed above
        root.animate_within [ ]

    func update_element [ parent: element, rendered: map element[string], force: bool ]
        if [!parent.elements] parent.elements = Elements[]

        home_type   : Au_t
        home_object : element

        # mark for umount
        for [ e:element, id:string ] in parent.elements
            if [ e ] e.flags |= 1

        # count rendered children for positional flags
        total_rendered : i32 [ 0 ]
        for [ e:element, id:string ] in rendered
            if [ e ] total_rendered += 1

        # iterate through rendered elements
        child_pos : i32 [ 0 ]
        for [ e:element, id:string ] in rendered
            # a null child means absent: its instance unmounts in the sweep
            if [ !e ] continue
            instance  : element* parent.elements[ id ]
            changed   : bool [ false ]
            new_inst  : false
            brand_new : false
            call_init : false

            if [ instance ]
                instance.flags &= ~1
                if [ !instance.id ]
                    brand_new = true # component within element map
                el [ typeid[instance] != typeid[e] ]
                    # the window must not keep pointing into what goes:
                    # a hover tip or a focus on it would read freed memory
                    for [ h: element* hovered, h, h = h.parent ]
                        if [ h == instance ]
                            hovered = null
                            break
                    for [ h: element* focus, h, h = h.parent ]
                        if [ h == instance ]
                            focus = null
                            break
                    if [ capture == instance ] capture = null
                    instance.release_tree[]
                    if [ instance.ux ] instance.ux.vk.defer_drop[ instance ]
                    parent.elements.rm[ id ]
                    instance = null

            if [ brand_new || !instance ]
                if [ id == "toolbar" ]
                    test2 :  2
                    test2 += 2
                    win : cast Window[ w ]
                    win.test_element = e
                
                new_inst         = true
                ndbg : handle [ fopen[ "/tmp/spl.txt", "a" ] ]
                if [ ndbg ]
                    fputs[ 'NEW {id} parent={parent.id} brand_new={brand_new} count={parent.elements.count}\n', ndbg ]
                    fclose[ ndbg ]
                if [ !instance ]
                    instance = e
                instance.pristine = false
                instance.id      = id
                instance.ux      = a
                instance.parent  = parent

                if [ !parent.elements ]
                    parent.elements = map element[string] [ ]

                if [ !brand_new ]
                    parent.elements[ id ] = instance

                # auto-bind instance to 'home' if defined
                if [ !home_type ]
                    home_type   = typeid[ parent ]
                    home_object = parent
                    if [ home_type == typeid[ element ]]
                        while [ home_object ]
                            home_object = home_object.parent
                            if [ !home_object ]
                                break
                            home_type   = typeid[ home_object ]
                            if [ home_type != typeid[ element ]]
                                break
                    if [ !home_object ]
                        home_object = cast element [ parent.ux.app_object ]
                        home_type   = typeid[ home_object ]
                
                imember : (home_type && id) ? find_member[ home_type, id.chars, AU_MEMBER_VAR, 0, true ] : null
                if [ imember && home_object && Au.inherits[ typeid[ instance ], imember.src ] ]
                    home_object.member_set[ imember, instance ]
                 
                instance.set_context_from[ home_object ]
                call_init = true
                changed = true
            el
                instance.parent = parent
                ta0 : i64 [ epoch_micros[] ]
                args_changed : bool apply_args[ instance, e ]
                a.t_apply_args += epoch_micros[] - ta0
                if [ args_changed ] instance.pristine = false
                changed = args_changed || !instance.pristine || force

            new_first  : bool [ child_pos == 0 ]
            new_last   : bool [ child_pos == total_rendered - 1 ]
            new_middle : bool [ child_pos > 0 && child_pos < total_rendered - 1 ]
            if [ instance.first != new_first || instance.last != new_last || instance.middle != new_middle ]
                instance.first  = new_first
                instance.last   = new_last
                instance.middle = new_middle
                changed = true
            instance.odd  = (child_pos % 2 == 0)
            instance.even = (child_pos % 2 == 1)
            new_has_value : bool [ instance.edit && instance.edit.count > 0 ]
            if [ instance.has_value != new_has_value ]
                instance.has_value = new_has_value
                changed = true
            child_pos += 1

            if [ changed ]
                avail  : (st) ? st.compute[ instance ] : null
                ts0 : i64 [ epoch_micros[] ]
                apply_style[ instance, avail, home_object ]
                a.t_apply_style += epoch_micros[] - ts0

                if [ call_init && !instance.initialized ]
                    if [ !text_mode ]
                        expect instance.vk, "no vk context set for new instance"
                    instance.initialize[]
                    bind_members[ instance ]
                    instance.initialized = true
                    instance.hold_members[]
                    instance.pristine = false
                    # defaults exist only now: integrate embedded style, restyle
                    if [ st && st.integrate_instance[ instance ] ]
                        avail2 : st.compute[ instance ]
                        apply_style[ instance, avail2, home_object ]
            inst    : typeid[ instance ]
            tr0 : i64 [ epoch_micros[] ]
            rendered_map : Elements instance.render*[]
            a.t_render += epoch_micros[] - tr0
            irender : Elements rendered_map
            if [ irender == null ] irender = e.elements
            if [ irender == null ] irender = instance.elements
            if [ irender != null ] update_element[ instance, irender, force ]
            if [ rendered_map ] drop[ rendered_map ]

        # perform umount on elements not updated in render
        retry : true
        while [ retry ]
            retry = false
            for [ e:element, id:string ] in parent.elements
                if [ !e ]
                    retry = true
                    parent.elements.rm[ id ]
                    break
                if [ e.flags & 1 ]
                    udbg : handle [ fopen[ "/tmp/spl.txt", "a" ] ]
                    if [ udbg ]
                        fputs[ 'UNMOUNT {id} parent={parent.id}\n', udbg ]
                        fclose[ udbg ]
                    e.flags  = 0
                    retry    = true
                    for [ h: element* hovered, h, h = h.parent ]
                        if [ h == e ]
                            hovered = null
                            break
                    for [ h: element* focus, h, h = h.parent ]
                        if [ h == e ]
                            focus = null
                            break
                    for [ h: element* capture, h, h = h.parent ]
                        if [ h == e ]
                            capture = null
                            break
                    e.release_tree[]
                    e.parent = null
                    # hold 8 frames so the dealloc cascade runs out of flight
                    if [ e.ux ] e.ux.vk.defer_drop[ e ]
                    parent.elements.rm[ id ]
                    break

        # paint + hit order is insertion order: mirror what render[] declared,
        # so a remount or a type swap cannot silently move an element
        rkeys : vec string []
        for [ e: element, id: string ] in rendered
            if [ e ] rkeys.push[ id ]
        same : bool [ true ]
        ix   : i32  [ 0 ]
        for [ e: element, id: string ] in parent.elements
            if [ ix >= rkeys.count || rkeys[ ix ].compare[ id ] != 0 ]
                same = false
                break
            ix += 1
        if [ !same || ix != rkeys.count ]
            ordered : Elements [ ]
            for [ k: string ] in rkeys
                inst : element parent.elements[ k ]
                if [ inst ] ordered[ k ] = inst
            parent.elements = ordered

    public func is_animating [] -> bool
        if [ !root ] return true
        if [ capture ] return true
        return root.is_animating[]

    func capture_context []
        if [ !isolate_session ] return
        ss : string [ isolate_session ]
        lr : last_render[]
        if [ lr && lr.color ]
            im : Image [ lr.color ]
            im.png[ path '/tmp/silver-app-{ss}.png' ]
        tr : cast trinity [ app_object ]
        if [ tr && root ]
            tree : map object [string] []
            tree['root'] = tr.ux_serialize[ root ]
            tp : path '/tmp/silver-app-{ss}.agi'
            tp.save[ Au.string_agi[ tree ], null ]

    func ide_open []
        if [ ide_active ] return
        capture_context[]
        app_size_w = width
        app_size_h = height
        iw : i32 [ (ide_size_w > 0) ? ide_size_w : 1888 ]
        ih : i32 [ (ide_size_h > 0) ? ide_size_h : 888 ]
        if [ glfw && (iw != width || ih != height) ] platform_window_set_size[ glfw, iw, ih ]
        ide_active = true
        host_post[ 0, i32[ HM.shell ], 1, 0, 0 ]
        restyle = true

    func ide_restore_size []
        ide_size_w = width
        ide_size_h = height
        if [ glfw && app_size_w > 0 && app_size_h > 0 ]
            platform_window_set_size[ glfw, app_size_w, app_size_h ]

    func app_render [] -> Elements
        e : Elements [ ]
        e[ 'app' ] = cast element [ app_object ]
        ae : cast element [ app_object ]
        if [ ae && ae.ux_generics ]
            e[ 'uxgenerics' ] = UXGenerics [ topmost: true, target: ae ]
        if [ ide_active ]
            e[ 'hostedshell' ] = IDEOverlay [ topmost: true ]
        if [ shot_ask && !agent_min ]
            e[ 'shot_bg' ] = ShotBackdrop [ topmost: true ]
            # the agent to send to, chosen at the prompt; it fades out with
            # the move to the conversation
            nm9 : vec string agent_names[ app_object ]
            ix9 : i32 [ 0 ]
            for [ k9: i32 0, k9 < nm9.count, k9 += 1 ]
                if [ agent_pick && agent_pick == nm9[ k9 ] ] ix9 = k9
            # a mounted picker owns its selection: re-mounting with the
            # stored index would stamp the user's press back every frame
            if [ root && root.elements ]
                pk0 : element root.elements[ 'agent_pick' ]
                if [ pk0 && pk0 inherits TButtons ]
                    tb0 : TButtons pk0
                    if [ tb0.selected >= 0 && tb0.selected < nm9.count ] ix9 = tb0.selected
            if [ agent_view ]
                e[ 'unotes' ] = ShotUser   [ topmost: true, area: Region [ 'l24px b-15%+594px w440px h420px' ] ]
                e[ 'shot' ]   = ShotPrompt [ topmost: true, area: Region [ 'l32px b-15%+220px w424px h40px' ], label: 'prompt description' ]
            el
                e[ 'unotes' ] = ShotUser   [ topmost: true ]
                e[ 'shot' ]   = ShotPrompt [ topmost: true, label: 'prompt description' ]
            if [ agent_view ]
                e[ 'notes' ]  = ShotNotes [ topmost: true ]
            # the picker last: over the blur and the boxes
            pw9 : i32 [ i32[ nm9.count ] * 96 ]
            e[ 'agent_pick' ] = AgentPick [ topmost: true, buttons: nm9, selected: ix9, faded: agent_view,
                icons: false, manual: false, seg_radius: 6.0, label_px: 13.0, rest_glow: rgba [ '#ccf2' ], rest_px: 16.0,
                area: Region [ 'l50%-{pw9 / 2}px b282px w{pw9}px h28px' ] ]
        # the app's exchange avatar is one instance, mounted for the life of
        # the app and invisible between exchanges: it is never torn down.
        # mounted AFTER the blur, or the blur paints over it
        av : element [ (ae) ? ae.agent_avatar*[] : null ]
        if [ av ] e[ 'agent_av' ] = av
            # the field takes focus once the tree holds it: this render's
            # instance is not the one that gets mounted
            if [ root && root.elements ]
                tf : element root.elements[ 'shot' ]
                if [ tf && focus != tf ] set_focus[ tf ]
        return e

    public func update_all [ render: Elements ]
        if [ !root ]
            root    = element [ id: string[ 'root' ], ux:a ]
            root.initialize[]
            root.initialized = true
            root_styles = (st) ? st.compute[ root ] : null
            restyle = true

        force_restyle : (!restyle && st) ? st.check_reload[] : false
        if [ force_restyle ]
            root_styles = st.compute[ root ]
            restyle     = true

        if [ force_restyle ]
            root.invalidate_transitions[ ]
            apply_style[ root, root_styles, null ]
            root.remove_invalid_transitions[ ]

        t_apply_args  = 0
        t_apply_style = 0
        t_render      = 0
        t0 : i64 [ epoch_micros[] ]
        update_element[ root, render, restyle ]
        render.drop[]
        t1 : i64 [ epoch_micros[] ]
        dt : i64 [ t1 - t0 ]
        restyle = false

    public func set_capture [ e: element ]
        if [ capture != e ]
            if [ capture ]
                capture.captured = false
                capture.pristine = false
            if [ e && !e.ghost ]
                capture = e
                capture.captured = true
                capture.pristine = false

    public func release_capture [ e: element ]
        if [ capture && capture == e ]
            capture = null

    # depth-first lookup by id, for the deferred focus above
    intern func focus_find [ e: element, id: string ] -> element
        if [ !e || !e.elements || !id ] return null
        direct : element e.elements[ id ]
        if [ direct ] return direct
        for [ ce: element, ck: string ] in e.elements
            found : element focus_find[ ce, id ]
            if [ found ] return found
        return null

    public func set_focus [ e: element ]
        if [ focus != e ]
            if [ focus ]
                focus.focused = false
                focus.pristine = false
            if [ e && !e.ghost ]
                focus = e
                focus.focused = true
                if [ focus.sel_col < 0 ]
                    focus.sel_col    = focus.edit->count
                    focus.anchor_col = focus.sel_col
                focus.pristine = false

    public func release_focus [ e: element ]
        if [ focus && focus == e ]
            focus.focused = false
            focus.pristine = false
            focus = null

    public func seam_cursor [ kind: i32 ]
        if [ kind == cursor_kind ] return
        g : handle [ Au.live_window_get[] ]
        if [ !g ] return
        cursor_kind = kind
        # 1 = horizontal resize, 2 = vertical resize, else arrow
        platform_set_cursor[ g, kind ]

    # mouse lock: the cursor hides and sits at the element's centre; every move
    # reaches the element as ev.mouse.delta from there. Esc releases. a hosted
    # app has no cursor of its own, so it asks the ide to lock for it
    func lock_centre [ e: element ] -> vec2f
        return [ f32[ i32[ e.bounds.x + e.bounds.w * 0.5 ] ], f32[ i32[ e.bounds.y + e.bounds.h * 0.5 ] ] ]

    public func mouse_lock [ e: element ]
        if [ !e || !e.bounds ] return
        locked = e
        c : vec2f lock_centre[ e ]
        g : handle [ Au.live_window_get[] ]
        if [ g ]
            platform_cursor_lock[ g, 1 ]
            platform_warp_cursor[ g, i32[ c.x ], i32[ c.y ] ]
        mouse     = c
        last_move = c
        host_post[ 0, i32[ HM.lock ], 1, i32[ c.x ], i32[ c.y ] ]     # hosted: the ide locks for us; standalone: no channel, dropped

    # interleaved s16 stereo frames at the app's rate, linearly resampled to 48 kHz for ffmpeg,
    # with whatever the microphone has captured since last time mixed in
    # stereo frames at the app's rate (8192 at most per call at 12 kHz and up)
    # drain a slot's sound ring into the recording: our own slot, or a pane
    # instance's from orbiter. nothing is read while no recording wants sound
    public func record_pull [ slot: i32 ]
        if [ !rec ] return
        buf : local i16 [ 8192 ]
        for [ true ]
            n : i32 [ host_audio_take[ slot, @buf[ 0 ], 4096 ] ]
            if [ n <= 0 ] break
            rt : i32 [ host_audio_rate[ slot ] ]
            if [ rt <= 0 ] continue
            record_rate = rt
            record_audio[ @buf[ 0 ], n, rt ]

    public func record_audio [ pcm: @i16, nfr: i32, rate: i32 ]
        if [ !rec || nfr <= 0 || rate <= 0 ] return
        n : i32 [ resample[ pcm, nfr, 2, rate, @rec_out[ 0 ], 32768, @rec_pos ] ]
        if [ mic ] mic.add_into[ @rec_out[ 0 ], n ]
        rec.put[ @rec_out[ 0 ], n ]

    # open the system's recording input and read it on its own thread
    public func mic_start []
        ifndef [ windows ]
            if [ mic_on ] return
            mic    = AudioRing [ ]
            mic_on = true
            tid : local u64 [ 1 ]
            pthread_create[ tid, null, @mic_entry, a ]

    func mic_entry [] -> none
        ifndef [ windows ]
            rate : local i32 [ 1 ] [ 0 ]
            if [ !platform_mic_open[ @rate[ 0 ] ] ]
                log 'record: no microphone'
                mic_on = false
                return
            log 'record: microphone on at {rate[ 0 ]} Hz'
            # the device runs at whatever rate it has; the track is 48 kHz, so resample
            mpos   : f64 [ 0.0 ]
            mono   : local i16 [ 1024 ]
            stereo : local i16 [ 4096 ]
            while [ mic_on ]
                got : i32 [ platform_mic_read[ @mono[ 0 ], 480 ] ]
                if [ got < 0 ] break
                if [ got == 0 ]
                    usleep[ 2000 ]
                    continue
                n : i32 [ resample[ @mono[ 0 ], got, 1, rate[ 0 ], @stereo[ 0 ], 2048, @mpos ] ]
                # the app's sound owns the track once it starts; until then the mic feeds it alone
                if [ record_rate == 0 ]
                    if [ rec ] rec.put[ @stereo[ 0 ], n ]
                el
                    mic.put[ @stereo[ 0 ], n ]
            platform_mic_close[]

    public func mouse_unlock []
        if [ !locked ] return
        locked = null
        g : handle [ Au.live_window_get[] ]
        if [ g ] platform_cursor_lock[ g, 0 ]
        host_post[ 0, i32[ HM.lock ], 0, 0, 0 ]

    # near: the pointer within half an element's size of its edges, in
    # window space (a parent's bounds never confine it): the :near style
    # state. every move re-evaluates the whole tree, since an element that
    # is not repainting still has to notice the pointer approaching. ox,oy
    # is the parent's window-space origin with its scroll taken out
    func near_walk [ e: element, ox: f32, oy: f32 ]
        if [ !e || !e.elements ] return
        for [ c: element, id: string ] in e.elements
            # a render may leave a null slot (a chip that is not up)
            if [ !c || !c.bounds ] continue
            cx : f32 [ ox + c.bounds.x - ((c.no_scroll) ? 0.0 : e.scroll.x) ]
            cy : f32 [ oy + c.bounds.y - ((c.no_scroll) ? 0.0 : e.scroll.y) ]
            if [ !c.hide && c.opacity > 0.0 && c.bounds.w > 0.0 && c.bounds.h > 0.0 ]
                hw : f32 [ c.bounds.w * 0.5 ]
                hh : f32 [ c.bounds.h * 0.5 ]
                mx : f32 [ f32[ mouse.x ] ]
                my : f32 [ f32[ mouse.y ] ]
                nr : bool [ mx >= cx - hw && mx < cx + c.bounds.w + hw && my >= cy - hh && my < cy + c.bounds.h + hh ]
                if [ nr != c.near ]
                    c.near = nr
                    for [ p: element* c, p, p = p.parent ] p.pristine = false
                    restyle = true
            near_walk[ c, cx, cy ]

    public func find_target [ e: element, ev: Event, must: element ] -> element
        if [ !e || !e.bounds || e.disable || e.ghost || e.hide || e.opacity <= 0.0 ]
            return null
        b : rect  [ e.bounds ]
        x : f32   [ ev.mouse.pos.x ]
        y : f32   [ ev.mouse.pos.y ]
        lx : f32  [ x - b.x ]
        ly : f32  [ y - b.y ]

        if [ !must && (lx < 0.0 || ly < 0.0 || lx >= b.w || ly >= b.h) ]
            return null

        bw : f32 [ (b.w > 0.0) ? b.w : 1.0 ]
        bh : f32 [ (b.h > 0.0) ? b.h : 1.0 ]
        e.cursor_pos = vec2f [ x: lx / bw, y: ly / bh ]

        fx : f32 [ lx + e.scroll.x ]
        fy : f32 [ ly + e.scroll.y ]
        ev.mouse.pos.x = fx
        ev.mouse.pos.y = fy

        for [ child: element, id: string ] reverse in e.elements
            if [ !child.topmost ] continue
            relx : bool [ child.area && child.area.l.relative ]
            rely : bool [ child.area && child.area.t.relative ]
            ev.mouse.pos.x = (child.no_scroll || !relx) ? lx : fx
            ev.mouse.pos.y = (child.no_scroll || !rely) ? ly : fy
            hit : find_target[ child, ev, must ]
            if [ hit ]
                return hit
        for [ child: element, id: string ] reverse in e.elements
            if [ child.topmost ] continue
            relx : bool [ child.area && child.area.l.relative ]
            rely : bool [ child.area && child.area.t.relative ]
            ev.mouse.pos.x = (child.no_scroll || !relx) ? lx : fx
            ev.mouse.pos.y = (child.no_scroll || !rely) ? ly : fy
            hit : find_target[ child, ev, must ]
            if [ hit ]
                return hit

        ev.mouse.pos.x = fx
        ev.mouse.pos.y = fy
        r : element [ ( e.user_events && (!must || must == e) ) ? e : null ]
        if [ !r ]
            ev.mouse.pos.x = x
            ev.mouse.pos.y = y
        return r

    public func text_event [ ev: Event ]
        ev.target = focus
        if [ focus && focus.on_char*[ ev ] ] return
        if [ app_object && app_object.on_char*[ ev ] ] return
        if [ focus && ev.key.text && ev.key.text.count > 0 ]
            for [ l: Layer, k: string ] in focus.layers
                if [ l.editable ]
                    l.on_char[ ev ]
                    break

    func dirty_tree [ e: element* ]
        if [ !e ] return
        e.pristine = false
        if [ e.elements ]
            for [ ce: element, ck: string ] in e.elements
                dirty_tree[ ce ]

    # one control changed level; the first pass only records the resting state
    func pad_emit [ j: i32, slot: i32, code: i32, on: u8 ]
        if [ on == pad_state[ j * 96 + slot ] ] return
        pad_state[ j * 96 + slot ] = on
        if [ !pad_said ] return
        ev.clear[]
        ev.pad.pad    = j
        ev.pad.button = code
        ev.pad.state  = i32[ on ]
        pad_event[ ev ]

    # device motion: accelerometer (g) + gyro (rad/s); false on a desktop
    public func motion [ ac: @f32, gy: @f32 ] -> bool
        return platform_motion[ ac, gy ]

    # interface orientation: 0 portrait, 1 landscape-left, 2 landscape-right.
    # accelerometer axes are DEVICE-relative, so tilt steering has to correct
    # for which way round the interface is or it inverts
    public func orientation [ ] -> i32
        return platform_orientation[ ]

    # stable per-install id (ios identifierForVendor). used to mark a player's
    # own row in an online record list
    # peer-to-peer, the shape the old game's GKSession had. the app supplies a
    # receive handler and sends bytes; pairing is automatic
    public func peer_start [ service: string ] -> bool
        return platform_peer_start[ service.chars ]

    public func peer_stop [ ]
        platform_peer_stop[ ]

    public func peer_connected [ ] -> bool
        return platform_peer_connected[ ]

    # ios shows no soft keyboard unless the view is asked; harmless elsewhere
    public func show_keyboard [ on: bool ]
        if [ glfw ] platform_show_keyboard[ glfw, on ]

    public func peer_name [ ] -> string
        cs : symbol [ platform_peer_name[ ] ]
        if [ !cs ] return ''
        return string[ cs ]

    public func peer_send [ data: @u8, len: i32, reliable: bool ]
        platform_peer_send[ data, len, reliable ]

    # drain one packet; 0 when nothing is waiting
    public func peer_poll [ out: @u8, max: i32 ] -> i32
        return platform_peer_poll[ out, max ]

    public func device_id [ ] -> string
        cs : symbol [ platform_device_id[ ] ]
        if [ !cs ] return ''
        return string[ cs ]

    # joysticks are polled, not called back. a d-pad is an axis pair on
    # most gamepads and a hat on others, so all three are read here
    public func pad_pump [ ]
        for [ j: i32 0, j < 16, j += 1 ]
            if [ !platform_joystick_present[ j ] ] continue
            nb : i32 [ 0 ]
            b  : @u8 [ platform_joystick_buttons[ j, @nb ] ]
            na : i32 [ 0 ]
            ax : @f32 [ platform_joystick_axes[ j, @na ] ]
            nh : i32 [ 0 ]
            ht : @u8 [ platform_joystick_hats[ j, @nh ] ]
            if [ b ]
                if [ nb > 32 ] nb = 32
                for [ i: i32 0, i < nb, i += 1 ]
                    pad_emit[ j, i, i, b[i] ]
            if [ ax ]
                if [ na > 16 ] na = 16
                for [ i: i32 0, i < na, i += 1 ]
                    v : f32 [ ax[i] ]
                    pad_emit[ j, 32 + i * 2,     1000 + i * 2,     (v < -0.5) ? u8[1] : u8[0] ]
                    pad_emit[ j, 32 + i * 2 + 1, 1000 + i * 2 + 1, (v >  0.5) ? u8[1] : u8[0] ]
            if [ ht ]
                if [ nh > 4 ] nh = 4
                for [ i: i32 0, i < nh, i += 1 ]
                    hv : i32 [ i32[ ht[i] ] ]
                    for [ d: i32 0, d < 4, d += 1 ]
                        pad_emit[ j, 64 + i * 4 + d, 2000 + i * 4 + d, ((hv >> d) & 1) ? u8[1] : u8[0] ]
        pad_said = true

    public func pad_event [ ev: Event ]
        ev.target = focus
        if [ focus && focus.on_pad*[ ev ] ] return
        if [ app_object ] app_object.on_pad*[ ev ]

    public func key_event [ ev: Event ]
        if [ screenshot_active ]
            if [ ev.key.state && ev.key.unicode == 256 ]
                screenshot_end[]
                screenshot_blur = null
            el [ ev.key.state && ev.key.unicode == 257 ]
                screenshot_path = null
                screenshot_save[]
                screenshot_end[]
                # the crop taken: a line to the agent goes with it
                if [ screenshot_path ] exchange_open[ screenshot_path, 0, false ]
            return
        if [ ev.key.state && ev.key.shift &&
             (ev.key.ctrl || ev.key.meta) && ev.key.unicode == 83 ]
            screenshot_begin[]
            return
        s2 : bool [ ev.key.shift ]
        if [ ev.key.unicode == 340 || ev.key.unicode == 344 ] s2 = (ev.key.state) ? true : false
        if [ shift != s2 ]
            shift = s2
            if [ root ] dirty_tree[ root ]
            will_animate = true
        # esc releases a mouse lock; the key still travels so a hosted app releases its side too
        if [ locked && ev.key.unicode == 256 && ev.key.state ] mouse_unlock[]
        # esc leaves full-screen: the app's display says so, and its updater acts
        if [ fs_active && ev.key.unicode == 256 && ev.key.state ]
            ae9 : element [ cast element [ app_object ] ]
            if [ ae9 ] ae9.display = DisplayMode.Window
            el set_fullscreen[ false ]
        ev.target = focus
        if [ focus && focus.on_key*[ ev ] ] return
        # esc while dictating CANCELS the take — nothing submits
        if [ ev.key.unicode == 256 && ev.key.state && dict_on ]
            dict_on   = false
            dict_live = false
            host_dictate_set[ 2 ]
            restyle = true
            return
        if [ ev.key.unicode == 256 && root ]
            sh : cast UXGenerics [ root.elements[ 'uxgenerics' ] ]
            if [ sh && sh.show_console ]
                sh.show_console = false
                restyle = true
                return
        if [ app_object && app_object.on_key*[ ev ] ] return
        if [ focus ]
            for [ l: Layer, k: string ] in focus.layers
                if [ l.editable ]
                    l.on_key[ ev ]
                    break

    public func drop_event [ ev: Event ]
        ev.target = focus
        if [ focus && focus.on_drop*[ ev ] ] return
        if [ app_object && app_object.on_drop*[ ev ] ] return
        if [ focus && ev.key.text && ev.key.text.count > 0 ]
            for [ l: Layer, k: string ] in focus.layers
                if [ l.editable ]
                    l.on_char[ ev ]
                    break

    # the cursor left the window entirely. GLFW stops sending motion at
    # the edge, so without this the last element keeps its hover lit --
    # same leave path move_event runs, just with nothing to hand it to.
    # CAPTURE is left alone on purpose: a drag that wanders outside is
    # still that drag, and it has to survive coming back in
    public func clear_hover [ ev: Event ]
        prev : element [ hovered ]
        if [ !prev ] return
        hovered       = null
        prev.hovered  = false
        prev.pristine = false
        restyle       = true
        leave_consumed : bool [ false ]
        for [ e: element* prev, e && !leave_consumed, e = e.parent ]
            ev.target = e
            if [ e.on_leave*[ ev ] ] leave_consumed = true
        if [ !leave_consumed && app_object ]
            ev.target = prev
            app_object.on_leave*[ ev ]

    public func move_event [ ev: Event ]
        if [ screenshot_active ]
            if [ screenshot_dragging ]
                p : vec2f screenshot_point[ ev.mouse.pos ]
                screenshot_x1 = p.x
                screenshot_y1 = p.y
                will_animate = true
            return
        ev.mouse.delta = [ ev.mouse.pos.x - last_move.x, ev.mouse.pos.y - last_move.y ]
        last_move = ev.mouse.pos
        if [ locked ]
            if [ !locked.bounds ]
                mouse_unlock[]
            el
                c : vec2f lock_centre[ locked ]
                if [ ev.mouse.pos.x == c.x && ev.mouse.pos.y == c.y ] return   # the warp back reports itself
                ev.mouse.delta = [ ev.mouse.pos.x - c.x, ev.mouse.pos.y - c.y ]
                ev.origin = locked
                ev.target = locked
                locked.on_move*[ ev ]
                if [ app_object && app_object != locked ] app_object.on_move*[ ev ]
                g : handle [ Au.live_window_get[] ]
                if [ g ] platform_warp_cursor[ g, i32[ c.x ], i32[ c.y ] ]
                mouse     = c
                last_move = c
                return
        orig_pos : vec2f [ ev.mouse.pos ]
        mouse.x = f64[ ev.mouse.pos.x ]
        mouse.y = f64[ ev.mouse.pos.y ]
        near_walk[ root, 0.0, 0.0 ]
        f : find_target[ root, ev, null ]
        ev.origin = f
        m : element [ f ]
        if [ capture ]
            ev.mouse.pos = orig_pos
            m = find_target[ root, ev, capture ]
            # a re-instanced tree orphans the capture: never eat the move
            if [ !m ]
                ev.mouse.pos = orig_pos
                m = find_target[ root, ev, null ]
        move_pos : vec2f [ ev.mouse.pos ]
        # hover / leave bubble runs in screen space, as before
        ev.mouse.pos = orig_pos
        if [ hovered != f ]
            prev : element [ hovered ]
            if [ prev ]
                if [ prev inherits Button ]
                    prev = prev
                prev.hovered = false
                prev.pristine = false
                restyle = true
                
                leave_consumed : bool [ false ]
                for [ e: element* prev, e && !leave_consumed, e = e.parent ]
                    ev.target = e
                    if [ e.on_leave*[ ev ] ] leave_consumed = true
                if [ !leave_consumed && app_object ]
                    ev.target = prev
                    app_object.on_leave*[ ev ]
            if [ stats ] log 'HOVER {(prev && prev.id) ? prev.id : "(none)"} -> {(f && f.id) ? f.id : "(none)"} at {ev.mouse.pos.x},{ev.mouse.pos.y}'
            hovered = f
            if [ f ]
                f.hovered = true
                f.pristine = false
                restyle = true
                hover_consumed : bool [ false ]
                for [ e: element* f, e && !hover_consumed, e = e.parent ]
                    ev.target = e
                    if [ e.on_hover*[ ev ] ] hover_consumed = true
                if [ !hover_consumed && app_object ]
                    ev.target = f
                    app_object.on_hover*[ ev ]
        ev.mouse.pos = move_pos
        if [ m ]
            move_consumed : bool [ false ]
            for [ e: element* m, e && !move_consumed, e = e.parent ]
                ev.target = e
                if [ e != app_object ] e.on_move*[ ev ]
                ev.mouse.pos.x += e.bounds.x - e.scroll.x
                ev.mouse.pos.y += e.bounds.y - e.scroll.y
            if [ !ev.no_propagation && app_object ]
                ev.target = m
                app_object.on_move*[ ev ]
        el [ app_object ]
            # drags must keep flowing to the app between hit targets
            ev.target = null
            app_object.on_move*[ ev ]
        ev.mouse.pos = move_pos
        if [ f && f.layers ]
            sbl : cast ScrollLayer [ f.layers['scrollbar'] ]
            if [ sbl && sbl.scroll_max > 0.0 ]
                fr : f32 [ (1.0 - f.cursor_pos.x) * f.bounds.w ]
                if [ fr < 90.0 ]
                    f.pristine = false
                    will_animate = true
        if [ focus && focus.text_dragging ]
            for [ l: Layer, k: string ] in focus.layers
                if [ l.editable ]
                    l.on_move[ ev ]
                    break

    public func wheel_event [ ev: Event ]
        if [ screenshot_active ] return
        target_el : element [ (capture) ? capture : find_target[ root, ev, null ] ]
        ev.origin = target_el
        consumed_w : bool [ false ]
        # the app element is served by the fallback below, with the hit
        # element as target; calling it here too would double every event
        for [ e: element* target_el, e && !consumed_w, e = e.parent ]
            if [ e == app_object ] continue
            ev.target = e
            e.on_wheel*[ ev ]
        if [ !ev.no_propagation && app_object ]
            ev.target = target_el
            app_object.on_wheel*[ ev ]

    public func press_event [ ev: Event ]
        if [ screenshot_active ]
            if [ ev.mouse.button == 0 ]
                p : vec2f screenshot_point[ ev.mouse.pos ]
                screenshot_x0       = p.x
                screenshot_y0       = p.y
                screenshot_x1       = p.x
                screenshot_y1       = p.y
                screenshot_dragging = true
                will_animate        = true
            return
        world_m : vec2f [ ev.mouse.pos ]   # world coords before find_target mangles it
        if [ ev.mouse.button == 0 ]
            now : i64 [ epoch_micros[] ]
            dx  : f32 [ world_m.x - last_click_pos.x ]
            dy  : f32 [ world_m.y - last_click_pos.y ]
            ev.mouse.double_click = (last_click_us > 0) && (now - last_click_us) < 350000 && (dx * dx + dy * dy) <= 36.0
            last_click_us  = now
            last_click_pos = world_m
        f : find_target[ root, ev, null ]
        target : string [ (f && f.id) ? f.id : '(none)' ]
        parent : string [ (f && f.parent && f.parent.id) ? f.parent.id : '(none)' ]
        log 'PRESS at {world_m.x},{world_m.y} -> {target} in {parent}'
        if [ f && f.elements ]
            for [ c: element, cid: string ] in f.elements
                if [ c.bounds ]
                    log '  child {cid} @ {c.bounds.x},{c.bounds.y} {c.bounds.w}x{c.bounds.h}'
        press_route[ f, ev ]

    # dispatch to a KNOWN target: the routing press_event does after hit-test
    public func press_route [ f: element, ev: Event ]
        release_capture[ capture ]
        ev.origin = f
        element_pos : vec2f [ ev.mouse.pos ]
        consumed_p : bool [ false ]
        for [ e: element* f, e, e = e.parent ]
            cl : typeid[e]
            ev.target = e
            if [ e == app_object ] continue
            e.on_press*[ ev ]
            ev.mouse.pos.x += e.bounds.x - e.scroll.x
            ev.mouse.pos.y += e.bounds.y - e.scroll.y
            if [ ev.no_propagation ]
                break

        # the style inspector is the FALLBACK for a modifier click, never
        # the first claim: an element with its own ctrl/cmd gesture (the
        # editor's goto-definition) sets no_default and keeps it
        if [ f && (ev.key.meta || ev.key.ctrl) && !ev.no_default ]
            if [ f.source && app_object ]
                cur : vec StyleHit []
                cur.push[ StyleHit [ file: path '{f.source}', line: f.line ] ]
                app_object.on_inspect*[ cur ]
            ev.no_propagation = true
            ev.no_default     = true
            return

        au : typeid[ f ]
        # app
        if [ !ev.no_propagation && app_object ]
            ev.target = f
            app_object.on_press*[ ev ]
        edit_l : Layer [ null ]
        if [ f && !f.read_only ]
            for [ l: Layer, k: string ] in f.layers
                if [ l.editable ]
                    edit_l = l
                    break
        if [ ev.mouse.button == 0 && f && (f.focusable || edit_l) && !ev.no_default ]
            set_focus[ f ]
        if [ edit_l && ev.mouse.button == 0 ]
            ev.mouse.pos = element_pos
            edit_l.on_press[ ev ]
        if [ !capture ]
            set_capture[ f ]
        if [ ev.mouse.button == 0 ]
            if [ action_pressed ]
                action_pressed.pristine = false
                action_pressed.pressed = false
            if [ f ]
                f.pristine = false
                f.pressed = true
                restyle = true
            
            action_pressed = f
        el [ ev.mouse.button == 1 ]
            context_pressed = f

    public func release_event [ ev: Event ]
        if [ screenshot_active ]
            if [ ev.mouse.button == 0 && screenshot_dragging ]
                p : vec2f screenshot_point[ ev.mouse.pos ]
                screenshot_x1       = p.x
                screenshot_y1       = p.y
                screenshot_dragging = false
                will_animate        = true
            return
        f : find_target[ root, ev, capture ]
        release_route[ f, ev ]

    public func release_route [ f: element, ev: Event ]
        ev.origin = f
        same_i : bool [ action_pressed == f ]
        consumed_r : bool [ false ]
        for [ e: element* f, e && !consumed_r, e = e.parent ]
            if [ e == app_object ] continue
            ev.target = e
            if [ e.on_release*[ ev ] ] consumed_r = true
        if [ !consumed_r && app_object ]
            ev.target = f
            app_object.on_release*[ ev ]
        if [ ev.mouse.button == 0 ]
            if [ action_pressed ]
                action_pressed.pristine = false
                action_pressed.pressed = false
            if [ f ]
                f.pristine = false
                f.pressed = false
                restyle = true
            
            if [ f && action_pressed == f && f.hovered ]
                for [ e: element* f, e, e = e.parent ]
                    ev.target = e
                    e.on_click*[ ev ]
                    if [ ev.no_propagation ]
                        break
                if [ !ev.no_propagation && app_object ]
                    ev.target = f
                    app_object.on_click*[ ev ]
            action_pressed  = null
            context_pressed = null
        el [ ev.mouse.button == 1 ]
            action_pressed  = null
            context_pressed = null
        if [ !action_pressed && !context_pressed ]
            release_capture[ capture ]
        if [ focus && focus.text_dragging ]
            for [ l: Layer, k: string ] in focus.layers
                if [ l.editable ]
                    l.on_release[ ev ]
                    break
    
    # unset follows the backdrop element's own frost_sharp
    func frost_eff [ ] -> i32
        if [ frost_mode >= 0 ] return frost_mode
        if [ backdrop && backdrop.owner && backdrop.owner.frost_sharp ] return 1
        return 0

    # the three stages the panels can read, sharpest last. soft and raw
    # both showed the original render and were one stage in practice,
    # so they are one in name too: clear.
    # r_reduce is NOT a reduction -- it is wscale 1.0 off the backdrop,
    # a full-res pass-through. it only heads the chain that reduces
    # stage 3, solid: the scene is not rendered at all; the background
    # shader paints solid_color, the theme's flat background
    public func frost_name [ ] -> string
        e : i32 [ frost_eff[] ]
        if [ e == 1 ] return 'blur'
        if [ e == 2 ] return 'clear'
        if [ e == 3 ] return 'solid'
        return 'frost'

    public func frost_step [ d: i32 ]
        frost_mode = (frost_eff[] + d + 4) % 4

    func frost_src [ ] -> Render
        e : i32 [ frost_eff[] ]
        if [ e == 1 ] return rb_blur.last[]
        if [ e == 2 ] return r_reduce
        return rb_frost.last[]

    func blur_src [ ] -> Render
        e : i32 [ frost_eff[] ]
        if [ e == 1 ] return rb_soft.last[]
        if [ e >= 2 ] return r_reduce
        return rb_blur.last[]

    # resize REPLACES render color attachments: every stage's sampler map
    # still points at the dead texture, and rebind_model faithfully
    # rebinds to it. re-wire the chain from CURRENT colors, in order
    func rewire_frost [ ]
        backdrop_once = true
        if [ !m_view ] return
        # no frost element ever appeared: there is no chain to wire. the
        # composite reads the background for all three samplers
        if [ !m_reduce ]
            # no chain: background, frost and blur are all the backdrop, so
            # ux.frag's blur/frost branch resolves to the real image
            src8 : Texture [ (backdrop) ? backdrop.color : compose.color ]
            m_view.samplers = map Texture[string] [
                'background': src8,
                'frost':      src8,
                'blur':       src8,
                'compose':    compose.color ]
            m_view.rebind_model[]
            return
        src9 : Texture [ (backdrop) ? backdrop.color : compose.color ]
        m_reduce.samplers  = map Texture[string] [ 'color': src9 ]
        m_reduce.rebind_model[]
        rb_blur.rewire[ r_reduce.color ]
        rb_soft.rewire[ rb_blur.stage[ 0 ] ]
        rb_frost.rewire[ rb_blur.stage[ 1 ] ]
        fr : frost_src[]
        bl : blur_src[]
        m_view.samplers = map Texture[string] [
            'background': src9,
            'frost':      (fr) ? fr.color : rb_frost.color[],
            'blur':       (bl) ? bl.color : rb_blur.color[],
            'compose':    compose.color ]
        m_view.rebind_model[]
        frost_bound = frost_eff[]

    # the blur/frost passes are built ONLY when an element actually declares
    # frost. a game window never has one, so they are never created, never
    # allocated and never drawn -- 11 passes, 6 of them full-resolution
    func build_frost_chain [ ]
        if [ chain ] return
        ctx: vk_context[ a.vk ]
        source : Texture [ (backdrop) ? backdrop.color : compose.color ]

        m_reduce  = Model  [ w: a, samplers: map Texture[string] [ 'color': source ] ]
        r_reduce  = Render [ vk: ctx, w: a, wscale: 1.0, models: [m_reduce ] ]
        m_reduce.hold[]
        r_reduce.hold[]

        # the reduce-then-blur units: blur halves the copy twice and blurs
        # at 1/4; soft blurs the first half at 1/2; frost halves the quarter
        # twice more and blurs at 1/16
        rb_blur  = ReduceBlur []
        rb_blur.hold[]
        rb_blur.build[ ctx, a, r_reduce.color, 1.0, 2 ]
        rb_soft  = ReduceBlur []
        rb_soft.hold[]
        rb_soft.build[ ctx, a, rb_blur.stage[ 0 ], 0.5, 0 ]
        rb_frost = ReduceBlur []
        rb_frost.hold[]
        rb_frost.build[ ctx, a, rb_blur.stage[ 1 ], 0.25, 2 ]

        chain = vec Render []
        chain.push[ r_reduce ]
        rb_blur.append[ chain ]
        rb_soft.append[ chain ]
        rb_frost.append[ chain ]
        chain.push[ r_view ]
        rewire_frost[]
        list = chain

    # whichever element declared frost owns the backdrop; no app rigging.
    # with no frost element the composite still needs a real background --
    # the app's own target. compose is cleared to #888, so falling back to
    # it renders a flat gray frame
    func bind_backdrop [ ]
        if [ !element_targets ] return
        found : Render [ null ]
        for [ r: Render, rid: string ] in element_targets
            if [ r && r.owner && r.owner.frost ]
                found = r
                break
        if [ found && !chain && is_setup ] build_frost_chain[]
        if [ !found ]
            # owner is an OPTIONAL backref: an app that registers its own
            # target (orion's 'orion_wv') never sets one. requiring it here
            # left backdrop null, and rewire_frost then wired background,
            # frost and blur all to compose -- the flat #888 gray frame.
            # an OWNED target without frost is an element's own render (the
            # avatar): never the window backdrop, or it stretches behind the editor
            for [ r: Render, rid: string ] in element_targets
                if [ r && !r.skip && !r.owner ]
                    found = r
                    break
        if [ !found ] return
        # a resize replaced every attachment: rewire the WHOLE chain from
        # current colors
        rb9 : bool [ rebind_frost ]
        rebind_frost = false
        # scene swaps replace the target: rebind, don't bind once
        fresh : bool [ found != backdrop ]
        if [ fresh ]
            backdrop = found
            log 'BACKDROP -> {found.id} {found.width}x{found.height} chain={(chain) ? 1 : 0} m_reduce={(m_reduce) ? 1 : 0}'
        if [ rb9 ]
            rewire_frost[]
            if [ !fresh ] return
        if [ !fresh && frost_eff[] == frost_bound ] return
        if [ m_reduce && fresh ]
            m_reduce.samplers[ 'color' ] = backdrop.color
            m_reduce.rebind_model[]
        if [ m_view ]
            frost_bound = frost_eff[]
            uxs : UXBackground [ m_view.s ]
            if [ uxs ] uxs.dim_floor = (backdrop.owner) ? backdrop.owner.frost_lift : 0.0
            # push the flat color to the shader the moment the scene mounts
            # or the stage changes, so the solid stage is right on frame one
            apply_solid[]
            if [ fresh ] m_view.samplers[ 'background' ] = backdrop.color
            fr : frost_src[]
            bl : blur_src[]
            # ux.frag picks background ONLY when compose.r < 0.502; compose is
            # cleared to #888 (0.533), so the else branch runs and samples
            # blur/frost. with no chain those must resolve to the backdrop or
            # every pixel comes back as the flat #888 clear
            m_view.samplers[ 'frost' ] = (fr) ? fr.color : backdrop.color
            m_view.samplers[ 'blur'  ] = (bl) ? bl.color : backdrop.color
            m_view.rebind_model[]

    # push solid_color to the background shader NOW, not on the next resize.
    # on-change only (scene mount / stage flip), so the flat stage is correct
    # from the first frame even while a scene's 3d models still load async
    # the app declares a backdrop is coming (a configured scene): loaded
    # once it has drawn. with none declared, the first frame is loaded
    public expect_backdrop : bool

    public func loaded [] -> bool
        if [ backdrop ] return backdrop.has_drawn
        return !expect_backdrop

    public func apply_solid [ ] -> bool
        backdrop_once = true
        s9 : bool [ frost_eff[] == 3 ]
        # solid: the scene target is not drawn at all, only the flat color
        skip_target = (s9) ? backdrop : null
        if [ !m_view ] return false
        uxs : UXBackground [ m_view.s ]
        if [ !uxs ] return false
        uxs.solid_color = (s9) ? vec4f [ solid_color.r, solid_color.g, solid_color.b, 1.0 ] : vec4f [ 0.0, 0.0, 0.0, 0.0 ]
        return true

    func update [ ]
        backdrop_once = true
        bind_backdrop[]
        apply_solid[]
        if [ !glyph ]
            glyph = Canvas [ w:a, vk: vk, format: Pixel.u8, :width, :height ]
            glyph.hold[]
        if [ !screen ]
            screen = Canvas [ w:a, vk: vk, format: Pixel.rgba8, load_existing: true, :width, :height ]
            screen.hold[]
        glyph.resize[ width, height ]
        screen.resize[ width, height ]
        glyph   .update[]
        screen  .update[]
        glyph   .clear[ string[ "#000" ] ]
        screen  .clear[ string[ "#000" ] ]

        if [ !compose ]
            compose = Canvas [ w:a, vk: vk, format: Pixel.rgba8, load_existing: true, :width, :height ]
            compose.hold[]
        compose.resize[ width, height ]
        compose.update[]
        compose.clear[ string[ "#888" ] ]

        if [ !is_setup ]
            is_setup = true
            ctx: vk_context[ a.vk ]

            shader : UXBackground [ vk: ctx, name: 'ux' ]
            shader.hold[]
            # no frost chain exists yet: frost/blur sample the background
            # itself, so nothing reads an image that was never rendered
            src0 : Texture [ (backdrop) ? backdrop.color : compose.color ]
            m_view    = Model [ w: w, s: shader,
                samplers: map Texture[string] [
                    'background':     src0,
                    'frost':          src0,
                    'blur':           src0,
                    'compose':        compose.color
                ]
            ]

            r_view    = Render [ vk: ctx, w: a,
                color: screen.color,
                wscale: 1.0, clear_color: vec4f [ 1.0, 1.0, 1.0, 1.0 ],
                models: [m_view ] ]
            m_view.hold[]
            r_view.hold[]

            ux_shader : UXBackground [ shader ]
            ux_shader.low_color  = vec4f [ 0.0, 0.1, 0.2, 1.0 ]
            ux_shader.high_color = vec4f [ 1.0, 0.8, 0.8, 1.0 ]

            # the backdrop draws itself as an element target, not here
            list = vec Render [] [ r_view ]
        el
            if [ chain ]
                for [ r: Render ] in chain
                    r.update[]
            el [ list ]
                for [ r: Render ] in list
                    r.update[]
            if [ r_view ]
                r_view.color = screen.color
                r_view.update[]
                # mode-aware: frost/blur follow frost_src, not r_frost
                rewire_frost[]

    # the display's refresh rate, for pacing what has no present of its own
    func refresh_hz [] -> i32
        if [ !glfw ] return 60
        hz : i32 [ platform_window_refresh_hz[ glfw ] ]
        return (hz > 0) ? hz : 60

    # the window on or off the screen: off while the app shows in orbiter
    func set_shown [ on: bool ]
        if [ text_mode || backbuffer || !glfw ] return
        # hidden also holds the first present's auto-show off
        hidden = !on
        if [ on ] platform_window_show[ glfw ]
        el        platform_window_hide[ glfw ]

    func set_fullscreen [ on: bool ]
        if [ on == fs_active ]
            return
        if [ on ]
            # remember windowed geometry
            platform_window_set_fullscreen[ glfw, true ]
        el
            platform_window_set_fullscreen[ glfw, false ]
        fs_active = on

    public func resize [ w: i32, h: i32 ] -> Window
        if [ screenshot_active ] screenshot_end[]
        resizing = true
        if [ vk && vk.device ]
            vkDeviceWaitIdle[ vk.device ]
        super.resize[ w, h ]
        update[]
        resizing = false
        return a

    mutable blur_anim : f32


    func on_compose []
        if [ resizing ] return
        if [ screenshot_active ] return
        update_all      [ app_render[] ]
        # a frost element publishes its target mid-frame, not on resize
        bind_backdrop   [ ]
        if [ !ide_active ] animate [ ]

    func on_screen []
        if [ !screen ] return
        vk.defer_tick[]
        if [ resizing ] return
        screen.save[]

        if [ screenshot_active ]
            screenshot_draw[]
            screen.paint[]
            screen.flush_text[]
            screen.sync_fence[]
            screen.restore[]
            return

        app_object.on_canvas*[ screen ]

        ts0 : i64 [ epoch_micros[] ]
        layout_element[ root, null, null, null, screen ]
        ts1 : i64 [ epoch_micros[] ]

        if [ ide_active && root.elements ]
            shell : cast element [ root.elements[ 'hostedshell' ] ]
            if [ shell ]
                draw_element[ shell, CanvasType.screen, null ]
            el
                draw_element[ root, CanvasType.screen, null ]
        el
            draw_element[ root, CanvasType.screen, null ]

        ts2 : i64 [ epoch_micros[] ]
        app_object.on_overlay*[ screen ]
        ts3 : i64 [ epoch_micros[] ]

        if [ stdout_overlay && !text_mode && !hidden ]
            Au.stdout_tee[]
            if [ !so_lines ]
                so_lines = vec string []
            line : Au.stdout_line[]
            while [ line ]
                so_lines += line
                if [ so_lines.count > 6 ] so_lines.remove[ 0 ]
                so_last = epoch_millis[]
                line = Au.stdout_line[]
            if [ so_lines.count > 0 ]
                age : i64 [ epoch_millis[] - so_last ]
                if [ age < 5000 ]
                    fading : bool [ age > 4000 ]
                    tsh : string [ (fading) ? '#00000044' : '#00000088' ]
                    ttx : string [ (fading) ? '#ffffff88' : '#ffffff' ]
                    screen.font_size[ 14 ]
                    count : i32 [ i32[ so_lines.count ] ]
                    for [ i: i32 0, i < count, i += 1 ]
                        y : f32 [ stdout_y + 20.0 * f32[ i ] ]
                        # drop shadow first, text over it
                        screen.fill_color[ tsh ]
                        screen.draw_text[ so_lines[ i ],
                            rect [ x: 17.0, y: y + 1.0, w: f32[ width ] - 32.0, h: 20.0 ],
                            vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
                        screen.fill_color[ ttx ]
                        screen.draw_text[ so_lines[ i ],
                            rect [ x: 16.0, y: y, w: f32[ width ] - 32.0, h: 20.0 ],
                            vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
                    screen.paint[]

        ##
        screen.fill_color[ '#f00' ]
        screen.rect_to[ 64.0, 64.0, 240.0, 120.0 ]
        screen.fill_color[ "#fff" ]
        screen.font_size [ 32 ]
        screen.draw_text[
            "Aura",
            rect [ x: 128.0 + 128.0 + 24.0 + 8.0 - 0.5, y: 64.0 + 32.0 - 32.0 - 0.5, w: 64.0, h: 32.0 ],
            vec2f [ 0.5, 0.5 ],
            vec2f [ 0.0, 0.0 ],
            false ]
        ##
        ts4 : i64 [ epoch_micros[] ]
        screen.paint[]
        screen.flush_text[]
        screen.sync_fence[]
        screen.restore[]
        vk.ph_layout  += ts1 - ts0
        vk.ph_elems   += ts2 - ts1
        vk.ph_overlay += ts3 - ts2
        vk.ph_flush   += epoch_micros[] - ts4


    func box_bits [ cp: i32 ] -> i32
        if [ cp == 0x2500 ] return 12
        if [ cp == 0x2502 ] return 3
        if [ cp == 0x250C ] return 10
        if [ cp == 0x2510 ] return 6
        if [ cp == 0x2514 ] return 9
        if [ cp == 0x2518 ] return 5
        if [ cp == 0x256D ] return 10
        if [ cp == 0x256E ] return 6
        if [ cp == 0x2570 ] return 9
        if [ cp == 0x256F ] return 5
        if [ cp == 0x251C ] return 11
        if [ cp == 0x2524 ] return 7
        if [ cp == 0x252C ] return 14
        if [ cp == 0x2534 ] return 13
        if [ cp == 0x253C ] return 15
        return 0

    func bits_box [ b: i32 ] -> i32
        if [ b == 12 ] return 0x2500
        if [ b == 3  ] return 0x2502
        if [ b == 10 ] return 0x256D
        if [ b == 6  ] return 0x256E
        if [ b == 9  ] return 0x2570
        if [ b == 5  ] return 0x256F
        if [ b == 11 ] return 0x251C
        if [ b == 7  ] return 0x2524
        if [ b == 14 ] return 0x252C
        if [ b == 13 ] return 0x2534
        if [ b == 15 ] return 0x253C
        return 0

    func cell_set [ grid: @i32, colg: @i32, cols: i32, rows: i32, x: i32, y: i32, cp: i32, color: i32 ]
        if [ x < 0 || y < 0 || x >= cols || y >= rows ] return
        idx : i32 [ y * cols + x ]
        out : i32 [ cp ]
        ob  : i32 [ box_bits[ grid[ idx ] ] ]
        nb  : i32 [ box_bits[ cp ] ]
        if [ ob != 0 && nb != 0 ]
            merged : i32 [ bits_box[ ob | nb ] ]
            if [ merged ] out = merged
        grid[ idx ] = out
        colg[ idx ] = color

    func abs_x [ n: element* ] -> f32
        v : f32 [ 0.0 ]
        p : element [ n ]
        while [ p && p.bounds ]
            v += p.bounds.x
            p = p.parent
        return v

    func abs_y [ n: element* ] -> f32
        v : f32 [ 0.0 ]
        p : element [ n ]
        while [ p && p.bounds ]
            v += p.bounds.y
            p = p.parent
        return v

    func adjoin_bottom_at [ node: element*, skip: element, cx0: i32, cx1: i32, ty: i32 ] -> bool
        if [ !node ] return false
        if [ node != skip && node.bordering && node.bounds ]
            ax : f32 [ abs_x[ node ] ]
            ay : f32 [ abs_y[ node ] ]
            nb  : i32 [ i32 (ay + node.bounds.h) - 1 ]
            nx0 : i32 [ i32 ax ]
            nx1 : i32 [ i32 (ax + node.bounds.w) - 1 ]
            if [ nb == ty && nx0 <= cx1 && nx1 >= cx0 ] return true
        if [ node.elements ]
            for [ ce: element, ck: string ] in node.elements
                if [ adjoin_bottom_at[ ce, skip, cx0, cx1, ty ] ] return true
        return false

    func adjoin_right_at [ node: element*, skip: element, ry0: i32, ry1: i32, tx: i32 ] -> bool
        if [ !node ] return false
        if [ node != skip && node.bordering && node.bounds ]
            ax : f32 [ abs_x[ node ] ]
            ay : f32 [ abs_y[ node ] ]
            nr  : i32 [ i32 (ax + node.bounds.w) - 1 ]
            ny0 : i32 [ i32 ay ]
            ny1 : i32 [ i32 (ay + node.bounds.h) - 1 ]
            if [ nr == tx && ny0 <= ry1 && ny1 >= ry0 ] return true
        if [ node.elements ]
            for [ ce: element, ck: string ] in node.elements
                if [ adjoin_right_at[ ce, skip, ry0, ry1, tx ] ] return true
        return false

    func draw_box [ grid: @i32, colg: @i32, cols: i32, rows: i32, x: i32, y: i32, w: i32, h: i32, color: i32 ]
        x0 : i32 [ (x < 0) ? 0 : x ]
        y0 : i32 [ (y < 0) ? 0 : y ]
        x1 : i32 [ x + w - 1 ]
        y1 : i32 [ y + h - 1 ]
        if [ x1 > cols - 1 ] x1 = cols - 1
        if [ y1 > rows - 1 ] y1 = rows - 1
        if [ x1 < x0 || y1 < y0 ] return
        # rounded (arc) corners: ╭ ╮ ╰ ╯
        cell_set[ grid, colg, cols, rows, x0, y0, 0x256D, color ]
        cell_set[ grid, colg, cols, rows, x1, y0, 0x256E, color ]
        cell_set[ grid, colg, cols, rows, x0, y1, 0x2570, color ]
        cell_set[ grid, colg, cols, rows, x1, y1, 0x256F, color ]
        for [ i: i32 x0 + 1, i < x1, i += 1 ]
            cell_set[ grid, colg, cols, rows, i, y0, 0x2500, color ]
            cell_set[ grid, colg, cols, rows, i, y1, 0x2500, color ]
        for [ j: i32 y0 + 1, j < y1, j += 1 ]
            cell_set[ grid, colg, cols, rows, x0, j, 0x2502, color ]
            cell_set[ grid, colg, cols, rows, x1, j, 0x2502, color ]

    func stamp_text [ grid: @i32, colg: @i32, cols: i32, rows: i32, x: i32, y: i32, s: string, maxw: i32, color: i32 ]
        if [ !s || maxw <= 0 ] return
        i   : i32 [ 0 ]
        col : i32 [ 0 ]
        while [ i < s.count && col < maxw ]
            b0 : i32 [ (i32 s.chars[i]) & 0xFF ]
            if [ b0 == 9 ]
                nsp : i32 [ 4 - (col % 4) ]
                k : i32 [ 0 ]
                while [ k < nsp && col < maxw ]
                    cell_set[ grid, colg, cols, rows, x + col, y, 32, color ]
                    col += 1
                    k += 1
                i += 1
            el [ b0 < 0x20 ]
                i += 1
            el [ b0 < 0x80 ]
                cell_set[ grid, colg, cols, rows, x + col, y, b0, color ]
                col += 1
                i += 1
            el [ b0 < 0xC0 ]
                i += 1
            el [ b0 < 0xE0 ]
                cp : i32 [ b0 & 0x1F ]
                if [ i + 1 < s.count ] cp = (cp << 6) | ((i32 s.chars[i+1]) & 0x3F)
                cell_set[ grid, colg, cols, rows, x + col, y, cp, color ]
                col += 1
                i += 2
            el [ b0 < 0xF0 ]
                cp : i32 [ b0 & 0x0F ]
                if [ i + 2 < s.count ]
                    cp = (cp << 6) | ((i32 s.chars[i+1]) & 0x3F)
                    cp = (cp << 6) | ((i32 s.chars[i+2]) & 0x3F)
                cell_set[ grid, colg, cols, rows, x + col, y, cp, color ]
                col += 1
                i += 3
            el
                cp : i32 [ b0 & 0x07 ]
                if [ i + 3 < s.count ]
                    cp = (cp << 6) | ((i32 s.chars[i+1]) & 0x3F)
                    cp = (cp << 6) | ((i32 s.chars[i+2]) & 0x3F)
                    cp = (cp << 6) | ((i32 s.chars[i+3]) & 0x3F)
                cell_set[ grid, colg, cols, rows, x + col, y, cp, color ]
                col += 1
                i += 4

    func has_focus_within [ e: element* ] -> bool
        f : element [ focus ]
        while [ f ]
            if [ f == e ] return true
            f = f.parent
        return false

    func draw_element_console [ e: element*, grid: @i32, colg: @i32, cols: i32, rows: i32, ox: i32, oy: i32, aw: i32, ah: i32, pbx0: i32, pbx1: i32, pbordered: bool, pax: i32, pay: i32 ]
        if [ !e ] return
        if [ !e.area ] e.area = Region [ 0.0 ]
        if [ !e.bounds ] e.bounds = rect[]
        e.fc = 1.0
        rel : rect [ x: 0, y: 0, w: f32 aw, h: f32 ah ]
        b : e.area.rectangle[ rel, null, null, 1.0, true, 0.0, 0.0 ]
        bw : i32 [ i32 b.w ]
        bh : i32 [ i32 b.h ]
        if [ !e.parent ]
            if [ bw < 1 ] bw = aw
            if [ bh < 1 ] bh = ah
        x0 : i32 [ ox + i32 b.x ]
        y0 : i32 [ oy + i32 b.y ]
        e.bounds.x = f32 (x0 - pax)
        e.bounds.y = f32 (y0 - pay)
        e.bounds.w = f32 bw
        e.bounds.h = f32 bh
        if [ bw < 1 || bh < 1 ] return
        if [ e.opacity <= 0.0 ] return

        if [ e.layers ]
            for [ lau: Au, lk: string ] in e.layers
                lyr : cast Layer [ lau ]
                if [ lyr ]
                    lyr.bounds = (lyr.area) ? lyr.area.rectangle[ e.bounds, null, null, 1.0, true, 0.0, 0.0 ] : e.bounds.copy[]

        bordered : bool [ e.bordering ]
        header   : bool [ bordered && pbordered ]
        bcolor : i32 [ 4 ]

        lshift : i32 [ 0 ]
        tshift : i32 [ 0 ]
        if [ bordered && !header && e.ux && e.ux.root ]
            rootn : element [ e.ux.root ]
            if [ adjoin_right_at [ rootn, e, y0, y0 + bh - 1, x0 - 1 ] ] lshift = 1
            if [ adjoin_bottom_at[ rootn, e, x0, x0 + bw - 1, y0 - 1 ] ] tshift = 1

        if [ header ]
            ry  : i32 [ y0 + bh ]
            jx0 : i32 [ (pbx0 < 0) ? 0 : pbx0 ]
            jx1 : i32 [ (pbx1 > cols - 1) ? cols - 1 : pbx1 ]
            cell_set[ grid, colg, cols, rows, jx0, ry, 0x251C, bcolor ]
            cell_set[ grid, colg, cols, rows, jx1, ry, 0x2524, bcolor ]
            for [ rx: i32 jx0 + 1, rx < jx1, rx += 1 ]
                cell_set[ grid, colg, cols, rows, rx, ry, 0x2500, bcolor ]
        el [ bordered && bw >= 2 && bh >= 2 ]
            draw_box[ grid, colg, cols, rows, x0 - lshift, y0 - tshift, bw + lshift, bh + tshift, bcolor ]

        il : i32 [ (bordered && !header) ? 1 : 0 ]
        it : i32 [ (bordered && !header) ? 1 : 0 ]
        ir : i32 [ (bordered && !header) ? 1 : 0 ]
        ib : i32 [ (bordered && !header) ? 1 : 0 ]
        bx0 : i32 [ x0 - lshift ]
        by0 : i32 [ y0 - tshift ]
        bbw : i32 [ bw + lshift ]
        bbh : i32 [ bh + tshift ]
        editing : bool [ false ]
        if [ e.layers ]
            for [ ela: Au, elk: string ] in e.layers
                elay : cast Layer [ ela ]
                if [ elay && elay.editable ]
                    editing = true
                    break

        has_lbl  : bool [ e.label && e.label.count > 0 ]
        lbl_row  : i32 [ (!bordered && has_lbl) ? 1 : 0 ]
        if [ editing ]
            bxl : i32 [ bx0 + il ]
            bxw : i32 [ bbw - il - ir ]
            if [ bxw > 0 ]
                ph : string [ (e.label) ? e.label : '' ]
                ed : string [ (e.edit)  ? e.edit  : '' ]
                if [ ph.count > 0 && ed.count <= 1 ] stamp_text[ grid, colg, cols, rows, bxl, by0 + it, ph, bxw, 2 ]
                if [ ed.count > 0 ] stamp_text[ grid, colg, cols, rows, bxl, by0 + it, ed, bxw, 1 ]
                cpos : i32 [ ed.count ]
                if [ cpos > bxw - 1 ] cpos = bxw - 1
                ccx : i32 [ bxl + cpos ]
                ccy : i32 [ by0 + it ]
                if [ ccx >= 0 && ccx < cols && ccy >= 0 && ccy < rows ]
                    colg[ ccy * cols + ccx ] = 3
        el [ has_lbl ]
            lx : i32 [ bx0 + il ]
            lw : i32 [ bbw - il - ir ]
            if [ lw > 0 ] stamp_text[ grid, colg, cols, rows, lx, by0 + it, e.label, lw, 0 ]

        child_bordered : bool [ bordered && !header ]
        cpx0 : i32 [ (child_bordered) ? x0 - lshift : pbx0 ]
        cpx1 : i32 [ (child_bordered) ? x0 + bw - 1 : pbx1 ]
        cpb  : bool [ child_bordered || (header && pbordered) ]

        cx : i32 [ bx0 + il ]
        cy : i32 [ by0 + it + lbl_row ]
        cw : i32 [ bbw - il - ir ]
        ch : i32 [ bbh - it - ib - lbl_row ]

        if [ e.id && e.id == 'topbar' ]
            tby : i32 [ y0 ]
            mby : i32 [ y0 + 1 ]
            bby : i32 [ y0 + 2 ]
            e.bounds.h = 3.0
            rcol : i32 [ x0 + bw - 1 ]
            rwidth : i32 [ 0 ]
            for [ tb: element, tk: string ] in e.elements
                if [ !(tb.area && tb.area.l.x_type == XAlign.right) ] continue
                if [ tb.elements ]
                    for [ ob: element, ok: string ] in tb.elements
                        ropt : Option ob
                        if [ !ropt ] continue
                        rtxt : string [ '?' ]
                        if [ ob.label && ob.label.count > 0 ]
                            rtxt = '{ob.label}'
                        el [ ob.id && ob.id == 'play' ]
                            rtxt = '>'
                        el [ ob.id && ob.id.count > 0 ]
                            rtxt = '{ob.id}'
                        rwidth += rtxt.count + 3
            rstart : i32 [ rcol - rwidth ]
            lcol : i32 [ x0 ]
            rcur : i32 [ rstart ]
            left_end : i32 [ x0 ]
            for [ tb: element, tk: string ] in e.elements
                right : bool [ tb.area && tb.area.l.x_type == XAlign.right ]
                col : i32 [ (right) ? rcur : lcol ]
                gstart : i32 [ col ]
                if [ tb.elements ]
                    for [ ob: element, ok: string ] in tb.elements
                        opt : Option ob
                        if [ !opt ] continue
                        txt : string [ '?' ]
                        if [ ob.label && ob.label.count > 0 ]
                            txt = '{ob.label}'
                        el [ ob.id && ob.id == 'play' ]
                            txt = '▶'
                        el [ ob.id && ob.id.count > 0 ]
                            txt = '{ob.id}'
                        bs : i32 [ col ]
                        cell_set[ grid, colg, cols, rows, col, tby, 0x252C, 4 ]
                        cell_set[ grid, colg, cols, rows, col, mby, 0x2502, 4 ]
                        cell_set[ grid, colg, cols, rows, col, bby, 0x2534, 4 ]
                        lbl : ' {txt} '
                        cw2 : i32 [ 0 ]
                        ci : i32 [ 0 ]
                        while [ ci < lbl.count ]
                            if [ ((i32 lbl.chars[ci]) & 0xC0) != 0x80 ] cw2 += 1
                            ci += 1
                        k : i32 [ 0 ]
                        while [ k < cw2 ]
                            cell_set[ grid, colg, cols, rows, col + 1 + k, tby, 0x2500, 4 ]
                            cell_set[ grid, colg, cols, rows, col + 1 + k, bby, 0x2500, 4 ]
                            k += 1
                        bcol : i32 [ (opt.selected) ? 1 : 0 ]
                        stamp_text[ grid, colg, cols, rows, col + 1, mby, lbl, cw2, bcol ]
                        if [ !ob.bounds ] ob.bounds = rect[]
                        ob.bounds.x = f32 (bs - gstart)
                        ob.bounds.y = 0.0
                        ob.bounds.w = f32 (cw2 + 1)
                        ob.bounds.h = 1.0
                        col = col + 1 + cw2
                if [ !tb.bounds ] tb.bounds = rect[]
                tb.bounds.x = f32 (gstart - x0)
                tb.bounds.y = f32 (mby - y0)
                tb.bounds.w = f32 (col - gstart)
                tb.bounds.h = 1.0
                if [ right ] rcur = col
                el
                    lcol = col
                    left_end = col
            # bordered fill in the gap between the left and right groups
            j : i32 [ left_end ]
            while [ j < rstart ]
                cell_set[ grid, colg, cols, rows, j, tby, 0x2500, 4 ]
                cell_set[ grid, colg, cols, rows, j, mby, 32, 0 ]
                cell_set[ grid, colg, cols, rows, j, bby, 0x2500, 4 ]
                j += 1
            if [ x0 >= 0 && rcol < cols && bby < rows ]
                grid[ tby * cols + x0 ]   = 0x256D
                colg[ tby * cols + x0 ]   = 4
                grid[ mby * cols + x0 ]   = 0x2502
                colg[ mby * cols + x0 ]   = 4
                grid[ bby * cols + x0 ]   = 0x2570
                colg[ bby * cols + x0 ]   = 4
                grid[ tby * cols + rcol ] = 0x256E
                colg[ tby * cols + rcol ] = 4
                grid[ mby * cols + rcol ] = 0x2502
                colg[ mby * cols + rcol ] = 4
                grid[ bby * cols + rcol ] = 0x256F
                colg[ bby * cols + rcol ] = 4
            return

        if [ cw > 0 && ch > 0 && e.elements ]
            for [ ce: element, ck: string ] in e.elements
                draw_element_console[ ce, grid, colg, cols, rows, cx, cy, cw, ch, cpx0, cpx1, cpb, x0, y0 ]

        lc : i32 [ e.console_line_count*[] ]
        if [ lc > 0 ]
            tx : i32 [ cx ]
            tw : i32 [ cw ]
            ty : i32 [ (bordered) ? cy + 2 : cy ]
            bot : i32 [ by0 + bbh - 1 ]
            body : i32 [ bot - ty ]
            if [ body < 1 ] body = 1
            e.content_h    = f32 (lc + (bbh - body))
            e.scroll_speed = 3.0
            maxs : i32 [ (lc > body) ? lc - body : 0 ]
            first : i32 [ i32 e.scroll.y ]
            if [ first < 0 ] first = 0
            if [ first > maxs ] first = maxs
            vr : i32 [ 0 ]
            while [ vr < body && first + vr < lc ]
                ln : e.console_line*[ first + vr ]
                if [ ln && ln.count > 0 ] stamp_text[ grid, colg, cols, rows, tx, ty + vr, ln, tw, 0 ]
                vr += 1
            if [ bordered && lc > body ]
                rbx : i32 [ bx0 + bbw - 1 ]
                th0 : i32 [ ty + (first * body) / lc ]
                th1 : i32 [ ty + ((first + body) * body) / lc ]
                if [ th1 <= th0 ] th1 = th0 + 1
                rr : i32 [ th0 ]
                while [ rr < th1 && rr < bot ]
                    cell_set[ grid, colg, cols, rows, rbx, rr, 0x2503, 1 ]
                    rr += 1

    func tty_write [ s: string ]
        if [ tty_in >= 0 && s ] write[ tty_in, s.chars, s.count ]

    func emit_bytes [ dst: @u8, p: i32, s: string ] -> i32
        q : i32 [ p ]
        i : i32 [ 0 ]
        while [ i < s.count ]
            dst[ q ] = u8 s.chars[i]
            q += 1
            i += 1
        return q

    func console_input_open []
        c0 : command "stty -icanon -echo min 0 time 0"
        c0.exec[ false ]
        tty : handle [ fopen[ "/dev/tty", "r+" ] ]
        if [ tty ]
            tty_in = fileno[ tty ]
            tty_write[ "\033[?1049h" ]
            tty_write[ "\033[?1000h" ]
            tty_write[ "\033[?1002h" ]
            tty_write[ "\033[?1006h" ]
            tty_write[ "\033[?7l" ]
            tty_write[ "\033[?25l" ]

    func console_input_close []
        tty_write[ "\033[?1000l" ]
        tty_write[ "\033[?1002l" ]
        tty_write[ "\033[?1006l" ]
        tty_write[ "\033[?7h" ]
        tty_write[ "\033[?25h" ]
        tty_write[ "\033[?1049l" ]
        c1 : command "stty sane"
        c1.exec[ false ]

    func console_input_poll []
        buf : local u8 [ 128 ]
        src : i32 [ (tty_in >= 0) ? tty_in : 0 ]
        nb : i32 [ read[ src, @buf[0], 127 ] ]
        if [ nb <= 0 ] return
        rb0 : i32 [ i32 buf[0] ]
        rb1 : i32 [ 0 ]
        rb2 : i32 [ 0 ]
        if [ nb > 1 ] rb1 = i32 buf[1]
        if [ nb > 2 ] rb2 = i32 buf[2]
        rdbg : handle [ fopen[ "/tmp/orbclick.txt", "a" ] ]
        if [ rdbg ]
            fputs[ 'READ nb={nb} b0={rb0} b1={rb1} b2={rb2}\n', rdbg ]
            fclose[ rdbg ]
        i : i32 [ 0 ]
        while [ i < nb ]
            c : i32 [ i32 buf[i] ]
            # SGR mouse: ESC [ < btn ; col ; row (M=press / m=release)
            if [ c == 0x1b && i + 2 < nb && buf[i+1] == 0x5B && buf[i+2] == 0x3C ]
                j   : i32 [ i + 3 ]
                btn : i32 [ 0 ]
                mx  : i32 [ 0 ]
                my  : i32 [ 0 ]
                while [ j < nb && buf[j] >= 0x30 && buf[j] <= 0x39 ]
                    btn = btn * 10 + (i32 buf[j] - 0x30)
                    j += 1
                if [ j < nb && buf[j] == 0x3B ] j += 1
                while [ j < nb && buf[j] >= 0x30 && buf[j] <= 0x39 ]
                    mx = mx * 10 + (i32 buf[j] - 0x30)
                    j += 1
                if [ j < nb && buf[j] == 0x3B ] j += 1
                while [ j < nb && buf[j] >= 0x30 && buf[j] <= 0x39 ]
                    my = my * 10 + (i32 buf[j] - 0x30)
                    j += 1
                press : bool [ j < nb && buf[j] == 0x4D ]
                # report columns/rows are 1-based; cells are 0-based
                mouse.x = f32 (mx - 1)
                mouse.y = f32 (my - 1)
                ev.clear[]
                ev.mouse.pos.x = mouse.x
                ev.mouse.pos.y = mouse.y
                if [ btn & 64 ]
                    ev.mouse.wheel_delta.y = (btn == 64) ? 1.0 : -1.0
                    wheel_event[ ev ]
                el [ btn & 32 ]
                    move_event[ ev ]
                el
                    ev.mouse.button = btn & 3
                    ev.mouse.state  = press
                    if [ press ]
                        press_event[ ev ]
                    el
                        release_event[ ev ]
                i = j + 1
                continue
            # arrow / nav keys: ESC [ A/B/C/D
            if [ c == 0x1b && i + 2 < nb && buf[i+1] == 0x5B ]
                k    : i32 [ i32 buf[i+2] ]
                code : i32 [ 0 ]
                if [ k == 0x41 ]
                    code = 265
                el [ k == 0x42 ]
                    code = 264
                el [ k == 0x43 ]
                    code = 262
                el [ k == 0x44 ]
                    code = 263
                if [ code ]
                    ev.clear[]
                    ev.key.unicode = code
                    ev.key.state   = 1
                    key_event[ ev ]
                    i += 3
                    continue
            # bare escape
            if [ c == 0x1b ]
                ev.clear[]
                ev.key.unicode = 256
                ev.key.state   = 1
                key_event[ ev ]
                i += 1
                continue
            # enter
            if [ c == 0x0d || c == 0x0a ]
                ev.clear[]
                ev.key.unicode = 257
                ev.key.state   = 1
                key_event[ ev ]
                i += 1
                continue
            # backspace
            if [ c == 0x7f || c == 0x08 ]
                ev.clear[]
                ev.key.unicode = 259
                ev.key.state   = 1
                key_event[ ev ]
                i += 1
                continue
            # printable ASCII → character insertion
            if [ c >= 0x20 && c < 0x7f ]
                tb : local i8 [ 2 ]
                tb[0] = i8 c
                tb[1] = 0
                ev.clear[]
                ev.key.text = string[ @tb[0] ]
                text_event[ ev ]
                i += 1
                continue
            i += 1

    func draw_console []
        console_input_poll[]
        ws : winsize
        cols : i32 [ 80 ]
        rows : i32 [ 24 ]
        ok : bool [ ioctl[ 0, 0x40087468, @ws ] == 0 && ws.ws_col > 0 ]
        if [ !ok ] ok = ioctl[ 1, 0x40087468, @ws ] == 0 && ws.ws_col > 0
        if [ !ok ] ok = ioctl[ 2, 0x40087468, @ws ] == 0 && ws.ws_col > 0
        if [ !ok ] ok = ioctl[ 0, 0x5413, @ws ] == 0 && ws.ws_col > 0
        if [ !ok ] ok = ioctl[ 1, 0x5413, @ws ] == 0 && ws.ws_col > 0
        if [ !ok ] ok = ioctl[ 2, 0x5413, @ws ] == 0 && ws.ws_col > 0
        if [ ok ]
            cols = i32 ws.ws_col
            rows = i32 ws.ws_row
        width  = cols
        height = rows

        update_all[ app_render[] ]
        animate[]

        n : i32 [ cols * rows ]
        grid : new i32 [ n ]
        colg : new i32 [ n ]
        for [ i: i32 0, i < n, i += 1 ]
            grid[ i ] = 32
            colg[ i ] = 0
        if [ root ]
            draw_element_console[ root, grid, colg, cols, rows, 0, 0, cols, rows, 0, 0, false, 0, 0 ]

        cap : i32 [ n * 24 + rows + 64 ]
        out : new u8 [ cap ]
        p : i32 [ 0 ]
        p = emit_bytes[ out, p, "\033[?7l\033[H\033[J" ]
        cur_col : i32 [ -1 ]
        for [ y: i32 0, y < rows, y += 1 ]
            for [ x: i32 0, x < cols, x += 1 ]
                idx : i32 [ y * cols + x ]
                c   : i32 [ colg[ idx ] ]
                if [ c != cur_col ]
                    cur_col = c
                    if [ c == 4 ]
                        p = emit_bytes[ out, p, "\033[0;38;5;240m" ]
                    el [ c == 2 ]
                        p = emit_bytes[ out, p, "\033[0;90m" ]
                    el [ c == 3 ]
                        p = emit_bytes[ out, p, "\033[0;7m" ]
                    el [ c == 1 ]
                        p = emit_bytes[ out, p, "\033[0;97m" ]
                    el
                        p = emit_bytes[ out, p, "\033[0m" ]
                cp : i32 [ grid[ idx ] ]
                if [ cp < 0x80 ]
                    out[p] = u8 cp
                    p += 1
                el [ cp < 0x800 ]
                    out[p] = u8 (0xC0 | (cp >> 6))
                    p += 1
                    out[p] = u8 (0x80 | (cp & 0x3F))
                    p += 1
                el
                    out[p] = u8 (0xE0 | (cp >> 12))
                    p += 1
                    out[p] = u8 (0x80 | ((cp >> 6) & 0x3F))
                    p += 1
                    out[p] = u8 (0x80 | (cp & 0x3F))
                    p += 1
            if [ y < rows - 1 ]
                out[p] = 0x0A
                p += 1
        # reset color at the end of the frame
        p = emit_bytes[ out, p, "\033[0m" ]
        out[p] = 0
        printf[ "%s", out ]

    func text_grid [ tcols: i32, trows: i32 ] -> string
        cols : i32 [ (tcols > 8) ? tcols : 120 ]
        rows : i32 [ (trows > 4) ? trows : 44 ]
        w0 : i32 [ width ]
        h0 : i32 [ height ]
        width  = cols
        height = rows
        update_all[ app_render[] ]
        n : i32 [ cols * rows ]
        grid : new i32 [ n ]
        colg : new i32 [ n ]
        for [ i: i32 0, i < n, i += 1 ]
            grid[ i ] = 32
            colg[ i ] = 0
        if [ root ]
            draw_element_console[ root, grid, colg, cols, rows, 0, 0, cols, rows, 0, 0, false, 0, 0 ]
        cap : i32 [ n * 4 + rows + 8 ]
        tout : new u8 [ cap ]
        p : i32 [ 0 ]
        for [ y: i32 0, y < rows, y += 1 ]
            for [ x: i32 0, x < cols, x += 1 ]
                cp : i32 [ grid[ y * cols + x ] ]
                if [ cp < 0x80 ]
                    tout[p] = u8 cp
                    p += 1
                el [ cp < 0x800 ]
                    tout[p] = u8 (0xC0 | (cp >> 6))
                    p += 1
                    tout[p] = u8 (0x80 | (cp & 0x3F))
                    p += 1
                el
                    tout[p] = u8 (0xE0 | (cp >> 12))
                    p += 1
                    tout[p] = u8 (0x80 | ((cp >> 6) & 0x3F))
                    p += 1
                    tout[p] = u8 (0x80 | (cp & 0x3F))
                    p += 1
            tout[p] = 0x0A
            p += 1
        tout[p] = 0
        res : string [ cast cstr [ tout ] ]
        width  = w0
        height = h0
        update_all[ app_render[] ]
        return res

    func layout_element [ e: element*, last: element, last_l: element, last_r: element, cv: Canvas ]
        expect e inherits element, 'e is not an element'
        rel : rect [ (e.parent) ?
            rect [ x: 0, y: 0, w: e.parent.bounds.w, h: e.parent.bounds.h ] :
            rect [ x: 0, y: 0, w: width, h: height ] ]

        # the em comes from the default font, never from whatever size the
        # last draw left on the canvas (a hex or git view's) -- that
        # shrank every em-sized area, the title first
        cv.font_size[ 0 ]
        cv.ensure_font[]
        e.fc = 22.0
        if [ cv.font ]
            cs : f32 [ (cv.w && cv.w.scale > 0.0) ? cv.w.scale : 1.0 ]
            e.fc = cv.font.line_height / cs

        # compute element bounds from its area
        if [ !e.area ]
            e.area = Region [ 0.0 ]

        if [!e.bounds] e.bounds = rect[]

        spx : f32 [ (e.use_spacing && e.parent) ? e.parent.spacing_x * e.fc : 0.0 ]
        spy : f32 [ (e.use_spacing && e.parent) ? e.parent.spacing_y * e.fc : 0.0 ]
        bounds : e.area.rectangle[ rel, null, last->bounds, e.fc, false, spx, spy ]

        # a percent HEIGHT or WIDTH (h50%, w50%) is a share of the parent
        # less its fixed-size siblings; a percent EDGE (b-15%+174px) is an
        # edge, plotted above with its offset
        share_h : bool [ e.area.b.percent && e.area.b.y_type == YAlign.height ]
        share_w : bool [ e.area.r.percent && e.area.r.x_type == XAlign.width ]
        if [ e.area && e.parent && e.parent.elements && (share_h || share_w) ]
            prel   : rect [ x: 0, y: 0, w: rel.w, h: rel.h ]
            pfc    : f32  [ (e.parent.fc > 0.0) ? e.parent.fc : e.fc ]
            fixed_h : f32 0.0
            fixed_w : f32 0.0
            for [ sib: element, sid: string ] in e.parent.elements
                if [ sib == e || !sib.area ] continue
                if [ share_h && sib.area.b.y_type == YAlign.height && !sib.area.b.percent ]
                    sfc : f32 [ (sib.fc > 0.0) ? sib.fc : pfc ]
                    tb  : sib.area.rectangle[ prel, null, null, sfc, false, 0.0, 0.0 ]
                    fixed_h += tb.h
                if [ share_w && sib.area.r.x_type == XAlign.width && !sib.area.r.percent ]
                    sfc : f32 [ (sib.fc > 0.0) ? sib.fc : pfc ]
                    tb  : sib.area.rectangle[ prel, null, null, sfc, false, 0.0, 0.0 ]
                    fixed_w += tb.w
            if [ share_h ] bounds.h = e.area.b.offset * (rel.h - fixed_h)
            if [ share_w ] bounds.w = e.area.r.offset * (rel.w - fixed_w)

        if [ e.area.r.content || e.area.b.content ]
            cw : f32 [ bounds.w ]
            ch : f32 [ bounds.h ]
            measured : bool [ false ]
            if [ e.elements && e.elements.count > 0 ]
                prov  : rect [ x: 0.0, y: 0.0, w: 100000.0, h: 100000.0 ]
                lastc : rect [ null ]
                maxr  : f32 [ 0.0 ]
                maxb  : f32 [ 0.0 ]
                for [ ce: element, ck: string ] in e.elements
                    if [ !ce.area ] continue
                    if [ ce.area.l.x_type == XAlign.middle || ce.area.l.x_type == XAlign.right ] continue
                    if [ ce.area.t.y_type == YAlign.middle || ce.area.t.y_type == YAlign.bottom ] continue
                    if [ ce.area.r.x_type == XAlign.middle || ce.area.r.x_type == XAlign.right || ce.area.r.percent ] continue
                    if [ ce.area.b.y_type == YAlign.middle || ce.area.b.y_type == YAlign.bottom || ce.area.b.percent ] continue
                    cb : ce.area.rectangle[ prov, null, lastc, e.fc, false, (ce.use_spacing) ? e.spacing_x * e.fc : 0.0, (ce.use_spacing) ? e.spacing_y * e.fc : 0.0 ]
                    if [ cb.x + cb.w > maxr ] maxr = cb.x + cb.w
                    if [ cb.y + cb.h > maxb ] maxb = cb.y + cb.h
                    lastc    = cb
                    measured = true
                if [ measured ]
                    cw = maxr
                    ch = maxb
            if [ !measured && cv.font && e.label && e.label.count > 0 ]
                metrics : cv.measure_text[ e.label ]
                cw = metrics.w
                ch = metrics.ascent - metrics.descent
            if [ e.area.r.content ]
                cw += e.area.r.offset * ((e.area.r.pixel) ? 1.0 : e.fc)
                if [ e.area.l.x_type == XAlign.right ]  bounds.x = bounds.x - cw
                if [ e.area.l.x_type == XAlign.middle ] bounds.x = bounds.x - cw / 2.0
                bounds.w = cw
            if [ e.area.b.content ]
                ch += e.area.b.offset * ((e.area.b.pixel) ? 1.0 : e.fc)
                if [ e.area.t.y_type == YAlign.bottom ]  bounds.y = bounds.y - ch
                if [ e.area.t.y_type == YAlign.middle ] bounds.y = bounds.y - ch / 2.0
                bounds.h = ch

        if [ e.area.l.x_type == XAlign.right && e.area.l.relative ]
            if [ last_r && last_r.bounds ]
                bounds.x = last_r.bounds.x - e.area.l.offset * ((e.area.l.pixel) ? 1.0 : e.fc) - spx - bounds.w
            el
                bounds.x = rel.w - e.area.l.offset * ((e.area.l.pixel) ? 1.0 : e.fc) - spx - bounds.w
        if [ e.area.l.x_type == XAlign.left && e.area.l.relative ]
            if [ last_l && last_l.bounds ]
                bounds.x = last_l.bounds.x + last_l.bounds.w + e.area.l.offset * ((e.area.l.pixel) ? 1.0 : e.fc) + spx
            el
                bounds.x = e.area.l.offset * ((e.area.l.pixel) ? 1.0 : e.fc) + spx

        e.bounds.x = bounds.x
        e.bounds.y = bounds.y
        e.bounds.w = bounds.w
        e.bounds.h = bounds.h


        if [ e.bounds.w <= 0.0 || e.bounds.h <= 0.0 ] return
        if [ e.opacity <= 0.0 ] return
        last_2 : element
        last_l : element
        last_r : element
        for [ ee: element, id: string ] in e.elements
            if [ ee.topmost ] continue
            layout_element[ ee, last_2, last_l, last_r, cv ]
            last_2 = ee
            if [ ee.area && ee.area.l.relative ]
                if [ ee.area.l.x_type == XAlign.right ]
                    last_r = ee
                el [ ee.area.l.x_type == XAlign.left ]
                    last_l = ee
        for [ ee: element, id: string ] in e.elements
            if [ !ee.topmost ] continue
            layout_element[ ee, last_2, last_l, last_r, cv ]
            last_2 = ee
            if [ ee.area && ee.area.l.relative ]
                if [ ee.area.l.x_type == XAlign.right ]
                    last_r = ee
                el [ ee.area.l.x_type == XAlign.left ]
                    last_l = ee

    public func draw_element [ e: element*, stage: CanvasType, last:element ]
        draw_stage = stage
        expect e inherits element, 'e is not an element'
        if [ e.hide ] return
        bits : i32 [ 0 ]
        if [ e.hovered   ] bits += i32[ State.hovered ]
        if [ e.pressed   ] bits += i32[ State.pressed ]
        if [ e.focused   ] bits += i32[ State.focused ]
        if [ e.disable   ] bits += i32[ State.disable ]
        if [ e.first     ] bits += i32[ State.first ]
        if [ e.middle    ] bits += i32[ State.middle ]
        if [ e.last      ] bits += i32[ State.last ]
        if [ e.odd       ] bits += i32[ State.odd ]
        if [ e.even      ] bits += i32[ State.even ]
        if [ e.has_value ] bits += i32[ State.has_value ]
        if [ shift       ] bits += i32[ State.shifted ]
        opt : Option [ e inherits Option ]
        if [ opt->selected ] bits += i32[ State.selected ]
        e.on_state*[ bits ]
        if [ !e.parent && e != root ] return
        cv : (stage == CanvasType.screen) ? screen : compose
        if [ !e.bounds || e.bounds.w <= 0.0 || e.bounds.h <= 0.0 ] return
        if [ e.opacity <= 0.0 ] return
        # opacity scales everything the element paints
        cv.save[]
        if [ e.opacity < 1.0 ]
            cv.set_opacity[ cv.get_opacity[] * e.opacity ]
        # no_cache: no canvas of its own, it paints onto its parent's. that
        # reaches down: an element under one paints as it does
        nc : bool [ e.no_cache ]
        for [ pe: element* e.parent, pe && !nc, pe = pe.parent ]
            if [ pe.no_cache ] nc = true
        # no canvas of its own to clip it: a scrolling uncached element crops
        # to its bounds, or its rows would paint past them
        if [ nc && e.content_h > 0.0 ]
            ncx : f32 [ cv.transform_tx[] ]
            ncy : f32 [ cv.transform_ty[] ]
            cv.set_crop[ ncx, ncy, ncx + e.bounds.w, ncy + e.bounds.h ]
        margin_l : i32 [ 0 ]
        margin_t : i32 [ 0 ]
        margin_r : i32 [ 0 ]
        margin_b : i32 [ 0 ]
        for [ psc_au: Au, psc_k: string ] in e.layers
            psc_lay : cast Layer [ psc_au ]
            if [ !psc_lay || !psc_lay.area ] continue
            psc_b  : psc_lay.area.rectangle[ e.bounds, null, null, e.fc, false, 0.0, 0.0 ]
            psc_lx : f32  [ psc_b.x - e.bounds.x ]
            psc_ly : f32  [ psc_b.y - e.bounds.y ]
            psc_rx : f32  [ psc_b.x + psc_b.w - e.bounds.x - e.bounds.w ]
            psc_by : f32  [ psc_b.y + psc_b.h - e.bounds.y - e.bounds.h ]
            if [ psc_lx < 0.0 ]
                ol : i32 ceilf[ 0.0 - psc_lx ]
                if [ ol > margin_l ] margin_l = ol
            if [ psc_ly < 0.0 ]
                ot : i32 ceilf[ 0.0 - psc_ly ]
                if [ ot > margin_t ] margin_t = ot
            if [ psc_rx > 0.0 ]
                or2 : i32 ceilf[ psc_rx ]
                if [ or2 > margin_r ] margin_r = or2
            if [ psc_by > 0.0 ]
                ob2 : i32 ceilf[ psc_by ]
                if [ ob2 > margin_b ] margin_b = ob2
        if [ margin_l > 0 ] margin_l += 1
        if [ margin_t > 0 ] margin_t += 1
        if [ margin_r > 0 ] margin_r += 1
        if [ margin_b > 0 ] margin_b += 1
        ew : i32 [ i32[ceilf[e.bounds.w]] + 1 + margin_l + margin_r ]
        eh : i32 [ i32[ceilf[e.bounds.h]] + 1 + margin_t + margin_b ]
        if [ !nc && ( ew > 0 && eh > 0 ) && ( !e.cache_canvas || e.cache_w != ew || e.cache_h != eh ) ]
            if [ e.cache_canvas ]
                e.cache_canvas.resize[ ew, eh ]
                e.pristine = false
            el
                e.cache_canvas = Canvas [ w: a, vk: vk, format: Pixel.rgba8, width: ew, height: eh, load_existing: true, quantize: true, nearest: true ]
                e.cache_canvas.update[]
                e.pristine = false
            e.cache_w = ew
            e.cache_h = eh
            e.cache_ox = margin_l
            e.cache_oy = margin_t

        #log 'target_cv set'
        target_cv : (e.cache_canvas && !e.animated && !nc && stage == CanvasType.screen) ? e.cache_canvas : cv
        element_text : (e.label && e.label.count) ? e.label : null

        sx       : f32  [ (e.scaling.x != 0.0) ? e.scaling.x : 1.0 ]
        sy       : f32  [ (e.scaling.y != 0.0) ? e.scaling.y : 1.0 ]
        has_rot  : bool [ e.rotation != 0.0 ]
        has_sc   : bool [ sx != 1.0 || sy != 1.0 ]
        xform    : bool [ has_rot || has_sc ]

        if [ xform ]
            ox : f32 [ (e.transform_origin.x != 0.0) ? e.transform_origin.x : 0.5 ]
            oy : f32 [ (e.transform_origin.y != 0.0) ? e.transform_origin.y : 0.5 ]
            pivot_x : f32 [ e.bounds.w * ox ]
            pivot_y : f32 [ e.bounds.h * oy ]
            cv.save[]
            cv.translate[ pivot_x, pivot_y ]
            if [ has_rot ]
                cv.rotate[ e.rotation ]
            if [ has_sc ]
                cv.scale_xy[ sx, sy ]
            cv.translate[ -pivot_x, -pivot_y ]

        if [ stage == CanvasType.screen ] e.tick*[ a ]
        # an uncached element paints whenever it is reached: onto a cached
        # parent's canvas as that canvas repaints, else onto the screen
        redraw : bool [ e.animated || !e.pristine || nc || stage == CanvasType.compose ]
        tpe0 : i64 [ (stats) ? epoch_micros[] : 0 ]
        if [ redraw && e.cache_canvas && !e.animated && !nc && stage == CanvasType.screen ]
            eid : string [ (e.id && e.id.count > 0) ? e.id : '(noid)' ]
            if [ stats ] log 'REDRAW {eid} {ew}x{eh} pristine={e.pristine} animated={e.animated} nc={nc}'
        if [ redraw && e.cache_canvas && !e.animated && !nc && stage == CanvasType.screen ]
            e.cache_canvas.reset[ vec4f[0.0, 0.0, 0.0, 0.0] ]
            if [ e.cache_ox > 0 || e.cache_oy > 0 ]
                target_cv.save[]
                target_cv.translate[ f32 e.cache_ox, f32 e.cache_oy ]

        e.needs_frame = false

        defer_scroll : bool [ e.cache_canvas && !e.animated && !nc && stage == CanvasType.screen ]

        e_mask : i32 [ 0 ]
        if [ e.hovered   ] e_mask += i32[ State.hovered ]
        if [ e.pressed   ] e_mask += i32[ State.pressed ]
        if [ e.focused   ] e_mask += i32[ State.focused ]
        if [ e.disable   ] e_mask += i32[ State.disable ]
        if [ e.first     ] e_mask += i32[ State.first ]
        if [ e.middle    ] e_mask += i32[ State.middle ]
        if [ e.last      ] e_mask += i32[ State.last ]
        if [ e.odd       ] e_mask += i32[ State.odd ]
        if [ e.even      ] e_mask += i32[ State.even ]
        if [ e.has_value ] e_mask += i32[ State.has_value ]
        if [ shift     ] e_mask += i32[ State.shifted ]
        # selected lives on Option (not element) — fold it in typed
        eopt : Option [ e inherits Option ]
        if [ eopt->selected ] e_mask += i32[ State.selected ]
        for [ layer_au: Au, lkey: string ] in e.layers
            if [ !redraw ] break
            layer : cast Layer [ layer_au ]
            if [ !layer ]
                continue
            lsm : i32 [ i32[ layer.states ] ]
            if [ lsm != 0 && (e_mask & lsm) != lsm ]
                continue
            if [ layer.ctype != stage || layer.hide ]
                continue
            # the scrollbar has its own overlay pass, never the layer loop
            if [ lkey == 'scrollbar' ]
                continue

            layer.bounds = (layer.area) ? layer.area.rectangle[ e.bounds, null, null, e.fc, false, 0.0, 0.0 ] : e.bounds.copy[]
            layer.bounds.x -= e.bounds.x
            layer.bounds.y -= e.bounds.y
            b  : rect   [ layer.bounds ]
            r_tl : f32 [ 0.0 ]
            r_tr : f32 [ 0.0 ]
            r_br : f32 [ 0.0 ]
            r_bl : f32 [ 0.0 ]
            if [ layer.radius ]
                r_tl = layer.radius.tl
                r_tr = layer.radius.tr
                r_br = layer.radius.br
                r_bl = layer.radius.bl

            needs_blur  : bool [ layer.blur_x > 0.0 || layer.blur_y > 0.0 ]
            draw_cv     : target_cv
            blur_redraw : bool [ false ]

            if [ needs_blur ]
                blur_r  : f32 [ (layer.blur_x > layer.blur_y) ? layer.blur_x : layer.blur_y ]
                pad     : f32 [ blur_r * 2.0 ]
                bw : i32 [ i32[b.w + pad] + 1 ]
                bh : i32 [ i32[b.h + pad] + 1 ]
                resized9 : bool [ !layer.blur_canvas || layer.blur_bw != bw || layer.blur_bh != bh ]
                if [ resized9 ]
                    layer.blur_canvas = Canvas [ w: a, vk: vk, format: Pixel.rgba8, width: bw, height: bh ]
                    layer.blur_canvas.update[]
                    layer.blur_bw = bw
                    layer.blur_bh = bh
                    layer.blur_dirty = true
                if [ !e.pristine ]
                    layer.blur_dirty = true
                # the blur cascade is several fenced passes: pace it at the
                # backdrop rate (subtle = 4 Hz) unless the size changed
                now9 : i64 [ epoch_millis[] ]
                due9 : bool [ background_hz <= 0.0 || now9 - layer.blur_ms >= i64[ 1000.0 / background_hz ] ]
                if [ layer.blur_dirty && (resized9 || due9) ]
                    layer.blur_ms = now9
                    layer.blur_canvas.reset[ vec4f[0.0, 0.0, 0.0, 0.0] ]
                    draw_cv = layer.blur_canvas
                    draw_cv.save[]
                    draw_cv.translate[ -b.x + pad * 0.5, -b.y + pad * 0.5 ]
                    blur_redraw = true

            if [ (!needs_blur || blur_redraw) && ((layer.fill_color && layer.fill_color.a > 0.0) || (layer.stroke_color && layer.stroke_color.a > 0.0) || layer.inner_glow) ]
                draw_cv.save             [ ]
                sw_top   : f32 [ (layer.stroke_width) ? layer.stroke_width.top    : 0.0 ]
                sw_right : f32 [ (layer.stroke_width) ? layer.stroke_width.right  : 0.0 ]
                sw_bot   : f32 [ layer.stroke_width->bottom ]
                sw_left  : f32 [ (layer.stroke_width) ? layer.stroke_width.left   : 0.0 ]
                sw_max   : f32 [ maxf[ maxf[ sw_top, sw_right ], maxf[ sw_bot, sw_left ] ] ]
                draw_cv.set_stroke_size  [ sw_max ]
                draw_cv.set_stroke_cap   [ layer.stroke_cap  ]
                draw_cv.set_stroke_join  [ layer.stroke_join ]
                draw_cv.rounded          [ r_tl, r_tr, r_br, r_bl ]
                draw_cv.stroke_sides     [ sw_top, sw_right, sw_bot, sw_left ]
                # integral placement: snap the layer rect to the device pixel
                # grid (accounting for the canvas translate + scale) so a 1px
                # stroke/edge lands on one pixel row instead of straddling two
                lsc7 : f32 [ draw_cv.transform_scale[] ]
                if [ lsc7 <= 0.0 ] lsc7 = 1.0
                ltx7 : f32 [ draw_cv.transform_tx[] ]
                lty7 : f32 [ draw_cv.transform_ty[] ]
                bx7  : f32 [ (round[ b.x * lsc7 + ltx7 ] - ltx7) / lsc7 ]
                by7  : f32 [ (round[ b.y * lsc7 + lty7 ] - lty7) / lsc7 ]
                bw7  : f32 [ round[ b.w * lsc7 ] / lsc7 ]
                bh7  : f32 [ round[ b.h * lsc7 ] / lsc7 ]
                draw_cv.rounded_rect     [ bx7, by7, bw7, bh7,
                                           r_tl, r_tr, r_br, r_bl ]
                draw_cv.fill_color       [ (layer.fill_color && layer.fill_color.a > 0.0) ? layer.fill_color : rgba [ '#00000000' ] ]
                draw_cv.stroke_color     [ layer.stroke_color ]
                fp_x : f32 [ layer.fill_color_pos.x * e.bounds.w ]
                fp_y : f32 [ layer.fill_color_pos.y * e.bounds.h ]
                f_rad : f32 [ layer.fill_gradient_radius ]
                f_ax  : f32 [ draw_cv.transform_tx[] + fp_x ]
                f_ay  : f32 [ draw_cv.transform_ty[] + fp_y ]
                draw_cv.fill_grad        [ layer.fill_gradient_color ]
                if [ layer.fill_gradient == GradientType.radial ]
                    f_ry : f32 [ (layer.fill_gradient_radius_y > 0.0) ? layer.fill_gradient_radius_y : f_rad ]
                    draw_cv.fill_color_pos   [ f_ax, f_ay ]
                    draw_cv.fill_grad_pos    [ f_ax + f_rad, f_ay + f_ry ]
                    draw_cv.fill_grad_radial [ true ]
                    draw_cv.fill_grad_mirror [ false ]
                el [ layer.fill_gradient == GradientType.linear ]
                    draw_cv.fill_color_pos   [ f_ax, f_ay ]
                    fill_rad : f32 [ layer.fill_gradient_angle * 3.14159265 / 180.0 ]
                    fill_ext : f32 [ (f_rad > 0.0) ? f_rad : abs[b.w * cos[fill_rad]] + abs[b.h * sin[fill_rad]] ]
                    draw_cv.fill_grad_pos    [ f_ax + fill_ext * cos[ fill_rad ], f_ay + fill_ext * sin[ fill_rad ] ]
                    draw_cv.fill_grad_radial [ false ]
                    draw_cv.fill_grad_mirror [ false ]
                el
                    draw_cv.fill_grad_radial [ false ]
                    draw_cv.fill_grad_mirror [ false ]
                # stroke gradient anchor — independent of fill anchor
                sp_x  : f32 [ layer.stroke_color_pos.x * e.bounds.w ]
                sp_y  : f32 [ layer.stroke_color_pos.y * e.bounds.h ]
                s_ax  : f32 [ draw_cv.transform_tx[] + sp_x ]
                s_ay  : f32 [ draw_cv.transform_ty[] + sp_y ]
                s_rad : f32 [ layer.stroke_gradient_radius ]
                draw_cv.stroke_grad      [ layer.stroke_gradient_color ]
                if [ layer.stroke_gradient == GradientType.radial ]
                    s_ry : f32 [ (layer.stroke_gradient_radius_y > 0.0) ? layer.stroke_gradient_radius_y : s_rad ]
                    draw_cv.stroke_color_pos [ s_ax, s_ay ]
                    draw_cv.stroke_grad_pos  [ s_ax + s_rad, s_ay + s_ry ]
                    draw_cv.stroke_grad_radial [ true ]
                    draw_cv.stroke_grad_mirror [ false ]
                el [ layer.stroke_gradient == GradientType.linear ]
                    draw_cv.stroke_color_pos [ s_ax, s_ay ]
                    stroke_rad : f32 [ layer.stroke_gradient_angle * 3.14159265 / 180.0 ]
                    stroke_ext : f32 [ (s_rad > 0.0) ? s_rad : abs[b.w * cos[stroke_rad]] + abs[b.h * sin[stroke_rad]] ]
                    draw_cv.stroke_grad_pos  [ s_ax + stroke_ext * cos[ stroke_rad ], s_ay + stroke_ext * sin[ stroke_rad ] ]
                    draw_cv.stroke_grad_radial [ false ]
                    draw_cv.stroke_grad_mirror [ false ]
                el
                    draw_cv.stroke_grad_radial [ false ]
                    draw_cv.stroke_grad_mirror [ false ]
                if [ layer.inner_glow ]
                    if [ !layer.inner_glow.color ]
                        log 'DBG glow null-color: element={e.id} layer={lkey}'
                    el
                        draw_cv.inner_glow   [ layer.inner_glow.color, layer.inner_glow.blur ]
                draw_cv.paint            [ ]
                draw_cv.restore          [ ]

            if [ (!needs_blur || blur_redraw) && layer.image_svg ]
                sc : f32 (layer.image_scale > 0.0) ? layer.image_scale : 1.0
                dw : f32 layer.image_svg.w * sc
                dh : f32 layer.image_svg.h * sc
                if [ layer.image_fit > 0.0 && layer.image_svg.w > 0.0 && layer.image_svg.h > 0.0 ]
                    f2 : f32 [ min[ (b.w * layer.image_fit) / layer.image_svg.w,
                                    (b.h * layer.image_fit) / layer.image_svg.h ] ]
                    dw = layer.image_svg.w * f2
                    dh = layer.image_svg.h * f2
                dx : f32 b.x + (b.w - dw) * 0.5
                dy : f32 b.y + (b.h - dh) * 0.5
                draw_cv.save[]
                draw_cv.set_opacity[ (layer.opacity > 0.0) ? layer.opacity : 1.0 ]
                icf : rgba [ (layer.image_color) ? layer.image_color : rgba [ '#ffffff' ] ]
                draw_cv.fill_color  [ icf ]
                draw_cv.stroke_color[ icf ]
                draw_cv.draw_svg[ layer.image_svg, dx, dy, dw, dh ]
                draw_cv.restore[]

            label : string (layer.label && layer.label.count > 0) ? layer.label : null

            if [ (!needs_blur || blur_redraw) && !layer.editable && (element_text || label) && layer.label_size > 0 && layer.label_color && layer.label_color.a > 0 ]
                draw_cv.save[]
                prev_font : CanvasFont draw_cv.font
                prev_fs   : bool [ draw_cv.font_set ]
                if [ layer.label_font && layer.label_font.count > 0 ]
                    if [ !layer.label_font_cache ]
                        layer.label_font_cache = CanvasFont [ ft_lib: draw_cv.ft_lib, uri: layer.label_font, size_px: i32[layer.label_size] ]
                    draw_cv.set_font[ layer.label_font_cache ]
                align  : vec2f [ x: layer.label_align.x, y: layer.label_align.y ]
                offset : vec2f  [ x: layer.label_offset.x, y: layer.label_offset.y ]
                draw_cv.fill_color   [ layer.label_color ]
                draw_cv.font_size    [ layer.label_size ]
                draw_cv.line_height  [ layer.label_height ]
                cp_x : f32 [ layer.label_color_pos.x * e.bounds.w ]
                cp_y : f32 [ layer.label_color_pos.y * e.bounds.h ]
                rad  : f32 [ layer.label_gradient_radius ]
                ang  : f32 [ radians[ layer.label_gradient_degrees ] ]
                hx   : f32 [ cosf[ ang ] * rad * 0.5 ]
                hy   : f32 [ sinf[ ang ] * rad * 0.5 ]
                ax   : f32 [ draw_cv.transform_tx[] + cp_x ]
                ay   : f32 [ draw_cv.transform_ty[] + cp_y ]
                draw_cv.text_grad        [ layer.label_gradient ]
                draw_cv.text_color_pos   [ ax - hx, ay - hy ]
                draw_cv.text_grad_pos    [ ax + hx, ay + hy ]
                draw_cv.text_grad_mirror [ layer.label_gradient_mirror ]

                lsh : Shadow [
                    color:  layer.label_shadow,
                    offset: layer.label_shadow_offset,
                    blur:   layer.label_shadow_blur ]
                tx0 : f32 [ draw_cv.transform_tx[] + b.x ]
                ty0 : f32 [ draw_cv.transform_ty[] + b.y ]
                draw_cv.set_crop[ tx0, ty0, tx0 + b.w, ty0 + b.h ]
                draw_cv.draw_text    [ (label || element_text), b, align, offset, layer.label_overflow, lsh ]
                draw_cv.clear_crop[]
                if [ layer.label_font && layer.label_font.count > 0 ]
                    draw_cv.set_font[ (prev_fs) ? prev_font : null ]
                draw_cv.restore      [ ]

            layer.draw*[ draw_cv ]

            if [ needs_blur ]
                if [ blur_redraw ]
                    draw_cv.restore[]
                    br : f32 [ (layer.blur_x > layer.blur_y) ? layer.blur_x : layer.blur_y ]
                    layer.blur_canvas.blur[ br ]
                    layer.blur_dirty = false
                bpad : f32 [ ((layer.blur_x > layer.blur_y) ? layer.blur_x : layer.blur_y) * 2.0 ]
                target_cv.draw_canvas[ layer.blur_canvas, b.x - bpad * 0.5, b.y - bpad * 0.5, b.w + bpad, b.h + bpad ]

        if [ xform ]
            cv.restore[]

        if [ redraw ]
            prev_screen  : hold[ a.screen ]
            #prev_compose : hold[ a.compose ]
            if [ stage == CanvasType.screen ]  a.screen  = target_cv
            #if [ stage == CanvasType.compose ] a.compose = target_cv
            e.draw*[ a ]
            # the uncached children paint into this canvas, part of the cache
            if [ e.cache_canvas && !e.animated && !nc && stage == CanvasType.screen && e.elements ]
                for [ pass9: i32 0, pass9 < 2, pass9 += 1 ]
                    for [ ee: element, id: string ] in e.elements
                        if [ !ee.no_cache || ee.hide || ee.animated ] continue
                        if [ (pass9 == 0) != !ee.topmost ] continue
                        target_cv.save[]
                        if [ ee.bounds ]
                            relx : bool [ ee.area && ee.area.l.relative ]
                            rely : bool [ ee.area && ee.area.t.relative ]
                            sx : f32 [ (ee.no_scroll || !relx) ? 0.0 : e.scroll.x ]
                            sy : f32 [ (ee.no_scroll || !rely) ? 0.0 : e.scroll.y ]
                            target_cv.translate[ ee.bounds.x - sx, ee.bounds.y - sy ]
                        draw_element[ ee, stage, null ]
                        target_cv.restore[]
            a.screen  = prev_screen
            #a.compose = prev_compose
            drop[ prev_screen ]
            #drop[ prev_compose ]
            if [ !e.animated && stage == CanvasType.screen ]
                if [ e.cache_ox > 0 || e.cache_oy > 0 ]
                    target_cv.restore[]
                if [ !e.needs_frame ]
                    e.pristine = true

        # scroll_fade drives the mask from scroll state, per frame
        if [ e.scroll_fade > 0.0 && e.content_h > 0.0 && e.bounds ]
            mxs : f32 [ e.content_h - e.bounds.h ]
            e.mask_glow.x = (e.scroll.y > 0.5) ? e.scroll_fade : 0.0
            e.mask_glow.z = (mxs > 0.5 && e.scroll.y < mxs - 0.5) ? e.scroll_fade : 0.0
        mask_on : bool [ e.mask_glow.x > 0.0 || e.mask_glow.y > 0.0 || e.mask_glow.z > 0.0 || e.mask_glow.w > 0.0 ]
        if [ e.cache_canvas && !e.animated && !nc && stage == CanvasType.screen ]
            # snap the cache blit to the device grid: a cached element sitting
            # at a fractional screen pixel smears its whole border over two
            bsc9 : f32 [ cv.transform_scale[] ]
            if [ bsc9 <= 0.0 ] bsc9 = 1.0
            bsx9 : f32 [ (round[ cv.transform_tx[] ] - cv.transform_tx[]) / bsc9 ]
            bsy9 : f32 [ (round[ cv.transform_ty[] ] - cv.transform_ty[]) / bsc9 ]
            if [ mask_on ]
                glow_changed : bool [ e.mask_bg.x != e.mask_glow.x || e.mask_bg.y != e.mask_glow.y || e.mask_bg.z != e.mask_glow.z || e.mask_bg.w != e.mask_glow.w ]
                if [ !e.mask_canvas || e.mask_w != ew || e.mask_h != eh || glow_changed ]
                    mcs : f32 [ (a.scale > 0.0) ? a.scale : 1.0 ]
                    if [ !e.mask_canvas ]
                        e.mask_canvas = Canvas [ w: a, vk: vk, format: Pixel.rgba8, width: i32[ e.cache_canvas.width / mcs ], height: i32[ e.cache_canvas.height / mcs ], load_existing: true, quantize: true ]
                        e.mask_canvas.update[]
                    el
                        e.mask_canvas.resize[ i32[ e.cache_canvas.width / mcs ], i32[ e.cache_canvas.height / mcs ] ]
                    e.mask_canvas.content_w = ew
                    e.mask_canvas.content_h = eh
                    e.mask_w = ew
                    e.mask_h = eh
                    e.mask_canvas.reset[ vec4f[ 0.0, 0.0, 0.0, 1.0 ] ]
                    e.mask_canvas.save[]
                    # linear falloff so the fade is a straight ramp on the edges
                    e.mask_canvas.glow_falloff[ 1.0 ]
                    e.mask_canvas.fill_color[ rgba['#fff'] ]
                    # mask_glow = (top, right, bottom, left) px
                    e.mask_canvas.inner_glow_sides[ rgba['#000'],
                        e.mask_glow.x, e.mask_glow.y, e.mask_glow.z, e.mask_glow.w ]
                    mrx : f32 [ e.mask_inset.w ]
                    mry : f32 [ e.mask_inset.x ]
                    mrw : f32 [ f32 ew - e.mask_inset.w - e.mask_inset.y ]
                    mrh : f32 [ f32 eh - e.mask_inset.x - e.mask_inset.z ]
                    e.mask_canvas.rect_to[ mrx, mry, mrw, mrh ]
                    e.mask_canvas.paint[]
                    if [ e.mask_keep_l > 0.0 ]
                        e.mask_canvas.inner_glow_sides[ rgba['#000'], e.mask_glow.x, 0.0, e.mask_glow.z, 0.0 ]
                        e.mask_canvas.fill_color[ rgba['#fff'] ]
                        e.mask_canvas.rect_to[ 0.0, mry, e.mask_keep_l, mrh ]
                        e.mask_canvas.paint[]
                    e.mask_canvas.restore[]
                    e.mask_bg = e.mask_glow
                cv.draw_canvas_masked[ e.cache_canvas, e.mask_canvas,
                    0.0 - f32 [ e.cache_ox ] + bsx9, 0.0 - f32 [ e.cache_oy ] + bsy9, f32 [ ew ], f32 [ eh ] ]
            el
                if [ dbg_blit < 14 ]
                    dbg_blit += 1
                cv.draw_canvas[ e.cache_canvas, 0.0 - f32 [ e.cache_ox ] + bsx9, 0.0 - f32 [ e.cache_oy ] + bsy9, f32 [ ew ], f32 [ eh ] ]
            sbl : ScrollLayer (e.layers) ? cast ScrollLayer [ e.layers['scrollbar'] ] : null
            if [ sbl && sbl.ctype == stage && !sbl.hide ]
                sbl.bounds = (sbl.area) ? sbl.area.rectangle[ e.bounds, null, null, e.fc, false, 0.0, 0.0 ] : e.bounds.copy[]
                sbl.bounds.x -= e.bounds.x
                sbl.bounds.y -= e.bounds.y
                cv.save[ ]
                sbtx : f32 [ cv.transform_tx[] ]
                sbty : f32 [ cv.transform_ty[] ]
                cv.set_crop[ sbtx, sbty, sbtx + e.bounds.w, sbty + e.bounds.h ]
                sbl.draw[ cv ]
                cv.restore[ ]

        # an uncached element has no blit pass: its scrollbar draws here
        if [ nc && stage == CanvasType.screen ]
            sbn : ScrollLayer (e.layers) ? cast ScrollLayer [ e.layers['scrollbar'] ] : null
            if [ sbn && sbn.ctype == stage && !sbn.hide ]
                sbn.bounds = (sbn.area) ? sbn.area.rectangle[ e.bounds, null, null, e.fc, false, 0.0, 0.0 ] : e.bounds.copy[]
                sbn.bounds.x -= e.bounds.x
                sbn.bounds.y -= e.bounds.y
                cv.save[ ]
                sbn.draw[ cv ]
                cv.restore[ ]

        if [ stats && stage == CanvasType.screen ] e.paint_us += epoch_micros[] - tpe0
        cached9 : bool [ e.cache_canvas && !e.animated && !nc && stage == CanvasType.screen ]
        last_2 : element
        # cached children compose onto the shared target, not into this cache:
        # a scrolling element crops them to its bounds or its rows land past
        # them (topmost children, popups, stay free)
        if [ e.content_h > 0.0 && stage == CanvasType.screen ]
            ccx9 : f32 [ cv.transform_tx[] ]
            ccy9 : f32 [ cv.transform_ty[] ]
            cv.save[]
            cv.crop_within[ ccx9, ccy9, ccx9 + e.bounds.w, ccy9 + e.bounds.h ]
        for [ ee: element, id: string ] in e.elements
            if [ ee.topmost ] continue
            # an uncached child lives in this cache: its change repaints us.
            # an animated one paints every frame onto the composed target
            if [ cached9 && ee.no_cache && !ee.animated ]
                if [ !ee.pristine ] e.pristine = false
                continue
            cv.save[]
            if [ ee.bounds ]
                relx : bool [ ee.area && ee.area.l.relative ]
                rely : bool [ ee.area && ee.area.t.relative ]
                sx : f32 [ (ee.no_scroll || !relx) ? 0.0 : e.scroll.x ]
                sy : f32 [ (ee.no_scroll || !rely) ? 0.0 : e.scroll.y ]
                cv.translate[ ee.bounds.x - sx, ee.bounds.y - sy ]
            draw_element[ ee, stage, last_2 ]
            last_2 = ee
            cv.restore[]
        if [ e.content_h > 0.0 && stage == CanvasType.screen ] cv.restore[]
        for [ ee: element, id: string ] in e.elements
            if [ !ee.topmost ] continue
            if [ cached9 && ee.no_cache && !ee.animated ]
                if [ !ee.pristine ] e.pristine = false
                continue
            cv.save[]
            if [ ee.bounds ]
                relx : bool [ ee.area && ee.area.l.relative ]
                rely : bool [ ee.area && ee.area.t.relative ]
                sx : f32 [ (ee.no_scroll || !relx) ? 0.0 : e.scroll.x ]
                sy : f32 [ (ee.no_scroll || !rely) ? 0.0 : e.scroll.y ]
                cv.translate[ ee.bounds.x - sx, ee.bounds.y - sy ]
            draw_element[ ee, stage, last_2 ]
            last_2 = ee
            cv.restore[]

        # children are composed: anything drawn here lands ON TOP of them
        if [ redraw ]
            over_screen : hold[ a.screen ]
            if [ stage == CanvasType.screen ] a.screen = target_cv
            e.draw_over*[ a ]
            a.screen = over_screen
            drop[ over_screen ]
        cv.restore[]


class offscreen
    context vk    : vk_context
    public width  : i32 [ 1024 ]
    public height : i32 [ 1024 ]
    public root   : element
    public st     : Style                      # usually the host app's style
    public w      : Window

    func init []
        expect root, 'offscreen requires a root element'
        if [ !st ] st = Style [ root ]
        win : Window [ vk: vk, app_object: root, st: st,
            width: width, height: height, backbuffer: true, title: 'offscreen' ]
        w = win
        Au.hold[ w ]
        root.vk = vk
        w.update*[]
        w.restyle = true

    # one headless frame: tree update + draw, nothing presents
    public func frame []
        if [ w ] w.draw[]

class StatePersist

# `public [ Launch ] x : T [ default ]` — a launch parameter the host may offer
class Launch

# a launch parameter the host may also set while the app runs (`set name value`)
Launch Live

# meta B is the control: `[ Live, VolumeRange ]`. its members are the runtime
# defaults the app instances when it answers `props`; no arguments in the meta
class Range
    public min : f32 [ 0.0 ]
    public max : f32 [ 1.0 ]

Range VolumeRange
    min : 0.0
    max : 1.0

# a key binding on an i32 keycode: the host's editor reads 'press key' and
# captures the next key for it, one member per button
class KeyBind

# a method the host may call while the app runs: `public [ Action ] func reset []`
Live Action

# a '#rrggbb' string: the host shows a swatch beside the hex
class Color

# a gamepad button binding on an i32 button code, one member per button
class PadBind

# a number stepped between min and max: the host draws - value +
class Stepper
    public min  : f32 [ 0.0 ]
    public max  : f32 [ 100.0 ]
    public step : f32 [ 1.0 ]

# a folder on a path member, picked from the host's nav list
class Directory

# a longer string: the host gives it a taller field
class Multiline

# a path the module handles: a host picks it by the module's exported extensions
path resource

func state_persist_path [ target: Au ] -> path
    if [ !target ] return null
    ty : Au_t typeid[ target ]
    dir : path path.path_storage[ ty.ident ]
    if [ !dir ] return null
    return path '{dir}/persist.agi'

func state_persist_store [ target: Au ]
    sp : state_persist_path[ target ]
    if [ !sp ] return
    values : map Au [string] []
    for [ ty : typeid[ target ], ty != typeid[ Au ],
        ty = ty.context ]
        for [ i: i32 0, i < ty.members.count, i += 1 ]
            mem : Au_t ty.members.origin[i]
            if [ mem.member_type != AU_MEMBER_VAR ] continue
            if [ mem.meta.m != typeid[ StatePersist ] ] continue
            v8 : target.member_object[ mem ]
            if [ v8 ] values[string[ mem.ident ]] = v8
    sp.save[ Au.string_agi[ values ], null ]

# a member is in the file when a top-level line names it: AF bits
# only cover the public schema, and interns persist too
func agi_has_key [ txt: string, ident: cstr ] -> bool
    key : string '{ident}:'
    at  : i32 [ 0 ]
    while [ at < txt.count ]
        end : i32 [ at ]
        while [ end < txt.count && txt[ end ] != 10 ] end += 1
        if [ end - at >= key.count && txt[ at ] != 9 ]
            if [ txt.mid[ at, key.count ] == key ] return true
        at = end + 1
    return false

func state_persist_load [ target: Au ]
    sp : state_persist_path[ target ]
    if [ !sp || !sp.exists[] ] return
    txt : string [ sp.load[ typeid[string], null ] ]
    if [ !txt || txt.count == 0 ] return
    ty : Au_t typeid[ target ]
    source : Au.new_object[ ty, null, null, false,
        __FILE__, __LINE__, __SEQUENCE__ ]
    Au.parse_agi[ null, txt.chars, source ]
    for [ mt : ty, mt != typeid[ Au ], mt = mt.context ]
        for [ i: i32 0, i < mt.members.count, i += 1 ]
            mem : Au_t mt.members.origin[i]
            if [ mem.member_type != AU_MEMBER_VAR ] continue
            if [ mem.meta.m != typeid[ StatePersist ] ] continue
            if [ !agi_has_key[ txt, mem.ident ] ] continue
            v9 : source.member_object[ mem ]
            # an empty block reads as null: never erase a live default
            if [ v9 ] target.member_set[ mem, v9 ]

class AgentConnection
    func post [ root: path, from: string, text: string, urgency: string ] -> bool
        return false

AgentConnection SocketAgentConnection
    public socket : path
    public token : string

    func post [ root: path, from: string, text: string, urgency: string ] -> bool
        if [ !socket ] return false
        peer : string [ (token) ? token : '' ]
        return agent_inbox_post[ socket.chars, peer.chars, from.chars, text.chars, urgency.chars ] != 0

AgentConnection CodexAgentConnection
    public socket : path
    public session : string

    func post [ root: path, from: string, text: string, urgency: string ] -> bool
        endpoint : string [ (socket) ? '{socket}' : '' ]
        thread : string [ (session) ? session : '' ]
        msg : 'From: {from}\nPriority: {urgency}\n\n{text}'
        return agent_codex_post_async[ root.chars, endpoint.chars, thread.chars, msg.chars ] != 0

AgentConnection ClaudeAgentConnection
    public socket : path

    func post [ root: path, from: string, text: string, urgency: string ] -> bool
        sk : local i8 [ 512 ]
        tk : local i8 [ 128 ]
        explicit_socket : string [ (socket) ? '{socket}' : '' ]
        if [ agent_inbox_find[ root.chars, explicit_socket.chars, @sk[0], 512, @tk[0], 128 ] == 0 ]
            log 'agent: no session inbox for {root}'
            return false
        return agent_inbox_post[ @sk[0], @tk[0], from.chars, text.chars, urgency.chars ] != 0

abstract media_app trinity
    public root         : element
    public title        : string
    # fixed logical width (points) on a device: the height follows the aspect, like a 480-wide game screen
    public logical_width : i32
    public hidden       : bool
    public startup_path : path
    public agent : string
    # the agents the user runs, by adapter name ('claude', 'codex', ...):
    # the exchange's prompt offers the pick; `agent` alone is one of them
    public agents : vec string
    public agent_connection : AgentConnection
    # Legacy socket setting for the default connection.
    public agent_inbox  : path
    intern msaa_samples : i64
    intern istroke      : f32 0
    intern ifill        : f32 0

    func load_scene   [] return

    func adopt [ name: string ]
        v : root.get_property[ name.chars ]
        if [ v ] a.set_property[ name.chars, v ]

    func console_size []
        ws : winsize
        ok : bool [ ioctl[ 1, 0x40087468, @ws ] == 0 && ws.ws_col > 0 ]
        if [ !ok ] ok = ioctl[ 1, 0x5413, @ws ] == 0 && ws.ws_col > 0
        if [ ok ]
            width  = i32 ws.ws_col
            height = i32 ws.ws_row
        if [ width  <= 0 ] width  = 80
        if [ height <= 0 ] height = 24

    func init []
        expect root, 'trinity requires a root element'
        # app element is process-owned; holds must not pin it
        header : Au.header[ root ]
        header.managed = 0
        rtn : typeid[ root ]
        host_log_setup[ rtn.ident ]
        startup_path = path.path_startup[]
        root.initialize[]
        # the app element never goes through update_element's first pass
        bind_members[ root ]
        root.initialized = true
        adopt[ 'title' ]
        adopt[ 'width' ]
        adopt[ 'height' ]
        adopt[ 'logical_width' ]
        adopt[ 'lock_aspect' ]
        if [ lock_aspect ]
            aspect_w = width
            aspect_h = height
        adopt[ 'background' ]
        adopt[ 'text_mode' ]
        adopt[ 'hidden' ]
        adopt[ 'screenshot' ]
        adopt[ 'shot_frame' ]
        adopt[ 'attach' ]
        adopt[ 'record' ]
        adopt[ 'record_mic' ]
        adopt[ 'agent' ]
        adopt[ 'agents' ]
        adopt[ 'agent_inbox' ]
        ag9 : Au root.get_property[ 'agents' ]
        log 'ADOPT agents root={bool[ag9]} type={(ag9) ? string[ Au.header[ ag9 ].au.ident ] : "none"} app={bool[ a.get_property[ "agents" ] ]}'   # DIAG
        # SILVER_DISPLAY=<PIP|Full|Window|Screen>: the host's launch display.
        # PIP and Full start with the window never shown: the frames go to
        # orbiter's pane, and Window brings the window up later, live
        dsp9 : cstr [ getenv[ 'SILVER_DISPLAY' ] ]
        if [ dsp9 ]
            ds9 : string [ dsp9 ]
            if [ ds9 == 'Full' ]   root.display = DisplayMode.Full
            if [ ds9 == 'Window' ] root.display = DisplayMode.Window
            if [ ds9 == 'Screen' ] root.display = DisplayMode.Screen
            if [ ds9 == 'PIP' || ds9 == 'Full' ] hidden = true
        # SILVER_HZ: the host display's refresh, the pace of a paned app
        hz9 : cstr [ getenv[ 'SILVER_HZ' ] ]
        if [ hz9 ]
            hs9 : string [ hz9 ]
            hv9 : i32 [ i32[ hs9.integer_value[] ] ]
            if [ hv9 >= 24 && hv9 <= 480 ] frame_hz = hv9
        rt : typeid[ root ]
        if [ text_mode ]
            console_size[]
            cwin : Window[ app_object: root, title:(title) ?? rt.ident, st: Style [ root ],
                width:width, height:height, text_mode: true ]
            w = cwin
            Au.hold[ w ]
            cwin.console_input_open[]
            render *[]
            cwin.restyle = true
            Au.auto_free[ true ]
            return
        ifdef [ unix ]
            if [ attach ]
                at_start[ rt ]
                Au.auto_free[ true ]
                return
        window : Window[ app_object: root, title:(title) ?? rt.ident, st: Style [ root ],
            width:(width) ?? 1888, height:(height) ?? 888,
            hidden: hidden, lock_aspect: lock_aspect, logical_width: logical_width,
            aspect_w: aspect_w, aspect_h: aspect_h ]
        expect window.vk, "context didnt work"
        w = window
        Au.hold[ w ]
        root.vk = window.vk
        # the app loads hidden
        window.hidden = true
        w.update *[]
        render   *[]
        w.resize[w.width, w.height]
        window.restyle = true
        Au.auto_free[ true ]

    func render[]
        if [ text_mode ]
            cwin : Window[w]
            cwin.draw_console[]
            frames += 1
            return
        window : Window[w]
        window.will_animate = false
        u0 : i64 [ epoch_micros[] ]
        # headless hosts render alongside the window (no present)
        if [ window.offscreens ]
            for [ os_au: Au ] in window.offscreens
                os : offscreen [ os_au inherits offscreen ]
                if [ os ] os.frame[]
        u1 : i64 [ epoch_micros[] ]
        window.draw[]
        # loaded hidden; shown once the scene has drawn (--hidden stays hidden)
        if [ window.hidden && !hidden && window.loaded[] ]
            window.hidden = false
        vk.update_us += u1 - u0
        vk.draw_us   += epoch_micros[] - u1
        frames += 1

    ifdef [ unix ]
        func at_start [ rt: Au_t ]
            aw : i32 [ (width)  ?? 1280 ]
            ah : i32 [ (height) ?? 720 ]
            awin : Window[ app_object: root, title:(title) ?? rt.ident, st: Style [ root ],
                width: aw, height: ah, backbuffer: true,
                format: Pixel.rgba8, logical_width: logical_width ]
            w = awin
            Au.hold[ w ]
            root.vk = awin.vk
            w.update *[]
            render   *[]
            w.resize[ aw, ah ]
            awin.restyle = true
            log 'attach: hosted {aw}x{ah} (slot {host_slot[]})'





# the adapter for a pick (the exchange's choice), else the configured one
func agent_connect [ obj: Au, pick: string ] -> AgentConnection
    if [ !obj ] return null
    connection : cast AgentConnection [ obj.get_property[ 'agent_connection' ] ]
    if [ connection && (!pick || pick.count == 0) ] return connection
    if [ connection && pick == 'codex' && connection inherits CodexAgentConnection ] return connection
    if [ connection && pick == 'claude' && connection inherits ClaudeAgentConnection ] return connection
    name : string [ (pick && pick.count > 0) ? pick : cast string [ obj.get_property[ 'agent' ] ] ]
    if [ !name || name.count == 0 || name == 'claude' ]
        ib : cast path [ obj.get_property[ 'agent_inbox' ] ]
        return ClaudeAgentConnection [ socket: ib ]
    if [ name == 'codex' ] return CodexAgentConnection []
    log 'agent: unknown connection {name}'
    return null

func agent_post [ obj: Au, text: string, priority: string ] -> bool
    return agent_post_as[ obj, null, text, priority ]

# the names the exchange offers: the app's `agents` list, else its `agent`,
# else claude
func agent_names [ obj: Au ] -> vec string
    out : vec string []
    if [ obj ]
        # agents is media_app's own member (no app redeclares it), so the
        # base view of the app reads it at the base's offset
        # by name: an app declares `agents` on its own type (the abstract's
        # member is not in its layout), so the property is the one to read
        av9 : Au obj.get_property[ 'agents' ]
        if [ av9 ]
            vv9 : cast vector [ av9 ]
            for [ i: i32 0, i < vv9.count, i += 1 ]
                n : string [ cast string [ vv9[ i ] ] ]
                if [ n && n.count > 0 ] out.push[ n ]
        if [ out.count == 0 ]
            one : cast string [ obj.get_property[ 'agent' ] ]
            if [ one && one.count > 0 ] out.push[ one ]
    if [ out.count == 0 ] out.push[ 'claude' ]
    log 'AGENTS names={out.count} first={out[0]}'   # DIAG
    return out

func agent_post_as [ obj: Au, pick: string, text: string, priority: string ] -> bool
    connection : AgentConnection agent_connect[ obj, pick ]
    if [ !connection ] return false
    # Apps may redeclare properties at different offsets.
    sp : path   [ cast path   [ obj.get_property[ 'startup_path' ] ] ]
    tt : string [ cast string [ obj.get_property[ 'title'        ] ] ]
    rt : path [ (sp) ? sp : path.path_startup[] ]
    fr : string [ (tt && tt.count > 0) ? tt : 'trinity' ]
    ok : bool [ connection.post*[ rt, fr, text, priority ] ]
    if [ !ok ] log 'agent: inbox post failed'
    return ok

func save-persistent []
    glfw : handle [ Au.live_window_get[] ]
    if [ !glfw ] return
    win : cast Window [ platform_window_get_user[ glfw ] ]
    if [ win && win.app_object ]
        state_persist_store[ win.app_object ]

func load-persistent [ target: Au ]
    state_persist_load[ target ]

# scrolling requires defined children Region
Layer Children
    public scroll : vec2f

Layer ScrollLayer
    public thumb_color  : string [ '#fff3' ]
    public thumb_w      : f32 [ 6.0 ]
    public thumb_min_h  : f32 [ 32.0 ]
    public thumb_radius : f32 [ 4.0 ]
    mutable thumb_y_px  : f32
    mutable thumb_h_px  : f32
    mutable track_vis   : f32
    mutable scroll_max  : f32
    mutable grab_w      : f32
    mutable top_pad     : f32
    mutable grab_off    : f32
    public  active      : bool

    func draw [ cv: Canvas ]
        e : element [ parent ]
        if [ !e || e.content_h <= 0.0 || e.bounds.h >= e.content_h ] return
        if [ e.no_scroll ] return
        top     : f32 [ bounds.y ]
        cl      : Layer (e.layers) ? e.layers['content'] : null
        if [ cl && cl.bounds ] top = cl.bounds.y + 8.0
        top_pad = (cl && cl.bounds) ? top - cl.bounds.y : 0.0
        total_h : f32 [ e.content_h ]
        vis_h   : f32 [ bounds.y + bounds.h - top ]
        ratio   : f32 [ vis_h / total_h ]
        min_h   : f32 [ (thumb_min_h > 0.0) ? thumb_min_h : 32.0 ]
        # no room for even the minimum thumb — don't draw a stub bar
        if [ vis_h < min_h ] return
        thumb_h : f32 [ (ratio * vis_h < min_h) ? min_h : ratio * vis_h ]
        travel  : f32 [ vis_h - thumb_h ]
        max_sc  : f32 [ total_h - vis_h ]
        thumb_y : f32 [ top + (max_sc > 0.0) ? (e.scroll.y / max_sc) * travel : 0.0 ]
        base_w  : f32 [ thumb_w ]
        reach : f32 [ 90.0 ]
        prox  : f32 [ 0.0 ]
        if [ e.hovered ]
            from_right : f32 [ (1.0 - e.cursor_pos.x) * e.bounds.w ]
            prox = clamp[ 1.0 - from_right / reach, 0.0, 1.0 ]
        if [ active ] prox = 1.0
        eff_w : f32 [ base_w * (1.0 + prox) ]
        r     : f32 [ thumb_radius * (1.0 - prox) ]
        cx      : f32 [ bounds.x + bounds.w - base_w ]
        thumb_x : f32 [ cx - eff_w * 0.5 ]
        thumb_y_px = thumb_y - top
        thumb_h_px = thumb_h
        track_vis  = vis_h
        scroll_max = max_sc
        grab_w     = base_w * 2.0 + 6.0
        if [ prox > 0.0 ]
            cv.fill_color  [ rgba['#0000'] ]
            cv.stroke_color[ rgba[ r:1.0, g:1.0, b:1.0, a: 0.133 * prox ] ]
            cv.stroke_width[ 1.0 ]
            cv.rect_to     [ thumb_x, top, eff_w, vis_h ]
            cv.paint       [ ]
            cv.stroke_width[ 0.0 ]
        cv.fill_color[ thumb_color ]
        cv.rounded_rect[ thumb_x, thumb_y, eff_w, thumb_h, r, r, r, r ]
        cv.paint[]

    public func drag_to [ my: f32 ] -> f32
        travel : f32 [ track_vis - thumb_h_px ]
        if [ travel <= 0.0 ] return -1.0
        thumb_top : f32 [ my - top_pad - grab_off ]
        return clamp[ (thumb_top / travel) * scroll_max, 0.0, scroll_max ]

    public func grab_at [ my: f32 ]
        mt : f32 [ my - top_pad ]
        if [ mt >= thumb_y_px && mt <= thumb_y_px + thumb_h_px ]
            grab_off = mt - thumb_y_px
        el
            grab_off = thumb_h_px * 0.5


element View
    func render[] -> Elements
        return null

element Group
    func render[] -> Elements
        return null

element Group2
    func render[] -> Elements
        return null

element TButtons
    # no canvas of its own: it paints onto its parent's, when it changes
    no_cache : true
    public  buttons   : vec string    # segment ids, e.g. [ 'minus', 'plus' ]
    public  icons     : bool [ true ] # ids resolve to images/<id>.svg
    # per-segment icon name when the id is not the file name
    public  icon_ids  : vec string
    public  manual    : bool          # actions, not toggles — no latched selection
    public  selected  : i32 [ -1 ]
    public  sel_mask  : i32
    public  disable_mask : i32        # per-segment disable, same bits as sel_mask
    public  seg_radius : f32 [ 8.0 ]
    # icon height as a fraction of the control's height
    public  icon_scale : f32 [ 0.55 ]
    # text segments: point size, 0 = half the control's height
    public  label_px  : f32
    # rest-state edge, off by default; set to match neighboring buttons
    public  rest_glow  : rgba
    public  rest_px    : f32
    intern  svg_cache : map SVGModel [string]
    intern  svg_miss  : map i32      [string]
    intern  hover_ix  : i32 [ -1 ]
    intern  pick_dbg  : bool          # DIAG
    # the strip's own id: a press hands the app the segment's name as the
    # target id, and the next move gives the strip its name back
    intern  strip_id  : string
    # collapse: at rest the strip is one segment wide and shows rest_icon;
    # the style grows its area (a transition on :hovered) and the draw
    # follows: segments keep bounds.h * seg_aspect each from the right
    # edge, and the icons fade in, clipped to what the strip has revealed
    public  collapse   : bool
    public  seg_aspect : f32 [ 1.2778 ]
    public  rest_icon  : string [ 'more' ]

    func seg_width [] -> f32
        n : i32 [ (buttons) ? buttons.count : 1 ]
        if [ n < 1 ] n = 1
        if [ collapse ] return bounds.h * seg_aspect
        return bounds.w / f32[ n ]

    # 0..1: how much of the full strip the area has grown to
    func reveal [] -> f32
        if [ !collapse || !buttons || buttons.count <= 1 ] return 1.0
        sw   : f32 [ seg_width[] ]
        full : f32 [ sw * f32[ buttons.count ] ]
        if [ full <= sw ] return 1.0
        return clamp[ (bounds.w - sw) / (full - sw), 0.0, 1.0 ]

    # a segment's left edge: shared width from the left, or its own
    # width from the right when the strip collapses
    func seg_x [ i: i32 ] -> f32
        sw : f32 [ seg_width[] ]
        if [ !collapse ] return f32[ i ] * sw
        return bounds.w - f32[ buttons.count - i ] * sw

    # the segment under the pointer, by its id; '' when none is
    func hover_name [] -> string
        if [ !hovered || !buttons || hover_ix < 0 || hover_ix >= buttons.count ] return ''
        return buttons[ hover_ix ]

    func theme_rgba [ s: string ] -> rgba
        if [ ux && ux.st ] return ux.st.theme_color[ s ]
        return rgba [ s ]

    # the svg for a segment id, loaded on first use. a segment with no
    # icon file draws its name instead, so any id can be a button
    func seg_svg [ id: string ] -> SVGModel
        if [ !id ] return null
        if [ !svg_cache ] svg_cache = map SVGModel [string] [ ]
        if [ !svg_miss ] svg_miss = map i32 [string] [ ]
        if [ svg_miss.contains[ id ] ] return null
        model : SVGModel svg_cache[ id ]
        if [ !model ]
            file : path 'images/{id}.svg'
            if [ !file.exists[] ]
                svg_miss[ id ] = 1
                return null
            model = SVGModel [ file ]
            svg_cache[ id ] = model
        return model

    # segment index under the cursor, or -1 outside the strip.
    func seg_at [ ev: Event ] -> i32
        if [ !buttons ] return -1
        n : i32 [ buttons.count ]
        if [ n == 0 ] return -1
        rel : f32 [ ev.mouse.pos.x ]
        if [ rel < 0.0 || rel >= bounds.w ] return -1
        if [ collapse ]
            # only a fully revealed strip has segments to hit
            if [ reveal[] < 0.999 ] return -1
            k : i32 [ i32[ (bounds.w - rel) / seg_width[] ] ]
            i : i32 [ n - 1 - k ]
            return (i >= 0) ? i : -1
        return i32 [ rel / (bounds.w / f32[ n ]) ]

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        if [ !buttons ] return
        n : i32 [ buttons.count ]
        if [ n == 0 || !bounds ] return
        cv : Canvas w.screen
        # DIAG: the exchange's picker
        if [ id && id == 'agent_pick' && !pick_dbg ]
            pick_dbg = true
            log 'PICKDRAW n={n} bounds={bounds.x},{bounds.y},{bounds.w},{bounds.h} tx={cv.transform_tx[]} ty={cv.transform_ty[]} op={cv.get_opacity[]} opacity={opacity}'
        if [ !hovered ] hover_ix = -1
        # integral placement: the element origin is often a fractional device
        # pixel, which smears a 1px stroke. snap the whole draw to the grid
        sc9  : f32 [ cv.transform_scale[] ]
        if [ sc9 <= 0.0 ] sc9 = 1.0
        snx9 : f32 [ (round[ cv.transform_tx[] ] - cv.transform_tx[]) / sc9 ]
        sny9 : f32 [ (round[ cv.transform_ty[] ] - cv.transform_ty[]) / sc9 ]
        cv.save[]
        cv.translate[ snx9, sny9 ]
        seg_w : f32 [ seg_width[] ]
        rv9   : f32 [ reveal[] ]
        op0   : f32 [ cv.get_opacity[] ]
        if [ collapse ]
            # what the strip has grown to shows; the rest waits past its edge
            cwx : f32 [ cv.transform_tx[] ]
            cwy : f32 [ cv.transform_ty[] ]
            cv.set_crop[ cwx, cwy, cwx + bounds.w, cwy + bounds.h ]
            # one rounded ground over what has grown: the segments' own
            # rest fills would show their square inner corners at the
            # strip's growing edge and the dots chip
            cv.fill_color[ rgba [ '#ffffff0c' ] ]
            cv.rounded[ seg_radius, seg_radius, seg_radius, seg_radius ]
            cv.rounded_rect[ 0.0, 0.0, bounds.w, bounds.h, seg_radius, seg_radius, seg_radius, seg_radius ]
            cv.paint[ ]
            cv.rounded[ 0.0, 0.0, 0.0, 0.0 ]
        for [ i: i32 0, i < n, i += 1 ]
            x  : f32 [ seg_x[ i ] ]
            if [ x + seg_w <= 0.0 ] continue
            tl : f32 [ (i == 0)     ? seg_radius : 0.0 ]
            bl : f32 [ (i == 0)     ? seg_radius : 0.0 ]
            tr : f32 [ (i == n - 1) ? seg_radius : 0.0 ]
            br : f32 [ (i == n - 1) ? seg_radius : 0.0 ]
            # near-clear at rest, NO glow — only hover/lit draw a glow, so
            # nothing lingers when the cursor leaves
            fcol : rgba [ '#ffffff0c' ]
            gc   : rgba [ '#0000' ]
            gpx  : f32  [ 0.0 ]
            off  : bool [ disable || ((disable_mask & (1 << i)) != 0) ]
            # hover brightens first, at half strength...
            if [ i == hover_ix && !off ]
                fcol = rgba [ '#ffffff1c' ]
                gc   = rgba [ '#fcc3' ]
                gpx  = 18.0
            # ...then the toggled state always brightens over it
            lit : bool [ (sel_mask != 0) ? ((sel_mask & (1 << i)) != 0) : (i == selected) ]
            if [ lit && !off ]
                fcol = theme_rgba[ '#826' ]
                gc   = rgba [ '#fcc6' ]
                gpx  = 18.0
            gl : f32 [ (i == 0)     ? gpx : 0.0 ]
            gr : f32 [ (i == n - 1) ? gpx : 0.0 ]
            # a collapsing strip has its ground already: a segment paints
            # only its hover or lit state, and only once fully revealed
            seg_bg : bool [ !collapse || (rv9 >= 0.999 && gpx > 0.0) ]
            if [ seg_bg ]
                cv.fill_color[ fcol ]
                # radius FIRST: the glow follows the corners only if it knows them
                cv.rounded[ tl, tr, br, bl ]
                # a segment owning BOTH ends takes the uniform path, the one
                # the css layers use — sides pin the glow and lose the corners
                if [ gl > 0.0 && gr > 0.0 ] cv.inner_glow[ gc, gpx ]
                el                          cv.inner_glow_sides[ gc, gpx, gr, gpx, gl ]
                cv.rounded_rect[ x, 0.0, seg_w, bounds.h, tl, tr, br, bl ]
                cv.paint[ ]
                cv.inner_glow_sides[ rgba [ '#0000' ], 0.0, 0.0, 0.0, 0.0 ]
                # both are STATE: leaving the radius set clips the icon after it
                cv.rounded[ 0.0, 0.0, 0.0, 0.0 ]
            icon : string [ (icon_ids && i < icon_ids.count) ? icon_ids[i] : buttons[i] ]
            svg  : SVGModel (icons) ? seg_svg[ icon ] : null
            # the icons fade in with the reveal; a disabled one stays dim
            cv.set_opacity[ op0 * ((off) ? 0.35 : 1.0) * rv9 ]
            if [ svg ]
                isz : f32 [ bounds.h * ((icon_scale > 0.0) ? icon_scale : 0.55) ]
                ix  : f32 [ x + (seg_w - isz) * 0.5 ]
                iy  : f32 [ (bounds.h - isz) * 0.5 ]
                cv.fill_color[ rgba [ '#fff' ] ]
                cv.draw_svg[ svg, ix, iy, isz, isz ]
            el
                cv.font_size[ (label_px > 0.0) ? label_px : bounds.h * 0.5 ]
                cv.fill_color[ rgba [ '#fff' ] ]
                cv.draw_text[ buttons[ i ], rect [ x: x, y: 0.0, w: seg_w, h: bounds.h ],
                    vec2f [ 0.5, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]
            cv.set_opacity[ op0 ]
        # the rest icon sits in the last slot and fades as the set reveals
        if [ collapse && rv9 < 1.0 ]
            rsvg : SVGModel seg_svg[ rest_icon ]
            if [ rsvg ]
                rsz : f32 [ bounds.h * ((icon_scale > 0.0) ? icon_scale : 0.55) ]
                cv.set_opacity[ op0 * (1.0 - rv9) ]
                cv.fill_color[ rgba [ '#fff' ] ]
                cv.draw_svg[ rsvg, bounds.w - seg_w + (seg_w - rsz) * 0.5, (bounds.h - rsz) * 0.5, rsz, rsz ]
                cv.set_opacity[ op0 ]
        # one semi-clear 1px outline around the whole group; no segment
        # notches. origin is grid-snapped above; round the size too so both
        # edges land on whole device pixels. stroke_sides drives coverage
        dw9  : f32 [ round[ bounds.w * sc9 ] / sc9 ]
        dh9  : f32 [ round[ bounds.h * sc9 ] / sc9 ]
        cv.fill_color[ rgba [ '#0000' ] ]
        cv.set_stroke_size[ 0.5 ]
        cv.stroke_sides[ 0.5, 0.5, 0.5, 0.5 ]
        cv.stroke_color[ rgba [ '#ffffff33' ] ]
        cv.rounded_rect[ 0.0, 0.0, dw9, dh9, seg_radius, seg_radius, seg_radius, seg_radius ]
        cv.paint[ ]
        cv.set_stroke_size[ 0.0 ]
        cv.stroke_sides[ 0.0, 0.0, 0.0, 0.0 ]
        cv.restore[ ]

    func on_press [ ev: Event ]
        i : i32 [ seg_at[ ev ] ]
        if [ i < 0 ] return
        if [ disable || (disable_mask & (1 << i)) != 0 ] return
        if [ !manual ] selected = i
        if [ !strip_id ] strip_id = a.id
        a.id = buttons[ i ]
        pristine = false
        if [ ux && ux.stats ] log 'TBUTTONS press seg={i} id={buttons[ i ]}'

    func on_move [ ev: Event ]
        if [ strip_id && a.id != strip_id ] a.id = strip_id
        was : i32 [ hover_ix ]
        hover_ix = seg_at[ ev ]
        if [ hover_ix >= 0 && (disable || (disable_mask & (1 << hover_ix)) != 0) ]
            hover_ix = -1
        # the window's tooltip names the hovered segment: a new one redraws it
        if [ hover_ix != was ]
            pristine = false
            if [ ux ] ux.restyle = true

element Splitter
    public inner       : map element [ string ]
    public vertical   : bool
    public line_color : rgba [ '#222' ]     # the 1px divider line
    public bar        : f32 [ 6.0 ]          # divider grab half-width px
    public gap        : f32 [ 1.0 ]          # panes sit flush; the line IS the gap
    public inset      : f32 [ 0.0 ]          # leading inset (units) for each child
    public deflt      : f32 [ 320.0 ]        # unsaved-size fallback; 0 = even share
    public share      : f32                  # unsaved-size fallback as a fraction of the span
    public even       : bool                 # count change resets to even shares
    public min_size   : f32 [ 40.0 ]         # drag floor for a sized pane, px
    public snap_close : bool
    intern drag_ix    : i32
    intern last_n     : i32
    intern dseam      : vec f32              # divider px positions, hit-test + draw
    # the seam as one number: the line is an overlay, so when it moves the
    # pixel it used to sit on belongs to a child that must repaint to erase
    # it. without this the old line stays and the seam reads two px wide
    intern dseam_sig  : f32 [ -1.0 ]
    intern cursor_on  : bool                 # WE set the resize cursor; restore it
    intern dbgf       : i32                  # count-change debug frames left

    func order [] -> vec string
        ids : vec string []
        if [ inner ]
            for [ ce: element, id: string ] in inner
                ids.push[ id ]
        return ids

    # extent lives on the MOUNTED child; inner is rebuilt each frame
    func kid [ id: string ] -> element
        if [ !id ] return null
        if [ elements ]
            m : element elements[ id ]
            if [ m ] return m
        if [ !inner ] return null
        return inner[ id ]

    # extent > 0 sized, == 0 unset, < 0 snapped closed
    func target_of [ ch: element, span: f32, n: i32 ] -> f32
        if [ ch ]
            v : f32 [ ch.extent ]
            if [ v > 0.0 ] return (v < min_size) ? min_size : v
            if [ v < 0.0 && snap_close ] return 0.0
        if [ deflt > 0.0 ] return deflt
        if [ share > 0.0 ] return span * share
        return (span - f32[ n - 1 ] * gap) / f32[ n ]

    func shown_of [ ch: element, span: f32, n: i32 ] -> f32
        if [ ch && ch.extent_shown > 0.0 ] return ch.extent_shown
        t : f32 [ target_of[ ch, span, n ] ]
        if [ ch ] ch.extent_shown = t
        return t

    func render [] -> Elements
        if [ !inner ] return null
        ids : order[]
        n   : i32 [ ids.count ]
        if [ n == 0 ] return null
        if [ n != last_n ]
            last_n = n
            for [ ri: i32 0, ri < n, ri += 1 ]
                ce : element kid[ ids[ ri ] ]
                if [ !ce ] continue
                if [ even ] ce.extent = 0.0
                ce.extent_shown = 0.0
            dbgf  = 20
        span : f32 [ (bounds) ? ((vertical) ? bounds.h : bounds.w) : 1200.0 ]
        flex : f32 [ span - f32[ n - 1 ] * gap ]
        for [ i: i32 1, i < n, i += 1 ]
            flex -= shown_of[ kid[ ids[ i ] ], span, n ]
        if [ flex < 60.0 ] flex = 60.0
        ti   : string [ (inset > 0.0) ? '{inset}' : '0' ]
        out  : Elements [ ]
        dseam = vec f32 []
        pos : f32 [ 0.0 ]
        for [ i: i32 0, i < n, i += 1 ]
            ch : element inner[ ids[ i ] ]
            w  : f32 [ (i == 0) ? flex : shown_of[ kid[ ids[ i ] ], span, n ] ]
            # whole-pixel pane edges. a fractional edge on a translucent
            # background feathers into the gap and reads as a second line
            a0 : f32 [ round[ pos ] ]
            a1 : f32 [ round[ pos + w ] ]
            if [ vertical ]
                ch.area = Region [ 'l0 t{a0}px r0 t{a1}px' ]
            el
                ch.area = Region [ 'l{a0}px t{ti} l{a1}px b0' ]
            if [ dbgf > 0 ]
                bx : f32 [ (ch.bounds) ? ch.bounds.x : -1.0 ]
                bw : f32 [ (ch.bounds) ? ch.bounds.w : -1.0 ]
                sdbg : handle [ fopen[ "/tmp/spl.txt", "a" ] ]
                if [ sdbg ]
                    fputs[ 'SPL {id} n={n} i={i} kid={ids[i]} a0={a0} a1={a1} prev_bx={bx} prev_bw={bw}\n', sdbg ]
                    fclose[ sdbg ]
            out[ ids[ i ] ] = ch
            pos += w
            if [ i < n - 1 ]
                # the gap IS the line: it starts where the pane really ended
                mid : f32 [ round[ pos ] + gap * 0.5 ]
                dseam.push[ mid ]
                h0 : f32 [ mid - bar ]
                h1 : f32 [ mid + bar ]
                hd : element [ topmost: true ]
                if [ vertical ]
                    hd.area = Region [ 'l0 t{h0}px r0 t{h1}px' ]
                el
                    hd.area = Region [ 'l{h0}px t0 l{h1}px b0' ]
                out[ 'dv{i}' ] = hd
                pos += gap
        if [ dbgf > 0 ] dbgf -= 1
        sig9 : f32 [ f32[ dseam.count ] ]
        for [ di9: i32 0, di9 < dseam.count, di9 += 1 ]
            sig9 = sig9 * 7.0 + dseam[ di9 ]
        if [ sig9 != dseam_sig ]
            dseam_sig = sig9
            pristine  = false
            for [ ce9: element, ck9: string ] in out
                if [ ce9 ] ce9.pristine = false
        return out

    public func tick [ w: Window ]
        if [ !bounds ] return
        ids : order[]
        n   : i32 [ ids.count ]
        if [ n == 0 ] return
        span   : f32 [ (vertical) ? bounds.h : bounds.w ]
        moving : bool [ false ]
        for [ i: i32 1, i < n, i += 1 ]
            ch : element kid[ ids[ i ] ]
            if [ !ch ] continue
            t : f32 [ target_of[ ch, span, n ] ]
            v : f32 [ shown_of[ ch, span, n ] ]
            d : f32 [ t - v ]
            if [ d != 0.0 ]
                if [ i != drag_ix || (d < 0.5 && d > -0.5) ]
                    v = t
                el
                    v = filter_n[ v, t, 0.28, ux.frame_factor ]
                    moving = true
                ch.extent_shown = v
        if [ moving ]
            pristine        = false
            ux.will_animate = true

    # NOTHING is painted in the seam: the gap between panes is a window onto
    # whatever sits behind them, the backdrop scene included. a line here
    # covered it, and a stale one left the seam reading two px wide

    func on_press [ ev: Event ]
        if [ !bounds || !dseam ] return
        ids : order[]
        at  : f32 [ (vertical) ? ev.mouse.pos.y : ev.mouse.pos.x ]
        for [ di: i32 0, di < dseam.count, di += 1 ]
            d : f32 [ dseam[ di ] ]
            if [ at >= d - bar && at <= d + bar ]
                if [ di + 1 < ids.count ] drag_ix = di + 1
                ux.set_capture[ a ]
                ev.no_default   = true
                ev.no_propagation = true
                return

    func on_move [ ev: Event ]
        if [ !bounds ] return
        hat  : f32 [ (vertical) ? ev.mouse.pos.y : ev.mouse.pos.x ]
        seam_near : bool [ drag_ix > 0 ]
        if [ !seam_near && dseam ]
            for [ di: i32 0, di < dseam.count, di += 1 ]
                d : f32 [ dseam[ di ] ]
                if [ hat >= d - bar && hat <= d + bar ] seam_near = true
        if [ seam_near ]
            ux.seam_cursor[ (vertical) ? 2 : 1 ]
            cursor_on = true
        el [ cursor_on ]
            ux.seam_cursor[ 0 ]
            cursor_on = false
        if [ drag_ix <= 0 ] return
        ids  : order[]
        n    : i32 [ ids.count ]
        if [ drag_ix >= n ] drag_ix = n - 1
        if [ drag_ix <= 0 ] return
        span : f32 [ (vertical) ? bounds.h : bounds.w ]
        at   : f32 [ (vertical) ? ev.mouse.pos.y : ev.mouse.pos.x ]
        after : f32 [ 0.0 ]
        for [ i: i32 1, i < n, i += 1 ]
            if [ i > drag_ix ] after += target_of[ kid[ ids[ i ] ], span, n ]
        gaps  : f32 [ f32[ n - 1 - drag_ix ] * gap ]
        trail : f32 [ span - after - gaps ]
        sz    : f32 [ trail - at ]
        closed : bool [ false ]
        if [ sz < min_size ]
            closed = snap_close && sz < 20.0
            sz = (closed) ? 0.0 : min_size
        if [ sz > span - 60.0 ] sz = span - 60.0
        dch : element kid[ ids[ drag_ix ] ]
        if [ dch ] dch.extent = (closed) ? -1.0 : sz
        pristine        = false
        ux.will_animate = true
        ev.no_default   = true

    func on_release [ ev: Event ]
        if [ drag_ix > 0 ] ux.release_capture[ a ]
        drag_ix = 0

    func on_leave [ ev: Event ]
        if [ drag_ix <= 0 && cursor_on ]
            ux.seam_cursor[ 0 ]
            cursor_on = false

element Control
    focusable : true
    func render[] -> Elements
        return null

Control Button
    # no canvas of its own: it paints onto its parent's, when it changes
    no_cache : true
    public icon  : string
    iconl : Layer [ image_align: Align [ x: XAlign.middle, y: YAlign.middle ], image_scale: 1.7 ]
    intern icon_cur : string
    public  icon_fit : f32
    public  icon_scale : f32 [ 1.7 ]

    func sync_icon []
        if [ icon_fit > 0.0 ] iconl.image_fit = icon_fit
        iconl.image_scale = icon_scale
        if [ !icon || icon.count == 0 ] return
        if [ icon_cur && icon_cur.compare[ icon ] == 0 ] return
        icon_cur = icon
        iconl.image_svg = SVGModel [ 'images/{icon}.svg' ]
        pristine    = false
        needs_frame = true
        if [ ux ] ux.will_animate = true

    func init []
        sync_icon[]

    func render[] -> Elements
        sync_icon[]
        return null

Button Check
    func on_click[ ev:Event ]
        selected = !selected
    
    func render[] -> Elements
        return null

Button Option
    public left_view  : bool
    public right_view : bool
    public toggle     : bool
    public manual_mode : bool
    func on_press[ ev:Event ]
        if [ manual_mode ] return
        if [ ev.mouse.pos.y != (0 ..< 48) ]
            return
        if [ selected && !toggle ]
            return
        new_state : bool [ !selected ]
        for [ e:element, id:string ] in parent.elements
            op : Option e
            if [ op ]
                op.selected = (new_state && a == e)
                op.pristine = false

    func render[] -> Elements
        return null

# utility: a horizontal 0..1 slider. click or drag anywhere on the track
Control VolumeSlider
    public value    : f32 [ 0.5 ]
    public pad_l    : f32              # px kept clear at the left for an embedded label
    public pad_r    : f32              # px kept clear at the right for a value label
    public stops    : i32             # >1 snaps to that many discrete positions (enum)
    public value_text : string        # drawn right-aligned in pad_r (the enum's level)
    public changed  : bool             # set when the user moves it; the owner clears it
    intern dragging : bool
    intern vol_inset : f32 [ 7.0 ]     # track inset = widest knob radius

    func set_from_x [ x: f32 ]
        track : f32 [ bounds.w - vol_inset * 2.0 - pad_l - pad_r ]
        if [ track <= 0.0 ] return
        frac : f32 [ clamp[ (x - vol_inset - pad_l) / track, 0.0, 1.0 ] ]
        if [ stops > 1 ]
            step : i32 [ i32[ frac * f32[ stops - 1 ] + 0.5 ] ]
            frac = f32[ step ] / f32[ stops - 1 ]
        if [ frac == value ] return
        value    = frac
        changed  = true
        pristine = false
        if [ ux ] ux.will_animate = true

    public func on_press [ ev: Event ]
        dragging = true
        ux.set_capture[ a ]
        set_from_x[ ev.mouse.pos.x ]
        ev.no_default     = true
        ev.no_propagation = true

    public func on_move [ ev: Event ]
        if [ !dragging ] return
        set_from_x[ ev.mouse.pos.x ]
        ev.no_propagation = true

    public func on_release [ ev: Event ]
        dragging = false

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        if [ bounds.w <= 0.0 ] return
        cv : Canvas [ w.screen ]
        cv.stroke_width[ 0.0 ]
        # inset is CONSTANT (vol_inset) so the drawn knob and the hit math
        # agree; only the drawn radius grows on hover
        kr : f32 [ (hovered || dragging) ? 7.0 : 5.5 ]
        th : f32 [ 3.0 ]
        cy : f32 [ bounds.h * 0.5 ]
        ty : f32 [ cy - th * 0.5 ]
        x0 : f32 [ vol_inset + pad_l ]
        tw : f32 [ bounds.w - vol_inset * 2.0 - pad_l - pad_r ]
        if [ tw <= 0.0 ] return
        cv.fill_color[ '#ffffff33' ]
        cv.rounded_rect[ x0, ty, tw, th, th * 0.5, th * 0.5, th * 0.5, th * 0.5 ]
        cv.paint[]
        # enum stops: a notch at each position
        if [ stops > 1 ]
            cv.fill_color[ '#ffffff66' ]
            for [ si: i32 0, si < stops, si += 1 ]
                nx : f32 [ x0 + tw * f32[ si ] / f32[ stops - 1 ] ]
                cv.rounded_rect[ nx - 1.0, cy - 5.0, 2.0, 10.0, 1.0, 1.0, 1.0, 1.0 ]
                cv.paint[]
        fw : f32 [ tw * clamp[ value, 0.0, 1.0 ] ]
        if [ fw > 0.5 ]
            cv.fill_color[ '#ffffff' ]
            cv.rounded_rect[ x0, ty, fw, th, th * 0.5, th * 0.5, th * 0.5, th * 0.5 ]
            cv.paint[]
        kx : f32 [ x0 + fw - kr ]
        cv.fill_color[ '#ffffff' ]
        cv.rounded_rect[ kx, cy - kr, kr * 2.0, kr * 2.0, kr, kr, kr, kr ]
        cv.paint[]
        # the enum's current level, right of the track, in the reserved pad
        if [ value_text && value_text.count > 0 && pad_r > 0.0 ]
            cv.font_size[ 14.0 ]
            cv.fill_color[ '#e8e8ec' ]
            cv.draw_text[ value_text, rect [ x: bounds.w - pad_r, y: 0.0, w: pad_r - 6.0, h: bounds.h ],
                vec2f [ 1.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip, null ]

element Toolbar
    func render[] -> Elements
        return null

Control Tabs
    public  etype : Au_t
    public  value : i32
    mutable bound : @i32

    func member_value [ mem: Au_t ] -> i32
        pv : cast @i32 [ mem.value ]
        return pv[0]

    func on_press [ ev: Event ]
        e : cast element [ ev.origin ]
        if [ !e || !etype ] return
        for [ m: i32 0, m < etype.members.count, m += 1 ]
            mem : Au_t etype.members.origin[m]
            if [ mem.member_type != 10 ] continue          # AU_MEMBER_ENUMV
            nm : string mem.ident
            if [ nm == e.id ]
                value = member_value[ mem ]
                if [ bound ] bound[0] = value
                if [ ux ] ux.restyle = true
                ev.stop[]
                return

    func render [] -> Elements
        if [ !etype ] return null
        els : Elements [ ]
        for [ m: i32 0, m < etype.members.count, m += 1 ]
            mem : Au_t etype.members.origin[m]
            if [ mem.member_type != 10 ] continue          # AU_MEMBER_ENUMV
            nm : string mem.ident
            sel : bool [ member_value[ mem ] == value ]
            els[ nm ] = Option [ label: nm, manual_mode: true, selected: sel ]
        return els

Control Slider
    animated : true
    manual target : element   # points at an element, never owns it
    mutable mem    : Au_t
    mutable minv   : f32
    mutable maxv   : f32 [ 1.0 ]

    func read [] -> f32
        if [ value ] return f32[ value ]
        if [ target && mem ]
            pf : @f32 [ target.member_ref[ mem ] ]
            return pf[0]
        return 0.0

    func write [ lx: f32 ]
        hr : f32 [ bounds.h / 2.0 - 2.0 ]
        span : f32 [ bounds.w - 2.0 * hr ]
        t : f32 [ (span > 0.0) ? (lx - hr) / span : 0.0 ]
        if [ t < 0.0 ] t = 0.0
        if [ t > 1.0 ] t = 1.0
        v : f32 [ minv + t * (maxv - minv) ]
        value = v
        if [ target && mem ]
            pf : @f32 [ target.member_ref[ mem ] ]
            pf[0] = v
        pristine = false

    func on_press [ ev: Event ]
        write[ ev.mouse.pos.x ]
        ev.stop[]

    func on_move [ ev: Event ]
        if [ pressed ] write[ ev.mouse.pos.x ]

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !target || !mem ] return
        cv : Canvas w.screen
        v  : f32 [ read[] ]
        t  : f32 [ (maxv > minv) ? (v - minv) / (maxv - minv) : 0.0 ]
        cy : f32 [ bounds.h / 2.0 ]
        rr : f32 [ 2.5 ]
        hr : f32 [ bounds.h / 2.0 - 2.0 ]
        kx : f32 [ hr + t * (bounds.w - 2.0 * hr) ]
        cv.fill_color[ rgba[ '#ffffff20' ] ]
        cv.rounded_rect[ 0.0, cy - rr, bounds.w, rr * 2.0, rr, rr, rr, rr ]
        cv.paint[]
        cv.fill_color[ rgba[ '#3b6fe0' ] ]
        cv.rounded_rect[ 0.0, cy - rr, kx, rr * 2.0, rr, rr, rr, rr ]
        cv.paint[]
        # handle: a circle = rounded_rect at full (half-size) radius
        cv.fill_color[ rgba[ '#ffffff' ] ]
        cv.rounded_rect[ kx - hr, cy - hr, hr * 2.0, hr * 2.0, hr, hr, hr, hr ]
        cv.paint[]

Control ColorPicker
    animated : true
    manual target : element   # points at an element, never owns it
    mutable mem    : Au_t

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        col : rgba [ (value) ? rgba[ value ] : rgba[ '#000000' ] ]
        cv : Canvas w.screen
        if [ !selected ]
            # collapsed: a rounded swatch of the current color
            cv.fill_color[ col ]
            cv.rounded_rect[ 0.0, 0.0, bounds.w, bounds.h, 6.0, 6.0, 6.0, 6.0 ]
            cv.paint[]
            return
        cx : f32 [ bounds.w / 2.0 ]
        cy : f32 [ bounds.h / 2.0 ]
        rad : f32 [ ((bounds.w < bounds.h) ? bounds.w : bounds.h) / 2.0 - 6.0 ]
        g : Gradient conic_gradient[ cx, cy, 0.0 ]
        g.add_stop[ 0.0,     0xffff0000 ]
        g.add_stop[ 0.1667,  0xffffff00 ]
        g.add_stop[ 0.3333,  0xff00ff00 ]
        g.add_stop[ 0.5,     0xff00ffff ]
        g.add_stop[ 0.6667,  0xff0000ff ]
        g.add_stop[ 0.8333,  0xffff00ff ]
        g.add_stop[ 1.0,     0xffff0000 ]
        cv.set_fill_gradient[ g ]
        cv.rounded_rect[ cx - rad, cy - rad, rad * 2.0, rad * 2.0, rad, rad, rad, rad ]
        cv.paint[]
        cv.clear_fill_gradient[]
        # punch the center hole + show the current color there
        inr : f32 [ rad * 0.62 ]
        cv.fill_color[ col ]
        cv.rounded_rect[ cx - inr, cy - inr, inr * 2.0, inr * 2.0, inr, inr, inr, inr ]
        cv.paint[]

Option Edit
    func on_press[ ev:Event ] return
    func render[] -> Elements
        return null

Option UXMenuButton
    area    : Region { r0.22+ t0.22 w1.0 h1.0 }
    public wait_state : bool
    public live_state : bool
    outline : Layer [ radius: Radius [ '8' ], stroke_width: 0.0,
        stroke_color: rgba [ '#0000' ], fill_color: rgba [ '#0000' ] ]
    hover   : Layer [ states: State.hovered, radius: Radius [ '8' ],
        stroke_width: 0.5, stroke_color: rgba [ '#ffff' ], fill_color: rgba [ '#ffffff14' ] ]
    active  : Layer [ states: State.selected, radius: Radius [ '8' ],
        stroke_width: 0.5, stroke_color: rgba [ '#ffff' ], fill_color: rgba [ '#0000' ] ]

    func render [] -> Elements
        sync_icon[]
        if [ selected ]
            iconl.image_color = rgba [ '#c8641e' ]
        el [ hovered ]
            iconl.image_color = rgba [ '#ffffff' ]
        el
            iconl.image_color = rgba [ '#ffffff80' ]
        if [ live_state ]
            outline.stroke_width = 1.0
            outline.stroke_color = rgba [ '#3b6fe0' ]
        el [ wait_state ]
            outline.stroke_width = 1.0
            outline.stroke_color = rgba [ '#e08a1e' ]
        el
            outline.stroke_width = 0.0
            outline.stroke_color = rgba [ '#0000' ]
        return null

