ifdef [ apple ]
    import <AudioToolbox/AudioToolbox.h>
        -framework AudioToolbox

    func aq_output_done [ user: handle, q: AudioQueueRef, b: AudioQueueBufferRef ] -> none
        c : @u64 [ user ]
        c[0] += 1

    class AudioOut
        public sample_rate : i32 [ 48000 ]
        public channels    : i32 [ 2 ]
        public buffer_size : sz  [ 1024 ]
        public device      : string
        public active      : bool
        public buffer      : @i16
        intern queue       : AudioQueueRef
        intern aq_bufs     : @AudioQueueBufferRef
        intern freed       : @u64           # callback-owned counter
        intern used        : u64               # write-side counter
        intern next        : i32               # round-robin buffer index

        func open [] -> bool
            bytes  : i32 [ buffer_size * channels * 2 ]
            buffer = calloc[ 1, bytes ]
            freed  = calloc[ 1, 8 ]
            aq_bufs = calloc[ 4, 8 ]
            fmt : AudioStreamBasicDescription
            memset[ @fmt, 0, sizeof[ AudioStreamBasicDescription ] ]
            fmt.mSampleRate       = sample_rate
            fmt.mFormatID         = kAudioFormatLinearPCM
            fmt.mFormatFlags      = kLinearPCMFormatFlagIsSignedInteger | kLinearPCMFormatFlagIsPacked
            fmt.mBytesPerPacket   = channels * 2
            fmt.mFramesPerPacket  = 1
            fmt.mBytesPerFrame    = channels * 2
            fmt.mChannelsPerFrame = channels
            fmt.mBitsPerChannel   = 16
            err : i32 [ AudioQueueNewOutput[ @fmt, @aq_output_done, freed, null, null, 0, @queue ] ]
            if [ err != 0 ] return false
            for [ i: i32 0, i < 4, i += 1 ]
                b : AudioQueueBufferRef
                AudioQueueAllocateBuffer[ queue, bytes, @b ]
                memset[ b.mAudioData, 0, bytes ]
                b.mAudioDataByteSize = bytes
                AudioQueueEnqueueBuffer[ queue, b, 0, null ]
                aq_bufs[ i ] = b
            used = 4
            serr : i32 [ AudioQueueStart[ queue, null ] ]
            if [ serr != 0 ] return false
            active = true
            return true

        func write [ frames: i32 ] -> none
            if [ ! active ] return
            for [ used - freed[0] >= 4 ]
                usleep[ 500 ]
            b     : AudioQueueBufferRef [ aq_bufs[ next ] ]
            bytes : i32 [ frames * channels * 2 ]
            memcpy[ b.mAudioData, buffer, bytes ]
            b.mAudioDataByteSize = bytes
            AudioQueueEnqueueBuffer[ queue, b, 0, null ]
            used += 1
            next  = ( next + 1 ) % 4

        func close []
            if [ ! active ] return
            AudioQueueStop   [ queue, 1 ]
            AudioQueueDispose[ queue, 1 ]
            active = false
el [ windows ]
    # spectra.cc keeps the COM on its side; these are its plain entries
    intern func wasapi_cap_open  [ cstr, i32, i32, i32 ] -> handle
    intern func wasapi_cap_read  [ handle, @i16, i32 ] -> i32
    intern func wasapi_cap_reset [ handle ] -> none
    intern func wasapi_cap_close [ handle ] -> none
    intern func wasapi_out_open  [ cstr, i32, i32, i32 ] -> handle
    intern func wasapi_out_write [ handle, @i16, i32 ] -> i32
    intern func wasapi_out_close [ handle ] -> none

    class spectra
        public size:        i32
        public sample_rate: i32
        public channels:    i32
        public device:      cstr
        public pcm:         handle
        public re:          @f32
        public im:          @f32
        public buf:         @i16
        public bins:        @f32

        func init []
            channels = 1
            re   = new f32 [ size ]
            im   = new f32 [ size ]
            buf  = new i16 [ size ]
            bins = new f32 [ size / 2 ]

        func open [] -> bool
            pcm = wasapi_cap_open [ device, sample_rate, channels, size ]
            if [ !pcm ]
                puts 'spectra: no capture endpoint'
                return false
            return true

        func capture [] -> bool
            frames: i32 [ wasapi_cap_read [ pcm, buf, size ] ]
            if [ frames < 0 ] return false

            for [ i: i32 0, i < size, i += 1 ]
                re[i] = buf[i] / 32768.0
                im[i] = 0.0

            fft [ re, im, size ]
            half2: i32 [ size / 2 ]
            for [ i: i32 0, i < half2, i += 1 ]
                bins[i] = sqrt [ re[i] * re[i] + im[i] * im[i] ]
            return true

        func drain []
            if [ !pcm ] return
            wasapi_cap_reset [ pcm ]

        func close []
            if [ !pcm ] return
            wasapi_cap_close [ pcm ]
            pcm = null

    class AudioOut
        public sample_rate : i32 [ 48000 ]
        public channels    : i32 [ 2 ]
        public buffer_size : sz  [ 1024 ]
        public device      : string
        public active      : bool
        public buffer      : @i16
        public pcm_handle  : handle
        intern shorts      : i64
        intern writes      : i64

        func open [] -> bool
            buffer = calloc[ 1, buffer_size * channels * 2 ]
            pcm_handle = wasapi_out_open[ null, sample_rate, channels, i32[ buffer_size ] ]
            active = pcm_handle != null
            return active

        func write [ frames: i32 ] -> none
            if [ ! pcm_handle ] return
            wr : i32 [ wasapi_out_write[ pcm_handle, buffer, frames ] ]
            # a short write drops the remainder; count it like the alsa path
            if [ wr < frames ]
                shorts += 1
            writes += 1

        func close []
            if [ pcm_handle ] wasapi_out_close[ pcm_handle ]
            pcm_handle = null
            active = false

el [ android ]
    import <aaudio/AAudio.h>
        -laaudio

    # no capture path on android yet
    class spectra
        public size:        i32
        public sample_rate: i32
        public channels:    i32
        public device:      cstr
        public re:          @f32
        public im:          @f32
        public buf:         @i16
        public bins:        @f32

        func init []
            channels = 1
            re   = new f32 [ size ]
            im   = new f32 [ size ]
            buf  = new i16 [ size ]
            bins = new f32 [ size / 2 ]

        func open [] -> bool
            return false

        func capture [] -> bool
            return false

        func drain []
            return

        func close []
            return

    class AudioOut
        public sample_rate : i32 [ 48000 ]
        public channels    : i32 [ 2 ]
        public buffer_size : sz  [ 1024 ]
        public device      : string
        public active      : bool
        public buffer      : @i16
        intern stream      : @AAudioStream
        intern writes      : i64

        func open [] -> bool
            buffer = calloc[ 1, buffer_size * channels * 2 ]
            b : @AAudioStreamBuilder [ null ]
            if [ AAudio_createStreamBuilder[ @b ] != AAUDIO_OK ] return false
            AAudioStreamBuilder_setDirection      [ b, AAUDIO_DIRECTION_OUTPUT ]
            AAudioStreamBuilder_setSampleRate     [ b, sample_rate ]
            AAudioStreamBuilder_setChannelCount   [ b, channels ]
            AAudioStreamBuilder_setFormat         [ b, AAUDIO_FORMAT_PCM_I16 ]
            AAudioStreamBuilder_setPerformanceMode[ b, AAUDIO_PERFORMANCE_MODE_LOW_LATENCY ]
            ok : bool [ AAudioStreamBuilder_openStream[ b, @stream ] == AAUDIO_OK ]
            AAudioStreamBuilder_delete[ b ]
            if [ !ok ] return false
            got : i32 [ AAudioStream_getSampleRate[ stream ] ]
            printf[ "AudioOut: asked %d Hz -> got %d Hz (aaudio)\n", sample_rate, got ]
            if [ AAudioStream_requestStart[ stream ] != AAUDIO_OK ]
                AAudioStream_close[ stream ]
                stream = null
                return false
            active = true
            return true

        func write [ frames: i32 ] -> none
            if [ !stream ] return
            AAudioStream_write[ stream, buffer, frames, 1000000000 ]
            writes += 1

        func close []
            if [ stream ]
                AAudioStream_requestStop[ stream ]
                AAudioStream_close[ stream ]
            stream = null
            active = false

el
    import <alsa/asoundlib.h>
        -lasound

    class spectra
        public size:        i32
        public sample_rate: i32
        public channels:    i32
        public device:      cstr
        public pcm:         @snd_pcm_t
        public re:          @f32
        public im:          @f32
        public buf:         @i16
        public bins:        @f32

        func init []
            channels = 1
            re   = new f32 [ size ]
            im   = new f32 [ size ]
            buf  = new i16 [ size ]
            bins = new f32 [ size / 2 ]

        func open [] -> bool
            rc: snd_pcm_open [ @pcm, device, SND_PCM_STREAM_CAPTURE, 0 ]
            if [ rc < 0 ]
                printf [ "cannot open: %s\n", snd_strerror [ rc ] ]
                return false
            params2: @snd_pcm_hw_params_t
            snd_pcm_hw_params_malloc       [ @params2 ]
            snd_pcm_hw_params_any          [ pcm, params2 ]
            snd_pcm_hw_params_set_access   [ pcm, params2, SND_PCM_ACCESS_RW_INTERLEAVED ]
            snd_pcm_hw_params_set_format   [ pcm, params2, SND_PCM_FORMAT_S16_LE ]
            snd_pcm_hw_params_set_channels [ pcm, params2, channels ]

            rate:           u32 [ sample_rate ]
            dir2:           i32 [ 0 ]
            snd_pcm_hw_params_set_rate_near        [ pcm, params2, @rate, @dir2 ]

            period_size:    i32 size
            dir_period:     i32 0
            snd_pcm_hw_params_set_period_size_near [ pcm, params2, @period_size, @dir_period ]
            rc = snd_pcm_hw_params [ pcm, params2 ]
            snd_pcm_hw_params_free [ params2 ]
            if [ rc < 0 ]
                printf [ "hw params failed: %s\n", snd_strerror [ rc ] ]
                return false
            return true

        func capture [] -> bool
            frames: i32 [ snd_pcm_readi [ pcm, buf, size ] ]

            if [ frames < 0 ]
                snd_pcm_prepare [ pcm ]
                return false

            for [ i: i32 0, i < size, i += 1 ]
                re[i] = buf[i] / 32768.0
                im[i] = 0.0

            fft [ re, im, size ]
            half2: i32 [ size / 2 ]
            for [ i: i32 0, i < half2, i += 1 ]
                bins[i] = sqrt [ re[i] * re[i] + im[i] * im[i] ]
            return true

        func drain []
            if [ !pcm ] return
            snd_pcm_drop    [ pcm ]
            snd_pcm_prepare [ pcm ]
            snd_pcm_start   [ pcm ]

        func close []
            if [ !pcm ] return
            snd_pcm_close [ pcm ]
            pcm = null

    class AudioOut
        public sample_rate : i32 [ 48000 ]
        public channels    : i32 [ 2 ]
        public buffer_size : sz  [ 1024 ]
        public device      : string
        public active      : bool
        public buffer      : @i16
        public pcm_handle  : @snd_pcm_t
        intern xruns       : i64
        intern shorts      : i64
        intern writes      : i64

        func open [] -> bool
            buffer = calloc[ 1, buffer_size * channels * 2 ]
            pb  : i32 [ SND_PCM_STREAM_PLAYBACK ]
            dev : symbol [ (device && device.count) ? device.chars : 'pulse' ]
            err : i32 [ snd_pcm_open[ @pcm_handle, dev, pb, 0 ] ]
            if [ err < 0 ] return false
            psz    : snd_pcm_hw_params_sizeof[]
            params : @snd_pcm_hw_params_t [ calloc[ 1, psz ] ]
            snd_pcm_hw_params_any[ pcm_handle, params ]
            rw  : i32 [ SND_PCM_ACCESS_RW_INTERLEAVED ]
            fmt : i32 [ SND_PCM_FORMAT_S16_LE ]
            snd_pcm_hw_params_set_access  [ pcm_handle, params, rw ]
            snd_pcm_hw_params_set_format  [ pcm_handle, params, fmt ]
            snd_pcm_hw_params_set_channels[ pcm_handle, params, channels ]
            snd_pcm_hw_params_set_rate    [ pcm_handle, params, sample_rate, 0 ]
            bufsz : sz [ buffer_size * 2 ]
            persz : sz [ buffer_size / 4 ]
            snd_pcm_hw_params_set_buffer_size_near[ pcm_handle, params, @bufsz ]
            snd_pcm_hw_params_set_period_size_near[ pcm_handle, params, @persz, null ]
            ok : bool [ snd_pcm_hw_params[ pcm_handle, params ] >= 0 ]
            # what we ASKED for is not what we got. all three of these
            # are in/out and were being discarded, so a device that
            # refused 32kHz would silently be fed at the wrong rate
            arate : i32 [ 0 ]
            adir  : i32 [ 0 ]
            snd_pcm_hw_params_get_rate[ params, @arate, @adir ]
            printf[ "AudioOut: asked %d Hz buf %ld per %ld -> got %d Hz buf %ld per %ld\n",
                sample_rate, i64[ buffer_size * 2 ], i64[ buffer_size / 4 ],
                arate, i64[ bufsz ], i64[ persz ] ]
            free[ params ]
            if [ ok ]
                perr : i32 [ snd_pcm_prepare[ pcm_handle ] ]
                if [ perr < 0 ]
                    puts 'AudioOut: prepare failed {snd_strerror[ perr ]}'
                    ok = false
            active = ok
            return ok

        func write [ frames: i32 ] -> none
            if [ ! pcm_handle ] return
            wr : i64 [ snd_pcm_writei[ pcm_handle, buffer, frames ] ]
            if [ wr < 0 ]
                # every recover is an xrun, and an xrun is an audible click
                xruns += 1
                printf[ "AudioOut: xrun %ld (%s) after %ld writes\n",
                    xruns, snd_strerror[ i32[ wr ] ], writes ]
                snd_pcm_recover[ pcm_handle, wr, 0 ]
                snd_pcm_writei[ pcm_handle, buffer, frames ]
            el [ wr < i64[ frames ] ]
                # a SHORT write drops the remainder on the floor: the
                # positive return was being ignored entirely
                shorts += 1
                printf[ "AudioOut: short write %ld of %d (count %ld)\n", wr, frames, shorts ]
            writes += 1

        func close []
            if [ pcm_handle ]
                snd_pcm_drain[ pcm_handle ]
                snd_pcm_close[ pcm_handle ]
            pcm_handle = null
            active = false

# decoded PCM, interleaved S16
class AudioClip
    public rate     : i32
    public channels : i32
    public frames   : i64
    public pcm      : @i16

func be32 [ b: @u8, o: i32 ] -> i64
    return i64[ b[o] ] * 16777216 + i64[ b[o+1] ] * 65536 + i64[ b[o+2] ] * 256 + i64[ b[o+3] ]

func le32 [ b: @u8, o: i32 ] -> i64
    return i64[ b[o] ] + i64[ b[o+1] ] * 256 + i64[ b[o+2] ] * 65536 + i64[ b[o+3] ] * 16777216

func le16 [ b: @u8, o: i32 ] -> i32
    return i32[ b[o] ] + i32[ b[o+1] ] * 256

func be64 [ b: @u8, o: i32 ] -> i64
    hi : i64 [ be32[ b, o ] ]
    lo : i64 [ be32[ b, o + 4 ] ]
    return hi * 4294967296 + lo

# parsed AAC packet stream, container-agnostic
class AacStream
    public asc_o   : i32
    public asc_n   : i32
    public npkts   : i64
    public sizes   : @i32
    public offs    : @i32
    public priming : i32
    public nvalid  : i64

func box_find [ b: @u8, s: i32, e: i32, cc: i64 ] -> i32
    o : i32 [ s ]
    while [ o + 8 <= e ]
        bs : i64 [ be32[ b, o ] ]
        bt : i64 [ be32[ b, o + 4 ] ]
        if [ bt == cc ] return o
        if [ bs < 8 ] return -1
        adv : i32 [ i32[ bs ] ]
        o += adv
    return -1

func esds_asc [ b: @u8, s: i32, e: i32 ] -> i64
    q : i32 [ s ]
    while [ q < e ]
        tag : i32 [ i32[ b[ q ] ] ]
        q += 1
        ln : i32 [ 0 ]
        while [ true ]
            b9 : i32 [ i32[ b[ q ] ] ]
            q += 1
            ln = ln * 128 + (b9 & 127)
            if [ (b9 & 128) == 0 ] break
        if [ tag == 5 ]
            return i64[ q ] * 65536 + i64[ ln ]
        el [ tag == 3 ]
            q += 3
        el [ tag == 4 ]
            q += 13
        el
            q += ln
    return -1

# CAF: desc/kuki/pakt/data big-endian chunks
func caf_parse [ buf: @u8, fsz: i32 ] -> AacStream
    o      : i32 [ 8 ]
    kuki_o : i32 [ -1 ]
    kuki_n : i32 [ 0 ]
    pakt_o : i32 [ -1 ]
    data_o : i32 [ -1 ]
    while [ o + 12 <= fsz ]
        ct : i64 [ be32[ buf, o ] ]
        cs : i64 [ be64[ buf, o + 4 ] ]
        o += 12
        if [ ct == 1802659689 ]
            kuki_o = o
            kuki_n = i32[ cs ]
        el [ ct == 1885432180 ]
            pakt_o = o
        el [ ct == 1684108385 ]
            data_o = o + 4
        if [ cs < 0 ] break
        adv : i32 [ i32[ cs ] ]
        o += adv
    if [ kuki_o < 0 || pakt_o < 0 || data_o < 0 ] return null
    st : AacStream [ asc_o: kuki_o, asc_n: kuki_n ]
    if [ i32[ buf[ kuki_o ] ] == 3 ]
        pk : i64 [ esds_asc[ buf, kuki_o, kuki_o + kuki_n ] ]
        if [ pk < 0 ] return null
        st.asc_o = i32[ pk / 65536 ]
        st.asc_n = i32[ pk % 65536 ]
    st.npkts   = be64[ buf, pakt_o ]
    st.nvalid  = be64[ buf, pakt_o + 8 ]
    st.priming = i32[ be32[ buf, pakt_o + 16 ] ]
    np : i32 [ i32[ st.npkts ] ]
    st.sizes = new i32 [ np ]
    st.offs  = new i32 [ np ]
    po : i32 [ pakt_o + 24 ]
    doff : i32 [ data_o ]
    for [ k: i32 0, k < np, k += 1 ]
        psz : i32 [ 0 ]
        while [ true ]
            b9 : i32 [ i32[ buf[ po ] ] ]
            po += 1
            psz = psz * 128 + (b9 & 127)
            if [ (b9 & 128) == 0 ] break
        st.sizes[ k ] = psz
        st.offs[ k ]  = doff
        doff += psz
    return st

func m4a_parse [ buf: @u8, fsz: i32 ] -> AacStream
    moov : i32 [ box_find[ buf, 0, fsz, 1836019574 ] ]
    if [ moov < 0 ] return null
    me   : i32 [ moov + i32[ be32[ buf, moov ] ] ]
    trak : i32 [ box_find[ buf, moov + 8, me, 1953653099 ] ]
    if [ trak < 0 ] return null
    te   : i32 [ trak + i32[ be32[ buf, trak ] ] ]
    # elst media_time = encoder priming in media samples
    priming : i32 [ 2112 ]
    edts : i32 [ box_find[ buf, trak + 8, te, 1701082227 ] ]
    if [ edts >= 0 ]
        ee   : i32 [ edts + i32[ be32[ buf, edts ] ] ]
        elst : i32 [ box_find[ buf, edts + 8, ee, 1701606260 ] ]
        if [ elst >= 0 ]
            nent : i32 [ i32[ be32[ buf, elst + 12 ] ] ]
            if [ nent > 0 ]
                mt : i32 [ i32[ be32[ buf, elst + 20 ] ] ]
                if [ mt > 0 ] priming = mt
    mdia : i32 [ box_find[ buf, trak + 8, te, 1835297121 ] ]
    if [ mdia < 0 ] return null
    de   : i32 [ mdia + i32[ be32[ buf, mdia ] ] ]
    minf : i32 [ box_find[ buf, mdia + 8, de, 1835626086 ] ]
    if [ minf < 0 ] return null
    fe   : i32 [ minf + i32[ be32[ buf, minf ] ] ]
    stbl : i32 [ box_find[ buf, minf + 8, fe, 1937007212 ] ]
    if [ stbl < 0 ] return null
    se   : i32 [ stbl + i32[ be32[ buf, stbl ] ] ]
    stsd : i32 [ box_find[ buf, stbl + 8, se, 1937011556 ] ]
    stsz : i32 [ box_find[ buf, stbl + 8, se, 1937011578 ] ]
    stsc : i32 [ box_find[ buf, stbl + 8, se, 1937011555 ] ]
    stco : i32 [ box_find[ buf, stbl + 8, se, 1937007471 ] ]
    if [ stsd < 0 || stsz < 0 || stsc < 0 || stco < 0 ] return null
    entry : i32 [ stsd + 16 ]
    entry_e : i32 [ entry + i32[ be32[ buf, entry ] ] ]
    esds : i32 [ box_find[ buf, entry + 36, entry_e, 1702061171 ] ]
    if [ esds < 0 ] return null
    ese : i32 [ esds + i32[ be32[ buf, esds ] ] ]
    pk : i64 [ esds_asc[ buf, esds + 12, ese ] ]
    if [ pk < 0 ] return null
    st : AacStream [ asc_o: i32[ pk / 65536 ], asc_n: i32[ pk % 65536 ], priming: priming ]
    np : i32 [ i32[ be32[ buf, stsz + 16 ] ] ]
    fixed : i32 [ i32[ be32[ buf, stsz + 12 ] ] ]
    st.npkts = np
    st.sizes = new i32 [ np ]
    st.offs  = new i32 [ np ]
    for [ k: i32 0, k < np, k += 1 ]
        st.sizes[ k ] = (fixed > 0) ? fixed : i32[ be32[ buf, stsz + 20 + k * 4 ] ]
    nchunk : i32 [ i32[ be32[ buf, stco + 12 ] ] ]
    nsc    : i32 [ i32[ be32[ buf, stsc + 12 ] ] ]
    k2 : i32 [ 0 ]
    sci : i32 [ 0 ]
    for [ ci: i32 0, ci < nchunk, ci += 1 ]
        # advance the stsc run whose first_chunk covers this chunk
        while [ sci + 1 < nsc ]
            nfc : i32 [ i32[ be32[ buf, stsc + 16 + (sci + 1) * 12 ] ] ]
            if [ ci + 1 >= nfc ]
                sci += 1
            el
                break
        spc : i32 [ i32[ be32[ buf, stsc + 16 + sci * 12 + 4 ] ] ]
        coff : i32 [ i32[ be32[ buf, stco + 16 + ci * 4 ] ] ]
        for [ j: i32 0, j < spc, j += 1 ]
            if [ k2 >= np ] break
            st.offs[ k2 ] = coff
            coff += st.sizes[ k2 ]
            k2 += 1
    st.nvalid = 0
    return st

func wav_load [ p: path ] -> AudioClip
    fp : @FILE [ fopen[ '{p}', 'rb' ] ]
    if [ !fp ]
        puts 'wav: cannot open {p}'
        return null
    fseek[ fp, 0, SEEK_END ]
    fsz : i32 [ i32[ ftell[ fp ] ] ]
    fseek[ fp, 0, SEEK_SET ]
    buf : new u8 [ fsz ]
    fread[ buf, 1, fsz, fp ]
    fclose[ fp ]
    if [ fsz < 44 || be32[ buf, 0 ] != 1380533830 || be32[ buf, 8 ] != 1463899717 ]
        puts 'wav: not RIFF/WAVE: {p}'
        return null
    rate : i32 [ 0 ]
    ch : i32 [ 0 ]
    bits : i32 [ 0 ]
    doff : i32 [ 0 ]
    dsz : i32 [ 0 ]
    o : i32 [ 12 ]
    for [ o + 8 <= fsz ]
        cid : i64 [ be32[ buf, o ] ]
        csz : i32 [ i32[ le32[ buf, o + 4 ] ] ]
        if [ cid == 1718449184 ]
            ch   = le16[ buf, o + 10 ]
            rate = i32[ le32[ buf, o + 12 ] ]
            bits = le16[ buf, o + 22 ]
        if [ cid == 1684108385 ]
            doff = o + 8
            dsz = csz
        o += 8 + csz + (csz % 2)
    if [ rate < 1 || ch < 1 || bits != 16 || dsz < 2 ]
        puts 'wav: unsupported format in {p} (need PCM S16)'
        return null
    nfr : i64 [ i64[ dsz ] / i64[ ch * 2 ] ]
    cnt : i32 [ i32[ nfr ] * ch ]
    pcm : new i16 [ cnt ]
    memcpy[ pcm, @buf[ doff ], i64[ cnt ] * 2 ]
    clip : AudioClip [ rate: rate, channels: ch, frames: nfr ]
    pcm.hold[]
    clip.pcm = pcm
    return clip


# AAC in a CAF or M4A container via faad2; RIFF falls through to wav
func caf_load [ p: path ] -> AudioClip
    fp : @FILE [ fopen[ '{p}', 'rb' ] ]
    if [ !fp ]
        puts 'caf: cannot open {p}'
        return null
    fseek[ fp, 0, SEEK_END ]
    fsz : i32 [ ftell[ fp ] ]
    fseek[ fp, 0, SEEK_SET ]
    buf : new u8 [ fsz ]
    fread[ buf, 1, fsz, fp ]
    fclose[ fp ]
    st : AacStream [ null ]
    if [ be32[ buf, 0 ] == 1667327590 ]
        st = caf_parse[ buf, fsz ]
    el [ be32[ buf, 4 ] == 1718909296 ]
        st = m4a_parse[ buf, fsz ]
    if [ !st ]
        if [ be32[ buf, 0 ] == 1380533830 ]
            return wav_load[ p ]
        puts 'caf: unsupported container: {p}'
        return null
    h : NeAACDecOpen[]
    conf : NeAACDecGetCurrentConfiguration[ h ]
    conf.outputFormat = FAAD_FMT_16BIT
    NeAACDecSetConfiguration[ h, conf ]
    sr9 : u64 [ 0 ]
    ch9 : u8 [ 0 ]
    ir : i64 [ NeAACDecInit2[ h, @buf[ st.asc_o ], u64[ st.asc_n ], @sr9, @ch9 ] ]
    if [ ir != 0 ]
        puts 'caf: faad init failed on {p}'
        NeAACDecClose[ h ]
        return null
    ch : i32 [ ch9 ]
    rate : i32 [ sr9 ]
    cap : i64 [ (st.npkts + 2) * 2048 * ch ]
    pcm : new i16 [ cap ]
    wr : i64 [ 0 ]
    np : i32 [ st.npkts ]
    for [ k: i32 0, k < np, k += 1 ]
        info : NeAACDecFrameInfo
        doff : i32 [ st.offs[ k ] ]
        psz  : i32 [ st.sizes[ k ] ]
        smp : @i16 [ NeAACDecDecode[ h, @info, @buf[ doff ], psz ] ]
        if [ info.error != 0 || !smp ] continue
        if [ info.channels > 0 ] ch = info.channels
        ns : i64 [ info.samples ]
        if [ wr + ns > cap ] break
        nb : i64 [ ns * 2 ]
        memcpy[ @pcm[ wr ], smp, nb ]
        wr += ns
    NeAACDecClose[ h ]
    start : i64 [ st.priming * ch ]
    total : i64 [ wr - start ]
    if [ st.nvalid > 0 ]
        nv : i64 [ st.nvalid * ch ]
        if [ nv < total ] total = nv
    if [ total < 0 ] total = 0
    if [ start > 0 && total > 0 ]
        tb : i64 [ total * 2 ]
        memmove[ pcm, @pcm[ start ], tb ]
    clip : AudioClip [ rate: rate, channels: ch, frames: total / ch ]
    pcm.hold[]
    clip.pcm = pcm
    puts 'caf: {p} rate={rate} ch={ch} frames={clip.frames} cap={cap} wr={wr} start={start} nvalid={st.nvalid} npkts={st.npkts}'
    return clip

class Voice
    public clip   : AudioClip
    public pos    : f64
    public gain   : f32
    public pitch  : f32 [ 1.0 ]
    public loop   : bool
    public active : bool

class AudioMixer
    public sample_rate : i32 [ 44100 ]
    public out    : AudioOut
    intern voices : vec Voice
    intern acc    : @i32
    intern stop   : bool

    func start [] -> bool
        out = AudioOut [ sample_rate: sample_rate, channels: 2, buffer_size: 1024 ]
        if [ !out.open[] ]
            puts 'mixer: audio device unavailable'
            return false
        voices = vec Voice []
        voices.hold[]
        # fixed pool: the mix thread iterates this while play_p runs
        for [ i: i32 0, i < 16, i += 1 ]
            voices += Voice [ ]
        nacc : i32 [ out.buffer_size * 2 ]
        acc = new i32 [ nacc ]
        tid : local u64 [ 1 ]
        pthread_create[ tid, null, @mix_entry, a ]
        return true

    func play_p [ c: AudioClip, loop2: bool, gain2: f32, pitch2: f32 ]
        if [ !c || !out || !out.active ] return
        for [ v: Voice ] in voices
            if [ !v.active ]
                v.pos = 0.0
                v.clip = c
                v.gain = gain2
                v.pitch = pitch2
                v.loop = loop2
                v.active = true
                return
        nv : Voice [ clip: c, pos: 0.0, gain: gain2, pitch: pitch2, loop: loop2 ]
        voices += nv
        nv.active = true

    func play [ c: AudioClip, loop2: bool, gain2: f32 ]
        play_p[ c, loop2, gain2, 1.0 ]

    func set_gain [ c: AudioClip, gain2: f32 ]
        if [ !voices ] return
        for [ v: Voice ] in voices
            if [ v.active && v.clip == c ] v.gain = gain2

    func stop_clip [ c: AudioClip ]
        if [ !voices ] return
        for [ v: Voice ] in voices
            if [ v.clip == c ] v.active = false

    func mix_entry [] -> none
        n : i32 [ out.buffer_size ]
        n2 : i32 [ n * 2 ]
        while [ !stop ]
            for [ i: i32 0, i < n2, i += 1 ] acc[ i ] = 0
            for [ v: Voice ] in voices
                if [ !v.active ] continue
                c : v.clip
                if [ !c || !c.pcm || c.frames < 2 ] continue
                step : f64 [ f64[ c.rate ] / f64[ sample_rate ] * f64[ v.pitch ] ]
                ch : i32 [ c.channels ]
                for [ i: i32 0, i < n, i += 1 ]
                    lim : f64 [ f64[ c.frames - 1 ] ]
                    if [ v.pos >= lim ]
                        if [ v.loop ]
                            v.pos = 0.0
                        el
                            v.active = false
                            break
                    i0 : i64 [ i64[ v.pos ] ]
                    fr : f32 [ f32[ v.pos - f64[ i0 ] ] ]
                    b0 : i64 [ i0 * ch ]
                    b1 : i64 [ (i0 + 1) * ch ]
                    l0 : f32 [ f32[ c.pcm[ b0 ] ] ]
                    l1 : f32 [ f32[ c.pcm[ b1 ] ] ]
                    ls : f32 [ (l0 + (l1 - l0) * fr) * v.gain ]
                    rs : f32 [ ls ]
                    if [ ch > 1 ]
                        r0 : f32 [ f32[ c.pcm[ b0 + 1 ] ] ]
                        r1 : f32 [ f32[ c.pcm[ b1 + 1 ] ] ]
                        rs = (r0 + (r1 - r0) * fr) * v.gain
                    li : i32 [ i32[ ls ] ]
                    ri : i32 [ i32[ rs ] ]
                    acc[ i * 2 ] += li
                    acc[ i * 2 + 1 ] += ri
                    v.pos += step
            for [ i: i32 0, i < n2, i += 1 ]
                s5 : i32 [ acc[ i ] ]
                if [ s5 > 32767 ] s5 = 32767
                if [ s5 < -32768 ] s5 = -32768
                out.buffer[ i ] = i16[ s5 ]
            out.write[ n ]
        out.close[]

func fft [ re: @f32, im: @f32, n: i32 ]
    if [ n <= 1 ]
        return
    j : i32 [ 0 ]
    for [ i: i32 1, i < n, i += 1 ]
        m2 : i32 [ n / 2 ]
        for [ m2 >= 1 && j >= m2 ]
            j -= m2
            m2 = m2 / 2
        j += m2
        if [ i < j ]
            tr0 : f32 [ re[ i ] ]
            re[ i ] = re[ j ]
            re[ j ] = tr0
            ti0 : f32 [ im[ i ] ]
            im[ i ] = im[ j ]
            im[ j ] = ti0
    ln : i32 [ 2 ]
    for [ ln <= n ]
        ha : i32 [ ln / 2 ]
        ang0 : f32 [ -6.28318530718 / f32[ ln ] ]
        wr0 : f32 [ cos[ ang0 ] ]
        wi0 : f32 [ sin[ ang0 ] ]
        for [ s: i32 0, s < n, s += ln ]
            wr : f32 [ 1.0 ]
            wi : f32 [ 0.0 ]
            for [ k: i32 0, k < ha, k += 1 ]
                i0 : i32 [ s + k ]
                i1 : i32 [ s + k + ha ]
                tr : f32 [ wr * re[ i1 ] - wi * im[ i1 ] ]
                ti : f32 [ wi * re[ i1 ] + wr * im[ i1 ] ]
                re[ i1 ] = re[ i0 ] - tr
                im[ i1 ] = im[ i0 ] - ti
                re[ i0 ] = re[ i0 ] + tr
                im[ i0 ] = im[ i0 ] + ti
                wn : f32 [ wr * wr0 - wi * wi0 ]
                wi = wr * wi0 + wi * wr0
                wr = wn
        ln = ln * 2

func heat [ t0: f32 ] -> i32
    t : f32 [ t0 ]
    if [ t < 0.0 ] t = 0.0
    if [ t > 1.0 ] t = 1.0
    r0 : f32 [ 0.0 ]
    g0 : f32 [ 0.0 ]
    b0 : f32 [ 0.0 ]
    r1 : f32 [ 0.0 ]
    g1 : f32 [ 0.0 ]
    b1 : f32 [ 0.0 ]
    f : f32 [ 0.0 ]
    if [ t < 0.25 ]
        r1 = 22.0
        g1 = 24.0
        b1 = 96.0
        f = t * 4.0
    el [ t < 0.5 ]
        r0 = 22.0
        g0 = 24.0
        b0 = 96.0
        r1 = 128.0
        g1 = 32.0
        b1 = 142.0
        f = (t - 0.25) * 4.0
    el [ t < 0.75 ]
        r0 = 128.0
        g0 = 32.0
        b0 = 142.0
        r1 = 244.0
        g1 = 124.0
        b1 = 44.0
        f = (t - 0.5) * 4.0
    el
        r0 = 244.0
        g0 = 124.0
        b0 = 44.0
        r1 = 255.0
        g1 = 244.0
        b1 = 210.0
        f = (t - 0.75) * 4.0
    r : i32 [ i32[ r0 + (r1 - r0) * f ] ]
    g : i32 [ i32[ g0 + (g1 - g0) * f ] ]
    b : i32 [ i32[ b0 + (b1 - b0) * f ] ]
    return r * 65536 + g * 256 + b

func spectrograph [ c: AudioClip, out2: path, w2: i32, h2: i32, fmin: f32, fmax: f32, gray: bool, act: @f32 ] -> bool
    if [ !c || c.frames < 4096 ] return false
    n : i32 [ 2048 ]
    wn : i32 [ i32[ i64[ c.rate ] * 2048 / 48000 ] ]
    if [ wn > n ] wn = n
    if [ wn < 64 ] wn = 64
    mscale : f32 [ f32[ n ] / f32[ wn ] ]
    re : new f32 [ n ]
    im : new f32 [ n ]
    win : new f32 [ n ]
    for [ i: i32 0, i < wn, i += 1 ]
        ang : f32 [ 6.28318530718 * f32[ i ] / f32[ wn ] ]
        win[ i ] = 0.5 - 0.5 * cos[ ang ]
    nch5 : i32 [ (gray) ? 1 : 4 ]
    pfmt : Pixel [ (gray) ? Pixel.u8 : Pixel.rgba8 ]
    img2 : Image [ width: w2, height: h2, format: pfmt, channels: nch5 ]
    pd : @u8 [ img2.vdata[] ]
    ch : i32 [ c.channels ]
    gap : i32 [ (ch > 1) ? 2 : 0 ]
    band : i32 [ (h2 - gap * (ch - 1)) / ch ]
    span : i64 [ c.frames - i64[ n ] ]
    hop : i64 [ span / i64[ w2 ] ]
    if [ hop < 1 ] hop = 1
    nyq : f32 [ f32[ c.rate ] * 0.5 ]
    fx2 : f32 [ (fmax > nyq) ? nyq : fmax ]
    lr : f32 [ log[ fx2 / fmin ] ]
    # divider rows between channel bands
    for [ y: i32 0, y < h2, y += 1 ]
        for [ x: i32 0, x < w2, x += 1 ]
            if [ gray ]
                dg0 : i64 [ i64[ y ] * w2 + x ]
                pd[ dg0 ] = 0
            el
                di : i64 [ (i64[ y ] * w2 + x) * 4 ]
                pd[ di ]     = 0
                pd[ di + 1 ] = 0
                pd[ di + 2 ] = 0
                pd[ di + 3 ] = 255
    for [ x: i32 0, x < w2, x += 1 ]
        s0 : i64 [ i64[ x ] * hop ]
        for [ c2: i32 0, c2 < ch, c2 += 1 ]
            for [ i: i32 0, i < wn, i += 1 ]
                b9 : i64 [ (s0 + i64[ i ]) * ch + c2 ]
                re[ i ] = f32[ c.pcm[ b9 ] ] / 32768.0 * win[ i ]
                im[ i ] = 0.0
            for [ i: i32 wn, i < n, i += 1 ]
                re[ i ] = 0.0
                im[ i ] = 0.0
            fft[ re, im, n ]
            ytop : i32 [ c2 * (band + gap) ]
            for [ y: i32 0, y < band, y += 1 ]
                # log frequency: band bottom = 20Hz, top = 10kHz
                t : f32 [ f32[ band - 1 - y ] / f32[ band - 1 ] ]
                fq : f32 [ fmin * exp[ t * lr ] ]
                fb : f32 [ fq * f32[ n ] / f32[ c.rate ] ]
                bi : i32 [ i32[ fb ] ]
                fr : f32 [ fb - f32[ bi ] ]
                m0 : f32 [ sqrt[ re[ bi ] * re[ bi ] + im[ bi ] * im[ bi ] ] ]
                m1 : f32 [ sqrt[ re[ bi + 1 ] * re[ bi + 1 ] + im[ bi + 1 ] * im[ bi + 1 ] ] ]
                mag : f32 [ m0 + (m1 - m0) * fr ]
                amp : f32 [ mag * mscale / 512.0 ]
                db : f32 [ 8.6858896 * log[ amp + 0.0000000001 ] ]
                tv : f32 [ (db + 80.0) / 80.0 ]
                if [ tv < 0.0 ] tv = 0.0
                if [ tv > 1.0 ] tv = 1.0
                if [ act && c2 == 0 ]
                    act[ x ] += tv / f32[ band ]
                if [ gray ]
                    dg1 : i64 [ i64[ ytop + y ] * w2 + x ]
                    pd[ dg1 ] = u8[ tv * 255.0 ]
                el
                    rgb : i32 [ heat[ tv ] ]
                    di : i64 [ (i64[ ytop + y ] * w2 + x) * 4 ]
                    pd[ di ]     = u8[ rgb / 65536 ]
                    pd[ di + 1 ] = u8[ (rgb / 256) % 256 ]
                    pd[ di + 2 ] = u8[ rgb % 256 ]
                    pd[ di + 3 ] = 255
    img2.png[ out2 ]
    return true

