import trinity
import vec
import <stdio.h>
import <stdlib.h>
# wlroots and xcb are linux's; windows takes wayland-win.c, which
# answers every call with nothing
ifdef [ windows ]
    import <string.h>
ifndef [ windows ]
    import <pthread.h>
ifndef [ windows ]
    import <unistd.h>
        +_DEFAULT_SOURCE
ifndef [ windows ]
    import <string.h>
        -I=/usr/include/pixman-1
        -I/usr/include/pixman-1
        -I=/usr/include/libdrm
        -I/usr/include/libdrm
        -I{root_path}/wayland
        -lwlroots
        -lwayland-server
        -lxkbcommon
        -lxcb
        -lxcb-res
        +WLR_USE_UNSTABLE

# the compositor lives in wayland.c on wlroots; this is its surface
func wlc_create         [ w: i32, h: i32 ] -> i32
func wlc_socket         [] -> cstr
func wlc_x11_display    [] -> cstr
func wlc_pump           []
func wlc_resize         [ w: i32, h: i32 ]
func wlc_fullscreen     [ on: i32 ]
# the real monitor's size: programs see it as their screen
func wlc_screen         [ w: i32, h: i32, hz: i32 ]
# it has the whole screen (it asked for it)
func wlc_window_full    [ id: u64 ] -> i32
# the window that last asked into or out of fullscreen, once (0 none)
func wlc_window_full_asked [] -> u64
func wlc_window_count  [] -> i32
func wlc_window_at     [ i: i32 ] -> u64
func wlc_window_newest [] -> u64
# the window that last asked to come forward, once (0 none)
func wlc_window_asked  [] -> u64
# the window that last asked to be minimized, once (0 none)
func wlc_window_hide_asked [] -> u64
func wlc_window_open   [ id: u64 ] -> i32
func wlc_window_title  [ id: u64 ] -> cstr
func wlc_window_app    [ id: u64 ] -> cstr
func wlc_window_pid    [ id: u64 ] -> i32
func wlc_window_resize [ id: u64, w: i32, h: i32 ]
func wlc_window_focus  [ id: u64 ]
func wlc_window_close  [ id: u64 ]
# one that did not answer its close ends (its process, or X client)
func wlc_window_kill   [ id: u64 ]
# it draws its own header (neither decoration protocol took it)
func wlc_window_csd    [ id: u64 ] -> i32
# a dialog's window (its parent), else 0
func wlc_window_parent [ id: u64 ] -> u64
# counts the window's size changes
func wlc_window_epoch  [ id: u64 ] -> u64
# its own size (a dialog's frame has room past it)
func wlc_window_w      [ id: u64 ] -> i32
func wlc_window_drawn  [ id: u64 ] -> i32
func wlc_window_h      [ id: u64 ] -> i32
# its menu: 0 none, 1 dbusmenu, 2 GTK; then where it lives on D-Bus
func wlc_window_menu_kind [ id: u64 ] -> i32
func wlc_window_menu_bus  [ id: u64 ] -> cstr
func wlc_window_menu_path [ id: u64 ] -> cstr
func wlc_window_menu_app  [ id: u64 ] -> cstr
func wlc_window_menu_win  [ id: u64 ] -> cstr
func wlc_frame_id       [ id: u64 ] -> u64
func wlc_frame_gen      [ id: u64 ] -> u64
# a reader's hold on the current frame, its render waited, let go
func wlc_frame_take     [ id: u64 ] -> u64
func wlc_frame_ready    [ b: u64, ms: i32 ] -> i32
func wlc_frame_drop     [ b: u64 ]
func wlc_frame_w        [ id: u64 ] -> i32
func wlc_frame_h        [ id: u64 ] -> i32
func wlc_frame_format   [ id: u64 ] -> u32
func wlc_frame_modifier [ id: u64 ] -> u64
func wlc_frame_stride   [ id: u64 ] -> u32
func wlc_frame_offset   [ id: u64 ] -> u32
func wlc_frame_fd       [ id: u64 ] -> i32
func wlc_pointer_motion [ id: u64, x: f32, y: f32 ]
func wlc_pointer_button [ id: u64, x: f32, y: f32, button: i32,
                          state: i32 ]
func wlc_pointer_axis   [ dx: f32, dy: f32 ]
# the window whose pointer is held still (a game's mouse look), 0 none
func wlc_pointer_held   [] -> u64
# the mouse's raw motion to the window under the pointer
func wlc_pointer_relative [ dx: f32, dy: f32 ]
func wlc_key            [ glfw: i32, state: i32 ]
# the windows' keyboard: an xkb layout and variant ('' default)
func wlc_key_layout     [ layout: cstr, variant: cstr ]
func wlc_key_repeat     [ rate: i32, delay_ms: i32 ]
# the windows' scale: the text size, as their own dpi
func wlc_set_scale      [ sc: f64 ]
func wlc_keys_release   []
func wlc_spawn          [ cmd: cstr ] -> i32

# one window's imports for pictures of it: this size's, and the last
# size's kept one change longer (the GPU may still draw them)
class WinThumbs
    public epoch  : u64
    public frames : map Texture [string]
    public prev   : map Texture [string]

wl_thumbs : map WinThumbs [string]

# a window's frame as a texture for any picture of it (a card in the
# navigator), whatever pane shows it, or none
func window_texture [ cv: Canvas, id: u64 ] -> Texture
    # a frame arrives as a dma-buf, which only linux has. no guest
    # window ever appears here, so there is no frame to import
    ifndef [ windows ]
        fid : u64 [ wlc_frame_id[ id ] ]
        if [ fid == 0 ] return null
        if [ !wl_thumbs ] wl_thumbs = map WinThumbs [string] []
        wk : '{id}'
        if [ !wl_thumbs.contains[ wk ] ]
            wl_thumbs[ wk ] = WinThumbs [ frames: map Texture [string] [] ]
        wt : WinThumbs wl_thumbs[ wk ]
        ep : u64 [ wlc_window_epoch[ id ] ]
        if [ ep != wt.epoch ]
            wt.epoch  = ep
            wt.prev   = wt.frames
            wt.frames = map Texture [string] []
        key : '{fid}'
        if [ wt.frames.contains[ key ] ] return wt.frames[ key ]
        fw : i32 [ wlc_frame_w[ id ] ]
        fh : i32 [ wlc_frame_h[ id ] ]
        fd : i32 [ wlc_frame_fd[ id ] ]
        if [ fd < 0 || fw <= 0 || fh <= 0 ] return null
        t : Texture cv.vk.import_dmabuf_image[ fd, fw, fh,
            wlc_frame_format[ id ], wlc_frame_modifier[ id ],
            wlc_frame_stride[ id ], wlc_frame_offset[ id ], cv.w ]
        wt.frames[ key ] = t
        return t
    el
        return null

# a Wayland display as one silver app: it shows one window (the
# newest, or the one chosen); orbiter mounts WaylandView in its panes
element wayland : trinity
    public  width  : i32 [ 1280 ]
    public  height : i32 [ 800 ]
    # a client to start on the display, e.g. 'firefox' or 'foot'
    public [ Launch ] run : string
    # the window shown; 0: the newest
    public [ Live ] window : u64
    # pixels of the window's top kept out of the pane: the output is
    # made that much taller and drawn that much higher, so an app's own
    # header bar falls above the edge. 46 hides a GNOME header bar
    public [ Live ] crop_top : i32 [ 46 ]
    # the shell passes every app its gain; the element must own the
    # member or the argument parser prints usage and drops the rest
    public [ Live, VolumeRange ] volume : f32 [ 1.0 ]

    func render [] -> Elements
        return Elements [ 'view' : WaylandView [ run: run,
            window: window, crop_top: crop_top,
            area: Region { l0 t0 r0 b0 } ] ]

    # a live change (the socket's set) reaches the view at once
    public func tick [ w: Window ]
        if [ !elements || !elements.contains[ 'view' ] ] return
        v : cast WaylandView [ elements[ 'view' ] ]
        if [ v ]
            v.window   = window
            v.crop_top = crop_top

# one window of the display in a pane: its frames drawn, the pane's
# mouse and keys sent to it; the first view starts the compositor
element WaylandView
    # the compositor pumps from draw: every frame, never cache-skipped
    animated : true
    # a client to start on the display, once
    public run      : string
    # the window shown; 0: the newest
    public window   : u64
    public crop_top : i32
    mutable up       : bool
    mutable spawned  : bool
    # the imports, one per swapchain buffer the output cycles through
    mutable frames   : map Texture [string]
    mutable shown    : u64
    mutable last_w   : i32
    mutable last_h   : i32
    # the window this frame shows
    mutable win      : u64
    # the pane's size, and since when (ms): the window takes it once
    # the pane has held it a moment (a sliding panel resizes no app)
    mutable want_w   : i32
    mutable want_h   : i32
    # when the last size went to the window
    mutable sent_ms  : i64
    mutable sent_w   : i32
    mutable sent_h   : i32
    # the window's size changes seen: its buffers are new after one
    mutable epoch    : u64
    # the last size's imports, kept a few frames (the GPU may still
    # draw them), then let go
    mutable retired  : vec Texture
    mutable retire_n : i32
    # the last frame drawn: shown until the window has one at its
    # new size (a resize every frame never leaves it time)
    mutable last_t   : Texture
    # a dialog of the window: drawn over it at its own size, eased
    # down from the top (a sheet); while up it takes the pointer
    public sheet        : u64
    mutable sheet_on     : u64
    mutable sheet_at     : f32
    mutable sheet_frames : map Texture [string]
    mutable sheet_epoch  : u64
    mutable sheet_x      : f32
    mutable sheet_y      : f32
    mutable sheet_w      : f32
    mutable sheet_h      : f32
    # the mouse locked for the window's held pointer; let go by Esc
    # (held off until the next press in the pane)
    mutable held_lock    : bool
    mutable held_off     : bool
    # the window in fullscreen: shown on the real monitor in a window
    # of its own, its keys and mouse from there; closed there, it
    # stays off until the window asks again
    mutable screen       : ScreenOut
    mutable screen_off   : bool
    # on the screen, a thread of its own takes each new frame there:
    # the shell's frames never carry them
    mutable screen_cv    : Canvas
    mutable screen_gen   : u64
    mutable shown_w      : i32
    mutable shown_h      : i32
    mutable present_on   : bool
    # the frame the last copy read: held until the next copy, which
    # waits for it, has started
    mutable held_frame   : u64
    intern  present_tid  : pthread_t

    func ensure [ w: i32, h: i32 ]
        if [ up ] return
        if [ wlc_create[ w, h ] == 0 ]
            log 'wayland: the compositor did not start'
            return
        up = true
        log 'wayland: display {string[ wlc_socket[] ]} up at {w}x{h}'
        sr : rect screen_rect[]
        wlc_screen[ i32[ sr.w ], i32[ sr.h ], screen_hz[] ]

    # the output follows the pane's size
    func frame_out [ cv: Canvas, vp: rect ]
        w9 : i32 [ vp.w ]
        h9 : i32 [ i32[ vp.h ] + ((crop_top > 0) ? crop_top : 0) ]
        if [ w9 < 16 || h9 < 16 ] return
        ensure[ w9, h9 ]
        if [ !up ] return
        if [ w9 != last_w || h9 != last_h ]
            last_w = w9
            last_h = h9
            wlc_resize[ w9, h9 ]
        if [ !spawned && run && run.count > 0 ]
            spawned = true
            pid9 : i32 [ wlc_spawn[ run.chars ] ]
            log 'wayland: started {run} (pid {pid9})'
        wlc_pump[]
        wn : u64 [ (window > 0) ? window : wlc_window_newest[] ]
        if [ wn != win ]
            win     = wn
            sent_w  = 0
            sent_h  = 0
        if [ win == 0 ] return
        # on the screen: its own thread shows it, the shell pauses
        # until the window closes
        if [ screen_follow[ cv ] ]
            settle[ screen.width, screen.height ]
            present_start[ cv ]
            ux.pause_for = a
            return
        settle[ w9, h9 ]
        retire[]
        if [ !frames ] frames = map Texture [string] []
        t : Texture frame_of[ cv, win, frames ]
        if [ t ] last_t = t
        el t = last_t
        if [ !t ] return
        shown = wlc_frame_id[ win ]
        ct : f32 [ (crop_top > 0) ? f32[ crop_top ] : 0.0 ]
        # the cut header and anything past the pane stay off screen
        cv.save[]
        cv.clip_rect[ vp.x, vp.y, vp.w, vp.h, 0.0, 0.0 ]
        cv.draw_image[ t,
                       rect [ x: vp.x, y: vp.y - ct, w: f32[ t.width ],
                              h: f32[ t.height ] ] ]
        cv.restore[]
        draw_sheet[ cv, vp ]

    # the screen window opens as the window asks for fullscreen; it
    # stays until the window closes (on_frame); true while it shows
    func screen_follow [ cv: Canvas ] -> bool
        if [ screen ] return true
        full : bool [ wlc_window_full[ win ] != 0 ]
        if [ !full ] screen_off = false
        if [ full && !screen_off ]
            screen = ScreenOut [ vk: cv.vk, hidden: ux.hidden,
                title: string[ wlc_window_title[ win ] ] ]
            if [ !screen.win ]
                screen = null
                screen_off = true
                return false
            wlc_window_focus[ win ]
            log 'wayland: window {win} on the screen'
        return screen != null

    # the screen window's keys and mouse to the window: a held
    # pointer locks the mouse there and takes raw motion
    func screen_input [ tw: i32, th: i32 ]
        held : bool [ wlc_pointer_held[] == win ]
        screen.lock[ held ]
        k : f64 [ min[ f64[ screen.width ] / f64[ tw ],
                       f64[ screen.height ] / f64[ th ] ] ]
        ox : f64 [ (f64[ screen.width ] - f64[ tw ] * k) * 0.5 ]
        oy : f64 [ (f64[ screen.height ] - f64[ th ] * k) * 0.5 ]
        # read in place, then cleared: a list swapped out was freed
        for [ e: ScreenEvent ] in screen.events
            x : f32 [ (e.x - ox) / k ]
            y : f32 [ (e.y - oy) / k ]
            if [ e.kind == 1 ]
                wlc_key[ e.code, e.state ]
            el [ e.kind == 2 ]
                if [ held ]
                    wlc_pointer_button[ win, 0.0, 0.0, e.code, e.state ]
                el
                    wlc_pointer_button[ win, x, y, e.code, e.state ]
            el [ e.kind == 3 ]
                if [ held ]
                    wlc_pointer_relative[ f32[ e.dx ], f32[ e.dy ] ]
                el
                    wlc_pointer_motion[ win, x, y ]
            el [ e.kind == 4 ]
                wlc_pointer_axis[ f32[ e.dx ] * ux.window_wheel,
                                  f32[ e.dy ] * ux.window_wheel ]
        screen.events.clear[]

    # a window's current frame, imported once per buffer into got
    func frame_of [ cv: Canvas, id: u64, got: map Texture [string] ]
                  -> Texture
        # the import is linux's; no frame ever arrives here
        ifndef [ windows ]
            fid : u64 [ wlc_frame_id[ id ] ]
            if [ fid == 0 ] return null
            key : string '{fid}'
            if [ got.contains[ key ] ] return got[ key ]
            fw : i32 [ wlc_frame_w[ id ] ]
            fh : i32 [ wlc_frame_h[ id ] ]
            fd : i32 [ wlc_frame_fd[ id ] ]
            if [ fd < 0 || fw <= 0 || fh <= 0 ] return null
            t : Texture cv.vk.import_dmabuf_image[ fd, fw, fh,
                                                   wlc_frame_format[ id ],
                                                   wlc_frame_modifier[ id ],
                wlc_frame_stride[ id ], wlc_frame_offset[ id ], cv.w ]
            got[ key ] = t
            log 'wayland: imported frame {key} {fw}x{fh}'
            return t
        el
            return null

    # the dialog over the window, centred, coming down from the top
    func draw_sheet [ cv: Canvas, vp: rect ]
        if [ sheet == 0 || wlc_window_open[ sheet ] == 0 ]
            sheet_on = 0
            sheet_w  = 0.0
            return
        if [ sheet != sheet_on ]
            sheet_on     = sheet
            sheet_at     = 0.0
            sheet_frames = map Texture [string] []
            sheet_epoch  = wlc_window_epoch[ sheet ]
        ep : u64 [ wlc_window_epoch[ sheet ] ]
        if [ ep != sheet_epoch ]
            sheet_epoch = ep
            if [ !retired ] retired = vec Texture []
            for [ old: Texture, k: string ] in sheet_frames
                retired.push[ old ]
            sheet_frames = map Texture [string] []
            retire_n = 8
        t : Texture frame_of[ cv, sheet, sheet_frames ]
        if [ !t ] return
        sheet_at = filter_n[ sheet_at, 1.0, 0.25, ux.frame_factor ]
        if [ sheet_at > 0.999 ] sheet_at = 1.0
        # its frame has room past it: the dialog is its own size of it
        tw : f32 [ f32[ t.width ] ]
        th : f32 [ f32[ t.height ] ]
        sheet_w = min[ f32[ wlc_window_w[ sheet ] ], tw ]
        sheet_h = min[ f32[ wlc_window_h[ sheet ] ], th ]
        if [ sheet_w <= 0.0 || sheet_h <= 0.0 ]
            sheet_w = tw
            sheet_h = th
        sheet_x = round[ vp.x + (vp.w - sheet_w) * 0.5 ]
        sheet_y = round[ vp.y - sheet_h * (1.0 - sheet_at) ]
        cv.save[]
        cv.clip_rect[ vp.x, vp.y, vp.w, vp.h, 0.0, 0.0 ]
        # the window under it dims a little, as it waits on the dialog
        cv.fill_color[ rgba [ r: 0.0, g: 0.0, b: 0.0,
                              a: 0.25 * sheet_at ] ]
        cv.rect_to[ vp.x, vp.y, vp.w, vp.h ]
        cv.paint[]
        cv.box_shadow[ rgba [ '#000000aa' ], 0.0, 6.0, 24.0, 0.0,
                       false ]
        cv.fill_color[ rgba [ '#000000ff' ] ]
        cv.rect_to[ sheet_x, sheet_y, sheet_w, sheet_h ]
        cv.paint[]
        cv.no_shadows[]
        cv.draw_image_crop[ t, rect [ x: sheet_x, y: sheet_y,
                                      w: sheet_w, h: sheet_h ],
            0.0, 0.0, sheet_w / tw, sheet_h / th ]
        cv.restore[]

    # x, y (the pane's) is on the sheet
    func to_sheet [ x: f32, y: f32 ] -> bool
        return x >= sheet_x && x < sheet_x + sheet_w
               && y >= sheet_y && y < sheet_y + sheet_h

    # the pane's size reaches the window as fast as it draws: the
    # next goes once it has a frame at the last (or 250 ms passed);
    # one every frame left it no time to draw (black)
    func settle [ w9: i32, h9: i32 ]
        want_w = w9
        want_h = h9
        if [ want_w == sent_w && want_h == sent_h ] return
        now : i64 [ epoch_millis[] ]
        drawn : bool [ wlc_window_drawn[ win ] != 0 ]
        if [ sent_w != 0 && !drawn && now - sent_ms < 250 ] return
        sent_ms = now
        sent_w = want_w
        sent_h = want_h
        wlc_window_resize[ win, sent_w, sent_h ]

    # a new size, new buffers: the imports start over; the old ones go
    # some frames later
    func retire []
        if [ retire_n > 0 ]
            retire_n -= 1
            if [ retire_n == 0 ] retired = vec Texture []
        ep : u64 [ wlc_window_epoch[ win ] ]
        if [ ep == epoch ] return
        epoch = ep
        if [ !frames ] return
        if [ !retired ] retired = vec Texture []
        for [ t: Texture, k: string ] in frames
            retired.push[ t ]
        frames   = map Texture [string] []
        retire_n = 8

    # the thread's frames: imported here (this thread owns frames
    # while it runs) and shown once per commit
    func present_start [ cv: Canvas ]
        if [ present_on ] return
        screen_cv  = cv
        screen_gen = 0
        if [ !frames ] frames = map Texture [string] []
        present_on = true
        ifndef [ windows ]
            pthread_create[ @present_tid, null, @present_entry, a ]

    func present_stop []
        if [ !present_on ] return
        present_on = false
        ifndef [ windows ]
            pthread_join[ present_tid, null ]

    func present_entry [] -> none
        while [ present_on ]
            retire[]
            g : u64 [ wlc_frame_gen[ win ] ]
            if [ g != screen_gen ] present_one[ g ]
            Au.auto_free[]
            usleep[ 1000 ]
        wlc_frame_drop[ held_frame ]
        held_frame = 0

    # one frame: held, its render done, imported, copied; a frame
    # changed while taken is left for the next pass
    func present_one [ g: u64 ]
        b : u64 [ wlc_frame_take[ win ] ]
        if [ b == 0 ] return
        if [ wlc_frame_id[ win ] != b || wlc_frame_ready[ b, 100 ] == 0 ]
            wlc_frame_drop[ b ]
            return
        t : Texture frame_of[ screen_cv, win, frames ]
        if [ wlc_frame_id[ win ] != b || !t || !screen.show[ t ] ]
            wlc_frame_drop[ b ]
            return
        # the copy before this one is done: its frame may be reused
        wlc_frame_drop[ held_frame ]
        held_frame = b
        screen_gen = g
        shown_w = t.width
        shown_h = t.height

    # the shell paused for this window: its input from the screen
    # window, until the window closes or the screen window does
    public func on_frame [ w: Window ]
        if [ w.pause_for != a ] return
        open : bool [ win != 0 && wlc_window_open[ win ] != 0 ]
        if [ open && screen && !screen.shut[] ]
            screen.keep_front[]
            settle[ screen.width, screen.height ]
            if [ shown_w > 0 ] screen_input[ shown_w, shown_h ]
            return
        present_stop[]
        if [ screen ]
            if [ screen.closed ] screen_off = true
            screen.close[]
            screen = null
            log 'wayland: window {win} left the screen'
        sent_w = 0
        w.pause_for = null
        w.restyle = true

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        ux.will_animate = true
        hold_mouse[]
        frame_out[ w.screen,
                   rect [ x: 0.0, y: 0.0, w: bounds.w, h: bounds.h ] ]

    # the window holds its pointer: the mouse locks to the pane (its
    # moves go as raw motion) until the window lets go or Esc
    func hold_mouse []
        held : bool [ up && win != 0 && wlc_pointer_held[] == win ]
        mine : bool [ ux.locked == a ]
        if [ held_lock && !mine ] held_off = held
        held_lock = mine
        if [ held && !mine && !held_off && ux.focus == a ]
            ux.mouse_lock[ a ]
            held_lock = true
        el [ !held && mine ]
            ux.mouse_unlock[]
            held_lock = false

    # the pane's y plus the cropped top is the window's y
    func win_y [ y: f32 ] -> f32
        return y + ((crop_top > 0) ? f32[ crop_top ] : 0.0)

    public func on_press [ ev: Event ]
        if [ !up || win == 0 ] return
        if [ sheet_w > 0.0 ]
            if [ !to_sheet[ ev.mouse.pos.x, ev.mouse.pos.y ] ] return
            sx : f32 [ ev.mouse.pos.x - sheet_x ]
            sy : f32 [ ev.mouse.pos.y - sheet_y ]
            wlc_pointer_motion[ sheet, sx, sy ]
            wlc_pointer_button[ sheet, sx, sy, ev.mouse.button, 1 ]
            if [ ux ] ux.set_focus[ a ]
            return
        held_off = false
        if [ held_lock ]
            wlc_pointer_button[ win, 0.0, 0.0, ev.mouse.button, 1 ]
            return
        y : f32 win_y[ ev.mouse.pos.y ]
        wlc_pointer_motion[ win, ev.mouse.pos.x, y ]
        wlc_pointer_button[ win, ev.mouse.pos.x, y, ev.mouse.button, 1 ]
        if [ ux ] ux.set_focus[ a ]

    public func on_release [ ev: Event ]
        if [ !up || win == 0 ] return
        if [ sheet_w > 0.0 ]
            wlc_pointer_button[ sheet, ev.mouse.pos.x - sheet_x,
                ev.mouse.pos.y - sheet_y, ev.mouse.button, 0 ]
            return
        if [ held_lock ]
            wlc_pointer_button[ win, 0.0, 0.0, ev.mouse.button, 0 ]
            return
        y : f32 win_y[ ev.mouse.pos.y ]
        wlc_pointer_button[ win, ev.mouse.pos.x, y, ev.mouse.button, 0 ]

    public func on_move [ ev: Event ]
        if [ !up || win == 0 ] return
        if [ held_lock ]
            wlc_pointer_relative[ ev.mouse.delta.x, ev.mouse.delta.y ]
            return
        if [ sheet_w > 0.0 ]
            if [ to_sheet[ ev.mouse.pos.x, ev.mouse.pos.y ] ]
                wlc_pointer_motion[ sheet, ev.mouse.pos.x - sheet_x,
                                    ev.mouse.pos.y - sheet_y ]
            return
        y : f32 win_y[ ev.mouse.pos.y ]
        wlc_pointer_motion[ win, ev.mouse.pos.x, y ]

    public func on_wheel [ ev: Event ]
        if [ !up || win == 0 ] return
        if [ sheet_w > 0.0 ]
            if [ !to_sheet[ ev.mouse.pos.x, ev.mouse.pos.y ] ] return
            wlc_pointer_motion[ sheet, ev.mouse.pos.x - sheet_x,
                                ev.mouse.pos.y - sheet_y ]
            wlc_pointer_axis[ steps[ ev.mouse.wheel_delta.x ],
                              steps[ ev.mouse.wheel_delta.y ] ]
            return
        # the scroll goes to the surface under the pointer
        wlc_pointer_motion[ win, ev.mouse.pos.x,
                            win_y[ ev.mouse.pos.y ] ]
        wlc_pointer_axis[ steps[ ev.mouse.wheel_delta.x ],
                          steps[ ev.mouse.wheel_delta.y ] ]

    # a window takes the wheel's own steps, not trinity's boost,
    # times the user's setting for windows
    func steps [ d: f32 ] -> f32
        m : f64 [ (ux.wheel_mul > 0.0) ? ux.wheel_mul : wheel_scale[] ]
        return f32[ d / m ] * ux.window_wheel

    public func on_key [ ev: Event ]
        if [ !up ] return
        wlc_key[ i32[ ev.key.unicode ], (ev.key.state) ? 1 : 0 ]
