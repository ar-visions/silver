# wizard: orbiter-os install settings, then the install itself
export 0.1.0

import vec
import img
import trinity
import avatar
import os-bootstrap
import <stdio.h>
import <stdlib.h>
import <string.h>
import <unistd.h>
    +_DEFAULT_SOURCE
import <errno.h>
import <utime.h>
import <sys/stat.h>
import <sys/statvfs.h>
import <fnmatch.h>
import <pthread.h>
import <sys/mount.h>
import <sys/reboot.h>
import <crypt.h>
    -lcrypt
ifdef [ linux ]
    import <vulkan/vulkan.h>
        -lvulkan

# the first line of a small file, trimmed; '' when unreadable
func read_line [ f: string ] -> string
    fh : handle fopen[ f.chars, 'r' ]
    if [ !fh ] return ''
    b : local i8 [ 4096 ]
    out : string ''
    if [ fgets[ @b[0], 4096, fh ] ]
        s : string [ @b[0] ]
        out = s.trim[]
    fclose[ fh ]
    return out

# where a link points; '' when it is not one
func link_text [ f: string ] -> string
    b : local i8 [ 4096 ]
    n : i64 [ readlink[ f.chars, @b[0], 4095 ] ]
    if [ n <= 0 ] return ''
    b[ n ] = 0
    return string [ @b[0] ]

# the last name in a path
func last_name [ s: string ] -> string
    at : i32 [ s.rindex_of[ '/' ] ]
    if [ at < 0 ] return s
    return s.mid[ at + 1, s.count - at - 1 ]

# n bytes of a file at an offset; empty when unreadable
func read_at [ f: string, at: i64, n: i32 ] -> vec u8
    out : vec u8 []
    fh : handle fopen[ f.chars, 'rb' ]
    if [ !fh ] return out
    b : local u8 [ 64 ]
    if [ fseek[ fh, at, SEEK_SET ] == 0 ]
        got : i32 [ fread[ @b[0], 1, n, fh ] ]
        for [ i: i32 0, i < got, i += 1 ]
            v : u8 [ b[ i ] ]
            out.push[ v ]
    fclose[ fh ]
    return out

# 1024-based, as the rest of silver writes sizes
func size_text [ n: i64 ] -> string
    gb : f64 [ f64[ n ] / 1073741824.0 ]
    if [ gb >= 1024.0 ]
        tb : f64 [ gb / 1024.0 ]
        return '{tb.1f} TB'
    if [ gb >= 1.0 ] return '{gb.1f} GB'
    mb : f64 [ f64[ n ] / 1048576.0 ]
    return '{mb.0f} MB'

# a hex word from sysfs (0x10de)
func hex_value [ s: string ] -> u32
    return u32[ strtol[ s.chars, null, 16 ] ]

# the ext4 uuid from the superblock (offset 1024)
func ext4_uuid [ dev: string ] -> string
    magic : read_at[ dev, 1080, 2 ]
    if [ magic.count < 2 || magic[0] != 0x53 || magic[1] != 0xEF ]
        return ''
    return uuid_at[ dev, 1128 ]

# 16 bytes at at, as a uuid
func uuid_at [ dev: string, at: i64 ] -> string
    u : read_at[ dev, at, 16 ]
    if [ u.count < 16 ] return ''
    digits : '0123456789abcdef'
    s : string ''
    for [ i: i32 0, i < 16, i += 1 ]
        if [ i == 4 || i == 6 || i == 8 || i == 10 ] s = '{s}-'
        hi : i32 [ u[ i ] >> 4 ]
        lo : i32 [ u[ i ] & 15 ]
        s = '{s}{digits.mid[ hi, 1 ]}{digits.mid[ lo, 1 ]}'
    return s

# a file system's name in its first sectors
func has_sig [ dev: string, at: i64, sig: string ] -> bool
    n : i32 [ sig.count ]
    v : read_at[ dev, at, n ]
    if [ v.count < n ] return false
    for [ i: i32 0, i < n, i += 1 ]
        if [ v[ i ] != sig.chars[ i ] ] return false
    return true

# swap in use, from the kernel's list
func swap_on [ dev: string ] -> bool
    fh : handle fopen[ '/proc/swaps', 'r' ]
    if [ !fh ] return false
    b : local i8 [ 1024 ]
    on : bool [ false ]
    while [ fgets[ @b[0], 1024, fh ] ]
        ln : string [ @b[0] ]
        if [ ln.starts_with[ '{dev} ' ] ] on = true
    fclose[ fh ]
    return on

# bytes free on a mounted file system
func free_at [ dir: string ] -> i64
    st : struct statvfs
    if [ statvfs[ dir.chars, @st ] != 0 ] return -1
    return i64[ st.f_bavail ] * i64[ st.f_frsize ]

# what is on a mounted partition: a system, boot folders
func contents [ dir: string, fs: string ] -> string
    if [ fs == 'vfat' ]
        ed : path '{dir}/EFI'
        if [ !ed.is_dir[] ] return ''
        out : string ''
        names : ed.ls[ null, false ]
        if [ names ]
            for [ e: path ] in names
                nm : e.filename[]
                if [ !e.is_dir[] || nm.lcase[] == 'boot' ] continue
                out = (out.count > 0) ? '{out}, {nm}' : nm
        return (out.count > 0) ? 'EFI: {out}' : 'EFI'
    out : string ''
    rel : read_os[ '{dir}/etc/os-release' ]
    if [ rel.count > 0 ] out = rel
    if [ dir == '/' ]
        out = (out.count > 0) ? '{out}, running now' : 'running now'
    oo : path '{dir}/orbiter-os'
    if [ oo.exists[] || oo.is_symlink[] ]
        out = (out.count > 0) ? '{out}, has orbiter-os' : 'orbiter-os'
    return out

# a system's name: PRETTY_NAME from os-release
func read_os [ f: string ] -> string
    fh : handle fopen[ f.chars, 'r' ]
    if [ !fh ] return ''
    b : local i8 [ 1024 ]
    out : string ''
    while [ fgets[ @b[0], 1024, fh ] ]
        ln0 : string [ @b[0] ]
        ln : ln0.trim[]
        if [ !ln.starts_with[ 'PRETTY_NAME=' ] ] continue
        v : ln.mid[ 12, ln.count - 12 ]
        if [ v.count >= 2 && v.chars[ 0 ] == 34 ]
            v = v.mid[ 1, v.count - 2 ]
        out = v
    fclose[ fh ]
    return out

# a mounted partition's type, from this process's mount table
func mounted_type [ dev: string ] -> string
    fh : handle fopen[ '/proc/self/mountinfo', 'r' ]
    if [ !fh ] return ''
    b : local i8 [ 4096 ]
    out : string ''
    while [ fgets[ @b[0], 4096, fh ] ]
        ln : string [ @b[0] ]
        dash : i32 [ ln.index_of[ ' - ' ] ]
        if [ dash < 0 ] continue
        tail : ln.mid[ dash + 3, ln.count - dash - 3 ]
        words : tail.split[ ' ' ]
        if [ words.count >= 2 && '{words[1]}' == dev ]
            out = '{words[0]}'
            break
    fclose[ fh ]
    return out

# where a partition is mounted here; '' when it is not
func mounted_at [ dev: string ] -> string
    fh : handle fopen[ '/proc/self/mountinfo', 'r' ]
    if [ !fh ] return ''
    b : local i8 [ 4096 ]
    out : string ''
    while [ fgets[ @b[0], 4096, fh ] ]
        ln : string [ @b[0] ]
        dash : i32 [ ln.index_of[ ' - ' ] ]
        if [ dash < 0 ] continue
        tail : ln.mid[ dash + 3, ln.count - dash - 3 ]
        words : tail.split[ ' ' ]
        head : ln.split[ ' ' ]
        if [ words.count >= 2 && '{words[1]}' == dev && head.count > 4 ]
            out = '{head[4]}'
            break
    fclose[ fh ]
    return out

# the partition's file system: ext4, vfat, or '' (unread)
func fs_type [ dev: string ] -> string
    mt : mounted_type[ dev ]
    if [ mt.count > 0 ] return mt
    if [ ext4_uuid[ dev ].count > 0 ] return 'ext4'
    if [ has_sig[ dev, 82, 'FAT' ] || has_sig[ dev, 54, 'FAT' ] ]
        return 'vfat'
    if [ has_sig[ dev, 3, 'NTFS' ] ] return 'ntfs'
    if [ swap_on[ dev ] || has_sig[ dev, 4086, 'SWAPSPACE2' ] ]
        return 'swap'
    return ''

# a partition's uuid as udev keeps it (readable by anyone)
func part_uuid [ dev: string ] -> string
    cmd : command [ 'lsblk -dno UUID {dev} 2>/dev/null' ]
    fh : handle cmd.stream[]
    if [ !fh ] return ''
    b : local i8 [ 128 ]
    out : string ''
    if [ fgets[ @b[0], 128, fh ] ]
        ln : string [ @b[0] ]
        out = ln.trim[]
    pclose[ fh ]
    return out

# partition n of a disk: nvme0n1 -> nvme0n1p1, sda -> sda1
func part_dev [ disk: string, n: i32 ] -> string
    lc : i32 [ disk.chars[ disk.count - 1 ] ]
    if [ lc >= 48 && lc <= 57 ] return '/dev/{disk}p{n}'
    return '/dev/{disk}{n}'

# the disk the running system is on, by the mount of /
func root_disk [] -> string
    fh : handle fopen[ '/proc/self/mountinfo', 'r' ]
    if [ !fh ] return ''
    b : local i8 [ 4096 ]
    num : string ''
    while [ fgets[ @b[0], 4096, fh ] ]
        ln : string [ @b[0] ]
        words : ln.split[ ' ' ]
        if [ words.count > 4 && '{words[4]}' == '/' ]
            num = '{words[2]}'
    fclose[ fh ]
    if [ num.count == 0 ] return ''
    lk : link_text[ '/sys/dev/block/{num}' ]
    if [ lk.count == 0 ] return ''
    pt : path '/sys/dev/block/{num}/partition'
    if [ !pt.exists[] ] return last_name[ lk ]
    up : lk.mid[ 0, lk.rindex_of[ '/' ] ]
    return last_name[ up ]

# a program on PATH; '' when it is not there
func find_tool [ nm: string ] -> string
    env : cstr [ getenv[ 'PATH' ] ]
    dirs : string [ (env) ? string [ env ]
        : '/usr/sbin:/usr/bin:/sbin:/bin' ]
    for [ d: string ] in dirs.split[ ':' ]
        f : '{d}/{nm}'
        if [ access[ f.chars, X_OK ] == 0 ] return f
    return ''

# a 16-bit id as pci.ids writes it: 4 small hex digits
func hex4 [ v: u32 ] -> string
    digits : '0123456789abcdef'
    out : string ''
    for [ i: i32 3, i >= 0, i -= 1 ]
        k : i32 [ (v >> (i * 4)) & 15 ]
        out = '{out}{digits.mid[ k, 1 ]}'
    return out

# the name in brackets, else the words before the first comma
func short_name [ s: string ] -> string
    a1 : i32 [ s.index_of[ '[' ] ]
    a2 : i32 [ s.rindex_of[ ']' ] ]
    if [ a1 >= 0 && a2 > a1 ] return s.mid[ a1 + 1, a2 - a1 - 1 ]
    sp : i32 [ s.index_of[ ' ' ] ]
    if [ sp > 0 ] return s.mid[ 0, sp ]
    return s

# a pci device's name from pci.ids: vendor, then device
func pci_name [ ids: string, v: u32, d: u32 ] -> string
    vs : hex4[ v ]
    ds : hex4[ d ]
    fh : handle fopen[ ids.chars, 'r' ]
    if [ !fh ] return 'device {vs}:{ds}'
    b : local i8 [ 1024 ]
    vendor : string ''
    dev : string ''
    while [ fgets[ @b[0], 1024, fh ] ]
        ln0 : string [ @b[0] ]
        ln : ln0.trim[]
        lead : i32 [ ln0.chars[ 0 ] ]
        # 9 is a tab: device lines sit under their vendor's
        if [ lead != 9 && lead != 35 ]
            if [ vendor.count > 0 ] break
            if [ ln.starts_with[ '{vs}  ' ] ]
                vendor = short_name[ ln.mid[ 6, ln.count - 6 ] ]
        el [ vendor.count > 0 && lead == 9 && ln0.chars[ 1 ] != 9
             && ln.starts_with[ '{ds}  ' ] ]
            dev = ln.mid[ 6, ln.count - 6 ]
            break
    fclose[ fh ]
    if [ vendor.count == 0 ] return 'device {vs}:{ds}'
    if [ dev.count == 0 ] return '{vendor} device {ds}'
    a1 : i32 [ dev.index_of[ '[' ] ]
    if [ a1 >= 0 ] dev = short_name[ dev ]
    return '{vendor} {dev}'

# a module tree's drivers: name, then the hardware id it takes
# (depmod's lines: alias <id pattern> <module>)
func load_aliases [ f: string, out: vec string ]
    fh : handle fopen[ f.chars, 'r' ]
    if [ !fh ] return
    b : local i8 [ 1024 ]
    while [ fgets[ @b[0], 1024, fh ] ]
        ln0 : string [ @b[0] ]
        ln : ln0.trim[]
        if [ !ln.starts_with[ 'alias ' ] ] continue
        rest : ln.mid[ 6, ln.count - 6 ]
        sp : i32 [ rest.rindex_of[ ' ' ] ]
        if [ sp <= 0 ] continue
        out.push[ rest.mid[ sp + 1, rest.count - sp - 1 ] ]
        out.push[ rest.mid[ 0, sp ] ]
    fclose[ fh ]

# the kernel release a tree has modules for: the running one's
# if the tree has it, else its own; '' when none
func kernel_release [ tree: string ] -> string
    run : read_line[ '/proc/sys/kernel/osrelease' ]
    mine : path '{tree}/lib/modules/{run}/modules.alias'
    if [ mine.exists[] ] return run
    own : image_release[ '{tree}/boot/vmlinuz' ]
    theirs : path '{tree}/lib/modules/{own}/modules.alias'
    if [ own.count > 0 && theirs.exists[] ] return own
    md : path '{tree}/lib/modules'
    rels : md.ls[ null, false ]
    if [ !rels ] return ''
    out : string ''
    for [ r: path ] in rels
        ma : path '{r}/modules.alias'
        if [ ma.exists[] ] out = r.filename[]
    return out

# an x86 kernel image's release: its header holds where its
# version text is (at 0x20E, from 0x200), the release first
func image_release [ f: string ] -> string
    at : read_at[ f, 0x20E, 2 ]
    if [ at.count < 2 ] return ''
    off : i64 [ i64[ at[ 0 ] ] + i64[ at[ 1 ] ] * 256 + 0x200 ]
    v : read_at[ f, off, 64 ]
    b : local i8 [ 65 ]
    n : i32 [ 0 ]
    while [ n < v.count && v[ n ] != 32 && v[ n ] != 0 ]
        b[ n ] = i8[ v[ n ] ]
        n += 1
    b[ n ] = 0
    return string [ @b[0] ]

# a module's firmware the tree lacks: '' when one it lists is
# there (a driver lists every chip's; one is this device's)
func firmware_gap [ tree: string, rel: string,
                    mod: string ] -> string
    root : string [ (tree.count > 0) ? tree : '/' ]
    cmd : 'modinfo -b {root} -k {rel} -F firmware {mod} 2>/dev/null'
    fh_cmd : command [ cmd ]
    fh : handle fh_cmd.stream[]
    if [ !fh ] return ''
    b : local i8 [ 1024 ]
    first : string ''
    found : bool [ false ]
    while [ fgets[ @b[0], 1024, fh ] ]
        ln0 : string [ @b[0] ]
        f : ln0.trim[]
        if [ f.count == 0 ] continue
        if [ first.count == 0 ] first = f
        for [ x: string ] in vec string [] [ '', '.zst', '.xz' ]
            fp : path '{tree}/lib/firmware/{f}{x}'
            if [ fp.exists[] ] found = true
    pclose[ fh ]
    return (found) ? '' : first

# every driver for a device id, as modprobe -b loads them: the
# blocklisted ones left out
func drivers_for [ al: vec string, id: string,
                   black: vec string ] -> vec string
    out : vec string []
    if [ id.count == 0 ] return out
    for [ i: i32 0, i + 1 < al.count, i += 2 ]
        pat : al[ i + 1 ]
        if [ fnmatch[ pat.chars, id.chars, 0 ] != 0 ] continue
        mod : al[ i ]
        if [ !black.contains[ mod ] && !out.contains[ mod ] ]
            out.push[ mod ]
    return out

# the first driver for a device id; '' when it has none
func driver_for [ al: vec string, id: string ] -> string
    found : drivers_for[ al, id, vec string [] ]
    return (found.count > 0) ? found[ 0 ] : ''

# modprobe's blocklist: the names in blacklist lines
func load_blacklist [ dir: string ] -> vec string
    out : vec string []
    d : path [ dir ]
    confs : d.ls[ null, false ]
    if [ !confs ] return out
    for [ f: path ] in confs
        if [ !f.filename[].ends_with[ '.conf' ] ] continue
        fs : '{f}'
        fh : handle fopen[ fs.chars, 'r' ]
        if [ !fh ] continue
        b : local i8 [ 1024 ]
        while [ fgets[ @b[0], 1024, fh ] ]
            ln0 : string [ @b[0] ]
            ln : ln0.trim[]
            if [ !ln.starts_with[ 'blacklist ' ] ] continue
            out.push[ ln.mid[ 10, ln.count - 10 ].trim[] ]
        fclose[ fh ]
    return out

# a graphics driver's Vulkan driver file, by its name
func icd_for [ drv: string ] -> string
    if [ drv == 'nvidia' ] return 'nvidia_icd'
    if [ drv == 'amdgpu' ] return 'radeon_icd'
    if [ drv == 'i915' || drv == 'xe' ] return 'intel_icd'
    if [ drv == 'virtio_gpu' ] return 'virtio_icd'
    return ''

# one device the hardware check looks at
class Hw
    public kind   : string [ '' ]
    public name   : string [ '' ]
    public driver : string [ '' ]
    public graphics : bool
    public ok     : bool
    public note   : string [ '' ]

# the program the firmware starts first, and its menu
enum BootKind
    none:         0
    grub_debian:  1
    grub_bls:     2
    systemd_boot: 3
    refind:       4
    windows:      5
    unknown:      6

func boot_name [ k: BootKind ] -> string
    if [ k == BootKind.grub_debian ] return 'GRUB (Debian, Ubuntu)'
    if [ k == BootKind.grub_bls ]
        return 'GRUB with boot entries (Fedora)'
    if [ k == BootKind.systemd_boot ] return 'systemd-boot'
    if [ k == BootKind.refind ] return 'rEFInd'
    if [ k == BootKind.windows ] return 'Windows Boot Manager'
    if [ k == BootKind.unknown ] return 'not known'
    return 'none'

# the firmware's order, from its BootOrder: line
func boot_order [ lines: vec string ] -> vec string
    out : vec string []
    for [ ln: string ] in lines
        if [ !ln.starts_with[ 'BootOrder:' ] ] continue
        rest : ln.mid[ 10, ln.count - 10 ].trim[]
        for [ w: string ] in rest.split[ ',' ]
            id : '{w}'
            if [ id.count > 0 ] out.push[ id ]
    return out

# the default entry's file: BootOrder's first, its File(...)
func default_loader [ lines: vec string ] -> string
    order : boot_order[ lines ]
    if [ order.count == 0 ] return ''
    key : 'Boot{order[0]}'
    for [ ln: string ] in lines
        if [ !ln.starts_with[ key ] ] continue
        at : i32 [ ln.index_of[ 'File(' ] ]
        if [ at < 0 ] return ''
        rest : ln.mid[ at + 5, ln.count - at - 5 ]
        end : i32 [ rest.index_of[ ')' ] ]
        if [ end < 0 ] return ''
        return rest.mid[ 0, end ].lcase[]
    return ''

# which menu: the default loader first, then what is on disk
func detect_boot [ loader: string, esp: string,
                   root: string ] -> BootKind
    ld : loader.lcase[]
    sd : path '{esp}/EFI/systemd'
    le : path '{esp}/loader/entries'
    rf : path '{esp}/EFI/refind'
    if [ ld.index_of[ 'refind' ] >= 0 ] return BootKind.refind
    if [ ld.index_of[ 'systemd' ] >= 0 ] return BootKind.systemd_boot
    if [ ld.index_of[ 'microsoft' ] >= 0 ] return BootKind.windows
    grub : bool [ ld.index_of[ 'grub' ] >= 0
        || ld.index_of[ 'shim' ] >= 0 ]
    if [ grub || ld.count == 0 || ld.index_of[ '\\boot\\' ] >= 0 ]
        bls_own : path '{root}/loader/entries'
        bls_sub : path '{root}/boot/loader/entries'
        if [ bls_own.is_dir[] || bls_sub.is_dir[] ]
            return BootKind.grub_bls
        gd : path '{root}/etc/grub.d'
        if [ gd.is_dir[] ] return BootKind.grub_debian
    if [ ld.count == 0 || !grub ]
        if [ sd.is_dir[] || le.is_dir[] ] return BootKind.systemd_boot
        if [ rf.is_dir[] ] return BootKind.refind
    return BootKind.unknown

class Part
    public name   : string [ '' ]
    public number : i32
    # where it starts on the disk, and its size
    public start  : i64
    public bytes  : i64
    public fs     : string [ '' ]
    # -1: not known (not mounted, not root)
    public free   : i64 [ -1 ]
    public what   : string [ '' ]
    # in use: never shrunk
    public mounted : bool
    # the least it can shrink to, -1 when it cannot
    public low    : i64 [ -1 ]
    # the size it is to shrink to, -1: kept as it is
    public keep   : i64 [ -1 ]

    func shown [] -> i64
        return (keep >= 0) ? keep : bytes

# unallocated space on a disk
class Gap
    public start : i64
    public bytes : i64

class Disk
    public name      : string [ '' ]
    public model     : string [ '' ]
    public bytes     : i64
    public removable : bool
    # the running system is on it
    public running   : bool
    public parts     : vec Part
    # installing into free space: the gap chosen, or the
    # partition shrunk to make room (-1 each: none)
    public gap_at    : i32 [ -1 ]
    public shrink_at : i32 [ -1 ]

    func text [] -> string
        kind : string [ (removable) ? ', removable' : '' ]
        here : string [ (running) ? ', running now' : '' ]
        md : string [ (model.count > 0) ? model : 'disk' ]
        return '{name}   {md}   {size_text[ bytes ]}{kind}{here}'

# a graphics card: pci ids, kernel and Vulkan drivers
class Card
    public slot    : string [ '' ]
    public vendor  : u32
    public device  : u32
    public kernel  : string [ '' ]
    public name    : string [ '' ]
    public vulkan  : string [ '' ]
    public api     : string [ '' ]
    public discrete : bool
    public in_use  : bool

    func vendor_name [] -> string
        if [ vendor == 0x10de ] return 'NVIDIA'
        if [ vendor == 0x1002 ] return 'AMD'
        if [ vendor == 0x8086 ] return 'Intel'
        if [ vendor == 0x1af4 ] return 'virtio'
        return 'vendor {vendor}'

    func title [] -> string
        nm : string [ (name.count > 0) ? name
            : '{vendor_name[]} card {device}' ]
        return (in_use) ? '{nm}  (in use)' : nm

    func detail [] -> string
        kind : string [ (discrete) ? 'graphics card' : 'built in' ]
        return '{kind}, {vulkan}, Vulkan {api}'

# a C char array as a string
func c_text [ src: @i8 ] -> string
    b : local i8 [ 260 ]
    strncpy[ @b[0], src, 255 ]
    b[ 255 ] = 0
    return string [ @b[0] ]

# every display device on the pci bus, with its vulkan driver
func scan_cards [] -> vec Card
    out : vec Card []
    d : path '/sys/bus/pci/devices'
    entries : d.ls[ null, false ]
    if [ entries ]
        for [ e: path ] in entries
            cl : read_line[ '{e}/class' ]
            if [ !cl.starts_with[ '0x03' ] ] continue
            out.push[ Card [ slot: e.filename[],
                vendor: hex_value[ read_line[ '{e}/vendor' ] ],
                device: hex_value[ read_line[ '{e}/device' ] ],
                kernel: last_name[ link_text[ '{e}/driver' ] ] ] ]
    app : VkApplicationInfo [
        sType:      VK_STRUCTURE_TYPE_APPLICATION_INFO,
        apiVersion: VK_API_VERSION_1_2 ]
    inst : VkInstance
    res : vkCreateInstance[ VkInstanceCreateInfo [
        sType:            VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
        pApplicationInfo: @app ], null, @inst ]
    if [ res != VK_SUCCESS ] return out
    count : u32 [ 8 ]
    devs : local VkPhysicalDevice [ 8 ]
    vkEnumeratePhysicalDevices[ inst, @count, @devs[0] ]
    for [ i: u32 0, i < count, i += 1 ]
        drv : VkPhysicalDeviceDriverProperties [
            sType: VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_DRIVER_PROPERTIES ]
        props : VkPhysicalDeviceProperties2 [
            sType: VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2,
            pNext: @drv ]
        vkGetPhysicalDeviceProperties2[ devs[ i ], @props ]
        # a software renderer draws on the processor: no card
        if [ props.properties.deviceType
             == VK_PHYSICAL_DEVICE_TYPE_CPU ] continue
        major : u32 [ props.properties.apiVersion >> 22 ]
        minor : u32 [ (props.properties.apiVersion >> 12) & 0x3ff ]
        found : Card null
        for [ c: Card ] in out
            if [ c.vendor == props.properties.vendorID
                 && c.device == props.properties.deviceID
                 && c.vulkan.count == 0 ]
                found = c
                break
        if [ !found ]
            found = Card [ vendor: props.properties.vendorID,
                           device: props.properties.deviceID ]
            out.push[ found ]
        found.name     = c_text[ @props.properties.deviceName[0] ]
        dn : c_text[ @drv.driverName[0] ]
        di : c_text[ @drv.driverInfo[0] ]
        found.vulkan   = '{dn} {di}'
        found.api      = '{major}.{minor}'
        found.discrete = props.properties.deviceType
            == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU
    vkDestroyInstance[ inst, null ]
    # only cards orbiter-os can draw with: a Vulkan driver
    usable : vec Card []
    for [ c: Card ] in out
        if [ c.vulkan.count > 0 ] usable.push[ c ]
    # trinity's pick: the first discrete card, else the first
    pick : Card null
    for [ c: Card ] in usable
        if [ c.discrete ]
            pick = c
            break
    if [ !pick && usable.count > 0 ] pick = usable[ 0 ]
    if [ pick ] pick.in_use = true
    return usable

# a partition's free space and contents: where it is mounted,
# else mounted read-only here for a moment (as root)
func inspect [ p: Part ]
    dev : '/dev/{p.name}'
    if [ p.fs == 'swap' ]
        p.what = (swap_on[ dev ]) ? 'swap, in use' : 'swap'
        return
    if [ p.fs == 'ntfs' ]
        p.what = 'Windows or data (NTFS)'
        return
    if [ p.fs != 'ext4' && p.fs != 'vfat' ] return
    dir : mounted_at[ dev ]
    look : '/run/wizard/look-part'
    if [ dir.count == 0 ]
        lp : path [ look ]
        lp.make_dir[]
        if [ mount[ dev.chars, look.chars, p.fs.chars, MS_RDONLY,
                    null ] == 0 ]
            dir = look
    if [ dir.count == 0 ] return
    p.free = free_at[ dir ]
    p.what = contents[ dir, p.fs ]
    if [ dir == look ] umount2[ look.chars, 0 ]

MIB : i64 [ 1048576 ]
GIB : i64 [ 1073741824 ]

func mib_up [ n: i64 ] -> i64
    return ((n + MIB - 1) / MIB) * MIB

# the least a partition can shrink to: what it holds, a tenth
# more and at least a GB; -1 when in use or not ext4 / NTFS
func shrink_floor [ p: Part ] -> i64
    if [ p.mounted ] return -1
    used : i64 [ -1 ]
    if [ p.fs == 'ext4' && p.free >= 0 ] used = p.bytes - p.free
    if [ p.fs == 'ntfs' ] used = ntfs_least[ '/dev/{p.name}' ]
    if [ used < 0 ] return -1
    room : i64 [ used / 10 ]
    if [ room < GIB ] room = GIB
    low : i64 [ mib_up[ used + room ] ]
    return (low < p.bytes) ? low : -1

# ntfsresize's own least size (as root), -1 when it says none
func ntfs_least [ dev: string ] -> i64
    full : 'ntfsresize --info --force --no-action {dev} 2>/dev/null'
    fh_cmd : command [ full ]
    fh : handle fh_cmd.stream[]
    if [ !fh ] return -1
    b : local i8 [ 512 ]
    out : i64 [ -1 ]
    key : 'You might resize at '
    while [ fgets[ @b[0], 512, fh ] ]
        ln : string [ @b[0] ]
        at : i32 [ ln.index_of[ key ] ]
        if [ at >= 0 ]
            rest : ln.mid[ at + key.count, ln.count - at - key.count ]
            out = rest.integer_value[]
    pclose[ fh ]
    return out

# unallocated runs of 16 MB or more, a MB aligned, after the
# table's first MB and before its backup at the end
func disk_gaps [ dk: Disk ] -> vec Gap
    out : vec Gap []
    order : vec Part []
    for [ p: Part ] in dk.parts
        at : i32 [ 0 ]
        while [ at < order.count && order[ at ].start < p.start ]
            at += 1
        order.insert[ p, at ]
    from : i64 [ MIB ]
    last : i64 [ ((dk.bytes - MIB) / MIB) * MIB ]
    for [ i: i32 0, i <= order.count, i += 1 ]
        upto : i64 [ last ]
        if [ i < order.count ] upto = order[ i ].start
        s : i64 [ mib_up[ from ] ]
        n : i64 [ ((upto - s) / MIB) * MIB ]
        if [ n >= 16 * MIB ] out.push[ Gap [ start: s, bytes: n ] ]
        if [ i < order.count ]
            e : i64 [ order[ i ].start + order[ i ].bytes ]
            if [ e > from ] from = e
    return out

# where the new partition goes: the gap chosen, or what a shrink
# frees with any gap right after it; bytes 0: nowhere yet
func free_place [ dk: Disk ] -> Gap
    if [ dk.shrink_at >= 0 && dk.shrink_at < dk.parts.count ]
        p : Part dk.parts[ dk.shrink_at ]
        s : i64 [ mib_up[ p.start + p.shown[] ] ]
        e : i64 [ s ]
        for [ g: Gap ] in disk_gaps[ dk ]
            if [ g.start >= p.start + p.bytes
                 && g.start <= mib_up[ p.start + p.bytes ] ]
                e = g.start + g.bytes
        if [ e == s ] e = ((p.start + p.bytes) / MIB) * MIB
        return Gap [ start: s, bytes: (e > s) ? e - s : 0 ]
    gaps : disk_gaps[ dk ]
    if [ dk.gap_at >= 0 && dk.gap_at < gaps.count ]
        return gaps[ dk.gap_at ]
    return Gap []

# this machine's memory
func ram_bytes [] -> i64
    fh : handle fopen[ '/proc/meminfo', 'r' ]
    if [ !fh ] return 0
    b : local i8 [ 256 ]
    out : i64 [ 0 ]
    while [ fgets[ @b[0], 256, fh ] ]
        ln : string [ @b[0] ]
        if [ ln.starts_with[ 'MemTotal:' ] ]
            kb : ln.mid[ 9, ln.count - 9 ].trim[]
            out = kb.integer_value[] * 1024
    fclose[ fh ]
    return out

# the swap this machine wants: its memory, at most 8 GB
func swap_want [] -> i64
    r : i64 [ mib_up[ ram_bytes[] ] ]
    return (r > 8 * GIB || r <= 0) ? 8 * GIB : r

# every disk the kernel lists, with its partitions
func scan_disks [] -> vec Disk
    out : vec Disk []
    here : root_disk[]
    d : path '/sys/block'
    entries : d.ls[ null, false ]
    if [ !entries ] return out
    skip : vec string [] [ 'loop', 'ram', 'zram', 'sr', 'fd' ]
    for [ e: path ] in entries
        nm : e.filename[]
        virt : bool [ false ]
        for [ s: string ] in skip
            if [ nm.starts_with[ s ] ] virt = true
        if [ virt ] continue
        # sysfs sizes count 512-byte sectors
        sectors : i64 [ read_line[ '{e}/size' ].integer_value[] ]
        if [ sectors == 0 ] continue
        dk : Disk [ name: nm, model: read_line[ '{e}/device/model' ],
            bytes: sectors * 512,
            removable: read_line[ '{e}/removable' ] == '1',
            running: nm == here, parts: vec Part [] ]
        kids : e.ls[ null, false ]
        if [ kids ]
            for [ k: path ] in kids
                kn : k.filename[]
                if [ !kn.starts_with[ nm ] ] continue
                pn : read_line[ '{k}/partition' ]
                if [ pn.count == 0 ] continue
                ps : i64 [ read_line[ '{k}/size' ].integer_value[] ]
                st : i64 [ read_line[ '{k}/start' ].integer_value[] ]
                pt : Part [ name: kn, number: pn.integer_value[],
                    start: st * 512, bytes: ps * 512,
                    fs: fs_type[ '/dev/{kn}' ] ]
                pt.mounted = mounted_at[ '/dev/{kn}' ].count > 0
                    || (pt.fs == 'swap' && swap_on[ '/dev/{kn}' ])
                inspect[ pt ]
                pt.low = shrink_floor[ pt ]
                # sysfs lists them in no order: keep them by number
                at : i32 [ 0 ]
                while [ at < dk.parts.count
                        && dk.parts[ at ].number < pt.number ]
                    at += 1
                dk.parts.insert[ pt, at ]
        out.push[ dk ]
    return out

enum StepKind
    run:     0
    wait:    1
    mount:   2
    unmount: 3
    copy:    4
    file:    5
    write:   6
    boot:    7
    menu:    8

# one step of the install; the review lists each title
class Step
    public kind  : StepKind
    public title : string [ '' ]
    public cmd   : string [ '' ]
    public src   : string [ '' ]
    public dst   : string [ '' ]
    public fs    : string [ '' ]
    public text  : string [ '' ]
    # a boot entry that goes after the current default
    public second : bool
    # a menu file for this boot manager, made at install time
    public menu   : BootKind
    # the written file runs: rwxr-xr-x
    public exec   : bool

