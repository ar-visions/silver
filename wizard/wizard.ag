# a partition's or a gap's place on the map, 0..1 across it
class MapSeg
    public gap   : bool
    public index : i32
    public x0    : f32
    public x1    : f32

# the disk as a bar: its partitions and free space to scale (a
# small one keeps 3% so it can be seen and picked), the used
# part of each shaded. Free space mode: the partition chosen to
# shrink has an edge to drag left, and what it frees shows green
element DiskMap
    public dk      : Disk
    # 0 the whole disk, 1 a folder beside, 2 into free space
    public mode    : i32
    public part_at : i32 [ -1 ]
    intern dragging : bool

    func layout [] -> vec MapSeg
        out : vec MapSeg []
        if [ !dk || dk.bytes <= 0 ] return out
        gaps : disk_gaps[ dk ]
        starts : vec i64 []
        for [ i: i32 0, i < dk.parts.count, i += 1 ]
            ps : i64 [ dk.parts[ i ].start ]
            at : i32 [ 0 ]
            while [ at < out.count && starts[ at ] < ps ] at += 1
            out.insert[ MapSeg [ index: i ], at ]
            starts.insert[ ps, at ]
        for [ i: i32 0, i < gaps.count, i += 1 ]
            g : Gap gaps[ i ]
            at : i32 [ 0 ]
            while [ at < out.count && starts[ at ] < g.start ] at += 1
            out.insert[ MapSeg [ gap: true, index: i ], at ]
            starts.insert[ g.start, at ]
        sizes : vec f32 []
        total : f32 [ 0.0 ]
        for [ m: MapSeg ] in out
            n : i64 [ 0 ]
            if [ m.gap ] n = gaps[ m.index ].bytes
            el n = dk.parts[ m.index ].bytes
            v : f32 [ f32[ f64[ n ] / f64[ dk.bytes ] ] ]
            if [ v < 0.03 ] v = 0.03
            sizes.push[ v ]
            total += v
        x : f32 [ 0.0 ]
        for [ i: i32 0, i < out.count, i += 1 ]
            out[ i ].x0 = x
            x += sizes[ i ] / total
            out[ i ].x1 = x
        return out

    # the area across the map from lo to hi (0..1)
    func span [ lo: f32, hi: f32 ] -> Region
        l : f32 [ lo * 100.0 ]
        r : f32 [ (1.0 - hi) * 100.0 ]
        return Region [ 'l{l.3f}% t0 r{r.3f}% b0' ]

    func render [] -> Elements
        t : Elements []
        if [ !dk ] return t
        gaps : disk_gaps[ dk ]
        for [ m: MapSeg ] in layout[]
            w : f32 [ m.x1 - m.x0 ]
            if [ m.gap ]
                g : Gap gaps[ m.index ]
                lb : string [ (w > 0.1) ? 'free  {size_text[ g.bytes ]}'
                    : '' ]
                t[ 'gap_{m.index}' ] = WizFree [ label: lb,
                    area: span[ m.x0, m.x1 ],
                    selected: mode == 2 && dk.shrink_at < 0
                        && dk.gap_at == m.index ]
                continue
            p : Part dk.parts[ m.index ]
            if [ p.free >= 0 && p.bytes > 0 ]
                used : f32 [ 1.0 - f32[ f64[ p.free ]
                    / f64[ p.bytes ] ] ]
                t[ 'used_{m.index}' ] = WizUsed [
                    area: span[ m.x0, m.x0 + w * used ] ]
            lb : string [ (w > 0.12)
                ? '{p.name}  {size_text[ p.shown[] ]}'
                : ((w > 0.05) ? '{p.number}' : '') ]
            on : bool [ (mode == 1 && m.index == part_at)
                || (mode == 2 && m.index == dk.shrink_at) ]
            ar : Region span[ m.x0, m.x1 ]
            k : 'part_{m.index}'
            if [ p.fs == 'ext4' ]
                t[ k ] = WizSeg [ label: lb, selected: on, area: ar ]
            el
                t[ k ] = WizSegOther [ label: lb, selected: on,
                                       area: ar ]
            if [ mode == 2 && m.index == dk.shrink_at && p.low >= 0 ]
                cut : f32 [ m.x0 + w * f32[ f64[ p.shown[] ]
                    / f64[ p.bytes ] ] ]
                if [ p.keep >= 0 ]
                    t[ 'freed' ] = WizFreed [ area: span[ cut, m.x1 ] ]
                at : f32 [ cut * 100.0 ]
                t[ 'edge' ] = WizEdge [
                    area: Region [ 'l{at.3f}%-2px t0 w4px b0' ] ]
        return t

    # the shrinking partition and its place on the map
    func shrinking [] -> MapSeg
        if [ mode != 2 || !dk || dk.shrink_at < 0 ] return null
        if [ dk.parts[ dk.shrink_at ].low < 0 ] return null
        for [ m: MapSeg ] in layout[]
            if [ !m.gap && m.index == dk.shrink_at ] return m
        return null

    func on_press [ ev: Event ]
        m : MapSeg shrinking[]
        if [ !m || !bounds ] return
        p : Part dk.parts[ m.index ]
        f : f32 [ f32[ f64[ p.shown[] ] / f64[ p.bytes ] ] ]
        x : f32 [ (m.x0 + (m.x1 - m.x0) * f) * bounds.w ]
        dx : f32 [ ev.mouse.pos.x - x ]
        if [ dx > 8.0 || dx < -8.0 ] return
        dragging = true
        ux.set_capture[ a ]
        ev.no_default     = true
        ev.no_propagation = true

    # the edge follows the pointer, a MB at a time, no lower
    # than what the partition holds
    func on_move [ ev: Event ]
        if [ !dragging ] return
        m : MapSeg shrinking[]
        if [ !m || !bounds ] return
        p : Part dk.parts[ m.index ]
        f : f32 [ (ev.mouse.pos.x / bounds.w - m.x0) / (m.x1 - m.x0) ]
        if [ f < 0.0 ] f = 0.0
        if [ f > 1.0 ] f = 1.0
        n : i64 [ (i64[ f64[ f ] * f64[ p.bytes ] ] / MIB) * MIB ]
        if [ n < p.low ] n = p.low
        p.keep = (n >= ((p.bytes / MIB) * MIB)) ? -1 : n
        pristine = false
        up : element parent
        while [ up && !(up inherits InstallWizard) ] up = up.parent
        if [ up ] up.pristine = false
        ux.will_animate = true
        ev.no_default   = true

    func on_release [ ev: Event ]
        if [ dragging ] ux.release_capture[ a ]
        dragging = false

# an installer being written: coral, eased toward the share
# written, a light sweeping across it on a beat
element WizBar
    animated : true
    public frac   : f32
    # written: the whole bar turns green
    public done   : bool
    intern shown  : f32
    # the sweep starts every period seconds, crosses in sweep
    intern period : f32 [ 4.0 ]
    intern sweep  : f32 [ 1.0 ]
    intern radius : f32 [ 6.0 ]
    intern reach  : f32 [ 234.0 ]
    # the fill's light reaches further than the track's
    intern fill_reach : f32 [ 1.4 ]

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        shown = filter_n[ shown, frac, 0.08, w.frame_factor ]
        cv : Canvas [ w.screen ]
        bw : f32 [ bounds.w ]
        bh : f32 [ bounds.h ]
        r  : f32 [ min[ radius, bh * 0.5 ] ]
        secs : f64 [ f64[ epoch_micros[] ] / 1000000.0 ]
        t  : f32 [ f32[ secs - floor[ secs / period ] * period ] ]
        # it enters and leaves a whole reach beyond each end, at the
        # speed that crosses the bar in sweep seconds
        out  : f32 [ reach * fill_reach ]
        span : f32 [ bw + 2.0 * out ]
        dur  : f32 [ sweep * span / max[ bw, 1.0 ] ]
        # written: the light rests
        lit : bool [ t < dur && !done ]
        sc : f32 [ cv.transform_scale[] ]
        at : f32 [ span * t / dur - out ]
        lx : f32 [ cv.transform_tx[] + at * sc ]
        ly : f32 [ cv.transform_ty[] + bh * 0.5 * sc ]
        glow : f32 [ (lit) ? 1.0 : 0.0 ]
        cv.save[]
        cv.near_light[ lx, ly, reach * sc, glow ]
        cv.box_shadow[ rgba[ '#ffb4a01a' ], 0.0, 0.0, 6.0, 0.0, true ]
        cv.near_style[ 1.0, 4.0, rgba[ '#ffd2c4cc' ], w.near_y_fade ]
        hue : string [ (done) ? '#4fd27a' : '#ff7a5c' ]
        cv.fill_color[ rgba[ '{hue}2e' ] ]
        cv.rounded_rect[ 0.0, 0.0, bw, bh, r, r, r, r ]
        cv.paint[]
        if [ shown > 0.001 ]
            cv.near_light[ lx, ly, reach * fill_reach * sc, glow ]
            cv.box_shadow[ rgba[ '#fff0e826' ], 0.0, 0.0, 6.0, 0.0,
                           true ]
            cv.near_style[ 1.0, 6.0, rgba[ '#fff4eeff' ],
                           w.near_y_fade ]
            cv.fill_color[ rgba[ hue ] ]
            cv.rounded_rect[ 0.0, 0.0, bw * shown, bh, r, r, r, r ]
            cv.paint[]
        cv.restore[]

# a password: the text is drawn as dots
TextInput WizSecret
    style : CSS {
        layers.face:
            label_color: #0000
        :focused
            layers.face:
                label_color: #0000
        :has_value
            layers.face:
                label_color: #0000
    }

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen || !bounds ] return
        if [ !edit || edit.count == 0 ] return
        dots : string ''
        for [ i: i32 0, i < edit.count, i += 1 ] dots = '{dots}•'
        cv : Canvas [ w.screen ]
        cv.font_size[ 18 ]
        cv.fill_color[ rgba [ '#ffffff' ] ]
        cv.draw_text[ dots, rect [ x: 14.0, y: 0.0,
            w: bounds.w - 28.0, h: bounds.h ],
            vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.clip,
            null ]
        cv.paint[]

# orbiter-os setup: the install's settings, then the install
element InstallWizard
    area : Region { l0 t0 r0 b0 }
    # every step listed and logged; nothing written
    public dry_run : bool
    # the tree that is copied: the running system
    public source  : string [ '/' ]
    mutable page    : i32
    # 0, the build, only where orbiter-os can be built
    mutable first_page : i32
    # page 0 goes on once the tree it is writing is done
    mutable advance    : bool
    # test: the A button lights the core's beam, tilted away
    mutable beam_test  : bool
    mutable cards   : vec Card
    # the hardware check: graphics and network, as orbiter-os sees
    mutable hw      : vec Hw
    mutable disks   : vec Disk
    mutable disk_at : i32 [ -1 ]
    mutable beside  : bool [ true ]
    mutable part_at : i32 [ -1 ]
    # into free space: a new partition there
    mutable fresh   : bool
    # swap: -2 not chosen (the default), -1 a file, else the
    # swap partition's place on the disk
    mutable swap_pick : i32 [ -2 ]
    # the user's ssh keys go to orbiter-os's /root/.ssh
    mutable keys_copy : bool
    # the boot line's swap word, made with the plan
    mutable swap_word : string
    # orbiter-os's partition's uuid: read, or given to mkfs
    mutable ruuid     : string
    mutable user    : string
    mutable pass    : string
    mutable again   : string
    mutable host    : string
    mutable keys    : string
    mutable zone    : string
    mutable plan     : vec Step
    # bytes the copy needs; -1 when the tree does not say
    mutable need     : i64 [ -1 ]
    mutable problems : vec string
    # what the review says that does not stop the install
    mutable notes    : vec string
    mutable boot     : BootKind
    # the install's thread and what it reports, under lock
    mutable lock     : mutex
    mutable lines    : vec string
    mutable running  : bool
    mutable finished : bool
    mutable failed   : bool
    mutable step_at  : i32
    mutable copied   : i64
    mutable total    : i64
    intern  tid      : pthread_t

    func init []
        cards = scan_cards[]
        disks = scan_disks[]
        lines = vec string []
        lock  = mutex []
        swap_word = ''
        ruuid = ''
        user  = ''
        pass  = ''
        again = ''
        host  = read_line[ '/etc/hostname' ]
        if [ host.count == 0 ] host = 'orbiter'
        keys  = 'us'
        zone  = read_line[ '/etc/timezone' ]
        if [ zone.count == 0 ] zone = 'UTC'
        # orbiter-os copies itself; from another system, the tree
        # os-bootstrap writes
        if [ source == '/' && !booted_os[] ] source = drive_tree[]
        need = copy_need[]
        scan_hw[]
        first_page = (bootstrap_here[]) ? 0 : 1
        page = first_page
        for [ c: Card ] in cards
            log 'wizard: card {c.title[]}: {c.detail[]}'
        for [ dk: Disk ] in disks
            log 'wizard: disk {dk.text[]}'

    # the tree's size as os-bootstrap wrote it, and a tenth more
    # for what the system writes as it runs
    func copy_need [] -> i64
        base : string [ (source == '/') ? '' : source ]
        tb : '{base}/boot/tree-bytes'
        n : i64 [ read_line[ tb ].integer_value[] ]
        if [ n <= 0 ] return -1
        return n + n / 10

    # where orbiter-os is: the tree being installed
    func hw_tree [] -> string
        return (source == '/') ? '' : source

    # running orbiter-os itself
    func booted_os [] -> bool
        cmd : read_line[ '/proc/cmdline' ]
        return cmd.index_of[ 'orbiter.init=' ] >= 0

    # graphics and network on the pci bus, network on usb: each
    # matched against orbiter-os's own modules and firmware
    func scan_hw []
        hw = vec Hw []
        tree : hw_tree[]
        rel : kernel_release[ tree ]
        al : vec string []
        md : '{tree}/lib/modules/{rel}'
        load_aliases[ '{md}/modules.alias', al ]
        load_aliases[ '{md}/modules.builtin.alias', al ]
        log 'wizard: checking against {tree}/lib/modules/{rel}'
        black : load_blacklist[ '{tree}/etc/modprobe.d' ]
        ids : '{tree}/usr/share/misc/pci.ids'
        idp : path [ ids ]
        if [ !idp.exists[] ] ids = '/usr/share/misc/pci.ids'
        inst : path.path_install[]
        icd_dirs : vec string [] [ '{tree}/usr/share/vulkan/icd.d',
                                   '{tree}{inst}/share/vulkan/icd.d' ]
        d : path '/sys/bus/pci/devices'
        entries : d.ls[ null, false ]
        if [ entries ]
            for [ e: path ] in entries
                cl : read_line[ '{e}/class' ]
                gfx : bool [ cl.starts_with[ '0x03' ] ]
                if [ !gfx && !cl.starts_with[ '0x02' ] ] continue
                v : hex_value[ read_line[ '{e}/vendor' ] ]
                dv : hex_value[ read_line[ '{e}/device' ] ]
                h : Hw [ graphics: gfx, name: pci_name[ ids, v, dv ],
                    kind: (gfx) ? 'Graphics'
                    : ((cl.starts_with[ '0x0280' ]) ? 'Wi-Fi'
                    : 'Wired network') ]
                # the vulkan name reads better than pci.ids'
                for [ c: Card ] in cards
                    if [ gfx && c.vendor == v && c.device == dv ]
                        h.name = c.name
                mods : drivers_for[ al, read_line[ '{e}/modalias' ],
                                    black ]
                h.driver = (mods.count > 0) ? mods[ 0 ] : ''
                if [ gfx && h.driver.count > 0 ]
                    # of its drivers, the one with a Vulkan driver
                    found : bool [ false ]
                    for [ m: string ] in mods
                        icd : icd_for[ m ]
                        for [ dir: string ] in icd_dirs
                            dp : path [ dir ]
                            files : dp.ls[ null, false ]
                            if [ !files || icd.count == 0 ] continue
                            for [ f: path ] in files
                                if [ !found && f.filename[].starts_with[
                                        icd ] ]
                                    found    = true
                                    h.driver = m
                    h.ok   = found
                    nv : 'not supported: no Vulkan driver'
                    h.note = (found) ? 'supported: {h.driver} driver'
                        : '{nv} for {h.driver}'
                el [ h.driver.count > 0 ]
                    h.ok   = true
                    h.note = 'supported: {h.driver} driver'
                el
                    h.note = 'not supported: orbiter-os has no driver'
                if [ h.ok ]
                    gap : firmware_gap[ tree, rel, h.driver ]
                    if [ gap.count > 0 ]
                        h.ok   = false
                        h.note = 'not supported: no firmware {gap}'
                hw.push[ h ]
        # usb network adapters, by their interfaces
        nd : path '/sys/class/net'
        nets : nd.ls[ null, false ]
        if [ nets ]
            for [ n: path ] in nets
                sub : last_name[ link_text[ '{n}/device/subsystem' ] ]
                if [ sub != 'usb' ] continue
                wl : path '{n}/wireless'
                h : Hw [ name: 'USB adapter {n.filename[]}',
                    kind: (wl.exists[]) ? 'Wi-Fi' : 'Wired network' ]
                ma : read_line[ '{n}/device/modalias' ]
                um : drivers_for[ al, ma, black ]
                h.driver = (um.count > 0) ? um[ 0 ] : ''
                h.ok   = h.driver.count > 0
                h.note = (h.ok) ? 'supported: {h.driver} driver'
                    : 'not supported: orbiter-os has no driver'
                if [ h.ok ]
                    gap : firmware_gap[ tree, rel, h.driver ]
                    if [ gap.count > 0 ]
                        h.ok   = false
                        h.note = 'not supported: no firmware {gap}'
                hw.push[ h ]
        # graphics first, then network
        by : vec Hw []
        for [ h: Hw ] in hw
            if [ h.graphics ] by.push[ h ]
        for [ h: Hw ] in hw
            if [ !h.graphics ] by.push[ h ]
        hw = by
        if [ al.count == 0 ]
            for [ h: Hw ] in hw
                h.ok   = false
                h.note = 'not checked: no orbiter-os module tree'
        for [ h: Hw ] in hw
            log 'wizard: {h.kind}: {h.name}: {h.note}'

    # the build page's element, while page 0 shows it
    func boot_el [] -> Bootstrap
        panel : element (elements) ? elements[ 'panel' ] : null
        if [ !panel || !panel.elements ] return null
        e : element panel.elements[ 'bootstrap' ]
        if [ !e || !(e inherits Bootstrap) ] return null
        return Bootstrap e

    # page 0 holds still while it builds; without a kernel only
    # shift+click goes on
    func boot_blocked [] -> bool
        bs : boot_el[]
        if [ page != 0 || !bs ] return false
        return bs.building || bs.kernels.count == 0

    # graphics to draw with and a way onto a network
    func hw_ok [] -> bool
        g : bool [ false ]
        n : bool [ false ]
        for [ h: Hw ] in hw
            if [ h.ok && h.graphics ] g = true
            if [ h.ok && !h.graphics ] n = true
        return g && n

    # a partition the folder will not fit on
    func too_small [ p: Part ] -> bool
        return need > 0 && p.free >= 0 && p.free < need

    func disk [] -> Disk
        if [ disk_at < 0 || disk_at >= disks.count ] return null
        return disks[ disk_at ]

    func part [] -> Part
        dk : disk[]
        if [ !dk || part_at < 0 || part_at >= dk.parts.count ]
            return null
        return dk.parts[ part_at ]

    # the disk's EFI system partition: its first FAT one
    func esp [] -> Part
        dk : disk[]
        if [ !dk ] return null
        for [ p: Part ] in dk.parts
            if [ p.fs == 'vfat' ] return p
        return null

    # swap partitions orbiter-os can use: the disk's own (none
    # when the whole disk is erased)
    func swap_parts [] -> vec i32
        out : vec i32 []
        dk : disk[]
        if [ !dk || (!beside && !fresh) ] return out
        for [ i: i32 0, i < dk.parts.count, i += 1 ]
            if [ dk.parts[ i ].fs == 'swap' ] out.push[ i ]
        return out

    # the swap orbiter-os uses: the one picked, else the largest
    # swap partition when it holds what this machine wants, else
    # a file (-1)
    func swap_choice [] -> i32
        parts : swap_parts[]
        if [ swap_pick == -1 || parts.contains[ swap_pick ] ]
            return swap_pick
        dk : disk[]
        best : i32 [ -1 ]
        for [ i: i32 ] in parts
            n : i64 [ dk.parts[ i ].bytes ]
            if [ best < 0 || n > dk.parts[ best ].bytes ] best = i
        want : i64 [ (swap_want[] * 9) / 10 ]
        if [ best >= 0 && dk.parts[ best ].bytes >= want ] return best
        return -1

    # the account page's keys row: what Install does with them
    func keys_text [] -> string
        n : i32 ssh_keys[]
        if [ n == 0 ] return 'SSH keys: none in {ssh_dir[]}'
        what : string [ (n == 1) ? 'your key' : 'your {n} keys' ]
        if [ keys_copy ] return 'SSH keys: copy {what} to orbiter-os'
        return 'SSH keys: leave {what} out'

    func swap_text [] -> string
        at : i32 swap_choice[]
        if [ at < 0 ]
            n : size_text[ swap_want[] ]
            return 'Swap: a {n} file in orbiter-os'
        p : Part disk[].parts[ at ]
        small : string [ (p.bytes < (swap_want[] * 9) / 10)
            ? ', small for {size_text[ ram_bytes[] ]} of memory' : '' ]
        n : size_text[ p.bytes ]
        return 'Swap: the {p.name} partition, {n}{small}'

    # what the new partition must hold: the tree, and a swap file
    func space_need [] -> i64
        n : i64 [ (need > 0) ? need : 4 * GIB ]
        if [ swap_choice[] < 0 ] n += swap_want[]
        return n

    # why this page cannot go on; '' when it can
    func why [] -> string
        if [ page == 1 && !hw_ok[] ]
            un : 'orbiter-os does not support all of this yet.'
            return '{un} Shift+click Continue to go on anyway.'
        if [ page == 2 && !disk[] ] return 'Choose a disk.'
        if [ page == 3 ]
            dk : disk[]
            if [ !beside && dk.running && !dry_run ]
                return 'The system runs from this disk: erase another.'
            if [ beside ]
                pt : part[]
                if [ !pt ] return 'Choose the partition for the folder.'
                if [ pt.fs != 'ext4' && !dry_run ]
                    return 'The folder needs an ext4 partition.'
                if [ !esp[] ] return 'This disk has no EFI partition.'
            if [ fresh ]
                if [ !esp[] ] return 'This disk has no EFI partition.'
                if [ dk.shrink_at >= 0 ]
                    sp : Part dk.parts[ dk.shrink_at ]
                    if [ sp.low < 0 ]
                        nc : 'It cannot shrink: it is in use, or not'
                        return '{nc} ext4 or NTFS.'
                el [ dk.gap_at < 0 ]
                    pk : 'Choose free space on the map, or a partition'
                    return '{pk} to shrink.'
                room : free_place[ dk ]
                want : i64 space_need[]
                if [ room.bytes < want ]
                    if [ dk.shrink_at >= 0 ]
                        dg : 'Drag its edge left to free'
                        return '{dg} {size_text[ want ]}.'
                    return 'It needs {size_text[ want ]} of free space.'
        if [ page == 4 ]
            if [ user.count == 0 ] return 'Give a user name.'
            for [ i: i32 0, i < user.count, i += 1 ]
                ch : i32 [ user.chars[ i ] ]
                ok : bool [ (ch >= 97 && ch <= 122)
                    || (ch >= 48 && ch <= 57 && i > 0) ]
                if [ !ok ]
                    return 'A user name is small letters and digits.'
            if [ pass.count == 0 ] return 'Give a password.'
            if [ pass != again ] return 'The two passwords differ.'
            if [ host.count == 0 ] return 'Give the computer a name.'
        return ''

    # the shell's crypt with a sha-512 salt from the kernel
    func pass_hash [] -> string
        low : 'abcdefghijklmnopqrstuvwxyz'
        abc : '{low}{low.ucase[]}0123456789./'
        rnd : read_at[ '/dev/urandom', 0, 16 ]
        salt : string '$6$'
        for [ i: i32 0, i < rnd.count, i += 1 ]
            k : i32 [ rnd[ i ] % 64 ]
            salt = '{salt}{abc.mid[ k, 1 ]}'
        salt = '{salt}$'
        h : cstr [ crypt[ pass.chars, salt.chars ] ]
        return (h) ? string [ h ] : ''

    # the boot line: this system's own, for the new place
    # the kernel's options; efi: the stub loads the initramfs
    func boot_line [ uuid: string, root: string,
                     efi: bool ] -> string
        line : read_line[ '/proc/cmdline' ]
        drop : vec string [] [ 'BOOT_IMAGE=', 'root=', 'initrd=',
            'orbiter.uuid=', 'orbiter.root=', 'orbiter.args=',
            'orbiter.swap=', 'vt.handoff=', 'resume=' ]
        out : 'orbiter.uuid={uuid} orbiter.root={root}'
        if [ efi ] out = 'initrd=\\EFI\\orbiter\\initramfs {out}'
        if [ swap_word.count > 0 ] out = '{out} {swap_word}'
        # from another system: orbiter-os's own words, not its
        if [ !booted_os[] ]
            rel : kernel_release[ source ]
            nv : path '{source}/lib/modules/{rel}/extra/nvidia-drm.ko'
            return '{out} console=tty0 {os_words[ false, nv.exists[] ]}'
        for [ w: string ] in line.split[ ' ' ]
            word : '{w}'
            if [ word.count == 0 || word == 'ro' || word == 'rw'
                 || word == 'quiet' || word == 'splash' ] continue
            gone : bool [ false ]
            for [ d: string ] in drop
                if [ word.starts_with[ d ] ] gone = true
            if [ !gone ] out = '{out} {word}'
        return out

    func step [ kind: StepKind, title: string ] -> Step
        s : Step [ kind: kind, title: title ]
        plan.push[ s ]
        return s

    # orbiter.root: the folder on the partition, or all of it
    func root_dir [] -> string
        return (beside) ? '/orbiter-os' : '/'

    # the tree's place on its partition, for a menu's paths
    func tree_rel [] -> string
        return (beside) ? '/orbiter-os' : ''

    # the menu file a boot manager reads; tree: the folder
    func menu_text [ k: BootKind, uuid: string, root: string,
                     tree: string ] -> string
        opts : boot_line[ uuid, root, false ]
        kern : '{tree}/boot/vmlinuz'
        rd   : '{tree}/boot/initramfs'
        if [ k == BootKind.systemd_boot || k == BootKind.grub_bls ]
            if [ k == BootKind.systemd_boot ]
                kern = '/EFI/orbiter/vmlinuz.efi'
                rd   = '/EFI/orbiter/initramfs'
            t : 'title   orbiter-os\nlinux   {kern}\n'
            return '{t}initrd  {rd}\noptions {opts}\n'
        if [ k == BootKind.refind ]
            efi : boot_line[ uuid, root, true ]
            return '"orbiter-os" "{efi}"\n'
        if [ k == BootKind.grub_debian ]
            t : '#!/bin/sh\nexec tail -n +3 $0\n'
            t = '{t}menuentry \'orbiter-os\' {{\n'
            sr : 'search --no-floppy --fs-uuid --set=root'
            t = '{t}    {sr} {uuid}\n'
            t = '{t}    linux  {kern} {opts}\n'
            return '{t}    initrd {rd}\n}}\n'
        return ''

    # a partition's files: where it is mounted, else mounted
    # read-only at a place of ours; '' when neither works
    func look_at [ dev: string, fs: string, at: string ] -> string
        m : mounted_at[ dev ]
        if [ m.count > 0 ] return m
        mp : path [ at ]
        mp.make_dir[]
        if [ mount[ dev.chars, at.chars, fs.chars, MS_RDONLY,
                    null ] == 0 ]
            return at
        return ''

    # the boot manager this disk starts, as the review shows it
    func find_boot [ espd: string, rootd: string ] -> BootKind
        efv : path '/sys/firmware/efi/efivars'
        if [ efv.is_empty[] ]
            mount[ 'efivarfs', efv.chars, 'efivarfs', 0, null ]
        ld : default_loader[ capture[ 'efibootmgr' ] ]
        es : look_at[ espd, 'vfat', '/run/wizard/look-efi' ]
        rs : look_at[ rootd, 'ext4', '/run/wizard/look-root' ]
        k : detect_boot[ ld, es, rs ]
        log 'wizard: default loader {ld}, efi {es}, root {rs}'
        for [ d: string ] in vec string [] [ '/run/wizard/look-efi',
                '/run/wizard/look-root' ]
            if [ es == d || rs == d ] umount2[ d.chars, 0 ]
        return k

    # a partition made smaller to free its end: its file system
    # first (checked, then shrunk), then its entry in the table
    func shrink [ dk: Disk, p: Part ]
        d : '/dev/{p.name}'
        dev : '/dev/{dk.name}'
        kb : i64 [ p.keep / 1024 ]
        if [ p.fs == 'ext4' ]
            s : step[ StepKind.run, 'Check {d}' ]
            s.cmd = 'e2fsck -f -y {d}; test $? -le 1'
            s = step[ StepKind.run,
                      'Shrink {d}\'s files to {size_text[ p.keep ]}' ]
            s.cmd = 'resize2fs {d} {kb}K'
        el
            s : step[ StepKind.run,
                      'Shrink {d}\'s files to {size_text[ p.keep ]}' ]
            s.cmd = 'echo y | ntfsresize --force --size {p.keep} {d}'
        s : step[ StepKind.run,
                  'Shrink {d} to {size_text[ p.keep ]} in the table' ]
        sf : 'sfdisk --no-reread -N {p.number} {dev}'
        s.cmd = 'echo \',{kb}KiB\' | {sf}'

    # the number sfdisk gives a partition it appends: the least
    # one not in use
    func free_number [ dk: Disk ] -> i32
        n : i32 [ 1 ]
        taken : bool [ true ]
        while [ taken ]
            taken = false
            for [ p: Part ] in dk.parts
                if [ p.number == n ] taken = true
            if [ taken ] n += 1
        return n

    # a Linux already on the disk: the first ext4 that says what
    # it holds (its boot menu takes orbiter-os)
    func linux_part [ dk: Disk ] -> Part
        for [ p: Part ] in dk.parts
            if [ p.fs == 'ext4' && p.what.count > 0
                 && p.what != 'has orbiter-os' ] return p
        return null

    # the whole install as steps; problems that stop it
    func make_plan []
        plan     = vec Step []
        problems = vec string []
        notes    = vec string []
        boot     = BootKind.none
        dk : disk[]
        if [ !dk ] return
        tools : vec string [] [ 'sfdisk', 'mkfs.vfat', 'mkfs.ext4',
            'efibootmgr', 'fallocate', 'mkswap', 'partx', 'tar' ]
        # as a user, the steps run as root through pkexec's prompt
        if [ geteuid[] != 0 ] tools.push[ 'pkexec' ]
        if [ fresh && dk.shrink_at >= 0 ]
            if [ dk.parts[ dk.shrink_at ].fs == 'ext4' ]
                tools.push[ 'resize2fs' ]
                tools.push[ 'e2fsck' ]
            el
                tools.push[ 'ntfsresize' ]
        for [ t: string ] in tools
            if [ find_tool[ t ].count == 0 ]
                problems.push[ 'Missing program: {t}' ]
        efi_dir : path '/sys/firmware/efi'
        if [ !efi_dir.exists[] ]
            problems.push[ 'This machine did not start with UEFI.' ]
        base : string [ (source == '/') ? '' : source ]
        kern : '{base}/boot/vmlinuz'
        rd   : '{base}/boot/initramfs'
        for [ f: string ] in vec string [] [ kern, rd ]
            fp : path [ f ]
            if [ !fp.exists[] ] problems.push[ 'Missing {f}' ]
        mnt  : '/run/wizard/root'
        efi  : '/run/wizard/efi'
        dev  : '/dev/{dk.name}'
        espn : i32 [ 1 ]
        rdev : string ''
        tree : string ''
        root : string ''
        # where an existing Linux keeps its boot menu, mounted
        lmnt : string [ mnt ]
        if [ fresh ]
            es : esp[]
            espn = es.number
            place : free_place[ dk ]
            num : free_number[ dk ]
            rdev = part_dev[ dk.name, num ]
            lp : linux_part[ dk ]
            ld : string ''
            if [ lp ] ld = '/dev/{lp.name}'
            boot = find_boot[ '/dev/{es.name}', ld ]
            notes.push[ 'Boot manager: {boot_name[ boot ]}' ]
            tree = mnt
            root = '/'
            sp : Part null
            if [ dk.shrink_at >= 0 ] sp = dk.parts[ dk.shrink_at ]
            if [ sp && sp.keep >= 0 ]
                shrink[ dk, sp ]
                sw : 'Shrinking moves {sp.name}\'s data inside it:'
                notes.push[ '{sw} back it up first.' ]
            sec : i64 [ 512 ]
            pn : size_text[ place.bytes ]
            s : step[ StepKind.run, 'Make {rdev}: {pn} of free space' ]
            ln : 'start={place.start / sec}, size={place.bytes / sec},'
            ln = '{ln} type=L, name=orbiter'
            sf : 'sfdisk --no-reread -N {num} {dev}'
            s.cmd = 'echo \'{ln}\' | {sf}'
            s = step[ StepKind.run, 'Read {dev}\'s new table' ]
            s.cmd = 'partx -u {dev}; partx -a {dev}; true'
            s = step[ StepKind.wait, 'Wait for {rdev}' ]
            s.src = rdev
            s.dst = rdev
            ruuid = read_line[ '/proc/sys/kernel/random/uuid' ]
            s = step[ StepKind.run, 'Format {rdev} as ext4' ]
            s.cmd = 'mkfs.ext4 -F -L orbiter-os -U {ruuid} {rdev}'
            s = step[ StepKind.mount, 'Mount {rdev}' ]
            s.src = rdev
            s.dst = mnt
            s.fs  = 'ext4'
            if [ lp ] lmnt = '/run/wizard/linux'
        el [ beside ]
            pt : part[]
            es : esp[]
            espn = es.number
            rdev = '/dev/{pt.name}'
            ruuid = part_uuid[ rdev ]
            boot = find_boot[ '/dev/{es.name}', rdev ]
            notes.push[ 'Boot manager: {boot_name[ boot ]}' ]
            tree = '{mnt}/orbiter-os'
            root = '/orbiter-os'
            # one there already is replaced; never the source
            here : mounted_at[ rdev ]
            old : path '{here}/orbiter-os'
            if [ here.count > 0 && (old.exists[] || old.is_symlink[]) ]
                rp : path [ source ]
                lk : '/orbiter-os, a link, is replaced by the copy.'
                same : '/orbiter-os is the tree being copied.'
                over : '/orbiter-os is there: it is copied over.'
                if [ old.is_symlink[] ] notes.push[ lk ]
                el [ '{old.normalize[]}' == '{rp.normalize[]}' ]
                    problems.push[ same ]
                el notes.push[ over ]
            s : step[ StepKind.mount, 'Mount {rdev}' ]
            s.src = rdev
            s.dst = mnt
            s.fs  = 'ext4'
        el
            rdev = part_dev[ dk.name, 2 ]
            tree = mnt
            root = '/'
            esd : part_dev[ dk.name, 1 ]
            s : step[ StepKind.write, 'Write the partition table' ]
            s.dst  = '/run/wizard/layout.sfdisk'
            lay : 'label: gpt\n'
            lay = '{lay}size=512MiB, type=U, name=orbiter-efi\n'
            s.text = '{lay}type=L, name=orbiter\n'
            et : 'Erase {dev}: EFI 512 MB, the rest for orbiter-os'
            s = step[ StepKind.run, et ]
            s.cmd = 'sfdisk --wipe always --wipe-partitions always'
            s.cmd = '{s.cmd} {dev} < /run/wizard/layout.sfdisk'
            s = step[ StepKind.wait, 'Wait for {esd} and {rdev}' ]
            s.src = esd
            s.dst = rdev
            s = step[ StepKind.run, 'Format {esd} as FAT32' ]
            s.cmd = 'mkfs.vfat -F 32 -n ORBITER {esd}'
            ruuid = read_line[ '/proc/sys/kernel/random/uuid' ]
            s = step[ StepKind.run, 'Format {rdev} as ext4' ]
            s.cmd = 'mkfs.ext4 -F -L orbiter-os -U {ruuid} {rdev}'
            s = step[ StepKind.mount, 'Mount {rdev}' ]
            s.src = rdev
            s.dst = mnt
            s.fs  = 'ext4'
        s : step[ StepKind.copy, 'Copy orbiter-os to {rdev}' ]
        s.src = source
        s.dst = tree
        sw : i32 swap_choice[]
        su : string ''
        if [ sw >= 0 ] su = part_uuid[ '/dev/{dk.parts[ sw ].name}' ]
        if [ su.count > 0 ]
            swap_word = 'orbiter.swap=UUID={su}'
            notes.push[ 'Swap: the {dk.parts[ sw ].name} partition' ]
        el
            n : i64 [ swap_want[] ]
            swap_word = 'orbiter.swap=/swapfile'
            st : 'Make the swap file: {size_text[ n ]}'
            s = step[ StepKind.run, st ]
            f : '{tree}/swapfile'
            s.cmd = 'fallocate -l {n} {f} && chmod 600 {f}'
            s.cmd = '{s.cmd} && mkswap {f}'
        s = step[ StepKind.write, 'Write the settings' ]
        s.dst  = '{tree}/var/lib/orbiter/install.agi'
        s.text = 'user: {user}\npassword: \'{pass_hash[]}\'\n'
        s.text = '{s.text}host: {host}\nkeyboard: {keys}\n'
        s.text = '{s.text}zone: {zone}\n'
        s = step[ StepKind.write, 'Name the computer {host}' ]
        s.dst  = '{tree}/etc/hostname'
        s.text = '{host}\n'
        if [ keys_copy && ssh_keys[] > 0 ]
            s = step[ StepKind.run, 'Copy your SSH keys' ]
            to : sh_word[ '{tree}/root/.ssh' ]
            s.cmd = ssh_copy_sh[ sh_word[ ssh_dir[] ], to ]
            s.cmd = '{s.cmd} && chown -R 0:0 {to}'
        if [ boot == BootKind.grub_debian || boot == BootKind.grub_bls ]
            lp : Part linux_part[ dk ]
            if [ fresh && lp ]
                s = step[ StepKind.mount, 'Mount /dev/{lp.name}' ]
                s.src = '/dev/{lp.name}'
                s.dst = lmnt
                s.fs  = 'ext4'
            mt : string [ (boot == BootKind.grub_debian)
                ? '{lmnt}/etc/grub.d/41_orbiter-os'
                : '{lmnt}/loader/entries/orbiter-os.conf' ]
            if [ boot == BootKind.grub_bls ]
                sub : path '{lmnt}/boot/loader/entries'
                own : path '{lmnt}/loader/entries'
                if [ !own.is_dir[] && sub.is_dir[] ]
                    mt = '{lmnt}/boot/loader/entries/orbiter-os.conf'
            s = step[ StepKind.menu, 'Add orbiter-os to GRUB\'s menu' ]
            s.src  = rdev
            s.dst  = mt
            s.menu = boot
            s.exec = boot == BootKind.grub_debian
            if [ fresh && lp ]
                s = step[ StepKind.unmount, 'Unmount /dev/{lp.name}' ]
                s.dst = lmnt
        esd : part_dev[ dk.name, espn ]
        s = step[ StepKind.mount, 'Mount {esd}' ]
        s.src = esd
        s.dst = efi
        s.fs  = 'vfat'
        s = step[ StepKind.file, 'Copy the kernel to EFI' ]
        s.src = kern
        s.dst = '{efi}/EFI/orbiter/vmlinuz.efi'
        s = step[ StepKind.file, 'Copy the initramfs to EFI' ]
        s.src = rd
        s.dst = '{efi}/EFI/orbiter/initramfs'
        if [ boot == BootKind.systemd_boot || boot == BootKind.refind ]
            mt : string [ (boot == BootKind.refind)
                ? '{efi}/EFI/orbiter/refind_linux.conf'
                : '{efi}/loader/entries/orbiter-os.conf' ]
            s = step[ StepKind.menu,
                      'Add orbiter-os to {boot_name[ boot ]}\'s menu' ]
            s.src  = rdev
            s.dst  = mt
            s.menu = boot
        s = step[ StepKind.unmount, 'Unmount {esd}' ]
        s.dst = efi
        s = step[ StepKind.mount, 'Mount the EFI variables' ]
        s.src = 'efivarfs'
        s.dst = '/sys/firmware/efi/efivars'
        s.fs  = 'efivarfs'
        keep_boot : bool [ beside || fresh ]
        bt : string [ 'Add orbiter-os to the boot menu, first' ]
        if [ keep_boot ]
            bt = 'Add orbiter-os to the boot menu; the default stays'
        s = step[ StepKind.boot, bt ]
        s.src    = rdev
        s.dst    = root
        s.second = keep_boot
        mk : string [ (keep_boot) ? '--create-only' : '--create' ]
        s.cmd = 'efibootmgr {mk} --disk {dev} --part {espn}'
        s.cmd = '{s.cmd} --label orbiter-os'
        s.cmd = '{s.cmd} --loader \'\\EFI\\orbiter\\vmlinuz.efi\''
        s = step[ StepKind.unmount, 'Unmount {rdev}' ]
        s.dst = mnt
        if [ boot == BootKind.grub_debian ]
            notes.push[ 'GRUB lists it after: sudo update-grub' ]
        el [ boot == BootKind.windows || boot == BootKind.unknown ]
            fw : 'orbiter-os is in the firmware boot menu only.'
            notes.push[ fw ]
        for [ st: Step ] in plan
            log 'wizard: plan: {st.title}'
            if [ st.kind == StepKind.menu ]
                mx : menu_text[ st.menu, ruuid, root, tree_rel[] ]
                log 'wizard:   {st.dst}:\n{mx}'
            if [ st.cmd.count > 0 ] log 'wizard:   {st.cmd}'
            if [ st.kind == StepKind.boot ]
                bl : boot_line[ ruuid, root, true ]
                log 'wizard:   --unicode \'{bl}\''
        # a dry run shows the script an install would run
        if [ dry_run ]
            for [ ln: string ] in script_text[ plan ].split[ '\n' ]
                log 'wizard: sh: {ln}'
        for [ p: string ] in problems
            log 'wizard: problem: {p}'
        for [ n: string ] in notes
            log 'wizard: note: {n}'

    # the worker's word: logged, and the last lines shown
    func say [ s: string ]
        log 'wizard: {s}'
        lock.lock[]
        lines.push[ s ]
        lock.unlock[]

    # a command's output lines, not logged
    func capture [ cmd: string ] -> vec string
        out : vec string []
        full : '{cmd} 2>/dev/null'
        fh_cmd : command [ full ]
        fh : handle fh_cmd.stream[]
        if [ !fh ] return out
        b : local i8 [ 4096 ]
        while [ fgets[ @b[0], 4096, fh ] ]
            ln : string [ @b[0] ]
            out.push[ ln.trim[] ]
        pclose[ fh ]
        return out

    func file_size [ f: string ] -> i64
        fh : handle fopen[ f.chars, 'rb' ]
        if [ !fh ] return 0
        fseek[ fh, 0, SEEK_END ]
        n : i64 [ ftell[ fh ] ]
        fclose[ fh ]
        return n

    # the kernel's own trees: made empty, never copied
    func outside [ s: string ] -> bool
        for [ d: string ] in vec string [] [ 'proc', 'sys', 'dev',
                'run', 'tmp', 'lost+found' ]
            if [ s == '{source}/{d}' || s == '/{d}' ] return true
        return false

    func tree_bytes [ src: string ] -> i64
        d : path [ src ]
        entries : d.ls[ null, false ]
        n : i64 [ 0 ]
        if [ !entries ] return 0
        for [ e: path ] in entries
            s : '{e}'
            if [ outside[ s ] || e.is_symlink[] ] continue
            if [ e.is_dir[] ] n += tree_bytes[ s ]
            el n += file_size[ s ]
        return n

    # a word for sh: in '', each ' as '\''
    func sh_word [ t: string ] -> string
        out : string ''
        for [ i: i32 0, i < t.count, i += 1 ]
            ch : t.mid[ i, 1 ]
            out = (ch == '\'') ? '{out}\'\\\'\'' : '{out}{ch}'
        return '\'{out}\''

    # one step as sh lines (no braces: they would interpolate)
    func step_sh [ s: Step ] -> string
        if [ s.kind == StepKind.run ] return s.cmd
        src : sh_word[ s.src ]
        dst : sh_word[ s.dst ]
        if [ s.kind == StepKind.wait ]
            ok : '[ -e {src} ] && [ -e {dst} ]'
            w : 'i=0; while [ $i -lt 100 ]; do'
            w = '{w} {ok} && break; sleep 0.1; i=$((i+1)); done'
            return '{w}; {ok}'
        if [ s.kind == StepKind.mount ]
            # efivarfs is often there already
            m : 'mount -t {s.fs} {src} {dst} || mountpoint -q {dst}'
            return 'mkdir -p {dst} && ( {m} )'
        if [ s.kind == StepKind.unmount ] return 'sync && umount {dst}'
        if [ s.kind == StepKind.copy ]
            # a link there goes: the copy takes its place, never
            # the tree it points at; the kernel's trees go empty
            ex : string ''
            for [ d: string ] in vec string [] [ 'proc', 'sys', 'dev',
                    'run', 'tmp', 'lost+found' ]
                ex = '{ex} {sh_word[ '--exclude=./{d}/*' ]}'
            bad : '/run/wizard/copy.bad'
            pr : sh_word[ '--checkpoint-action=echo=@copied %u' ]
            c : '( [ -L {dst} ] && rm -f {dst}; mkdir -p {dst} )'
            c = '{c} && rm -f {bad} && ( tar -C {src}{ex}'
            c = '{c} --checkpoint=100 {pr} -cf - . || touch {bad} )'
            c = '{c} | tar -C {dst} --no-same-owner -xpf -'
            return '{c} && [ ! -e {bad} ]'
        made : 'mkdir -p "$(dirname {dst})"'
        if [ s.kind == StepKind.file ]
            return '{made} && cp --preserve=mode,timestamps {src} {dst}'
        text : string [ s.text ]
        runs : bool [ s.exec ]
        if [ s.kind == StepKind.menu ]
            text = menu_text[ s.menu, ruuid, root_dir[], tree_rel[] ]
        if [ s.kind == StepKind.write || s.kind == StepKind.menu ]
            w : '{made} && printf %s {sh_word[ text ]} > {dst}'
            # rwxr-xr-x: GRUB runs its scripts
            return (runs) ? '{w} && chmod 755 {dst}' : w
        if [ s.kind == StepKind.boot ]
            bl : boot_line[ ruuid, s.dst, true ]
            c : '{s.cmd} --unicode {sh_word[ bl ]}'
            return (s.second) ? 'boot_second {c}' : c
        return 'false'

    # the script's start: its folder, and boot_second, which runs
    # the entry's command and puts the new entry second (the
    # firmware's default stays first)
    func sh_head [] -> string
        hx : '[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f]'
        ids : 'efibootmgr | sed -n \'s/^Boot\\({hx}\\)[* ].*/\\1/p\''
        h : 'set -u\nmkdir -p /run/wizard\n'
        h = '{h}boot_second() (\n'
        h = '{h}  before=" $({ids} | tr \'\\n\' \' \') "\n'
        h = '{h}  "$@" || exit 1\n  new=\'\'\n'
        h = '{h}  for id in $({ids}); do\n'
        h = '{h}    case "$before" in *" $id "*) ;;'
        h = '{h} *) new=$id ;; esac\n'
        h = '{h}  done\n  if [ -z "$new" ]; then\n'
        h = '{h}    echo \'The new boot entry was not found.\''
        h = '{h}; exit 1\n'
        h = '{h}  fi\n'
        h = '{h}  o=$(efibootmgr | sed -n \'s/^BootOrder: //p\')\n'
        h = '{h}  if [ -z "$o" ]; then efibootmgr --bootorder "$new"; '
        h = '{h}exit; fi\n'
        h = '{h}  first=$(echo "$o" | cut -d, -f1)\n'
        h = '{h}  rest=$(echo "$o" | tr \',\' \'\\n\' | sed 1d '
        h = '{h}| grep -vx "$new" | paste -sd, -)\n'
        h = '{h}  if [ -n "$rest" ]; then rest=",$rest"; fi\n'
        h = '{h}  efibootmgr --bootorder "$first,$new$rest"\n)\n'
        return h

    # the plan as one script: each step says it starts, and where
    # it stopped when it fails
    func script_text [ steps: vec Step ] -> string
        t : sh_head[]
        for [ i: i32 0, i < steps.count, i += 1 ]
            one : step_sh[ steps[ i ] ]
            t = '{t}echo @step {i}\nif ! ( {one} ); then '
            t = '{t}echo @fail {i}; exit 1; fi\n'
        return '{t}echo @done\n'

    # runs a script (how: sh, or pkexec sh), following its word:
    # the step it is on, bytes copied, the step it stopped at
    func run_script [ f: string, how: string ]
        fh_cmd : command [ '{how} {f} 2>&1' ]
        fh : handle fh_cmd.stream[]
        if [ !fh ]
            failed = true
            say[ 'The install could not start.' ]
            return
        b : local i8 [ 4096 ]
        # tar's records are 20 blocks of 512 bytes
        block : i64 [ 10240 ]
        while [ fgets[ @b[0], 4096, fh ] ]
            ln : string [ @b[0] ]
            t : ln.trim[]
            cp : i32 [ t.index_of[ '@copied ' ] ]
            if [ cp >= 0 ]
                n : t.mid[ cp + 8, t.count - cp - 8 ]
                copied = n.integer_value[] * block
                continue
            if [ t.starts_with[ '@step ' ] ]
                step_at = t.mid[ 6, t.count - 6 ].integer_value[]
                if [ step_at < plan.count ] say[ plan[ step_at ].title ]
                continue
            if [ t.starts_with[ '@fail ' ] ]
                failed = true
                k : i32 [ t.mid[ 6, t.count - 6 ].integer_value[] ]
                if [ k < plan.count ]
                    say[ 'Stopped at: {plan[ k ].title}' ]
                continue
            if [ t == '@done' ] continue
            say[ t ]
        st : i32 [ pclose[ fh ] ]
        if [ st != 0 && !failed ]
            failed = true
            no : 'The install did not run: the password was not given.'
            say[ no ]

    # the plan's script, in the install's own scratch folder
    func write_script [ steps: vec Step ] -> string
        f : '{path.path_install[]}/tmp/install-{getpid[]}.sh'
        fh : handle fopen[ f.chars, 'w' ]
        if [ !fh ] return ''
        fputs[ script_text[ steps ].chars, fh ]
        fclose[ fh ]
        return f

    # the install, on its own thread: as root (orbiter-os from the
    # stick) the script runs as it is; as a user, through pkexec,
    # which asks for the password once
    func work [] -> none
        # from another system the copy is the drive tree: bring it
        # up to the last build first (only newer files are copied)
        if [ source == drive_tree[] ]
            say[ 'Updating the drive tree from the build' ]
            b : Bootstrap []
            b.initialize[]
            b.out_dir.make_dir[]
            b.assemble[]
        for [ st: Step ] in plan
            if [ st.kind == StepKind.copy ] total = tree_bytes[ st.src ]
        copied = 0
        f : write_script[ plan ]
        if [ f.count == 0 ]
            failed = true
            say[ 'The install script could not be written.' ]
        el
            how : string [ (geteuid[] == 0) ? 'sh' : 'pkexec sh' ]
            run_script[ f, how ]
            unlink[ f.chars ]
        # stopped: the bar stays at the step that failed
        if [ !failed ] step_at = plan.count
        finished = true
        running  = false
        Au.auto_free[]

    func start []
        if [ running || finished || dry_run ] return
        running = true
        pthread_create[ @tid, null, @work, a ]

    public func on_click [ ev: Event ]
        e : cast element [ ev.origin ]
        # a cell's click is its row's
        while [ e && e inherits ListCell ] e = e.parent
        if [ !e || !e.id ] return
        key : e.id
        if [ key == 'back' && page > first_page && !running ]
            page -= 1
        el [ key == 'cancel_build' ]
            bs : boot_el[]
            if [ bs ] bs.cancel[]
        el [ key == 'next' && page == 0 ]
            bs : boot_el[]
            over : bool [ ev.key.shift || ev.key.meta ]
            if [ bs && bs.building ] return
            if [ bs && bs.kernels.count == 0 && !over ] return
            # the tree takes the chosen kernel first, then on; a
            # dry run writes nothing
            if [ bs && bs.kernels.count > 0 && !bs.ready[]
                 && bs.can_build[] && !dry_run ]
                bs.start[ 'tree' ]
                advance = true
            el
                page += 1
        el [ key == 'next' && (why[].count == 0 || (page == 1
             && (ev.key.shift || ev.key.meta))) ]
            page += 1
            if [ page == 5 ] make_plan[]
        el [ key == 'install' && problems.count == 0 ]
            page = 6
            start[]
        el [ key == 'beam_test' ]
            beam_test = !beam_test
        el [ key == 'restart' ]
            sync[]
            # a user may not call reboot: ask the system's own
            if [ geteuid[] == 0 ]
                reboot[ RB_AUTOBOOT ]
            el
                sys : command [ 'systemctl reboot' ]
                if [ sys.exec[ false ] != 0 ]
                    log 'restart: systemctl reboot refused'
        el [ key == 'whole' ]
            beside = false
            fresh  = false
        el [ key == 'beside' ]
            beside = true
            fresh  = false
        el [ key == 'fresh' ]
            beside = false
            fresh  = true
        el [ key == 'ssh_keys' ]
            keys_copy = !keys_copy
        el [ key == 'swap' ]
            # round the choices: the file, then each partition
            opts : vec i32 [] [ -1 ]
            for [ i: i32 ] in swap_parts[]
                opts.push[ i ]
            now : i32 [ opts.index_of[ swap_choice[] ] ]
            swap_pick = opts[ (now + 1) % opts.count ]
        el [ key.starts_with[ 'disk_' ] ]
            at : i32 [ key.mid[ 5, key.count - 5 ].integer_value[] ]
            if [ at != disk_at ]
                part_at = -1
                swap_pick = -2
            disk_at = at
        el [ key.starts_with[ 'part_' ] && fresh ]
            # a partition to shrink; again: let go of it
            dk : disk[]
            at : i32 [ key.mid[ 5, key.count - 5 ].integer_value[] ]
            for [ p: Part ] in dk.parts
                p.keep = -1
            dk.shrink_at = (dk.shrink_at == at) ? -1 : at
            dk.gap_at = -1
        el [ key.starts_with[ 'part_' ] ]
            part_at = key.mid[ 5, key.count - 5 ].integer_value[]
        el [ key.starts_with[ 'gap_' ] && fresh ]
            dk : disk[]
            for [ p: Part ] in dk.parts
                p.keep = -1
            dk.shrink_at = -1
            dk.gap_at = key.mid[ 4, key.count - 4 ].integer_value[]
        el
            return
        ev.stop[]
        pristine = false
        if [ ux ] ux.restyle = true

    # a typed field's text, from its mounted control
    func field [ panel: element, id: string, cur: string ] -> string
        if [ !panel || !panel.elements ] return cur
        if [ !panel.elements.contains[ id ] ] return cur
        e : element panel.elements[ id ]
        return (e && e.edit) ? e.edit : ''

    func row [ y: f32 ] -> Region
        return Region [ 'l1.4 t{y} r1.4 h0.94' ]

    # a label and its field on one row
    func entry [ t: Elements, panel: element, id: string,
                 name: string, cur: string, y: f32, secret: bool ]
        t[ '{id}_name' ] = WizText [ label: name,
            area: Region [ 'l1.4 t{y} w7 h0.94' ] ]
        mounted : bool [ panel && panel.elements
            && panel.elements.contains[ id ] ]
        ar : Region [ 'l8.6 t{y} r1.4 h0.94' ]
        if [ secret ]
            t[ id ] = (mounted) ? WizSecret [ area: ar ]
                : WizSecret [ area: ar, edit: cur, sel_col: cur.count,
                              anchor_col: cur.count ]
        el
            t[ id ] = (mounted) ? TextInput [ area: ar ]
                : TextInput [ area: ar, edit: cur, sel_col: cur.count,
                              anchor_col: cur.count ]

    # the table's header and its scrolled rows
    func part_els [ panel: element ] -> Elements
        dk : disk[]
        # partition, size, free, type, what's on it (units)
        lefts : vec string [] [ 'l0.7 t0 w4.3 b0', 'l5.2 t0 w3.3 b0',
            'l8.7 t0 w3.3 b0', 'l12.2 t0 w2.6 b0', 'l15 t0 r0.7 b0' ]
        rows : Elements []
        for [ i: i32 0, i < dk.parts.count, i += 1 ]
            p : Part dk.parts[ i ]
            dv : '/dev/{p.name}'
            seen : bool [ access[ dv.chars, R_OK ] == 0
                || p.free >= 0 || p.fs == 'swap' ]
            fs : string [ (p.fs.count > 0) ? p.fs
                : ((seen) ? 'other' : '?') ]
            what : string [ (p.what.count > 0 || seen) ? p.what
                : 'not readable here' ]
            free : string [ (p.free >= 0) ? size_text[ p.free ] : '' ]
            small : bool [ too_small[ p ] ]
            if [ small ]
                what = (what.count > 0) ? 'too small; {what}'
                    : 'too small'
            row : vec string [] [ p.name, size_text[ p.bytes ], free,
                                  fs, what ]
            # too small: shown, never picked
            rows[ 'part_{i}' ] = ListRow [ selected: i == part_at,
                disable: small, area: Region { l0 t0+ r0 h1.2 },
                elements: list_cells[ row, lefts, false, small ] ]
        # the list's height in pixels: rows times the unit
        tb : element (panel && panel.elements)
            ? panel.elements[ 'parts' ] : null
        unit : f32 [ (tb && tb.fc > 0.0) ? tb.fc : 22.0 ]
        head : vec string [] [ 'Partition', 'Size', 'Free', 'Type',
                               'What\'s on it' ]
        out : Elements []
        out[ 'head' ] = ListHead [ area: Region { l0 t0 r0 h1.1 },
            elements: list_cells[ head, lefts, true, false ] ]
        out[ 'rows' ] = ListRows [ area: Region { l0 t1.1 r0 b0 },
            content_h: f32[ dk.parts.count ] * 1.2 * unit,
            elements: rows ]
        return out

    # free space mode: where the new partition goes
    func place_text [] -> string
        dk : disk[]
        room : free_place[ dk ]
        if [ dk.shrink_at >= 0 ]
            p : Part dk.parts[ dk.shrink_at ]
            if [ p.keep >= 0 ]
                sk : 'Shrink {p.name} from {size_text[ p.bytes ]} to'
                return '{sk} {size_text[ p.keep ]}: the new partition '
                    + 'gets {size_text[ room.bytes ]}'
            if [ p.low < 0 ] return '{p.name}: {size_text[ p.bytes ]}.'
            return '{p.name}: drag its edge left to make room.'
        if [ room.bytes > 0 ]
            n : size_text[ room.bytes ]
            return 'The new partition takes the {n} of free space.'
        return 'Choose free space on the map, or a partition to shrink.'

    func how_text [] -> string
        dk : disk[]
        if [ dk.shrink_at >= 0 ]
            p : Part dk.parts[ dk.shrink_at ]
            if [ p.low < 0 ]
                return 'It cannot shrink: in use, or not ext4 or NTFS.'
            return 'It can shrink to {size_text[ p.low ]}: '
                + 'what it holds, and room to grow.'
        n : size_text[ space_need[] ]
        return 'Needs {n}: orbiter-os, and its swap.'

    func page_els [ panel: element ] -> Elements
        t : Elements []
        top : f32 [ 4.4 ]
        gap : f32 [ 1.55 ]
        title : string ''
        note  : string ''
        if [ page == 0 ]
            title = 'Build orbiter-os'
            note  = 'The kernel the drive takes; build a new one.'
            # Write installer…: the stick's own heading
            ub : boot_el[]
            if [ ub && ub.usb_view && ub.on_phone[] ]
                title = 'Install orbiter-os on the phone'
                note  = 'Its boot and userdata are replaced; ' +
                    'Android\'s data is erased.'
            el [ ub && ub.usb_view ]
                title = 'Make orbiter-os installer'
                note  = 'Choose the USB drive; ' +
                    'everything on it is erased.'
            # Build kernel…: its own page, then its build
            el [ ub && ub.building && ub.job == 'kernel' ]
                title = 'Building {ub.want_hardware} {ub.want_version}'
                note  = 'Its steps below; the whole log when asked.'
            el [ ub && ub.kview == 'build' ]
                title = 'Build a kernel'
                note  = 'The hardware it is for and the kernel.'
            t[ 'bootstrap' ] = Bootstrap [
                area: Region [ 'l1.4 t{top} r1.4 h14.15' ] ]
        el [ page == 1 ]
            title = 'Hardware check'
            note  = 'What orbiter-os supports on this machine.'
            y : f32 [ top ]
            for [ i: i32 0, i < hw.count, i += 1 ]
                h : Hw hw[ i ]
                t[ 'hw_{i}' ] = WizText [ label: '{h.kind}:  {h.name}',
                    area: row[ y ] ]
                ar : Region [ 'l1.4 t{y + 1.0} r1.4 h0.8' ]
                k : 'hw_note_{i}'
                if [ h.ok ] t[ k ] = WizGood [ label: h.note, area: ar ]
                el t[ k ] = WizBad [ label: h.note, area: ar ]
                y += 2.1
            if [ hw.count == 0 ]
                none : 'No graphics or network hardware was found.'
                t[ 'hw_none' ] = WizText [ label: none, area: row[ y ] ]
        el [ page == 2 ]
            title = 'Choose a disk'
            note  = 'orbiter-os is installed on it.'
            y : f32 [ top ]
            for [ i: i32 0, i < disks.count, i += 1 ]
                dk : Disk disks[ i ]
                t[ 'disk_{i}' ] = WizPick [ label: dk.text[],
                    selected: i == disk_at, area: row[ y ] ]
                y += gap
        el [ page == 3 ]
            dk : disk[]
            title = 'Where on {dk.name}'
            note  = 'Erase the disk, or keep what is on it.'
            t[ 'beside' ] = WizPick [ selected: beside,
                label: 'Keep what is there: a folder on a partition',
                area: row[ top ] ]
            t[ 'fresh' ] = WizPick [ selected: fresh,
                label: 'Keep what is there: a partition in free space',
                area: row[ top + gap ] ]
            t[ 'whole' ] = WizPick [ selected: !beside && !fresh,
                label: 'Erase the whole disk for orbiter-os',
                area: row[ top + gap * 2.0 ] ]
            mode : i32 [ (fresh) ? 2 : ((beside) ? 1 : 0) ]
            y : f32 [ top + gap * 3.0 + 0.1 ]
            t[ 'map' ] = DiskMap [ dk: dk, mode: mode, part_at: part_at,
                area: Region [ 'l1.4 t{y} r1.4 h1.5' ] ]
            y += 1.9
            if [ beside ]
                t[ 'parts' ] = ListBox [ elements: part_els[ panel ],
                    area: Region [ 'l1.4 t{y} r1.4 h3.6' ] ]
            el [ fresh ]
                t[ 'place' ] = WizSmall [ label: place_text[],
                    area: Region [ 'l1.4 t{y} r1.4 h0.75' ] ]
                t[ 'how' ] = WizSmall [ label: how_text[],
                    area: Region [ 'l1.4 t{y + 0.8} r1.4 h0.75' ] ]
            el
                t[ 'erase' ] = WizSmall [
                    label: 'Everything on {dk.name} is erased.',
                    area: Region [ 'l1.4 t{y} r1.4 h0.75' ] ]
            t[ 'swap' ] = WizPick [ label: swap_text[],
                area: row[ top + 10.45 ] ]
        el [ page == 4 ]
            user  = field[ panel, 'user', user ]
            pass  = field[ panel, 'pass', pass ]
            again = field[ panel, 'again', again ]
            host  = field[ panel, 'host', host ]
            keys  = field[ panel, 'keys', keys ]
            zone  = field[ panel, 'zone', zone ]
            title = 'Your account'
            note  = 'The first user, and this computer.'
            entry[ t, panel, 'user', 'User name', user, top, false ]
            entry[ t, panel, 'pass', 'Password', pass,
                   top + gap, true ]
            entry[ t, panel, 'again', 'Again', again,
                   top + gap * 2.0, true ]
            entry[ t, panel, 'host', 'Computer', host,
                   top + gap * 3.0, false ]
            entry[ t, panel, 'keys', 'Keyboard', keys,
                   top + gap * 4.0, false ]
            entry[ t, panel, 'zone', 'Time zone', zone,
                   top + gap * 5.0, false ]
            t[ 'ssh_keys' ] = WizPick [ label: keys_text[],
                disable: ssh_keys[] == 0, area: row[ top + gap * 6.0 ] ]
        el [ page == 5 ]
            title = 'Ready to install'
            note  = 'Install runs these steps.'
            if [ dry_run ]
                note = 'Dry run: these steps would run. Nothing is '
                note = '{note}written.'
            y : f32 [ top ]
            for [ i: i32 0, i < plan.count, i += 1 ]
                st : Step plan[ i ]
                t[ 'plan_{i}' ] = WizSmall [
                    label: '{i + 1}.  {st.title}',
                    area: Region [ 'l1.4 t{y} r1.4 h0.75' ] ]
                y += 0.78
            for [ i: i32 0, i < notes.count, i += 1 ]
                t[ 'notice_{i}' ] = WizNote [ label: notes[ i ],
                    area: Region [ 'l1.4 t{y} r1.4 h0.8' ] ]
                y += 0.8
            for [ i: i32 0, i < problems.count, i += 1 ]
                t[ 'problem_{i}' ] = WizWarn [ label: problems[ i ],
                    area: Region [ 'l1.4 t{y} r1.4 h0.8' ] ]
                y += 0.8
        el
            done : i32 [ step_at ]
            title = (failed) ? 'The install stopped'
                : ((finished) ? 'orbiter-os is installed'
                : 'Installing')
            note = (finished && !failed)
                ? 'Restart to start orbiter-os.' : ''
            cur : string ''
            if [ done < plan.count ]
                st : Step plan[ done ]
                cur = st.title
            t[ 'now' ] = WizText [ area: row[ top ],
                label: (cur.count > 0)
                    ? 'Step {done + 1} of {plan.count}: {cur}' : '' ]
            frac : f32 [ f32[ done ] / f32[ (plan.count > 0)
                ? plan.count : 1 ] ]
            whole : bool [ finished && !failed ]
            t[ 'bar' ] = WizBar [ frac: frac, done: whole,
                area: Region [ 'l1.4 t{top + 1.4} r1.4 h0.3' ] ]
            if [ total > 0 ]
                cp : f32 [ f32[ copied ] / f32[ total ] ]
                if [ cp > 1.0 ] cp = 1.0
                cl : 'Copied {size_text[ copied ]}'
                cl = '{cl} of {size_text[ total ]}'
                t[ 'copy' ] = WizSmall [ area: row[ top + 2.0 ],
                                         label: cl ]
                t[ 'cbar' ] = WizBar [ frac: cp, done: whole,
                    area: Region [ 'l1.4 t{top + 3.3} r1.4 h0.3' ] ]
            shown : vec string []
            lock.lock[]
            oldest : i32 [ lines.count - 7 ]
            if [ oldest < 0 ] oldest = 0
            for [ i: i32 oldest, i < lines.count, i += 1 ]
                shown.push[ '{lines[ i ]}' ]
            lock.unlock[]
            y : f32 [ top + 4.2 ]
            for [ i: i32 0, i < shown.count, i += 1 ]
                t[ 'line_{i}' ] = WizSmall [ label: shown[ i ],
                    area: Region [ 'l1.4 t{y} r1.4 h0.75' ] ]
                y += 0.78
        t[ 'title' ] = WizTitle [ label: title,
            area: Region { l1.4 t1.1 r1.4 h1.6 } ]
        t[ 'note' ] = WizNote [ label: note,
            area: Region { l1.4 t2.7 r1.4 h1 } ]
        why_text : string [ (page < 5) ? why[] : '' ]
        if [ why_text.count > 0 ]
            t[ 'why' ] = WizWarn [ label: why_text,
                area: Region { l1.4 b3.7 r1.4 h1 } ]
        if [ page > first_page && page < 6 ]
            t[ 'back' ] = WizButton [ label: 'Back',
                area: Region { l1.4 b2.05 w4.5 h1.05 } ]
        # while page 0 builds: the build can be stopped
        bs : boot_el[]
        if [ page == 0 && bs && bs.building && bs.job != 'usb' ]
            t[ 'cancel_build' ] = WizButton [ label: 'Cancel Build',
                area: Region { l1.4 b2.05 w6 h1.05 } ]
        # writing an installer: its bar between the two buttons;
        # written, it stays, green, until the drive row is left
        wrote : bool [ bs && !bs.building && !bs.failed
            && bs.usb_view && bs.progress >= 1.0 ]
        if [ page == 0 && bs && bs.job == 'usb'
             && (bs.building || wrote) ]
            # centred in the dialog, clear of Continue
            side : f32 [ 7.45 ]
            t[ 'usb_bar' ] = WizBar [ frac: bs.progress, done: wrote,
                area: Region [ 'l{side} b1.675 r{side} h0.3' ] ]
        # making an installer or a kernel: no Continue, Back (or
        # Cancel Build) is the way out
        if [ page == 0 && bs && (bs.usb_view || bs.kview == 'build'
             || (bs.building && bs.job == 'kernel')) ]
            return t
        # building: no going on at all
        if [ boot_blocked[] || advance ]
            t[ 'next' ] = WizButton [ label: 'Continue', disable: true,
                opacity: 0.4, area: Region { r5.9 b2.05 r1.4 h1.05 } ]
        # blocked: a plain button, which shift+click still takes
        el [ page < 5 && why_text.count > 0 ]
            t[ 'next' ] = WizButton [ label: 'Continue',
                area: Region { r5.9 b2.05 r1.4 h1.05 } ]
        el [ page < 5 ]
            t[ 'next' ] = WizGo [ label: 'Continue',
                area: Region { r5.9 b2.05 r1.4 h1.05 } ]
        el [ page == 5 && !dry_run && problems.count == 0 ]
            t[ 'install' ] = WizGo [ label: 'Install',
                area: Region { r5.9 b2.05 r1.4 h1.05 } ]
        el [ page == 6 && finished && !failed ]
            t[ 'restart' ] = WizGo [ label: 'Restart',
                area: Region { r5.9 b2.05 r1.4 h1.05 } ]
        return t

    public func render [] -> Elements
        # the tree Continue asked for is written: on to page 1
        bs : boot_el[]
        if [ advance && bs && !bs.building ]
            advance = false
            if [ bs.ready[] ] page = 1
        # the progress page follows the worker each frame
        if [ page == 6 || page == 0 ] pristine = false
        panel : element (elements) ? elements[ 'panel' ] : null
        return Elements [
            # building linux: tilted away as orbiter's at work, and
            # a kernel build's flame; a stick write, the long halo.
            # never settled: done or cancelled, it faces the user
            'avatar': SetupAvatar [ settled: false,
                work_on: (bs && bs.building) || beam_test,
                edits_in: bs && bs.building && bs.job == 'usb',
                swap_on: (bs && bs.building && bs.job != 'usb')
                         || beam_test ],
            'beam_test': WizGo [ label: 'A',
                area: Region { l1 t1 w2 h1.05 } ],
            'panel': WizPanel [ elements: page_els[ panel ],
                area: Region { l50%-8 t50%-10.5 w32 h21 } ] ]

# the install's script on a scratch tree, run as this user (no
# mounts): copy, write, one file
expect func t_install_steps [] -> bool
    root : '/tmp/wizard-test-{getpid[]}'
    src  : '{root}/src'
    mk : command { mkdir -p {src}/boot {src}/bin {src}/proc/1
        && echo kernel > {src}/boot/vmlinuz
        && echo tool > {src}/bin/tool
        && chmod 755 {src}/bin/tool && echo x > {src}/proc/1/status
        && ln -s boot {src}/lib }
    mk.exec[ false ]
    w : InstallWizard [ source: src ]
    if [ !w.lock ] w.lock = mutex []
    if [ !w.lines ] w.lines = vec string []
    if [ !w.swap_word ] w.swap_word = ''
    if [ !w.ruuid ] w.ruuid = ''
    w.plan = vec Step []
    s : w.step[ StepKind.copy, 'Copy the tree' ]
    s.src = src
    s.dst = '{root}/dst'
    s = w.step[ StepKind.write, 'Write the settings' ]
    s.dst  = '{root}/dst/var/lib/orbiter/install.agi'
    s.text = 'user: it\'s a test\n'
    s = w.step[ StepKind.file, 'Copy the kernel' ]
    s.src = '{src}/boot/vmlinuz'
    s.dst = '{root}/efi/EFI/orbiter/vmlinuz.efi'
    f : w.write_script[ w.plan ]
    w.run_script[ f, 'sh' ]
    unlink[ f.chars ]
    dst : '{root}/dst'
    tool_copy : '{dst}/bin/tool'
    proc_dir  : path '{dst}/proc'
    proc_kid  : path '{dst}/proc/1'
    ok : bool [ !w.failed && w.step_at == 2
        && read_line[ '{dst}/boot/vmlinuz' ] == 'kernel'
        && link_text[ '{dst}/lib' ] == 'boot'
        && access[ tool_copy.chars, X_OK ] == 0
        && proc_dir.exists[] && !proc_kid.exists[]
        && read_line[ '{root}/efi/EFI/orbiter/vmlinuz.efi' ] == 'kernel'
        && read_line[ '{dst}/var/lib/orbiter/install.agi' ]
            == 'user: it\'s a test' ]
    log 'wizard test: script steps ok {ok}, failed {w.failed}'
    rm_cmd : command { rm -rf {root} }
    rm_cmd.exec[ false ]
    return ok

# boot_second against a made-up efibootmgr with europa's entries:
# the new one goes second, Ubuntu stays first
expect func t_boot_order [] -> bool
    dir : '/tmp/wizard-boot-order-{getpid[]}'
    dp : path [ dir ]
    dp.make_dir[]
    fake : '#!/bin/sh\nd={dir}\ncase "$*" in\n'
    fake = '{fake}  *--bootorder*) echo "$2" > $d/order; exit 0 ;;\n'
    fake = '{fake}  *--create-only*) touch $d/made; exit 0 ;;\nesac\n'
    fake = '{fake}echo "BootCurrent: 0000"\n'
    fake = '{fake}echo "BootOrder: 0000,0003,0001,0002"\n'
    fake = '{fake}echo "Boot0000* Ubuntu HD(3)"\n'
    fake = '{fake}echo "Boot0001* opensuse-secureboot HD(3)"\n'
    fake = '{fake}echo "Boot0002* Windows Boot Manager HD(3)"\n'
    fake = '{fake}echo "Boot0003* GRUB HD(3)"\n'
    fake = '{fake}[ -e $d/made ] && echo "Boot0004* orbiter-os HD(3)"\n'
    fake = '{fake}exit 0\n'
    w : InstallWizard []
    sc : '{w.sh_head[]}boot_second efibootmgr --create-only --label x\n'
    em : '{dir}/efibootmgr'
    sf : '{dir}/s.sh'
    fe : handle fopen[ em.chars, 'w' ]
    fputs[ fake.chars, fe ]
    fclose[ fe ]
    fs : handle fopen[ sf.chars, 'w' ]
    fputs[ sc.chars, fs ]
    fclose[ fs ]
    # rwxr-xr-x
    exec_mode : u32 [ 0x1ED ]
    chmod[ em.chars, exec_mode ]
    run : command { PATH={dir}:$PATH sh {dir}/s.sh }
    run.exec[ false ]
    od : read_line[ '{dir}/order' ]
    log 'wizard test: boot order {od}'
    rm_cmd : command { rm -rf {dir} }
    rm_cmd.exec[ false ]
    return od == '0000,0004,0003,0001,0002'

# each boot manager from a made-up EFI and Linux partition
expect func t_boot_detect [] -> bool
    root : '/tmp/wizard-boot-{getpid[]}'
    dirs : vec string [] [ 'deb/etc/grub.d', 'bls/loader/entries',
        'fed/boot/loader/entries', 'esp/EFI/systemd',
        'esp/loader/entries', 'plain', 'rf/EFI/refind' ]
    for [ d: string ] in dirs
        dp : path '{root}/{d}'
        dp.make_dir[]
    lines : vec string [] [ 'BootOrder: 0000,0003',
        'Boot0000* Ubuntu\tHD(3)/File(\\EFI\\ubuntu\\shimx64.efi)',
        'Boot0003* GRUB\tHD(3)/File(\\EFI\\GRUB\\grubx64.efi)' ]
    ld : default_loader[ lines ]
    shim : '\\efi\\ubuntu\\shimx64.efi'
    win  : '\\efi\\microsoft\\boot\\bootmgfw.efi'
    sdb  : '\\efi\\systemd\\systemd-bootx64.efi'
    refi : '\\efi\\refind\\refind_x64.efi'
    fall : '\\efi\\boot\\bootx64.efi'
    e : '{root}/esp'
    p : '{root}/plain'
    got : vec BootKind [] [
        detect_boot[ shim, p, '{root}/deb' ],
        detect_boot[ shim, p, '{root}/bls' ],
        detect_boot[ shim, p, '{root}/fed' ],
        detect_boot[ sdb, e, p ],
        detect_boot[ fall, e, p ],
        detect_boot[ refi, p, p ],
        detect_boot[ '', '{root}/rf', p ],
        detect_boot[ win, e, '{root}/deb' ],
        detect_boot[ shim, p, p ] ]
    want : vec BootKind [] [ BootKind.grub_debian, BootKind.grub_bls,
        BootKind.grub_bls, BootKind.systemd_boot,
        BootKind.systemd_boot, BootKind.refind, BootKind.refind,
        BootKind.windows, BootKind.unknown ]
    ok : bool [ ld == shim ]
    for [ i: i32 0, i < want.count, i += 1 ]
        if [ got[ i ] != want[ i ] ]
            log 'wizard test: case {i} gave {boot_name[ got[ i ] ]}'
            ok = false
    log 'wizard test: loader {ld}, boot cases ok {ok}'
    rm_cmd : command { rm -rf {root} }
    rm_cmd.exec[ false ]
    return ok

# free space read as df reads it; contents of the running root
expect func t_free_space [] -> bool
    mine : free_at[ '/' ]
    fh_cmd : command [ 'df -B1 --output=avail /' ]
    fh : handle fh_cmd.stream[]
    b : local i8 [ 256 ]
    df : i64 [ -1 ]
    while [ fh && fgets[ @b[0], 256, fh ] ]
        ln0 : string [ @b[0] ]
        ln : ln0.trim[]
        if [ ln.is_numeric[] ] df = ln.integer_value[]
    if [ fh ] pclose[ fh ]
    gap : i64 [ (mine > df) ? mine - df : df - mine ]
    root : contents[ '/', 'ext4' ]
    log 'wizard test: free {mine} df {df}, root: {root}'
    # a write between the two reads moves it a little
    return df > 0 && gap < 64 * 1048576
        && root.index_of[ 'running' ] >= 0

# the copy's measure from the tree, and the rows it rules out
expect func t_copy_need [] -> bool
    root : '/tmp/wizard-need-{getpid[]}'
    bd : path '{root}/boot'
    bd.make_dir[]
    tb : '{root}/boot/tree-bytes'
    fh : handle fopen[ tb.chars, 'w' ]
    fputs[ '1000000\n', fh ]
    fclose[ fh ]
    w : InstallWizard [ source: root ]
    w.need = w.copy_need[]
    fits  : Part [ name: 'a', free: 2000000 ]
    tight : Part [ name: 'b', free: 1050000 ]
    blind : Part [ name: 'c' ]
    ok : bool [ w.need == 1100000 && !w.too_small[ fits ]
        && w.too_small[ tight ] && !w.too_small[ blind ] ]
    log 'wizard test: need {w.need}, ok {ok}'
    rm_cmd : command { rm -rf {root} }
    rm_cmd.exec[ false ]
    return ok

# a stand-in .ssh (never the user's): one key counted, the copy
# private (folder 700, files 600)
expect func t_ssh_keys [] -> bool
    root : '/tmp/wizard-keys-{getpid[]}'
    home : '{root}/home'
    sd : path '{home}/.ssh'
    sd.make_dir[]
    names : vec string [] [ 'id_test', 'id_test.pub', 'known_hosts' ]
    for [ nm: string ] in names
        f : '{home}/.ssh/{nm}'
        fh : handle fopen[ f.chars, 'w' ]
        fputs[ 'stand-in\n', fh ]
        fclose[ fh ]
        chmod[ f.chars, 0x1A4 ]
    was : string [ getenv[ "HOME" ] ]
    setenv[ "HOME", home.chars, 1 ]
    n : i32 ssh_keys[]
    to : '{root}/dst/.ssh'
    cp : command [ ssh_copy_sh[ ssh_dir[], to ] ]
    rc : i32 [ cp.exec[ false ] ]
    setenv[ "HOME", was.chars, 1 ]
    st : struct stat
    stat[ to.chars, @st ]
    dir_mode : i32 [ i32[ st.st_mode ] & 0x1FF ]
    key : '{to}/id_test'
    stat[ key.chars, @st ]
    key_mode : i32 [ i32[ st.st_mode ] & 0x1FF ]
    ok : bool [ n == 1 && rc == 0 && dir_mode == 0x1C0
                && key_mode == 0x180 ]
    log 'wizard test: keys {n}, copy {rc}, dir {dir_mode}, key {key_mode}'
    # each file by name, then the folders
    for [ nm: string ] in names
        a : '{home}/.ssh/{nm}'
        b : '{to}/{nm}'
        unlink[ a.chars ]
        unlink[ b.chars ]
    for [ d: string ] in vec string [] [ '{home}/.ssh', home, to,
                                         '{root}/dst', root ]
        rmdir[ d.chars ]
    return ok

# a device id against the drive's drivers, and its pci.ids name
expect func t_hardware_match [] -> bool
    al : vec string [] [ 'e1000e',
        'pci:v00008086d000015B8sv*sd*bc*sc*i*', 'r8169',
        'pci:v000010ECd00008125sv*sd*bc*sc*i*' ]
    lan : 'pci:v000010ECd00008125sv00001458sd0000E000bc02sc00i00'
    wifi : 'pci:v000010ECd0000C852sv000010ECsd0000C852bc02sc80i00'
    nm : pci_name[ '/usr/share/misc/pci.ids', 0x10ec, 0x8125 ]
    gpu : pci_name[ '/usr/share/misc/pci.ids', 0x10de, 0x2504 ]
    log 'wizard test: {nm}, {gpu}'
    return driver_for[ al, lan ] == 'r8169'
        && driver_for[ al, wifi ] == ''
        && nm == 'Realtek RTL8125 2.5GbE Controller'
        && gpu.starts_with[ 'NVIDIA GeForce RTX 3060' ]

# a made-up disk: EFI, ext4, NTFS, and room between and after
func test_disk [] -> Disk
    dk : Disk [ name: 'tst', bytes: 100 * GIB, parts: vec Part [] ]
    dk.parts.push[ Part [ name: 'tst1', number: 1, start: MIB,
        bytes: 512 * MIB, fs: 'vfat' ] ]
    dk.parts.push[ Part [ name: 'tst2', number: 2, start: 513 * MIB,
        bytes: 40 * GIB, fs: 'ext4', what: 'Ubuntu 26.04',
        low: 10 * GIB ] ]
    dk.parts.push[ Part [ name: 'tst3', number: 3, start: 60 * GIB,
        bytes: 30 * GIB, fs: 'ntfs' ] ]
    return dk

# the gaps, a chosen gap's place, and a shrink's
expect func t_disk_gaps [] -> bool
    dk : test_disk[]
    gaps : disk_gaps[ dk ]
    ok : bool [ gaps.count == 2 ]
    if [ ok ]
        mid : i64 [ 60 * GIB - (513 * MIB + 40 * GIB) ]
        ok = gaps[ 0 ].start == 513 * MIB + 40 * GIB
            && gaps[ 0 ].bytes == mid
            && gaps[ 1 ].start == 90 * GIB
            && gaps[ 1 ].bytes == 10 * GIB - MIB
    dk.gap_at = 1
    g : free_place[ dk ]
    at_end : bool [ g.start == 90 * GIB && g.bytes == 10 * GIB - MIB ]
    dk.gap_at = -1
    dk.shrink_at = 1
    dk.parts[ 1 ].keep = 30 * GIB
    f : free_place[ dk ]
    freed : bool [ f.start == 513 * MIB + 30 * GIB
        && f.bytes == 60 * GIB - (513 * MIB + 30 * GIB) ]
    log 'wizard gaps: {gaps.count} gaps, {ok}; chosen {at_end}; '
        + 'shrink frees {size_text[ f.bytes ]} {freed}'
    return ok && at_end && freed

# into free space after shrinking the ext4: the plan's commands
expect func t_free_plan [] -> bool
    dk : test_disk[]
    dk.shrink_at = 1
    dk.parts[ 1 ].keep = 30 * GIB
    w : InstallWizard [ dry_run: true, source: '/' ]
    if [ !w.lines ] w.lines = vec string []
    if [ !w.swap_word ] w.swap_word = ''
    # constructed, not mounted: its init never ran
    w.user = 'test'
    w.pass = 'test'
    w.host = 'test'
    w.keys = 'us'
    w.zone = 'UTC'
    w.disks = vec Disk [] [ dk ]
    w.disk_at = 0
    w.beside = false
    w.fresh = true
    w.make_plan[]
    cmds : string ''
    for [ st: Step ] in w.plan
        cmds = '{cmds}{st.title} | {st.cmd}\n'
    log 'wizard free plan:\n{cmds}'
    kb : i64 [ 30 * GIB / 1024 ]
    sec : i64 [ 512 ]
    s0 : i64 [ (513 * MIB + 30 * GIB) / sec ]
    n0 : i64 [ (60 * GIB - (513 * MIB + 30 * GIB)) / sec ]
    want : vec string [] [ 'e2fsck -f -y /dev/tst2',
        'resize2fs /dev/tst2 {kb}K',
        'echo \',{kb}KiB\' | sfdisk --no-reread -N 2 /dev/tst',
        'start={s0}, size={n0}, type=L, name=orbiter',
        'sfdisk --no-reread -N 4 /dev/tst',
        'mkfs.ext4 -F -L orbiter-os -U ', ' /dev/tst4',
        'mkswap /run/wizard/root/swapfile', '--create-only' ]
    ok : bool [ true ]
    for [ x: string ] in want
        if [ cmds.index_of[ x ] < 0 ]
            log 'wizard free plan: missing {x}'
            ok = false
    return ok && w.swap_word == 'orbiter.swap=/swapfile'
