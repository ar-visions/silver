import vec
import img
import trinity
import <stdio.h>

enum Quality
    low:    0
    medium: 1
    high:   2

enum Theme
    dark:   0
    light:  1
    auto:   2
 

Button ClickButton
    style : CSS {
        area: l2 t2 w123px h64px
        focusable: true
        opacity:1.0
        layers.body:
            fill_color: #fff
            radius: 8
            opacity:1.0
        layers.face:
            label_color: #000
            label_size: 14
            label_align: 0.5 0.5
            opacity:1.0
    :hovered
        layers.body:
            fill_color: #00f
            radius: 8
            opacity:1.0
    }

element buttontest : trinity
    intern clicks     : i32    0
    public ux_generics : bool  [ true ]
    public width      : i32    [ 480 ]
    public height     : i32    [ 560 ]
    public background : string [ 'Background' ]
    public title      : string [ 'buttontest' ]
    public wireframe  : bool
    public paused     : bool   [ true ]
    public show_grid  : bool
    public vsync      : bool   [ true ]
    public quality    : Quality [ Quality.medium ]
    public theme      : Theme [ Theme.dark ]
    public tint       : rgba [ '#e0508c' ]
    # public f32 becomes a range slider (0..1)
    public volume     : f32 [ 0.7 ]

    # 'clicks' is entries only; 'bars' also carries a view
    public func instruments [] -> array string
        return array string [ 'clicks', 'bars' ]

    public func read_instrument [ nm: string ] -> array string
        if [ !nm ] return null
        if [ nm.compare[ 'clicks' ] == 0 ]
            ls : array string []
            ls.push[ 'clicks     {clicks}' ]
            ls.push[ 'volume     {volume}' ]
            ls.push[ 'paused     {(paused) ? 1 : 0}' ]
            return ls
        if [ nm.compare[ 'bars' ] == 0 ]
            bs : array string []
            bs.push[ 'bars       {clicks % 8}' ]
            return bs
        return null

    # the shell gives the width; this is the height we want at it
    public func instrument_height [ nm: string, iw: i32 ] -> i32
        if [ nm.compare[ 'bars' ] == 0 ] return 110
        return 0

    public func paint_instrument [ cv: Canvas, nm: string, r: rect ] -> bool
        if [ !nm || nm.compare[ 'bars' ] != 0 ] return false
        cv.stroke_width[ 0.0 ]
        bw : f32 [ (r.w - 16.0) / 8.0 ]
        for [ i: i32 0, i < 8, i += 1 ]
            bh : f32 [ 10.0 + f32[ (clicks + i) % 8 ] * ((r.h - 20.0) / 8.0) ]
            cv.fill_color[ rgba [ '#7fb2ff' ] ]
            cv.rect_to[ r.x + 8.0 + f32[i] * bw, r.y + r.h - bh - 8.0, bw - 2.0, bh ]
            cv.paint[]
        return true

    public func on_click [ ev: Event ]
        e : cast element [ ev.origin ]
        if [ !e ] return
        if [ e.id == 'hello' ]
            clicks += 1
            puts 'LIVE RELOADED! count={clicks}'
        ev.stop[]

    public func render [] -> Elements
        return Elements [
            "hello": ClickButton [ label: 'click me' ]
        ]