extend composer

import <math.h>

# BigVGAN v2 (22 kHz, 80 mels, 256x): mel frames in, samples out.
# weights from bigvgan.pth, weight norm folded at load

# one 1d convolution's folded weights: [cout, cin, k] (a transposed
# one is [cin, cout, k])
class Conv1
    public w    : vec f32
    public b    : vec f32
    public cin  : i32
    public cout : i32
    public k    : i32

# the anti-aliased snake: 2x up, snakebeta, 2x down
class Snake
    public alpha : vec f32
    public beta  : vec f32
    public up    : vec f32
    public down  : vec f32

class BigVGAN
    public  src   : path
    public  valid : bool
    intern  ck    : pth
    intern  cv_pre   : Conv1
    intern  cv_post  : Conv1
    intern  ups   : vec Conv1
    # 18 blocks x (3 convs1 + 3 convs2), 36 snakes each 6 a block
    intern  c1    : vec Conv1
    intern  c2    : vec Conv1
    intern  acts  : vec Snake
    intern  act_post : Snake
    public  rates : vec i32

    func init []
        ck = pth [ src: src ]
        if [ !ck.valid ] return
        rates = vec i32 [] [ 4, 4, 2, 2, 2, 2 ]
        cv_pre  = conv[ 'generator.conv_pre', 0 ]
        cv_post = conv[ 'generator.conv_post', 0 ]
        ups  = vec Conv1 []
        for [ i: i32 0, i < 6, i += 1 ]
            ups.push[ conv[ 'generator.ups.{i}.0', 1 ] ]
        c1   = vec Conv1 []
        c2   = vec Conv1 []
        acts = vec Snake []
        for [ n: i32 0, n < 18, n += 1 ]
            for [ j: i32 0, j < 3, j += 1 ]
                c1.push[ conv[ 'generator.resblocks.{n}.convs1.{j}', 0 ] ]
                c2.push[ conv[ 'generator.resblocks.{n}.convs2.{j}', 0 ] ]
            for [ m: i32 0, m < 6, m += 1 ]
                acts.push[ snake[ 'generator.resblocks.{n}.activations.{m}' ] ]
        act_post = snake[ 'generator.activation_post' ]
        valid = cv_pre.w.count > 0 && cv_post.w.count > 0
        ck = null

    func floats [ name: string ] -> vec f32
        t : tensor ck.tensor_named[ name ]
        if [ !t ] return vec f32 []
        n : i64 [ t.tensor_shape.total[] ]
        out : vec f32 [ n ]
        memcpy[ @out[ 0 ], t.floats, n * 4 ]
        return out

    # weight = g * v / |v|, the norm over everything but dim 0
    func conv [ base: string, transposed: i32 ] -> Conv1
        v  : tensor ck.tensor_named[ '{base}.weight_v' ]
        g  : vec f32 floats[ '{base}.weight_g' ]
        c  : Conv1 [ b: floats[ '{base}.bias' ] ]
        if [ !v ] return c
        d0 : i32 [ i32[ v.tensor_shape[ 0 ] ] ]
        d1 : i32 [ i32[ v.tensor_shape[ 1 ] ] ]
        kk : i32 [ i32[ v.tensor_shape[ 2 ] ] ]
        c.k    = kk
        c.cin  = (transposed == 1) ? d0 : d1
        c.cout = (transposed == 1) ? d1 : d0
        per : i64 [ i64[ d1 ] * kk ]
        c.w = vec f32 [ i64[ d0 ] * per ]
        for [ r: i64 0, r < i64[ d0 ], r += 1 ]
            ss : f64 [ 0.0 ]
            for [ q: i64 0, q < per, q += 1 ]
                e : f64 [ f64[ v.floats[ r * per + q ] ] ]
                ss += e * e
            sc : f64 [ f64[ g[ r ] ] / sqrt[ ss ] ]
            for [ q: i64 0, q < per, q += 1 ]
                c.w[ r * per + q ] = f32[ f64[ v.floats[ r * per + q ] ] * sc ]
        return c

    func snake [ base: string ] -> Snake
        s : Snake [ alpha: floats[ '{base}.act.alpha' ], beta: floats[ '{base}.act.beta' ],
                    up: floats[ '{base}.upsample.filter' ], down: floats[ '{base}.downsample.lowpass.filter' ] ]
        # log-scale parameters
        for [ i: i64 0, i < s.alpha.count, i += 1 ]
            s.alpha[ i ] = expf[ s.alpha[ i ] ]
            s.beta[ i ]  = 1.0 / (expf[ s.beta[ i ] ] + 0.000000001)
        return s

    # y[co] = b[co] + sum ci, j of w[co, ci, j] x[ci, t + j*dil - pad]
    func conv1d [ c: Conv1, x: vec f32, t: i32, dil: i32, pad: i32 ] -> vec f32
        to : i32 [ t + 2 * pad - dil * (c.k - 1) ]
        y  : vec f32 [ i64[ c.cout ] * to ]
        xp : @f32 [ @x[ 0 ] ]
        wp : @f32 [ @c.w[ 0 ] ]
        for [ co: i32 0, co < c.cout, co += 1 ]
            yr : @f32 [ @y[ i64[ co ] * to ] ]
            bv : f32 [ (c.b.count > 0) ? c.b[ co ] : 0.0 ]
            for [ q: i32 0, q < to, q += 1 ]
                yr[ q ] = bv
            for [ ci: i32 0, ci < c.cin, ci += 1 ]
                xr : @f32 [ @x[ i64[ ci ] * t ] ]
                for [ j: i32 0, j < c.k, j += 1 ]
                    wv  : f32 [ wp[ (i64[ co ] * c.cin + ci) * c.k + j ] ]
                    off : i32 [ j * dil - pad ]
                    q0 : i32 [ (off < 0) ? 0 - off : 0 ]
                    q1 : i32 [ (t - off < to) ? t - off : to ]
                    for [ q: i32 q0, q < q1, q += 1 ]
                        yr[ q ] += wv * xr[ q + off ]
        return y

    # a transposed convolution, stride s: every input sample spreads
    func conv_up [ c: Conv1, x: vec f32, t: i32, s: i32 ] -> vec f32
        pad : i32 [ (c.k - s) / 2 ]
        to  : i32 [ (t - 1) * s - 2 * pad + c.k ]
        y   : vec f32 [ i64[ c.cout ] * to ]
        for [ co: i32 0, co < c.cout, co += 1 ]
            yr : @f32 [ @y[ i64[ co ] * to ] ]
            bv : f32 [ (c.b.count > 0) ? c.b[ co ] : 0.0 ]
            for [ q: i32 0, q < to, q += 1 ]
                yr[ q ] = bv
        xp : @f32 [ @x[ 0 ] ]
        wp : @f32 [ @c.w[ 0 ] ]
        for [ ci: i32 0, ci < c.cin, ci += 1 ]
            xr : @f32 [ @x[ i64[ ci ] * t ] ]
            for [ co: i32 0, co < c.cout, co += 1 ]
                yr : @f32 [ @y[ i64[ co ] * to ] ]
                for [ j: i32 0, j < c.k, j += 1 ]
                    wv : f32 [ wp[ (i64[ ci ] * c.cout + co) * c.k + j ] ]
                    for [ q: i32 0, q < t, q += 1 ]
                        o : i32 [ q * s + j - pad ]
                        if [ o >= 0 && o < to ] yr[ o ] += wv * xr[ q ]
        return y

    # 2x up (replicate pad 5, 12-tap filter, x2), snakebeta, 2x down
    func act [ sk: Snake, x: vec f32, ch: i32, t: i32 ] -> vec f32
        y  : vec f32 [ i64[ ch ] * t ]
        u  : vec f32 [ i64[ 2 * t ] ]
        up : @f32 [ @sk.up[ 0 ] ]
        dn : @f32 [ @sk.down[ 0 ] ]
        for [ c: i32 0, c < ch, c += 1 ]
            xr : @f32 [ @x[ i64[ c ] * t ] ]
            al : f32 [ sk.alpha[ c ] ]
            ib : f32 [ sk.beta[ c ] ]
            # u[o] = 2 sum_j f[j] xp[(o + 15 - j) / 2] over even o + 15 - j
            for [ o: i32 0, o < 2 * t, o += 1 ]
                s : f32 [ 0.0 ]
                for [ j: i32 0, j < 12, j += 1 ]
                    z : i32 [ o + 15 - j ]
                    if [ (z & 1) == 0 ]
                        ix : i32 [ z / 2 - 5 ]
                        if [ ix < 0 ] ix = 0
                        if [ ix > t - 1 ] ix = t - 1
                        s += up[ j ] * xr[ ix ]
                v : f32 [ 2.0 * s ]
                sn : f32 [ sinf[ v * al ] ]
                u[ o ] = v + ib * sn * sn
            yr : @f32 [ @y[ i64[ c ] * t ] ]
            for [ q: i32 0, q < t, q += 1 ]
                s : f32 [ 0.0 ]
                for [ j: i32 0, j < 12, j += 1 ]
                    ix : i32 [ 2 * q + j - 5 ]
                    if [ ix < 0 ] ix = 0
                    if [ ix > 2 * t - 1 ] ix = 2 * t - 1
                    s += dn[ j ] * u[ ix ]
                yr[ q ] = s
        return y

    func add_into [ dst: vec f32, src9: vec f32 ]
        ap : @f32 [ @dst[ 0 ] ]
        bp : @f32 [ @src9[ 0 ] ]
        for [ i: i64 0, i < dst.count, i += 1 ]
            ap[ i ] += bp[ i ]

    # one AMP block: three dilations, snake conv snake conv, residual
    public func block [ n: i32, x: vec f32, ch: i32, t: i32 ] -> vec f32
        dils : vec i32 [] [ 1, 3, 5 ]
        xb : vec f32 [ i64[ ch ] * t ]
        memcpy[ @xb[ 0 ], @x[ 0 ], i64[ ch ] * t * 4 ]
        for [ d: i32 0, d < 3, d += 1 ]
            ca : Conv1 c1[ n * 3 + d ]
            cb : Conv1 c2[ n * 3 + d ]
            xt : vec f32 act[ acts[ n * 6 + d * 2 ], xb, ch, t ]
            xt = conv1d[ ca, xt, t, dils[ d ], (ca.k * dils[ d ] - dils[ d ]) / 2 ]
            xt = act[ acts[ n * 6 + d * 2 + 1 ], xt, ch, t ]
            xt = conv1d[ cb, xt, t, 1, (cb.k - 1) / 2 ]
            add_into[ xb, xt ]
        return xb

    # mel [80, frames] (log magnitudes) to samples at 22050 a second
    public func run [ mel: vec f32, frames: i32 ] -> vec f32
        x : vec f32 conv1d[ cv_pre, mel, frames, 1, 3 ]
        t : i32 [ frames ]
        ch : i32 [ cv_pre.cout ]
        for [ i: i32 0, i < 6, i += 1 ]
            x  = conv_up[ ups[ i ], x, t, rates[ i ] ]
            t  = t * rates[ i ]
            ch = ups[ i ].cout
            acc : vec f32 [ i64[ ch ] * t ]
            memset[ @acc[ 0 ], 0, i64[ ch ] * t * 4 ]
            for [ jb: i32 0, jb < 3, jb += 1 ]
                xb : vec f32 block[ i * 3 + jb, x, ch, t ]
                add_into[ acc, xb ]
            for [ q: i64 0, q < acc.count, q += 1 ]
                acc[ q ] = acc[ q ] / 3.0
            x = acc
        x = act[ act_post, x, ch, t ]
        y : vec f32 conv1d[ cv_post, x, t, 1, 3 ]
        for [ q: i64 0, q < y.count, q += 1 ]
            if [ y[ q ] > 1.0 ] y[ q ] = 1.0
            if [ y[ q ] < -1.0 ] y[ q ] = -1.0
        return y
