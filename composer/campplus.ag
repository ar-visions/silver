extend composer

import <math.h>

# CAM++ (FunASR): a reference voice's 16 kHz samples to the 192
# numbers Seed-VC conditions on, the voice's seed

# eval batchnorm folded: y = x * scale + shift, one pair a channel
class Norm
    public scale : vec f32
    public shift : vec f32

# a convolution's weights, [cout, cin, kh, kw] (kh 1 for 1d)
class Conv
    public w    : vec f32
    public b    : vec f32
    public cin  : i32
    public cout : i32
    public kh   : i32
    public kw   : i32

# Kaldi's fbank at 16 kHz, 80 bins, as torchaudio computes it (no
# dither): 25 ms frames every 10 ms, dc removed, pre-emphasis 0.97,
# povey window, 512-point power spectrum, htk mel triangles from 20
# Hz, log; then the mean over time taken off. out [frames, 80]
func kaldi_fbank [ pcm: vec f32, frames_out: @i32 ] -> vec f32
    n : i64 [ pcm.count ]
    if [ n < 400 ] return vec f32 []
    frames : i32 [ i32[ 1 + (n - 400) / 160 ] ]
    frames_out[ 0 ] = frames
    win : vec f32 [ 400 ]
    for [ i: i32 0, i < 400, i += 1 ]
        hn : f64 [ 0.5 - 0.5 * cos[ 2.0 * 3.14159265358979323846 * f64[ i ] / 399.0 ] ]
        win[ i ] = f32[ pow[ hn, 0.85 ] ]
    # the mel triangles over the 256 useful fft bins
    lo  : f64 [ 1127.0 * log[ 1.0 + 20.0 / 700.0 ] ]
    hi  : f64 [ 1127.0 * log[ 1.0 + 8000.0 / 700.0 ] ]
    dlt : f64 [ (hi - lo) / 81.0 ]
    bank : vec f32 [ 80 * 256 ]
    for [ m: i32 0, m < 80, m += 1 ]
        l : f64 [ lo + f64[ m ] * dlt ]
        c : f64 [ l + dlt ]
        r : f64 [ c + dlt ]
        for [ j: i32 0, j < 256, j += 1 ]
            mj : f64 [ 1127.0 * log[ 1.0 + f64[ j ] * 31.25 / 700.0 ] ]
            up : f64 [ (mj - l) / (c - l) ]
            dn : f64 [ (r - mj) / (r - c) ]
            v  : f64 [ (up < dn) ? up : dn ]
            bank[ m * 256 + j ] = (v > 0.0) ? f32[ v ] : 0.0
    out : vec f32 [ i64[ frames ] * 80 ]
    fr  : vec f64 [ 512 ]
    re  : vec f64 [ 257 ]
    pw  : vec f64 [ 257 ]
    for [ t: i32 0, t < frames, t += 1 ]
        base : i64 [ i64[ t ] * 160 ]
        mean : f64 [ 0.0 ]
        for [ i: i32 0, i < 400, i += 1 ]
            mean += f64[ pcm[ base + i ] ]
        mean = mean / 400.0
        prev : f64 [ f64[ pcm[ base ] ] - mean ]
        for [ i: i32 0, i < 400, i += 1 ]
            v : f64 [ f64[ pcm[ base + i ] ] - mean ]
            fr[ i ] = (v - 0.97 * prev) * f64[ win[ i ] ]
            prev = v
        for [ i: i32 400, i < 512, i += 1 ]
            fr[ i ] = 0.0
        # the power spectrum by a plain dft (400 real samples)
        for [ k: i32 0, k < 257, k += 1 ]
            sr : f64 [ 0.0 ]
            si : f64 [ 0.0 ]
            w9 : f64 [ 2.0 * 3.14159265358979323846 * f64[ k ] / 512.0 ]
            for [ i: i32 0, i < 400, i += 1 ]
                sr += fr[ i ] * cos[ w9 * f64[ i ] ]
                si -= fr[ i ] * sin[ w9 * f64[ i ] ]
            pw[ k ] = sr * sr + si * si
        for [ m: i32 0, m < 80, m += 1 ]
            e : f64 [ 0.0 ]
            for [ j: i32 0, j < 256, j += 1 ]
                e += f64[ bank[ m * 256 + j ] ] * pw[ j ]
            if [ e < 0.00000011920929 ] e = 0.00000011920929
            ix9 : i64 [ i64[ t ] * 80 + m ]
            out[ ix9 ] = f32[ log[ e ] ]
    for [ m: i32 0, m < 80, m += 1 ]
        s : f64 [ 0.0 ]
        for [ t: i32 0, t < frames, t += 1 ]
            s += f64[ out[ i64[ t ] * 80 + m ] ]
        mu : f32 [ f32[ s / f64[ frames ] ] ]
        for [ t: i32 0, t < frames, t += 1 ]
            ix9 : i64 [ i64[ t ] * 80 + m ]
            out[ ix9 ] = out[ i64[ t ] * 80 + m ] - mu
    return out

class CAMPPlus
    public  src   : path
    public  valid : bool
    intern  ck    : pth

    func init []
        ck = pth [ src: src ]
        valid = ck.valid

    func floats [ name: string ] -> vec f32
        t : tensor ck.tensor_named[ name ]
        if [ !t ] return vec f32 []
        n : i64 [ t.tensor_shape.total[] ]
        out : vec f32 [ n ]
        memcpy[ @out[ 0 ], t.floats, n * 4 ]
        return out

    func conv_of [ name: string, cin: i32, cout: i32, kh: i32, kw: i32 ] -> Conv
        return Conv [ w: floats[ '{name}.weight' ], b: floats[ '{name}.bias' ],
            cin: cin, cout: cout, kh: kh, kw: kw ]

    # affine false: only the running statistics
    func norm_of [ name: string, n: i32 ] -> Norm
        mu : vec f32 floats[ '{name}.running_mean' ]
        va : vec f32 floats[ '{name}.running_var' ]
        wt : vec f32 floats[ '{name}.weight' ]
        bs : vec f32 floats[ '{name}.bias' ]
        nm : Norm [ scale: vec f32 [ i64[ n ] ], shift: vec f32 [ i64[ n ] ] ]
        for [ i: i32 0, i < n, i += 1 ]
            g : f32 [ (wt.count > 0) ? wt[ i ] : 1.0 ]
            b : f32 [ (bs.count > 0) ? bs[ i ] : 0.0 ]
            s : f32 [ g / sqrtf[ va[ i ] + 0.00001 ] ]
            nm.scale[ i ] = s
            nm.shift[ i ] = b - mu[ i ] * s
        return nm

    # x [ch, len] in place: batchnorm, then relu when asked
    func bn_apply [ nm: Norm, x: vec f32, ch: i32, len: i32, relu: bool ]
        for [ c: i32 0, c < ch, c += 1 ]
            s : f32 [ nm.scale[ c ] ]
            h : f32 [ nm.shift[ c ] ]
            for [ q: i32 0, q < len, q += 1 ]
                v : f32 [ x[ i64[ c ] * len + q ] * s + h ]
                if [ relu && v < 0.0 ] v = 0.0
                ix9 : i64 [ i64[ c ] * len + q ]
                x[ ix9 ] = v
        return

    # x [cin, h, w] -> [cout, oh, w]: 3x3 (or 1x1), stride sh on h
    func conv2d [ c: Conv, x: vec f32, h: i32, w: i32, sh: i32 ] -> vec f32
        pad : i32 [ c.kh / 2 ]
        oh  : i32 [ (h + 2 * pad - c.kh) / sh + 1 ]
        y   : vec f32 [ i64[ c.cout ] * oh * w ]
        for [ co: i32 0, co < c.cout, co += 1 ]
            for [ ci: i32 0, ci < c.cin, ci += 1 ]
                for [ ky: i32 0, ky < c.kh, ky += 1 ]
                    for [ kx: i32 0, kx < c.kw, kx += 1 ]
                        wv : f32 [ c.w[ ((i64[ co ] * c.cin + ci) * c.kh + ky) * c.kw + kx ] ]
                        dx : i32 [ kx - c.kw / 2 ]
                        for [ r: i32 0, r < oh, r += 1 ]
                            ih : i32 [ r * sh + ky - pad ]
                            if [ ih < 0 || ih >= h ] continue
                            yr : @f32 [ @y[ (i64[ co ] * oh + r) * w ] ]
                            xr : @f32 [ @x[ (i64[ ci ] * h + ih) * w ] ]
                            q0 : i32 [ (dx < 0) ? 0 - dx : 0 ]
                            q1 : i32 [ (dx > 0) ? w - dx : w ]
                            for [ q: i32 q0, q < q1, q += 1 ]
                                yr[ q ] += wv * xr[ q + dx ]
        if [ c.b.count > 0 ]
            for [ co: i32 0, co < c.cout, co += 1 ]
                for [ q: i64 0, q < i64[ oh ] * w, q += 1 ]
                    ix9 : i64 [ i64[ co ] * oh * w + q ]
                    y[ ix9 ] += c.b[ co ]
        return y

    # x [cin, len] -> [cout, olen]
    func conv1d [ c: Conv, x: vec f32, len: i32, stride: i32, dil: i32, pad: i32 ] -> vec f32
        ol : i32 [ (len + 2 * pad - dil * (c.kw - 1) - 1) / stride + 1 ]
        y  : vec f32 [ i64[ c.cout ] * ol ]
        for [ co: i32 0, co < c.cout, co += 1 ]
            yr : @f32 [ @y[ i64[ co ] * ol ] ]
            bv : f32 [ (c.b.count > 0) ? c.b[ co ] : 0.0 ]
            for [ q: i32 0, q < ol, q += 1 ]
                yr[ q ] = bv
            for [ ci: i32 0, ci < c.cin, ci += 1 ]
                xr : @f32 [ @x[ i64[ ci ] * len ] ]
                for [ j: i32 0, j < c.kw, j += 1 ]
                    wv : f32 [ c.w[ (i64[ co ] * c.cin + ci) * c.kw + j ] ]
                    for [ q: i32 0, q < ol, q += 1 ]
                        ix : i32 [ q * stride + j * dil - pad ]
                        if [ ix >= 0 && ix < len ] yr[ q ] += wv * xr[ ix ]
        return y

    # a basic residual block of the head (on [32, h, w])
    func res_block [ base: string, x: vec f32, h: i32, w: i32, sh: i32 ] -> vec f32
        c1 : Conv conv_of[ '{base}.conv1', 32, 32, 3, 3 ]
        c2 : Conv conv_of[ '{base}.conv2', 32, 32, 3, 3 ]
        oh : i32 [ (h + 2 - 3) / sh + 1 ]
        o  : vec f32 conv2d[ c1, x, h, w, sh ]
        bn_apply[ norm_of[ '{base}.bn1', 32 ], o, 32, oh * w, true ]
        o = conv2d[ c2, o, oh, w, 1 ]
        bn_apply[ norm_of[ '{base}.bn2', 32 ], o, 32, oh * w, false ]
        sc : vec f32 [ null ]
        if [ sh != 1 ]
            s9 : Conv conv_of[ '{base}.shortcut.0', 32, 32, 1, 1 ]
            sc = conv2d[ s9, x, h, w, sh ]
            bn_apply[ norm_of[ '{base}.shortcut.1', 32 ], sc, 32, oh * w, false ]
        el
            sc = x
        for [ i: i64 0, i < o.count, i += 1 ]
            v : f32 [ o[ i ] + sc[ i ] ]
            o[ i ] = (v > 0.0) ? v : 0.0
        return o

    # one dense layer's new 32 channels from x [cin, len]
    func dense_layer [ base: string, x: vec f32, cin: i32, len: i32, dil: i32 ] -> vec f32
        h : vec f32 [ i64[ cin ] * len ]
        memcpy[ @h[ 0 ], @x[ 0 ], i64[ cin ] * len * 4 ]
        bn_apply[ norm_of[ '{base}.nonlinear1.batchnorm', cin ], h, cin, len, true ]
        h = conv1d[ conv_of[ '{base}.linear1', cin, 128, 1, 1 ], h, len, 1, 1, 0 ]
        bn_apply[ norm_of[ '{base}.nonlinear2.batchnorm', 128 ], h, 128, len, true ]
        y : vec f32 conv1d[ conv_of[ '{base}.cam_layer.linear_local', 128, 32, 1, 3 ], h, len, 1, dil, dil ]
        # context: the mean over all of it plus the mean of its 100-frame segment
        nseg : i32 [ (len + 99) / 100 ]
        ctx : vec f32 [ i64[ 128 ] * len ]
        for [ c: i32 0, c < 128, c += 1 ]
            tot : f64 [ 0.0 ]
            for [ q: i32 0, q < len, q += 1 ]
                tot += f64[ h[ i64[ c ] * len + q ] ]
            tot = tot / f64[ len ]
            for [ s: i32 0, s < nseg, s += 1 ]
                a0 : i32 [ s * 100 ]
                a1 : i32 [ (a0 + 100 < len) ? a0 + 100 : len ]
                sm : f64 [ 0.0 ]
                for [ q: i32 a0, q < a1, q += 1 ]
                    sm += f64[ h[ i64[ c ] * len + q ] ]
                v : f32 [ f32[ tot + sm / f64[ a1 - a0 ] ] ]
                for [ q: i32 a0, q < a1, q += 1 ]
                    ix9 : i64 [ i64[ c ] * len + q ]
                    ctx[ ix9 ] = v
        m : vec f32 conv1d[ conv_of[ '{base}.cam_layer.linear1', 128, 64, 1, 1 ], ctx, len, 1, 1, 0 ]
        for [ i: i64 0, i < m.count, i += 1 ]
            if [ m[ i ] < 0.0 ] m[ i ] = 0.0
        m = conv1d[ conv_of[ '{base}.cam_layer.linear2', 64, 32, 1, 1 ], m, len, 1, 1, 0 ]
        for [ i: i64 0, i < y.count, i += 1 ]
            y[ i ] = y[ i ] / (1.0 + expf[ 0.0 - m[ i ] ])
        return y

    # 16 kHz samples in [-1, 1] to the 192-number style
    public func embed [ pcm: vec f32 ] -> vec f32
        nf : local i32 [ 1 ]
        fb : vec f32 kaldi_fbank[ pcm, @nf[ 0 ] ]
        t : i32 [ nf[ 0 ] ]
        if [ t < 8 ] return vec f32 []
        # [frames, 80] to [1, 80, frames]
        x : vec f32 [ i64[ 80 ] * t ]
        for [ q: i32 0, q < t, q += 1 ]
            for [ m: i32 0, m < 80, m += 1 ]
                ix9 : i64 [ i64[ m ] * t + q ]
                x[ ix9 ] = fb[ i64[ q ] * 80 + m ]
        h : i32 [ 80 ]
        x = conv2d[ conv_of[ 'head.conv1', 1, 32, 3, 3 ], x, h, t, 1 ]
        bn_apply[ norm_of[ 'head.bn1', 32 ], x, 32, h * t, true ]
        x = res_block[ 'head.layer1.0', x, h, t, 2 ]
        h = 40
        x = res_block[ 'head.layer1.1', x, h, t, 1 ]
        x = res_block[ 'head.layer2.0', x, h, t, 2 ]
        h = 20
        x = res_block[ 'head.layer2.1', x, h, t, 1 ]
        x = conv2d[ conv_of[ 'head.conv2', 32, 32, 3, 3 ], x, h, t, 2 ]
        h = 10
        bn_apply[ norm_of[ 'head.bn2', 32 ], x, 32, h * t, true ]
        # [32, 10, t] is already [320, t]
        x = conv1d[ conv_of[ 'xvector.tdnn.linear', 320, 128, 1, 5 ], x, t, 2, 1, 2 ]
        t = (t + 4 - 5) / 2 + 1
        bn_apply[ norm_of[ 'xvector.tdnn.nonlinear.batchnorm', 128 ], x, 128, t, true ]
        ch : i32 [ 128 ]
        layers : vec i32 [] [ 12, 24, 16 ]
        dils   : vec i32 [] [ 1, 2, 2 ]
        for [ b: i32 0, b < 3, b += 1 ]
            for [ l: i32 0, l < layers[ b ], l += 1 ]
                y : vec f32 dense_layer[ 'xvector.block{b + 1}.tdnnd{l + 1}', x, ch, t, dils[ b ] ]
                grown : vec f32 [ i64[ ch + 32 ] * t ]
                memcpy[ @grown[ 0 ], @x[ 0 ], i64[ ch ] * t * 4 ]
                memcpy[ @grown[ i64[ ch ] * t ], @y[ 0 ], i64[ 32 ] * t * 4 ]
                x = grown
                ch += 32
            bn_apply[ norm_of[ 'xvector.transit{b + 1}.nonlinear.batchnorm', ch ], x, ch, t, true ]
            x = conv1d[ conv_of[ 'xvector.transit{b + 1}.linear', ch, ch / 2, 1, 1 ], x, t, 1, 1, 0 ]
            ch = ch / 2
        bn_apply[ norm_of[ 'xvector.out_nonlinear.batchnorm', ch ], x, ch, t, true ]
        # mean and (unbiased) deviation over time
        st : vec f32 [ i64[ ch ] * 2 ]
        for [ c: i32 0, c < ch, c += 1 ]
            s : f64 [ 0.0 ]
            for [ q: i32 0, q < t, q += 1 ]
                s += f64[ x[ i64[ c ] * t + q ] ]
            mu : f64 [ s / f64[ t ] ]
            v : f64 [ 0.0 ]
            for [ q: i32 0, q < t, q += 1 ]
                d : f64 [ f64[ x[ i64[ c ] * t + q ] ] - mu ]
                v += d * d
            st[ c ] = f32[ mu ]
            st[ ch + c ] = f32[ sqrt[ v / f64[ t - 1 ] ] ]
        e : vec f32 conv1d[ conv_of[ 'xvector.dense.linear', ch * 2, 192, 1, 1 ], st, 1, 1, 1, 0 ]
        bn_apply[ norm_of[ 'xvector.dense.nonlinear.batchnorm', 192 ], e, 192, 1, false ]
        return e
