# one serialized call; it invokes a Composer method
class Op
    public why : string
    func invoke [ c: Composer ] -> bool
        return false
    # the pass it runs in: fetches, then crops, then inserts
    func stage [] -> i32
        return -1

# take/<name>.<ext>: kept if present, else downloaded
Op Fetch
    public name : string
    public url  : string
    func invoke [ c: Composer ] -> bool
        return c.fetch[ name, url ]
    func stage [] -> i32
        return 0

# removes the take's span from..to, picture and sound
Op Crop
    public from : f64
    public to   : f64
    func invoke [ c: Composer ] -> bool
        return c.crop[ from, to ]
    func stage [] -> i32
        return 1

# a resource from the take's folder over the take at `at`
Op Insert
    public at     : f64
    public media  : string
    public from   : f64
    public to     : f64
    public dur    : f64
    public place  : string [ 'pip' ]
    public corner : string [ 'br' ]
    # pip width as a share of the frame's: a third by default
    public size   : f64 [ 0.33 ]
    # 'x y w h', each a share of the frame
    public region : string
    public volume : f64
    public fade   : f64 [ 0.25 ]
    # 'take' keeps the take's sound under it; 'media' uses the insert's
    public sound  : string [ 'take' ]
    # the take holds while it plays: a cut to it, the output grows
    public pause  : bool
    func invoke [ c: Composer ] -> bool
        return c.insert[ a ]
    func stage [] -> i32
        return 2

# a big-endian u32 out of a box
func box32 [ b: vec u8, at: i64 ] -> i64
    return (i64[ b[ at ] ] << 24) | (i64[ b[ at + 1 ] ] << 16) | (i64[ b[ at + 2 ] ] << 8) | i64[ b[ at + 3 ] ]

func box64 [ b: vec u8, at: i64 ] -> i64
    return (box32[ b, at ] << 32) | box32[ b, at + 4 ]

# a take's length in seconds from its fragments (video, 90 kHz)
func take_length [ p: path ] -> f64
    fd : i32 [ open[ p.chars, O_RDONLY, 0 ] ]
    if [ fd < 0 ] return 0.0
    hd : local u8 [ 8 ]
    last : i64 [ 0 ]
    # the first track's clock; our own takes run at 90 kHz
    scale : i64 [ 90000 ]
    for [ true ]
        if [ read[ fd, @hd[ 0 ], 8 ] < 8 ] break
        size : i64 [
            (i64[ hd[ 0 ] ] << 24) | (i64[ hd[ 1 ] ] << 16) | (i64[ hd[ 2 ] ] << 8) | i64[ hd[ 3 ] ] ]
        tag  : i64 [
            (i64[ hd[ 4 ] ] << 24) | (i64[ hd[ 5 ] ] << 16) | (i64[ hd[ 6 ] ] << 8) | i64[ hd[ 7 ] ] ]
        if [ size < 8 ] break
        if [ tag == 0x6D6F6F76 ]
            mv : vec u8 [ size - 8 ]
            if [ read[ fd, @mv[ 0 ], size - 8 ] < size - 8 ] break
            for [ i: i64 0, i + 24 < mv.count, i += 1 ]
                if [ box32[ mv, i ] == 0x6D646864 ]
                    ts9 : i64 [
                        (mv[ i + 4 ] == 1) ? box32[ mv, i + 24 ]
                        : box32[ mv, i + 16 ] ]
                    if [ ts9 > 0 ] scale = ts9
                    break
            continue
        if [ tag != 0x6D6F6F66 ]
            lseek[ fd, size - 8, SEEK_CUR ]
            continue
        b : vec u8 [ size - 8 ]
        if [ read[ fd, @b[ 0 ], size - 8 ] < size - 8 ] break
        at : i64 [ 0 ]
        while [ at + 8 <= size - 8 ]
            bs : i64 [ box32[ b, at ] ]
            if [ bs < 8 ] break
            if [ box32[ b, at + 4 ] == 0x74726166 ]
                track : i64 [ 0 ]
                dur   : i64 [ 0 ]
                base  : i64 [ 0 ]
                count : i64 [ 0 ]
                c : i64 [ at + 8 ]
                while [ c + 8 <= at + bs ]
                    cs : i64 [ box32[ b, c ] ]
                    ct : i64 [ box32[ b, c + 4 ] ]
                    if [ cs < 8 ] break
                    if [ ct == 0x74666864 ]
                        fl : i64 [ box32[ b, c + 8 ] & 0xFFFFFF ]
                        track = box32[ b, c + 12 ]
                        o : i64 [ c + 16 ]
                        if [ (fl & 1) != 0 ] o += 8
                        if [ (fl & 2) != 0 ] o += 4
                        if [ (fl & 8) != 0 ] dur = box32[ b, o ]
                    if [ ct == 0x74666474 ]
                        base = (b[ c + 8 ] == 1) ? box64[ b,
                                                          c
                                                          + 12 ] : box32[
                                                              b,
                                                              c + 12 ]
                    if [ ct == 0x7472756E ] count = box32[ b, c + 12 ]
                    c += cs
                if [ track == 1 && base + count * dur > last ]
                    last = base + count * dur
            at += bs
    close[ fd ]
    return f64[ last ] / f64[ scale ]


# 12 floats: limited-range yuv to rgb, three rows of (y, u, v, add)
func yuv_rows [ bt: bool ] -> @f32
    ky : f32 [ 255.0 / 219.0 ]
    kc : f32 [ 255.0 / 224.0 ]
    rv : f32 [ (bt) ? 1.5748 : 1.402 ]
    gu : f32 [ (bt) ? 0.1873 : 0.3441 ]
    gv : f32 [ (bt) ? 0.4681 : 0.7141 ]
    bu : f32 [ (bt) ? 1.8556 : 1.772 ]
    y0 : f32 [ 16.0 / 255.0 * ky ]
    c0 : f32 [ 128.0 / 255.0 * kc ]
    r : new f32 [ 12 ]
    r[0]  = ky
    r[1]  = 0.0
    r[2]  = rv * kc
    r[3]  = 0.0 - y0 - rv * c0
    r[4]  = ky
    r[5]  = 0.0 - gu * kc
    r[6]  = 0.0 - gv * kc
    r[7]  = 0.0 - y0 + (gu + gv) * c0
    r[8]  = ky
    r[9]  = bu * kc
    r[10] = 0.0
    r[11] = 0.0 - y0 - bu * c0
    return r

# a video picture's three planes on the gpu
class Planes
    context vk   : vk_context
    context w    : Display
    public  y    : Texture
    public  u    : Texture
    public  v    : Texture
    public  width  : i32
    public  height : i32
    public  bt709  : bool

    func put [ f: VideoFrame ]
        cw : i32 [ (f.full) ? f.width : f.width / 2 ]
        ch : i32 [ (f.full) ? f.height : f.height / 2 ]
        if [
            !y || width != f.width || height != f.height
            || u.width != cw ]
            y = Texture [ vk: vk, w: w, width: f.width, height: f.height,
                          linear: true,
                pixel_format: Pixel.u8, surface: Surface.color,
                tag: 'composer' ]
            u = Texture [ vk: vk, w: w, width: cw, height: ch,
                          linear: true,
                pixel_format: Pixel.u8, surface: Surface.color,
                tag: 'composer' ]
            v = Texture [ vk: vk, w: w, width: cw, height: ch,
                          linear: true,
                pixel_format: Pixel.u8, surface: Surface.color,
                tag: 'composer' ]
            width  = f.width
            height = f.height
        y.upload[ @f.y[ 0 ], i64[ f.width ] * f.height ]
        u.upload[ @f.u[ 0 ], i64[ cw ] * ch ]
        v.upload[ @f.v[ 0 ], i64[ cw ] * ch ]

    func draw [ cv: Canvas, r: rect ]
        if [ !y ] return
        cv.draw_yuv[ y, u, v, r.x, r.y, r.w, r.h, yuv_rows[ bt709 ] ]

# the bytes of a file
# one track's aac samples, gathered into one buffer, as pcm
func clip_of [ t: DemuxTrack, got: vec DemuxSample ] -> AudioClip
    total : i64 [ 0 ]
    for [ ds: DemuxSample ] in got
        if [ ds.track == t.id ] total += ds.data.count
    if [ total == 0 ] return null
    data : vec u8 [ total ]
    offs : vec i64 []
    szs  : vec i64 []
    o : i64 [ 0 ]
    for [ ds: DemuxSample ] in got
        if [ ds.track == t.id ]
            n9 : i64 [ ds.data.count ]
            memcpy[ @data[ o ], @ds.data[ 0 ], n9 ]
            offs.push[ o ]
            szs.push[ n9 ]
            o += n9
    return aac_clip[ @t.config[ 0 ], i32[ t.config.count ], @data[ 0 ],
                     offs, szs, t.shift ]

# a reference voice: a .wav, or the AAC sound of an mp4/m4a/mov
func voice_clip [ p: path ] -> AudioClip
    s9 : string '{p}'
    low : string s9.lcase[]
    if [ low.ends_with[ '.wav' ] ] return wav_load[ p ]
    bytes : vec u8 file_bytes[ p ]
    if [ !bytes || bytes.count == 0 ] return null
    dm : Demux []
    if [ dm.read_bytes[ @bytes[ 0 ], bytes.count ] ]
        for [ t: DemuxTrack ] in dm.tracks
            if [ t.kind == 2 && t.samples[] > 0 ]
                return aac_clip[ @t.config[ 0 ], i32[ t.config.count ],
                                 @bytes[ 0 ],
                    t.offsets, t.sizes, t.shift ]
        return null
    fm : Demux []
    fm.append[ @bytes[ 0 ], bytes.count ]
    at : DemuxTrack [ null ]
    for [ t: DemuxTrack ] in fm.tracks
        if [ t.kind == 2 && !at ] at = t
    if [ !at ] return null
    return clip_of[ at, fm.ready ]

intern func fnv1a_hash [ @u8, size_t, u64 ] -> u64

# a clip's size and a hash of its bytes: a changed one retrains
func voice_fingerprint [ p: path ] -> string
    b : vec u8 file_bytes[ p ]
    if [ !b || b.count == 0 ] return string [ '' ]
    h : u64 [ fnv1a_hash[ @b[ 0 ], b.count, 1469598103934665603 ] ]
    return string '{b.count} {h}'

func file_bytes [ p: path ] -> vec u8
    fd : i32 [ open[ p.chars, O_RDONLY, 0 ] ]
    if [ fd < 0 ] return null
    n : i64 [ lseek[ fd, 0, SEEK_END ] ]
    lseek[ fd, 0, SEEK_SET ]
    b : vec u8 [ n ]
    got : i64 [ 0 ]
    while [ got < n ]
        k : i64 [ read[ fd, @b[ got ], n - got ] ]
        if [ k <= 0 ] break
        got += k
    close[ fd ]
    return b

# 'avc1' / 'hvc1' / 'hev1' as the sample entry's four bytes
func is_hevc [ codec: i64 ] -> bool
    return codec == 0x68766331 || codec == 0x68657631

# an insert's media: a picture, or a video (and its sound)
class Media
    context vk    : vk_context
    context w     : Display
    public  file  : path
    public  pic   : Texture
    public  video : bool
    # an animated gif: its frames, shown in turn on pic
    intern  gif   : handle
    intern  gif_shown : i32 [ -1 ]
    intern  gif_total : i64
    public  width : i32
    public  height : i32
    # the video's samples in decode order, its decoder and picture
    intern  samples : vec DemuxSample
    intern  next    : i64
    intern  dec     : Decoder
    intern  scale   : i64
    public  planes  : Planes
    # its sound at 48 kHz stereo, when it has one
    public  sound   : AudioClip

    func load [] -> bool
        s : string '{file}'
        low : string s.lcase[]
        if [ low.ends_with[ '.gif' ] ]
            gif = gif_open[ s.chars ]
            if [ !gif ] return false
            width  = gif_width[ gif ]
            height = gif_height[ gif ]
            for [ i: i32 0, i < gif_count[ gif ], i += 1 ]
                gif_total += i64[ gif_delay[ gif, i ] ]
            pic = Texture [ vk: vk, w: w, width: width, height: height,
                            linear: true,
                pixel_format: Pixel.rgba8, surface: Surface.color,
                tag: 'composer' ]
            gif_show[ 0.0 ]
            return true
        if [
            !(low.ends_with[ '.mp4' ] || low.ends_with[ '.mov' ] || low.ends_with[ '.m4v' ]) ]
            im : Image [ uri: file ]
            if [ !im || im.width <= 0 ] return false
            # the canvas blends premultiplied; a png is straight
            if [ im.channels == 4 && im.pixels ]
                px : @u8 [ im.pixels ]
                n4 : i64 [ i64[ im.width ] * im.height * 4 ]
                for [ i: i64 0, i < n4, i += 4 ]
                    al : i32 [ px[ i + 3 ] ]
                    px[ i ]     = u8[ i32[ px[ i ] ] * al / 255 ]
                    px[ i + 1 ] = u8[ i32[ px[ i + 1 ] ] * al / 255 ]
                    px[ i + 2 ] = u8[ i32[ px[ i + 2 ] ] * al / 255 ]
            pic    = Texture [ vk: vk, w: w, sampler: im, linear: true ]
            width  = im.width
            height = im.height
            return true
        video = true
        bytes : vec u8 file_bytes[ file ]
        if [ !bytes || bytes.count == 0 ] return false
        dm : Demux []
        # a plain file is read whole; a fragmented one by its fragments
        if [ !dm.read_bytes[ @bytes[ 0 ], bytes.count ] ]
            dm = Demux []
            dm.append[ @bytes[ 0 ], bytes.count ]
        vt : DemuxTrack [ null ]
        at : DemuxTrack [ null ]
        for [ t: DemuxTrack ] in dm.tracks
            if [ t.kind == 1 && !vt ] vt = t
            if [ t.kind == 2 && !at ] at = t
        if [ !vt ] return false
        samples = vec DemuxSample []
        scale = vt.timescale
        if [ vt.samples[] > 0 ]
            for [ i: i64 0, i < vt.samples[], i += 1 ]
                ds : DemuxSample [ track: vt.id, pts: vt.pts[ i ],
                                   timescale: vt.timescale ]
                ds.data = vec u8 [ vt.sizes[ i ] ]
                memcpy[ @ds.data[ 0 ], @bytes[ vt.offsets[ i ] ],
                        vt.sizes[ i ] ]
                samples.push[ ds ]
        el
            fm : Demux []
            fm.append[ @bytes[ 0 ], bytes.count ]
            for [ ds: DemuxSample ] in fm.ready
                if [ ds.track == vt.id ] samples.push[ ds ]
        dec = Decoder [ vk: vk ]
        ok : bool [
            (is_hevc[ vt.codec ])
            ? dec.config_hevc[ @vt.config[ 0 ], i32[ vt.config.count ] ]
            : dec.config[ @vt.config[ 0 ], i32[ vt.config.count ] ] ]
        if [ !ok ] return false
        width  = dec.width
        height = dec.height
        planes = Planes [ vk: vk, w: w, bt709: height >= 720 ]
        if [ at && vt.samples[] > 0 && at.samples[] > 0 ]
            sound = aac_clip[ @at.config[ 0 ], i32[ at.config.count ],
                              @bytes[ 0 ],
                at.offsets, at.sizes, at.shift ]
        return true

    # a gif's frame at t seconds, looping, premultiplied on upload
    func gif_show [ t: f64 ]
        if [ !gif || gif_total <= 0 ] return
        ms : i64 [ i64[ t * 1000.0 ] % gif_total ]
        k : i32 [ 0 ]
        for [ i: i32 0, i < gif_count[ gif ], i += 1 ]
            k = i
            ms -= i64[ gif_delay[ gif, i ] ]
            if [ ms < 0 ] break
        if [ k == gif_shown ] return
        gif_shown = k
        n : i32 [ width * height * 4 ]
        src : @u8 [ gif_frame[ gif, k ] ]
        pm : new u8 [ n ]
        for [ i: i32 0, i < n, i += 4 ]
            al : i32 [ src[ i + 3 ] ]
            pm[ i ]     = u8[ i32[ src[ i ] ] * al / 255 ]
            pm[ i + 1 ] = u8[ i32[ src[ i + 1 ] ] * al / 255 ]
            pm[ i + 2 ] = u8[ i32[ src[ i + 2 ] ] * al / 255 ]
            pm[ i + 3 ] = u8[ al ]
        pic.upload_region[ 0, 0, width, height, pm, n ]

    func dealloc []
        if [ gif ] gif_free[ gif ]

    # the picture shown at t seconds into the video; a frame is
    # uploaded before the vector lets it go
    func show [ t: f64 ]
        target : i64 [ t * f64[ scale ] ]
        shown : bool [ false ]
        for [ true ]
            if [ dec.frames.count > 0 ]
                f0 : VideoFrame dec.frames[ 0 ]
                if [ f0.pts > target && (shown || next < samples.count || planes.y) ]
                    break
                planes.put[ f0 ]
                shown = true
                dec.frames.remove[ 0 ]
                continue
            if [ next >= samples.count ]
                dec.finish[]
                if [ dec.frames.count == 0 ] break
                continue
            ds : DemuxSample samples[ next ]
            next += 1
            dec.decode[ @ds.data[ 0 ], i32[ ds.data.count ], ds.pts ]

# one piece of the output in order: a span of the take, or a cut
# to an insert while the take holds
class Seg
    public from  : f64
    public to    : f64
    public pause : Overlay

# the take's video read ahead in display order
class Source
    context vk     : vk_context
    public  fd     : i32
    public  dm     : Demux
    public  dec    : Decoder
    public  track  : i64
    public  scale  : i64
    intern  chunk  : new u8 [ 1048576 ]
    intern  ended  : bool
    intern  taken  : i64

    # the frames stay in the decoder's vector until all are taken:
    # the one returned lives until the next call
    func next_frame [] -> VideoFrame
        if [ taken >= dec.frames.count ]
            dec.frames.clear[]
            taken = 0
        for [ dec.frames.count == 0 ]
            if [ ended ] return null
            n : i64 [ read[ fd, chunk, 1048576 ] ]
            if [ n <= 0 ]
                ended = true
                dec.finish[]
                continue
            dm.append[ chunk, n ]
            for [ ds: DemuxSample ] in dm.ready
                if [ ds.track == track ]
                    dec.decode[ @ds.data[ 0 ], i32[ ds.data.count ],
                                ds.pts ]
            dm.ready.clear[]
        f : VideoFrame dec.frames[ taken ]
        taken += 1
        return f

class Renderer
    context vk     : vk_context
    context w      : Display
    public  comp   : Composer
    public  cv     : Canvas
    public  src    : Planes
    public  rec    : Recorder
    public  aac    : Aac
    public  media  : map Media [ string ]
    public  fps    : i32
    public  width  : i32
    public  height : i32
    # the output's pcm, 48 kHz stereo, and how much of it is encoded
    intern  pcm    : vec i16
    intern  fed    : i64
    # the take time this frame shows: a focus is on the take's clock
    public  take_t : f64
    # the zoom as it stands: its box's left, top and size (shares)
    intern  zx     : f32
    intern  zy     : f32
    intern  zs     : f32 [ 1.0 ]
    public  frames : i64
    intern  aout   : new u8 [ 8192 ]

    func media_of [ ins: Insert ] -> Media
        m : Media media[ ins.media ]
        if [ m ] return m
        m = Media [ vk: vk, w: w, file: path '{comp.folder[]}/{ins.media}' ]
        if [ !m.load[] ]
            comp.problems.push[ 'render: cannot read {ins.media}' ]
            return null
        media[ ins.media ] = m
        return m

    # where an insert sits on the frame
    func place [ ins: Insert, m: Media ] -> rect
        fw : f32 [ width ]
        fh : f32 [ height ]
        asp : f32 [ f32[ m.width ] / f32[ m.height ] ]
        if [ ins.place == 'full' ]
            rw : f32 [ fw ]
            rh : f32 [ fw / asp ]
            if [ rh > fh ]
                rh = fh
                rw = fh * asp
            return rect [ x: (fw - rw) / 2.0, y: (fh - rh) / 2.0, w: rw,
                          h: rh ]
        if [ ins.place == 'region' && ins.region ]
            parts : ins.region.split[ ' ' ]
            nums : vec f32 []
            for [ pt: string ] in parts
                if [ pt.count > 0 ] nums.push[ f32[ pt.real_value[] ] ]
            if [ nums.count == 4 ]
                # the picture keeps its shape, centred in the region
                rw : f32 [ nums[ 2 ] * fw ]
                rh : f32 [ nums[ 3 ] * fh ]
                bw : f32 [ rw ]
                bh : f32 [ rw / asp ]
                if [ bh > rh ]
                    bh = rh
                    bw = rh * asp
                return rect [ x: nums[ 0 ] * fw + (rw - bw) / 2.0,
                              y: nums[ 1 ] * fh + (rh - bh) / 2.0, w: bw,
                              h: bh ]
        pw : f32 [ f32[ ins.size ] * fw ]
        ph : f32 [ pw / asp ]
        mg : f32 [ fw * 0.02 ]
        cn : string [ (ins.corner) ? ins.corner : 'br' ]
        px : f32 [ (cn == 'tl' || cn == 'bl') ? mg : fw - pw - mg ]
        py : f32 [ (cn == 'tl' || cn == 'tr') ? mg : fh - ph - mg ]
        return rect [ x: px, y: py, w: pw, h: ph ]

    # fade in and out over the insert's own length
    func fade_at [ ov: Overlay, t: f64 ] -> f32
        fd : f64 [ ov.insert.fade ]
        if [ fd <= 0.0 ] return 1.0
        a : f64 [ (t - ov.out_at) / fd ]
        b : f64 [ (ov.out_at + ov.length - t) / fd ]
        v : f64 [ (a < b) ? a : b ]
        if [ v > 1.0 ] v = 1.0
        if [ v < 0.0 ] v = 0.0
        return f32[ v ]

    func draw_insert [ ov: Overlay, t: f64 ]
        m : Media media_of[ ov.insert ]
        if [ !m ] return
        r : rect place[ ov.insert, m ]
        cv.set_opacity[ fade_at[ ov, t ] ]
        if [ m.video ]
            m.show[ ov.insert.from + (t - ov.out_at) ]
            m.planes.draw[ cv, r ]
        el
            m.gif_show[ t - ov.out_at ]
            cv.draw_image[ m.pic, r ]
        cv.set_opacity[ 1.0 ]

    # where the take is drawn: the zoom box (the whole frame, or a
    # focus's) filling the frame; each frame it moves toward the box
    # wanted now by filter_n, a step per 60 Hz frame
    func take_rect [] -> rect
        gx : f32 [ 0.0 ]
        gy : f32 [ 0.0 ]
        gs : f32 [ 1.0 ]
        amt : f32 [ 0.08 ]
        for [ f: Focus ] in comp.focuses
            if [ take_t < f.from || take_t > f.to ] continue
            b : rect comp.focus_box[ f ]
            if [ b.w <= 0.0 ] continue
            gx = b.x
            gy = b.y
            gs = b.w
            if [ f.speed > 0.0 ] amt = f32[ f.speed ]
            break
        rt : f32 [ 60.0 / f32[ fps ] ]
        zx = filter_n[ zx, gx, amt, rt ]
        zy = filter_n[ zy, gy, amt, rt ]
        zs = filter_n[ zs, gs, amt, rt ]
        fw : f32 [ width ]
        fh : f32 [ height ]
        return rect [ x: 0.0 - zx / zs * fw, y: 0.0 - zy / zs * fh,
                      w: fw / zs, h: fh / zs ]

    # one output frame: the take (unless covered), then the inserts
    func emit [ show_take: bool ]
        t : f64 [ f64[ frames ] / f64[ fps ] ]
        cv.clear_recorded[ vec4f [ 0.0, 0.0, 0.0, 1.0 ] ]
        if [ show_take ] src.draw[ cv, take_rect[] ]
        for [ ov: Overlay ] in comp.overlays
            if [ t >= ov.out_at && t < ov.out_at + ov.length ]
                draw_insert[ ov, t ]
        cv.sync_all[]
        rec.capture[ cv.color ]
        frames += 1
        audio_to[ frames * 48000 / i64[ fps ] ]

    func audio_to [ upto: i64 ]
        if [ !rec.mux ] return
        while [ fed + 1024 <= upto && (fed + 1024) * 2 <= pcm.count ]
            n : i32 [ aac.encode[ @pcm[ fed * 2 ], aout, 8192 ] ]
            fed += 1024
            if [ n > 0 ] rec.mux.audio*[ aout, i64[ n ] ]

    func run [ fd: i32, take_sound: AudioClip, segs: vec Seg ] -> bool
        rec = Recorder [ vk: vk, w: w, fd: fd, fps: fps, qp: 23,
                         format: 'mp4',
            chroma444: false, lossless: false, width: width,
            height: height, paced: false ]
        aac = Aac [ ]
        rec.asc = aac.asc
        media = map Media [ string ] []
        # the output's sound: the take's kept pieces, the cuts' sound
        total : i64 [ 0 ]
        for [ k: Seg ] in segs
            total += i64[
                (k.to - k.from) * f64[ fps ] + 0.5 ] * 48000 / i64[
                    fps ]
        pcm = vec i16 [ total * 2 + 4096 ]
        memset[ @pcm[ 0 ], 0, pcm.count * 2 ]
        at : i64 [ 0 ]
        for [ k: Seg ] in segs
            nf : i64 [
                i64[ (k.to - k.from) * f64[ fps ] + 0.5 ] * 48000
                / i64[ fps ] ]
            if [
                !k.pause && take_sound && take_sound.rate == 48000
                && take_sound.channels == 2 ]
                s0 : i64 [ k.from * 48000.0 ]
                n2 : i64 [ nf ]
                if [ s0 + n2 > take_sound.frames ]
                    n2 = take_sound.frames - s0
                if [ n2 > 0 ]
                    memcpy[ @pcm[ at * 2 ], @take_sound.pcm[ s0 * 2 ],
                            n2 * 4 ]
            at += nf
        # an insert's own sound replaces the take's while it plays
        for [ ov: Overlay ] in comp.overlays
            if [ ov.insert.sound != 'media' ] continue
            m : Media media_of[ ov.insert ]
            if [ !m || !m.sound || m.sound.rate != 48000 || m.sound.channels != 2 ]
                continue
            vol : f64 [
                (ov.insert.volume > 0.0) ? ov.insert.volume : 1.0 ]
            o0 : i64 [ ov.out_at * 48000.0 ]
            m0 : i64 [ ov.insert.from * 48000.0 ]
            n3 : i64 [ ov.length * 48000.0 ]
            for [ i: i64 0, i < n3 * 2, i += 1 ]
                oi : i64 [ o0 * 2 + i ]
                mi : i64 [ m0 * 2 + i ]
                if [ oi >= pcm.count || mi >= m.sound.frames * 2 ] break
                pcm[ oi ] = i16[ f64[ m.sound.pcm[ mi ] ] * vol ]
        return true

    # the frames of the output, piece by piece, the take read once
    func frames_of [ sr: Source, segs: vec Seg ] -> bool
        ahead  : VideoFrame sr.next_frame[]
        for [ k: Seg ] in segs
            nout : i64 [ (k.to - k.from) * f64[ fps ] + 0.5 ]
            if [ k.pause ]
                cover : bool [ k.pause.insert.place == 'full' ]
                # the take holds at the cut: its focus holds too
                take_t = k.pause.at
                for [ i: i64 0, i < nout, i += 1 ]
                    emit[ !cover ]
                continue
            for [ i: i64 0, i < nout, i += 1 ]
                ts : f64 [ k.from + f64[ i ] / f64[ fps ] ]
                take_t = ts
                while [
                    ahead
                    && f64[ ahead.pts ] / f64[ sr.scale ] <= ts + 0.0005 ]
                    src.put[ ahead ]
                    ahead = sr.next_frame[]
                emit[ true ]
        rec.close[]
        return true

# take time from .. to in another voice (rvc, trained on first use)
Op Revoice
    public from  : f64
    public to    : f64
    public voice : string
    # semitones up (negative: down), as rvc's f0_up_key
    public pitch  : i32
    public epochs : i32 [ 100 ]
    func invoke [ c: Composer ] -> bool
        return c.add_voice[ a ]
    func stage [] -> i32
        return 2

# clears the voice from .. to (take time): the mic track alone
# when the take has one, else all of the take's sound
Op Mute
    public from : f64
    public to   : f64
    func invoke [ c: Composer ] -> bool
        return c.add_mute[ a ]
    func stage [] -> i32
        return 2

# zooms the picture onto a region of it from .. to (take time); the
# zoom goes there and back by a decay; the take's sound is untouched
Op Focus
    public from   : f64
    public to     : f64
    # 'x y w h', each a share of the frame (0..1, top left origin)
    public region : string
    # the share of the way it moves each frame, at 60 a second
    public speed  : f64 [ 0.08 ]
    func invoke [ c: Composer ] -> bool
        return c.add_focus[ a ]
    func stage [] -> i32
        return 2

# <stem>.composition.agi: what the agent writes
class Composition
    public source : string
    public output : string
    public ops    : vec Op

# a kept span of the take and its place in the output
class Kept
    public from   : f64
    public to     : f64
    public out_at : f64

# an insert on the output's clock
class Overlay
    public insert : Insert
    public at     : f64
    public out_at : f64
    public length : f64

class Composer
    # its stem names the .agi, composition and folder
    public take     : path
    # the take's length in seconds
    public length   : f64
    public comp     : Composition
    public kept     : vec Kept
    public overlays : vec Overlay
    public voices   : vec Revoice
    public mutes    : vec Mute
    public focuses  : vec Focus
    # each thing asked for that cannot be done
    public problems : vec string
    # trained voices by clip name, shared by every take
    public voice_dir : path

    func stem [] -> string
        s : string '{take}'
        dot : i32 [ s.rindex_of[ '.' ] ]
        return (dot > 0) ? s.mid[ 0, dot ] : s

    # the take's module: the folder holding it, its notes and media
    func module_dir [] -> string
        s : string '{take}'
        sl : i32 [ s.rindex_of[ '/' ] ]
        return (sl > 0) ? s.mid[ 0, sl ] : '.'

    # where media names start: the module's parent, so a name reads
    # '<module>/bugs-bunny.gif'
    func folder [] -> string
        s : string module_dir[]
        sl : i32 [ s.rindex_of[ '/' ] ]
        return (sl > 0) ? s.mid[ 0, sl ] : '.'

    # the user's agent reads the protocol and the take's notes,
    # gathers the resources and writes the composition
    func ask [ agent: string, model: string, shots: vec string ] -> bool
        vp : path '{source_dir[]}/VIDEO.md'
        proto : string [ vp.load[ typeid[ string ], null ] ]
        if [ !proto || proto.count == 0 ]
            problems.push[ 'no protocol at {vp}' ]
            return false
        req : string 'You compose a video from a recording (a take). The protocol, VIDEO.md:\n\n{proto}\n\nThe take: {take} ({length} seconds). Its notes: {stem[]}.agi. Its folder, which holds its resources too: {module_dir[]}/ (media names start with that folder\'s name). Read the notes and look in the folder: files already there are the user\'s, use them. For anything else a mark needs, search the web (WebSearch, WebFetch) for a direct link to the image or video file and write a Fetch op for it (name: the reference name, url: that link); do not download files yourself, the composer downloads every Fetch. Then write {stem[]}.composition.agi as the protocol says. Answer with one short line.'
        # the stills: open them to see what each mark is about
        if [ shots && shots.count > 0 ]
            sl : string ''
            for [ s9: string ] in shots
                sl = '{sl}\n{s9}'
            req = '{req}\n\nA still of the take at the middle of each mark (take time: file); open them to see what was on screen as it was said, and to place a Focus region:{sl}'
        dir : string folder[]
        nm : string [ (agent && agent.count > 0) ? agent : 'claude' ]
        md : string [ (model) ? model : '' ]
        agent_shell_allow[ 'WebSearch WebFetch' ]
        if [
            agent_shell_start[ nm.chars, dir.chars, md.chars,
                               req.chars ] == 0 ]
            problems.push[ 'agent: {string [ agent_shell_error[] ]}' ]
            return false
        log 'composer: {nm} is composing {take}'
        buf : local i8 [ 8192 ]
        t0 : i64 [ Au.epoch_millis[] ]
        fin : bool [ false ]
        for [ !fin ]
            if [ agent_shell_line[ @buf[ 0 ], 8192 ] == 0 ]
                if [ Au.epoch_millis[] - t0 > 900000 ]
                    problems.push[ 'agent: no answer in 15 minutes' ]
                    break
                usleep[ 50000 ]
                continue
            ln : string [ @buf[ 0 ] ]
            if [ !ln.starts_with[ 'diff' ] ] log 'composer: {ln}'
            if [ ln.starts_with[ 'done' ] ] fin = true
            if [ ln.starts_with[ 'needs' ] ]
                problems.push[ 'agent: {ln}' ]
                break
        agent_shell_stop[]
        agent_shell_allow[ '' ]
        return fin

    # a still of the take at each mark (its middle): what was on the
    # screen as it was said, for the agent to see; in <stem>.stills/
    func stills [ disp: Display ] -> vec string
        out : vec string []
        np : path '{stem[]}.agi'
        if [ !disp || !np.exists[] ] return out
        txt : string [ np.load[ typeid[ string ], null ] ]
        notes : RecNotes [ marks: vec RecMark [] ]
        Au.parse_agi[ null, txt.chars, notes ]
        if [ !notes.marks || notes.marks.count == 0 ] return out
        # the video track, from the head of the file
        fd : i32 [ open[ take.chars, O_RDONLY, 0 ] ]
        if [ fd < 0 ] return out
        head : new u8 [ 1048576 ]
        n : i64 [ read[ fd, head, 1048576 ] ]
        close[ fd ]
        dm : Demux []
        dm.append[ head, n ]
        vt : DemuxTrack [ null ]
        for [ t: DemuxTrack ] in dm.tracks
            if [ t.kind == 1 && !vt ] vt = t
        if [ !vt ] return out
        vk9 : vk_context disp.vk
        sfd : i32 [ open[ take.chars, O_RDONLY, 0 ] ]
        sr : Source [ vk: vk9, fd: sfd, dm: Demux [], track: vt.id,
                      scale: vt.timescale,
            dec: Decoder [ vk: vk9 ] ]
        cn : i32 [ i32[ vt.config.count ] ]
        ok : bool [
            (is_hevc[ vt.codec ])
            ? sr.dec.config_hevc[ @vt.config[ 0 ], cn ]
            : sr.dec.config[ @vt.config[ 0 ], cn ] ]
        if [ !ok ]
            close[ sfd ]
            return out
        cv : Canvas [ vk: vk9, w: disp, width: vt.width,
                      height: vt.height, load_existing: true ]
        cv.update[]
        pl : Planes [ vk: vk9, w: disp, bt709: true ]
        dir : path '{stem[]}.stills'
        dir.make_dir[]
        full : rect [ x: 0.0, y: 0.0, w: f32[ vt.width ],
                      h: f32[ vt.height ] ]
        # one pass: each mark takes the first picture at or past it
        mi : i32 [ 0 ]
        f : VideoFrame sr.next_frame[]
        for [ f && mi < notes.marks.count ]
            mk : RecMark notes.marks[ mi ]
            t : f64 [ mk.at + mk.dur * 0.5 ]
            if [ f64[ f.pts ] / f64[ sr.scale ] < t ]
                f = sr.next_frame[]
                continue
            pl.put[ f ]
            cv.reset[ vec4f [ 0.0, 0.0, 0.0, 1.0 ] ]
            pl.draw[ cv, full ]
            cv.sync_all[]
            ms : i64 [ t * 1000.0 ]
            p : path '{dir}/at_{ms}ms.png'
            im : Image [ cv.color ]
            im.png[ p ]
            out.push[ '{t} s: {p}' ]
            mi += 1
        close[ sfd ]
        log 'composer: {out.count} stills in {dir}'
        return out

    # the composer's own folder: VIDEO.md sits beside the source
    func source_dir [] -> string
        f : string '{__FILE__}'
        sl : i32 [ f.rindex_of[ '/' ] ]
        return (sl > 0) ? f.mid[ 0, sl ] : '.'

    # the composition as it stands (the user may have edited it)
    # an h.264 4:4:4 take cannot be decoded on the gpu: say so first
    func readable [] -> bool
        fd : i32 [ open[ take.chars, O_RDONLY, 0 ] ]
        if [ fd < 0 ] return false
        head : new u8 [ 65536 ]
        n : i64 [ read[ fd, head, 65536 ] ]
        close[ fd ]
        dm : Demux []
        dm.append[ head, n ]
        for [ t: DemuxTrack ] in dm.tracks
            if [
                t.kind == 1 && !is_hevc[ t.codec ] && t.config.count > 1
                && t.config[ 1 ] == 244 ]
                problems.push[
                    '{take} is H.264 4:4:4 (recorded before the H.265 change); this GPU cannot decode it. Record it again.' ]
                return false
        return true

    # the whole run: the take's length, the agent, then the plan
    func compose [ agent: string, model: string, disp: Display ] -> bool
        if [ !readable[] ] return false
        length = take_length[ take ]
        if [ length <= 0.0 ]
            problems.push[ 'no video in {take}' ]
            return false
        # a composition newer than the notes is the user's latest
        notes : path '{stem[]}.agi'
        cp : path '{stem[]}.composition.agi'
        if [
            cp.exists[]
            && (!notes.exists[] || cp.modified_time[] >= notes.modified_time[]) ]
            log 'composer: {cp} is newer than the notes: rendering it as it is'
        el [ !ask[ agent, model, stills[ disp ] ] ]
            return false
        if [ !load[] ] return false
        return plan[]

    # the new video: the kept spans, the cuts and the inserts
    func render [ disp: Display ] -> bool
        vk9 : vk_context disp.vk
        # pass 1: the take's picture size, rate and all its sound
        fd : i32 [ open[ take.chars, O_RDONLY, 0 ] ]
        if [ fd < 0 ] return false
        dm : Demux []
        chunk : new u8 [ 1048576 ]
        vt : DemuxTrack [ null ]
        at : DemuxTrack [ null ]
        # a take with --record_mic: the app's sound and the mic too
        ap : DemuxTrack [ null ]
        mc : DemuxTrack [ null ]
        audio : vec DemuxSample []
        fps : i32 [ 0 ]
        last_dts : i64 [ -1 ]
        gap : i64 [ 0 ]
        seen : i64 [ 0 ]
        for [ true ]
            n : i64 [ read[ fd, chunk, 1048576 ] ]
            if [ n <= 0 ] break
            dm.append[ chunk, n ]
            for [ t: DemuxTrack ] in dm.tracks
                if [ t.kind == 1 && !vt ] vt = t
                if [ t.kind == 2 && at && t.id != at.id && !ap ] ap = t
                if [ t.kind == 2 && at && ap && t.id != at.id && t.id != ap.id && !mc ]
                    mc = t
                if [ t.kind == 2 && !at ] at = t
            for [ ds: DemuxSample ] in dm.ready
                if [ vt && ds.track != vt.id ] audio.push[ ds ]
                # the shortest frame gap over 60 pictures is the rate
                if [ vt && ds.track == vt.id && seen < 60 ]
                    d : i64 [ ds.dts - last_dts ]
                    if [ last_dts >= 0 && d > 0 && (gap == 0 || d < gap) ]
                        gap = d
                    last_dts = ds.dts
                    seen += 1
            dm.ready.clear[]
        close[ fd ]
        if [ vt && gap > 0 ]
            fps = i32[ f64[ vt.timescale ] / f64[ gap ] + 0.5 ]
        if [ !vt ]
            problems.push[ 'render: no video in {take}' ]
            return false
        if [ fps <= 0 ] fps = 60
        sound : AudioClip [ null ]
        if [ at ] sound = clip_of[ at, audio ]
        # the stems matter only to a voice change or a mute
        app9 : AudioClip [ null ]
        mic9 : AudioClip [ null ]
        if [ (voices.count > 0 || mutes.count > 0) && ap && mc ]
            app9 = clip_of[ ap, audio ]
            mic9 = clip_of[ mc, audio ]
        apply_mutes[ sound, app9, mic9 ]
        if [ !apply_voices[ sound, app9, mic9, disp ] ] return false
        # the pieces in output order; a cut splits the span it lands in
        segs : vec Seg []
        for [ k: Kept ] in kept
            a : f64 [ k.from ]
            for [ true ]
                cut : Overlay [ null ]
                for [ ov: Overlay ] in overlays
                    if [ ov.insert.pause && ov.at >= a && ov.at < k.to && (!cut || ov.at < cut.at) ]
                        cut = ov
                if [ !cut ] break
                if [ cut.at > a ]
                    segs.push[ Seg [ from: a, to: cut.at ] ]
                segs.push[
                    Seg [ from: 0.0, to: cut.length, pause: cut ] ]
                a = cut.at
                # a later cut at the same moment still comes after this
                # one
                cut.insert.pause = false
            if [ k.to > a ] segs.push[ Seg [ from: a, to: k.to ] ]
        # every insert's place on the output clock, from the pieces
        run9 : f64 [ 0.0 ]
        for [ sg: Seg ] in segs
            if [ sg.pause ]
                sg.pause.out_at = run9
                sg.pause.insert.pause = true
            el
                for [ ov: Overlay ] in overlays
                    if [
                        !ov.insert.pause && ov.at >= sg.from
                        && ov.at < sg.to ]
                        ov.out_at = run9 + ov.at - sg.from
            run9 += f64[
                i64[ (sg.to - sg.from) * f64[ fps ] + 0.5 ] ] / f64[
                    fps ]
        out : path [ (comp.output && comp.output.count > 0) ? path '{module_dir[]}/{comp.output}' : path '{stem[]}.final.mp4' ]
        ofd : i32 [
            open[ out.chars, O_WRONLY | O_CREAT | O_TRUNC, 0x1A4 ] ]
        if [ ofd < 0 ]
            problems.push[ 'render: cannot write {out}' ]
            return false
        cv : Canvas [ vk: vk9, w: disp, width: vt.width,
                      height: vt.height,
            load_existing: true, paint_n: 1024 ]
        cv.update[]
        cv.reset[ vec4f [ 0.0, 0.0, 0.0, 1.0 ] ]
        r : Renderer [ vk: vk9, w: disp, comp: a, cv: cv, fps: fps,
            width: vt.width, height: vt.height,
            src: Planes [ vk: vk9, w: disp, bt709: true ] ]
        r.run[ ofd, sound, segs ]
        # pass 2: the take's pictures, in order
        sfd : i32 [ open[ take.chars, O_RDONLY, 0 ] ]
        sr : Source [ vk: vk9, fd: sfd, dm: Demux [], track: vt.id,
                      scale: vt.timescale,
            dec: Decoder [ vk: vk9 ] ]
        ok9 : bool [
            (is_hevc[ vt.codec ])
            ? sr.dec.config_hevc[ @vt.config[ 0 ], i32[ vt.config.count ] ]
            : sr.dec.config[ @vt.config[ 0 ], i32[ vt.config.count ] ] ]
        if [ !ok9 ]
            problems.push[ 'render: the take cannot be decoded here' ]
            close[ sfd ]
            close[ ofd ]
            return false
        r.frames_of[ sr, segs ]
        close[ sfd ]
        close[ ofd ]
        log 'composer: wrote {out}: {r.frames} frames at {fps} a second'
        return true

    func load [] -> bool
        cp : path '{stem[]}.composition.agi'
        if [ !cp.exists[] ]
            problems.push[ 'no composition at {cp}' ]
            return false
        txt : string [ cp.load[ typeid[ string ], null ] ]
        comp = Composition [ ops: vec Op [] ]
        Au.parse_agi[ null, txt.chars, comp ]
        return true

    # fetches, then crops (the output clock), then inserts
    func plan [] -> bool
        kept     = vec Kept [] [
            Kept [ from: 0.0, to: length, out_at: 0.0 ] ]
        overlays = vec Overlay []
        voices   = vec Revoice []
        mutes    = vec Mute []
        focuses  = vec Focus []
        if [ !comp ] return false
        # *[] dispatches to the subclass; [] binds to Op's own
        for [ st: i32 0, st < 3, st += 1 ]
            for [ o: Op ] in comp.ops
                if [ o.stage*[] == st ] o.invoke*[ a ]
        # a paused insert pushes everything after it down the output
        for [ ov: Overlay ] in overlays
            for [ pv: Overlay ] in overlays
                if [ pv.insert.pause && pv.at < ov.at ]
                    ov.out_at += pv.length
        return problems.count == 0

    # the folder's file called name, any extension
    func resource [ name: string ] -> path
        for [ x: string ]
            in vec string [] [ 'jpg', 'jpeg', 'png', 'webp', 'gif',
                               'mp4', 'mov', 'webm' ]
            p : path '{module_dir[]}/{name}.{x}'
            if [ p.exists[] ] return p
        return null

    func fetch [ name: string, url: string ] -> bool
        if [ resource[ name ] ] return true
        if [ !url || url.count == 0 ]
            problems.push[
                'fetch {name}: not in the folder and no url' ]
            return false
        q : i32 [ url.index_of[ '?' ] ]
        bare : string [ (q > 0) ? url.mid[ 0, q ] : url ]
        dot : i32 [ bare.rindex_of[ '.' ] ]
        ext : string [
            (dot > 0 && bare.count - dot <= 5)
            ? bare.mid[ dot + 1, bare.count - dot - 1 ] : 'jpg' ]
        dest : path '{module_dir[]}/{name}.{ext}'
        Http.download[ url, dest ]
        if [ !dest.exists[] ]
            problems.push[ 'fetch {name}: download of {url} failed' ]
            return false
        log 'composer: fetched {name} -> {dest}'
        return true

    func crop [ from: f64, to: f64 ] -> bool
        if [ to <= from || from < 0.0 || to > length ]
            problems.push[
                'crop {from}..{to} is outside the take (0..{length})' ]
            return false
        next : vec Kept []
        for [ k: Kept ] in kept
            if [ to <= k.from || from >= k.to ]
                next.push[ k ]
            el
                if [ from > k.from ]
                    next.push[ Kept [ from: k.from, to: from ] ]
                if [ to < k.to ]
                    next.push[ Kept [ from: to, to: k.to ] ]
        run : f64 [ 0.0 ]
        for [ k: Kept ] in next
            k.out_at = run
            run += k.to - k.from
        kept = next
        return true

    # the output time of take time t; -1 inside a crop
    func out_time [ t: f64 ] -> f64
        for [ k: Kept ] in kept
            if [ t >= k.from && t < k.to ]
                return k.out_at + (t - k.from)
        return -1.0

    func add_focus [ f: Focus ] -> bool
        if [ f.to <= f.from || f.from < 0.0 || f.to > length ]
            problems.push[
                'focus {f.from}..{f.to} is outside the take (0..{length})' ]
            return false
        if [ focus_box[ f ].w <= 0.0 ]
            problems.push[
                'focus at {f.from}: region is not \'x y w h\' in 0..1' ]
            return false
        focuses.push[ f ]
        return true

    # a focus's square of the frame (shares, keeping the frame's
    # shape): its region's larger side round its centre, inside the
    # frame; w 0 when the region does not read
    func focus_box [ f: Focus ] -> rect
        nums : vec f32 []
        if [ f.region ]
            for [ pt: string ] in f.region.split[ ' ' ]
                if [ pt.count > 0 ] nums.push[ f32[ pt.real_value[] ] ]
        if [ nums.count != 4 || nums[ 2 ] <= 0.0 || nums[ 3 ] <= 0.0 ]
            return rect [ x: 0.0, y: 0.0, w: 0.0, h: 0.0 ]
        s : f32 [ clamp[ max[ nums[ 2 ], nums[ 3 ] ], 0.05, 1.0 ] ]
        cx : f32 [ clamp[ nums[ 0 ] + nums[ 2 ] * 0.5, s * 0.5,
                          1.0 - s * 0.5 ] ]
        cy : f32 [ clamp[ nums[ 1 ] + nums[ 3 ] * 0.5, s * 0.5,
                          1.0 - s * 0.5 ] ]
        return rect [ x: cx - s * 0.5, y: cy - s * 0.5, w: s, h: s ]

    func add_voice [ v: Revoice ] -> bool
        if [ !v.voice || v.voice.count == 0 ]
            problems.push[ 'voice at {v.from}: no reference voice' ]
            return false
        vp : path '{folder[]}/{v.voice}'
        if [ !vp.exists[] ]
            problems.push[
                'voice at {v.from}: {v.voice} is not in the take folder' ]
            return false
        if [ v.to <= v.from || v.from < 0.0 || v.to > length ]
            problems.push[
                'voice {v.from}..{v.to} is outside the take (0..{length})' ]
            return false
        voices.push[ v ]
        return true

    func add_mute [ m: Mute ] -> bool
        if [ m.to <= m.from || m.from < 0.0 || m.to > length ]
            problems.push[
                'mute {m.from}..{m.to} is outside the take (0..{length})' ]
            return false
        mutes.push[ m ]
        return true

    # every Mute op on the take's sound (48 kHz stereo) in place:
    # the app's stem alone where there is one, else silence; 50 ms
    # fades at both ends
    func apply_mutes [ snd: AudioClip, app: AudioClip,
                       mic: AudioClip ]
        if [ mutes.count == 0 || !snd ] return
        split : bool [
            app && mic && app.frames >= snd.frames
            && mic.frames >= snd.frames ]
        rate : f64 [ f64[ snd.rate ] ]
        ch : i64 [ i64[ snd.channels ] ]
        fade : i64 [ i64[ rate * 0.05 ] ]
        for [ m: Mute ] in mutes
            a0 : i64 [ m.from * rate ]
            a1 : i64 [ m.to * rate ]
            if [ a1 > snd.frames ] a1 = snd.frames
            n : i64 [ a1 - a0 ]
            for [ i: i64 0, i < n, i += 1 ]
                g : f32 [ 1.0 ]
                if [ i < fade ] g = f32[ i ] / f32[ fade ]
                if [ n - i < fade ] g = f32[ n - i ] / f32[ fade ]
                for [ c: i64 0, c < ch, c += 1 ]
                    ix : i64 [ (a0 + i) * ch + c ]
                    keep : f32 [ 0.0 ]
                    if [ split ] keep = f32[ app.pcm[ ix ] ]
                    nv : f32 [ f32[ snd.pcm[ ix ] ] * (1.0 - g)
                        + keep * g ]
                    snd.pcm[ ix ] = i16[ nv ]
            log 'composer: muted {m.from}..{m.to} s'

    # every Voice op on the take's sound (48 kHz stereo) in place:
    # seeded once per reference, converted in overlapping 15 s
    # chunks, faded in and out over 50 ms
    # with stems: the mic converted, the app's sound added back
    func apply_voices [ snd: AudioClip, app9: AudioClip, mic9: AudioClip,
                        disp: Display ] -> bool
        if [ voices.count == 0 || !snd ] return true
        split : bool [
            app9 && mic9 && app9.frames >= snd.frames
            && mic9.frames >= snd.frames ]
        if [ split ] log 'composer: voice on the mic track alone'
        if [ snd.rate != 48000 || snd.channels != 2 ]
            problems.push[
                'voice: the take sound is not 48 kHz stereo' ]
            return false
        rv : RvcVoice [ null ]
        rname : string [ '' ]
        for [ v: Revoice ] in voices
            if [ !rv || rname != v.voice ]
                if [ rv ] rv.release[]
                mp : path voice_model[ v, disp ]
                if [ !mp ] return false
                rv = RvcVoice [ vk: disp.vk, model: mp,
                                semitones: v.pitch ]
                rname = v.voice
                if [ !rv.valid ]
                    problems.push[ 'voice: cannot load {mp}' ]
                    return false
            a0 : i64 [ v.from * 48000.0 ]
            a1 : i64 [ v.to * 48000.0 ]
            if [ a1 > snd.frames ] a1 = snd.frames
            n48 : i64 [ a1 - a0 ]
            if [ n48 < 4800 ] continue
            src9 : AudioClip [ (split) ? mic9 : snd ]
            mono : vec f32 [ n48 ]
            for [ i: i64 0, i < n48, i += 1 ]
                l9 : f64 [ src9.pcm[ (a0 + i) * 2 ] ]
                r9 : f64 [ src9.pcm[ (a0 + i) * 2 + 1 ] ]
                mono[ i ] = f32[ (l9 + r9) / 65536.0 ]
            back : vec f32 [ null ]
            try
                back = rv.speak[ resample_sinc[ mono, 48000, 16000 ],
                                 48000 ]
            catch [ message: string ]
                problems.push[ 'voice {v.from}..{v.to}: {message}' ]
            if [ !back ]
                rv.release[]
                return false
            fade : i64 [ 2400 ]
            for [ i: i64 0, i < n48 && i < back.count, i += 1 ]
                g9 : f32 [ 1.0 ]
                if [ i < fade ] g9 = f32[ i ] / f32[ fade ]
                if [ n48 - i < fade ] g9 = f32[ n48 - i ] / f32[ fade ]
                for [ ch: i32 0, ch < 2, ch += 1 ]
                    ix9 : i64 [ (a0 + i) * 2 + ch ]
                    orig : f32 [ snd.pcm[ ix9 ] ]
                    nv : f32 [
                        orig * (1.0 - g9) + back[ i ] * 32767.0 * g9 ]
                    if [ split ]
                        mv : f32 [ mic9.pcm[ ix9 ] ]
                        nv = f32[
                            app9.pcm[ ix9 ] ] + mv * (1.0 - g9) + back[
                                i ] * 32767.0 * g9
                    if [ nv > 32767.0 ] nv = 32767.0
                    if [ nv < -32768.0 ] nv = -32768.0
                    snd.pcm[ ix9 ] = i16[ nv ]
            log 'composer: voice {v.voice} over {v.from}..{v.to} s'
        if [ rv ] rv.release[]
        return true

    # the voice's rvc model beside its clip, trained on first use
    func voice_model [ v: Revoice, disp: Display ] -> path
        return train_voice[ path '{folder[]}/{v.voice}', v.epochs, disp ]

    # <clip>.rvc.safetensors and its .index, trained if older
    func train_voice [ clip: path, epochs: i32, disp: Display ] -> path
        vd : path [ (voice_dir) ? voice_dir : path '{path.path_install[]}/models/voices' ]
        vd.make_dir[]
        # named by the clip's own name: picard-full.wav is picard-full
        nm : string clip.stem[]
        mp : path '{vd}/{nm}.rvc.safetensors'
        fpp : path '{vd}/{nm}.fp'
        fp9 : string voice_fingerprint[ clip ]
        if [ mp.exists[] && fpp.exists[] ]
            have : cast string [ fpp.load[ typeid[ string ], null ] ]
            if [ have == fp9 ]
                log 'composer: voice {nm} already trained ({mp})'
                return mp
        log 'composer: training {nm} from {clip} ({epochs} epochs); this takes a while'
        pp : RvcPrep [ vk: disp.vk ]
        if [ !pp.valid ]
            problems.push[ 'voice: the rvc models are not installed' ]
            return null
        items : vec RvcItem [ null ]
        try
            items = pp.prepare[ clip ]
        catch [ message: string ]
            problems.push[ 'voice: preparing {clip}: {message}' ]
        feats : vec f32 pp.feats
        pp.release[]
        if [ !items ] return null
        if [ items.count == 0 ]
            problems.push[ 'voice: no speech found in {clip}' ]
            return null
        log 'composer: {clip}: {items.count} pieces'
        m : path '{path.path_install[]}/models/rvc'
        net : RvcNet [ vk: disp.vk, src: path '{m}/f0G40k.pth', keep_mb: 2048, work_mb: 6144 ]
        tr : RvcTrain [ vk: disp.vk, net: net ]
        # checkpoints only; the model's name means it finished
        part : path '{mp}.part'
        ok : bool [ false ]
        if [ tr.valid && tr.resume[ part ] > 0 ]
            log 'composer: resuming {clip} after epoch {tr.done}'
        try
            ok = tr.valid && tr.train[ items, epochs, 2, part, 10 ]
        catch [ message: string ]
            problems.push[ 'voice: training {clip}: {message}' ]
        net.gd.release[]
        if [ !ok ]
            problems.push[ 'voice: training {clip} failed' ]
            return null
        from9 : string '{part}'
        to9 : string '{mp}'
        rename[ from9.chars, to9.chars ]
        state9 : string '{part}.state'
        unlink[ state9.chars ]
        fp : @FILE [ fopen[ '{mp}.index', 'wb' ] ]
        if [ fp ]
            fwrite[ @feats[ 0 ], 4, feats.count, fp ]
            fclose[ fp ]
        # written last: a voice counts as trained only once complete
        fpp.save[ fp9, null ]
        return mp

    func insert [ ins: Insert ] -> bool
        if [ !ins.media || ins.media.count == 0 ]
            problems.push[ 'insert at {ins.at}: no media' ]
            return false
        mp : path '{folder[]}/{ins.media}'
        if [ !mp.exists[] ]
            problems.push[
                'insert at {ins.at}: {ins.media} is not in the take folder' ]
            return false
        at : f64 [ out_time[ ins.at ] ]
        if [ at < 0.0 ]
            problems.push[
                'insert at {ins.at}: that moment is cropped out' ]
            return false
        ln : f64 [ (ins.to > ins.from) ? ins.to - ins.from : ins.dur ]
        if [ ln <= 0.0 ]
            problems.push[
                'insert at {ins.at}: no length (from/to or dur)' ]
            return false
        overlays.push[
            Overlay [ insert: ins, at: ins.at, out_at: at,
                      length: ln ] ]
        return true

# composer <take.mp4>: the agent composes, the plan is checked
element composer : trinity
    default take  : path
    public  agent : string [ 'claude' ]
    public  model : string
    func init []
        # a build mid-run must not swap out a training run
        au_live_set_reload[ 0 ]
        # a take's module folder names its mp4: <folder>/<folder>.mp4
        if [ take && take.is_dir[] ]
            take = path '{take}/{take.filename[]}.mp4'
        if [ !take || !take.exists[] ]
            log 'composer: no take at {take}'
            exit[ 1 ]
        c : Composer [ take: take, kept: vec Kept [],
                       overlays: vec Overlay [],
            problems: vec string [] ]
        # the gpu first: the stills for the agent need it too
        v9 : vk_context []
        Au.hold[ v9 ]
        d9 : Display [ vk: v9, format: Pixel.rgba8, backbuffer: true,
                       width: 64, height: 64 ]
        Au.hold[ d9 ]
        ok : bool c.compose[ agent, model, d9 ]
        if [ ok ]
            log 'composer: {c.kept.count} spans kept, {c.overlays.count} inserts'
            ok = c.render[ d9 ]
        for [ p: string ] in c.problems
            log 'composer: {p}'
        exit[ (ok) ? 0 : 1 ]

# a file of f32 values
func floats_of [ p: path ] -> vec f32
    b : vec u8 file_bytes[ p ]
    if [ !b ] return vec f32 []
    out : vec f32 [ b.count / 4 ]
    memcpy[ @out[ 0 ], @b[ 0 ], b.count ]
    return out

# the rvc files read as pytorch reads them
expect func t_rvc_weights [] -> bool
    m : path '{path.path_install[]}/models/rvc'
    if [ !m.exists[] ] return true
    hb : pth [ src: path '{m}/hubert.pth' ]
    rm : pth [ src: path '{m}/rmvpe.pt' ]
    gn : pth [ src: path '{m}/f0G40k.pth' ]
    ds : pth [ src: path '{m}/f0D40k.pth' ]
    if [ !hb.valid || !rm.valid || !gn.valid || !ds.valid ] return false
    log 'rvc: hubert {hb.count[]}, rmvpe {rm.count[]}, generator {gn.count[]}, discriminator {ds.count[]} tensors'
    counts : bool [
        hb.count[] == 213 && rm.count[] == 741 && gn.count[] == 560
        && ds.count[] == 165 ]
    a : tensor hb.tensor_named[
        'feature_extractor.conv_layers.2.conv.weight' ]
    b : tensor rm.tensor_named[
        'unet.encoder.layers.0.conv.0.conv.0.weight' ]
    c : tensor gn.tensor_named[
        'model.enc_p.encoder.attn_layers.0.conv_q.weight' ]
    d : tensor ds.tensor_named[
        'model.discriminators.0.convs.1.weight_v' ]
    if [ !a || !b || !c || !d ] return false
    log 'rvc: first values {a.floats[ 0 ]} {b.floats[ 0 ]} {c.floats[ 0 ]} {d.floats[ 0 ]}'
    sizes : bool [
        a.tensor_shape.total[] == 786432
        && b.tensor_shape.total[] == 144
        && c.tensor_shape.total[] == 36864
        && d.tensor_shape.total[] == 10496 ]
    vals : bool [
        a.floats[ 0 ] == -0.0482177734375
        && b.floats[ 0 ] == 0.056396484375
        && c.floats[ 0 ] == 0.05670166015625
        && d.floats[ 0 ] == -0.046905517578125 ]
    return counts && sizes && vals

# rvc's synthesizer vs pytorch (COMPOSER_RVC_GOLD)
expect func t_rvc_infer [] -> bool
    ge : cstr [ getenv[ 'COMPOSER_RVC_GOLD' ] ]
    if [ !ge ] return true
    dir : string [ ge ]
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, format: Pixel.rgba8, backbuffer: true,
                     width: 64, height: 64 ]
    Au.hold[ disp ]
    net : RvcNet [ vk: vk, src: path '{path.path_install[]}/models/rvc/f0G40k.pth' ]
    if [ !net.valid ] return false
    t0 : i64 [ Au.epoch_millis[] ]
    ph : vec f32 floats_of[ path '{dir}/phone.f32' ]
    pt : vec f32 floats_of[ path '{dir}/pitch.f32' ]
    f0 : vec f32 floats_of[ path '{dir}/f0.f32' ]
    zn : vec f32 floats_of[ path '{dir}/zn.f32' ]
    sn : vec f32 floats_of[ path '{dir}/sn.f32' ]
    y : vec f32 net.infer[ ph, pt, f0, 0, zn, sn ]
    ms : i64 [ Au.epoch_millis[] - t0 ]
    gold : vec f32 floats_of[ path '{dir}/out.f32' ]
    if [ y.count != gold.count ]
        log 'rvc infer: {y.count} samples, pytorch {gold.count}'
        return false
    sig : f64 [ 0.0 ]
    err : f64 [ 0.0 ]
    for [ i: i64 0, i < y.count, i += 1 ]
        d : f64 [ f64[ y[ i ] ] - f64[ gold[ i ] ] ]
        sig += f64[ gold[ i ] ] * f64[ gold[ i ] ]
        err += d * d
    snr : f64 [ 10.0 * log10[ sig / (err + 1.0e-30) ] ]
    log 'rvc infer: {y.count} samples in {ms} ms, SNR {snr} dB against pytorch'
    ok9 : bool [ snr > 40.0 ]
    net.gd.release[]
    return ok9

# hubert on 2 s of speech vs transformers' HubertModel
expect func t_rvc_hubert [] -> bool
    ge : cstr [ getenv[ 'COMPOSER_RVC_GOLD' ] ]
    if [ !ge ] return true
    dir : string [ ge ]
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, format: Pixel.rgba8, backbuffer: true,
                     width: 64, height: 64 ]
    Au.hold[ disp ]
    gd : Grad [ vk: vk, keep_mb: 512, work_mb: 1024 ]
    hb : RvcHubert [ gd: gd, src: path '{path.path_install[]}/models/rvc/hubert.pth' ]
    if [ !hb.valid ] return false
    wav : vec f32 floats_of[ path '{dir}/wav16.f32' ]
    t0 : i64 [ Au.epoch_millis[] ]
    h : GTensor hb.features[ wav ]
    gd.rn.finish[]
    ms : i64 [ Au.epoch_millis[] - t0 ]
    got : vec f32 gd.download[ h ]
    gold : vec f32 floats_of[ path '{dir}/hubert.f32' ]
    if [ got.count != gold.count ]
        log 'rvc hubert: {got.count} values, transformers {gold.count}'
        return false
    worst : f64 grad_worst[ got, gold ]
    sig : f64 [ 0.0 ]
    err : f64 [ 0.0 ]
    for [ i: i64 0, i < got.count, i += 1 ]
        d : f64 [ f64[ got[ i ] ] - f64[ gold[ i ] ] ]
        sig += f64[ gold[ i ] ] * f64[ gold[ i ] ]
        err += d * d
    log 'rvc hubert: {h.dims[ 2 ]} frames in {ms} ms, worst {worst}, SNR {10.0 * log10[ sig / (err + 1.0e-30) ]} dB'
    ok9 : bool [ worst < 0.001 ]
    gd.release[]
    return ok9

# rmvpe's mel, salience and pitch vs rvc's own
expect func t_rvc_pitch [] -> bool
    ge : cstr [ getenv[ 'COMPOSER_RVC_GOLD' ] ]
    if [ !ge ] return true
    dir : string [ ge ]
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, format: Pixel.rgba8, backbuffer: true,
                     width: 64, height: 64 ]
    Au.hold[ disp ]
    gd : Grad [ vk: vk, keep_mb: 1024, work_mb: 2048 ]
    pn : RvcPitch [ gd: gd, src: path '{path.path_install[]}/models/rvc/rmvpe.pt' ]
    if [ !pn.valid ] return false
    wav : vec f32 floats_of[ path '{dir}/wav16.f32' ]
    ml : GTensor pn.mel[ wav ]
    gd.rn.finish[]
    me : f64 grad_worst[ gd.download[ ml ], floats_of[ path '{dir}/rm_mel.f32' ] ]
    gd.reset_work[]
    t0 : i64 [ Au.epoch_millis[] ]
    sal : vec f32 pn.salience[ wav ]
    ms : i64 [ Au.epoch_millis[] - t0 ]
    se : f64 grad_worst[ sal, floats_of[ path '{dir}/rm_sal.f32' ] ]
    gd.reset_work[]
    f0 : vec f32 pn.f0[ wav, 0.03 ]
    gold : vec f32 floats_of[ path '{dir}/rm_f0.f32' ]
    vo : i64 [ 0 ]
    miss : i64 [ 0 ]
    worst : f64 [ 0.0 ]
    for [ i: i64 0, i < gold.count && i < f0.count, i += 1 ]
        if [ (gold[ i ] > 0.0) != (f0[ i ] > 0.0) ] miss += 1
        if [ gold[ i ] > 0.0 && f0[ i ] > 0.0 ]
            vo += 1
            c9 : f64 [
                fabs[
                    1200.0
                    * log2[ f64[ f0[ i ] ] / f64[ gold[ i ] ] ] ] ]
            if [ c9 > worst ] worst = c9
    log 'rvc pitch: mel worst {me}, salience worst {se} ({ms} ms), {vo} voiced frames, {miss} voicing differences, pitch worst {worst} cents'
    ok9 : bool [
        f0.count == gold.count && miss == 0 && worst < 1.0
        && se < 0.001 ]
    gd.release[]
    return ok9

# two rvc training steps vs pytorch (COMPOSER_RVC_TRAIN)
expect func t_rvc_train_step [] -> bool
    ge : cstr [ getenv[ 'COMPOSER_RVC_TRAIN' ] ]
    if [ !ge ] return true
    dir : string [ ge ]
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, format: Pixel.rgba8, backbuffer: true,
                     width: 64, height: 64 ]
    Au.hold[ disp ]
    net : RvcNet [ vk: vk, src: path '{path.path_install[]}/models/rvc/f0G40k.pth', keep_mb: 2048, work_mb: 6144 ]
    if [ !net.valid ] return false
    tr : RvcTrain [ vk: vk, net: net ]
    if [ !tr.valid ] return false
    sd : vec f32 [ 2 ]
    ph : vec f32 floats_of[ path '{dir}/phone.f32' ]
    pt9 : vec f32 floats_of[ path '{dir}/pitch.f32' ]
    pf : vec f32 floats_of[ path '{dir}/pitchf.f32' ]
    sp : vec f32 floats_of[ path '{dir}/spec.f32' ]
    wv : vec f32 floats_of[ path '{dir}/wave.f32' ]
    bt : RvcBatch [ nb: 2, nt: 48, phone: ph, pitch: pt9, pitchf: pf,
                    spec: sp, wave: wv, sid: sd ]
    names : vec string [] [ 'dec.conv_post.weight',
                            'enc_p.emb_phone.weight',
                            'flow.flows.0.post.weight',
                            'enc_q.pre.weight', 'dec.ups.0.weight_v',
                            'emb_g.weight' ]
    ok : bool [ true ]
    for [ st: i32 0, st < 2, st += 1 ]
        iv : vec f32 floats_of[ path '{dir}/s{st}_ids.f32' ]
        qv : vec f32 floats_of[ path '{dir}/s{st}_epsq.f32' ]
        sv : vec f32 floats_of[ path '{dir}/s{st}_epss.f32' ]
        bt.ids = iv
        bt.eps_q = qv
        bt.eps_s = sv
        t0 : i64 [ Au.epoch_millis[] ]
        ls : vec f32 tr.step[ bt, 0.0001 ]
        ms : i64 [ Au.epoch_millis[] - t0 ]
        gl : vec f32 floats_of[ path '{dir}/s{st}_losses.f32' ]
        log 'rvc train step {st} ({ms} ms): disc {ls[ 0 ]}/{gl[ 0 ]} gen {ls[ 1 ]}/{gl[ 1 ]} fm {ls[ 2 ]}/{gl[ 2 ]} mel {ls[ 3 ]}/{gl[ 3 ]} kl {ls[ 4 ]}/{gl[ 4 ]}'
        for [ i: i64 0, i < 5, i += 1 ]
            r9 : f64 [
                fabs[ f64[ ls[ i ] ] - f64[ gl[ i ] ] ]
                / (fabs[ f64[ gl[ i ] ] ] + 0.000001) ]
            if [ r9 > 0.001 ] ok = false
        for [ i: i64 0, i < names.count, i += 1 ]
            pt : GTensor net.pm[ names[ i ] ]
            got : vec f32 net.gd.download[ pt.gr ]
            want : vec f32 floats_of[ path '{dir}/s{st}_g{i}.f32' ]
            mx : f64 [ 0.0 ]
            for [ j: i64 0, j < want.count, j += 1 ]
                a9 : f64 [ fabs[ f64[ want[ j ] ] ] ]
                if [ a9 > mx ] mx = a9
            e9 : f64 grad_worst[ got, want ]
            log 'rvc train step {st} grad {names[ i ]}: worst {e9} of max {mx}'
            if [ e9 > 0.01 * mx ] ok = false
    ok9 : bool [ ok ]
    net.gd.release[]
    return ok9

# one step at lr 0: every gradient vs pytorch's
expect func t_rvc_train_grads [] -> bool
    ge : cstr [ getenv[ 'COMPOSER_RVC_TRAIN0' ] ]
    if [ !ge ] return true
    dir : string [ ge ]
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, format: Pixel.rgba8, backbuffer: true,
                     width: 64, height: 64 ]
    Au.hold[ disp ]
    net : RvcNet [ vk: vk, src: path '{path.path_install[]}/models/rvc/f0G40k.pth', keep_mb: 2048, work_mb: 6144 ]
    if [ !net.valid ] return false
    tr : RvcTrain [ vk: vk, net: net, keep_dgrad: true ]
    if [ !tr.valid ] return false
    sd : vec f32 [ 2 ]
    ph : vec f32 floats_of[ path '{dir}/phone.f32' ]
    pt9 : vec f32 floats_of[ path '{dir}/pitch.f32' ]
    pf : vec f32 floats_of[ path '{dir}/pitchf.f32' ]
    sp : vec f32 floats_of[ path '{dir}/spec.f32' ]
    wv : vec f32 floats_of[ path '{dir}/wave.f32' ]
    iv : vec f32 floats_of[ path '{dir}/s0_ids.f32' ]
    qv : vec f32 floats_of[ path '{dir}/s0_epsq.f32' ]
    sv : vec f32 floats_of[ path '{dir}/s0_epss.f32' ]
    bt : RvcBatch [ nb: 2, nt: 48, phone: ph, pitch: pt9, pitchf: pf,
                    spec: sp, wave: wv, sid: sd, ids: iv, eps_q: qv,
                    eps_s: sv ]
    ls : vec f32 tr.step[ bt, 0.0 ]
    gl : vec f32 floats_of[ path '{dir}/s0_losses.f32' ]
    log 'rvc grads: disc {ls[ 0 ]}/{gl[ 0 ]} gen {ls[ 1 ]}/{gl[ 1 ]} fm {ls[ 2 ]}/{gl[ 2 ]} mel {ls[ 3 ]}/{gl[ 3 ]} kl {ls[ 4 ]}/{gl[ 4 ]}'
    ok : bool [ true ]
    for [ i: i64 0, i < 5, i += 1 ]
        r9 : f64 [
            fabs[ f64[ ls[ i ] ] - f64[ gl[ i ] ] ]
            / (fabs[ f64[ gl[ i ] ] ] + 0.000001) ]
        if [ r9 > 0.0001 ] ok = false
    gn : vec string [] [ 'dec.conv_post.weight',
                         'enc_p.emb_phone.weight',
                         'flow.flows.0.post.weight', 'enc_q.pre.weight',
                         'dec.ups.0.weight_v', 'emb_g.weight' ]
    dn : vec string [] [ 'discriminators.0.convs.1.weight_v',
                         'discriminators.3.convs.2.weight_g',
                         'discriminators.8.conv_post.bias',
                         'discriminators.0.convs.5.bias' ]
    for [ i: i64 0, i < gn.count + dn.count, i += 1 ]
        isg : bool [ i < gn.count ]
        nm : string [ (isg) ? gn[ i ] : dn[ i - gn.count ] ]
        pt : GTensor [ (isg) ? net.pm[ nm ] : tr.dsc.pm[ nm ] ]
        got : vec f32 net.gd.download[ pt.gr ]
        fl : string [
            (isg) ? '{dir}/s0_g{i}.f32'
            : '{dir}/s0_d{i - gn.count}.f32' ]
        want : vec f32 floats_of[ path fl ]
        mx : f64 [ 0.0 ]
        for [ j: i64 0, j < want.count, j += 1 ]
            a9 : f64 [ fabs[ f64[ want[ j ] ] ] ]
            if [ a9 > mx ] mx = a9
        e9 : f64 grad_worst[ got, want ]
        dn2 : f64 [ 0.0 ]
        wn : f64 [ 0.0 ]
        for [ j: i64 0, j < want.count, j += 1 ]
            d9 : f64 [ f64[ got[ j ] ] - f64[ want[ j ] ] ]
            dn2 += d9 * d9
            wn += f64[ want[ j ] ] * f64[ want[ j ] ]
        rel : f64 [ sqrt[ dn2 / (wn + 1.0e-30) ] ]
        log 'rvc grads {nm}: worst {e9} of max {mx}, relative {rel}'
        # one relu flipped at zero moves a gradient ~0.3%
        if [ rel > 0.005 ] ok = false
    ok9 : bool [ ok ]
    net.gd.release[]
    return ok9

# every discriminator gradient on pytorch's generated wave
expect func t_rvc_disc_grads [] -> bool
    ge : cstr [ getenv[ 'COMPOSER_RVC_DALL' ] ]
    if [ !ge ] return true
    dir : string [ ge ]
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, format: Pixel.rgba8, backbuffer: true,
                     width: 64, height: 64 ]
    Au.hold[ disp ]
    gd : Grad [ vk: vk, keep_mb: 1024, work_mb: 4096 ]
    dsc : RvcDisc [ gd: gd, src: path '{path.path_install[]}/models/rvc/f0D40k.pth' ]
    if [ !dsc.valid ] return false
    wall : vec f32 floats_of[ path '{dir}/wave.f32' ]
    wv : vec f32 [ 25600 ]
    memcpy[ @wv[ 0 ], @wall[ 1200 ], 12800 * 4 ]
    memcpy[ @wv[ 12800 ], @wall[ 19200 + 4000 ], 12800 * 4 ]
    yh : vec f32 floats_of[ path '{dir}/dall/yhat.f32' ]
    gd.record = true
    dsc.set_need[ true ]
    real : GTensor gd.temp[ vec i64 [] [ 2, 1, 12800 ] ]
    gd.upload[ real, wv ]
    fake : GTensor gd.temp[ vec i64 [] [ 2, 1, 12800 ] ]
    gd.upload[ fake, yh ]
    dsc.logits = vec GTensor []
    dsc.fmaps = vec GTensor []
    dsc.run[ real ]
    dsc.run[ fake ]
    dls : vec GTensor []
    dws : vec f32 []
    w1 : f32 [ 1.0 ]
    for [ i: i64 0, i < 9, i += 1 ]
        dls.push[ gd.lsq[ dsc.logits[ i ], 1.0 ] ]
        dws.push[ w1 ]
        dls.push[ gd.lsq[ dsc.logits[ 9 + i ], 0.0 ] ]
        dws.push[ w1 ]
    gd.backward_all[ dls, dws ]
    gd.rn.finish[]
    worst : f64 [ 0.0 ]
    wname : string [ '' ]
    nm9 : vec string dsc.names[]
    for [ nm: string ] in nm9
        pt : GTensor dsc.pm[ nm ]
        want : vec f32 floats_of[ path '{dir}/dall/{nm}.f32' ]
        if [ !pt.gr ] continue
        got : vec f32 gd.download[ pt.gr ]
        dn : f64 [ 0.0 ]
        wn : f64 [ 0.0 ]
        for [ j: i64 0, j < want.count, j += 1 ]
            d9 : f64 [ f64[ got[ j ] ] - f64[ want[ j ] ] ]
            dn += d9 * d9
            wn += f64[ want[ j ] ] * f64[ want[ j ] ]
        rel : f64 [ sqrt[ dn / (wn + 1.0e-30) ] ]
        if [ rel > 0.001 ] log 'rvc disc grad {nm}: relative {rel}'
        if [ rel > worst ]
            worst = rel
            wname = nm
    log 'rvc disc grads: {nm9.count} gradients, worst relative {worst} ({wname})'
    # one relu flipped at zero moves a gradient ~0.3%
    ok9 : bool [ worst < 0.005 ]
    gd.release[]
    return ok9

# rvc's high-pass and slicer vs scipy and slicer2 (COMPOSER_RVC_PREP)
expect func t_rvc_slices [] -> bool
    ge : cstr [ getenv[ 'COMPOSER_RVC_PREP' ] ]
    if [ !ge ] return true
    dir : string [ ge ]
    a : vec f32 floats_of[ path '{dir}/clip40.f32' ]
    hp : vec f32 rvc_highpass[ a ]
    gh : vec f32 floats_of[ path '{dir}/hp40.f32' ]
    he : f64 grad_worst[ hp, gh ]
    sl : vec i64 rvc_slices[ gh ]
    gs : vec f32 floats_of[ path '{dir}/slices.f32' ]
    same : bool [ sl.count == gs.count ]
    for [ i: i64 0, same && i < sl.count, i += 1 ]
        if [ f32[ sl[ i ] ] != gs[ i ] ] same = false
    log 'rvc slices: high-pass worst {he}; {sl.count / 2} slices, pytorch-side {gs.count / 2}, same {same}'
    return he < 0.0001 && same

# a clip to rvc training items (COMPOSER_RVC_PREP: clip.wav)
expect func t_rvc_prepare [] -> bool
    ge : cstr [ getenv[ 'COMPOSER_RVC_PREP' ] ]
    if [ !ge ] return true
    dir : string [ ge ]
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, format: Pixel.rgba8, backbuffer: true,
                     width: 64, height: 64 ]
    Au.hold[ disp ]
    pp : RvcPrep [ vk: vk ]
    if [ !pp.valid ] return false
    t0 : i64 [ Au.epoch_millis[] ]
    items : vec RvcItem pp.prepare[ path '{dir}/clip.wav' ]
    ms : i64 [ Au.epoch_millis[] - t0 ]
    pp.release[]
    ok : bool [ items.count == 6 ]
    for [ it: RvcItem ] in items
        bad : i64 [ 0 ]
        for [ t: i64 0, t < it.nt, t += 1 ]
            if [ it.pitch[ t ] < 1.0 || it.pitch[ t ] > 255.0 || it.pitchf[ t ] <= 0.0 ]
                bad += 1
        fin : bool [ true ]
        for [ i: i64 0, i < it.phone.count, i += 1 ]
            v9 : f32 [ it.phone[ i ] ]
            if [ v9 != v9 || v9 > 1.0e30 || v9 < -1.0e30 ] fin = false
        log 'rvc prepare: {it.nt} frames, pitch {it.pitchf[ it.nt / 2 ]} Hz bin {it.pitch[ it.nt / 2 ]}, {bad} bad, finite {fin}'
        if [ bad > 0 || !fin ] ok = false
    log 'rvc prepare: {items.count} items in {ms} ms'
    return ok

# train a voice on a clip, save it, load it back and convert
# (COMPOSER_RVC_PREP: clip.wav; the voice goes beside it)
expect func t_rvc_train_loop [] -> bool
    ge : cstr [ getenv[ 'COMPOSER_RVC_PREP' ] ]
    if [ !ge ] return true
    dir : string [ ge ]
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, format: Pixel.rgba8, backbuffer: true,
                     width: 64, height: 64 ]
    Au.hold[ disp ]
    pp : RvcPrep [ vk: vk ]
    items : vec RvcItem pp.prepare[ path '{dir}/clip.wav' ]
    pp.release[]
    if [ items.count == 0 ] return false
    m : path '{path.path_install[]}/models/rvc'
    net : RvcNet [ vk: vk, src: path '{m}/f0G40k.pth', keep_mb: 2048, work_mb: 6144 ]
    tr : RvcTrain [ vk: vk, net: net ]
    if [ !tr.valid ] return false
    vp : path '{dir}/voice.safetensors'
    if [ !tr.train[ items, 2, 2, vp, 1 ] ] return false
    want : vec f32 net.gd.download[ net.pm[ 'dec.conv_post.weight' ] ]
    net.gd.release[]
    v2 : RvcNet [ vk: vk, src: path '{m}/f0G40k.pth', voice: vp ]
    if [ !v2.valid ] return false
    got : vec f32 v2.gd.download[ v2.pm[ 'dec.conv_post.weight' ] ]
    same : f64 grad_worst[ got, want ]
    it : RvcItem items[ 0 ]
    nt : i64 [ 100 ]
    ph : vec f32 [ nt * 768 ]
    memcpy[ @ph[ 0 ], @it.phone[ 0 ], nt * 768 * 4 ]
    pt : vec f32 [ nt ]
    memcpy[ @pt[ 0 ], @it.pitch[ 0 ], nt * 4 ]
    pf : vec f32 [ nt ]
    memcpy[ @pf[ 0 ], @it.pitchf[ 0 ], nt * 4 ]
    y : vec f32 v2.infer[ ph, pt, pf, 0, null, null ]
    peak : f32 [ 0.0 ]
    bad : bool [ false ]
    for [ i: i64 0, i < y.count, i += 1 ]
        if [ y[ i ] != y[ i ] ] bad = true
        if [ fabsf[ y[ i ] ] > peak ] peak = fabsf[ y[ i ] ]
    log 'rvc train loop: saved and reloaded (weight difference {same}); converted {y.count} samples, peak {peak}, nan {bad}'
    ok9 : bool [ same == 0.0 && !bad && y.count == nt * 400 ]
    v2.gd.release[]
    return ok9

# a stopped run picks up where its last checkpoint left it
expect func t_rvc_train_resume [] -> bool
    ge : cstr [ getenv[ 'COMPOSER_RVC_PREP' ] ]
    if [ !ge ] return true
    dir : string [ ge ]
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, format: Pixel.rgba8, backbuffer: true,
                     width: 64, height: 64 ]
    Au.hold[ disp ]
    pp : RvcPrep [ vk: vk ]
    items : vec RvcItem pp.prepare[ path '{dir}/clip.wav' ]
    pp.release[]
    if [ items.count == 0 ] return false
    m : path '{path.path_install[]}/models/rvc'
    cp : path '{dir}/resume.safetensors'
    na : RvcNet [ vk: vk, src: path '{m}/f0G40k.pth', keep_mb: 2048, work_mb: 6144 ]
    ta : RvcTrain [ vk: vk, net: na ]
    if [ !ta.valid || !ta.train[ items, 2, 2, cp, 1 ] ] return false
    ga : vec f32 na.gd.download[ na.pm[ 'dec.conv_post.weight' ] ]
    da : vec f32 na.gd.download[ ta.dsc.pm[ 'discriminators.3.convs.2.weight_v' ] ]
    ma : vec f32 na.gd.download[ ta.og.ms[ 5 ] ]
    va : vec f32 na.gd.download[ ta.od.vs[ 7 ] ]
    sa : i64 [ ta.og.step ]
    na.gd.release[]
    nb : RvcNet [ vk: vk, src: path '{m}/f0G40k.pth', keep_mb: 2048, work_mb: 6144 ]
    tb : RvcTrain [ vk: vk, net: nb ]
    if [ !tb.valid ] return false
    at : i32 tb.resume[ cp ]
    gb : vec f32 nb.gd.download[ nb.pm[ 'dec.conv_post.weight' ] ]
    db : vec f32 nb.gd.download[ tb.dsc.pm[ 'discriminators.3.convs.2.weight_v' ] ]
    mb : vec f32 nb.gd.download[ tb.og.ms[ 5 ] ]
    vb : vec f32 nb.gd.download[ tb.od.vs[ 7 ] ]
    diff : f64 [
        grad_worst[ ga, gb ] + grad_worst[ da, db ]
        + grad_worst[ ma, mb ] + grad_worst[ va, vb ] ]
    more : bool tb.train[ items, 3, 2, cp, 1 ]
    log 'rvc train resume: after epoch {at}, steps {sa}/{tb.og.step}, difference {diff}, then to epoch {tb.done}'
    nb.gd.release[]
    return at == 2 && diff == 0.0 && more && tb.done == 3

# 8 s through the synthesizer in the default arenas (lean decoder)
expect func t_rvc_infer_long [] -> bool
    ge : cstr [ getenv[ 'COMPOSER_RVC_GOLD' ] ]
    if [ !ge ] return true
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, format: Pixel.rgba8, backbuffer: true,
                     width: 64, height: 64 ]
    Au.hold[ disp ]
    net : RvcNet [ vk: vk, src: path '{path.path_install[]}/models/rvc/f0G40k.pth' ]
    if [ !net.valid ] return false
    nt : i64 [ 800 ]
    ph : vec f32 rvc_randn[ nt * 768 ]
    pt : vec f32 [ nt ]
    pf : vec f32 [ nt ]
    for [ t: i64 0, t < nt, t += 1 ]
        pf[ t ] = f32[ 120.0 + 40.0 * sin[ f64[ t ] * 0.02 ] ]
        pt[ t ] = 40.0
    t0 : i64 [ Au.epoch_millis[] ]
    y : vec f32 net.infer[ ph, pt, pf, 0, null, null ]
    ms : i64 [ Au.epoch_millis[] - t0 ]
    log 'rvc infer long: {y.count} samples ({y.count / 40000} s) in {ms} ms, arena top {net.gd.work.top / 1048576} MB'
    ok9 : bool [ y.count == nt * 400 ]
    net.gd.release[]
    return ok9

# the retrieval index's blend vs an exact numpy search
expect func t_rvc_index [] -> bool
    ge : cstr [ getenv[ 'COMPOSER_RVC_INDEX' ] ]
    if [ !ge ] return true
    dir : string [ ge ]
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, format: Pixel.rgba8, backbuffer: true,
                     width: 64, height: 64 ]
    Au.hold[ disp ]
    gd : Grad [ vk: vk, keep_mb: 64, work_mb: 256 ]
    ix : RvcIndex [ gd: gd ]
    rows : vec f32 floats_of[ path '{dir}/rows.f32' ]
    if [ !ix.load[ rows ] ] return false
    q : vec f32 floats_of[ path '{dir}/q.f32' ]
    got : vec f32 ix.blend[ q, 0.75 ]
    want : vec f32 floats_of[ path '{dir}/blend.f32' ]
    w9 : f64 grad_worst[ got, want ]
    log 'rvc index: 50 queries over 5000 rows, worst {w9}'
    ok9 : bool [ w9 < 0.001 ]
    gd.release[]
    return ok9

# train_voice keeps checkpoints in .part until the last epoch
expect func t_rvc_train_voice [] -> bool
    ge : cstr [ getenv[ 'COMPOSER_RVC_PREP' ] ]
    if [ !ge ] return true
    dir : string [ ge ]
    clip : path '{dir}/clip.wav'
    mp : path '{dir}/voices/clip.rvc.safetensors'
    part : path '{dir}/voices/clip.rvc.safetensors.part'
    fp0 : string '{dir}/voices/clip.fp'
    unlink[ fp0.chars ]
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, format: Pixel.rgba8, backbuffer: true,
                     width: 64, height: 64 ]
    Au.hold[ disp ]
    c : Composer [ take: clip, kept: vec Kept [],
                   overlays: vec Overlay [],
        problems: vec string [], voice_dir: path '{dir}/voices' ]
    got : path c.train_voice[ clip, 1, disp ]
    for [ p: string ] in c.problems
        log 'rvc train voice: {p}'
    ix : path '{mp}.index'
    fpp : path '{dir}/voices/clip.fp'
    t1 : i64 [ mp.modified_time[] ]
    # the same clip by name again: no training, the same file
    again : path c.train_voice[ clip, 1, disp ]
    same : bool [ again && mp.modified_time[] == t1 ]
    log 'rvc train voice: model {mp.exists[]}, part {part.exists[]}, index {ix.exists[]}, fingerprint {fpp.exists[]}, reused {same}'
    return got && mp.exists[] && !part.exists[] && ix.exists[] &&
        fpp.exists[] && same

# rvc's whole pipeline on a 22 s clip with a trained voice
# (COMPOSER_RVC_PREP: clip.wav and the voice the loop test saved)
expect func t_rvc_pipeline [] -> bool
    ge : cstr [ getenv[ 'COMPOSER_RVC_PREP' ] ]
    if [ !ge ] return true
    dir : string [ ge ]
    vp : path '{dir}/voice.safetensors'
    if [ !vp.exists[] ] return true
    vk : vk_context []
    Au.hold[ vk ]
    disp : Display [ vk: vk, format: Pixel.rgba8, backbuffer: true,
                     width: 64, height: 64 ]
    Au.hold[ disp ]
    rv : RvcVoice [ vk: vk, model: vp ]
    if [ !rv.valid ] return false
    ac : AudioClip voice_clip[ path '{dir}/clip.wav' ]
    mono : vec f32 [ ac.frames ]
    for [ i: i64 0, i < ac.frames, i += 1 ]
        mono[ i ] = f32[ ac.pcm[ i ] ] / 32768.0
    a16 : vec f32 resample_sinc[ mono, ac.rate, 16000 ]
    t0 : i64 [ Au.epoch_millis[] ]
    y : vec f32 rv.speak[ a16, 48000 ]
    ms : i64 [ Au.epoch_millis[] - t0 ]
    peak : f32 [ 0.0 ]
    bad : bool [ false ]
    for [ i: i64 0, i < y.count, i += 1 ]
        if [ y[ i ] != y[ i ] ] bad = true
        if [ fabsf[ y[ i ] ] > peak ] peak = fabsf[ y[ i ] ]
    want : f64 [ f64[ a16.count ] / 16000.0 ]
    got : f64 [ f64[ y.count ] / 48000.0 ]
    log 'rvc pipeline: {want} s in, {got} s out at 48 kHz, {ms} ms, peak {peak}, nan {bad}'
    ok9 : bool [ !bad && fabs[ got - want ] < 0.05 && peak < 1.0 ]
    rv.gd.release[]
    return ok9

# decodes an h.265 take (COMPOSER_HEVC) to planar yuv at
# COMPOSER_HEVC_OUT, for a byte comparison with a reference decode
expect func t_hevc_decode [] -> bool
    he : cstr [ getenv[ 'COMPOSER_HEVC' ] ]
    ho : cstr [ getenv[ 'COMPOSER_HEVC_OUT' ] ]
    if [ !he || !ho ] return true
    vk : vk_context []
    Au.hold[ vk ]
    # the queues come up with a display
    disp : Display [ vk: vk, format: Pixel.rgba8, backbuffer: true,
                     width: 64, height: 64 ]
    Au.hold[ disp ]
    fd : i32 [ open[ he, O_RDONLY, 0 ] ]
    if [ fd < 0 ] return false
    dm : Demux []
    dec : Decoder [ vk: vk ]
    chunk : new u8 [ 1048576 ]
    configured : bool [ false ]
    samples : i64 [ 0 ]
    for [ true ]
        n : i64 [ read[ fd, chunk, 1048576 ] ]
        if [ n <= 0 ] break
        dm.append[ chunk, n ]
        if [ !configured && dm.tracks.count > 0 ]
            t0 : DemuxTrack dm.tracks[ 0 ]
            if [ !dec.config_hevc[ @t0.config[ 0 ], i32[ t0.config.count ] ] ]
                return false
            configured = true
        for [ s: DemuxSample ] in dm.ready
            if [ s.track == 1 ]
                dec.decode[ @s.data[ 0 ], i32[ s.data.count ], s.pts ]
                samples += 1
        dm.ready.clear[]
    close[ fd ]
    dec.finish[]
    out : handle [ fopen[ ho, 'wb' ] ]
    for [ f: VideoFrame ] in dec.frames
        fwrite[ @f.y[ 0 ], 1, u64[ f.y.count ], out ]
        fwrite[ @f.u[ 0 ], 1, u64[ f.u.count ], out ]
        fwrite[ @f.v[ 0 ], 1, u64[ f.v.count ], out ]
    fclose[ out ]
    log 'hevc decode: {dec.frames.count} of {samples} frames, {dec.width}x{dec.height}, full {dec.full}'
    return dec.frames.count == samples && samples > 0

expect func t_take_length [] -> bool
    te : cstr [ getenv[ 'COMPOSER_TAKE' ] ]
    if [ !te ] return true
    tp : path [ te ]
    if [ !tp.exists[] ] return true
    ln : f64 [ take_length[ tp ] ]
    log 'take length {ln} s'
    return ln > 0.0

expect func t_composition_plan [] -> bool
    dir : path '/tmp/composer-test'
    dir.make_dir[]
    res : path '{dir}/take'
    res.make_dir[]
    pic : path '{res}/bunny.jpg'
    pic.save[ 'x', null ]
    cp : path '{res}/take.composition.agi'
    cp.save[
        'source: \'take.mp4\'\noutput: \'take.final.mp4\'\nops:\n\tf0: Fetch\n\t\tname: \'bunny\'\n\te0: Crop\n\t\tfrom: 10.0\n\t\tto: 13.0\n\t\twhy: \'instruction\'\n\te1: Insert\n\t\tat: 20.0\n\t\tmedia: \'take/bunny.jpg\'\n\t\tdur: 4.0\n\t\tplace: \'pip\'\n\t\twhy: \'after the race\'\n', null ]
    c : Composer [ take: path '{res}/take.mp4', length: 60.0,
        kept: vec Kept [], overlays: vec Overlay [],
        problems: vec string [] ]
    if [ !c.load[] ] return false
    if [ c.comp.ops.count != 3 ] return false
    o1 : Op c.comp.ops[ 1 ]
    if [ o1.stage*[] != 1 ] return false
    if [ !c.plan[] ]
        for [ p: string ] in c.problems
            log 'problem: {p}'
        return false
    # two spans kept; the insert at 20 lands at 17 on the output
    if [ c.kept.count != 2 || c.overlays.count != 1 ] return false
    ov : Overlay c.overlays[ 0 ]
    log 'insert lands at {ov.out_at} for {ov.length}'
    return ov.out_at == 17.0 && ov.length == 4.0

# a mute clears 0.5..1.5 s: silence, or the app's stem alone
expect func t_mute [] -> bool
    c : Composer [ length: 2.0, problems: vec string [] ]
    c.mutes = vec Mute []
    if [ !c.add_mute[ Mute [ from: 0.5, to: 1.5 ] ] ] return false
    if [ c.add_mute[ Mute [ from: 1.0, to: 3.0 ] ] ] return false
    n : i64 [ 96000 ]
    whole : vec i16 [ n * 2 ]
    app : vec i16 [ n * 2 ]
    mic : vec i16 [ n * 2 ]
    for [ i: i64 0, i < n * 2, i += 1 ]
        whole[ i ] = 1000
        app[ i ]   = 200
        mic[ i ]   = 800
    snd : AudioClip [ rate: 48000, channels: 2, frames: n,
                      pcm: @whole[ 0 ] ]
    c.apply_mutes[ snd, null, null ]
    if [ whole[ 48000 * 2 ] != 0 || whole[ 1000 ] != 1000
         || whole[ 80000 * 2 ] != 1000 ] return false
    for [ i: i64 0, i < n * 2, i += 1 ]
        whole[ i ] = 1000
    as : AudioClip [ rate: 48000, channels: 2, frames: n,
                     pcm: @app[ 0 ] ]
    ms : AudioClip [ rate: 48000, channels: 2, frames: n,
                     pcm: @mic[ 0 ] ]
    c.apply_mutes[ snd, as, ms ]
    log 'mute: {whole[ 48000 * 2 ]} with stems, {whole[ 1000 ]} outside'
    return whole[ 48000 * 2 ] == 200 && whole[ 1000 ] == 1000

expect func t_composition_cut [] -> bool
    dir : path '/tmp/composer-cut'
    dir.make_dir[]
    res : path '{dir}/take'
    res.make_dir[]
    clip : path '{res}/bunny.mp4'
    clip.save[ 'x', null ]
    pic : path '{res}/logo.png'
    pic.save[ 'x', null ]
    cp : path '{res}/take.composition.agi'
    cp.save[
        'ops:\n\te0: Insert\n\t\tat: 10.0\n\t\tmedia: \'take/bunny.mp4\'\n\t\tfrom: 2.0\n\t\tto: 8.0\n\t\tplace: \'full\'\n\t\tsound: \'media\'\n\t\tpause: true\n\te1: Insert\n\t\tat: 30.0\n\t\tmedia: \'take/logo.png\'\n\t\tdur: 3.0\n', null ]
    c : Composer [ take: path '{res}/take.mp4', length: 60.0,
        kept: vec Kept [], overlays: vec Overlay [],
        problems: vec string [] ]
    if [ !c.load[] || !c.plan[] ] return false
    cut : Overlay c.overlays[ 0 ]
    pip : Overlay c.overlays[ 1 ]
    log 'cut at {cut.out_at} for {cut.length}; pip at {pip.out_at}, size {pip.insert.size}'
    # the 6 s cut holds the take: the pip at 30 lands at 36
    return cut.out_at == 10.0 && pip.out_at == 36.0 &&
        pip.insert.size == 0.33
