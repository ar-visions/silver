func inlay_len [ inlay v: v2 ] -> f32   # inlay: the struct passes by value
    return v.x + v.y

expect func t_inlay_arg [] -> bool
    v: v2 [ x: 1.0, y: 2.0 ]
    return inlay_len[ v ] == 3.0

expect func t_expect_expr [] -> bool
    ok: bool [ expect 1 == 1 ]      # expect in expression position
    return ok

intern exception_finally_hits : i32

func raise_feature [ message: string ] -> none
    throw message

expect func t_try_catch_finally [] -> bool
    caught: string [ null ]
    exception_finally_hits = 0
    try
        raise_feature[ 'boom' ]
    catch [ message: string ]
        caught = message
    finally
        exception_finally_hits += 1
    return caught == 'boom' && exception_finally_hits == 1

expect func t_try_normal_finally [] -> bool
    value: i32 [ 0 ]
    try
        value = 2
    finally
        value += 3
    return value == 5

expect func t_try_finally_rethrow [] -> bool
    caught: string [ null ]
    finalized: bool [ false ]
    try
        try
            raise_feature[ 'nested' ]
        finally
            finalized = true
    catch [ message: string ]
        caught = message
    return caught == 'nested' && finalized

expect func t_catch_throw_runs_finally [] -> bool
    caught: string [ null ]
    finalized: bool [ false ]
    try
        try
            raise_feature[ 'first' ]
        catch
            raise_feature[ 'second' ]
        finally
            finalized = true
    catch [ message: string ]
        caught = message
    return caught == 'second' && finalized

expect func t_catch_without_finally [] -> bool
    caught: bool [ false ]
    try
        raise_feature[ 'plain' ]
    catch
        caught = true
    return caught



expect func t_multiline [] -> bool
    c: Counter                      # an indented block is the initializer
        count: 3
        label: 'multi'
    r: sum_pair[ 2,
        3 ]                         # an open [ continues onto the next line
    return c.count == 3 && c.label == 'multi' && r == 5

intern early_hits : i64

func early [ ok: bool ] -> i64
    v: ok || return 0               # a falsy left returns early
    early_hits += 1
    return 1

expect func t_or_return_void [] -> bool
    early[ false ]
    early[ true ]
    return early_hits == 1

expect func t_loops_more [] -> bool
    m: map i64 [ string ] [ ]
    m[ 'a' ] = 1
    m[ 'b' ] = 2
    last: string [ null ]
    for [ v: i64, k: string ] reverse in m
        last = k
    hits: i32 [ 0 ]
    for [ i: i32 0, i < 3, i += 1 ]
        for [ j: i32 0, j < 3, j += 1 ]
            if [ j == 1 ]
                continue [ 1 ]      # continue the OUTER loop
            hits += 1
    return last == 'a' && hits == 3

expect func t_two_part_for [] -> bool
    i: i32 [ 0 ]
    sum: i32 [ 0 ]
    for [ i = 0, i < 4 ]            # init and condition only
        sum += i
        i += 1                      # the body advances the loop
    return sum == 6

expect func t_switch_int [] -> bool
    n: i32 [ 2 ]
    r: i32 [ 0 ]
    switch [ n ]                    # integers switch too
        case 1, 2
            r = 12
        case 3
            r = 3
    return r == 12

enum Auto                           # values count up from 0
    zero
    one
    two

expect func t_enum_more [] -> bool
    c: Color [ 2 ]                  # a number converts to its member
    r: Color [ 'red' ]              # so does the member's name at runtime
    return c == green && r == red && Auto.two == 2

expect func t_compare_more [] -> bool
    a1: v2 [ x: 1.0, y: 2.0 ]
    b1: v2 [ x: 1.0, y: 2.0 ]
    s1: 'apple'
    s2: 'banana'
    return a1 == b1 && s1 < s2 && s2 > s1

class Acc
    public total : i64
    operator += [ n: i64 ] -> i64   # a compound overload mutates; no store-back
        total += n
        return total

expect func t_op_assign_overload [] -> bool
    a: Acc [ total: 5 ]
    a += 3                          # compound assignment overload
    return a.total == 8

expect func t_vec_math [] -> bool
    a: vec i32 [ 3 ]
    b: vec i32 [ 3 ]
    f: vec f32 [ 3 ]
    for [ i: i32 0, i < 3, i += 1 ]
        a[ i ] = 7 + i
        b[ i ] = 3
        f[ i ] = 4.0
    r: a % b                        # element-wise remainder
    s: sqrt[ f ]                    # math builtins map over a vec
    one: f32 [ 1.0 ]
    mn: min[ f, one ]               # so do min, max, clamp
    return r[ 0 ] == 1 && r[ 2 ] == 0 && s[ 1 ] == 2.0 && mn[ 2 ] == 1.0

expect func t_ptr_arith [] -> bool
    loc: local i32 [ 4 ] [ 10, 20, 30, 40 ]
    p: @loc[ 0 ]
    q: p + 8                        # pointer math moves BYTES, not elements
    d: q - p                        # pointer minus pointer: byte distance
    return q[ 0 ] == 30 && d == 8

expect func t_construct_more [] -> bool
    p: v2 [ 1.0, 2.0 ]              # positional struct construction
    m: map i64 [ string ] [ 'a': 1, 'b': 2 ]    # map literal
    s: string [ 42 ]                # a number to string
    b: takes_any[ 7 ]               # a number boxes into any
    n7: i32 [ 7 ]
    pi: @ n7
    back: i32 [ pi[ 0 ] ]           # reading through a pointer is indexing
    c: Counter [ count: 1 ]
    raw: @u8 [ c ]               # an object to its byte pointer
    expect p.y == 2.0, 'positional p = {p.x} {p.y}'
    expect m[ 'b' ] == 2, 'map literal b = {m['b']}'
    expect s == '42', 's = {s}'
    expect b, 'takes_any boxed'
    expect back == 7, 'back = {back}'
    expect raw != null, 'raw null'
    return true

expect func t_string_more [] -> bool
    s: 'Hello-World-x'
    lo: s.lcase[]
    ri: s.rindex_of[ '-' ]
    t:  '  pad  '
    lt: t.ltrim[]
    rt: t.rtrim[]
    j: 'ab'
    j.append[ 'cd' ]
    k: 'ab' + 'cd'                  # + joins strings
    n: '42'
    return lo == 'hello-world-x' && ri == 11 && lt == 'pad  ' && rt == '  pad' && j == 'abcd' && k == 'abcd' && n.is_numeric[] && n.integer_value[] == 42 && s.first[] == 72 && s[ 1 ] == 101

expect func t_collections_more [] -> bool
    v: vec i64 [] [ 1, 2 ]
    w: vec i64 [] [ 1, 2 ]
    m: map i64 [ string ] [ ]
    m[ 'a' ] = 1
    m[ 'b' ] = 2
    m.rm[ 'a' ]
    n1: i64 [ m.count ]
    m.clear[]
    return v.equals[ w ] && n1 == 1 && m.count == 0

expect func t_path_ops [] -> bool
    p: path 'dir/sub/file.txt'
    st: p.stem[]
    ex: p.ext[]
    fn: p.filename[]
    pd: p.parent_dir[]
    tmp: path.path_tempfile[ 'txt' ]   # unique file in the temp dir
    tmp.save[ 'temp-data', null ]
    ok: tmp.exists[]
    tmp.remove[]
    gone: !tmp.exists[]
    return st == 'file' && ex == 'txt' && fn == 'file.txt' && string [ pd ] == 'dir/sub' && ok && gone

# a scalar prints as its value with the unit as suffix — generated for
# every scalar unless it declares its own string cast
expect func t_scalar_print [] -> bool
    how_many_ft : ft [ 150cm ]
    d : 16ms
    simple : how_many_ft.1f
    puts simple
    return '{how_many_ft}' == '4.92126ft' && '{d}' == '16ms' &&
           how_many_ft.4f == '4.9213ft' && '{d.3d}' == '016ms' && simple == '4.9ft'

# C-style format postfix: `.4f` is the C precision spec, formatting the
# value to a string inside {} or anywhere; the chain continues from it
expect func t_format_postfix [] -> bool
    x : f64 [ 3.14159 ]
    n : i32 [ 255 ]
    s : 'abcdef'
    return '{x.2f}' == '3.14' && x.4f == '3.1416' && x.2f.count == 4 &&
           n.02x == 'ff' && n.05d == '00255' && s.4s == 'abcd'

expect func t_float_methods [] -> bool
    x: f64 [ 3.14159 ]
    r: x.round[ 2 ]
    z: f64 [ 0.0 ]
    n: z / z
    return r == 3.14 && n.is_nan[] && x.is_finite[]

expect func t_shape_value [] -> bool
    s: 4x4                          # a shape is a value
    return s.total[] == 16 && s.count == 2

# the argv parser is C surface: declare it, libAu resolves it at link
intern func Au_with_cstrs [ object, @cstr ] -> object

class ArgApp
    public  depth : i32
    public  fast  : bool
    default rom   : path            # the bare argument

expect func t_argv [] -> bool
