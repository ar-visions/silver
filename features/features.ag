# the silver language, annotated and self-verifying
# each entry is a feature; run: silver --test features
export 1.0.0                        # module version
# setenv at module init — trinity exports VK_LAYER_PATH this way. it
# lands after the expect tests run, so no test can observe it
export FEATURES_MODE: 'test'
export extensions [ '.feat' ]       # registry: export/silver-features.agi

import <stdio.h>                    # C header, read by libclang
import <string.h>
import <stdlib.h>
import <ctype.h, limits.h>     # several headers in one line
import madler:zlib/51b7f2a <zlib.h>  # a git import: owner:repo/commit, built with cmake; flags below
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
    -lz
import troglobit:libuev/v2.4.1 <uev/uev.h>   # autotools: configure and make, in the checkout
    --disable-examples
    -luev
import fribidi:fribidi/v1.0.16 <fribidi.h>   # meson; its .pc file supplies the include path
    -Ddocs=false
    -Dtests=false
    -lfribidi
import vec                          # Au's own vector module: its records come from libAu's tables
import <cpp.hpp>                    # C++ header: .hpp marks the unit
import More                         # sibling .ag, headed extend
import random with RandomExtra as rnd   # add an extension, then alias

# config import: a module's own members are its parameters, set here
# by the importer and read-only inside the module
import fcfg
    greeting: 'set-by-features'
    scale:    7

# a single file by url: fetched once to install/imports, the file
# itself IS the cache. > lines run after, with {import_file} set
import https://raw.githubusercontent.com/ar-visions/silver/master/LICENSE
    > cp {import_file} {install}/share/silver-features/data/fetched.txt

ifdef [ windows ]                   # platform-gated import
    import <posix.h>
ifndef [ windows ]                  # ifndef is the negated form
    import <unistd.h>

enum Color : u8                     # explicit backing type
    red:   1
    green: 2
    blue:  3

enum Weight : f32                   # a float-backed enum
    light: 0.5
    heavy: 2.0

enum Mode                           # backing type is optional
    off: 0
    on:  1

scalar px : f32                     # name becomes a suffix: 200px
scalar ms : i64                     # integer scalars reject floats
scalar deg : f32

scalar mm   : f32
    cast -> cm   [ a / 10.0 ]
    cast -> inch [ a / 25.4 ]
    cast -> ft   [ a / 304.8 ]
    construct [ v: cm ]   [ v * 10.0 ]
    construct [ v: inch ] [ v * 25.4 ]
    construct [ v: ft ]   [ v * 304.8 ]

scalar cm   : f32
    cast -> mm   [ a * 10.0 ]
    cast -> inch [ a / 2.54 ]
    cast -> ft   [ a / 30.48 ]
    construct [ v: mm ]   [ v / 10.0 ]
    construct [ v: inch ] [ v * 2.54 ]
    construct [ v: ft ]   [ v * 30.48 ]

scalar inch : f32                   # `in` is a keyword
    cast -> mm [ a * 25.4 ]
    cast -> cm [ a * 2.54 ]
    cast -> ft [ a / 12.0 ]
    construct [ v: mm ] [ v / 25.4 ]
    construct [ v: cm ] [ v / 2.54 ]
    construct [ v: ft ] [ v * 12.0 ]

scalar ft   : f32                   # 2.0ft, not 2.0f + a stray t
    cast -> mm   [ a * 304.8 ]
    cast -> cm   [ a * 30.48 ]
    cast -> inch [ a * 12.0 ]
    construct [ v: mm ]   [ v / 304.8 ]
    construct [ v: cm ]   [ v / 30.48 ]
    construct [ v: inch ] [ v / 12.0 ]

alias ints    : vec i64             # alias names a compound type
alias byname  : map i64 [ string ]  # bracketed type is the KEY
alias FutureA : FutureB             # forward aliases resolve in passes
alias FutureB : FuturePair

struct v2                           # struct is an inlay value type
    x: f32
    y: f32

    operator + [ b: v2 ] -> v2 [ x: x + b.x, y: y + b.y ]
    operator - [ b: v2 ] -> v2 [ x: x - b.x, y: y - b.y ]
    operator * [ k: f32 ] -> v2 [ x: x * k,   y: y * k   ]
    operator left * [ k: f32 ] -> v2 [ x: x * k, y: y * k ]

    func dot [ b: v2 ] -> f32
        return x * b.x + y * b.y

    cast -> string [ 'v2-{x}-{y}' ] # conversion member

struct span2                        # same size as v2: bitcasts
    lo: f32
    hi: f32

    func width [] -> f32
        return hi - lo

struct FuturePair                   # target of aliases above
    x: i32

class Before                        # record bodies resolve later types
    public after : After

class After
    public value : i32

class Counter                       # class is heap, ref-counted
    public  count  : i64            # readable outside, written in
    intern  hidden : i64            # module-private
    mutable label  : string         # writable by outsiders

    static  made   : i64            # one per type, not per object

    func init []                    # runs after props are set
        hidden = 7

    func inc []
        count += 1

    public func value [] -> i64
        return count

    intern func peek_hidden [] -> i64
        return hidden

    func tally [] -> i64            # a static is shared by every instance
        made += 1
        return made

    cast -> string [ 'count-{count}' ]
    cast -> bool   [ count != 0 ]

    operator +  [ n: i64 ] -> i64 [ count + n ]
    operator -  [ n: i64 ] -> i64 [ count - n ]
    operator *  [ n: i64 ] -> i64 [ count * n ]
    operator /  [ n: i64 ] -> i64 [ count / n ]
    operator %  [ n: i64 ] -> i64 [ count % n ]
    operator |  [ n: i64 ] -> i64 [ count | n ]
    operator &  [ n: i64 ] -> i64 [ count & n ]
    operator ^  [ n: i64 ] -> i64 [ count ^ n ]
    operator << [ n: i64 ] -> i64 [ count << n ]
    operator >> [ n: i64 ] -> i64 [ count >> n ]

    # left = scalar on the left; only * / << >> have that slot
    operator left /  [ n: i64 ] -> i64 [ n / count ]
    operator left << [ n: i64 ] -> i64 [ n << count ]
    operator left >> [ n: i64 ] -> i64 [ n >> count ]

Counter Doubler                     # base name IS the keyword
    func inc []
        super.inc[]                # super reaches the base
        count += 1

    func value [] -> i64
        return super.value[] * 10

class Boxed
    public data : vec i64 [ 8 ]     # heap buffer member
    public last_op : i32

    getter [ i: i64 ] -> i64        # obj[ i ] read
        return data[ i ]

    setter [ i: i64, v: i64, op: i32 ]  # obj[ i ] = v
        last_op = op
        data[ i ] = v

class Named
    expect  name  : string          # required at construction
    mutable score : i64
    intern  hits  : i64

    func bump_hits [] -> i64        # intern member, reached from within
        hits += 1
        return hits

    construct [ n: i64 ]            # build from ONE other type
        name = 'n-{n}'
        score = n

    # same name space as construct: needs a different arg type
    post construct [ s: string ]    # runs after init completes
        name = s
        score = 100

class Shape
    public sides : i32
    public tag   : string

    func describe [] -> string
        return 'shape-{sides}'

    func area_ish [] -> i32
        return sides * sides

Shape Square
    func init []
        sides = 4
        tag = 'square'

    func describe [] -> string
        return 'square-{sides}'

Shape Tri
    func init []
        sides = 3
        tag = 'tri'

    func describe [] -> string
        return 'tri-{sides}'

class Holder
    public shape : Shape*           # * = holds any subclass
    public items : vec i64
    public named : map i64 [ string ]

class Stepper
    public start   : i64
    # a lambda type is written inline: return type, then arg types
    public on_step : lambda i64 [ i64 ]

    # :: opens contextual args — that is what makes it a lambda.
    # reach it with lambda s.step_twice[ base ], never by name
    func step_twice [ n: i64 :: base: i64 ] -> i64
        return n * 2 + base


# a bodyless func is implemented in the companion named for the module
intern func c_add   [ i32, i32 ] -> i32          # features.c
intern func c_scale [ i32, i32 ] -> i32
intern func c_len   [ cstr ] -> i32              # silver string in
intern func c_rss_kb [] -> i64                   # resident memory, KB
intern func c_log_last [] -> cstr                # last au_log line
intern func c_fill  [ @i32, i32, i32 ] -> none   # writes through a ref
intern func cc_mul  [ i32, i32 ] -> i32          # features.cc
intern func cc_pow2 [ i32 ] -> i32
intern func cc_sum  [ @i32, i32 ] -> i32         # uses the C++ stdlib

# Type-first arguments support unnamed C-style declarations.
func type_only_arg [ i32 ] -> i32
    return 7

func type_void [] -> void
    no-op

func commaless [ p: px, m: ms, d: deg ] -> f32
    return 1.0

func takes_any [ v: any ] -> bool   # any accepts every object
    return v != null

func sum_pair [ a: i64, b: i64 ] -> i64
    return a + b

# a lambda as an ARGUMENT, typed inline
func apply_step [ fn: lambda i64 [ i64 ], n: i64 ] -> i64
    return fn[ n ]

# 10MB rides in the lambda's context; it must go when the lambda does
intern payload_dropped : i64

class Payload
    public data : vec i8 [ 10485760 ]   # ten megabytes onboard

    func touch [] -> i64
        for [ k: i64 0, k < 10485760, k += 4096 ]
            data[ k ] = 7               # make the pages resident
        return 1

    func dealloc []
        payload_dropped += 1

func hold_big [ i: i64 :: big: Payload ] -> i64
    return big.touch[] + i

func make_and_drop [] -> i64
    p  : Payload [ ]                # born at refs 0, on the auto-free list
    fn : lambda hold_big[ p ]       # the context holds it: refs 1
    return fn[ 1 ]

func plain_scope [] -> i64          # same payload, no lambda involved
    p : Payload [ ]
    return p.touch[] + 1

# ---- build-time: export func runs during the BUILD, then exits ----
# this is how scenes instances its resources: bake once, ship the
# artifact, and let the app read it at run time

func bake_text [] -> string
    return 'baked-by-features'

export func bake_greeting []
    # u64 [ @fn ] is the token hash of fn's source: the stamp changes
    # only when the code that produces the artifact changes
    stamp : string '{u64[ @bake_text ]}'
    sp : path '{path.path_share_path[]}/data/baked.hash'
    op : path '{path.path_share_path[]}/data/baked.txt'
    # silver --export forces the bake: skip the stamp short-circuit
    force : getenv[ 'SILVER_EXPORT_FORCE' ]
    if [ !force && sp.exists[] && op.exists[] ]
        old : string [ sp.load[ typeid[string], null ] ]
        if [ old && old == stamp ]
            puts 'features: baked artifact current'
            return
    op.save[ bake_text[], null ]
    sp.save[ stamp, null ]
    puts 'features: baked artifact written'

# ---- expect func declares a test the compiler runs ----

expect func t_declare [] -> bool
    x: i32 [ 42 ]                   # : declares, = assigns
    x = 10
    y: x + 1                        # type inferred from expr
    z: y
    w: i64 [ x ]                    # explicit type conversion
    return y == 11 && z == 11 && w == 10

expect func t_assign_ops [] -> bool
    n: i64 [ 20 ]
    n += 4
    n -= 2
    n *= 3
    n /= 2
    n %= 25
    n |= 32
    n &= 62
    n ^= 3
    n <<= 2
    n >>= 1
    return n == 86

expect func t_bitwise [] -> bool
    a: i64 [ 12 ]
    b: i64 [ 10 ]
    return (a | b) == 14 && (a & b) == 8 && (a ^ b) == 6 && (a << 2) == 48 && (a >> 2) == 3 && ~0 == -1

expect func t_compare [] -> bool
    a: i64 [ 5 ]
    b: i64 [ 9 ]
    c: (a <=> b)                    # spaceship: i32 sign result
    return a < b && a <= b && b > a && b >= a && a != b && a == 5 && c < 0

expect func t_control [] -> bool
    total: i32 [ 0 ]
    for [ i: i32 0, i < 10, i += 1 ]    # init, cond, step
        if [ i == 3 ]
            continue
        el [ i == 7 ]               # el is else-if and else
            break
        el
            total += i
    n: i32 [ 0 ]
    while [ n < 5 ]
        n += 1
    running: bool [ true ]
    for [ running ]                 # one part = condition only
        running = false
    dw: i32 [ 0 ]
    for                             # no [ ] = do-while form
        dw += 1
    while [ dw < 3 ]                # tested after the body runs
    no-op                           # explicit empty statement
    return total == 18 && n == 5 && dw == 3

expect func t_switch [] -> bool
    c: Color.green
    r: i32 [ 0 ]
    switch [ c ]
        case red                    # bare member: type inferred
            r = 1
        case green, blue            # cases never fall through
            r = 2
        default
            r = 3
    m: Mode.on
    q: i32 [ 0 ]
    switch [ m ]
        case on
            q = 9
        default
            q = 1
    return r == 2 && q == 9

expect func t_enums [] -> bool
    c: Color.blue
    i: i32 [ c ]                    # enums convert to integers
    w: Weight.heavy
    f: f32 [ w ]                    # and to floats
    return i == 3 && f == 2.0

expect func t_expr [] -> bool
    x: i32 [ 5 ]
    t: (x > 0) ? x : -x             # condition must be parens
    hat: bool [ x == (1, 3, 5, 7) ] # true when any one matches
    nhat: bool [ x != (2, 4, 6) ]   # true when none match
    rin: bool [ x == (2 ... 10) ]   # inclusive range
    rex: bool [ x != (6 ..< 9) ]    # end-exclusive range
    inv: i32 [ ~0 ]
    nn:  bool [ not false ]
    nb:  bool [ !false ]
    ng:  i32 [ -x ]
    return t == 5 && hat && nhat && rin && rex && inv == -1 && nn && nb && ng == -5

expect func t_cast [] -> bool
    f: f64 [ 3.9 ]
    i: i32 [ f ]                    # conversion by construction
    j: i32 [ 0 ]
    j = cast i32 [ f ]              # the explicit form
    c: Counter [ count: 5 ]
    s: string [ c ]                 # dispatches cast -> string
    b: bool [ c ]                   # dispatches cast -> bool
    vv: v2 [ x: 1.0, y: 2.0 ]
    vs: string [ vv ]
    return i == 3 && j == 3 && s == 'count-5' && b && vs == 'v2-1-2'

expect func t_types [] -> bool
    s: 'hello'
    ok1: bool [ typeid[ i32 ] == typeid[ i32 ] ]
    ok2: bool [ sizeof[ i64 ] == 8 ]
    ok3: bool [ s is string ]       # is compares type identity
    d: Doubler [ ]
    ok4: bool [ d inherits Counter ]    # walks ancestry
    ok5: bool [ typeid[ s ] == typeid[ string ] ]
    ok6: bool [ takes_any[ s ] ]
    return ok1 && ok2 && ok3 && ok4 && ok5 && ok6

expect func t_forward_types [] -> bool
    p: FutureA [ x: 9 ]
    b: Before [ after: After [ value: 7 ] ]
    return p.x == 9 && b.after.value == 7

expect func t_c_type_spellings [] -> bool
    a: signed [ -1 ]
    b: unsigned [ 1 ]
    c: signed char [ -2 ]
    d: unsigned char [ 3 ]
    e: signed short [ -4 ]
    f: unsigned short [ 5 ]
    g: signed int [ -6 ]
    h: unsigned int [ 7 ]
    i: signed long [ -8 ]
    j: unsigned long [ 9 ]
    k: signed long long [ -10 ]
    l: unsigned long long [ 11 ]
    m: float [ 1.5 ]
    n: double [ 2.5 ]
    o: struct v2 [ x: 3.0, y: 4.0 ]
    type_void[]
    return a == -1 && b == 1 && c == -2 && d == 3 &&
           e == -4 && f == 5 && g == -6 && h == 7 &&
           i == -8 && j == 9 && k == -10 && l == 11 &&
           m == 1.5 && n == 2.5 && o.y == 4.0 &&
           type_only_arg[ 1 ] == 7

expect func t_null [] -> bool
    z: @i32                      # typed null pointer
    fallback: 'world'
    name: string [ null ]
    v: (name) ?? fallback           # null-coalesce
    w: name || fallback             # keeps the truthy operand
    y: 'yes' && 'also'
    h: Holder [ ]
    g: h->shape->tag                # -> yields default on null
    return !z && v == 'world' && w == 'world' && y == 'also' && !g

expect func t_strings [] -> bool
    name: 'silver'                  # single quotes interpolate
    x: i32 [ 7 ]
    c: Counter [ count: 3 ]
    msg: 'hello {name}, value is {x}'
    call: 'v={c.value[]} n={sum_pair[ 2, 3 ]}'   # calls inline
    big: f64 [ 1e2 ]                # scientific notation
    tiny: f64 [ 2.5e-1 ]
    hexv: i64 [ 0xff ]
    lit: "cstr-literal"             # double quotes are cstr
    n: i32 [ strlen[ lit ] ]
    return msg == 'hello silver, value is 7' && call == 'v=3 n=5' && big == 100.0 && tiny == 0.25 && hexv == 255 && n == 12

expect func t_scalars [] -> bool
    w: 200px
    d: 16ms
    a: 90deg
    r: commaless[ w, d, a ]         # commas: positional
    r2: commaless[ 90deg 200px 16ms ] # no commas: matched BY TYPE
    return r == 1.0 && r2 == 1.0

expect func t_scalar_units [] -> bool
    d: 254mm
    h: 25.5cm                       # exact in binary: f32 == f64 holds
    i: 10.0inch                     # `in` is a keyword, so inches spell out
    v: 2.0ft
    dc: cast cm [ d ]
    im: cast mm [ i ]
    vi: cast inch [ v ]
    hf: cast ft [ h ]
    dc_ctr: cm [ d ]
    im_ctr: mm [ i ]
    vi_ctr: inch [ v ]
    hf_ctr: ft [ h ]
    return d == 254mm && d != 253mm && h * 2.0 == 51.0 &&
           d / 2.0 == 127.0 && i * 2.0 == 20.0 &&
           v + 1.0 == 3.0 && dc == 25.4cm && im == 254mm &&
           vi == 24inch && hf == 0.8366142ft &&
           dc_ctr == dc && im_ctr == im && vi_ctr == vi &&
           hf_ctr == hf

expect func t_collections [] -> bool
    items: vec i64 [] [ 3, 5, 8 ]
    b : items[ 0 ]                  # non-holding borrow
    items += 13                     # append
    m: map i64 [ string ] [ ]       # trailing [ ] allocates
    m[ 'a' ] = 10
    m[ 'b' ] = 20
    sum: i64 [ 0 ]
    for [ v: i64, k: string ] in m  # map gives value then key
        sum += v
    fsum: i64 [ 0 ]
    for [ v: i64 ] in items
        fsum += v
    rsum: i64 [ 0 ]
    first: i64 [ 0 ]
    for [ v: i64 ] reverse in items # back to front
        if [ rsum == 0 ]
            first = v
        rsum += v
    al: ints [ 1, 2 ]               # alias-typed vec
    bm: byname [ ]                  # alias-typed map
    bm[ 'k' ] = 4
    ok_al: bool [ al.count == 2 ]
    sm: map string [ string ] [ ]
    sm[ 'x' ] = 'yes'
    ok_sm: bool [ sm[ 'x' ] == 'yes' ]
    ok_bm: bool [ bm.count == 1 ]
    return b == 3 && sum == 30 && fsum == 29 && rsum == 29 && first == 13 && ok_al && ok_sm && ok_bm

expect func t_arrays [] -> bool
    a1: vec f32 [ 4 ]               # heap-allocated typed memory
    a2: vec f32 [ 4 ]
    for [ i: i32 0, i < 4, i += 1 ]
        a1[ i ] = f32[ i ]
        a2[ i ] = 2.0
    a3: a1 + a2                     # element-wise on both
    a4: a1 * 3.0                    # scalar broadcasts
    a5: a1 - a2
    a6: a2 / 2.0
    k: vec i32 [ 2x2 ] [ 1 2, 3 4 ] # shape plus constant data
    loc: local i32 [ 3 ] [ 9, 8, 7 ]    # stack array
    dst: local i32 [ 3 ]
    memcpy[ @dst[ 0 ], @loc[ 0 ], 12 ]
    zed: local i32 [ 2 ]
    memset[ @zed[ 0 ], 0, 8 ]
    n: i32 [ 3 ]
    dyn: local i32 [ n ]            # runtime count is allowed
    dyn[ 2 ] = 5
    return a3[ 2 ] == 4.0 && a4[ 3 ] == 9.0 && a5[ 1 ] == -1.0 && a6[ 0 ] == 1.0 && k[ 3 ] == 4 && dst[ 1 ] == 8 && zed[ 0 ] == 0 && dyn[ 2 ] == 5

expect func t_shaped [] -> bool
    m: vec f32 [ 2x2 ] [ 1.0 2.0, 3.0 4.0 ]
    q: vec f32 [ 2x2 ] [ 5.0 6.0, 7.0 8.0 ]
    p: m * q                        # ELEMENT-WISE, not matrix multiply
    s: m * 2.0                      # scalar broadcasts
    d: m + q
    return p[ 0 ] == 5.0 && p[ 3 ] == 32.0 && s[ 1 ] == 4.0 && d[ 2 ] == 10.0

expect func t_math [] -> bool
    r1: sqrt[ 16.0 ]
    r2: min[ 3, 9 ]
    r3: max[ 3, 9 ]
    r4: clamp[ 12, 0, 10 ]
    r5: abs[ -6 ]
    r6: pow[ 2.0, 10.0 ]
    r7: mix[ 0.0, 10.0, 0.5 ]       # from * (1 - t) + to * t
    r8: floor[ 3.7 ]
    r9: ceil[ 3.2 ]
    r10: round[ 3.5 ]
    r11: exp[ 0.0 ]
    r12: log[ 1.0 ]
    r13: atan2[ 0.0, 1.0 ]
    r14: sin[ 0.0 ]
    r15: cos[ 0.0 ]
    r16: tan[ 0.0 ]
    r17: asin[ 0.0 ]
    r18: acos[ 1.0 ]
    r19: atan[ 0.0 ]
    return r1 == 4.0 && r2 == 3 && r3 == 9 && r4 == 10 && r5 == 6 && r6 == 1024.0 && r7 == 5.0 && r8 == 3.0 && r9 == 4.0 && r10 == 4.0 && r11 == 1.0 && r12 == 0.0 && r13 == 0.0 && r14 == 0.0 && r15 == 1.0 && r16 == 0.0 && r17 == 0.0 && r18 == 0.0 && r19 == 0.0

expect func t_ref [] -> bool
    n: i32 [ 41 ]
    p: @ n                          # @ is ref: address-of
    p[ 0 ] += 1
    bytes: @u8 p                 # @Type expr casts
    loc: local i32 [ 2 ] [ 5, 6 ]
    q: @loc[ 1 ]                    # address of an element
    nullp: @i64                  # @Type alone is null
    return n == 42 && q[ 0 ] == 6 && !nullp && bytes != null

expect func t_class [] -> bool
    c: Counter [ count: 3, label: 'main' ]  # prop pairs
    c.inc                          # zero-arg call, no brackets
    c.inc*[]                       # * dispatches dynamically
    t1: c + 5
    t2: c - 1
    t3: c * 2
    t4: c / 5
    t5: c % 3
    t6: c | 2
    t7: c & 4
    t8: c ^ 1
    t9: c << 1
    t10: c >> 1
    t11: 20 / c                     # reverse slot: operator left
    t12: 1 << c
    t13: 160 >> c
    n1: c.tally[]                   # static: shared across instances
    o: Counter [ count: 0 ]
    n2: o.tally[]
    return c.value[] == 5 && c.peek_hidden[] == 7 && t1 == 10 && t2 == 4 && t3 == 10 && t4 == 1 && t5 == 2 && t6 == 7 && t7 == 4 && t8 == 4 && t9 == 10 && t10 == 2 && t11 == 4 && t12 == 32 && t13 == 5 && c.label == 'main' && n2 == n1 + 1

expect func t_inherit [] -> bool
    d: Doubler [ count: 0 ]
    d.inc
    sq: Square [ ]
    tr: Tri [ ]
    h: Holder [ shape: sq ]
    poly: h.shape.describe[]        # direct: uses STATIC type
    h.shape = tr
    poly2: h.shape.describe*[]      # *[]: uses dynamic type
    ar: h.shape.area_ish[]          # base method through the member
    h.items = vec i64 [] [ 2, 4 ]   # collection members on a class
    h.named = map i64 [ string ] [ ]
    h.named[ 'k' ] = 9
    return d.count == 2 && d.value[] == 20 && poly == 'shape-4' && poly2 == 'tri-3' && ar == 9 && h.items[ 1 ] == 4 && h.named.count == 1

expect func t_structs [] -> bool
    a1: v2 [ x: 1.0, y: 2.0 ]
    b1: v2 [ x: 3.0, y: 4.0 ]
    c1: a1 + b1
    d1: b1 - a1
    e1: a1 * 2.0
    f1: 2.0 * a1                    # binds operator left *
    dp: a1.dot[ b1 ]
    s1: cast span2 [ a1 ]           # same size: a bitcast
    return c1.x == 4.0 && c1.y == 6.0 && d1.x == 2.0 && e1.y == 4.0 && f1.x == 2.0 && dp == 11.0 && s1.lo == 1.0 && s1.width[] == 1.0

expect func t_construct [] -> bool
    nm: Named [ 7 ]                 # runs construct [ i64 ]
    pm: Named [ 'abc' ]             # runs post construct
    width: i64 [ 3 ]
    sh: Named [ 5 ]
    sh.score = width                # mutable member write
    h1: nm.bump_hits[]              # intern member, only from within
    h2: nm.bump_hits[]
    return nm.name == 'n-7' && nm.score == 7 && pm.name == 'abc' && pm.score == 100 && sh.score == 3 && h1 == 1 && h2 == 2

expect func t_indexers [] -> bool
    bx: Boxed [ ]
    bx[ 2 ] = 44                    # runs the setter
    assign_op: i32 [ bx.last_op ]
    bx[ 2 ] += 3                    # setter receives the operator
    add_op: i32 [ bx.last_op ]
    bx[ 3 ] = 7
    return bx[ 2 ] == 3 && bx[ 3 ] == 7 && add_op != assign_op

expect func t_lambda [] -> bool
    base: i64 [ 100 ]
    s: Stepper [ start: 1 ]
    f: lambda s.step_twice[ base ]  # bind the contextual args
    r: f[ 4 ]                       # call it: 4 * 2 + 100
    p: apply_step[ f, 6 ]           # handed to a function
    s.on_step = f                   # stored on a class member
    m: s.on_step[ 5 ]               # and called back through it
    # a bare mention hands the lambda over; a call always brackets
    return r == 108 && s.start == 1 && p == 112 && m == 110

expect func t_lambda_ctx_drop [] -> bool
    before: c_rss_kb[]
    r: make_and_drop[]              # 10MB rides in the lambda context
    Au.auto_free[ false ]           # drain: Au frees at refs 0 on drain
    after: c_rss_kb[]
    grew: i64 [ after - before ]
    # the drain reaps the lambda at refs 0; its dealloc drops the
    # context, the context drops the payload, the 10MB unmaps
    freed_ctx: i64 [ payload_dropped ]
    q: plain_scope[]                # the same payload with no lambda
    Au.auto_free[ false ]
    reaped: i64 [ payload_dropped - freed_ctx ]
    return r == 2 && q == 2 && freed_ctx == 1 && reaped == 1 && grew < 2048

# log prints under the object's binding stamp: the declaration that
# constructed it names it 'owner-module:ident'
class Chirper
    public tone : i32

    func chirp [] -> none
        log 'tone {tone}'

class Nest
    public egg : Chirper [ tone: 3 ]

expect func t_log [] -> bool
    b: Chirper [ tone: 7 ]
    b.chirp[ ]                      # local decl stamps 'features:b'
    s1: string [ c_log_last[ ] ]
    n: Nest [ ]
    n.egg.chirp[ ]                  # member default stamps 'Nest:egg'
    s2: string [ c_log_last[ ] ]
    n2: Nest [ egg: Chirper [ tone: 5 ] ]
    n2.egg.chirp[ ]                 # caller prop pair stamps the same
    s3: string [ c_log_last[ ] ]
    log 'sum {7 + 3}'               # free function: message, no stamp
    s4: string [ c_log_last[ ] ]
    return s1 == 'silver-features:b tone 7' && s2 == 'Nest:egg tone 3' &&
           s3 == 'Nest:egg tone 5' && s4 == 'sum 10'

# an inline lambda declares its args; everything else the body uses
# is copied into its context at the instance site
expect func t_lambda_inline [] -> bool
    base: i64 [ 100 ]
    f: lambda [ n: i64 ]
        return n * 2 + base
    r: f[ 4 ]                       # 4 * 2 + 100
    base = 50                       # copied at instance — r2 unchanged
    r2: f[ 4 ]
    p: apply_step[ f, 6 ]           # same lambda type as a named one
    return r == 108 && r2 == 108 && p == 112

expect func t_companions [] -> bool
    r1: c_add[ 40, 2 ]              # .c companion
    r2: cc_mul[ 6, 7 ]              # .cc companion
    r3: c_scale[ 6, 7 ]
    r4: cc_pow2[ 5 ]
    n: i32 [ 41 ]
    rs_bump[ @n ]                   # .rs companion, via cbindgen
    m: i32 [ rs_mul3[ 4 ] ]
    return r1 == 42 && r2 == 42 && r3 == 42 && r4 == 25 && n == 42 && m == 12

expect func t_companion_data [] -> bool
    txt: 'abcde'
    ln: c_len[ txt ]                # string passes as cstr
    buf: local i32 [ 4 ]
    c_fill[ @buf[ 0 ], 4, 10 ]      # C writes into our stack array
    cs: cc_sum[ @buf[ 0 ], 4 ]      # C++ reads it back
    rs: rs_sum[ @buf[ 0 ], 4 ]      # rust reads the same memory
    return ln == 5 && buf[ 3 ] == 13 && cs == 46 && rs == 46

expect func t_resources [] -> bool
    # any FOLDER in the module ships to install/share; a relative
    # path resolves there — symlinked in debug, copied in release
    # at RUN time the cwd is the bundle, so 'data/x' resolves; a test
    # runs from the launch cwd, so name the share dir explicitly
    p: path '{path.path_share_path[]}/data/greeting.txt'
    if [ !p.exists[] ] return false
    s: string p.load[ typeid[string], null ]
    return s == 'hello-from-resource'

expect func t_config_import [] -> bool
    # greeting was set at the import; scale kept its own default
    # every line in the import body is a config input
    return cfg_greeting[] == 'set-by-features' && cfg_scale[] == 7

expect func t_url_import [] -> bool
    # the > line above copied the fetched file into our bundle
    p: path '{path.path_share_path[]}/data/fetched.txt'
    if [ !p.exists[] ] return false
    s: string p.load[ typeid[string], null ]
    return s.count > 0

expect func t_build_time [] -> bool
    # bake_greeting ran at build time and left this behind
    p: path '{path.path_share_path[]}/data/baked.txt'
    if [ !p.exists[] ] return false
    s: string p.load[ typeid[string], null ]
    return s == 'baked-by-features'

expect func t_extend [] -> bool
    # More.ag says `extend features`: one module, two files
    return ext_triple[ 5 ] == 15 && ext_name[] == 'from-More'

expect func t_import_as [] -> bool
    rng_seed[ 12345 ]               # from the random module
    v: u64 [ rng_next[] ]
    return v != 0 && rng_extension_value[] == 42

# lexical shadowing: the nearest declaration wins — locals may take the
# names of module funcs, C imports, types, and import aliases; the one
# forbidden clash is a member of your own enclosing class
class ShadowHost
    public abs : i32 [ 3 ]          # member named after a C function

    func read [] -> i32
        return abs                  # the field, not stdlib abs

expect func t_shadowing [] -> bool
    sum_pair: i64 [ 3 ]             # shadows the module func
    puts:     i64 [ 2 ]             # shadows C stdio's puts
    Color:    i64 [ 7 ]             # shadows the enum type
    rnd:      i64 [ 9 ]             # shadows the import alias
    h: ShadowHost [ ]
    return sum_pair + puts + Color + rnd == 21 && h.read[] == 3

expect func t_cpp_templates [] -> bool
    pi: pairT<i32> [ a: 3, b: 4 ]   # sampled specialization
    pf: pairT<f32> [ a: 0.5, b: 1.5 ]
    po: pairT<i32> [ a: 1, b: 1 ]
    if [ pi.sum[] != 7 || pf.sum[] != 2.0 ] return false
    if [ pi * 2 != 14 ] return false    # C++ operator overload
    if [ (pi + po) != 9 || (pi - po) != 5 ] return false
    if [ pi.scale[ 3 ] != 21 ] return false
    si: scaled<i32,8> [ v: 3 ]      # integral template argument
    sf: scaled<f32,3> [ v: 1.5 ]
    if [ si.out[] != 24 || sf.out[] != 4.5 ] return false
    du: duo<i32,f32> [ first: 2, second: 3.0 ]  # two type args
    return du.wide[] == 5

# a string PARAMETER compares by content like any string: `==` against a
# literal inside an expression must not fall back to identity
func str_param_is [ s: string ] -> bool
    return s == 'cells'

func str_param_pick [ s: string ] -> i32
    return (s == 'cells') ? 1 : (s == 'tholin') ? 2 : 0

expect func t_string_param_eq [] -> bool
    m : map string [string] []
    m[ 'brush' ] = 'cells'
    k : m[ 'brush' ]
    return str_param_is[ k ] && str_param_pick[ k ] == 1 && str_param_pick[ 'tholin' ] == 2

# a vec handed to an IMPORTED func's raw-pointer arg crosses as its origin
expect func t_import_aref_vec [] -> bool
    v : vec u8 [ 8 ]
    rng_fill[ v, 8 ]
    return v[0] == 0 && v[3] == 21 && v[7] == 49

# a sized vec is one allocation with its elements inline; growing past
# that capacity moves them to the heap and keeps every value
expect func t_vec_inline_growth [] -> bool
    v : vec i32 [ 4 ]
    v[3] = 9
    v.push[ 5 ]
    v.push[ 6 ]
    return v.count == 6 && v[3] == 9 && v[4] == 5 && v[5] == 6

struct AgiPt
    x : i32
    y : i32

class AgiItem
    public name : string
    public n    : i32

class AgiDoc
    public pt    : AgiPt
    public items : vec AgiItem
    public note  : string
    public flag  : i32

# agi round-trip through reflection: a struct member, a vec of objects
# (keyed blocks), an unset member (empty block reads back as null)
expect func t_agi_roundtrip [] -> bool
    d : AgiDoc [ flag: 5 ]
    d.pt = AgiPt [ x: 3, y: 4 ]
    d.items = vec AgiItem []
    d.items.push[ AgiItem [ name: 'a', n: 7 ] ]
    d.items.push[ AgiItem [ name: 'b', n: 8 ] ]
    txt  : Au.string_agi[ d ]
    back : cast AgiDoc [ Au.parse_agi[ typeid[ AgiDoc ], txt.chars, null ] ]
    return back.pt.x == 3 && back.pt.y == 4 && back.items.count == 2 &&
           back.items[1].n == 8 && back.items[1].name == 'b' &&
           back.note == null && back.flag == 5

# on-demand instantiation: cpp.hpp never instantiates pairT<i64> — the
# token pre-scan requests it, and the import TU carries the instantiation
expect func t_template_ondemand [] -> bool
    p: pairT<i64> [ a: 40, b: 2 ]
    s: scaled<i64,6> [ v: 7 ]
    return p.sum[] == 42 && s.out[] == 42

# a namespaced function template resolves flat the same way; the C++
# `const T&` takes the address of a silver value. silver's own clamp[]
# builtin is untouched — only the call form is the builtin
expect func t_std_clamp [] -> bool
    lo : i32 [ 1 ]
    return std::clamp<i32>[ 7, lo, 3 ] == 3 && clamp[ 7, 1, 3 ] == 3

expect func t_cpp_objects [] -> bool
    bs: make_beast[]
    wf: make_wolf[]
    if [ bs.roar[] != 1 || wf.roar[] != 42 ] return false
    if [ bs.stride[] != 4 || wf.stride[] != 8 ] return false
    bb: Beast [ ]
    bb.Beast[ 6 ]                   # ctor imports as a method
    if [ bb.stride[] != 12 ] return false
    r2: Ratio [ ]
    r2.Ratio[ 3, 4 ]
    fv: f32 [ r2 ]                  # C++ operator float
    if [ fv != 0.75 || r2.floor_div[] != 0 ] return false
    r1: Ratio [ ]
    r1.Ratio[ 5 ]                   # overload picked by type
    if [ f32[ r1 ] != 5.0 ] return false
    rf: Ratio [ ]
    rf.Ratio[ 2.5 ]
    if [ rf.num != 250 ] return false
    rc: geo2::rect2 [ ]             # namespaced type
    rc.rect2[ 3, 5 ]
    ro: geo2::rect2 [ ]
    ro.rect2[ 1, 1 ]
    rs: rc + ro
    if [ rc.area[] != 15 || rs.area[] != 24 ] return false
    pt: geo2::inner::point2 [ ]     # nested namespace
    pt.point2[ -3, 4 ]
    return pt.manhattan[] == 7

expect func t_asm [] -> bool
    x: i64 [ 37 ]
    out: local i64 [ 1 ]
    dst: @i64 [ @out[ 0 ] ]
    asm x86_64                      # the arch name IS the switch
        mov rax, x                  # in-scope vars auto-gather
        add rax, 5
        mov qword ptr [dst], rax
    asm arm64                       # only the match compiles
        add x9, x, 5
        str x9, [dst]
    return out[ 0 ] == 42

expect func t_origin [] -> bool
    ln: i32 [ __LINE__ ]            # source position of the stmt
    fl: __FILE__
    sq: i64 [ __SEQUENCE__ ]        # the statement's sequence number
    return ln > 0 && fl != null && sq >= 0

expect func t_or_return [] -> bool
    ok: bool [ true ]
    v: ok || return false           # falsy left returns early
    return v

expect func t_expect_stmt [] -> bool
    v: i32 [ 1 ]
    expect v == 1, 'v should be one, got {v}'   # exits 1 if false
    expect b : i32 [ v + 1 ], 'b did not bind'  # binds b, then checks
    if [ false ]
        fault 'unreachable'         # unconditional abort
    return b == 2

expect func t_string_methods [] -> bool
    s: 'hello-world'
    m: s.mid[ 0, 5 ]
    ix: s.index_of[ 'world' ]
    up: s.ucase[]
    t: '  pad  '
    tr: t.trim[]
    parts: s.split[ '-' ]
    return m == 'hello' && ix == 6 && up == 'HELLO-WORLD' &&
           tr == 'pad' && s.starts_with[ 'hell' ] && s.ends_with[ 'rld' ] &&
           parts.count == 2

# pins the interp-of-an-index fix: {buf[i]} loads before formatting
expect func t_interp_index [] -> bool
    buf: local i32 [ 3 ] [ 4, 5, 6 ]
    i: i32 [ 1 ]
    s1: 'v={buf[i]}'
    items: vec i64 [] [ 7, 8 ]
    s2: 'a={items[0]} b={items[1]}'
    return s1 == 'v=5' && s2 == 'a=7 b=8'

expect func t_break_depth [] -> bool
    hits: i32 [ 0 ]
    for [ i: i32 0, i < 3, i += 1 ]
        for [ j: i32 0, j < 3, j += 1 ]
            hits += 1
            if [ j == 1 ]
                break [ 1 ]         # 0 is the inner loop; 1 leaves both
    return hits == 2

expect func t_ifdef_stmt [] -> bool
    hit: i32 [ 0 ]
    ifdef [ windows ]               # gates statements, not just imports
        hit = 1
    ifndef [ windows ]
        hit = 2
    # the platform names are also plain bool values
    anyp: bool [ linux || apple || windows ]
    return hit == 2 && anyp

expect func t_lambda_inline2 [] -> bool
    base: i64 [ 30 ]
    g: lambda [ ]                   # zero args, capture only
        return base + 1
    h: lambda [ v: i64 ] -> i64     # explicit return type
        return v * base
    return g[] == 31 && h[ 2 ] == 60

# growable vector: vec T [] — identity object stays put, elements
# ride header->data; += appends, count is the header's
expect func t_vec [] -> bool
    v: vec i64 []
    v += 3
    v += 5
    v += 8
    s: i64 [ 0 ]
    for [ x: i64 ] in v
        s += x
    return v.count == 3 && s == 16 && v[ 1 ] == 5

# quoted literals to an Au param arrive as real strings, so keys match
expect func t_map_contains [] -> bool
    m: map i64 [ string ] [ ]
    m[ 'a' ] = 5
    return m.contains[ 'a' ] && !m.contains[ 'zz' ]

# class elements ride as held pointer slots; += appends and holds
expect func t_vec_class [] -> bool
    v: vec string []
    v += 'aa'
    v += 'bb'
    joined: ''
    for [ s: string ] in v
        joined = '{joined}{s}'
    return v.count == 2 && joined == 'aabb' && v[ 1 ] == 'bb'

# second bracket seeds the made growable with values
expect func t_vec_seed [] -> bool
    v: vec i64 [] [ 3, 5, 8 ]
    s: i64 [ 0 ]
    for [ x: i64 ] in v
        s += x
    return v.count == 3 && s == 16

# float seeds through the same double-bracket form
expect func t_vec_seed_f [] -> bool
    v: vec f64 [] [ 1.5, 2.5, 4.0 ]
    s: f64 [ 0.0 ]
    for [ x: f64 ] in v
        s += x
    return v.count == 3 && s == 8.0

# class seeds take the same growable path
expect func t_vec_seed_class [] -> bool
    v: vec string [] [ 'x', 'yz' ]
    return v.count == 2 && v[ 0 ] == 'x' && v[ 1 ] == 'yz'

class VecHolder
    public tags : vec string []
    intern notes : vec string []

    func add_note [ s: string ] -> i64
        notes += s
        return notes.count

VecHolder VecSub
    intern extra : vec string []
    intern greeting : string

    func init []
        greeting = 'hi'

    func add_extra [ s: string ] -> i64
        extra += s
        return extra.count

# a member spelled `: vec T []` is a managed growable slot
expect func t_vec_member [] -> bool
    h: VecHolder [ ]
    h.tags += 'q'
    h.tags += 'rs'
    n1 : i64 [ h.add_note[ 'x' ] ]
    return h.tags.count == 2 && h.tags[ 1 ] == 'rs' && n1 == 1

class AuBag
    public bag : Au

# an Au-typed slot holding a vec binds to its vec type (fmt_file.lines);
# vec T is Au's vector class — Au.header[x] sees that class
expect func t_vec_in_au [] -> bool
    b : AuBag []
    b.bag = vec string [] [ 'q', 'rs' ]
    v : vec string b.bag
    h : Au.header[ v ]
    return v.count == 2 && v[ 1 ] == 'rs' && h.au == typeid[ vector ]

# a vector handed to a C void* parameter passes its element memory
expect func t_vec_void_ptr [] -> bool
    v : vec u8 [ 8 ]
    for [ i: i32 0, i < 8, i += 1 ]
        v[ i ] = u8[ i ]
    p : @u8 [ memchr[ v, 5, 8 ] ]
    return p == @v[ 5 ] && p[ 0 ] == 5

# a vec member through a ternary is the member's object, not its slot
expect func t_vec_ternary [] -> bool
    h: VecHolder [ ]
    h.tags += 'q'
    h.tags += 'rs'
    t : vec string (h) ? h.tags : null
    n : vec string (!h) ? h.tags : null
    return t && t.count == 2 && t[ 1 ] == 'rs' && !n

# intern vec defaults must run through the inheritance chain
expect func t_vec_sub [] -> bool
    h: VecSub [ ]
    n1 : i64 [ h.add_extra[ 'a' ] ]
    n2 : i64 [ h.add_note[ 'b' ] ]
    return n1 == 1 && n2 == 1

# vec T in type position: args and returns carry vectors
func vec_double [ v: vec i64 ] -> vec i64
    r : vec i64 []
    for [ x: i64 ] in v
        r += x * 2
    return r

expect func t_vec_type_pos [] -> bool
    src : vec i64 [] [ 1, 2, 3 ]
    d : vec_double[ src ]
    return d.count == 3 && d[ 2 ] == 6

# the vec op surface: find, remove, reverse, ends, pop, concat, clear
expect func t_vec_ops [] -> bool
    v : vec i64 [] [ 3, 5, 8 ]
    ok1 : bool [ v.index_of[ 5 ] == 1 && v.contains[ 8 ] && !v.contains[ 99 ] ]
    v.remove[ 0 ]                  # 5 8
    v = v.reverse[]                # 8 5 — reverse returns a NEW vector
    ok2 : bool [ v.first[] == 8 && v.last[] == 5 ]
    p : i64 [ v.pop[] ]            # takes 5; count 1
    w : vec i64 [] [ 9 ]
    v.concat[ w ]                  # 8 9
    ok3 : bool [ v.count == 2 && v.last[] == 9 ]
    v.clear[]
    return ok1 && ok2 && ok3 && p == 5 && v.count == 0

# class elements find via compare; remove drops the held ref
expect func t_vec_ops_class [] -> bool
    v : vec string [] [ 'aa', 'bb', 'cc' ]
    i1 : i64 [ v.index_of[ 'bb' ] ]
    v.remove[ 1 ]
    return i1 == 1 && v.count == 2 && v.last[] == 'cc'

class VecProps
    public names : vec string

# prop-pair list literal seeds a vec member; [] makes it empty
expect func t_vec_prop_init [] -> bool
    h : VecProps [ names: [ 'x', 'yz' ] ]
    e : VecProps [ names: [] ]
    return h.names.count == 2 && h.names[ 1 ] == 'yz' && e.names && e.names.count == 0

# struct elements pack by value into the vector
expect func t_vec_struct [] -> bool
    v : vec v2 []
    p : v2 [ x: 3.0, y: 4.0 ]
    v.push[ p ]
    v += v2 [ x: 5.0, y: 6.0 ]
    return v.count == 2 && v[0].x == 3.0 && v[1].y == 6.0

# moduleid: the module's runtime Au_t — bare name resolves at design
# time, a string expression looks up at runtime
expect func t_moduleid [] -> bool
    m1 : moduleid[ features ]
    nm : 'features'
    m2 : moduleid[ nm ]
    return m1 && m2 && m1 == m2

# class seeds from variables load the object, not the alloca
expect func t_vec_seed_var [] -> bool
    s1 : string 'aa'
    s2 : string 'bb'
    v  : vec string [] [ s1, s2 ]
    v2 : vec string []
    v2.push[ s1 ]
    return v.count == 2 && v[ 0 ] == 'aa' && v2.first[] == 'aa'

# shift takes the front (ownership transfers); unshift inserts before it
expect func t_vec_shift [] -> bool
    v : vec i64 [] [ 3, 5, 8 ]
    f : i64 [ v.shift[] ]          # 3; v = 5 8
    v.unshift[ 1 ]                 # 1 5 8
    s : vec string [] [ 'bb' ]
    s.unshift[ 'aa' ]
    t : s.shift[]
    return f == 3 && v.count == 3 && v.first[] == 1 && v.last[] == 8 &&
           t == 'aa' && s.count == 1 && s[ 0 ] == 'bb'

class BufLike
    public data : handle

# a raw @T view over a handle indexes WITHOUT any vec header hop
expect func t_ref_from_handle [] -> bool
    raw : vec f32 [ 4 ]
    b : BufLike [ ]
    b.data = raw
    p : @f32 [ b.data ]
    p[0] = 1.5
    p[1] = 2.5
    return raw[0] == 1.5 && raw[1] == 2.5

class RawSlot
    public out : @u32

# a vec assigned into a raw @T slot (member or local) hands over its origin
expect func t_ref_slot_from_vec [] -> bool
    v : vec u32 [ 8 ]
    r : RawSlot [ ]
    r.out = v
    r.out[3] = 7
    p : @u32
    p = v
    p[5] = 9
    return v[3] == 7 && v[5] == 9

class LineLike
    public content : string
    public line    : i32

# a class-element borrow binds the OBJECT pointer, not the slot base
expect func t_vec_borrow [] -> bool
    v : vec LineLike []
    v.push[ LineLike [ content: 'aa', line: 1 ] ]
    v.push[ LineLike [ content: 'bb', line: 2 ] ]
    k : i32 [ 0 ]
    total : i32 [ 0 ]
    while [ k < v.count ]
        cl : v[k]
        c9 : cl.content
        total += cl.line
        if [ c9 == 'bb' ] total += 10
        k += 1
    w : vec LineLike []
    w.push[ v[0] ]
    w.push[ v[1] ]
    m9 : w[0]
    return total == 13 && m9.line == 1 && w[1].content == 'bb'

# a null vec iterates zero times
expect func t_vec_for_null [] -> bool
    v : vec i64
    n : i64 [ 0 ]
    for [ x: i64 ] in v
        n += 1
    return n == 0 && !v

# bare vec T is a null slot; [] makes it — the numpy split
expect func t_vec_null [] -> bool
    v: vec string
    was_null : bool [ !v ]
    v = vec string []
    v += 'a'
    return was_null && v.count == 1

# insert opens a slot at the index; later elements shift up
expect func t_vec_insert [] -> bool
    v : vec i64 [] [ 1, 3 ]
    v.insert[ 2, 1 ]
    v.insert[ 0, 0 ]
    return v.count == 4 && v[0] == 0 && v[1] == 1 && v[2] == 2 && v[3] == 3

# element assignment writes the SLOT, never through the old object
expect func t_vec_set_elem [] -> bool
    v : vec string [] [ 'aa', 'bb' ]
    old : v[1]
    old.hold[]                      # a bare borrow dies with the slot
    v[1] = 'cc'
    w : vec i64 [] [ 1, 2 ]
    w[0] = 9
    ok : bool [ v[1] == 'cc' && v[0] == 'aa' && old == 'bb' && w[0] == 9 && w[1] == 2 ]
    old.drop[]
    return ok

# class elements insert held; a borrowed element works as the arg
expect func t_vec_insert_class [] -> bool
    src : vec string [] [ 'bb', 'cc' ]
    v   : vec string []
    v.insert[ src[0], 0 ]
    v.insert[ 'aa', 0 ]
    v.insert[ src[1], 2 ]
    return v.count == 3 && v[0] == 'aa' && v[1] == 'bb' && v[2] == 'cc' &&
           v[2].compare[ v[0] ] > 0

class AsyncJob
    public x   : i64
    public out : i64

class AsyncHost
    public tag : i64

# :: opens contextual args — bound at the lambda instance site
func run_job [ arg: object :: h: AsyncHost ]
    j : AsyncJob [ arg ]
    j.out = j.x * 2 + h.tag

# async fans work items out to threads; work_fn is a lambda and
# sync[ null ] joins them
expect func t_async [] -> bool
    h : AsyncHost [ tag: 100 ]
    j1 : AsyncJob [ x: 3 ]
    j2 : AsyncJob [ x: 5 ]
    j3 : AsyncJob [ x: 8 ]
    jobs : vec Au []
    jobs.push[ j1 ]
    jobs.push[ j2 ]
    jobs.push[ j3 ]
    t : async [ work_fn: lambda run_job[ h ], work: jobs ]
    t.sync[ null ]
    return j1.out == 106 && j2.out == 110 && j3.out == 116

# an inline lambda works too — captures ride its context, and a
# captured OBJECT's members read through it on the worker thread
expect func t_async_inline [] -> bool
    base : i64 [ 7 ]
    h : AsyncHost [ tag: 1000 ]
    j1 : AsyncJob [ x: 3 ]
    j2 : AsyncJob [ x: 5 ]
    w : vec Au []
    w.push[ j1 ]
    w.push[ j2 ]
    f : lambda [ arg: object ]
        j : AsyncJob [ arg ]
        j.out = j.x * 10 + base + h.tag
    t : async [ work_fn: f, work: w ]
    t.sync[ null ]
    expect j1.out == 1037, 'j1.out = {j1.out}'
    expect j2.out == 1057, 'j2.out = {j2.out}'
    return true



expect func t_literals [] -> bool
    b:  i64 [ 0b1010 ]              # binary
    o:  i64 [ 0o17 ]                # octal
    hf: f64 [ 0x1.8p1 ]             # hex float: 1.5 * 2 = 3.0
    fs: f32 [ 3.5f ]                # C float suffix
    c:  unichar [ 'a' ]             # one char in quotes is a unichar
    nl: unichar [ '\n' ]
    hx: unichar [ '\x41' ]          # 'A'
    return b == 10 && o == 15 && hf == 3.0 && fs == 3.5 && c == 97 && nl == 10 && hx == 65

expect func t_string_escapes [] -> bool
    br: 'a {{b}} c'                 # doubled braces are literal braces
    m: map string [ string ] [ ]
    m[ 'k' ] = 'v'
    q: 'x={m['k']}'                 # quotes inside an interpolation
    esc: 'one\ntwo'                 # backslash escapes
    return br == 'a {{b}} c' && br.count == 7 && q == 'x=v' && esc.count == 7

expect func t_precedence [] -> bool
    a: i64 [ 12 ]
    b: i64 [ 10 ]
    r1: i64 [ 2 + 3 * 4 ]           # * before +
    r2: i64 [ 1 << 2 + 1 ]          # + before <<
    r3: i64 [ a | b == 14 ]         # == before | : 12 | 0
    r4: bool [ a > 5 && b > 5 ]     # compare before &&
    return r1 == 14 && r2 == 8 && r3 == 12 && r4

expect func t_ranges [] -> bool
    x: i32 [ 5 ]
    rex: bool [ x == (2 ..< 6) ]    # end-exclusive, positive form
    rni: bool [ x != (7 ... 9) ]    # negated inclusive
    pr:  bool [ x == (4 + 1) ]      # plain parenthesized right side
    c: Color.green
    e:  bool [ c == green ]         # bare enum name on the right
    return rex && rni && pr && e

expect func t_is_value [] -> bool
    s: 'hi'
    a: object [ s ]                 # object is the Au base
    v: string (a is string)         # is as a value: the object, or null
    n: string (a is Counter)
    t: bool [ a is typeid[ s ] ]    # right side may be a runtime type
    return v == 'hi' && !n && t

expect func t_expr_chain [] -> bool
    a1: v2 [ x: 1.0, y: 2.0 ]
    b1: v2 [ x: 3.0, y: 4.0 ]
    sx: (a1 + b1).x                 # (expr).member
    v: vec i64 [] [ 1, 2, 3 ]
    n: [ v ].count                  # [expr].member
    expect sx == 4.0, 'sx = {sx}'
    expect n == 3, 'n = {n}'
    return true

expect func t_asm_expr [] -> bool
    x: i64 [ 40 ]
    r: i64 [ 0 ]
    ifdef [ x86_64 ]
        r = i64 asm [ x ]           # explicit inputs; return names the register
            mov rax, x
            add rax, 2
            return rax
    ifdef [ arm64 ]
        r = i64 asm [ x ]
            add x9, x, 2
            return x9
    return r == 42

expect func t_keyword_tokens [] -> bool
    t: tokens { l0 t0 r0 b0 }       # bare words become a tokens object
    s: string { color red }         # or a string, joined by spaces
    return t.count == 4 && s == 'color red'

expect func t_memop_bare [] -> bool
    src: local i32 [ 2 ] [ 1, 2 ]
    dst: local i32 [ 2 ]
    memcpy @dst[ 0 ], @src[ 0 ], 8  # bracketless statement form
    return dst[ 1 ] == 2

expect func t_arch_bools [] -> bool
    return x86_64 || arm64          # arch names are bool values too

expect func t_misc_expr [] -> bool
    f: __builtin_frame_address[ 0 ]
    n: i64 [ 5 ]
    sz: i64 [ sizeof[ n ] ]         # sizeof on an expression
    h: half [ 1.5 ]                 # half is bf16
    hf: f32 [ h ]
    ul: unsigned long [ 7 ]         # C spellings read as types
    s65: string [ 65 ]              # a number to a string is its digits
    ch:  string [ 'A' ]             # a unichar to a string is the char
    a1: v2 [ x: 0.0, y: 0.0 ]
    b1: v2 [ x: 2.0, y: 4.0 ]
    mx: mix[ a1, b1, 0.5 ]          # mix on a struct
    expect f != null, 'frame address null'
    expect sz == 8, 'sizeof expr = {sz}'
    expect hf == 1.5, 'half = {hf}'
    expect ul == 7, 'unsigned long = {ul}'
    expect s65 == '65' && ch == 'A', 's65 = {s65} ch = {ch}'
    expect mx.x == 1.0 && mx.y == 2.0, 'mix = {mx.x} {mx.y}'
    return true

expect func t_prop_shorthand [] -> bool
    x: f32 [ 1.0 ]
    y: f32 [ 2.0 ]
    p: v2 [ :x, :y ]                # :name binds the local of that name
    return p.x == 1.0 && p.y == 2.0


class Owner
    public name : string

class Widget
    context owner : Owner           # injected by type; read-only; not held
    manual  peer  : Widget          # a plain slot: never held or dropped
    public  held  : Widget          # a public slot holds
    unmanaged raw : Widget          # unmanaged: same as manual
    default rom   : path            # the bare command-line arg lands here
    public  depth : i32
    public  refp  : @i32            # a pointer member

    static func make [ d: i32 ] -> Widget
        return Widget [ depth: d ]

    construct [ s: string ]
        depth = s.count

    construct [ n: i64 ]
        construct [ 'n-{n}' ]       # chain to the string constructor

expect func t_member_attribs [] -> bool
    o: Owner [ name: 'own' ]
    w: Widget [ ]
    w.set_context_from[ o ]         # context members bind by type
    p: Widget [ ]
    r0: i32 [ Au.header[ p ].refs ]
    w.peer = p                      # manual: refs unchanged
    r1: i32 [ Au.header[ p ].refs ]
    w.held = p                      # public: refs go up by one
    r2: i32 [ Au.header[ p ].refs ]
    w.raw = p
    r3: i32 [ Au.header[ p ].refs ]
    n: i32 [ 5 ]
    w.refp = @ n
    m: Widget.make[ 3 ]             # static func through the type name
    c: Widget [ 7 ]                 # chained construct: 'n-7' has 3 chars
    return w.owner == o && r1 == r0 && r2 == r0 + 1 && r3 == r2 && w.refp[ 0 ] == 5 && m.depth == 3 && c.depth == 3

class AttribHost
    attrib egg : Chirper [ tone: 3 ]    # a static object built at load

class MemberMeta

class MemberMetaHost
    public [ MemberMeta ] value : i32
    # an annotated intern registers too: the meta is its whole reason
    intern [ MemberMeta ] hidden_v : i32

    public [ MemberMeta ] func marked [] -> none
        no-op

struct MemberMetaStruct
    [ MemberMeta ] value : i32

    [ MemberMeta ] func marked [] -> none
        no-op

expect func t_member_meta [] -> bool
    ct: Au_t [ typeid[ MemberMetaHost ] ]
    st: Au_t [ typeid[ MemberMetaStruct ] ]
    cf: Au.find_member[ ct, 'value', AU_MEMBER_VAR, 0, false ]
    hf: Au.find_member[ ct, 'hidden_v', AU_MEMBER_VAR, 0, false ]
    cm: Au.find_member[ ct, 'marked', AU_MEMBER_FUNC, 0, false ]
    sf: Au.find_member[ st, 'value', AU_MEMBER_VAR, 0, false ]
    sm: Au.find_member[ st, 'marked', AU_MEMBER_FUNC, 0, false ]
    return cf.meta.m == typeid[ MemberMeta ] &&
           cm.meta.m == typeid[ MemberMeta ] &&
           sf.meta.m == typeid[ MemberMeta ] &&
           sm.meta.m == typeid[ MemberMeta ] &&
           hf != null && hf.meta.m == typeid[ MemberMeta ]

# attrib is declaration-time metadata: trinity reads shader bindings this way
expect func t_attrib [] -> bool
    found: i32 [ 0 ]
    tone:  i32 [ 0 ]
    t: Au_t [ typeid[ AttribHost ] ]
    for [ mem: Au_t ] in t.members
        if [ mem.traits & (1 << 56) ]   # AU_TRAIT_IS_ATTRIB
            found += 1
            val: Au [ mem.value ]
            c: Chirper [ val ]
            tone = c.tone
    return found == 1 && tone == 3

# silver.c publishes the Au member-kind enum as constants.
expect func t_member_kind_constants [] -> bool
    return AU_MEMBER_NONE == 0 && AU_MEMBER_MODULE == 1 &&
           AU_MEMBER_TYPE == 2 && AU_MEMBER_CONSTRUCT == 3 &&
           AU_MEMBER_VAR == 4 && AU_MEMBER_FUNC == 5 &&
           AU_MEMBER_OPERATOR == 6 && AU_MEMBER_CAST == 7 &&
           AU_MEMBER_GETTER == 8 && AU_MEMBER_SETTER == 9 &&
           AU_MEMBER_ENUMV == 10 && AU_MEMBER_OVERRIDE == 11 &&
           AU_MEMBER_NAMESPACE == 12 && AU_MEMBER_DECL == 13 &&
           AU_MEMBER_MACRO == 14

