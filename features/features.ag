    n: snprintf[ @buf[ 0 ], 32, "%d-%s", 7, "x" ]   # C varargs
    s: string [ @buf[ 0 ] ]
    up: toupper[ 97 ]               # from <ctype.h>
    big: i32 [ INT_MAX ]            # an object-like macro
    return n == 3 && s == '7-x' && up == 65 && big == 2147483647

expect func t_ifdef_chain [] -> bool
