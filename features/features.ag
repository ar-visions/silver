    return h.v == 4

alias iptr : @i32                   # alias to a pointer type

expect func t_alias_ptr [] -> bool
    n: i32 [ 9 ]
    p: iptr [ @ n ]
    return p[ 0 ] == 9

class Grid
    public cells : vec i64 [ 6 ]
    getter [ s: shape ] -> i64      # shape getter: g[ i, j ] arrives as one
        return cells[ s[ 0 ] * 3 + s[ 1 ] ]

expect func t_getter_2d [] -> bool
    g: Grid [ ]
    g.cells[ 4 ] = 44
    return g[ 1, 1 ] == 44

func words [] -> string { alpha beta }  # a { } body is raw tokens joined

expect func t_raw_body [] -> bool
    return words[] == 'alpha beta'

# struct literals from every value source: a field carries the VALUE,
# never the address it was read from
struct Mat3
    m : local f32 [ 9 ]

struct Pt3
    x : f32
    y : f32
    z : f32

struct RawView
    data  : @u8
    count : i32
    first : u8
    flag  : bool
    wide  : i64

class PtHost
    public px : i32
    public py : i32
    public m  : Mat3

func pt_sub [ a: Pt3, b: Pt3 ] -> Pt3
    return Pt3 [ a.x - b.x, a.y - b.y, a.z - b.z ]

func pt_len [ a: Pt3 ] -> f32
    return sqrt[ a.x * a.x + a.y * a.y + a.z * a.z ]

func pt_of [ mat: Mat3 ] -> Pt3
    return Pt3 [ mat.m[ 0 ], mat.m[ 1 ], mat.m[ 2 ] ]

expect func t_struct_from_array_member [] -> bool
    mat: Mat3 [ ]
    mat.m[ 0 ] = 1.0
    mat.m[ 1 ] = 2.0
    mat.m[ 2 ] = 3.0
    mat.m[ 3 ] = 3.0
    mat.m[ 4 ] = 4.0
    mat.m[ 5 ] = 12.0
    p: Pt3 [ mat.m[ 3 ], mat.m[ 4 ], mat.m[ 5 ] ]            # positional
    q: Pt3 [ x: mat.m[ 5 ], y: mat.m[ 4 ], z: mat.m[ 3 ] ]   # named
    r: pt_of[ mat ]                                         # through a struct param
    return p.x == 3.0 && p.y == 4.0 && p.z == 12.0 && q.x == 12.0 && q.z == 3.0 && r.y == 2.0

expect func t_struct_from_local_array [] -> bool
    loc: local f32 [ 3 ] [ 1.5, 2.5, 3.5 ]
    i: i32 [ 2 ]
    p: Pt3 [ loc[ 0 ], loc[ 1 ], loc[ i ] ]                # constant and runtime index
    return p.x == 1.5 && p.y == 2.5 && p.z == 3.5

expect func t_struct_from_vec [] -> bool
    v: vec f32 [ 3 ]
    v[ 0 ] = 6.0
    v[ 1 ] = 7.0
    v[ 2 ] = 8.0
    p: Pt3 [ v[ 0 ], v[ 1 ], v[ 2 ] ]
    return p.x == 6.0 && p.y == 7.0 && p.z == 8.0

expect func t_struct_from_pointer [] -> bool
    buf: local u8 [ 4 ] [ 10, 20, 30, 40 ]
    p: @buf[ 0 ]
    nil_p: @u8 [ null ]
    a: RawView [ data: p, count: 4, first: p[ 2 ], flag: true, wide: 5 ]
    b: RawView [ data: nil_p, count: 0, first: 0, flag: false, wide: 0 ]   # a null pointer field is stored, never read through
    expect a.data && memcmp[ a.data, p, 4 ] == 0, 'data pointer'
    expect a.first == 30, 'first = {a.first}'
    expect a.count == 4, 'count = {a.count}'
    expect a.flag, 'flag'
    expect a.wide == 5, 'wide = {a.wide}'
    expect !b.data, 'null data'
    expect b.first == 0, 'null first = {b.first}'
    return true

expect func t_struct_from_class_member [] -> bool
    h: PtHost [ px: 3, py: 4 ]
    h.m.m[ 0 ] = 9.0
    h.m.m[ 8 ] = 2.0
    p: Pt3 [ x: f32[ h.px ], y: f32[ h.py ], z: h.m.m[ 0 ] ]  # members through the object pointer
    q: Pt3 [ h.m.m[ 8 ], h.m.m[ 0 ], h.m.m[ 8 ] ]
    return p.x == 3.0 && p.y == 4.0 && p.z == 9.0 && q.x == 2.0 && q.y == 9.0

expect func t_struct_from_struct_field [] -> bool
    a: Pt3 [ 1.0, 2.0, 3.0 ]
    b: Pt3 [ a.z, a.y, a.x ]                               # fields of another struct
    c: Pt3 [ a.x + b.x, a.y * 2.0, pt_len[ a ] ]           # expressions and a call
    return b.x == 3.0 && b.z == 1.0 && c.x == 4.0 && c.y == 4.0 && c.z > 3.74 && c.z < 3.75

expect func t_struct_nested_return [] -> bool
    a: Pt3 [ 3.0, 0.0, 4.0 ]
    b: Pt3 [ 0.0, 0.0, 0.0 ]
    step: pt_sub[ a, b ]
    l1: f32 [ pt_len[ step ] ]
    l2: f32 [ pt_len[ pt_sub[ a, b ] ] ]                   # by-value result straight into a call
    return l1 == 5.0 && l2 == 5.0

expect func t_c_typedef_file [] -> bool
    fp: @FILE [ fopen[ '/tmp/features-file.bin', 'wb' ] ]   # FILE is a C typedef; a record from C has no Au header
    n:  i32 [ 42 ]
    fwrite[ @n, 4, 1, fp ]
    fclose[ fp ]
    fp2: @FILE [ fopen[ '/tmp/features-file.bin', 'rb' ] ]
    m: i32
    r: i64 [ fread[ @m, 4, 1, fp2 ] ]
    fclose[ fp2 ]
    return r == 1 && m == 42

expect func t_bare_method_call [] -> bool
    c: Counter [ count: 1 ]
    c.inc                           # no brackets: a method without arguments is called
    c.inc
    return c.count == 3

expect func t_vec_module [] -> bool
    a: vec2f [ 1.0, 2.0 ]           # an Au struct: fields from its record, returned by value in the C ABI
    b: vec2f [ 3.0, 4.0 ]
    c: vec2f [ a.add[ b ] ]         # a struct method from the record; the result comes back by value
    return c.x == 4.0 && c.y == 6.0 && a.dot[ b ] == 11.0

expect func t_switch_string [] -> bool
    s: string [ 'two' ]
    r: i32 [ 0 ]
    switch [ s ]                    # a non-primitive subject compares case by case
        case 'one'
            r = 1
        case 'two', 'three'
            r = 2
        default
            r = 3
    return r == 2

class Box
    public w : i32
    public h : i32
    intern static on_make : hook    # Au (*)(Au)
    intern static made    : i32

    static func bump []             # a static func sees the statics only
        made += 1

    func init []
        bump[]

    func count [] -> i32
        return made

    func refs [] -> i32
        info : header[ a ]          # the Au header behind self; a names self
        return info.refs

    func checked [] -> bool
        caught : bool [ false ]
        try
            check w > 100, 'small' # Au's check raises when false
        catch [ message: string ]
            caught = message == 'small'
        return caught

class Filled                        # init has no body here: s2test.cc defines Filled_init
    public n : i32
    func init []

func accumulate [ acc: @i32, x: i32, y: i32 ]
    acc[ 0 ] = acc[ 0 ] + x + y

expect func t_prop_block [] -> bool
    w : i32 [ 3 ]
    h : i32 [ 4 ]
    b : Box                         # a prop block: name: value with commas, :name shorthand
        w: w,
        :h
    return b.w == 3 && b.h == 4

expect func t_arg_block [] -> bool
    acc : local i32 [ 1 ]
    acc[ 0 ] = 0
    accumulate                      # arguments as an indented block
        @acc[ 0 ], 1,
        2
    return acc[ 0 ] == 3

expect func t_sizeof_bare [] -> bool
    return sizeof i32 == 4 && sizeof [ i64 ] == 8

expect func t_check [] -> bool
    b : Box [ w: 1 ]
    return b.checked[]

expect func t_self_a_header [] -> bool
    b : Box [ w: 1 ]
    b.hold[]
    return b.refs[] >= 1 && b.count[] >= 1

expect func t_au_root_method [] -> bool
    b : Box [ w: 2, h: 5 ]
    c : Box [ b.copy[] ]            # Au's own copy, reached through any class
    return c.w == 2 && c.h == 5

expect func t_companion_method [] -> bool
    f : Filled [ ]
    return f.n == 7

expect func t_c_macros [] -> bool
    return twice[ 21 ] == 42 && string [ MACRO_NAME ] == 'macro'

expect func t_cstr_literal_eq [] -> bool
    s : string [ 'png' ]
    return s == "png" && s != "jpg"

expect func t_git_import [] -> bool
    v : string [ zlibVersion[] ]
    return v.count > 0

expect func t_au_types [] -> bool
    n : sz [ 3 ]
    return n + 4 == 7

expect func t_autotools_import [] -> bool
    ctx : uev_ctx_t [ ]
    rc  : uev_init[ ctx ]
    uev_exit[ ctx ]
    return rc == 0

expect func t_meson_import [] -> bool
    return fribidi_get_bidi_type[ 1488 ] == FRIBIDI_TYPE_RTL   # alef reads right to left

expect func t_type_macros [] -> bool
    n : cpp_int [ 5 ]               # a C macro naming a type reads as that type
    p : cpp_intp [ @n ]
    return p[ 0 ] == 5 && sizeof cpp_int == 4 && cpp_max[ 3, 9 ] == 9

expect func t_extension_interns [] -> bool
    return ext_adds[] == 42 && rng_extension_intern[] == 1   # each extension sees its module's interns

expect func t_extension_class [] -> bool
    rng_seed[ 7 ]
    d: Dice [ sides: 6 ]            # a class RandomExtra adds to random
    r: d.roll[]
    return r >= 1 && r <= 6

app features
    func init []
        puts 'features module — run with silver --test features'
