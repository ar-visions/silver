extend features
# hash: 5fef23f23bce3873
func gen_nth_prime [ n: i32 ] -> i64
    if [ n < 1 ]
        return 0
    primes : vec i64 []
    c : i64 [ 2 ]
    while [ primes.count < n ]
        prime : bool [ true ]
        for [ i: i32 0, i < primes.count, i += 1 ]
            p : i64 [ primes[ i ] ]
            if [ p * p > c ]
                break
            if [ c % p == 0 ]
                prime = false
                break
        if [ prime ]
            primes.push[ c ]
        c += 1
    return c - 1
