export 0.1.0

import vec
import img
import trinity
import <stdlib.h>
import <sys/wait.h>

# a shell in a window: trinity's Console on its own
element console : trinity
    public  width      : i32    [ 960 ]
    public  height     : i32    [ 600 ]
    public  title      : string [ 'console' ]
    # the folder the shell starts in; empty: where it was launched
    public  [ Launch ] folder : string
    # orbiter's Wayland display: a window the program opens goes there
    public  [ Launch ] wayland : string
    # a fontconfig file for its programs (orbiter's lettering)
    public  [ Launch ] fonts : string
    # the program to run; empty: an interactive shell
    default [ Launch ] run : string
    intern  sessions   : map ConsoleSession [string]

    func render [] -> Elements
        if [ !sessions ]
            sessions = map ConsoleSession [string] []
            # the program's own environment: it finds the display here
            if [ wayland && wayland.count > 0 ]
                setenv[ 'WAYLAND_DISPLAY', wayland.chars, 1 ]
            if [ fonts && fonts.count > 0 ]
                setenv[ 'FONTCONFIG_FILE', fonts.chars, 1 ]
        at : (folder && folder.count > 0) ? folder
            : '{path.path_startup[]}'
        cmd : (run) ? run : ''
        return Elements [
            'shell' : Console [ session_id: 'shell', sessions: sessions,
                titles: true,
                cwd: at, launch: cmd, area: Region { l0 t0 r0 b0 } ] ]

    # a program run here ends the console with it (no empty shell)
    public func on_frame [ w: Window ]
        if [ !run || run.count == 0 || !sessions ] return
        s : ConsoleSession sessions.get[ 'shell' ]
        if [ !s || s.pid <= 0 ] return
        st : i32 [ 0 ]
        if [ waitpid[ s.pid, @st, WNOHANG ] == s.pid ]
            Au.quit_request[]
