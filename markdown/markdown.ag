# markdown — a canvas renderer for .md files, hosted by orbiter
export 1.0.0
export extensions ['.md': FileType.ascii]

import vec
import img
import trinity
import <stdio.h>
import <string.h>
import <stdlib.h>

# one styled run inside a block, produced by the inline parser
class MdSpan
    public text : string
    public bold : bool
    public ital : bool
    public code : bool
    public link : bool

# one source block; layout wraps it against the live width at draw
class MdBlock
    public kind  : i32           # 0 para 1..6 heading 7 code 8 bullet 9 numbered 10 quote 11 hr
    public text  : string
    public depth : i32           # list nesting, from leading spaces
    public num   : i32           # ordered-list number

# one laid-out paint op; positions are local to the content box
class MdItem
    public kind  : i32           # 0 text 1 rect 2 rounded rect
    public x     : f32
    public y     : f32
    public w     : f32
    public h     : f32
    public r     : f32
    public fs    : i32
    public text  : string
    public color : string
    public bold  : bool
    public clip  : bool

# one laid-out block: its items are local, its tile is painted once
class MdRow
    public y     : f32
    public h     : f32
    public hash  : i64
    public items : vec MdItem

# a painted block, reused across frames by content hash
class MdTile
    mutable canvas : Canvas
    mutable hash   : i64 [ -1 ]
    mutable frame  : i32 [ -1 ]

element markdown : trinity
    public width   : i32 [ 980 ]
    public height  : i32 [ 1180 ]
    public title   : string [ 'markdown' ]
    default src    : path
    mutable blocks    : vec MdBlock
    mutable rows       : vec MdRow
    mutable tiles      : vec MdTile
    mutable tile_frame : i32
    mutable laid_w     : f32
    mutable laid_h     : f32
    mutable src_mt    : i64
    mutable src_watch : watch
    # fires on the watcher thread: dirty the ELEMENT (draw is gated on
    # pristine) and wake the window; draw's mtime check does the rest
    func on_src_change [ changed: Au :: t: markdown ] -> none
        t.pristine = false
        if [ t.ux ] t.ux.will_animate = true

    func init []
        if [ src ] title = '{src.filename[]}'
        if [ src && src.exists[] ]
            # watch the DIRECTORY: editors replace files by rename,
            # which silently ends a watch held on the file's inode
            src_watch = watch [ res: src.parent_dir[], callback: lambda on_src_change[ a ] ]
            src_watch.start[]

    # ---- block parse: one pass over the lines ----

    func flush_para [ para: string ]
        if [ para.count > 0 ]
            blocks.push[ MdBlock [ kind: 0, text: para ] ]

    func parse_doc []
        blocks = vec MdBlock []
        if [ !src || !src.exists[] ] return
        text : cast string [ src.load[ typeid[ string ], null ] ]
        if [ !text ] return
        lines : text.split[ '\n' ]
        para    : string ''
        quote   : string ''
        code    : string ''
        in_code : bool [ false ]
        for [ i: i32 0, i < i32[ lines.count ], i += 1 ]
            raw : string lines[ i ]
            t   : string raw.trim[]
            tn  : i32 [ i32 t.count ]
            if [ in_code ]
                if [ t.starts_with[ '```' ] ]
                    blocks.push[ MdBlock [ kind: 7, text: code ] ]
                    code    = ''
                    in_code = false
                el
                    code = (code.count > 0) ? '{code}\n{raw}' : raw
                continue
            # a quote run ends on the first non-quote line
            if [ quote.count > 0 && !t.starts_with[ '>' ] ]
                blocks.push[ MdBlock [ kind: 10, text: quote ] ]
                quote = ''
            if [ t.starts_with[ '```' ] ]
                flush_para[ para ]
                para    = ''
                in_code = true
                continue
            if [ tn == 0 ]
                flush_para[ para ]
                para = ''
                continue
            # heading: 1..6 hashes then a space
            if [ t.chars[0] == '#' ]
                h : i32 [ 0 ]
                while [ h < tn && h < 6 && t.chars[h] == '#' ]
                    h += 1
                if [ h < tn && t.chars[h] == ' ' ]
                    flush_para[ para ]
                    para = ''
                    blocks.push[ MdBlock [ kind: h, text: t.mid[ h + 1, tn - h - 1 ] ] ]
                    continue
            # horizontal rule: --- or *** (3 or more)
            if [ tn >= 3 && (t.chars[0] == '-' || t.chars[0] == '*') ]
                same : bool [ true ]
                for [ k: i32 1, k < tn, k += 1 ]
                    if [ t.chars[k] != t.chars[0] ] same = false
                if [ same ]
                    flush_para[ para ]
                    para = ''
                    blocks.push[ MdBlock [ kind: 11, text: '' ] ]
                    continue
            # blockquote lines accumulate into one block
            if [ t.chars[0] == '>' ]
                flush_para[ para ]
                para = ''
                q : string [ (tn > 1 && t.chars[1] == ' ') ? t.mid[ 2, tn - 2 ] : t.mid[ 1, tn - 1 ] ]
                quote = (quote.count > 0) ? '{quote} {q}' : q
                continue
            # list depth from the raw line's leading spaces
            sp : i32 [ 0 ]
            rn : i32 [ i32 raw.count ]
            while [ sp < rn && raw.chars[sp] == ' ' ]
                sp += 1
            # bullet: - * + then a space
            if [ tn > 1 && (t.chars[0] == '-' || t.chars[0] == '*' || t.chars[0] == '+') && t.chars[1] == ' ' ]
                flush_para[ para ]
                para = ''
                blocks.push[ MdBlock [ kind: 8, text: t.mid[ 2, tn - 2 ], depth: sp / 2 ] ]
                continue
            # numbered: digits then '. '
            dg : i32 [ 0 ]
            while [ dg < tn && t.chars[dg] >= '0' && t.chars[dg] <= '9' ]
                dg += 1
            if [ dg > 0 && dg + 1 < tn && t.chars[dg] == '.' && t.chars[dg + 1] == ' ' ]
                flush_para[ para ]
                para = ''
                nv : i32 [ i32[ t.mid[ 0, dg ].integer_value[] ] ]
                blocks.push[ MdBlock [ kind: 9, text: t.mid[ dg + 2, tn - dg - 2 ], depth: sp / 2, num: nv ] ]
                continue
            # plain text joins the open paragraph
            para = (para.count > 0) ? '{para} {t}' : t
        flush_para[ para ]
        if [ quote.count > 0 ]  blocks.push[ MdBlock [ kind: 10, text: quote ] ]
        if [ in_code && code.count > 0 ] blocks.push[ MdBlock [ kind: 7, text: code ] ]

    # ---- inline parse: ** * ` [label](url) into styled spans ----

    func spans_of [ s: string ] -> vec MdSpan
        out : vec MdSpan []
        n   : i32 [ i32 s.count ]
        i   : i32 [ 0 ]
        seg : i32 [ 0 ]
        bold : bool [ false ]
        ital : bool [ false ]
        codef : bool [ false ]
        while [ i < n ]
            c : i32 [ s.chars[i] ]
            if [ c == '`' ]
                if [ i > seg ] out.push[ MdSpan [ text: s.mid[ seg, i - seg ], bold: bold, ital: ital, code: codef ] ]
                codef = !codef
                i   += 1
                seg  = i
                continue
            if [ !codef && c == '*' ]
                two : bool [ i + 1 < n && s.chars[i + 1] == '*' ]
                if [ i > seg ] out.push[ MdSpan [ text: s.mid[ seg, i - seg ], bold: bold, ital: ital ] ]
                if [ two ]
                    bold = !bold
                    i += 2
                el
                    ital = !ital
                    i += 1
                seg = i
                continue
            if [ !codef && c == '[' ]
                cl : i32 [ i + 1 ]
                while [ cl < n && s.chars[cl] != ']' ]
                    cl += 1
                if [ cl < n && cl + 1 < n && s.chars[cl + 1] == '(' ]
                    fin : i32 [ cl + 2 ]
                    while [ fin < n && s.chars[fin] != ')' ]
                        fin += 1
                    if [ fin < n ]
                        if [ i > seg ] out.push[ MdSpan [ text: s.mid[ seg, i - seg ], bold: bold, ital: ital ] ]
                        out.push[ MdSpan [ text: s.mid[ i + 1, cl - i - 1 ], link: true ] ]
                        i   = fin + 1
                        seg = i
                        continue
            i += 1
        if [ i > seg ] out.push[ MdSpan [ text: s.mid[ seg, i - seg ], bold: bold, ital: ital, code: codef ] ]
        return out

    # ---- layout + paint: word wrap against the live width ----

    func span_color [ s: MdSpan, body: string ] -> string
        if [ s.link ] return '#7ab8ff'
        if [ s.code ] return '#a8d8b0'
        if [ s.bold ] return '#eef1f6'
        if [ s.ital ] return '#d8d0c0'
        return body

    # measures one block's spans wrapped; returns the height it needs
    func layout_spans [ cv: Canvas, out: vec MdItem, sp: vec MdSpan, fs: i32,
            x0: f32, xmax: f32, body: string, weight: bool ] -> f32
        lh : f32 [ round[ cv.get_line_height[] * 1.25 ] ]
        x  : f32 [ x0 ]
        y  : f32 [ 0.0 ]
        sw : cv.measure_text[ ' ' ]
        for [ s: MdSpan ] in sp
            words : s.text.split[ ' ' ]
            for [ k: i32 0, k < i32[ words.count ], k += 1 ]
                wtx : string words[ k ]
                if [ wtx.count == 0 ] continue
                m : cv.measure_text[ wtx ]
                if [ x + m.w > xmax && x > x0 ]
                    x = x0
                    y += lh
                col : string span_color[ s, body ]
                if [ s.code ]
                    out.push[ MdItem [ kind: 2, x: x - 2.0, y: y + 1.0, w: m.w + 4.0,
                        h: lh - 2.0, r: 4.0, color: '#20242e' ] ]
                out.push[ MdItem [ kind: 0, x: x, y: y, w: m.w + 8.0, h: lh, fs: fs,
                    text: wtx, color: col, bold: s.bold || weight ] ]
                if [ s.link ]
                    out.push[ MdItem [ kind: 1, x: x, y: y + lh - 3.0, w: m.w, h: 1.0, color: col ] ]
                x += m.w + sw.w
        return y + lh

    # content identity of a block at a given width
    func row_hash [ b: MdBlock, cw: f32 ] -> i64
        h : i64 [ 1469598103934665603 ]
        for [ i: i32 0, i < b.text.count, i += 1 ]
            h = (h ^ i64[ b.text[i] ]) * 1099511628211
        h = (h ^ i64[ b.kind ])  * 1099511628211
        h = (h ^ i64[ b.depth ]) * 1099511628211
        h = (h ^ i64[ b.num ])   * 1099511628211
        h = (h ^ i64[ i32[ cw ] ]) * 1099511628211
        return h

    # one measuring pass into rows; only the width can invalidate it
    func layout_doc [ cv: Canvas, cw: f32 ]
        rows   = vec MdRow []
        laid_w = cw
        laid_h = 0.0
        if [ !blocks || blocks.count == 0 ] return
        y : f32 [ 0.0 ]
        for [ b: MdBlock ] in blocks
            it : vec MdItem []
            rh : f32 [ 0.0 ]
            if [ b.kind >= 1 && b.kind <= 6 ]
                fs : i32 [ 16 ]
                if [ b.kind == 1 ] fs = 29
                el [ b.kind == 2 ] fs = 24
                el [ b.kind == 3 ] fs = 20
                el [ b.kind == 4 ] fs = 18
                el                 fs = 16
                cv.font_size[ fs ]
                y += 10.0
                rh = layout_spans[ cv, it, spans_of[ b.text ], fs, 0.0, cw, '#eef1f6', b.kind < 3 ]
                if [ b.kind <= 2 ]
                    it.push[ MdItem [ kind: 1, x: 0.0, y: rh + 2.0, w: cw, h: 1.0, color: '#262b36' ] ]
                    rh += 3.0
                y += rh + 8.0
            el [ b.kind == 7 ]
                cv.font_size[ 14 ]
                clines : b.text.split[ '\n' ]
                lh : f32 [ round[ cv.get_line_height[] * 1.3 ] ]
                rh = f32[ clines.count ] * lh + 16.0
                it.push[ MdItem [ kind: 2, x: 0.0, y: 0.0, w: cw, h: rh, r: 8.0, color: '#1a1e28' ] ]
                cy : f32 [ 8.0 ]
                for [ k: i32 0, k < i32[ clines.count ], k += 1 ]
                    it.push[ MdItem [ kind: 0, x: 12.0, y: cy, w: cw - 24.0, h: lh, fs: 14,
                        text: clines[ k ], color: '#a8d8b0', clip: true ] ]
                    cy += lh
                y += rh + 12.0
            el [ b.kind == 8 || b.kind == 9 ]
                cv.font_size[ 16 ]
                ix : f32 [ 22.0 + f32[ b.depth ] * 22.0 ]
                if [ b.kind == 8 ]
                    it.push[ MdItem [ kind: 2, x: ix - 14.0, y: 9.0, w: 5.0, h: 5.0,
                        r: 2.5, color: '#8892a4' ] ]
                el
                    it.push[ MdItem [ kind: 0, x: ix - 22.0, y: 0.0, w: 20.0, h: 22.0, fs: 16,
                        text: '{b.num}.', color: '#8892a4' ] ]
                rh = layout_spans[ cv, it, spans_of[ b.text ], 16, ix, cw, '#c6ccd8', false ]
                y += rh + 3.0
            el [ b.kind == 10 ]
                cv.font_size[ 16 ]
                rh = layout_spans[ cv, it, spans_of[ b.text ], 16, 18.0, cw, '#9aa8bc', false ]
                it.push[ MdItem [ kind: 1, x: 2.0, y: 2.0, w: 3.0, h: rh - 4.0, color: '#3a4356' ] ]
                y += rh + 8.0
            el [ b.kind == 11 ]
                rh = 9.0
                it.push[ MdItem [ kind: 1, x: 0.0, y: 8.0, w: cw, h: 1.0, color: '#2a2f3a' ] ]
                y += 22.0
            el
                cv.font_size[ 16 ]
                rh = layout_spans[ cv, it, spans_of[ b.text ], 16, 0.0, cw, '#c6ccd8', false ]
                y += rh + 9.0
            rows.push[ MdRow [ y: y - rh - gap_after[ b ], h: rh,
                hash: row_hash[ b, cw ], items: it ] ]
        laid_h = y

    # trailing gap each kind leaves after its own height
    func gap_after [ b: MdBlock ] -> f32
        if [ b.kind >= 1 && b.kind <= 6 ] return 8.0
        if [ b.kind == 7 ]  return 12.0
        if [ b.kind == 8 || b.kind == 9 ] return 3.0
        if [ b.kind == 10 ] return 8.0
        if [ b.kind == 11 ] return 13.0
        return 9.0

    # a painted tile for this row, reused whenever the hash still matches
    func tile_for [ cv: Canvas, row: MdRow, cw: f32 ] -> MdTile
        if [ !tiles ] tiles = vec MdTile []
        for [ t: MdTile ] in tiles
            if [ t.canvas && t.hash == row.hash ]
                t.frame = tile_frame
                return t
        use : MdTile [ null ]
        for [ t: MdTile ] in tiles
            if [ t.frame != tile_frame ]
                use = t
                break
        if [ !use ]
            use = MdTile [ ]
            tiles.push[ use ]
        wi : i32 [ i32[ ceil[ cw ] ] ]
        hi : i32 [ i32[ ceil[ row.h ] ] + 1 ]
        if [ wi < 1 ] wi = 1
        if [ hi < 1 ] hi = 1
        if [ !use.canvas ]
            use.canvas = Canvas [ vk: cv.vk, w: cv.w, format: Pixel.rgba8, width: wi,
                height: hi, load_existing: true, quantize: true, tag: 'md' ]
            use.canvas.update[]
        el [ use.canvas.content_w != wi || use.canvas.content_h != hi ]
            use.canvas.resize[ wi, hi ]
        tc : use.canvas
        tc.reset[ vec4f [ 0.0, 0.0, 0.0, 0.0 ] ]
        tc.stroke_width[ 0.0 ]
        fs9 : i32 [ 0 ]
        for [ i: MdItem ] in row.items
            tc.fill_color[ i.color ]
            if [ i.kind == 0 ]
                if [ i.fs != fs9 ]
                    fs9 = i.fs
                    tc.font_size[ fs9 ]
                ov : Overflow [ (i.clip) ? Overflow.clip : Overflow.visible ]
                r  : rect [ x: i.x, y: i.y, w: i.w, h: i.h ]
                tc.draw_text[ i.text, r, vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], ov, null ]
                if [ i.bold ]
                    r2 : rect [ x: i.x + 0.6, y: i.y, w: i.w, h: i.h ]
                    tc.draw_text[ i.text, r2, vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], ov, null ]
            el [ i.kind == 1 ]
                tc.rect_to[ i.x, i.y, i.w, i.h ]
                tc.paint[]
            el
                tc.rounded_rect[ i.x, i.y, i.w, i.h, i.r, i.r, i.r, i.r ]
                tc.paint[]
        use.hash  = row.hash
        use.frame = tile_frame
        return use

    public func draw [ w: Window ]
        if [ w.draw_stage != CanvasType.screen ] return
        cv : Canvas w.screen
        if [ !bounds ] return
        # reparse when the file changes on disk — live preview
        mt : i64 [ (src && src.exists[]) ? src.modified_time[] : 0 ]
        if [ !blocks || mt != src_mt ]
            src_mt = mt
            parse_doc[]
            laid_w = 0.0
        cv.stroke_width[ 0.0 ]
        cv.fill_color[ '#12141a' ]
        cv.rect_to[ bounds.x, bounds.y, bounds.w, bounds.h ]
        cv.paint[]
        pad : f32 [ 28.0 ]
        cw  : f32 [ bounds.w - pad * 2.0 ]
        if [ cw > 860.0 ] cw = 860.0
        # text snaps to whole pixels; tiles must land on the same grid
        x0  : f32 [ round[ bounds.x + (bounds.w - cw) * 0.5 ] ]
        oy  : f32 [ round[ bounds.y + pad - scroll.y ] ]
        vh  : f32 [ bounds.y + bounds.h ]
        if [ !blocks || blocks.count == 0 ]
            cv.font_size[ 16 ]
            cv.fill_color[ '#8892a4' ]
            r0 : rect [ x: x0, y: oy, w: cw, h: 24.0 ]
            cv.draw_text[ (src) ? 'empty file: {src}' : 'no file — silver markdown <file.md>', r0, vec2f [ 0.0, 0.5 ], vec2f [ 0.0, 0.0 ], Overflow.visible, null ]
            return
        # measured once per width: scrolling only moves the same tiles
        if [ !rows || cw != laid_w ] layout_doc[ cv, cw ]
        tile_frame += 1
        for [ row: MdRow ] in rows
            ry : f32 [ oy + row.y ]
            if [ ry + row.h < bounds.y || ry > vh ] continue
            t : MdTile tile_for[ cv, row, cw ]
            if [ t && t.canvas ]
                cv.draw_canvas[ t.canvas, x0, ry,
                    f32[ t.canvas.content_w ], f32[ t.canvas.content_h ] ]
        cv.paint[]
        # the base element scrolls anything with a content height
        content_h = laid_h + pad * 2.0

# ---- syntax map: orbiter asks the handler to colour a .md it edits ----

func tok [ tk: vec fmt_token, col: i32, len: i32, kind: Syntax ]
    if [ len > 0 ] tk.push[ fmt_token [ column: col, length: len, syntax: kind ] ]

# the index just past the closing run of ch, or -1
func close_run [ s: string, from: i32, ch: i32, run: i32 ] -> i32
    n : i32 [ i32 s.count ]
    j : i32 [ from ]
    while [ j + run <= n ]
        hit : bool [ true ]
        for [ k: i32 0, k < run, k += 1 ]
            if [ s[j + k] != ch ] hit = false
        if [ hit ] return j + run
        j += 1
    return -1

# a list marker's width at i: '- ', '* ', '+ ' or '12. '
func marker_len [ s: string, i: i32 ] -> i32
    n : i32 [ i32 s.count ]
    if [ i + 1 < n && (s[i] == 45 || s[i] == 42 || s[i] == 43) && s[i + 1] == 32 ] return 2
    j : i32 [ i ]
    while [ j < n && s[j] >= 48 && s[j] <= 57 ] j += 1
    if [ j > i && j + 1 < n && s[j] == 46 && s[j + 1] == 32 ] return j + 2 - i
    return 0

# a rule is three or more of one of - * _ and nothing else
func is_rule [ s: string, i: i32 ] -> bool
    n : i32 [ i32 s.count ]
    if [ i >= n ] return false
    c : i32 [ s[i] ]
    if [ c != 45 && c != 42 && c != 95 ] return false
    cnt : i32 [ 0 ]
    for [ j: i32 i, j < n, j += 1 ]
        if [ s[j] == c ]
            cnt += 1
        el [ s[j] != 32 ]
            return false
    return cnt >= 3

# code spans, emphasis, links and tags inside one line of prose
func inline_tokens [ s: string, from: i32, tk: vec fmt_token ]
    n : i32 [ i32 s.count ]
    j : i32 [ from ]
    while [ j < n ]
        c : i32 [ s[j] ]
        if [ c == 96 ]
            e : i32 [ close_run[ s, j + 1, 96, 1 ] ]
            if [ e < 0 ] break
            tok[ tk, j, e - j, Syntax._str ]
            j = e
        el [ c == 42 || c == 95 ]
            run : i32 [ (j + 1 < n && s[j + 1] == c) ? 2 : 1 ]
            e   : i32 [ close_run[ s, j + run, c, run ] ]
            if [ e < 0 ]
                j += run
                continue
            tok[ tk, j, e - j, (run == 2) ? Syntax._classname : Syntax._meta ]
            j = e
        el [ c == 91 ]
            e : i32 [ close_run[ s, j + 1, 93, 1 ] ]
            if [ e < 0 ]
                j += 1
                continue
            tok[ tk, j, e - j, Syntax._usertoken ]
            if [ e < n && s[e] == 40 ]
                u : i32 [ close_run[ s, e + 1, 41, 1 ] ]
                if [ u > 0 ]
                    tok[ tk, e, u - e, Syntax._function ]
                    e = u
            j = e
        el [ c == 60 ]
            e : i32 [ close_run[ s, j + 1, 62, 1 ] ]
            if [ e < 0 ]
                j += 1
                continue
            tok[ tk, j, e - j, Syntax._type ]
            j = e
        el
            j += 1

# the same shape the .f map gives silver source: one token list per line
func syntax [ src: path ] -> fmt_file
    lns  : vec Au []
    text : cast string [ src.load[ typeid[ string ], null ] ]
    if [ text ]
        lines   : text.split[ '\n' ]
        in_code : bool [ false ]
        for [ li: i32 0, li < i32[ lines.count ], li += 1 ]
            s  : string lines[ li ]
            n  : i32 [ i32 s.count ]
            tk : vec fmt_token []
            i  : i32 [ 0 ]
            while [ i < n && s[i] == 32 ] i += 1
            fence : bool [ i + 2 < n && s[i] == 96 && s[i + 1] == 96 && s[i + 2] == 96 ]
            if [ fence ]
                tok[ tk, i, n - i, Syntax._punctuation ]
                in_code = !in_code
            el [ in_code ]
                tok[ tk, i, n - i, Syntax._str ]
            el [ i < n && s[i] == 35 ]
                j : i32 [ i ]
                while [ j < n && s[j] == 35 ] j += 1
                tok[ tk, i, j - i, Syntax._punctuation ]
                tok[ tk, j, n - j, Syntax._keyword ]
            el [ i < n && s[i] == 62 ]
                tok[ tk, i, 1, Syntax._punctuation ]
                tok[ tk, i + 1, n - i - 1, Syntax._comment ]
            el [ is_rule[ s, i ] ]
                tok[ tk, i, n - i, Syntax._punctuation ]
            el
                m : i32 [ marker_len[ s, i ] ]
                tok[ tk, i, m, Syntax._punctuation ]
                inline_tokens[ s, i + m, tk ]
            lns.push[ tk ]
    return fmt_file [ source: '{src}', mtime: src.modified_time[], lines: lns ]
