# silver — central language feature outline
# one entry per feature: key, then a one-to-two sentence description.
# sections are blocks; leaves are 'key: description'. tabs indent, # comments.
# sources: LANGUAGE.md, README.md, features.txt, ar-visions.github.io, compiler.

name:    silver
version: 0.8.8
tagline: 'a native build language — the language IS the build system; one import line clones, builds, and links a dependency, and the output is a native binary with full LLDB debug info'

declarations:
	declare:        ': declares a variable, = assigns to an existing one; these are always distinct, and = never creates'
	initializer:    'x: i32 [ 42 ] declares with a bracketed initializer; the type may be inferred from the expression, as in y: x + 1'
	module_members: 'module-scope members are the only constants; there are no const locals — LLVM optimizes never-modified locals itself'

types:
	primitives:     'i8 i16 i32 i64, u8 u16 u32 u64, f32 f64, bf16, bool, num, sz, none'
	builtin:        'string, symbol (cstr), array, map, list, path, shape, handle — all Au objects with reference counting'
	pointers:       'ref T is a pointer to T, used for C interop, stack arrays, and explicit reference passing; @ is shorthand for ref'
	alias:          'alias Elements : map element [ string ] names a compound type; nested generics are expressed through aliases'
	scalars:        'scalar px : f32 makes the name a numeric suffix — 200px, 16ms — each a distinct type; integer scalars reject float literals'
	shape:          'dimensional literals like 4x4 and 32x32x1 are native shape values, used by new for typed allocation'

functions:
	form:           'func name [ arg: Type ] -> ReturnType with tab-indented body; omitting -> means none, and -> none is disallowed'
	zero_arg:       'at statement level a zero-argument call needs no brackets; inside expressions brackets are required'
	commaless_args: 'without commas, arguments match parameters BY TYPE (CSS-selector style) for order-free declarative composition; with commas they are positional'
	no_varargs:     'fixed arity everywhere — it is what makes commaless type-matching possible'
	access:         'public exports, intern is module-private; module-level defaults public, class members default private'
	dynamic_call:   'method calls are direct by default; dynamic dispatch is opt-in at the call site with method*[ ]'
	bodyless:       'a method declared in silver without a body is implemented in a .c or .cc file beside the module, reading the same fields'

classes:
	model:          'class is heap-allocated, reference-counted, single inheritance; construct with property pairs: c: Counter [ count: 0 ]'
	inheritance:    'the parent class name becomes the keyword: Counter DoubleCounter; super.method[] reaches the base'
	member_access:  'public, intern, context (read-only, injected by type matching), expect (required at construction), mutable'
	init:           'init[] takes no custom parameters — callers pass property pairs and init reads the fields; multi-arg constructors are not silver'
	construct:      'construct [ u: path ] is conversion-shaped: build this class from ONE other type, the opposite of cast'
	exposure_rule:  'public members and public function arguments cannot expose C-imported opaque types; use intern for those'

structs:
	model:          'struct is an inlay value type — no reference counting, passed by reference to its methods'
	bitcast:        'same-size structs convert both directions as a bitcast: (my_vec4f) to rgbaf'

enums:
	form:           'enum Color : u8 with explicit member values; the backing type is optional and may be f32'
	inference:      'bare member names resolve where the enum type is inferred, e.g. switch cases; enums convert to integers and floats'

control_flow:
	if_el:          'if [ cond ] ... el [ cond ] ... el — el is both else-if and else'
	for:            'for [ i: i32 0, i < n, i += 1 ]; a single expression is condition-only, making it a while loop'
	for_in:         'for [ v: T ] in collection iterates arrays; for [ v: V, k: K ] in map iterates maps'
	while:          'while [ condition ] with tab body'
	switch:         'switch [ expr ] with case v1 / case v2, v3 / default; cases never fall through, and enum members go bare'
	sub:            'z: i32 sub stores a body; z[] re-invokes it against current scope and returns the value — the scoped replacement for goto'

expressions:
	ternary:        '(cond) ? a : b — the condition must be parenthesized'
	cast:           '(expr) to Type converts after a parenthesized expression'
	null_guard:     'obj->field->subfield returns the default when a link is null'
	short_circuit:  '|| and && short-circuit and preserve the operand value when types are compatible (a: x || fallback); mismatched types yield bool'
	coalesce:       'value: ptr ?? fallback null-coalesces'
	hat_multi:      'x == (1, 3, 5, 7) is true when x matches any listed value'
	borrow:         'x : coll[i] is a non-holding borrow of a collection element'

strings:
	interpolation:  'single quotes interpolate expressions in braces; double quotes are literal symbols (cstr)'
	numerics:       'decimal floats, scientific notation (1e20, 1.5e-7), and C integer suffixes are read; scalar-typed literals check their unit'

collections:
	array:          'array T — the element type parameter is required'
	map:            'map V [ K ] — the bracketed type is the KEY; e.g. map image [ string ]'
	list:           'list T is the linked collection'
	meta_rule:      'collections with meta.a demand a type parameter unless a subtype already fixed it (tokens inherits array with element preset)'
	elementwise:    'primitive arrays support + - * / % element-wise with scalar broadcast either side; loops auto-vectorize with AVX2 at -O2'

construction:
	prop_pairs:     'objects construct with named field pairs: Counter [ count: 0, name: test ]'
	shorthand:      ':width inside a constructor means width: width'
	single_arg:     'one argument into a multi-field struct acts as a same-size cast when convertible'
	new:            'new T [ shape ] heap-allocates typed memory; * inside those brackets is shape multiplication, so pre-compute products into an i32'
	local:          'local T [ N ] stack-allocates a fixed array, with an optional inline initializer list'

math:
	single_arg:     'sqrt sin cos tan asin acos atan exp log floor ceil round abs — LLVM intrinsics or libm, on scalars and arrays'
	two_arg:        'min max atan2 pow clamp — clamp[ val, lo, hi ]'
	array_forms:    'array versions emit loops LLVM auto-vectorizes; hand-written numerics stay in the module'

asm:
	blocks:         'asm x86_64 conditionally compiles per platform define; Intel syntax'
	expression:     'r: i64 asm [ x, b ] returns a value; with no [ args ] the body auto-gathers in-scope variables'

lambdas:
	form:           'lambda on_event [ event: string :: source: string ] -> bool — :: separates call arguments from captured context'
	alias_type:     'alias FRender : lambda Elements [ Display ] names a lambda type'

operators:
	overload:       'operator + [ b: Vec2 ] -> Vec2 defines binary operators on classes and structs'
	cast_member:    'cast -> string [ ... ] defines a conversion; castable() dispatches it wherever the target type is expected'
	reverse:        'scalar-on-the-left forms (2 * obj) bind through the reverse operator slots (lmul, ldiv, lright, lleft)'

errors:
	expect_stmt:    'expect condition, message — an assertion that prints and traps under the debugger when false'
	check:          'check condition, message — a verify assertion'
	fault:          'fault message — unconditional abort'

imports:
	silver_module:  'import trinity imports another module by bare name; modules live at root as name/name.ag'
	import_as:      'import rand1 as r1 binds companion C sources or a module under a local name'
	c_header:       'import <stdio.h> parses a C header through the integrated clang frontend — macros, structs, functions, enums available at design time, no bindings generated'
	cpp_header:     'a header import carrying -std=c++17 parses as C++: templates, classes, namespaces, and operators become silver types and methods (see interop_cpp)'
	git:            'import owner:repo/commit clones at that pinned hash, detects CMake, Meson, Cargo, GN, or autotools, builds with that project of tools, and links the result'
	git_plus_hdr:   'import madler:zlib/51b7f2a <zlib.h> combines the pinned build with its header'
	flags:          '+NAME defines, +NAME=V defines with value, -D... reaches cmake, -I paths interpolate the install var, -l links, >> runs a post-build shell command'
	params:         'module-scope members become configuration inputs set by the importer, read-only within: import mymod / debug: true'
	cli_git:        'silver User:Project:Module/Commit on the command line imports and runs a module straight from a repository'
	conditionals:   'ifdef linux / ifdef mac gate imports and code per platform; defines are x86_64 arm64 mac linux windows'

modules:
	one_module:     'a module IS a directory with a matching .ag file — one build unit, one shared library or executable'
	companions:     '.c, .cc, .rs, and .mm companion files named after the module compile and link automatically with full access to your types'
	rust:           'a <module>.rs companion binds by stem: cbindgen emits its header, rustc builds a staticlib, silver links it'
	resources:      'style/, images/, fonts/, models/, textures/ inside the module bundle to install/share — symlinked in debug for live edit, copied in release'
	g_descriptor:   'an optional .g carries type: app|shared, modules:, link:, cflags:, install: for the core build'
	agi_format:     '.agi is tab-indented JSON without braces — unquoted keys, key: Type blocks, # comments; Au parses it fresh or onto an existing object'
	export:         'export extensions [ .gen ] writes export/<module>.agi under the silver root at build time — a registry any tool can read; modules built years apart associate without being compiled together'
	export_func:    'export func runs under SILVER_EXPORT after module init and exits — build-time baking for module assets'

interop_c:
	object_model:   'silver, C, and C++ meet inside one C runtime — Au: reference counting, reflection, single inheritance; every type is one schema node'
	headers:        'imported C headers deliver structs at real layout offsets, functions, enums, and function-like macros'
	opaque:         'opaque C types (FILE, GLFWwindow) import as handles; unions get a single-element body padded to ABI size'

interop_cpp:
	direct_import:  'C++ headers import directly — no shim file, no binding layer; .hpp extension or a -std=c++17 flag marks the unit, and production headers like OpenEXR ImfRgbaFile.h work as-is'
	templates:      'sampled specializations register under composed names: minmax<i32>, fixed<i32,16>; explicit instantiation in the header is the sampling trigger'
	angle_types:    'silver reads minmax<i32> and ns::type<arg> natively — type and integral template arguments compose the lookup'
	methods:        'C++ methods call through their mangled symbols with the object pointer as this; inline bodies emit from the import unit itself, so header-only libraries need nothing extra'
	ctors:          'constructors import as methods named for their class: aa.Animal[ 2 ] runs the real constructor on the silver-allocated object, vtable included'
	dtor:           'destructors import as the dtor method, called explicitly where the object must flush or release'
	virtuals:       'virtual methods dispatch through the real Itanium vtable — the dynamic type decides, exactly as in C++'
	overloads:      'overload sets resolve by scoring: exact type over numeric family over pointer kinship over conversion; equal scores are a compile error naming the ambiguity'
	operators:      'C++ operator overloads map onto silver operators — cpp_obj * 2 dispatches to the mangled operator method'
	conversions:    'C++ conversion operators import as silver cast members, so f32[ half_value ] converts through operator float'
	namespaces:     'namespaced types register under qualified names (geo::box); using-directives publish versioned namespaces (Imf finds Imf_3_4)'
	abi:            'by-value 8-byte PODs pass as their SysV eightbyte scalar; C records pad to the compiler-reported ABI size'

glsl:
	inline_shaders: 'func vertex [] -> GLSL none { ... } authors shader code inside silver, compiled to SPIR-V; typed I/O classes carry the interface'
	css_tokens:     'style : CSS { tokens } embeds per-class styling the same way — brace token blocks integrate foreign syntax in place'

testing:
	expect_func:    'expect func test [] -> bool compiles a test into the module; silver --test app runs every expect across the module and its imports'
	constructed:    'test arguments are default-constructed by the runner — a vk_context parameter arrives live; unconstructable arguments report skipped, never silently dropped'
	release_gate:   'a release build runs the debug tests first and refuses on failure; release binaries carry no test code at all'
	coverage:       'coverage <name> classes and the --coverage flag give per-statement instrumentation, opt-in; --timing likewise'

build:
	is_build_sys:   'no CMakeLists, no Makefile, no lock file for your project — the .ag source describes dependencies, build, links, and exports'
	toolchain:      'the install carries clang, lld, llvm-ar, and the SDK, built from source into one folder that never touches the system'
	debug_first:    'debug is default and emits .ll plus full LLDB info; release emits objects in-memory at -O2 with AVX2 and FMA'
	phases:         'compilation is phased — every type name registers before any body parses, every LLVM type exists before any function emits'
	caching:        'modules whose source is unchanged skip recompilation; --clean forces a rebuild and propagates to imports'
	cli:            'silver [flags] module [app-args] — bare launch builds AND runs; --build compiles only, --watch watches, --test runs expects, --release optimizes'
	live_reload:    'the source watcher is compiled into the binaries — a running app rebuilds and hot-swaps its module while the Vulkan session stays live'
	host:           'silver-host supervises apps as peer processes: crash freeze with a symbolized report, live reload, one-window frame sharing'
	listen:         '--listen Class.method traces a method per statement, with optional [ expr ] criteria gating'
	leaks:          '--leaks N reports live objects by init origin with holder chains'

constraints:
	no_const:       'no const locals — module members are the constants'
	no_varargs:     'no varargs — fixed arity enables type matching'
	no_goto:        'no goto — sub covers scoped reusable blocks'
	no_nested_gen:  'no nested generics — alias names the compound'
	arrow_none:     'no -> none — omit the return type'
	collections:    'collections always take their type parameter'
