export 0.1.0

import <stdio.h>
import <string.h>
import <stdlib.h>
import physics
import imu
import gnss
import nav
import guidance
import control

# mission: a Falcon 9 off a sea platform, its upper stage to a
# 200 km orbit, its booster back onto the same deck. each
# vehicle carries its own flight computer (IMU, GPS receiver,
# nav, control) and flies from what nav believes; the truth is
# only physics. the platform's receiver, at its surveyed place,
# corrects the booster's ranges: the errors they share cancel.

# a vehicle's flight computer
class Avionics
    public sensor   : Imu
    public receiver : Receiver
    public filter   : Nav
    public pilot    : Autopilot
    public ready    : bool
    # only the computer flying its own vehicle steers it
    public steers   : bool [ true ]

    # every physics step: sense, believe, steer
    public func tick [ c: Craft, h: f64 ]
        sensor.tick[ c, h ]
        receiver.tick[ c, h ]
        if [ !ready ] return
        for [ s: ImuSample ] in sensor.take[]
            filter.propagate[ s ]
        for [ f: Fix ] in receiver.take[ c.time ]
            filter.correct[ f ]
        if [ steers ]
            pilot.tick[ c, belief_nav[ filter ], h ]

    # nav starts from the surveyed pad, as alignment leaves it
    public func align [ c: Craft ]
        arm : dv_sub[ filter.imu_at, Dvec [ c.cg, 0.0, 0.0 ] ]
        r : dv_add[ c.state.r, q_rotate[ c.state.q, arm ] ]
        v : dv_add[ c.state.v, q_rotate[ c.state.q,
                    dv_cross[ c.state.w, arm ] ] ]
        # 3 m, 0.05 m/s, 0.05 deg tilt, 0.2 deg heading off
        off : q_axis[ Dvec [ 0.3, 1.0, 0.2 ], 0.0035 ]
        filter.begin[ c.time, dv_add[ r, Dvec [ 1.5, -2.0, 1.0 ] ],
                      v, q_mul[ off, c.state.q ], 3.0, 0.05,
                      0.00087, 0.0035 ]
        sensor.take[]
        receiver.take[ c.time ]
        ready = true

func avionics [ al: Almanac, imu_at: Dvec, ant: Dvec,
                seed: u64 ] -> Avionics
    return Avionics [ sensor: Imu [ at: imu_at, seed: seed ],
                      receiver: Receiver [ almanac: al, antenna: ant,
                                           seed: seed * 3 + 1 ],
                      filter: Nav [ imu_at: imu_at, antenna: ant ],
                      pilot: Autopilot [ ] ]

# east, north, up as inertial directions
class Frame
    public east  : Dvec
    public north : Dvec
    public up    : Dvec

func degrees [ d: f64 ] -> f64
    return d * 3.14159265358979 / 180.0

# the booster's drag coefficient by Mach (0 to 10 by 0.25),
# engines first, off and burning, from its own shape
class DragTable
    public off : vec f64
    public lit : vec f64

    func init []
        off = vec f64 []
        lit = vec f64 []

    public func fill [ c: Craft ]
        off.clear[]
        lit.clear[]
        for [ i: i32 0, i <= 40, i += 1 ]
            m : f64 [ f64[ i ] * 0.25 ]
            a : f64 [ c.axial_coeff[ m, true, false ] ]
            b : f64 [ c.axial_coeff[ m, true, true ] ]
            off.push[ a ]
            lit.push[ b ]

    public func coeff [ m: f64, burning: bool ] -> f64
        mk : f64 [ m / 0.25 ]
        if [ mk > 39.999 ] mk = 39.999
        if [ mk < 0.0 ] mk = 0.0
        ki : i32 [ i32[ mk ] ]
        fr : f64 [ mk - f64[ ki ] ]
        if [ burning ]
            return lit[ ki ] + (lit[ ki + 1 ] - lit[ ki ]) * fr
        return off[ ki ] + (off[ ki + 1 ] - off[ ki ]) * fr

    # its own copy: a worker reads it while this one is refilled
    public func copy [] -> DragTable
        out : DragTable [ ]
        for [ i: i32 0, i < off.count, i += 1 ]
            a : f64 [ off[ i ] ]
            b : f64 [ lit[ i ] ]
            out.off.push[ a ]
            out.lit.push[ b ]
        return out

# solve, then again with the drag along the plan's own path:
# the air still pushes as hard as the engine at ignition
func drag_plan [ ld: Landing, tb: DragTable, area: f64, deck: f64,
                 search: bool ] -> bool
    # a first guess: speed falling evenly to nothing
    tf : f64 [ (search) ? (ld.best_lo + ld.best_hi) * 0.5
               : ld.flight ]
    first : vec f64 []
    for [ k: i32 0, k < ld.steps, k += 1 ]
        frac : f64 [ (f64[ k ] + 0.5) / f64[ ld.steps ] ]
        v : dv_scale[ ld.v0, 1.0 - frac ]
        hz : f64 [ ld.r0.z * (1.0 - frac) * (1.0 - frac) ]
        ar : standard_air[ hz + deck ]
        sp : f64 [ dv_len[ v ] ]
        ca : f64 [ tb.coeff[ sp / ar.sound, true ] ]
        k_d : f64 [ 0.5 * ar.density * sp * ca * area / ld.mass ]
        fx : f64 [ 0.0 - k_d * v.x ]
        fy : f64 [ 0.0 - k_d * v.y ]
        fz : f64 [ 0.0 - k_d * v.z ]
        first.push[ fx ]
        first.push[ fy ]
        first.push[ fz ]
    ld.extra = first
    good : bool [ (search) ? ld.best[ ld.best_lo, ld.best_hi ]
                  : ld.solve[] ]
    if [ !good ] return false
    for [ pass: i32 0, pass < 2, pass += 1 ]
        drag : vec f64 []
        used : f64 [ 0.0 ]
        dt : f64 [ ld.flight / f64[ ld.steps ] ]
        for [ k: i32 0, k < ld.steps, k += 1 ]
            v : ld.speed_at[ k ]
            p : ld.place_at[ k ]
            ar : standard_air[ p.z + deck ]
            sp : f64 [ dv_len[ v ] ]
            ca : f64 [ tb.coeff[ sp / ar.sound, true ] ]
            m : f64 [ ld.mass - used ]
            k_d : f64 [ 0.5 * ar.density * sp * ca * area / m ]
            dx : f64 [ 0.0 - k_d * v.x ]
            dy : f64 [ 0.0 - k_d * v.y ]
            dz : f64 [ 0.0 - k_d * v.z ]
            drag.push[ dx ]
            drag.push[ dy ]
            drag.push[ dz ]
            used += ld.bound[ k ] * m * dt / (ld.isp * GRAVITY_STD)
        ld.extra = drag
        if [ !ld.solve[] ] return false
    return true


# a landing plan solved on a worker, from the state the booster
# will be in when the plan is taken up
class PlanJob
    public ld    : Landing
    public tb    : DragTable
    public area  : f64
    public deck  : f64
    # the met it is for, and whether the last plan's time is tried
    public at    : f64
    public warm  : bool
    public good  : bool
    # out of reach of the mark: as near as it can
    public far   : bool
    public done  : bool
    # set when SCvx plans it; ld is then its answer
    public sc    : Scvx
    # how long the solve took (ms, wall clock)
    public took  : f64

func plan_work [ arg: object ]
    j : PlanJob [ arg ]
    began : i64 [ Au.epoch_micros[] ]
    if [ j.sc ]
        scvx_work[ j ]
    el
        gfold_work[ j ]
    j.took = f64[ Au.epoch_micros[] - began ] / 1000.0
    j.done = true

func gfold_work [ j: PlanJob ]
    ld : j.ld
    if [ j.warm ]
        j.good = drag_plan[ ld, j.tb, j.area, j.deck, false ]
    if [ !j.good && ld.r0.z > 3.0 ]
        j.good = drag_plan[ ld, j.tb, j.area, j.deck, true ]
        if [ !j.good ]
            ld.relax = true
            j.good = drag_plan[ ld, j.tb, j.area, j.deck, true ]
            j.far = j.good

# the last touchdown time, a free one, cold, then as near
func scvx_work [ j: PlanJob ]
    sc : j.sc
    sc.hold_time = sc.start.count > 0
    j.good = sc.solve[]
    if [ !j.good && sc.hold_time ]
        sc.hold_time = false
        j.good = sc.solve[]
    if [ !j.good && sc.start.count > 0 ]
        sc.start = vec f64 []
        j.good = sc.solve[]
    if [ !j.good && sc.r0.z > 3.0 ]
        sc.start = vec f64 []
        sc.relax = true
        j.good = sc.solve[]
        j.far = j.good
    j.ld = sc.landing[]

# the whole ship's most acceleration (g): crew and structure
WHOLE_G : f64 [ 4.0 ]
# its lean off the pitch plan's: it climbs steeper, heavier
WHOLE_LEAN : f64 [ 0.8 ]

class Mission
    # the platform at sea, east of the Cape; its deck at 5 m
    public pad_lat : f64 [ 0.49829 ]
    public pad_lon : f64 [ -1.40150 ]
    public deck_h  : f64 [ 5.0 ]
    # three hex decks fitted together, each flat against the
    # others (honeycomb): their corners 48 m out east and west,
    # so 83.14 m apart centre to centre; the second due north of
    # the first, the tanker's
    public pad2_lat : f64 [ 0.49829 + 83.14 / 6371000.0 ]
    public pad2_lon : f64 [ -1.40150 ]
    public deck_two : Deck
    # the third 72.0 m east and 41.57 m north of the first, flat
    # against both: the crew ship's
    public pad3_lat : f64 [ 0.49829 + 41.57 / 6371000.0 ]
    public pad3_lon : f64 [ -1.40150 + 72.0 / (6371000.0 * 0.87843) ]
    public deck_three : Deck
    # decks D, E, F round the first, flat against it: south east,
    # south west, north west (83.14 m centre to centre)
    public deck_lats : vec f64
    public deck_lons : vec f64
    public more_decks : vec Deck
    # the tanker stands on deck two, to lift off first (else it
    # is placed in its orbit)
    public tanker_on_pad : bool [ true ]
    # the tanker's own flight: it is the stack, off deck two; our
    # ship stands on deck one meanwhile (parked_ship, drawn only)
    public tanker_flight : bool
    public parked_ship : Craft
    # a recovery flight: one booster home, nothing else (the
    # tanker's side boosters each fly one); its notes' name
    public recovery : bool
    public label    : string
    public sides    : vec Mission
    # the landing burn's first part on three engines, while fast
    intern three_burn : bool
    # where the flying stack stands and its booster comes home
    public site_lat : f64
    public site_lon : f64
    # the staging flight with the crew ship flown home too: it
    # turns back after separation and lands on the second deck
    public crew_home : bool
    # deck two's middle, its receiver as the crew ship's base
    intern aim2      : Dvec
    intern plat2_ant : Dvec
    public platform2 : Receiver
    intern crew_t    : f64
    public payload : f64 [ 10000.0 ]
    # the pitch kick, degrees off vertical by T+25 s
    public kick    : f64 [ 8.0 ]
    # the main mission: the whole ship to the tanker, nothing
    # dropped; false: the orbit flight, the booster home again
    public whole   : bool [ false ]
    # the booster parts from the crew ship here (m), or sooner if
    # it is down to what its way home needs (their tanks are not
    # joined)
    public sep_alt : f64 [ 50000.0 ]
    # the booster's tanks are dry: its engines draw stage two's
    intern fed_up  : bool
    # when the whole ship took its own steering, for the blend
    intern hand_t  : f64
    # its linear tangent steering: tan = lt_a - lt_b (t - lt_at)
    intern lt_a    : f64
    intern lt_b    : f64
    intern lt_at   : f64
    public almanac : Almanac
    public stack   : Craft
    public booster : Craft
    public orbiter : Craft
    public fairing : Craft
    # the tanker: our own ship, nose and all, propellant where
    # ours carries people, waiting in its circular orbit; height
    # (m) and how far ahead of the pad along its orbit it is at
    # liftoff (deg): behind, so the wait after insertion is
    # short (set from a flight: beside us at SECO)
    public tanker  : Craft
    public tanker_alt  : f64 [ 300000.0 ]
    # our parking orbit, under the tanker's: we gain on it there
    public park_alt    : f64 [ 270000.0 ]
    public tanker_lead : f64 [ -12.65 ]
    # station keeping: its pilot, the orbit's size it keeps (its
    # energy's radius) and the sag allowed under it (m), the
    # burns and what they spent
    public tanker_pilot : Autopilot
    # the close approach: the tanker's own receiver, what its
    # radio last sent (its body origin as it believes it, ECI,
    # and its attitude), the stand-off below its port (m) and
    # when the gap last came inside the hold's limits
    public tank_rx   : Receiver
    public approaching : bool
    intern link_t    : f64
    intern link_r    : Dvec
    intern link_v    : Dvec
    intern link_q    : Quat
    public stand     : f64 [ 20.0 ]
    # which side of the tanker we come from: 1 under it, -1
    # over it; its ports turn to that side, ours to it
    public beneath   : f64 [ 1.0 ]
    # mated, the rings hold the hulls this far apart (m): past
    # both ships' stowed grid fins, only the connectors touch
    public standoff  : f64 [ 1.5 ]
    intern held_t    : f64
    # the approach's jets: a push starts past one level of
    # error and runs until under a fifth of it
    intern pushing   : bool
    # the docking net's last log (nav seconds)
    intern net_log   : f64
    # the latch, as the screen tells it
    intern latched   : string
    # propellant moved from the tanker into us (kg)
    public moved     : f64
    # when the latches closed (met s), -1 before
    public docked_at : f64 [ -1.0 ]
    # the ports' gear: how far the doors are open (0..1) and
    # our probes out of their wells (m)
    public doors     : f64
    public probe     : f64
    # when the gear began moving, and when the probes caught
    intern gear_t    : f64 [ -1.0 ]
    intern caught_t  : f64
    # when the latches opened
    intern freed_t   : f64
    intern caught_r  : Dvec
    intern caught_q  : Quat
    # docked: our port from its port, and our turn, in the
    # tanker's body frame (the hulls, not the centres of mass:
    # those move as the propellant does)
    intern dock_r    : Dvec
    intern dock_q    : Quat
    # the gap port to port by relative GPS (ECI) and its time
    intern rel_p     : Dvec
    intern rel_v     : Dvec
    intern rel_t     : f64 [ -1.0 ]
    public keep_a    : f64
    public keep_band : f64 [ 50.0 ]
    public boosting  : bool
    public boosts    : i32
    public boost_kg  : f64
    intern boost_from : f64
    intern tank_vr   : f64
    # the transfer's high point while raising, the low point to
    # beat while circularising (m from the centre)
    intern raise_to : f64
    # the parking orbit rounded off at its high point
    public parked   : bool
    intern trimming : bool
    # the last step's climb along the radius (m/s)
    intern last_vr  : f64
    public low     : Avionics
    public high    : Avionics
    public platform : Receiver
    # where the booster lands: ECEF, the surveyed mark, aimed at
    public target  : Dvec
    public aim     : Dvec
    public plat_ant : Dvec
    public met     : f64 [ -10.0 ]
    # booster: 0 stack, 1 flip, 2 boostback, 3 coast, 4 entry,
    # 5 aero, 6 landing burn, 7 down; orbiter: 0 stack, 1 coast,
    # 2 burn, 3 parking orbit, 4 raising burn, 5 transfer coast,
    # 6 circularising burn, 7 in the tanker's orbit
    public lower   : i32
    public upper   : i32
    public events  : vec string
    public lit_t   : f64
    public steer   : Dvec
    public miss    : f64
    public plan    : Landing
    public plan_t  : f64
    # the planner the landing burn flies, and its solve times
    public landing : LandingMethod
    public plan_n  : i32
    public plan_ms : f64
    public plan_worst : f64
    # touchdown: when, and once it has stood still or fallen
    public down_t  : f64 [ -1.0 ]
    public settled : bool
    # the touchdown events already noted, a bit each
    intern seen    : i32
    intern think   : f64
    public sep_t   : f64
    intern booster_dry : f64
    # how many boosters make the bottom stage (the tanker's 3)
    intern boosters : f64 [ 1.0 ]
    intern prev_miss : f64 [ 1e30 ]
    # the predicted landing's last place against the mark, and
    # how fast it moves (inertial, horizontal)
    intern prev_mv : Dvec
    intern mv_rate : Dvec
    intern glance : f64
    # when the boostback is cut, once its target is in sight
    intern cut_at : f64 [ -1.0 ]
    # the landing burn's last pointing: axis, thrust N, when
    intern pt_axis : Dvec
    intern pt_thrust : f64
    intern pt_t : f64
    # the push felt less the push its attitude should give,
    # filtered (m/s2, inertial)
    intern push_err : Dvec
    # the drag table, and when it was last made from the shape
    intern drag_tb : DragTable
    intern drag_t : f64 [ -1e30 ]
    # the landing plan being solved, and the worker solving it
    intern job : PlanJob
    intern solver : async
    # SCvx's last answer: the next solve starts from it
    intern plan_sc : Scvx
    # down near the deck, then rising: the engines are cut
    intern cut     : bool
    # how far from the mark is on the pad, m: none from afar (it
    # aims at the centre), growing as it comes down to 2/3 of
    # the deck's 48 m by pad_full (estimates)
    public pad_far : f64 [ 2000.0 ]
    public pad_full : f64 [ 300.0 ]
    # where the plans land, across from the mark (m): it stays
    # put, moved only when where it is headed strays 10 m from it
    intern land_at : Dvec
    # the way a lean carries it on its fins: 1 toward the lean,
    # -1 away; learned from the miss over 4 s, since the last
    intern fin_way : f64
    intern fin_look : f64 [ -1.0 ]
    intern fin_miss : f64
    # the deck's anemometer on its 10 m mast: its own air, and
    # what it reads, east and north, over about 10 s
    intern deck_air : Weather
    public deck_wind : Dvec
    # the last of the fall at the least throttle, then off; the
    # engine off for a fall, to light again at the least throttle
    intern feather : bool
    intern coasting : bool

    func init []
        events = vec string []
        almanac = Almanac [ ]
        almanac.load[]
        if [ recovery ]
            # its own computers; adopt gives it the booster
            platform = Receiver [ almanac: almanac, seed: 79 ]
            low = avionics[ almanac, Dvec [ 39.0 * SHIP_LONG, 0.0, 0.0 ],
                            Dvec [ 40.0 * SHIP_LONG, 1.83 * SHIP_WIDE,
                                   0.0 ], 31 ]
            low.filter.gps_bias = 0.3
            pt_axis = Dvec [ 0.0, 0.0, 1.0 ]
            push_err = Dvec [ 0.0, 0.0, 0.0 ]
            return
        site_lat = pad_lat
        site_lon = pad_lon
        if [ tanker_flight ]
            site_lat = pad2_lat
            site_lon = pad2_lon
            # parked in its own orbit, 300 km
            park_alt = tanker_alt
            tanker_on_pad = false
        stack = (tanker_flight) ? tanker_ship[] : falcon_nine[ payload ]
        stack.turn_start = 0.0
        deck : Deck [ centre: geodetic_to_ecef[ site_lat, site_lon, deck_h ],
                      up: enu_up[ site_lat, site_lon ], radius: 48.0 ]
        stack.deck = deck
        deck_two = Deck [ centre: geodetic_to_ecef[ pad2_lat, pad2_lon,
                                                    deck_h ],
                          up: enu_up[ pad2_lat, pad2_lon ], radius: 48.0 ]
        deck_three = Deck [ centre: geodetic_to_ecef[ pad3_lat, pad3_lon,
                                                      deck_h ],
                            up: enu_up[ pad3_lat, pad3_lon ],
                            radius: 48.0 ]
        deck_lats = vec f64 []
        deck_lons = vec f64 []
        more_decks = vec Deck []
        north : vec f64 [] [ -41.57, -41.57, 41.57 ]
        east : vec f64 [] [ 72.0, -72.0, -72.0 ]
        for [ i: i32 0, i < 3, i += 1 ]
            lat : f64 [ pad_lat + north[ i ] / 6371000.0 ]
            lon : f64 [ pad_lon + east[ i ] / (6371000.0 * 0.87843) ]
            deck_lats.push[ lat ]
            deck_lons.push[ lon ]
            more_decks.push[ Deck [ centre: geodetic_to_ecef[ lat, lon,
                                                              deck_h ],
                                    up: enu_up[ lat, lon ],
                                    radius: 48.0 ] ]
        # the landing mark: the deck's middle, where it stood
        target = geodetic_to_ecef[ site_lat, site_lon, deck_h ]
        plat_ant = geodetic_to_ecef[ site_lat, site_lon, deck_h + 2.0 ]
        platform = Receiver [ almanac: almanac, seed: 77 ]
        platform2 = Receiver [ almanac: almanac, seed: 78 ]
        aim2 = geodetic_to_ecef[ pad3_lat, pad3_lon, deck_h ]
        plat2_ant = geodetic_to_ecef[ pad3_lat, pad3_lon, deck_h + 2.0 ]
        aim = target
        kl : f64 [ SHIP_LONG ]
        kr : f64 [ SHIP_WIDE ]
        low = avionics[ almanac, Dvec [ 39.0 * kl, 0.0, 0.0 ],
                        Dvec [ 40.0 * kl, 1.83 * kr, 0.0 ], 11 ]
        low.receiver.base = platform
        low.receiver.base_at = plat_ant
        # corrected, little shared error is left (an estimate)
        low.filter.gps_bias = 0.3
        high = avionics[ almanac, Dvec [ 55.0 * kl, 0.0, 0.0 ],
                         Dvec [ 56.0 * kl, 1.83 * kr, 0.0 ], 23 ]
        boosters = 0.0
        for [ t: Tank ] in stack.tanks
            if [ t.group == 'one' && t.density > 1000.0 ] boosters += 1.0
        booster_dry = 25600.0 * kl * kr * kr * boosters
        pt_axis = Dvec [ 0.0, 0.0, 1.0 ]
        push_err = Dvec [ 0.0, 0.0, 0.0 ]
        high.steers = false
        for [ g: Leg ] in stack.legs
            g.out = true
        clamp_down[]
        if [ tanker_flight ]
            # ours stands on deck one, quiet
            parked_ship = falcon_nine[ payload ]
            parked_ship.turn_start = 0.0
            parked_ship.deck = Deck [ centre: geodetic_to_ecef[ pad_lat, pad_lon,
                                                         deck_h ],
                               up: enu_up[ pad_lat, pad_lon ],
                               radius: 48.0 ]
            for [ g: Leg ] in parked_ship.legs
                g.out = true
                g.frac = 1.0
            parked_ship.stand[ pad_lat, pad_lon, deck_h - LEG_FOOT_X ]
        el
            place_tanker[]

    # the tanker at liftoff: circular, its plane through the pad
    # along its heading east, tanker_lead degrees ahead
    func place_tanker []
        # three boosters side by side, a fourth on top
        tk : tanker_ship[]
        # what that climb leaves of its propellant: 9.4 km/s to
        # 300 km at 3.6 km/s of exhaust on average (an estimate)
        # placed in orbit, it has what its flight up leaves (the
        # top stage's load less its climb from staging, an
        # estimate); on its deck it stands full
        if [ !tanker_on_pad ]
            for [ i: i32 0, i < tk.state.prop.count, i += 1 ]
                if [ tk.tanks[ i ].group == 'one' ] tk.state.prop[ i ] = 0.0
            top_full : f64 [ tk.mass ]
            arrive : f64 [ top_full * exp[ -7100.0 / 3727.0 ] ]
            dry : f64 [ top_full - tk.propellant[] ]
            keep : f64 [ max[ arrive - dry, 0.0 ] ]
            share : f64 [ keep / max[ tk.propellant[], 1.0 ] ]
            for [ i: i32 0, i < tk.state.prop.count, i += 1 ]
                tk.state.prop[ i ] = tk.state.prop[ i ] * share
            tk.mass_properties[ tk.state.prop ]
        t0 : f64 [ stack.time - met ]
        ang : f64 [ earth_turn[ t0, stack.turn_start ] ]
        pad : ecef_to_eci[ geodetic_to_ecef[ pad_lat, pad_lon, 0.0 ],
                           ang ]
        ea : ecef_to_eci[ enu_east[ pad_lat, pad_lon ], ang ]
        ur : dv_norm[ pad ]
        ut : dv_norm[ dv_sub[ ea, dv_scale[ ur, dv_dot[ ea, ur ] ] ] ]
        th : f64 [ degrees[ tanker_lead ] ]
        dir : dv_add[ dv_scale[ ur, cos[ th ] ],
                      dv_scale[ ut, sin[ th ] ] ]
        along : dv_sub[ dv_scale[ ut, cos[ th ] ],
                        dv_scale[ ur, sin[ th ] ] ]
        rr : f64 [ EARTH_A + tanker_alt ]
        tk.time = t0
        tk.state.r = dv_scale[ dir, rr ]
        # circular in our gravity, its flattening (J2) included
        down : f64 [ 0.0 - dv_dot[ gravity[ tk.state.r ], dir ] ]
        tk.state.v = dv_scale[ along, sqrt[ rr * down ] ]
        # its nose along its path, holding still
        tk.state.q = q_between[ Dvec [ 1.0, 0.0, 0.0 ], along ]
        tk.state.w = Dvec [ 0.0, 0.0, 0.0 ]
        for [ g: Leg ] in tk.legs
            g.out = false
            g.frac = 0.0
        # slow: a heavy ship, small jets
        tanker_pilot = Autopilot [ rate: 2.0, use_jets: true,
                                   max_rate: 0.02, couples: true ]
        tank_rx = Receiver [ almanac: almanac, seed: 41,
                             antenna: Dvec [ 56.0 * SHIP_LONG,
                                             1.83 * SHIP_WIDE, 0.0 ] ]
        link_q = tk.state.q
        # its body origin (state.r is its centre of mass)
        link_r = tk.body_point[ Dvec [ 0.0, 0.0, 0.0 ] ]
        link_v = tk.state.v
        link_t = tk.time
        tanker = tk
        keep_a = energy_radius[ tk.state.r, tk.state.v ]
        if [ tanker_on_pad ]
            # on deck two, on its legs, quiet
            tk.deck = deck_two
            for [ g: Leg ] in tk.legs
                g.out = true
                g.frac = 1.0
            tk.stand[ pad2_lat, pad2_lon, deck_h - LEG_FOOT_X ]
            link_q = tk.state.q
            link_r = tk.body_point[ Dvec [ 0.0, 0.0, 0.0 ] ]
            link_v = tk.state.v

    # the orbit's size from its whole energy, the flattening's
    # share in it: only the air and burns change it (m)
    public func energy_radius [ r: Dvec, v: Dvec ] -> f64
        rr : f64 [ dv_len[ r ] ]
        s2 : f64 [ r.z * r.z / (rr * rr) ]
        u : f64 [ 0.0 - EARTH_GM / rr + EARTH_GM * EARTH_J * EARTH_A
                  * EARTH_A * (3.0 * s2 - 1.0) / (2.0 * rr * rr * rr) ]
        e : f64 [ 0.5 * dv_dot[ v, v ] + u ]
        return 0.0 - EARTH_GM / (2.0 * e)

    # the tanker keeps itself up: nose along its path through the
    # air; at its high point, when its orbit has shrunk past the
    # band, its centre engine burns at least throttle
    public func keep_tanker [ h: f64 ]
        tk : tanker
        r : tk.state.r
        v : tk.state.v
        rr : f64 [ dv_len[ r ] ]
        vr : f64 [ dv_dot[ v, r ] / rr ]
        tanker_pilot.axis = dv_norm[ v ]
        # on our call it rolls its port to face the Earth
        tanker_pilot.side = Dvec [ 0.0, 0.0, 0.0 ]
        if [ approaching ]
            face : dv_scale[ r, 0.0 - beneath / rr ]
            tanker_pilot.side = dv_cross[ face, dv_norm[ v ] ]
        tanker_pilot.tick[ tk, belief_truth[ tk ], h ]
        # its radio: its own fix and its attitude, as it sends
        tank_rx.tick[ tk, h ]
        for [ f: Fix ] in tank_rx.take[ tk.time ]
            ang : f64 [ earth_turn[ f.time, tk.turn_start ] ]
            ra : ecef_to_eci[ f.pos, ang ]
            va : dv_add[ ecef_to_eci[ f.vel, ang ],
                         dv_cross[ Dvec [ 0.0, 0.0, EARTH_SPIN ], ra ] ]
            # its own filter: each fix nudges what it believed
            # (an alpha-beta smoothing, about 2 s to settle)
            link_q = tk.state.q
            got : dv_sub[ ra, q_rotate[ link_q, tank_rx.antenna ] ]
            was : tanker_at[ f.time ]
            link_r = dv_add[ was[ 0 ], dv_scale[ dv_sub[ got, was[ 0 ] ],
                                                0.05 ] ]
            link_v = dv_add[ was[ 1 ], dv_scale[ dv_sub[ va, was[ 1 ] ],
                                                0.1 ] ]
            link_t = f.time
        eng : tk.engines[ 0 ]
        size : f64 [ energy_radius[ r, v ] ]
        if [ boosting ]
            if [ size < keep_a ] return
            eng.lit = false
            boosting = false
            spent : f64 [ boost_from - tk.propellant[] ]
            boost_kg += spent
            boosts += 1
            got : orbit_range[ r, v, period_at[ rr ] ]
            lo_km : f64 [ (got.y - EARTH_A) / 1000.0 ]
            hi_km : f64 [ (got.x - EARTH_A) / 1000.0 ]
            note[ 'tanker reboost {boosts}: {spent} kg, now {lo_km} to {hi_km} km, {boost_kg} kg in all' ]
            return
        top : bool [ tank_vr > 0.0 && vr <= 0.0 ]
        tank_vr = vr
        # never with a ship alongside
        if [ !top || tanker_pilot.error > 0.02 || approaching ] return
        if [ size >= keep_a - keep_band ] return
        eng.lit = true
        eng.throttle = eng.throttle_min
        boosting = true
        boost_from = tk.propellant[]

    # ---- the save state: the flight as text, 'name: values' a
    # line, full precision; the computers restart on a load ----
    # a double as its exact bits, written as a whole number
    func exact [ x: f64 ] -> string
        v : f64 [ x ]
        u : u64 [ 0 ]
        memcpy[ @u, @v, 8 ]
        return '{u}'

    # and back
    func inexact [ word: string ] -> f64
        u : u64 [ strtoull[ word.chars, null, 10 ] ]
        v : f64 [ 0.0 ]
        memcpy[ @v, @u, 8 ]
        return v

    func dv_text [ d: Dvec ] -> string
        return '{exact[ d.x ]} {exact[ d.y ]} {exact[ d.z ]}'

    func q_text [ q: Quat ] -> string
        return '{exact[ q.w ]} {exact[ q.x ]} {exact[ q.y ]} {exact[ q.z ]}'

    func vec_text [ v: vec f64 ] -> string
        out : string [ '' ]
        for [ x: f64 ] in v
            out = '{out} {exact[ x ]}'
        return out

    func craft_text [ tag: string, c: Craft ] -> string
        st : c.state
        out : 'craft: {tag}\n'
        out = '{out}time: {exact[ c.time ]}\nturn_start: {exact[ c.turn_start ]}\n'
        out = '{out}r: {dv_text[ st.r ]}\nv: {dv_text[ st.v ]}\n'
        out = '{out}q: {q_text[ st.q ]}\nw: {dv_text[ st.w ]}\n'
        out = '{out}prop:{vec_text[ st.prop ]}\nslosh:{vec_text[ st.slosh ]}\n'
        out = '{out}flex:{vec_text[ st.flex ]}\n'
        out = '{out}collar: {exact[ c.collar_stroke ]} {exact[ c.collar_turn ]}\n'
        for [ e: Engine ] in c.engines
            lit : i32 [ (e.lit) ? 1 : 0 ]
            ox : i32 [ tank_number[ c, e.oxidiser ] ]
            fu : i32 [ tank_number[ c, e.fuel ] ]
            out = '{out}engine: {exact[ f64[ lit ] ]} {exact[ e.throttle ]} {exact[ e.pitch ]} {exact[ e.yaw ]} {exact[ f64[ ox ] ]} {exact[ f64[ fu ] ]}\n'
        for [ g: Leg ] in c.legs
            o : i32 [ (g.out) ? 1 : 0 ]
            b : i32 [ (g.broken) ? 1 : 0 ]
            out = '{out}leg: {exact[ f64[ o ] ]} {exact[ g.frac ]} {exact[ f64[ b ] ]}\n'
        for [ f: Fin ] in c.fins
            o : i32 [ (f.open) ? 1 : 0 ]
            out = '{out}fin: {exact[ f64[ o ] ]} {exact[ f.frac ]} {exact[ f.deflect ]}\n'
        return '{out}end: {tag}\n'

    # a nav filter's whole belief: time, place, speed, turn,
    # its bias and gps error estimates, its spread, its fixes
    func nav_numbers [ f: Nav ] -> vec f64
        out : vec f64 [] [ f.time, f.r.x, f.r.y, f.r.z, f.v.x, f.v.y,
            f.v.z, f.q.w, f.q.x, f.q.y, f.q.z, f.ba.x, f.ba.y, f.ba.z,
            f.bg.x, f.bg.y, f.bg.z, f.gps.x, f.gps.y, f.gps.z,
            f.rate.x, f.rate.y, f.rate.z, f.felt.x, f.felt.y,
            f.felt.z, f64[ f.fixes ] ]
        for [ c: f64 ] in f.cov
            out.push[ c ]
        return out

    # and back over a restarted filter
    func nav_back [ f: Nav, x: vec f64 ]
        if [ x.count < 27 + f.cov.count ] return
        f.time = x[ 0 ]
        f.r = Dvec [ x[ 1 ], x[ 2 ], x[ 3 ] ]
        f.v = Dvec [ x[ 4 ], x[ 5 ], x[ 6 ] ]
        f.q = Quat [ x[ 7 ], x[ 8 ], x[ 9 ], x[ 10 ] ]
        f.ba = Dvec [ x[ 11 ], x[ 12 ], x[ 13 ] ]
        f.bg = Dvec [ x[ 14 ], x[ 15 ], x[ 16 ] ]
        f.gps = Dvec [ x[ 17 ], x[ 18 ], x[ 19 ] ]
        f.rate = Dvec [ x[ 20 ], x[ 21 ], x[ 22 ] ]
        f.felt = Dvec [ x[ 23 ], x[ 24 ], x[ 25 ] ]
        f.fixes = i32[ x[ 26 ] ]
        for [ i: i32 0, i < f.cov.count, i += 1 ]
            f.cov[ i ] = x[ 27 + i ]

    # which of a craft's tanks has a name (its place in the list)
    func tank_number [ c: Craft, nm: string ] -> i32
        for [ i: i32 0, i < c.tanks.count, i += 1 ]
            if [ c.tanks[ i ].name == nm ] return i
        return -1

    func pilot_text [ tag: string, ap: Autopilot ] -> string
        c : i32 [ (ap.couples) ? 1 : 0 ]
        j : i32 [ (ap.use_jets) ? 1 : 0 ]
        g : i32 [ (ap.use_gimbal) ? 1 : 0 ]
        f : i32 [ (ap.use_fins) ? 1 : 0 ]
        out : '{tag}_flags: {exact[ f64[ c ] ]} {exact[ f64[ j ] ]} {exact[ f64[ g ] ]} {exact[ f64[ f ] ]}\n'
        out = '{out}{tag}_axis: {dv_text[ ap.axis ]}\n{tag}_side: {dv_text[ ap.side ]}\n'
        return '{out}{tag}_push: {dv_text[ ap.push ]}\n'

    # the flight now, to a file; true when written
    public func save_state [ to: path ] -> bool
        n : '# launch save state at T{met}, phases {lower} {upper} (numbers are their doubles\' bits)\n'
        nums : vec f64 [] [ met, f64[ lower ], f64[ upper ], hand_t, lt_a,
            lt_b, lt_at, link_t, stand, beneath, standoff, held_t,
            moved, docked_at, doors, probe, gear_t, caught_t, freed_t,
            rel_t, keep_a, boost_kg, f64[ boosts ], boost_from,
            last_vr, lit_t, sep_t, down_t, raise_to, tank_vr ]
        flags : vec bool [] [ whole, fed_up, approaching, pushing,
            boosting, parked, trimming, settled, coasting ]
        n = '{n}nums:{vec_text[ nums ]}\n'
        fl : string [ '' ]
        for [ x: bool ] in flags
            bit : i32 [ (x) ? 1 : 0 ]
            fl = '{fl} {exact[ f64[ bit ] ]}'
        n = '{n}flags:{fl}\n'
        n = '{n}link_r: {dv_text[ link_r ]}\nlink_v: {dv_text[ link_v ]}\n'
        n = '{n}link_q: {q_text[ link_q ]}\ncaught_r: {dv_text[ caught_r ]}\n'
        n = '{n}caught_q: {q_text[ caught_q ]}\ndock_r: {dv_text[ dock_r ]}\n'
        n = '{n}dock_q: {q_text[ dock_q ]}\nrel_p: {dv_text[ rel_p ]}\n'
        n = '{n}rel_v: {dv_text[ rel_v ]}\n'
        n = '{n}{pilot_text[ 'low', low.pilot ]}{pilot_text[ 'high', high.pilot ]}'
        # which computer flies, and which has started
        ls : i32 [ (low.steers) ? 1 : 0 ]
        hs : i32 [ (high.steers) ? 1 : 0 ]
        lr : i32 [ (low.ready) ? 1 : 0 ]
        hr : i32 [ (high.ready) ? 1 : 0 ]
        n = '{n}nav_low:{vec_text[ nav_numbers[ low.filter ] ]}\n'
        n = '{n}nav_high:{vec_text[ nav_numbers[ high.filter ] ]}\n'
        n = '{n}computers: {exact[ f64[ ls ] ]} {exact[ f64[ hs ] ]} {exact[ f64[ lr ] ]} {exact[ f64[ hr ] ]}\n'
        n = '{n}{pilot_text[ 'tanker', tanker_pilot ]}'
        if [ stack ] n = '{n}{craft_text[ 'stack', stack ]}'
        if [ booster && booster != stack ]
            n = '{n}{craft_text[ 'booster', booster ]}'
        if [ orbiter && orbiter != stack ]
            n = '{n}{craft_text[ 'orbiter', orbiter ]}'
        if [ tanker ] n = '{n}{craft_text[ 'tanker', tanker ]}'
        to.save[ n, null ]
        note[ 'saved the flight to {to}' ]
        return to.exists[]

    # an autopilot's line back
    func pilot_line [ ap: Autopilot, field: string, x: vec f64 ]
        if [ field == 'flags' && x.count >= 4 ]
            ap.couples = x[ 0 ] > 0.5
            ap.use_jets = x[ 1 ] > 0.5
            ap.use_gimbal = x[ 2 ] > 0.5
            ap.use_fins = x[ 3 ] > 0.5
        if [ x.count < 3 ] return
        d : Dvec [ x[ 0 ], x[ 1 ], x[ 2 ] ]
        if [ field == 'axis' ] ap.axis = d
        if [ field == 'side' ] ap.side = d
        if [ field == 'push' ] ap.push = d

    # a craft's line back; counts which engine, leg, fin it is at
    func craft_line [ c: Craft, key: string, x: vec f64,
                      at: vec i32 ]
        st : c.state
        if [ key == 'time' ] c.time = x[ 0 ]
        if [ key == 'turn_start' ] c.turn_start = x[ 0 ]
        if [ key == 'r' ] st.r = Dvec [ x[ 0 ], x[ 1 ], x[ 2 ] ]
        if [ key == 'v' ] st.v = Dvec [ x[ 0 ], x[ 1 ], x[ 2 ] ]
        if [ key == 'w' ] st.w = Dvec [ x[ 0 ], x[ 1 ], x[ 2 ] ]
        if [ key == 'q' ] st.q = Quat [ x[ 0 ], x[ 1 ], x[ 2 ], x[ 3 ] ]
        if [ key == 'prop' ]
            for [ i: i32 0, i < x.count && i < st.prop.count, i += 1 ]
                st.prop[ i ] = x[ i ]
        if [ key == 'slosh' ]
            for [ i: i32 0, i < x.count && i < st.slosh.count, i += 1 ]
                st.slosh[ i ] = x[ i ]
        if [ key == 'flex' ]
            for [ i: i32 0, i < x.count && i < st.flex.count, i += 1 ]
                st.flex[ i ] = x[ i ]
        if [ key == 'collar' ]
            c.collar_stroke = x[ 0 ]
            c.collar_turn = x[ 1 ]
        if [ key == 'engine' && at[ 0 ] < c.engines.count ]
            e : c.engines[ at[ 0 ] ]
            e.lit = x[ 0 ] > 0.5
            e.throttle = x[ 1 ]
            e.pitch = x[ 2 ]
            e.yaw = x[ 3 ]
            ox : i32 [ i32[ x[ 4 ] ] ]
            fu : i32 [ i32[ x[ 5 ] ] ]
            if [ ox >= 0 && ox < c.tanks.count ]
                e.oxidiser = c.tanks[ ox ].name
            if [ fu >= 0 && fu < c.tanks.count ]
                e.fuel = c.tanks[ fu ].name
            at[ 0 ] = at[ 0 ] + 1
        if [ key == 'leg' && at[ 1 ] < c.legs.count ]
            g : c.legs[ at[ 1 ] ]
            g.out = x[ 0 ] > 0.5
            g.frac = x[ 1 ]
            g.broken = x[ 2 ] > 0.5
            at[ 1 ] = at[ 1 ] + 1
        if [ key == 'fin' && at[ 2 ] < c.fins.count ]
            f : c.fins[ at[ 2 ] ]
            f.open = x[ 0 ] > 0.5
            f.frac = x[ 1 ]
            f.deflect = x[ 2 ]
            at[ 2 ] = at[ 2 ] + 1

    # a saved flight back: the ships as they were, the phases
    # where they were; each computer restarts with what it
    # believed (its receiver takes a fresh fix)
    public func load_state [ from: path ] -> bool
        if [ !from.exists[] ] return false
        text : string [ from.load[ typeid[ string ], null ] ]
        rows : text.split[ '\n' ]
        cur : Craft [ null ]
        at : vec i32 [] [ 0, 0, 0 ]
        flown : vec f64 []
        nav_lo : vec f64 []
        nav_hi : vec f64 []
        for [ row: string ] in rows
            cols : row.split[ ' ' ]
            if [ cols.count < 2 ] continue
            key : cols[ 0 ]
            if [ key.count < 2 || key.chars[ 0 ] == 35 ] continue
            key = key.mid[ 0, key.count - 1 ]
            x : vec f64 []
            for [ i: i32 1, i < cols.count, i += 1 ]
                word : cols[ i ]
                if [ word.count == 0 ] continue
                v : f64 [ inexact[ word ] ]
                x.push[ v ]
            if [ key == 'craft' ]
                tag : cols[ 1 ]
                cur = null
                if [ tag == 'stack' ] cur = stack
                if [ tag == 'booster' ] cur = booster
                if [ tag == 'orbiter' ] cur = orbiter
                if [ tag == 'tanker' ] cur = tanker
                at[ 0 ] = 0
                at[ 1 ] = 0
                at[ 2 ] = 0
                continue
            if [ key == 'end' ]
                if [ cur ] cur.mass_properties[ cur.state.prop ]
                cur = null
                continue
            if [ cur ]
                craft_line[ cur, key, x, at ]
                continue
            if [ key == 'nums' && x.count >= 30 ]
                met = x[ 0 ]
                lower = i32[ x[ 1 ] ]
                upper = i32[ x[ 2 ] ]
                hand_t = x[ 3 ]
                lt_a = x[ 4 ]
                lt_b = x[ 5 ]
                lt_at = x[ 6 ]
                link_t = x[ 7 ]
                stand = x[ 8 ]
                beneath = x[ 9 ]
                standoff = x[ 10 ]
                held_t = x[ 11 ]
                moved = x[ 12 ]
                docked_at = x[ 13 ]
                doors = x[ 14 ]
                probe = x[ 15 ]
                gear_t = x[ 16 ]
                caught_t = x[ 17 ]
                freed_t = x[ 18 ]
                rel_t = x[ 19 ]
                keep_a = x[ 20 ]
                boost_kg = x[ 21 ]
                boosts = i32[ x[ 22 ] ]
                boost_from = x[ 23 ]
                last_vr = x[ 24 ]
                lit_t = x[ 25 ]
                sep_t = x[ 26 ]
                down_t = x[ 27 ]
                raise_to = x[ 28 ]
                tank_vr = x[ 29 ]
                # a parted flight parts here too
                if [ lower >= 1 && stack ] separate[]
            if [ key == 'computers' ] flown = x
            if [ key == 'nav_low' ] nav_lo = x
            if [ key == 'nav_high' ] nav_hi = x
            if [ key == 'flags' && x.count >= 9 ]
                whole = x[ 0 ] > 0.5
                fed_up = x[ 1 ] > 0.5
                approaching = x[ 2 ] > 0.5
                pushing = x[ 3 ] > 0.5
                boosting = x[ 4 ] > 0.5
                parked = x[ 5 ] > 0.5
                trimming = x[ 6 ] > 0.5
                settled = x[ 7 ] > 0.5
                coasting = x[ 8 ] > 0.5
            if [ x.count >= 3 ]
                d : Dvec [ x[ 0 ], x[ 1 ], x[ 2 ] ]
                if [ key == 'link_r' ] link_r = d
                if [ key == 'link_v' ] link_v = d
                if [ key == 'caught_r' ] caught_r = d
                if [ key == 'dock_r' ] dock_r = d
                if [ key == 'rel_p' ] rel_p = d
                if [ key == 'rel_v' ] rel_v = d
            if [ x.count >= 4 ]
                qv : Quat [ x[ 0 ], x[ 1 ], x[ 2 ], x[ 3 ] ]
                if [ key == 'link_q' ] link_q = qv
                if [ key == 'caught_q' ] caught_q = qv
                if [ key == 'dock_q' ] dock_q = qv
            parts : key.split[ '_' ]
            if [ parts.count == 2 ]
                who : parts[ 0 ]
                field : parts[ 1 ]
                if [ who == 'low' ] pilot_line[ low.pilot, field, x ]
                if [ who == 'high' ] pilot_line[ high.pilot, field, x ]
                if [ who == 'tanker' ] pilot_line[ tanker_pilot, field, x ]
        # each computer restarts from the ship it flies, flying
        # it (or not) as it was
        ours_low : (lower == 0) ? stack : booster
        ours_high : (lower == 0) ? stack : orbiter
        if [ ours_low ] low.align[ ours_low ]
        if [ ours_high ] high.align[ ours_high ]
        # then each takes back what it believed
        nav_back[ low.filter, nav_lo ]
        nav_back[ high.filter, nav_hi ]
        if [ flown.count >= 4 ]
            low.steers = flown[ 0 ] > 0.5
            high.steers = flown[ 1 ] > 0.5
            low.ready = flown[ 2 ] > 0.5
            high.ready = flown[ 3 ] > 0.5
        note[ 'loaded the flight from {from}' ]
        return true

    func note [ what: string ]
        line : 'T{met}: {what}'
        if [ label ] line = 'T{met}: {label}: {what}'
        events.push[ line ]
        log 'mission: {line}'

    # on its legs: the feet on the deck, 1.6 m under the engines
    func clamp_down []
        stack.stand[ site_lat, site_lon, deck_h - LEG_FOOT_X ]

    func turn [ t: f64 ] -> f64
        return earth_turn[ t, 0.0 ]

    # the believed state of a vehicle's body point, inertial
    func believed_point [ a_v: Avionics, p: Dvec ] -> Dvec
        return a_v.filter.body_point[ p ]

    # local east, north, up at an inertial place now
    func frame [ r: Dvec, t: f64 ] -> Frame
        ang : f64 [ turn[ t ] ]
        geo : ecef_to_geodetic[ eci_to_ecef[ r, ang ] ]
        return Frame [ east: ecef_to_eci[ enu_east[ geo.x, geo.y ], ang ],
                       north: ecef_to_eci[ enu_north[ geo.x, geo.y ],
                                           ang ],
                       up: ecef_to_eci[ enu_up[ geo.x, geo.y ], ang ] ]

    func air_speed [ r: Dvec, v: Dvec ] -> Dvec
        return dv_sub[ v, dv_cross[ Dvec [ 0.0, 0.0, EARTH_SPIN ], r ] ]

    func set_engines [ c: Craft, which: vec i32, throttle: f64 ]
        for [ i: i32 0, i < c.engines.count, i += 1 ]
            c.engines[ i ].lit = false
        for [ k: i32 ] in which
            if [ k < c.engines.count ]
                c.engines[ k ].lit = true
                c.engines[ k ].throttle = throttle

    func height [ r: Dvec, t: f64 ] -> f64
        g : ecef_to_geodetic[ eci_to_ecef[ r, turn[ t ] ] ]
        return g.z

    # propellant the booster must keep to come home, kg: the
    # boostback (1.8 times its speed across), entry, landing;
    # measured on the tanker's flight (an estimate)
    func reserve [ vh: f64 ] -> f64
        dv : f64 [ 1.8 * vh + 950.0 + 750.0 ]
        isp : f64 [ 352.0 * GRAVITY_STD ]
        spare : f64 [ 2000.0 * SHIP_LONG * SHIP_WIDE * SHIP_WIDE
                      * boosters ]
        return booster_dry * (exp[ dv / isp ] - 1.0) + spare

    # one physics step of h seconds for everything flying
    public func step [ h: f64 ]
        met += h
        if [ recovery ]
            think += h
            go : bool [ think >= 0.5 ]
            if [ go ]
                think -= 0.5
                read_deck_wind[]
            if [ booster && (lower < 7 || (lower == 7 && !settled)) ]
                booster_phase[ go ]
                booster.step[ h ]
                low.tick[ booster, h ]
                splashed[]
                if [ lower >= 6 ] watch_touchdown[]
            return
        if [ sides ]
            for [ sm: Mission ] in sides
                sm.step[ h ]
        if [ met < 0.0 ]
            if [ met >= -3.0 && !stack.engines[ 0 ].lit ]
                # every engine of the bottom stage
                for [ e: Engine ] in stack.engines
                    if [ e.group == 'one' ]
                        e.lit = true
                        e.throttle = 1.0
                note[ 'ignition, held down' ]
            clamp_down[]
            stack.time += h
            return
        # in its orbit it keeps station; on its deck it waits
        if [ tanker ]
            if [ !tanker_on_pad ] keep_tanker[ h ]
            # one clock for both: placed at liftoff, it waits for us
            flying : (lower == 0) ? stack : orbiter
            if [ tanker.time <= flying.time + h * 0.001 ]
                tanker.step[ h ]
        if [ lower == 0 && !low.ready ]
            low.align[ stack ]
            high.align[ stack ]
            low.pilot.use_jets = false
            note[ 'liftoff' ]
        think += h
        decide : bool [ think >= 0.5 ]
        if [ decide ]
            think -= 0.5
            read_deck_wind[]
        if [ lower == 0 ]
            ascent[ decide ]
            if [ whole && decide ] feed_check[]
        el [ booster ]
            booster_phase[ decide ]
        if [ upper >= 1 ] orbiter_phase[ decide ]
        # the physics, then each computer on its own vehicle
        if [ lower == 0 ]
            stack.step[ h ]
            low.tick[ stack, h ]
            high.tick[ stack, h ]
            # the legs fold the moment no foot bears on the deck
            if [ stack.legs.count > 0 && stack.legs[ 0 ].out ]
                bearing : bool [ false ]
                for [ g: Leg ] in stack.legs
                    if [ g.load > 0.0 ] bearing = true
                if [ !bearing ]
                    # the deck's contacts are not a landing's
                    for [ g: Leg ] in stack.legs
                        g.out = false
                        g.touch_t = -1.0
                    note[ 'legs stowed' ]
        el
            # after touchdown its physics runs on while it settles
            if [ booster && (lower < 7 || (lower == 7 && !settled)) ]
                booster.step[ h ]
                low.tick[ booster, h ]
                splashed[]
                if [ lower >= 6 ] watch_touchdown[]
            orbiter.step[ h ]
            high.tick[ orbiter, h ]
            if [ fairing ]
                fairing.step[ h ]
        # both ships at one moment now: the touch, the latch, the
        # propellant moving
        if [ upper >= 12 && upper <= 17 ] port_gear[]
        if [ upper == 12 ] contact[]
        if [ upper >= 13 && upper <= 15 ]
            ride_tanker[]
            refuel[ h ]
        if [ upper == 15 ] undock[]

    # the lean from vertical (rad) toward the east, every 5 s from
    # T+25 to T+135: the calm climb along its airflow, flown as a
    # plan; between, a straight line; after, the last
    func planned_lean [ t: f64 ] -> f64
        plan_l : vec f64 [] [ 0.112805, 0.154005, 0.192612, 0.23355,
            0.276485, 0.320782, 0.368434, 0.419255, 0.472369,
            0.5272, 0.58291, 0.63693, 0.68711, 0.733428, 0.775968,
            0.814916, 0.850518, 0.883026, 0.912638, 0.93958,
            0.964044, 0.986224, 1.00629 ]
        at : f64 [ (t - 25.0) / 5.0 ]
        if [ at <= 0.0 ] return plan_l[ 0 ]
        last : i32 [ plan_l.count - 1 ]
        if [ at >= f64[ last ] ] return plan_l[ last ]
        i : i32 [ i32[ at ] ]
        fr_t : f64 [ at - f64[ i ] ]
        return plan_l[ i ] + (plan_l[ i + 1 ] - plan_l[ i ]) * fr_t

    # the stack: up, a small kick east, then the pitch plan
    func ascent [ decide: bool ]
        if [ whole && upper >= 2 ] return
        nv : low.filter
        fr : frame[ nv.r, nv.time ]
        east : fr.east
        up : fr.up
        rel : air_speed[ nv.r, nv.v ]
        axis : up
        if [ met > 10.0 && met <= 25.0 ]
            tip : f64 [ degrees[ kick ] * (met - 10.0) / 15.0 ]
            axis = dv_add[ dv_scale[ up, cos[ tip ] ],
                           dv_scale[ east, sin[ tip ] ] ]
        el [ met > 25.0 ]
            # the pitch plan, against the ground: wind can push the
            # climb aside but never turn it
            lean : f64 [ lean_now[] ]
            axis = dv_add[ dv_scale[ up, cos[ lean ] ],
                           dv_scale[ east, sin[ lean ] ] ]
        low.pilot.axis = axis
        # through max-Q at 70 percent
        th : f64 [ (met > 45.0 && met < 75.0) ? 0.7 : 1.0 ]
        for [ e: Engine ] in stack.engines
            if [ e.group == 'one' ] e.throttle = th
        if [ whole ] hold_g[ stack ]
        if [ !decide ] return
        if [ whole ]
            whole_ascent[]
            return
        # cut off once what is left is what the return needs
        vr : f64 [ dv_dot[ rel, up ] ]
        vh : f64 [ dv_len[ dv_sub[ rel, dv_scale[ up, vr ] ] ] ]
        left : f64 [ 0.0 ]
        for [ i: i32 0, i < stack.tanks.count, i += 1 ]
            if [ stack.tanks[ i ].group == 'one' ]
                left += stack.state.prop[ i ]
        # the tanker's three stage on their reserve alone
        high_enough : bool [ !tanker_flight
                             && height[ nv.r, nv.time ] >= sep_alt ]
        if [ left <= reserve[ vh ] || high_enough ]
            for [ e: Engine ] in stack.engines
                e.lit = false
            alt : f64 [ height[ nv.r, nv.time ] / 1000.0 ]
            note[ 'MECO at {alt} km, {vh} m/s across, {left} kg kept' ]
            separate[]

    # the whole ship climbing: when the booster's tanks run dry
    # its engines draw stage two's; past the pitch plan the
    # ship steers itself into orbit, as the upper stage would
    func whole_ascent []
        # the plan through the thick air, then the solved line,
        # starting from the plan's own pitch
        if [ met < 80.0 ] return
        lt_a = tan[ 1.5707963 - lean_now[] ]
        lt_b = lt_a / 200.0
        lt_at = met
        orbiter = stack
        upper = 2
        hand_t = met
        low.steers = false
        high.steers = true
        high.pilot.use_jets = true
        note[ 'the ship steers for orbit' ]

    # the share of the push along the local up that reaches
    # park_alt with no climb left as orbital speed comes: the
    # burn left by the rocket equation (it lightens as it
    # burns), the vertical push falling in a straight line
    func insertion_up [ c: Craft, rr: f64, vr: f64, vh: f64 ] -> f64
        push : push_of[ c ]
        acc : f64 [ push.x / c.mass ]
        if [ acc < 1.0 ] acc = 1.0
        g : f64 [ EARTH_GM / (rr * rr) ]
        park : f64 [ EARTH_A + park_height[] ]
        vc : f64 [ sqrt[ EARTH_GM / park ] ]
        ve : f64 [ (push.y > 0.0) ? push.x / push.y : 3400.0 ]
        tau : f64 [ ve / acc ]
        gain : f64 [ max[ vc - vh, 0.0 ] ]
        t_go : f64 [ max[ tau * (1.0 - exp[ 0.0 - gain / ve ]),
                          2.0 ] ]
        dh : f64 [ park - rr ]
        a_up : f64 [ (6.0 * dh - 4.0 * vr * t_go) / (t_go * t_go) ]
        k : f64 [ (a_up + g - vh * vh / rr) / acc ]
        if [ k > 0.9 ] k = 0.9
        if [ k < -0.6 ] k = -0.6
        return k

    # the orbit the climb ends in (m up): the whole ship arcs
    # straight to the tanker's; the upper stage parks under it
    func park_height [] -> f64
        return (whole) ? tanker_alt : park_alt

    # the pitch plan's axis now, along the pad's east
    func plan_axis [ nv: Nav ] -> Dvec
        fr : frame[ nv.r, nv.time ]
        lean : f64 [ lean_now[] ]
        return dv_add[ dv_scale[ fr.up, cos[ lean ] ],
                       dv_scale[ fr.east, sin[ lean ] ] ]

    # the whole ship holds under WHOLE_G: throttled back, then
    # down from seven engines to three (the centre and two
    # facing) to the centre alone when those lit at their least
    # push too hard
    func hold_g [ c: Craft ]
        most : f64 [ WHOLE_G * GRAVITY_STD * c.mass ]
        mid : c.engines[ 0 ]
        if [ !mid.lit ] return
        lit : i32 [ 0 ]
        for [ e: Engine ] in c.engines
            if [ e.lit ] lit += 1
        share : f64 [ most / (lit * mid.thrust_vac) ]
        if [ share < mid.throttle_min && lit > 1 ]
            keep : vec i32 [] [ 0 ]
            if [ lit > 3 ]
                keep = centre_three[ c ]
            set_engines[ c, keep, 1.0 ]
            lit = keep.count
            share = most / (lit * mid.thrust_vac)
            note[ 'down to {lit} engines' ]
        for [ e: Engine ] in c.engines
            if [ e.lit ]
                e.throttle = min[ e.throttle, share ]

    # the booster's tanks dry: its engines draw stage two's
    func feed_check []
        if [ fed_up || !stack ] return
        if [ stack.state.prop[ 0 ] > 0.0
             && stack.state.prop[ 1 ] > 0.0 ] return
        crossfeed[ stack ]
        fed_up = true
        alt : f64 [ height[ high.filter.r, high.filter.time ] / 1000.0 ]
        note[ 'booster tanks dry at {alt} km: the engines draw stage two\'s' ]

    # the plan's lean now; the whole ship climbs steeper (rad)
    func lean_now [] -> f64
        return planned_lean[ met ] * ((whole) ? WHOLE_LEAN : 1.0)

    # the rest of the whole ship's burn flown ahead in a plane,
    # point mass, 1 s steps: the nose's tangent over the
    # horizon ta - tb t, the push held under WHOLE_G and its
    # engines stepped down as hold_g does; ends at the tanker's
    # orbit size (its angular momentum, m2/s) or dry: its
    # radius, climb (m/s) and time
    func fly_ahead [ c: Craft, ta: f64, tb: f64, r0: f64, vr0: f64,
                     vh0: f64, h_end: f64 ] -> Dvec
        mid : c.engines[ 0 ]
        one : f64 [ mid.thrust_vac ]
        ve : f64 [ mid.thrust_vac / mid.flow ]
        n : f64 [ 0.0 ]
        for [ e: Engine ] in c.engines
            if [ e.lit ] n += 1.0
        cap : f64 [ WHOLE_G * GRAVITY_STD ]
        r : f64 [ r0 ]
        vr : f64 [ vr0 ]
        vh : f64 [ vh0 ]
        m : f64 [ c.mass ]
        fuel : f64 [ c.propellant[] ]
        t : f64 [ 0.0 ]
        dt : f64 [ 1.0 ]
        while [ t < 900.0 ]
            if [ r * vh >= h_end || fuel <= 0.0 ] break
            if [ n > 1.0 && n * one * mid.throttle_min > cap * m ]
                n = (n > 3.0) ? 3.0 : 1.0
            f : f64 [ min[ n * one, cap * m ] ]
            tn : f64 [ ta - tb * t ]
            cp : f64 [ 1.0 / sqrt[ 1.0 + tn * tn ] ]
            acc : f64 [ f / m ]
            vr += (acc * tn * cp - EARTH_GM / (r * r) + vh * vh / r) * dt
            vh += (acc * cp - vr * vh / r) * dt
            r += vr * dt
            burn : f64 [ f / ve * dt ]
            m -= burn
            fuel -= burn
            t += dt
        return Dvec [ r, vr, t ]

    # the linear tangent climb (the best steering for a burn to
    # orbit, Bryson and Ho): ta and tb by Newton's method so the
    # burn flown ahead ends at the tanker's orbit size, stand
    # metres under it, climbing as it climbs
    func steer_solve [ c: Craft, r: f64, vr: f64, vh: f64 ]
        # no tanker up yet: level and round at the parking height
        top : f64 [ EARTH_A + park_height[] ]
        climb : f64 [ 0.0 ]
        h_end : f64 [ sqrt[ EARTH_GM * top ] ]
        if [ tanker ]
            tr : tanker.state.r
            tv : tanker.state.v
            tl : f64 [ dv_len[ tr ] ]
            top = tl - stand
            climb = dv_dot[ tv, tr ] / tl
            h_end = dv_len[ dv_cross[ tr, tv ] ]
        # the line moved to now, so its pitch keeps on
        lt_a = lt_a - lt_b * (met - lt_at)
        lt_at = met
        for [ it: i32 0, it < 6, it += 1 ]
            e0 : fly_ahead[ c, lt_a, lt_b, r, vr, vh, h_end ]
            if [ e0.z < 15.0 ] return
            fa : fly_ahead[ c, lt_a + 0.01, lt_b, r, vr, vh, h_end ]
            fb : fly_ahead[ c, lt_a, lt_b + 0.0001, r, vr, vh, h_end ]
            ra : f64 [ (e0.x - top) / 1000.0 ]
            rv : f64 [ (e0.y - climb) / 100.0 ]
            j11 : f64 [ (fa.x - e0.x) / 1000.0 / 0.01 ]
            j21 : f64 [ (fa.y - e0.y) / 100.0 / 0.01 ]
            j12 : f64 [ (fb.x - e0.x) / 1000.0 / 0.0001 ]
            j22 : f64 [ (fb.y - e0.y) / 100.0 / 0.0001 ]
            det : f64 [ j11 * j22 - j12 * j21 ]
            if [ abs[ det ] < 1e-12 ] return
            da : f64 [ (ra * j22 - rv * j12) / det ]
            db : f64 [ (j11 * rv - j21 * ra) / det ]
            lt_a -= clamp_d[ da, -0.2, 0.2 ]
            lt_b -= clamp_d[ db, -0.002, 0.002 ]
            if [ abs[ ra ] < 0.05 && abs[ rv ] < 0.05 ] return

    # the nose's share up the radius now, on the solved line
    func steer_up [] -> f64
        tn : f64 [ lt_a - lt_b * (met - lt_at) ]
        return tn / sqrt[ 1.0 + tn * tn ]

    # every booster engine fed from stage two's tanks
    func crossfeed [ c: Craft ]
        for [ e: Engine ] in c.engines
            if [ e.group != 'one' ] continue
            e.oxidiser = 'lox two'
            e.fuel = 'rp1 two'

    # what the lit engines push and burn now (N, kg/s)
    func push_of [ c: Craft ] -> Dvec
        f : f64 [ 0.0 ]
        m : f64 [ 0.0 ]
        for [ e: Engine ] in c.engines
            if [ !e.lit || e.force <= 0.0 ] continue
            f += e.force
            m += e.flow * max[ e.throttle, e.throttle_min ]
        return Dvec [ f, m, 0.0 ]

    # a recovery flight takes its booster at staging: home to
    # the deck at lat, lon
    public func adopt [ c: Craft, lat: f64, lon: f64, dk: Deck,
                        now: f64 ]
        booster = c
        c.deck = dk
        site_lat = lat
        site_lon = lon
        target = geodetic_to_ecef[ lat, lon, deck_h ]
        aim = target
        plat_ant = geodetic_to_ecef[ lat, lon, deck_h + 2.0 ]
        low.receiver.base = platform
        low.receiver.base_at = plat_ant
        boosters = 1.0
        booster_dry = 25600.0 * SHIP_LONG * SHIP_WIDE * SHIP_WIDE
        met = now
        sep_t = now
        lower = 1
        low.align[ c ]
        low.pilot.use_gimbal = true
        low.pilot.use_jets = true
        for [ f: Fin ] in c.fins
            f.open = true
        low.pilot.use_fins = true
        low.pilot.max_rate = 0.12

    func separate []
        upper_groups : vec string [] [ 'two', 'fairing' ]
        orbiter = stack.detach[ upper_groups ]
        # the crew stage comes home to the third platform
        orbiter.deck = deck_three
        if [ crew_home ]
            high.receiver.base = platform2
            high.receiver.base_at = plat2_ant
            # its small legs are its landing legs: swung 136 deg
            # from stowed, the foot 7 m under the skirt
            for [ g: Leg ] in orbiter.flaps
                rl : f64 [ sqrt[ g.hinge.y * g.hinge.y
                                 + g.hinge.z * g.hinge.z ] ]
                ry : f64 [ g.hinge.y / rl ]
                rz : f64 [ g.hinge.z / rl ]
                th : f64 [ 136.0 * 3.14159265358979 / 180.0 ]
                out : f64 [ rl + g.length * sin[ th ] ]
                g.foot_out = Dvec [ g.hinge.x + g.length * cos[ th ],
                                    ry * out, rz * out ]
                g.foot = g.foot_out
                g.out = false
                g.frac = 0.0
                orbiter.legs.push[ g ]
        booster = stack
        stack = null
        # the tanker's side boosters let go of the middle one (the
        # joints stay on it) and fly home on their own: the left
        # to deck F, the right to deck C, both against deck B
        if [ tanker_flight ]
            sides = vec Mission []
            gap : f64 [ 3.66 * SHIP_WIDE + 1.5 ]
            ways : vec f64 [] [ gap, 0.0 - gap ]
            names : vec string [] [ 'left', 'right' ]
            for [ k: i32 0, k < 2, k += 1 ]
                at : Dvec [ 0.0, 0.0, ways[ k ] ]
                booster.mark_side[ at, names[ k ] ]
                grp : vec string [] [ names[ k ] ]
                side : booster.detach[ grp ]
                side.recentre[ at ]
                sm : Mission [ recovery: true, landing: landing,
                               label: '{names[ k ]} booster' ]
                lat : f64 [ (k == 0) ? deck_lats[ 2 ] : pad3_lat ]
                lon : f64 [ (k == 0) ? deck_lons[ 2 ] : pad3_lon ]
                dk : (k == 0) ? more_decks[ 2 ] : deck_three
                sm.adopt[ side, lat, lon, dk, met ]
                sides.push[ sm ]
            boosters = 1.0
            booster_dry = 25600.0 * SHIP_LONG * SHIP_WIDE * SHIP_WIDE
            # each one lands alone: all six of its legs are free
            for [ g: Leg ] in booster.legs
                g.folded = false
            for [ sm: Mission ] in sides
                for [ g: Leg ] in sm.booster.legs
                    g.folded = false
        # the pushers: half a metre a second apart
        ax : q_rotate[ booster.state.q, Dvec [ 1.0, 0.0, 0.0 ] ]
        orbiter.state.v = dv_add[ orbiter.state.v, dv_scale[ ax, 0.4 ] ]
        booster.state.v = dv_sub[ booster.state.v, dv_scale[ ax, 0.1 ] ]
        sep_t = met
        lower = 1
        upper = 1
        high.steers = true
        high.pilot.use_jets = true
        low.pilot.use_gimbal = true
        low.pilot.use_jets = true
        # the grid fins out at once, for the flip and the boostback
        for [ f: Fin ] in booster.fins
            f.open = true
        low.pilot.use_fins = true
        low.pilot.max_rate = 0.12
        note[ 'stage separation' ]

    # the crew ship home to deck two, on its own engines all the
    # way (falling unpowered it does not hold its attitude): a
    # turn on the jets, a boostback on all five, then the centre
    # one throttled down a slowing descent toward the deck, the
    # gimbal steering, legs out under 1.5 km, off at the touch
    func crew_return [ decide: bool ]
        c : orbiter
        nv : high.filter
        ang : f64 [ turn[ nv.time ] ]
        mark : ecef_to_eci[ aim2, ang ]
        fr : frame[ mark, nv.time ]
        up : fr.up
        fx : f64 [ (c.legs.count > 0) ? c.legs[ 0 ].foot_out.x : 0.0 ]
        feet : nv.body_point[ Dvec [ fx, 0.0, 0.0 ] ]
        d : dv_sub[ feet, mark ]
        h : f64 [ dv_dot[ d, up ] ]
        dh : dv_sub[ d, dv_scale[ up, h ] ]
        dist : f64 [ dv_len[ dh ] ]
        rel : air_speed[ nv.r, nv.v ]
        vz : f64 [ dv_dot[ rel, up ] ]
        vh : dv_sub[ rel, dv_scale[ up, vz ] ]
        if [ upper == 1 ]
            upper = 20
            crew_t = met
            note[ 'the crew ship turns for home: deck three, {dist / 1000.0} km off' ]
        if [ upper >= 23 ] return
        # the speed it wants: toward the deck, slowing as it nears;
        # down, slowing to touch at 1.5 m/s
        far : bool [ upper <= 21 ]
        brake_h : f64 [ (far) ? 2.0 : 0.6 ]
        top_h : f64 [ (far) ? 900.0 : 250.0 ]
        toward : dv_scale[ dh, -1.0 / max[ dist, 0.001 ] ]
        sh : f64 [ min[ top_h, sqrt[ 2.0 * brake_h * dist ] ] ]
        hz : f64 [ max[ h, 0.0 ] ]
        sz : f64 [ min[ 300.0, sqrt[ 2.0 * 1.5 * hz ] ] + 1.5 ]
        # down no faster than it closes on the deck: the height
        # gone as the distance is
        left : f64 [ dist / max[ sh, 1.0 ] ]
        sz = min[ sz, hz / max[ left, 1.0 ] + 1.5 ]
        want : dv_sub[ dv_scale[ toward, sh ], dv_scale[ up, sz ] ]
        # far out the boostback leaves the climb as it is
        if [ far ]
            want = dv_add[ dv_scale[ toward, sh ], dv_scale[ up, vz ] ]
        # the push that gets it there in 4 s, against gravity
        g : f64 [ dv_len[ gravity[ nv.r ] ] ]
        acc : dv_add[ dv_scale[ dv_sub[ want, rel ], 0.25 ],
                      dv_scale[ up, g ] ]
        # near the ground keep within 20 deg of upright
        if [ !far ]
            av : f64 [ dv_dot[ acc, up ] ]
            side : dv_sub[ acc, dv_scale[ up, av ] ]
            sl : f64 [ dv_len[ side ] ]
            most : f64 [ max[ av, 0.0 ] * 0.364 ]
            if [ sl > most ]
                acc = dv_add[ dv_scale[ up, av ],
                              dv_scale[ side, most / sl ] ]
        aim_dir : dv_norm[ acc ]
        high.pilot.axis = aim_dir
        if [ upper == 20 ]
            # the turn, on the jets; then all five light
            if [ met - crew_t > 4.0 && high.pilot.error < 0.17 ]
                for [ e: Engine ] in c.engines
                    e.lit = true
                    e.throttle = 1.0
                high.pilot.use_gimbal = true
                upper = 21
                note[ 'crew ship boostback on five' ]
            return
        # the throttle for the push asked, on the engines lit
        thrust : f64 [ 0.0 ]
        for [ e: Engine ] in c.engines
            if [ e.lit ] thrust += e.thrust_vac
        need : f64 [ dv_len[ acc ] * c.mass ]
        th : f64 [ (thrust > 0.0) ? need / thrust : 0.0 ]
        for [ e: Engine ] in c.engines
            if [ e.lit ]
                e.throttle = min[ max[ th, e.throttle_min ], 1.0 ]
        if [ upper == 21 ]
            # headed home and not falling back up: one engine on
            back : f64 [ dv_dot[ vh, toward ] ]
            miss_v : f64 [ dv_len[ dv_sub[ vh, dv_scale[ toward, sh ] ] ] ]
            if [ back > 0.0 && miss_v < 60.0 ]
                for [ k: i32 1, k < c.engines.count, k += 1 ]
                    c.engines[ k ].lit = false
                upper = 22
                note[ 'crew ship down on one engine, {dist / 1000.0} km off at {h / 1000.0} km up' ]
            return
        # legs out under 1.5 km
        if [ h < 1500.0 && c.legs.count > 0 && !c.legs[ 0 ].out ]
            for [ g2: Leg ] in c.legs
                g2.out = true
            note[ 'crew ship legs out at {h} m, {dist} m off, {dv_len[ vh ]} m/s across, {0.0 - vz} m/s down, {c.propellant[] / 1000.0} t left' ]
        # a foot on the deck: off
        touched : bool [ false ]
        for [ g3: Leg ] in c.legs
            if [ g3.touch_t >= 0.0 ] touched = true
        if [ touched ]
            for [ e: Engine ] in c.engines
                e.lit = false
            upper = 23
            off : f64 [ dist ]
            note[ 'crew ship down on deck three, {off} m from its mark at {0.0 - vz} m/s' ]

    # the upper stage: light after 8 s, climb to its orbit, cut off
    # at orbital speed
    func orbiter_phase [ decide: bool ]
        if [ crew_home ]
            crew_return[ decide ]
            return
        nv : high.filter
        fr : frame[ nv.r, nv.time ]
        up : fr.up
        rr : f64 [ dv_len[ nv.r ] ]
        vr : f64 [ dv_dot[ nv.v, up ] ]
        hv : dv_sub[ nv.v, dv_scale[ up, vr ] ]
        vh : f64 [ dv_len[ hv ] ]
        if [ upper == 1 ]
            high.pilot.axis = dv_norm[ nv.v ]
            if [ met >= sep_t + 8.0 ]
                # all its engines for the climb to orbit
                for [ e: Engine ] in orbiter.engines
                    e.lit = true
                    e.throttle = 1.0
                upper = 2
                if [ tanker_flight ]
                    # the line starts on its path's own slope
                    gam : f64 [ max[ vr / max[ vh, 1.0 ], 0.05 ] ]
                    lt_a = gam
                    lt_b = gam / 200.0
                    lt_at = met
                lit_n : i32 [ orbiter.engines.count ]
                who : string [ (tanker_flight) ? 'the top booster'
                               : 'the crew ship' ]
                note[ '{who} lights its {lit_n}' ]
            return
        if [ upper == 2 ]
            k : f64 [ 0.0 ]
            want : Dvec [ 0.0, 0.0, 0.0 ]
            steered : bool [ whole || tanker_flight ]
            if [ steered ]
                ru : dv_norm[ nv.r ]
                cr : f64 [ dv_dot[ nv.v, ru ] ]
                ch : f64 [ dv_len[ dv_sub[ nv.v, dv_scale[ ru, cr ] ] ] ]
                if [ decide ] steer_solve[ orbiter, rr, cr, ch ]
                k = steer_up[]
                want = dv_add[ dv_scale[ ru, k ],
                               dv_scale[ in_plane[ nv.r, nv.v ],
                                         sqrt[ 1.0 - k * k ] ] ]
            el
                k = insertion_up[ orbiter, rr, vr, vh ]
                want = dv_add[ dv_scale[ up, k ],
                               dv_scale[ in_plane[ nv.r, nv.v ],
                                         sqrt[ 1.0 - k * k ] ] ]
            if [ steered ] hold_g[ orbiter ]
            # the whole ship eases off its plan over 20 s: one arc
            if [ whole && met < hand_t + 20.0 ]
                b : f64 [ (met - hand_t) / 20.0 ]
                b = b * b * (3.0 - 2.0 * b)
                want = dv_norm[ dv_add[ dv_scale[ plan_axis[ nv ],
                                                  1.0 - b ],
                                        dv_scale[ want, b ] ] ]
            high.pilot.axis = want
            # the nose is the crew's cabin: it is never let go
            # its speed reached, its orbit clear of the air
            ends : apsides[ nv.r, nv.v ]
            top : f64 [ EARTH_A + park_height[] ]
            # the whole ship: round at the tanker's height, or its
            # high point past it with the low clear of the air
            # the whole ship cuts off at the tanker's orbit size
            h_tk : f64 [ sqrt[ EARTH_GM * top ] ]
            if [ tanker ]
                h_tk = dv_len[ dv_cross[ tanker.state.r, tanker.state.v ] ]
            enough : bool [ (steered) ? rr * vh >= h_tk
                            : vh >= sqrt[ EARTH_GM / rr ] ]
            done : bool [ enough && ends.y >= EARTH_A + 150000.0 ]
            if [ done ]
                for [ e: Engine ] in orbiter.engines
                    e.lit = false
                upper = 3
                alt : f64 [ (rr - EARTH_A) / 1000.0 ]
                note[ 'SECO at {alt} km, {vh} m/s, climbing {vr} m/s' ]
                got : orbit_range[ nv.r, nv.v, period_at[ rr ] ]
                lo_km : f64 [ (got.y - EARTH_A) / 1000.0 ]
                hi_km : f64 [ (got.x - EARTH_A) / 1000.0 ]
                note[ 'the orbit: {lo_km} to {hi_km} km' ]
                if [ tanker ]
                    off : f64 [ dv_dot[ nv.r, tanker_normal[] ] / 1000.0 ]
                    ph : f64 [ tanker_phase[ nv.r, nv.v ] * 57.2957795 ]
                    need : f64 [ transfer_phase[ rr ] * 57.2957795 ]
                    note[ 'the tanker {ph} deg ahead (the transfer needs {need}), {off} km off its plane' ]
            return
        # climbing or falling along the radius, not the local up
        chase[ nv.r, nv.v, rr, dv_dot[ nv.v, dv_norm[ nv.r ] ] ]

    # the tanker's orbit: its plane's normal, its radius
    func tanker_normal [] -> Dvec
        return dv_norm[ dv_cross[ tanker.state.r, tanker.state.v ] ]

    func tanker_radius [] -> f64
        return dv_len[ tanker.state.r ]

    # horizontal and forward in the tanker's plane, leaning to
    # take out what we move across it (sideways drift)
    func in_plane [ r: Dvec, v: Dvec ] -> Dvec
        # no tanker up yet (its own flight): its own way, level
        if [ !tanker ]
            ru : dv_norm[ r ]
            return dv_norm[ dv_sub[ v, dv_scale[ ru, dv_dot[ v, ru ] ] ] ]
        n : tanker_normal[]
        fwd : dv_norm[ dv_cross[ n, r ] ]
        across : f64 [ dv_dot[ v, n ] + dv_dot[ r, n ] * 0.01 ]
        k : f64 [ min[ max[ 0.0 - across / 200.0, -0.3 ], 0.3 ] ]
        return dv_norm[ dv_add[ fwd, dv_scale[ n, k ] ] ]

    # how far ahead of us the tanker is round our orbit (rad)
    func tanker_phase [ r: Dvec, v: Dvec ] -> f64
        h : dv_norm[ dv_cross[ r, v ] ]
        a : dv_norm[ r ]
        b : dv_norm[ tanker.state.r ]
        return atan2[ dv_dot[ dv_cross[ a, b ], h ], dv_dot[ a, b ] ]

    # how far ahead the tanker must be as we start a half-orbit
    # transfer from radius r1 to it (rad)
    func transfer_phase [ r1: f64 ] -> f64
        r2 : f64 [ tanker_radius[] ]
        at : f64 [ (r1 + r2) * 0.5 ]
        t_tr : f64 [ 3.14159265358979 * sqrt[ at * at * at / EARTH_GM ] ]
        n2 : f64 [ sqrt[ EARTH_GM / (r2 * r2 * r2) ] ]
        return 3.14159265358979 - n2 * t_tr

    # an orbit's high and low points from a place and speed (m
    # from the centre): x apoapsis, y periapsis
    func apsides [ r: Dvec, v: Dvec ] -> Dvec
        rr : f64 [ dv_len[ r ] ]
        vv : f64 [ dv_dot[ v, v ] ]
        a : f64 [ 1.0 / (2.0 / rr - vv / EARTH_GM) ]
        hh : f64 [ dv_len[ dv_cross[ r, v ] ] ]
        e : f64 [ sqrt[ max[ 0.0, 1.0 - hh * hh / (EARTH_GM * a) ] ] ]
        return Dvec [ a * (1.0 + e), a * (1.0 - e), 0.0 ]

    # the highest and lowest an orbit really reaches over span
    # seconds, flown in our gravity (its flattening included),
    # from a place and speed (m from the centre)
    func orbit_range [ r0: Dvec, v0: Dvec, span: f64 ] -> Dvec
        r : r0
        v : v0
        hi : f64 [ dv_len[ r ] ]
        lo : f64 [ hi ]
        dt : f64 [ 10.0 ]
        for [ t: f64 0.0, t < span, t += dt ]
            k1v : gravity[ r ]
            k1r : v
            r2 : dv_add[ r, dv_scale[ k1r, dt * 0.5 ] ]
            v2 : dv_add[ v, dv_scale[ k1v, dt * 0.5 ] ]
            k2v : gravity[ r2 ]
            r3 : dv_add[ r, dv_scale[ v2, dt * 0.5 ] ]
            v3 : dv_add[ v, dv_scale[ k2v, dt * 0.5 ] ]
            k3v : gravity[ r3 ]
            r4 : dv_add[ r, dv_scale[ v3, dt ] ]
            v4 : dv_add[ v, dv_scale[ k3v, dt ] ]
            k4v : gravity[ r4 ]
            r = dv_add[ r, dv_scale[ dv_add[ dv_add[ k1r, v4 ],
                        dv_scale[ dv_add[ v2, v3 ], 2.0 ] ], dt / 6.0 ] ]
            v = dv_add[ v, dv_scale[ dv_add[ dv_add[ k1v, k4v ],
                        dv_scale[ dv_add[ k2v, k3v ], 2.0 ] ],
                        dt / 6.0 ] ]
            rr : f64 [ dv_len[ r ] ]
            if [ rr > hi ] hi = rr
            if [ rr < lo ] lo = rr
        return Dvec [ hi, lo, 0.0 ]

    # one orbit's time at radius rr
    func period_at [ rr: f64 ] -> f64
        return 6.28318530717959 * sqrt[ rr * rr * rr / EARTH_GM ]

    # from the parking orbit up to the tanker: wait for its
    # phase, raise the high point to its orbit, coast up, round
    # the orbit off there
    func chase [ r: Dvec, v: Dvec, rr: f64, vr: f64 ]
        # the whole ship cuts off beside the tanker, in its
        # orbit: straight on to the approach
        if [ whole && upper == 3 ] upper = 7
        if [ whole && upper >= 7 ]
            approach[]
            return
        eng : orbiter.engines[ 0 ]
        pro : dv_norm[ v ]
        high.pilot.axis = pro
        ap : apsides[ r, v ]
        if [ upper == 3 && !parked ]
            # the orbit's high point: round the orbit off there
            if [ !trimming ]
                # passing the high point: round off, if not round
                top : bool [ last_vr > 0.0 && vr <= 0.0 ]
                last_vr = vr
                if [ !top ] return
                now : orbit_range[ r, v, period_at[ rr ] ]
                if [ now.y >= now.x - 3000.0 ]
                    parked = true
                    return
                trimming = true
                eng.lit = true
                eng.throttle = 1.0
                note[ 'parking burn' ]
                return
            got : orbit_range[ r, v, period_at[ rr ] ]
            if [ got.y >= got.x - 3000.0 || vr > 10.0 ]
                eng.lit = false
                trimming = false
                parked = true
                lo_km : f64 [ (got.y - EARTH_A) / 1000.0 ]
                hi_km : f64 [ (got.x - EARTH_A) / 1000.0 ]
                note[ 'parked at {lo_km} to {hi_km} km' ]
            return
        # the tanker's own flight: parked in its orbit, done
        if [ upper == 3 && tanker_flight ] return
        if [ upper == 3 && whole ]
            # in the tanker's own orbit already: the close
            # approach takes it from here
            upper = 7
            gap : f64 [ dv_len[ dv_sub[ tanker.state.r, r ] ] ]
            note[ 'in the tanker\'s orbit, {gap / 1000.0} km from it' ]
            return
        if [ upper == 3 ]
            ph : f64 [ tanker_phase[ r, v ] ]
            if [ ph > 0.0 && ph <= transfer_phase[ rr ] ]
                raise_to = tanker_radius[]
                eng.lit = true
                eng.throttle = 1.0
                upper = 4
                note[ 'transfer burn: the tanker {ph * 57.2957795} deg ahead' ]
            return
        if [ upper == 4 ]
            # near the cut, the high point as it will really be
            if [ ap.x >= raise_to - 30000.0
                 && orbit_range[ r, v, period_at[ rr ] * 0.6 ].x
                    >= raise_to ]
                eng.lit = false
                upper = 5
                up_km : f64 [ (ap.x - EARTH_A) / 1000.0 ]
                note[ 'transfer coast to {up_km} km' ]
            return
        if [ upper == 5 ]
            # at the high point the climb turns to a fall
            if [ vr <= 0.0 && rr > raise_to - 20000.0 ]
                eng.lit = true
                eng.throttle = 1.0
                upper = 6
                note[ 'circularising burn' ]
            return
        if [ upper == 6 ]
            near : bool [ ap.y >= raise_to - 30000.0 ]
            got : Dvec [ ap.x, ap.y, 0.0 ]
            if [ near ] got = orbit_range[ r, v, period_at[ rr ] ]
            if [ (near && got.y >= raise_to - 2000.0)
                 || got.x > raise_to + 5000.0 ]
                eng.lit = false
                upper = 7
                gap : f64 [ dv_len[ dv_sub[ tanker.state.r,
                                            orbiter.state.r ] ] ]
                lo_km : f64 [ (got.y - EARTH_A) / 1000.0 ]
                hi_km : f64 [ (got.x - EARTH_A) / 1000.0 ]
                note[ 'in the tanker\'s orbit, {lo_km} to {hi_km} km, {gap / 1000.0} km from it' ]

    # the tanker as its radio says, carried on to time t: its
    # body origin and speed, ECI
    func tanker_at [ t: f64 ] -> vec Dvec
        dt : f64 [ t - link_t ]
        g : gravity[ link_r ]
        r : dv_add[ dv_add[ link_r, dv_scale[ link_v, dt ] ],
                    dv_scale[ g, 0.5 * dt * dt ] ]
        v : dv_add[ link_v, dv_scale[ g, dt ] ]
        return vec Dvec [] [ r, v ]

    # relative GPS: our ranges less the tanker's, same
    # satellites, same moment, sent over its radio; the gap
    # port to port (ECI), smoothed (0.1 of each fix's place,
    # 0.05 of its speed)
    func rel_update []
        rx : high.receiver
        if [ rx.epoch_t <= rel_t ] return
        t : f64 [ rx.epoch_t ]
        ang : f64 [ earth_turn[ t, tanker.turn_start ] ]
        spin : Dvec [ 0.0, 0.0, EARTH_SPIN ]
        # its antenna at our epoch: the tanker has stepped on since
        back : f64 [ t - tanker.time ]
        now_ant : tanker.body_point[ tank_rx.antenna ]
        ant : dv_add[ dv_add[ now_ant, dv_scale[ tanker.state.v, back ] ],
                      dv_scale[ gravity[ now_ant ], 0.5 * back * back ] ]
        tvel : dv_add[ tanker.state.v,
                       dv_scale[ gravity[ now_ant ], back ] ]
        tpe : eci_to_ecef[ ant, ang ]
        tve : eci_to_ecef[ dv_sub[ tvel, dv_cross[ spin, ant ] ], ang ]
        theirs : tank_rx.measure[ t, tpe, tve ]
        tk : tanker_at[ t ]
        near : eci_to_ecef[ dv_add[ tk[ 0 ], q_rotate[ link_q,
                            tank_rx.antenna ] ], ang ]
        fx : relative_fix[ rx.last, theirs, near ]
        if [ fx[ 2 ].x < 4.0 ] return
        d : ecef_to_eci[ fx[ 0 ], ang ]
        dv : dv_add[ ecef_to_eci[ fx[ 1 ], ang ], dv_cross[ spin, d ] ]
        nv : high.filter
        mine : q_rotate[ nv.q, dv_sub[ orbiter.port_at, rx.antenna ] ]
        theirs_arm : q_rotate[ link_q, dv_sub[ tanker.port_at,
                                                tank_rx.antenna ] ]
        arms : dv_sub[ mine, theirs_arm ]
        gap : dv_add[ d, arms ]
        # both turn once an orbit, nose along the path
        hn : dv_cross[ tk[ 0 ], tk[ 1 ] ]
        w : dv_scale[ hn, 1.0 / dv_dot[ tk[ 0 ], tk[ 0 ] ] ]
        gv : dv_add[ dv, dv_cross[ w, arms ] ]
        if [ rel_t < 0.0 ]
            rel_p = gap
            rel_v = gv
        el
            # carried on with our own push (we know what we asked)
            dt : f64 [ t - rel_t ]
            pa : dv_scale[ q_rotate[ nv.q, high.pilot.push ],
                           1.0 / orbiter.mass ]
            pv : dv_add[ rel_v, dv_scale[ pa, dt ] ]
            pred : dv_add[ rel_p, dv_scale[ dv_add[ rel_v, pv ], 0.5 * dt ] ]
            rel_p = dv_add[ pred, dv_scale[ dv_sub[ gap, pred ], 0.1 ] ]
            rel_v = dv_add[ pv, dv_scale[ dv_sub[ gv, pv ], 0.05 ] ]
        rel_t = t

    # the docking net's look from our port cameras (right, up,
    # out m, three angles, the chance it is in range): weighed
    # into the gap by its held-out misses against the gps's
    public func net_fix [ g: vec f64 ]
        if [ !approaching || upper < 10 || upper >= 13 ] return
        if [ rel_t < 0.0 || g.count < 7 || g[ 6 ] < 0.5 ] return
        nv : high.filter
        t : f64 [ nv.time ]
        q : nv.q
        look : q_rotate[ q, orbiter.port_dir ]
        nose : q_rotate[ q, Dvec [ 1.0, 0.0, 0.0 ] ]
        right : dv_cross[ look, nose ]
        # their port from our camera, 0.2 m out of our port
        to : dv_add[ dv_add[ dv_scale[ right, g[ 0 ] ],
                             dv_scale[ nose, g[ 1 ] ] ],
                     dv_scale[ look, g[ 2 ] + 0.2 ] ]
        sighted : dv_scale[ to, -1.0 ]
        pred : dv_add[ rel_p, dv_scale[ rel_v, t - rel_t ] ]
        diff : dv_sub[ sighted, pred ]
        # gps 0.4 m; net 0.82, 2.22, 3.61 m (its held-out misses)
        axes : vec Dvec [] [ right, nose, look ]
        errs : vec f64 [] [ 0.82, 2.22, 3.61 ]
        for [ k: i32 0, k < 3, k += 1 ]
            ax : axes[ k ]
            wt : f64 [ 0.1 * 0.16 / (0.16 + errs[ k ] * errs[ k ]) ]
            rel_p = dv_add[ rel_p, dv_scale[ ax, wt * dv_dot[ diff, ax ] ] ]
        if [ t - net_log < 5.0 ] return
        net_log = t
        tg : dv_sub[ orbiter.body_point[ orbiter.port_at ],
                     tanker.body_point[ tanker.port_at ] ]
        log 'dock net: right {dv_dot[ sighted, right ]} up {dv_dot[ sighted, nose ]} out {dv_dot[ sighted, look ]} m; gps {dv_dot[ pred, right ]} {dv_dot[ pred, nose ]} {dv_dot[ pred, look ]}; true {dv_dot[ tg, right ]} {dv_dot[ tg, nose ]} {dv_dot[ tg, look ]}; in range {g[ 6 ]}'

    # the close approach for the screen: where it is, how far
    # the mark is as we believe it and as it truly is, how fast
    # it closes, the hold's clock
    public func dock_report [] -> vec string
        out : vec string []
        if [ !approaching || !orbiter ] return out
        if [ upper == 13 ]
            out.push[ 'SOFT CAPTURE: both probes in their cones, drawing in ({probe} m out)' ]
            out.push[ latched ]
            return out
        if [ upper >= 16 ]
            tons : f64 [ moved / 1000.0 ]
            mine : orbiter.body_point[ orbiter.port_at ]
            theirs : tanker.body_point[ tanker.port_at ]
            apart : f64 [ dv_len[ dv_sub[ mine, theirs ] ] ]
            state : string [ (upper == 16) ? 'UNDOCKED: backing away'
                             : 'clear of the tanker' ]
            out.push[ '{state}: {apart} m from its ports, {tons} t taken on' ]
            if [ probe > 0.0 || doors > 0.0 ]
                out.push[ 'probes in: {probe} m out, doors {doors * 100.0}% open' ]
            return out
        if [ upper >= 14 ]
            out.push[ 'DOCKED: both ports latched, riding the tanker' ]
            out.push[ latched ]
            tons : f64 [ moved / 1000.0 ]
            ours : f64 [ orbiter.propellant[] / 1000.0 ]
            left : f64 [ tanker.propellant[] / 1000.0 ]
            done : string [ (upper == 15) ? 'refuelled' : 'refuelling at 2 t/s' ]
            out.push[ '{done}: {tons} t moved, ours {ours} t, the tanker {left} t left' ]
            return out
        if [ upper == 12 && doors < 1.0 ]
            out.push[ 'port doors opening: {doors * 100.0}%' ]
        el [ upper == 12 && probe < 2.5 ]
            out.push[ 'probes running out: {probe} m of 2.5' ]
        words : vec string [] [ 'ports turning to face each other',
                                'closing to 200 m under its ports',
                                'closing to 20 m under its ports',
                                'holding 20 m under its ports',
                                'closing to contact',
                                'soft capture: probes drawing in',
                                'docked: ports latched',
                                'refuelled',
                                'undocking: backing away',
                                'clear of the tanker' ]
        at : i32 [ min[ max[ upper - 8, 0 ], 9 ] ]
        toward : dv_scale[ dv_norm[ tanker.state.r ], 0.0 - beneath ]
        mine : orbiter.body_point[ orbiter.port_at ]
        theirs : tanker.body_point[ tanker.port_at ]
        truly : f64 [ dv_len[ dv_sub[ dv_sub[ mine, theirs ],
                                      dv_scale[ toward, stand ] ] ] ]
        if [ rel_t < 0.0 ]
            out.push[ 'docking: {words[ at ]}, relative gps not yet fixed, mark truly {truly} m away' ]
            return out
        gap : dv_add[ rel_p, dv_scale[ rel_v, high.filter.time - rel_t ] ]
        dist : f64 [ dv_len[ dv_sub[ gap, dv_scale[ toward, stand ] ] ] ]
        speed : f64 [ dv_len[ rel_v ] ]
        side : string [ (beneath > 0.0) ? 'under' : 'over' ]
        out.push[ 'docking: {words[ at ]}, mark {stand} m {side} its ports' ]
        out.push[ 'relative gps: {dist} m to the mark (truly {truly} m), {speed} m/s between the ships' ]
        if [ held_t >= 0.0 ]
            kept : f64 [ high.filter.time - held_t ]
            out.push[ 'inside the hold for {kept} s of 10' ]
        return out

    # what our jets can push us along a way (m/s2), at our
    # mass now: a full ship moves far slower than an empty one
    func jets_reach [ way: Dvec ] -> f64
        if [ dv_len[ way ] < 1e-9 ] return 0.0
        u : dv_norm[ way ]
        q : high.filter.q
        sum : f64 [ 0.0 ]
        for [ j: Jet ] in orbiter.jets
            along : f64 [ dv_dot[ q_rotate[ q, j.dir ], u ] ]
            if [ along > 0.0 ] sum += along * j.thrust
        return sum / orbiter.mass

    # the close approach, in the tanker's own frame (up, along
    # its path, across): our port flown to points on the line
    # straight down from its port, 200 m then 20 m, on the
    # jets; the natural drift of a gap in orbit (Clohessy and
    # Wiltshire) taken out of the push
    func approach []
        nv : high.filter
        t : f64 [ nv.time ]
        if [ upper == 7 ]
            approaching = true
            high.pilot.couples = true
            high.pilot.use_jets = true
            rel_t = -1.0
            upper = 8
            held_t = -1.0
            # under or over it, as we believe we are
            spot : tanker_at[ t ]
            high_up : f64 [ dv_dot[ dv_sub[ nv.r, spot[ 0 ] ],
                                    dv_norm[ spot[ 0 ] ] ] ]
            beneath = (high_up < 0.0) ? 1.0 : -1.0
            way : string [ (beneath > 0.0) ? 'down to us, under it'
                           : 'up to us, over it' ]
            note[ 'the tanker rolls its ports {way}' ]
        if [ upper >= 13 && upper <= 15 ] return
        if [ upper >= 17 ] return
        rel_update[]
        tk : tanker_at[ t ]
        tr : tk[ 0 ]
        tv : tk[ 1 ]
        up : dv_norm[ tr ]
        hn : dv_norm[ dv_cross[ tr, tv ] ]
        along : dv_cross[ hn, up ]
        n : f64 [ dv_len[ dv_cross[ tr, tv ] ] / dv_dot[ tr, tr ] ]
        tx : q_rotate[ link_q, Dvec [ 1.0, 0.0, 0.0 ] ]
        # from its ports out to our side
        toward : dv_scale[ up, 0.0 - beneath ]
        # nose beside its nose, our ports looking back at its
        high.pilot.axis = tx
        high.pilot.side = dv_cross[ dv_scale[ toward, -1.0 ], tx ]
        if [ rel_t < 0.0 ] return
        # the springs' push first: no jet fires by its ports
        if [ upper == 16 && met - freed_t < 5.0 ]
            high.pilot.push = Dvec [ 0.0, 0.0, 0.0 ]
            return
        # our port against the mark stand metres out from its port
        gap : dv_add[ rel_p, dv_scale[ rel_v, t - rel_t ] ]
        rel : dv_sub[ gap, dv_scale[ toward, stand ] ]
        # the mark turns with the tanker: in its frame the gap
        # changes by the gap's own speed less that turn
        w : dv_scale[ hn, n ]
        relv : dv_sub[ rel_v, dv_cross[ w, gap ] ]
        dist : f64 [ dv_len[ rel ] ]
        # it closes while the two still turn their ports
        if [ upper == 8 ]
            tz : q_rotate[ link_q, Dvec [ 0.0, 0.0, 1.0 ] ]
            mz : q_rotate[ nv.q, Dvec [ 0.0, 0.0, 1.0 ] ]
            if [ dv_dot[ tz, toward ] > 0.9998
                 && dv_dot[ mz, toward ] < -0.9998 ]
                upper = 10
                note[ 'ports face each other: to 20 m from it, {dist / 1000.0} km to go' ]
        # as fast as it can still stop by the mark: braking at
        # 0.08 m/s2 far, 0.03 within 300 m, at most 15 m/s, and
        # never past two fifths of what the jets give back toward
        # the mark at our mass
        brake : f64 [ (dist > 300.0) ? 0.08 : 0.03 ]
        brake = min[ brake, 0.4 * jets_reach[ rel ] ]
        speed : f64 [ min[ 15.0, sqrt[ 2.0 * brake * dist ] ] ]
        # the last metres to the port: slowing to contact
        if [ upper == 12 ]
            speed = min[ 0.3, 0.03 + dist / 30.0 ]
        # at the mark: onto it over about 10 s
        if [ dist < 5.0 && upper != 12 ]
            speed = dist * 0.1
        want : dv_scale[ rel, 0.0 - speed / max[ dist, 0.000001 ] ]
        veer : dv_sub[ want, relv ]
        # burns, as a crew flies it: coast while the speed is
        # within its band of the curve (a tenth of it, at least
        # 0.05 m/s far, 0.02 within 300 m, 0.01 at the end), then
        # one firm burn back onto it
        least : f64 [ (dist > 300.0) ? 0.05 : 0.02 ]
        if [ upper == 12 || dist < 5.0 ] least = 0.01
        band : f64 [ max[ least, 0.1 * speed ] ]
        off : f64 [ dv_len[ veer ] ]
        if [ off > band ]
            pushing = true
        el [ off < band * 0.2 ]
            pushing = false
        # the jets' whole push far out, gentle near, softest last
        most : f64 [ (dist > 50.0) ? 0.15 : 0.05 ]
        if [ upper == 12 ] most = 0.02
        most = min[ most, 0.8 * jets_reach[ veer ] ]
        acc : Dvec [ 0.0, 0.0, 0.0 ]
        if [ pushing ]
            # never past the miss in one step of the guidance
            firm : f64 [ min[ most, off / 2.0 ] ]
            acc = dv_scale[ veer, firm / off ]
            # the orbit pulls on the gap to the tanker, not the mark
            x : f64 [ dv_dot[ gap, up ] ]
            z : f64 [ dv_dot[ gap, hn ] ]
            vx : f64 [ dv_dot[ relv, up ] ]
            vy : f64 [ dv_dot[ relv, along ] ]
            drift : dv_add[ dv_add[
                dv_scale[ up, 3.0 * n * n * x + 2.0 * n * vy ],
                dv_scale[ along, -2.0 * n * vx ] ],
                dv_scale[ hn, 0.0 - n * n * z ] ]
            acc = dv_sub[ acc, drift ]
        high.pilot.push = q_unrotate[ nv.q,
                                      dv_scale[ acc, orbiter.mass ] ]
        # the touch is judged after both have stepped (step's end)
        if [ upper == 12 ] return
        if [ upper < 10 ] return
        # backing away: clear once 50 m out from its ports (we
        # leave from there; holding beside it is not the aim)
        if [ upper == 16 ]
            if [ dv_dot[ gap, toward ] >= stand ]
                upper = 17
                high.pilot.push = Dvec [ 0.0, 0.0, 0.0 ]
                gone : f64 [ dv_len[ gap ] ]
                note[ 'clear of the tanker: {gone} m from its ports' ]
            return
        # a hold at 20 m: inside its limits for 10 s
        near : f64 [ 2.0 ]
        slow : f64 [ 0.05 ]
        if [ dist > near || dv_len[ relv ] > slow ]
            held_t = -1.0
            return
        if [ held_t < 0.0 ] held_t = t
        if [ t - held_t < 10.0 ] return
        upper = 12
        stand = 0.0
        held_t = -1.0
        note[ 'held at 20 m: closing to contact' ]

    # the ports' gear once the hold is done: both ships' doors
    # slide open over 8 s, then our probes run out 2.5 m over
    # 12 s; caught, they draw in until the hulls stand off, the
    # tips seated 0.45 m into the cones
    func port_gear []
        if [ gear_t < 0.0 ] gear_t = met
        run : f64 [ met - gear_t ]
        # freed: the probes withdraw over 10 s, then the doors
        # close over 8 s
        if [ upper >= 16 ]
            gone : f64 [ met - freed_t ]
            seated : f64 [ standoff + 0.45 ]
            probe = seated * max[ 1.0 - gone / 10.0, 0.0 ]
            doors = min[ max[ 1.0 - (gone - 10.0) / 8.0, 0.0 ], 1.0 ]
            return
        doors = min[ max[ run / 8.0, 0.0 ], 1.0 ]
        if [ upper == 12 ]
            probe = 2.5 * min[ max[ (run - 8.0) / 12.0, 0.0 ], 1.0 ]
        el
            pull : f64 [ min[ (met - caught_t) / 15.0, 1.0 ] ]
            probe = 2.5 - (2.05 - standoff) * pull

    # the probes meet the cones (the truth: a touch, not a
    # sensor): a tip inside its cone's mouth, slow and square,
    # is caught; else it backs off and tries again
    func contact []
        tk : tanker
        ob : orbiter
        toward : dv_scale[ dv_norm[ tk.state.r ], 0.0 - beneath ]
        theirs : tk.body_point[ tk.port_at ]
        gap : dv_sub[ ob.body_point[ ob.port_at ], theirs ]
        apart : f64 [ dv_dot[ gap, toward ] ]
        # a tip 0.3 m into its cone
        if [ apart > probe - 0.3 ] return
        aside : f64 [ dv_len[ dv_sub[ gap, dv_scale[ toward, apart ] ] ] ]
        w : q_rotate[ tk.state.q, tk.state.w ]
        tv : dv_add[ tk.state.v, dv_cross[ w, dv_sub[ theirs,
                                                      tk.state.r ] ] ]
        closing : f64 [ 0.0 - dv_dot[ dv_sub[ ob.state.v, tv ], toward ] ]
        face : f64 [ dv_dot[ q_rotate[ ob.state.q, ob.port_dir ],
                             q_rotate[ tk.state.q, tk.port_dir ] ] ]
        noses : f64 [ dv_dot[ q_rotate[ ob.state.q, Dvec [ 1.0, 0.0, 0.0 ] ],
                              q_rotate[ tk.state.q, Dvec [ 1.0, 0.0, 0.0 ] ] ] ]
        # limits (estimates): the cone's mouth 0.5 m about the
        # tip, 0.15 m/s, 3 degrees
        turned : f64 [ acos[ min[ 0.0 - face, noses ] ] * 57.2957795 ]
        lm : i32 [ met / 60.0 ]
        ls : i32 [ i32[ met ] % 60 ]
        lp : string [ (ls < 10) ? '0' : '' ]
        if [ aside < 0.5 && abs[ closing ] < 0.15 && turned < 3.0
             && probe >= 2.5 ]
            upper = 13
            caught_t = met
            high.pilot.use_jets = false
            high.pilot.push = Dvec [ 0.0, 0.0, 0.0 ]
            for [ j: Jet ] in ob.jets
                j.on = false
            tq : tk.state.q
            caught_r = q_unrotate[ tq, gap ]
            caught_q = q_mul[ q_conj[ tq ], ob.state.q ]
            dock_r = caught_r
            dock_q = caught_q
            latched = 'caught at T+{lm}:{lp}{ls}, {aside} m aside, {closing} m/s, {turned} deg off'
            note[ 'soft capture: {aside} m aside, {closing} m/s, {turned} deg off' ]
            return
        upper = 11
        stand = 20.0
        held_t = -1.0
        gear_t = -1.0
        doors = 0.0
        probe = 0.0
        note[ 'struck outside the capture limits ({aside} m aside, {closing} m/s, {turned} deg off): back to 20 m' ]

    # docked: the pumps move propellant from each of the
    # tanker's tanks into ours of the same name, 2,000 kg/s in
    # all (an estimate), oxygen to fuel 2.36 to 1, until ours
    # are full or its are dry
    func refuel [ h: f64 ]
        if [ upper != 14 ] return
        tk : tanker
        ob : orbiter
        flowing : bool [ false ]
        for [ i: i32 0, i < ob.tanks.count, i += 1 ]
            mine : ob.tanks[ i ]
            for [ j: i32 0, j < tk.tanks.count, j += 1 ]
                theirs : tk.tanks[ j ]
                if [ theirs.name != mine.name ] continue
                rate : f64 [ (mine.density > 1000.0)
                             ? 2000.0 * 2.36 / 3.36 : 2000.0 / 3.36 ]
                room : f64 [ mine.capacity - ob.state.prop[ i ] ]
                give : f64 [ min[ rate * h, min[ room,
                                                 tk.state.prop[ j ] ] ] ]
                if [ give <= 0.0 ] continue
                ob.state.prop[ i ] = ob.state.prop[ i ] + give
                tk.state.prop[ j ] = tk.state.prop[ j ] - give
                moved += give
                flowing = true
        ob.mass_properties[ ob.state.prop ]
        tk.mass_properties[ tk.state.prop ]
        if [ flowing ] return
        upper = 15
        tons : f64 [ moved / 1000.0 ]
        note[ 'refuelled: {tons} t moved, ours {ob.propellant[] / 1000.0} t, the tanker {tk.propellant[] / 1000.0} t left' ]

    # refuelled: the valves shut, the latches open and the
    # probes' springs push the ships apart at 0.1 m/s between
    # them (an estimate), shared by their masses; then we back
    # off on the jets to 50 m from its ports
    func undock []
        tk : tanker
        ob : orbiter
        toward : dv_scale[ dv_norm[ tk.state.r ], 0.0 - beneath ]
        both : f64 [ ob.mass + tk.mass ]
        ob.state.v = dv_add[ ob.state.v,
                             dv_scale[ toward, 0.1 * tk.mass / both ] ]
        tk.state.v = dv_sub[ tk.state.v,
                             dv_scale[ toward, 0.1 * ob.mass / both ] ]
        upper = 16
        freed_t = met
        stand = 50.0
        held_t = -1.0
        rel_t = -1.0
        pushing = false
        high.pilot.use_jets = true
        note[ 'undocking: the latches open, the springs push us apart' ]

    # latched: we ride the tanker as one body, our port held to
    # its port (its motion only; our mass does not yet load it)
    func ride_tanker []
        tk : tanker
        ob : orbiter
        tq : tk.state.q
        if [ upper == 13 ]
            # the probes draw the hulls in: port onto port, square
            # (ours turned half round its nose from the tanker's),
            # the cones taking out what was aside
            k : f64 [ min[ (met - caught_t) / 15.0, 1.0 ] ]
            ease : f64 [ k * k * (3.0 - 2.0 * k) ]
            # mated, the hulls stand off: only the connectors meet
            seat : dv_scale[ tk.port_dir, standoff ]
            dock_r = dv_add[ dv_scale[ caught_r, 1.0 - ease ],
                             dv_scale[ seat, ease ] ]
            sq : q_axis[ Dvec [ 1.0, 0.0, 0.0 ], 3.14159265358979 ]
            sign : f64 [ (caught_q.w * sq.w + caught_q.x * sq.x
                          + caught_q.y * sq.y + caught_q.z * sq.z < 0.0)
                         ? -1.0 : 1.0 ]
            dock_q = q_norm[ Quat [
                caught_q.w * (1.0 - ease) + sq.w * sign * ease,
                caught_q.x * (1.0 - ease) + sq.x * sign * ease,
                caught_q.y * (1.0 - ease) + sq.y * sign * ease,
                caught_q.z * (1.0 - ease) + sq.z * sign * ease ] ]
            if [ k >= 1.0 ]
                upper = 14
                docked_at = met
                lm : i32 [ met / 60.0 ]
                ls : i32 [ i32[ met ] % 60 ]
                lp : string [ (ls < 10) ? '0' : '' ]
                latched = 'latched at T+{lm}:{lp}{ls}: hulls together, both connectors seated'
                note[ 'hard dock: the latches close, the propellant lines open' ]
        ob.state.q = q_mul[ tq, dock_q ]
        # the same turn, in our body's axes (ours is turned from
        # its): what our gyros feel
        ob.state.w = q_unrotate[ dock_q, tk.state.w ]
        want : dv_add[ tk.body_point[ tk.port_at ],
                       q_rotate[ tq, dock_r ] ]
        slip : dv_sub[ want, ob.body_point[ ob.port_at ] ]
        ob.state.r = dv_add[ ob.state.r, slip ]
        arm : dv_sub[ ob.state.r, tk.state.r ]
        spin : q_rotate[ tq, tk.state.w ]
        ob.state.v = dv_add[ tk.state.v, dv_cross[ spin, arm ] ]

    # where the booster comes down if left alone, from its nav
    func predict [ aim_at: Dvec ] -> Dvec
        nv : low.filter
        stage_at : i32 [ (lower >= 5) ? 5 : ((lower == 4) ? 4 : 3) ]
        imp : forecast[ stage_at ]
        ang : f64 [ turn[ nv.time ] ]
        # the miss, horizontal, in the inertial frame now
        d : ecef_to_eci[ dv_sub[ imp.point, aim_at ], ang ]
        fr : frame[ nv.r, nv.time ]
        up : fr.up
        return dv_sub[ d, dv_scale[ up, dv_dot[ d, up ] ] ]

    # the stage-one centre engine and the ring pair facing
    # across it: their thrust passes through the axis
    func centre_three [ c: Craft ] -> vec i32
        grp : c.engines[ 0 ].group
        # several boosters side by side: each one's centre, so
        # every booster's tanks drain alike
        each : booster_centres[ c ]
        if [ each.count > 1 ] return each
        mid : i32 [ -1 ]
        mid_r : f64 [ 1e30 ]
        for [ i: i32 0, i < c.engines.count, i += 1 ]
            e : c.engines[ i ]
            r : f64 [ e.at.y * e.at.y + e.at.z * e.at.z ]
            if [ e.group == grp && r < mid_r ]
                mid = i
                mid_r = r
        pair : vec i32 [] [ -1, -1 ]
        best : f64 [ 1e30 ]
        for [ i: i32 0, i < c.engines.count, i += 1 ]
            for [ j: i32 i + 1, j < c.engines.count, j += 1 ]
                a_e : c.engines[ i ]
                b_e : c.engines[ j ]
                ok : bool [ i != mid && j != mid && a_e.group == grp
                            && b_e.group == grp ]
                sy : f64 [ a_e.at.y + b_e.at.y ]
                sz : f64 [ a_e.at.z + b_e.at.z ]
                gap : f64 [ sy * sy + sz * sz ]
                if [ ok && gap < best ]
                    best = gap
                    pair[ 0 ] = i
                    pair[ 1 ] = j
        return vec i32 [] [ mid, pair[ 0 ], pair[ 1 ] ]

    # each bottom-stage booster's engine nearest its own axis
    # (a booster is the oxidiser tank its engines draw)
    func booster_centres [ c: Craft ] -> vec i32
        out : vec i32 []
        names : vec string []
        grp : c.engines[ 0 ].group
        for [ e: Engine ] in c.engines
            if [ e.group != grp ] continue
            known : bool [ false ]
            for [ n: string ] in names
                if [ n == e.oxidiser ] known = true
            if [ !known ] names.push[ e.oxidiser ]
        for [ n: string ] in names
            ti : i32 [ c.tank_index[ n ] ]
            if [ ti < 0 ] continue
            ax : c.tanks[ ti ].off
            best : i32 [ -1 ]
            best_r : f64 [ 1e30 ]
            for [ i: i32 0, i < c.engines.count, i += 1 ]
                e : c.engines[ i ]
                if [ e.group != grp || e.oxidiser != n ] continue
                dy : f64 [ e.at.y - ax.y ]
                dz : f64 [ e.at.z - ax.z ]
                r : f64 [ dy * dy + dz * dz ]
                if [ r < best_r ]
                    best = i
                    best_r = r
            if [ best >= 0 ] out.push[ best ]
        return out

    # the engines the landing burns on: one, or each booster's
    # centre when there are several
    func landing_engines [ c: Craft ] -> vec i32
        each : booster_centres[ c ]
        if [ each.count > 1 ] return each
        if [ three_burn ] return centre_three[ c ]
        return vec i32 [] [ 0 ]

    # the landing engines on or off, at a throttle
    func land_set [ c: Craft, on: bool, th: f64 ]
        for [ k: i32 ] in landing_engines[ c ]
            c.engines[ k ].lit = on
            c.engines[ k ].throttle = th

    # how many engines the landing burn lights falling at v_down
    # (m/s): each booster's centre when there are several, else
    # three while fast, as the flight does
    func burn_n [ c: Craft, v_down: f64 ] -> f64
        each : booster_centres[ c ]
        if [ each.count > 1 ] return f64[ each.count ]
        if [ v_down > 250.0 ] return 3.0
        return 1.0

    # how many engines the landing burns on
    func land_n [ c: Craft ] -> f64
        return f64[ landing_engines[ c ].count ]

    func booster_phase [ decide: bool ]
        nv : low.filter
        c : booster
        fr : frame[ nv.r, nv.time ]
        up : fr.up
        rel : air_speed[ nv.r, nv.v ]
        speed : f64 [ dv_len[ rel ] ]
        back : dv_scale[ dv_norm[ rel ], -1.0 ]
        # close in, the impact moves fast: look ten times a second
        quick : bool [ lower == 2 && miss < 30000.0 ]
        if [ quick ]
            glance += 0.0025
        if [ lower == 1 || lower == 2 ]
            unset : bool [ steer.x == 0.0 && steer.y == 0.0 ]
            if [ decide || unset || (quick && glance >= 0.1) ]
                m : predict[ aim ]
                miss = dv_len[ m ]
                if [ quick ]
                    if [ prev_miss < 1e29 && glance > 0.0 ]
                        mv_rate = dv_scale[ dv_sub[ m, prev_mv ],
                                            1.0 / glance ]
                    prev_miss = miss
                    prev_mv = m
                    glance = 0.0
                dirh : dv_scale[ dv_norm[ m ], -1.0 ]
                # the landing point should come straight at the mark:
                # what it slides across that line is pushed out too
                mr : f64 [ dv_len[ mv_rate ] ]
                if [ quick && mr > 1e-3 ]
                    mh : dv_norm[ m ]
                    along : f64 [ dv_dot[ mv_rate, mh ] ]
                    slide : dv_sub[ mv_rate, dv_scale[ mh, along ] ]
                    dirh = dv_norm[ dv_sub[ dirh,
                                            dv_scale[ slide, 1.0 / mr ] ] ]
                steer = dv_norm[ dv_add[ dirh, dv_scale[ up, 0.35 ] ] ]
            low.pilot.axis = steer
        if [ lower == 1 ]
            if [ low.pilot.error < 0.17 && met > sep_t + 5.0 ]
                set_engines[ c, centre_three[ c ], 1.0 ]
                lower = 2
                lit_t = met
                note[ 'boostback burn, miss {miss} m' ]
            return
        if [ lower == 2 ]
            if [ miss < 8000.0 ]
                for [ e: Engine ] in c.engines
                    e.throttle = 0.4
            # the look that sees the closest pass coming sets the
            # step to cut on: the landing point moves as a line past
            # the mark, nearest at -(m . m') / |m'|^2
            mr2 : f64 [ dv_dot[ mv_rate, mv_rate ] ]
            if [ cut_at < 0.0 && quick && glance == 0.0 && mr2 > 1e-6 ]
                t_near : f64 [ 0.0 - dv_dot[ prev_mv, mv_rate ] / mr2 ]
                if [ t_near <= 0.1 ]
                    cut_at = met + max[ t_near, 0.0 ]
            # off on target, or down to what the entry and landing
            # burns need
            due : bool [ cut_at >= 0.0 && met >= cut_at ]
            spent : bool [ c.propellant[] < 14000.0 * boosters ]
            if [ miss < 50.0 || due || spent ]
                for [ e: Engine ] in c.engines
                    e.lit = false
                lower = 3
                left : f64 [ c.propellant[] ]
                # where it now comes down, not the last look's
                miss = dv_len[ predict[ aim ] ]
                note[ 'boostback cutoff, miss {miss} m, {left} kg left' ]
            return
        h : f64 [ height[ nv.r, nv.time ] ]
        if [ lower == 3 ]
            low.pilot.axis = back
            if [ h < 57000.0 && speed > 1000.0 && dv_dot[ rel, up ] < 0.0 ]
                set_engines[ c, centre_three[ c ], 1.0 ]
                lower = 4
                lit_t = met
                note[ 'entry burn at {speed} m/s' ]
            el [ h < 40000.0 && dv_dot[ rel, up ] < 0.0 ]
                lower = 5
                note[ 'no entry burn needed' ]
            return
        if [ lower == 4 ]
            low.pilot.axis = back
            # the air does the rest; keep the landing's share
            if [ speed < 900.0 || c.propellant[] < 6500.0 ]
                for [ e: Engine ] in c.engines
                    e.lit = false
                lower = 5
                note[ 'entry burn cutoff at {speed} m/s' ]
            return
        if [ lower == 5 ]
            if [ decide ]
                m : predict[ aim ]
                miss = dv_len[ m ]
                lean : f64 [ miss / 1000.0 ]
                if [ lean > 0.3 ] lean = 0.3
                md : dv_norm[ m ]
                # which way a lean carries it: away from the miss, as
                # flown (the hull alone says the other); then, once
                # the air bites (15 kPa), what the miss does: grown
                # by more than 20 m in 4 s, the other way, held 8 s
                if [ fin_way == 0.0 ]
                    fin_way = -1.0
                    fin_look = met
                    fin_miss = miss
                el [ low.pilot.qbar < 15000.0 ]
                    fin_look = met
                    fin_miss = miss
                el [ met - fin_look >= 4.0 ]
                    fin_look = met
                    if [ miss > fin_miss + 20.0 ]
                        fin_way = 0.0 - fin_way
                        fin_look = met + 4.0
                        note[ 'the fins steer the other way: miss {miss} m' ]
                    fin_miss = miss
                steer = dv_scale[ md, lean * fin_way ]
            low.pilot.axis = dv_norm[ dv_add[ back, steer ] ]
            # light when one engine at 70 percent, with the air's
            # drag, just stops it above the deck
            feet : believed_point[ low, Dvec [ LEG_FOOT_X, 0.0, 0.0 ] ]
            above : f64 [ height[ feet, nv.time ] - deck_h ]
            vdown : f64 [ 0.0 - dv_dot[ rel, up ] ]
            stop : f64 [ -1e30 ]
            # falling fast, the burn starts on three (Falcon's way)
            three_burn = vdown > 250.0
            if [ above < 8000.0 ]
                stop = stop_loss[ c, table[], c.mass, vdown,
                                 above + deck_h ]
                       + 40.0 + vdown * 0.3
            # the air does the braking until the last few km
            if [ above < stop ]
                set_engines[ c, landing_engines[ c ], 0.7 ]
                # lit, the gimbal turns it as fast as it can brake
                low.pilot.max_rate = 0.35
                lower = 6
                lit_t = met
                plan_t = -1.0
                left : f64 [ c.propellant[] ]
                note[ 'landing burn at {above} m, {vdown} m/s down, miss {miss} m, {left} kg left' ]
            return
        if [ lower == 6 ]
            landing_burn[ decide ]
            return

    # each leg's touch, a broken leg, the hull's strike, and
    # how it ends: standing or over
    func watch_touchdown []
        c : booster
        up : ecef_to_eci[ enu_up[ site_lat, site_lon ], turn[ c.time ] ]
        for [ i: i32 0, i < c.legs.count, i += 1 ]
            g : c.legs[ i ]
            bit : i32 [ 1 << i ]
            if [ g.touch_t >= 0.0 && (seen & bit) == 0 ]
                seen = seen | bit
                off : dv_sub[ g.touch_at, target ]
                ue : enu_up[ site_lat, site_lon ]
                flat : dv_sub[ off, dv_scale[ ue, dv_dot[ off, ue ] ] ]
                d : f64 [ dv_len[ flat ] ]
                deg : f64 [ g.touch_tilt * 57.2957795 ]
                note[ 'leg {i} touches at {g.touch_v} m/s, {d} m from the mark, tilt {deg} deg' ]
            gone : i32 [ 1 << (i + 8) ]
            if [ g.broken && (seen & gone) == 0 ]
                seen = seen | gone
                note[ 'leg {i} breaks at {g.peak} N' ]
        if [ c.hull_t >= 0.0 && (seen & (1 << 16)) == 0 ]
            seen = seen | (1 << 16)
            note[ 'the hull hits the deck at {c.hull_v} m/s: it explodes' ]
            lower = 9
            return
        if [ lower != 7 ] return
        ax : q_rotate[ c.state.q, Dvec [ 1.0, 0.0, 0.0 ] ]
        tilt : f64 [ acos[ dv_dot[ ax, up ] ] * 57.2957795 ]
        if [ tilt > 45.0 && (seen & (1 << 17)) == 0 ]
            seen = seen | (1 << 17)
            note[ 'it topples over' ]
        # still: barely moving and turning for a while
        rest : f64 [ dv_len[ air_speed[ c.state.r, c.state.v ] ] ]
        if [ met - down_t < 20.0 && (rest > 0.05
             || dv_len[ c.state.w ] > 0.01 || met - down_t < 3.0) ]
            return
        settled = true
        first : c.legs[ 0 ]
        cores : '{first.stroke}'
        for [ i: i32 1, i < c.legs.count, i += 1 ]
            g : c.legs[ i ]
            cores = '{cores}, {g.stroke}'
        how : (tilt > 45.0) ? 'on its side' : 'standing'
        note[ '{how} at {tilt} deg; crush cores {cores} m' ]

    # below the sea and not on the deck: it is in the water
    func splashed [] -> bool
        if [ !booster || lower == 8 ] return false
        h : f64 [ height[ booster.state.r, booster.time ] ]
        if [ h > 0.0 ] return false
        for [ e: Engine ] in booster.engines
            e.lit = false
        lower = 8
        note[ 'booster in the sea' ]
        return true

    # the landing burn: the convex plan from the believed state,
    # re-solved twice a second, its first step flown
    func landing_burn [ decide: bool ]
        c : booster
        nv : low.filter
        ang : f64 [ turn[ nv.time ] ]
        aim_i : ecef_to_eci[ aim, ang ]
        fr : frame[ aim_i, nv.time ]
        feet : nv.body_point[ Dvec [ LEG_FOOT_X, 0.0, 0.0 ] ]
        d : dv_sub[ feet, aim_i ]
        vrel : air_speed[ nv.r, nv.v ]
        # the feet's own speed: turning, they move unlike the top
        arm : dv_sub[ Dvec [ LEG_FOOT_X, 0.0, 0.0 ], nv.imu_at ]
        vf : dv_add[ vrel, q_rotate[ nv.q, dv_cross[ nv.rate, arm ] ] ]
        r0 : Dvec [ dv_dot[ d, fr.east ], dv_dot[ d, fr.north ],
                    dv_dot[ d, fr.up ] ]
        v0 : Dvec [ dv_dot[ vf, fr.east ], dv_dot[ vf, fr.north ],
                    dv_dot[ vf, fr.up ] ]
        # on three it brakes straight against its motion through
        # the air at 85 percent; down to the centre engine once it
        # alone (at 80 percent) can stop the fall in the height
        # left, and the planner takes it from there
        one_e : c.engines[ 0 ]
        one_acc : f64 [ 0.8 * (one_e.thrust_vac - c.air.pressure
                               * one_e.exit_area) / c.mass ]
        need : f64 [ v0.z * v0.z / (2.0 * max[ r0.z, 1.0 ]) + 9.81 ]
        if [ three_burn && need < one_acc ]
            three_burn = false
            set_engines[ c, landing_engines[ c ], 0.7 ]
            plan_t = -1.0
            note[ 'down to the centre engine at {r0.z} m, {0.0 - v0.z} m/s' ]
        if [ three_burn ]
            for [ k: i32 ] in landing_engines[ c ]
                c.engines[ k ].throttle = 0.85
            low.pilot.axis = dv_scale[ dv_norm[ vrel ], -1.0 ]
            return
        if [ r0.z < 400.0 ]
            for [ g: Leg ] in c.legs
                g.out = true
        if [ c.landed ]
            sp : f64 [ dv_len[ v0 ] ]
            for [ e: Engine ] in c.engines
                e.lit = false
            # on its legs it can not turn: steering would wind up
            low.steers = false
            for [ j: Jet ] in c.jets
                j.on = false
            lower = 7
            down_t = met
            note[ 'touchdown at {sp} m/s' ]
            mean : f64 [ plan_ms / f64[ (plan_n > 0) ? plan_n : 1 ] ]
            how : method_name[ landing ]
            note[ '{how} plans: {plan_n}, {mean} ms mean, {plan_worst} ms worst' ]
            return
        # it can not hover: once low, a climb is never let start
        if [ !cut && r0.z < 10.0 && v0.z > 0.0 ]
            cut = true
            note[ 'rising at {r0.z} m over the deck: engines cut' ]
        # off as soon as a free fall from here meets the deck at
        # 3 m/s or less: hanging low it only drifts
        fall_h : f64 [ max[ r0.z, 0.0 ] ]
        drop_v : f64 [ sqrt[ v0.z * v0.z + 2.0 * 9.8 * fall_h ] ]
        if [ !cut && r0.z < 10.0 && v0.z <= 0.0 && drop_v <= 3.0 ]
            cut = true
            note[ 'engine off at {r0.z} m, {v0.z} m/s: meets the deck at {drop_v} m/s' ]
        if [ cut ]
            for [ e: Engine ] in c.engines
                e.lit = false
            return
        # the end, timed to the least throttle at the mass it will
        # have at the deck: stopping above the deck (1.5 m) the
        # engine is off and it falls; stopping at the deck it burns
        # at the least throttle, upright, gently steered; short of
        # the deck the plan flies on. it never pushes up
        lone : c.engines[ 0 ]
        ln : f64 [ land_n[ c ] ]
        back_p : f64 [ c.air.pressure * lone.exit_area ]
        push_l : f64 [ ln * (lone.throttle_min * lone.thrust_vac - back_p) ]
        low_h : f64 [ (r0.z > 0.1) ? r0.z : 0.1 ]
        t_end : f64 [ 2.0 * low_h / max[ 0.0 - v0.z, 0.5 ] ]
        m_end : f64 [ c.mass - ln * lone.flow * lone.throttle_min * t_end ]
        least : f64 [ push_l / m_end ]
        net : f64 [ least - 9.81 ]
        if [ r0.z < 60.0 && v0.z < 0.0 && net > 0.0 ]
            stop_h : f64 [ r0.z - v0.z * v0.z / (2.0 * net) ]
            if [ lone.lit && stop_h > 1.5 ]
                land_set[ c, false, lone.throttle ]
                coasting = true
                note[ 'engine off at {r0.z} m, {v0.z} m/s: the least throttle would stop it {stop_h} m up' ]
            if [ !lone.lit && coasting && stop_h <= 0.0 ]
                land_set[ c, true, lone.throttle_min ]
                coasting = false
                note[ 'engine lit again at {r0.z} m, {v0.z} m/s' ]
            if [ !lone.lit ]
                low.pilot.axis = fr.up
                return
            if [ stop_h >= -1.0 ]
                if [ !feather ]
                    feather = true
                    note[ 'feathering at {r0.z} m, {v0.z} m/s' ]
                land_set[ c, true, lone.throttle_min ]
                # the sideways speed taken out over about 2 s,
                # leaning no more than 0.08 rad
                want_l : Dvec [ 0.0 - v0.x / 2.0, 0.0 - v0.y / 2.0,
                                0.0 ]
                most_l : f64 [ least * sin[ 0.08 ] ]
                wl : f64 [ dv_len[ want_l ] ]
                if [ wl > most_l ]
                    want_l = dv_scale[ want_l, most_l / wl ]
                share_l : f64 [ min[ dv_len[ want_l ] / least, 0.08 ] ]
                tilt_l : f64 [ asin[ share_l ] ]
                ax : fr.up
                if [ wl > 1e-6 ]
                    we : dv_scale[ fr.east, want_l.x ]
                    wn : dv_scale[ fr.north, want_l.y ]
                    wd : dv_norm[ dv_add[ we, wn ] ]
                    ax = dv_add[ dv_scale[ fr.up, cos[ tilt_l ] ],
                                 dv_scale[ wd, sin[ tilt_l ] ] ]
                low.pilot.axis = ax
                return
        # the plan solved for now is taken up; if its worker is
        # still at it, this waits
        if [ job && met >= job.at - 0.001 ]
            solver.sync[ null ]
            plan_n += 1
            plan_ms += job.took
            if [ job.took > plan_worst ] plan_worst = job.took
            if [ job.good ]
                plan = job.ld
                plan_t = job.at
                if [ job.sc ] plan_sc = job.sc
                if [ job.far ]
                    off : f64 [ dv_len[ plan.place_at[ plan.steps ] ] ]
                    note[ 'the mark is out of reach: landing {off} m from it' ]
            el [ plan_t < 0.0 ]
                plan_t = job.at
            job = null
            solver = null
        # the plan's thrust for now, else a braking law that stops
        # the fall at the deck and never pushes it back up
        hz : f64 [ (r0.z > 1.0) ? r0.z : 1.0 ]
        brake : f64 [ (v0.z < 0.0) ? v0.z * v0.z / (2.0 * hz) + 9.8
                      : 4.0 ]
        u : Dvec [ 0.0 - v0.x * 0.5, 0.0 - v0.y * 0.5, brake ]
        # a plan two solves old no longer fits where it is: the
        # braking law takes it from there
        fresh : bool [ plan && plan.feasible && met - plan_t < 1.0 ]
        if [ fresh ]
            nst : i32 [ plan.steps ]
            dt : f64 [ plan.flight / f64[ nst ] ]
            at_k : f64 [ max[ (met - plan_t) / dt, 0.0 ] ]
            k : i32 [ i32[ at_k ] ]
            # never past the end of a plan: then the braking law;
            # between its steps the push moves on from one to the
            # next (a plan is replaced before its first step ends);
            # the plans allow for the tilt's lag themselves
            if [ k < nst ] u = plan_push[ plan, at_k ]
        # the push wanted besides gravity: the plan's thrust plus
        # the drag it counted on, inertial
        ar : standard_air[ r0.z + deck_h ]
        drag : known_drag[ c, v0, ar ]
        if [ plan && plan.feasible && k_now[] < plan.steps ]
            kd : i32 [ k_now[] * 3 ]
            drag = Dvec [ plan.extra[ kd ], plan.extra[ kd + 1 ],
                          plan.extra[ kd + 2 ] ]
        want : dv_add[ u, drag ]
        if [ !job && (decide || plan_t < 0.0) ]
            plan_ahead[ c, r0, v0, want, u ]
        need_i : dv_add[ dv_add[ dv_scale[ fr.east, want.x ],
                         dv_scale[ fr.north, want.y ] ],
                         dv_scale[ fr.up, want.z ] ]
        # twenty times a second: the hull's air force at the
        # attitude it is at, and the engine gives the rest of the push
        if [ met - pt_t >= 0.05 || pt_thrust <= 0.0 ]
            hull : c.body_aero[ q_unrotate[ nv.q, vrel ], ar, true ]
            air_i : q_rotate[ nv.q, hull.force ]
            # what the wind and the models did not say: the push felt
            # against the one its own attitude and throttle should
            # give, over half a second
            if [ pt_thrust > 0.0 ]
                eng : c.engines[ 0 ]
                th : f64 [ eng.throttle ]
                if [ th < eng.throttle_min ] th = eng.throttle_min
                if [ th > 1.0 ] th = 1.0
                lit : f64 [ land_n[ c ] * (th * eng.thrust_vac
                            - c.air.pressure * eng.exit_area) ]
                body : q_rotate[ nv.q, Dvec [ 1.0, 0.0, 0.0 ] ]
                made : dv_add[ dv_scale[ body, lit ], air_i ]
                # the slosh rides along: felt over the whole mass
                gap : dv_sub[ nv.felt, dv_scale[ made, 1.0 / c.mass ] ]
                push_err = dv_add[ push_err, dv_scale[
                                   dv_sub[ gap, push_err ], 0.1 ] ]
                pe : f64 [ dv_len[ push_err ] ]
                if [ pe > 5.0 ]
                    push_err = dv_scale[ push_err, 5.0 / pe ]
            want_f : dv_scale[ dv_sub[ need_i, push_err ], c.mass ]
            # a tilt's push across is partly undone by the air on the
            # tilted hull: measured here, the share of it that is left
            vert : f64 [ dv_dot[ want_f, fr.up ] ]
            lat : dv_sub[ want_f, dv_scale[ fr.up, vert ] ]
            if [ dv_len[ lat ] > 1.0 ]
                way : dv_norm[ lat ]
                base : dv_norm[ want_f ]
                bent : dv_norm[ dv_add[ base, dv_scale[ way, 0.02 ] ] ]
                q0 : q_between[ Dvec [ 1.0, 0.0, 0.0 ], base ]
                q1 : q_between[ Dvec [ 1.0, 0.0, 0.0 ], bent ]
                f0 : c.body_aero[ q_unrotate[ q0, vrel ], ar, true ]
                f1 : c.body_aero[ q_unrotate[ q1, vrel ], ar, true ]
                across : f64 [ dv_dot[ dv_sub[ q_rotate[ q1, f1.force ],
                                       q_rotate[ q0, f0.force ] ], way ] ]
                push : f64 [ dv_len[ want_f ] ]
                share : f64 [ 1.0 + across / (0.02 * push) ]
                # below zero the air steers it: the lean flips; never
                # nearer zero than 0.2 (the lean cap takes the rest)
                if [ share < -1.3 ] share = -1.3
                if [ share > 1.3 ] share = 1.3
                if [ abs[ share ] < 0.2 ]
                    share = (share < 0.0) ? -0.2 : 0.2
                want_f = dv_add[ dv_scale[ fr.up, vert ],
                                 dv_scale[ lat, 1.0 / share ] ]
            # the engine on that line; the air's push along it comes
            # off the thrust
            pt_axis = dv_norm[ want_f ]
            # sized by the air at the attitude it is told to fly: while
            # it turns, the air at its own lags the line
            tq : q_between[ Dvec [ 1.0, 0.0, 0.0 ], pt_axis ]
            told : c.body_aero[ q_unrotate[ tq, vrel ], ar, true ]
            along : f64 [ dv_dot[ q_rotate[ tq, told.force ], pt_axis ] ]
            pt_thrust = dv_len[ want_f ] - along
            pt_t = met
        axis : pt_axis
        thrust : f64 [ pt_thrust ]
        # never past the tilt the engine can be flown at
        lean : f64 [ acos[ dv_dot[ axis, fr.up ] ] ]
        # no more than the plan allows now, a little over
        most : f64 [ 0.6 ]
        if [ plan && plan.feasible ]
            ks : i32 [ k_now[] ]
            if [ ks >= plan.steps ] ks = plan.steps - 1
            most = tilt_at[ plan.tilt, ks, plan.steps, plan.flight ]
                   + 0.05
        if [ lean > most ]
            side : dv_norm[ dv_sub[ axis,
                            dv_scale[ fr.up, dv_dot[ axis, fr.up ] ] ] ]
            axis = dv_add[ dv_scale[ fr.up, cos[ most ] ],
                           dv_scale[ side, sin[ most ] ] ]
            # the same push up as asked: what is cut is sideways
            thrust = thrust * cos[ lean ] / cos[ most ]
        low.pilot.axis = axis
        e : c.engines[ 0 ]
        pa : f64 [ c.air.pressure * e.exit_area ]
        each : f64 [ (thrust / land_n[ c ] + pa) / e.thrust_vac ]
        for [ k: i32 ] in landing_engines[ c ]
            c.engines[ k ].throttle = each

    # the share of a lean's push across left after the air on
    # the hull pushes back, falling straight down at a speed and
    # height under a push (N); below zero the air outpushes the
    # engine and the lean goes the other way; within 1.3
    func air_share [ c: Craft, speed: f64, ar: Air, push: f64 ]
                     -> f64
        if [ push < 1.0 ] return 1.0
        rel : Dvec [ 0.0 - speed, 0.0, 0.0 ]
        lean : f64 [ 0.2 ]
        bent : Dvec [ 0.0 - speed * cos[ lean ],
                      speed * sin[ lean ], 0.0 ]
        f0 : c.body_aero[ rel, ar, true ]
        f1 : c.body_aero[ bent, ar, true ]
        # the hull's push across, along the lean, per radian
        side : f64 [ (f1.force.y * cos[ lean ]
                      + f1.force.x * sin[ lean ] - f0.force.y) / lean ]
        share : f64 [ 1.0 + side / push ]
        if [ share < -1.3 ] share = -1.3
        if [ share > 1.3 ] share = 1.3
        return share

    # a plan falls due and its worker is not done: a step now
    # would wait for it
    public func waiting [] -> bool
        if [ !job ] return false
        if [ job.done ] return false
        return met + 0.0025 >= job.at - 0.001

    # a plan's push (m/s2) at a fraction of its steps, moving on
    # from one step's to the next
    func plan_push [ ld: Landing, at: f64 ] -> Dvec
        nst : i32 [ ld.steps ]
        k : i32 [ i32[ at ] ]
        if [ k >= nst ] k = nst - 1
        nk : i32 [ (k + 1 < nst) ? k + 1 : k ]
        fk : f64 [ at - f64[ k ] ]
        mixed : vec f64 [] [ 0.0, 0.0, 0.0 ]
        for [ ax: i32 0, ax < 3, ax += 1 ]
            p : f64 [ ld.accel[ k * 3 + ax ] ]
            q : f64 [ ld.accel[ nk * 3 + ax ] ]
            mixed[ ax ] = p + (q - p) * fk
        return Dvec [ mixed[ 0 ], mixed[ 1 ], mixed[ 2 ] ]

    # the next plan, solved on a worker from where the booster
    # will be in half a second at the push it is told now
    func plan_ahead [ c: Craft, r0: Dvec, v0: Dvec, want: Dvec,
                      push: Dvec ]
        lead : f64 [ 0.5 ]
        nv : low.filter
        fr : frame[ ecef_to_eci[ aim, turn[ nv.time ] ], nv.time ]
        acc : Dvec [ want.x, want.y, want.z - 9.8 ]
        r1 : dv_add[ dv_add[ r0, dv_scale[ v0, lead ] ],
                     dv_scale[ acc, 0.5 * lead * lead ] ]
        v1 : dv_add[ v0, dv_scale[ acc, lead ] ]
        # from afar the centre; closer, anywhere in a circle that
        # grows to 2/3 of the deck. it aims at a spot that stays
        # put; where it is headed (its place, plus half its speed
        # across for the time left) moves the spot only when it
        # strays 10 m, and the spot is kept inside the circle
        fall_v : f64 [ max[ 0.0 - v1.z, 1.0 ] ]
        t_left : f64 [ 2.0 * max[ r1.z, 0.0 ] / fall_v ]
        bound : Dvec [ r1.x + v1.x * t_left * 0.5,
                       r1.y + v1.y * t_left * 0.5, 0.0 ]
        grown : f64 [ (pad_far - r1.z) / (pad_far - pad_full) ]
        pad_ok : f64 [ 32.0 * min[ max[ grown, 0.0 ], 1.0 ] ]
        stray : dv_sub[ bound, land_at ]
        sl : f64 [ dv_len[ stray ] ]
        if [ sl > 10.0 ]
            nudge : dv_scale[ stray, (sl - 10.0) / sl ]
            land_at = dv_add[ land_at, nudge ]
        gl : f64 [ dv_len[ land_at ] ]
        if [ gl > pad_ok && gl > 1e-6 ]
            land_at = dv_scale[ land_at, pad_ok / gl ]
        r1 = dv_sub[ r1, land_at ]
        e : c.engines[ 0 ]
        ld : landing_problem[ c, r1, v1, aim ]
        ld.mass = c.mass - land_n[ c ] * e.flow * e.throttle * lead
        # the push across it feels now, less the drag counted on
        ld.lat_now = Dvec [ dv_dot[ nv.felt, fr.east ]
                            - (want.x - push.x),
                            dv_dot[ nv.felt, fr.north ]
                            - (want.y - push.y), 0.0 ]
        # what it gets across trails what it asks: the autopilot
        # settles on a lean in 1 / point_gain
        ld.lag = 1.0 / low.pilot.point_gain
        # the share the air leaves, step by step, as the fall slows
        ld.reach = vec f64 []
        fall : f64 [ dv_len[ v1 ] ]
        force : f64 [ dv_len[ want ] * ld.mass ]
        for [ k: i32 0, k < ld.steps, k += 1 ]
            gone : f64 [ f64[ k ] / f64[ ld.steps ] ]
            ark : standard_air[ r1.z * (1.0 - gone) + deck_h ]
            sk : f64 [ air_share[ c, fall * (1.0 - gone), ark, force ] ]
            ld.reach.push[ sk ]
        warm : bool [ plan && plan.feasible
                      && plan.flight - (met + lead - plan_t) > 2.0 ]
        if [ warm ]
            ld.flight = plan.flight - (met + lead - plan_t)
            ld.relax = plan.relax
        vd : f64 [ (0.0 - v1.z > 1.0) ? 0.0 - v1.z : 1.0 ]
        guess : f64 [ 2.0 * r1.z / vd ]
        if [ plan && plan.feasible ]
            guess = max[ guess, plan.flight - (met + lead - plan_t) ]
        # past the last plan's end: never a range that is empty
        if [ guess < 3.0 ] guess = 3.0
        lo : f64 [ guess * 0.5 ]
        if [ lo < 2.0 ] lo = 2.0
        ld.best_lo = lo
        ld.best_hi = guess * 1.6 + 3.0
        area : f64 [ 3.14159265358979 * c.radius * c.radius ]
        tb : table[].copy[]
        job = PlanJob [ ld: ld, tb: tb, area: area,
                        deck: deck_h, at: met + lead, warm: warm ]
        if [ landing == LandingMethod.scvx ]
            job.sc = Scvx [ r0: r1, v0: v1, mass: ld.mass,
                            thrust_min: ld.thrust_min,
                            thrust_max: ld.thrust_max, isp: ld.isp,
                            tilt: ld.tilt, glide: ld.glide,
                            steps: ld.steps, flight: guess,
                            drag: tb.lit, area: area, deck: deck_h,
                            start: vec f64 [], turn: ld.turn,
                            lag: ld.lag,
                            thrust_now: Dvec [ ld.lat_now.x * ld.mass,
                                               ld.lat_now.y * ld.mass,
                                               push.z * ld.mass ] ]
            if [ warm && plan_sc && plan_sc.feasible ]
                job.sc.shift[ plan_sc, met + lead - plan_t ]
        work : vec Au []
        work.push[ job ]
        run : lambda [ arg: object ]
            plan_work[ arg ]
        solver = async [ work_fn: run, work: work ]

    # the step of the plan in force now, -1 with none
    func k_now [] -> i32
        if [ !plan || !plan.feasible ] return -1
        dt : f64 [ plan.flight / f64[ plan.steps ] ]
        k : i32 [ i32[ (met - plan_t) / dt ] ]
        return (k < 0) ? 0 : k

    # the drag the plans count on: straight back along the flight,
    # local east, north, up (m/s2)
    func known_drag [ c: Craft, v: Dvec, ar: Air ] -> Dvec
        area : f64 [ 3.14159265358979 * c.radius * c.radius ]
        sp : f64 [ dv_len[ v ] ]
        ca : f64 [ c.axial_coeff[ sp / ar.sound, true, true ] ]
        k_d : f64 [ 0.5 * ar.density * sp * ca * area / c.mass ]
        return dv_scale[ v, 0.0 - k_d ]

    # planned at 85 percent at most: the rest is for corrections;
    # the push across turns at 2 m/s3: 20 m/s2 at 0.1 rad/s, as
    # flown (an estimate)
    func landing_problem [ c: Craft, r0: Dvec, v0: Dvec,
                           aim_i: Dvec ] -> Landing
        e : c.engines[ 0 ]
        ln : f64 [ land_n[ c ] ]
        # at sea level the outside air pushes on its exit
        sl_back : f64 [ 101325.0 * e.exit_area ]
        # how fast its push across can change: the gimbal's turn
        # of the whole booster (rad/s2), a 0.1 rad swing flown at
        # it, times its push per kg
        push : f64 [ ln * (0.85 * e.thrust_vac - sl_back) ]
        arm : f64 [ max[ c.cg - e.at.x, 1.0 ] ]
        spin : f64 [ push * sin[ e.gimbal_max ] * arm
                     / max[ c.inertia[ 4 ], 1.0 ] ]
        swing : f64 [ 2.0 * sqrt[ 0.1 / max[ spin, 1e-3 ] ] ]
        turn_r : f64 [ min[ push / c.mass * 0.1 / swing, 2.0 ] ]
        return Landing [ r0: r0, v0: v0, mass: c.mass,
                         thrust_min: ln * (0.4 * e.thrust_vac - sl_back),
                         thrust_max: ln * 0.85 * (e.thrust_vac - sl_back),
                         isp: 287.5,
                         tilt: 0.35, glide: 0.1, steps: 16,
                         turn: turn_r ]

    # metres one engine at 70 percent needs to stop a fall of
    # v_down from height h, the standard air's drag helping
    func stop_loss [ c: Craft, tb: DragTable, mass: f64, v_down: f64,
                     h: f64 ] -> f64
        v : f64 [ v_down ]
        z : f64 [ h ]
        m : f64 [ mass ]
        e : c.engines[ 0 ]
        ln : f64 [ burn_n[ c, v_down ] ]
        area : f64 [ 3.14159265358979 * c.radius * c.radius ]
        dt : f64 [ 0.05 ]
        for [ i: i32 0, i < 4000, i += 1 ]
            if [ v <= 0.0 ] break
            ar : standard_air[ z ]
            push : f64 [ ln * (0.7 * e.thrust_vac
                         - ar.pressure * e.exit_area) ]
            ca : f64 [ tb.coeff[ v / ar.sound, true ] ]
            drag : f64 [ 0.5 * ar.density * v * v * ca * area ]
            acc : f64 [ (push + drag) / m - 9.8 ]
            v -= acc * dt
            z -= v * dt
            m -= ln * e.flow * 0.7 * dt
        return h - z

    # the drag table from the shape as it is now (fins, legs),
    # made again each second
    func table [] -> DragTable
        if [ !drag_tb || met - drag_t > 1.0 ]
            if [ !drag_tb ] drag_tb = DragTable [ ]
            drag_tb.fill[ booster ]
            drag_t = met
        return drag_tb

    # where the booster comes down when it flies the rest of its
    # sequence from its believed state, by the flight's own rules:
    # coast, the entry burn, the fall without a lean, the landing
    # burn lit by its rule and braking to the deck; still standard
    # air. stage: 3 coast, 4 entry burn, 5 the fall
    func forecast [ stage_at: i32 ] -> Impact
        nv : low.filter
        c : booster
        tb : table[]
        e : c.engines[ 0 ]
        out : Impact [ ok: false ]
        pos : nv.r
        vel : nv.v
        spin : Dvec [ 0.0, 0.0, EARTH_SPIN ]
        mass : f64 [ c.mass ]
        prop : f64 [ c.propellant[] ]
        area : f64 [ 3.14159265358979 * c.radius * c.radius ]
        stage : i32 [ stage_at ]
        clock : f64 [ 0.0 ]
        look : f64 [ 0.0 ]
        stop : f64 [ -1e30 ]
        h : f64 [ 0.25 ]
        # the landing burn's engines, set as it lights
        lit_fc : f64 [ -1.0 ]
        for [ i: i32 0, i < 40000, i += 1 ]
            ang : f64 [ turn[ nv.time + clock ] ]
            geo : ecef_to_geodetic[ eci_to_ecef[ pos, ang ] ]
            up : ecef_to_eci[ enu_up[ geo.x, geo.y ], ang ]
            # through the wind it knows: the air moves too
            mw : known_wind[ c, geo.z ]
            east_i : ecef_to_eci[ enu_east[ geo.x, geo.y ], ang ]
            north_i : ecef_to_eci[ enu_north[ geo.x, geo.y ], ang ]
            wind_i : dv_add[ dv_scale[ east_i, mw.x ],
                             dv_scale[ north_i, mw.y ] ]
            ground : dv_sub[ vel, dv_cross[ spin, pos ] ]
            rel : dv_sub[ ground, wind_i ]
            sp : f64 [ dv_len[ rel ] ]
            down : f64 [ 0.0 - dv_dot[ ground, up ] ]
            above : f64 [ geo.z - deck_h ]
            if [ above <= 0.0 || (stage == 6 && down <= 0.5) ]
                out.point = eci_to_ecef[ pos, ang ]
                out.time = clock
                out.lat = geo.x
                out.lon = geo.y
                out.ok = true
                return out
            # the rules, as the flight flies them
            if [ stage == 3 ]
                if [ geo.z < 57000.0 && sp > 1000.0 && down > 0.0 ]
                    stage = 4
                el [ geo.z < 40000.0 && down > 0.0 ]
                    stage = 5
            el [ stage == 4 ]
                if [ sp < 900.0 || prop < 6500.0 ] stage = 5
            el [ stage == 5 && above < 8000.0 ]
                if [ clock >= look ]
                    look = clock + 0.5
                    stop = stop_loss[ c, tb, mass, down, above + deck_h ]
                           + 40.0 + down * 0.3
                if [ above < stop ] stage = 6
            ar : standard_air[ geo.z ]
            lit : f64 [ 0.0 ]
            th : f64 [ 0.0 ]
            if [ stage == 4 && prop > 0.0 ]
                lit = 3.0
                th = 1.0
            el [ stage == 6 && prop > 0.0 ]
                # brake the fall to the deck, on its landing engines:
                # three first when it lit fast, one once that one
                # (at 80 percent) can stop it, as the flight does
                rise : f64 [ (above > 1.0) ? above : 1.0 ]
                need : f64 [ down * down / (2.0 * rise) + 9.8 ]
                one_a : f64 [ 0.8 * (e.thrust_vac - ar.pressure * e.exit_area)
                              / mass ]
                if [ lit_fc < 0.0 ] lit_fc = burn_n[ c, down ]
                if [ booster_centres[ c ].count <= 1 && lit_fc > 1.5
                     && need < one_a ]
                    lit_fc = 1.0
                lit = lit_fc
                th = (mass * need / lit + ar.pressure * e.exit_area)
                     / e.thrust_vac
                if [ th < e.throttle_min ] th = e.throttle_min
                if [ th > 1.0 ] th = 1.0
                # on three it burns at 85 percent
                if [ lit > 1.5 && booster_centres[ c ].count <= 1 ] th = 0.85
            push : f64 [ lit * (th * e.thrust_vac
                         - ar.pressure * e.exit_area) ]
            ca : f64 [ tb.coeff[ sp / ar.sound, lit > 0.0 ] ]
            k : f64 [ 0.5 * ar.density * sp * ca * area / mass ]
            back : dv_scale[ rel, (sp > 1e-6) ? -1.0 / sp : 0.0 ]
            acc : dv_add[ dv_sub[ gravity[ pos ], dv_scale[ rel, k ] ],
                          dv_scale[ back, push / mass ] ]
            vel = dv_add[ vel, dv_scale[ acc, h ] ]
            pos = dv_add[ pos, dv_scale[ vel, h ] ]
            burn : f64 [ lit * e.flow * th * h ]
            mass -= burn
            prop -= burn
            clock += h
            h = (stage == 6 || geo.z < 20000.0) ? 0.05 : 0.25
        return out

    # the deck's anemometer: the real wind on its mast, gusts and
    # all, averaged over about 10 s (an estimate)
    func read_deck_wind []
        if [ !deck_air ]
            w : (stack) ? stack.weather : booster.weather
            deck_air = Weather [ levels: w.levels, severity: w.severity,
                                 seed: w.seed * 2862933555777941757 + 3 ]
            deck_wind = deck_air.mean_wind[ deck_h + 10.0 ]
        mast : f64 [ deck_h + 10.0 ]
        sw : deck_air.mean_wind[ mast ]
        felt : deck_air.air_at[ mast, dv_len[ sw ], 0.5 ]
        deck_wind = dv_add[ deck_wind, dv_scale[
                            dv_sub[ felt.wind, deck_wind ], 0.05 ] ]

    # the wind the flight computer knows at a height, east and
    # north: the profile loaded before launch, its bottom shifted
    # to what the deck measures, the shift gone by 1 km
    func known_wind [ c: Craft, h: f64 ] -> Dvec
        aloft : c.weather.mean_wind[ h ]
        if [ !deck_air ] return aloft
        there : c.weather.mean_wind[ deck_h + 10.0 ]
        fade : f64 [ 1.0 - min[ max[ h - deck_h, 0.0 ] / 1000.0, 1.0 ] ]
        return dv_add[ aloft, dv_scale[ dv_sub[ deck_wind, there ],
                                       fade ] ]

    # the booster's distance from the mark (m) and its speed
    public func landing_report [] -> vec f64
        ang : f64 [ turn[ booster.time ] ]
        feet : booster.body_point[ Dvec [ LEG_FOOT_X, 0.0, 0.0 ] ]
        off : dv_sub[ eci_to_ecef[ feet, ang ], target ]
        up : enu_up[ site_lat, site_lon ]
        flat : dv_sub[ off, dv_scale[ up, dv_dot[ off, up ] ] ]
        sp : f64 [ dv_len[ air_speed[ booster.state.r,
                                      booster.state.v ] ] ]
        ax : q_rotate[ booster.state.q, Dvec [ 1.0, 0.0, 0.0 ] ]
        tilt : f64 [ acos[ dv_dot[ ax, ecef_to_eci[ up, ang ] ] ] ]
        return vec f64 [] [ dv_len[ flat ], sp, tilt * 57.2957795,
                            booster.propellant[] ]

# the tanker at liftoff: its plane through the pad, 200 km up;
# an orbit later still circular
# the tanker's own flight off deck two: its bottom booster
# home to deck two, its top booster parked at 300 km
expect func t_tanker_flight [] -> bool
    ms : Mission [ tanker_flight: true ]
    ms.hold[]
    for [ i: i32 0, i < 1600000, i += 1 ]
        ms.step[ 0.0025 ]
        if [ i % 7 == 0 ] Au.auto_free[]
        if [ ms.upper >= 3 && ms.parked && (ms.lower >= 7 || ms.lower == 0) ]
            break
        if [ ms.met > 3600.0 ] break
    up : ms.orbiter
    if [ !up ] return false
    log 'tanker flight: upper {ms.upper} at T{ms.met}, booster phase {ms.lower}, {up.propellant[] / 1000.0} t aboard the top stage'
    return ms.upper >= 3 && ms.parked

# the staging flight with both home: the booster to deck one,
# the crew ship back on its engines to deck two
expect func t_crew_home [] -> bool
    ms : Mission [ whole: false, crew_home: true ]
    ms.hold[]
    for [ i: i32 0, i < 600000, i += 1 ]
        ms.step[ 0.0025 ]
        if [ i % 7 == 0 ] Au.auto_free[]
        if [ ms.upper >= 23 && (ms.lower >= 7 || !ms.booster) ] break
        if [ ms.met > 1200.0 ] break
    up : ms.orbiter
    if [ !up ] return false
    log 'crew home: phase {ms.upper} at T{ms.met}, booster phase {ms.lower}, {up.propellant[] / 1000.0} t left in the crew ship'
    return ms.upper == 23

# a flight saved at T+60 loads back to the same numbers, and
# flies on beside the original: within 50 m after 20 s through
# max-Q (its gusts and sensor noise are fresh draws)
expect func t_save_state [] -> bool
    ms : Mission [ ]
    ms.hold[]
    for [ i: i32 0, i < 28000, i += 1 ]
        ms.step[ 0.0025 ]
        if [ i % 7 == 0 ] Au.auto_free[]
    dir : path.path_cache[ 'launch' ]
    file : path '{dir}/t_save_state.save'
    if [ !ms.save_state[ file ] ] return false
    back : Mission [ ]
    back.hold[]
    if [ !back.load_state[ file ] ] return false
    a0 : ms.stack.state
    b0 : back.stack.state
    same : bool [ a0.r.x == b0.r.x && a0.r.y == b0.r.y && a0.r.z == b0.r.z
                  && a0.v.x == b0.v.x && a0.q.w == b0.q.w
                  && a0.w.y == b0.w.y && ms.met == back.met
                  && ms.upper == back.upper && ms.lower == back.lower
                  && ms.stack.mass == back.stack.mass ]
    for [ k: i32 0, k < ms.stack.engines.count, k += 1 ]
        ea : ms.stack.engines[ k ]
        eb : back.stack.engines[ k ]
        if [ ea.lit != eb.lit || ea.oxidiser != eb.oxidiser
             || ea.fuel != eb.fuel || ea.throttle != eb.throttle ]
            same = false
    if [ ms.whole != back.whole || ms.fed_up != back.fed_up
         || ms.low.steers != back.low.steers ]
        same = false
    tg : f64 [ dv_len[ dv_sub[ ms.tanker.state.r, back.tanker.state.r ] ] ]
    for [ i: i32 0, i < 8000, i += 1 ]
        ms.step[ 0.0025 ]
        back.step[ 0.0025 ]
        if [ i % 7 == 0 ] Au.auto_free[]
    apart : f64 [ dv_len[ dv_sub[ ms.stack.state.r, back.stack.state.r ] ] ]
    log 'save state: exact {same}, tanker {tg} m, {apart} m apart after 20 s more'
    return same && tg == 0.0 && apart < 50.0

# the whole flight to the tanker: up in one arc beside it,
# then docked to its ports
expect func t_to_tanker [] -> bool
    ms : Mission [ ]
    ms.hold[]
    for [ i: i32 0, i < 2800000, i += 1 ]
        ms.step[ 0.0025 ]
        if [ i % 7 == 0 ] Au.auto_free[]
        if [ ms.upper == 17 ] break
    if [ !ms.orbiter ] return false
    ob : ms.orbiter
    gap : f64 [ dv_len[ dv_sub[ ms.tanker.state.r, ob.state.r ] ] ]
    log 'to the tanker: phase {ms.upper} at T{ms.met}, {gap / 1000.0} km from it, {ob.propellant[]} kg left'
    log 'to the tanker: docked at T{ms.docked_at}, {ms.moved / 1000.0} t moved'
    # docked by T+15 minutes, then refuelled
    return ms.upper == 17 && ms.docked_at >= 0.0
           && ms.docked_at < 900.0

# the whole ship 10 km behind the tanker in its orbit: the
# ports turned to face each other, then held 200 m and 20 m
# under its port, by relative GPS and the jets
expect func t_dock_approach [] -> bool
    ms : Mission [ ]
    ms.hold[]
    ob : falcon_nine[ ms.payload ]
    for [ i: i32 0, i < ob.tanks.count, i += 1 ]
        t : ob.tanks[ i ]
        ob.state.prop[ i ] = (t.group == 'one') ? 0.0 : t.mass / 50.0
    ob.mass_properties[ ob.state.prop ]
    ms.crossfeed[ ob ]
    tk : ms.tanker
    ob.time = tk.time
    n : ms.tanker_normal[]
    b : dv_norm[ tk.state.r ]
    ahead : dv_cross[ n, b ]
    rr : f64 [ dv_len[ tk.state.r ] ]
    behind : f64 [ 10000.0 / rr ]
    dir : dv_sub[ dv_scale[ b, cos[ behind ] ],
                  dv_scale[ ahead, sin[ behind ] ] ]
    ob.state.r = dv_scale[ dir, rr ]
    fwd : dv_cross[ n, dir ]
    ob.state.v = dv_scale[ fwd, dv_len[ tk.state.v ] ]
    ob.state.q = q_between[ Dvec [ 1.0, 0.0, 0.0 ], fwd ]
    ob.state.w = Dvec [ 0.0, 0.0, 0.0 ]
    for [ g: Leg ] in ob.legs
        g.out = false
        g.frac = 0.0
    ms.stack = ob
    ms.orbiter = ob
    ms.met = 600.0
    ms.upper = 7
    ms.low.align[ ob ]
    ms.high.align[ ob ]
    ms.low.steers = false
    ms.high.steers = true
    # how often a jet lights, and the share of steps any burns
    # each jet's last step as a bit (auto_free takes a vec)
    was : i64 [ 0 ]
    lights : i64 [ 0 ]
    both : f64 [ -1.0 ]
    held : f64 [ 0.0 ]
    mated : f64 [ -1.0 ]
    after : f64 [ 0.0 ]
    burning : i64 [ 0 ]
    steps : i64 [ 0 ]
    for [ i: i32 0, i < 4000000, i += 1 ]
        ms.step[ 0.0025 ]
        if [ i % 7 == 0 ] Au.auto_free[]
        if [ ms.approaching ]
            steps += 1
            now : i64 [ 0 ]
            for [ k: i32 0, k < ob.jets.count, k += 1 ]
                jt : ob.jets[ k ]
                if [ jt.on ] now = now | (i64[ 1 ] << k)
            for [ k: i32 0, k < ob.jets.count, k += 1 ]
                if [ ((now & ~was) >> k) & 1 ] lights += 1
            if [ now != 0 ] burning += 1
            was = now
        # both ships' propellant at the latch: the pumps move it,
        # never make it
        if [ ms.upper >= 14 && both < 0.0 ]
            both = ob.propellant[] + tk.propellant[]
            held = dv_len[ dv_sub[ ob.body_point[ ob.port_at ],
                                   tk.body_point[ tk.port_at ] ] ]
        # at the release: the mated gap, before the springs act
        if [ ms.upper >= 16 && mated < 0.0 ]
            mated = dv_len[ dv_sub[ ob.body_point[ ob.port_at ],
                                    tk.body_point[ tk.port_at ] ] ]
            after = ob.propellant[] + tk.propellant[]
        if [ ms.upper == 17 ] break
    mins : f64 [ f64[ steps ] * 0.0025 / 60.0 ]
    per : f64 [ f64[ lights ] / max[ mins, 0.001 ] ]
    share : f64 [ f64[ burning ] * 100.0 / f64[ max[ steps, 1 ] ] ]
    log 'approach: {mins} min, {per} jet lights a minute, a jet burning {share}% of steps'
    # the truth: our port against its port
    port : tk.body_point[ tk.port_at ]
    mine : ob.body_point[ ob.port_at ]
    off : f64 [ dv_len[ dv_sub[ mine, port ] ] ]
    slip : f64 [ dv_len[ dv_sub[ ob.state.v, tk.state.v ] ] ]
    face : f64 [ dv_dot[ q_rotate[ ob.state.q, ob.port_dir ],
                         q_rotate[ tk.state.q, tk.port_dir ] ] ]
    log 'approach: phase {ms.upper} at T{ms.met}, docked at T{ms.docked_at}, our port {off} m from its port, {slip} m/s apart, faces {face} (-1 square)'
    log 'approach: refuelled {ms.moved / 1000.0} t, ours {ob.propellant[] / 1000.0} t, the tanker {tk.propellant[] / 1000.0} t, both {both} kg at the latch, {after} kg after'
    log 'approach: ports {held} m apart at the latch, {mated} m at the release, {off} m when clear'
    return ms.upper == 17 && abs[ mated - ms.standoff ] < 0.01
           && abs[ mated - held ] < 0.01 && off > 45.0
           && face < -0.99
           && ms.moved > 0.0 && abs[ after - both ] < 1.0

# the whole ship up to the tanker's orbit in one arc: its
# climb every 10 s, and the orbit at cutoff
expect func t_whole_ascent [] -> bool
    ms : Mission [ ]
    ms.hold[]
    next : f64 [ 0.0 ]
    # the speed the air took (m/s)
    lost : f64 [ 0.0 ]
    for [ i: i32 0, i < 400000, i += 1 ]
        ms.step[ 0.0025 ]
        if [ ms.met < 200.0 ]
            lost += ms.stack.drag / ms.stack.mass * 0.0025
        if [ i % 7 == 0 ] Au.auto_free[]
        if [ ms.upper >= 3 ] break
        if [ ms.met < next ] continue
        next += 10.0
        c : ms.stack
        nv : ms.low.filter
        up : ms.frame[ nv.r, nv.time ].up
        vr : f64 [ dv_dot[ nv.v, up ] ]
        vh : f64 [ dv_len[ dv_sub[ nv.v, dv_scale[ up, vr ] ] ] ]
        ax : q_rotate[ c.state.q, Dvec [ 1.0, 0.0, 0.0 ] ]
        pitch : f64 [ asin[ dv_dot[ ax, up ] ] * 57.2957795 ]
        push : ms.push_of[ c ]
        gs : f64 [ push.x / (c.mass * 9.80665) ]
        h : f64 [ ms.height[ nv.r, nv.time ] / 1000.0 ]
        log 'whole: T{ms.met} {h} km, up {vr} m/s, across {vh} m/s, nose {pitch} deg over the horizon, {gs} g, {c.mass / 1000.0} t'
    nv : ms.high.filter
    ap : ms.apsides[ nv.r, nv.v ]
    lo : f64 [ (ap.y - EARTH_A) / 1000.0 ]
    hi : f64 [ (ap.x - EARTH_A) / 1000.0 ]
    log 'whole: cutoff at T{ms.met}, orbit {lo} to {hi} km, {ms.stack.propellant[]} kg left, {lost} m/s to the air'
    return ms.upper >= 3 && lo > 190.0 && hi < 215.0

expect func t_tanker_orbit [] -> bool
    ms : Mission [ ]
    tk : ms.tanker
    t0 : f64 [ tk.time ]
    ang : f64 [ earth_turn[ t0, tk.turn_start ] ]
    pad : ecef_to_eci[ geodetic_to_ecef[ ms.pad_lat, ms.pad_lon, 0.0 ],
                       ang ]
    n : dv_norm[ dv_cross[ tk.state.r, tk.state.v ] ]
    off : f64 [ abs[ dv_dot[ n, pad ] ] ]
    incl : f64 [ acos[ n.z ] * 57.2957795 ]
    r0 : tk.state.r
    rr : f64 [ dv_len[ r0 ] ]
    period : f64 [ 6.28318530717959 * sqrt[ rr * rr * rr / EARTH_GM ] ]
    lo : f64 [ 1e30 ]
    hi : f64 [ 0.0 ]
    steps : i32 [ i32[ period / 0.5 ] ]
    for [ i: i32 0, i < steps, i += 1 ]
        tk.step[ 0.5 ]
        h : f64 [ dv_len[ tk.state.r ] - EARTH_A ]
        if [ h < lo ] lo = h
        if [ h > hi ] hi = h
    back : f64 [ dv_len[ dv_sub[ tk.state.r, r0 ] ] ]
    log 'tanker: pad {off} m off its plane, inclined {incl} deg; an orbit of {period} s at {lo / 1000.0} to {hi / 1000.0} km, back within {back / 1000.0} km'
    # J2 still swings it by about a kilometre
    return off < 1.0 && lo > ms.tanker_alt - 3000.0
           && hi < ms.tanker_alt + 3000.0

# the tanker waits days: the air lowers it, reboosts keep its
# low point in the band, nose along its path
expect func t_tanker_keeps [] -> bool
    ms : Mission [ ]
    ms.hold[]
    tk : ms.tanker
    days : f64 [ 3.0 ]
    start : f64 [ tk.time ]
    end : f64 [ start + days * 86400.0 ]
    full : f64 [ tk.propellant[] ]
    smallest : f64 [ 1e30 ]
    worst : f64 [ 0.0 ]
    i : i64 [ 0 ]
    while [ tk.time < end ]
        h : f64 [ (ms.boosting) ? 0.0025 : 0.05 ]
        ms.keep_tanker[ h ]
        tk.step[ h ]
        i += 1
        if [ i % 7 == 0 ] Au.auto_free[]
        size : f64 [ ms.energy_radius[ tk.state.r, tk.state.v ] ]
        if [ size < smallest ] smallest = size
        if [ tk.time > start + 3600.0 && ms.tanker_pilot.error > worst ]
            worst = ms.tanker_pilot.error
    ap : ms.orbit_range[ tk.state.r, tk.state.v,
                         ms.period_at[ dv_len[ tk.state.r ] ] ]
    sag : f64 [ ms.keep_a - smallest ]
    log 'tanker keeps: {tk.mass} kg, {days} days, {ms.boosts} reboosts, {ms.boost_kg} kg ({full - tk.propellant[]} kg in all), shrank {sag} m at most, now {(ap.y - EARTH_A) / 1000.0} to {(ap.x - EARTH_A) / 1000.0} km, nose off its path {worst * 57.2957795} deg at worst'
    return ms.boosts >= 1 && sag < ms.keep_band + 50.0
           && worst < 0.05

# from the parking orbit, the tanker 1 deg short of the
# transfer's phase: wait, raise, coast up, round off near it
expect func t_chase_tanker [] -> bool
    ms : Mission [ whole: false ]
    ms.hold[]
    # the whole ship as it reaches orbit: the booster's tanks
    # dry, a third of stage two's left, fed to the booster's
    ob : falcon_nine[ ms.payload ]
    for [ i: i32 0, i < ob.tanks.count, i += 1 ]
        t : ob.tanks[ i ]
        ob.state.prop[ i ] = (t.group == 'one') ? 0.0 : t.mass / 3.0
    ob.mass_properties[ ob.state.prop ]
    ms.crossfeed[ ob ]
    tk : ms.tanker
    ob.time = tk.time
    n : ms.tanker_normal[]
    b : dv_norm[ tk.state.r ]
    ahead : dv_cross[ n, b ]
    rr : f64 [ EARTH_A + ms.park_alt ]
    behind : f64 [ ms.transfer_phase[ rr ] + 0.01745 ]
    dir : dv_sub[ dv_scale[ b, cos[ behind ] ],
                  dv_scale[ ahead, sin[ behind ] ] ]
    ob.state.r = dv_scale[ dir, rr ]
    down : f64 [ 0.0 - dv_dot[ gravity[ ob.state.r ], dir ] ]
    fwd : dv_cross[ n, dir ]
    ob.state.v = dv_scale[ fwd, sqrt[ rr * down ] ]
    ob.state.q = q_between[ Dvec [ 1.0, 0.0, 0.0 ], fwd ]
    ob.state.w = Dvec [ 0.0, 0.0, 0.0 ]
    ms.orbiter = ob
    ms.met = 600.0
    ms.lower = 7
    ms.settled = true
    ms.upper = 3
    ms.high.align[ ob ]
    ms.high.steers = true
    ms.high.pilot.use_jets = true
    for [ i: i32 0, i < 2400000, i += 1 ]
        ms.step[ 0.0025 ]
        if [ i % 7 == 0 ] Au.auto_free[]
        if [ ms.upper == 7 ] break
    gap : f64 [ dv_len[ dv_sub[ tk.state.r, ob.state.r ] ] ]
    ap : ms.orbit_range[ ob.state.r, ob.state.v,
                         ms.period_at[ dv_len[ ob.state.r ] ] ]
    lo : f64 [ (ap.y - EARTH_A) / 1000.0 ]
    hi : f64 [ (ap.x - EARTH_A) / 1000.0 ]
    log 'chase: phase {ms.upper} at T{ms.met}, {gap / 1000.0} km from the tanker, orbit {lo} to {hi} km'
    # the last kilometres are the close approach's (item c)
    want : f64 [ ms.tanker_alt / 1000.0 ]
    return ms.upper == 7 && gap < 10000.0 && lo > want - 5.0
           && hi < want + 5.0


# the whole flight: up, the upper stage to orbit, the booster
# back onto the deck it left
expect func t_return_to_pad [] -> bool
    return return_to_pad[ LandingMethod.scvx ]

expect func t_return_to_pad_gfold [] -> bool
    return return_to_pad[ LandingMethod.gfold ]

func return_to_pad [ method: LandingMethod ] -> bool
    ms : Mission [ landing: method, whole: false ]
    ms.hold[]
    ms.stack.weather.severity = 1
    for [ i: i32 0, i < 320000, i += 1 ]
        ms.step[ 0.0025 ]
        # the app drains its pool each frame: so does this
        if [ i % 7 == 0 ] Au.auto_free[]
        if [ ms.settled && ms.upper >= 3 ] break
        if [ ms.lower == 9 || (ms.lower >= 7 && ms.met > 1500.0) ]
            break
    up_left : f64 [ ms.orbiter.propellant[] ]
    log 'mission: upper stage phase {ms.upper} at T{ms.met}, {up_left} kg left'
    if [ ms.lower != 7 ]
        log 'mission: booster not down, phase {ms.lower} at T{ms.met}'
        return false
    rep : ms.landing_report[]
    how : method_name[ method ]
    log 'mission {how}: down {rep[ 0 ]} m from the mark at {rep[ 1 ]} m/s, {rep[ 2 ]} deg tilt, {rep[ 3 ]} kg left'
    # on the pad: inside 2/3 of the deck, standing
    return rep[ 0 ] < 32.0 && rep[ 2 ] < 5.0

# the ascent alone for a kick: MECO height, speed across, up
func ascent_probe [ k: f64 ] -> vec f64
    ms : Mission [ kick: k, whole: false ]
    for [ i: i32 0, i < 80000, i += 1 ]
        ms.step[ 0.0025 ]
        if [ ms.lower > 0 ] break
    nv : ms.low.filter
    fr : ms.frame[ nv.r, nv.time ]
    rel : ms.air_speed[ nv.r, nv.v ]
    vr : f64 [ dv_dot[ rel, fr.up ] ]
    vh : f64 [ dv_len[ dv_sub[ rel, dv_scale[ fr.up, vr ] ] ] ]
    return vec f64 [] [ ms.height[ nv.r, nv.time ], vh, vr, ms.met ]

